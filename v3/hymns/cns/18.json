{"v":3,"coll":"cns","num":18,"id":"hymn_18","title":"Jesu wa sarin wa","duration":20.81,"voices":{"male":{"file":"cns-18-male.m4a","bytes":136915,"sha256":"d56bb18a2dae49648d51f4659307cc51a82a1c3a3b39d0452e479871fd76c287","duration":20.9},"female":{"file":"cns-18-female.m4a","bytes":146129,"sha256":"8277bddc67a13c94e97c0de7851f275fefe5674d7f8a581d04e6c528dfe6752a","duration":20.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.753,"text":"Jesu wa sarin wa,","marked":"Jésù wá sarin wa"},{"start":2.133,"end":3.416,"text":"L'agbar'Ajinde;","marked":"L'agbár'Àjíǹde"},{"start":3.796,"end":5.001,"text":"Je k'isin wa nihin","marked":"Jẹ k'ìsìn wa níhìn"},{"start":5.381,"end":6.409,"text":"Je isin owo.","marked":"Jẹ́ ìsìn ọwọ́."}],"end":6.409},{"key":"2","start":7.359,"lines":[{"start":7.359,"end":8.436,"text":"Mi emi Mimo Re,","marked":"Mi ẹ̀mí Mímọ́́ Rẹ"},{"start":8.816,"end":9.676,"text":"Sinu okan wa;","marked":"Sínú ọkàn wa"},{"start":10.056,"end":11.117,"text":"Mu 'foya at'aro,","marked":"Mu 'fòyà àt'àrò"},{"start":11.497,"end":12.501,"text":"Kuro l'okan wa.","marked":"Kúrò l'ọkàn wa."}],"end":12.501},{"key":"3","start":13.451,"lines":[{"start":13.451,"end":14.731,"text":"Bi a ti n yara lo,","marked":"Bí a ti ń yára lọ"},{"start":15.111,"end":16.055,"text":"Lona ajo wa;","marked":"Lọ́nà àjọ wa"},{"start":16.435,"end":17.878,"text":"K'a ma sona f'oro,","marked":"K'á ma ṣọ́nà f'ọrọ́"},{"start":18.258,"end":19.26,"text":"T'o j'ayeraye.","marked":"T'ó j'ayérayé."}],"end":19.26}]}