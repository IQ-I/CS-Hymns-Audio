{"v":3,"coll":"cns","num":41,"id":"hymn_41","title":"Awa wole Baba","duration":38.891,"voices":{"male":{"file":"cns-41-male.m4a","bytes":282228,"sha256":"71e4b675d957c24541db0273830fe71b5c7e8d218af9d39b942a6bc9bc69f693","duration":38.9},"female":{"file":"cns-41-female.m4a","bytes":292054,"sha256":"afe7e52b510280c59473523d51a00eb7c8699261f6b31718701b5b124bbb7ae2","duration":38.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.196,"text":"Awa wole Baba,","marked":"Àwa wọlé Bàbá"},{"start":1.576,"end":3.11,"text":"Ijo Serafu de loni o (2ce)","marked":"Ìjọ Séráfù dé lónì o"},{"start":3.49,"end":4.503,"text":"Oba onibu ore,","marked":"Ọba oníbú ọrẹ"},{"start":4.883,"end":6.874,"text":"Tiwa leyin lati sioni wa,","marked":"Tiwa lẹ́yìn láti Síónì wa"},{"start":7.254,"end":8.789,"text":"Eledumare ran wa lowo,","marked":"Elédùmarè ràn wá lọ́wọ́"},{"start":9.169,"end":10.69,"text":"Gb'ebo sisun wa loni o,","marked":"Gb'ebo sísun wa lónì o"},{"start":11.07,"end":12.425,"text":"Mu gbogbo ibere wa se,","marked":"Mú gbogbo ìbẹ̀rẹ̀ wa ṣẹ"},{"start":12.805,"end":15.362,"text":"'Gba yi la to mo pe Oluwa ti gba wa la o,","marked":"'Gbà yí la tó mọ̀ pé Olúwa ti gbà wá là o"},{"start":15.742,"end":17.473,"text":"Gbo lati 'bugbe Re -Eledunare,","marked":"Gbọ́ láti 'bùgbé Rẹ Ẹlẹ́dùnàrẹ"}],"end":17.473},{"key":"CHORUS","start":18.423,"lines":[{"start":18.423,"end":20.122,"text":"Abiamo kii gbo igbe omo Re,","marked":"Abiamo kìí gbọ́ igbe ọmọ Rẹ"},{"start":20.502,"end":21.548,"text":"Ko ma ta kiji,","marked":"Kó má ta kìjí"},{"start":21.928,"end":23.476,"text":"Eledumare Baba rere wa fi,","marked":"Elédùmarè Bàbá rere wá fi"},{"start":23.856,"end":24.606,"text":"Fun wa.","marked":"Fún wa."}],"end":24.606},{"key":"2","start":25.556,"lines":[{"start":25.556,"end":27.907,"text":"SOLO: Ibukun owo fi fun wa,","marked":"Sóló: Ìbùkún owó fi fún wa"},{"start":28.287,"end":29.999,"text":"Ibukun omo fi fun wa,","marked":"Ìbùkún ọmọ fi fún wa"},{"start":30.379,"end":31.663,"text":"Alafia fi fun wa.","marked":"Àlàáfíà fi fún wa."},{"start":32.043,"end":34.101,"text":"FULL: Awa wole Baba,","marked":"FULL: Àwa wọlé Bàbá"},{"start":34.481,"end":35.916,"text":"Ijo Serafu de loni o,","marked":"Ìjọ Séráfù dé lónì o"},{"start":36.296,"end":37.341,"text":"Oba onibu ore.","marked":"Ọba oníbú ọrẹ."}],"end":37.341}]}