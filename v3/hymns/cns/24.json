{"v":3,"coll":"cns","num":24,"id":"hymn_24","title":"Awa tun de –awa tun de","duration":30.1,"voices":{"male":{"file":"cns-24-male.m4a","bytes":223475,"sha256":"8d6fec725873ea618f42da47340cabfc4d6fa729dd9f28bb3a3d4d32fc1c91e0","duration":30.2},"female":{"file":"cns-24-female.m4a","bytes":229416,"sha256":"611e7b94a6cd713923073f639f050e60c16ad69d3bcdad323a7273acee0d294f","duration":30.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.953,"text":"Awa tun de -awa tun de,","marked":"Àwa tún dé àwa tún dé"},{"start":2.333,"end":3.4,"text":"Awa juba Baba,","marked":"Àwa júbà Bàbá"},{"start":3.78,"end":5.777,"text":"Awa wole l'eekun wa -Olodumare,","marked":"Àwa wọlé l'eékún wa Olódùmarè"},{"start":6.157,"end":7.733,"text":"Sokale wa -Wa ba wa pe","marked":"Sọ̀kalẹ̀ wa Wá bá wa pé"},{"start":8.113,"end":10.159,"text":"Je ki isin wa loni -Le je itewogba.","marked":"Jẹ́ kí ìsìn wa lọ́ni Lè jẹ́ ìtẹ́wọ́gbà."}],"end":10.159},{"key":"2","start":11.109,"lines":[{"start":11.109,"end":12.976,"text":"SOLO: Ope ibuku fi fun wa","marked":"Sóló: Ọpẹ́ ìbùkù fi fún wa"},{"start":13.356,"end":14.445,"text":"K'ile roju fun wa","marked":"K'ilẹ̀ rojú fún wa"},{"start":14.825,"end":15.972,"text":"K'ara de gbogbo wa,","marked":"K'ára dé gbogbo wa"},{"start":16.352,"end":17.51,"text":"K'olomo ma padanu,","marked":"K'ọlọ́mọ má pàdánù"},{"start":17.89,"end":19.352,"text":"K'agan ko d'olomo","marked":"K'ágàn kò d'ọlọ́mọ"},{"start":19.732,"end":22.395,"text":"FULL: Awa tun de -awa tun de,","marked":"FULL: Àwa tún dé àwa tún dé"},{"start":22.775,"end":23.873,"text":"Awa wole Baba,","marked":"Àwa wọlé Bàbá"},{"start":24.253,"end":26.075,"text":"Awa wole l'ekun wa Olodumare,","marked":"Àwa wọlé l'èkùn wa Olódùmarè"},{"start":26.455,"end":28.55,"text":"Je ki isin wa loni le je tewogba.","marked":"Jẹ́ kí ìsìn wa lọ́ni lè jẹ́ tẹ́wọ́gbà."}],"end":28.55}]}