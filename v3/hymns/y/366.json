{"v":3,"coll":"y","num":366,"id":"hymn_366","title":"ILE bukun kan wa","duration":57.308,"voices":{"male":{"file":"y-366-male-v3.m4a","bytes":402488,"sha256":"9df1ad3d54385c0bd6a1640c2c55dcefb3cafb11d34f05a3732ab2813c3f14ee","duration":57.4},"female":{"file":"y-366-female-v3.m4a","bytes":418407,"sha256":"4cc1ae6aae603ea3ae28209d30bde167bbfbb8d504734f1ca5088274f1721ea5","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.308,"text":"ILE 'bukun kan wa,","marked":"Ilẹ̀ bùkún kan wà"},{"start":1.758,"end":2.881,"text":"Lẹhin ayé wa yi,","marked":"Lẹ́hìn ayé wa yí"},{"start":3.331,"end":5.073,"text":"Wahala, irora,","marked":"Wàhálà, ìrora"},{"start":5.523,"end":7.015,"text":"At'ẹkun ki de'bẹ,","marked":"Àt'ẹkùn kí dé'bẹ̀"},{"start":7.465,"end":8.727,"text":"Igbagbọ y'o dopin,","marked":"Ìgbàgbọ́ y'ó dópin"},{"start":9.177,"end":10.662,"text":"A o de 'reti l'ade,","marked":"A ó dé retí l'adé"},{"start":11.112,"end":12.231,"text":"Imọlẹ ailopin,","marked":"Ìmọ́lẹ̀ àìlópin"},{"start":12.681,"end":13.956,"text":"Ni gbogbo ibẹ jẹ.","marked":"Ní gbogbo ibẹ̀ jẹ́."}],"end":13.956},{"key":"2","start":14.906,"lines":[{"start":14.906,"end":16.169,"text":"Ilẹ kan si tun mbẹ,","marked":"Ilẹ̀ kan sì tún mbẹ́"},{"start":16.619,"end":17.536,"text":"Ilẹ alafia,","marked":"Ilẹ̀ àlàáfíà"},{"start":17.986,"end":19.031,"text":"Awọn Angel rere,","marked":"Àwọn Angẹl rere"},{"start":19.481,"end":21.02,"text":"N kọrin n'nu rẹ lailai,","marked":"Ń kọrin n'nú rẹ̀ láéláé"},{"start":21.47,"end":22.626,"text":"Y'itẹ ogo Rẹ ka,","marked":"Y'ìtẹ́ ògo Rẹ̀ ká"},{"start":23.076,"end":23.974,"text":"L'awọn ẹgbẹ mimọ,","marked":"L'àwọn ẹgbẹ́ mímọ́"},{"start":24.424,"end":26.33,"text":"N wolẹ, wọn n tẹriba,","marked":"Ń wólẹ̀, wọ́n ń tẹríba"},{"start":26.78,"end":27.981,"text":"F'Ẹni Mẹtalọkan.","marked":"F'Ẹni Mẹ́talọ́kan."}],"end":27.981},{"key":"3","start":28.931,"lines":[{"start":28.931,"end":30.091,"text":"Ayọ wọn ti pọ to!","marked":"Ayọ̀ wọn ti pọ̀ tó!"},{"start":30.541,"end":31.709,"text":"Awọn to ri Jesu,","marked":"Àwọn tó rí Jésù"},{"start":32.159,"end":33.318,"text":"Nibi t'o gbe gunwa,","marked":"Níbi t'ó gbé gúnwà"},{"start":33.768,"end":35.181,"text":"T'a si n fi ogo fun;","marked":"T'a sì ń fi ògo fún"},{"start":35.631,"end":36.655,"text":"Wọn n kọrin iyin Rẹ,","marked":"Wọ́n ń kọrin ìyìn Rẹ̀"},{"start":37.105,"end":38.13,"text":"Ati t'isẹgun Rẹ,","marked":"Àti t'ìsẹ́gun Rẹ"},{"start":38.58,"end":39.748,"text":"Wọn ko dẹkun rohin,","marked":"Wọn kò dẹ́kun ròhìn"},{"start":40.198,"end":41.675,"text":"Ohun nla t'o ti se.","marked":"Ohun ńlá t'ó ti ṣe."}],"end":41.675},{"key":"4","start":42.625,"lines":[{"start":42.625,"end":43.991,"text":"W'oke, ẹyin mimọ,","marked":"W'òkè, ẹ̀yin mímọ́"},{"start":44.441,"end":45.394,"text":"Ẹ le ibẹru lọ;","marked":"Ẹ lé ìbẹ̀rù lọ"},{"start":45.844,"end":46.983,"text":"Ọna hiha kan naa,","marked":"Ọ̀nà híhá kan náà"},{"start":47.433,"end":48.652,"text":"L'Olugbala ti gba;","marked":"L'Olùgbàlà ti gbà"},{"start":49.102,"end":50.352,"text":"Ẹ fi suru duro,","marked":"Ẹ fi sùrù dúró"},{"start":50.802,"end":52.211,"text":"Fun igba diẹ sa,","marked":"Fún ìgbà díẹ̀ sá"},{"start":52.661,"end":53.867,"text":"T'ẹrin-t'ẹrin l'Oun o","marked":"T'ẹrin-t'ẹrin l'Òun o"},{"start":54.317,"end":55.759,"text":"Fi gba yin sọdọ rẹ.","marked":"Fi gbà yín sọ́dọ̀ rẹ."}],"end":55.759}]}