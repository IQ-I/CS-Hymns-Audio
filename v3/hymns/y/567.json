{"v":3,"coll":"y","num":567,"id":"hymn_567","title":"ESE d'eru? wo, Jesu ni!","duration":46.595,"voices":{"male":{"file":"y-567-male-v3.m4a","bytes":329368,"sha256":"94c0a4cef35058df1f736455c40e75c2a104c3e42b364eaad70662a99010df8d","duration":46.6},"female":{"file":"y-567-female-v3.m4a","bytes":343112,"sha256":"bc294a92e4629923ad34dbe780e1eabb27c8644b56219c5cce9d5f0705483870","duration":46.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.402,"text":"ESE d'ẹru? Wo, Jesu ni!","marked":"Ẹ̀ṣẹ̀ d'ẹ̀rù? Wò, Jésù ni!"},{"start":2.852,"end":4.511,"text":"Oun tikarẹ l'o n tọkọ;","marked":"Òun tìkárẹ̀ l'ó ń tọkọ"},{"start":4.961,"end":6.165,"text":"Ẹ ta 'bokun si afẹfẹ,","marked":"Ẹ ta bókun sí afẹ́fẹ́"},{"start":6.615,"end":7.954,"text":"Ti y'o gbe wa la ibu,","marked":"Tí y'ó gbé wà la ìbú"},{"start":8.404,"end":9.378,"text":"Lọ si ilu,","marked":"Lọ sí ìlú"},{"start":9.828,"end":11.188,"text":"'Bit' olofo ye sọkun.","marked":"bít olófó yẹ sọkún."}],"end":11.188},{"key":"2","start":12.138,"lines":[{"start":12.138,"end":14.02,"text":"B'a ko mọ 'bi t'a n lọ gun si,","marked":"B'á kò mọ bí t'á ń lọ gùn sí"},{"start":14.47,"end":15.693,"text":"Ju b'a ti n gbohin rẹ lọ;","marked":"Ju b'á ti ń gbóhìn rẹ̀ lọ"},{"start":16.143,"end":17.618,"text":"Sugb' a ko'hun gbogbo silẹ,","marked":"Ṣùgb a kó'hùn gbogbo sílẹ̀"},{"start":18.068,"end":19.685,"text":"A tẹle ihin t'a gbọ;","marked":"A tẹ̀lé ìhín t'á gbọ́"},{"start":20.135,"end":20.998,"text":"Pẹlu Jesu,","marked":"Pẹ̀lú Jésù"},{"start":21.448,"end":23.116,"text":"A nla arin ibu lọ.","marked":"A ńlá arin ìbú lọ."}],"end":23.116},{"key":"3","start":24.066,"lines":[{"start":24.066,"end":25.352,"text":"A ko bẹru igbi okun,","marked":"A kò bẹ̀rù ìgbì òkun"},{"start":25.802,"end":27.119,"text":"A ko si ka iji si;","marked":"A kò sì ka ìjì sí"},{"start":27.569,"end":28.956,"text":"Larin 'rukerudo k'a mọ","marked":"Lárin rúkèrúdò k'á mọ́"},{"start":29.406,"end":30.704,"text":"P'Oluwa mbẹ nitosi,","marked":"P'Olúwa mbẹ́ nítòsí"},{"start":31.154,"end":32.036,"text":"Okun gba gbọ,","marked":"Òkun gbà gbọ́"},{"start":32.486,"end":33.883,"text":"Iji sa niwaju Rẹ.","marked":"Ìjì sá níwájú Rẹ̀."}],"end":33.883},{"key":"4","start":34.833,"lines":[{"start":34.833,"end":36.204,"text":"B'ayọ wa o ti to lọhun,","marked":"B'ayọ̀ wa ó ti tó lọ́hùn"},{"start":36.654,"end":38.024,"text":"Iji ki ja de ibẹ,","marked":"Ìjì kí jà dé ibẹ̀"},{"start":38.474,"end":40.017,"text":"Nibẹ l'awọn ti n sọta wa,","marked":"Níbẹ̀ l'àwọn tí ń sọ̀tá wa"},{"start":40.467,"end":41.813,"text":"Ko le yọ wa lẹnu mọ.","marked":"Kò lè yọ wá lẹ́nu mọ́."},{"start":42.263,"end":43.112,"text":"Wahala pin,","marked":"Wàhálà pín"},{"start":43.562,"end":45.046,"text":"L'ebute alafia na.","marked":"L'èbúté àlàáfíà ná."}],"end":45.046}]}