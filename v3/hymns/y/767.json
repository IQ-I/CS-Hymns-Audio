{"v":3,"coll":"y","num":767,"id":"hymn_767","title":"EGBEGBERUN aimoye","duration":61.264,"voices":{"male":{"file":"y-767-male-v3.m4a","bytes":437215,"sha256":"1647e8f9871c9e2f2fc37b73be1f1b5dfa1d5c666730088f27ef33fbb4458d88","duration":61.3},"female":{"file":"y-767-female-v3.m4a","bytes":454460,"sha256":"eaee89b2c077528db8dfb93c4106d2b3ca0dc6a6795c92127e21aaefdb03a31c","duration":61.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.701,"text":"ẸGBẸGBẸRUN aimoye,","marked":"Ẹgbẹgbẹ̀rún àìmòye"},{"start":2.151,"end":3.133,"text":"Wọn wọ asọ ala,","marked":"Wọ́n wọ asọ̀ àlá"},{"start":3.583,"end":4.97,"text":"Ogun awọn t'a rapada,","marked":"Ogun àwọn t'á ràpadà"},{"start":5.42,"end":6.648,"text":"Wọn kun 'bi 'mọlẹ na;","marked":"Wọ́n kún bí 'mọlẹ ná"},{"start":7.098,"end":8.225,"text":"Ija wọn pẹlu ẹsẹ;","marked":"Ìjà wọn pẹ̀lú ẹsẹ̀"},{"start":8.675,"end":9.848,"text":"At'iku ti pari,","marked":"Àt'ikú ti parí"},{"start":10.298,"end":11.808,"text":"Ẹ si 'lẹkun wura silẹ,","marked":"Ẹ sì 'lẹkun wúrà sílẹ̀"},{"start":12.258,"end":13.517,"text":"Fun awọn asẹgun.","marked":"Fún àwọn asẹ́gun."}],"end":13.517},{"key":"2","start":14.467,"lines":[{"start":14.467,"end":15.555,"text":"Iro Haleluya wọn,","marked":"Ìró Haleluya wọn"},{"start":16.005,"end":17.502,"text":"L'o gb'ayé ọrun kan,","marked":"L'ó gb'ayé ọ̀run kan"},{"start":17.952,"end":19.565,"text":"Iro ẹgbẹgbẹrun Harpu,","marked":"Ìró ẹgbẹgbẹ̀rún Harpu"},{"start":20.015,"end":21.511,"text":"N dun pe 'sẹgun de tan;","marked":"Ń dùn pé 'sẹgun dé tán"},{"start":21.961,"end":23.344,"text":"Ọjọ t'a s'ẹda ayé,","marked":"Ọjọ́ t'á s'ẹ̀dà ayé"},{"start":23.794,"end":25.135,"text":"T'a da oril'ede;","marked":"T'á dá oríl'èdè"},{"start":25.585,"end":27.002,"text":"Ayọ nla pa 'banujẹ rẹ,","marked":"Ayọ̀ ńlá pa 'banujẹ rẹ̀"},{"start":27.452,"end":28.723,"text":"Ti a fun ni kikun.","marked":"Tí a fún ni kíkún."}],"end":28.723},{"key":"3","start":29.673,"lines":[{"start":29.673,"end":31.55,"text":"A! ayọ t'a ko le sọ,","marked":"A! ayọ̀ t'á kò lè sọ"},{"start":32.0,"end":33.315,"text":"L'eti bebe Kenaan;","marked":"L'etí bẹ̀bẹ̀ Kenaan"},{"start":33.765,"end":35.569,"text":"Idapọ nla wo lo to yii,","marked":"Ìdàpọ̀ ńlá wo ló tó yìí"},{"start":36.019,"end":37.304,"text":"Ibi t'a ki pinya;","marked":"Ibi t'á kí pínyà"},{"start":37.754,"end":39.422,"text":"Oju t'o kun f'ẹkun ri,","marked":"Ojú t'ó kún f'ẹkún rí"},{"start":39.872,"end":41.256,"text":"Y'o tun mọ 'lẹ ayọ;","marked":"Y'ó tún mọ̀ 'lẹ ayọ̀"},{"start":41.706,"end":43.161,"text":"Ki yoo si alaini baba,","marked":"Kì yóò sí aláìní Baba"},{"start":43.611,"end":45.003,"text":"Ọpọ ki yoo si mọ.","marked":"Ọ̀pọ̀ kì yóò sì mọ́."}],"end":45.003},{"key":"4","start":45.953,"lines":[{"start":45.953,"end":47.205,"text":"Mu igbala nla Rẹ wa,","marked":"Mú ìgbàlà ńlá Rẹ wá"},{"start":47.655,"end":48.927,"text":"Ọd' aguntan t'a pa;","marked":"Ọd' àgùntàn t'á pa"},{"start":49.377,"end":50.909,"text":"Sọ 'ye awọn ayanfẹ Rẹ,","marked":"Sọ yẹ àwọn àyànfẹ́ Rẹ"},{"start":51.359,"end":52.616,"text":"Mu 'pa Rẹ k'o jọba,","marked":"Mú pa Rẹ̀ k'ó jọba"},{"start":53.066,"end":54.551,"text":"Wa, ifẹ oril' ede,","marked":"Wá, ìfẹ́ oríl èdè"},{"start":55.001,"end":56.257,"text":"Da onde Rẹ silẹ,","marked":"Dá òǹdè Rẹ sílẹ̀"},{"start":56.707,"end":58.042,"text":"Wa fi ami 'leri Rẹ han,","marked":"Wá fi àmì lérí Rẹ hàn"},{"start":58.492,"end":59.715,"text":"Wa, Olugbala wa.","marked":"Wá, Olùgbàlà wa."}],"end":59.715}]}