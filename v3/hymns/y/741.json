{"v":3,"coll":"y","num":741,"id":"hymn_741","title":"lWO ti okunkun","duration":45.68,"voices":{"male":{"file":"y-741-male-v3.m4a","bytes":307761,"sha256":"608871303c686c6ba74ea1e8ca72820c71598699bb7843559b5624b88b5b3d10","duration":45.7},"female":{"file":"y-741-female-v3.m4a","bytes":324152,"sha256":"aab02d0b7606b29daa2f18d102f2633a453c3f9f32364bb57bf4b1c0fd572b75","duration":45.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.241,"text":"lWO ti okunkun","marked":"Ìwọ ti òkùnkùn"},{"start":1.691,"end":2.663,"text":"Gb'oro agbara re","marked":"Gb'ọ̀rọ̀ agbára rẹ"},{"start":3.113,"end":4.24,"text":"T'o si fo lo","marked":"T'ó sì fọ́ lọ"},{"start":4.69,"end":5.81,"text":"Gbo tiwa a mbe O","marked":"Gbọ́ tiwa a mbẹ́ Ọ"},{"start":6.26,"end":7.292,"text":"Nibit' ihinrere","marked":"Níbit ìhìnrere"},{"start":7.742,"end":8.937,"text":"Ko ti tan mole Re","marked":"Kò ti tan mọ́lẹ̀ Rẹ"},{"start":9.387,"end":10.358,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀ wà."}],"end":10.358},{"key":"2","start":11.308,"lines":[{"start":11.308,"end":13.013,"text":"'Wo t'iye apa Re","marked":"wò t'iye apá Rẹ"},{"start":13.463,"end":14.54,"text":"Mu iriran w'aiye","marked":"Mú ìríran w'ayé"},{"start":14.99,"end":15.775,"text":"At'ilera","marked":"Àt'ìlera"},{"start":16.225,"end":17.3,"text":"Ilera ti inu","marked":"Ìlera ti inú"},{"start":17.75,"end":18.816,"text":"Iriran gbogbo enia","marked":"Ìríran gbogbo ẹnià"},{"start":19.266,"end":20.221,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀ wà."}],"end":20.221},{"key":"3","start":21.171,"lines":[{"start":21.171,"end":22.089,"text":"Iwo Emi oto","marked":"Ìwọ Ẹ̀mí ọ̀tọ̀"},{"start":22.539,"end":23.788,"text":"Ti o f'iye fun wa","marked":"Tí ó f'ìyẹ́ fún wa"},{"start":24.238,"end":25.14,"text":"Fo kakiri","marked":"Fọ́ kákiri"},{"start":25.59,"end":26.662,"text":"Gbe fitila anu","marked":"Gbé fìtílà àánú"},{"start":27.112,"end":28.366,"text":"Fo ka oju omi","marked":"Fò ka ojú omi"},{"start":28.816,"end":29.839,"text":"Nibi okunkun nla","marked":"Níbi òkùnkùn ńlá"},{"start":30.289,"end":31.249,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀ wà."}],"end":31.249},{"key":"4","start":32.199,"lines":[{"start":32.199,"end":33.474,"text":"Metalokan Mimo","marked":"Mẹ́talọ́kan Mímọ́"},{"start":33.924,"end":35.181,"text":"Ogbon, lfe, Ipa","marked":"Ọgbọ́n, Ìfẹ́, Ipa"},{"start":35.631,"end":36.588,"text":"Alabukun!","marked":"Alábùkún!"},{"start":37.038,"end":38.287,"text":"B'igbi omi okun","marked":"B'ìgbì omi òkun"},{"start":38.737,"end":39.884,"text":"Ti nyi ni ipa re","marked":"Ti ńyí ní ipa rẹ̀"},{"start":40.334,"end":41.615,"text":"Be ka gbogbo aiye","marked":"Bẹ́ ka gbogbo ayé"},{"start":42.065,"end":43.018,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀ wà."},{"start":43.468,"end":44.13,"text":"Amin.","marked":"Àmín."}],"end":44.13}]}