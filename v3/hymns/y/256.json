{"v":3,"coll":"y","num":256,"id":"hymn_256","title":"BI mo ti ri laisawawi","duration":65.019,"voices":{"male":{"file":"y-256-male-v3.m4a","bytes":478431,"sha256":"f1aa1a0a1ade28ba219cb2dab10a609817fdfdef9edb87d3253bdb50ef8220a8","duration":65.1},"female":{"file":"y-256-female-v3.m4a","bytes":481286,"sha256":"634ddbe7874112d08749c21fe9b855b99a13c74f7572b2386f3151f7e1864e04","duration":65.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.788,"text":"Bi mo ti ri: laisawawi,","marked":"Bí mo ti rí: láìṣàwáwí"},{"start":3.238,"end":4.403,"text":"Sugbọn nitori ẹjẹ Rẹ,","marked":"Sùgbọ́n nítorí ẹ̀jẹ̀ Rẹ"},{"start":4.853,"end":6.554,"text":"B'O si ti pe mi pe ki n wa,","marked":"B'Ó sì ti pè mí pé kí n wá"},{"start":7.004,"end":8.323,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":8.323},{"key":"2","start":9.273,"lines":[{"start":9.273,"end":11.547,"text":"p Bi mo ti ri, laiduro","marked":"p Bí mo ti rí, láìdúró"},{"start":11.997,"end":13.26,"text":"pe Mo fe k'okan mi mo","marked":"pé Mo fẹ́ k'ọkàn mi mọ́"},{"start":13.71,"end":15.178,"text":"toto Sodo Re t'o le we mi","marked":"tọ́tọ̀ Sọ́dọ̀ Rẹ t'ó lè wẹ̀ mi"},{"start":15.628,"end":26.257,"text":"mo Olugbala, mo de. 3 Bi mo ti ri, b'o tilẹ jẹ, Ija lode, ija ninu: Ẹru lode, ẹru ninu, Olugbala mo de.","marked":"mo Olùgbàlà, mo dé. 3 Bí mo ti rí, b'ó tilẹ̀ jẹ́, Ìjà lóde, ìjà nínú: Ẹ̀rù lóde, ẹ̀rù nínú, Olùgbàlà mo dé."}],"end":26.257},{"key":"3","start":27.207,"lines":[{"start":27.207,"end":29.931,"text":"Bi mo ti ri: osi, are,","marked":"Bí mo ti rí: òṣì, àre"},{"start":30.381,"end":32.273,"text":"Mo si n wa, imularada;","marked":"Mo sì ń wá, ìmúláradá"},{"start":32.723,"end":34.066,"text":"Iwọ lo le s'awotan mi,","marked":"Ìwọ ló lè s'àwòtán mi"},{"start":34.516,"end":35.816,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":35.816},{"key":"4","start":36.766,"lines":[{"start":36.766,"end":38.524,"text":"Bi mo ti ri: 'Wo o gba mi","marked":"Bí mo ti rí: wò ó gbà mí"},{"start":38.974,"end":40.579,"text":"'Wo o gba mi towo-tese","marked":"wò ó gbà mí towo-tese"},{"start":41.029,"end":42.343,"text":"“Tori mo gba 'leri Re gbo","marked":"Torí mo gbà lérí Rẹ̀ gbọ́"},{"start":42.793,"end":44.127,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":44.127},{"key":"5","start":45.077,"lines":[{"start":45.077,"end":47.373,"text":"Bi mo ti ri: Ife Tire","marked":"Bí mo ti rí: Ìfẹ́ Tire"},{"start":47.823,"end":49.1,"text":"Lo sete mi patapata","marked":"Lọ ṣètè mi pátápátá"},{"start":49.55,"end":52.185,"text":"Mo di Tire, Tire nikan","marked":"Mo di Tire, Tire nìkan"},{"start":52.635,"end":53.976,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":53.976},{"key":"6","start":54.926,"lines":[{"start":54.926,"end":57.311,"text":"Bi mo ti ri, b'o tile je","marked":"Bí mo ti rí, b'ó tilẹ̀ jẹ́"},{"start":57.761,"end":59.601,"text":"Ija lode, ija ninu","marked":"Ìjà lóde, ìjà nínú"},{"start":60.051,"end":61.714,"text":"Eru lode, eru ninu","marked":"Ẹ̀rù lóde, ẹ̀rù nínú"},{"start":62.164,"end":63.47,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":63.47}]}