{"v":3,"coll":"y","num":800,"id":"hymn_800","title":"ORE-OFE ohun","duration":45.346,"voices":{"male":{"file":"y-800-male.m4a","bytes":312710,"sha256":"2d7952adca8601070d76a30d5e653d96f45f93cd41bbfc80b67e4a5fa5e695ab","duration":45.4},"female":{"file":"y-800-female.m4a","bytes":330383,"sha256":"16ffdac08b99a9637d97eaeea717a73a0b2aec85b8a6383a98202d15178f94f8","duration":45.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.338,"text":"ORE-OFE ohun","marked":"Ọ̀rẹ́-Ọ̀fẹ́ ọ̀hún"},{"start":1.718,"end":3.178,"text":"Adun ni l'eti wa,","marked":"Adùn ni l'etí wa"},{"start":3.558,"end":4.759,"text":"Gbohun-gbohun re y'o","marked":"Gbohùn-gbohùn rẹ̀ y'o"},{"start":5.139,"end":6.035,"text":"gba orun kan,","marked":"gba ọrùn kan"},{"start":6.415,"end":7.809,"text":"Aiye o gbo pelu.","marked":"Aiye ò gbọ́ pẹ̀lú."}],"end":7.809},{"key":"CHORUS","start":8.759,"lines":[{"start":8.759,"end":9.606,"text":"Ore-Ofe sa,","marked":"Ọ̀rẹ́-Ọ̀fẹ́ sà"},{"start":9.986,"end":10.944,"text":"N'igbekele mi,","marked":"N'ígbẹ́kẹ̀lé mi"},{"start":11.324,"end":12.749,"text":"Jesu ku fun araiye,","marked":"Jésù kú fún araiye"},{"start":13.129,"end":14.457,"text":"O ku fun mi pelu.","marked":"Ó kù fún mi pẹ̀lú."}],"end":14.457},{"key":"2","start":15.407,"lines":[{"start":15.407,"end":16.471,"text":"Ore-Ofe l'o ko","marked":"Ọ̀rẹ́-Ọ̀fẹ́ l'ó kọ́"},{"start":16.851,"end":17.949,"text":"Oruko mi l'orun","marked":"Orúkọ mi l'orun"},{"start":18.329,"end":20.061,"text":"L'o fi mi fun Od'agutan,","marked":"L'ó fi mí fún Od'agutan"},{"start":20.441,"end":21.526,"text":"T'o gba iya mi je.","marked":"T'ó gba ìyá mi jẹ."}],"end":21.526},{"key":"3","start":22.476,"lines":[{"start":22.476,"end":23.524,"text":"Ore-ofe to mi,","marked":"Ọ̀rẹ́-ọ̀fẹ́ tó mí"},{"start":23.904,"end":25.024,"text":"S'ona alafia;","marked":"S'ọ́nà àlàáfíà"},{"start":25.404,"end":27.314,"text":"O ntoju mi, lojojumo,","marked":"Ó ńtọ́jú mi, lojojumo"},{"start":27.694,"end":28.906,"text":"Ni irin ajo mi.","marked":"Ní ìrìn àjò mi."}],"end":28.906},{"key":"4","start":29.856,"lines":[{"start":29.856,"end":30.82,"text":"Ore-Ofe ko mi,","marked":"Ọ̀rẹ́-Ọ̀fẹ́ kọ́ mi"},{"start":31.2,"end":32.307,"text":"Bi a ti gbadura,","marked":"Bí a ti gbàdúrà"},{"start":32.687,"end":34.133,"text":"O pr :ni mo titi d'oni","marked":"Ó pr :ni mọ́ títí d'òní"},{"start":34.513,"end":35.939,"text":"Ko si jeki nsako.","marked":"Kò sì jẹ́kí ńṣáko."}],"end":35.939},{"key":"5","start":36.889,"lines":[{"start":36.889,"end":38.716,"text":"Jek' ore-ofe yi,","marked":"Jẹ́k' ọ̀rẹ́-ọ̀fẹ́ yí"},{"start":39.096,"end":40.309,"text":"F'agbara f'okan mi;","marked":"F'ágbára f'ọkàn mi"},{"start":40.689,"end":42.153,"text":"Ki nle fi gbogbo ipa mi,","marked":"Kí ńlẹ̀ fi gbogbo ipá mi"},{"start":42.533,"end":43.796,"text":"At'ojo mi fun O.","marked":"Àt'ọjọ́ mi fún O."}],"end":43.796}]}