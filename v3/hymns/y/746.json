{"v":3,"coll":"y","num":746,"id":"hymn_746","title":"OJO nla l'ojo t'Oluwa","duration":37.269,"voices":{"male":{"file":"y-746-male.m4a","bytes":266634,"sha256":"494a74f6247d28c6b24d3974738322200fcde85aa2bb193fcd9b7607f76ab9bf","duration":37.3},"female":{"file":"y-746-female.m4a","bytes":272285,"sha256":"d1d01dabb43d24d1ba5c66c35712cbe845a09746101308fcf7bc4f2863e32a5f","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.632,"text":"OJO nla l'ojo t'Oluwa","marked":"Ọjọ́ ńlá l'ọjọ́ t'Olúwa"},{"start":2.012,"end":3.575,"text":"Da egbe Serafu sile","marked":"Dá ẹgbẹ́ Séráfù sílẹ̀"},{"start":3.955,"end":5.645,"text":"O ye ki awa ko ma yo","marked":"Ó yẹ kí àwa kó má yọ̀"},{"start":6.025,"end":7.523,"text":"Fun 'fe t'Olorun ni si wa.","marked":"Fún 'fẹ́ t'Ọlọ́run ní sí wa."}],"end":7.523},{"key":"CHORUS","start":8.473,"lines":[{"start":8.473,"end":9.676,"text":"Ojo nla l'ojo na,","marked":"Ọjọ́ ńlá l'ọjọ́ ná"},{"start":10.056,"end":11.787,"text":"T'Olorun d'egbe yi sile","marked":"T'Ọlọ́run d'ẹgbẹ́ yí sílẹ̀"},{"start":12.167,"end":13.586,"text":"O nko wa ka ma gbadura,","marked":"Ó ńkọ́ wa ká má gbàdúrà"},{"start":13.966,"end":15.416,"text":"K'a n'ife si enikeni","marked":"K'á ń'ìfẹ́ sí ẹnikẹ́ni"},{"start":15.796,"end":17.043,"text":"Ojo nla I'ojo na","marked":"Ọjọ́ ńlá l'ọjọ́ ná"},{"start":17.423,"end":18.935,"text":"T'Olorun d'egbe yi sile.","marked":"T'Ọlọ́run d'ẹgbẹ́ yí sílẹ̀."}],"end":18.935},{"key":"2","start":19.885,"lines":[{"start":19.885,"end":21.739,"text":"Gbogbo aiye, e ba wa yo","marked":"Gbogbo aiye, ẹ bá wa yọ̀"},{"start":22.119,"end":23.82,"text":"Fun 'fe t'Olorun ni f'aiye","marked":"Fún 'fẹ́ t'Ọlọ́run ní f'aiye"},{"start":24.2,"end":25.77,"text":"Enyin ta pe si egbe yi","marked":"Enyin ta pé sí ẹgbẹ́ yí"},{"start":26.15,"end":27.585,"text":"E fi ayo korin soke","marked":"Ẹ fi ayọ̀ kọrin sókè"}],"end":27.585},{"key":"3","start":28.535,"lines":[{"start":28.535,"end":29.977,"text":"Ki kerubu fe Serafu,","marked":"Kí Kérúbù fẹ́ Séráfù"},{"start":30.357,"end":31.868,"text":"Ki Serafu fe Kerubu","marked":"Kí Séráfù fẹ́ Kérúbù"},{"start":32.248,"end":33.765,"text":"O ye k'awa ko ma yo","marked":"Ó yé k'áwà kó má yọ̀"},{"start":34.145,"end":35.719,"text":"Fun 'fe t'Olorun ni si wa.","marked":"Fún 'fẹ́ t'Ọlọ́run ní sí wa."}],"end":35.719}]}