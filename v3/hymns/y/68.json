{"v":3,"coll":"y","num":68,"id":"hymn_68","title":"N O korin ti Oludande mi","duration":50.952,"voices":{"male":{"file":"y-68-male-v3.m4a","bytes":373161,"sha256":"bc34ea7afaf3262d949131dffb6d39b7443ad4a0df80c21087e60f53aed25688","duration":51.0},"female":{"file":"y-68-female-v3.m4a","bytes":376438,"sha256":"88591ea52a9f59f8a29334d48cc94be992196b197c2fb1a73093c8dc1f5b7222","duration":51.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.025,"text":"N O korin ti Oludande","marked":"N Ó kọrin ti Olùdáǹdè"},{"start":2.475,"end":3.908,"text":"mi Ati ife iyanu","marked":"mi Àti ìfẹ́ ìyanu"},{"start":4.358,"end":6.317,"text":"Re, O jiya lori'gi oro","marked":"Rẹ̀, Ó jìyà lórí'gi ọ̀rọ̀"},{"start":6.767,"end":15.854,"text":"Lati so mi dom'nira. Kọrin ti - Oludande mi, Ẹjẹ Rẹ l'o fi ra mi O f'ọtẹ rẹ - dariji mi, O sanwo - mo dom'nira.","marked":"Láti sọ mí dọ́m'nira. Kọrin tí Olùdáǹdè mi, Ẹ̀jẹ̀ Rẹ̀ l'ó fi rà mí Ó f'ọ̀tẹ̀ rẹ̀ dáríjì mi, Ó sanwó mọ́ dọ́m'nira."}],"end":15.854},{"key":"CHORUS","start":16.804,"lines":[{"start":16.804,"end":18.305,"text":"Korin ti Oludande mi,","marked":"Kọrin ti Olùdáǹdè mi"},{"start":18.755,"end":20.043,"text":"Eje Re l'o fi ra mi","marked":"Ẹ̀jẹ̀ Rẹ l'ó fi rà mí"},{"start":20.493,"end":21.942,"text":"O f'ote re-dariji mi","marked":"Ó f'ọ̀tẹ̀ re-dariji mi"},{"start":22.392,"end":23.96,"text":"O sanwo-mo dom'nira.","marked":"Ó sanwo-mo dọ́m'nira."}],"end":23.96},{"key":"2","start":24.91,"lines":[{"start":24.91,"end":26.267,"text":"Emi o sọ'tan iyanu Rẹ,","marked":"Èmi ó sọ'tán ìyanu Rẹ"},{"start":26.717,"end":28.091,"text":"B'o ti gbohun mi to ni,","marked":"B'ó ti gbóhùn mi tó ni"},{"start":28.541,"end":30.568,"text":"Nu'fẹ at'anu ailopin","marked":"Nù'fẹ́ àt'ànú àìlópin"},{"start":31.018,"end":32.512,"text":"Fi 'dande fun mi lọfẹ","marked":"Fi dàǹdè fún mi lọ́fẹ́"}],"end":32.512},{"key":"3","start":33.462,"lines":[{"start":33.462,"end":34.757,"text":"N ó y'Oludande mi ọwọn,","marked":"N ó y'Olùdáǹdè mi ọ̀wọ́n"},{"start":35.207,"end":38.621,"text":"N ó r'agbara sẹgun Rẹ,B'o ti fun mi ni isẹgun,","marked":"N ó r'agbára sẹ́gun Rẹ,B'o ti fún mi ní ìsẹ́gun"},{"start":39.071,"end":40.466,"text":"Lor'ẹsẹ at'iparun.","marked":"Lór'ẹsẹ̀ àt'ìparun."}],"end":40.466},{"key":"4","start":41.416,"lines":[{"start":41.416,"end":43.1,"text":"N ó kọrin t'Oludande mi;","marked":"N ó kọrin t'Olùdáǹdè mi"},{"start":43.55,"end":45.173,"text":"T'ifẹ at'ọrun wa Rẹ,","marked":"T'ìfẹ́ àt'ọ̀run wá Rẹ"},{"start":45.623,"end":47.246,"text":"O mu mi lat'iku si'ye,","marked":"Ó mú mi lát'ikú sí'yè"},{"start":47.696,"end":49.402,"text":"Lati ba ọm'Ọlọrun gbe.","marked":"Láti bá ọm'Ọlọ́run gbé."}],"end":49.402}]}