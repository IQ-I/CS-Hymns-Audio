{"v":3,"coll":"y","num":298,"id":"hymn_298","title":"WAKATI didun ni fun mi","duration":39.358,"voices":{"male":{"file":"y-298-male-v3.m4a","bytes":268403,"sha256":"68edca84719c918cd4c167fe4d159a9efb92adcddb489421bb3d81952e6217e2","duration":39.4},"female":{"file":"y-298-female-v3.m4a","bytes":283192,"sha256":"96b6126c5ddfecd5ccb0f244db2fecbc2ead6569dc01d8d1335e0c7def6f7b13","duration":39.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.661,"text":"WAKATI didun ni fun mi","marked":"Wákàtí dídùn ni fún mi"},{"start":2.111,"end":3.216,"text":"Ni wiwo agbelebu","marked":"Ní wíwọ́ àgbélébùú"},{"start":3.666,"end":5.147,"text":"Nibe Jesu fun mi n'iye","marked":"Níbẹ̀ Jésù fún mi n'ìyè"},{"start":5.597,"end":6.853,"text":"'Lera at'alafia.","marked":"lera àt'àlàfíà."}],"end":6.853},{"key":"2","start":7.803,"lines":[{"start":7.803,"end":9.078,"text":"Nihin l'emi o gbe joko,","marked":"Níhìn l'èmi ó gbé jókò"},{"start":9.528,"end":11.01,"text":"La ti wo isun ẹjẹ,","marked":"La ti wọ ìsun ẹ̀jẹ̀"},{"start":11.46,"end":12.765,"text":"Eyi ti y'o wẹ ọkan mi,","marked":"Èyí tí y'ó wẹ ọkàn mi"},{"start":13.215,"end":14.422,"text":"K'Ọlọrun ba le gba mi.","marked":"K'Ọlọ́run bá lè gbà mí."}],"end":14.422},{"key":"3","start":15.372,"lines":[{"start":15.372,"end":16.704,"text":"Niwaju agbelebu Re","marked":"Níwájú àgbélébùú Rẹ"},{"start":17.154,"end":18.457,"text":"L'emi o ba buruburu","marked":"L'èmi ó bá burúburú"},{"start":18.907,"end":20.529,"text":"'Gbati emi bari 'yonu nla","marked":"gbàtí èmi barí yọnu ńlá"},{"start":20.979,"end":22.202,"text":"T'o farahan loju Re.","marked":"T'ó farahàn lójú Rẹ̀."}],"end":22.202},{"key":"4","start":23.152,"lines":[{"start":23.152,"end":24.703,"text":"Ifẹ ati omije mi,","marked":"Ìfẹ́ àti omijé mi"},{"start":25.153,"end":26.405,"text":"Ni n ó fi wẹ ẹsẹ Rẹ,","marked":"Ní n ó fi wẹ ẹsẹ̀ Rẹ"},{"start":26.855,"end":28.023,"text":"'Tori mo mọ pe iku Rẹ,","marked":"torí mo mọ̀ pé ikú Rẹ̀"},{"start":28.473,"end":29.702,"text":"Y'o mu iye wa fun mi.","marked":"Y'ó mú iye wá fún mi."}],"end":29.702},{"key":"5","start":30.652,"lines":[{"start":30.652,"end":32.286,"text":"Oluwa, jo gba ebe mi,","marked":"Olúwa, jọ gba ẹ̀bẹ̀ mi"},{"start":32.736,"end":34.023,"text":"Se okan mi ni Tire","marked":"Ṣe ọkàn mi ní Tìrẹ"},{"start":34.473,"end":35.833,"text":"Tit' emi o fi ri 'gbala","marked":"Tít èmi ó fi rí gbàlà"},{"start":36.283,"end":37.808,"text":"At'oju Re n'nu ogo.","marked":"Àt'ojú Rẹ̀ n'nú ògo."}],"end":37.808}]}