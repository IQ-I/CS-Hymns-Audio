{"v":3,"coll":"y","num":673,"id":"hymn_673","title":"GBA T'O ba de gba t'o ba de","duration":32.351,"voices":{"male":{"file":"y-673-male-v3.m4a","bytes":219766,"sha256":"49a10502fcc2fad7bfd87cdb75c78b2aefabe407a68536a22c6e12e0e9306ad2","duration":32.4},"female":{"file":"y-673-female-v3.m4a","bytes":227930,"sha256":"7ad8e3c025cb4e9985a7051c3430fa887f96eed2f59726e42ec0e4a4b924c114","duration":32.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.163,"text":"GBA T'O ba de gba t'o ba de,","marked":"Gba T'Ó bá dé gba t'ó bá dé"},{"start":2.613,"end":3.784,"text":"Lati sir' ọsọ Rẹ,","marked":"Láti ṣír ọ̀sọ́ Rẹ"},{"start":4.234,"end":5.758,"text":"Gbogb' ọsọ Rẹ iyebiye,","marked":"Gbogb ọ̀sọ́ Rẹ iyebíye"},{"start":6.208,"end":7.331,"text":"Awọn ti o fẹ.","marked":"Àwọn tí ó fẹ́."}],"end":7.331},{"key":"CHORUS","start":8.281,"lines":[{"start":8.281,"end":10.345,"text":"Bi irawo owuro, wọn","marked":"Bí ìràwọ̀ òwúrọ̀, wọ́n"},{"start":10.795,"end":11.565,"text":"n s'ade Re","marked":"ń s'adé Rẹ̀"},{"start":12.015,"end":13.14,"text":"loso Ewa won o yo","marked":"lọ́ṣọ́ Ẹwà wọn ó yọ"},{"start":13.59,"end":14.894,"text":"pupo Ewa f'ade Re.","marked":"púpọ̀ Ẹwà f'adé Rẹ."}],"end":14.894},{"key":"2","start":15.844,"lines":[{"start":15.844,"end":17.784,"text":"Yio ko jọ, yoo ko jọ,","marked":"Yóò kò jọ, yóò kò jọ"},{"start":18.234,"end":19.299,"text":"Osọ ijọba Rẹ,","marked":"Òsọ́ ìjọba Rẹ̀"},{"start":19.749,"end":21.938,"text":"Awọn mimọ, awọn didan,","marked":"Àwọn mímọ́, àwọn dídán"},{"start":22.388,"end":23.47,"text":"Awọn ti o fẹ.","marked":"Àwọn tí ó fẹ́."}],"end":23.47},{"key":"3","start":24.42,"lines":[{"start":24.42,"end":25.934,"text":"Awọn ewe, awọn ewe,","marked":"Àwọn èwe, àwọn èwe"},{"start":26.384,"end":27.359,"text":"T'o fẹ Olugbala,","marked":"T'ó fẹ́ Olùgbàlà"},{"start":27.809,"end":29.293,"text":"Ni ọsọ Rẹ iyebiye,","marked":"Ní ọ̀sọ́ Rẹ iyebíye"},{"start":29.743,"end":30.801,"text":"Awọn ti o fẹ.","marked":"Àwọn tí ó fẹ́."}],"end":30.801}]}