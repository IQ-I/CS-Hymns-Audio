{"v":3,"coll":"y","num":630,"id":"hymn_630","title":"KERUBU Serafu, e damure","duration":110.327,"voices":{"male":{"file":"y-630-male-v3.m4a","bytes":736964,"sha256":"2c237a04b40720a5e9ab34267246c3228d92416a86174c645e057587ceeab2da","duration":110.4},"female":{"file":"y-630-female-v3.m4a","bytes":759190,"sha256":"6b7c7fbbb5d265891910f31be867583e525dcb4b69462f449c2cd65f33d2447c","duration":110.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.881,"text":"KÉRÚBÙ Séráfù, ẹ damure,","marked":"Kérúbù Séráfù, ẹ dàmúrè"},{"start":3.331,"end":4.257,"text":"Ẹ mura giri (3)","marked":"Ẹ múra gírí"},{"start":4.707,"end":5.816,"text":"Ẹyin eniyan mi.","marked":"Ẹ̀yin ènìyàn mi."}],"end":5.816},{"key":"2","start":6.766,"lines":[{"start":6.766,"end":8.688,"text":"E gb' asia yin soke s'Oba","marked":"Ẹ gb àsíá yín sókè s'Ọba"},{"start":9.138,"end":10.319,"text":"ogo E mura giri (3) &c.","marked":"ògo Ẹ múra gírí"}],"end":10.319},{"key":"3","start":11.269,"lines":[{"start":11.269,"end":12.96,"text":"Olubukun l'Ẹni t'o mbo l'oko Re","marked":"Olùbùkún l'Ẹni t'ó mbọ̀ l'ọkọ Rẹ̀"},{"start":13.41,"end":14.351,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":14.351},{"key":"4","start":15.301,"lines":[{"start":15.301,"end":17.19,"text":"E lo wo Mattiu ori kedogbon","marked":"Ẹ lọ wo Mattiu orí kẹ́dọ́gbọ̀n"},{"start":17.64,"end":18.528,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":18.528},{"key":"5","start":19.478,"lines":[{"start":19.478,"end":22.054,"text":"E mase bi wundia marun t'o s'aigbọn, E","marked":"Ẹ máṣe bí wúńdíá márùn t'ó s'àìgbọ́n, Ẹ"},{"start":22.504,"end":23.333,"text":"mura giri (3) &c.","marked":"múra gírí"}],"end":23.333},{"key":"6","start":24.283,"lines":[{"start":24.283,"end":26.336,"text":"Sugbon se bi wundia marun t'o l'ogbon","marked":"Ṣùgbọ́n ṣe bí wúńdíá márùn t'ó l'ọgbọ́n"},{"start":26.786,"end":27.688,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":27.688},{"key":"7","start":28.638,"lines":[{"start":28.638,"end":31.286,"text":"E f'ororo s'atupa yin, Serafu","marked":"Ẹ f'òróró s'àtùpá yín, Séráfù"},{"start":31.736,"end":32.603,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":32.603},{"key":"8","start":33.553,"lines":[{"start":33.553,"end":36.041,"text":"E f'ororo s'atupa yin, Kerubu","marked":"Ẹ f'òróró s'àtùpá yín, Kérúbù"},{"start":36.491,"end":37.363,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":37.363},{"key":"9","start":38.313,"lines":[{"start":38.313,"end":39.769,"text":"Emi L'ENISAJU at'","marked":"Èmi L'Ẹniṣájú àt"},{"start":40.219,"end":41.694,"text":"ẸNIKẸHIN E mura giri (3) &c.","marked":"Ẹnìkẹ́hìn Ẹ múra gírí"}],"end":41.694},{"key":"10","start":42.644,"lines":[{"start":42.644,"end":44.513,"text":"Ẹyin ayanfe mi ti mo ti yan","marked":"Ẹ̀yin àyànfẹ́ mi tí mo ti yàn"},{"start":44.963,"end":45.851,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":45.851},{"key":"11","start":46.801,"lines":[{"start":46.801,"end":48.486,"text":"E mase tun sunmo ohun aimo","marked":"Ẹ máṣe tún súnmọ́ ohun àìmọ́"},{"start":48.936,"end":49.864,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":49.864},{"key":"12","start":50.814,"lines":[{"start":50.814,"end":52.974,"text":"W'Ori kejileladota Isaiah","marked":"W'Orí kejìléládọ́ta Isaiah"},{"start":53.424,"end":54.343,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":54.343},{"key":"13","start":55.293,"lines":[{"start":55.293,"end":57.041,"text":"E du k'e j'eni gbala nitoto","marked":"Ẹ dù k'é j'ẹni gbàlà nítòtọ́"},{"start":57.491,"end":58.405,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":58.405},{"key":"14","start":59.355,"lines":[{"start":59.355,"end":61.24,"text":"Ẹyin Olori ati Omo ese","marked":"Ẹ̀yin Olórí àti Ọmọ ẹ̀ṣẹ̀"},{"start":61.69,"end":62.564,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":62.564},{"key":"15","start":63.514,"lines":[{"start":63.514,"end":65.21,"text":"Jade lo wasu ihin-rere Mi","marked":"Jáde lọ wàṣù ihin-rere Mi"},{"start":65.66,"end":66.51,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":66.51},{"key":"16","start":67.46,"lines":[{"start":67.46,"end":69.529,"text":"E so f'awon ore at'ara wa","marked":"Ẹ sọ f'àwọn ọ̀rẹ́ àt'ara wa"},{"start":69.979,"end":70.857,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":70.857},{"key":"17","start":71.807,"lines":[{"start":71.807,"end":73.545,"text":"Ki wọn w'oko igbala k'o to kun","marked":"Kí wọ́n w'ọkọ ìgbàlà k'ó tó kún"},{"start":73.995,"end":74.899,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":74.899},{"key":"18","start":75.849,"lines":[{"start":75.849,"end":77.535,"text":"Kerubu Seraf' l'oko 'gbala na","marked":"Kérúbù Seraf l'ọ̀kọ̀ gbàlà ná"},{"start":77.985,"end":78.915,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":78.915},{"key":"19","start":79.865,"lines":[{"start":79.865,"end":81.873,"text":"Wo Mattiu karun ese ketala","marked":"Wo Mattiu karùn ẹsẹ̀ kẹtàlá"},{"start":82.323,"end":83.257,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":83.257},{"key":"20","start":84.207,"lines":[{"start":84.207,"end":86.297,"text":"Ade Ogo y'o je tiyin ni kehin","marked":"Adé Ògo y'ó jẹ́ tiyín ní kẹ̀hìn"},{"start":86.747,"end":87.715,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":87.715},{"key":"21","start":88.665,"lines":[{"start":88.665,"end":90.284,"text":"E ma sona pelu adura E","marked":"Ẹ má ṣọ́nà pẹ̀lú àdúrà Ẹ"},{"start":90.734,"end":91.584,"text":"mura giri (3) &c.","marked":"múra gírí"}],"end":91.584},{"key":"22","start":92.534,"lines":[{"start":92.534,"end":94.227,"text":"E mura giri ẹyin eniyan mi","marked":"Ẹ múra gírí ẹ̀yin ènìyàn mi"},{"start":94.677,"end":95.613,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":95.613},{"key":"23","start":96.563,"lines":[{"start":96.563,"end":98.269,"text":"E fi Ogo fun Baba wa l'oke","marked":"Ẹ fi Ògo fún Baba wa l'òkè"},{"start":98.719,"end":99.603,"text":"E mura giri (3) &c.","marked":"Ẹ múra gírí"}],"end":99.603},{"key":"24","start":100.553,"lines":[{"start":100.553,"end":102.616,"text":"E f'Ogo f'Omo at' ẸMI","marked":"Ẹ f'Ògo f'Ọmọ àt Ẹ̀mí"},{"start":103.066,"end":104.069,"text":"MIMO E mura giri (3) &c.","marked":"Mímọ́ Ẹ múra gírí"}],"end":104.069},{"key":"25","start":105.019,"lines":[{"start":105.019,"end":106.502,"text":"EMI ni O wa tit' ayé","marked":"Èmi ni Ó wà tít ayé"},{"start":106.952,"end":108.78,"text":"AINIPEKUN E mura giri (3) &c.","marked":"Àìnípẹ̀kun Ẹ múra gírí"}],"end":108.78}]}