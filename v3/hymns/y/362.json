{"v":3,"coll":"y","num":362,"id":"hymn_362","title":"E GBO b'awon Angeli ti","duration":44.735,"voices":{"male":{"file":"y-362-male-v3.m4a","bytes":298859,"sha256":"bd6a867869c41ddd21d957d4b6c16b4a6f8ba3df26b867fbe34f7eeb2a86f2da","duration":44.8},"female":{"file":"y-362-female-v3.m4a","bytes":306628,"sha256":"26334f2538583b79e30a5fe538ebbdae8129a7274633c102f9e3f5f4dfdf382d","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.97,"text":"Ẹ GBỌ b'awọn Angẹli ti","marked":"Ẹ Gbọ́ b'àwọn Áńgẹ́lì tí"},{"start":2.42,"end":3.723,"text":"Ń fi Ogo f'Ọlọrun ,","marked":"Ń fi Ògo f'Ọlọ́run"},{"start":4.173,"end":5.354,"text":"Ati awọn Olus' Àgùntàn,","marked":"Àti àwọn Olùṣ Àgùntàn"},{"start":5.804,"end":6.772,"text":"Ń fi'yin fun Un.","marked":"Ń fi'yìn fún Un."}],"end":6.772},{"key":"2","start":7.722,"lines":[{"start":7.722,"end":9.035,"text":"Gbogbo ogun ọrun pẹlu,","marked":"Gbogbo ogun ọ̀run pẹ̀lú"},{"start":9.485,"end":10.368,"text":"Agba mejila,","marked":"Àgbà méjìlá"},{"start":10.818,"end":12.259,"text":"Kérúbù pẹlu Séráfù,","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":12.709,"end":13.704,"text":"Ń fi'yin fun Un.","marked":"Ń fi'yìn fún Un."}],"end":13.704},{"key":"3","start":14.654,"lines":[{"start":14.654,"end":16.609,"text":"Ọkẹ meje at'ẹgbaaji,","marked":"Ọ̀kẹ́ méje àt'ẹgbàajì"},{"start":17.059,"end":17.95,"text":"Awọn Agba woli,","marked":"Àwọn Àgbà wòlí"},{"start":18.4,"end":19.826,"text":"Awọn t'o ń fẹ l'Olugbala,","marked":"Àwọn t'ó ń fẹ́ l'Olùgbàlà"},{"start":20.276,"end":21.291,"text":"Ń fi'yin fun Un.","marked":"Ń fi'yìn fún Un."}],"end":21.291},{"key":"4","start":22.241,"lines":[{"start":22.241,"end":24.454,"text":"Gbogb' Ogun ọrun, ẹ ho ye","marked":"Gbogb Ogun ọ̀run, ẹ hó yẹ"},{"start":24.904,"end":26.259,"text":"Ayé gbọ iro naa,","marked":"Ayé gbọ́ ìró náà"},{"start":26.709,"end":28.059,"text":"Imisi Ẹmi ba le wa;","marked":"Ìmísí Ẹ̀mí bá lè wà"},{"start":28.509,"end":29.37,"text":"Awa yin!","marked":"Àwa yín!"}],"end":29.37},{"key":"5","start":30.32,"lines":[{"start":30.32,"end":31.888,"text":"N'tori naa awa Kérúbù,","marked":"N'torí náà àwa Kérúbù"},{"start":32.338,"end":33.273,"text":"Ati Séráfù,","marked":"Àti Séráfù"},{"start":33.723,"end":35.067,"text":"Ninu aginju ayé yi,","marked":"Nínú aginjù ayé yí"},{"start":35.517,"end":36.354,"text":"Ń yin Baba.","marked":"Ń yin Baba."}],"end":36.354},{"key":"6","start":37.304,"lines":[{"start":37.304,"end":38.591,"text":"Ogo fun Baba Olore","marked":"Ògo fún Baba Ọlọ́rẹ̀"},{"start":39.041,"end":40.015,"text":"Ogo f'Omo Re","marked":"Ògo f'Ọmọ Rẹ"},{"start":40.465,"end":41.647,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":42.097,"end":43.186,"text":"Loke Orun.","marked":"Lókè Ọ̀run."}],"end":43.186}]}