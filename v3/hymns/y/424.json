{"v":3,"coll":"y","num":424,"id":"hymn_424","title":"JE ki ilekun aitase","duration":34.373,"voices":{"male":{"file":"y-424-male-v3.m4a","bytes":238648,"sha256":"e0f8c5107be99bdb3a7c52a7ebfd9e5189904096a5d7ae9dacd6b8b3165ba23a","duration":34.4},"female":{"file":"y-424-female-v3.m4a","bytes":250962,"sha256":"3d3adbbaa40a58423272781a06f9f84f1a53d79006f1183de015c924e3a8f836","duration":34.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.845,"text":"JE ki ilekun aitase","marked":"Jẹ́ kí ìlẹ̀kùn àìtàsé"},{"start":2.295,"end":4.285,"text":"Si fun ise wa, Oluwa","marked":"Sì fún iṣẹ́ wa, Olúwa"},{"start":4.735,"end":6.088,"text":"Ti o si ti ki o ti mo","marked":"Tí ó sì ti kí ó ti mọ̀"},{"start":6.538,"end":8.009,"text":"Ilekun 'wole oro re.","marked":"Ìlẹ̀kùn wọlé ọ̀rọ̀ rẹ̀."}],"end":8.009},{"key":"2","start":8.959,"lines":[{"start":8.959,"end":10.468,"text":"F'ọwọ ina tọ ete wọn","marked":"F'ọwọ́ iná tọ̀ ètè wọn"},{"start":10.918,"end":12.512,"text":"Ti n fi 'lana Rẹ han ayé;","marked":"Tí ń fi lànà Rẹ̀ han ayé"},{"start":12.962,"end":14.525,"text":"F'ifẹ mimọ si aya wọn,","marked":"F'ìfẹ́ mímọ́ sí aya wọn"},{"start":14.975,"end":16.359,"text":"Ti Ọlọrun at'eniyan.","marked":"Ti Ọlọ́run àt'ènìyàn."}],"end":16.359},{"key":"3","start":17.309,"lines":[{"start":17.309,"end":18.706,"text":"F'itara fun iransẹ Rẹ,","marked":"F'ìtara fún ìránsẹ́ Rẹ"},{"start":19.156,"end":20.857,"text":"T'ohun kan ko le mu tutu;","marked":"T'ohun kan kò lè mú tútù"},{"start":21.307,"end":22.619,"text":"Bi wọn si n tan ọrọ Rẹ,","marked":"Bí wọ́n sì ń tan ọ̀rọ̀ Rẹ"},{"start":23.069,"end":24.672,"text":"Bukun imọ at'isẹ wọn.","marked":"Bùkún ìmọ̀ àt'isẹ́ wọn."}],"end":24.672},{"key":"4","start":25.622,"lines":[{"start":25.622,"end":27.155,"text":"Ran Emi Re lat'oke wa","marked":"Rán Ẹ̀mí Rẹ̀ lát'òkè wá"},{"start":27.605,"end":29.124,"text":"Ma je ki agbara Re pin","marked":"Má jẹ́ kí agbára Rẹ pín"},{"start":29.574,"end":31.142,"text":"Tit'irira o fi pari,","marked":"Tít'ìríra ó fi parí"},{"start":31.592,"end":32.824,"text":"Ti gbogbo ija o si tan.","marked":"Tí gbogbo ìjà ó sì tàn."}],"end":32.824}]}