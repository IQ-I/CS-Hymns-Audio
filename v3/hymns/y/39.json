{"v":3,"coll":"y","num":39,"id":"hymn_39","title":"K'OJO 'sinmi yi to tan","duration":40.246,"voices":{"male":{"file":"y-39-male-v3.m4a","bytes":272466,"sha256":"fa584a3e12820c8d0bda74b2807cfe9997b2e3e9f54b6c59df066c4024a9ae1c","duration":40.3},"female":{"file":"y-39-female-v3.m4a","bytes":284615,"sha256":"93e1dc8544a40f66805cf2432897e4e0729c214986859bf31d30f1f264e581fd","duration":40.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.162,"text":"K'ỌJỌ 'sinmi yi to tan,","marked":"K'Ọjọ́ sinmi yí tó tán"},{"start":2.612,"end":4.073,"text":"K'a to lọ f'ara le'lẹ,","marked":"K'á tó lọ f'ara lé'lẹ́"},{"start":4.523,"end":5.928,"text":"Awa wolẹ l'ẹsẹ Rẹ,","marked":"Àwa wólẹ̀ l'ẹsẹ̀ Rẹ"},{"start":6.378,"end":7.576,"text":"A n kọrin iyin si Ọ.","marked":"A ń kọrin ìyìn sí Ọ."}],"end":7.576},{"key":"2","start":8.526,"lines":[{"start":8.526,"end":9.716,"text":"Fun anu ọjọ oni,","marked":"Fún àánú ọjọ́ òní"},{"start":10.166,"end":11.348,"text":"Fun isinmi lọna wa,","marked":"Fún ìsinmi lọ́nà wa"},{"start":11.798,"end":13.223,"text":"'Wọ nikan l'a f'ọpẹ fun","marked":"'Wọ nìkan l'á f'ọpẹ́ fún"},{"start":13.673,"end":15.051,"text":"Oluwa at'Ọba wa","marked":"Olúwa àt'Ọba wa"}],"end":15.051},{"key":"3","start":16.001,"lines":[{"start":16.001,"end":17.344,"text":"Isin wa ko nilari","marked":"Ìsìn wa kò nílárí"},{"start":17.794,"end":19.045,"text":"Adura wa lù m'ẹsẹ;","marked":"Àdúrà wa lù m'ẹsẹ̀"},{"start":19.495,"end":21.067,"text":"Sugbọn 'Wọ l'o n f'ẹsẹ ji,","marked":"Sùgbọ́n 'Wọ l'ó ń f'ẹsẹ̀ jí"},{"start":21.517,"end":22.903,"text":"Or'ọfẹ Rẹ to fun wa.","marked":"Or'ọ̀fẹ́ Rẹ̀ tó fún wa."}],"end":22.903},{"key":"4","start":23.853,"lines":[{"start":23.853,"end":25.114,"text":"Jẹ k'ifẹ Rẹ ma tọ wa,","marked":"Jẹ́ k'ìfẹ́ Rẹ má tọ̀ wá"},{"start":25.564,"end":26.951,"text":"B'a ti n rin'na ayé yi;","marked":"B'á ti ń rìn'ná ayé yí"},{"start":27.401,"end":28.861,"text":"Nigba t'ajo wa ba pin,","marked":"Nígbà t'àjọ wa bá pín"},{"start":29.311,"end":30.772,"text":"K'a le sinmi lọdọ Rẹ.","marked":"K'á lè sinmi lọ́dọ̀ Rẹ."}],"end":30.772},{"key":"5","start":31.722,"lines":[{"start":31.722,"end":33.203,"text":"K'ọjọ 'sinmi wọnyi jẹ","marked":"K'ọjọ́ sinmi wọ̀nyí jẹ́"},{"start":33.653,"end":34.646,"text":"Ibẹrẹ ayọ ọrun;","marked":"Ìbẹ̀rẹ̀ ayọ̀ ọ̀run"},{"start":35.096,"end":36.535,"text":"B'a ti n rin ajo wa lọ,","marked":"B'á ti ń rìn àjọ wa lọ"},{"start":36.985,"end":38.696,"text":"S' isinmi ti ko l'opin.","marked":"Ṣ ìsinmi tí kò l'òpin."}],"end":38.696}]}