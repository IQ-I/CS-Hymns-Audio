{"v":3,"coll":"y","num":679,"id":"hymn_679","title":"K'IYA wa, Efa to d'ese","duration":71.139,"voices":{"male":{"file":"y-679-male-v3.m4a","bytes":504226,"sha256":"b7361689f0688fbf5f5db2009b6008fa452a0129274a2ef6df253b5b987d727d","duration":71.2},"female":{"file":"y-679-female-v3.m4a","bytes":523646,"sha256":"c70423d26a8c95a478e805f0ce784d915023f3e904bad70b394c8e3604036dd6","duration":71.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.002,"text":"K'IYA wa, Efa, to d'ẹsẹ,","marked":"K'Ìyá wá, Efa, tó d'ẹ̀sẹ̀"},{"start":3.452,"end":4.982,"text":"Tal'o mọ ohun ti njẹ asọ?","marked":"Tál'ó mọ ohun tí ǹjẹ́ asọ̀?"},{"start":5.432,"end":6.934,"text":"Ohun t'a fi bo l'asiri,","marked":"Ohun t'a fi bọ́ l'àṣírí"},{"start":7.384,"end":8.901,"text":"Pada d'ohun irira rẹ.","marked":"Padà d'ohun ìríra rẹ."}],"end":8.901},{"key":"2","start":9.851,"lines":[{"start":9.851,"end":11.48,"text":"'Gba t'o ko gb'ewe ọpọtọ wọ,","marked":"gbà t'ó kò gb'èwe ọ̀pọ̀tọ́ wọ"},{"start":11.93,"end":13.584,"text":"Ọsọ ―iwa mimọ‖ rẹ lọ!","marked":"Ọ̀sọ́ ―ìwà mímọ́‖ rẹ̀ lọ!"},{"start":14.034,"end":15.334,"text":"Sa wo bi awa ọmọ rẹ","marked":"Sá wo bí àwa ọmọ rẹ"},{"start":15.784,"end":17.56,"text":"Ti n f'i bo 'tiju yi sogo.","marked":"Tí ń f'í bọ́ tijú yí ṣògo."}],"end":17.56},{"key":"3","start":18.51,"lines":[{"start":18.51,"end":20.359,"text":"Wo! b'igberaga wa ti to,","marked":"Wò! b'ìgbéraga wa ti tó"},{"start":20.809,"end":22.517,"text":"'Gba t'a ba gb'asọ titun wọ;","marked":"gbà t'á bá gb'asọ títún wọ̀"},{"start":22.967,"end":24.455,"text":"B'eni pe awọn kokoro,","marked":"B'ẹni pé àwọn kòkòrò"},{"start":24.905,"end":26.334,"text":"At'aguntan ko ti n wọ wọn.","marked":"Àt'àgùntàn kò ti ń wọ wọ́n."}],"end":26.334},{"key":"4","start":27.284,"lines":[{"start":27.284,"end":28.751,"text":"Wo arẹwa labalaba,","marked":"Wo arẹwà lábàlábà"},{"start":29.201,"end":30.522,"text":"Ati itanna pulpit;","marked":"Àti ìtànná pulpit"},{"start":30.972,"end":32.469,"text":"B'asọ mi ti wu ko pọ to,","marked":"B'asọ mi ti wù kò pọ̀ tó"},{"start":32.919,"end":34.369,"text":"Ko t'abọ ti awọn wọnyi.","marked":"Kò t'abọ ti àwọn wọ̀nyí."}],"end":34.369},{"key":"5","start":35.319,"lines":[{"start":35.319,"end":36.918,"text":"Njẹ n ó ma fi ọkan mi wa,","marked":"Ǹjẹ́ n ó má fi ọkàn mi wá"},{"start":37.368,"end":38.672,"text":"Ohun ọsọ t'o ju wọn lọ;","marked":"Ohun ọ̀sọ́ t'ó jù wọ́n lọ"},{"start":39.122,"end":40.863,"text":"Iwa rere at'otitọ,","marked":"Ìwà rere àt'òtítọ́"},{"start":41.313,"end":43.09,"text":"L'ọsọ to ju gbogb' ọsọ lọ.","marked":"L'ọ̀sọ́ tó ju gbogb ọ̀sọ́ lọ."}],"end":43.09},{"key":"6","start":44.04,"lines":[{"start":44.04,"end":45.425,"text":"Nigba na l'emi y'o dara,","marked":"Nígbà ná l'èmi y'ó dára"},{"start":45.875,"end":47.183,"text":"Pupọ j'awọn kokoro lọ,","marked":"Púpọ̀ j'àwọn kòkòrò lọ"},{"start":47.633,"end":48.846,"text":"Ọsọ awọn angel l'eyi,","marked":"Ọ̀sọ́ àwọn angẹl l'èyí"},{"start":49.296,"end":50.553,"text":"Ati t'Ọm' Ọlọrun pẹlu.","marked":"Àti t'Ọm' Ọlọ́run pẹ̀lú."}],"end":50.553},{"key":"7","start":51.503,"lines":[{"start":51.503,"end":54.185,"text":"Ki ti, ki gbo, ki sa titi,","marked":"Kí tí, kí gbọ́, kì sá títí"},{"start":54.635,"end":56.011,"text":"Ipara ko si le bajẹ,","marked":"Ìpara kò sì lè bàjẹ́"},{"start":56.461,"end":58.971,"text":"T'ojo t'ẹrun, bakan naa ni","marked":"T'ọjọ́ t'ẹrùn, bákan náà ni"},{"start":59.421,"end":60.928,"text":"Lilo ki ba ẹwa jẹ.","marked":"Lílò kì bá ẹwà jẹ́."}],"end":60.928},{"key":"8","start":61.878,"lines":[{"start":61.878,"end":63.299,"text":"Eyi n ó ma wọ layé,","marked":"Èyí n ó má wọ̀ layé"},{"start":63.749,"end":65.329,"text":"Ki n le ma wọ l'ọrun pẹlu;","marked":"Kí n lè má wọ̀ l'ọ̀run pẹ̀lú"},{"start":65.779,"end":67.339,"text":"Ọsọ t'o w'Ọlọrun l'eyi,","marked":"Ọ̀sọ́ t'ó w'Ọlọ́run l'èyí"},{"start":67.789,"end":69.59,"text":"Ogo ati ayọ Rẹ ni.","marked":"Ògo àti ayọ̀ Rẹ̀ ni."}],"end":69.59}]}