{"v":3,"coll":"y","num":729,"id":"hymn_729","title":"Gba wa Olorun igbala wa","duration":69.74,"voices":{"male":{"file":"y-729-male-v3.m4a","bytes":487914,"sha256":"9e291dffdf0acecade914506d39581549c7657b1ab31565715a1b9bdace5acb2","duration":69.8},"female":{"file":"y-729-female-v3.m4a","bytes":504450,"sha256":"0f102ac9583480071b5399473a622e815a05c0b68d8993273befa4f1add8d718","duration":69.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.843,"text":"E dide omo-ogun gbala","marked":"Ẹ dìde omo-ogun gbàlà"},{"start":2.293,"end":3.646,"text":"Gbe oruko Jesu ga","marked":"Gbé orúkọ Jésù ga"},{"start":4.096,"end":5.798,"text":"Fun ojo nla t'a ri loni","marked":"Fún ọjọ́ ńlá t'a rí lónì"},{"start":6.248,"end":7.963,"text":"Ti Maikeli Balogun wa.","marked":"Ti Maikeli Balógun wà."}],"end":7.963},{"key":"CHORUS","start":8.913,"lines":[{"start":8.913,"end":10.79,"text":"Maikeli Mimo Balogun","marked":"Maikeli Mímọ́ Balógun"},{"start":11.24,"end":13.223,"text":"Maikeli Mimo Balogun","marked":"Maikeli Mímọ́ Balógun"},{"start":13.673,"end":15.338,"text":"S'amona Egbe wa d'opin","marked":"S'amọ̀nà Ẹgbẹ́ wa d'òpin"},{"start":15.788,"end":17.331,"text":"B'awa segun Lusifa.","marked":"B'àwa ṣẹ́gun Lusifa."}],"end":17.331},{"key":"2","start":18.281,"lines":[{"start":18.281,"end":19.968,"text":"A dupe pe o je tiwa","marked":"A dúpẹ́ pé ó jẹ́ tiwa"},{"start":20.418,"end":21.595,"text":"Larin Egbe Serafu","marked":"Lárin Ẹgbẹ́ Séráfù"},{"start":22.045,"end":23.639,"text":"Ko si b'esu tile gb'ogun","marked":"Kò sì b'eṣú tilẹ̀ gb'ogun"},{"start":24.089,"end":25.732,"text":"Maikeli a bori won.","marked":"Maikeli a borí wọn."}],"end":25.732},{"key":"3","start":26.682,"lines":[{"start":26.682,"end":28.435,"text":"L'ojo na t'ogun gb'orun kan","marked":"L'ọjọ́ ná t'ogun gb'ọ̀run kan"},{"start":28.885,"end":30.297,"text":"Orun, aiye wariri","marked":"Ọ̀run, ayé wárìrì"},{"start":30.747,"end":32.151,"text":"lberu nla l'o gb'aiye kan","marked":"Ìbẹ̀rù ńlá l'ó gb'àìyè kan"},{"start":32.601,"end":34.298,"text":"Maikiel f'oko e g'esu.","marked":"Maikiel f'ọkọ ẹ̀ g'èṣù."}],"end":34.298},{"key":"4","start":35.248,"lines":[{"start":35.248,"end":36.899,"text":"Mo gb'ohun na lati orun wa","marked":"Mo gb'ohùn ná láti ọ̀run wá"},{"start":37.349,"end":38.699,"text":"Pe egbe ni fun aiye","marked":"Pé ègbé ni fún ayé"},{"start":39.149,"end":40.408,"text":"A le olufisun s'aiye","marked":"A lé olùfisùn s'ayé"},{"start":40.858,"end":42.644,"text":"Awon ayanfe yio la.","marked":"Àwọn àyànfẹ́ yóò là."}],"end":42.644},{"key":"5","start":43.594,"lines":[{"start":43.594,"end":44.88,"text":"Egbe Kerubu ma beru","marked":"Ẹgbẹ́ Kérúbù má bẹ̀rù"},{"start":45.33,"end":46.736,"text":"Pe Maikeli je tiwa","marked":"Pé Maikeli jẹ́ tiwa"},{"start":47.186,"end":49.66,"text":"Oso, aje ko n'ipa mo","marked":"Ọ̀ṣọ́, ajé kò n'ipa mọ́"},{"start":50.11,"end":51.408,"text":"Lori Egbe Mimo yi.","marked":"Lórí Ẹgbẹ́ Mímọ́ yí."}],"end":51.408},{"key":"6","start":52.358,"lines":[{"start":52.358,"end":54.274,"text":"Jesu, Omo Mimo Baba","marked":"Jésù, Ọmọ Mímọ́ Baba"},{"start":54.724,"end":56.41,"text":"A f;ogo f'Oruko Re","marked":"A f;ogo f'Orúkọ Rẹ̀"},{"start":56.86,"end":58.733,"text":"Pe Maikeli ti segun esu","marked":"Pé Maikeli ti ṣẹ́gun èṣù"},{"start":59.183,"end":60.463,"text":"Awon ogun esu fo.","marked":"Àwọn ogun èṣù fọ́."}],"end":60.463},{"key":"7","start":61.413,"lines":[{"start":61.413,"end":62.928,"text":"Gbati pe 'kehin ba si dun","marked":"Gbátí pé kẹ́hìn bá sì dùn"},{"start":63.378,"end":64.465,"text":"Olorun awa mbe O","marked":"Ọlọ́run àwa mbẹ́ Ọ"},{"start":64.915,"end":66.429,"text":"Ma jek' owo esu te wa","marked":"Má jẹ́k ọwọ́ èṣù tẹ̀ wá"},{"start":66.879,"end":68.191,"text":"K'a si le gb'ade iye.","marked":"K'á sì lè gb'adé ìyè."}],"end":68.191}]}