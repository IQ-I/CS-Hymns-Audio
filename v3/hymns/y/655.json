{"v":3,"coll":"y","num":655,"id":"hymn_655","title":"BABA Olodumare","duration":58.683,"voices":{"male":{"file":"y-655-male-v3.m4a","bytes":396364,"sha256":"dce518f2c64019f65e2dc9e9dff3bb63ffe6a92dddb019337debc87b3e147459","duration":58.7},"female":{"file":"y-655-female-v3.m4a","bytes":416558,"sha256":"a8f6b7fdb2ffc97063f4b7e1f72ed01bbb0ac5359eb963e62e4c66b197dbdb15","duration":58.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.315,"text":"BABA Olodumare,","marked":"Baba Olódùmarè"},{"start":1.765,"end":2.753,"text":"A n tọrọ anu Rẹ;","marked":"À ń tọrọ àánú Rẹ̀"},{"start":3.203,"end":4.476,"text":"S'ori arakunrin yi,","marked":"S'orí arákùnrin yí"},{"start":4.926,"end":6.1,"text":"At'arabinrin yi.","marked":"At'arábìnrin yí."}],"end":6.1},{"key":"2","start":7.05,"lines":[{"start":7.05,"end":8.693,"text":"S'ọkan ọkọ oun aya,","marked":"S'ọkàn ọkọ òun aya"},{"start":9.143,"end":10.132,"text":"F'ibẹru Rẹ fun wọn,","marked":"F'ìbẹ̀rù Rẹ fún wọn"},{"start":10.582,"end":11.993,"text":"Ki wọn n'ifẹ ara wọn,","marked":"Kí wọ́n n'ìfẹ́ ara wọn"},{"start":12.443,"end":13.573,"text":"Ni ọjọ ayé wọn.","marked":"Ní ọjọ́ ayé wọn."}],"end":13.573},{"key":"3","start":14.523,"lines":[{"start":14.523,"end":15.87,"text":"Ran esi rere si wa","marked":"Rán èsì rere sí wa"},{"start":16.32,"end":17.639,"text":"K'awa si le mo pe","marked":"K'àwa sì lè mọ̀ pé"},{"start":18.089,"end":19.559,"text":"Gbogbo eto oni yi","marked":"Gbogbo ètò òní yí"},{"start":20.009,"end":20.903,"text":"Je didun inu Re.","marked":"Jẹ́ dídùn inú Rẹ̀."}],"end":20.903},{"key":"4","start":21.853,"lines":[{"start":21.853,"end":22.953,"text":"Iru ọjọ bi oni,","marked":"Irú ọjọ́ bí òní"},{"start":23.403,"end":24.525,"text":"Jehovah Jireh wa;","marked":"Jehovah Jireh wà"},{"start":24.975,"end":26.251,"text":"Wa lati f'ibukun fun,","marked":"Wá láti f'ìbùkún fún"},{"start":26.701,"end":27.605,"text":"Awọn eniyan Rẹ.","marked":"Àwọn ènìyàn Rẹ."}],"end":27.605},{"key":"5","start":28.555,"lines":[{"start":28.555,"end":29.952,"text":"Se wọn ni abiyamọ,","marked":"Ṣé wọn ní abiyamọ"},{"start":30.402,"end":31.47,"text":"Ki wọn ko si ma rẹ,","marked":"Kí wọn kò sì má rẹ̀"},{"start":31.92,"end":33.545,"text":"Ẹranko ati ẹyẹ,","marked":"Ẹranko àti ẹyẹ"},{"start":33.995,"end":35.287,"text":"Wọn mbi lọpọlọpọ.","marked":"Wọ́n mbí lọ́pọ̀lọpọ̀."}],"end":35.287},{"key":"6","start":36.237,"lines":[{"start":36.237,"end":37.583,"text":"F'ayọ oun alafia,","marked":"F'ayọ̀ òun àlàáfíà"},{"start":38.033,"end":39.187,"text":"Pẹlu itẹlọrun;","marked":"Pẹ̀lú ìtẹ́lọ́rùn"},{"start":39.637,"end":40.685,"text":"S'ile awọn ọmọ Rẹ,","marked":"S'ilé àwọn ọmọ Rẹ"},{"start":41.135,"end":42.458,"text":"Pese fun aini wọn.","marked":"Pèsè fún àìní wọn."}],"end":42.458},{"key":"7","start":43.408,"lines":[{"start":43.408,"end":44.504,"text":"Ki adun lọna gbogbo,","marked":"Kí adùn lọ́nà gbogbo"},{"start":44.954,"end":46.176,"text":"Yi wọn ka lat'oni;","marked":"Yí wọn ká lát'òní"},{"start":46.626,"end":48.309,"text":"K'ire ma ba wọn titi,","marked":"K'írẹ́ má bá wọn títí"},{"start":48.759,"end":50.137,"text":"K'a ayé ma le ya wọn.","marked":"K'á ayé má lè yà wọn."}],"end":50.137},{"key":"8","start":51.087,"lines":[{"start":51.087,"end":52.316,"text":"Baba Onibu-ore","marked":"Baba Onibu-ore"},{"start":52.766,"end":53.582,"text":"Ran ore Re si won","marked":"Rán ọrẹ Rẹ̀ sí wọn"},{"start":54.032,"end":55.215,"text":"Mu won bori gbogbo ota","marked":"Mú wọn borí gbogbo ọ̀tá"},{"start":55.665,"end":57.134,"text":"Si je Olorun won.","marked":"Sì jẹ́ Ọlọ́run wọn."}],"end":57.134}]}