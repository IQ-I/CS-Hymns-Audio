{"v":3,"coll":"y","num":612,"id":"hymn_612","title":"OHUN aye b'aye lo","duration":98.994,"voices":{"male":{"file":"y-612-male-v3.m4a","bytes":691600,"sha256":"4000d39728f62403b6f0eaacb89ce8b9b9e179f284a47300d585d09ded42f270","duration":99.0},"female":{"file":"y-612-female-v3.m4a","bytes":720223,"sha256":"2c5b652795fa1ed40e6544cf74e5dbd7029b1ac27493d56f916ce166808e2657","duration":99.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.374,"text":"OHUN ayé b'ayé lo","marked":"Ohun ayé b'ayé lọ"},{"start":1.824,"end":3.531,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":3.981,"end":5.847,"text":"Ilu ti a te sori oke","marked":"Ìlú tí a tẹ́ sórí òkè"},{"start":6.297,"end":10.726,"text":"A ko le fara sin. Jẹ ka soto (3) Ka le ri 'gbala nikẹyin.","marked":"A kò lè fara sin. Jẹ́ ká sọ́tọ̀ Ká lè rí gbàlà níkẹyìn."}],"end":10.726},{"key":"CHORUS","start":11.676,"lines":[{"start":11.676,"end":12.766,"text":"Je ka soto - (3)","marked":"Jẹ́ ká sọ́tọ̀"},{"start":13.216,"end":14.214,"text":"Ka le ri gbala","marked":"Ká lè rí gbàlà"},{"start":14.664,"end":15.501,"text":"nikehin.","marked":"níkẹ̀hìn."}],"end":15.501},{"key":"2","start":16.451,"lines":[{"start":16.451,"end":17.477,"text":"Ohun ayé b'ayé lọ,","marked":"Ohun ayé b'ayé lọ"},{"start":17.927,"end":19.862,"text":"Ẹ ranti ti aya Loti,","marked":"Ẹ rántí ti aya Lọti"},{"start":20.312,"end":21.523,"text":"Ti o boju wo ẹhin;","marked":"Tí ó bojú wo ẹ̀hìn"},{"start":21.973,"end":23.186,"text":"Ti o fi di ọwọn iyọ","marked":"Tí ó fi di ọ̀wọ́n iyọ̀"},{"start":23.636,"end":24.702,"text":"Jẹ ka soto (3)","marked":"Jẹ́ ká sọ́tọ̀"}],"end":24.702},{"key":"3","start":25.652,"lines":[{"start":25.652,"end":26.732,"text":"Ohun ayé b'ayé lọ,","marked":"Ohun ayé b'ayé lọ"},{"start":27.182,"end":28.363,"text":"Ẹ ranti ọjọ Mose,","marked":"Ẹ rántí ọjọ́ Mósè"},{"start":28.813,"end":30.331,"text":"Ti Farao fi ri s'okun,","marked":"Tí Farao fi rí s'òkun"},{"start":30.781,"end":32.266,"text":"Ti Israel fi ri igbala.","marked":"Tí Israẹl fi rí ìgbàlà."},{"start":32.716,"end":33.745,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":33.745},{"key":"4","start":34.695,"lines":[{"start":34.695,"end":35.789,"text":"Ohun ayé b'ayé lọ,","marked":"Ohun ayé b'ayé lọ"},{"start":36.239,"end":37.431,"text":"Ẹ ranti Ọjọ Noah,","marked":"Ẹ rántí Ọjọ́ Noah"},{"start":37.881,"end":39.045,"text":"T'ọmọ eniyan fi n pẹgan,","marked":"T'ọmọ ènìyàn fi ń pẹ̀gàn"},{"start":39.495,"end":40.971,"text":"Ti ẹranko fi ri igbala","marked":"Tí ẹranko fi rí ìgbàlà"},{"start":41.421,"end":42.385,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":42.385},{"key":"5","start":43.335,"lines":[{"start":43.335,"end":44.444,"text":"Ẹyin Ẹgbẹ Oloye,","marked":"Ẹ̀yin Ẹgbẹ́ Olóye"},{"start":44.894,"end":46.433,"text":"At'ẹyin ẹgbẹ Mary;","marked":"Àt'ẹ̀yin ẹgbẹ́ Mary"},{"start":46.883,"end":48.499,"text":"Baba yoo wa pẹlu yin,","marked":"Baba yóò wà pẹ̀lú yín"},{"start":48.949,"end":50.708,"text":"Yoo di yin lamure ododo.","marked":"Yóò di yín lámùrè òdodo."},{"start":51.158,"end":52.195,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":52.195},{"key":"6","start":53.145,"lines":[{"start":53.145,"end":54.323,"text":"Ẹyin Ẹgbẹ Martha,","marked":"Ẹ̀yin Ẹgbẹ́ Martha"},{"start":54.773,"end":55.964,"text":"Ati Ayaba Esther,","marked":"Àti Ayaba Esther"},{"start":56.414,"end":57.839,"text":"Ẹ mura la ti sisẹ yin,","marked":"Ẹ múra la ti sisẹ́ yín"},{"start":58.289,"end":59.51,"text":"Baba yoo se iranwọ","marked":"Baba yóò ṣe ìrànwọ́"},{"start":59.96,"end":60.98,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":60.98},{"key":"7","start":61.93,"lines":[{"start":61.93,"end":63.195,"text":"Ẹyin Ẹgbẹ Akọrin,","marked":"Ẹ̀yin Ẹgbẹ́ Akọrin"},{"start":63.645,"end":65.016,"text":"Ati 'Tan-lẹhin Jesu;","marked":"Àti 'Tan-lẹhin Jésù"},{"start":65.466,"end":66.924,"text":"Ẹ mura lati sisẹ yin,","marked":"Ẹ múra láti sisẹ́ yín"},{"start":67.374,"end":68.807,"text":"Jesu yoo se iranwọ","marked":"Jésù yóò ṣe ìrànwọ́"},{"start":69.257,"end":70.254,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":70.254},{"key":"8","start":71.204,"lines":[{"start":71.204,"end":72.546,"text":"Mose Orimọlade,","marked":"Mósè Orímọ́ládé"},{"start":72.996,"end":74.372,"text":"O ti lọ soke ọrun;","marked":"Ó ti lọ sókè ọ̀run"},{"start":74.822,"end":76.38,"text":"O dapọ mọ awọn Angel,","marked":"Ó dàpọ̀ mọ́ àwọn Angẹl"},{"start":76.83,"end":78.17,"text":"O ti gbade Ogo.","marked":"Ó ti gbàdé Ògo."},{"start":78.62,"end":79.678,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":79.678},{"key":"9","start":80.628,"lines":[{"start":80.628,"end":81.934,"text":"Ẹyin Ẹgb' Aladura,","marked":"Ẹ̀yin Ẹgb' Aládúrà"},{"start":82.384,"end":83.618,"text":"Ẹ ku asẹyinde;","marked":"Ẹ kú àsẹyìndè"},{"start":84.068,"end":85.519,"text":"Baba yoo tu yin ninu,","marked":"Baba yóò tù yín nínú"},{"start":85.969,"end":87.431,"text":"Yio gb'ọwọ yin soke.","marked":"Yóò gb'ọwọ́ yín sókè."},{"start":87.881,"end":88.866,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":88.866},{"key":"10","start":89.816,"lines":[{"start":89.816,"end":90.928,"text":"Ogo ni fun Baba wa,","marked":"Ògo ni fún Baba wa"},{"start":91.378,"end":92.501,"text":"Ogo ni fun Ọmọ Rẹ,","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":92.951,"end":94.119,"text":"Ogo ni fun Ẹmi Mimọ ,","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":94.569,"end":95.95,"text":"Mẹtalọkan lailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":96.4,"end":97.446,"text":"Jẹ ka sotọ (3)","marked":"Jẹ́ ká sótọ̀"}],"end":97.446}]}