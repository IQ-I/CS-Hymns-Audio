{"v":3,"coll":"y","num":817,"id":"hymn_817","title":"EMI ti n ji oku dide","duration":87.991,"voices":{"male":{"file":"y-817-male-v3.m4a","bytes":627795,"sha256":"4cda00a7f0a928dd655eb8fe89979d725f84aa351c0cfdfaaba86b343c9c00ef","duration":88.0},"female":{"file":"y-817-female-v3.m4a","bytes":650865,"sha256":"879367e2aa27fb46cc99759ee8472873b02977179a761d56789f54fc9fa4356e","duration":88.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.027,"text":"ẸMI ti n ji oku dide,","marked":"Ẹ̀mí ti ń jí òkú dìde"},{"start":2.477,"end":3.848,"text":"A wolẹ niwaju Rẹ,","marked":"A wólẹ̀ níwájú Rẹ̀"},{"start":4.298,"end":5.598,"text":"Na 'wọ emi 'yẹ Rẹ si wa,","marked":"Na 'wọ ẹ̀mí 'yẹ Rẹ̀ sí wa"},{"start":6.048,"end":7.45,"text":"Ko sọ gbogbo wa d'ọtun;","marked":"Kò sọ gbogbo wa d'ọ̀tun"},{"start":7.9,"end":9.052,"text":"Ọmọ Baba to d'eniyan,","marked":"Ọmọ Baba tó d'ènìyàn"},{"start":9.502,"end":10.846,"text":"Woli, Alufa, Oluwa,","marked":"Wòlí, Àlùfá, Olúwa"}],"end":10.846},{"key":"CHORUS","start":11.796,"lines":[{"start":11.796,"end":13.15,"text":"Olugbala, Olugbala","marked":"Olùgbàlà, Olùgbàlà"},{"start":13.6,"end":14.954,"text":"Olugbala, gba wa la.","marked":"Olùgbàlà, gbà wá là."}],"end":14.954},{"key":"2","start":15.904,"lines":[{"start":15.904,"end":17.404,"text":"Ẹgbẹ Kérúbù ayé yi,","marked":"Ẹgbẹ́ Kérúbù ayé yí"},{"start":17.854,"end":19.224,"text":"Ẹ se ara yin lọkan;","marked":"Ẹ ṣe ara yín lọ́kàn"},{"start":19.674,"end":21.165,"text":"Ẹgbẹ Séráfù ayé yi,","marked":"Ẹgbẹ́ Séráfù ayé yí"},{"start":21.615,"end":22.897,"text":"Ẹ fi ọkan kan sise;","marked":"Ẹ fi ọkàn kan ṣiṣẹ́"},{"start":23.347,"end":24.629,"text":"Ran wa lọwọ ka sisẹ Rẹ,","marked":"Ràn wá lọ́wọ́ ká sisẹ́ Rẹ̀"},{"start":25.079,"end":26.246,"text":"Ma mase se aseti;","marked":"Má máṣe ṣe àṣetí"}],"end":26.246},{"key":"3","start":27.196,"lines":[{"start":27.196,"end":28.741,"text":"Ma sisẹ l'orukọ Jesu,","marked":"Má sisẹ́ l'orúkọ Jésù"},{"start":29.191,"end":30.35,"text":"Mase wo awọn ẹlẹgan;","marked":"Máṣe wo àwọn ẹlẹ́gàn"},{"start":30.8,"end":32.239,"text":"Si Matteu ori kẹwa,","marked":"Sí Matteu orí kẹwà"},{"start":32.689,"end":34.031,"text":"W'ẹsẹ kẹrindilogun,","marked":"W'ẹsẹ̀ kẹrìndílógún"},{"start":34.481,"end":35.854,"text":"Sọkalẹ ninu ọlanla,","marked":"Sọ̀kalẹ̀ nínú ọláńlá"},{"start":36.304,"end":37.753,"text":"Sarin Ẹgbẹ Séráfù.","marked":"Sarin Ẹgbẹ́ Séráfù."}],"end":37.753},{"key":"4","start":38.703,"lines":[{"start":38.703,"end":40.242,"text":"F'ojurere wo 'dapọ wa,","marked":"F'ojúrere wo 'dapọ wa"},{"start":40.692,"end":42.029,"text":"F'ọrọ mimọ Rẹ ye wa,","marked":"F'ọ̀rọ̀ mímọ́ Rẹ yẹ wá"},{"start":42.479,"end":44.132,"text":"Fitila t'o ran sarin wa,","marked":"Fìtílà t'ó rán sárín wa"},{"start":44.582,"end":46.013,"text":"Ma ba wa b'ororo si;","marked":"Má bá wá b'òróró sí"},{"start":46.463,"end":47.75,"text":"Nigba t'ọta ba sunmọ wa,","marked":"Nígbà t'ọ̀tá bá súnmọ́ wa"},{"start":48.2,"end":49.903,"text":"Jesu, jọwọ sunmọ wa.","marked":"Jésù, jọ̀wọ́ súnmọ́ wa."}],"end":49.903},{"key":"5","start":50.853,"lines":[{"start":50.853,"end":52.613,"text":"Okunkun yoo b'oju ọrun,","marked":"Òkùnkùn yóò b'ojú ọ̀run"},{"start":53.063,"end":55.144,"text":"Isẹlẹ nla y'o si sẹ,","marked":"Ìsẹ̀lẹ̀ ńlá y'ó sì sẹ́"},{"start":55.594,"end":56.784,"text":"Awọn irawọ y'o ma ja,","marked":"Àwọn ìràwọ̀ y'ó má jà"},{"start":57.234,"end":58.444,"text":"Gẹgẹ bi ọjọ ti n ro,","marked":"Gẹ́gẹ́ bí ọjọ́ tí ń rọ̀"},{"start":58.894,"end":60.111,"text":"Ẹ ma jafara adura,","marked":"Ẹ má jáfara àdúrà"},{"start":60.561,"end":61.912,"text":"Gbogbo ẹyin eniyan mi.","marked":"Gbogbo ẹ̀yin ènìyàn mi."}],"end":61.912},{"key":"6","start":62.862,"lines":[{"start":62.862,"end":64.268,"text":"Nigba t'o ba d'ọjọ kẹhin,","marked":"Nígbà t'ó bá d'ọjọ́ kẹhìn"},{"start":64.718,"end":66.157,"text":"T'ọmọ ko ni mọ baba,","marked":"T'ọmọ kò ní mọ Baba"},{"start":66.607,"end":68.245,"text":"Ma doju ti wa l'ọjọ na,","marked":"Má dojú ti wá l'ọjọ́ ná"},{"start":68.695,"end":70.145,"text":"Gb'awa Ẹgbẹ Séráfù;","marked":"Gb'àwa Ẹgbẹ́ Séráfù"},{"start":70.595,"end":71.889,"text":"Ran wa lọwọ ka sisẹ Rẹ,","marked":"Ràn wá lọ́wọ́ ká sisẹ́ Rẹ̀"},{"start":72.339,"end":73.972,"text":"K'a le ma ja f'otitọ.","marked":"K'á lè má jà f'òtítọ́."}],"end":73.972},{"key":"7","start":74.922,"lines":[{"start":74.922,"end":76.527,"text":"Ẹ f'ogo fun Baba loke,","marked":"Ẹ f'ògo fún Baba lókè"},{"start":76.977,"end":78.269,"text":"Ẹ f'ogo fun Ọmọ Rẹ,","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":78.719,"end":80.156,"text":"Ẹ f'ogo fun Ẹmi Mimọ ,","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́"},{"start":80.606,"end":82.503,"text":"Mẹtalọkan a juba,","marked":"Mẹ́talọ́kan a júbà"},{"start":82.953,"end":84.734,"text":"Oungbẹ rẹ ma n gbẹ ọkan wa","marked":"Òùngbẹ rẹ̀ má ń gbẹ ọkàn wá"},{"start":85.184,"end":86.442,"text":"Fi mana ọrun bọ wa.","marked":"Fi màná ọ̀run bọ̀ wá."}],"end":86.442}]}