{"v":3,"coll":"y","num":37,"id":"hymn_37","title":"OJO mefa t'ise koja","duration":44.34,"voices":{"male":{"file":"y-37-male-v3.m4a","bytes":313957,"sha256":"d9ce3f6c610a8b591bd4a9c9ba5136926f084ecf32bb26ea065e9cd5ff03e6e8","duration":44.4},"female":{"file":"y-37-female-v3.m4a","bytes":324176,"sha256":"4f3b5de2bbe81b20b8952386ba52a0d763bdf4f1ae1ef33d30ce7a12610a5e44","duration":44.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.147,"text":"ỌJỌ mẹfa t'isẹ kọja,","marked":"Ọjọ́ mẹ́fà t'isẹ́ kọjá"},{"start":2.597,"end":3.836,"text":"Ọkan t'isinmi si bẹrẹ:","marked":"Ọkàn t'ìsinmi sì bẹ̀rẹ̀"},{"start":4.286,"end":5.893,"text":"Wa, ọkan mi si 'sinmi rẹ,","marked":"Wá, ọkàn mi sì sinmi rẹ̀"},{"start":6.343,"end":8.135,"text":"Y'ọ s'ọjọ t'Ọlọrun busi","marked":"Y'ọ́ s'ọ́jọ́ t'Ọlọ́run bùṣì"}],"end":8.135},{"key":"2","start":9.085,"lines":[{"start":9.085,"end":10.747,"text":"Ki 'ronu at'ọpe wa nde,","marked":"Kí ronú àt'ọpé wa ńdẹ"},{"start":11.197,"end":12.615,"text":"Bi ẹbọ turari s'ọrun,","marked":"Bí ẹbọ tùràrí s'ọ̀run"},{"start":13.065,"end":14.718,"text":"K'o le fa inu didun wa;","marked":"K'ó lè fa inú dídùn wá"},{"start":15.168,"end":16.654,"text":"T'o jẹ t'ẹni t'O mọ nikan.","marked":"T'ó jẹ́ t'ẹni t'Ó mọ nìkan."}],"end":16.654},{"key":"3","start":17.604,"lines":[{"start":17.604,"end":19.018,"text":"Ibalẹ aya ọrun yi,","marked":"Ìbàlẹ̀ aya ọ̀run yí"},{"start":19.468,"end":20.828,"text":"L'eri isinmi t'o l'ogo;","marked":"L'ẹ́rí ìsinmi t'ó l'ògo"},{"start":21.278,"end":22.426,"text":"T'o wa fun eniyan mimọ,","marked":"T'ó wà fún ènìyàn mímọ́"},{"start":22.876,"end":24.586,"text":"p Opin aniyan at'aisan.","marked":"p Òpin àníyàn àt'àìsàn."}],"end":24.586},{"key":"4","start":25.536,"lines":[{"start":25.536,"end":27.408,"text":"f Ọlọrun , a yọ si'sẹ Rẹ,","marked":"f Ọlọ́run , a yọ sì'sẹ Rẹ̀"},{"start":27.858,"end":29.72,"text":"L'oniruru t'o gbọ t'ọtun","marked":"L'onírúrú t'ó gbọ́ t'ọ̀tún"},{"start":30.17,"end":31.866,"text":"A fi'yin ro anu t'o lo,","marked":"A fi'yín rọ àánú t'ó lọ"},{"start":32.316,"end":33.851,"text":"A ni 'reti s'eyi ti mbọ","marked":"A ní retí s'èyí ti mbọ̀"}],"end":33.851},{"key":"5","start":34.801,"lines":[{"start":34.801,"end":36.251,"text":"F'oni sesin mimọ jalẹ,","marked":"F'òní ṣẹ̀sìn mímọ́ jálẹ̀"},{"start":36.701,"end":38.394,"text":"K'o si se inu didun si;","marked":"K'ó sì ṣe inú dídùn sí"},{"start":38.844,"end":40.827,"text":"f B'o ti dun lati l'ọjọ yi,","marked":"f B'ó ti dùn láti l'ọjọ́ yí"},{"start":41.277,"end":42.791,"text":"Nireti ọkan ailopin?","marked":"Nírètí ọkàn àìlópin?"}],"end":42.791}]}