{"v":3,"coll":"y","num":6,"id":"hymn_6","title":"OLUWA mi, mo njade lo","duration":51.173,"voices":{"male":{"file":"y-6-male-v3.m4a","bytes":349705,"sha256":"92d024ca259e25e159414b5cb7ade26ca354c6f59c0365bc11d16f8fee7acd65","duration":51.2},"female":{"file":"y-6-female-v3.m4a","bytes":363451,"sha256":"7191d11bdf9cf497e4d0d4c5fc415b1dd6d3316bfa615b9f345625cc16e4bbfc","duration":51.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.091,"text":"OLUWA mi, mo njade lo,","marked":"Olúwa mi, mo ńjáde lọ"},{"start":2.541,"end":3.758,"text":"Lati seise ojo mi,","marked":"Láti ṣẹiṣẹ́ ọjọ́ mi"},{"start":4.208,"end":5.391,"text":"lwo nikan l'emi o mo,","marked":"Ìwọ nìkan l'èmi ó mọ̀"},{"start":5.841,"end":7.719,"text":"L'oro l'ero, ati n'ise.","marked":"L'ọ̀rọ̀ l'èrò, àti n'iṣẹ́."}],"end":7.719},{"key":"2","start":8.669,"lines":[{"start":8.669,"end":10.097,"text":"Ise t'o yan mi l'anu Re","marked":"Iṣẹ́ t'ó yàn mí l'àánú Rẹ̀"},{"start":10.547,"end":11.954,"text":"Jeki nle se tayo tayo","marked":"Jẹ́kí ńlè ṣe tayọ tayọ"},{"start":12.404,"end":13.751,"text":"Ki nroju Re ni ise mi","marked":"Kí ńrojú Rẹ ni iṣẹ́ mi"},{"start":14.201,"end":15.573,"text":"K'emi si le f'ife Re han.","marked":"K'èmi sì lè f'ìfẹ́ Rẹ hàn."}],"end":15.573},{"key":"3","start":16.523,"lines":[{"start":16.523,"end":17.994,"text":"Dabobo mi mi lowo 'danwo","marked":"Dàbòbò mi mí lọ́wọ́ dánwò"},{"start":18.444,"end":19.854,"text":"K ' o pa okan mi mo kuro,","marked":"K ' ó pa ọkàn mi mọ́ kúrò"},{"start":20.304,"end":21.882,"text":"L'owo aniyan aiye yi,","marked":"L'ọ́wọ́ àníyàn ayé yí"},{"start":22.332,"end":23.753,"text":"Ati gbogbo ifekufe.","marked":"Àti gbogbo ìfẹ́kúfẹ́."}],"end":23.753},{"key":"4","start":24.703,"lines":[{"start":24.703,"end":25.936,"text":"lwo t'oju Re r'okan mi,","marked":"Ìwọ t'ojú Rẹ r'ọkàn mi"},{"start":26.386,"end":27.802,"text":"Ma wa low'otun mi titi","marked":"Má wà lọ́w'ọ̀tún mi títí"},{"start":28.252,"end":29.672,"text":"Ki mma sise lo lase Re,","marked":"Kí mmá ṣiṣẹ́ lọ láṣẹ Rẹ"},{"start":30.122,"end":31.421,"text":"Ki nf'ise mi gbogbo fun O.","marked":"Kí ńf'iṣẹ́ mi gbogbo fún Ọ."}],"end":31.421},{"key":"5","start":32.371,"lines":[{"start":32.371,"end":34.072,"text":"Je ki nr'eru Re t'o fuye","marked":"Jẹ́ kí ńr'ẹ̀rù Rẹ t'ó fúyẹ́"},{"start":34.522,"end":35.986,"text":"Ki mma sora nigbagbogbo;","marked":"Kí mmá ṣọ́ra nígbàgbogbo"},{"start":36.436,"end":38.243,"text":"Ki mma f'oju si nkan t'orun","marked":"Kí mmá f'ojú sí nǹkan t'ọ̀run"},{"start":38.693,"end":40.483,"text":"Ki nsi mura d'ojo ogo.","marked":"Kí ńsì múra d'ọjọ́ ògo."}],"end":40.483},{"key":"6","start":41.433,"lines":[{"start":41.433,"end":42.691,"text":"Ohunkohun t'o fi fun mi,","marked":"Ohunkóhun t'ó fi fún mi"},{"start":43.141,"end":44.451,"text":"Jeki nle lo fun ago Re,","marked":"Jẹ́kí ńlè lọ fún àgọ́ Rẹ"},{"start":44.901,"end":46.283,"text":"Ki nf'ayo sure ije mi,","marked":"Kí ńf'ayọ̀ súre ìjẹ mi"},{"start":46.733,"end":48.639,"text":"Ki mba O rin titi d'orun.","marked":"Kí mbá Ó rìn títí d'ọ̀run."},{"start":49.089,"end":49.624,"text":"Amin.","marked":"Àmín."}],"end":49.624}]}