{"v":3,"coll":"y","num":152,"id":"hymn_152","title":"'WO, owon Olurapada","duration":33.581,"voices":{"male":{"file":"y-152-male-v3.m4a","bytes":230578,"sha256":"a732af610c54d81209a4a27d983ebcca0213a5fd813f88acf7cc1db360d0aa54","duration":33.6},"female":{"file":"y-152-female-v3.m4a","bytes":241618,"sha256":"277d60491f33753335018bebbc73c55a52f485bc6793abfa074f036a96a9f270","duration":33.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.67,"text":"'WO, owon Olurapada","marked":"wò, ọ̀wọ́n Olùràpadà"},{"start":2.12,"end":3.199,"text":"A fe ma gburo Re","marked":"A fẹ́ má gbúrò Rẹ"},{"start":3.649,"end":5.324,"text":"Ko s'orin bi oruko Re,","marked":"Kò s'orin bí orúkọ Rẹ"},{"start":5.774,"end":7.001,"text":"T'o le dun t'abo re.","marked":"T'ó lè dùn t'abo rẹ̀."}],"end":7.001},{"key":"2","start":7.951,"lines":[{"start":7.951,"end":10.153,"text":"A! a ba le ma gbohun Re,","marked":"A! a bá lè má gbóhùn Rẹ̀"},{"start":10.603,"end":11.618,"text":"L'anu soro si wa,","marked":"L'àánú sọ̀rọ̀ sí wa"},{"start":12.068,"end":13.868,"text":"Nin' Alufa wa l'a o yo","marked":"Nín Àlùfá wa l'á ó yọ"},{"start":14.318,"end":15.795,"text":"Melkisedek giga.","marked":"Melkisedek gíga."}],"end":15.795},{"key":"3","start":16.745,"lines":[{"start":16.745,"end":18.378,"text":"Jesu ni y'o se orin wa,","marked":"Jésù ni y'ó ṣe orin wa"},{"start":18.828,"end":20.032,"text":"Nigba t'a wa l'ayé,","marked":"Nígbà t'á wà l'ayé"},{"start":20.482,"end":21.848,"text":"A o kọrin ifẹ Jesu,","marked":"A ó kọrin ìfẹ́ Jésù"},{"start":22.298,"end":23.651,"text":"'Gba nkan gbogbo bajẹ.","marked":"gba nǹkan gbogbo bàjẹ́."}],"end":23.651},{"key":"4","start":24.601,"lines":[{"start":24.601,"end":26.079,"text":"Nigba 'ba yọ soke lọhun,","marked":"Nígbà bá yọ sókè lọ́hùn"},{"start":26.529,"end":28.12,"text":"Pẹlu 'jọ, ẹni Rẹ,","marked":"Pẹ̀lú 'jọ, ẹni Rẹ"},{"start":28.57,"end":30.103,"text":"'Gbna a o kọrin kikan,","marked":"gbná a ó kọrin kíkan"},{"start":30.553,"end":32.031,"text":"Krist' ni y'o j'orin wa.","marked":"Krist ni y'ó j'orin wà."}],"end":32.031}]}