{"v":3,"coll":"y","num":478,"id":"hymn_478","title":"OLORUN 'Wo l'agbara mi","duration":37.878,"voices":{"male":{"file":"y-478-male-v3.m4a","bytes":256415,"sha256":"fb7cc8096aae8dfed9a88b1985a8958f63875491b94c7216f64408b9feed9842","duration":37.9},"female":{"file":"y-478-female-v3.m4a","bytes":262042,"sha256":"52265ca40994786672f2e14eedbbed6685b318485b84b0f014aebf106b298279","duration":37.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.788,"text":"OLORUN 'Wo l'agbara mi","marked":"Ọlọ́run wò l'agbára mi"},{"start":2.238,"end":3.333,"text":"Emi o feran re","marked":"Èmi ó fẹ́ràn rẹ"},{"start":3.783,"end":5.465,"text":"Iwo l'odi at'abo mi","marked":"Ìwọ l'odi àt'abo mi"},{"start":5.915,"end":6.911,"text":"Ni igba aini mi.","marked":"Ní ìgbà àìní mi."}],"end":6.911},{"key":"2","start":7.861,"lines":[{"start":7.861,"end":9.365,"text":"Ni 'gba 'rora oun 'banujẹ,","marked":"Ní gba rora òun 'banujẹ"},{"start":9.815,"end":11.092,"text":"Mo tọrọ or'-ọfẹ ,","marked":"Mo tọrọ or'-ọfẹ"},{"start":11.542,"end":12.693,"text":"Ọlọrun gbọ aroye mi","marked":"Ọlọ́run gbọ́ àròyé mi"},{"start":13.143,"end":14.2,"text":"Lat' ibi mimọ Rẹ.","marked":"Lát ibi mímọ́ Rẹ."}],"end":14.2},{"key":"3","start":15.15,"lines":[{"start":15.15,"end":16.574,"text":"Ati ninu ọla-nla Rẹ","marked":"Àti nínú ọla-nla Rẹ"},{"start":17.024,"end":18.207,"text":"O gun awọn Kerub'","marked":"Ó gun àwọn Kerub"},{"start":18.657,"end":19.789,"text":"L'apa iyẹ afẹfẹ,","marked":"L'apá ìyẹ́ afẹ́fẹ́"},{"start":20.239,"end":21.664,"text":"L'o si n fo kakiri.","marked":"L'ó sì ń fò kákiri."}],"end":21.664},{"key":"4","start":22.614,"lines":[{"start":22.614,"end":23.945,"text":"O mu mi sibi titẹju,","marked":"Ó mú mi síbi títẹ́jú"},{"start":24.395,"end":25.539,"text":"Ki n le di omnira:","marked":"Kí n lè di omnira"},{"start":25.989,"end":27.559,"text":"O si pa mi mọ nitori,","marked":"Ó sì pa mí mọ́ nítorí"},{"start":28.009,"end":29.111,"text":"Inu Rẹ dun si mi.","marked":"Inú Rẹ̀ dùn sí mi."}],"end":29.111},{"key":"5","start":30.061,"lines":[{"start":30.061,"end":31.216,"text":"Ọna Ọlọrun mo pupọ,","marked":"Ọ̀nà Ọlọ́run mọ́ púpọ̀"},{"start":31.666,"end":32.783,"text":"Ọrọ Rẹ ye koro,","marked":"Ọ̀rọ̀ Rẹ̀ yẹ korò"},{"start":33.233,"end":34.514,"text":"Awọn t'o n tẹle ọna Rẹ,","marked":"Àwọn t'ó ń tẹ̀lé ọ̀nà Rẹ"},{"start":34.964,"end":36.329,"text":"Ni abo t'o daju.","marked":"Ní abo t'ó dájú."}],"end":36.329}]}