{"v":3,"coll":"y","num":22,"id":"hymn_22","title":"JESU, a w'odo Re","duration":24.859,"voices":{"male":{"file":"y-22-male-v3.m4a","bytes":168761,"sha256":"36bd0379d8fe205b7a9bece4c386abb69c4c7cf6de8d5ae5d4ad495a1fc3efce","duration":24.9},"female":{"file":"y-22-female-v3.m4a","bytes":175597,"sha256":"87e9ea192e375519e31c4fb66d5737e8897194ac941524bddc43abaf66360298","duration":24.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.479,"text":"JESU, a w'odo Re","marked":"Jésù, a w'ọ̀dọ̀ Rẹ"},{"start":2.929,"end":4.079,"text":"L'Ojo Re mimo yi,","marked":"L'Ọjọ́ Rẹ mímọ́ yí"},{"start":4.529,"end":5.875,"text":"To wa bi awa ti pejo","marked":"Tó wá bí àwa ti péjọ"},{"start":6.325,"end":7.81,"text":"Si ko wa fun 'ra Re.","marked":"Sì kó wá fún ra Rẹ."}],"end":7.81},{"key":"2","start":8.76,"lines":[{"start":8.76,"end":10.044,"text":"Dari ẹsẹ wa ji wa,","marked":"Dárí ẹsẹ̀ wa jì wá"},{"start":10.494,"end":11.611,"text":"Fun wa l'Ẹmi Mimọ;","marked":"Fún wa l'Ẹ̀mí Mímọ́"},{"start":12.061,"end":13.711,"text":"Kọ wa k'ihin jẹ ibẹrẹ,","marked":"Kọ́ wá k'ìhín jẹ́ ìbẹ̀rẹ̀"},{"start":14.161,"end":15.581,"text":"Ayé ti ko l'opin.","marked":"Ayé tí kò l'òpin."}],"end":15.581},{"key":"3","start":16.531,"lines":[{"start":16.531,"end":17.937,"text":"F'ifẹ kun aya wa,","marked":"F'ìfẹ́ kún aya wa"},{"start":18.387,"end":19.647,"text":"Gba 'se olukọ wa;","marked":"Gbà ṣe olùkọ́ wa"},{"start":20.097,"end":21.604,"text":"K'awa at'awọn le pade;","marked":"K'àwa àt'àwọn lè pàdé"},{"start":22.054,"end":23.309,"text":"Niwaju Rẹ l'oke.","marked":"Níwájú Rẹ l'òkè."}],"end":23.309}]}