{"v":3,"coll":"y","num":258,"id":"hymn_258","title":"MO kese mi le, Jesu","duration":60.066,"voices":{"male":{"file":"y-258-male-v3.m4a","bytes":420329,"sha256":"a4eadc46297235a6357f03981fa5de322c6b7f5ae13fc80af65174a99fc1343a","duration":60.1},"female":{"file":"y-258-female-v3.m4a","bytes":435427,"sha256":"65ef1c293661fff13d1989bfd99c2e4b3e9a4454fc1f15eda6790e6d77086acf","duration":60.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.66,"text":"MO Kẹsẹ mi le, Jesu,","marked":"Mo Kẹsẹ̀ mi lé, Jésù"},{"start":3.11,"end":4.597,"text":"Ọd' aguntan Mimọ;","marked":"Ọd' àgùntàn Mímọ́"},{"start":5.047,"end":6.172,"text":"O ru gbogbo ẹru mi,","marked":"Ó rú gbogbo ẹ̀rù mi"},{"start":6.622,"end":7.849,"text":"O sọ mi d'ominira;","marked":"Ó sọ mí d'òmìnira"},{"start":8.299,"end":9.615,"text":"Mo ru ẹbi mi tọ wa,","marked":"Mo rú ẹ̀bi mi tọ̀ wà"},{"start":10.065,"end":11.375,"text":"K'o wẹ eeri mi nu,","marked":"K'ò wẹ èérí mi nù"},{"start":11.825,"end":13.248,"text":"K'ẹjẹ Rẹ iyebiye,","marked":"K'ẹ̀jẹ̀ Rẹ iyebíye"},{"start":13.698,"end":15.048,"text":"Le sọ mi di funfun.","marked":"Lè sọ mí di funfun."}],"end":15.048},{"key":"2","start":15.998,"lines":[{"start":15.998,"end":17.305,"text":"Mo k'aini mi le Jesu,","marked":"Mo k'àìní mi lé Jésù"},{"start":17.755,"end":18.929,"text":"Tirẹ l'ohun gbogbo;","marked":"Tirẹ̀ l'ohun gbogbo"},{"start":19.379,"end":20.687,"text":"O w'arun mi gbogbo san,","marked":"Ó w'àrùn mi gbogbo sàn"},{"start":21.137,"end":22.177,"text":"O r'ẹmi mi pada;","marked":"Ó r'ẹ̀mí mi padà"},{"start":22.627,"end":23.833,"text":"Mo ko ibanujẹ mi,","marked":"Mo kọ ìbànújẹ́ mi"},{"start":24.283,"end":25.763,"text":"Ẹru at' aniyan","marked":"Ẹ̀rù àt àníyàn"},{"start":26.213,"end":28.313,"text":"Le Jesu, O si gba mi,","marked":"Lé Jésù, Ó sì gbà mí"},{"start":28.763,"end":29.979,"text":"O gba irora mi.","marked":"Ó gba ìrora mi."}],"end":29.979},{"key":"3","start":30.929,"lines":[{"start":30.929,"end":32.184,"text":"Mo gb'ọkan mi le Jesu,","marked":"Mo gb'ọkàn mi lé Jésù"},{"start":32.634,"end":33.661,"text":"Ọkan arẹ mi yii;","marked":"Ọkàn arẹ mi yìí"},{"start":34.111,"end":35.264,"text":"Ọw' ọtun Rẹ gba mi mu,","marked":"Ọw' ọ̀tún Rẹ gbà mi mú"},{"start":35.714,"end":36.815,"text":"Mo sinmi laya Rẹ;","marked":"Mo sinmi láyà Rẹ"},{"start":37.265,"end":38.691,"text":"Mo fẹ orukọ Jesu,","marked":"Mo fẹ́ orúkọ Jésù"},{"start":39.141,"end":40.767,"text":"Emmanuẹl, Kristi;","marked":"Emmanuẹl, Kristi"},{"start":41.217,"end":42.422,"text":"Bi orun didun yika,","marked":"Bí ọ̀run dídùn yíká"},{"start":42.872,"end":44.009,"text":"Ni orukọ Rẹ jẹ.","marked":"Ní orúkọ Rẹ jẹ́."}],"end":44.009},{"key":"4","start":44.959,"lines":[{"start":44.959,"end":46.566,"text":"Mo fẹ ki n ri bi Jesu,","marked":"Mo fẹ́ kí n rí bí Jésù"},{"start":47.016,"end":48.179,"text":"T'ọkan Rẹ kun fun 'fẹ;","marked":"T'ọkàn Rẹ kún fún 'fẹ"},{"start":48.629,"end":50.229,"text":"Mo fẹ ki n ri bi Jesu,","marked":"Mo fẹ́ kí n rí bí Jésù"},{"start":50.679,"end":51.623,"text":"Ọmọ Mimọ Baba;","marked":"Ọmọ Mímọ́ Baba"},{"start":52.073,"end":53.661,"text":"Mo fẹ ki mba Jesu gbe,","marked":"Mo fẹ́ kí mba Jésù gbé"},{"start":54.111,"end":55.122,"text":"Larin ẹgbẹ mimọ;","marked":"Lárin ẹgbẹ́ mímọ́"},{"start":55.572,"end":56.726,"text":"Ki n kọrin iyin titi,","marked":"Kí n kọrin ìyìn títí"},{"start":57.176,"end":58.517,"text":"Orin t'Angẹli n kọ.","marked":"Orin t'Áńgẹ́lì ń kọ́."}],"end":58.517}]}