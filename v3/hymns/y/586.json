{"v":3,"coll":"y","num":586,"id":"hymn_586","title":"GBEKELE Olorun re","duration":75.311,"voices":{"male":{"file":"y-586-male-v3.m4a","bytes":524543,"sha256":"e459ff34d8e4e16204f38edfca586cea213629f8df09e99378a41cfdda8b88f0","duration":75.4},"female":{"file":"y-586-female-v3.m4a","bytes":553739,"sha256":"b58a27bdb2fa72a74b739ea35a48070169a322fd80e2c3137d219ce09ae846ec","duration":75.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.414,"text":"GBEKELE Olorun re,","marked":"Gbẹ́kẹ̀lé Ọlọ́run rẹ"},{"start":1.864,"end":3.765,"text":"K'o ma nso! k'o ma nso!","marked":"K'ó má ńṣọ́! k'ó má ńṣọ́!"},{"start":4.215,"end":5.439,"text":"Di 'leri re mu sinsin","marked":"Di lérí rẹ̀ mú ṣinṣin"},{"start":5.889,"end":6.703,"text":"K'o ma nso!","marked":"K'ó má ńṣọ́!"},{"start":7.153,"end":8.428,"text":"Mase se oruko Re,","marked":"Mase ṣe orúkọ Rẹ̀"},{"start":8.878,"end":10.248,"text":"B'o tile mu egan wa","marked":"B'ó tilẹ̀ mú ẹ̀gàn wá"},{"start":10.698,"end":11.921,"text":"Ma tan ihin Re kale","marked":"Má tan ìhín Rẹ̀ kalẹ̀"},{"start":12.371,"end":13.236,"text":"Si ma nso!","marked":"Sí má ńṣọ́!"}],"end":13.236},{"key":"CHORUS","start":14.186,"lines":[{"start":14.186,"end":15.841,"text":"Sa ma nso! Sa ma nso!","marked":"Ṣá má ńṣọ́! Ṣá má ńṣọ́!"},{"start":16.291,"end":17.101,"text":"K'o ma nso!","marked":"K'ó má ńṣọ́!"}],"end":17.101},{"key":"2","start":18.051,"lines":[{"start":18.051,"end":19.64,"text":"O ti pe O si se Re?","marked":"Ó ti pé Ó sì ṣe Rẹ̀?"},{"start":20.09,"end":22.01,"text":"Sa ma nso! Sa ma nso","marked":"Sá má ńṣọ́! Sá má ńṣọ"},{"start":22.46,"end":23.735,"text":"Oru mbo wa mura sin!","marked":"Òru mbọ́ wá múra sin!"},{"start":24.185,"end":25.08,"text":"Sa ma nso!","marked":"Sá má ńṣọ́!"},{"start":25.53,"end":27.374,"text":"Sin n'ife at'igbagbo","marked":"Sin n'ìfẹ́ àt'ìgbàgbọ́"},{"start":27.824,"end":29.162,"text":"Gbekele agbara Re","marked":"Gbẹ́kẹ̀lé agbára Rẹ̀"},{"start":29.612,"end":31.128,"text":"Fi ori ti de opin","marked":"Fi orí ti dé òpin"},{"start":31.578,"end":32.398,"text":"Sa ma nso!","marked":"Sá má ńṣọ́!"}],"end":32.398},{"key":"3","start":33.348,"lines":[{"start":33.348,"end":34.526,"text":"O ti fun ọ ni 'rugbin,","marked":"Ó ti fún ọ ní rúgbìn"},{"start":34.976,"end":36.768,"text":"Sa ma nso! Sa ma nso!","marked":"Ṣá má ńṣọ́! Ṣá má ńṣọ́!"},{"start":37.218,"end":38.672,"text":"Ma gbin 'wọ o tun kore,","marked":"Má gbìn 'wọ ó tún kórè"},{"start":39.122,"end":39.971,"text":"Sa ma nso!","marked":"Sá má ńṣọ́!"},{"start":40.421,"end":41.856,"text":"Ma sọra, si ma reti,","marked":"Má sọ́ra, sì má retí"},{"start":42.306,"end":43.293,"text":"L'ẹnu ọna Oluwa,","marked":"L'ẹnu ọ̀nà Olúwa"},{"start":43.743,"end":45.094,"text":"Y'o dahun adura rẹ,","marked":"Y'ó dáhùn àdúrà rẹ"},{"start":45.544,"end":46.416,"text":"Sa ma nso!","marked":"Sá má ńṣọ́!"}],"end":46.416},{"key":"4","start":47.366,"lines":[{"start":47.366,"end":48.578,"text":"O ti wi pé opin mbọ,","marked":"Ó ti wí pé òpin mbọ́"},{"start":49.028,"end":50.932,"text":"Sa ma nso! Sa ma nso!","marked":"Ṣá má ńṣọ́! Ṣá má ńṣọ́!"},{"start":51.382,"end":52.868,"text":"Njẹ fi ẹru mimọ sin!","marked":"Ǹjẹ́ fi ẹ̀rù mímọ́ sìn!"},{"start":53.318,"end":54.618,"text":"Kristi l'atilẹhin rẹ,","marked":"Kristi l'àtìlẹ́hìn rẹ̀"},{"start":55.068,"end":56.385,"text":"Oun na si ni Ounjẹ rẹ,","marked":"Òun nà sì ní Oúnjẹ rẹ̀"},{"start":56.835,"end":58.506,"text":"Y'o sin o de 'nu ogo;","marked":"Y'ó sìn ó dé nù ògo"},{"start":58.956,"end":59.785,"text":"Sa ma nso!","marked":"Sá má ńṣọ́!"}],"end":59.785},{"key":"5","start":60.735,"lines":[{"start":60.735,"end":62.27,"text":"Ni akoko diẹ yi,","marked":"Ní àkókò díẹ̀ yí"},{"start":62.72,"end":64.395,"text":"Sa ma nso! Sa ma nso!","marked":"Ṣá má ńṣọ́! Ṣá má ńṣọ́!"},{"start":64.845,"end":65.953,"text":"Jẹwọ Rẹ ni ọna rẹ:","marked":"Jẹ́wọ́ Rẹ ní ọ̀nà rẹ"},{"start":66.403,"end":67.275,"text":"Sa ma nso!","marked":"Sá má ńṣọ́!"},{"start":67.725,"end":69.044,"text":"Ka ri ọkan Rẹ n'nu rẹ,","marked":"Ká rí ọkàn Rẹ̀ n'nú rẹ̀"},{"start":69.494,"end":70.85,"text":"K'ifẹ Rẹ jẹ ayọ rẹ,","marked":"K'ìfẹ́ Rẹ jẹ́ ayọ̀ rẹ"},{"start":71.3,"end":72.429,"text":"L'ọjọ ayé rẹ gbogbo","marked":"L'ọjọ́ ayé rẹ gbogbo"},{"start":72.879,"end":73.762,"text":"Si ma nso!","marked":"Sí má ńṣọ́!"}],"end":73.762}]}