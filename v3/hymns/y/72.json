{"v":3,"coll":"y","num":72,"id":"hymn_72","title":"OBA awon eni Mimo","duration":79.179,"voices":{"male":{"file":"y-72-male-v3.m4a","bytes":553189,"sha256":"4cd3a48513117359cd1f2547a6522f4cc827bc553fe0a02c9304ee6f324b8b86","duration":79.2},"female":{"file":"y-72-female-v3.m4a","bytes":563391,"sha256":"eaed3b73b77a2aa8c2fd42272caa1e7a92de90704ef2aa9a9c1b8c2c0f690864","duration":79.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.321,"text":"OBA awon eni Mimo","marked":"Ọba àwọn ẹni Mímọ́"},{"start":1.771,"end":3.183,"text":"T'o mo ye awon 'rawo","marked":"T'ó mo yẹ àwọn ràwọ̀"},{"start":3.633,"end":5.015,"text":"Opo ẹni t'Ẹda gbagbe","marked":"Ọ̀pọ̀ ẹni t'Ẹ̀dà gbàgbé"},{"start":5.465,"end":11.971,"text":"Wa yika ite Re lai. Mimọ Mimọ (6 times) Lo ye Ọ, Iwọ l'a ba ma f'iyin fun, Ọlọrun, Edumare.","marked":"Wá yíká ìtẹ́ Rẹ láì. Mímọ́ Mímọ́ Ló yẹ Ọ́, Ìwọ l'á bá má f'ìyìn fún, Ọlọ́run, Èdùmàrè."}],"end":11.971},{"key":"CHORUS","start":12.921,"lines":[{"start":12.921,"end":15.816,"text":"Mimo Mimo, Mimo Mimo, Mimo Mimo","marked":"Mímọ́ Mímọ́, Mímọ́ Mímọ́, Mímọ́ Mímọ́"},{"start":16.266,"end":17.081,"text":"Lo ye O.","marked":"Ló yẹ Ọ."},{"start":17.531,"end":18.85,"text":"Iwo I'a ba ma f' iyin fun","marked":"Ìwọ l'á bá má f ìyìn fún"},{"start":19.3,"end":20.615,"text":"Olorun, Edumare.","marked":"Ọlọ́run, Èdùmàrè."}],"end":20.615},{"key":"2","start":21.565,"lines":[{"start":21.565,"end":23.084,"text":"Ẹni t'o wa ninu 'mọlẹ,","marked":"Ẹni t'ó wà nínú 'mọlẹ"},{"start":23.534,"end":24.762,"text":"T'oju ẹnikan ko ri;","marked":"T'ojú ẹnìkan kò rí"},{"start":25.212,"end":26.631,"text":"Mose ri akẹyinsi Rẹ,","marked":"Mósè rí àkẹyìnsí Rẹ̀"},{"start":27.081,"end":28.517,"text":"Oju Mose ran b'orun.","marked":"Ojú Mósè ràn b'ọ̀run."}],"end":28.517},{"key":"3","start":29.467,"lines":[{"start":29.467,"end":30.862,"text":"'Mọlẹ ti 'kuku ayé bo,","marked":"'Mọlẹ tí kúkú ayé bọ̀"},{"start":31.312,"end":33.032,"text":"N tan 'mọlẹ roro loke;","marked":"Ń tàn 'mọlẹ rorò lókè"},{"start":33.482,"end":34.866,"text":"Wọn jẹ ọmọ alade l'ọrun,","marked":"Wọ́n jẹ́ ọmọ aládé l'ọ̀run"},{"start":35.316,"end":36.8,"text":"Ẹda gbagbe wọn l'ayé.","marked":"Ẹ̀dá gbàgbé wọn l'ayé."}],"end":36.8},{"key":"4","start":37.75,"lines":[{"start":37.75,"end":39.447,"text":"mf Lala at'iya wọn fun Ọ,","marked":"mf Lala àt'ìyá wọn fún Ọ"},{"start":39.897,"end":41.383,"text":"Ẹda ko royin rẹ mọ;","marked":"Ẹ̀dá kò ròyìn rẹ̀ mọ́"},{"start":41.833,"end":43.19,"text":"Iwa rere wọn farasin,","marked":"Ìwà rere wọn farasin"},{"start":43.64,"end":44.844,"text":"Oluwa nikan lo mọ.","marked":"Olúwa nìkan ló mọ̀."}],"end":44.844},{"key":"5","start":45.794,"lines":[{"start":45.794,"end":47.406,"text":"p Wọn farasin fun wa sugbọn,","marked":"p Wọ́n farasin fún wa sùgbọ́n"},{"start":47.856,"end":49.014,"text":"A kọ wọn s'iwe iye,","marked":"A kọ wọn s'ìwé iye"},{"start":49.464,"end":51.962,"text":"Igbagbọ, adura, suuru,","marked":"Ìgbàgbọ́, àdúrà, sùúrù"},{"start":52.412,"end":53.862,"text":"Lala oun 'jakadi wọn.","marked":"Lálà òun jákadì wọn."}],"end":53.862},{"key":"6","start":54.812,"lines":[{"start":54.812,"end":56.22,"text":"Wọn mọ isura Rẹ lọhun,","marked":"Wọ́n mọ ìṣúra Rẹ lọ́hùn"},{"start":56.67,"end":57.836,"text":"Ka wa mọ wọn Oluwa;","marked":"Ká wá mọ̀ wọn Olúwa"},{"start":58.286,"end":59.609,"text":"Nigba t'O ba n siro ọsọ,","marked":"Nígbà t'Ó bá ń ṣírò ọ̀sọ́"},{"start":60.059,"end":61.771,"text":"Ti mbẹ lara ade Rẹ.","marked":"Ti mbẹ̀ lára adé Rẹ."}],"end":61.771},{"key":"7","start":62.721,"lines":[{"start":62.721,"end":64.15,"text":"E wole f'Oba Ologo","marked":"Ẹ wọlé f'Ọba Ológo"},{"start":64.6,"end":66.174,"text":"Serafu e wole fun","marked":"Séráfù ẹ wọlé fún"},{"start":66.624,"end":68.115,"text":"Niwaju ite Jehovah","marked":"Níwájú ìtẹ́ Jehovah"},{"start":68.565,"end":69.646,"text":"Olorun Metalokan.","marked":"Ọlọ́run Mẹ́talọ́kan."}],"end":69.646},{"key":"8","start":70.596,"lines":[{"start":70.596,"end":72.184,"text":"mp Ẹ wolẹ f'Ọba Ologo,","marked":"mp Ẹ wólẹ̀ f'Ọba Ológo"},{"start":72.634,"end":73.925,"text":"Kérúbù ẹ wolẹ fun;","marked":"Kérúbù ẹ wólẹ̀ fún"},{"start":74.375,"end":76.095,"text":"Niwaju itẹ Jehovah,","marked":"Níwájú ìtẹ́ Jehovah"},{"start":76.545,"end":77.63,"text":"Ọlọrun Mẹtalọkan","marked":"Ọlọ́run Mẹ́talọ́kan"}],"end":77.63}]}