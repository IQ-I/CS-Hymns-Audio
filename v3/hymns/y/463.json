{"v":3,"coll":"y","num":463,"id":"hymn_463","title":"MO gbohun Jesu t'o wi pe","duration":49.797,"voices":{"male":{"file":"y-463-male-v3.m4a","bytes":352640,"sha256":"9abca2d0db30463262e74b1f117d96e1274da66b3a3551560fc7fe9f835b1282","duration":49.8},"female":{"file":"y-463-female-v3.m4a","bytes":359567,"sha256":"64aff7162effd9c43a474ed78d14a3fc1998845f9f7e1a38335489e4cb8d003f","duration":49.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.122,"text":"MO gbohun Jesu t'o wi pé;","marked":"Mo gbóhùn Jésù t'ó wí pé"},{"start":2.572,"end":3.693,"text":"Wa sinmi lọdọ Mi,","marked":"Wá sinmi lọ́dọ̀ Mi"},{"start":4.143,"end":5.7,"text":"Gbe ori rẹ, 'wọ alarẹ,","marked":"Gbé orí rẹ, 'wọ alárẹ"},{"start":6.15,"end":7.428,"text":"Le okan aya Mi.‖","marked":"Lé ọkàn àyà Mi.‖"},{"start":7.878,"end":9.283,"text":"Nin' arẹ oun ibinujẹ,","marked":"Nín àrẹ òun ìbìnújẹ́"},{"start":9.733,"end":11.07,"text":"Ni mo tọ Jesu wa;","marked":"Ni mo tọ Jésù wá"},{"start":11.52,"end":12.772,"text":"O jẹ ib' isinmi fun mi,","marked":"Ó jẹ́ ib ìsinmi fún mi"},{"start":13.222,"end":14.42,"text":"O si mu 'nu mi dun.","marked":"Ó sì mú nù mi dùn."}],"end":14.42},{"key":"2","start":15.37,"lines":[{"start":15.37,"end":17.326,"text":"Mo gbohun Jesu t'o wi pé,","marked":"Mo gbóhùn Jésù t'ó wí pé"},{"start":17.776,"end":18.92,"text":"Iwọ ti oungbẹ ń gbẹ,","marked":"Ìwọ tí òùngbẹ ń gbẹ"},{"start":19.37,"end":20.91,"text":"N ó f'omi 'ye fun Ọ lọfẹ,","marked":"N ó f'omi yè fún Ọ lọ́fẹ́"},{"start":21.36,"end":23.034,"text":"Bere, mu, k'o si ye,‖","marked":"Bẹ̀rẹ̀, mú, k'ó sì yè,‖"},{"start":23.484,"end":25.871,"text":"Mo tọ Jesu wa, mo si mu,","marked":"Mo tọ Jésù wá, mo sì mú"},{"start":26.321,"end":27.429,"text":"Ninu omi 'ye na;","marked":"Nínú omi yè ná"},{"start":27.879,"end":29.933,"text":"Ọkan mi tutu, o sọji,","marked":"Ọkàn mi tútù, ó sọjí"},{"start":30.383,"end":31.693,"text":"Mo d'alaye n'nu Rẹ.","marked":"Mo d'àlàyé n'nú Rẹ̀."}],"end":31.693},{"key":"3","start":32.643,"lines":[{"start":32.643,"end":34.983,"text":"Mo gbohun Jesu t'o wi pé,","marked":"Mo gbóhùn Jésù t'ó wí pé"},{"start":35.433,"end":36.595,"text":"Mọlẹ ayé l'Emi;","marked":"Mọ́lẹ̀ ayé l'Èmi"},{"start":37.045,"end":38.828,"text":"Wo mi, Emi ni ọrun rẹ,","marked":"Wò mí, Èmi ni ọ̀run rẹ"},{"start":39.278,"end":40.724,"text":"Ọjọ rẹ y'o dara.‖","marked":"Ọjọ́ rẹ̀ y'ó dára.‖"},{"start":41.174,"end":43.078,"text":"Mo wo Jesu, emi si ri,","marked":"Mo wo Jésù, èmi sì rí"},{"start":43.528,"end":44.644,"text":"B'orun ododo mi,","marked":"B'ọ̀run òdodo mi"},{"start":45.094,"end":46.449,"text":"Ninu 'mọlẹ yi l'em' o rin,","marked":"Nínú 'mọlẹ yí l'ẹ́m ó rìn"},{"start":46.899,"end":48.247,"text":"Tit' ajo mi y'o pin.","marked":"Tít àjọ mi y'ó pín."}],"end":48.247}]}