{"v":3,"coll":"y","num":691,"id":"hymn_691","title":"KRISTI n'ipile wa","duration":51.851,"voices":{"male":{"file":"y-691-male-v3.m4a","bytes":368677,"sha256":"6c49efb4cf0ce4ca3ce6fc90a6fd0d3a8d2d0ed1b9d1535f75aa92ea1cf6f381","duration":51.9},"female":{"file":"y-691-female-v3.m4a","bytes":370714,"sha256":"8001bef1e030e8633dace8c936ef9647d889cc17bf982b8d16594abdafe78433","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.799,"text":"KRISTI n'ipile wa","marked":"Kristi n'ìpìlẹ̀ wa"},{"start":2.249,"end":3.288,"text":"Lori Re la o","marked":"Lórí Rẹ̀ là ọ́"},{"start":3.738,"end":4.962,"text":"kole Awon Mimo","marked":"kọ́lé Àwọn Mímọ́"},{"start":5.412,"end":6.542,"text":"nikan L'o n gb'agbala","marked":"nìkan L'ó ń gb'àgbàlá"},{"start":6.992,"end":8.633,"text":"orun Ireti wa, T'ore","marked":"ọ̀run Ìrètí wa, T'ọrẹ"},{"start":9.083,"end":11.9,"text":"ayé, T'ayo ti mbo, Wa n'nu fe Re.","marked":"ayé, T'ayọ̀ ti mbọ̀, Wá n'nù fẹ́ Rẹ."}],"end":11.9},{"key":"2","start":12.85,"lines":[{"start":12.85,"end":13.913,"text":"Agbala Mimo yi","marked":"Àgbàlá Mímọ́ yí"},{"start":14.363,"end":15.623,"text":"Y'o ho f'orin iyin","marked":"Y'ó hó f'orin ìyìn"},{"start":16.073,"end":17.142,"text":"A o korin iyin si","marked":"A ó kọrin ìyìn sí"},{"start":17.592,"end":18.704,"text":"Metalokan Mimo,","marked":"Mẹ́talọ́kan Mímọ́"},{"start":19.154,"end":21.07,"text":"Be la o f'orin, Ayo","marked":"Bẹ̀ la ó f'orin, Ayọ̀"},{"start":21.52,"end":23.539,"text":"kede Oruko Re, Titi ayé.","marked":"kéde Orúkọ Rẹ, Títí ayé."}],"end":23.539},{"key":"3","start":24.489,"lines":[{"start":24.489,"end":25.422,"text":"Olorun Olore","marked":"Ọlọ́run Ọlọ́rẹ́"},{"start":25.872,"end":26.637,"text":"Fiye si","marked":"Fìyẹ́ sí"},{"start":27.087,"end":28.517,"text":"ni, nihin Lati gba","marked":"ni, níhìn Láti gbà"},{"start":28.967,"end":30.763,"text":"eje wa At'ebe","marked":"ẹ̀jẹ̀ wa At'ẹ̀bẹ"},{"start":31.213,"end":32.868,"text":"wa gbogbo K'o si f'opo,","marked":"wá gbogbo K'ó sì f'opó"},{"start":33.318,"end":36.567,"text":"Bukun dahun, Adura wa, Nigba gbogbo","marked":"Bùkún dáhùn, Àdúrà wa, Nígbà gbogbo"}],"end":36.567},{"key":"4","start":37.517,"lines":[{"start":37.517,"end":39.335,"text":"Nihin, jẹ k'ore Rẹ,","marked":"Níhìn, jẹ́ k'ọrẹ Rẹ"},{"start":39.785,"end":41.199,"text":"T'a n tọrọ l'at'ọrun,","marked":"T'à ń tọrọ l'át'ọ̀run"},{"start":41.649,"end":42.828,"text":"Bọ sori wa lẹkan,","marked":"Bọ́ sórí wa lẹ́kàn"},{"start":43.278,"end":44.346,"text":"K'o ma si tun lọ mọ,","marked":"K'ó má sì tún lọ mọ́"},{"start":44.796,"end":45.995,"text":"di Tit'ọjọ na,","marked":"di Tít'ọjọ́ ná"},{"start":46.445,"end":47.726,"text":"T'a o s'akojọ,","marked":"T'a ó s'àkójọ"},{"start":48.176,"end":48.847,"text":"Awọn Mimọ,","marked":"Àwọn Mímọ́"},{"start":49.297,"end":50.302,"text":"Sib' isinmi.","marked":"Síb ìsinmi."}],"end":50.302}]}