{"v":3,"coll":"y","num":520,"id":"hymn_520","title":"AWA ko orin ife Re","duration":58.719,"voices":{"male":{"file":"y-520-male-v3.m4a","bytes":409685,"sha256":"06131159e5c84872a5817bc6a72807bbe311b84eccb69d2392f379fbcd161684","duration":58.8},"female":{"file":"y-520-female-v3.m4a","bytes":423969,"sha256":"2abc08131025f5d6817bf8b66019889ef264e1c1d3c966368ed4c8f0f0ee44b4","duration":58.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.853,"text":"AWA ko orin ife Re","marked":"Àwa kọ orin ìfẹ́ Rẹ̀"},{"start":2.303,"end":3.767,"text":"Obangiji Oba Ogo","marked":"Ọbangijì Ọba Ògo"},{"start":4.217,"end":5.535,"text":"Ko s'ohun ti lalasi Re","marked":"Kò s'ohun tí lálàṣí Rẹ̀"},{"start":5.985,"end":7.475,"text":"Ola Re ko si nipekun.","marked":"Ọlá Rẹ̀ kò sì nípẹ̀kun."}],"end":7.475},{"key":"2","start":8.425,"lines":[{"start":8.425,"end":10.036,"text":"N'nu ifẹ l'o s'ẹda ayé,","marked":"N'nú ìfẹ́ l'ó s'ẹ̀dà ayé"},{"start":10.486,"end":11.736,"text":"O da eniyan sinu rẹ;","marked":"Ó dá ènìyàn sínú rẹ̀"},{"start":12.186,"end":13.815,"text":"Lati ma s'akoso gbogbo;","marked":"Láti má s'àkóso gbogbo"},{"start":14.265,"end":15.919,"text":"Ẹ kọrin 'fẹ Ẹlẹda wa.","marked":"Ẹ kọrin 'fẹ Ẹlẹda wa."}],"end":15.919},{"key":"3","start":16.869,"lines":[{"start":16.869,"end":18.148,"text":"Lojojumọ l'O n tọju wa,","marked":"Lójojúmọ́ l'Ó ń tọ́jú wá"},{"start":18.598,"end":20.748,"text":"O si mbọ, O si n sikẹ wa,","marked":"Ó sì mbọ́, Ó sì ń sìkẹ́ wá"},{"start":21.198,"end":22.634,"text":"Bẹni ko gba n kan lọwọ wa,","marked":"Bẹ́ni kò gbà ń kan lọ́wọ́ wa"},{"start":23.084,"end":24.423,"text":"Kọrin 'yin s'onibu ọrẹ.","marked":"Kọrin yín s'oníbú ọrẹ."}],"end":24.423},{"key":"4","start":25.373,"lines":[{"start":25.373,"end":26.626,"text":"O ri wa ninu okunkun,","marked":"Ó rí wa nínú òkùnkùn"},{"start":27.076,"end":28.789,"text":"Pe, a ko mọ ojubọ Rẹ;","marked":"Pé, a kò mọ ojúbọ Rẹ̀"},{"start":29.239,"end":30.76,"text":"N'ifẹ O fi ọna han wa;","marked":"N'ìfẹ́ Ó fi ọ̀nà hàn wá"},{"start":31.21,"end":32.461,"text":"Ẹ kọrin ifẹ Olore!","marked":"Ẹ kọrin ìfẹ́ Ọlọ́rẹ!"}],"end":32.461},{"key":"5","start":33.411,"lines":[{"start":33.411,"end":35.212,"text":"N'ife O fi Jesu fun wa","marked":"N'ìfẹ́ Ó fi Jésù fún wa"},{"start":35.662,"end":36.957,"text":"Omo bibi Re kansoso","marked":"Ọmọ bíbí Rẹ̀ kanṣoṣo"},{"start":37.407,"end":38.717,"text":"O wa ra wa lowo ese","marked":"Ó wá rà wá lọ́wọ́ ẹ̀ṣẹ̀"},{"start":39.167,"end":40.428,"text":"A yin fe Re Olugbala!","marked":"A yín fẹ́ Rẹ Olùgbàlà!"}],"end":40.428},{"key":"6","start":41.378,"lines":[{"start":41.378,"end":42.62,"text":"Ifẹ Rẹ ran Ọrọ Rẹ wa,","marked":"Ìfẹ́ Rẹ̀ rán Ọ̀rọ̀ Rẹ̀ wá"},{"start":43.07,"end":44.571,"text":"Ifẹ Rẹ l'o si wa leti,","marked":"Ìfẹ́ Rẹ l'ó sì wà létí"},{"start":45.021,"end":46.261,"text":"Ifẹ Rẹ si mu wa duro,","marked":"Ìfẹ́ Rẹ̀ sì mú wa dúró"},{"start":46.711,"end":48.166,"text":"Ẹ kọrin ore- ọfẹ Rẹ.","marked":"Ẹ kọrin oore ọ̀fẹ́ Rẹ̀."}],"end":48.166},{"key":"7","start":49.116,"lines":[{"start":49.116,"end":50.655,"text":"Gbogbo ẹda kun fun 'fẹ Rẹ,","marked":"Gbogbo ẹ̀dá kún fún 'fẹ Rẹ"},{"start":51.105,"end":52.815,"text":"Oluwa wa, Ọba ayé;","marked":"Olúwa wá, Ọba ayé"},{"start":53.265,"end":55.388,"text":"Gbogbo agbayé, ẹ gberin,","marked":"Gbogbo agbayé, ẹ gberin"},{"start":55.838,"end":57.17,"text":"Orin ifẹ Ọlọrun wa.","marked":"Orin ìfẹ́ Ọlọ́run wa."}],"end":57.17}]}