{"v":3,"coll":"y","num":694,"id":"hymn_694","title":"JEJE laisi ariwo","duration":75.94,"voices":{"male":{"file":"y-694-male-v3.m4a","bytes":542735,"sha256":"4ca2384a9e8effd4707eafa15345e988bd4e26a9b3415dcf401ffdedfdfe71a4","duration":76.0},"female":{"file":"y-694-female-v3.m4a","bytes":564681,"sha256":"dace864638b448b49c5a67ecfc7eaebc1a0643bb953500b0de1b9028b7bef674","duration":76.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.571,"text":"JẸJẸ laisi ariwo,","marked":"Jẹ́jẹ́ láìsí ariwo"},{"start":2.021,"end":3.173,"text":"Jẹjẹ sa ni orun n ran,","marked":"Jẹ́jẹ́ sá ní ọ̀run ń ràn"},{"start":3.623,"end":5.231,"text":"Gba t'o ba yọ ni ila rẹ,","marked":"Gba t'ó bá yọ ní ìlà rẹ̀"},{"start":5.681,"end":6.898,"text":"Ẹda si le wo oju rẹ,","marked":"Ẹ̀dá sì lè wọ ojú rẹ̀"},{"start":7.348,"end":8.756,"text":"B'o si ti n goke pẹlẹ,","marked":"B'ó sì ti ń gòkè pẹ̀lẹ́"},{"start":9.206,"end":10.363,"text":"Jẹjẹ l'agbara rẹ n pọ,","marked":"Jẹ́jẹ́ l'agbára rẹ̀ ń pọ̀"},{"start":10.813,"end":12.122,"text":"Titi y'o fi kan 'tari,","marked":"Títí y'ó fi kan tari"},{"start":12.572,"end":14.337,"text":"Nin' ogo t'a ko le wo.","marked":"Nín ògo t'á kò lè wò."}],"end":14.337},{"key":"2","start":15.287,"lines":[{"start":15.287,"end":16.901,"text":"Okunkun t'o n'ipa ju,","marked":"Òkùnkùn t'ó n'ipa jù"},{"start":17.351,"end":18.555,"text":"Ko wa pẹlu okiki,","marked":"Kò wà pẹ̀lú òkìkí"},{"start":19.005,"end":20.447,"text":"Osupa ati Irawọ,","marked":"Òṣùpá àti Ìràwọ̀"},{"start":20.897,"end":22.422,"text":"Ti n tan 'mọlẹ y'ayé ka,","marked":"Tí ń tan 'mọlẹ y'ayé ká"},{"start":22.872,"end":24.116,"text":"Wọn ko wa pẹlu iro,","marked":"Wọn kò wà pẹ̀lú irọ́"},{"start":24.566,"end":26.141,"text":"Iri nla ti o n sẹ,","marked":"Ìrì ńlá tí ó ń sẹ̀"},{"start":26.591,"end":27.91,"text":"Yi gbogbo ayé yi ka,","marked":"Yí gbogbo ayé yí ká"},{"start":28.36,"end":29.734,"text":"Ko wa pẹlu okiki.","marked":"Kò wà pẹ̀lú òkìkí."}],"end":29.734},{"key":"3","start":30.684,"lines":[{"start":30.684,"end":32.04,"text":"Bayi n'isẹ ỌLỌRUN,","marked":"Báyì n'isẹ́ Ọlọ́run"},{"start":32.49,"end":33.659,"text":"Larin ẸGBẸ MIMỌ yi,","marked":"Lárin Ẹgbẹ́ Mímọ́ yí"},{"start":34.109,"end":35.588,"text":"B'a ti jẹ alailera,","marked":"B'á ti jẹ́ aláìlera"},{"start":36.038,"end":37.48,"text":"T'agbara wa ko si pọ,","marked":"T'agbára wa kò sì pọ̀"},{"start":37.93,"end":39.25,"text":"Sugbọn ipese BABA ,","marked":"Sùgbọ́n ìpèsè Baba"},{"start":39.7,"end":41.011,"text":"'Jojumo l'o n yọ si wa;","marked":"jojúmọ́ l'ó ń yọ sí wa"},{"start":41.461,"end":42.496,"text":"Nipa 'GBARA ỌLỌRUN","marked":"Nípa gbára Ọlọ́run"},{"start":42.946,"end":44.204,"text":"A kọ ile na pari.","marked":"A kọ ilẹ̀ ná parí."}],"end":44.204},{"key":"4","start":45.154,"lines":[{"start":45.154,"end":46.615,"text":"Loni yi, ỌLỌRUN wa,","marked":"Lónì yí, Ọlọ́run wa"},{"start":47.065,"end":48.234,"text":"Awa Ẹgbẹ Séráfù,","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":48.684,"end":50.156,"text":"Ọmọde ati agba,","marked":"Ọmọdé àti àgbà"},{"start":50.606,"end":51.866,"text":"Ọkunrin at'Obinrin,","marked":"Ọkùnrin àt'obìnrin"},{"start":52.316,"end":53.442,"text":"Onile at' alejo,","marked":"Onílé àt àlejò"},{"start":53.892,"end":55.189,"text":"T'o wa fi ọpẹ fun Ọ,","marked":"T'ó wá fi ọpẹ́ fún Ọ"},{"start":55.639,"end":56.688,"text":"Ninu ile Mimọ yi,","marked":"Nínú ilé Mímọ́ yí"},{"start":57.138,"end":58.855,"text":"Masai tẹwọ gb'ọpẹ wa.","marked":"Masai tẹ́wọ́ gb'ọpẹ́ wa."}],"end":58.855},{"key":"5","start":59.805,"lines":[{"start":59.805,"end":60.835,"text":"ỌLỌRUN MẸTALỌKAN,","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":61.285,"end":62.613,"text":"T'o da Ẹgbẹ yi silẹ,","marked":"T'ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":63.063,"end":64.44,"text":"Ya ile yi si MIMỌ,","marked":"Ya ilẹ̀ yí sí Mímọ́"},{"start":64.89,"end":66.385,"text":"Nipa AGBARA nla Rẹ,","marked":"Nípa Agbára ńlá Rẹ"},{"start":66.835,"end":68.365,"text":"Sọkalẹ l'ọjọ oni,","marked":"Sọ̀kalẹ̀ l'ọjọ́ òní"},{"start":68.815,"end":70.264,"text":"F'agbara wọ gbogbo wa,","marked":"F'agbára wọ gbogbo wa"},{"start":70.714,"end":72.248,"text":"Ki gbogbo wa jẹ TIRẸ,","marked":"Kí gbogbo wa jẹ́ Tìrẹ"},{"start":72.698,"end":74.391,"text":"Layé yi ati l'ọrun.","marked":"Layé yí àti l'ọ̀run."}],"end":74.391}]}