{"v":3,"coll":"y","num":77,"id":"hymn_77","title":"T'OLUWA n'ile at'ekun re,","duration":60.686,"voices":{"male":{"file":"y-77-male-v3.m4a","bytes":431940,"sha256":"424e02ed1432643d037edd87651af0a1ab8ba4c797962bc6b5a0c4783037e430","duration":60.7},"female":{"file":"y-77-female-v3.m4a","bytes":442760,"sha256":"3a7a156c3c1995d8a029d6f4c99b1f814f52fcfea793c4d8437a565ec1d9adfd","duration":60.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.895,"text":"T'OLUWA n'ile at'ekun re,","marked":"T'Olúwa n'ilé àt'ẹkùn rẹ̀"},{"start":2.345,"end":3.739,"text":"Ayé at'ekun 'nu re,","marked":"Ayé àt'ẹkùn nù rẹ̀"},{"start":4.189,"end":5.68,"text":"O fi 'di r sole lor'okun","marked":"Ó fi di r sọlẹ̀ lọ́r'òkun"},{"start":6.13,"end":12.856,"text":"Ati lori 'san omi. Gb'ori soke, Ẹyin 'lẹkun, K'a gbe yin soke, K'Ọba Ogo wọle wa.","marked":"Àti lórí san omi. Gb'orí sókè, Ẹ̀yin 'lẹkun, K'á gbé yín sókè, K'Ọba Ògo wọlé wá."}],"end":12.856},{"key":"CHORUS","start":13.806,"lines":[{"start":13.806,"end":14.874,"text":"Gb'ori soke","marked":"Gb'orí sókè"},{"start":15.324,"end":16.151,"text":"Enyin 'Iekun","marked":"Ẹ̀yin lẹ́kùn"},{"start":16.601,"end":17.997,"text":"K'a gbe nyin soke","marked":"K'á gbé yín sókè"},{"start":18.447,"end":19.804,"text":"K'Oba Ogo wole wa.","marked":"K'Ọba Ògo wọlé wá."}],"end":19.804},{"key":"2","start":20.754,"lines":[{"start":20.754,"end":22.56,"text":"Tani yoo g'ori oke yi lọ,","marked":"Tani yóò g'orí òkè yí lọ"},{"start":23.01,"end":24.023,"text":"Ori oke Oluwa;","marked":"Orí òkè Olúwa"},{"start":24.473,"end":25.874,"text":"Tani yoo duro niwaju Rẹ,","marked":"Tani yóò dúró níwájú Rẹ"},{"start":26.324,"end":27.703,"text":"Niwaju Oluwa wa.","marked":"Níwájú Olúwa wà."}],"end":27.703},{"key":"3","start":28.653,"lines":[{"start":28.653,"end":29.898,"text":"Ẹni t'o ni ọwọ mimọ,","marked":"Ẹni t'ó ní ọwọ́ mímọ́"},{"start":30.348,"end":31.742,"text":"T'o si ni aya funfun;","marked":"T'ó sì ní aya funfun"},{"start":32.192,"end":33.818,"text":"Ti ko gb'ọkan rẹ s'oke s'asan,","marked":"Tí kò gb'ọkàn rẹ̀ s'òkè s'ásán"},{"start":34.268,"end":35.674,"text":"Ti ko si bura ẹtan.","marked":"Tí kò sì búra ẹ̀tàn."}],"end":35.674},{"key":"4","start":36.624,"lines":[{"start":36.624,"end":38.269,"text":"Awa n'iran ti n s'afẹri Rẹ,","marked":"Àwa n'ìran tí ń s'áfẹ́rí Rẹ̀"},{"start":38.719,"end":39.796,"text":"Safẹri Rẹ Oluwa;","marked":"Sàfẹ́rí Rẹ Olúwa"},{"start":40.246,"end":42.044,"text":"Awa yoo si ri ibukun gba,","marked":"Àwa yóò sì rí ìbùkún gbà"},{"start":42.494,"end":43.661,"text":"Lọwọ Ọlọrun Jakob.","marked":"Lọ́wọ́ Ọlọ́run Jakọb."}],"end":43.661},{"key":"5","start":44.611,"lines":[{"start":44.611,"end":46.541,"text":"f A! Tani Oba awọn","marked":"f A! Tani Ọba àwọn"},{"start":46.991,"end":48.702,"text":"ọba? Ti 'se Oba Ogo","marked":"ọba? Ti ṣe Ọba Ògo"},{"start":49.152,"end":50.418,"text":"yi? Oluwa awon","marked":"yí? Olúwa àwọn"},{"start":50.868,"end":53.022,"text":"omo-ogun, Oun naa ni Oba","marked":"omo-ogun, Òun náà ni Ọba"},{"start":53.472,"end":55.175,"text":"Ogo. Gb'ori soke...","marked":"Ògo. Gb'orí sókè"},{"start":55.625,"end":59.137,"text":"Ẹyin 'lẹkun, K'a gbe yin soke, K'Ọba Ogo wọle wa.","marked":"Ẹ̀yin 'lẹkun, K'á gbé yín sókè, K'Ọba Ògo wọlé wá."}],"end":59.137}]}