{"v":3,"coll":"y","num":851,"id":"hymn_851","title":"A dupe lowo Oluwa","duration":108.166,"voices":{"male":{"file":"y-851-male-v3.m4a","bytes":783108,"sha256":"69517b4baaf1dba37c57bd288c007583b746bf3444cfe86ebcba90a074923bd1","duration":108.2},"female":{"file":"y-851-female-v3.m4a","bytes":808159,"sha256":"0261bdd1cbf2db8d83dd7e68f89a0aa48c13efa831f810201e13ce09ec12133c","duration":108.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.518,"text":"A dupe lowo Oluwa","marked":"A dúpẹ́ lọ́wọ́ Olúwa"},{"start":1.968,"end":3.236,"text":"To da wa si d'oni","marked":"Tó dá wa sì d'oni"},{"start":3.686,"end":5.027,"text":"Ti ko f'okan adaba Re","marked":"Tí kò f'ọkàn àdàbà Rẹ"},{"start":5.477,"end":6.605,"text":"Le eranko lowo","marked":"Lé ẹranko lọ́wọ́"},{"start":7.055,"end":8.751,"text":"Iku ati Esu gbogun,","marked":"Ikú àti Èṣù gbógun"},{"start":9.201,"end":10.548,"text":"Sibe ko ta wa nu","marked":"Síbẹ̀ kò ta wá nù"},{"start":10.998,"end":12.506,"text":"Ogo f'Oba Mimo julo","marked":"Ògo f'Ọba Mímọ́ jùlọ"},{"start":12.956,"end":14.106,"text":"Kabiyesi Oba.","marked":"Kábíyèsí Ọba."}],"end":14.106},{"key":"2","start":15.056,"lines":[{"start":15.056,"end":16.569,"text":"Melomelo lore, Re","marked":"Mélòmélò lọ́rẹ̀, Rẹ"},{"start":17.019,"end":18.014,"text":"Oba awon Oba","marked":"Ọba àwọn Ọba"},{"start":18.464,"end":20.004,"text":"Ti pamo ati iso Re,","marked":"Ti pamọ́ àti ìṣọ́ Rẹ"},{"start":20.454,"end":21.616,"text":"Tabi Isẹgun ota","marked":"Tàbí Ìsẹ́gun ọ̀tá"},{"start":22.066,"end":23.578,"text":"Loju ala, loju ayé,","marked":"Lójú àlá, lójú ayé"},{"start":24.028,"end":25.112,"text":"Tabi ti pese Re","marked":"Tàbí ti pèsè Rẹ̀"},{"start":25.562,"end":26.924,"text":"Iwosan lona iyanu,","marked":"Ìwòsàn lọ́nà ìyanu"},{"start":27.374,"end":28.485,"text":"A dupe Oluwa.","marked":"A dúpẹ́ Olúwa."}],"end":28.485},{"key":"3","start":29.435,"lines":[{"start":29.435,"end":30.647,"text":"Owo wa ko to dupe,","marked":"Ọwọ́ wa kò tó dúpẹ́"},{"start":31.097,"end":32.16,"text":"Aso ko to dupe","marked":"Aṣọ kò tó dúpẹ́"},{"start":32.61,"end":34.302,"text":"Ko s'ohun ta le fi dupe","marked":"Kò s'ohun ta lè fi dúpẹ́"},{"start":34.752,"end":35.725,"text":"Bikose ohun wa","marked":"Bíkọsẹ̀ ohun wà"},{"start":36.175,"end":37.703,"text":"Ka f'okan wa fun Kristi","marked":"Ká f'ọkàn wá fún Kristi"},{"start":38.153,"end":39.499,"text":"Lati ayé yi lo","marked":"Láti ayé yí lọ"},{"start":39.949,"end":42.353,"text":"Kayọ orun le je tiwa, Ti Kristi","marked":"Kayọ̀ ọ̀run lè jẹ́ tiwa, Ti Kristi"},{"start":42.803,"end":43.808,"text":"ti seleri.","marked":"ti ṣèlérí."}],"end":43.808},{"key":"4","start":44.758,"lines":[{"start":44.758,"end":46.13,"text":"Bani owo lainiye,","marked":"Bani ọwọ́ láìníye"},{"start":46.58,"end":47.827,"text":"B'a ni 'le lainiye","marked":"B'á ni lè láìníye"},{"start":48.277,"end":50.132,"text":"Basọ wa po bi ti Lilly B'omo","marked":"Basọ wá pọ̀ bí ti Lilly B'ọmọ"},{"start":50.582,"end":51.653,"text":"po lo titi Ba","marked":"pọ̀ lọ títí Ba"},{"start":52.103,"end":53.999,"text":"ro pe ayo wa tikun,","marked":"rò pé ayọ̀ wà tikún"},{"start":54.449,"end":55.844,"text":"Rara ko iti kun","marked":"Rárá kọ ìtì kún"},{"start":56.294,"end":57.437,"text":"Oku ba ko ti","marked":"Òkú bá kò tí"},{"start":57.887,"end":59.641,"text":"seleri Eru ni n'eru wa.","marked":"ṣèlérí Ẹ̀rù ní n'ẹ̀rù wà."}],"end":59.641},{"key":"5","start":60.591,"lines":[{"start":60.591,"end":61.625,"text":"Ki lo tun ba o","marked":"Kí ló tún bá ọ"},{"start":62.075,"end":63.862,"text":"leru, Ti Jesu ko le","marked":"lẹ́rù, Tí Jésù kò lè"},{"start":64.312,"end":65.837,"text":"se Damu lo wa niwaju","marked":"ṣe Damu lọ wà níwájú"},{"start":66.287,"end":67.86,"text":"re, Pe Jesu fun ran","marked":"rẹ̀, Pé Jésù fún rán"},{"start":68.31,"end":69.558,"text":"'wo Peteru pe fun","marked":"wo Peteru pè fún"},{"start":70.008,"end":71.68,"text":"ranlowo, Ko je ko ri","marked":"rànlọ́wọ́, Kò jẹ́ kó rí"},{"start":72.13,"end":74.029,"text":"somi Hezekiah Oba tun","marked":"sọmi Hezekiah Ọba tún"},{"start":74.479,"end":75.853,"text":"pe, O segun Keferi.","marked":"pé, Ó ṣẹ́gun Kèfèrí."}],"end":75.853},{"key":"6","start":76.803,"lines":[{"start":76.803,"end":78.344,"text":"Won to feje ti Kristi,","marked":"Wọ́n tó fẹ́jẹ́ ti Kristi"},{"start":78.794,"end":80.092,"text":"yoo pinu lokan won","marked":"yóò pinu lọ́kàn wọn"},{"start":80.542,"end":81.94,"text":"Lati yago fun Lusifa","marked":"Láti yàgò fún Lusifa"},{"start":82.39,"end":83.412,"text":"A t'omo ogun re","marked":"A t'ọmọ ogun rẹ̀"},{"start":83.862,"end":85.78,"text":"Ija, Ibinu, Arankan","marked":"Ìjà, Ìbínú, Àrànkàn"},{"start":86.23,"end":87.305,"text":"Ati iwa Eri","marked":"Àti ìwà Ẹ̀rí"},{"start":87.755,"end":89.4,"text":"Ainife ati ailanu,","marked":"Àìnífẹ́ àti àìlánú"},{"start":89.85,"end":91.209,"text":"Ko won sile loni.","marked":"Kọ́ wọn sílẹ̀ lónì."}],"end":91.209},{"key":"7","start":92.159,"lines":[{"start":92.159,"end":93.273,"text":"A dupe lowo Oluwa","marked":"A dúpẹ́ lọ́wọ́ Olúwa"},{"start":93.723,"end":94.678,"text":"Oba awon Oba","marked":"Ọba àwọn Ọba"},{"start":95.128,"end":97.426,"text":"Atobiju, Eni 'yanu","marked":"Àtòbìjú, Ẹni yanu"},{"start":97.876,"end":98.776,"text":"Olugbala Eda","marked":"Olùgbàlà Ẹ̀dá"},{"start":99.226,"end":101.093,"text":"Eleda, Olojo oni,","marked":"Ẹlẹ́dàá, Ọlọ́jọ́ òní"},{"start":101.543,"end":102.535,"text":"A juba Oko Re","marked":"A júbà Ọkọ Rẹ̀"},{"start":102.985,"end":104.152,"text":"Oore Re pọ ju kika","marked":"Oore Rẹ̀ pọ̀ ju kíká"},{"start":104.602,"end":105.656,"text":"lo, A dupe","marked":"lọ, A dúpẹ́"},{"start":106.106,"end":106.618,"text":"Oluwa.","marked":"Olúwa."}],"end":106.618}]}