{"v":3,"coll":"y","num":555,"id":"hymn_555","title":"JESU ni Balogun oko","duration":75.905,"voices":{"male":{"file":"y-555-male-v3.m4a","bytes":529412,"sha256":"16b6edd6107b5f4ef613aa62e158eba1620403380e25f79fe6b708156864eb4b","duration":76.0},"female":{"file":"y-555-female-v3.m4a","bytes":548017,"sha256":"2e47c975417c1a5e5c5cd02fdb2c5b700c3bccf27796f95ffa4853d347d7b69a","duration":76.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.919,"text":"JESU ni Balogun oko","marked":"Jésù ni Balógun ọkọ"},{"start":2.369,"end":3.895,"text":"E mase jek' a foiya","marked":"Ẹ máṣe jẹ́k a fòìyà"},{"start":4.345,"end":5.844,"text":"Olutoko wa ni Jesu","marked":"Olùtọ́kọ̀ wà ní Jésù"},{"start":6.294,"end":7.654,"text":"E mase jek'a foiya.","marked":"Ẹ máṣe jẹ́k'á fòìyà."}],"end":7.654},{"key":"CHORUS","start":8.604,"lines":[{"start":8.604,"end":9.528,"text":"E mase beru","marked":"Ẹ máṣe bẹ̀rù"},{"start":9.978,"end":10.994,"text":"E kun fun ayo","marked":"Ẹ kún fún ayọ̀"},{"start":11.444,"end":13.103,"text":"Nitori Jesu I'oga oko","marked":"Nítorí Jésù l'ọ̀gá oko"},{"start":13.553,"end":15.236,"text":"Bo ti wu ki ji na le to","marked":"Bó ti wù kí jí ná le tó"},{"start":15.686,"end":17.078,"text":"Yio mu oko wa gunle.","marked":"Yóò mú ọkọ wá gúnlẹ̀."}],"end":17.078},{"key":"2","start":18.028,"lines":[{"start":18.028,"end":19.535,"text":"Enyin ero to wa l'oko","marked":"Ẹ̀yin èrò tó wà l'ọ̀kọ̀"},{"start":19.985,"end":21.573,"text":"E ke pe Jesu nikan","marked":"Ẹ ké pe Jésù nìkan"},{"start":22.023,"end":23.849,"text":"K'e si gbekele nyin le pelu","marked":"K'é sì gbẹ́kẹ̀lé yín le pẹ̀lú"},{"start":24.299,"end":25.678,"text":"Yio mu oko wa gunle.","marked":"Yóò mú ọkọ wá gúnlẹ̀."}],"end":25.678},{"key":"3","start":26.628,"lines":[{"start":26.628,"end":28.06,"text":"Olugbala Wo t'oro re","marked":"Olùgbàlà Wo t'ọ̀rọ̀ rẹ"},{"start":28.51,"end":29.54,"text":"Mu igb'omi pa roro","marked":"Mú ìgb'omi pa rọ́rọ́"},{"start":29.99,"end":31.665,"text":"Iwo t'o orin lori omi","marked":"Ìwọ t'ọ orin lórí omi"},{"start":32.115,"end":33.875,"text":"T'o sun beni ko si nkan.","marked":"T'ó sùn bẹ́ni kò sí nǹkan."}],"end":33.875},{"key":"4","start":34.825,"lines":[{"start":34.825,"end":36.238,"text":"Kil'ohun to mba nyin leru?","marked":"Kíl'ohun tó mbá yín lẹ́rù?"},{"start":36.688,"end":37.915,"text":"Enyin Omogun Kristi","marked":"Ẹ̀yin Omogun Kristi"},{"start":38.365,"end":39.993,"text":"Bi Jesu ba wa 'nu oko","marked":"Bí Jésù bá wá nú oko"},{"start":40.443,"end":41.688,"text":"Awa yio fi 'gbi rerin.","marked":"Àwa yóò fi gbì rẹ́rìn."}],"end":41.688},{"key":"5","start":42.638,"lines":[{"start":42.638,"end":44.119,"text":"Gbati gbi aiye yi ba nja","marked":"Gbátí gbí ayé yí bá ńjà"},{"start":44.569,"end":46.204,"text":"Lor'okun ati nile","marked":"Lọ́r'okùn àti nílẹ̀"},{"start":46.654,"end":48.207,"text":"Abo kan mbe ti o daju","marked":"Abo kan mbẹ́ tí ó dájú"},{"start":48.657,"end":49.959,"text":"Lodo Olugbala wa.","marked":"Lọ́dọ̀ Olùgbàlà wa."}],"end":49.959},{"key":"6","start":50.909,"lines":[{"start":50.909,"end":52.451,"text":"Lowo Kiniun at'ekun","marked":"Lọ́wọ́ Kiniun àt'ẹkùn"},{"start":52.901,"end":54.099,"text":"Lowo eranko ibi","marked":"Lọ́wọ́ ẹranko ibi"},{"start":54.549,"end":56.201,"text":"Jesu yio dabobo tire","marked":"Jésù yóò dàbòbò tirẹ̀"},{"start":56.651,"end":58.14,"text":"Jesu yio pa tire mo.","marked":"Jésù yóò pa tirẹ̀ mọ́."}],"end":58.14},{"key":"7","start":59.09,"lines":[{"start":59.09,"end":60.544,"text":"Metalokan Alagbara","marked":"Mẹ́talọ́kan Alágbára"},{"start":60.994,"end":62.294,"text":"Dabobo awa omo re","marked":"Dàbòbò àwa ọmọ rẹ"},{"start":62.744,"end":64.749,"text":"Lowo ategun ati iji","marked":"Lọ́wọ́ àtẹ̀gùn àti ìjì"},{"start":65.199,"end":66.62,"text":"Jek'awa k' alleluya.","marked":"Jek'awa k Allelúyà."}],"end":66.62},{"key":"8","start":67.57,"lines":[{"start":67.57,"end":69.114,"text":"Ogo ni fun Baba loke","marked":"Ògo ni fún Baba lókè"},{"start":69.564,"end":70.766,"text":"Ogo ni fun Omo Re","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":71.216,"end":72.454,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":72.904,"end":74.356,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọ̀pẹ yẹ."}],"end":74.356}]}