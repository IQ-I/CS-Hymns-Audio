{"v":3,"coll":"y","num":69,"id":"hymn_69","title":"IRAPADA lowo 'ku oun ese","duration":53.858,"voices":{"male":{"file":"y-69-male-v3.m4a","bytes":401354,"sha256":"a28994d8afaa485fdf42f37587e027783023f8548b5539bfee316b0852628025","duration":53.9},"female":{"file":"y-69-female-v3.m4a","bytes":407410,"sha256":"4b0351a7c43b517123d89993c67e0a35342c15affd1faa766d34499c9e496075","duration":53.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.893,"text":"RAPADA lowo 'ku oun ese","marked":"Ràpadà lọ́wọ́ kú òun ẹ̀ṣẹ̀"},{"start":2.343,"end":3.787,"text":"Irapada n'ile l'ode","marked":"Ìràpadà n'ilẹ̀ l'òde"},{"start":4.237,"end":5.965,"text":"'Mole titun wo lo to yii!","marked":"mọ́lẹ̀ títún wo lọ tó yìí!"},{"start":6.415,"end":16.588,"text":"Ogo wo lo tan s'okan wa. Irapada! l'orin mi yoo jẹ, Titi ayé ainipẹkun Jẹ k'ẹni 'rapada k'o kọ Orin iyin si Kristi Ọba.","marked":"Ògo wo ló tán s'ọkàn wa. Ìràpadà! l'orin mi yóò jẹ́, Títí ayé àìnípẹ̀kun Jẹ́ k'ẹni ràpadà k'ó kọ Orin ìyìn sí Kristi Ọba."}],"end":16.588},{"key":"CHORUS","start":17.538,"lines":[{"start":17.538,"end":20.029,"text":"lrapada! I'orin mi yio je","marked":"Ìràpadà! l'orin mi yóò jẹ́"},{"start":20.479,"end":22.316,"text":"Titi aiye ainipekurn","marked":"Títí ayé àìnípẹ̀kurn"},{"start":22.766,"end":24.334,"text":"Je k'eni 'rapada k'o ko","marked":"Jẹ́ k'ẹni ràpadà k'ó kọ"},{"start":24.784,"end":26.284,"text":"Orin iyin si Kristi Oba.","marked":"Orin ìyìn sí Kristi Ọba."}],"end":26.284},{"key":"2","start":27.234,"lines":[{"start":27.234,"end":29.156,"text":"f Ogo f'ẹni t'a o le mọ'fẹ Rẹ,","marked":"f Ògo f'ẹni t'a ó lè mọ̀'fẹ́ Rẹ"},{"start":29.606,"end":30.851,"text":"To tan 'mọlẹ s'ọna eniyan,","marked":"Tó tán 'mọlẹ s'ọ́nà ènìyàn"},{"start":31.301,"end":32.722,"text":"B'itansan 'Rawọ titun n yọ,","marked":"B'ìtànṣán 'Rawọ títún ń yọ"},{"start":33.172,"end":34.591,"text":"A gbe 'rin titun 'rapada.","marked":"A gbé rìn títún ràpadà."}],"end":34.591},{"key":"3","start":35.541,"lines":[{"start":35.541,"end":37.065,"text":"mf Bi'gbi okun ti n ru soke,","marked":"mf Bí'gbí òkun tí ń ru sókè"},{"start":37.515,"end":39.407,"text":"Bẹẹ ni gb'orin ayọ yoo dun","marked":"Bẹ́ẹ̀ ni gb'orin ayọ̀ yóò dùn"},{"start":39.857,"end":41.25,"text":"Ifẹ Jesu jijin b'okun","marked":"Ìfẹ́ Jésù jíjìn b'okùn"},{"start":41.7,"end":43.44,"text":"Yoo k'ẹni 'rapada wa yẹ.","marked":"Yóò k'ẹni ràpadà wa yẹ."}],"end":43.44},{"key":"4","start":44.39,"lines":[{"start":44.39,"end":46.411,"text":"f Irapada! gbogbo ẹda,","marked":"f Ìràpadà! gbogbo ẹ̀dá"},{"start":46.861,"end":48.486,"text":"Yo f'ayọ m'ọrẹ f'Ọba wa","marked":"Yọ f'ayọ̀ m'ọ́rẹ́ f'Ọba wa"},{"start":48.936,"end":50.441,"text":"Irapada! gbogbo ayé,","marked":"Ìràpadà! gbogbo ayé"},{"start":50.891,"end":52.309,"text":"Yo d'ohun po kọrin iyin Rẹ","marked":"Yọ d'ohun pọ̀ kọrin ìyìn Rẹ"}],"end":52.309}]}