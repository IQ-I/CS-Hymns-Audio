{"v":3,"coll":"y","num":596,"id":"hymn_596","title":"MA sise lo mase sole","duration":48.148,"voices":{"male":{"file":"y-596-male-v3.m4a","bytes":333874,"sha256":"0fba1c6a08cea5f51899e6cda8b02c7d312ff572d057fd232ac7174a1b8d99e1","duration":48.2},"female":{"file":"y-596-female-v3.m4a","bytes":351674,"sha256":"aba53b9a146d7e96321e85613146eebf485678224eb33c37316ff65efe9f6aef","duration":48.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.623,"text":"MA sise lo mase sole","marked":"Má ṣiṣẹ́ lọ máṣe sọlẹ̀"},{"start":2.073,"end":3.442,"text":"Enyin Omo Egbe Serafu","marked":"Ẹ̀yin Ọmọ Ẹgbẹ́ Séráfù"},{"start":3.892,"end":5.585,"text":"Ikore po, ko s'agbase","marked":"Ìkórè pọ̀, kò s'àgbàṣe"},{"start":6.035,"end":7.796,"text":"Gbogbpo wa ni yio gb'ere na.","marked":"Gbogbpo wa ni yóò gb'èrè ná."}],"end":7.796},{"key":"2","start":8.746,"lines":[{"start":8.746,"end":10.802,"text":"Ma sise lo, mase sole","marked":"Má ṣiṣẹ́ lọ, máṣe sọlẹ̀"},{"start":11.252,"end":12.891,"text":"Enyin Omo Egbe Kerubu","marked":"Ẹ̀yin Ọmọ Ẹgbẹ́ Kérúbù"},{"start":13.341,"end":15.095,"text":"E jade lo s'opopo aiye","marked":"Ẹ jáde lọ s'òpópó ayé"},{"start":15.545,"end":17.176,"text":"Gbogbo wa ni yio gb'ere na.","marked":"Gbogbo wa ni yóò gb'èrè ná."}],"end":17.176},{"key":"3","start":18.126,"lines":[{"start":18.126,"end":20.133,"text":"Ma sise lo, mase sole","marked":"Má ṣiṣẹ́ lọ, máṣe sọlẹ̀"},{"start":20.583,"end":22.162,"text":"Ma jeki fitila nyin ku","marked":"Má jẹ́kí fìtílà yín kú"},{"start":22.612,"end":24.278,"text":"Omo 'ya wa ni ebi npa","marked":"Ọmọ yà wà ní ebi ńpa"},{"start":24.728,"end":26.34,"text":"Gbogbo wa ni yio gb'ere na.","marked":"Gbogbo wa ni yóò gb'èrè ná."}],"end":26.34},{"key":"4","start":27.29,"lines":[{"start":27.29,"end":29.368,"text":"Ma sise lo, mase sole","marked":"Má ṣiṣẹ́ lọ, máṣe sọlẹ̀"},{"start":29.818,"end":31.059,"text":"Mase wo awon elegan","marked":"Máṣe wo àwọn ẹlẹ́gàn"},{"start":31.509,"end":33.159,"text":"K'a fi keta gbogbo sile","marked":"K'á fi kẹta gbogbo sílẹ̀"},{"start":33.609,"end":35.136,"text":"Gbogbo wa ni yio gb'ere na.","marked":"Gbogbo wa ni yóò gb'èrè ná."}],"end":35.136},{"key":"5","start":36.086,"lines":[{"start":36.086,"end":38.177,"text":"Ma sise lo, mase sole","marked":"Má ṣiṣẹ́ lọ, máṣe sọlẹ̀"},{"start":38.627,"end":40.022,"text":"Awa yio korin Halleluya","marked":"Àwa yóò kọrin Hallelúyà"},{"start":40.472,"end":42.429,"text":"Orin Halle, Halleluyah","marked":"Orin Halle, Hallelúyà"},{"start":42.879,"end":44.177,"text":"Nigbat' a ba r'Olugbala","marked":"Nígbàt a bá r'Olùgbàlà"},{"start":44.627,"end":45.504,"text":"Amin, Amin,. Ase.","marked":"Àmín, Àmín,. Àṣẹ."},{"start":45.954,"end":46.598,"text":"Amin.","marked":"Àmín."}],"end":46.598}]}