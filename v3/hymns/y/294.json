{"v":3,"coll":"y","num":294,"id":"hymn_294","title":"W'OLORI Alufa Giga","duration":51.306,"voices":{"male":{"file":"y-294-male-v3.m4a","bytes":374815,"sha256":"994e128d0e68a881c76c5f1c6fd6fd272b4527a8a4490a357d06dacdca8529b0","duration":51.4},"female":{"file":"y-294-female-v3.m4a","bytes":382583,"sha256":"d3cbdf56e8250af14a909fbb51571a620727a226ceac3ab516ac995b4f3fda22","duration":51.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.717,"text":"W'OLORI Alufa Giga","marked":"W'Olórí Àlùfá Gíga"},{"start":2.167,"end":3.796,"text":"B'o ti gbe ebe wa lo","marked":"B'ó ti gbé ẹ̀bẹ̀ wa lọ"},{"start":4.246,"end":6.459,"text":"L'ogba, o f 'ikedun wole","marked":"L'ọgbà, ó f ìkẹ́dùn wọlé"},{"start":6.909,"end":8.164,"text":"O f'eru dojubole","marked":"Ó f'ẹ́rù dojúbolẹ̀"},{"start":8.614,"end":9.865,"text":"Angeli f'idamu duro","marked":"Áńgẹ́lì f'ìdàmú dúró"},{"start":10.315,"end":11.527,"text":"Lati ri Eleda be","marked":"Láti rí Ẹlẹ́dàá bẹ"},{"start":11.977,"end":13.702,"text":"Awa o ha wa l'aigbogbe","marked":"Àwa ó ha wà l'àìgbọgbẹ́"},{"start":14.152,"end":15.933,"text":"T'a mo pe tori wa ni?","marked":"T'á mọ̀ pé torí wa ni?"}],"end":15.933},{"key":"2","start":16.883,"lines":[{"start":16.883,"end":18.858,"text":"mf Kiki ẹjẹ Jesu nikan,","marked":"mf Kìkì ẹ̀jẹ̀ Jésù nìkan"},{"start":19.308,"end":20.555,"text":"L'o le yi ọkan pada;","marked":"L'ó lè yí ọkàn padà"},{"start":21.005,"end":22.646,"text":"Oun l'o le gba wa n'nu ẹbi,","marked":"Òun l'ó lè gbà wá n'nú ẹ̀bi"},{"start":23.096,"end":24.364,"text":"Oun l'o le m'ọkan wa rọ;","marked":"Òun l'ó lè m'ọkàn wa rọ̀"},{"start":24.814,"end":26.447,"text":"Ofin at' ikilọ ko to,","marked":"Òfin àt ìkìlọ̀ kò tó"},{"start":26.897,"end":28.074,"text":"Wọn ko si le nikan se;","marked":"Wọn kò sì lè nìkan ṣe"},{"start":28.524,"end":30.026,"text":"Ero yi l'o le m'ọkan ro;","marked":"Èrò yí l'ó lè m'ọkàn rò"},{"start":30.476,"end":31.75,"text":"Oluwa ku dipo mi!","marked":"Olúwa kú dípò mi!"}],"end":31.75},{"key":"3","start":32.7,"lines":[{"start":32.7,"end":34.633,"text":"Jesu, gbogbo itunu wa,","marked":"Jésù, gbogbo ìtùnú wa"},{"start":35.083,"end":36.873,"text":"Lat'ọdọ Rẹ l'o ti n wa;","marked":"Lát'ọ̀dọ̀ Rẹ̀ l'ó ti ń wá"},{"start":37.323,"end":39.976,"text":"Ifẹ, gbogbo, 'reti, suuru,","marked":"Ìfẹ́, gbogbo, retí, sùúrù"},{"start":40.426,"end":41.579,"text":"Gbogbo rẹ l'ẹjẹ Rẹ ra;","marked":"Gbogbo rẹ̀ l'ẹ̀jẹ̀ Rẹ rà"},{"start":42.029,"end":43.685,"text":"Lat' inu ẹkun Re l'a n gba,","marked":"Lát inú ẹkún Rẹ̀ l'à ń gbà"},{"start":44.135,"end":45.578,"text":"A ko da ohun kan ni;","marked":"A kò dá ohun kan ni"},{"start":46.028,"end":47.533,"text":"Lọfẹ n'Iwọ ń fi wọn tọrẹ,","marked":"Lọ́fẹ́ n'Ìwọ ń fi wọ́n tọrẹ"},{"start":47.983,"end":49.757,"text":"Fun awọn t'o s'alaini.","marked":"Fún àwọn t'ó s'aláìní."}],"end":49.757}]}