{"v":3,"coll":"y","num":462,"id":"hymn_462","title":"MO f'igbagbo b'Olorun Rin","duration":36.823,"voices":{"male":{"file":"y-462-male-v3.m4a","bytes":261559,"sha256":"302370ff4f77f0af0da9a28ec7fe5c3deb48a6b5b7a13d3560644db21aa3c304","duration":36.9},"female":{"file":"y-462-female-v3.m4a","bytes":262026,"sha256":"3588b40ce54da9a2f50b2bbd67ec3dda7ad815c2589d847da8282a8ca947994f","duration":36.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.808,"text":"MO f'igbagbọ b'Ọlọrun Rin,","marked":"Mo f'ìgbàgbọ́ b'Ọlọ́run Rìn"},{"start":2.258,"end":3.61,"text":"Ọrun ni opin ajo mi;","marked":"Ọ̀run ni òpin àjọ mi"},{"start":4.06,"end":5.998,"text":"Ọp' at' ọgọ Rẹ tu mi n'nu","marked":"Ọp' àt ọ̀gọ Rẹ̀ tú mi n'nú"},{"start":6.448,"end":7.948,"text":"Ọna didun l'ọna t'o la.","marked":"Ọ̀nà dídùn l'ọ̀nà t'ó là."}],"end":7.948},{"key":"2","start":8.898,"lines":[{"start":8.898,"end":10.558,"text":"Mo n rin larin aginju nla,","marked":"Mò ń rìn lárin aginjù ńlá"},{"start":11.008,"end":12.357,"text":"Nibi ọpọlọpọ ti nu;","marked":"Níbi ọ̀pọ̀lọpọ̀ ti nù"},{"start":12.807,"end":14.655,"text":"Sugbọn Oun t'o s'amọna wa,","marked":"Sùgbọ́n Òun t'ó s'amọ̀nà wá"},{"start":15.105,"end":17.023,"text":"Ko jẹ ki n sina ti mba nu.","marked":"Kò jẹ́ kí n ṣìnà tí mbá nù."}],"end":17.023},{"key":"3","start":17.973,"lines":[{"start":17.973,"end":19.846,"text":"Mo nla 'kẹkun t'oun ewu ja,","marked":"Mo ńlá 'kẹkun t'òun ewu jà"},{"start":20.296,"end":21.969,"text":"Ayé at'Esu kọlu mi,","marked":"Ayé àt'èṣù kọlù mí"},{"start":22.419,"end":23.779,"text":"Agbara Rẹ ni mo fi la,","marked":"Agbára Rẹ ni mo fi là"},{"start":24.229,"end":25.865,"text":"Igbagbọ si ni 'sẹgun mi.","marked":"Ìgbàgbọ́ sì ni 'sẹgun mi."}],"end":25.865},{"key":"4","start":26.815,"lines":[{"start":26.815,"end":28.67,"text":"Mo n kanu awọn ti ń halẹ,","marked":"Mo ń kanu àwọn tí ń halẹ̀"},{"start":29.12,"end":30.957,"text":"F'afẹ ayé ti n kọja yi:","marked":"F'àfẹ́ ayé tí ń kọjá yí"},{"start":31.407,"end":33.375,"text":"Oluwa, jẹ ki n ba Ọ Rin,","marked":"Olúwa, jẹ́ kí n bá Ọ Rìn"},{"start":33.825,"end":35.273,"text":"Olugbala at'Ọrẹ mi.","marked":"Olùgbàlà àt'Ọ̀rẹ́ mi."}],"end":35.273}]}