{"v":3,"coll":"y","num":234,"id":"hymn_234","title":"OLUWA at'igbala wa","duration":35.631,"voices":{"male":{"file":"y-234-male-v3.m4a","bytes":262062,"sha256":"2f34430ce80b77e99a4ecdd190954ff24501ea275b6ae2331f2459b4d6b19137","duration":35.7},"female":{"file":"y-234-female-v3.m4a","bytes":267985,"sha256":"92f2ac946882353c17431b2ba82f389691e798687b5ae4b9e1425b74cd5eb273","duration":35.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.76,"text":"OLUWA at'igbala wa,","marked":"Olúwa àt'ìgbàlà wa"},{"start":2.21,"end":3.767,"text":"Amọna at'agbara wa,","marked":"Amọ̀nà àt'agbára wa"},{"start":4.217,"end":5.8,"text":"L'o ko wa jọ l'alẹ oni,","marked":"L'ó kò wá jọ l'alẹ́ òní"},{"start":6.25,"end":7.747,"text":"Jẹ k'a gbe Ebeneseri ro;","marked":"Jẹ́ k'á gbé Ebeneseri rọ"},{"start":8.197,"end":10.154,"text":"Ọdun t'a ti la kọja yi,","marked":"Ọdún t'a ti là kọjá yí"},{"start":10.604,"end":12.214,"text":"Ni Oun f'ore Rẹ de lade,","marked":"Ní Òun f'ọrẹ Rẹ dé ládé"},{"start":12.664,"end":14.16,"text":"Ọtun l'anu Rẹ l'Owurọ;","marked":"Ọ̀tún l'àánú Rẹ̀ l'Òwúrọ̀"},{"start":14.61,"end":16.437,"text":"Njẹ ki ọpẹ wa ma pọ si!","marked":"Ǹjẹ́ kí ọpẹ́ wa má pọ̀ sí!"}],"end":16.437},{"key":"2","start":17.387,"lines":[{"start":17.387,"end":19.334,"text":"Jesu t'o joko lor' itẹ;","marked":"Jésù t'ó jókò lór ìtẹ́"},{"start":19.784,"end":21.235,"text":"L'a fi Halleluyah wa fun;","marked":"L'á fi Hallelúyà wá fún"},{"start":21.685,"end":23.185,"text":"Nitori Rẹ nikansoso,","marked":"Nítorí Rẹ nìkanṣoṣo"},{"start":23.635,"end":25.302,"text":"L'a da wa si lati kọrin,","marked":"L'á dá wa sí láti kọrin"},{"start":25.752,"end":27.097,"text":"Ran wa lọwọ lati kanu,","marked":"Ràn wá lọ́wọ́ láti kanu"},{"start":27.547,"end":29.652,"text":"Ẹsẹ ọdun t'o ti kọja;","marked":"Ẹsẹ̀ ọdún t'ó ti kọjá"},{"start":30.102,"end":31.736,"text":"Fun ni k'a lo eyi ti mbọ;","marked":"Fún ni k'á lo èyí ti mbọ̀"},{"start":32.186,"end":34.081,"text":"S'iyin Rẹ ju ọdun t'o lọ.","marked":"S'ìyìn Rẹ̀ ju ọdún t'ó lọ."}],"end":34.081}]}