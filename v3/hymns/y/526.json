{"v":3,"coll":"y","num":526,"id":"hymn_526","title":"JESU, Iwo ni a n wo","duration":41.103,"voices":{"male":{"file":"y-526-male-v3.m4a","bytes":281114,"sha256":"4f0074b81215079b9a0363e9fbdaa76c04630f60aa5c4303c3c5024b695cfa10","duration":41.2},"female":{"file":"y-526-female-v3.m4a","bytes":298759,"sha256":"127c0e89e12a80d4b5bc8dab1fad3a321db413ecd8f263aaa0f797daecaaa70d","duration":41.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.514,"text":"JESU, Iwo ni a nwo","marked":"Jésù, Ìwọ ni a ńwọ̀"},{"start":2.964,"end":4.248,"text":"K'a repo l'oruko Re","marked":"K'á rẹpọ̀ l'orúkọ Rẹ̀"},{"start":4.698,"end":5.681,"text":"Alade alaiia","marked":"Aládé aláìíà"},{"start":6.131,"end":7.706,"text":"Mu k'ija tan l'arin wa.","marked":"Mú k'ìjà tán l'árìn wa."}],"end":7.706},{"key":"2","start":8.656,"lines":[{"start":8.656,"end":9.95,"text":"Nipa ilaja Tire","marked":"Nípa ìlàjà Tire"},{"start":10.4,"end":11.613,"text":"Mu idugbolu kuro","marked":"Mú ìdùgbòlù kúrò"},{"start":12.063,"end":13.431,"text":"Jek'a dapo si okan","marked":"Jek'a dàpọ̀ sí ọkàn"},{"start":13.881,"end":15.155,"text":"F'itegun Re sarin wa.","marked":"F'ìtẹ̀gùn Rẹ̀ sárín wa."}],"end":15.155},{"key":"3","start":16.105,"lines":[{"start":16.105,"end":17.43,"text":"Jek'a wa ni okan kan","marked":"Jek'a wà ní ọkàn kan"},{"start":17.88,"end":19.512,"text":"K'a se anu at'ore","marked":"K'á ṣe àánú àt'ọ̀rẹ́"},{"start":19.962,"end":21.527,"text":"K'a tutu l'ero l'okan","marked":"K'á tútù l'èrò l'ọkàn"},{"start":21.977,"end":23.257,"text":"Gege bi Oluwa wa.","marked":"Gẹ́gẹ́ bí Olúwa wà."}],"end":23.257},{"key":"4","start":24.207,"lines":[{"start":24.207,"end":25.787,"text":"K'a s'aniyan ara wa","marked":"K'á s'àníyàn ara wa"},{"start":26.237,"end":27.505,"text":"K'a ma reru ara wa","marked":"K'á má rẹrù ara wa"},{"start":27.955,"end":29.386,"text":"K'a f'apere fun ljo","marked":"K'á f'àpẹrẹ fún Ìjọ"},{"start":29.836,"end":31.225,"text":"B'Olugbagbo ti gbe po.","marked":"B'Olùgbàgbọ́ ti gbé pọ̀."}],"end":31.225},{"key":"5","start":32.175,"lines":[{"start":32.175,"end":33.369,"text":"K'a kuro ni ibinu","marked":"K'á kúrò ní ìbínú"},{"start":33.819,"end":34.92,"text":"K'a simi le Olorun","marked":"K'á ṣímí lé Ọlọ́run"},{"start":35.37,"end":36.738,"text":"K'a so ti ibu ife","marked":"K'á sọ ti ibú ìfẹ́"},{"start":37.188,"end":38.523,"text":"At'iwa giga mimo.","marked":"Àt'ìwà gíga mímọ́."},{"start":38.973,"end":39.554,"text":"Amin.","marked":"Àmín."}],"end":39.554}]}