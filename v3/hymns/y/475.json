{"v":3,"coll":"y","num":475,"id":"hymn_475","title":"LOWO kiniun at'ekun","duration":112.843,"voices":{"male":{"file":"y-475-male-v3.m4a","bytes":836154,"sha256":"be090f69737fe00db77a9ef9acd8d813dc9fbfdc75da90f2d11c7e041a7ce661","duration":112.9},"female":{"file":"y-475-female-v3.m4a","bytes":848890,"sha256":"ae4c669af9b85c62d8f0b00dc12634bb8bf220c4e63f3279056c16be58951633","duration":112.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.83,"text":"LỌWỌ Kiniun at'ẹkun,","marked":"Lọ́wọ́ Kiniun àt'ẹkùn"},{"start":2.28,"end":3.534,"text":"Lọwọ ẹranko ibi,","marked":"Lọ́wọ́ ẹranko ibi"},{"start":3.984,"end":5.395,"text":"Jọ sọ aw' Ijọ Séráfù,","marked":"Jọ sọ àw Ìjọ Séráfù"},{"start":5.845,"end":7.05,"text":"At'ọmọ 'jọ Kérúbù,","marked":"At'ọmọ 'jọ Kérúbù"},{"start":7.5,"end":8.963,"text":"Ninu gbogbo iji to nja,","marked":"Nínú gbogbo ìjì tó ǹjà"},{"start":9.413,"end":11.137,"text":"A! nibo l'a ba sa si,","marked":"A! níbo l'a bá sá sí"},{"start":11.587,"end":13.199,"text":"A! Baba ma fi wa silẹ,","marked":"A! Baba má fi wá sílẹ̀"},{"start":13.649,"end":15.129,"text":"Sẹgun Satani fun wa.","marked":"Sẹ́gun Sátánì fún wa."}],"end":15.129},{"key":"2","start":16.079,"lines":[{"start":16.079,"end":18.022,"text":"Ko s'ọna ti a ba tun tọ,","marked":"Kò s'ọ̀nà tí a bá tún tọ́"},{"start":18.472,"end":19.743,"text":"To le bori ọna yi,","marked":"Tó lè borí ọ̀nà yí"},{"start":20.193,"end":22.103,"text":"Jẹ ka diju si nkan t'ayé,","marked":"Jẹ́ ká díjú sí nǹkan t'ayé"},{"start":22.553,"end":24.069,"text":"Ka laju si nkan f'ọrun,","marked":"Ká lájú sí nǹkan f'ọ̀run"},{"start":24.519,"end":26.09,"text":"Ma jẹ k'ayé fa wa s'ẹhin,","marked":"Má jẹ́ k'ayé fà wá s'ẹ̀hìn"},{"start":26.54,"end":27.616,"text":"Kuro ninu ọna Rẹ,","marked":"Kúrò nínú ọ̀nà Rẹ"},{"start":28.066,"end":29.736,"text":"N'nu 'banujẹ at'ipọnju,","marked":"N'nú 'banujẹ àt'ìpọ́njú"},{"start":30.186,"end":31.673,"text":"Emi ki o fi Ọ silẹ.","marked":"Èmi kí ó fi Ọ́ sílẹ̀."}],"end":31.673},{"key":"3","start":32.623,"lines":[{"start":32.623,"end":34.643,"text":"Ade ogo yoo jẹ ti yin,","marked":"Adé ògo yóò jẹ́ tì yín"},{"start":35.093,"end":36.506,"text":"T'ẹyin ko ba sin l'ẹtan,","marked":"T'ẹ̀yin kò bá sin l'ẹ̀tàn"},{"start":36.956,"end":38.677,"text":"Mo se tan mo ti pa yin pọ,","marked":"Mo ṣe tán mo ti pa yín pọ̀"},{"start":39.127,"end":40.403,"text":"Ẹmi ni Ẹmi Airi,","marked":"Ẹ̀mí ni Ẹ̀mí Àìrí"},{"start":40.853,"end":42.243,"text":"Sugbọn mo wa n'nu Ọlanla,","marked":"Sùgbọ́n mo wá n'nú Ọláńlá"},{"start":42.693,"end":44.366,"text":"Mo le pa, mo le gbala,","marked":"Mo lè pa, mo lè gbàlà"},{"start":44.816,"end":46.48,"text":"Jẹ arọwa k'ẹ ma w'ehin,","marked":"Jẹ́ àrọ̀wà k'ẹ má w'ẹ̀hìn"},{"start":46.93,"end":48.096,"text":"K'ẹ le gbere nikẹhin.","marked":"K'ẹ lè gbèrè níkẹ̀hìn."}],"end":48.096},{"key":"4","start":49.046,"lines":[{"start":49.046,"end":50.48,"text":"Ifẹ to dopin la n tọrọ,","marked":"Ìfẹ́ tó dópin là ń tọrọ"},{"start":50.93,"end":52.459,"text":"Fun gbogb' Ẹgbẹ to papọ,","marked":"Fún gbogb Ẹgbẹ́ tó papọ̀"},{"start":52.909,"end":55.148,"text":"Ẹ ja, ẹ sẹgun, ẹ bori,","marked":"Ẹ jà, ẹ sẹ́gun, ẹ borí"},{"start":55.598,"end":57.179,"text":"Layé yi ati lọrun,","marked":"Layé yí àti lọ́rùn"},{"start":57.629,"end":59.518,"text":"Sugọn 'danwo tun wa l'ọrun","marked":"Sùgọ́n dánwò tún wà l'ọ̀run"},{"start":59.968,"end":61.601,"text":"A! bawo ni yoo ti ri,","marked":"A! báwo ni yóò ti rí"},{"start":62.051,"end":63.927,"text":"Ka gbọ p'o ti jẹ Séráfù,","marked":"Ká gbọ́ p'ó ti jẹ́ Séráfù"},{"start":64.377,"end":65.555,"text":"O tun pada nikẹhin.","marked":"Ó tún padà níkẹ̀hìn."}],"end":65.555},{"key":"5","start":66.505,"lines":[{"start":66.505,"end":67.74,"text":"Ohun ti mo ba pa lasẹ,","marked":"Ohun tí mo bá pa lásẹ"},{"start":68.19,"end":69.594,"text":"Ma f'ọgbọn-ori yipada,","marked":"Má f'ọgbọn-ori yípadà"},{"start":70.044,"end":71.641,"text":"Ẹni ti ko ba gba 'ran gbọ,","marked":"Ẹni tí kò bá gbà ràn gbọ́"},{"start":72.091,"end":73.188,"text":"O dabi ẹni ti Ọ,","marked":"Ó dàbí ẹni tí Ọ"},{"start":73.638,"end":74.917,"text":"Kọ'le rẹ si eti odo,","marked":"Kọ̀'lè rẹ̀ sí etí odò"},{"start":75.367,"end":76.835,"text":"Ẹkun omi de o gba lọ,","marked":"Ẹkún omi dé ó gbà lọ"},{"start":77.285,"end":78.875,"text":"K'ẹ mase ro p'agbara yin,","marked":"K'ẹ máṣe rọ̀ p'agbára yín"},{"start":79.325,"end":80.62,"text":"La ko se fin yin silẹ.","marked":"La kò ṣe fín yín sílẹ̀."}],"end":80.62},{"key":"6","start":81.57,"lines":[{"start":81.57,"end":83.43,"text":"Jesu setan lati gba yin,","marked":"Jésù ṣetán láti gbà yín"},{"start":83.88,"end":85.394,"text":"O kun f' anu at'ifẹ,","marked":"Ó kún f àánú àt'ìfẹ́"},{"start":85.844,"end":87.059,"text":"Gb'ara rẹ le patapata,","marked":"Gb'ara rẹ̀ le pátápátá"},{"start":87.509,"end":88.64,"text":"Ma gb'ẹkẹl' ohun miran,","marked":"Má gb'ẹkẹl' ohun míràn"},{"start":89.09,"end":90.254,"text":"Gbohun-gbohun orukọ Rẹ,","marked":"Gbohun-gbohun orúkọ Rẹ"},{"start":90.704,"end":92.192,"text":"Si gba gbogbo ọrun kan,","marked":"Sì gba gbogbo ọ̀run kan"},{"start":92.642,"end":93.915,"text":"Ke Halleluya s'Ọlọrun,","marked":"Ké Hallelúyà s'Ọlọ́run"},{"start":94.365,"end":95.758,"text":"Fi 'baralẹ juba Rẹ.","marked":"Fi 'baralẹ júbà Rẹ."}],"end":95.758},{"key":"7","start":96.708,"lines":[{"start":96.708,"end":98.302,"text":"Ẹ f'Ogo fun Baba loke,","marked":"Ẹ f'Ògo fún Baba lókè"},{"start":98.752,"end":99.953,"text":"Ẹ f'Ogo fun Ọmọ Rẹ,","marked":"Ẹ f'Ògo fún Ọmọ Rẹ"},{"start":100.403,"end":102.034,"text":"Mẹtalọkan ayérayé,","marked":"Mẹ́talọ́kan ayérayé"},{"start":102.484,"end":103.516,"text":"A juba Orukọ Rẹ,","marked":"A júbà Orúkọ Rẹ̀"},{"start":103.966,"end":105.576,"text":"Mase jẹ ki 'pade wa yi,","marked":"Mase jẹ́ kí pàdé wa yí"},{"start":106.026,"end":107.435,"text":"Ko jẹ asan nigbẹhin,","marked":"Kò jẹ́ asán nígbẹ̀hìn"},{"start":107.885,"end":109.204,"text":"F'oju anu wo 'papọ wa,","marked":"F'ojú àánú wo 'papọ wá"},{"start":109.654,"end":111.294,"text":"K'a le ma pade titi.","marked":"K'á lè má pàdé títí."}],"end":111.294}]}