{"v":3,"coll":"y","num":435,"id":"hymn_435","title":"Emi ko wa oro aye","duration":57.368,"voices":{"male":{"file":"y-435-male-v3.m4a","bytes":403702,"sha256":"cf540a2a6711c3ace41dc4da3cd4cc18bf3bb5a274a514987ca667e91e392a28","duration":57.4},"female":{"file":"y-435-female-v3.m4a","bytes":421249,"sha256":"d9d9e33b255de0bc2a0bd7933b1e45ff34b6ef47996dbc15a69ff71b6a15346d","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.635,"text":"EMI ko wa oro aiye","marked":"Èmi kò wá ọ̀rọ̀ ayé"},{"start":2.085,"end":3.29,"text":"O pese f'aini mi,","marked":"Ó pèsè f'àìní mi"},{"start":3.74,"end":5.198,"text":"Sugbon ngo noga siwaju","marked":"Ṣùgbọ́n ńgọ́ nọ́gá síwájú"},{"start":5.648,"end":6.875,"text":"F'oju to mu hanhan","marked":"F'ojú tó mú hànhàn"},{"start":7.325,"end":8.488,"text":"Ki ngbekele O Oluwa","marked":"Kí ńgbẹ́kẹ̀lé Ọ Olúwa"},{"start":8.938,"end":10.386,"text":"F'ore-ofe ojojumo.","marked":"F'oore-ọ̀fẹ́ ojojúmọ́."}],"end":10.386},{"key":"CHORUS","start":11.336,"lines":[{"start":11.336,"end":12.705,"text":"Gbana l'okan mi o korin","marked":"Gbàná l'ọkàn mi ò kọrin"},{"start":13.155,"end":14.23,"text":"Labe agbelebu","marked":"Lábẹ́ àgbélébùú"},{"start":14.68,"end":16.14,"text":"Nitori 'simi dun l'ese Krist'","marked":"Nítorí ṣímí dùn l'ẹ̀ṣẹ̀ Krist"},{"start":16.59,"end":17.933,"text":"Gba mo fi 'gbagbo re 'le","marked":"Gbà mo fi gbàgbọ́ rẹ lé"},{"start":18.383,"end":19.616,"text":"Gba mo fi 'gbagbo re 'le.","marked":"Gbà mo fi gbàgbọ́ rẹ lé."}],"end":19.616},{"key":"2","start":20.566,"lines":[{"start":20.566,"end":22.055,"text":"Nki y'o nani ohun aiye","marked":"Ǹkí y'ó nání ohun ayé"},{"start":22.505,"end":23.593,"text":"To o nrogba yi mi ka","marked":"Tó ọ ńrọgbà yí mi ká"},{"start":24.043,"end":25.922,"text":"Sugbon ngo f 'ayo sa 'pa mi,","marked":"Ṣùgbọ́n ńgò f ayọ̀ sá pa mi"},{"start":26.372,"end":27.456,"text":"Iyoku d'owo Re","marked":"Ìyókù d'ọwọ́ Rẹ"},{"start":27.906,"end":29.2,"text":"O daju p'ere didun wa,","marked":"Ó dájú p'èrè dídùn wá"},{"start":29.65,"end":31.364,"text":"F'awon to simi l'Oluwa.","marked":"F'àwọn tó ṣímí l'Olúwa."}],"end":31.364},{"key":"3","start":32.314,"lines":[{"start":32.314,"end":34.395,"text":"Ng' ki y'o sa f'agbelebu mi,","marked":"Ng kí y'ó sá f'àgbélébùú mi"},{"start":34.845,"end":36.072,"text":"Ohun t'o wu k' o je","marked":"Ohun t'ó wù k ó jẹ́"},{"start":36.522,"end":38.515,"text":"Sugbon ki nsa le wa fun O","marked":"Ṣùgbọ́n kí ńsá lè wá fún Ọ"},{"start":38.965,"end":40.178,"text":"Ki nsa se ife Re","marked":"Kí ńsá ṣe ìfẹ́ Rẹ"},{"start":40.628,"end":41.984,"text":"Ki ng' se' fe Re lojojumo","marked":"Kí ng ṣe fẹ́ Rẹ lójojúmọ́"},{"start":42.434,"end":44.114,"text":"Gba mba fi 'gbagbo sunmole.","marked":"Gba mbá fi gbàgbọ́ súnmọ́lẹ̀."}],"end":44.114},{"key":"4","start":45.064,"lines":[{"start":45.064,"end":46.542,"text":"Gba mo ba pari ise mi","marked":"Gbà mo bá parí iṣẹ́ mi"},{"start":46.992,"end":48.102,"text":"Ti mo koja odo","marked":"Tí mo kọjá odò"},{"start":48.552,"end":49.991,"text":"Oluwa jo jek'okan mi","marked":"Olúwa jọ jẹ́k'ọkàn mi"},{"start":50.441,"end":52.157,"text":"Le ba O gbe titi","marked":"Lè bá Ọ gbé títí"},{"start":52.607,"end":53.962,"text":"Ki nko 'hun ti mo nihin","marked":"Kí ńkọ́ hun tí mo níhìn"},{"start":54.412,"end":55.818,"text":"Bi 'fe Re ti po si mi to.","marked":"Bí fẹ́ Rẹ ti pọ̀ sí mi tó."}],"end":55.818}]}