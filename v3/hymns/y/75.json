{"v":3,"coll":"y","num":75,"id":"hymn_75","title":"EMI Orun gb'adura wa","duration":47.455,"voices":{"male":{"file":"y-75-male-v3.m4a","bytes":332373,"sha256":"b8854fb80f006fb5dd6cfe96f07df4f37e5e96db67982710cceba5acff601490","duration":47.5},"female":{"file":"y-75-female-v3.m4a","bytes":344330,"sha256":"8b4211943d420dbe0aadd6c434994436a1cb6c0f9523f219120419eb8638f3af","duration":47.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.73,"text":"EMI Orun gb'adura wa,","marked":"Ẹ̀mí Ọ̀run gb'àdúrà wa"},{"start":2.18,"end":3.459,"text":"Wa gbe 'nu ile yi,","marked":"Wá gbé nu ilẹ̀ yí"},{"start":3.909,"end":5.718,"text":"Sokale pel'agbara Re,","marked":"Sọ̀kalẹ̀ pẹ̀l'agbára Rẹ"},{"start":6.168,"end":7.239,"text":"Wa Emi Mimo wa.","marked":"Wá Ẹ̀mí Mímọ́ wa."}],"end":7.239},{"key":"2","start":8.189,"lines":[{"start":8.189,"end":9.658,"text":"Wa bi 'mọlẹ si fi han wa,","marked":"Wá bí 'mọlẹ sì fi hàn wá"},{"start":10.108,"end":11.325,"text":"B'aini wa ti pọ to,","marked":"B'àìní wa ti pọ̀ tó"},{"start":11.775,"end":13.329,"text":"Wa tọ wa si ọna iye,","marked":"Wá tọ̀ wá sí ọ̀nà ìyè"},{"start":13.779,"end":14.688,"text":"Ti Olododo ń rin.","marked":"Tí Olódodo ń rìn."}],"end":14.688},{"key":"3","start":15.638,"lines":[{"start":15.638,"end":16.771,"text":"Wa bi ina ebo Mimo","marked":"Wá bí iná ẹbọ Mímọ́"},{"start":17.221,"end":18.382,"text":"S'okan wa di mimo,","marked":"S'ọkàn wa di mímọ́"},{"start":18.832,"end":20.213,"text":"Je ki okan wa je ore","marked":"Jẹ́ kí ọkàn wa jẹ́ ọrẹ"},{"start":20.663,"end":21.765,"text":"F'oruko Oluwa.","marked":"F'orúkọ Olúwa."}],"end":21.765},{"key":"4","start":22.715,"lines":[{"start":22.715,"end":24.241,"text":"p Wa bi iri si wa bukun,","marked":"p Wá bí ìrì sí wa bùkún"},{"start":24.691,"end":25.766,"text":"Akoko mimọ yi,","marked":"Àkókò mímọ́ yí"},{"start":26.216,"end":27.513,"text":"Ki ọkan alaileso wa,","marked":"Kí ọkàn aláìléso wà"},{"start":27.963,"end":29.192,"text":"Le yọ l'agbara Rẹ.","marked":"Lè yọ l'agbára Rẹ."}],"end":29.192},{"key":"5","start":30.142,"lines":[{"start":30.142,"end":31.717,"text":"p Wa bi adaba n'apa Rẹ,","marked":"p Wá bí àdàbà n'apá Rẹ"},{"start":32.167,"end":33.176,"text":"Apa ifẹ Mimọ,","marked":"Apá ìfẹ́ Mímọ́"},{"start":33.626,"end":35.197,"text":"Wa jẹ ki Ẹgbẹ yi l'ayé,","marked":"Wá jẹ́ kí Ẹgbẹ́ yí l'ayé"},{"start":35.647,"end":37.051,"text":"Dabi Ẹgbẹ t'ọrun.","marked":"Dàbí Ẹgbẹ́ t'ọ̀run."}],"end":37.051},{"key":"6","start":38.001,"lines":[{"start":38.001,"end":39.475,"text":"Ẹmi ọrun gb'adura wa,","marked":"Ẹ̀mí ọ̀run gb'àdúrà wa"},{"start":39.925,"end":41.13,"text":"S'ayé yi d'ile Rẹ,","marked":"S'ayé yí d'ilé Rẹ̀"},{"start":41.58,"end":43.707,"text":"Sọkalẹ pẹl'agbara Rẹ,","marked":"Sọ̀kalẹ̀ pẹ̀l'agbára Rẹ"},{"start":44.157,"end":45.905,"text":"Wa, Ẹmi Mimọ wa.","marked":"Wá, Ẹ̀mí Mímọ́ wà."}],"end":45.905}]}