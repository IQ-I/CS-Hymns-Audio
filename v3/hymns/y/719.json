{"v":3,"coll":"y","num":719,"id":"hymn_719","title":"Ki l'o tun yẹ wa loni yi","duration":44.686,"voices":{"male":{"file":"y-719-male-v3.m4a","bytes":313190,"sha256":"e6e7fb24bac278f7a587d4361f0c0672389aa395f4aa67384475ca970d53a566","duration":44.7},"female":{"file":"y-719-female-v3.m4a","bytes":320169,"sha256":"56c17d714ad287c61a997f86e142edffdbd04af39274759644ca820e8aef08ee","duration":44.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.824,"text":"Ki l'o tun yẹ wa loni yi,","marked":"Kí l'ó tún yẹ̀ wá lónì yí"},{"start":2.274,"end":3.87,"text":"Bi k'a jo k'a yọ s'Oluwa,","marked":"Bí k'á jọ k'á yọ̀ s'Olúwa"},{"start":4.32,"end":5.874,"text":"T'o mu wa r'ọdun yi l'ayọ,","marked":"T'ó mú wa r'ọdún yí l'ayọ̀"},{"start":6.324,"end":8.382,"text":"Ẹ ho, ẹ ke Halleluyah.","marked":"Ẹ hó, ẹ ké Hallelúyà."}],"end":8.382},{"key":"2","start":9.332,"lines":[{"start":9.332,"end":10.93,"text":"Eyi daju ni tiwa pe,","marked":"Èyí dájú ni tiwa pé"},{"start":11.38,"end":13.074,"text":"Jesu Kristi wa larin wa;","marked":"Jésù Kristi wà lárin wa"},{"start":13.524,"end":14.917,"text":"O ni k'a f'ọkan wa balẹ,","marked":"Ó ní k'á f'ọkàn wa balẹ̀"},{"start":15.367,"end":17.017,"text":"Baba ko ni jẹ k'a yanku.","marked":"Baba kò ní jẹ́ k'á yànkù."}],"end":17.017},{"key":"3","start":17.967,"lines":[{"start":17.967,"end":19.43,"text":"B'Oluwa ko kọ ile na,","marked":"B'Olúwa kò kọ́ ilẹ̀ ná"},{"start":19.88,"end":21.314,"text":"Awọn ti n kọ n sisẹ lasan,","marked":"Àwọn tí n kọ́ ń sisẹ́ lásán"},{"start":21.764,"end":23.262,"text":"B'Oluwa ko pa ilu mọ,","marked":"B'Olúwa kò pa ìlú mọ́"},{"start":23.712,"end":25.476,"text":"Olusọ sa kan ji lasan.","marked":"Olùsọ́ sá kàn jí lásán."}],"end":25.476},{"key":"4","start":26.426,"lines":[{"start":26.426,"end":27.987,"text":"Gbogbo Ẹyin asiwaju,","marked":"Gbogbo Ẹ̀yin aṣíwájú"},{"start":28.437,"end":29.866,"text":"Tẹsiwaju n'isẹ Oluwa,","marked":"Tẹ̀síwájú n'isẹ́ Olúwa"},{"start":30.316,"end":32.011,"text":"Baba y'o f'agbara wọ yin,","marked":"Baba y'ó f'agbára wọ yín"},{"start":32.461,"end":34.72,"text":"Lati sẹgun esu at'ẹsẹ.","marked":"Láti sẹ́gun èṣù àt'ẹsẹ̀."}],"end":34.72},{"key":"5","start":35.67,"lines":[{"start":35.67,"end":37.136,"text":"Oluwa y'o dabo bo wa,","marked":"Olúwa y'ó dàbò bò wá"},{"start":37.586,"end":38.966,"text":"Ọlọmọ ko ni padanu,","marked":"Ọlọ́mọ kò ní pàdánù"},{"start":39.416,"end":41.059,"text":"Agan y'o tọwọ rẹ b'osun","marked":"Àgàn y'ó tọwọ́ rẹ̀ b'osùn"},{"start":41.509,"end":43.137,"text":"Aboyun y'o bi l'abiye.","marked":"Aboyún y'ó bí l'abiye."}],"end":43.137}]}