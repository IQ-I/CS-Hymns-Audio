{"v":3,"coll":"y","num":665,"id":"hymn_665","title":"AWON Angeli ni orun","duration":49.182,"voices":{"male":{"file":"y-665-male-v3.m4a","bytes":342624,"sha256":"e1e5237c6835aef9df04ceed74a70b6b9843035e1526be499232b275fa0fefcd","duration":49.2},"female":{"file":"y-665-female-v3.m4a","bytes":352999,"sha256":"b30b0da32634d9b0a2179c9cb3cf7938b3d184a3980a5c0809b44b6888eb83df","duration":49.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.478,"text":"AWỌN Angẹli ni ọrun,","marked":"Àwọn Áńgẹ́lì ní ọ̀run"},{"start":1.928,"end":3.225,"text":"Yin Ọ logo, Ọlọrun wa,","marked":"Yin Ọ́ lógo, Ọlọ́run wa"},{"start":3.675,"end":4.845,"text":"Iwuwo ọpa 'binu Rẹ,","marked":"Ìwúwo ọ̀pá bínú Rẹ̀"},{"start":5.295,"end":6.913,"text":"N damu esu l'ọrun ẹgbẹ.","marked":"Ń dàmú èṣù l'ọ̀run ẹgbẹ́."}],"end":6.913},{"key":"2","start":7.863,"lines":[{"start":7.863,"end":9.026,"text":"Gbogbo ẹyin ọmọ-kọmọ,","marked":"Gbogbo ẹ̀yin ọmọ-kọmọ"},{"start":9.476,"end":10.809,"text":"Asepe ati abura;","marked":"Àṣepé àti àbúrà"},{"start":11.259,"end":12.65,"text":"Ẹ se 'ranti ofin kẹta,","marked":"Ẹ ṣe rántí òfin kẹta"},{"start":13.1,"end":14.651,"text":"Kẹ bọwọ f'Okọ Ọlọrun.","marked":"Kẹ́ bọ̀wọ̀ f'Okọ Ọlọ́run."}],"end":14.651},{"key":"3","start":15.601,"lines":[{"start":15.601,"end":17.826,"text":"Wọn o se le duro, Baba,","marked":"Wọn ó ṣe lè dúró, Baba"},{"start":18.276,"end":19.552,"text":"Niwaju agbara nla Rẹ!","marked":"Níwájú agbára ńlá Rẹ!"},{"start":20.002,"end":21.085,"text":"Awọn alaibẹru Ọlọrun,","marked":"Àwọn aláìbẹ̀rù Ọlọ́run"},{"start":21.535,"end":22.866,"text":"Yoo lọ si ọrun egbe!","marked":"Yóò lọ sí ọ̀run ẹgbẹ́!"}],"end":22.866},{"key":"4","start":23.816,"lines":[{"start":23.816,"end":25.523,"text":"Nibi ti ki y'o si omi,","marked":"Níbi tí kí y'ó sí omi"},{"start":25.973,"end":27.523,"text":"Ti y'o pa oungbẹ ọfun wọn,","marked":"Tí y'ó pa òùngbẹ ọ̀fun wọn"},{"start":27.973,"end":29.402,"text":"Emi y'o ma yin Ọ titi,","marked":"Èmi y'ó má yín Ọ́ títí"},{"start":29.852,"end":31.335,"text":"Bi n ó ti ma yin ni ọrun.","marked":"Bí n ó ti má yín ní ọ̀run."}],"end":31.335},{"key":"5","start":32.285,"lines":[{"start":32.285,"end":33.626,"text":"Ibanujẹ nla ni fun mi","marked":"Ìbànújẹ́ ńlá ni fún mi"},{"start":34.076,"end":35.671,"text":"Lati gbọ ọrọ buburu;","marked":"Láti gbọ́ ọ̀rọ̀ búburú"},{"start":36.121,"end":37.327,"text":"Ti awọn ọmọkọmọ n sọ,","marked":"Tí àwọn ọmọkọmọ ń sọ"},{"start":37.777,"end":39.411,"text":"Si Eledumare Baba!","marked":"Sí Elédùmarè Baba!"}],"end":39.411},{"key":"6","start":40.361,"lines":[{"start":40.361,"end":41.483,"text":"Gbogbo wọn ni n ó l'ọrẹ,","marked":"Gbogbo wọn ní ń ó l'ọrẹ"},{"start":41.933,"end":43.13,"text":"Awọn alaibẹru Ọlọrun,","marked":"Àwọn aláìbẹ̀rù Ọlọ́run"},{"start":43.58,"end":45.183,"text":"Ti wọn n p'orukọ Rẹ lasan,","marked":"Tí wọ́n ń p'orúkọ Rẹ̀ lásán"},{"start":45.633,"end":47.633,"text":"Ti wọn mbura, ti wọn n sepe.","marked":"Tí wọ́n mbúra, tí wọ́n ń ṣépè."}],"end":47.633}]}