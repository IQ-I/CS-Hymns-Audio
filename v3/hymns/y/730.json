{"v":3,"coll":"y","num":730,"id":"hymn_730","title":"MAIKIEL Olusegun","duration":65.533,"voices":{"male":{"file":"y-730-male-v3.m4a","bytes":445273,"sha256":"912b764f6b8d20de8dad92a47d06617995f7f1e9e4791d508141389f060ce32e","duration":65.6},"female":{"file":"y-730-female-v3.m4a","bytes":467920,"sha256":"241c8ff33f6a0fdbe06bf6ddd1e2b0983782fe85affcb68292d31776460af0fe","duration":65.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.74,"text":"MAIKIEL Olusegun","marked":"Maikiel Olùṣègùn"},{"start":2.19,"end":3.31,"text":"Yara sokale wa","marked":"Yára sọ̀kalẹ̀ wá"},{"start":3.76,"end":4.845,"text":"Loni n'isegun re","marked":"Lónì n'ìṣẹ́gun rẹ̀"},{"start":5.295,"end":6.474,"text":"Mase duro pe mo.","marked":"Máṣe dúró pè mọ́."}],"end":6.474},{"key":"2","start":7.424,"lines":[{"start":7.424,"end":9.205,"text":"Isẹgun rẹ, Baba,","marked":"Ìsẹ́gun rẹ̀, Baba"},{"start":9.655,"end":10.736,"text":"O pọ ju t'eniyan,","marked":"Ó pọ̀ ju t'ènìyàn"},{"start":11.186,"end":12.585,"text":"Jahora Ọba wa,","marked":"Jahora Ọba wa"},{"start":13.035,"end":14.409,"text":"Sẹgun iku fun wa.","marked":"Sẹ́gun ikú fún wa."}],"end":14.409},{"key":"3","start":15.359,"lines":[{"start":15.359,"end":16.367,"text":"Ogun aje gbona","marked":"Ogun ajé gbóná"},{"start":16.817,"end":17.8,"text":"Ogun oso gbona","marked":"Ogun ọ̀ṣọ́ gbóná"},{"start":18.25,"end":19.302,"text":"Asahola-Hurah","marked":"Asahola-hurah"},{"start":19.752,"end":20.921,"text":"Wa segun ota wa.","marked":"Wá ṣẹ́gun ọ̀tá wa."}],"end":20.921},{"key":"4","start":21.871,"lines":[{"start":21.871,"end":23.007,"text":"Apejuba Hujjah,","marked":"Àpèjúbá Hujjah"},{"start":23.457,"end":24.727,"text":"Yawottah Saharah,","marked":"Yawottah Saharah"},{"start":25.177,"end":26.238,"text":"Ẹyin onida ina,,","marked":"Ẹ̀yin onídà iná"},{"start":26.688,"end":28.136,"text":"Sẹgun ajẹ fun wa.","marked":"Sẹ́gun àjẹ́ fún wa."}],"end":28.136},{"key":"5","start":29.086,"lines":[{"start":29.086,"end":30.239,"text":"Iyamma Iyamma,","marked":"Ìyàmmá Ìyàmmá"},{"start":30.689,"end":31.766,"text":"Ọba 'Lewilese,","marked":"Ọba lewilese"},{"start":32.216,"end":33.615,"text":"Ajagorah Hullah,","marked":"Ajagorah Hullah"},{"start":34.065,"end":35.255,"text":"P'agbara ajẹ run.","marked":"P'agbára àjẹ́ run."}],"end":35.255},{"key":"6","start":36.205,"lines":[{"start":36.205,"end":37.323,"text":"Ẹyin Kérúbù ọrun,","marked":"Ẹ̀yin Kérúbù ọ̀run"},{"start":37.773,"end":38.905,"text":"At'ẹyin Séráfù,","marked":"Àt'ẹ̀yin Séráfù"},{"start":39.355,"end":40.49,"text":"Ẹ n de fun iranwọ,","marked":"Ẹ ń dé fún ìrànwọ́"},{"start":40.94,"end":42.448,"text":"Awa t'aginju ayé","marked":"Àwa t'aginjù ayé"}],"end":42.448},{"key":"7","start":43.398,"lines":[{"start":43.398,"end":44.391,"text":"Emmanuel Baba,","marked":"Emmanuel Baba"},{"start":44.841,"end":46.043,"text":"Olusẹgun iku,","marked":"Olùsẹ̀gùn ikú"},{"start":46.493,"end":47.994,"text":"Ọba aiku ni Ọ","marked":"Ọba àìkú ni Ọ"},{"start":48.444,"end":49.788,"text":"Yara wa gba wa la.","marked":"Yàrá wa gbà wá là."}],"end":49.788},{"key":"8","start":50.738,"lines":[{"start":50.738,"end":51.98,"text":"Ojira-Saro-Fa","marked":"Ojira-saro-fa"},{"start":52.43,"end":53.807,"text":"Eli-Eli-Yaworah,","marked":"Eli-eli-yaworah"},{"start":54.257,"end":55.268,"text":"Oba 'wimayehun","marked":"Ọba wímáyèhùn"},{"start":55.718,"end":56.941,"text":"Wa se t'emi n'ire.","marked":"Wá ṣe t'èmi n'ìre."}],"end":56.941},{"key":"9","start":57.891,"lines":[{"start":57.891,"end":58.952,"text":"Ogo ni fun Baba","marked":"Ògo ni fún Baba"},{"start":59.402,"end":60.492,"text":"Ogo ni fun Omo,","marked":"Ògo ni fún Ọmọ"},{"start":60.942,"end":61.997,"text":"Ogo f'Emi Mimo","marked":"Ògo f'Ẹ̀mí Mímọ́"},{"start":62.447,"end":63.984,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":63.984}]}