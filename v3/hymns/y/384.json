{"v":3,"coll":"y","num":384,"id":"hymn_384","title":"EMI 'bukun ti a n sin","duration":124.674,"voices":{"male":{"file":"y-384-male-v3.m4a","bytes":869596,"sha256":"0e6f743f46e9c51f66428604a4382fd7f6bd420a25c7a3f81cd1e5dc7752c002","duration":124.7},"female":{"file":"y-384-female-v3.m4a","bytes":900364,"sha256":"a03b27a60a321de29611f3fedd9f5ee950aeccc6325f996c4e08b9cfa4adddfb","duration":124.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.849,"text":"ẸMI 'bukun ti a ń sin,","marked":"Ẹ̀mí bùkún tí à ń sìn"},{"start":2.299,"end":3.651,"text":"Pẹlu baba at'Ọrọ,","marked":"Pẹ̀lú Baba àt'Ọ̀rọ̀"},{"start":4.101,"end":5.119,"text":"Ọlọrun ayérayé;","marked":"Ọlọ́run ayérayé"},{"start":5.569,"end":7.092,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":7.092},{"key":"2","start":8.042,"lines":[{"start":8.042,"end":9.297,"text":"Ẹmi Mimọ 'Daba ọrun,","marked":"Ẹ̀mí Mímọ́ dàbà ọ̀run"},{"start":9.747,"end":11.089,"text":"Iri ti ń sẹ lat'oke,","marked":"Ìrì tí ń sẹ̀ lát'òkè"},{"start":11.539,"end":13.051,"text":"Ẹmi 'ye at'ina 'fẹ,","marked":"Ẹ̀mí yè àt'iná 'fẹ"},{"start":13.501,"end":15.163,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":15.163},{"key":"3","start":16.113,"lines":[{"start":16.113,"end":17.567,"text":"Isun ipa at'imọ,","marked":"Ìsun ipa àt'ìmọ̀"},{"start":18.017,"end":19.294,"text":"Ọgbọn at'iwa mimọ,","marked":"Ọgbọ́n àt'ìwà mímọ́"},{"start":19.744,"end":21.668,"text":"Oye, imọran, eru;","marked":"Òye, ìmọ̀ràn, ẹ̀rù"},{"start":22.118,"end":23.739,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":23.739},{"key":"4","start":24.689,"lines":[{"start":24.689,"end":26.337,"text":"Isun ifẹ, alafia,","marked":"Ìsun ìfẹ́, àlàáfíà"},{"start":26.787,"end":28.689,"text":"Suru, ibisi 'gbagbọ,","marked":"Sùrù, ìbísí 'gbagbọ"},{"start":29.139,"end":31.39,"text":"'Reti, ayọ ti ki tan;","marked":"retí, ayọ̀ tí kì tán"},{"start":31.84,"end":33.518,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":33.518},{"key":"5","start":34.468,"lines":[{"start":34.468,"end":35.679,"text":"Ẹmi af'ọna han ni,","marked":"Ẹ̀mí àf'ọ̀nà hàn ni"},{"start":36.129,"end":37.285,"text":"Ẹmi ti ń mu 'mọlẹ wa,","marked":"Ẹ̀mí tí ń mú 'mọlẹ wá"},{"start":37.735,"end":38.899,"text":"Ẹmi agbara gbogbo;","marked":"Ẹ̀mí agbára gbogbo"},{"start":39.349,"end":41.001,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":41.001},{"key":"6","start":41.951,"lines":[{"start":41.951,"end":43.276,"text":"'Wọ t'o mu Wundia bi,","marked":"'Wọ t'ó mú Wúńdíá bí"},{"start":43.726,"end":45.144,"text":"Ẹni t'ọrun t'ayé mbọ,","marked":"Ẹni t'ọ̀run t'ayé mbọ́"},{"start":45.594,"end":47.143,"text":"T'a ran lati tun wa bi,","marked":"T'á rán láti tún wá bí"},{"start":47.593,"end":49.249,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":49.249},{"key":"7","start":50.199,"lines":[{"start":50.199,"end":52.028,"text":"'Wọ ti Jesu t'oke ran,","marked":"'Wọ tí Jésù t'òkè rán"},{"start":52.478,"end":53.787,"text":"Wa tu eniyan Rẹ ninu,","marked":"Wá tú ènìyàn Rẹ̀ nínú"},{"start":54.237,"end":55.593,"text":"Ki wọn ma ba nikan wa,","marked":"Kí wọn má ba nìkan wá"},{"start":56.043,"end":57.686,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":57.686},{"key":"8","start":58.636,"lines":[{"start":58.636,"end":60.074,"text":"'Wọ t'o ń f'ore kun Ijọ,","marked":"'Wọ t'ó ń f'ọrẹ kún Ìjọ"},{"start":60.524,"end":61.927,"text":"T'o ń fi ifẹ Baba han,","marked":"T'ó ń fi ìfẹ́ Baba hàn"},{"start":62.377,"end":64.024,"text":"T'O ń mu k'o ma ri Jesu;","marked":"T'Ó ń mú k'ó má rí Jésù"},{"start":64.474,"end":66.042,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":66.042},{"key":"9","start":66.992,"lines":[{"start":66.992,"end":68.293,"text":"F'ẹbun meje Rẹ fun ni,","marked":"F'ẹ̀bùn méje Rẹ fún ni"},{"start":68.743,"end":69.923,"text":"Ọgbọn lati m'Ọlọrun,","marked":"Ọgbọ́n láti m'Ọlọ́run"},{"start":70.373,"end":71.622,"text":"Ipa lati ko ọta:","marked":"Ipa láti kọ ọ̀tá"},{"start":72.072,"end":73.78,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":73.78},{"key":"10","start":74.73,"lines":[{"start":74.73,"end":76.138,"text":"Pa ẹsẹ run lọkan wa,","marked":"Pa ẹsẹ̀ run lọ́kàn wa"},{"start":76.588,"end":77.657,"text":"Tọ ifẹ wa si ọna,","marked":"Tọ ìfẹ́ wá sí ọ̀nà"},{"start":78.107,"end":80.547,"text":"'Gba ba n sẹ Ọ, mu sùúrù;","marked":"gbà bá ń sẹ́ Ọ́, mú sùúrù"},{"start":80.997,"end":82.795,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":82.795},{"key":"11","start":83.745,"lines":[{"start":83.745,"end":85.076,"text":"Gbe wa dide b'a subu","marked":"Gbé wa dìde b'á ṣubú"},{"start":85.526,"end":86.717,"text":"Ati nigba idanwo","marked":"Àti nígbà ìdánwò"},{"start":87.167,"end":88.653,"text":"Sa pe wa pada pele","marked":"Sá pé wá padà pẹ̀lẹ́"},{"start":89.103,"end":90.714,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":90.714},{"key":"12","start":91.664,"lines":[{"start":91.664,"end":93.493,"text":"Wa, k'O mu ailera le,","marked":"Wá, k'Ó mú àìlera le"},{"start":93.943,"end":95.237,"text":"F'igboya fun alarẹ,","marked":"F'ìgboyà fún alárẹ"},{"start":95.687,"end":97.372,"text":"Kọ wa l'ọrọ t'a o sọ;","marked":"Kọ́ wá l'ọ̀rọ̀ t'á ó sọ"},{"start":97.822,"end":99.687,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":99.687},{"key":"13","start":100.637,"lines":[{"start":100.637,"end":101.941,"text":"Wa ran ọkan wa lọwọ,","marked":"Wá rán ọkàn wa lọ́wọ́"},{"start":102.391,"end":103.61,"text":"Lati mọ otitọ Rẹ,","marked":"Láti mọ òtítọ́ Rẹ"},{"start":104.06,"end":105.549,"text":"Ki 'fẹ wa le ma gbona;","marked":"Kí 'fẹ wá lè má gbóná"},{"start":105.999,"end":107.619,"text":"Ẹmi Mimọ, gbọ tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":107.619},{"key":"14","start":108.569,"lines":[{"start":108.569,"end":109.725,"text":"Pa wa mọ l'ọna toro,","marked":"Pa wá mọ́ l'ọ̀nà tọ́rọ̀"},{"start":110.175,"end":111.607,"text":"Ba wa wi nigb'a n sako,","marked":"Bá wa wí nígb'à ń ṣáko"},{"start":112.057,"end":113.304,"text":"Ba wa bẹbẹ l'adura,","marked":"Bá wa bẹ̀bẹ̀ l'àdúrà"},{"start":113.754,"end":115.346,"text":"Ẹmi Mimọ, gbẹ tiwa.","marked":"Ẹ̀mí Mímọ́, gbẹ tiwa."}],"end":115.346},{"key":"15","start":116.296,"lines":[{"start":116.296,"end":117.239,"text":"Eni Mimo Olufe","marked":"Ẹni Mímọ́ Olùfẹ́"},{"start":117.689,"end":119.182,"text":"Wa gbe inu okan wa","marked":"Wá gbé inú ọkàn wa"},{"start":119.632,"end":121.075,"text":"Ma fi wa sile titi","marked":"Má fi wá sílẹ̀ títí"},{"start":121.525,"end":123.126,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́, gbọ́ tiwa."}],"end":123.126}]}