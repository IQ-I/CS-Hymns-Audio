{"v":3,"coll":"y","num":318,"id":"hymn_318","title":"L'OWURO ojo Ajinde","duration":69.188,"voices":{"male":{"file":"y-318-male-v3.m4a","bytes":485412,"sha256":"17c0e7e6e83feb47cbcefb54c34bbdb0d72bba3ee999b0bcbe5163ffb037b784","duration":69.2},"female":{"file":"y-318-female-v3.m4a","bytes":505663,"sha256":"20eb3d67dac0768a4f07a1e8bb4689ab599c1623836a648d69bce50dc4a8866e","duration":69.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.922,"text":"L'OWURỌ ọjọ Ajinde,","marked":"L'Òwúrọ̀ ọjọ́ Àjíǹde"},{"start":2.372,"end":4.057,"text":"T'ara t'ọkan yoo pade,","marked":"T'ara t'ọkàn yóò pàdé"},{"start":4.507,"end":6.64,"text":"Ẹkun, 'kanu oun irora,","marked":"Ẹkún, kanu òun ìrora"},{"start":7.09,"end":7.974,"text":"Y'o dopin.","marked":"Y'ó dópin."}],"end":7.974},{"key":"2","start":8.924,"lines":[{"start":8.924,"end":10.238,"text":"Nihin wọn ko le sai pinya,","marked":"Níhìn wọn kò lè ṣàì pínyà"},{"start":10.688,"end":12.098,"text":"Ki ara ba le sinmi,","marked":"Kí ara bá lè sinmi"},{"start":12.548,"end":14.365,"text":"K'o si fi idakẹrọrọ,","marked":"K'ó sì fi ìdákẹ́rọ́rọ́"},{"start":14.815,"end":15.861,"text":"Sun fọnfọn.","marked":"Sùn fọnfọn."}],"end":15.861},{"key":"3","start":16.811,"lines":[{"start":16.811,"end":18.326,"text":"Fun 'gba diẹ ara arẹ yi,","marked":"Fún gba díẹ̀ ara arẹ yí"},{"start":18.776,"end":20.137,"text":"L'a gbe s'ibi 'sinmi rẹ;","marked":"L'á gbé s'ibi sinmi rẹ̀"},{"start":20.587,"end":21.97,"text":"Titi di imọlẹ ọrọ,","marked":"Títí di ìmọ́lẹ̀ ọ̀rọ̀"},{"start":22.42,"end":23.262,"text":"Ajinde.","marked":"Àjíǹde."}],"end":23.262},{"key":"4","start":24.212,"lines":[{"start":24.212,"end":25.82,"text":"Ọkan t'o kanu nisinyi,","marked":"Ọkàn t'ó kanú nísìnyí"},{"start":26.27,"end":27.834,"text":"T'o si n gbadura kikan,","marked":"T'ó sì ń gbàdúrà kíkan"},{"start":28.284,"end":29.892,"text":"Y'o bu s'orin ayọ l'ọjọ","marked":"Y'ó bú s'orin ayọ̀ l'ọjọ́"},{"start":30.342,"end":31.227,"text":"Ajinde.","marked":"Àjíǹde."}],"end":31.227},{"key":"5","start":32.177,"lines":[{"start":32.177,"end":34.025,"text":"Ara at'ọkan y'o dapọ,","marked":"Ara àt'ọkàn y'ó dàpọ̀"},{"start":34.475,"end":35.77,"text":"Ipinya ko ni si mọ;","marked":"Ìpínyà kò ní sí mọ́"},{"start":36.22,"end":37.976,"text":"cr Wọn o ji l'aworan Krist, ni","marked":"cr Wọn ó jí l'àwòrán Krist, ni"},{"start":38.426,"end":39.175,"text":"'Tẹlọrun.","marked":"'Tẹlọrun."}],"end":39.175},{"key":"6","start":40.125,"lines":[{"start":40.125,"end":42.476,"text":"A! ẹwa na at'ayọ na,","marked":"A! ẹwà na àt'ayọ̀ ná"},{"start":42.926,"end":44.564,"text":"Y'o ti pọ to l'Ajinde!","marked":"Y'ó ti pọ̀ tó l'Àjíǹde!"},{"start":45.014,"end":47.565,"text":"Y'o duro, b'ọrun at'ayé,","marked":"Y'ó dúró, b'ọ̀run at'ayé"},{"start":48.015,"end":48.92,"text":"Ba fo lọ.","marked":"Bá fò lọ."}],"end":48.92},{"key":"7","start":49.87,"lines":[{"start":49.87,"end":51.421,"text":"L'oro ojo Ajinde wa,","marked":"L'ọ̀rọ̀ ọjọ́ Àjíǹde wà"},{"start":51.871,"end":53.218,"text":"'Boji y'o m'oku re wa","marked":"bojì y'ó m'òkú rẹ̀ wá"},{"start":53.668,"end":56.49,"text":"Baba, iya, omo, ara","marked":"Baba, ìyá, ọmọ, ara"},{"start":56.94,"end":57.88,"text":"Y'o pade.","marked":"Y'ó pàdé."}],"end":57.88},{"key":"8","start":58.83,"lines":[{"start":58.83,"end":60.627,"text":"Si 'dapọ ti o dun bayi,","marked":"Sì 'dapọ tí ó dùn báyì"},{"start":61.077,"end":63.411,"text":"Jesu, masai ka wa yẹ,","marked":"Jésù, masai ká wá yẹ"},{"start":63.861,"end":66.188,"text":"N'nu 'ku 'dajọ, k'a le ro","marked":"N'nú kú 'dajọ, k'á lè rò"},{"start":66.638,"end":67.639,"text":"m'a 'Gbelebu.","marked":"m'á gbélébù."}],"end":67.639}]}