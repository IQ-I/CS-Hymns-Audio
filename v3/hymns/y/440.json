{"v":3,"coll":"y","num":440,"id":"hymn_440","title":"IGBAGBO mi wo O","duration":46.733,"voices":{"male":{"file":"y-440-male-v3.m4a","bytes":316626,"sha256":"de373b6af448ed5647de149965185de73295d6d140e39ee2380f9fbdf844cbfb","duration":46.8},"female":{"file":"y-440-female-v3.m4a","bytes":333090,"sha256":"e030f56794d356ee626f024f5b3bbefa1269a94d16b201aa8d6dcd4dbb6a5944","duration":46.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.312,"text":"IGBAGBỌ mi wo Ọ,","marked":"Ìgbàgbọ́ mi wò Ọ́"},{"start":1.762,"end":2.889,"text":"Iwọ Ọdaguntan,","marked":"Ìwọ Ọ̀dàgùntàn"},{"start":3.339,"end":4.06,"text":"Olugbala,","marked":"Olùgbàlà"},{"start":4.51,"end":5.89,"text":"Jọ, gbọ adura mi,","marked":"Jọ, gbọ́ àdúrà mi"},{"start":6.34,"end":7.484,"text":"M'ẹsẹ mi gbogbo lọ,","marked":"M'ẹsẹ̀ mi gbogbo lọ"},{"start":7.934,"end":8.991,"text":"K'emi lat'oni lọ,","marked":"K'èmi lát'òní lọ"},{"start":9.441,"end":10.404,"text":"Si jẹ Tirẹ","marked":"Sì jẹ́ Tirẹ̀"}],"end":10.404},{"key":"2","start":11.354,"lines":[{"start":11.354,"end":12.349,"text":"Ki ore-ofe Re","marked":"Kí oore-ọ̀fẹ́ Rẹ"},{"start":12.799,"end":13.932,"text":"F'ilera f'okan mi","marked":"F'ìlera f'ọkàn mi"},{"start":14.382,"end":15.323,"text":"Mu mi tara","marked":"Mú mi tara"},{"start":15.773,"end":16.943,"text":"B'Iwo ti ku fun mi","marked":"B'Ìwọ ti kú fún mi"},{"start":17.393,"end":18.871,"text":"A! k'ife mi si O","marked":"A! k'ìfẹ́ mi sí Ọ"},{"start":19.321,"end":20.517,"text":"K'o ma gbona titi!","marked":"K'ó má gbóná títí!"},{"start":20.967,"end":21.792,"text":"B'ina iye.","marked":"B'íná ìyè."}],"end":21.792},{"key":"3","start":22.742,"lines":[{"start":22.742,"end":24.227,"text":"'Gba mo n rin l'okunkun,","marked":"gbà mò ń rìn l'òkùnkùn"},{"start":24.677,"end":25.578,"text":"Ninu ibinujẹ;","marked":"Nínú ìbìnújẹ́"},{"start":26.028,"end":27.055,"text":"S'amọna mi;","marked":"S'amọ̀nà mi"},{"start":27.505,"end":28.532,"text":"M'okunkun lọ loni,","marked":"M'òkùnkùn lọ lónì"},{"start":28.982,"end":30.046,"text":"Pa 'banujẹ mi rẹ,","marked":"Pa 'banujẹ mi rẹ"},{"start":30.496,"end":31.905,"text":"Ki n ma sako kuro,","marked":"Kí n má ṣáko kúrò"},{"start":32.355,"end":33.209,"text":"Ni ọdọ Rẹ.","marked":"Ní ọ̀dọ̀ Rẹ."}],"end":33.209},{"key":"4","start":34.159,"lines":[{"start":34.159,"end":35.426,"text":"'Gbati ayé ba pin","marked":"gbátí ayé bá pín"},{"start":35.876,"end":37.041,"text":"T'odo tutu iku,","marked":"T'odò tútù ikú"},{"start":37.491,"end":38.379,"text":"Nsan lori mi;","marked":"Ǹsàn lórí mi"},{"start":38.829,"end":40.39,"text":"Jesu, ninu ifẹ,","marked":"Jésù, nínú ìfẹ́"},{"start":40.84,"end":41.926,"text":"Mu k'ifoya mi lọ,","marked":"Mú k'ìfòyà mi lọ"},{"start":42.376,"end":43.563,"text":"Gbe mi d'oke orun,","marked":"Gbé mi d'òkè ọ̀run"},{"start":44.013,"end":45.184,"text":"B'ọkan t'a ra.","marked":"B'ọkàn t'á rà."}],"end":45.184}]}