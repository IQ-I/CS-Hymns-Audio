{"v":3,"coll":"y","num":171,"id":"hymn_171","title":"OLUWA 'kore. 'Wo l'a n yin","duration":50.76,"voices":{"male":{"file":"y-171-male-v3.m4a","bytes":362345,"sha256":"79eaa664cebfb44873d3a4563607b75c3e9e6649ebec7bff3c38a76538451779","duration":50.8},"female":{"file":"y-171-female-v3.m4a","bytes":372206,"sha256":"a74b6b51d54b9715dd53f93872a5d7e62439d3fd0cb17d07843f46466e050c36","duration":50.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.554,"text":"OLUWA 'kore. 'Wọ l'a ń yin,","marked":"Olúwa kórè. 'Wọ l'á ń yín"},{"start":3.004,"end":4.388,"text":"Ileri Rẹ 'gbani ko yẹ;","marked":"Ìlérí Rẹ̀ gbani kò yẹ"},{"start":4.838,"end":6.571,"text":"Orisi igba si ń yipo,","marked":"Oríṣi ìgbà sì ń yípo"},{"start":7.021,"end":8.407,"text":"Ọdọdun kun fun ore Rẹ,","marked":"Ọdọdún kún fún ọrẹ Rẹ̀"},{"start":8.857,"end":10.78,"text":"Lọjọ oni, awa dupẹ,","marked":"Lọ́jọ́ òní, àwa dúpẹ́"},{"start":11.23,"end":12.56,"text":"Jẹ k'iyin gba ọkan wa kan.","marked":"Jẹ́ k'ìyìn gba ọkàn wa kan."}],"end":12.56},{"key":"2","start":13.51,"lines":[{"start":13.51,"end":14.906,"text":"B'akoko 'rugbin mu wa yọ,","marked":"B'àkókò rúgbìn mú wa yọ"},{"start":15.356,"end":16.551,"text":"B'igba ẹrun ń mu oru wa;","marked":"B'ìgbà ẹ̀rùn ń mú òru wá"},{"start":17.001,"end":18.424,"text":"'Gbati ọwọ ojo naa ń rinlẹ,","marked":"gbàtí ọwọ́ ọjọ́ náà ń rinlẹ̀"},{"start":18.874,"end":20.603,"text":"Tab' igba ti ikore ba pọn,","marked":"Tàb ìgbà tí ìkórè bá pọ́n"},{"start":21.053,"end":22.633,"text":"'Wo Ọba wa l'a o ma yin;","marked":"wò Ọba wa l'a ó má yín"},{"start":23.083,"end":24.474,"text":"'Wọ l'akoso gbogbo wọn.","marked":"'Wọ l'àkóso gbogbo wọn."}],"end":24.474},{"key":"3","start":25.424,"lines":[{"start":25.424,"end":27.12,"text":"Ju gbogbo rẹ lọ, nigba ti,","marked":"Ju gbogbo rẹ̀ lọ, nígbà tí"},{"start":27.57,"end":29.01,"text":"Ọwọ Rẹ fun ọpọ ka'lẹ;","marked":"Ọwọ́ Rẹ fún ọ̀pọ̀ ká'lẹ́"},{"start":29.46,"end":31.266,"text":"'Gba t'ohun ayọ, gbilẹ kan,","marked":"gbà t'ohun ayọ̀, gbilẹ̀ kan"},{"start":31.716,"end":33.371,"text":"B'ẹda ti ń ko ire wọn jọ;","marked":"B'ẹ̀dà tí ń kó ìre wọn jọ"},{"start":33.821,"end":35.164,"text":"Awa pẹlu y'o ma yin Ọ,","marked":"Àwa pẹ̀lú y'ó má yìn Ọ́"},{"start":35.614,"end":36.924,"text":"Ọrẹ Rẹ ni gbogbo wa ń pin.","marked":"Ọrẹ Rẹ̀ ni gbogbo wa ń pín."}],"end":36.924},{"key":"4","start":37.874,"lines":[{"start":37.874,"end":39.523,"text":"Oluwa 'kore, Tirẹ ni,","marked":"Olúwa kórè, Tirẹ̀ ni"},{"start":39.973,"end":41.949,"text":"Ojo ti ń rọ, orun ti ń ran;","marked":"Ọjọ́ tí ń rọ̀, ọ̀run tí ń rán"},{"start":42.399,"end":43.863,"text":"Irugbin ti a gbin silẹ,","marked":"Irúgbìn tí a gbìn sílẹ̀"},{"start":44.313,"end":45.664,"text":"Tirẹ l'ọgbọn ti ń mu dagba;","marked":"Tirẹ̀ l'ọgbọ́n tí ń mú dàgbà"},{"start":46.114,"end":47.576,"text":"Ọtun l'ẹbun Rẹ l'ọdọdun,","marked":"Ọ̀tún l'ẹ̀bùn Rẹ̀ l'ọdọdún"},{"start":48.026,"end":49.211,"text":"Ọtun n'iyin Rẹ l'ẹnu wa.","marked":"Ọ̀tún n'ìyìn Rẹ̀ l'ẹnu wà."}],"end":49.211}]}