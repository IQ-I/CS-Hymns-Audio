{"v":3,"coll":"y","num":202,"id":"hymn_202","title":"NIGBA kan ni Betlehemu","duration":70.678,"voices":{"male":{"file":"y-202-male-v3.m4a","bytes":497785,"sha256":"889d6e6f0e672aca8a536c26441c989fe55164d836485e1c000f87c2fa2200eb","duration":70.7},"female":{"file":"y-202-female-v3.m4a","bytes":509691,"sha256":"6526c3c08cb845176a6dfca4e4545c063c6e75d2886b13be5818f09e20985212","duration":70.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.85,"text":"NIGBA kan ni Betlehemu,","marked":"Nígbà kan ní Bẹ́tílẹ́hẹ́mù"},{"start":2.3,"end":3.688,"text":"Ile kekere kan wa;","marked":"Ilẹ̀ kékeré kan wà"},{"start":4.138,"end":5.709,"text":"Nib'iya kan tẹ 'mọ rẹ si,","marked":"Níb'ìyà kan tẹ́ 'mọ rẹ̀ sí"},{"start":6.159,"end":7.247,"text":"Lori ibujẹ ẹran;","marked":"Lórí ibùjẹ ẹran"},{"start":7.697,"end":9.088,"text":"Maria n'iya ọmọ naa,","marked":"Màríà n'ìyá ọmọ náà"},{"start":9.538,"end":10.974,"text":"Jesu Kristi l'ọmọ naa.","marked":"Jésù Kristi l'ọmọ náà."}],"end":10.974},{"key":"2","start":11.924,"lines":[{"start":11.924,"end":13.629,"text":"O t'ọrun wa sode ayé,","marked":"Ó t'ọ̀run wá sóde ayé"},{"start":14.079,"end":15.396,"text":"Oun ni Ọlọrun Oluwa,","marked":"Òun ni Ọlọ́run Olúwa"},{"start":15.846,"end":17.208,"text":"O f'ile ẹran se ile,","marked":"Ó f'ilé ẹran ṣe ilé"},{"start":17.658,"end":18.91,"text":"'Bujẹ ẹran fun 'busun;","marked":"'Bujẹ ẹran fún bùsùn"},{"start":19.36,"end":20.411,"text":"L'ọdọ awọn otosi,","marked":"L'ọ́dọ̀ àwọn òtòṣì"},{"start":20.861,"end":22.354,"text":"Ni Jesu gbe ni ayé.","marked":"Ní Jésù gbé ní ayé."}],"end":22.354},{"key":"3","start":23.304,"lines":[{"start":23.304,"end":24.723,"text":"Ni gbogbo igba ewe Rẹ,","marked":"Ní gbogbo ìgbà èwe Rẹ"},{"start":25.173,"end":26.863,"text":"O gbọran o si mb'ọla;","marked":"Ó gbọ́ràn ó sì mb'ọlá"},{"start":27.313,"end":29.045,"text":"O fẹran o si ń tẹriba,","marked":"Ó fẹ́ràn ó sì ń tẹríba"},{"start":29.495,"end":30.806,"text":"Fun iya ti ń tọju Rẹ;","marked":"Fún ìyá tí ń tọ́jú Rẹ̀"},{"start":31.256,"end":32.453,"text":"O yẹ ki gbogb' ọmọde,","marked":"Ó yẹ kí gbogb ọmọdé"},{"start":32.903,"end":34.338,"text":"Ko se Olugbọran bẹ.","marked":"Kò ṣe Olùgbọ́ràn bẹ."}],"end":34.338},{"key":"4","start":35.288,"lines":[{"start":35.288,"end":36.942,"text":"'Tori Oun jẹ awose wa,","marked":"torí Òun jẹ́ àwòṣe wa"},{"start":37.392,"end":38.587,"text":"A ma dagba bi awa;","marked":"A má dàgbà bí àwa"},{"start":39.037,"end":40.982,"text":"O kere ko le da nkan se,","marked":"Ó kéré kò lè dá nǹkan ṣe"},{"start":41.432,"end":42.85,"text":"p A ma sọkun bi awa;","marked":"p A má sọkún bí àwa"},{"start":43.3,"end":44.55,"text":"O si le ba wa daro,","marked":"Ó sì lè bá wa dárò"},{"start":45.0,"end":46.543,"text":"f O le ba wa yọ pẹlu.","marked":"f Ó lè bá wa yọ̀ pẹ̀lú."}],"end":46.543},{"key":"5","start":47.493,"lines":[{"start":47.493,"end":49.315,"text":"A o f'oju wa ri nikẹhin,","marked":"A ó f'ojú wa rí níkẹ̀hìn"},{"start":49.765,"end":51.121,"text":"Ni agbara ifẹ Rẹ;","marked":"Ní agbára ìfẹ́ Rẹ"},{"start":51.571,"end":52.918,"text":"Nitori ọmọ rere yi,","marked":"Nítorí ọmọ rere yí"},{"start":53.368,"end":54.69,"text":"Ni Oluwa wa l'ọrun,","marked":"Ni Olúwa wà l'ọ̀run"},{"start":55.14,"end":56.269,"text":"O ń tọ awa ọmọ Rẹ,","marked":"Ó ń tọ àwa ọmọ Rẹ̀"},{"start":56.719,"end":58.152,"text":"S'ọna ibi ti Oun lọ.","marked":"S'ọ́nà ibi tí Òun lọ."}],"end":58.152},{"key":"6","start":59.102,"lines":[{"start":59.102,"end":60.274,"text":"Ki se ni ibujẹ ẹran,","marked":"Kí ṣe ní ibùjẹ ẹran"},{"start":60.724,"end":61.92,"text":"Nibi ti malu ń jeun;","marked":"Níbi tí màlú ń jẹun"},{"start":62.37,"end":63.699,"text":"L'awa o ri sugbọn l'ọrun,","marked":"L'àwa ó rí sùgbọ́n l'ọ̀run"},{"start":64.149,"end":65.364,"text":"L'ọwọ ọtun Ọlọrun,","marked":"L'ọ́wọ́ ọ̀tún Ọlọ́run"},{"start":65.814,"end":67.08,"text":"'Gba wọn 'mọ Rẹ b'irawọ,","marked":"gbà wọn 'mọ Rẹ̀ b'ìràwọ̀"},{"start":67.53,"end":69.129,"text":"Ba ń tan nin' asọ ala.","marked":"Bá ń tàn nín asọ̀ àlá."}],"end":69.129}]}