{"v":3,"coll":"y","num":179,"id":"hymn_179","title":"LEBA odo Jodani ni","duration":44.13,"voices":{"male":{"file":"y-179-male-v3.m4a","bytes":311172,"sha256":"5a1020df78c9209dc263d0acd2e1ad96a362a18d5e6f403c1760521ed1c82fab","duration":44.2},"female":{"file":"y-179-female-v3.m4a","bytes":326901,"sha256":"895bbb4848bd119e5f1212942cada25939ff015ee50ca3b7f176323891bf5b05","duration":44.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.683,"text":"LẸBA odo Jọdani ni,","marked":"Lẹ́ba odò Jọ́dánì ni"},{"start":2.133,"end":3.803,"text":"Onibaptisi ń ke wi pé;","marked":"Oníbaptisi ń ké wí pé"},{"start":4.253,"end":6.054,"text":"Oluwa mbọ! Oluwa mbọ!","marked":"Olúwa mbọ́! Olúwa mbọ́!"},{"start":6.504,"end":8.69,"text":"Ẹ gbọ 'hin ayọ: Ọba mbọ.","marked":"Ẹ gbọ́ hin ayọ̀: Ọba mbọ́."}],"end":8.69},{"key":"2","start":9.64,"lines":[{"start":9.64,"end":11.298,"text":"K'ese tan ni gbogbo okan","marked":"K'ẹsẹ̀ tán ní gbogbo ọkàn"},{"start":11.748,"end":13.014,"text":"K'olorun ba le ba wa gbe","marked":"K'Ọlọ́run bá lè bá wa gbé"},{"start":13.464,"end":14.928,"text":"K'a pa ile okan wa mo","marked":"K'á pa ilé ọkàn wa mọ́"},{"start":15.378,"end":17.036,"text":"Ki Alejo-nla yi to de.","marked":"Kí Alejo-nla yí tó dé."}],"end":17.036},{"key":"3","start":17.986,"lines":[{"start":17.986,"end":19.996,"text":"Jesu, Iwọ ni igbala,","marked":"Jésù, Ìwọ ni ìgbàlà"},{"start":20.446,"end":21.983,"text":"Ẹsan ati Alabo wa;","marked":"Ẹ̀san àti Alábọ́ wa"},{"start":22.433,"end":23.658,"text":"B'itanna l'awa 'ba segbe,","marked":"B'ìtànná l'àwa bá ṣègbé"},{"start":24.108,"end":25.847,"text":"Bikose t'ore-ọfẹ Rẹ.","marked":"Bíkọsẹ̀ t'ore-ọfẹ Rẹ."}],"end":25.847},{"key":"4","start":26.797,"lines":[{"start":26.797,"end":28.406,"text":"S'awotan awọn alaisan,","marked":"S'àwòtán àwọn aláìsàn"},{"start":28.856,"end":30.649,"text":"Gb'ẹlẹsẹ to subu dide;","marked":"Gb'ẹlẹ́sẹ tó ṣubú dìde"},{"start":31.099,"end":32.383,"text":"Tanmọlẹ Rẹ ka 'bi gbogbo,","marked":"Tànmọ́lẹ̀ Rẹ̀ ká bí gbogbo"},{"start":32.833,"end":34.423,"text":"Mu ẹwa ayé bọ sipo.","marked":"Mú ẹwà ayé bọ̀ sípò."}],"end":34.423},{"key":"5","start":35.373,"lines":[{"start":35.373,"end":36.812,"text":"K'a f'iyin f'ọmọ Ọlọrun ,","marked":"K'á f'ìyìn f'ọmọ Ọlọ́run"},{"start":37.262,"end":38.837,"text":"Bibọ Ẹni mu 'dande wa;","marked":"Bíbọ Ẹni mú dáǹdè wá"},{"start":39.287,"end":40.927,"text":"Ẹni t'a ń sin pẹlu Baba,","marked":"Ẹni t'á ń sìn pẹ̀lú Baba"},{"start":41.377,"end":42.581,"text":"At'Ọlọrun Ẹmi Mimọ.","marked":"Àt'Ọlọ́run Ẹ̀mí Mímọ́."}],"end":42.581}]}