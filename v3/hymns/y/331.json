{"v":3,"coll":"y","num":331,"id":"hymn_331","title":"JESU ore elese ku","duration":36.97,"voices":{"male":{"file":"y-331-male-v3.m4a","bytes":267131,"sha256":"04b4f120375cbcd8929f61e8ea16e8e98ab49b5378d64cb4428a640708d4f959","duration":37.0},"female":{"file":"y-331-female-v3.m4a","bytes":274559,"sha256":"b2f1de1d20e8911fd80d97e2d4f1d7b278ac76bd5a00a353fc4a5c4181fa48b5","duration":37.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.143,"text":"Jesu ọrẹ ẹlẹsẹ ku,","marked":"Jésù ọrẹ ẹlẹ́sẹ̀ kú"},{"start":2.593,"end":4.094,"text":"Awọn ọmọ Salem n sọkun:","marked":"Àwọn ọmọ Salem ń sọkún"},{"start":4.544,"end":5.876,"text":"Okunkun bo oju ọrun,","marked":"Òkùnkùn bo ojú ọ̀run"},{"start":6.326,"end":7.978,"text":"Isẹlẹ nla sẹ lojiji.","marked":"Ìsẹ̀lẹ̀ ńlá sẹ́ lójijì."}],"end":7.978},{"key":"2","start":8.928,"lines":[{"start":8.928,"end":10.605,"text":"Nihin l'a r'anu at'ifẹ,","marked":"Níhìn l'á r'àánú àt'ìfẹ́"},{"start":11.055,"end":12.343,"text":"Ọba ogo ku f'eniyan;","marked":"Ọba ògo kú f'ènìyàn"},{"start":12.793,"end":15.326,"text":"Wa! Ayọ kil' a tun ri yi,","marked":"Wá! Ayọ̀ kìl a tún rí yí"},{"start":15.776,"end":17.496,"text":"Jesu t'O ku tun ji dide.","marked":"Jésù t'Ó kú tún jí dìde."}],"end":17.496},{"key":"3","start":18.446,"lines":[{"start":18.446,"end":19.984,"text":"Ma bẹru mọ, ẹyin mimọ;","marked":"Má bẹ̀rù mọ́, ẹ̀yin mímọ́"},{"start":20.434,"end":21.692,"text":"Sọ bi Oluwa ti jọba;","marked":"Sọ bí Olúwa ti jọba"},{"start":22.142,"end":23.428,"text":"Kọrin b'O ti sẹgun Esu,","marked":"Kọrin b'Ó ti sẹ́gun Èṣù"},{"start":23.878,"end":25.223,"text":"Bi O si ti bori iku.","marked":"Bí Ó sì ti borí ikú."}],"end":25.223},{"key":"4","start":26.173,"lines":[{"start":26.173,"end":28.666,"text":"Ẹ wi pé, ―Ọba, wa titi,","marked":"Ẹ wí pé, ―Ọba, wà títí"},{"start":29.116,"end":30.526,"text":"Iwọ t'a bi lati gba wa,","marked":"Ìwọ t'á bí láti gbà wá"},{"start":30.976,"end":32.849,"text":"K'ẹ b'iku pe, ―oro rẹ da?","marked":"K'ẹ́ b'ikú pé, ―ọ̀rọ̀ rẹ̀ dà?"},{"start":33.299,"end":35.421,"text":"Iboji, isẹgun rẹ da?","marked":"Ibojì, ìsẹ́gun rẹ̀ dà?"}],"end":35.421}]}