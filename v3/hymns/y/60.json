{"v":3,"coll":"y","num":60,"id":"hymn_60","title":"AWA Egbe Kerubu","duration":72.976,"voices":{"male":{"file":"y-60-male-v3.m4a","bytes":520337,"sha256":"9e402afca0bc13494f627ee2b919d9f82c7900dd4120d6b5702a73e0c367150b","duration":73.0},"female":{"file":"y-60-female-v3.m4a","bytes":530245,"sha256":"851051e12c37dc1e27bc098f62ef32f18f42c57049fac4de02b21696a6b657ce","duration":73.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.611,"text":"AWA Egbe Kerubu","marked":"Àwa Ẹgbẹ́ Kérúbù"},{"start":2.061,"end":3.252,"text":"Ati Serafu layé","marked":"Àti Séráfù layé"},{"start":3.702,"end":4.953,"text":"Awa mbebe fun 'ranwo","marked":"Àwa mbẹ̀bẹ̀ fún rànwọ́"},{"start":5.403,"end":10.074,"text":"Agbara Emi Mimo. A! Baba sanu fun wa Ko dari ẹsẹ ji wa.","marked":"Agbára Ẹ̀mí Mímọ́. A! Baba ṣanú fún wa Kò dárí ẹsẹ̀ jì wá."}],"end":10.074},{"key":"CHORUS","start":11.024,"lines":[{"start":11.024,"end":12.489,"text":"A! Baba sanu fun wa","marked":"A! Baba ṣanú fún wa"},{"start":12.939,"end":14.442,"text":"ko dari ese ji wa.","marked":"kò dárí ẹ̀ṣẹ̀ jì wá."}],"end":14.442},{"key":"2","start":15.392,"lines":[{"start":15.392,"end":16.611,"text":"Ki fitila Re ma ku","marked":"Kí fìtílà Rẹ má kú"},{"start":17.061,"end":18.375,"text":"Ninu Ijọ Serafu","marked":"Nínú Ìjọ Séráfù"},{"start":18.825,"end":20.316,"text":"Ki gbogbo isesi wa","marked":"Kí gbogbo ìṣesí wa"},{"start":20.766,"end":26.055,"text":"Fi wa han bi Omo Re. A! Baba sanu fun wa Ko dari ẹsẹ ji wa.","marked":"Fi wá hàn bí Ọmọ Rẹ̀. A! Baba ṣanú fún wa Kò dárí ẹsẹ̀ jì wá."}],"end":26.055},{"key":"3","start":27.005,"lines":[{"start":27.005,"end":28.44,"text":"Mase ta wa nu kuro","marked":"Máṣe ta wá nù kúrò"},{"start":28.89,"end":29.891,"text":"Iwọ Olugbala wa","marked":"Ìwọ Olùgbàlà wa"},{"start":30.341,"end":31.73,"text":"K'awa ma ba sako lọ,","marked":"K'àwa má bá ṣáko lọ"},{"start":32.18,"end":33.628,"text":"Mu wa rin ọna tire.","marked":"Mú wa rìn ọ̀nà tirẹ̀."}],"end":33.628},{"key":"4","start":34.578,"lines":[{"start":34.578,"end":35.978,"text":"Jehovah Jire Baba,","marked":"Jehovah Jire Baba"},{"start":36.428,"end":37.586,"text":"Pese f'awon alaini","marked":"Pèsè f'àwọn aláìní"},{"start":38.036,"end":39.518,"text":"At'awon ti ko ri se","marked":"Àt'àwọn tí kò rí ṣe"},{"start":39.968,"end":44.567,"text":"Ma sai ranti won loni. A! Baba sanu fun wa Ko dari ẹsẹ ji wa.","marked":"Má ṣàì rántí wọn lónì. A! Baba ṣanú fún wa Kò dárí ẹsẹ̀ jì wá."}],"end":44.567},{"key":"5","start":45.517,"lines":[{"start":45.517,"end":46.865,"text":"Ese wa ti papo ju,","marked":"Ẹ̀ṣẹ̀ wa ti papọ̀ jù"},{"start":47.315,"end":48.844,"text":"Bi yanrin eti okun","marked":"Bí yanrìn etí òkun"},{"start":49.294,"end":50.042,"text":"Awa n fẹ","marked":"Àwa ń fẹ́"},{"start":50.492,"end":56.219,"text":"'mularada Iwẹnumo ese wa. A! Baba sanu fun wa Ko dari ẹsẹ ji wa.","marked":"múláradá Ìwẹ̀nùmó ẹ̀ṣẹ̀ wa. A! Baba ṣanú fún wa Kò dárí ẹsẹ̀ jì wá."}],"end":56.219},{"key":"6","start":57.169,"lines":[{"start":57.169,"end":58.565,"text":"Jehovah Emmanueli","marked":"Jehovah Emmanueli"},{"start":59.015,"end":60.106,"text":"Iwọ ni ireti wa,","marked":"Ìwọ ni ìrètí wa"},{"start":60.556,"end":62.0,"text":"Mase jẹ koju tiwa","marked":"Mase jẹ́ kojú tiwa"},{"start":62.45,"end":64.095,"text":"L'ọjọ nla ọjọ 'dajọ.","marked":"L'ọjọ́ ńlá ọjọ́ 'dajọ."}],"end":64.095},{"key":"7","start":65.045,"lines":[{"start":65.045,"end":66.049,"text":"Ọdaguntan Ọlọrun,","marked":"Ọ̀dàgùntàn Ọlọ́run"},{"start":66.499,"end":67.942,"text":"Baba at'Ẹmi Mimọ,","marked":"Baba àt'Ẹ̀mí Mímọ́"},{"start":68.392,"end":69.639,"text":"Wẹ wa mọ patapata,","marked":"Wẹ wá mọ́ pátápátá"},{"start":70.089,"end":71.427,"text":"Ko to kuro layé yi.","marked":"Kò tó kúrò layé yí."}],"end":71.427}]}