{"v":3,"coll":"y","num":489,"id":"hymn_489","title":"OLORUN opo arugbo","duration":60.843,"voices":{"male":{"file":"y-489-male-v3.m4a","bytes":436006,"sha256":"9e8850ca94e553931785de6e0c93beabc81e4ec02918148c7397c03e08bdc8fe","duration":60.9},"female":{"file":"y-489-female-v3.m4a","bytes":447329,"sha256":"c3ba8529402445d9dfd65db2afd5b51fbebe0733276c430c364c5589a419a511","duration":60.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.677,"text":"OLORUN opo arugbo","marked":"Ọlọ́run ọ̀pọ̀ arúgbó"},{"start":2.127,"end":3.831,"text":"T'aiye ro pe ko le bimo mo","marked":"T'ayé rò pé kò lè bímọ mọ́"},{"start":4.281,"end":5.689,"text":"N'Iwo se l'ogo to bimo","marked":"N'Ìwọ ṣe l'ògo tó bímọ"},{"start":6.139,"end":7.582,"text":"O si d'oju t'awon ota re.","marked":"Ó sì d'ojú t'àwọn ọ̀tá rẹ̀."}],"end":7.582},{"key":"CHORUS","start":8.532,"lines":[{"start":8.532,"end":9.934,"text":"Gbo temi, gbo temi","marked":"Gbọ́ tèmi, gbọ́ tèmi"},{"start":10.384,"end":12.518,"text":"Gbo temi, Oba awimayehun","marked":"Gbọ́ tèmi, Ọba àwímáyèhùn"},{"start":12.968,"end":14.539,"text":"Gbo temi, gbo temi","marked":"Gbọ́ tèmi, gbọ́ tèmi"},{"start":14.989,"end":16.812,"text":"Gbo temi, Oba awimayehun.","marked":"Gbọ́ tèmi, Ọba àwímáyèhùn."}],"end":16.812},{"key":"2","start":17.762,"lines":[{"start":17.762,"end":19.249,"text":"O s'arugbo di wundia","marked":"Ó s'arúgbó di wúńdíá"},{"start":19.699,"end":21.253,"text":"Olorun to la Serah lagan","marked":"Ọlọ́run tó la Serah lágan"},{"start":21.703,"end":23.922,"text":"Ko ku, ko sa O wa nibe","marked":"Kò kú, kò sá Ó wà níbẹ̀"},{"start":24.372,"end":25.823,"text":"Baba, se 'ranlowo wa loni.","marked":"Baba, ṣe rànlọ́wọ́ wa lónì."}],"end":25.823},{"key":"3","start":26.773,"lines":[{"start":26.773,"end":28.3,"text":"Sarah fere ma tun le gba","marked":"Sarah fèrè má tún lè gbà"},{"start":28.75,"end":29.954,"text":"Pe'ru on tun le bimo mo","marked":"Pẹ́'rù ọ́n tún lè bímọ mọ́"},{"start":30.404,"end":31.627,"text":"Lo fi rerin ninu okan","marked":"Ló fi rẹ́rìn nínú ọkàn"},{"start":32.077,"end":34.036,"text":"Sugbon Olorun ko ka s'ese fun.","marked":"Ṣùgbọ́n Ọlọ́run kò ká s'ẹ̀ṣẹ̀ fún."}],"end":34.036},{"key":"4","start":34.986,"lines":[{"start":34.986,"end":36.251,"text":"Okiki Olorun mi kan","marked":"Òkìkí Ọlọ́run mi kan"},{"start":36.701,"end":38.338,"text":"Oju mi ko ri 'ru eyi ri","marked":"Ojú mi kò rí ru èyí rí"},{"start":38.788,"end":40.424,"text":"T'igi t'ope lo ndamuso","marked":"T'igi t'ọpẹ́ ló ńdàmúṣọ"},{"start":40.874,"end":42.39,"text":"Fun iloyun Elisabeti.","marked":"Fún ìlóyún Elisabeti."}],"end":42.39},{"key":"5","start":43.34,"lines":[{"start":43.34,"end":44.888,"text":"Hihu agbado ki tase","marked":"Híhu àgbàdo kì tàsé"},{"start":45.338,"end":46.959,"text":"Hihu oka ti tase","marked":"Híhu ọkà ti tàsé"},{"start":47.409,"end":49.031,"text":"Mase jek' arabinrin yi","marked":"Mase jẹ́k arábìnrin yí"},{"start":49.481,"end":50.705,"text":"Tase omo rere lodo Re.","marked":"Tàṣẹ ọmọ rere lọ́dọ̀ Rẹ̀."}],"end":50.705},{"key":"6","start":51.655,"lines":[{"start":51.655,"end":53.466,"text":"Baba, Omo, Emi Mimo","marked":"Baba, Ọmọ, Ẹ̀mí Mímọ́"},{"start":53.916,"end":55.309,"text":"Ko s'awati ore lodo Re","marked":"Kò s'àwátí ọrẹ lọ́dọ̀ Rẹ̀"},{"start":55.759,"end":57.202,"text":"Ma jek'oso aje dina","marked":"Má jẹ́k'ọ̀ṣọ́ ajé dìnà"},{"start":57.652,"end":59.294,"text":"Lati f'arabinrin yi l'omo.","marked":"Láti f'arábìnrin yí l'ọmọ."}],"end":59.294}]}