{"v":3,"coll":"y","num":406,"id":"hymn_406","title":"IJO kerubu ti ye","duration":91.545,"voices":{"male":{"file":"y-406-male-v3.m4a","bytes":656060,"sha256":"166bb4906f55c160233e7ef594ef2c8f7a6d79e192d3a5ba9e44c734d4ed35f4","duration":91.6},"female":{"file":"y-406-female-v3.m4a","bytes":680870,"sha256":"861e4b9e71a0b1e5637db3a3cc272b1168344eedd07eb090087478a43b83dbdb","duration":91.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.75,"text":"Ijo kerubu ti ye","marked":"Ìjọ Kérúbù ti yẹ"},{"start":2.2,"end":3.315,"text":"So fun mi lekan si","marked":"Sọ fún mi lẹ́kàn sí"},{"start":3.765,"end":5.539,"text":"Jesu Kristi l'Oba Ogo","marked":"Jésù Kristi l'Ọba Ògo"},{"start":5.989,"end":7.173,"text":"Olugbala l'Oba lye","marked":"Olùgbàlà l'Ọba Iye"},{"start":7.623,"end":9.31,"text":"Ijo kerubu l'Ijo iye","marked":"Ìjọ Kérúbù l'Ìjọ iye"},{"start":9.76,"end":11.234,"text":"Ijo Kerubu ti ye.","marked":"Ìjọ Kérúbù ti yẹ."}],"end":11.234},{"key":"CHORUS","start":12.184,"lines":[{"start":12.184,"end":14.523,"text":"Iyanu, Iyanu, Iyanu","marked":"Ìyanu, Ìyanu, Ìyanu"},{"start":14.973,"end":16.471,"text":"Ijo Kerubu ti ye.","marked":"Ìjọ Kérúbù ti yẹ."}],"end":16.471},{"key":"2","start":17.421,"lines":[{"start":17.421,"end":19.094,"text":"Ijo Serafu ti ye","marked":"Ìjọ Séráfù ti yẹ"},{"start":19.544,"end":20.723,"text":"E f'ogo fun baba","marked":"Ẹ f'ògo fún Baba"},{"start":21.173,"end":22.504,"text":"T'o mu wa ri ojo oni","marked":"T'ó mú wa rí ọjọ́ òní"},{"start":22.954,"end":24.571,"text":"Fi ola fun Baba loke","marked":"Fi ọlá fún Baba lókè"},{"start":25.021,"end":26.931,"text":"Ijo Serafu l'Ijo iye","marked":"Ìjọ Séráfù l'Ìjọ iye"},{"start":27.381,"end":29.026,"text":"Ijo Serafu ti ye.","marked":"Ìjọ Séráfù ti yẹ."},{"start":29.476,"end":31.567,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":31.567},{"key":"3","start":32.517,"lines":[{"start":32.517,"end":33.886,"text":"Ijo kerubu ti ye","marked":"Ìjọ Kérúbù ti yẹ"},{"start":34.336,"end":35.504,"text":"E so fun mi ki ngbo","marked":"Ẹ sọ fún mi kí ǹgbọ́"},{"start":35.954,"end":37.751,"text":"Jesu Kristi Olusegun","marked":"Jésù Kristi Olùṣègùn"},{"start":38.201,"end":39.511,"text":"Olusegun l'Oba lye","marked":"Olùṣègùn l'Ọba Iye"},{"start":39.961,"end":41.704,"text":"Ijo kerubu I'Ijo iye","marked":"Ìjọ Kérúbù l'Ìjọ iye"},{"start":42.154,"end":43.639,"text":"Ijo Kerubu ti ye.","marked":"Ìjọ Kérúbù ti yẹ."},{"start":44.089,"end":46.262,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":46.262},{"key":"4","start":47.212,"lines":[{"start":47.212,"end":49.132,"text":"Ijo Serafu ti ye","marked":"Ìjọ Séráfù ti yẹ"},{"start":49.582,"end":51.195,"text":"T'o mo ti Krist' nikan","marked":"T'ó mọ̀ ti Krist nìkan"},{"start":51.645,"end":53.214,"text":"Jesu t'o wa niwaju wa","marked":"Jésù t'ó wà níwájú wa"},{"start":53.664,"end":55.606,"text":"Olugbala, Balogun wa","marked":"Olùgbàlà, Balógun wà"},{"start":56.056,"end":57.727,"text":"Ijo Serafu l'Ijo iye","marked":"Ìjọ Séráfù l'Ìjọ iye"},{"start":58.177,"end":59.772,"text":"Ijo Serafu ti ye.","marked":"Ìjọ Séráfù ti yẹ."},{"start":60.222,"end":62.248,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":62.248},{"key":"5","start":63.198,"lines":[{"start":63.198,"end":64.657,"text":"Ijo kerubu ti ye","marked":"Ìjọ Kérúbù ti yẹ"},{"start":65.107,"end":66.018,"text":"Oba lyanu ni;","marked":"Ọba Ìyanu ni"},{"start":66.468,"end":68.988,"text":"Jesu Kristi, Balogun wa,","marked":"Jésù Kristi, Balógun wà"},{"start":69.438,"end":70.732,"text":"Obangiji l'Oba iye","marked":"Ọbangijì l'Ọba iye"},{"start":71.182,"end":72.997,"text":"Ijo kerubu l'Ijo iye.","marked":"Ìjọ Kérúbù l'Ìjọ iye."},{"start":73.447,"end":75.887,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":75.887},{"key":"6","start":76.837,"lines":[{"start":76.837,"end":78.409,"text":"Ijo Serafu ti ye","marked":"Ìjọ Séráfù ti yẹ"},{"start":78.859,"end":79.89,"text":"Ijo Iyanu ni","marked":"Ìjọ Ìyanu ni"},{"start":80.34,"end":81.789,"text":"“Olubukun I'Enit' o mbo","marked":"Olùbùkún l'Enit ò mbọ̀"},{"start":82.239,"end":83.408,"text":"Li oruko Oluwa wa","marked":"Lí orúkọ Olúwa wà"},{"start":83.858,"end":85.426,"text":"Ogo ni fun Baba loke","marked":"Ògo ni fún Baba lókè"},{"start":85.876,"end":87.057,"text":"Ogo fun Metalokan.","marked":"Ògo fún Mẹ́talọ́kan."},{"start":87.507,"end":89.996,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":89.996}]}