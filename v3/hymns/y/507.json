{"v":3,"coll":"y","num":507,"id":"hymn_507","title":"KERUBU pelu Serafu","duration":130.059,"voices":{"male":{"file":"y-507-male-v3.m4a","bytes":935211,"sha256":"181d5cfd2932537829c06451427bdb43005e121b12cbfc4d98ee54244fbfbc04","duration":130.1},"female":{"file":"y-507-female-v3.m4a","bytes":982511,"sha256":"ecf262fde45833d0a5b8c94851254ff03cfb2926bc834a321670a8bdeab1d8d2","duration":130.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.744,"text":"KÉRÚBÙ pẹlu Séráfù,","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":2.194,"end":3.369,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":3.819,"end":5.718,"text":"B'esu gbe tasi rẹ si wa,","marked":"B'èṣù gbé tàsí rẹ̀ sí wa"},{"start":6.168,"end":7.4,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":7.85,"end":9.886,"text":"Maikel Mimọ Balogun wa,","marked":"Maikel Mímọ́ Balógun wà"},{"start":10.336,"end":11.942,"text":"Y'o fọ 'tẹgun esu tutu,","marked":"Y'ó fọ́ 'tẹgun èṣù tútù"},{"start":12.392,"end":13.961,"text":"Esu y'o wolẹ lẹsẹ wa,","marked":"Èṣù y'ó wólẹ̀ lẹ́sẹ̀ wa"},{"start":14.411,"end":15.533,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":15.533},{"key":"2","start":16.483,"lines":[{"start":16.483,"end":17.952,"text":"Asiwaju ẹ ma bẹru","marked":"Aṣíwájú ẹ má bẹ̀rù"},{"start":18.402,"end":19.57,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":20.02,"end":21.628,"text":"'Gbati Jesu wa pẹlu wa,","marked":"gbàtí Jésù wà pẹ̀lú wa"},{"start":22.078,"end":23.348,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":23.798,"end":25.994,"text":"Sa gbadura, Asiwaju,","marked":"Sá gbàdúrà, Aṣíwájú"},{"start":26.444,"end":28.604,"text":"Oke nla yoo di pẹtẹlẹ,","marked":"Òkè ńlá yóò di pẹ̀tẹ́lẹ̀"},{"start":29.054,"end":30.581,"text":"Ayé ko le ri wa gbe se,","marked":"Ayé kò lè rí wa gbé ṣe"},{"start":31.031,"end":32.236,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":32.236},{"key":"3","start":33.186,"lines":[{"start":33.186,"end":34.435,"text":"Ẹgbẹ Aladura mura,","marked":"Ẹgbẹ́ Aládúrà múra"},{"start":34.885,"end":36.133,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":36.583,"end":38.051,"text":"Jesu y'o di yin l'amure;","marked":"Jésù y'ó di yín l'àmùrè"},{"start":38.501,"end":39.675,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":40.125,"end":41.761,"text":"Ẹ gbe ida 'sẹgun soke,","marked":"Ẹ gbé idà 'sẹgun sókè"},{"start":42.211,"end":43.712,"text":"Kil' ohun ti mba yin l'ẹru?","marked":"Kíl ohun tí mbà yín l'ẹ̀rù?"},{"start":44.162,"end":46.135,"text":"Esu ko le ri wa gbe se,","marked":"Èṣù kò lè rí wa gbé ṣe"},{"start":46.585,"end":47.756,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":47.756},{"key":"4","start":48.706,"lines":[{"start":48.706,"end":50.154,"text":"Ẹgbẹ Baba nla mejila,","marked":"Ẹgbẹ́ Baba ńlá méjìlá"},{"start":50.604,"end":51.786,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":52.236,"end":53.824,"text":"Ẹgbẹ F'ogo-Ọlọrun-han,","marked":"Ẹgbẹ́ F'ogo-Ọlọrun-han"},{"start":54.274,"end":55.455,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":55.905,"end":57.884,"text":"Ẹ ma foya, ẹ ma s'ojo,","marked":"Ẹ má fòyà, ẹ má s'ọjọ́"},{"start":58.334,"end":59.558,"text":"Tẹ siwaju larin ogun;","marked":"Tẹ̀ síwájú lárin ogun"},{"start":60.008,"end":61.637,"text":"Jesu y'o fun wa n'isẹgun,","marked":"Jésù y'ó fún wa n'ìsẹ̀gùn"},{"start":62.087,"end":63.294,"text":"Ki yoo si nkan.","marked":"Kì yóò sí nǹkan."}],"end":63.294},{"key":"5","start":64.244,"lines":[{"start":64.244,"end":66.478,"text":"Ẹgbẹ Mary, Ẹgbẹ Martha,","marked":"Ẹgbẹ́ Mary, Ẹgbẹ́ Martha"},{"start":66.928,"end":68.152,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":68.602,"end":70.789,"text":"Ẹgbẹ Dorcas, Ẹgbẹ Esta,","marked":"Ẹgbẹ́ Dorcas, Ẹgbẹ́ Esta"},{"start":71.239,"end":72.458,"text":"Ki yoo si nkan","marked":"Kì yóò sí nǹkan"},{"start":72.908,"end":74.446,"text":"Kọrin Ogo s'Ọlọrun wa,","marked":"Kọrin Ògo s'Ọlọ́run wa"},{"start":74.896,"end":76.557,"text":"Ẹ ho ye s'Ọlọrun Daniel,","marked":"Ẹ hó yẹ s'Ọlọ́run Daniẹl"},{"start":77.007,"end":79.336,"text":"Halle, Halle, Halleluyah!","marked":"Halle, Halle, Hallelúyà!"},{"start":79.786,"end":80.99,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":80.99},{"key":"6","start":81.94,"lines":[{"start":81.94,"end":83.675,"text":"Ẹgbẹ Akọrin ẹ mura,","marked":"Ẹgbẹ́ Akọrin ẹ múra"},{"start":84.125,"end":85.364,"text":"Ki yoo si nkan","marked":"Kì yóò sí nǹkan"},{"start":85.814,"end":87.351,"text":"Aladura at'Afunpe,","marked":"Aládúrà àt'àfúnpè"},{"start":87.801,"end":89.018,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":89.468,"end":91.018,"text":"Mura lati kọrin Mose,","marked":"Múra láti kọrin Mósè"},{"start":91.468,"end":93.179,"text":"K'ẹ yin Ọdaguntan logo,","marked":"K'ẹ́ yin Ọ̀dàgùntàn lógo"},{"start":93.629,"end":95.199,"text":"K'a jumọ kọ Halleluyah,","marked":"K'a jùmọ̀ kọ Hallelúyà"},{"start":95.649,"end":96.953,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":96.953},{"key":"7","start":97.903,"lines":[{"start":97.903,"end":99.348,"text":"Kérúbù pẹlu Séráfù,","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":99.798,"end":100.987,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":101.437,"end":103.368,"text":"B'iku npa lọtun pa losi,","marked":"B'ikú ńpa lọ́tún pa lósì"},{"start":103.818,"end":105.091,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":105.541,"end":108.643,"text":"Bi Shadraki Mesaki ati","marked":"Bí Ṣhadraki Meṣaki àti"},{"start":109.093,"end":110.423,"text":"Abednigo ninu ina,","marked":"Abednigo nínú iná"},{"start":110.873,"end":112.6,"text":"Ina esu ko le jo wa,","marked":"Iná èṣù kò lè jó wá"},{"start":113.05,"end":114.24,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":114.24},{"key":"8","start":115.19,"lines":[{"start":115.19,"end":116.54,"text":"Ogo ni fun Baba l'oke,","marked":"Ògo ni fún Baba l'òkè"},{"start":116.99,"end":118.135,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":118.585,"end":120.131,"text":"Ogo ni fun Ọmọ l'oke,","marked":"Ògo ni fún Ọmọ l'òkè"},{"start":120.581,"end":121.818,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":122.268,"end":123.522,"text":"Ogo ni fun Ẹmi Mimọ ,","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":123.972,"end":125.249,"text":"Ogo ni fun Mẹtalọkan,","marked":"Ògo ni fún Mẹ́talọ́kan"},{"start":125.699,"end":126.885,"text":"Lagbara Olodumare,","marked":"Lágbára Olódùmarè"},{"start":127.335,"end":128.511,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":128.511}]}