rked":"A ṣẹ́gun, A ṣẹ́gun"}],"end":31.717},{"key":"3","start":32.667,"lines":[{"start":32.667,"end":33.842,"text":"A segun ofa iku","marked":"A ṣẹ́gun ọfà ikú"},{"start":34.292,"end":35.578,"text":"A segun ofa esu","marked":"A ṣẹ́gun ọfà èṣù"},{"start":36.028,"end":37.335,"text":"Oluwa so won d'ofo","marked":"Olúwa sọ wọ́n d'òfo"},{"start":37.785,"end":39.161,"text":"A dupe lowo Baba.","marked":"A dúpẹ́ lọ́wọ́ Baba."},{"start":39.611,"end":41.143,"text":"Egbe:  A segun, A segun...","marked":"A ṣẹ́gun, A ṣẹ́gun"}],"end":41.143},{"key":"4","start":42.093,"lines":[{"start":42.093,"end":43.589,"text":"Esu ko le l'agbara","marked":"Èṣù kò lè l'agbára"},{"start":44.039,"end":45.208,"text":"Lori Egbe Mimo yi","marked":"Lórí Ẹgbẹ́ Mímọ́ yí"},{"start":45.658,"end":47.285,"text":"Aje, oso, sanponna","marked":"Ajé, ọ̀ṣọ́, ṣanpọ́nná"},{"start":47.735,"end":49.21,"text":"Di temole l'ese wa.","marked":"Di tẹ̀mọ́lẹ̀ l'ẹsẹ̀ wa."},{"start":49.66,"end":51.528,"text":"Egbe:  A segun, A segun...","marked":"A ṣẹ́gun, A ṣẹ́gun"}],"end":51.528},{"key":"5","start":52.478,"lines":[{"start":52.478,"end":53.859,"text":"Jah yio ma s'Alabo wa","marked":"Jah yóò má s'Alábọ́ wa"},{"start":54.309,"end":55.365,"text":"Lowo emi buburu","marked":"Lọ́wọ́ ẹ̀mí búburú"},{"start":55.815,"end":57.132,"text":"Michael Balogun wa","marked":"Michael Balógun wà"},{"start":57.582,"end":58.825,"text":"Tid' oju esu bole.","marked":"Tìd ojú èṣù bolẹ̀."},{"start":59.275,"end":60.972,"text":"Egbe:  A segun, A segun...","marked":"A ṣẹ́gun, A ṣẹ́gun"}],"end":60.972},{"key":"6","start":61.922,"lines":[{"start":61.922,"end":63.459,"text":"Ajiagommon Bussawuu","marked":"Ajiagommon Bussawuu"},{"start":63.909,"end":65.233,"text":"Ajiagommon Buttari","marked":"Ajiagommon Buttari"},{"start":65.683,"end":66.849,"text":"Omo Mimo ti segun,","marked":"Ọmọ Mímọ́ ti ṣẹ́gun"},{"start":67.299,"end":68.651,"text":"A dupe lowo Baba.","marked":"A dúpẹ́ lọ́wọ́ Baba."},{"start":69.101,"end":70.781,"text":"Egbe:  A segun, A segun...","mar