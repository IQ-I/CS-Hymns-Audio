{"v":3,"coll":"y","num":396,"id":"hymn_396","title":"BIBELI mimo t'orun","duration":34.338,"voices":{"male":{"file":"y-396-male-v3.m4a","bytes":235599,"sha256":"0d72149a74ee8369cced956d5362e8c20b52194b70596881d7e026d8537f5b90","duration":34.4},"female":{"file":"y-396-female-v3.m4a","bytes":240151,"sha256":"35b8ca46e9a814c4b169aa9ff58775bbc1918842fca83932907fe0c06d7acfa7","duration":34.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.522,"text":"BIBELI mimọ t'ọrun,","marked":"Bíbélì mímọ́ t'ọ̀run"},{"start":1.972,"end":3.096,"text":"Ọwọn isura t'emi!","marked":"Ọwọ́n ìṣúra t'èmi!"},{"start":3.546,"end":5.175,"text":"'Wọ ti n wi bi mo ti ri,","marked":"'Wọ tí ń wí bí mo ti rí"},{"start":5.625,"end":7.144,"text":"'Wọ ti n sọ bi mo ti wa","marked":"'Wọ tí ń sọ bí mo ti wá"}],"end":7.144},{"key":"2","start":8.094,"lines":[{"start":8.094,"end":9.923,"text":"'Wọ n kọ mi, bi mo sina,","marked":"'Wọ ń kọ́ mi, bí mo ṣìnà"},{"start":10.373,"end":11.625,"text":"'Wọ n f'ifẹ Oluwa han;","marked":"'Wọ ń f'ìfẹ́ Olúwa hàn"},{"start":12.075,"end":13.533,"text":"'Wọ l'o si n tọ ẹsẹ mi,","marked":"'Wọ l'ó sì ń tọ ẹsẹ̀ mi"},{"start":13.983,"end":16.073,"text":"'Wọ l'o n dare, at'ẹbi.","marked":"'Wọ l'ó ń darè, àt'ẹ̀bi."}],"end":16.073},{"key":"3","start":17.023,"lines":[{"start":17.023,"end":18.346,"text":"f 'Wọ n'ima tu wa ninu,","marked":"f 'Wọ n'ìmá tú wà nínú"},{"start":18.796,"end":19.859,"text":"Ninu wahala ayé,","marked":"Nínú wàhálà ayé"},{"start":20.309,"end":22.647,"text":"cr 'Wọ n ko ni, nipa 'gbagbọ,","marked":"cr 'Wọ ń kò ní, nípa 'gbagbọ"},{"start":23.097,"end":24.698,"text":"Pe, a le sẹgun iku.","marked":"Pé, a lè sẹ́gun ikú."}],"end":24.698},{"key":"4","start":25.648,"lines":[{"start":25.648,"end":27.563,"text":"'Wọ l'o n sọ t'ayọ ti mbọ,","marked":"'Wọ l'ó ń sọ t'ayọ̀ tí mbọ̀"},{"start":28.013,"end":29.188,"text":"At'iparun ẹlẹsẹ;","marked":"Àt'ìparun ẹlẹ́sẹ̀"},{"start":29.638,"end":30.856,"text":"Bibeli mimọ t'ọrun,","marked":"Bíbélì mímọ́ t'ọ̀run"},{"start":31.306,"end":32.789,"text":"Ọwọn isura t'emi.","marked":"Ọ̀wọ́n ìṣúra t'ẹ̀mí."}],"end":32.789}]}