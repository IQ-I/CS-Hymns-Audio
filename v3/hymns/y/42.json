{"v":3,"coll":"y","num":42,"id":"hymn_42","title":"Iwo t'o n mu okan mole","duration":52.083,"voices":{"male":{"file":"y-42-male-v3.m4a","bytes":367362,"sha256":"aeb913380ffff36bb1d9ae6bd88dee6ad951cb261b7767d098079fb792c903ae","duration":52.1},"female":{"file":"y-42-female-v3.m4a","bytes":384504,"sha256":"023d4fcd84e5b372907aecb6a7dd5fa452cd655bcef5e9ad0aad2cc387b1f1b1","duration":52.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.686,"text":"Iwọ t'o n mu ọkan mọlẹ,","marked":"Ìwọ t'ó ń mú ọkàn mọ́lẹ̀"},{"start":2.136,"end":3.646,"text":"Nipa 'mọlẹ atọrunwa;","marked":"Nípa 'mọlẹ àtọ̀runwá"},{"start":4.096,"end":5.449,"text":"T'o si ń sẹ iri ibukun","marked":"T'ó sì ń sẹ́ ìrì ìbùkún"},{"start":5.899,"end":7.451,"text":"Sor'awọn ti n safẹri Rẹ.","marked":"Sór'àwọn tí ń sàfẹ́rí Rẹ."}],"end":7.451},{"key":"2","start":8.401,"lines":[{"start":8.401,"end":9.759,"text":"Jọ masai fi ibukun Rẹ,","marked":"Jọ maṣai fi ìbùkún Rẹ̀"},{"start":10.209,"end":11.907,"text":"Fun olukọ at'akẹkọọ;","marked":"Fún olùkọ́ àt'akẹ́kọ̀ọ́"},{"start":12.357,"end":13.662,"text":"Ki ijọ Rẹ le jẹ mimọ,","marked":"Kí ìjọ Rẹ lè jẹ́ mímọ́"},{"start":14.112,"end":15.405,"text":"K'atupa rẹ ma jo gere.","marked":"K'àtùpá rẹ̀ má jọ gẹ́rẹ́."}],"end":15.405},{"key":"3","start":16.355,"lines":[{"start":16.355,"end":17.76,"text":"F'ọkan mimọ fun olukọ,","marked":"F'ọkàn mímọ́ fún olùkọ́"},{"start":18.21,"end":20.439,"text":"Igbagbọ, 'reti, at'ifẹ;","marked":"Ìgbàgbọ́, retí, àt'ìfẹ́"},{"start":20.889,"end":22.254,"text":"Ki wọn j'ẹni t'Iwọ ti kọ,","marked":"Kí wọ́n j'ẹni t'Ìwọ tí kọ"},{"start":22.704,"end":24.25,"text":"Ki wọn le j'olukọ rere.","marked":"Kí wọn lè j'olùkọ́ rere."}],"end":24.25},{"key":"4","start":25.2,"lines":[{"start":25.2,"end":26.811,"text":"F'eti igbọran f'akẹkọọ,","marked":"F'etí ìgbọ́ràn f'akẹ́kọ̀ọ́"},{"start":27.261,"end":28.795,"text":"Ọkan 'rẹlẹ at'ailẹtan;","marked":"Ọkàn 'rẹlẹ àt'àìlẹ́tàn"},{"start":29.245,"end":31.34,"text":"Talaka to kun f'ẹbun yi,","marked":"Tálákà tó kún f'ẹ̀bùn yí"},{"start":31.79,"end":33.301,"text":"San ju ọba ayé yi lọ.","marked":"Sàn ju ọba ayé yí lọ."}],"end":33.301},{"key":"5","start":34.251,"lines":[{"start":34.251,"end":35.847,"text":"'Buk'olusọ: buk'aguntan,","marked":"'Buk'olusọ: bùk'àgùntàn"},{"start":36.297,"end":37.63,"text":"Ki wọn j'ọkan labẹ 'sọ Rẹ;","marked":"Kí wọ́n j'ọkàn lábẹ́ 'sọ Rẹ̀"},{"start":38.08,"end":39.45,"text":"Ki wọn ma f'ọkan kan sọna,","marked":"Kí wọn má f'ọkàn kan sọ́nà"},{"start":39.9,"end":41.432,"text":"Tit' ayé osi yi y'o pin.","marked":"Tít ayé òsì yí y'ó pín."}],"end":41.432},{"key":"6","start":42.382,"lines":[{"start":42.382,"end":44.228,"text":"Baba, b'awa ba n'ore Rẹ,","marked":"Baba, b'àwa bá n'ọrẹ Rẹ"},{"start":44.678,"end":46.392,"text":"Layé yi l'a ti l'ogo;","marked":"Layé yí l'a ti l'ògo"},{"start":46.842,"end":48.275,"text":"K'a to kọja s'oke ọrun,","marked":"K'á tó kọjá s'ókè ọ̀run"},{"start":48.725,"end":50.534,"text":"L'a o mọ ohun ti aiku jẹ.","marked":"L'á ò mọ ohun tí àìkú jẹ́."}],"end":50.534}]}