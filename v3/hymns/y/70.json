{"v":3,"coll":"y","num":70,"id":"hymn_70","title":"ELESE wa sodo Jesu","duration":87.304,"voices":{"male":{"file":"y-70-male-v3.m4a","bytes":627980,"sha256":"026a8701d3ade625d8c96fcca13e76d397a5d6f972a39f0fa3f742d5f08d5ee2","duration":87.4},"female":{"file":"y-70-female-v3.m4a","bytes":645382,"sha256":"817bd78f1c7e15acde70de94ff52abc14bd890ac5b6b65ef3bb8b8c13d0b7e3a","duration":87.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.884,"text":"ELESE wa sodo Jesu","marked":"Ẹlẹ́ṣẹ̀ wá sọ́dọ̀ Jésù"},{"start":2.334,"end":3.58,"text":"Fun igbala re lofe","marked":"Fún ìgbàlà rẹ lọ́fẹ́"},{"start":4.03,"end":5.17,"text":"O n pe o ni ohun","marked":"Ó ń pè ọ́ ní ohun"},{"start":5.62,"end":11.982,"text":"kele Pe omo ma sako mo. Ki l'a o ro? Ki l'a o sọ? 'Gba ti Baba ba n pe wa, Pe ọmọ siwọ ko ma bọ, Wa jihin isẹ rẹ o.","marked":"kẹ́lẹ́ Pé ọmọ má ṣáko mọ́. Kí l'á ò rò? Kí l'á ò sọ? gbà tí Baba bá ń pè wá, Pé ọmọ síwọ́ kò má bọ̀, Wá jíhìn isẹ́ rẹ̀ ọ."}],"end":11.982},{"key":"CHORUS","start":12.932,"lines":[{"start":12.932,"end":14.967,"text":"Kil' ao ro! Kil' ao so?","marked":"Kíl àò rò! Kíl àò sọ?"},{"start":15.417,"end":16.884,"text":"'Gbati Baba ba npe wa,","marked":"gbàtí Baba bá ńpè wá"},{"start":17.334,"end":19.132,"text":"Pe omo, siwo ko ma bo","marked":"Pé ọmọ, ṣíwọ́ kò má bọ̀"},{"start":19.582,"end":20.83,"text":"Wa jihin ise re o.","marked":"Wá jíhìn iṣẹ́ rẹ̀ ọ́."}],"end":20.83},{"key":"2","start":21.78,"lines":[{"start":21.78,"end":23.355,"text":"Ẹlẹsẹ wa sọdọ Jesu,","marked":"Ẹlẹ́sẹ̀ wá sọ́dọ̀ Jésù"},{"start":23.805,"end":24.933,"text":"Loni lọjọ igbala,","marked":"Lónì lọ́jọ́ ìgbàlà"},{"start":25.383,"end":26.788,"text":"Yara ma si jẹ ko pẹ ju,","marked":"Yára má sì jẹ́ kó pẹ́ jù"},{"start":27.238,"end":28.31,"text":"Iye mbẹ fun ọ loni","marked":"Iye mbẹ́ fún ọ lónì"}],"end":28.31},{"key":"3","start":29.26,"lines":[{"start":29.26,"end":31.04,"text":"cr Séráfù damure giri,","marked":"cr Séráfù dàmúrè gírí"},{"start":31.49,"end":33.184,"text":"Kérúbù ma jafara,","marked":"Kérúbù má jáfara"},{"start":33.634,"end":35.159,"text":"mp Ọpọ ọkan ti segbe lọ,","marked":"mp Ọ̀pọ̀ ọkàn ti ṣègbé lọ"},{"start":35.609,"end":37.199,"text":"Wa, ẹ wa s'agbo jesu.","marked":"Wá, ẹ wá s'àgbò Jésù."}],"end":37.199},{"key":"4","start":38.149,"lines":[{"start":38.149,"end":39.617,"text":"f Jesu Olori Ẹgbẹ wa,","marked":"f Jésù Olórí Ẹgbẹ́ wa"},{"start":40.067,"end":41.312,"text":"Ifẹ Rẹ ti sọwọn to,","marked":"Ìfẹ́ Rẹ ti sọ̀wọ́n tó"},{"start":41.762,"end":43.245,"text":"Ti O da Ẹgbẹ yi silẹ;","marked":"Tí Ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":43.695,"end":45.154,"text":"Pe k'a le ri igbala.","marked":"Pé k'á lè rí ìgbàlà."}],"end":45.154},{"key":"5","start":46.104,"lines":[{"start":46.104,"end":48.141,"text":"Ajẹ n yọnu, oso ń yọnu,","marked":"Àjẹ́ ń yọnu, ọ̀ṣọ́ ń yọnu"},{"start":48.591,"end":50.041,"text":"Wa sabẹ abo Jesu,","marked":"Wá sábẹ́ abo Jésù"},{"start":50.491,"end":52.014,"text":"Ohun ibi t'o wu k'o jẹ,","marked":"Ohun ibi t'ó wù k'ó jẹ́"},{"start":52.464,"end":53.774,"text":"Wa si Ẹgbẹ Séráfù.","marked":"Wá sí Ẹgbẹ́ Séráfù."}],"end":53.774},{"key":"6","start":54.724,"lines":[{"start":54.724,"end":55.916,"text":"Ẹlẹsẹ ronupiwada,","marked":"Ẹlẹ́sẹ̀ ronúpìwàdà"},{"start":56.366,"end":57.6,"text":"Ki akoko to kọja,","marked":"Kí àkókò tó kọjá"},{"start":58.05,"end":59.391,"text":"Ki Mẹtalọkan to pe ọ,","marked":"Kí Mẹ́talọ́kan tó pé ọ́"},{"start":59.841,"end":61.245,"text":"Pe wa siro isẹ rẹ.","marked":"Pè wá ṣírò isẹ́ rẹ."}],"end":61.245},{"key":"7","start":62.195,"lines":[{"start":62.195,"end":63.843,"text":"Ka le gbọ nikẹyin ọjọ,","marked":"Ká lè gbọ́ níkẹyìn ọjọ́"},{"start":64.293,"end":65.505,"text":"Pe o se ọmọ rere,","marked":"Pé ó ṣe ọmọ rere"},{"start":65.955,"end":67.462,"text":"Kérúbù pẹlu Séráfù,","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":67.912,"end":69.198,"text":"Bọ s'ayọ Oluwa rẹ.","marked":"Bọ̀ s'ayọ̀ Olúwa rẹ̀."}],"end":69.198},{"key":"8","start":70.148,"lines":[{"start":70.148,"end":71.405,"text":"Orin Halle Halleluya,","marked":"Orin Halle Hallelúyà"},{"start":71.855,"end":73.06,"text":"L'a o ko ni'te baba","marked":"L'á ò kò ní'tẹ́ Baba"},{"start":73.51,"end":75.142,"text":"'Wo n'iyin at'ope ye fun","marked":"wò n'ìyìn àt'ọpẹ́ yẹ fún"},{"start":75.592,"end":85.755,"text":"Tit'ayé ainipẹkun. Ki l'a o ro? Ki l'a o sọ? 'Gba Ti Baba ba n pe wa, Pe ọmọ siwọ ko ma bọ, Wa jihin isẹ rẹ o.","marked":"Tit'ayé àìnípẹ̀kun. Kí l'á ò rò? Kí l'á ò sọ? gba Tí Baba bá ń pè wá, Pé ọmọ síwọ́ kò má bọ̀, Wá jíhìn isẹ́ rẹ̀ ọ́."}],"end":85.755}]}