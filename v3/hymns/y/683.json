{"v":3,"coll":"y","num":683,"id":"hymn_683","title":"OLORUN ogbon at'ore","duration":64.85,"voices":{"male":{"file":"y-683-male-v3.m4a","bytes":451148,"sha256":"07399e656b16de2c3145e88cd24b2410a93b45e53c12f0c5db3b23b452ff1177","duration":64.9},"female":{"file":"y-683-female-v3.m4a","bytes":469226,"sha256":"9aee8c3e22198b04325f6351295e567e28cf63ab8adcd342aa48f29b60487733","duration":64.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.607,"text":"OLORUN ogbon at'ore","marked":"Ọlọ́run ọgbọ́n àt'ọrẹ"},{"start":2.057,"end":3.66,"text":"Tan 'mole at'oto","marked":"Tan mọ́lẹ̀ àt'ọ̀tọ̀"},{"start":4.11,"end":5.7,"text":"Lati f'ona toto han wa","marked":"Láti f'ọ̀nà tòtọ́ hàn wá"},{"start":6.15,"end":7.287,"text":"Lai to 'sise wa.","marked":"Láì tó ṣiṣẹ́ wa."}],"end":7.287},{"key":"2","start":8.237,"lines":[{"start":8.237,"end":9.562,"text":"Lati tọ wa ninu ewu,","marked":"Láti tọ̀ wà nínú ewu"},{"start":10.012,"end":11.097,"text":"Ni arin apata,","marked":"Ní arin àpáta"},{"start":11.547,"end":13.173,"text":"Lati ma rin lọ larin wọn,","marked":"Láti má rìn lọ lárin wọn"},{"start":13.623,"end":14.969,"text":"K'a m'ọkọ wa gunlẹ","marked":"K'á m'ọkọ wá gúnlẹ̀"}],"end":14.969},{"key":"3","start":15.919,"lines":[{"start":15.919,"end":17.312,"text":"B'or' ọfẹ Rẹ ti n mu wa ye,","marked":"B'ọ́r ọ̀fẹ́ Rẹ̀ ti ń mú wa yẹ"},{"start":17.762,"end":18.908,"text":"K'a kọ wọn b'eko Rẹ;","marked":"K'á kọ́ wọn b'ẹ̀kọ́ Rẹ"},{"start":19.358,"end":20.785,"text":"Awa lati kọ ọmọ wa,","marked":"Àwa láti kọ ọmọ wa"},{"start":21.235,"end":22.287,"text":"Ni gbogbo ọna Rẹ.","marked":"Ní gbogbo ọ̀nà Rẹ."}],"end":22.287},{"key":"4","start":23.237,"lines":[{"start":23.237,"end":25.204,"text":"Ni akoko, pa ifẹ wọn,","marked":"Ní àkókò, pa ìfẹ́ wọn"},{"start":25.654,"end":26.801,"text":"Oun 'gberaga wọn run!","marked":"Òun gbéraga wọn run!"},{"start":27.251,"end":28.616,"text":"K'a fi ọna mimọ han wọn,","marked":"K'á fi ọ̀nà mímọ́ hàn wọ́n"},{"start":29.066,"end":30.34,"text":"Si Olugbala wọn.","marked":"Sí Olùgbàlà wọn."}],"end":30.34},{"key":"5","start":31.29,"lines":[{"start":31.29,"end":32.846,"text":"A fẹ woke nigbakugba,","marked":"A fẹ́ wòkè nígbàkúgbà"},{"start":33.296,"end":34.589,"text":"K'a tọ apẹrẹ Rẹ;","marked":"K'á tọ̀ apẹ̀rẹ̀ Rẹ̀"},{"start":35.039,"end":36.996,"text":"K'a ru 'bẹru oun 'reti wọn,","marked":"K'á ru 'bẹru òun retí wọn"},{"start":37.446,"end":38.978,"text":"K'a tun ero wọn se.","marked":"K'á tún èrò wọn ṣe."}],"end":38.978},{"key":"6","start":39.928,"lines":[{"start":39.928,"end":42.096,"text":"A fẹ rọ wọn lati gbagbọ,","marked":"A fẹ́ rọ̀ wọn láti gbàgbọ́"},{"start":42.546,"end":43.612,"text":"Ki wọn f'itara han;","marked":"Kí wọ́n f'ìtara hàn"},{"start":44.062,"end":45.549,"text":"Ki a mase lo ikanra,","marked":"Kí a máṣe lo ìkanra"},{"start":45.999,"end":47.317,"text":"'Gba t'a ba le lo 'fẹ","marked":"gbà t'á bá lè lọ 'fẹ"}],"end":47.317},{"key":"7","start":48.267,"lines":[{"start":48.267,"end":49.539,"text":"Eyi l'a f'igbagbọ bere,","marked":"Èyí l'a f'ìgbàgbọ́ bẹ̀rẹ̀"},{"start":49.989,"end":51.12,"text":"Ọgbọn t'o t'oke wa!","marked":"Ọgbọ́n t'ó t'òkè wá!"},{"start":51.57,"end":52.902,"text":"K'a f'ẹru ọmọ s'aya wọn,","marked":"K'á f'ẹ́rù ọmọ s'àyà wọn"},{"start":53.352,"end":54.452,"text":"Pẹlu ifẹ mimọ.","marked":"Pẹ̀lú ìfẹ́ mímọ́."}],"end":54.452},{"key":"8","start":55.402,"lines":[{"start":55.402,"end":57.792,"text":"K'a sọ 'fẹ wọn ti n tẹ s'ibi,","marked":"K'á sọ 'fẹ wọn tí ń tẹ̀ s'ibi"},{"start":58.242,"end":59.564,"text":"Kuro l'ọna ewu;","marked":"Kúrò l'ọ̀nà ewu"},{"start":60.014,"end":61.494,"text":"K'a fi pẹlẹ tẹ ọkan wọn,","marked":"K'á fi pẹ̀lẹ́ tẹ ọkàn wọn"},{"start":61.944,"end":63.301,"text":"K'a fa wọn t'Ọlọrun.","marked":"K'á fà wọ́n t'Ọlọ́run."}],"end":63.301}]}