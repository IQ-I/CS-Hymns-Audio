{"v":3,"coll":"y","num":149,"id":"hymn_149","title":"BABA, Eleda wa","duration":45.655,"voices":{"male":{"file":"y-149-male.m4a","bytes":333948,"sha256":"9faee30756cbf8e1ce685c324c8be7d90031ef4c538320e9cc6d5c4599a0009b","duration":45.7},"female":{"file":"y-149-female.m4a","bytes":340009,"sha256":"4e44787c8281202a3a97ebf52e0f3e7aa4fc397f7176732faf63a914e6a5cb8b","duration":45.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.171,"text":"BABA, Eleda wa,","marked":"Bàbá, Ẹlẹ́dàá wa"},{"start":2.551,"end":3.687,"text":"Gbo orin iyin wa","marked":"Gbọ́ orin ìyìn wa"},{"start":4.067,"end":5.624,"text":"L' aye ati l'orun","marked":"L' ayé àti l'ọrun"},{"start":6.004,"end":6.998,"text":"Baba Olubukun:","marked":"Bàbá Olùbùkún"},{"start":7.378,"end":9.031,"text":"Iwo l'ogo ati iyin","marked":"Ìwo l'ògo àti ìyìn"},{"start":9.411,"end":11.18,"text":"Ope, ati ola ye fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":11.18},{"key":"2","start":12.13,"lines":[{"start":12.13,"end":13.082,"text":"'Wo Olorun omo,","marked":"'Wò Ọlọ́run ọmọ"},{"start":13.462,"end":14.779,"text":"T' O ku lati gba wa","marked":"T' Ó kù láti gbà wá"},{"start":15.159,"end":16.396,"text":"Eni t'O ji dide","marked":"Ẹni t'Ó jí dìde"},{"start":16.776,"end":17.99,"text":"Ti O si goke lo:","marked":"Tí Ó sì gòkè lọ"},{"start":18.37,"end":19.93,"text":"Iwo l'ogo, ati iyin","marked":"Ìwo l'ògo, àti ìyìn"},{"start":20.31,"end":22.251,"text":"Ope, ati ola ye fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":22.251},{"key":"3","start":23.201,"lines":[{"start":23.201,"end":24.107,"text":"Si O Emi Mimo,","marked":"Sí Ọ Ẹ̀mí Mímọ́́"},{"start":24.487,"end":25.437,"text":"Ni a korin iyin","marked":"Ní a kọrin ìyìn"},{"start":25.817,"end":27.038,"text":"Iwo t'o f 'imole","marked":"Ìwo t'ó f 'ìmọ́lẹ̀̀"},{"start":27.418,"end":28.496,"text":"Iye si okan wa","marked":"Iye sí ọkàn wa"},{"start":28.876,"end":30.411,"text":"Iwo l'ogo, ati iyin","marked":"Ìwo l'ògo, àti ìyìn"},{"start":30.791,"end":32.486,"text":"Ope ati ola ye fun.","marked":"Ọpẹ́ àti ọlá yẹ fún."}],"end":32.486},{"key":"4","start":33.436,"lines":[{"start":33.436,"end":34.601,"text":"Mimo, mimo, mimo","marked":"Mímọ́́, mímọ́́, mímọ́́"},{"start":34.981,"end":36.197,"text":"N'iyin Metalokan","marked":"N'ìyìn Mẹ́talọ́kan"},{"start":36.577,"end":38.028,"text":"L' aye ati l'orun","marked":"L' ayé àti l'ọrun"},{"start":38.408,"end":39.61,"text":"L'a o ma korin pe","marked":"L'á ò má kọrin pé"},{"start":39.99,"end":42.043,"text":"Iwo l'ogo, ati iyin","marked":"Ìwo l'ògo, àti ìyìn"},{"start":42.423,"end":44.105,"text":"Ope ati ola ye fun.","marked":"Ọpẹ́ àti ọlá yẹ fún."}],"end":44.105}]}