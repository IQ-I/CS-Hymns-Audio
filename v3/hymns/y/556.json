{"v":3,"coll":"y","num":556,"id":"hymn_556","title":"MA toju mi Jehofa nla","duration":36.534,"voices":{"male":{"file":"y-556-male-v3.m4a","bytes":262701,"sha256":"ab95e141fe8602a15c0ff93336f970cc7b6ae9bea318cf0623c33239d19b8fa2","duration":36.6},"female":{"file":"y-556-female-v3.m4a","bytes":264108,"sha256":"94078da29015cc6990675301e8ce343782928daf9ec7734d6ea394989659c7e9","duration":36.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.765,"text":"MA toju mi Jehofa nla","marked":"Má tọ́jú mi Jèhófà ńlá"},{"start":2.215,"end":3.805,"text":"Ero l'aiye osi yi","marked":"Èrò l'ayé òsì yí"},{"start":4.255,"end":6.208,"text":"Emi ko n'okun, Iwo ni","marked":"Èmi kò n'okùn, Ìwọ ni"},{"start":6.658,"end":7.921,"text":"F'ow'agbara di mi mu","marked":"F'ọw'agbára dì mí mú"},{"start":8.371,"end":10.525,"text":"Onje orun, Onje orun","marked":"Oǹjẹ ọ̀run, Oǹjẹ ọ̀run"},{"start":10.975,"end":12.266,"text":"Ma bo mi titi lailai.","marked":"Má bọ̀ mí títí láéláé."}],"end":12.266},{"key":"2","start":13.216,"lines":[{"start":13.216,"end":14.852,"text":"Silekun isun ogo ni","marked":"Ṣílẹ̀kùn ìsun ògo ni"},{"start":15.302,"end":16.396,"text":"Orisun imarale","marked":"Orísun ìmáralẹ̀"},{"start":16.846,"end":18.403,"text":"Je ki imole Re orun","marked":"Jẹ́ kí ìmọ́lẹ̀ Rẹ ọ̀run"},{"start":18.853,"end":20.261,"text":"Se amona mi jale","marked":"Ṣe amọ̀nà mi jalè"},{"start":20.711,"end":22.037,"text":"Olugbala, Olugbala","marked":"Olùgbàlà, Olùgbàlà"},{"start":22.487,"end":24.191,"text":"S'agbara at'asa mi.","marked":"S'agbára àt'àṣà mi."}],"end":24.191},{"key":"3","start":25.141,"lines":[{"start":25.141,"end":26.677,"text":"Gba mo ba te eba Jordan","marked":"Gba mo bá tẹ ẹ̀bá Jordan"},{"start":27.127,"end":28.259,"text":"F'okan eru mi bale","marked":"F'ọkàn ẹ̀rù mi balẹ̀"},{"start":28.709,"end":30.0,"text":"Iwo t'o ti segun iku","marked":"Ìwọ t'ó ti ṣẹ́gun ikú"},{"start":30.45,"end":31.76,"text":"Mu mi gunle Kenaan je","marked":"Mú mi gúnlẹ̀ Kenaan jẹ́"},{"start":32.21,"end":33.164,"text":"Orin iyin,orin iyin","marked":"Orin iyin,orin ìyìn"},{"start":33.614,"end":34.985,"text":"L'emi o fun O titi.","marked":"L'èmi ó fún Ọ títí."}],"end":34.985}]}