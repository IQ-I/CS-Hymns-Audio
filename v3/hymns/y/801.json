{"v":3,"coll":"y","num":801,"id":"hymn_801","title":"MO n fe O n'gha gbogbo","duration":43.695,"voices":{"male":{"file":"y-801-male-v3.m4a","bytes":290513,"sha256":"7721186e6c7da7a91b57203f085098c907ad3b14bc0299d09cf12cde125cbab9","duration":43.7},"female":{"file":"y-801-female-v3.m4a","bytes":301684,"sha256":"7789378ad100bbdbb4ebfc0cbd5b5b089c1cdcbdfd5d03d745d92fd842962e8a","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.598,"text":"MO n fe O n'gha gbogbo","marked":"Mò ń fẹ́ Ọ n'gha gbogbo"},{"start":2.048,"end":3.052,"text":"Oluwa Oloore","marked":"Olúwa Olóore"},{"start":3.502,"end":4.853,"text":"Ko s'ohun ti n fun ni","marked":"Kò s'ohun tí ń fún ni"},{"start":5.303,"end":6.474,"text":"N'sinmi bii Re.","marked":"N'sinmi bíi Rẹ."}],"end":6.474},{"key":"CHORUS","start":7.424,"lines":[{"start":7.424,"end":10.714,"text":"Mo n fe, o aah! mo n fe O","marked":"Mò ń fẹ́, ọ àáh! mò ń fẹ́ Ọ"},{"start":11.164,"end":12.496,"text":"Ni wakati gbogbo","marked":"Ní wákàtí gbogbo"},{"start":12.946,"end":13.858,"text":"Bukun mi Olugbala","marked":"Bùkún mi Olùgbàlà"},{"start":14.308,"end":15.373,"text":"Mo wa do Re.","marked":"Mo wá dọ̀ Rẹ."}],"end":15.373},{"key":"2","start":16.323,"lines":[{"start":16.323,"end":17.616,"text":"Mo n fe O n'gba gbogbo","marked":"Mò ń fẹ́ Ọ n'gba gbogbo"},{"start":18.066,"end":19.129,"text":"Duro ti mi","marked":"Dúró tì mí"},{"start":19.579,"end":20.67,"text":"Idanwo ko nipa","marked":"Ìdánwò kò nípa"},{"start":21.12,"end":22.374,"text":"B'o wa n'tosi.","marked":"B'ó wá n'tòsí."}],"end":22.374},{"key":"3","start":23.324,"lines":[{"start":23.324,"end":24.566,"text":"Mo n fe O n'gba gbogbo","marked":"Mò ń fẹ́ Ọ n'gba gbogbo"},{"start":25.016,"end":25.805,"text":"N'ipokipo","marked":"N'ìpòkípò"},{"start":26.255,"end":27.342,"text":"Yara wa ba mi gbe","marked":"Yàrá wá bá mi gbé"},{"start":27.792,"end":28.927,"text":"Ki n ma p'ofo","marked":"Kí n má p'òfo"}],"end":28.927},{"key":"4","start":29.877,"lines":[{"start":29.877,"end":31.11,"text":"Mo n fe O n'gba gbogbo","marked":"Mò ń fẹ́ Ọ n'gba gbogbo"},{"start":31.56,"end":32.487,"text":"F'ife Re han","marked":"F'ìfẹ́ Rẹ hàn"},{"start":32.937,"end":34.057,"text":"K'O je k'ileri Re","marked":"K'Ó jẹ́ k'ílérí Rẹ̀"},{"start":34.507,"end":35.461,"text":"Le se si mi","marked":"Lè ṣe sí mi"}],"end":35.461},{"key":"5","start":36.411,"lines":[{"start":36.411,"end":37.607,"text":"Mo nfe O n'gba gbogbo","marked":"Mo ńfẹ́ Ọ n'gba gbogbo"},{"start":38.057,"end":39.244,"text":"Eni Mimo julo","marked":"Ẹni Mímọ́ jùlọ"},{"start":39.694,"end":40.831,"text":"Se mi n' ti Re tooto","marked":"Ṣe mi ń tí Rẹ tòótọ́"},{"start":41.281,"end":42.146,"text":"Omo Olorun.","marked":"Ọmọ Ọlọ́run."}],"end":42.146}]}