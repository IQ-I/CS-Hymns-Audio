{"v":3,"coll":"y","num":83,"id":"hymn_83","title":"A DUPE lowo Olorun","duration":55.178,"voices":{"male":{"file":"y-83-male-v3.m4a","bytes":389698,"sha256":"674ab6114693f7dfd8a8a773e3b57a795c57affce9afcf3230a920ad43208207","duration":55.2},"female":{"file":"y-83-female-v3.m4a","bytes":405018,"sha256":"03b32aa0b3b32c991926dcdeb419e7f2c774f219553d075d2065fd99b5f8ebe6","duration":55.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.416,"text":"A DUPE lowo Olorun","marked":"A Dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":1.866,"end":3.151,"text":"T'o da wa si d'oni","marked":"T'ó dá wa sì d'óní"},{"start":3.601,"end":5.167,"text":"T'o je k'emi tun emi ri,","marked":"T'ó jẹ́ k'èmi tún èmi rí"},{"start":5.617,"end":14.291,"text":"Ogo f'oruko Re. A dupẹ lọwọ Ọlọrun, T'o da ẹmi wa si d'oni; T'o jẹ k'ẹmi tun ẹmi ri, Ogo f'orukọ Rẹ.","marked":"Ògo f'orúkọ Rẹ̀. A dúpẹ́ lọ́wọ́ Ọlọ́run, T'ó dá ẹ̀mí wá sì d'óní; T'ó jẹ́ k'ẹ̀mi tún ẹ̀mí rí, Ògo f'orúkọ Rẹ̀."}],"end":14.291},{"key":"CHORUS","start":15.241,"lines":[{"start":15.241,"end":16.344,"text":"A dupe lowo Olorun","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":16.794,"end":18.35,"text":"T'o da emi wa si d'oni","marked":"T'ó dá ẹ̀mí wa sì d'óní"},{"start":18.8,"end":20.272,"text":"T'o je k'emi tun emi ri","marked":"T'ó jẹ́ k'èmi tún èmi rí"},{"start":20.722,"end":22.004,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":22.004},{"key":"2","start":22.954,"lines":[{"start":22.954,"end":24.597,"text":"Isẹ pọ n'ilu Osogbo,","marked":"Isẹ́ pọ̀ n'ìlú Òṣògbò"},{"start":25.047,"end":26.359,"text":"T'Ilesa ko ni sọ;","marked":"T'Ìlẹ́ṣà kò ní sọ"},{"start":26.809,"end":28.278,"text":"Ẹgbẹ Ondo ti mura tan,","marked":"Ẹgbẹ́ Òǹdó ti múra tán"},{"start":28.728,"end":30.098,"text":"Lati gbe Jesu ga.","marked":"Láti gbé Jésù ga."}],"end":30.098},{"key":"3","start":31.048,"lines":[{"start":31.048,"end":32.658,"text":"Ẹgbẹ Eko damure yin,","marked":"Ẹgbẹ́ Ẹ̀kọ́ dàmúrè yín"},{"start":33.108,"end":34.349,"text":"Lati besu jagun;","marked":"Láti bẹ̀ṣù jagun"},{"start":34.799,"end":36.287,"text":"Oko pọn pupọ n'ilu Oke,","marked":"Oko pọ́n púpọ̀ n'ìlú Òkè"},{"start":36.737,"end":37.663,"text":"Tani yoo lọ ka?","marked":"Tani yóò lọ ká?"}],"end":37.663},{"key":"4","start":38.613,"lines":[{"start":38.613,"end":40.11,"text":"A ki Baba Aladura,","marked":"A kí Baba Aládúrà"},{"start":40.56,"end":41.802,"text":"O ku afojuba;","marked":"Ó kú àfojúba"},{"start":42.252,"end":43.935,"text":"Olori ti jagun fun Jesu,","marked":"Olórí ti jagun fún Jésù"},{"start":44.385,"end":45.575,"text":"O si sẹgun Esu.","marked":"Ó sì sẹ́gun Èṣù."}],"end":45.575},{"key":"5","start":46.525,"lines":[{"start":46.525,"end":48.495,"text":"Orin Halle, Halleluya","marked":"Orin Halle, Hallelúyà"},{"start":48.945,"end":50.381,"text":"L'awa y'o ko l'orun","marked":"L'àwa y'ó kò l'ọ̀run"},{"start":50.831,"end":52.123,"text":"Nigba t'a ba r'Olugbala,","marked":"Nígbà t'á bá r'Olùgbàlà"},{"start":52.573,"end":53.628,"text":"Ni ori ite Re.","marked":"Ní orí ìtẹ́ Rẹ."}],"end":53.628}]}