{"v":3,"coll":"y","num":225,"id":"hymn_225","title":"ODUN miran ti koja","duration":47.351,"voices":{"male":{"file":"y-225-male-v3.m4a","bytes":334817,"sha256":"58f2b1a966212e746c7ea66d19b06c7b610b06ebe42687b6b5810118e692faca","duration":47.4},"female":{"file":"y-225-female-v3.m4a","bytes":345264,"sha256":"6f49dcddb349497547a3745cb9f48925c5738f304cc6a439d75abfd3d98c0022","duration":47.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.881,"text":"ỌDUN miran ti kọja,","marked":"Ọdún míràn ti kọjá"},{"start":2.331,"end":3.704,"text":"Wawa l'akoko naa lọ,","marked":"Wáwa l'àkókò náà lọ"},{"start":4.154,"end":5.443,"text":"Ninu eyi t'a wa yi,","marked":"Nínú èyí t'á wá yí"},{"start":5.893,"end":6.998,"text":"Yoo s'arimọ ọpọ;","marked":"Yóò s'àrímọ ọ̀pọ̀"},{"start":7.448,"end":8.744,"text":"Anu l'o fi da wa si,","marked":"Àánú l'ó fi dá wa sí"},{"start":9.194,"end":10.517,"text":"A ha lo anu naa bi?","marked":"A ha lo àánú náà bí?"},{"start":10.967,"end":12.195,"text":"K'a bi 'ra wa ba se tan?","marked":"K'á bí ra wa bá ṣe tán?"},{"start":12.645,"end":14.137,"text":"B'a o pe wa l'ọdun yi.","marked":"B'á ò pè wá l'ọdún yí."}],"end":14.137},{"key":"2","start":15.087,"lines":[{"start":15.087,"end":16.234,"text":"Ayé bi ibi ija,","marked":"Ayé bí ibi ìjà"},{"start":16.684,"end":17.901,"text":"Ẹgbẹgbẹrun l'o n subu;","marked":"Ẹgbẹgbẹ̀rún l'ó ń ṣubú"},{"start":18.351,"end":20.284,"text":"Ọfa Iku t'o si n fo","marked":"Ọfà Ikú t'ó sì ń fọ́"},{"start":20.734,"end":21.888,"text":"A le ran s'emi b'iwọ,","marked":"A lè ràn s'èmi b'ìwọ"},{"start":22.338,"end":24.203,"text":"Nigb'a n wasu t'a si n gbọ,","marked":"Nígb'à ń wàṣù t'á sì ń gbọ́"},{"start":24.653,"end":26.404,"text":"Oluwa, jẹ k'a saro;","marked":"Olúwa, jẹ́ k'á ṣàrò"},{"start":26.854,"end":28.138,"text":"P'ayérayé sunmọle;","marked":"P'ayérayé súnmọ́lè"},{"start":28.588,"end":30.079,"text":"A n duro l'eti bebe.","marked":"A ń dúró l'etí bẹ̀bẹ̀."}],"end":30.079},{"key":"3","start":31.029,"lines":[{"start":31.029,"end":32.262,"text":"B'a gba wa lọwọ ẹsẹ,","marked":"B'á gbà wá lọ́wọ́ ẹsẹ̀"},{"start":32.712,"end":33.878,"text":"Nipa ore-ọfẹ Rẹ,","marked":"Nípa ore-ọfẹ Rẹ"},{"start":34.328,"end":36.074,"text":"Njẹ ―ma bọ‖ n'ipe o jẹ,","marked":"Ǹjẹ́ ―má bọ̀‖ n'ìpè ó jẹ́"},{"start":36.524,"end":38.373,"text":"K'a le lo, k'a r'oju Rẹ;","marked":"K'á lè lọ, k'á r'ojú Rẹ̀"},{"start":38.823,"end":39.951,"text":"F'eniyan Rẹ l'ayé yi,","marked":"F'ènìyàn Rẹ l'ayé yí"},{"start":40.401,"end":41.933,"text":"K'aanu wa l'ọdun titun;","marked":"K'àánú wà l'ọdún titun"},{"start":42.383,"end":43.92,"text":"Ọdun t'o l'ayọ ju yi,","marked":"Ọdún t'ó l'ayọ̀ ju yí"},{"start":44.37,"end":45.801,"text":"L'eyi t'o mu wọn de 'le.","marked":"L'èyí t'ó mú wọn dé lé."}],"end":45.801}]}