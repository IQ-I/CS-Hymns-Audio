{"v":3,"coll":"y","num":501,"id":"hymn_501","title":"OLORUN wa, awa mbe O","duration":108.949,"voices":{"male":{"file":"y-501-male-v3.m4a","bytes":771849,"sha256":"3ec525ac6f499b137b301b962287565c47b067a940497074239e0b6363d1d897","duration":109.0},"female":{"file":"y-501-female-v3.m4a","bytes":805415,"sha256":"54208b2f592a881770a67b74472761e48cd725701f834442b6d52ddaff4ae956","duration":109.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.325,"text":"OLORUN wa, awa mbe O","marked":"Ọlọ́run wa, àwa mbẹ́ Ọ"},{"start":2.775,"end":4.063,"text":"Sokale si arin wa","marked":"Sọ̀kalẹ̀ sí àrín wa"},{"start":4.513,"end":5.788,"text":"Ran agbara 'segun nla Re","marked":"Rán agbára ṣẹ́gun ńlá Rẹ̀"},{"start":6.238,"end":7.291,"text":"S'ori awon omo Re","marked":"S'orí àwọn ọmọ Rẹ"},{"start":7.741,"end":8.828,"text":"F'ore ofe igbala","marked":"F'oore ọ̀fẹ́ ìgbàlà"},{"start":9.278,"end":10.448,"text":"Yi awa omo Re ka","marked":"Yí àwa ọmọ Rẹ ká"},{"start":10.898,"end":12.416,"text":"K'a le ma yo n'nu ore Re","marked":"K'á lè má yọ̀ n'nú ọrẹ Rẹ"},{"start":12.866,"end":14.097,"text":"K'a si le segun ota.","marked":"K'á sì lè ṣẹ́gun ọ̀tá."}],"end":14.097},{"key":"CHORUS","start":15.047,"lines":[{"start":15.047,"end":15.909,"text":"O d'ofo (4)","marked":"Ó d'ọ̀fọ̀"},{"start":16.359,"end":17.698,"text":"Ajahula Sakula","marked":"Ajahula Sakula"},{"start":18.148,"end":19.595,"text":"Agbara aje d'ofo.","marked":"Agbára ajé d'òfo."}],"end":19.595},{"key":"2","start":20.545,"lines":[{"start":20.545,"end":21.849,"text":"Enyin Angeli Olusegun","marked":"Ẹ̀yin Áńgẹ́lì Olùṣègùn"},{"start":22.299,"end":23.566,"text":"Sokale l'agbara Re","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀"},{"start":24.016,"end":25.625,"text":"E dide pel'ohun ija yin","marked":"Ẹ dìde pẹ̀l'ohun ìjà yín"},{"start":26.075,"end":27.693,"text":"Lati segun f'Egbe yi","marked":"Láti ṣẹ́gun f'Ègbé yí"},{"start":28.143,"end":29.415,"text":"Emi-Mimo daba orun","marked":"Emi-mimo dàbà ọ̀run"},{"start":29.865,"end":31.324,"text":"Fi ore isegun Re","marked":"Fi ọrẹ ìṣẹ́gun Rẹ"},{"start":31.774,"end":33.035,"text":"Yi awa omo Re ka","marked":"Yí àwa ọmọ Rẹ ká"},{"start":33.485,"end":35.088,"text":"K'a le ma yo 'nu segun.","marked":"K'á lè má yọ̀ nù ṣẹ́gun."},{"start":35.538,"end":36.411,"text":"Egbe:  O d'ofo...","marked":"Ó d'ọ̀fọ̀"}],"end":36.411},{"key":"3","start":37.361,"lines":[{"start":37.361,"end":38.917,"text":"Karubu oni 'da ina","marked":"Kàrúbù òní dá iná"},{"start":39.367,"end":40.556,"text":"Sokale l'agbara Re","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀"},{"start":41.006,"end":42.508,"text":"Maikel olori ogun wa","marked":"Maikel olórí ogun wà"},{"start":42.958,"end":44.273,"text":"Sokale l'agbara Re","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀"},{"start":44.723,"end":45.751,"text":"Awa omo Re duro","marked":"Àwa ọmọ Rẹ dúró"},{"start":46.201,"end":47.243,"text":"De agbara ina na","marked":"Dé agbára iná ná"},{"start":47.693,"end":48.867,"text":"T'o sakale sara won","marked":"T'ó ṣákálẹ̀ sára wọn"},{"start":49.317,"end":50.618,"text":"T'o sote s'awon omo Re.","marked":"T'ó ṣọ̀tẹ̀ s'àwọn ọmọ Rẹ̀."},{"start":51.068,"end":51.956,"text":"Egbe:  O d'ofo...","marked":"Ó d'ọ̀fọ̀"}],"end":51.956},{"key":"4","start":52.906,"lines":[{"start":52.906,"end":54.14,"text":"Olorun Alagbara nla","marked":"Ọlọ́run Alágbára ńlá"},{"start":54.59,"end":56.115,"text":"T'o pa ara Egypt run","marked":"T'ó pa ara Egypt run"},{"start":56.565,"end":58.166,"text":"T'o ri won sinu okun pupa","marked":"T'ó rí wọn sínú okùn pupa"},{"start":58.616,"end":59.857,"text":"Ti nwon ko le dide mo","marked":"Tí wọ́n kò lè dìde mọ́"},{"start":60.307,"end":61.81,"text":"Sokale Eleda wa","marked":"Sọ̀kalẹ̀ Ẹlẹ́dàá wa"},{"start":62.26,"end":63.393,"text":"Doju ota wa bo le","marked":"Dojú ọ̀tá wa bọ́ lé"},{"start":63.843,"end":65.141,"text":"Ki nwon subu n'iwaju Re","marked":"Kí wọ́n ṣubú n'iwájú Rẹ"},{"start":65.591,"end":67.075,"text":"Ki nwon si di 'temole.","marked":"Kí wọ́n sì di tèmọ́lé."},{"start":67.525,"end":68.399,"text":"Egbe:  O d'ofo...","marked":"Ó d'ọ̀fọ̀"}],"end":68.399},{"key":"5","start":69.349,"lines":[{"start":69.349,"end":70.98,"text":"E ma yo enyin enia mi","marked":"Ẹ má yọ ẹ̀yin ẹnìà mi"},{"start":71.43,"end":72.539,"text":"Ninu agbara nla mi","marked":"Nínú agbára ńlá mi"},{"start":72.989,"end":74.343,"text":"E ho iho isegun nla","marked":"Ẹ hó ihò ìṣẹ́gun ńlá"},{"start":74.793,"end":76.023,"text":"Bi t' awon omo Isreal","marked":"Bí t àwọn ọmọ Isreal"},{"start":76.473,"end":78.208,"text":"Maikel ti segun fun nyin","marked":"Maikel ti ṣẹ́gun fún yín"},{"start":78.658,"end":79.926,"text":"O si di nyin l'amure","marked":"Ó sì di yín l'àmùrè"},{"start":80.376,"end":82.03,"text":"Te siwaju n'ipa agbara Re,","marked":"Tẹ̀ síwájú n'ipa agbára Rẹ̀"},{"start":82.48,"end":83.827,"text":"E ja k'e si le segun.","marked":"Ẹ jà k'é sì lè ṣẹ́gun."},{"start":84.277,"end":85.198,"text":"Egbe:  O d'ofo...","marked":"Ó d'ọ̀fọ̀"}],"end":85.198},{"key":"6","start":86.148,"lines":[{"start":86.148,"end":87.911,"text":"Emi ni El El-Sahula","marked":"Èmi ni El El-sahula"},{"start":88.361,"end":89.737,"text":"Oba Ajasegun ni mi","marked":"Ọba Ajáṣegun ni mí"},{"start":90.187,"end":91.675,"text":"Emi ni Jehofa Hullam","marked":"Èmi ni Jèhófà Hullam"},{"start":92.125,"end":93.373,"text":"Oba Awimayehun","marked":"Ọba Awimayehun"},{"start":93.823,"end":95.182,"text":"E ma yo ninu ore mi","marked":"Ẹ má yọ̀ nínú ọrẹ mi"},{"start":95.632,"end":96.993,"text":"K'e si ma dupe pelu","marked":"K'é sì má dúpẹ́ pẹ̀lú"},{"start":97.443,"end":98.727,"text":"Emi ni Asaholah","marked":"Èmi ni Asaholah"},{"start":99.177,"end":101.1,"text":"Oba a-fi-dip'o-te‐mole.","marked":"Ọba a-fi-dip'o-te-mole."},{"start":101.55,"end":102.428,"text":"Egbe:  O d'ofo (4)","marked":"Ó d'ọ̀fọ̀"},{"start":102.878,"end":104.235,"text":"Ajahula Sakula","marked":"Ajahula Sakula"},{"start":104.685,"end":106.352,"text":"Agbara aje d'ofo.","marked":"Agbára ajé d'òfo."},{"start":106.802,"end":107.4,"text":"Amin.","marked":"Àmín."}],"end":107.4}]}