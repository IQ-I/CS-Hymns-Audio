{"v":3,"coll":"y","num":89,"id":"hymn_89","title":"EYIN Egbe Igbala | Eyin Ijo Igbala Je Ka Yin Oba Ogo","duration":28.606,"voices":{"male":{"file":"y-89-male.m4a","bytes":197802,"sha256":"37ad1c48e6f49807eac50ceefe7dcd6f7b37d947bd759fa0ad7523afc1d09ef1","duration":28.7},"female":{"file":"y-89-female.m4a","bytes":205977,"sha256":"0026000a2a60fa3fee8023e19d1320cb956ff46f8ff5d341d86eebe958562a43","duration":28.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.404,"text":"ENYIN Egbę Igbala","marked":"Enyin Ègbẹ́ Ìgbàlà"},{"start":1.784,"end":2.986,"text":"Je k'a yin oba Ogo,","marked":"Jẹ k'á yin ọba Ògo"},{"start":3.366,"end":4.731,"text":"T'o da wa si di oni,","marked":"T'ó dá wa sí di òní"},{"start":5.111,"end":6.328,"text":"T'iparun ko ba wa.","marked":"T'ìparun kò bá wà."}],"end":6.328},{"key":"CHORUS","start":7.278,"lines":[{"start":7.278,"end":8.042,"text":"Yin Oluwa, (2ce)","marked":"Yín Olúwa"},{"start":8.422,"end":9.953,"text":"Kerubu, Serafu,","marked":"Kérúbù, Séráfù"},{"start":10.333,"end":11.554,"text":"Enyin agbaiye dide,","marked":"Enyin agbaiye dìde"},{"start":11.934,"end":13.239,"text":"K'a yin oba Ogo.","marked":"K'á yin ọba Ògo."}],"end":13.239},{"key":"2","start":14.189,"lines":[{"start":14.189,"end":15.413,"text":"Onigbagbo agbaiye,","marked":"Onígbàgbọ́ agbaiye"},{"start":15.793,"end":17.012,"text":"Imale gbogb❜aiye","marked":"Ìmàlẹ̀ gbogb'aiye"},{"start":17.392,"end":18.702,"text":"Ati Keferi agbaiye","marked":"Àti Kèfèrí àgbáíyé"},{"start":19.082,"end":20.278,"text":"Ę wa k'a yin Oluwa","marked":"Ẹ wá k'á yin Olúwa"}],"end":20.278},{"key":"3","start":21.228,"lines":[{"start":21.228,"end":22.399,"text":"Emi Adaba Orun","marked":"Ẹ̀mí Àdàbà Ọ̀run"},{"start":22.779,"end":23.793,"text":"Șe 'le Rę ninu wa,","marked":"Ṣe 'lé Rẹ̀ nínú wa"},{"start":24.173,"end":25.489,"text":"'Fun wa l'okun lera","marked":"'Fún wa l'òkun léra"},{"start":25.869,"end":27.057,"text":"Lati yin Olorun.","marked":"Láti yin Ọlọ́run."}],"end":27.057}]}