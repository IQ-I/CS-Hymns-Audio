{"v":3,"coll":"y","num":441,"id":"hymn_441","title":"GBOGB' eyin Onigbagbo","duration":86.896,"voices":{"male":{"file":"y-441-male-v3.m4a","bytes":598102,"sha256":"b0e36fe521eb08e51f3472e88f88237d79e0efb8f052f0ed516d4dd2c4173281","duration":86.9},"female":{"file":"y-441-female-v3.m4a","bytes":627510,"sha256":"59c8ac27a83b2b103890cb658ab9bd81f928abd9d893674254bca62e0abaf1d1","duration":86.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.432,"text":"GBOGBO enyin Onigbagbo","marked":"Gbogbo ẹ̀yin Onígbàgbọ́"},{"start":1.882,"end":2.903,"text":"To wa lode aiye","marked":"Tó wà lóde ayé"},{"start":3.353,"end":4.572,"text":"Babalawo gbe 'fa wa","marked":"Babalawo gbé fà wá"},{"start":5.022,"end":6.25,"text":"O tun d'Aladura.","marked":"Ó tún d'Aládúrà."},{"start":6.7,"end":7.547,"text":"Egbe:  E yi pada","marked":"Ẹ yí padà"},{"start":7.997,"end":9.136,"text":"Ojo 'dajo de tan","marked":"Ọjọ́ dájọ́ dé tán"},{"start":9.586,"end":11.74,"text":"E yi pada, e sunmo Olorun.","marked":"Ẹ yí padà, ẹ súnmọ́ Ọlọ́run."}],"end":11.74},{"key":"2","start":12.69,"lines":[{"start":12.69,"end":14.055,"text":"Pupo abogi bo 'pe","marked":"Púpọ̀ abògi bọ́ pé"},{"start":14.505,"end":15.676,"text":"Fori bale f'Oba","marked":"Forí balẹ̀ f'Ọba"},{"start":16.126,"end":17.555,"text":"Nwon si tun jeri Kristi","marked":"Wọ́n sì tún jẹ́rí Kristi"},{"start":18.005,"end":19.278,"text":"Niwaj'onigbagbo.","marked":"Níwáj'onígbàgbọ́."},{"start":19.728,"end":20.554,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":20.554},{"key":"3","start":21.504,"lines":[{"start":21.504,"end":22.479,"text":"Oro Olugbala se,","marked":"Ọ̀rọ̀ Olùgbàlà ṣe"},{"start":22.929,"end":24.005,"text":"Lori gbogbo aiye","marked":"Lórí gbogbo ayé"},{"start":24.455,"end":25.778,"text":"Wipe gbogbo ekun ni","marked":"Wípé gbogbo ẹkún ni"},{"start":26.228,"end":27.358,"text":"Yio wole fun mi.","marked":"Yóò wọlé fún mi."},{"start":27.808,"end":28.604,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":28.604},{"key":"4","start":29.554,"lines":[{"start":29.554,"end":30.664,"text":"Sib'awon onigbagbo","marked":"Síb'àwọn onígbàgbọ́"},{"start":31.114,"end":32.268,"text":"Gb'ohun asan dani","marked":"Gb'ohùn asán dani"},{"start":32.718,"end":34.139,"text":"T'o ni ohun 'dile ni","marked":"T'ó ní ohun dilẹ̀ ni"},{"start":34.589,"end":36.141,"text":"Emi ko le s'aise.","marked":"Èmi kò lè s'àìṣe."},{"start":36.591,"end":37.418,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":37.418},{"key":"5","start":38.368,"lines":[{"start":38.368,"end":39.652,"text":"ltiju pupo yio wa","marked":"Ìtìjú púpọ̀ yóò wà"},{"start":40.102,"end":41.011,"text":"F'awon onigbagbop","marked":"F'àwọn onígbàgbọ́p"},{"start":41.461,"end":42.574,"text":"At'awon onimale","marked":"Àt'àwọn onímàlẹ̀"},{"start":43.024,"end":44.259,"text":"Gb'onifa ba wole.","marked":"Gb'onifa bá wọlé."},{"start":44.709,"end":45.513,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":45.513},{"key":"6","start":46.463,"lines":[{"start":46.463,"end":47.735,"text":"Okunrin at'obinrin","marked":"Ọkùnrin àt'obìnrin"},{"start":48.185,"end":49.53,"text":"T'o wa nin'Egbe yi","marked":"T'ó wà nín'ègbé yí"},{"start":49.98,"end":51.459,"text":"Ise po pupo l'oko","marked":"Iṣẹ́ pọ̀ púpọ̀ l'ọ̀kọ̀"},{"start":51.909,"end":53.384,"text":"Tal'awa yio ran lo.","marked":"Tál'àwa yóò rán lọ."},{"start":53.834,"end":54.649,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":54.649},{"key":"7","start":55.599,"lines":[{"start":55.599,"end":56.706,"text":"O seun omo rere","marked":"Ó ṣeun ọmọ rere"},{"start":57.156,"end":58.541,"text":"L'ohun 'kehin yio je","marked":"L'ohun kẹ́hìn yóò jẹ́"},{"start":58.991,"end":60.416,"text":"F'awon to s'olotito","marked":"F'àwọn tó s'olótítọ́"},{"start":60.866,"end":61.954,"text":"'Nu Egbe Kerubu.","marked":"nu Ẹgbẹ́ Kérúbù."},{"start":62.404,"end":63.313,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":63.313},{"key":"8","start":64.263,"lines":[{"start":64.263,"end":65.325,"text":"E lo kuro lodo mi","marked":"Ẹ lọ kúrò lọ́dọ̀ mi"},{"start":65.775,"end":66.968,"text":"Emi ko mo nyin ri","marked":"Èmi kò mọ yín rí"},{"start":67.418,"end":68.664,"text":"L'ohun ikehin yio je","marked":"L'ohun ìkẹhìn yóò jẹ́"},{"start":69.114,"end":70.283,"text":"F'awon alaigbagbo.","marked":"F'àwọn aláìgbàgbọ́."},{"start":70.733,"end":71.485,"text":"Egbe: E yi pada...","marked":"Ẹ yí padà"}],"end":71.485},{"key":"9","start":72.435,"lines":[{"start":72.435,"end":73.79,"text":"Jehovah Jire Baba","marked":"Jehovah Jire Baba"},{"start":74.24,"end":75.501,"text":"Jowo pese fun wa","marked":"Jọ̀wọ́ pèsè fún wa"},{"start":75.951,"end":77.321,"text":"Jehovah Nisi Baba","marked":"Jehovah Nísi Baba"},{"start":77.771,"end":78.822,"text":"Pa wa mo de opin.","marked":"Pa wá mo dé òpin."},{"start":79.272,"end":80.094,"text":"Egbe:  E yi pada","marked":"Ẹ yí padà"},{"start":80.544,"end":81.68,"text":"Ojo 'dajo de tan","marked":"Ọjọ́ dájọ́ dé tán"},{"start":82.13,"end":84.269,"text":"E yi pada, e sunmo Olorun.","marked":"Ẹ yí padà, ẹ súnmọ́ Ọlọ́run."},{"start":84.719,"end":85.347,"text":"Amin.","marked":"Àmín."}],"end":85.347}]}