{"v":3,"coll":"y","num":853,"id":"hymn_853","title":"Olorun aye mi","duration":56.557,"voices":{"male":{"file":"y-853-male-v3.m4a","bytes":390550,"sha256":"4b75ee50d29abbb932f87a81f9ca7ef560c21594125e09889d977bee56009325","duration":56.6},"female":{"file":"y-853-female-v3.m4a","bytes":409601,"sha256":"ef2e77f3f448ddadfd7e574a364a01f20886caf26b210b3d0055fd1de23d7dcb","duration":56.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.347,"text":"Ọlọrun ayé mi,","marked":"Ọlọ́run ayé mi"},{"start":1.797,"end":3.025,"text":"Ẹmi mi yọ si Ọ!","marked":"Ẹ̀mí mi yọ sí Ọ!"},{"start":3.475,"end":4.553,"text":"Ọrẹ Rẹ l'o da mi","marked":"Ọrẹ Rẹ l'ó dá mi"},{"start":5.003,"end":6.22,"text":"L'o da mi si sibẹ,","marked":"L'ó dá mi sí síbẹ̀"},{"start":6.67,"end":8.041,"text":"Ayajọ ibi mi tun de,","marked":"Àyàjọ ibi mi tún dé"},{"start":8.491,"end":10.239,"text":"N ó sure f'ọjọ t'a bi mi.","marked":"N ó súre f'ọjọ́ t'a bí mi."}],"end":10.239},{"key":"2","start":11.189,"lines":[{"start":11.189,"end":12.242,"text":"Ni gbogbo ọjọ mi,","marked":"Ní gbogbo ọjọ́ mi"},{"start":12.692,"end":14.034,"text":"Ki n wa laye fun Ọ!","marked":"Kí n wà láyè fún Ọ!"},{"start":14.484,"end":15.527,"text":"Ki gbogbo ẹmi mi,","marked":"Kí gbogbo ẹ̀mí mi"},{"start":15.977,"end":17.615,"text":"F'ọpẹ, iyin fun Ọ!","marked":"F'ọpẹ́, ìyìn fún Ọ!"},{"start":18.065,"end":19.327,"text":"Gbogbo ini at'iwa mi,","marked":"Gbogbo ìní àt'ìwà mi"},{"start":19.777,"end":21.34,"text":"Y'o yin Ẹlẹda mi logo.","marked":"Y'ó yin Ẹlẹda mi lógo."}],"end":21.34},{"key":"3","start":22.29,"lines":[{"start":22.29,"end":23.375,"text":"Gbogbo pa ẹmi mi,","marked":"Gbogbo pa ẹ̀mí mi"},{"start":23.825,"end":25.124,"text":"Y'o jẹ Tirẹ nikan;","marked":"Y'ó jẹ́ Tirẹ̀ nìkan"},{"start":25.574,"end":26.631,"text":"Gbogbo akoko mi,","marked":"Gbogbo àkókò mi"},{"start":27.081,"end":28.454,"text":"Mo ya sọtọ fun Ọ;","marked":"Mo yà sọ́tọ̀ fún Ọ"},{"start":28.904,"end":30.138,"text":"Jọ tun mi bi l'aworan Rẹ,","marked":"Jọ tún mi bí l'àwòrán Rẹ"},{"start":30.588,"end":32.248,"text":"N ó si ma yin Ọ titi ayé.","marked":"N ó sì má yìn Ọ́ títí ayé."}],"end":32.248},{"key":"4","start":33.198,"lines":[{"start":33.198,"end":34.456,"text":"Mo n fẹ se ifẹ Rẹ,","marked":"Mò ń fẹ́ ṣe ìfẹ́ Rẹ"},{"start":34.906,"end":36.636,"text":"B'angel' ti n se l'ọrun,","marked":"B'angẹl tí ń ṣe l'ọ̀run"},{"start":37.086,"end":38.284,"text":"Ki n datunbi n'nu Krist'","marked":"Kí n dátúnbí n'nú Krist"},{"start":38.734,"end":40.018,"text":"Ki n ri 'dariji gba,","marked":"Kí n rí dáríjì gbà"},{"start":40.468,"end":42.096,"text":"Mo n fẹ mu 'fẹ pipe Rẹ sẹ,","marked":"Mò ń fẹ́ mú 'fẹ pípé Rẹ sẹ́"},{"start":42.546,"end":43.859,"text":"K'ifẹ Rẹ ya mi si Mimọ.","marked":"K'ìfẹ́ Rẹ̀ yà mí sí Mímọ́."}],"end":43.859},{"key":"5","start":44.809,"lines":[{"start":44.809,"end":46.089,"text":"'Gba 'sẹ na ba pari,","marked":"gbà 'sẹ ná bá parí"},{"start":46.539,"end":47.885,"text":"L'agbara igbagbọ,","marked":"L'agbára ìgbàgbọ́"},{"start":48.335,"end":49.437,"text":"Tẹwọ gb'ayanfẹ RẸ,","marked":"Tẹ́wọ́ gb'àyànfẹ́ Rẹ"},{"start":49.887,"end":50.967,"text":"Ni akoko iku:","marked":"Ní àkókò ikú"},{"start":51.417,"end":52.976,"text":"Pe mi sọdọ bi ti Mose,","marked":"Pè mí sọ́dọ̀ bí ti Mósè"},{"start":53.426,"end":55.007,"text":"Gbe ẹmi mi s'afẹfẹ 'rẹ.","marked":"Gbé ẹ̀mí mi s'áfẹ́fẹ́ 'rẹ."}],"end":55.007}]}