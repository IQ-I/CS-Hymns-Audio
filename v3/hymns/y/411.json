{"v":3,"coll":"y","num":411,"id":"hymn_411","title":"OLORUN Serafu","duration":51.814,"voices":{"male":{"file":"y-411-male-v3.m4a","bytes":345051,"sha256":"14cae89e249f869fcfffa5a7553a179593f2b0b22db46a0cbb1a51811450ffc9","duration":51.9},"female":{"file":"y-411-female-v3.m4a","bytes":363928,"sha256":"28b45353c7f878f72d52dafce69c29e8cb56d056109e0a94a81cc45c0b697576","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.362,"text":"OLORUN Serafu","marked":"Ọlọ́run Séráfù"},{"start":1.812,"end":2.925,"text":"Ati ti Kerubu","marked":"Àti ti Kérúbù"},{"start":3.375,"end":5.074,"text":"Masai pelu awa t'aiye","marked":"Masai pẹ̀lú àwa t'ayé"},{"start":5.524,"end":6.653,"text":"Ko gbo adura.","marked":"Kò gbọ́ àdúrà."}],"end":6.653},{"key":"CHORUS","start":7.603,"lines":[{"start":7.603,"end":8.512,"text":"Alanu Olore","marked":"Alánù Ọlọ́rẹ́"},{"start":8.962,"end":10.322,"text":"Gbo tiwa Baba wa","marked":"Gbọ́ tiwa Baba wa"},{"start":10.772,"end":12.21,"text":"Iwo to gbo ti Elijah","marked":"Ìwọ tó gbọ́ tí Elijah"},{"start":12.66,"end":14.006,"text":"Gbo t'Egbe Serafu.","marked":"Gbọ́ t'Ẹgbẹ́ Séráfù."}],"end":14.006},{"key":"2","start":14.956,"lines":[{"start":14.956,"end":15.81,"text":"lwo Omo Baba","marked":"Ìwọ Ọmọ Baba"},{"start":16.26,"end":17.568,"text":"T'o ti gb'ara wa wo","marked":"T'ó ti gb'ara wa wò"},{"start":18.018,"end":19.627,"text":"lwo ti mo ailera wa","marked":"Ìwọ ti mọ àìlera wa"},{"start":20.077,"end":21.511,"text":"Ma wa fun wa titi.","marked":"Má wà fún wa títí."}],"end":21.511},{"key":"3","start":22.461,"lines":[{"start":22.461,"end":23.572,"text":"Ise 'yanu Re yo","marked":"Iṣẹ́ yanu Rẹ̀ yọ"},{"start":24.022,"end":24.988,"text":"Larin Igbimo wa","marked":"Lárin Ìgbìmọ̀ wa"},{"start":25.438,"end":26.98,"text":"T'o gbe Alagba wa dide","marked":"T'ó gbé Alàgbà wa dìde"},{"start":27.43,"end":28.423,"text":"Fun igbala enia.","marked":"Fún ìgbàlà ènìà."}],"end":28.423},{"key":"4","start":29.373,"lines":[{"start":29.373,"end":30.541,"text":"Ope ni f 'Olorun","marked":"Ọpẹ́ ni f Ọlọ́run"},{"start":30.991,"end":32.009,"text":"Fun 'ru ore Re yi","marked":"Fún rú ọrẹ Rẹ yí"},{"start":32.459,"end":34.181,"text":"Ti ko ka wa s'alailera","marked":"Tí kò kà wá s'aláìlera"},{"start":34.631,"end":35.705,"text":"To nfi ran re han wa.","marked":"Tó ńfi rán rẹ̀ hàn wá."}],"end":35.705},{"key":"5","start":36.655,"lines":[{"start":36.655,"end":37.858,"text":"Ebun rere re ni","marked":"Ẹ̀bùn rere rẹ̀ ni"},{"start":38.308,"end":39.62,"text":"To ti pese fun wa","marked":"Tó ti pèsè fún wa"},{"start":40.07,"end":41.241,"text":"A mbe O Baba wa orun","marked":"A mbẹ́ Ọ Baba wa ọ̀run"},{"start":41.691,"end":43.047,"text":"Mase je ko ya wa.","marked":"Maṣe jẹ́ kó yà wá."}],"end":43.047},{"key":"6","start":43.997,"lines":[{"start":43.997,"end":45.161,"text":"E f'Ogo fun Baba","marked":"Ẹ f'Ògo fún Baba"},{"start":45.611,"end":46.717,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":47.167,"end":48.47,"text":"E f'Ogo fun Emi Mimo","marked":"Ẹ f'Ògo fún Ẹ̀mí Mímọ́"},{"start":48.92,"end":50.265,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":50.265}]}