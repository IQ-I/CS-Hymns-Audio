{"v":3,"coll":"y","num":609,"id":"hymn_609","title":"OJO 'dajo ojo eru!","duration":56.045,"voices":{"male":{"file":"y-609-male-v3.m4a","bytes":386580,"sha256":"45f3d0368883939a3005b2cbcf69bcda0d28bf1c887f740ed010dafacc13b4d5","duration":56.1},"female":{"file":"y-609-female-v3.m4a","bytes":401097,"sha256":"2d142bb5b5b845713695c0f14851c994628909e56261add407b7fc8b3424e36b","duration":56.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.526,"text":"ỌJỌ 'dajọ ọjọ ẹru!","marked":"Ọjọ́ 'dajọ ọjọ́ ẹrú!"},{"start":1.976,"end":3.416,"text":"Gbọ bi ipe ti n dun to!","marked":"Gbọ́ bí ìpè tí ń dùn tó!"},{"start":3.866,"end":5.249,"text":"O ju ẹgbẹrun ara lọ,","marked":"Ó ju ẹgbẹ̀rún ara lọ"},{"start":5.699,"end":6.831,"text":"O si n mi gbogbo ayé,","marked":"Ó sì ń mi gbogbo ayé"},{"start":7.281,"end":8.277,"text":"Bi ẹsun na,","marked":"Bí ẹ̀sùn ná"},{"start":8.727,"end":10.271,"text":"Y'o ti damu ẹlẹsẹ.","marked":"Y'ó ti dàmú ẹlẹ́sẹ̀."}],"end":10.271},{"key":"2","start":11.221,"lines":[{"start":11.221,"end":12.605,"text":"Wọ Onidajọ l'awa wa,","marked":"Wọ Onídájọ́ l'àwa wà"},{"start":13.055,"end":14.543,"text":"T'o wọ ogo nla l'asọ;","marked":"T'ó wọ ògo ńlá l'asọ"},{"start":14.993,"end":16.334,"text":"Gbogbo wọn ti n wo ọna Rẹ,","marked":"Gbogbo wọn ti ń wo ọ̀nà Rẹ"},{"start":16.784,"end":17.934,"text":"'Gbana ni wọn o ma yọ,","marked":"gbàná ni wọn ó má yọ̀"},{"start":18.384,"end":19.123,"text":"Olugbala,","marked":"Olùgbàlà"},{"start":19.573,"end":20.914,"text":"Jẹwọ mi ni ọjọ na.","marked":"Jẹ́wọ́ mi ní ọjọ́ ná."}],"end":20.914},{"key":"3","start":21.864,"lines":[{"start":21.864,"end":23.944,"text":"Ni pipe Rẹ oku o ji,","marked":"Ní pípé Rẹ òkú ó jí"},{"start":24.394,"end":26.299,"text":"Lat'okun, ile s'iye:","marked":"Lát'òkun, ilẹ̀ s'ìyẹ́"},{"start":26.749,"end":28.168,"text":"Gbogbo ipa ayé y'o mi,","marked":"Gbogbo ipa ayé y'ó mi"},{"start":28.618,"end":29.868,"text":"Wọn o salọ loju RẸ;","marked":"Wọn ó sálọ lójú Rẹ̀"},{"start":30.318,"end":31.049,"text":"Alaironu,","marked":"Aláìronú"},{"start":31.499,"end":32.732,"text":"Yoo ha ti ri fun ọ?","marked":"Yóò ha ti rí fún ọ?"}],"end":32.732},{"key":"4","start":33.682,"lines":[{"start":33.682,"end":35.065,"text":"Esu ti n tan ọ nisinyi,","marked":"Èṣù tí ń tàn ọ́ nísìnyí"},{"start":35.515,"end":36.739,"text":"Iwọ mase gbọ tirẹ,","marked":"Ìwọ máṣe gbọ́ tirẹ̀"},{"start":37.189,"end":38.642,"text":"'Gbati ayé yi ba kọja;","marked":"gbátí ayé yí bá kọjá"},{"start":39.092,"end":40.272,"text":"Y'o ri ọ ninu ina;","marked":"Y'ó rí ọ nínú iná"},{"start":40.722,"end":41.438,"text":"Iwọ ronu,","marked":"Ìwọ ronú"},{"start":41.888,"end":43.081,"text":"Ipo rẹ ninu ina.","marked":"Ipò rẹ̀ nínú iná."}],"end":43.081},{"key":"5","start":44.031,"lines":[{"start":44.031,"end":45.584,"text":"Labẹ ipọnju at'ẹgan,","marked":"Lábẹ́ ìpọ́njú àt'ẹ̀gàn"},{"start":46.034,"end":47.427,"text":"K'eyi gba ọ n'iyanju;","marked":"K'èyí gbà ọ́ n'ìyànjú"},{"start":47.877,"end":49.116,"text":"Ọjọ Ọlọrun mbọ tete,","marked":"Ọjọ́ Ọlọ́run mbọ́ tètè"},{"start":49.566,"end":51.4,"text":"'Gbana ẹkun y'o d'ayọ,","marked":"gbàná ẹkún y'ó d'ayọ̀"},{"start":51.85,"end":52.715,"text":"A o sẹgun,","marked":"A ó sẹ́gun"},{"start":53.165,"end":54.496,"text":"'Gbati ayé ba gbina.","marked":"gbátí ayé bá gbiná."}],"end":54.496}]}