{"v":3,"coll":"y","num":430,"id":"hymn_430","title":"OLORUN, a so oro Re","duration":23.843,"voices":{"male":{"file":"y-430-male-v3.m4a","bytes":159095,"sha256":"9777390d40b5780e705a8b7fca9f8cff7910b867b43cb43fe5d50b16bfe451fb","duration":23.9},"female":{"file":"y-430-female-v3.m4a","bytes":164972,"sha256":"651a4ba62dcb5f15587b7e7629106a7dbd94239125a30c6c97721126005b632d","duration":23.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.44,"text":"OLORUN, a so oro Re","marked":"Ọlọ́run, a sọ ọ̀rọ̀ Rẹ̀"},{"start":1.89,"end":3.102,"text":"Bi 'rugbin l'or'ile","marked":"Bí rúgbìn l'ọ́r'ilẹ̀"},{"start":3.552,"end":4.772,"text":"Je k'iri orun se sile","marked":"Jẹ́ k'ìrì ọ̀run ṣe sílẹ̀"},{"start":5.222,"end":6.411,"text":"K'o mu ipa re wa.","marked":"K'ó mú ipa rẹ̀ wá."}],"end":6.411},{"key":"2","start":7.361,"lines":[{"start":7.361,"end":8.708,"text":"K'ọta Kristi oun eniyan,","marked":"K'ọ̀tá Kristi òun ènìyàn"},{"start":9.158,"end":10.43,"text":"Mase se sa 'rugbin na;","marked":"Máṣe ṣe sá rúgbìn ná"},{"start":10.88,"end":12.356,"text":"K'o f'irin mulẹ l'okan wa,","marked":"K'ó f'irin múlẹ̀ l'ọkàn wa"},{"start":12.806,"end":14.244,"text":"K'o dagba ni ifẹ.","marked":"K'ó dàgbà ní ìfẹ́."}],"end":14.244},{"key":"3","start":15.194,"lines":[{"start":15.194,"end":16.654,"text":"Ma jẹ ki aniyan ayé,","marked":"Má jẹ́ kí àníyàn ayé"},{"start":17.104,"end":18.296,"text":"Bi ọrọ oun ayọ,","marked":"Bí ọ̀rọ̀ òun ayọ̀"},{"start":18.746,"end":20.613,"text":"Tabi ijọna, oun iji,","marked":"Tàbí ìjọ̀nà, òun ìjì"},{"start":21.063,"end":22.293,"text":"Run irugbin ọrun.","marked":"Run irúgbìn ọ̀run."}],"end":22.293}]}