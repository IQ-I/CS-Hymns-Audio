{"v":3,"coll":"y","num":162,"id":"hymn_162","title":"EMI Mimo sokale","duration":43.639,"voices":{"male":{"file":"y-162-male-v3.m4a","bytes":300443,"sha256":"a4ab9c3e070912d932ad11c5b188667d8dac45a1c7e30ea20f0bef71ece7c400","duration":43.7},"female":{"file":"y-162-female-v3.m4a","bytes":313320,"sha256":"e81c4d772f0f6eaf7a6a525ac8bc11eb917de0e6d940fe8914fb8467b796f7d7","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.561,"text":"ẸMI Mimọ sọkalẹ,","marked":"Ẹ̀mí Mímọ́ sọ̀kalẹ̀"},{"start":2.011,"end":3.102,"text":"Fi ohun ọrun han;","marked":"Fi ohun ọ̀run hàn"},{"start":3.552,"end":4.906,"text":"K'o mu imọlẹ w'ayé,","marked":"K'ó mú ìmọ́lẹ̀ w'ayé"},{"start":5.356,"end":6.42,"text":"Si ara eniyan.","marked":"Sí ara ènìyàn."},{"start":6.87,"end":8.361,"text":"K'awa t'a wa l'okunkun,","marked":"K'àwa t'á wà l'òkùnkùn"},{"start":8.811,"end":9.788,"text":"Ki o le ma riran,","marked":"Kí ó lè má ríran"},{"start":10.238,"end":11.748,"text":"'Tori Jesu Kristi ku,","marked":"torí Jésù Kristi kú"},{"start":12.198,"end":13.344,"text":"Fun gbogbo eniyan.","marked":"Fún gbogbo ènìyàn."}],"end":13.344},{"key":"2","start":14.294,"lines":[{"start":14.294,"end":15.889,"text":"K'o fi han pe ẹlẹsẹ,","marked":"K'ó fi hàn pé ẹlẹ́sẹ̀"},{"start":16.339,"end":17.455,"text":"Ni emi n se papa;","marked":"Ni èmi ń ṣe pápá"},{"start":17.905,"end":19.171,"text":"K'emi k'o le gbẹkẹ mi,","marked":"K'èmi k'ó lè gbẹ́kẹ̀ mi"},{"start":19.621,"end":20.576,"text":"Le Olugbala mi,","marked":"Lé Olùgbàlà mi"},{"start":21.026,"end":22.242,"text":"Nigba ti a wẹ mi nu,","marked":"Nígbà tí a wẹ̀ mí nù"},{"start":22.692,"end":23.838,"text":"Kuro ninu ẹsẹ,","marked":"Kúrò nínú ẹsẹ̀"},{"start":24.288,"end":25.598,"text":"Emi o le fi ogo,","marked":"Èmi ó lè fi ògo"},{"start":26.048,"end":27.27,"text":"Fun Ẹni mimọ na.","marked":"Fún Ẹni mímọ́ ná."}],"end":27.27},{"key":"3","start":28.22,"lines":[{"start":28.22,"end":29.349,"text":"K'o mu mi se afẹri,","marked":"K'ó mú mi ṣe àfẹ́rí"},{"start":29.799,"end":31.211,"text":"Lati tọ Jesu lọ;","marked":"Láti tọ Jésù lọ"},{"start":31.661,"end":33.11,"text":"K'o j'ọba ni ọkan mi,","marked":"K'ò j'ọba ní ọkàn mi"},{"start":33.56,"end":34.936,"text":"K'o sọ mi di mimọ;","marked":"K'ó sọ mí di mímọ́"},{"start":35.386,"end":36.958,"text":"Ki ara ati ọkan,","marked":"Kí ara àti ọkàn"},{"start":37.408,"end":38.72,"text":"K'o dapọ lati sin,","marked":"K'ó dàpọ̀ láti sìn"},{"start":39.17,"end":40.405,"text":"Ọlọrun Ẹni mimọ,","marked":"Ọlọ́run Ẹni mímọ́"},{"start":40.855,"end":42.09,"text":"Matalọkan soso.","marked":"Màtàlọ́kàn ṣoṣo."}],"end":42.09}]}