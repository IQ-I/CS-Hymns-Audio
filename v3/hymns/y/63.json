{"v":3,"coll":"y","num":63,"id":"hymn_63","title":"BABA jo gbo temi","duration":45.033,"voices":{"male":{"file":"y-63-male-v3.m4a","bytes":304877,"sha256":"6e2f5e5441b8ba01da2e48426e4bd7fa0d1e3997355f697e78f5fbc63acd50d2","duration":45.1},"female":{"file":"y-63-female-v3.m4a","bytes":313077,"sha256":"d6c0cc5cf420a2af61e73db13f7849fd65f1e298384da6e6a6f8d72a1b5aa765","duration":45.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.628,"text":"Baba jọ gbọ temi,","marked":"Baba jọ gbọ́ tèmi"},{"start":2.078,"end":3.265,"text":"Mo wolẹ lẹsẹ Rẹ,","marked":"Mo wólẹ̀ lẹ́sẹ̀ Rẹ"},{"start":3.715,"end":5.577,"text":"'Wọ to n wosan to n dariji,","marked":"'Wọ tó ń wòsàn tó ń dáríjì"},{"start":6.027,"end":7.296,"text":"Jọwọ gbadura wa.","marked":"Jọ̀wọ́ gbàdúrà wa."}],"end":7.296},{"key":"2","start":8.246,"lines":[{"start":8.246,"end":9.303,"text":"Ọlọrun Oluwa,","marked":"Ọlọ́run Olúwa"},{"start":9.753,"end":10.757,"text":"Jehofa Ọba mi,","marked":"Jèhófà Ọba mi"},{"start":11.207,"end":12.7,"text":"'Wọ to tẹdo sinu 'mọle,","marked":"'Wọ tó tẹ̀dó sínú 'mọle"},{"start":13.15,"end":14.554,"text":"A juba O'okọ Rẹ.","marked":"A júbà O'òkọ̀ Rẹ̀."}],"end":14.554},{"key":"3","start":15.504,"lines":[{"start":15.504,"end":16.765,"text":"Tani Ọba ti ayé?","marked":"Tani Ọba ti ayé?"},{"start":17.215,"end":18.757,"text":"Jesu Emmanuel,","marked":"Jésù Emmanuel"},{"start":19.207,"end":20.738,"text":"Gbongbo Jesse Ẹni 'Yanu","marked":"Gbòǹgbò Jesse Ẹni yanu"},{"start":21.188,"end":22.254,"text":"Ran 'ranwọ Rẹ si mi","marked":"Rán 'ranwọ Rẹ sí mi"}],"end":22.254},{"key":"4","start":23.204,"lines":[{"start":23.204,"end":24.428,"text":"Mimo Mimo julo","marked":"Mímọ́ Mímọ́ jùlọ"},{"start":24.878,"end":25.766,"text":"Oba Olugbala","marked":"Ọba Olùgbàlà"},{"start":26.216,"end":27.742,"text":"Alagbara ninu orun","marked":"Alágbára nínú ọ̀run"},{"start":28.192,"end":29.407,"text":"Ranti majemu Re.","marked":"Rántí májẹ̀mú Rẹ."}],"end":29.407},{"key":"5","start":30.357,"lines":[{"start":30.357,"end":31.46,"text":"Lowuro gbo temi,","marked":"Lówúrọ̀ gbọ́ tèmi"},{"start":31.91,"end":33.009,"text":"Losan gbo ebe mi,","marked":"Lọ́sàn gbọ́ ẹ̀bẹ̀ mi"},{"start":33.459,"end":34.811,"text":"Loju ale gbat'orun wo","marked":"Lójú alẹ́ gbàt'ọ̀run wò"},{"start":35.261,"end":36.672,"text":"Jowo gbo ebe mi.","marked":"Jọ̀wọ́ gbọ́ ẹ̀bẹ̀ mi."}],"end":36.672},{"key":"6","start":37.622,"lines":[{"start":37.622,"end":38.721,"text":"Ogo fun Baba wa,","marked":"Ògo fún Baba wa"},{"start":39.171,"end":40.163,"text":"Ogo fun Ọmọ Rẹ,","marked":"Ògo fún Ọmọ Rẹ"},{"start":40.613,"end":41.643,"text":"Ogo fun Ẹmi Mimọ,","marked":"Ògo fún Ẹ̀mí Mímọ́"},{"start":42.093,"end":43.484,"text":"Mẹtalọkan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":43.484}]}