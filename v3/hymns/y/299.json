{"v":3,"coll":"y","num":299,"id":"hymn_299","title":"GBATI mo ri agbelebu","duration":37.229,"voices":{"male":{"file":"y-299-male-v3.m4a","bytes":263067,"sha256":"523bdd55ac37379d2d47e51804670876cda6a20a42db33bd9d6f3ba5cf43cba7","duration":37.3},"female":{"file":"y-299-female-v3.m4a","bytes":269547,"sha256":"94fd5ffe8110e6afd5e4b44bcf741fe61962b99799f993fb6ef1733e82e44436","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.972,"text":"GBATI mo ri agbelebu","marked":"Gbátí mo rí àgbélébùú"},{"start":2.422,"end":4.041,"text":"Ti a kan Oba ogo mo","marked":"Tí a kan Ọba ògo mọ́"},{"start":4.491,"end":6.042,"text":"Mo ka gbogbo oro s'ofo","marked":"Mo ka gbogbo ọ̀rọ̀ s'ọ̀fọ̀"},{"start":6.492,"end":8.151,"text":"Mo kegan gbogbo ogo mi.","marked":"Mo kẹ́gàn gbogbo ògo mi."}],"end":8.151},{"key":"2","start":9.101,"lines":[{"start":9.101,"end":11.592,"text":"K'a ma se gbọ pe, mo n halẹ,","marked":"K'á má ṣe gbọ́ pé, mò ń halẹ̀"},{"start":12.042,"end":13.523,"text":"B'o yẹ n'iku Oluwa mi;","marked":"B'ó yẹ n'ikú Olúwa mi"},{"start":13.973,"end":15.888,"text":"Gbogbo nkan asan ti mo fẹ,","marked":"Gbogbo nǹkan asán tí mo fẹ́"},{"start":16.338,"end":18.03,"text":"Ma da silẹ fun ẹjẹ Rẹ.","marked":"Má dá sílẹ̀ fún ẹ̀jẹ̀ Rẹ."}],"end":18.03},{"key":"3","start":18.98,"lines":[{"start":18.98,"end":20.783,"text":"p Wo lat'ori, ọwọ, ẹsẹ;","marked":"p Wò lát'orí, ọwọ́, ẹsẹ̀"},{"start":21.233,"end":22.933,"text":"B'ikanu at'ifẹ ti n san;","marked":"B'ìkanu àt'ìfẹ́ tí ń sàn"},{"start":23.383,"end":24.896,"text":"'Banujẹ at'ifẹ papọ,","marked":"'Banujẹ àt'ìfẹ́ papọ̀"},{"start":25.346,"end":27.309,"text":"A f'ẹgun se ade Ogo.","marked":"A f'ẹ̀gún ṣe adé Ògo."}],"end":27.309},{"key":"4","start":28.259,"lines":[{"start":28.259,"end":29.727,"text":"mf Gbogbo ayé ba jẹ t'emi,","marked":"mf Gbogbo ayé bá jẹ́ t'èmi"},{"start":30.177,"end":31.387,"text":"Ẹbun abẹrẹ ni fun mi;","marked":"Ẹ̀bùn abẹ́rẹ́ ni fún mi"},{"start":31.837,"end":33.654,"text":"Ifẹ nla ti n yanilẹnu,","marked":"Ìfẹ́ ńlá tí ń yanilẹ́nu"},{"start":34.104,"end":35.679,"text":"Gba gbogbo ọkan, ẹmi mi.","marked":"Gba gbogbo ọkàn, ẹ̀mí mi."}],"end":35.679}]}