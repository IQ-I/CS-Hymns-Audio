{"v":3,"coll":"y","num":196,"id":"hymn_196","title":"OKAN wa kun f'ayo loni","duration":90.523,"voices":{"male":{"file":"y-196-male-v3.m4a","bytes":655687,"sha256":"479b91ae754dfd65a98f8624010e6b258fe2a1f028daf3ff6f0736efbe0569be","duration":90.6},"female":{"file":"y-196-female-v3.m4a","bytes":672796,"sha256":"88478b70ab4b7168db3a175c7036e17b52e048102087794ec5cfa443058c6f2b","duration":90.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.748,"text":"OKAN wa kun f'ayo loni","marked":"Ọkàn wa kún f'ayọ̀ lónì"},{"start":2.198,"end":3.486,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":3.936,"end":5.472,"text":"Imole re nta l'ona wa","marked":"Ìmọ́lẹ̀ rẹ̀ ńta l'ọ̀nà wa"},{"start":5.922,"end":7.169,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":7.619,"end":9.247,"text":"O ti pe t'ayun Re nyun wa","marked":"Ó ti pẹ́ t'ayún Rẹ̀ nyún wá"},{"start":9.697,"end":11.449,"text":"Larin ayidayid' aye","marked":"Lárin àyídáyíd ayé"},{"start":11.899,"end":13.734,"text":"Die lo ku fun wa k'o bo","marked":"Díẹ̀ ló kú fún wa k'ó bọ̀"},{"start":14.184,"end":15.492,"text":"K'a to r'ona wura na.","marked":"K'á tó r'ọ̀nà wúrà ná."}],"end":15.492},{"key":"CHORUS","start":16.442,"lines":[{"start":16.442,"end":18.072,"text":"Egbe: Nje korin, korin ayo","marked":"Ǹjẹ́ kọrin, kọrin ayọ̀"},{"start":18.522,"end":20.006,"text":"F'okan ayo korin soke","marked":"F'ọkàn ayọ̀ kọrin sókè"},{"start":20.456,"end":22.614,"text":"Imole de, a de 'ile wa","marked":"Ìmọ́lẹ̀ dé, a dé ilé wa"},{"start":23.064,"end":24.257,"text":"Ati r'ona wura na.","marked":"Àti r'ọ̀nà wúrà ná."}],"end":24.257},{"key":"2","start":25.207,"lines":[{"start":25.207,"end":26.834,"text":"A pe wa kuro l'aye yi","marked":"A pè wá kúrò l'ayé yí"},{"start":27.284,"end":28.595,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":29.045,"end":30.624,"text":"Ore wa gbogbo wa nibe","marked":"Ọ̀rẹ́ wa gbogbo wa níbẹ̀"},{"start":31.074,"end":32.309,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":32.759,"end":34.176,"text":"Awa jeri pe didun na","marked":"Àwa jẹ́rí pé dídùn ná"},{"start":34.626,"end":36.071,"text":"K'a ma tase ijoba orun","marked":"K'á má tàsé ìjọba ọ̀run"},{"start":36.521,"end":38.422,"text":"Pelu Jesu a nlo 'le wa","marked":"Pẹ̀lú Jésù à ńlọ lè wá"},{"start":38.872,"end":40.26,"text":"A ti r'ona wura na.","marked":"A ti r'ọ̀nà wúrà ná."}],"end":40.26},{"key":"3","start":41.21,"lines":[{"start":41.21,"end":43.216,"text":"Kiun ni 'danwo wa t'o koja","marked":"Kíún ni dánwò wa t'ó kọjá"},{"start":43.666,"end":44.875,"text":"A ti t'ona wura na","marked":"A ti t'ọ̀nà wúrà ná"},{"start":45.325,"end":46.739,"text":"Ayo ile mu k'a gbagbe","marked":"Ayọ̀ ilé mú k'á gbàgbé"},{"start":47.189,"end":48.4,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":48.85,"end":50.376,"text":"'Ji kuku ko ni pe kuro","marked":"jí kúkú kò ní pè kúrò"},{"start":50.826,"end":52.633,"text":"lfayabale yoo si de","marked":"Ìfàyàbalẹ̀ yóò sì dé"},{"start":53.083,"end":56.103,"text":"A ta 'gbokun, oko si gun le","marked":"A ta gbòkún, oko sì gùn lé"},{"start":56.553,"end":57.991,"text":"A ti r'ona wura na.","marked":"A ti r'ọ̀nà wúrà ná."}],"end":57.991},{"key":"4","start":58.941,"lines":[{"start":58.941,"end":60.209,"text":"Pel'okan 'es'Olorun wa","marked":"Pẹ̀l'ọkàn ẹs'ọlọ́run wa"},{"start":60.659,"end":61.924,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":62.374,"end":64.104,"text":"Lekan ri ti a ti sonu","marked":"Lẹ́kàn rí tí a ti sọnù"},{"start":64.554,"end":65.744,"text":"A ti r'ona wura na","marked":"A ti r'ọ̀nà wúrà ná"},{"start":66.194,"end":67.547,"text":"A fe d'odo Olugbala","marked":"A fẹ́ d'ọ̀dọ̀ Olùgbàlà"},{"start":67.997,"end":69.724,"text":"Jesu yoo f'ayo gba wa","marked":"Jésù yóò f'ayọ̀ gbà wá"},{"start":70.174,"end":71.576,"text":"O je nipa or'ofe nikan","marked":"Ó jẹ́ nípa ọr'ọ̀fẹ́ nìkan"},{"start":72.026,"end":73.431,"text":"A ti r'ona wura na.","marked":"A ti r'ọ̀nà wúrà ná."}],"end":73.431},{"key":"5","start":74.381,"lines":[{"start":74.381,"end":75.625,"text":"A dupe low'Olorun wa","marked":"A dúpẹ́ lọ́w'ọlọ́run wa"},{"start":76.075,"end":77.442,"text":"Ti p'a r'ona wura na","marked":"Ti p'á r'ọ̀nà wúrà ná"},{"start":77.892,"end":79.442,"text":"Iyin, ogo ope, ola","marked":"Ìyìn, ògo ọpẹ́, ọlá"},{"start":79.892,"end":81.52,"text":"Fun Baba ati Omo","marked":"Fún Baba àti Ọmọ"},{"start":81.97,"end":83.249,"text":"Ati pelu Emi Mimo","marked":"Àti pẹ̀lú Ẹ̀mí Mímọ́"},{"start":83.699,"end":85.324,"text":"Metalokan ayeraye","marked":"Mẹ́talọ́kan ayérayé"},{"start":85.774,"end":87.12,"text":"Titi aye lao ma yin","marked":"Títí ayé láò má yín"},{"start":87.57,"end":88.974,"text":"Pe a r'ona wura na.","marked":"Pé a r'ọ̀nà wúrà ná."}],"end":88.974}]}