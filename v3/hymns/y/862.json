{"v":3,"coll":"y","num":862,"id":"hymn_862","title":"OLUS'AGUNTAN, toju wa","duration":49.642,"voices":{"male":{"file":"y-862-male-v3.m4a","bytes":347547,"sha256":"85bf367b05cb0b342d655f2a5784259a1d0d67086b9f033f83c777a118442b28","duration":49.7},"female":{"file":"y-862-female-v3.m4a","bytes":356716,"sha256":"17a899245e05b9fccff07d639b6ff754c2d4fbdca128ff07fbf18171f0b8007e","duration":49.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.353,"text":"OLUS'AGUNTAN, tọju wa,","marked":"Olùṣ'àgùntàn, tọ́jú wa"},{"start":2.803,"end":3.956,"text":"Ni ọjọ ibi yi,","marked":"Ní ọjọ́ ibi yí"},{"start":4.406,"end":5.611,"text":"Fun gbogbo ọmọ-ẹhin Rẹ,","marked":"Fún gbogbo ọmọ-ẹhin Rẹ"},{"start":6.061,"end":7.517,"text":"N'ipa lati sọna.","marked":"N'ipa láti sọ́nà."}],"end":7.517},{"key":"2","start":8.467,"lines":[{"start":8.467,"end":9.823,"text":"B'igba idanwo wa ba pe,","marked":"B'ígbà ìdánwò wa bá pé"},{"start":10.273,"end":11.605,"text":"T'ipọnju pọ fun wa,","marked":"T'ìpọ́njú pọ̀ fún wa"},{"start":12.055,"end":13.655,"text":"Jẹ k'ẹmi wa sinmi le Ọ,","marked":"Jẹ́ k'ẹ̀mí wá sinmi lé Ọ"},{"start":14.105,"end":15.367,"text":"L'adura aisinmi.","marked":"L'àdúrà àìsinmi."}],"end":15.367},{"key":"3","start":16.317,"lines":[{"start":16.317,"end":17.555,"text":"F'ore-ọfẹ emi ẹbẹ,","marked":"F'ore-ọfẹ ẹ̀mí ẹ̀bẹ̀"},{"start":18.005,"end":19.345,"text":"Fun wa nipa 'gbagbọ;","marked":"Fún wa nípa 'gbagbọ"},{"start":19.795,"end":22.145,"text":"K'a du titi a o r'oju Rẹ,","marked":"K'á dù títí a ó r'ojú Rẹ"},{"start":22.595,"end":23.774,"text":"T'a o si mọ okọ Rẹ.","marked":"T'a ó sì mọ okọ Rẹ̀."}],"end":23.774},{"key":"4","start":24.724,"lines":[{"start":24.724,"end":26.054,"text":"Titi O fun wa l'ara Rẹ,","marked":"Títí Ó fún wa l'ara Rẹ̀"},{"start":26.504,"end":27.609,"text":"Ati ifẹ pipe,","marked":"Àti ìfẹ́ pípẹ́"},{"start":28.059,"end":29.358,"text":"K'eyi jẹ igbe gbogbo wa,","marked":"K'èyí jẹ́ igbe gbogbo wa"},{"start":29.808,"end":31.2,"text":"N ki o jẹ ki O lọ.","marked":"N kí ó jẹ́ kí Ó lọ."}],"end":31.2},{"key":"5","start":32.15,"lines":[{"start":32.15,"end":34.495,"text":"O ki o lọ, bi ko se pe,","marked":"Ó kí ó lọ, bí kò ṣe pé"},{"start":34.945,"end":36.075,"text":"O s'okọ Rẹ fun mi,","marked":"Ó s'okọ Rẹ̀ fún mi"},{"start":36.525,"end":37.897,"text":"K'O f'igbala Rẹ bukun mi,","marked":"K'Ó f'ìgbàlà Rẹ̀ bùkún mi"},{"start":38.347,"end":39.831,"text":"Si jẹ ki n dabi Rẹ.","marked":"Sì jẹ́ kí n dàbí Rẹ̀."}],"end":39.831},{"key":"6","start":40.781,"lines":[{"start":40.781,"end":42.264,"text":"Jẹ ki n r'oju Rẹ kedere,","marked":"Jẹ́ kí n r'ojú Rẹ̀ kedere"},{"start":42.714,"end":44.09,"text":"'Gba m'ba d'ori-oke,","marked":"gbà m'bá d'ori-oke"},{"start":44.54,"end":46.433,"text":"Nibi t'a r'ohun t'a gbagbọ,","marked":"Níbi t'á r'ohun t'á gbàgbọ́"},{"start":46.883,"end":48.093,"text":"T'adura di iyin.","marked":"T'àdúrà di ìyìn."}],"end":48.093}]}