{"v":3,"coll":"y","num":200,"id":"hymn_200","title":"Eyin Angel' l'orun ogo","duration":45.811,"voices":{"male":{"file":"y-200-male-v3.m4a","bytes":315732,"sha256":"f11c69338960fdf26a95bbee096ac74a82b374beb98863936d8b474731074213","duration":45.9},"female":{"file":"y-200-female-v3.m4a","bytes":327974,"sha256":"0dab3bd4331c6e6cc57ad8db78c9bb58ce49e8ffd21e0e611f70f75c1f542e69","duration":45.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.817,"text":"Ẹyin Angel' l'orun ogo,","marked":"Ẹ̀yin Angẹl l'ọ̀run ògo"},{"start":2.267,"end":3.56,"text":"To yi gbogbo ayé ka;","marked":"Tó yí gbogbo ayé ká"},{"start":4.01,"end":5.436,"text":"E ti korin dida ayé,","marked":"Ẹ ti kọrin dídá ayé"},{"start":5.886,"end":7.261,"text":"E so t'ibi Messia. Ẹ wa jọsin, ẹ wa jọsin, Fun Kristi Ọba titun.","marked":"Ẹ sọ t'ibi Messia. Ẹ wá jọ́sìn, ẹ wá jọ́sìn, Fún Kristi Ọba titun."}],"end":7.261},{"key":"CHORUS","start":8.211,"lines":[{"start":8.211,"end":10.403,"text":"Egbe: E wa josin, e wa josin,","marked":"Ẹ wá jọ́sìn, ẹ wá jọ́sìn"},{"start":10.853,"end":12.365,"text":"Fun Kristi Oba titun.","marked":"Fún Kristi Ọba titun."}],"end":12.365},{"key":"2","start":13.315,"lines":[{"start":13.315,"end":14.571,"text":"Ẹyin Olusọ-aguntan,","marked":"Ẹ̀yin Olusọ-aguntan"},{"start":15.021,"end":16.606,"text":"Ti ń sọ ẹran yin loru","marked":"Tí ń sọ ẹran yín lóru"},{"start":17.056,"end":18.393,"text":"Emmanueli wa ti de,","marked":"Emmanueli wá ti dé"},{"start":18.843,"end":20.091,"text":"Irawọ ọmọ naa ń tan.","marked":"Ìràwọ̀ ọmọ náà ń tàn."}],"end":20.091},{"key":"3","start":21.041,"lines":[{"start":21.041,"end":22.763,"text":"Onigbagbọ ti ń tẹriba,","marked":"Onígbàgbọ́ tí ń tẹríba"},{"start":23.213,"end":24.587,"text":"Ni 'bẹru at'ireti,","marked":"Ní 'bẹru àt'ìrètí"},{"start":25.037,"end":26.37,"text":"L'ojiji l'Oluwa o de,","marked":"L'òjìji l'Olúwa ó dé"},{"start":26.82,"end":27.964,"text":"Ti yoo mu yin re'le","marked":"Tí yóò mú yín rẹ̀'lẹ̀"}],"end":27.964},{"key":"4","start":28.914,"lines":[{"start":28.914,"end":30.072,"text":"Ẹlẹsẹ 'wọ alaironu,","marked":"Ẹlẹ́sẹ̀ 'wọ aláìrònú"},{"start":30.522,"end":32.033,"text":"Ẹlẹbi ati egbe,","marked":"Ẹlẹ́bi àti ẹgbẹ́"},{"start":32.483,"end":33.646,"text":"Ododo Ọlọrun duro,","marked":"Òdodo Ọlọ́run dúró"},{"start":34.096,"end":35.922,"text":"Anu ń pe ọ, pa 'wa da.","marked":"Àánú ń pè ọ́, pa wá dà."}],"end":35.922},{"key":"5","start":36.872,"lines":[{"start":36.872,"end":38.169,"text":"Gbogbo eda e fo f'ayo,","marked":"Gbogbo ẹ̀dá ẹ fò f'ayọ̀"},{"start":38.619,"end":40.128,"text":"Jesu Olugbala de,","marked":"Jésù Olùgbàlà dé"},{"start":40.578,"end":42.31,"text":"Anfani miran ko si mo,","marked":"Àǹfàní míràn kò sì mọ́"},{"start":42.76,"end":44.262,"text":"B'eyi ba fo yin koja. Njẹ, ẹ wa sin, Njẹ ẹ wa sin, Sin Kristi Ọba Ogo.","marked":"B'èyí bá fọ́ yín kọjá. Ǹjẹ́, ẹ wá sìn, Ǹjẹ́ ẹ wá sìn, Sin Kristi Ọba Ògo."}],"end":44.262}]}