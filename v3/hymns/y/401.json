{"v":3,"coll":"y","num":401,"id":"hymn_401","title":"EMI Mimo, mi s'okan wa","duration":31.637,"voices":{"male":{"file":"y-401-male-v3.m4a","bytes":210798,"sha256":"c1dcc43348477a92f8927f964e173baed1927039bf7080f789cfaa8ff26a92b4","duration":31.7},"female":{"file":"y-401-female-v3.m4a","bytes":217026,"sha256":"32ec084119a50d6a1d64abe30b2326143727ddc4b0a69c35a714c4bd17b7ff82","duration":31.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.951,"text":"EMI Mimo, mi s'okan wa,","marked":"Ẹ̀mí Mímọ́, mi s'ọkàn wá"},{"start":2.401,"end":3.454,"text":"K'a mo agbara Re","marked":"K'á mọ agbára Rẹ"},{"start":3.904,"end":5.136,"text":"Orisun emi 'sotele","marked":"Orísun èmi sọtẹ́lẹ̀"},{"start":5.586,"end":6.875,"text":"T'imole at'ife.","marked":"T'ìmọ́lẹ̀ àt'ìfẹ́."}],"end":6.875},{"key":"2","start":7.825,"lines":[{"start":7.825,"end":9.644,"text":"Ẹmi Mimọ, l'agbara Rẹ,","marked":"Ẹ̀mí Mímọ́, l'agbára Rẹ"},{"start":10.094,"end":11.269,"text":"L'awọn woli sise;","marked":"L'àwọn wòlí ṣiṣẹ́"},{"start":11.719,"end":13.152,"text":"Iwọ l'o n fi otọ han wa,","marked":"Ìwọ l'ó ń fi òtọ̀ hàn wá"},{"start":13.602,"end":14.655,"text":"Ninu iwe mimọ.","marked":"Nínú ìwé mímọ́."}],"end":14.655},{"key":"3","start":15.605,"lines":[{"start":15.605,"end":18.159,"text":"Adaba ọrun, na 'yẹ Rẹ,","marked":"Àdàbà ọ̀run, na 'yẹ Rẹ"},{"start":18.609,"end":19.731,"text":"Bọ okun ẹda wa;","marked":"Bọ̀ okùn ẹ̀dá wá"},{"start":20.181,"end":21.498,"text":"Jẹ ki 'mọlẹ Rẹ tan sori,","marked":"Jẹ́ kí 'mọlẹ Rẹ̀ tàn sórí"},{"start":21.948,"end":23.029,"text":"Ẹmi aisotọ wa.","marked":"Ẹ̀mí àìsòtọ̀ wà."}],"end":23.029},{"key":"4","start":23.979,"lines":[{"start":23.979,"end":25.12,"text":"A o mo Ọlọrun daju,","marked":"A ó mọ Ọlọ́run dájú"},{"start":25.57,"end":26.755,"text":"B'Iwọ ba mbẹ n'nu wa,","marked":"B'Ìwọ bá mbẹ́ n'nù wá"},{"start":27.205,"end":28.528,"text":"A o mo 'jinlẹ ifẹ mimọ,","marked":"A ó mọ 'jinlẹ ìfẹ́ mímọ́"},{"start":28.978,"end":30.088,"text":"Pẹlu awọn Tirẹ.","marked":"Pẹ̀lú àwọn Tirẹ̀."}],"end":30.088}]}