{"v":3,"coll":"y","num":185,"id":"hymn_185","title":"ONIDAJO mbo wa","duration":31.054,"voices":{"male":{"file":"y-185-male-v3.m4a","bytes":209564,"sha256":"0ce494a48376a4d4ab4217fcd1110f08beeab0e21fd9a7d200056cd1b1a73139","duration":31.1},"female":{"file":"y-185-female-v3.m4a","bytes":219662,"sha256":"fd869464d76825c72c23d9865b1484923ed92f64f8c8e5e9f366b0ea706d0a0f","duration":31.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.303,"text":"ONIDAJỌ mbọ wa,","marked":"Onídàjọ́ ḿbọ̀ wá"},{"start":1.753,"end":3.042,"text":"Awọn oku jinde,","marked":"Àwọn òkú jíǹde"},{"start":3.492,"end":5.228,"text":"Ẹnikan ko le yọ kuro,","marked":"Ẹnìkan kò lè yọ̀ kúrò"},{"start":5.678,"end":7.149,"text":"'Nu imọlẹ oju Rẹ.","marked":"nù ìmọ́lẹ̀ ojú Rẹ."}],"end":7.149},{"key":"2","start":8.099,"lines":[{"start":8.099,"end":9.01,"text":"Ẹnu ododo Rẹ,","marked":"Ẹnu òdodo Rẹ"},{"start":9.46,"end":10.551,"text":"Yoo da ẹbi fun,","marked":"Yóò dá ẹ̀bi fún"},{"start":11.001,"end":12.325,"text":"Awọn t'o sọ anu Rẹ nu;","marked":"Àwọn t'ó sọ àánú Rẹ̀ nù"},{"start":12.775,"end":14.024,"text":"Ti wọn se buburu.","marked":"Tí wọ́n ṣe búburú."}],"end":14.024},{"key":"3","start":14.974,"lines":[{"start":14.974,"end":16.066,"text":"―Lọ kuro lọdọ mi,","marked":"―Lọ kúrò lọ́dọ̀ mi"},{"start":16.516,"end":18.009,"text":"S'ina ti ko l'opin,","marked":"S'iná tí kò l'òpin"},{"start":18.459,"end":19.984,"text":"Ti a ti pese fun Esu,","marked":"Tí a ti pèsè fún Èṣù"},{"start":20.434,"end":21.801,"text":"T'o ti ń sọtẹ si mi.","marked":"T'ó ti ń sọ̀tẹ̀ sí mi."}],"end":21.801},{"key":"4","start":22.751,"lines":[{"start":22.751,"end":23.83,"text":"Iwọ ti duro to!","marked":"Ìwọ ti dúró tó!"},{"start":24.28,"end":25.571,"text":"Ọjọ naa o mbọ wa","marked":"Ọjọ́ náà ò mbọ̀ wá"},{"start":26.021,"end":27.714,"text":"T'ayé at'ọrun o fo lọ,","marked":"T'ayé àt'ọ̀run ò fò lọ"},{"start":28.164,"end":29.504,"text":"Kuro ni wiwa Rẹ.","marked":"Kúrò ní wíwá Rẹ."}],"end":29.504}]}