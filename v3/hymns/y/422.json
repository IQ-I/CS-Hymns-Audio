{"v":3,"coll":"y","num":422,"id":"hymn_422","title":"TERUTERU t'iyanu ni","duration":31.617,"voices":{"male":{"file":"y-422-male-v3.m4a","bytes":216057,"sha256":"f2ea3106b5653959198de5663f616763db291a40c3c535b74a2d6974851ad4e2","duration":31.7},"female":{"file":"y-422-female-v3.m4a","bytes":218199,"sha256":"b6f8a9f01a78c07c7f1b37ed42c593d77365d572349db2daf95082958cf7f526","duration":31.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.915,"text":"TERUTERU t'iyanu ni","marked":"Tẹrùtẹrù t'ìyanu ni"},{"start":2.365,"end":3.403,"text":"Olorun mi da mi","marked":"Ọlọ́run mi dá mi"},{"start":3.853,"end":5.254,"text":"Gbogbo awon eya ara mi","marked":"Gbogbo àwọn ẹ̀yà ara mi"},{"start":5.704,"end":6.995,"text":"Ise iyanu ni.","marked":"Iṣẹ́ ìyanu ni."}],"end":6.995},{"key":"2","start":7.945,"lines":[{"start":7.945,"end":9.352,"text":"Nigba t'a da mi n'ikoko,","marked":"Nígbà t'á dá mi n'ìkọ̀kọ̀"},{"start":9.802,"end":10.945,"text":"O ti mọ ara mi;","marked":"Ó ti mọ ara mi"},{"start":11.395,"end":12.66,"text":"Ẹya ara mi l'O si mọ,","marked":"Ẹ̀yà ara mi l'Ó sì mọ̀"},{"start":13.11,"end":14.634,"text":"Sa t'ọkan wọn ko si.","marked":"Sá t'ọkàn wọn kò sí."}],"end":14.634},{"key":"3","start":15.584,"lines":[{"start":15.584,"end":17.163,"text":"Olorun, iro inu Re","marked":"Ọlọ́run, ìró inú Rẹ̀"},{"start":17.613,"end":18.706,"text":"Se 'yebiye fun mi","marked":"Ṣe yẹ̀bíyẹ́ fún mi"},{"start":19.156,"end":20.443,"text":"Iye won poju iyanrin","marked":"Iye wọn pọ̀jù iyanrìn"},{"start":20.893,"end":22.16,"text":"Ti ko seni le ka.","marked":"Tí kò sẹ́ni lè kà."}],"end":22.16},{"key":"4","start":23.11,"lines":[{"start":23.11,"end":24.572,"text":"B'o ti mo eda mi bayi","marked":"B'ó ti mọ ẹ̀dá mi báyì"},{"start":25.022,"end":26.348,"text":"Wadi okan temi","marked":"Wádì ọkàn tèmi"},{"start":26.798,"end":28.123,"text":"Mu mi mo ona Re lailai","marked":"Mú mi mọ ọ̀nà Rẹ̀ láéláé"},{"start":28.573,"end":30.068,"text":"Si ma to ese mi.","marked":"Sì má tọ ẹsẹ̀ mi."}],"end":30.068}]}