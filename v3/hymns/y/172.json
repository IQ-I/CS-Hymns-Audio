{"v":3,"coll":"y","num":172,"id":"hymn_172","title":"YIN Olorun, yin lailai","duration":61.628,"voices":{"male":{"file":"y-172-male-v3.m4a","bytes":427107,"sha256":"77f58a529ca3ae2a5777b694e3ae4fab7261b745647f404e6d7eef82e445c8d3","duration":61.7},"female":{"file":"y-172-female-v3.m4a","bytes":442874,"sha256":"25bf7722c81c22097f6c604594de90a8906afa7560c9e7991d806f5d4922ed64","duration":61.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.962,"text":"YIN Olorun, yin lailai","marked":"Yín Ọlọ́run, yín láéláé"},{"start":2.412,"end":3.582,"text":"Fun ife ojojumo","marked":"Fún ìfẹ́ ojojúmọ́"},{"start":4.032,"end":5.221,"text":"Orisun ayo gbogbo","marked":"Orísun ayọ̀ gbogbo"},{"start":5.671,"end":6.877,"text":"K'iyin Re gb'enu wa kan.","marked":"K'ìyìn Rẹ̀ gb'ẹnu wá kan."}],"end":6.877},{"key":"2","start":7.827,"lines":[{"start":7.827,"end":9.099,"text":"Fun ire t'oko ń mu wa,","marked":"Fún ìre t'oko ń mú wá"},{"start":9.549,"end":11.029,"text":"Fun Ounjẹ t'a ń mu l'ọgba;","marked":"Fún Oúnjẹ t'á ń mú l'ọgbà"},{"start":11.479,"end":12.871,"text":"Fun eso igi pẹlu,","marked":"Fún èso igi pẹ̀lú"},{"start":13.321,"end":14.543,"text":"At'ororo ti a ń lo.","marked":"Àt'òróró tí à ń lọ."}],"end":14.543},{"key":"3","start":15.493,"lines":[{"start":15.493,"end":16.705,"text":"Fun gbogb'ẹran ọsin wa,","marked":"Fún gbogb'ẹran ọ̀sìn wa"},{"start":17.155,"end":18.399,"text":"T'oun siri ọka gbogbo;","marked":"T'òun ṣírí ọkà gbogbo"},{"start":18.849,"end":20.057,"text":"Ọrun ti ń sẹ'ri silẹ,","marked":"Ọ̀run tí ń sẹ'rí sílẹ̀"},{"start":20.507,"end":21.734,"text":"Orun ti m'oru rẹ wa.","marked":"Ọ̀run tí m'òru rẹ̀ wà."}],"end":21.734},{"key":"4","start":22.684,"lines":[{"start":22.684,"end":23.979,"text":"Gbogbo nkan t'ẹrun ń mu wa,","marked":"Gbogbo nǹkan t'ẹ̀rùn ń mú wá"},{"start":24.429,"end":25.675,"text":"Kakiri gbogbo ilẹ,","marked":"Kákiri gbogbo ilẹ̀"},{"start":26.125,"end":27.732,"text":"At'eso igba ojo,","marked":"Àt'èso ìgbà ọjọ́"},{"start":28.182,"end":29.432,"text":"Lat' inu ẹkun rẹ wa.","marked":"Lát inú ẹkún rẹ̀ wá."}],"end":29.432},{"key":"5","start":30.382,"lines":[{"start":30.382,"end":31.83,"text":"'Wo l'ẹlẹbun gbogbo wọn,","marked":"wò l'ẹlẹ́bùn gbogbo wọn"},{"start":32.28,"end":33.366,"text":"Orisun ibukun wa;","marked":"Orísun ìbùkún wà"},{"start":33.816,"end":35.135,"text":"'Tori naa ọkan wa y'o,","marked":"torí náà ọkàn wa y'ọ̀"},{"start":35.585,"end":37.113,"text":"F'iyin at'ọpẹ fun Ọ.","marked":"F'ìyìn àt'ọpẹ́ fún Ọ."}],"end":37.113},{"key":"6","start":38.063,"lines":[{"start":38.063,"end":39.419,"text":"mp Iji lile iba ja,","marked":"mp Ìjì líle ìbá jà"},{"start":39.869,"end":41.061,"text":"Ko ba gbogbo ọka jẹ;","marked":"Kò bá gbogbo ọkà jẹ́"},{"start":41.511,"end":42.874,"text":"K'eso igi wọ danu,","marked":"K'èso igi wọ̀ dànù"},{"start":43.324,"end":44.9,"text":"Ki akoko rẹ to pe.","marked":"Kí àkókò rẹ tó pé."}],"end":44.9},{"key":"7","start":45.85,"lines":[{"start":45.85,"end":47.158,"text":"Ajara 'ba ma so mo","marked":"Àjàrà bá má sọ mọ́"},{"start":47.608,"end":48.705,"text":"Ki igi gbogbo si gbe","marked":"Kí igi gbogbo sì gbé"},{"start":49.155,"end":50.506,"text":"K'eran osin gbogbo ku","marked":"K'ẹran ọ̀sìn gbogbo kú"},{"start":50.956,"end":52.415,"text":"K'eran igbe tan pelu.","marked":"K'ẹran igbe tán pẹ̀lú."}],"end":52.415},{"key":"8","start":53.365,"lines":[{"start":53.365,"end":54.824,"text":"Sibẹ, iwọ l'ọkan wa,","marked":"Síbẹ̀, ìwọ l'ọkàn wa"},{"start":55.274,"end":56.519,"text":"Y'o f'iyin af'ọpẹ fun;","marked":"Y'ó f'ìyìn àf'ọpẹ́ fún"},{"start":56.969,"end":58.137,"text":"Gbat' ibukun gbogbo tan,","marked":"Gbàt ìbùkún gbogbo tán"},{"start":58.587,"end":60.079,"text":"A o sa fẹ Ọ fun'ra Rẹ.","marked":"A ó sá fẹ́ Ọ fún'ra Rẹ̀."}],"end":60.079}]}