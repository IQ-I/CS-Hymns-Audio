{"v":3,"coll":"y","num":766,"id":"hymn_766","title":"A O DURO niwaj' Oba","duration":46.901,"voices":{"male":{"file":"y-766-male.m4a","bytes":336479,"sha256":"e5997af219c5c527c502304f9f3752c48e19f09e37cf760da5b2b43e25a3f3c0","duration":47.0},"female":{"file":"y-766-female.m4a","bytes":348910,"sha256":"a2f2ab565ea55aac4a7dfa3008c591fb3eb452e8e2fbe260ef666a306986df7e","duration":47.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.712,"text":"Ao duro niwaj' Oba","marked":"Aó dúró niwaj' Ọba"},{"start":2.092,"end":3.378,"text":"Ao b'awon Angeli korin","marked":"Àò b'àwọn Áńgẹ́lì kọrin"},{"start":3.758,"end":5.05,"text":"Nigbose, nigbose,","marked":"Nígbóṣe, nígbóṣe"},{"start":5.43,"end":6.775,"text":"Ao ma yan l'ebute na,","marked":"Àó ma yan l'èbúté ná"},{"start":7.155,"end":9.018,"text":"Ao si ma yin titi lai","marked":"Àó sì má yín títí láí"},{"start":9.398,"end":10.852,"text":"Nigbose, nigbose.","marked":"Nígbóṣe, nígbóṣe."}],"end":10.852},{"key":"CHORUS","start":11.802,"lines":[{"start":11.802,"end":13.088,"text":"Egbe: Ao duro niwaj'Oba","marked":"Aó dúró níwáj'Ọba"},{"start":13.468,"end":14.978,"text":"Ao b'awon Angel'korin","marked":"Aó b'àwọn Angel'kọrin"},{"start":15.358,"end":16.758,"text":"Ogo, Ogo, s'Oba wa,","marked":"Ògo, Ògo, s'Ọba wa"},{"start":17.138,"end":19.157,"text":"Halleluya, Halleluya,","marked":"Hallelúyà, Hallelúyà"},{"start":19.537,"end":20.813,"text":"Ao duro niwaj'Oba.","marked":"Aó dúró niwaj'Ọba."}],"end":20.813},{"key":"2","start":21.763,"lines":[{"start":21.763,"end":23.675,"text":"Agogo orun! e lu","marked":"Agogo ọ̀run! ẹ lù"},{"start":24.055,"end":25.631,"text":"Ao duro niwaj' Oba","marked":"Aó dúró niwaj' Ọba"},{"start":26.011,"end":27.406,"text":"Nigbose, Nigbose,","marked":"Nígbóṣe, Nígbóṣe"},{"start":27.786,"end":29.161,"text":"Banuje y'o tan nibe","marked":"Banújẹ́ y'ó tán níbẹ̀"},{"start":29.541,"end":30.794,"text":"Ao si mayo l'Oko Re...","marked":"Àó sì máyọ̀ l'Ọkọ Rẹ"},{"start":31.174,"end":32.465,"text":"Nigbose, Nigbose.","marked":"Nígbóṣe, Nígbóṣe."}],"end":32.465},{"key":"3","start":33.415,"lines":[{"start":33.415,"end":34.876,"text":"Nde! okan m'ore wa,","marked":"Ńde! ọkàn ḿ'ọ̀rẹ́ wa"},{"start":35.256,"end":37.439,"text":"'Wo o duro niwaj' Oba","marked":"'Wò ó dúró niwaj' Ọba"},{"start":37.819,"end":39.441,"text":"Nigbose, Nigbose,","marked":"Nígbóṣe, Nígbóṣe"},{"start":39.821,"end":41.82,"text":"'Da' kogun re s'ese Re,","marked":"'Dá' kógun rẹ̀ s'ẹsẹ̀ Rẹ"},{"start":42.2,"end":43.685,"text":"Si gba pipe ewa Re","marked":"Sì gba pípe ẹwà Rẹ"},{"start":44.065,"end":45.351,"text":"Nigbose, Nigbose.","marked":"Nígbóṣe, Nígbóṣe."}],"end":45.351}]}