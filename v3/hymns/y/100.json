{"v":3,"coll":"y","num":100,"id":"hymn_100","title":"EMI Baba Alaye","duration":53.825,"voices":{"male":{"file":"y-100-male-v3.m4a","bytes":378777,"sha256":"e2c4888ad8487b38737e34f8381f6704dc820222fd5d2f873f374fb7cf9bd448","duration":53.9},"female":{"file":"y-100-female-v3.m4a","bytes":390656,"sha256":"ab781f2f2def3cc2b5a7e3b27c36f74c87e02ce1eb9166e8fdfea03671f76f43","duration":53.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.514,"text":"EMI Baba Alaye","marked":"Ẹ̀mí Baba Àlàyé"},{"start":1.964,"end":3.06,"text":"Sokale pelu","marked":"Sọ̀kalẹ̀ pẹ̀lú"},{"start":3.51,"end":4.99,"text":"Agbara Pentikosti","marked":"Agbára Pentikosti"},{"start":5.44,"end":6.446,"text":"So okan wa ji","marked":"Sọ ọkàn wa jí"},{"start":6.896,"end":8.038,"text":"Ki O si mu gbona","marked":"Kí Ó sì mú gbóná"},{"start":8.488,"end":9.652,"text":"B'ina orun nla","marked":"B'iná ọ̀run ńlá"},{"start":10.102,"end":11.169,"text":"Pelu 'tunu nla","marked":"Pẹ̀lú tùnú ńlá"},{"start":11.619,"end":12.434,"text":"Tan 'mole re.","marked":"Tàn mọ́lẹ̀ rẹ."}],"end":12.434},{"key":"2","start":13.384,"lines":[{"start":13.384,"end":14.839,"text":"Aye ati emi wa","marked":"Ayé àti èmi wà"},{"start":15.289,"end":16.391,"text":"Gba, fi se Tire","marked":"Gbà, fi ṣe Tìrẹ"},{"start":16.841,"end":18.128,"text":"Ninu isin wa fun O","marked":"Nínú ìsìn wa fún Ọ"},{"start":18.578,"end":19.475,"text":"Ka ni 'ranwo Re","marked":"Ká ní rànwọ́ Rẹ"},{"start":19.925,"end":21.252,"text":"Lati j'olotito","marked":"Láti j'olótítọ́"},{"start":21.702,"end":22.714,"text":"K'ebun at'orun","marked":"K'ẹ̀bùn àt'ọ̀run"},{"start":23.164,"end":24.348,"text":"Ti Pentikosti","marked":"Ti Pentikosti"},{"start":24.798,"end":25.926,"text":"Ba s'ori wa.","marked":"Bá s'orí wa."}],"end":25.926},{"key":"3","start":26.876,"lines":[{"start":26.876,"end":28.185,"text":"Fi eje 'yebiye Re","marked":"Fi ẹ̀jẹ̀ yẹbíye Rẹ"},{"start":28.635,"end":29.55,"text":"T'oke Kalfari","marked":"T'òkè Kalfárì"},{"start":30.0,"end":31.427,"text":"We okan ese wa nu","marked":"Wẹ ọkàn ẹ̀ṣẹ̀ wa nù"},{"start":31.877,"end":32.879,"text":"Si ra wa pada","marked":"Sì rà wá padà"},{"start":33.329,"end":34.628,"text":"Fi 'fe kun aya wa","marked":"Fi fẹ́ kún aya wa"},{"start":35.078,"end":36.013,"text":"Ka rin 'na oto","marked":"Ká rìn ná ọ̀tọ̀"},{"start":36.463,"end":37.493,"text":"lfe Re lao se","marked":"Ìfẹ́ Rẹ̀ láò ṣe"},{"start":37.943,"end":38.947,"text":"Bi ti orun.","marked":"Bí ti ọ̀run."}],"end":38.947},{"key":"4","start":39.897,"lines":[{"start":39.897,"end":41.559,"text":"Baba, Omo on Emi","marked":"Baba, Ọmọ ọn Ẹ̀mí"},{"start":42.009,"end":43.013,"text":"Metalokan lae","marked":"Mẹ́talọ́kan láé"},{"start":43.463,"end":45.233,"text":"lyin, Ogo, agbara","marked":"Ìyìn, Ògo, agbára"},{"start":45.683,"end":46.805,"text":"Je Tire nikan","marked":"Jẹ́ Tire nìkan"},{"start":47.255,"end":48.283,"text":"Ewa Re l'aye yi","marked":"Ẹwà Rẹ l'ayé yí"},{"start":48.733,"end":49.819,"text":"Yo je ayo wa","marked":"Yó jẹ́ ayọ̀ wa"},{"start":50.269,"end":51.104,"text":"Pelu idupe","marked":"Pẹ̀lú ìdúpẹ́"},{"start":51.554,"end":52.276,"text":"Aleluya!","marked":"Alelúyà!"}],"end":52.276}]}