{"v":3,"coll":"y","num":323,"id":"hymn_323","title":"KABO, ojo rere","duration":80.678,"voices":{"male":{"file":"y-323-male.m4a","bytes":605554,"sha256":"7d9d8ad6d1a7180843f07114f4133d0f5312dc3820004720f2779057c41efce7","duration":80.7},"female":{"file":"y-323-female.m4a","bytes":621023,"sha256":"90517ae978ad0ce4759c73d69c6e8da510e2a3f928cbb91cbeda5e23d9901f69","duration":80.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.382,"text":"KABO, ojo rere,\"l'ao ma wi titi","marked":"Kábó, ọjọ́ rere,l'áo má wí títí"},{"start":3.762,"end":4.754,"text":"A sete 'ku loni,","marked":"A ṣètè 'kú lónì"},{"start":5.134,"end":6.369,"text":"orun di tiwa","marked":"ọ̀run di tiwa"},{"start":6.749,"end":7.915,"text":"'Wo Oku d'alaye,","marked":"'Wo Òkú d'àlàyé"},{"start":8.295,"end":9.581,"text":"Oba tit' aiye!","marked":"Ọba tít' aiye!"},{"start":9.961,"end":11.138,"text":"Gbogb'eda Re Jesu,","marked":"Gbogb'eda Rẹ Jésù"},{"start":11.518,"end":12.76,"text":"ni nwon njuba Re.","marked":"ní nwọn njuba Rẹ."},{"start":13.14,"end":14.555,"text":"Egbe:  Kabo, ojo rere,","marked":"Kábọ̀, ọjọ́ rere"},{"start":14.935,"end":16.21,"text":"l'ao ma wi titi","marked":"l'áo má wí títí"},{"start":16.59,"end":17.582,"text":"A sete ku loni,","marked":"A ṣètè kú lónì"},{"start":17.962,"end":19.054,"text":"orun di ti wa.","marked":"ọ̀run di ti wa."}],"end":19.054},{"key":"CHORUS","start":20.004,"lines":[{"start":20.004,"end":23.152,"text":"Kabo, ojo rere, l'ao ma wi titi","marked":"Kábó, ọjọ́ rere, l'áo má wí títí"},{"start":23.532,"end":26.449,"text":"A sete ku loni, orun di ti wa.","marked":"A ṣètè kú lónì, ọ̀run di ti wa."}],"end":26.449},{"key":"2","start":27.399,"lines":[{"start":27.399,"end":29.729,"text":"Eleda, Oluwa, Emi alaye","marked":"Ẹlẹ́dàá, Olúwa, Ẹ̀mí àlàyé"},{"start":30.109,"end":31.581,"text":"Lat'orun l'oti bojuwo","marked":"Lát'ọ̀run l'ótì bojúwò"},{"start":31.961,"end":32.742,"text":"sina wa","marked":"síná wa"},{"start":33.122,"end":34.439,"text":"Om'Olorun papa ni Wo","marked":"Om'Ọlọ́run pápá ni Wọ́"},{"start":34.819,"end":35.58,"text":"tile se","marked":"tilẹ̀ ṣe"},{"start":35.96,"end":37.327,"text":"K' O ba le gba wa la,","marked":"K' Ó bá lè gbà wá là"},{"start":37.707,"end":38.637,"text":"O di enia.","marked":"Ó di enia."},{"start":39.017,"end":40.303,"text":"Egbe:  Kabo, ojo rere...","marked":"Kábọ̀, ọjọ́ rere"}],"end":40.303},{"key":"3","start":41.253,"lines":[{"start":41.253,"end":42.991,"text":"'Wo Oluwa iye, O wa to","marked":"'Wo Olúwa ìyè, Ó wá tó"},{"start":43.371,"end":43.873,"text":"'ku wo","marked":"'kù wo"},{"start":44.253,"end":46.217,"text":"Lati f'ipa Re han, O sun","marked":"Láti f'ipá Rẹ hàn, Ó sùn"},{"start":46.597,"end":47.328,"text":"n'iboji","marked":"n'íbòji"},{"start":47.708,"end":50.596,"text":"Wa, Eni Oloto, si m'oro","marked":"Wà, Ẹni Ọlọ́tọ̀, sì ḿ'ọrọ̀"},{"start":50.976,"end":51.636,"text":"Re se","marked":"Rẹ̀ ṣẹ̀"},{"start":52.016,"end":54.565,"text":"Ojo keta Re de, jinde","marked":"Ọjọ́ kẹta Rẹ dé, jíǹde"},{"start":54.945,"end":55.658,"text":"Oluwa!","marked":"Olúwa!"},{"start":56.038,"end":57.864,"text":"Egbe:  Kabo, ojo rere...","marked":"Kábọ̀, ọjọ́ rere"}],"end":57.864},{"key":"4","start":58.814,"lines":[{"start":58.814,"end":61.739,"text":"Tu igbekun sile, t' E su de l'ewon,","marked":"Tu ìgbèkùn sílẹ̀, t' E sú dé l'ẹ́wọ̀n"},{"start":62.119,"end":64.258,"text":"Awon t'o si subu, jo gbe","marked":"Àwọn t'ó sì ṣubú, jó gbé"},{"start":64.638,"end":65.337,"text":"won dide","marked":"wọ́n dìde"},{"start":65.717,"end":68.499,"text":"F'ojurere Re han: jek' aiye riran","marked":"F'ojúrere Rẹ hàn: jẹ́k' aiye ríran"},{"start":68.879,"end":70.248,"text":"Tun mu 'mole wa de","marked":"Tún mú 'mole wa dé"},{"start":70.628,"end":71.773,"text":"'Wo sa ni 'mole.","marked":"'Wò sá ní 'mọ́lẹ̀."},{"start":72.153,"end":74.831,"text":"Egbe:  Kabo, ojo rere, l'ao ma wi titi","marked":"Kábó, ọjọ́ rere, l'áo má wí títí"},{"start":75.211,"end":78.184,"text":"A sete ku loni, orun di ti wa.","marked":"A ṣètè kú lónì, ọ̀run di ti wa."},{"start":78.564,"end":79.128,"text":"Amin.","marked":"Àmín."}],"end":79.128}]}