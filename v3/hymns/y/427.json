{"v":3,"coll":"y","num":427,"id":"hymn_427","title":"OLUWA, Iwo wadi mi","duration":47.29,"voices":{"male":{"file":"y-427-male-v3.m4a","bytes":322087,"sha256":"5eb0ac9e8fd9726151c7f51f04c0b1a6906f0d9b9b698833b1fa29e4a77611cc","duration":47.3},"female":{"file":"y-427-female-v3.m4a","bytes":339297,"sha256":"fabb7ac9d58486a7c46b19138482c85d1b8088317692056ab87fbeecde686e2b","duration":47.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.876,"text":"OLUWA, Iwọ wadi mi ,","marked":"Olúwa, Ìwọ wádì mi"},{"start":2.326,"end":3.324,"text":"Em' isẹ ọwọ Rẹ;","marked":"Èm isẹ́ ọwọ́ Rẹ"},{"start":3.774,"end":5.305,"text":"Ijoko oun idide mi,","marked":"Ìjókò òun ìdìde mi"},{"start":5.755,"end":6.893,"text":"Ko pamọ loju Rẹ.","marked":"Kò pamọ́ lójú Rẹ̀."}],"end":6.893},{"key":"2","start":7.843,"lines":[{"start":7.843,"end":9.613,"text":"N'ile mi, ati l'ona mi","marked":"N'ilé mi, àti l'ọ̀nà mi"},{"start":10.063,"end":11.117,"text":"N' Iwo ti yi mi ka","marked":"N Ìwọ ti yí mi ká"},{"start":11.567,"end":13.516,"text":"Ko s'iro tabi oro mi","marked":"Kò s'ìrò tàbí ọ̀rọ̀ mi"},{"start":13.966,"end":15.43,"text":"T'Iwo ko ti mo tan.","marked":"T'Ìwọ kò tí mo tán."}],"end":15.43},{"key":"3","start":16.38,"lines":[{"start":16.38,"end":18.032,"text":"Niwaju ati lẹhin mi,","marked":"Níwájú àti lẹ́hìn mi"},{"start":18.482,"end":19.572,"text":"N'Iwọ ti se mi mọ;","marked":"N'Ìwọ ti ṣe mi mọ́"},{"start":20.022,"end":21.322,"text":"Iru 'mọ yi se 'yanu ju,","marked":"Irú 'mọ yí ṣe yanu jù"},{"start":21.772,"end":23.195,"text":"Ti emi ko le mọ.","marked":"Tí èmi kò lè mọ́."}],"end":23.195},{"key":"4","start":24.145,"lines":[{"start":24.145,"end":25.675,"text":"Lati sa kuro loju Re","marked":"Láti sá kúrò lójú Rẹ"},{"start":26.125,"end":27.261,"text":"Is' asan ni fun mi","marked":"Ìṣ asán ni fún mi"},{"start":27.711,"end":29.102,"text":"Emi Re lu aluja mi","marked":"Èmi Rẹ̀ lu àlùjà mi"},{"start":29.552,"end":30.887,"text":"Beni mo sa lasan.","marked":"Bẹni mo sá lásán."}],"end":30.887},{"key":"5","start":31.837,"lines":[{"start":31.837,"end":33.277,"text":"Bi mo sa sinu okunkun","marked":"Bí mo sá sínú òkùnkùn"},{"start":33.727,"end":34.903,"text":"Asan ni eyi je","marked":"Asán ni èyí jẹ́"},{"start":35.353,"end":36.89,"text":"Imole l'okunkun fun O","marked":"Ìmọ́lẹ̀ l'òkùnkùn fún Ọ"},{"start":37.34,"end":38.664,"text":"B'osangangan l'o ri.","marked":"B'ọ̀sáǹgàngàn l'ó rí."}],"end":38.664},{"key":"6","start":39.614,"lines":[{"start":39.614,"end":40.868,"text":"Bi Iwo ti mo okan mi","marked":"Bí Ìwọ ti mọ ọkàn mi"},{"start":41.318,"end":42.424,"text":"Lat'inu iya mi","marked":"Lát'inú ìyá mi"},{"start":42.874,"end":44.264,"text":"Je ki emi k'o f'ara mi","marked":"Jẹ́ kí èmi k'ó f'ara mi"},{"start":44.714,"end":45.741,"text":"Fun O Olugbala.","marked":"Fún Ọ Olùgbàlà."}],"end":45.741}]}