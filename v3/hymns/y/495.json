{"v":3,"coll":"y","num":495,"id":"hymn_495","title":"OLORUN mi, 'Wo l'emi o pe","duration":43.01,"voices":{"male":{"file":"y-495-male-v3.m4a","bytes":301676,"sha256":"d22fb8973b6ba21439704f05f3b61c6208e25d908fef6d0c8eed88eaae0f18c5","duration":43.1},"female":{"file":"y-495-female-v3.m4a","bytes":308054,"sha256":"d58f96a0a26983b537b45626ebd9a89b68b8e50066761e77da05e7e8bb5deabd","duration":43.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.078,"text":"ỌLỌRUN mi, 'Wọ l'emi o pe;","marked":"Ọlọ́run mi, 'Wọ l'èmi ó pè"},{"start":2.528,"end":4.609,"text":"Ara n ni mi, gbọ igbe mi,","marked":"Ara ń ni mí, gbọ́ igbe mi"},{"start":5.059,"end":6.433,"text":"'Gba 'san omi ba bori mi,","marked":"gbà san omi bá borí mi"},{"start":6.883,"end":8.339,"text":"Ma jẹ k'ọkan mi fa sẹhin.","marked":"Má jẹ́ k'ọkàn mi fà sẹ́hìn."}],"end":8.339},{"key":"2","start":9.289,"lines":[{"start":9.289,"end":10.72,"text":"Iwọ Ọrẹ alailera,","marked":"Ìwọ Ọrẹ aláìlera"},{"start":11.17,"end":12.598,"text":"Tani mba s'aroye mi fun?","marked":"Tani mbá s'àròyé mi fún?"},{"start":13.048,"end":14.83,"text":"Bikose 'Wọ nikansoso,","marked":"Bíkọsẹ̀ 'Wọ nìkanṣoṣo"},{"start":15.28,"end":16.671,"text":"T'o n pe otosi wọdọ Rẹ?","marked":"T'ó ń pe òtòṣì wọ̀dọ̀ Rẹ?"}],"end":16.671},{"key":"3","start":17.621,"lines":[{"start":17.621,"end":19.071,"text":"Tal'o sọkun tọ Ọ lasan ri?","marked":"Tál'ó sọkún tọ̀ Ọ́ lásán rí?"},{"start":19.521,"end":21.164,"text":"'Wọ ko i gbagbe ẹnikan ri,","marked":"'Wọ kò ì gbàgbé ẹnìkan rí"},{"start":21.614,"end":23.257,"text":"Se Iwọ ni O ti sọ pe,","marked":"Ṣe Ìwọ ni Ó ti sọ pé"},{"start":23.707,"end":25.003,"text":"Ẹnikan k' yo wa lasan?","marked":"Ẹnìkan k yó wá lásán?"}],"end":25.003},{"key":"4","start":25.953,"lines":[{"start":25.953,"end":27.307,"text":"Eyi 'ba jẹ 'banujẹ mi,","marked":"Èyí bá jẹ́ 'banujẹ mi"},{"start":27.757,"end":29.598,"text":"Pe, O ko n dahun adura;","marked":"Pé, O kò ń dáhùn àdúrà"},{"start":30.048,"end":31.479,"text":"Sugbọn 'Wọ ti n gbọ adura,","marked":"Sùgbọ́n 'Wọ ti ń gbọ́ àdúrà"},{"start":31.929,"end":33.333,"text":"Iwọ l'O n se iranwọ mi.","marked":"Ìwọ l'Ó ń ṣe ìrànwọ́ mi."}],"end":33.333},{"key":"5","start":34.283,"lines":[{"start":34.283,"end":35.824,"text":"Mo mọ pe alaini l'emi,","marked":"Mo mọ̀ pé aláìní l'èmi"},{"start":36.274,"end":37.558,"text":"Ọlọrun ko ni gbagbe mi;","marked":"Ọlọ́run kò ní gbàgbé mi"},{"start":38.008,"end":39.553,"text":"Ẹni ti Jesu mbẹbẹ fun,","marked":"Ẹni tí Jésù mbẹ̀bẹ̀ fún"},{"start":40.003,"end":41.461,"text":"O bọ lọwọ gbogbo 'yọnu.","marked":"Ó bọ́ lọ́wọ́ gbogbo 'yọnu."}],"end":41.461}]}