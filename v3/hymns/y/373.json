{"v":3,"coll":"y","num":373,"id":"hymn_373","title":"PARADISE! Paradise!","duration":48.37,"voices":{"male":{"file":"y-373-male-v3.m4a","bytes":335280,"sha256":"dc18f82537035be41a345aaf0895731dd28da14c5bc67788d137f4f36a98986f","duration":48.4},"female":{"file":"y-373-female-v3.m4a","bytes":343614,"sha256":"52aa1f45104cde3a17628d59f39a6a65631d6e5cb6faf62df87dff209b3e6a90","duration":48.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.354,"text":"PARADISE! Paradise!","marked":"Paradise! Paradise!"},{"start":2.804,"end":4.069,"text":"Tani ko fe simi?","marked":"Tani kò fẹ́ sími?"},{"start":4.519,"end":6.066,"text":"Tani ko fe 'le ayo na","marked":"Tani kò fẹ́ lé ayọ̀ ná"},{"start":6.516,"end":7.665,"text":"lle alabukun.","marked":"Ilẹ̀ alábùkún."}],"end":7.665},{"key":"CHORUS","start":8.615,"lines":[{"start":8.615,"end":9.767,"text":"Nib'awon oloto","marked":"Níb'àwọn ọlọ́tọ̀"},{"start":10.217,"end":11.259,"text":"Wa lai ninu 'mole","marked":"Wá láì nínú mọ́lẹ̀"},{"start":11.709,"end":12.889,"text":"Nwon nyo nigbagbogbo","marked":"Wọ́n ńyọ̀ nígbàgbogbo"},{"start":13.339,"end":14.372,"text":"Niwaju Olorun.","marked":"Níwájú Ọlọ́run."}],"end":14.372},{"key":"2","start":15.322,"lines":[{"start":15.322,"end":17.234,"text":"Paradise! Paradise!","marked":"Paradise! Paradise!"},{"start":17.684,"end":18.721,"text":"Aiye ndarugbo lo","marked":"Ayé ńdarúgbó lọ"},{"start":19.171,"end":20.603,"text":"Tani ko si fe lo simi","marked":"Tani kò sì fẹ́ lọ sími"},{"start":21.053,"end":22.139,"text":"Nib' ife tutu?","marked":"Níb ìfẹ́ tútù?"}],"end":22.139},{"key":"3","start":23.089,"lines":[{"start":23.089,"end":25.317,"text":"Paradise! Paradise!","marked":"Paradise! Paradise!"},{"start":25.767,"end":27.161,"text":"Aiye yi ma su mi!","marked":"Ayé yí má sú mi!"},{"start":27.611,"end":29.184,"text":"Okan mi nfa sodo Jesu","marked":"Ọkàn mi ńfà sọ́dọ̀ Jésù"},{"start":29.634,"end":30.811,"text":"Emi nfe r'oju Re.","marked":"Èmi ńfẹ́ r'ojú Rẹ."}],"end":30.811},{"key":"4","start":31.761,"lines":[{"start":31.761,"end":33.837,"text":"Paradise! Paradise!","marked":"Paradise! Paradise!"},{"start":34.287,"end":35.433,"text":"Mo fe ki nye dese","marked":"Mo fẹ́ kí nye dẹ́ṣẹ̀"},{"start":35.883,"end":37.562,"text":"Mo fe ki nwa lodo Jesu,","marked":"Mo fẹ́ kí ńwá lọ́dọ̀ Jésù"},{"start":38.012,"end":39.028,"text":"Li ebute mimo.","marked":"Lí èbúté mímọ́."}],"end":39.028},{"key":"5","start":39.978,"lines":[{"start":39.978,"end":41.933,"text":"Paradise! Paradise!","marked":"Paradise! Paradise!"},{"start":42.383,"end":43.595,"text":"Nko ni duro pe mo","marked":"Ǹkò ní dúró pé mọ́"},{"start":44.045,"end":45.547,"text":"Nisiyi b'eni pe mo ngbo","marked":"Nísíyì b'ẹni pé mo ńgbọ́"},{"start":45.997,"end":46.821,"text":"Ohun orin orun.","marked":"Ohun orin ọ̀run."}],"end":46.821}]}