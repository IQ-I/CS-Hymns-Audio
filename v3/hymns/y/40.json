{"v":3,"coll":"y","num":40,"id":"hymn_40","title":"AYO l'ojo 'sinmi fun mi","duration":36.24,"voices":{"male":{"file":"y-40-male-v3.m4a","bytes":255026,"sha256":"d91dde0ac810dd70f88f10ecdb42d592c7c6664faf1e3017c9a3d8c7271ad048","duration":36.3},"female":{"file":"y-40-female-v3.m4a","bytes":262052,"sha256":"48561c0bd514c3bc0ac67c0961fe243e8d849289f748645de13fc92e410a2641","duration":36.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.6,"text":"AYỌ l'ọjọ 'sinmi fun mi,","marked":"Ayọ̀ l'ọjọ́ sinmi fún mi"},{"start":2.05,"end":3.955,"text":"Ati agogo at'iwasu;","marked":"Àti agogo àt'ìwàṣù"},{"start":4.405,"end":5.872,"text":"'Gba t'a ba mi n'nu 'banujẹ,","marked":"gbà t'á bá mi n'nú 'banujẹ"},{"start":6.322,"end":7.789,"text":"mf Awọn l'o n mu inu mi dun.","marked":"mf Àwọn l'ó ń mú inú mi dùn."}],"end":7.789},{"key":"2","start":8.739,"lines":[{"start":8.739,"end":10.272,"text":"Ayọ si ni wakati naa,","marked":"Ayọ̀ sì ni wákàtí náà"},{"start":10.722,"end":12.166,"text":"Ti mo lo n'nu agbala Rẹ;","marked":"Tí mo lọ n'nú àgbàlá Rẹ"},{"start":12.616,"end":14.286,"text":"Lati mọ adun adura,","marked":"Láti mọ adùn àdúrà"},{"start":14.736,"end":16.352,"text":"Lati gba manna ọrọ Rẹ.","marked":"Láti gba manna ọ̀rọ̀ Rẹ̀."}],"end":16.352},{"key":"3","start":17.302,"lines":[{"start":17.302,"end":18.574,"text":"f Ayọ ni idahun ―Ami","marked":"f Ayọ̀ ni ìdáhùn ―Àmì"},{"start":19.024,"end":20.771,"text":"To gba gbogbo ile naa kan,","marked":"Tó gba gbogbo ilẹ̀ náà kan"},{"start":21.221,"end":23.965,"text":"Lẹẹkọọkan l'o n dun, t'o n rọlẹ,","marked":"Lẹ́ẹ̀kọ̀ọ̀kan l'ó ń dùn, t'ó ń rọlẹ̀"},{"start":24.415,"end":26.008,"text":"O n kọja lọ s'ọdọ Baba.","marked":"Ó ń kọjá lọ s'ọdọ̀ Baba."}],"end":26.008},{"key":"4","start":26.958,"lines":[{"start":26.958,"end":28.348,"text":"B'ayé fẹ f'agbara de mi","marked":"B'ayé fẹ́ f'agbára dé mí"},{"start":28.798,"end":30.155,"text":"Mọ isẹ ọjọ mẹfa rẹ;","marked":"Mọ isẹ́ ọjọ́ mẹ́fà rẹ"},{"start":30.605,"end":32.114,"text":"Oluwa, jọ tu ide na,","marked":"Olúwa, jọ tú idẹ ná"},{"start":32.564,"end":34.691,"text":"K'O sọ ọkan mi d'ominira.","marked":"K'Ó sọ ọkàn mi d'òmìnira."}],"end":34.691}]}