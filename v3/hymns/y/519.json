{"v":3,"coll":"y","num":519,"id":"hymn_519","title":"JESU, Oluwa, a fe O","duration":46.639,"voices":{"male":{"file":"y-519-male-v3.m4a","bytes":329747,"sha256":"5ace9bbb3c5c83c4e2c7b22f0190235f493ec7344b5ee4d8e3f9c3de90a4e782","duration":46.7},"female":{"file":"y-519-female-v3.m4a","bytes":343472,"sha256":"43a1f6e103ef82a1a19153e29046537a7598aecf9b85d466b6cf6ab2e7b1022f","duration":46.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.417,"text":"JESU, Oluwa, a fẹ Ọ,","marked":"Jésù, Olúwa, a fẹ́ Ọ"},{"start":2.867,"end":3.859,"text":"'Tori gbogbo ẹbun,","marked":"torí gbogbo ẹ̀bùn"},{"start":4.309,"end":5.993,"text":"N t'ọwọ Rẹ da lat' oke wa,","marked":"Ń t'ọwọ́ Rẹ̀ dà lát òkè wá"},{"start":6.443,"end":7.682,"text":"B' iri si gbogb' ayé,","marked":"B ìrì sì gbogb ayé"},{"start":8.132,"end":9.46,"text":"A yin Ọ nitori wọnyi;","marked":"A yìn Ọ́ nítorí wọ̀nyí"},{"start":9.91,"end":11.287,"text":"K' ise fun wọn nikan,","marked":"K iṣẹ́ fún wọn nìkan"},{"start":11.737,"end":12.696,"text":"Ni awọn ọmọ-ọdọ Rẹ,","marked":"Ní àwọn ọmọ-ọdọ Rẹ"},{"start":13.146,"end":14.579,"text":"Se ń gbadura si Ọ.","marked":"Ṣe ń gbàdúrà sí Ọ."}],"end":14.579},{"key":"2","start":15.529,"lines":[{"start":15.529,"end":17.175,"text":"Awa fẹ Ọ, Olugbala,","marked":"Àwa fẹ́ Ọ, Olùgbàlà"},{"start":17.625,"end":19.08,"text":"'Tori 'gba t'a sako;","marked":"torí gbà t'á ṣáko"},{"start":19.53,"end":20.797,"text":"Iwọ pe ọkan wa pada,","marked":"Ìwọ pé ọkàn wa padà"},{"start":21.247,"end":22.433,"text":"Lati t'ọna iye,","marked":"Láti t'ọ̀nà iye"},{"start":22.883,"end":24.436,"text":"'Gba t'a wa ninu okunkun,","marked":"gbà t'á wà nínú òkùnkùn"},{"start":24.886,"end":26.254,"text":"T'a rin ninu ẹsẹ:","marked":"T'á rìn nínú ẹsẹ"},{"start":26.704,"end":27.961,"text":"'Wọ ran imọlẹ Rẹ si wa,","marked":"'Wọ rán ìmọ́lẹ̀ Rẹ sí wa"},{"start":28.411,"end":29.828,"text":"Lati f'ọna han wa.","marked":"Láti f'ọ̀nà hàn wá."}],"end":29.828},{"key":"3","start":30.778,"lines":[{"start":30.778,"end":32.55,"text":"Baba orun, awa fe O,","marked":"Baba ọ̀run, àwa fẹ́ Ọ"},{"start":33.0,"end":34.122,"text":"Nitori Wo fe wa","marked":"Nítorí Wo fẹ́ wà"},{"start":34.572,"end":36.177,"text":"Wo ran Omo Re lati ku","marked":"Wo rán Ọmọ Rẹ̀ láti kú"},{"start":36.627,"end":37.622,"text":"Ki awa le n'iye","marked":"Kí àwa lè n'ìyè"},{"start":38.072,"end":39.409,"text":"Gbat' a wa labe 'binu Re","marked":"Gbàt a wà lábẹ́ bínú Rẹ̀"},{"start":39.859,"end":41.037,"text":"Wo fun wa n'ireti","marked":"Wọ fún wa n'ìrètí"},{"start":41.487,"end":43.249,"text":"Bi ese t'a da ti po to","marked":"Bí ẹsẹ̀ t'á dá ti pọ̀ tó"},{"start":43.699,"end":45.09,"text":"Be l' o dariji wa.","marked":"Bẹ̀ l ó dáríjì wá."}],"end":45.09}]}