{"v":3,"coll":"y","num":837,"id":"hymn_837","title":"JESU fe mi mo mo be","duration":34.029,"voices":{"male":{"file":"y-837-male-v3.m4a","bytes":229160,"sha256":"4b099190df833167394828af67f384487c8f5bce978af0181acccd9cebb9b4fe","duration":34.1},"female":{"file":"y-837-female-v3.m4a","bytes":244264,"sha256":"e719638d81aec844d2c15bcc33f325640d71c66727942ad20f606ed42cdc2717","duration":34.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.244,"text":"JESU fẹ mi, mo mọ bẹ,","marked":"Jésù fẹ́ mi, mo mọ̀ bẹ"},{"start":2.694,"end":3.992,"text":"Bibeli l'o sọ fun mi;","marked":"Bíbélì l'ó sọ fún mi"},{"start":4.442,"end":5.665,"text":"Tirẹ l'awọn ọmọde,","marked":"Tirẹ̀ l'àwọn ọmọdé"},{"start":6.115,"end":8.047,"text":"Wọn ko lagbara, Oun ni.","marked":"Wọn kò lágbára, Òun ni."}],"end":8.047},{"key":"2","start":8.997,"lines":[{"start":8.997,"end":11.02,"text":"Jesu fẹ mi Ẹn' t'o ku,","marked":"Jésù fẹ́ mi Ẹn' t'ó kú"},{"start":11.47,"end":12.676,"text":"Lati si ọrun silẹ;","marked":"Láti ṣí ọ̀run sílẹ̀"},{"start":13.126,"end":14.444,"text":"Yoo wẹ ẹsẹ mi nu;","marked":"Yóò wẹ ẹsẹ̀ mi nù"},{"start":14.894,"end":16.247,"text":"Jẹ ki ọmọ Rẹ wọle.","marked":"Jẹ́ kí ọmọ Rẹ̀ wọlé."}],"end":16.247},{"key":"3","start":17.197,"lines":[{"start":17.197,"end":18.714,"text":"Jesu fẹ mi sibẹ si,","marked":"Jésù fẹ́ mi síbẹ̀ sí"},{"start":19.164,"end":20.445,"text":"Bi emi tilẹ s'aisan,","marked":"Bí èmi tilẹ̀ s'àìsàn"},{"start":20.895,"end":22.243,"text":"Lor' akete aisan mi,","marked":"Lọ́r àkéte àìsàn mi"},{"start":22.693,"end":24.295,"text":"Y'o t'itẹ Rẹ wa sọ mi.","marked":"Y'ó t'ìtẹ́ Rẹ̀ wá sọ mí."}],"end":24.295},{"key":"4","start":25.245,"lines":[{"start":25.245,"end":27.267,"text":"Jesu fẹ mi, y'o duro,","marked":"Jésù fẹ́ mi, y'ó dúró"},{"start":27.717,"end":28.938,"text":"Ti mi ni gbogb' ọna mi,","marked":"Tì mí ní gbogb ọ̀nà mi"},{"start":29.388,"end":30.803,"text":"'Gba mba f'ayé yi silẹ,","marked":"gbà mbá f'ayé yí sílẹ̀"},{"start":31.253,"end":32.48,"text":"Y'o mu mi re 'le ọrun.","marked":"Y'ó mú mi rẹ̀ lé ọ̀run."}],"end":32.48}]}