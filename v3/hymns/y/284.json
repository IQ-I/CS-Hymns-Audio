{"v":3,"coll":"y","num":284,"id":"hymn_284","title":"JESU, l'ara Re l'awa n wo","duration":34.224,"voices":{"male":{"file":"y-284-male-v3.m4a","bytes":235583,"sha256":"c13987ad16447299ac4d4a236c035929fcb9d466f0a9b56d3c6f13870a0a9fd4","duration":34.3},"female":{"file":"y-284-female-v3.m4a","bytes":243593,"sha256":"482eaa5727a9aabb8ab5403a1d8e52142fc4bb05c033d89cdd382e1de83ad02f","duration":34.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.404,"text":"JESU, l'ara Rẹ l'awa ń wo","marked":"Jésù, l'ara Rẹ̀ l'àwa ń wò"},{"start":2.854,"end":3.931,"text":"Ẹgbẹgbẹrun ogo;","marked":"Ẹgbẹgbẹ̀rún ògo"},{"start":4.381,"end":5.855,"text":"Ju t'okuta iyebiye,","marked":"Ju t'òkúta iyebíye"},{"start":6.305,"end":7.777,"text":"T'agbada Aaroni.","marked":"T'agbádá Aaroni."}],"end":7.777},{"key":"2","start":8.727,"lines":[{"start":8.727,"end":10.446,"text":"Wọn ko le sai ko rubọ na,","marked":"Wọn kò lè ṣàì kó rúbọ ná"},{"start":10.896,"end":12.179,"text":"Fun ẹsẹ ara wọn,","marked":"Fún ẹsẹ̀ ara wọn"},{"start":12.629,"end":14.986,"text":"Iwa Rẹ pe, ko l'abawọn,","marked":"Ìwà Rẹ̀ pé, kò l'àbàwọ́n"},{"start":15.436,"end":16.562,"text":"Mimọ si l'Ẹda Rẹ.","marked":"Mímọ́ sì l'Ẹ̀dà Rẹ."}],"end":16.562},{"key":"3","start":17.512,"lines":[{"start":17.512,"end":19.416,"text":"Jesu Ọba ogo gunwa,","marked":"Jésù Ọba ògo gúnwà"},{"start":19.866,"end":21.184,"text":"L'oke Sion t'ọrun;","marked":"L'ókè Sion t'ọ̀run"},{"start":21.634,"end":23.135,"text":"Bi Ọdọ-aguntan t'a pa,","marked":"Bí Ọdọ-aguntan t'á pa"},{"start":23.585,"end":24.771,"text":"Bi Alufa nla wa.","marked":"Bí Àlùfá ńlá wa."}],"end":24.771},{"key":"4","start":25.721,"lines":[{"start":25.721,"end":27.144,"text":"Alagbawi lodo Baba","marked":"Alágbàwí lọ́dọ̀ Baba"},{"start":27.594,"end":28.923,"text":"Ti y'o wa titi lai","marked":"Tí y'ó wà títí láì"},{"start":29.373,"end":30.827,"text":"Gb'ejo re fun 'wo okan mi","marked":"Gb'ẹjọ́ rẹ fún wò ọkàn mi"},{"start":31.277,"end":32.674,"text":"Gb'ore-ofe baba.","marked":"Gb'ore-ofe Baba."}],"end":32.674}]}