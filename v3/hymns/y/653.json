{"v":3,"coll":"y","num":653,"id":"hymn_653","title":"ATUPA 'wa njo, geere","duration":55.643,"voices":{"male":{"file":"y-653-male-v3.m4a","bytes":397226,"sha256":"e044612a1151351fccfb4e31f0d3632eb1a7dc7c09c8c82d6470cf6df21953bc","duration":55.7},"female":{"file":"y-653-female-v3.m4a","bytes":405229,"sha256":"ba4d1b3f3a1471f56d2e0e81b6adef8e564730e196d8927a588c5dbd8195af0d","duration":55.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.97,"text":"ATUPA 'wa njo, geere","marked":"Àtùpá wá ńjọ, geere"},{"start":2.42,"end":3.699,"text":"Aso wa funfun lau","marked":"Aṣọ wa funfun láù"},{"start":4.149,"end":5.568,"text":"A nduro d'oko yawo,","marked":"A ńdúró d'oko yàwó"},{"start":6.018,"end":7.034,"text":"a ha le wole bi?","marked":"a ha lè wọlé bí?"},{"start":7.484,"end":9.599,"text":"A mo pe a ko ni nkan t'a","marked":"A mọ̀ pé a kò ní nǹkan t'á"},{"start":10.049,"end":11.115,"text":"le pe ni tiwa","marked":"lè pè ní tiwa"},{"start":11.565,"end":14.625,"text":"Ina, ororo, at'aso, t'owo","marked":"Iná, òróró, àt'aṣọ, t'ọwọ́"},{"start":15.075,"end":16.063,"text":"Re nikan wa.","marked":"Rẹ̀ nìkan wà."}],"end":16.063},{"key":"CHORUS","start":17.013,"lines":[{"start":17.013,"end":18.32,"text":"E wo Oko yawo mbo","marked":"Ẹ wo Ọkọ̀ yàwó mbọ̀"},{"start":18.77,"end":20.144,"text":"Gbogbo wa Ie wole","marked":"Gbogbo wa lè wọlé"},{"start":20.594,"end":22.087,"text":"T'atupa wa njo gere!","marked":"T'àtúpá wá ńjọ gẹ́rẹ́!"},{"start":22.537,"end":23.861,"text":"T'aso wa funfun lau.","marked":"T'aṣọ wà funfun láù."}],"end":23.861},{"key":"2","start":24.811,"lines":[{"start":24.811,"end":25.955,"text":"E jade lo pade Re,","marked":"Ẹ jáde lọ pàdé Rẹ̀"},{"start":26.405,"end":27.707,"text":"lekun ti si sile","marked":"lẹ́kun ti ṣí sílẹ̀"},{"start":28.157,"end":29.651,"text":"Ogo t'o tan loju Re mu","marked":"Ògo t'ó tán lójú Rẹ̀ mú"},{"start":30.101,"end":31.072,"text":"gbogbo ona mole,","marked":"gbogbo ọ̀nà mọ́lẹ̀"},{"start":31.522,"end":33.128,"text":"Gba ipe lati wole,","marked":"Gba ìpè láti wọlé"},{"start":33.578,"end":34.549,"text":"o j'ohun gbogbo lo,","marked":"ó j'ohun gbogbo lọ"},{"start":34.999,"end":37.003,"text":"Ma jafara! gb'atupa Re!","marked":"Má jáfara! gb'àtùpá Rẹ̀!"},{"start":37.453,"end":38.684,"text":"w'ayo aiyeraiye.","marked":"w'ayọ̀ ayérayé."}],"end":38.684},{"key":"3","start":39.634,"lines":[{"start":39.634,"end":40.993,"text":"Arewa gbeyawo na,","marked":"Arẹwà gbéyàwó ná"},{"start":41.443,"end":42.623,"text":"b'ilekun si sibe,","marked":"b'ìlẹ̀kùn sì síbẹ̀"},{"start":43.073,"end":44.377,"text":"A mo p'awon t'o wole","marked":"A mọ̀ p'àwọn t'ó wọlé"},{"start":44.827,"end":46.072,"text":"d'eni 'bukun lailai,","marked":"d'ẹni bùkún láéláé"},{"start":46.522,"end":48.207,"text":"A si ri pe O wa ni ju","marked":"A sì rí pé Ó wà ní ju"},{"start":48.657,"end":49.693,"text":"enikeni lo,","marked":"ẹnikẹ́ni lọ"},{"start":50.143,"end":51.475,"text":"Sugbon b' ilekun ti,","marked":"Ṣùgbọ́n b ìlẹ̀kùn ti"},{"start":51.925,"end":54.093,"text":"lekun ki yio tun si mo Iai.","marked":"lẹ́kun kí yóò tún sì mọ̀ láì."}],"end":54.093}]}