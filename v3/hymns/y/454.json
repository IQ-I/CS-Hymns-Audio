{"v":3,"coll":"y","num":454,"id":"hymn_454","title":"KO to k'awon mimo b)eru","duration":49.155,"voices":{"male":{"file":"y-454-male-v3.m4a","bytes":335171,"sha256":"e70d4953d580950383b57682ec9481f25672404dcb7a96be9687a9f441e4d800","duration":49.2},"female":{"file":"y-454-female-v3.m4a","bytes":351175,"sha256":"3a4104a76cbd4181289fd173dee112c431ecb74c77bc9d026ca4f37c9862ae37","duration":49.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.761,"text":"Ko to k'awon mimo beru","marked":"Kò tó k'àwọn mímọ́ bẹ̀rù"},{"start":2.211,"end":3.348,"text":"Ki nwon so 'reti nu","marked":"Kí wọ́n sọ retí nù"},{"start":3.798,"end":5.189,"text":"'Gba nwon ko reti 'ranwo Re,","marked":"gba wọ́n kò retí rànwọ́ Rẹ"},{"start":5.639,"end":6.993,"text":"Olugbala y'o de.","marked":"Olùgbàlà y'ó dé."}],"end":6.993},{"key":"CHORUS","start":7.943,"lines":[{"start":7.943,"end":9.548,"text":"Ka d'amure lati jagun","marked":"Ká d'àmùrè láti jagun"},{"start":9.998,"end":11.483,"text":"Ka d'amure lati jagun","marked":"Ká d'àmùrè láti jagun"},{"start":11.933,"end":12.913,"text":"Ka d'amure e","marked":"Ká d'àmùrè e"},{"start":13.363,"end":14.303,"text":"Ka d'amure e","marked":"Ká d'àmùrè e"},{"start":14.753,"end":16.592,"text":"Ka d'amure lati jagun.","marked":"Ká d'àmùrè láti jagun."}],"end":16.592},{"key":"2","start":17.542,"lines":[{"start":17.542,"end":19.089,"text":"Nigbati Abraha mu obe","marked":"Nígbàtí Abraha mú ọbẹ̀"},{"start":19.539,"end":20.56,"text":"Olorun ni 'Duro\"","marked":"Ọlọ́run ni dúró"},{"start":21.01,"end":22.636,"text":"Agbo ti o wa lohun ni","marked":"Agbo tí ó wà lóhùn ni"},{"start":23.086,"end":24.216,"text":"Y'o dipo omo na.","marked":"Y'ó dípò ọmọ ná."}],"end":24.216},{"key":"3","start":25.166,"lines":[{"start":25.166,"end":26.451,"text":"'Gba Jona ri sinu omi","marked":"gba Jona rí sínú omi"},{"start":26.901,"end":28.171,"text":"Ko ro lati yo mo","marked":"Kò rò láti yọ̀ mọ́"},{"start":28.621,"end":29.88,"text":"Sugbon Olorun ran eje","marked":"Ṣùgbọ́n Ọlọ́run rán ẹ̀jẹ̀"},{"start":30.33,"end":31.748,"text":"T'o gbe lo s'ebute.","marked":"T'ó gbé lọ s'èbúté."}],"end":31.748},{"key":"4","start":32.698,"lines":[{"start":32.698,"end":34.379,"text":"B'iru ipa at'ife yi","marked":"B'irú ipa àt'ìfẹ́ yí"},{"start":34.829,"end":35.915,"text":"Ti pio l'oro Re to","marked":"Ti píọ́ l'ọ̀rọ̀ Rẹ̀ tó"},{"start":36.365,"end":37.677,"text":"Emi ba ma k'aniyan mi","marked":"Èmi bá má k'àníyàn mi"},{"start":38.127,"end":39.23,"text":"Le Oluwa lowo.","marked":"Lé Olúwa lọ́wọ́."}],"end":39.23},{"key":"5","start":40.18,"lines":[{"start":40.18,"end":41.554,"text":"E duro de iranwo Re","marked":"Ẹ dúró de ìrànwọ́ Rẹ̀"},{"start":42.004,"end":43.747,"text":"B'o tile pe, duro","marked":"B'ó tilẹ̀ pé, dúró"},{"start":44.197,"end":45.784,"text":"B'ileri na tile fa 'le","marked":"B'ílérí ná tilẹ̀ fà lé"},{"start":46.234,"end":47.606,"text":"Sugbon ko le pe de.","marked":"Ṣùgbọ́n kò lè pè dé."}],"end":47.606}]}