{"v":3,"coll":"y","num":229,"id":"hymn_229","title":"OLUWA alafia wa","duration":50.987,"voices":{"male":{"file":"y-229-male-v3.m4a","bytes":365058,"sha256":"86243c113dd1e4b184d65a167b229258ca577cb0122d4841b39a5a5f75756524","duration":51.0},"female":{"file":"y-229-female-v3.m4a","bytes":377813,"sha256":"0d02f778d1c95ecfc56a840ed016e497261a5435f0e1b6c6007bd46364e831e2","duration":51.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.863,"text":"OLUWA alafia wa,","marked":"Olúwa àlàáfíà wa"},{"start":2.313,"end":3.918,"text":"L'o pasẹ t'ọdun yipo;","marked":"L'ó pàsẹ t'ọdún yípo"},{"start":4.368,"end":5.685,"text":"Awa ọmọ Rẹ wa dupẹ,","marked":"Àwa ọmọ Rẹ wá dúpẹ́"},{"start":6.135,"end":7.956,"text":"F'ọdun titun t'a bere,","marked":"F'ọdún títún t'á bẹ̀rẹ̀"},{"start":8.406,"end":10.164,"text":"Yin Oluwa! Yin Oluwa!","marked":"Yín Olúwa! Yin Olúwa!"},{"start":10.614,"end":12.324,"text":"Ọba nla t'O da wa si.","marked":"Ọba ńlá t'Ó dá wa sí."}],"end":12.324},{"key":"2","start":13.274,"lines":[{"start":13.274,"end":14.762,"text":"A dupẹ fun ipamọ wa,","marked":"A dúpẹ́ fún ìpamọ́ wa"},{"start":15.212,"end":16.782,"text":"Ni ọdun ti o kọja;","marked":"Ní ọdún tí ó kọjá"},{"start":17.232,"end":18.444,"text":"A mbẹbẹ iranlọwọ Rẹ,","marked":"A mbẹ̀bẹ̀ ìrànlọ́wọ́ Rẹ̀"},{"start":18.894,"end":20.219,"text":"Fun gbogbo wa lọdun yi,","marked":"Fún gbogbo wa lọ́dún yí"},{"start":20.669,"end":22.748,"text":"Jẹ k'Ijọ wa, jẹ k'Ijọ wa","marked":"Jẹ́ k'Ìjọ wa, jẹ́ k'Ìjọ wa"},{"start":23.198,"end":24.686,"text":"Ma dagba ninu Kristi.","marked":"Má dàgbà nínú Kristi."}],"end":24.686},{"key":"3","start":25.636,"lines":[{"start":25.636,"end":27.161,"text":"K'agba k'o mura lati sin","marked":"K'àgbà k'ó múra láti sìn"},{"start":27.611,"end":29.396,"text":"Lokan kan ni odun yi","marked":"Lọ́kàn kan ní ọdún yí"},{"start":29.846,"end":31.566,"text":"K'awon omode k'o mura","marked":"K'àwọn ọmọdé k'ó múra"},{"start":32.016,"end":33.487,"text":"Lati saferi Jesu","marked":"Láti ṣàfẹ́rí Jésù"},{"start":33.937,"end":35.683,"text":"K'alafia, k'alafia","marked":"K'àlàáfíà, k'àlàáfíà"},{"start":36.133,"end":37.386,"text":"K'o se ade odun yi.","marked":"K'ó ṣe adé ọdún yí."}],"end":37.386},{"key":"4","start":38.336,"lines":[{"start":38.336,"end":40.13,"text":"K'Emi Mimo lat' oke wa","marked":"K'Ẹ̀mí Mímọ́ lát òkè wá"},{"start":40.58,"end":42.068,"text":"Ba le wa ni odun yi","marked":"Bá lè wà ní ọdún yí"},{"start":42.518,"end":43.994,"text":"Ki Alufa at'Oluko","marked":"Kí Àlùfá àt'olùkọ́"},{"start":44.444,"end":45.508,"text":"Pelu gbogbo Ijo wa","marked":"Pẹ̀lú gbogbo Ìjọ wa"},{"start":45.958,"end":47.437,"text":"Mura giri, Mura giri","marked":"Múra gírí, Múra gírí"},{"start":47.887,"end":49.438,"text":"Lati Josin f'Oluwa.","marked":"Láti Jọ́sìn f'Olúwa."}],"end":49.438}]}