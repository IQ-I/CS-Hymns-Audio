{"v":3,"coll":"y","num":718,"id":"hymn_718","title":"OLORUN Oluwa l'oba","duration":67.747,"voices":{"male":{"file":"y-718-male-v3.m4a","bytes":471093,"sha256":"7b74a5b95841e790f92b9340691f595b37dc7c0ddbd56bc306e0bdd44b584a1b","duration":67.8},"female":{"file":"y-718-female-v3.m4a","bytes":485758,"sha256":"08d04b107e24ce1491d45ffaca56e956f66ead32598af2534b41732201b95b53","duration":67.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.534,"text":"OLORUN Oluwa l'oba","marked":"Ọlọ́run Olúwa l'ọba"},{"start":1.984,"end":3.12,"text":"Aye mbe niwaju Re","marked":"Ayé mbẹ́ níwájú Rẹ̀"},{"start":3.57,"end":5.021,"text":"Nibi t'awon angel nsin I","marked":"Níbi t'àwọn angẹl ńsìn I"},{"start":5.471,"end":6.901,"text":"L'O gunwa ni ite Re","marked":"L'Ó gúnwà ní ìtẹ́ Rẹ"},{"start":7.351,"end":8.055,"text":"Eni Mimo","marked":"Ẹni Mímọ́"},{"start":8.505,"end":9.982,"text":"Obangiji, On l'Oba.","marked":"Ọbangijì, Ọ́n l'Ọba."}],"end":9.982},{"key":"2","start":10.932,"lines":[{"start":10.932,"end":12.105,"text":"Oba Ogo Ii Olorun","marked":"Ọba Ògo Ìí Ọlọ́run"},{"start":12.555,"end":13.956,"text":"Sion royin Re k'aye","marked":"Sion ròyìn Rẹ̀ k'ayé"},{"start":14.406,"end":15.859,"text":"lsra-eli ti igbani","marked":"Isra-eli ti ìgbáni"},{"start":16.309,"end":17.432,"text":"Kede itan oto Re","marked":"Kéde ìtàn ọ̀tọ̀ Rẹ"},{"start":17.882,"end":18.657,"text":"Eni Mimo","marked":"Ẹni Mímọ́"},{"start":19.107,"end":20.255,"text":"Mimo li oruko Re.","marked":"Mímọ́ lí orúkọ Rẹ."}],"end":20.255},{"key":"3","start":21.205,"lines":[{"start":21.205,"end":22.84,"text":"Li atijo, ni 'gba ewu","marked":"Lí àtijọ́, ni gba ewu"},{"start":23.29,"end":24.38,"text":"T'awon ojise Re be","marked":"T'àwọn òjíṣẹ́ Rẹ bẹ"},{"start":24.83,"end":26.333,"text":"O gbo gbe awon eniyan Re","marked":"Ó gbọ́ gbé àwọn ènìyàn Rẹ̀"},{"start":26.783,"end":28.627,"text":"N'nu eru won, O dahun","marked":"N'nú ẹ̀rù wọn, Ó dáhùn"},{"start":29.077,"end":29.779,"text":"Eni Mimo","marked":"Ẹni Mímọ́"},{"start":30.229,"end":31.947,"text":"Won ri n'tosi gba won p'e.","marked":"Wọ́n rí n'tòsí gbà wọ́n p'é."}],"end":31.947},{"key":"4","start":32.897,"lines":[{"start":32.897,"end":34.476,"text":"Awon l'afun l'ofin mimo","marked":"Àwọn l'afún l'òfin mímọ́"},{"start":34.926,"end":36.215,"text":"Lat' inu awosanma","marked":"Lát inú àwọsánmà"},{"start":36.665,"end":37.894,"text":"Ilana mimo ti won ru","marked":"Ìlànà mímọ́ tí wọ́n rú"},{"start":38.344,"end":39.509,"text":"Mu ki O binu si won","marked":"Mú kí Ó bínú sí wọn"},{"start":39.959,"end":40.644,"text":"Eni Mimo","marked":"Ẹni Mímọ́"},{"start":41.094,"end":42.327,"text":"Won kanu fun ese won.","marked":"Wọ́n kanu fún ẹ̀ṣẹ̀ wọn."}],"end":42.327},{"key":"5","start":43.277,"lines":[{"start":43.277,"end":44.863,"text":"Sugbon Baba won fiji won","marked":"Ṣùgbọ́n Baba wọn fìjì wọn"},{"start":45.313,"end":46.553,"text":"Gba won tun safari Re","marked":"Gbà wọ́n tún ṣàfárí Rẹ"},{"start":47.003,"end":48.603,"text":"O mura tan lati gba won","marked":"Ó múra tán láti gbà wọ́n"},{"start":49.053,"end":50.387,"text":"O f'ife gba won pada","marked":"Ó f'ìfẹ́ gbà wọ́n padà"},{"start":50.837,"end":51.52,"text":"Eni Mimo","marked":"Ẹni Mímọ́"},{"start":51.97,"end":53.404,"text":"Awa na nw'or'ofe Re.","marked":"Àwa na ńw'ọr'ọ̀fẹ́ Rẹ."}],"end":53.404},{"key":"6","start":54.354,"lines":[{"start":54.354,"end":56.092,"text":"Baba wa n'iyonu n'nu Kristi","marked":"Baba wa n'ìyọnu n'nú Kristi"},{"start":56.542,"end":57.84,"text":"Y'o mu ileri Re se","marked":"Y'ó mú ìlérí Rẹ̀ ṣe"},{"start":58.29,"end":60.594,"text":"Wa, k'a gbe ga, gbogbo'alaye","marked":"Wá, k'á gbé ga, gbogbo'àlàyé"},{"start":61.044,"end":62.416,"text":"E wa soke mimo Re!","marked":"Ẹ wá sókè mímọ́ Rẹ̀!"},{"start":62.866,"end":63.537,"text":"Eni Mimo","marked":"Ẹni Mímọ́"},{"start":63.987,"end":65.182,"text":"E sin loke mimo Re.","marked":"Ẹ sìn lókè mímọ́ Rẹ̀."},{"start":65.632,"end":66.198,"text":"Amin.","marked":"Àmín."}],"end":66.198}]}