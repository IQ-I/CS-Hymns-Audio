{"v":3,"coll":"y","num":651,"id":"hymn_651","title":"OJO ko, ase na leyi","duration":50.828,"voices":{"male":{"file":"y-651-male-v3.m4a","bytes":353438,"sha256":"b6be0a40238ad19864c87a192aab6b0336937068782768d6b5e9fb4da64a594c","duration":50.9},"female":{"file":"y-651-female-v3.m4a","bytes":362822,"sha256":"fee005efb1bc022d2fd39eb06744bae2996a69ad776dfde787c26066d1a8b9c9","duration":50.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.404,"text":"ỌJỌ ko, ase na leyi,","marked":"Ọjọ́ kọ́, àṣẹ ná léyí"},{"start":2.854,"end":4.143,"text":"Mo f'ara mi fun yin;","marked":"Mo f'ara mi fún yín"},{"start":4.593,"end":6.476,"text":"Ẹ wo, mo f'ẹjẹ mi fun yin","marked":"Ẹ wò, mo f'ẹ̀jẹ̀ mi fún yín"},{"start":6.926,"end":8.115,"text":"Lati ran yin pada.","marked":"Láti rán yín padà."}],"end":8.115},{"key":"2","start":9.065,"lines":[{"start":9.065,"end":10.611,"text":"O di 'nu 'jọba Baba Mi,","marked":"Ó di nù 'jọba Baba Mi"},{"start":11.061,"end":12.311,"text":"Ki n to tun 'ba yin mu,","marked":"Kí n tó tún bá yín mu"},{"start":12.761,"end":14.523,"text":"'Gbana ẹkun ko ni si mọ,","marked":"gbàná ẹkún kò ní sí mọ́"},{"start":14.973,"end":16.203,"text":"A o ma yọ titi.","marked":"A ó má yọ̀ títí."}],"end":16.203},{"key":"3","start":17.153,"lines":[{"start":17.153,"end":18.982,"text":"Titi l'a o ma jẹ Ounjẹ yi,","marked":"Títí l'á ò má jẹ́ Oúnjẹ yí"},{"start":19.432,"end":20.564,"text":"K'o to di igba na;","marked":"K'ó tó di ìgbà ná"},{"start":21.014,"end":22.576,"text":"Ka gbogb' ayé l'ọpọlọpọ,","marked":"Ká gbogb ayé l'ọ̀pọ̀lọpọ̀"},{"start":23.026,"end":24.98,"text":"Y'o ma jẹ, y'o ma mu.","marked":"Y'ó má jẹ́, y'ó má mu."}],"end":24.98},{"key":"4","start":25.93,"lines":[{"start":25.93,"end":27.264,"text":"'Bukun atọrunwa y'o ma","marked":"bùkún àtọ̀runwá y'ó má"},{"start":27.714,"end":29.132,"text":"Wa lor' awọn t'o n jẹ;","marked":"Wá lór àwọn t'ó ń jẹ"},{"start":29.582,"end":31.008,"text":"N ó gbe or'-itẹ Baba mi,","marked":"N ó gbé or'-itẹ Baba mi"},{"start":31.458,"end":32.781,"text":"Ma pes'-aye fun wọn.","marked":"Má pes'-aye fún wọn."}],"end":32.781},{"key":"5","start":33.731,"lines":[{"start":33.731,"end":36.024,"text":"p Sugbọn nisinsin yi, ago","marked":"p Sùgbọ́n nísinsin yí, àgọ́"},{"start":36.474,"end":37.565,"text":"Kikoro l'em' o mu,","marked":"Kíkorò l'ẹ́m ò mú"},{"start":38.015,"end":39.373,"text":"Emi o mu nitori yin,","marked":"Èmi ó mú nítorí yín"},{"start":39.823,"end":41.021,"text":"Ago 'rora iku.","marked":"Àgọ́ rora ikú."}],"end":41.021},{"key":"6","start":41.971,"lines":[{"start":41.971,"end":43.305,"text":"E ko le mo banuje Mi","marked":"Ẹ kò lè mọ̀ banújẹ́ Mi"},{"start":43.755,"end":45.213,"text":"E ko ti r'ogo Mi","marked":"Ẹ kò ti r'ògo Mi"},{"start":45.663,"end":47.562,"text":"Sugbon e ma s'eyi titi","marked":"Ṣùgbọ́n ẹ má s'èyí títí"},{"start":48.012,"end":49.279,"text":"K'e ma fi ranti Mi.","marked":"K'é má fi rántí Mi."}],"end":49.279}]}