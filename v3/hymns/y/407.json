{"v":3,"coll":"y","num":407,"id":"hymn_407","title":"BABA anu, n'nu oro Re","duration":42.456,"voices":{"male":{"file":"y-407-male-v3.m4a","bytes":289180,"sha256":"cc2e9bcb91a2e50975999d3c075ecb43135e762c814acda9965361d503242d57","duration":42.5},"female":{"file":"y-407-female-v3.m4a","bytes":302293,"sha256":"86a1741eb9e4f5df04e9e77ba6a8664feb23f6ea3893865a5ae477a97c26d2bc","duration":42.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.257,"text":"BABA anu, n'nu ọrọ Rẹ,","marked":"Baba àánú, n'nú ọ̀rọ̀ Rẹ"},{"start":2.707,"end":4.274,"text":"L'ogo ailopin n tan;","marked":"L'ògo àìlópin ń tàn"},{"start":4.724,"end":6.78,"text":"K'a ma yin orukọ Rẹ lai,","marked":"K'á má yin orúkọ Rẹ̀ láì"},{"start":7.23,"end":8.495,"text":"Fun iwe mimọ yi.","marked":"Fún ìwé mímọ́ yí."}],"end":8.495},{"key":"2","start":9.445,"lines":[{"start":9.445,"end":11.293,"text":"N'nu rẹ l'awọn alaini le","marked":"N'nú rẹ̀ l'àwọn aláìní le"},{"start":11.743,"end":12.862,"text":"Ri ọrọ ailopin;","marked":"Rí ọ̀rọ̀ àìlópin"},{"start":13.312,"end":15.267,"text":"Ọrọ, t'ayé ko le fun-ni,","marked":"Ọ̀rọ̀, t'ayé kò lè fun-ni"},{"start":15.717,"end":16.965,"text":"T'o daju bi iye.","marked":"T'ó dájú bí iye."}],"end":16.965},{"key":"3","start":17.915,"lines":[{"start":17.915,"end":19.439,"text":"N'nu rẹ n'igi imọ rere,","marked":"N'nú rẹ̀ n'igi ìmọ̀ rere"},{"start":19.889,"end":21.342,"text":"N fun-ni l'Ounjẹ ọfẹ,","marked":"Ń fun-ni l'Oúnjẹ ọ̀fẹ́"},{"start":21.792,"end":23.527,"text":"T'adun rẹ po ju t'ayé lọ,","marked":"T'adùn rẹ̀ pọ̀ ju t'ayé lọ"},{"start":23.977,"end":25.336,"text":"T'o n fa gbogbo ẹda.","marked":"T'ó ń fa gbogbo ẹ̀dá."}],"end":25.336},{"key":"4","start":26.286,"lines":[{"start":26.286,"end":28.063,"text":"N'nu rẹ l'a gbọ t'Oludande,","marked":"N'nú rẹ̀ l'á gbọ́ t'Olùdáǹdè"},{"start":28.513,"end":29.62,"text":"N kede alafia;","marked":"Ń kéde àlàáfíà"},{"start":30.07,"end":31.554,"text":"Iro didun na jẹ iye,","marked":"Ìró dídùn ná jẹ́ iye"},{"start":32.004,"end":33.347,"text":"At'ayọ ailopin.","marked":"Àt'ayọ̀ àìlópin."}],"end":33.347},{"key":"5","start":34.297,"lines":[{"start":34.297,"end":35.846,"text":"Oluwa, Olukọ mimọ,","marked":"Olúwa, Olùkọ́ mímọ́"},{"start":36.296,"end":37.48,"text":"Ma sunmọ mi titi,","marked":"Má súnmọ́ mi títí"},{"start":37.93,"end":39.209,"text":"Kọ mi lati fẹ ọrọ Rẹ,","marked":"Kọ́ mi láti fẹ́ ọ̀rọ̀ Rẹ"},{"start":39.659,"end":40.907,"text":"Ki n ri Jesu nibẹ.","marked":"Kí n rí Jésù níbẹ̀."}],"end":40.907}]}