{"v":3,"coll":"y","num":43,"id":"hymn_43","title":"GBOGBO'ogun orun nro keke","duration":49.665,"voices":{"male":{"file":"y-43-male.m4a","bytes":370243,"sha256":"7c91c39dbc450af7f7ed4831a2b43aff6ac2722b5ad30b9de2d164c5a83f848c","duration":49.7},"female":{"file":"y-43-female.m4a","bytes":384086,"sha256":"b12bfe3fd92d08f99b8e6094e2b1aea84dbe58c966317d6a83743fe21559b3ea","duration":49.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.093,"text":"GBOGBO'ogun orun nro keke","marked":"Gbogbo'ogun orun ńrọ́ kẹ̀kẹ́"},{"start":2.473,"end":3.756,"text":"Angeli mu harpu won","marked":"Áńgẹ́lì mú harpu wọn"},{"start":4.136,"end":5.882,"text":"Awon mimo nt'ohun won se","marked":"Àwọn mímọ́ nt'ohun wọn ṣe"},{"start":6.262,"end":7.976,"text":"Lati josin t'o l'ogo","marked":"Láti jọ́sìn t'ó l'ògo"},{"start":8.356,"end":9.674,"text":"Ojo 'simi t'OIorun de","marked":"Ọjọ́ 'simi t'Ọlọ́run dé"},{"start":10.054,"end":11.536,"text":"Ojo t'o l'ogo julo","marked":"Ọjọ́ t'ó l'ògo jùlọ"},{"start":11.916,"end":13.253,"text":"Orun kun fun iho ayo","marked":"Ọ̀run kún fún ihò ayò"},{"start":13.633,"end":15.354,"text":"A! b'isin won ti dun to.","marked":"A! b'ìsìn wọn ti dùn tó."}],"end":15.354},{"key":"2","start":16.304,"lines":[{"start":16.304,"end":17.909,"text":"Jek'a pelu awon t'orun","marked":"Jek'á pẹ̀lú àwọn t'ọrun"},{"start":18.289,"end":19.258,"text":"Yin Olorun Oba wa","marked":"Yín Ọlọ́run Ọba wa"},{"start":19.638,"end":21.172,"text":"Jek'a pa 'le okan wa mo","marked":"Jẹ́k'á pa 'lé ọkàn wa mọ́"},{"start":21.552,"end":23.068,"text":"K'a f'ohun mimo korin","marked":"K'á f'ohun mímọ́́ kọrin"},{"start":23.448,"end":25.038,"text":"Apere ni ti wa le je","marked":"Apẹ̀rẹ̀ ní ti wá lè jẹ́"},{"start":25.418,"end":27.046,"text":"T'isimi ti won loke","marked":"T'isimi tì wọ́n lókè"},{"start":27.426,"end":28.671,"text":"Titi ao fi ri Oluwa","marked":"Títí aó fi rí Olúwa"},{"start":29.051,"end":30.406,"text":"Ti a nsin l'ojukoju.","marked":"Tí à ńsìn l'ojúkojú."}],"end":30.406},{"key":"3","start":31.356,"lines":[{"start":31.356,"end":33.74,"text":"K'o to d'igba na, e jeki","marked":"K'ó tó d'ígbà ná, ẹ jẹ́kí"},{"start":34.12,"end":35.544,"text":"A ma sin l'ojo keje","marked":"A ma sìn l'ọjọ́ keje"},{"start":35.924,"end":37.715,"text":"K'a f'aniyan wa s'apakan","marked":"K'á f'àníyàn wa s'ápàkan"},{"start":38.095,"end":39.617,"text":"K'a pe sinu ile Re","marked":"K'á pẹ́ sínú ilé Rẹ"},{"start":39.997,"end":41.361,"text":"O ti pase k'a ma se be","marked":"Ó ti pàṣẹ k'á má ṣe bẹ́"},{"start":41.741,"end":43.113,"text":"Y'o bukun ipejo wa","marked":"Y'ó bùkún ìpéjọ wa"},{"start":43.493,"end":44.97,"text":"E jek'a sin li aisaare","marked":"Ẹ jẹ́k'á sìn li àìsààrẹ̀"},{"start":45.35,"end":46.958,"text":"Ere re y'o je ti wa.","marked":"Eré rẹ y'ó jẹ́ ti wa."},{"start":47.338,"end":48.115,"text":"Amin.","marked":"Àmín."}],"end":48.115}]}