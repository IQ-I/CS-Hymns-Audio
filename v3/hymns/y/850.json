{"v":3,"coll":"y","num":850,"id":"hymn_850","title":"EGBE awon angeli","duration":85.359,"voices":{"male":{"file":"y-850-male-v3.m4a","bytes":597601,"sha256":"13a018bf549447de01465981c9e00b37f1097d9c635873ae813ed549cdc1e659","duration":85.4},"female":{"file":"y-850-female-v3.m4a","bytes":623049,"sha256":"3aed31fe437430113874e72b72e693352c218e483e22cedbb7467b6d2b3c9196","duration":85.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.528,"text":"ẸGBẸ awọn angeli,","marked":"Ẹgbẹ́ àwọn áńgẹ́lì"},{"start":1.978,"end":3.023,"text":"Ẹgbẹ ogun ọrun,","marked":"Ẹgbẹ́ ogun ọ̀run"},{"start":3.473,"end":4.816,"text":"Ẹgbẹ awọn Apostel,","marked":"Ẹgbẹ́ àwọn Apostel"},{"start":5.266,"end":6.098,"text":"Wọn Ẹni mimọ,","marked":"Wọ́n Ẹni mímọ́"},{"start":6.548,"end":7.614,"text":"Gbogbo wọn loke ọrun,","marked":"Gbogbo wọn lókè ọ̀run"},{"start":8.064,"end":9.409,"text":"N yin Ọ tọsan-toru,","marked":"N yín Ọ́ tọsan-toru"},{"start":9.859,"end":10.909,"text":"Ọlọrun Mẹtalọkan","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":11.359,"end":12.578,"text":"Ọga Ogo julọ.","marked":"Ọ̀gá Ògo jùlọ."}],"end":12.578},{"key":"2","start":13.528,"lines":[{"start":13.528,"end":14.942,"text":"Lẹgbẹgbẹ l'awa pejọ,","marked":"Lẹ́gbẹ̀gbẹ́ l'àwa péjọ"},{"start":15.392,"end":17.043,"text":"Niwaju Rẹ, Baba,","marked":"Níwájú Rẹ, Baba"},{"start":17.493,"end":18.659,"text":"Lati fi ọpẹ fun Ọ,","marked":"Láti fi ọpẹ́ fún Ọ"},{"start":19.109,"end":19.932,"text":"Pẹl' awọn ọrẹ wa,","marked":"Pẹl' àwọn ọ̀rẹ́ wa"},{"start":20.382,"end":21.664,"text":"Ọpẹ 'kore l'a mu wa,","marked":"Ọpẹ́ kórè l'a mú wá"},{"start":22.114,"end":23.238,"text":"F'Oluwa ikore;","marked":"F'Olúwa ìkórè"},{"start":23.688,"end":25.16,"text":"Ọlọrun, jọ sọkalẹ,","marked":"Ọlọ́run, jọ sọ̀kalẹ̀"},{"start":25.61,"end":27.113,"text":"F'ogo Rẹ kun 'le yi.","marked":"F'ògo Rẹ̀ kún lè yí."}],"end":27.113},{"key":"3","start":28.063,"lines":[{"start":28.063,"end":29.176,"text":"Larin ainiye ibi,","marked":"Lárin àìníye ibi"},{"start":29.626,"end":30.912,"text":"T'o rọgba yi wa ka,","marked":"T'ó rọ̀gbà yí wa ká"},{"start":31.362,"end":32.793,"text":"Larin ayida ayé,","marked":"Lárin àyídà ayé"},{"start":33.243,"end":34.226,"text":"Lẹhin 'kore esi,","marked":"Lẹ́hìn kórè èsì"},{"start":34.676,"end":35.817,"text":"Awa wa f'ọpẹ fun Ọ,","marked":"Àwa wá f'ọpẹ́ fún Ọ"},{"start":36.267,"end":37.66,"text":"N'tori 'Wọ da wa si;","marked":"N'torí 'Wọ dá wa sí"},{"start":38.11,"end":39.619,"text":"Loni, ọdun ikore,","marked":"Lónì, ọdún ìkórè"},{"start":40.069,"end":41.373,"text":"A f'ogo f'Okọ Rẹ.","marked":"A f'ògo f'Okọ Rẹ̀."}],"end":41.373},{"key":"4","start":42.323,"lines":[{"start":42.323,"end":43.6,"text":"'Gba Noa rubọ ọpẹ,","marked":"gba Noa rúbọ ọpẹ́"},{"start":44.05,"end":45.214,"text":"'Wọ f'osumare han,","marked":"'Wọ f'òṣùmárè hàn"},{"start":45.664,"end":46.773,"text":"Ami pe kikun omi,","marked":"Àmì pé kíkún omi"},{"start":47.223,"end":48.152,"text":"Ki o ba ayé mọ,","marked":"Kí ó bá ayé mọ́"},{"start":48.602,"end":49.879,"text":"Baba f'osumare han,","marked":"Baba f'òṣùmárè hàn"},{"start":50.329,"end":51.397,"text":"Nitori Jesu wa,","marked":"Nítorí Jésù wà"},{"start":51.847,"end":53.426,"text":"K'ipọnju oun banujẹ,","marked":"K'ìpọ́njú òun banújẹ́"},{"start":53.876,"end":55.13,"text":"Mase tun de ba wa.","marked":"Maṣe tún dé bá wa."}],"end":55.13},{"key":"5","start":56.08,"lines":[{"start":56.08,"end":57.355,"text":"Obinrin opo 'gbani,","marked":"Obìnrin ọ̀pọ̀ gbani"},{"start":57.805,"end":58.871,"text":"Ko ri pupọ mu wa,","marked":"Kò rí púpọ̀ mú wa"},{"start":59.321,"end":60.93,"text":"Sugbọn o ri 'bukun gba,","marked":"Sùgbọ́n ó rí bùkún gbà"},{"start":61.38,"end":62.638,"text":"Fun iwọn ti o le se,","marked":"Fún ìwọ̀n tí ó lè ṣe"},{"start":63.088,"end":65.218,"text":"Jesu, jọ yin wa loni,","marked":"Jésù, jọ yín wá lónì"},{"start":65.668,"end":66.817,"text":"Jẹ k'a ri 'bukun gba,","marked":"Jẹ́ k'á rí bùkún gbà"},{"start":67.267,"end":68.373,"text":"Tẹwọ gb'ọrẹ ọpẹ wa,","marked":"Tẹ́wọ́ gb'ọrẹ ọpẹ́ wa"},{"start":68.823,"end":70.18,"text":"B'o tilẹ salayé.","marked":"B'ó tilẹ̀ salayé."}],"end":70.18},{"key":"6","start":71.13,"lines":[{"start":71.13,"end":72.602,"text":"Awa mbẹ Ọ, Ọlọrun,","marked":"Àwa mbẹ́ Ọ, Ọlọ́run"},{"start":73.052,"end":74.035,"text":"Gba ọkan wa pẹlu,","marked":"Gba ọkàn wa pẹ̀lú"},{"start":74.485,"end":75.67,"text":"Ọkan ẹsẹ la mu wa,","marked":"Ọkàn ẹsẹ̀ la mú wá"},{"start":76.12,"end":77.177,"text":"Ẹgbin pọ ninu rẹ;","marked":"Ẹ̀gbin pọ̀ nínú rẹ̀"},{"start":77.627,"end":78.921,"text":"F'Ẹjẹ Rẹ mimọ Jesu,","marked":"F'Ẹ̀jẹ̀ Rẹ mímọ́ Jésù"},{"start":79.371,"end":80.334,"text":"Wẹ abawọn rẹ nu,","marked":"Wẹ àbàwọ́n rẹ̀ nù"},{"start":80.784,"end":82.165,"text":"K'ọkan ati ọrẹ wa,","marked":"K'ọkàn àti ọrẹ wa"},{"start":82.615,"end":83.811,"text":"J'ẹbọ ọpẹ fun Ọ.","marked":"J'ẹbọ ọpẹ́ fún Ọ."}],"end":83.811}]}