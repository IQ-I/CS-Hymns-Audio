{"v":3,"coll":"y","num":159,"id":"hymn_159","title":"ALEJO kan ma nkankun","duration":54.955,"voices":{"male":{"file":"y-159-male.m4a","bytes":390615,"sha256":"a5a8388eda674e8f08ff7ad79ad38b63e5c7854f6b8fb5df2ffa2acfb410a425","duration":55.0},"female":{"file":"y-159-female.m4a","bytes":401984,"sha256":"b1acefdff444da33e83d525a5edcb5c580cab1808008bf727bfe176aba4b080b","duration":55.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.981,"text":"ALEJO kan ma nkankun","marked":"Àlejò kan má nkankun"},{"start":2.361,"end":3.138,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":3.518,"end":5.163,"text":"O ti npara 'be ti pe","marked":"Ó ti ńpara 'bẹ̀ ti pẹ́"},{"start":5.543,"end":6.47,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":6.85,"end":8.391,"text":"Pe wole. ki O to lo,","marked":"Pé wọlé. kí O tó lọ"},{"start":8.771,"end":10.307,"text":"Pe wole, Emi Mimo","marked":"Pé wọlé, Ẹ̀mí Mímọ́́"},{"start":10.687,"end":12.175,"text":"Jesu krist'Omo Baba","marked":"Jésù krist'Ọmọ Bàbá"},{"start":12.555,"end":13.241,"text":"Pe wole.","marked":"Pé wọlé."}],"end":13.241},{"key":"2","start":14.191,"lines":[{"start":14.191,"end":15.495,"text":"Silekun okan re fun","marked":"Ṣílẹ̀kùn ọkàn rẹ fún"},{"start":15.875,"end":16.682,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":17.062,"end":18.96,"text":"B'o ba pe y'o pada lo","marked":"B'ó bá pẹ́ y'ó padà lọ"},{"start":19.34,"end":20.116,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":20.496,"end":22.159,"text":"Pe wole, Ore re ni","marked":"Pé wọlé, Ọ̀rẹ́ rẹ ni"},{"start":22.539,"end":23.914,"text":"Y'o dabobo okan re","marked":"Y'ó dábòbò ọkàn rẹ"},{"start":24.294,"end":25.696,"text":"Y'o pa o mo de opin,","marked":"Y'ó pa ọ́ mọ́ dé òpin"},{"start":26.076,"end":26.785,"text":"Pe wole.","marked":"Pé wọlé."}],"end":26.785},{"key":"3","start":27.735,"lines":[{"start":27.735,"end":29.158,"text":"O ko ha ngbo ohun Re?","marked":"O kò ha ńgbọ́ ohùn Rẹ?"},{"start":29.538,"end":30.272,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":30.652,"end":32.195,"text":"Yan l'ore nisisiyi","marked":"Yan l'ọ̀rẹ́ nisisiyi"},{"start":32.575,"end":33.432,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":33.812,"end":35.048,"text":"O nduro lenu 'lekun","marked":"Ó ńdúró lẹ́nu 'lẹ́kùn"},{"start":35.428,"end":36.6,"text":"Yio fun o li ayo","marked":"Yío fún ò li ayò"},{"start":36.98,"end":38.16,"text":"'Wo o yin oruko Re","marked":"'Wò ó yin orúkọ Rẹ"},{"start":38.54,"end":39.133,"text":"Pe wole.","marked":"Pé wọlé."}],"end":39.133},{"key":"4","start":40.083,"lines":[{"start":40.083,"end":41.157,"text":"P' Alejo Orun wole","marked":"P' Àlejò Ọ̀run wọ́lẹ̀"},{"start":41.537,"end":42.34,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":42.72,"end":44.376,"text":"Yio se ase fun o","marked":"Yío ṣe àṣẹ fún ọ"},{"start":44.756,"end":45.572,"text":"Pe wole","marked":"Pé wọ́lẹ̀"},{"start":45.952,"end":47.393,"text":"Y'o dari ese ji o,","marked":"Y'ó dárí ẹ̀ṣẹ̀ jì ọ́"},{"start":47.773,"end":49.714,"text":"'Gbat' o ba f'aiye sile","marked":"'Gbat' ò bá f'aiye sílẹ̀"},{"start":50.094,"end":51.47,"text":"Y'o mu o de 'le Orun","marked":"Y'ó mú ọ dé 'lé Ọ̀run"},{"start":51.85,"end":52.391,"text":"Pe wole.","marked":"Pé wọlé."},{"start":52.771,"end":53.405,"text":"Amin.","marked":"Àmín."}],"end":53.405}]}