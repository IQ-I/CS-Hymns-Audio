{"v":3,"coll":"y","num":25,"id":"hymn_25","title":"OLUWA awa de","duration":77.127,"voices":{"male":{"file":"y-25-male-v3.m4a","bytes":538004,"sha256":"f1347ea353738e22dc454d14f38cf1d8852f12c3a6135fa0478a7607c959fb2a","duration":77.2},"female":{"file":"y-25-female-v3.m4a","bytes":556131,"sha256":"c042348db551fdda1f90138a78e63794568e509a2d40bf88467d8e72cfbb5891","duration":77.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.255,"text":"OLUWA awa de,","marked":"Olúwa àwa dé"},{"start":1.705,"end":3.127,"text":"Lati yin O logo","marked":"Láti yìn Ọ́ lógo"},{"start":3.577,"end":5.676,"text":"Fun ayo nla t'a nyo loni","marked":"Fún ayọ̀ ńlá t'a ńyọ̀ lónì"},{"start":6.126,"end":7.216,"text":"Larin Egbe Seraf","marked":"Lárin Ẹgbẹ́ Seraf"}],"end":7.216},{"key":"CHORUS","start":8.166,"lines":[{"start":8.166,"end":9.786,"text":"Olugbala, a de","marked":"Olùgbàlà, a dé"},{"start":10.236,"end":11.329,"text":"Lati f'iyin fun O","marked":"Láti f'ìyìn fún Ọ"},{"start":11.779,"end":13.325,"text":"Ogo, Iyin, f'Oruko Re","marked":"Ògo, Ìyìn, f'Orúkọ Rẹ"},{"start":13.775,"end":14.788,"text":"Alagbara julo","marked":"Alágbára jùlọ"}],"end":14.788},{"key":"2","start":15.738,"lines":[{"start":15.738,"end":17.564,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":18.014,"end":19.276,"text":"Eyin ni'yo aye","marked":"Ẹ̀yin ní'yọ ayé"},{"start":19.726,"end":20.965,"text":"llu ta te sori oke","marked":"Ìlú ta tẹ́ sórí òkè"},{"start":21.415,"end":22.683,"text":"A ko le farasin","marked":"A kò lè farasin"},{"start":23.133,"end":24.844,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":24.844},{"key":"3","start":25.794,"lines":[{"start":25.794,"end":28.092,"text":"Kabiyesi! Oba,","marked":"Kábíyèsí! Ọba"},{"start":28.542,"end":29.9,"text":"Ogo f'Oruko Re!","marked":"Ògo f'Orúkọ Rẹ!"},{"start":30.35,"end":31.675,"text":"Fun iyanu Re larin wa,","marked":"Fún ìyanu Rẹ̀ lárin wa"},{"start":32.125,"end":33.516,"text":"Eyi t'a ko gbo ri","marked":"Èyí t'a kò gbọ́ rí"},{"start":33.966,"end":35.607,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":35.607},{"key":"4","start":36.557,"lines":[{"start":36.557,"end":37.667,"text":"Orin Halleluyah!","marked":"Orin Hallelúyà!"},{"start":38.117,"end":39.304,"text":"L'awa yio ma ko","marked":"L'àwa yóò má kọ"},{"start":39.754,"end":41.48,"text":"Awa y'o f'iye fo b'idi","marked":"Àwa y'ó f'ìyẹ́ fọ́ b'ìdí"},{"start":41.93,"end":43.16,"text":"Lehin irin ajo wa.","marked":"Lẹ́hìn irin àjọ wà."},{"start":43.61,"end":45.454,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":45.454},{"key":"5","start":46.404,"lines":[{"start":46.404,"end":47.659,"text":"Aiye sun m'Olorun","marked":"Ayé sùn m'Ọlọ́run"},{"start":48.109,"end":49.27,"text":"Akoko sunmo le:","marked":"Àkókò súnmọ́ lé"},{"start":49.72,"end":51.009,"text":"Ilekun anu fere ti,","marked":"Ìlẹ̀kùn àánú fèrè tí"},{"start":51.459,"end":52.622,"text":"E wa wo oko na.","marked":"Ẹ wá wọ oko ná."},{"start":53.072,"end":54.741,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":54.741},{"key":"6","start":55.691,"lines":[{"start":55.691,"end":57.081,"text":"Jesu, Olori wa,","marked":"Jésù, Olórí wa"},{"start":57.531,"end":58.683,"text":"A gb'oju wa si O,","marked":"A gb'ojú wá sí Ọ"},{"start":59.133,"end":61.048,"text":"'Wo l'ao ma yin titi aiye,","marked":"wò l'áò má yín títí ayé"},{"start":61.498,"end":63.047,"text":"Aiye ainipekun","marked":"Ayé àìnípẹ̀kun"},{"start":63.497,"end":65.144,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":65.144},{"key":"7","start":66.094,"lines":[{"start":66.094,"end":67.189,"text":"A f'ogo fun Baba","marked":"A f'ògo fún Baba"},{"start":67.639,"end":68.771,"text":"A f'ogo f'Omo Re","marked":"A f'ògo f'Ọmọ Rẹ"},{"start":69.221,"end":70.464,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":70.914,"end":72.338,"text":"Metalokan Iailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":72.788,"end":74.505,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"},{"start":74.955,"end":75.578,"text":"Amin.","marked":"Àmín."}],"end":75.578}]}