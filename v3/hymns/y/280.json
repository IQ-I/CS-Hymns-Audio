{"v":3,"coll":"y","num":280,"id":"hymn_280","title":"BABA alanu t'o fe wa","duration":24.493,"voices":{"male":{"file":"y-280-male-v3.m4a","bytes":165879,"sha256":"a5fa430a6bce418c85affaf13ce7d4f384d264e8ac4ccf5fa14efe554c49e5ca","duration":24.5},"female":{"file":"y-280-female-v3.m4a","bytes":173420,"sha256":"9cb830b0006174a53d610aef59f63e2b34dfaf50bb2d4d63cadf02a02c25fa9e","duration":24.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.576,"text":"BABA alanu t'o fẹ wa,","marked":"Baba alánú t'ó fẹ́ wà"},{"start":2.026,"end":3.201,"text":"Mo gb'ọkan mi si Ọ;","marked":"Mo gb'ọkàn mi sí Ọ"},{"start":3.651,"end":5.138,"text":"pa Rẹ t'o pọ l'o gba wa;","marked":"pa Rẹ t'ó pọ̀ l'ó gbà wá"},{"start":5.588,"end":6.928,"text":"Awa ń kọrin si Ọ.","marked":"Àwa ń kọrin sí Ọ."}],"end":6.928},{"key":"2","start":7.878,"lines":[{"start":7.878,"end":9.518,"text":"Tirẹ papa l'awa fe se,","marked":"Tirẹ̀ pápá l'àwa fẹ́ ṣe"},{"start":9.968,"end":11.061,"text":"Gb'ọkan wa fun ẹbọ;","marked":"Gb'ọkàn wà fún ẹbọ"},{"start":11.511,"end":13.43,"text":"O da wa, o si tun wa bi,","marked":"Ó dá wa, ó sì tún wá bí"},{"start":13.88,"end":15.2,"text":"A f'ara wa fun Ọ.","marked":"A f'ara wa fún Ọ."}],"end":15.2},{"key":"3","start":16.15,"lines":[{"start":16.15,"end":17.81,"text":"Emi Mimo, wa sodo mi,","marked":"Ẹ̀mí Mímọ́, wá sọ́dọ̀ mi"},{"start":18.26,"end":19.286,"text":"F'ife Oluwa han","marked":"F'ìfẹ́ Olúwa hàn"},{"start":19.736,"end":21.257,"text":"Fun mi k'emi k'o le ma rin","marked":"Fún mi k'èmi k'ó lè má rìn"},{"start":21.707,"end":22.944,"text":"N'ife Oluwa mi.","marked":"N'ìfẹ́ Olúwa mi."}],"end":22.944}]}