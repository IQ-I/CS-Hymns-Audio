{"v":3,"coll":"y","num":217,"id":"hymn_217","title":"JESU loruko to ga ju","duration":82.575,"voices":{"male":{"file":"y-217-male-v3.m4a","bytes":600220,"sha256":"499c03f702d704ff5b56be996fcf916fe8ca1907cb53df4ac1edeaa71bf8f121","duration":82.6},"female":{"file":"y-217-female-v3.m4a","bytes":621180,"sha256":"78ed51ad7524bbc9630d95e305b2ada1abdd010fc9bb7b8db77cfef256f54f17","duration":82.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.724,"text":"JESU loruko to ga","marked":"Jésù lorúkọ tó ga"},{"start":2.174,"end":3.324,"text":"ju, Layé a","marked":"ju, Layé a"},{"start":3.774,"end":5.433,"text":"ti lorun; Awon Angeli","marked":"ti lọ́rùn; Àwọn Áńgẹ́lì"},{"start":5.883,"end":16.227,"text":"wole fun, Esu, beru o sa. Ha! Ko s'ariyanjiyan mọ, Ipe miiran ko si, O daju wi pé Jesu ku, Ani f'emi ẹlẹsẹ.","marked":"wọlé fún, Èṣù, bẹ̀rù ó sá. Ha! Kò s'àríyànjiyàn mọ́, Ìpè mìíràn kò sí, Ó dájú wí pé Jésù kú, Àní f'ẹ̀mí ẹlẹ́sẹ̀."}],"end":16.227},{"key":"CHORUS","start":17.177,"lines":[{"start":17.177,"end":19.324,"text":"Ha! ko s' ariyanjiyan mo,","marked":"Ha! kò s àríyànjiyàn mọ́"},{"start":19.774,"end":20.977,"text":"Ipe miran ko si,","marked":"Ìpè míràn kò sí"},{"start":21.427,"end":23.094,"text":"O daju wipe Jesu ku,","marked":"Ó dájú wípé Jésù kú"},{"start":23.544,"end":24.702,"text":"A ni f' emi elese.","marked":"A ní f ẹ̀mí ẹlẹ́ṣẹ̀."}],"end":24.702},{"key":"2","start":25.652,"lines":[{"start":25.652,"end":27.403,"text":"Kérúbù ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":27.853,"end":29.093,"text":"Wọn yi 'tẹ Baba ka,","marked":"Wọ́n yí 'tẹ Baba ká"},{"start":29.543,"end":30.878,"text":"Nigba gbogbo niwaju Rẹ,","marked":"Nígbà gbogbo níwájú Rẹ̀"},{"start":31.328,"end":32.433,"text":"Wọn ń kọ orin iyin.","marked":"Wọ́n ń kọ orin ìyìn."}],"end":32.433},{"key":"3","start":33.383,"lines":[{"start":33.383,"end":34.566,"text":"Olugbala sẹgun iku,","marked":"Olùgbàlà sẹ́gun ikú"},{"start":35.016,"end":36.384,"text":"Ijọba Satan fọ;","marked":"Ìjọba Satan fọ́"},{"start":36.834,"end":38.326,"text":"Gbogbo ẹda ẹ bu sayọ,","marked":"Gbogbo ẹ̀dá ẹ bú sáyọ̀"},{"start":38.776,"end":40.022,"text":"Ka yin Baba logo.","marked":"Ká yín Baba lógo."}],"end":40.022},{"key":"4","start":40.972,"lines":[{"start":40.972,"end":42.635,"text":"Kérúbù ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":43.085,"end":44.289,"text":"Ẹ fẹran ara yin;","marked":"Ẹ fẹ́ràn ara yín"},{"start":44.739,"end":46.016,"text":"Ifẹ ni awọn Angẹli,","marked":"Ìfẹ́ ni àwọn Áńgẹ́lì"},{"start":46.466,"end":47.775,"text":"Fi ń sin Baba loke","marked":"Fi ń sin Baba lókè"}],"end":47.775},{"key":"5","start":48.725,"lines":[{"start":48.725,"end":50.453,"text":"Jesu, Olori Ijọ wa,","marked":"Jésù, Olórí Ìjọ wa"},{"start":50.903,"end":52.02,"text":"Bukun wa layé wa;","marked":"Bùkún wà layé wa"},{"start":52.47,"end":53.754,"text":"Jọwọ pese fun aini wa,","marked":"Jọ̀wọ́ pèsè fún àìní wa"},{"start":54.204,"end":55.643,"text":"K'ebi alẹ ma pa wa.","marked":"K'ebi alẹ́ má pa wá."}],"end":55.643},{"key":"6","start":56.593,"lines":[{"start":56.593,"end":58.099,"text":"Jehovah Jire Ọba wa,","marked":"Jehovah Jire Ọba wa"},{"start":58.549,"end":59.535,"text":"Iyin f'orukọ Rẹ;","marked":"Ìyìn f'orúkọ Rẹ"},{"start":59.985,"end":62.253,"text":"Ma jẹ ki oso at'ajẹ","marked":"Má jẹ́ kí ọ̀ṣọ́ àt'àjẹ́"},{"start":62.703,"end":64.03,"text":"Ri wa lọjọ ayé wa.","marked":"Rí wa lọ́jọ́ ayé wa."}],"end":64.03},{"key":"7","start":64.98,"lines":[{"start":64.98,"end":67.303,"text":"Jesu, fo itegun esu,","marked":"Jésù, fọ́ ìtẹ̀gùn èṣù"},{"start":67.753,"end":68.979,"text":"Iwo l'Oba Ogo;","marked":"Ìwọ l'Ọba Ògo"},{"start":69.429,"end":71.192,"text":"Iyin, ope ni fun Baba,","marked":"Ìyìn, ọpẹ́ ni fún Baba"},{"start":71.642,"end":81.026,"text":"Ni fun Metalokan. Ha! Ko s'ariyanjiyan mọ, Ipe miran ko si, O daju wi pé Jesu ku, Ani f' emi ẹlẹsẹ.","marked":"Ní fún Mẹ́talọ́kan. Ha! Kò s'àríyànjiyàn mọ́, Ìpè míràn kò sí, Ó dájú wí pé Jésù kú, Àní f ẹ̀mí ẹlẹ́sẹ̀."}],"end":81.026}]}