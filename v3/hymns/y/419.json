{"v":3,"coll":"y","num":419,"id":"hymn_419","title":"GB'OKAN mi gege b'o ti ri","duration":32.663,"voices":{"male":{"file":"y-419-male-v3.m4a","bytes":218107,"sha256":"2df26bbde9aa7c023a7a4e5aff638281b1e872d3da24c50c0f59d35b848a371b","duration":32.7},"female":{"file":"y-419-female-v3.m4a","bytes":229048,"sha256":"343f8f21b1076a51982e2faccb4d0664701c02c46d247f5d62bf2d928a8fd9e7","duration":32.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.239,"text":"GB'ỌKAN mi gẹgẹ b'o ti ri,","marked":"Gb'Ọkàn mi gẹ́gẹ́ b'ó ti rí"},{"start":2.689,"end":3.71,"text":"Tẹ itẹ Rẹ sibẹ;","marked":"Tẹ ìtẹ́ Rẹ síbẹ̀"},{"start":4.16,"end":5.998,"text":"Ki n le fẹ Ọ ju ayé lọ,","marked":"Kí n lè fẹ́ Ọ ju ayé lọ"},{"start":6.448,"end":7.768,"text":"Ki n wa fun Ọ nikan.","marked":"Kí n wá fún Ọ nìkan."}],"end":7.768},{"key":"2","start":8.718,"lines":[{"start":8.718,"end":9.936,"text":"Pari 'se Re Oluwa mi","marked":"Parí ṣe Rẹ Olúwa mi"},{"start":10.386,"end":11.351,"text":"Mu mi je oloto","marked":"Mú mi jẹ́ ọlọ́tọ̀"},{"start":11.801,"end":13.774,"text":"K'emi le gbohun Re, Jesu","marked":"K'èmi lè gbóhùn Rẹ, Jésù"},{"start":14.224,"end":15.419,"text":"Ti o kun fun ife.","marked":"Tí ó kún fún ìfẹ́."}],"end":15.419},{"key":"3","start":16.369,"lines":[{"start":16.369,"end":17.839,"text":"Ohun ti n ko mi n'ifẹ Rẹ,","marked":"Ohun tí ń kọ́ mi n'ìfẹ́ Rẹ"},{"start":18.289,"end":19.574,"text":"Ti n so 'hun ti mba se;","marked":"Tí ń sọ hun tí mbá ṣe"},{"start":20.024,"end":21.991,"text":"Ti n doju ti mi, nigba n ko","marked":"Tí ń dojú tì mí, nígbà ń kò"},{"start":22.441,"end":23.668,"text":"Ba tọpa ọna Rẹ.","marked":"Bá tọ̀pá ọ̀nà Rẹ."}],"end":23.668},{"key":"4","start":24.618,"lines":[{"start":24.618,"end":26.026,"text":"Emi 'ba ma ni ẹkọ yi,","marked":"Èmi bá má ni ẹ̀kọ́ yí"},{"start":26.476,"end":27.74,"text":"T'o n ti ọdọ Rẹ wa;","marked":"T'ó ń ti ọ̀dọ̀ Rẹ̀ wá"},{"start":28.19,"end":29.593,"text":"Ki n ko 'tẹriba s'ohun Rẹ,","marked":"Kí n kò 'tẹriba s'ohun Rẹ"},{"start":30.043,"end":31.114,"text":"At'ọrọ isọye.","marked":"Àt'ọ̀rọ̀ ìsọyé."}],"end":31.114}]}