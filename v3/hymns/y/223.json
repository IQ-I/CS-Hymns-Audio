{"v":3,"coll":"y","num":223,"id":"hymn_223","title":"OLORUN t'odun t'o koja","duration":50.392,"voices":{"male":{"file":"y-223-male-v3.m4a","bytes":357857,"sha256":"670ba82f076972ea534f0a0f60b2d0a63b2ec0d0f84b565a74e188297399d7fe","duration":50.4},"female":{"file":"y-223-female-v3.m4a","bytes":362272,"sha256":"5fdd0bc02bab8508517c82bd91a86f98a5321cdbdd8829cdda00991a943736fa","duration":50.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.016,"text":"OLORUN t'odun t'o koja","marked":"Ọlọ́run t'ọdún t'ó kọjá"},{"start":2.466,"end":3.816,"text":"Iret'eyi ti mbo","marked":"Ìrèt'èyí ti mbọ̀"},{"start":4.266,"end":5.592,"text":"Ib'isadi wa ni iji","marked":"Ìb'ìsádi wà ní ìjì"},{"start":6.042,"end":7.364,"text":"At'ile wa lailai.","marked":"Àt'ilẹ̀ wà láéláé."}],"end":7.364},{"key":"2","start":8.314,"lines":[{"start":8.314,"end":9.604,"text":"Labẹ ojiji itẹ Rẹ,","marked":"Lábẹ́ òjìji ìtẹ́ Rẹ"},{"start":10.054,"end":11.215,"text":"L'awọn eniyan Rẹ n gbe!","marked":"L'àwọn ènìyàn Rẹ̀ ń gbé!"},{"start":11.665,"end":13.657,"text":"f Titọ l'apa Rẹ nikansoso,","marked":"f Títọ́ l'apá Rẹ̀ nìkanṣoṣo"},{"start":14.107,"end":15.415,"text":"Abo wa si daju.","marked":"Abo wa sì dájú."}],"end":15.415},{"key":"3","start":16.365,"lines":[{"start":16.365,"end":17.666,"text":"K'awọn oke k'o to duro","marked":"K'àwọn òkè k'ó tó dúró"},{"start":18.116,"end":19.615,"text":"Tabi k'a to d'ayé,","marked":"Tàbí k'á tó d'ayé"},{"start":20.065,"end":21.425,"text":"Lailai Iwọ ni Ọlọrun,","marked":"Láéláé Ìwọ ni Ọlọ́run"},{"start":21.875,"end":23.821,"text":"Bakan naa, l'ailopin!","marked":"Bákan náà, l'àìlópin!"}],"end":23.821},{"key":"4","start":24.771,"lines":[{"start":24.771,"end":26.101,"text":"Ẹgbẹgbẹrun ọdun l'oju Rẹ,","marked":"Ẹgbẹgbẹ̀rún ọdún l'ojú Rẹ̀"},{"start":26.551,"end":27.811,"text":"Bi alẹ kan l'ori;","marked":"Bí alẹ́ kan l'orí"},{"start":28.261,"end":29.885,"text":"B'isọ kan l'afẹmọjumọ,","marked":"B'ìsọ́ kan l'àfẹ̀mọ́júmọ́"},{"start":30.335,"end":31.773,"text":"Ki orun k'o to la.","marked":"Kí ọ̀run k'ó tó là."}],"end":31.773},{"key":"5","start":32.723,"lines":[{"start":32.723,"end":34.327,"text":"Ọjọ wa bi odo sisan;","marked":"Ọjọ́ wa bí odò ṣíṣàn"},{"start":34.777,"end":36.15,"text":"Ọpọ l'o si n gbe lọ;","marked":"Ọ̀pọ̀ l'ó sì ń gbé lọ"},{"start":36.6,"end":38.729,"text":"Wọn n lọ, wọn di ẹni 'gbagbe;","marked":"Wọ́n ń lọ, wọ́n di ẹni gbàgbé"},{"start":39.179,"end":40.401,"text":"Bi ala ti a n rọ","marked":"Bí àlá tí à ń rọ̀"}],"end":40.401},{"key":"6","start":41.351,"lines":[{"start":41.351,"end":43.037,"text":"Olorun t'odun t'o koja","marked":"Ọlọ́run t'ọdún t'ó kọjá"},{"start":43.487,"end":44.83,"text":"Iret'eyi ti mbo","marked":"Ìrèt'èyí ti mbọ̀"},{"start":45.28,"end":47.041,"text":"Mas'abo wa 'gba 'yonu de,","marked":"Maṣ'abo wá gba yọnu dé"},{"start":47.491,"end":48.843,"text":"At'ile wa lailai.","marked":"Àt'ilẹ̀ wà láéláé."}],"end":48.843}]}