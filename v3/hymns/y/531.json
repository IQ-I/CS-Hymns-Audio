{"v":3,"coll":"y","num":531,"id":"hymn_531","title":"MO fe jinle si i ninu 'fe Jesu","duration":62.143,"voices":{"male":{"file":"y-531-male-v3.m4a","bytes":437395,"sha256":"a2b14b09e2cdaf6aaa7b465e0421486633f05f8f0a71f807fd764aa2b76da003","duration":62.2},"female":{"file":"y-531-female-v3.m4a","bytes":455817,"sha256":"0a944f7d5549a680a013ea34ea39a318fe065ce6aab718b820e9cb9b16fa052b","duration":62.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.303,"text":"MO fe jinle si i ninu 'fe Jesu","marked":"Mo fẹ́ jinlẹ̀ sí i nínú fẹ́ Jésù"},{"start":2.753,"end":3.585,"text":"Ni ojoojumo","marked":"Ní ojoojúmọ́"},{"start":4.035,"end":5.671,"text":"Ki n dagba si n'ile eko ogbon","marked":"Kí n dàgbà sí n'ilé ẹ̀kọ́ ọgbọ́n"},{"start":6.121,"end":7.247,"text":"At'oor-ofe Re.","marked":"At'oor-ofe Rẹ."},{"start":7.697,"end":8.909,"text":"Egbe:  Mo fe.. maa jinle si","marked":"Mo fẹ́ máa jinlẹ̀ sí"},{"start":9.359,"end":10.741,"text":"Ki n ga.. sii n'joojumo","marked":"Kí n ga síi n'joojúmọ́"},{"start":11.191,"end":12.577,"text":"Ki n si..ni ogbon sii","marked":"Kí n sì ní ọgbọ́n síi"},{"start":13.027,"end":14.342,"text":"N'nu oro yebiye Re.","marked":"N'nú ọ̀rọ̀ yẹbíye Rẹ."}],"end":14.342},{"key":"CHORUS","start":15.292,"lines":[{"start":15.292,"end":16.451,"text":"Mo fe.. maa jinle si","marked":"Mo fẹ́ máa jinlẹ̀ sí"},{"start":16.901,"end":18.452,"text":"Ki n ga.. sii n'joojumo","marked":"Kí n ga síi n'joojúmọ́"},{"start":18.902,"end":20.368,"text":"Ki n si..ni ogbon sii","marked":"Kí n sì ní ọgbọ́n síi"},{"start":20.818,"end":22.174,"text":"N'nu oro yebiye Re.","marked":"N'nú ọ̀rọ̀ yẹbíye Rẹ."}],"end":22.174},{"key":"2","start":23.124,"lines":[{"start":23.124,"end":24.703,"text":"Mo fe jinle iwo Emi Mimo","marked":"Mo fẹ́ jinlẹ̀ ìwọ Ẹ̀mí Mímọ́"},{"start":25.153,"end":26.363,"text":"Mu mi jinle sii","marked":"Mú mi jinlẹ̀ síi"},{"start":26.813,"end":28.688,"text":"Ti gbogb'aye mi yoo je ti Jesu","marked":"Tí gbogb'ayé mi yóò jẹ́ ti Jésù"},{"start":29.138,"end":30.097,"text":"Ati ife Re.","marked":"Àti ìfẹ́ Rẹ̀."},{"start":30.547,"end":31.775,"text":"Egbe:  Mo fe.. maa jinle si...","marked":"Mo fẹ́ máa jinlẹ̀ sí"}],"end":31.775},{"key":"3","start":32.725,"lines":[{"start":32.725,"end":35.526,"text":"Mo fe jinle, b'idanwo tile de","marked":"Mo fẹ́ jinlẹ̀, b'ìdánwò tilẹ̀ dé"},{"start":35.976,"end":37.278,"text":"Mu mi jinle si i","marked":"Mú mi jinlẹ̀ sí i"},{"start":37.728,"end":39.771,"text":"Ki n fi gbongbo mule n'nu 'fe Jesu","marked":"Kí n fi gbòǹgbò múlẹ̀ n'nú fẹ́ Jésù"},{"start":40.221,"end":41.579,"text":"Jeki n' s'eso si i.","marked":"Jẹ́kí ń s'èso sí i."},{"start":42.029,"end":43.273,"text":"Egbe:  Mo fe.. maa jinle si...","marked":"Mo fẹ́ máa jinlẹ̀ sí"}],"end":43.273},{"key":"4","start":44.223,"lines":[{"start":44.223,"end":46.833,"text":"Ki n jinle, ki n dagba ninu Jesu","marked":"Kí n jinlẹ̀, kí n dàgbà nínú Jésù"},{"start":47.283,"end":48.459,"text":"Tit'ija yoo tan","marked":"Tít'ìjà yóò tán"},{"start":48.909,"end":50.935,"text":"Si se mi ni asegun bi i ti Re","marked":"Sì ṣe mí ní aṣẹ́gun bí i ti Rẹ"},{"start":51.385,"end":52.289,"text":"Titi de opin.","marked":"Títí dé òpin."},{"start":52.739,"end":53.984,"text":"Egbe:  Mo fe.. maa jinle si","marked":"Mo fẹ́ máa jinlẹ̀ sí"},{"start":54.434,"end":55.9,"text":"Ki n ga.. sii n'joojumo","marked":"Kí n ga síi n'joojúmọ́"},{"start":56.35,"end":57.744,"text":"Ki n si..ni ogbon sii","marked":"Kí n sì ní ọgbọ́n síi"},{"start":58.194,"end":59.547,"text":"N'nu oro yebiye Re.","marked":"N'nú ọ̀rọ̀ yẹbíye Rẹ."},{"start":59.997,"end":60.594,"text":"Amin.","marked":"Àmín."}],"end":60.594}]}