{"v":3,"coll":"y","num":28,"id":"hymn_28","title":"OLORUN ojo isinmi","duration":46.095,"voices":{"male":{"file":"y-28-male-v3.m4a","bytes":318647,"sha256":"c5e9c680fb03103d355140f8635e07c6b604db3395487879f1225de576307a48","duration":46.1},"female":{"file":"y-28-female-v3.m4a","bytes":329289,"sha256":"c7bc1bcef55a2b9db23d887e08ab7ace989ffe57c40070fd7e5ce681f043d8bf","duration":46.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.368,"text":"ỌLỌRUN ọjọ 'sinmi","marked":"Ọlọ́run ọjọ́ sinmi"},{"start":1.818,"end":3.16,"text":"Sọkalẹ l'agbara Rẹ","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀"},{"start":3.61,"end":4.838,"text":"Pasẹ 'bukun t'oke wa","marked":"Pasẹ̀ bùkún t'òkè wá"},{"start":5.288,"end":6.537,"text":"Jẹ ka ri Ọ larin wa.","marked":"Jẹ́ ká rí Ọ lárin wa."}],"end":6.537},{"key":"2","start":7.487,"lines":[{"start":7.487,"end":9.313,"text":"Jẹ ka wa Ọ, ka ri Ọ","marked":"Jẹ́ ká wá Ọ, ká rí Ọ"},{"start":9.763,"end":10.884,"text":"Ni Ọlọrun Kérúbù;","marked":"Ní Ọlọ́run Kérúbù"},{"start":11.334,"end":12.576,"text":"Ko ran ifẹ rere Rẹ","marked":"Kò rán ìfẹ́ rere Rẹ̀"},{"start":13.026,"end":14.362,"text":"Sarin Ẹgbẹ Séráfù.","marked":"Sarin Ẹgbẹ́ Séráfù."}],"end":14.362},{"key":"3","start":15.312,"lines":[{"start":15.312,"end":16.522,"text":"Mu ki gbogbo agbayé,","marked":"Mú kí gbogbo agbayé"},{"start":16.972,"end":18.045,"text":"Tẹti sọrọ mimọ Rẹ,","marked":"Tẹ́tí sọ̀rọ̀ mímọ́ Rẹ"},{"start":18.495,"end":19.59,"text":"M'alagidi tẹriba,","marked":"M'alágídí tẹríba"},{"start":20.04,"end":21.844,"text":"S'ọkan t'o ku d'alaye.","marked":"S'ọkàn t'ó kù d'àlàyé."}],"end":21.844},{"key":"4","start":22.794,"lines":[{"start":22.794,"end":23.94,"text":"Ẹni n wa Ọ ko ri Ọ,","marked":"Ẹni ń wá Ọ kò rí Ọ"},{"start":24.39,"end":25.728,"text":"Ẹni n subu gbe dide;","marked":"Ẹní ń ṣubú gbé dìde"},{"start":26.178,"end":28.272,"text":"W'alaisan, at'afọju,","marked":"W'aláìsàn, àt'afọ́jú"},{"start":28.722,"end":30.082,"text":"Ki gbogbo wa jọ yin Ọ.","marked":"Kí gbogbo wa jọ yín Ọ."}],"end":30.082},{"key":"5","start":31.032,"lines":[{"start":31.032,"end":32.083,"text":"Bukun ọrọ mimọ Rẹ,","marked":"Bùkún ọ̀rọ̀ mímọ́ Rẹ"},{"start":32.533,"end":33.95,"text":"To ran wa lakoko yi;","marked":"Tó ràn wá lákokò yí"},{"start":34.4,"end":35.814,"text":"Je k'ayé fi se'wa hu","marked":"Jẹ́ k'ayé fi ṣe'wà hù"},{"start":36.264,"end":37.545,"text":"L'agbara Mẹtalọkan.","marked":"L'agbára Mẹ́talọ́kan."}],"end":37.545},{"key":"6","start":38.495,"lines":[{"start":38.495,"end":39.647,"text":"Ogo ni fun Baba wa,","marked":"Ògo ni fún Baba wa"},{"start":40.097,"end":41.252,"text":"Ogo ni fun Omo Re,","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":41.702,"end":42.936,"text":"Ogo ni f'Emi Mimo","marked":"Ògo ni f'Ẹ̀mí Mímọ́"},{"start":43.386,"end":44.545,"text":"Ogo fun Metalokan.","marked":"Ògo fún Mẹ́talọ́kan."}],"end":44.545}]}