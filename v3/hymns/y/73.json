{"v":3,"coll":"y","num":73,"id":"hymn_73","title":"Mimo, Mimo, Mimo Olodumare","duration":44.754,"voices":{"male":{"file":"y-73-male-v3.m4a","bytes":320727,"sha256":"f54ca35cb3f76dbb6620c5b9ac4f269345dc2b3421ff753eb7851daefca435a1","duration":44.8},"female":{"file":"y-73-female-v3.m4a","bytes":326909,"sha256":"f558902a69a4065dc92968eadd2332d158e1b43f27f0d65f0259670148be26b4","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.527,"text":"Mimo, Mimo, Mimo Olodumare,","marked":"Mímọ́, Mímọ́, Mímọ́ Olódùmarè"},{"start":2.977,"end":5.36,"text":"Ni kutukutu ni 'wo o gbo orin wa,","marked":"Ní kùtùkùtù ni wò ó gbọ́ orin wá"},{"start":5.81,"end":8.215,"text":"Mimo, Mimo, Mimo! Oniyonu julo,","marked":"Mímọ́, Mímọ́, Mímọ́! Oníyọnu jùlọ"},{"start":8.665,"end":10.313,"text":"Ologo meta lai Olubukun.","marked":"Ológo mẹ́ta láì Olùbùkún."}],"end":10.313},{"key":"2","start":11.263,"lines":[{"start":11.263,"end":14.297,"text":"Mimo, Mimo, Mimo awon t'orun nyin","marked":"Mímọ́, Mímọ́, Mímọ́ àwọn t'ọ̀run yín"},{"start":14.747,"end":16.816,"text":"Nwon nfi ade wura won lele y'ite ka,","marked":"Wọ́n ńfi adé wúrà wọn lélẹ̀ y'ìtẹ́ ká"},{"start":17.266,"end":19.505,"text":"Kerubim Serafim nwole niwaju Re,","marked":"Kerubim Serafim ńwọlé níwájú Rẹ̀"},{"start":19.955,"end":22.104,"text":"Wo to ti wa to si wa titi lai.","marked":"Wo tó ti wá tó sì wá títí láì."}],"end":22.104},{"key":"3","start":23.054,"lines":[{"start":23.054,"end":25.056,"text":"Mimo, Mimo, Mimo, Olodumare","marked":"Mímọ́, Mímọ́, Mímọ́, Olódùmarè"},{"start":25.506,"end":27.47,"text":"Bi oju elese ko le ri Ogo Re,","marked":"Bí ojú ẹlẹ́ṣẹ̀ kò lè rí Ògo Rẹ"},{"start":27.92,"end":29.951,"text":"lwo nikan lo mo ko tun si elomi","marked":"Ìwọ nìkan lọ mọ́ kò tún sí ẹlòmí"},{"start":30.401,"end":32.416,"text":"Pipe 'nu agbara ati n'ife.","marked":"Pípẹ́ nù agbára àti n'ìfẹ́."}],"end":32.416},{"key":"4","start":33.366,"lines":[{"start":33.366,"end":35.46,"text":"Mimo, Mimo, Mimo Olodumare,","marked":"Mímọ́, Mímọ́, Mímọ́ Olódùmarè"},{"start":35.91,"end":37.995,"text":"Gbogbo ise Re n'ile l'oke lo nyin O,","marked":"Gbogbo iṣẹ́ Rẹ̀ n'ilẹ̀ l'òkè ló yín Ọ"},{"start":38.445,"end":41.097,"text":"Mimo, Mimo, Mimo Oniyonu julo","marked":"Mímọ́, Mímọ́, Mímọ́ Oníyọnu jùlọ"},{"start":41.547,"end":43.204,"text":"Ologo meta lai Olubukun.","marked":"Ológo mẹ́ta láì Olùbùkún."}],"end":43.204}]}