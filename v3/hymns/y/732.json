{"v":3,"coll":"y","num":732,"id":"hymn_732","title":"BABA Aladura mura","duration":66.327,"voices":{"male":{"file":"y-732-male.m4a","bytes":488288,"sha256":"7e55db6e190c1bae632cca09f3c37d61618c446d0589cfe8f46d1c880c3ee8c2","duration":66.4},"female":{"file":"y-732-female.m4a","bytes":505503,"sha256":"baa560fa8f9b7d4b76fa7bf6e0bff8d80a6802fff7a5c4196ffe2e76ea71dc6b","duration":66.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.538,"text":"BABA Aladura mura","marked":"Bàbá Alàdúrà múra"},{"start":1.918,"end":3.239,"text":"Lati pade Kerubu","marked":"Láti pàdé Kérúbù"},{"start":3.619,"end":5.959,"text":"Jesu lo pe o, lo yan o","marked":"Jésù ló pè ọ́, ló yàn ọ́"},{"start":6.339,"end":7.835,"text":"Lati d'Egbe yi sile","marked":"Láti d'Ẹgbẹ́ yí sílẹ̀"},{"start":8.215,"end":9.865,"text":"O si pe gbogbo aiye lati wo","marked":"Ó sì pe gbogbo àìyẹ láti wò"},{"start":10.245,"end":11.187,"text":"'ko 'gbala yi","marked":"'ko 'gbàlà yí"},{"start":11.567,"end":13.12,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":13.12},{"key":"CHORUS","start":14.07,"lines":[{"start":14.07,"end":15.702,"text":"Ojo nlo, ojo nlo - 2ce","marked":"Ọjọ́ ńlọ, ọjọ́ ńlò"},{"start":16.082,"end":17.697,"text":"Ise po t'awa o se","marked":"Iṣẹ́ pọ̀ t'áwá ò ṣe"},{"start":18.077,"end":19.484,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":19.484},{"key":"2","start":20.434,"lines":[{"start":20.434,"end":21.745,"text":"Egbe Aladura mura","marked":"Ẹgbẹ́ Alàdúrà múra"},{"start":22.125,"end":23.368,"text":"Lati pade Kerubu","marked":"Láti pàdé Kérúbù"},{"start":23.748,"end":25.419,"text":"E ma je k'amure nyin tu","marked":"Ẹ má jẹ k'ámùrè nyin tu"},{"start":25.799,"end":27.163,"text":"Lati pade Kerubu","marked":"Láti pàdé Kérúbù"},{"start":27.543,"end":28.836,"text":"Gbe Ida 'segun s'oke","marked":"Gbé Idà 'ṣẹ́gun s'òkè"},{"start":29.216,"end":30.576,"text":"Iye s'Olorun Daniel","marked":"Iye s'Ọlọ́run Daniel"},{"start":30.956,"end":32.582,"text":"Alleluyah! Jesu mbo","marked":"Allelúyàh! Jésù ḿbọ̀"},{"start":32.962,"end":34.346,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":34.346},{"key":"3","start":35.296,"lines":[{"start":35.296,"end":36.505,"text":"Olorun Metalokan wa,","marked":"Ọlọ́run Mẹ́talọ́kan wa"},{"start":36.885,"end":38.257,"text":"Lati gbo adura wa","marked":"Láti gbọ́ àdúrà wa"},{"start":38.637,"end":40.346,"text":"Jesu Olugbala Oba","marked":"Jésù Olùgbàlà Ọba"},{"start":40.726,"end":41.827,"text":"Jowo gb'ebo ope wa","marked":"Jọ̀wọ́ gb'ẹbọ ọpẹ́ wa"},{"start":42.207,"end":43.361,"text":"Emi Mimo sokale","marked":"Ẹ̀mí Mímọ́́ sọ̀kalẹ̀"},{"start":43.741,"end":45.158,"text":"F'ore-ofe ba wa gbe","marked":"F'ọ̀rẹ́-ọ̀fẹ́ bá wa gbé"},{"start":45.538,"end":47.035,"text":"Ise po t'awa o se","marked":"Iṣẹ́ pọ̀ t'áwá ò ṣe"},{"start":47.415,"end":48.857,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":48.857},{"key":"4","start":49.807,"lines":[{"start":49.807,"end":51.373,"text":"Okun fe so gbogbo wa po","marked":"Okun fẹ́ so gbogbo wa pọ̀"},{"start":51.753,"end":53.18,"text":"B'ojo wa ti nkoja lo","marked":"B'ọjọ́ wa ti ńkọjá lọ"},{"start":53.56,"end":55.202,"text":"Kankan lao fa won s'agbo Re","marked":"Kankan láó fà wọ́n s'agbo Rẹ̀"},{"start":55.582,"end":57.192,"text":"B'ojo wa ti nkoja lo","marked":"B'ọjọ́ wa ti ńkọjá lọ"},{"start":57.572,"end":58.918,"text":"Sugbon eso oro Re","marked":"Ṣùgbọ́n èso ọ̀rọ̀ Rẹ"},{"start":59.298,"end":61.011,"text":"Ndagba l'osan at'oru","marked":"Ndagba l'ọ̀sán àt'oru"},{"start":61.391,"end":62.89,"text":"Gb'awon to subu dide","marked":"Gb'àwọn tó ṣubú dìde"},{"start":63.27,"end":64.778,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":64.778}]}