{"v":3,"coll":"y","num":326,"id":"hymn_326","title":"OLUWA ji l'oto","duration":32.22,"voices":{"male":{"file":"y-326-male-v3.m4a","bytes":222234,"sha256":"f6f10f31283300defafd1f0e7b8f166fcf52b2ed4450ac24b14a9bbd0c68eaf2","duration":32.3},"female":{"file":"y-326-female-v3.m4a","bytes":228366,"sha256":"1375f64c0c0bdeceec025a089a4ed88a5341e66cc0ea862e9e3ce258d6211494","duration":32.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.54,"text":"OLUWA ji l'otọ,","marked":"Olúwa jí l'òtọ̀"},{"start":1.99,"end":3.274,"text":"Ihin na ha s'otọ?","marked":"Ìhín ná ha s'òtọ̀?"},{"start":3.724,"end":5.373,"text":"Wọn ti ri p'Olugbala ku,","marked":"Wọ́n ti rí p'Olùgbàlà kú"},{"start":5.823,"end":7.184,"text":"Wọn ri l'aye pẹlu.","marked":"Wọ́n rí l'ayé pẹ̀lú."}],"end":7.184},{"key":"2","start":8.134,"lines":[{"start":8.134,"end":9.597,"text":"fOluwa ji l'ootọ,","marked":"folúwa jí l'òótọ́"},{"start":10.047,"end":11.402,"text":"Otọ ko fẹ ju yi;","marked":"Òtọ̀ kò fẹ́ ju yí"},{"start":11.852,"end":13.761,"text":"Anu at'otitọ pade,","marked":"Àánú àt'òtítọ́ pàdé"},{"start":14.211,"end":15.583,"text":"Ti wọn ti n s'ọta ri.","marked":"Tí wọ́n ti ń s'ọ̀tá rí."}],"end":15.583},{"key":"3","start":16.533,"lines":[{"start":16.533,"end":17.87,"text":"Oluwa ji l'ootọ,","marked":"Olúwa jí l'òótọ́"},{"start":18.32,"end":19.448,"text":"Isẹ Rẹ l'o se tan;","marked":"Isẹ́ Rẹ l'ó ṣe tán"},{"start":19.898,"end":21.295,"text":"A da ide onigbọwọ,","marked":"A dá idẹ onígbọ̀wọ́"},{"start":21.745,"end":22.948,"text":"A sẹ apa iku.","marked":"A sẹ́ apá ikú."}],"end":22.948},{"key":"4","start":23.898,"lines":[{"start":23.898,"end":25.218,"text":"Oluwa ji l'ootọ,","marked":"Olúwa jí l'òótọ́"},{"start":25.668,"end":27.015,"text":"Boji ko le se mọ;","marked":"Bojì kò lè ṣe mọ́"},{"start":27.465,"end":28.944,"text":"Awọn t'o ku si ji pẹlu,","marked":"Àwọn t'ó kù sì jí pẹ̀lú"},{"start":29.394,"end":30.671,"text":"Wọn ki o si ku mọ.","marked":"Wọn kí ó sì kú mọ́."}],"end":30.671}]}