{"v":3,"coll":"y","num":473,"id":"hymn_473","title":"GBEKELE onigbagbo","duration":30.851,"voices":{"male":{"file":"y-473-male-v3.m4a","bytes":204137,"sha256":"f74354a2eeeaafb9d5a28282d2441b621abe99a9c2670bff05b483c9e156db9c","duration":30.9},"female":{"file":"y-473-female-v3.m4a","bytes":215933,"sha256":"b868c3fb7bf61842476ed5dde6f755a8730f73caa1d43620674af13d5c19c76d","duration":30.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.606,"text":"GBEKELE onigbagbo","marked":"Gbẹ́kẹ̀lé onígbàgbọ́"},{"start":2.056,"end":3.388,"text":"Bi 'ja na tile pe","marked":"Bí jà ná tilẹ̀ pé"},{"start":3.838,"end":5.156,"text":"Iwo ni yio sa segun","marked":"Ìwọ ni yóò sá ṣẹ́gun"},{"start":5.606,"end":6.817,"text":"Baba y'o ja fun o.","marked":"Baba y'ó jà fún ọ."}],"end":6.817},{"key":"CHORUS","start":7.767,"lines":[{"start":7.767,"end":8.775,"text":"Sa gbekele!","marked":"Sá gbẹ́kẹ̀lé!"},{"start":9.225,"end":10.695,"text":"B'okunkun tile su","marked":"B'òkùnkùn tilẹ̀ ṣú"},{"start":11.145,"end":12.247,"text":"Sa gbekele!","marked":"Sá gbẹ́kẹ̀lé!"},{"start":12.697,"end":13.921,"text":"Ile fere mo na.","marked":"Ilẹ̀ fẹ́rẹ́ mọ́ ná."}],"end":13.921},{"key":"2","start":14.871,"lines":[{"start":14.871,"end":16.027,"text":"Gbekele larin ewu","marked":"Gbẹ́kẹ̀lé lárin ewu"},{"start":16.477,"end":17.99,"text":"Danwo nla wa n'tosi","marked":"Dánwò ńlá wa n'tòsí"},{"start":18.44,"end":19.526,"text":"Larin wahala aiye","marked":"Lárin wàhálà ayé"},{"start":19.976,"end":21.169,"text":"Baba ma s'amona.","marked":"Baba má s'amọ̀nà."}],"end":21.169},{"key":"3","start":22.119,"lines":[{"start":22.119,"end":23.874,"text":"Jesu to lati gba wa","marked":"Jésù tọ̀ láti gbà wá"},{"start":24.324,"end":25.307,"text":"Ore toto l'Oje","marked":"Ọrẹ tótọ́ l'Òjé"},{"start":25.757,"end":27.404,"text":"Gbekele, onigbagbo","marked":"Gbẹ́kẹ̀lé, onígbàgbọ́"},{"start":27.854,"end":29.301,"text":"Sa gbekele dopin.","marked":"Sá gbẹ́kẹ̀lé dópin."}],"end":29.301}]}