{"v":3,"coll":"y","num":333,"id":"hymn_333","title":"Oro ayo na de","duration":26.933,"voices":{"male":{"file":"y-333-male-v3.m4a","bytes":179068,"sha256":"e7018983f58120ea1c9044f8f590630696c698a2759cfc69f178cbb77b1f9459","duration":27.0},"female":{"file":"y-333-female-v3.m4a","bytes":182814,"sha256":"bde19a7341a477548a28ff656bb9b2dfaeb9298787e916397f8dee86975440aa","duration":27.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.423,"text":"Ọrọ ayo na de","marked":"Ọ̀rọ̀ ayọ̀ nà dé"},{"start":1.873,"end":2.775,"text":"Olugbala bori","marked":"Olùgbàlà borí"},{"start":3.225,"end":4.387,"text":"O fi 'boji sile","marked":"Ó fi bojì sílẹ̀"},{"start":4.837,"end":5.862,"text":"Bi Olodumare.","marked":"Bí Olódùmarè."}],"end":5.862},{"key":"CHORUS","start":6.812,"lines":[{"start":6.812,"end":8.463,"text":"A d'igbekun ni'gbekun lo,","marked":"A d'ìgbèkùn ní'gbèkùn lọ"},{"start":8.913,"end":10.702,"text":"Jesu t'o ku di alaye.","marked":"Jésù t'ó kú di àlàyé."}],"end":10.702},{"key":"2","start":11.652,"lines":[{"start":11.652,"end":12.714,"text":"Onigbọwọ wa ku,","marked":"Onígbọ̀wọ́ wa kú"},{"start":13.164,"end":14.243,"text":"Tani to fi wa sun?","marked":"Tani tó fi wá sùn?"},{"start":14.693,"end":15.77,"text":"Baba dawa lare:","marked":"Baba dàwà láre"},{"start":16.22,"end":17.331,"text":"Tal'o to da ẹbi?","marked":"Tál'ó tó dá ẹ̀bi?"}],"end":17.331},{"key":"3","start":18.281,"lines":[{"start":18.281,"end":19.188,"text":"Kristi ti san","marked":"Kristi ti sàn"},{"start":19.638,"end":20.671,"text":"gbese Ise ogo","marked":"gbèsè Iṣẹ́ ògo"},{"start":21.121,"end":22.366,"text":"pari O ti ran wa","marked":"parí Ó ti ràn wá"},{"start":22.816,"end":24.049,"text":"lowo O ti ba wa","marked":"lọ́wọ́ Ó ti bá wa"},{"start":24.499,"end":25.383,"text":"segun.","marked":"ṣẹ́gun."}],"end":25.383}]}