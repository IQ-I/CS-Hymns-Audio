{"v":3,"coll":"y","num":277,"id":"hymn_277","title":"KRIST' ki 'joba Re de","duration":43.872,"voices":{"male":{"file":"y-277-male-v3.m4a","bytes":299105,"sha256":"ca9af84606ebcbffaa5ee15f13bd87a65a1f8c61e43fbc15c7d19d7a327e8f89","duration":43.9},"female":{"file":"y-277-female-v3.m4a","bytes":313319,"sha256":"85e93a8ca438e1e90117deb6f692cb3a094eb3ddf3bdc379b01e8aa951e2fc10","duration":43.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.8,"text":"KRIST' ki 'joba Re de","marked":"Krist kí jọba Rẹ̀ dé"},{"start":2.25,"end":3.31,"text":"Ki ase Re bere","marked":"Kí àṣẹ Rẹ bẹ̀rẹ̀"},{"start":3.76,"end":5.084,"text":"F'opa-irin Re fo","marked":"F'opa-irin Rẹ̀ fọ́"},{"start":5.534,"end":6.717,"text":"Gbogbo ipa ese.","marked":"Gbogbo ipa ẹ̀ṣẹ̀."}],"end":6.717},{"key":"2","start":7.667,"lines":[{"start":7.667,"end":8.714,"text":"Ijọba ifẹ da,","marked":"Ìjọba ìfẹ́ dá"},{"start":9.164,"end":10.321,"text":"Ati t'alafia?","marked":"Àti t'àlàáfíà?"},{"start":10.771,"end":11.901,"text":"Gba wo ni irira,","marked":"Gba wo ní ìríra"},{"start":12.351,"end":13.504,"text":"Yoo tan bi t'ọrun?","marked":"Yóò tàn bí t'ọ̀run?"}],"end":13.504},{"key":"3","start":14.454,"lines":[{"start":14.454,"end":15.766,"text":"Akoko naa ha da,","marked":"Àkókò náà ha dá"},{"start":16.216,"end":17.589,"text":"T'ọtẹ yoo pari,","marked":"T'ọ̀tẹ̀ yóò parí"},{"start":18.039,"end":19.194,"text":"Ika at'irẹjẹ,","marked":"Ìkà àt'ìrẹ́jẹ"},{"start":19.644,"end":20.879,"text":"Pẹlu ifẹkufẹ?","marked":"Pẹ̀lú ìfẹ́kúfẹ́?"}],"end":20.879},{"key":"4","start":21.829,"lines":[{"start":21.829,"end":23.225,"text":"Oluwa jọ, dide,","marked":"Olúwa jọ, dìde"},{"start":23.675,"end":24.858,"text":"Wa n'nu agbara Rẹ:","marked":"Wá n'nú agbára Rẹ"},{"start":25.308,"end":26.447,"text":"Fi ayọ fun awa,","marked":"Fi ayọ̀ fún àwa"},{"start":26.897,"end":28.007,"text":"Ti o n s'aferi Rẹ.","marked":"Tí ó ń s'àfẹ́rí Rẹ."}],"end":28.007},{"key":"5","start":28.957,"lines":[{"start":28.957,"end":30.292,"text":"Ẹda ń gan ookọ Rẹ,","marked":"Ẹ̀dá ń gan òókọ Rẹ̀"},{"start":30.742,"end":32.203,"text":"Koko ń jẹ agbo Rẹ;","marked":"Kọ́kọ́ ń jẹ́ agbo Rẹ̀"},{"start":32.653,"end":33.726,"text":"Iwa 'tiju pupọ,","marked":"Ìwà tijú púpọ̀"},{"start":34.176,"end":35.526,"text":"Nfihan pe'fẹ tutu.","marked":"Ǹfihàn pé'fẹ́ tútù."}],"end":35.526},{"key":"6","start":36.476,"lines":[{"start":36.476,"end":37.594,"text":"Okun bolẹ sibẹ,","marked":"Òkun bolẹ̀ síbẹ̀"},{"start":38.044,"end":39.032,"text":"Ni ilẹ Keferi;","marked":"Ní ilẹ̀ Kèfèrí"},{"start":39.482,"end":40.541,"text":"Dide 'Rawọ oorọ,","marked":"Dìde 'Rawọ oorọ"},{"start":40.991,"end":42.323,"text":"Dide, mase wọ mọ.","marked":"Dìde, máṣe wọ mọ́."}],"end":42.323}]}