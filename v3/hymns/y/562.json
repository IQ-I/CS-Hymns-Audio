{"v":3,"coll":"y","num":562,"id":"hymn_562","title":"LARIN ewu at'osi","duration":44.025,"voices":{"male":{"file":"y-562-male-v3.m4a","bytes":310729,"sha256":"c4854debc085e928f43e9f0f26e146a7359fedaec135e112ceadc8180c39a6f8","duration":44.1},"female":{"file":"y-562-female-v3.m4a","bytes":322275,"sha256":"c19440ab772407ee58e1c262e124abc9738e41cc1b34ac96b88f774655464198","duration":44.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.876,"text":"LARIN ewu at'osi,","marked":"Lárin ẹ̀wù àt'òṣì"},{"start":2.326,"end":4.511,"text":"Kristian, ma tẹsiwaju:","marked":"Kristian, má tẹ̀síwájú"},{"start":4.961,"end":6.327,"text":"Rọju duro, jija na,","marked":"Rọ́jú dúró, jíjà ná"},{"start":6.777,"end":8.163,"text":"K'Ounjẹ 'ye mu ọ lokun.","marked":"K'Oúnjẹ yẹ mú ọ lókun."}],"end":8.163},{"key":"2","start":9.113,"lines":[{"start":9.113,"end":11.046,"text":"Kristian, ma tẹsiwaju,","marked":"Kristian, má tẹ̀síwájú"},{"start":11.496,"end":13.073,"text":"Wa k'a doju kọ ọta:","marked":"Wá k'á dojú kọ ọ̀tá"},{"start":13.523,"end":14.604,"text":"Ẹ o ha bẹru ibi?","marked":"Ẹ ó ha bẹ̀rù ibi?"},{"start":15.054,"end":16.344,"text":"S'e mọyi Balogun yin?","marked":"S'é mọyì Balógun yín?"}],"end":16.344},{"key":"3","start":17.294,"lines":[{"start":17.294,"end":18.505,"text":"Jẹ ki ọkan yin k'o yọ:","marked":"Jẹ́ kí ọkàn yín k'ó yọ̀"},{"start":18.955,"end":20.366,"text":"Mu 'hamọra ọrun wọ:","marked":"Mú 'hamọra ọ̀run wọ̀"},{"start":20.816,"end":22.67,"text":"Ja, ma ro pe ogun n pẹ,","marked":"Já, má rò pé ogun ń pẹ́"},{"start":23.12,"end":24.436,"text":"Isẹgun yin fẹrẹ de.","marked":"Ìsẹ́gun yín fẹ́rẹ́ dé."}],"end":24.436},{"key":"4","start":25.386,"lines":[{"start":25.386,"end":26.753,"text":"Ma jẹ k'inu yin bajẹ,","marked":"Má jẹ́ k'inú yín bàjẹ́"},{"start":27.203,"end":28.6,"text":"Oun fẹ n'omije yin nu;","marked":"Òun fẹ́ n'omijé yín nù"},{"start":29.05,"end":30.549,"text":"Mase jẹ k'ẹru ba yin,","marked":"Maṣe jẹ́ k'ẹrú bá yín"},{"start":30.999,"end":33.404,"text":"B'aini yin, l'agbara yin","marked":"B'àìní yín, l'agbára yín"}],"end":33.404},{"key":"5","start":34.354,"lines":[{"start":34.354,"end":36.268,"text":"Njẹ ẹ ma tẹsiwaju,","marked":"Ǹjẹ́ ẹ má tẹ̀síwájú"},{"start":36.718,"end":37.873,"text":"Ẹ o ju Asẹgun lọ,","marked":"Ẹ ò ju Asẹ́gun lọ"},{"start":38.323,"end":39.748,"text":"B'ọ 'p'ọta dojukọ yin,","marked":"B'ọ́ 'p'ọta dojúkọ yín"},{"start":40.198,"end":42.475,"text":"Kristian, ẹ tẹsiwaju.","marked":"Kristian, ẹ tẹ̀síwájú."}],"end":42.475}]}