{"v":3,"coll":"y","num":753,"id":"hymn_753","title":"AWON t'o sowon fun wa","duration":46.532,"voices":{"male":{"file":"y-753-male-v3.m4a","bytes":317387,"sha256":"d9b4462c580374b3db41076442eb41d2e0cd85f2ce352be55a30dd710ff2408f","duration":46.6},"female":{"file":"y-753-female-v3.m4a","bytes":329463,"sha256":"7bf1efc65d58d527d3ead7727aa3a279743267658ae3d279533d5deb52d3b550","duration":46.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.544,"text":"AWON t'o sowon fun wa","marked":"Àwọn t'ó ṣọ̀wọ́n fún wa"},{"start":1.994,"end":3.144,"text":"Ninu Egbe Serafu","marked":"Nínú Ẹgbẹ́ Séráfù"},{"start":3.594,"end":4.942,"text":"Nwon ti lo s'aiyeraiye","marked":"Wọ́n ti lọ s'ayérayé"},{"start":5.392,"end":6.791,"text":"Ko ha ye k'a ranti won?","marked":"Kò ha yẹ k'á rántí wọn?"}],"end":6.791},{"key":"2","start":7.741,"lines":[{"start":7.741,"end":9.0,"text":"Awon t'o sowon fun wa","marked":"Àwọn t'ó ṣọ̀wọ́n fún wa"},{"start":9.45,"end":10.859,"text":"Larin Egbe Kerubu","marked":"Lárin Ẹgbẹ́ Kérúbù"},{"start":11.309,"end":12.703,"text":"Nwon dapo mo jo t'orun","marked":"Wọ́n dàpọ̀ mo jọ t'ọ̀run"},{"start":13.153,"end":14.583,"text":"lse won nto won lehin.","marked":"Iṣẹ́ wọn ńtọ̀ wọn lẹ́hìn."}],"end":14.583},{"key":"3","start":15.533,"lines":[{"start":15.533,"end":16.868,"text":"Awon t'o sowon fun wa","marked":"Àwọn t'ó ṣọ̀wọ́n fún wa"},{"start":17.318,"end":18.832,"text":"Ninu Egbe Aladura","marked":"Nínú Ẹgbẹ́ Aládúrà"},{"start":19.282,"end":20.722,"text":"Enit' o ku ti pari","marked":"Ẹnit ó kù ti parí"},{"start":21.172,"end":22.63,"text":"Ise re l'odo Jesu.","marked":"Iṣẹ́ rẹ̀ l'ọ̀dọ̀ Jésù."}],"end":22.63},{"key":"4","start":23.58,"lines":[{"start":23.58,"end":24.873,"text":"Awon wonyi ti segun","marked":"Àwọn wọ̀nyí ti ṣẹ́gun"},{"start":25.323,"end":26.36,"text":"F'Ola Olugbala won","marked":"F'Ọlá Olùgbàlà wọn"},{"start":26.81,"end":28.286,"text":"Nwon ti gb'ohun Jesu pe","marked":"Wọ́n ti gb'ohùn Jésù pé"},{"start":28.736,"end":30.002,"text":"Bo s'ayo Oluwa Re.","marked":"Bó s'ayọ̀ Olúwa Rẹ."}],"end":30.002},{"key":"5","start":30.952,"lines":[{"start":30.952,"end":32.082,"text":"Oluwa gbadura wa","marked":"Olúwa gbàdúrà wa"},{"start":32.532,"end":34.079,"text":"K'a le ni 'po lodo Re","marked":"K'á lè ní pọ̀ lọ́dọ̀ Rẹ"},{"start":34.529,"end":35.944,"text":"K'a ma tan bi irawo","marked":"K'á má tàn bí ìràwọ̀"},{"start":36.394,"end":37.776,"text":"Titi lai lod'Oluwa.","marked":"Títí láì lọ́d'olúwa."}],"end":37.776},{"key":"6","start":38.726,"lines":[{"start":38.726,"end":40.041,"text":"E f'ogo fun Baba wa,","marked":"Ẹ f'ògo fún Baba wa"},{"start":40.491,"end":41.683,"text":"E f'ogo fun Omo Re","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":42.133,"end":43.388,"text":"E f'ogo Emi Mimo","marked":"Ẹ f'ògo Ẹ̀mí Mímọ́"},{"start":43.838,"end":44.983,"text":"Ogo fun metalokan.","marked":"Ògo fún Mẹ́talọ́kan."}],"end":44.983}]}