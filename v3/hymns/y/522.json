{"v":3,"coll":"y","num":522,"id":"hymn_522","title":"JESU Olugbala, Oba mi","duration":43.106,"voices":{"male":{"file":"y-522-male-v3.m4a","bytes":304089,"sha256":"df2e6f678f3e148a039b5ba445802c975d6949504874d502158a6e68d3e0ae36","duration":43.2},"female":{"file":"y-522-female-v3.m4a","bytes":316491,"sha256":"4c99fca00dd47d7b2335d92d46f13c86aa77e5a74de41a69753fc10520333866","duration":43.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.475,"text":"JESU Olugbala, Oba mi","marked":"Jésù Olùgbàlà, Ọba mi"},{"start":2.925,"end":4.11,"text":"Gbohun mi nigba ti mo","marked":"Gbóhùn mi nígbà tí mo"},{"start":4.56,"end":6.696,"text":"n pe, Gbohun mi lati","marked":"ń pé, Gbóhùn mi láti"},{"start":7.146,"end":8.217,"text":"'bugbe Re, Rojo","marked":"bùgbé Rẹ, Rọ́jọ́"},{"start":8.667,"end":9.801,"text":"ore-ofe sile.","marked":"oore-ọ̀fẹ́ sílẹ̀."}],"end":9.801},{"key":"CHORUS","start":10.751,"lines":[{"start":10.751,"end":12.525,"text":"Oluwa mi, mo feran Re","marked":"Olúwa mi, mo fẹ́ràn Rẹ"},{"start":12.975,"end":14.714,"text":"Jẹ ki n le ma feran Re si.","marked":"Jẹ́ kí n lè má fẹ́ràn Rẹ̀ sí."}],"end":14.714},{"key":"2","start":15.664,"lines":[{"start":15.664,"end":17.992,"text":"Jesu, mo ti jafara ju,","marked":"Jésù, mo ti jáfara jù"},{"start":18.442,"end":20.037,"text":"N ó se le fẹ Ọ b'o ti yẹ,","marked":"N ó ṣe lè fẹ́ Ọ b'ó ti yẹ"},{"start":20.487,"end":21.83,"text":"Em'o se le gb'ogo Rẹ ga,","marked":"Èm'ó ṣe lè gb'ògo Rẹ̀ ga"},{"start":22.28,"end":23.513,"text":"Ati ẹwa orukọ Rẹ.","marked":"Àti ẹwà orúkọ Rẹ̀."}],"end":23.513},{"key":"3","start":24.463,"lines":[{"start":24.463,"end":26.875,"text":"Jesu, kil'o ri ninu mi,","marked":"Jésù, kìl'ó rí nínú mi"},{"start":27.325,"end":28.841,"text":"Ti 'fẹ na fi pọ to bayi?","marked":"Tí 'fẹ ná fi pọ̀ tó báyì?"},{"start":29.291,"end":30.661,"text":"Ore Rẹ si mi ti pọ to!","marked":"Ọrẹ Rẹ sì mi ti pọ̀ tó!"},{"start":31.111,"end":32.552,"text":"O ta gbogbo ero mi yọ!","marked":"Ó ta gbogbo èrò mi yọ!"}],"end":32.552},{"key":"4","start":33.502,"lines":[{"start":33.502,"end":35.491,"text":"Jesu, 'Wo o je orin mi","marked":"Jésù, wò ó jẹ́ orin mi"},{"start":35.941,"end":37.814,"text":"Tire l'aya at'okan mi","marked":"Tirẹ̀ l'àyà àt'ọkàn mi"},{"start":38.264,"end":39.525,"text":"Tire ni gbogbo ini mi","marked":"Tìrẹ ni gbogbo ìní mi"},{"start":39.975,"end":41.557,"text":"Olugbala, Wo ni temi.","marked":"Olùgbàlà, Wo ni tèmi."}],"end":41.557}]}