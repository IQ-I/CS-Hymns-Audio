{"v":3,"coll":"y","num":546,"id":"hymn_546","title":"GEGE bi oro ore Re","duration":37.834,"voices":{"male":{"file":"y-546-male-v3.m4a","bytes":255617,"sha256":"1346cca1db1f9a660b8ac7c8fe3c72b82f573a103a6d3d0bebd3d5ec74e83627","duration":37.9},"female":{"file":"y-546-female-v3.m4a","bytes":264644,"sha256":"0fdb5cba08e35992351b9169c816196d7a3880dc01bd9f380dfc0be504d7cc87","duration":37.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.692,"text":"GEGE bi oro ore Re","marked":"Gẹ́gẹ́ bí ọ̀rọ̀ ọ̀rẹ́ Rẹ"},{"start":2.142,"end":3.097,"text":"Ninu irele nla","marked":"Nínú ìrẹ̀lẹ̀ ńlá"},{"start":3.547,"end":5.004,"text":"Emi o s'eyi, Oluwa","marked":"Èmi ó s'èyí, Olúwa"},{"start":5.454,"end":6.561,"text":"Emi o ranti re.","marked":"Èmi ó rántí rẹ."}],"end":6.561},{"key":"2","start":7.511,"lines":[{"start":7.511,"end":8.886,"text":"Ara Rẹ ti a bu fun mi,","marked":"Ara Rẹ tí a bù fún mi"},{"start":9.336,"end":10.619,"text":"Yoo jẹ Ounjẹ mi,","marked":"Yóò jẹ́ Oúnjẹ mi"},{"start":11.069,"end":12.411,"text":"Mo gba ago majẹmu Rẹ,","marked":"Mo gba àgọ́ májẹ̀mú Rẹ"},{"start":12.861,"end":14.148,"text":"Lati se ranti Rẹ.","marked":"Láti ṣe rántí Rẹ."}],"end":14.148},{"key":"3","start":15.098,"lines":[{"start":15.098,"end":16.696,"text":"Mo le gbagbe Getsemane,","marked":"Mo lè gbàgbé Getsemane"},{"start":17.146,"end":18.181,"text":"Ti mo r'ijanu Rẹ,","marked":"Tí mo r'ìjánu Rẹ̀"},{"start":18.631,"end":20.344,"text":"Iya oun ogun ẹjẹ Rẹ,","marked":"Ìyá òun ogun ẹ̀jẹ̀ Rẹ̀"},{"start":20.794,"end":21.904,"text":"Ki n ma si ranti Rẹ?","marked":"Kí n má sì rántí Rẹ?"}],"end":21.904},{"key":"4","start":22.854,"lines":[{"start":22.854,"end":23.983,"text":"N ó ranti gbogbo rora Rẹ,","marked":"N ó rántí gbogbo rọra Rẹ"},{"start":24.433,"end":25.452,"text":"Ati 'fẹ Rẹ si mi;","marked":"Àti 'fẹ Rẹ sí mi"},{"start":25.902,"end":27.39,"text":"Bi o ku emi kan fun mi,","marked":"Bí ó kú èmi kan fún mi"},{"start":27.84,"end":28.881,"text":"Emi o ranti Rẹ.","marked":"Èmi ó rántí Rẹ."}],"end":28.881},{"key":"5","start":29.831,"lines":[{"start":29.831,"end":31.127,"text":"'Gbati ẹnu mi ba pamọ,","marked":"gbàtí ẹnu mi bá pamọ́"},{"start":31.577,"end":32.568,"text":"Ti iye mi ba ra,","marked":"Tí iye mi bá rà"},{"start":33.018,"end":34.334,"text":"Ti O ba de n' IjỌba Rẹ,","marked":"Tí Ó bá dé ń ÌjỌba Rẹ"},{"start":34.784,"end":36.285,"text":"Jesu, jọ ranti mi.","marked":"Jésù, jọ rántí mi."}],"end":36.285}]}