{"v":3,"coll":"y","num":207,"id":"hymn_207","title":"ONIGBAGBO, e bu s' ayo","duration":59.961,"voices":{"male":{"file":"y-207-male-v3.m4a","bytes":414854,"sha256":"b9b1332320f107bbb9b53274bad6c90aa0e76d6e2e550791f2828d81cf0513c1","duration":60.0},"female":{"file":"y-207-female-v3.m4a","bytes":439922,"sha256":"ca36adb62eb025f61b59fccb5a8023860cf18ad3874d5342d8740bfd0f7c4017","duration":60.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.04,"text":"ONIGBAGBỌ, ẹ bu s'ayọ,","marked":"Onígbàgbọ́, ẹ bú s'ayọ̀"},{"start":2.49,"end":3.73,"text":"Ọjọ nla l'eyi fun wa:","marked":"Ọjọ́ ńlá l'èyí fún wa"},{"start":4.18,"end":5.401,"text":"Ẹ gbọ bi awọn Angẹli,","marked":"Ẹ gbọ́ bí àwọn Áńgẹ́lì"},{"start":5.851,"end":7.298,"text":"Ti ń fi Ogun fun Ọlọrun,","marked":"Tí ń fi Ogun fún Ọlọ́run"},{"start":7.748,"end":9.454,"text":"Alafia, Alafia,","marked":"Àlàáfíà, Àlàáfíà"},{"start":9.904,"end":11.077,"text":"Ni fun gbogbo eniyan.","marked":"Ní fún gbogbo ènìyàn."}],"end":11.077},{"key":"2","start":12.027,"lines":[{"start":12.027,"end":13.502,"text":"Ki gbogbo ayé ho f'ayọ:","marked":"Kí gbogbo ayé hó f'ayọ̀"},{"start":13.952,"end":15.396,"text":"K'a f'ogo fun Ọlọrun;","marked":"K'á f'ògo fún Ọlọ́run"},{"start":15.846,"end":17.233,"text":"Ọmọ bibi Rẹ l'O fun wa;","marked":"Ọmọ bíbí Rẹ l'Ó fún wa"},{"start":17.683,"end":18.816,"text":"T'a bi ninu Wundia,","marked":"T'á bí nínú Wúńdíá"},{"start":19.266,"end":20.119,"text":"Ẹn' Iyanu,","marked":"Ẹn' Ìyanu"},{"start":20.569,"end":22.058,"text":"Ni ọmọ t'a bi loni.","marked":"Ní ọmọ t'á bí lónì."}],"end":22.058},{"key":"3","start":23.008,"lines":[{"start":23.008,"end":24.31,"text":"Ninu gbogbo rudurudu,","marked":"Nínú gbogbo rúdurùdu"},{"start":24.76,"end":26.03,"text":"Ohun ibi t'o kun ayé,","marked":"Ohun ibi t'ó kún ayé"},{"start":26.48,"end":27.875,"text":"Ninu idamu nla ẹsẹ,","marked":"Nínú ìdàmú ńlá ẹsẹ̀"},{"start":28.325,"end":29.676,"text":"L'Ọm'Ọlọrun wa gba wa:","marked":"L'Ọm'Ọlọ́run wa gbà wá"},{"start":30.126,"end":31.786,"text":"Olugbimọ, Olugbimọ,","marked":"Olùgbìmọ̀, Olùgbìmọ̀"},{"start":32.236,"end":33.531,"text":"Alade alafia.","marked":"Aládé àlàáfíà."}],"end":33.531},{"key":"4","start":34.481,"lines":[{"start":34.481,"end":35.515,"text":"Ọlọrun Olodumare;","marked":"Ọlọ́run Olódùmarè"},{"start":35.965,"end":37.842,"text":"L'a bi, bi ọmọ titun;","marked":"L'á bí, bí ọmọ titun"},{"start":38.292,"end":40.412,"text":"Baba! Ẹni ayérayé;","marked":"Baba! Ẹni ayérayé"},{"start":40.862,"end":42.371,"text":"L'o di alakoso wa;","marked":"L'ó di alákòso wa"},{"start":42.821,"end":44.785,"text":"Ẹ bu s'ayọ, Ẹ bu s'ayọ,","marked":"Ẹ bú s'ayọ̀, Ẹ bù s'ayọ̀"},{"start":45.235,"end":46.657,"text":"Ọmọ Dafidi jọba.","marked":"Ọmọ Dafidi jọba."}],"end":46.657},{"key":"5","start":47.607,"lines":[{"start":47.607,"end":48.887,"text":"O wa gba wa lọwọ ẹsẹ,","marked":"Ó wá gbà wá lọ́wọ́ ẹsẹ̀"},{"start":49.337,"end":50.515,"text":"O wa d'onigbọwọ wa,","marked":"Ó wá d'onígbọ̀wọ́ wa"},{"start":50.965,"end":52.472,"text":"Lati fọ itẹgun ẹsẹ,","marked":"Láti fọ́ ìtẹ̀gùn ẹsẹ̀"},{"start":52.922,"end":54.204,"text":"A se ni Ọga Ogo:","marked":"A ṣe ní Ọ̀gá Ògo"},{"start":54.654,"end":56.549,"text":"Ẹ ku ayọ, ẹ ku ayọ,","marked":"Ẹ kú ayọ̀, ẹ kú ayọ̀"},{"start":56.999,"end":58.412,"text":"A gba wa lọwọ iku.","marked":"A gbà wá lọ́wọ́ ikú."}],"end":58.412}]}