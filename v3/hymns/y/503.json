{"v":3,"coll":"y","num":503,"id":"hymn_503","title":"ORE wo l'a ni bi Jesu","duration":49.059,"voices":{"male":{"file":"y-503-male-v3.m4a","bytes":347360,"sha256":"850db8c2979925935a56768eac271bc2f51b600c0a0bf0b45f772b48c5d1434c","duration":49.1},"female":{"file":"y-503-female-v3.m4a","bytes":360002,"sha256":"2e7d11d1f8521089ca9a0657984ab518f3be4b21e0ea72c6b3e6d7b441366666","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.801,"text":"ORE wo l'a ni bi Jesu","marked":"Ọrẹ wo l'á ní bí Jésù"},{"start":2.251,"end":3.304,"text":"Ti O ru 'banuje wa","marked":"Tí Ó ru banújẹ́ wa"},{"start":3.754,"end":5.16,"text":"Anfaani wo I'o po bayi","marked":"Àǹfààní wo l'ó pọ̀ báyì"},{"start":5.61,"end":6.908,"text":"Lati maa gbadura si I","marked":"Láti máa gbàdúrà sí I"},{"start":7.358,"end":9.151,"text":"Alaafia pupo l'a n sonu","marked":"Àlàáfíà púpọ̀ l'à ń sọnù"},{"start":9.601,"end":11.132,"text":"Irora ainidi l'a n je","marked":"Ìrora àìnídì l'à ń jẹ́"},{"start":11.582,"end":13.305,"text":"'Tori a ko n fi gbogbo nnkan","marked":"torí a kò ń fi gbogbo nǹkan"},{"start":13.755,"end":15.154,"text":"S'adura niwaju Re.","marked":"S'àdúrà níwájú Rẹ."}],"end":15.154},{"key":"2","start":16.104,"lines":[{"start":16.104,"end":17.619,"text":"Idanwo ha wa fun wa bi?","marked":"Ìdánwò ha wà fún wa bí?"},{"start":18.069,"end":19.289,"text":"A ha ni wahala bi","marked":"A ha ní wàhálà bí"},{"start":19.739,"end":21.159,"text":"A ko gbodo so 'reti nu","marked":"A kò gbọdọ̀ sọ retí nù"},{"start":21.609,"end":23.132,"text":"Sa gbadura s'Oluwa,","marked":"Sá gbàdúrà s'Olúwa"},{"start":23.582,"end":25.125,"text":"A'a le ri ore olooto","marked":"A'á lè rí ọrẹ olóòtọ́"},{"start":25.575,"end":26.824,"text":"Ti o Ie ba wa daro","marked":"Tí ó lè bá wa dárò"},{"start":27.274,"end":29.05,"text":"Jesu ti mo ailera wa,","marked":"Jésù ti mọ àìlera wa"},{"start":29.5,"end":31.105,"text":"Sa gbadura s'Oluwa.","marked":"Sá gbàdúrà s'Olúwa."}],"end":31.105},{"key":"3","start":32.055,"lines":[{"start":32.055,"end":33.44,"text":"Eru han won wa l'orun bi?","marked":"Ẹ̀rù hàn wọ́n wà l'ọ̀run bí?"},{"start":33.89,"end":35.125,"text":"Aniyan ha po fun wa?","marked":"Àníyàn ha pọ̀ fún wa?"},{"start":35.575,"end":36.777,"text":"Olugbala ni aabo wa,","marked":"Olùgbàlà ni ààbò wa"},{"start":37.227,"end":38.628,"text":"Sa gbadura s'Oluwa","marked":"Sá gbàdúrà s'Olúwa"},{"start":39.078,"end":40.429,"text":"Awon ore ha sa o ti?","marked":"Àwọn ọ̀rẹ́ ha ṣá ọ tì?"},{"start":40.879,"end":42.214,"text":"Sa gbadura s'Oluwa","marked":"Sá gbàdúrà s'Olúwa"},{"start":42.664,"end":44.511,"text":"Yoo gbe o soke l'apa Re,","marked":"Yóò gbé ọ sókè l'apá Rẹ"},{"start":44.961,"end":46.423,"text":"lwo yoo si n'itunu.","marked":"Ìwọ yóò sì n'ìtùnú."},{"start":46.873,"end":47.509,"text":"Amin.","marked":"Àmín."}],"end":47.509}]}