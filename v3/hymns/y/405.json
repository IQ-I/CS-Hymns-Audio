{"v":3,"coll":"y","num":405,"id":"hymn_405","title":"BIBELI iwe aiyeraiye","duration":38.709,"voices":{"male":{"file":"y-405-male-v3.m4a","bytes":255230,"sha256":"9d80a0f3e898ed4d9e1e9968794b786d8795ba9d9e7a51876fd86002fe6ce702","duration":38.8},"female":{"file":"y-405-female-v3.m4a","bytes":266176,"sha256":"833659b4b47d7cab23df961da7725cfce631606a27063b0d9c494c486cceed54","duration":38.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.604,"text":"BIBELI iwe aiyeraiye","marked":"Bíbélì ìwé ayérayé"},{"start":2.054,"end":3.017,"text":"Tani le r'idi re?","marked":"Tani lè r'ìdí rẹ̀?"},{"start":3.467,"end":4.647,"text":"Tani Ie so idide re?","marked":"Tani lè sọ ìdìde rẹ̀?"},{"start":5.097,"end":6.098,"text":"Tani le m'opin re?","marked":"Tani lè m'òpin rẹ̀?"}],"end":6.098},{"key":"2","start":7.048,"lines":[{"start":7.048,"end":8.177,"text":"Asiri Olodumare","marked":"Àṣírí Olódùmarè"},{"start":8.627,"end":9.968,"text":"Iko Oba orun","marked":"Ikọ̀ Ọba ọ̀run"},{"start":10.418,"end":11.884,"text":"Ida t'o pa oro iku","marked":"Idà t'ó pa ọ̀rọ̀ ikú"},{"start":12.334,"end":13.314,"text":"Aworan Olorun.","marked":"Àwòrán Ọlọ́run."}],"end":13.314},{"key":"3","start":14.264,"lines":[{"start":14.264,"end":15.578,"text":"Okan ni O larin opo","marked":"Ọkàn ni Ó lárin ọ̀pọ̀"},{"start":16.028,"end":17.021,"text":"Iwe aiye 'gbani","marked":"Ìwé ayé gbani"},{"start":17.471,"end":18.639,"text":"lwo l'o s'ona igbala","marked":"Ìwọ l'ó s'ọ̀nà ìgbàlà"},{"start":19.089,"end":20.342,"text":"Di mimo f'araiye.","marked":"Di mímọ́ f'araìyè."}],"end":20.342},{"key":"4","start":21.292,"lines":[{"start":21.292,"end":22.632,"text":"Isura ti Metalokan","marked":"Ìṣúra ti Mẹ́talọ́kan"},{"start":23.082,"end":24.378,"text":"Oba nla t'o gunwa","marked":"Ọba ńlá t'ó gúnwà"},{"start":24.828,"end":26.483,"text":"Jo, tumo ara Re fun mi","marked":"Jọ, túmọ̀ ara Rẹ fún mi"},{"start":26.933,"end":28.257,"text":"Ki m'ye siyemeji.","marked":"Kí m'yè ṣiyèméjì."}],"end":28.257},{"key":"5","start":29.207,"lines":[{"start":29.207,"end":30.725,"text":"Ki m'si o p pelu adura","marked":"Kí m'ṣí ó p pẹ̀lú àdúrà"},{"start":31.175,"end":32.376,"text":"Ki 'm'k' eko ninu re","marked":"Kí m'k ẹ̀kọ́ nínú rẹ̀"},{"start":32.826,"end":34.199,"text":"Iwo lwe Aiyeraiye,","marked":"Ìwọ Ìwé Ayérayé"},{"start":34.649,"end":36.067,"text":"F'ife Jesu han mi.","marked":"F'ìfẹ́ Jésù hàn mí."},{"start":36.517,"end":37.16,"text":"Amin.","marked":"Àmín."}],"end":37.16}]}