{"v":3,"coll":"y","num":496,"id":"hymn_496","title":"ENI T'O la 'ju afoju","duration":31.131,"voices":{"male":{"file":"y-496-male-v3.m4a","bytes":211655,"sha256":"33d991e0d324659afe96054bfa2281ebdbdb96363ce4400fdb93e5fa428b7455","duration":31.2},"female":{"file":"y-496-female-v3.m4a","bytes":225868,"sha256":"3b9816ac0a18d428f87d200865acf676922eb95aeb952c40cd41ce84620795d1","duration":31.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.796,"text":"ẸNI T'O la 'ju afọju,","marked":"Ẹni T'Ó là ju afọ́jú"},{"start":2.246,"end":3.324,"text":"Ti O mu ope gbọn,","marked":"Tí Ó mú ọpẹ́ gbọ́n"},{"start":3.774,"end":5.188,"text":"At'ẹni t'O da imọlẹ,","marked":"Àt'ẹni t'Ó dá ìmọ́lẹ̀"},{"start":5.638,"end":6.767,"text":"Fun ẹni okunkun.","marked":"Fún ẹni òkùnkùn."}],"end":6.767},{"key":"2","start":7.717,"lines":[{"start":7.717,"end":8.914,"text":"Ẹni t'O le fi agbara,","marked":"Ẹni t'Ó lè fi agbára"},{"start":9.364,"end":10.427,"text":"F'awọn olokunrun,","marked":"F'àwọn olókùnrùn"},{"start":10.877,"end":12.173,"text":"Ti O si fi ẹmi iye,","marked":"Tí Ó sì fi ẹ̀mí ìyè"},{"start":12.623,"end":14.284,"text":"Fun awọn t'o ti ku.","marked":"Fún àwọn t'ó ti kú."}],"end":14.284},{"key":"3","start":15.234,"lines":[{"start":15.234,"end":16.536,"text":"Eni fi 'dasile f'okan","marked":"Ẹni fi dásílẹ̀ f'ọkàn"},{"start":16.986,"end":18.082,"text":"T'O gb'eni subu nde","marked":"T'Ó gb'ẹni ṣubú ńdẹ"},{"start":18.532,"end":19.887,"text":"T'O si pa ibanuje da","marked":"T'Ó sì pa ìbànújẹ́ dá"},{"start":20.337,"end":21.653,"text":"S'orin pelu iyin.","marked":"S'orin pẹ̀lú ìyìn."}],"end":21.653},{"key":"4","start":22.603,"lines":[{"start":22.603,"end":23.815,"text":"'Wọ Onisegun ọkan mi,","marked":"'Wọ Oníṣègùn ọkàn mi"},{"start":24.265,"end":25.646,"text":"Si Ọ l'awa n kọrin,","marked":"Sí Ọ l'àwa ń kọrin"},{"start":26.096,"end":27.785,"text":"Titi ayé o fi d'opin,","marked":"Títí ayé ó fi d'òpin"},{"start":28.235,"end":29.582,"text":"Tirẹ l'ọpẹ o se.","marked":"Tirẹ̀ l'ọpẹ́ ò ṣe."}],"end":29.582}]}