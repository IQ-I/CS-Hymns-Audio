{"v":3,"coll":"y","num":722,"id":"hymn_722","title":"OLORUN Olodumare","duration":65.998,"voices":{"male":{"file":"y-722-male-v3.m4a","bytes":471201,"sha256":"d8aa66ec2f13ed02ac861c2ce5ad305826b2a0759fde0f0ea7304c0dca5f0697","duration":66.0},"female":{"file":"y-722-female-v3.m4a","bytes":486213,"sha256":"97a1acd6b67b4892991f3ddb24f0e89e0057214b4a248dbf85ccf94b7ff6943c","duration":66.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.406,"text":"OLORUN Olodumare","marked":"Ọlọ́run Olódùmarè"},{"start":1.856,"end":3.542,"text":"A dupe fun 'dasi oni","marked":"A dúpẹ́ fún dásí òní"},{"start":3.992,"end":5.662,"text":"Ajodun yi si tun ba wa","marked":"Àjọ̀dún yí sì tún bá wa"},{"start":6.112,"end":7.63,"text":"Ni ori ile agbaiye.","marked":"Ní orí ilẹ̀ àgbáìyè."}],"end":7.63},{"key":"CHORUS","start":8.58,"lines":[{"start":8.58,"end":10.395,"text":"A s'ope, a s'ope","marked":"A s'ọpẹ́, a s'ọpẹ́"},{"start":10.845,"end":12.531,"text":"Fun idasi wa l'odun yi","marked":"Fún ìdásí wa l'ọdún yí"},{"start":12.981,"end":14.582,"text":"Larin ota, larin egan","marked":"Lárin ọ̀tá, lárin ẹ̀gàn"},{"start":15.032,"end":16.301,"text":"Larin awon oninubini","marked":"Lárin àwọn onínúbíni"},{"start":16.751,"end":18.698,"text":"A s'ope, a s'ope","marked":"A s'ọpẹ́, a s'ọpẹ́"},{"start":19.148,"end":20.824,"text":"Fun idasi wa l'odun yi.","marked":"Fún ìdásí wa l'ọdún yí."}],"end":20.824},{"key":"2","start":21.774,"lines":[{"start":21.774,"end":23.475,"text":"Ajodun oni ko ba wa","marked":"Àjọ̀dún òní kò bá wa"},{"start":23.925,"end":26.13,"text":"Ha! ayo t'orun ko d'opin","marked":"Ha! ayọ̀ t'ọ̀run kò d'òpin"},{"start":26.58,"end":28.112,"text":"Egbe t'o t'orun sokale","marked":"Ẹgbẹ́ t'ó t'ọ̀run sọ̀kalẹ̀"},{"start":28.562,"end":30.13,"text":"Iru eyi ko si laiye.","marked":"Irú èyí kò sì láìyẹ."}],"end":30.13},{"key":"3","start":31.08,"lines":[{"start":31.08,"end":32.515,"text":"Okunrin ati Obirin","marked":"Ọkùnrin àti Obirin"},{"start":32.965,"end":34.669,"text":"E mura k'e d'amure nyin","marked":"Ẹ múra k'é d'àmùrè yín"},{"start":35.119,"end":36.613,"text":"Omode at'agbalagba","marked":"Ọmọdé àt'àgbàlagbà"},{"start":37.063,"end":38.356,"text":"Ki gbogbo wa korin s'oke.","marked":"Kí gbogbo wa kọrin s'òkè."}],"end":38.356},{"key":"4","start":39.306,"lines":[{"start":39.306,"end":41.468,"text":"Aje, Oso, Alawirin","marked":"Ajé, Ọ̀ṣọ́, Aláwìrìn"},{"start":41.918,"end":44.171,"text":"Sanponno, Ologun ika","marked":"Sanponno, Ológun ìkà"},{"start":44.621,"end":46.098,"text":"Igunnu at'awon elegun","marked":"Ìgunnu àt'àwọn ẹlẹ́gun"},{"start":46.548,"end":48.266,"text":"Ko n'ipa kan lor'Egbe na.","marked":"Kò n'ipa kan lór'ẹgbẹ́ ná."}],"end":48.266},{"key":"5","start":49.216,"lines":[{"start":49.216,"end":50.818,"text":"Nigbat' Egbe yi ko bere","marked":"Nígbàt Ègbé yí kò bẹ̀rẹ̀"},{"start":51.268,"end":52.564,"text":"Awon kan nreti eleya","marked":"Àwọn kan ńretí ẹlẹ́yà"},{"start":53.014,"end":54.364,"text":"Nwon sebi egbe lasan ni","marked":"Wọ́n ṣebi ẹgbẹ́ lásán ni"},{"start":54.814,"end":56.139,"text":"Nwon ko mo ise Olorun.","marked":"Wọ́n kò mọ iṣẹ́ Ọlọ́run."}],"end":56.139},{"key":"6","start":57.089,"lines":[{"start":57.089,"end":58.277,"text":"Metalokan l'Olorun wa","marked":"Mẹ́talọ́kan l'Ọlọ́run wa"},{"start":58.727,"end":60.139,"text":"Olorun ti ko n'ipekun","marked":"Ọlọ́run tí kò n'ìpẹ̀kun"},{"start":60.589,"end":62.626,"text":"Baba, Omo, Emi Mimo","marked":"Baba, Ọmọ, Ẹ̀mí Mímọ́"},{"start":63.076,"end":64.449,"text":"Gbogbo won lo nsise won po.","marked":"Gbogbo wọn ló ńṣiṣẹ́ wọn pọ̀."}],"end":64.449}]}