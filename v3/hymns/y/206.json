{"v":3,"coll":"y","num":206,"id":"hymn_206","title":"GBO, eda orun n korin","duration":46.816,"voices":{"male":{"file":"y-206-male-v3.m4a","bytes":330889,"sha256":"75ee4cdff03e615fbfb87404d7003a2b8bf0aa4e403099d2ebf5c4da68bd4528","duration":46.9},"female":{"file":"y-206-female-v3.m4a","bytes":345341,"sha256":"42054a279d9252b0f9c79a3af1f466f2de9b49398007d9e28ed4e675140b82b7","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.508,"text":"GBỌ, ẹda ọrun ń kọrin;","marked":"Gbọ́, ẹ̀dá ọ̀run ń kọrin"},{"start":2.958,"end":4.08,"text":"Ogo fun Ọba t'a bi","marked":"Ògo fún Ọba t'á bí"},{"start":4.53,"end":5.857,"text":"Alafia layé yi,","marked":"Àlàáfíà layé yí"},{"start":6.307,"end":7.426,"text":"Ọlọrun ba wa laja,","marked":"Ọlọ́run bá wa làjà"},{"start":7.876,"end":9.133,"text":"Gbogbo ẹda nde layọ;","marked":"Gbogbo ẹ̀dá ńdé láyọ̀"},{"start":9.583,"end":10.883,"text":"Dapọ mọ hiho ọrun;","marked":"Dàpọ̀ mọ́ híhó ọ̀run"},{"start":11.333,"end":12.703,"text":"W'Alade Alafia!","marked":"W'Aládé Àlàáfíà!"},{"start":13.153,"end":14.567,"text":"Wo, Orun ododo de.","marked":"Wò, Ọ̀run òdodo dé."}],"end":14.567},{"key":"2","start":15.517,"lines":[{"start":15.517,"end":17.225,"text":"O bo'go Rẹ s'apa kan;","marked":"Ó bò'gò Rẹ̀ s'apá kan"},{"start":17.675,"end":18.817,"text":"A bi k'eniyan ma ku;","marked":"A bí k'ènìyàn má kú"},{"start":19.267,"end":20.585,"text":"A bi k'o gb'eniyan ro;","marked":"A bí k'ó gb'ènìyàn rò"},{"start":21.035,"end":22.603,"text":"A bi k'o le tun wa bi.","marked":"A bí k'ó lè tún wá bí."},{"start":23.053,"end":24.612,"text":"Wa, ireti eniyan;","marked":"Wá, ìrètí ènìyàn"},{"start":25.062,"end":26.32,"text":"Se ile Rẹ ninu wa;","marked":"Ṣe ilé Rẹ nínú wa"},{"start":26.77,"end":28.637,"text":"N' de, iru ọmọbirin,","marked":"Ń dé, irú ọmọbìrin"},{"start":29.087,"end":30.313,"text":"Bori esu ninu wa:","marked":"Borí èṣù nínú wa"}],"end":30.313},{"key":"3","start":31.263,"lines":[{"start":31.263,"end":33.015,"text":"Pa aworan Adam run;","marked":"Pa àwòrán Adam run"},{"start":33.465,"end":34.811,"text":"F'aworan Rẹ s'ipo rẹ;","marked":"F'àwòrán Rẹ̀ s'ipò rẹ̀"},{"start":35.261,"end":36.702,"text":"Jọ masai f'Ẹmi Rẹ kun,","marked":"Jọ masai f'Ẹ̀mí Rẹ̀ kún"},{"start":37.152,"end":38.292,"text":"Okan gbogbo' onigbagbọ,","marked":"Ọkàn gbogbo onígbàgbọ́"},{"start":38.742,"end":40.126,"text":"Ogo fun Ọba t'a bi‖","marked":"Ògo fún Ọba t'á bí‖"},{"start":40.576,"end":41.809,"text":"Jẹ ki gbogbo wa gberin;","marked":"Jẹ́ kí gbogbo wa gbẹ́rin"},{"start":42.259,"end":43.556,"text":"Alafia layé yi‖","marked":"Àlàáfíà layé yí‖"},{"start":44.006,"end":45.267,"text":"Ọlọrun ba wa laja.","marked":"Ọlọ́run bá wa làjà."}],"end":45.267}]}