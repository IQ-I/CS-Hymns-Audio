{"v":3,"coll":"y","num":796,"id":"hymn_796","title":"OJO 'mole l'eyi","duration":73.475,"voices":{"male":{"file":"y-796-male-v3.m4a","bytes":504229,"sha256":"1e478f5e5c9d2322057e89011bb452e87ae2a14ef8d0da5be2bcd629744b4536","duration":73.5},"female":{"file":"y-796-female-v3.m4a","bytes":526641,"sha256":"c5ab42c7d9d27de6816ff6dc9e3323fd1d84c96f49cecda776e10ac48da786d1","duration":73.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.729,"text":"OJO 'mole l'eyi","marked":"Ọjọ́ mọ́lẹ̀ l'èyí"},{"start":2.179,"end":3.261,"text":"Ki 'mole wa l'oni","marked":"Kí mọ́lẹ̀ wá l'òní"},{"start":3.711,"end":5.691,"text":"Wo Orun, ran s'okunkun wa,","marked":"Wo Ọ̀run, rán s'òkùnkùn wá"},{"start":6.141,"end":7.519,"text":"K'o si le oru lo.","marked":"K'ó sì lé òru lọ."}],"end":7.519},{"key":"2","start":8.469,"lines":[{"start":8.469,"end":9.658,"text":"Ojo simi l'eyi","marked":"Ọjọ́ sími l'èyí"},{"start":10.108,"end":11.426,"text":"S'agbara wa d'otun","marked":"S'agbára wa d'ọ̀tún"},{"start":11.876,"end":13.309,"text":"S'ori aibale aiya wa","marked":"S'orí àìbalẹ̀ àìyá wà"},{"start":13.759,"end":15.371,"text":"Seri itura Re.","marked":"Ṣèrí ìtura Rẹ."}],"end":15.371},{"key":"3","start":16.321,"lines":[{"start":16.321,"end":17.199,"text":"Ojo alafia","marked":"Ọjọ́ àlàáfíà"},{"start":17.649,"end":18.744,"text":"F'alafia fun wa","marked":"F'àlàáfíà fún wa"},{"start":19.194,"end":20.819,"text":"Da iyapa gbogbo duro","marked":"Dá ìyapa gbogbo dúró"},{"start":21.269,"end":22.518,"text":"Si mu ija kuro.","marked":"Sì mú ìjà kúrò."}],"end":22.518},{"key":"4","start":23.468,"lines":[{"start":23.468,"end":24.458,"text":"Ojo adura ni","marked":"Ọjọ́ àdúrà ni"},{"start":24.908,"end":26.311,"text":"K'aiye sunmo Orun","marked":"K'ayé súnmọ́ Ọ̀run"},{"start":26.761,"end":28.301,"text":"Gb'okan soke si odo Re","marked":"Gb'ọkàn sókè sí ọ̀dọ̀ Rẹ"},{"start":28.751,"end":30.028,"text":"Si pade wa nihin.","marked":"Sì pàdé wa níhìn."}],"end":30.028},{"key":"5","start":30.978,"lines":[{"start":30.978,"end":32.262,"text":"Oba ojo l'eyi","marked":"Ọba ọjọ́ l'èyí"},{"start":32.712,"end":33.747,"text":"Fun wa ni isoji","marked":"Fún wa ní ìṣòjì"},{"start":34.197,"end":35.856,"text":"Ji oku okan wa s'ife","marked":"Jí òkú ọkàn wa s'ìfẹ́"},{"start":36.306,"end":38.962,"text":"Wo asegun iku.  Amin","marked":"Wo aṣẹ́gun ikú. Àmín"},{"start":39.412,"end":40.491,"text":"------APA Keji------","marked":"Apá Kejì"}],"end":40.491},{"key":"6","start":41.441,"lines":[{"start":41.441,"end":42.804,"text":"KABO! ojo 'simi","marked":"Kábọ́! ọjọ́ ṣímí"},{"start":43.254,"end":44.593,"text":"T'o r'ajinde Jesu","marked":"T'ó r'àjíǹde Jésù"},{"start":45.043,"end":46.704,"text":"Ma bo wa m'okan yi soji","marked":"Má bọ̀ wá m'ọkàn yí sóji"},{"start":47.154,"end":48.187,"text":"Si mu inu mi dun.","marked":"Sì mú inú mi dùn."}],"end":48.187},{"key":"7","start":49.137,"lines":[{"start":49.137,"end":50.283,"text":"Oba tikare wa","marked":"Ọba tìkárẹ̀ wá"},{"start":50.733,"end":51.774,"text":"Bo ljo Re loni","marked":"Bọ́ Ìjọ Rẹ lónì"},{"start":52.224,"end":54.041,"text":"Nihin l'a wa ti a si ri","marked":"Níhìn l'á wà tí a sì rí"},{"start":54.491,"end":56.169,"text":"A nyin, a gbadura.","marked":"A yín, a gbàdúrà."}],"end":56.169},{"key":"8","start":57.119,"lines":[{"start":57.119,"end":58.24,"text":"Ojo kan f'adura","marked":"Ọjọ́ kan f'àdúrà"},{"start":58.69,"end":59.717,"text":"N'nu ile mimo Re","marked":"N'nú ilé mímọ́ Rẹ"},{"start":60.167,"end":61.551,"text":"O san j'egberun ojo lo","marked":"Ó sàn j'ẹgbẹ̀rún ọjọ́ lọ"},{"start":62.001,"end":63.17,"text":"T'a lo f'adun ese.","marked":"T'á lọ f'adùn ẹ̀ṣẹ̀."}],"end":63.17},{"key":"9","start":64.12,"lines":[{"start":64.12,"end":65.462,"text":"Okan mi y'o f'ayo","marked":"Ọkàn mi y'ó f'ayọ̀"},{"start":65.912,"end":67.114,"text":"Wa n'iru ipo yi","marked":"Wá n'irú ipò yí"},{"start":67.564,"end":68.943,"text":"Y'o si ma duro de ojo","marked":"Y'ó sì má dúró de ọjọ́"},{"start":69.393,"end":71.927,"text":"Ibukun ailopin.  Amin","marked":"Ìbùkún àìlópin. Àmín"}],"end":71.927}]}