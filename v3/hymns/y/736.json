{"v":3,"coll":"y","num":736,"id":"hymn_736","title":"E YO, Jesu j‘Oba","duration":49.074,"voices":{"male":{"file":"y-736-male-v3.m4a","bytes":349478,"sha256":"18d394012bff8dfe4a51f775b98e83d051b27d5036c1923e0b698206d1a4f822","duration":49.1},"female":{"file":"y-736-female-v3.m4a","bytes":368053,"sha256":"e7493d5d484ad395e0f5c029441d3101e69c379c67f1d0397aa5a5a8d8bc313c","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.122,"text":"Ẹ YỌ, Jesu j‘Ọba,","marked":"Ẹ Yọ̀, Jésù j'Ọba"},{"start":2.572,"end":3.481,"text":"'Nu ọmọ eniyan,","marked":"nù ọmọ ènìyàn"},{"start":3.931,"end":5.388,"text":"O da ara tubu,","marked":"Ó dá ara túbú"},{"start":5.838,"end":7.038,"text":"O sọ wọn d'ominira:","marked":"Ó sọ wọ́n d'òmìnira"},{"start":7.488,"end":9.142,"text":"K'esu kọju s'ọm' Ọlọrun,","marked":"K'èṣù kọjú s'ọm' Ọlọ́run"},{"start":9.592,"end":11.426,"text":"Lai f'ọta pe isẹ Rẹ n lọ.","marked":"Láì f'ọ̀tá pé isẹ́ Rẹ̀ ń lọ."}],"end":11.426},{"key":"2","start":12.376,"lines":[{"start":12.376,"end":13.62,"text":"Isẹ ti ododo,","marked":"Isẹ́ ti òdodo"},{"start":14.07,"end":15.584,"text":"Otọ, alafia,","marked":"Òtọ̀, àlàáfíà"},{"start":16.034,"end":17.215,"text":"Fun r'ọrun ayé wa,","marked":"Fún r'ọ̀run ayé wa"},{"start":17.665,"end":18.763,"text":"Yoo tan ka kiri,","marked":"Yóò tàn ká kiri"},{"start":19.213,"end":21.852,"text":"Keferi, Juu, wọn o wolẹ,","marked":"Kèfèrí, Júù, wọn ó wólẹ̀"},{"start":22.302,"end":23.822,"text":"Wọn o jẹjẹ isin yiyẹ.","marked":"Wọn ò jẹ́jẹ́ ìsìn yíyẹ."}],"end":23.822},{"key":"3","start":24.772,"lines":[{"start":24.772,"end":25.853,"text":"Agbara l'owo Re","marked":"Agbára l'ọwọ́ Rẹ"},{"start":26.303,"end":27.376,"text":"Fun abo eni Re","marked":"Fún abo ẹni Rẹ"},{"start":27.826,"end":29.047,"text":"Si ase giga Re","marked":"Sí àṣẹ gíga Rẹ"},{"start":29.497,"end":30.875,"text":"L'opo o kiyesi","marked":"L'ọ́pọ̀ ò kíyèsi"},{"start":31.325,"end":32.607,"text":"Orun ayo ri ise Re,","marked":"Ọ̀run ayọ̀ rí iṣẹ́ Rẹ̀"},{"start":33.057,"end":34.591,"text":"Ekusu rere gb'ofin Re.","marked":"Èkùṣù rere gb'òfin Rẹ."}],"end":34.591},{"key":"4","start":35.541,"lines":[{"start":35.541,"end":37.61,"text":"Séráfù (Kérúbù) t'ayé yi,","marked":"Séráfù Kérúbù t'ayé yí"},{"start":38.06,"end":39.192,"text":"O fẹrẹ d'ijọ nla;","marked":"Ó fẹ́rẹ̀ d'ìjọ ńlá"},{"start":39.642,"end":40.706,"text":"Abukun wukara,","marked":"Àbùkún wúkàrà"},{"start":41.156,"end":42.312,"text":"Ko le sai tan kiri,","marked":"Kò lè ṣàì tán kiri"},{"start":42.762,"end":44.074,"text":"Tit'Ọlọrun Ọmọ tun wa,","marked":"Tít'Ọlọ́run Ọmọ tún wá"},{"start":44.524,"end":47.524,"text":"Ko le sai lọ. Amin! Amin!","marked":"Kò lè ṣàì lọ. Àmín! Àmín!"}],"end":47.524}]}