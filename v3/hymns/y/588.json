{"v":3,"coll":"y","num":588,"id":"hymn_588","title":"AO sise! ao sise! om'","duration":78.723,"voices":{"male":{"file":"y-588-male-v3.m4a","bytes":588516,"sha256":"1458eca6be2a4f506dde60d9ec54e493c90096e08f9e9ac4e662ad6b7b4b9348","duration":78.8},"female":{"file":"y-588-female-v3.m4a","bytes":601954,"sha256":"3ac6c42efe5d7525bd46729926dfab7c13cb1317ffd3f1464a8661cbc08eb543","duration":78.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.24,"text":"AO sise! ao sise! om'","marked":"Àó ṣiṣẹ́! àó ṣiṣẹ́! ọm"},{"start":2.69,"end":3.746,"text":"Olorun ni wa","marked":"Ọlọ́run ni wá"},{"start":4.196,"end":6.551,"text":"Jek'a tele ipa ti Oluwa wa to","marked":"Jek'a tẹ̀lé ipa tí Olúwa wà tọ́"},{"start":7.001,"end":7.976,"text":"K'a f' imoran","marked":"K'á f ìmọ̀ràn"},{"start":8.426,"end":10.013,"text":"Re so agbara wa d'otun","marked":"Rẹ̀ sọ agbára wa d'ọ̀tún"},{"start":10.463,"end":11.965,"text":"K'a fi gbogbo okun wa","marked":"K'á fi gbogbo okùn wá"},{"start":12.415,"end":13.593,"text":"sise t'a o se.","marked":"ṣíṣe t'a ó ṣe."},{"start":14.043,"end":15.972,"text":"Egbe: Foriti! Foriti!","marked":"Forítì! Forítì!"},{"start":16.422,"end":18.133,"text":"Ma reti, ma sona","marked":"Má retí, má ṣọ́nà"},{"start":18.583,"end":20.052,"text":"Titi Oluwa o fi de.","marked":"Títí Olúwa ó fi dé."}],"end":20.052},{"key":"CHORUS","start":21.002,"lines":[{"start":21.002,"end":22.986,"text":"Foriti! Foriti!","marked":"Forítì! Forítì!"},{"start":23.436,"end":25.047,"text":"Ma reti, ma sona","marked":"Má retí, má ṣọ́nà"},{"start":25.497,"end":27.011,"text":"Titi Oluwa o fi de.","marked":"Títí Olúwa ó fi dé."}],"end":27.011},{"key":"2","start":27.961,"lines":[{"start":27.961,"end":31.382,"text":"Ao sise! ao sise!, bo awon t'ebi npa","marked":"Àó ṣiṣẹ́! àó ṣiṣẹ́!, bo àwọn t'ebi ńpa"},{"start":31.832,"end":33.658,"text":"Ko awon alare lo s'orisun iye!","marked":"Kó àwọn aláre lọ s'orísun iye!"},{"start":34.108,"end":36.194,"text":"Ninu agbelebu l'awa o ma sogo","marked":"Nínú àgbélébùú l'àwa ó má ṣògo"},{"start":36.644,"end":39.531,"text":"Gbati a ba nkede pe, 'Ofe n'Igbala.","marked":"Gbátí a bá ńkéde pé, ọ̀fẹ́ n'Ìgbàlà."},{"start":39.981,"end":41.828,"text":"Egbe: Foriti! Foriti!...","marked":"Forítì! Forítì!"}],"end":41.828},{"key":"3","start":42.778,"lines":[{"start":42.778,"end":46.143,"text":"Ao sise, ao sise! gbogbo wa ni y'o se","marked":"Àó ṣiṣẹ́, àó ṣiṣẹ́! gbogbo wa ni y'ó ṣe"},{"start":46.593,"end":49.058,"text":"Ijoba okunkun at'iro yo fo","marked":"Ìjọba òkùnkùn àt'irọ́ yọ fọ́"},{"start":49.508,"end":51.444,"text":"Ao si gbe oruko Jesu leke","marked":"Àó sì gbé orúkọ Jésù lékè"},{"start":51.894,"end":54.312,"text":"N'nu orin iyin wa pe, 'Ofe n'Igbala.","marked":"N'nú orin ìyìn wá pé, ọ̀fẹ́ n'Ìgbàlà."},{"start":54.762,"end":56.869,"text":"Egbe: Foriti! Foriti!...","marked":"Forítì! Forítì!"}],"end":56.869},{"key":"4","start":57.819,"lines":[{"start":57.819,"end":61.258,"text":"Ao sise! ao sise! l'agbara Oluwa,","marked":"Àó ṣiṣẹ́! àó ṣiṣẹ́! l'agbára Olúwa"},{"start":61.708,"end":64.382,"text":"Agbala at'ade y'o si je ere wa","marked":"Àgbàlá àt'adé y'ó sì jẹ́ èrè wa"},{"start":64.832,"end":66.839,"text":"Gbat' ile awon oloto ba di tiwa","marked":"Gbàt ilé àwọn ọlọ́tọ̀ bá di tiwa"},{"start":67.289,"end":68.654,"text":"Gbogbo wa o jo ho pe","marked":"Gbogbo wa ò jọ hó pé"},{"start":69.104,"end":70.059,"text":"'Ofe n'Igbala.","marked":"ọ̀fẹ́ n'Ìgbàlà."},{"start":70.509,"end":72.265,"text":"Egbe: Foriti, foriti","marked":"Forítì, forítì"},{"start":72.715,"end":74.364,"text":"Ma reti, ma sona","marked":"Má retí, má ṣọ́nà"},{"start":74.814,"end":76.196,"text":"Titi Oluwa o fi de.","marked":"Títí Olúwa ó fi dé."},{"start":76.646,"end":77.174,"text":"Amin.","marked":"Àmín."}],"end":77.174}]}