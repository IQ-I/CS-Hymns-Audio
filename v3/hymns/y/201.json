{"v":3,"coll":"y","num":201,"id":"hymn_201","title":"WA, eyin oloto","duration":62.345,"voices":{"male":{"file":"y-201-male-v3.m4a","bytes":455110,"sha256":"4f8a2198cc156d9ac2770fd6b845054886e1a5683480671fbb0185c38a5296a2","duration":62.4},"female":{"file":"y-201-female-v3.m4a","bytes":467739,"sha256":"fb96a70b22494f2350fe35008808a997e2655ca2fa413c3acd296182a7d840cf","duration":62.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.65,"text":"WA, ẹyin oloto,","marked":"Wá, ẹ̀yin ọlọ́tọ̀"},{"start":2.1,"end":4.549,"text":"L'ayọ at'isegun, Wa","marked":"L'ayọ̀ àt'ìṣẹ́gun, Wá"},{"start":4.999,"end":8.527,"text":"k'a lo, wa ka lo si Betlehem, Wa","marked":"k'á lọ, wa ká lọ sí Betlehem, Wa"},{"start":8.977,"end":10.304,"text":"ka lo wo O! Oba","marked":"ká lọ wò Ó! Ọba"},{"start":10.754,"end":17.788,"text":"awon Angel. Ẹ wa ka lọ juba Rẹ, Ẹ wa ka lọ juba Rẹ, Ẹ wa k'a lọ juba Kristi Oluwa.","marked":"àwọn Angẹl. Ẹ wá ká lọ júbà Rẹ̀, Ẹ wá ká lọ júbà Rẹ̀, Ẹ wá k'á lọ júbà Kristi Olúwa."}],"end":17.788},{"key":"CHORUS","start":18.738,"lines":[{"start":18.738,"end":19.978,"text":"E wa ka lo juba Re,","marked":"Ẹ wá ká lọ júbà Rẹ̀"},{"start":20.428,"end":21.71,"text":"E wa ka lo juba Re,","marked":"Ẹ wá ká lọ júbà Rẹ̀"},{"start":22.16,"end":23.38,"text":"E wa k' a lo juba","marked":"Ẹ wá k á lọ júbà"},{"start":23.83,"end":24.945,"text":"Kristi Oluwa.","marked":"Kristi Olúwa."}],"end":24.945},{"key":"2","start":25.895,"lines":[{"start":25.895,"end":26.93,"text":"Olodumare ni!","marked":"Olódùmarè ni!"},{"start":27.38,"end":28.319,"text":"Imọlẹ Ododo,","marked":"Ìmọ́lẹ̀ Òdodo"},{"start":28.769,"end":30.311,"text":"Ko si korira inu Wundia;","marked":"Kò sì kórìra inú Wúńdíá"},{"start":30.761,"end":31.776,"text":"Ọlọrun papa ni,","marked":"Ọlọ́run pápá ni"},{"start":32.226,"end":34.029,"text":"T'a bi, t'a ko da.","marked":"T'á bí, t'á kò dá."}],"end":34.029},{"key":"3","start":34.979,"lines":[{"start":34.979,"end":36.67,"text":"Angeli, e korin,","marked":"Áńgẹ́lì, ẹ kọrin"},{"start":37.12,"end":38.26,"text":"Korin itoye Re;","marked":"Kọrin ìtòye Rẹ"},{"start":38.71,"end":40.496,"text":"Ki gbogbo eda orun si gberin:","marked":"Kí gbogbo ẹ̀dá ọ̀run sì gbẹ́rin"},{"start":40.946,"end":42.094,"text":"Ogo f' Olorun","marked":"Ògo f Ọlọ́run"},{"start":42.544,"end":43.719,"text":"L'oke orun l'ohun:","marked":"L'òkè ọ̀run l'ohun"}],"end":43.719},{"key":"4","start":44.669,"lines":[{"start":44.669,"end":46.178,"text":"Nitoto, a wole,","marked":"Nítòtọ́, a wọlé"},{"start":46.628,"end":48.957,"text":"F'Oba t'a bi loni: Jesu","marked":"F'Ọba t'á bí lónì: Jésù"},{"start":49.407,"end":51.139,"text":"iwo ni awa ń fi ogo fun,","marked":"ìwọ ni àwa ń fi ògo fún"},{"start":51.589,"end":52.514,"text":"'Wo Omo baba,","marked":"wo Ọmọ Baba"},{"start":52.964,"end":60.796,"text":"T'o gbe ara wa wo! Ẹ wa ka lọ juba Rẹ, Ẹ wa ka lọ juba Rẹ, Ẹ wa k'a lọ juba Kristi Oluwa.","marked":"T'ó gbé ara wa wò! Ẹ wá ká lọ júbà Rẹ̀, Ẹ wá ká lọ júbà Rẹ̀, Ẹ wá k'á lọ júbà Kristi Olúwa."}],"end":60.796}]}