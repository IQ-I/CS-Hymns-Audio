{"v":3,"coll":"y","num":218,"id":"hymn_218","title":"ODUN titun de awa n yo","duration":109.735,"voices":{"male":{"file":"y-218-male-v3.m4a","bytes":795059,"sha256":"22e49e90fdc4214b8db1130556a3b1225c54d3cdbc13bf4773d22272cf8e8640","duration":109.8},"female":{"file":"y-218-female-v3.m4a","bytes":818205,"sha256":"e7d570d8475fff0eebf14700e4fcf7cdd7181a047af4b2030e00b5d2e90ea140","duration":109.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.888,"text":"ỌDUN titun de awa ń yọ,","marked":"Ọdún titun dé àwa ń yọ̀"},{"start":2.338,"end":4.454,"text":"Tiwa to bẹ, o ju bẹ lọ,","marked":"Tiwa tó bẹ, ó ju bẹ lọ"},{"start":4.904,"end":6.095,"text":"Awa 'jọ Séráfù,","marked":"Àwa 'jọ Séráfù"},{"start":6.545,"end":8.099,"text":"Ko ni gbagbe l'ọdun to lọ,","marked":"Kò ní gbàgbé l'ọdún tó lọ"},{"start":8.549,"end":9.965,"text":"K'Ọlọrun se 'yi l'ọdun re,","marked":"K'Ọlọ́run ṣe yí l'ọdún rẹ̀"},{"start":10.415,"end":11.68,"text":"Ẹ ku ewu Ọdun.","marked":"Ẹ kú ẹ̀wù Ọdún."}],"end":11.68},{"key":"2","start":12.63,"lines":[{"start":12.63,"end":14.056,"text":"Ẹyin ọmọ 'jọ Kérúbù,","marked":"Ẹ̀yin ọmọ 'jọ Kérúbù"},{"start":14.506,"end":16.336,"text":"K'ẹ sotitọ titi d'opin,","marked":"K'ẹ́ sòtítọ́ títí d'òpin"},{"start":16.786,"end":18.068,"text":"K'ẹ mura s' adura,","marked":"K'ẹ múra s àdúrà"},{"start":18.518,"end":19.992,"text":"K'ẹ ma woju ẹnikẹni,","marked":"K'ẹ má wojú ẹnikẹ́ni"},{"start":20.442,"end":21.727,"text":"Ẹ gbọran si agba l'ẹnu,","marked":"Ẹ gbọ́ràn sí àgbà l'ẹnu"},{"start":22.177,"end":23.411,"text":"Ẹ yẹ 'ra ọdun wo.","marked":"Ẹ yẹ ra ọdún wò."}],"end":23.411},{"key":"3","start":24.361,"lines":[{"start":24.361,"end":25.693,"text":"Ẹyin Ijọ Aladura,","marked":"Ẹ̀yin Ìjọ Aládúrà"},{"start":26.143,"end":27.603,"text":"K'ẹ ranti iran ti ẹ ń ri,","marked":"K'ẹ rántí ìran tí ẹ ń rí"},{"start":28.053,"end":29.138,"text":"S'ipa iwa rere,","marked":"S'ipa ìwà rere"},{"start":29.588,"end":31.121,"text":"K'ẹ mura lati d'ohun pọ,","marked":"K'ẹ múra láti d'ohun pọ̀"},{"start":31.571,"end":32.996,"text":"Ẹ se ara yin ni ọkan.","marked":"Ẹ ṣe ara yín ní ọkàn."},{"start":33.446,"end":34.812,"text":"Ẹ yẹ'ra ọdun wo.","marked":"Ẹ yẹ̀'rá ọdún wò."}],"end":34.812},{"key":"4","start":35.762,"lines":[{"start":35.762,"end":37.122,"text":"Awọn ti ko gba iran gbọ,","marked":"Àwọn tí kò gba ìran gbọ́"},{"start":37.572,"end":38.914,"text":"Wọn dabi akọ keferi;","marked":"Wọ́n dàbí akọ kèfèrí"},{"start":39.364,"end":40.73,"text":"Wọn ko mọ 'kan s'ọkan,","marked":"Wọn kò mọ kan s'ọkàn"},{"start":41.18,"end":42.48,"text":"Bere lọwọ Jenny Winful,","marked":"Bẹ̀rẹ̀ lọ́wọ́ Jenny Winful"},{"start":42.93,"end":44.444,"text":"Ohun t'o ri k'o to bimọ,","marked":"Ohun t'ó rí k'ó tó bímọ"},{"start":44.894,"end":46.09,"text":"Ẹ yẹ'ra ọdun wo.","marked":"Ẹ yẹ̀'rá ọdún wò."}],"end":46.09},{"key":"5","start":47.04,"lines":[{"start":47.04,"end":48.762,"text":"K'a fi keta gbogbo silẹ,","marked":"K'á fi kẹta gbogbo sílẹ̀"},{"start":49.212,"end":50.76,"text":"K'a fẹ ọm'ẹnikeji wa,","marked":"K'á fẹ́ ọm'ẹnìkejì wa"},{"start":51.21,"end":52.641,"text":"L'ọdun t'a bọ si yi,","marked":"L'ọdún t'á bọ́ sí yí"},{"start":53.091,"end":54.252,"text":"K'a ma sọrọ ẹni lẹhin,","marked":"K'á má sọ̀rọ̀ ẹni lẹ́hìn"},{"start":54.702,"end":56.175,"text":"K'ija gbogbo kuro l'ona,","marked":"K'ìjà gbogbo kúrò l'ọ̀nà"},{"start":56.625,"end":57.905,"text":"Ẹ yẹ'ra ọdun wo.","marked":"Ẹ yẹ̀'rá ọdún wò."}],"end":57.905},{"key":"6","start":58.855,"lines":[{"start":58.855,"end":60.675,"text":"Ninu ọdun t'a bọ si yi,","marked":"Nínú ọdún t'a bọ́ sí yí"},{"start":61.125,"end":62.508,"text":"Agan a f'ọwọ s'osun,","marked":"Àgàn a f'ọwọ́ s'oṣùn"},{"start":62.958,"end":63.907,"text":"Ọlọmọ a tun bi,","marked":"Ọlọ́mọ a tún bí"},{"start":64.357,"end":65.796,"text":"Ẹni t'o jẹ gbese y'o san,","marked":"Ẹni t'ó jẹ́ gbèsè y'ó sàn"},{"start":66.246,"end":69.256,"text":"Ajẹ, oso ko ni ri wa,","marked":"Àjẹ́, ọ̀ṣọ́ kò ní rí wa"},{"start":69.706,"end":70.971,"text":"Ẹ yẹ'ra ọdun wo.","marked":"Ẹ yẹ̀'rá ọdún wò."}],"end":70.971},{"key":"7","start":71.921,"lines":[{"start":71.921,"end":73.484,"text":"E wo bi ilu wa ti ri,","marked":"Ẹ wo bí ìlú wa ti rí"},{"start":73.934,"end":75.563,"text":"Ajakal' arun tun gb'ode,","marked":"Àjàkál àrùn tún gb'ọdẹ"},{"start":76.013,"end":77.175,"text":"K'Olorun mu kuro,","marked":"K'Ọlọ́run mú kúrò"},{"start":77.625,"end":79.224,"text":"Nipa awe at'adura,","marked":"Nípa àwẹ̀ àt'àdúrà"},{"start":79.674,"end":81.21,"text":"K'okan gbogbo wa nirepo,","marked":"K'ọkàn gbogbo wà nírẹ̀pọ̀"},{"start":81.66,"end":82.825,"text":"E ye 'ra odun wo.","marked":"Ẹ yẹ ra ọdún wò."}],"end":82.825},{"key":"8","start":83.775,"lines":[{"start":83.775,"end":85.934,"text":"A ko ri ra, a ko ri ta,","marked":"A kò rí rà, a kò rí ta"},{"start":86.384,"end":87.665,"text":"Ko tun s'awọn alanu mọ,","marked":"Kò tún s'àwọ̀n alánú mọ́"},{"start":88.115,"end":89.399,"text":"Owo ko si l'ode,","marked":"Owó kò sì l'òde"},{"start":89.849,"end":91.399,"text":"Ibawi Ọlọrun l'eyi,","marked":"Ìbáwí Ọlọ́run l'èyí"},{"start":91.849,"end":93.515,"text":"K'a ronu k' a p'iwa wa da.","marked":"K'á ronú k á p'ìwà wa dà."},{"start":93.965,"end":95.196,"text":"Ẹ yẹ'ra ọdun wo.","marked":"Ẹ yẹ̀'rá ọdún wò."}],"end":95.196},{"key":"9","start":96.146,"lines":[{"start":96.146,"end":97.587,"text":"Nigba t'o ba d'ọjọ 'kẹhin,","marked":"Nígbà t'ó bá d'ọjọ́ 'kẹhin"},{"start":98.037,"end":99.498,"text":"Ti ọmọ ko ni mọ baba,","marked":"Tí ọmọ kò ní mọ Baba"},{"start":99.948,"end":101.703,"text":"Oluwa, ranti mi,","marked":"Olúwa, rántí mi"},{"start":102.153,"end":103.773,"text":"K'a le gbọ ohun 'kẹlẹ ni,","marked":"K'á lè gbọ́ ohùn 'kẹlẹ ni"},{"start":104.223,"end":106.403,"text":"Wi pé, ma bọ, ọmọ rere,","marked":"Wí pé, má bọ̀, ọmọ rere"},{"start":106.853,"end":108.187,"text":"K'a gb'ade nikẹhin.","marked":"K'á gb'adé níkẹ̀hìn."}],"end":108.187}]}