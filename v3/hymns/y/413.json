{"v":3,"coll":"y","num":413,"id":"hymn_413","title":"MA koja mi, Olugbala","duration":36.915,"voices":{"male":{"file":"y-413-male-v3.m4a","bytes":251146,"sha256":"05f59fe8459651d1856a8ea28aebdc7d634354cd92a8525310ac13fafe643114","duration":37.0},"female":{"file":"y-413-female-v3.m4a","bytes":263163,"sha256":"6478e9c55884c7758859f5f86a2474fb0726a71a25e0da72115e542fed0e4639","duration":37.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.063,"text":"MA koja mi, Olugbala","marked":"Má kọjá mi, Olùgbàlà"},{"start":2.513,"end":3.499,"text":"Gbo adura mi","marked":"Gbọ́ àdúrà mi"},{"start":3.949,"end":5.476,"text":"Gbati lwo ba np'elomiran","marked":"Gbátí Ìwọ bá ńp'ẹlòmíràn"},{"start":5.926,"end":7.019,"text":"Mase koja mi!","marked":"Máṣe kọjá mi!"}],"end":7.019},{"key":"CHORUS","start":7.969,"lines":[{"start":7.969,"end":10.299,"text":"Jesu! Jesu! Gbo adura mi!","marked":"Jésù! Jésù! Gbọ́ àdúrà mi!"},{"start":10.749,"end":12.367,"text":"Gbat'lwo ba np'elomiran","marked":"Gbàt'lwò bá ńp'ẹlòmíràn"},{"start":12.817,"end":14.009,"text":"Mase koja mi.","marked":"Mase kọjá mi."}],"end":14.009},{"key":"2","start":14.959,"lines":[{"start":14.959,"end":16.289,"text":"N'ite anu je k'emi ri,","marked":"N'ìtẹ́ àánú jẹ́ k'èmi rí"},{"start":16.739,"end":17.673,"text":"ltura didun","marked":"Ìtura dídùn"},{"start":18.123,"end":19.539,"text":"Teduntedun ni mo wole","marked":"Tẹ̀dùntẹ̀dùn ni mo wọlé"},{"start":19.989,"end":21.071,"text":"Jo ran mi lowo.","marked":"Jọ ràn mí lọ́wọ́."}],"end":21.071},{"key":"3","start":22.021,"lines":[{"start":22.021,"end":23.428,"text":"N'igbekele itoye Re","marked":"N'ìgbẹ́kẹ̀lé ìtòye Rẹ"},{"start":23.878,"end":24.979,"text":"L'em'o w'oju Re","marked":"L'ẹ̀m'ọ́ w'ojú Rẹ̀"},{"start":25.429,"end":26.744,"text":"Wo 'banuje okan mi san","marked":"Wo banújẹ́ ọkàn mi sàn"},{"start":27.194,"end":28.31,"text":"F'ife re gba mi.","marked":"F'ìfẹ́ rẹ gbà mí."}],"end":28.31},{"key":"4","start":29.26,"lines":[{"start":29.26,"end":30.619,"text":"'Wo orisun itunu mi","marked":"wo orísun ìtùnú mi"},{"start":31.069,"end":31.995,"text":"Ju ye fun mi lo","marked":"Ju yẹ fún mi lọ"},{"start":32.445,"end":34.006,"text":"Tani mo ni l'aiye l'orun","marked":"Tani mo ní l'ayé l'ọ̀run"},{"start":34.456,"end":35.366,"text":"Bikose lwo?","marked":"Bíkọsẹ̀ Ìwọ?"}],"end":35.366}]}