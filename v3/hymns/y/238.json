{"v":3,"coll":"y","num":238,"id":"hymn_238","title":"ALAIMO ni emi","duration":37.295,"voices":{"male":{"file":"y-238-male-v3.m4a","bytes":249254,"sha256":"6b3a034a315b84b1df3b833f9440ba3c3a8fdc591e2a8e61f34056c6d6fd018e","duration":37.3},"female":{"file":"y-238-female-v3.m4a","bytes":258275,"sha256":"3132bf7de8e8f130d73582b74f94f69ad635ff85bdcad28de391082113580d14","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.439,"text":"ALAIMO ni emi","marked":"Aláìmọ́ ni èmi"},{"start":1.889,"end":2.807,"text":"Olorun Oluwa!","marked":"Ọlọ́run Olúwa!"},{"start":3.257,"end":4.462,"text":"Emi ha gbodo sunmo O,","marked":"Èmi ha gbọdọ̀ súnmọ́ Ọ"},{"start":4.912,"end":5.841,"text":"T'emi t'eru ese?","marked":"T'èmi t'ẹrú ẹ̀ṣẹ̀?"}],"end":5.841},{"key":"2","start":6.791,"lines":[{"start":6.791,"end":8.14,"text":"Ẹru ẹsẹ yi n pa,","marked":"Ẹ̀rù ẹsẹ̀ yí ń pa"},{"start":8.59,"end":9.456,"text":"Ọkan buburu mi;","marked":"Ọkàn búburú mi"},{"start":9.906,"end":11.511,"text":"Yio ha si ti buru to,","marked":"Yóò ha sì ti burú tó"},{"start":11.961,"end":13.054,"text":"L'oju Rẹ mimọ ni!","marked":"L'ojú Rẹ mímọ́ ni!"}],"end":13.054},{"key":"3","start":14.004,"lines":[{"start":14.004,"end":15.091,"text":"Emi o ha si ku","marked":"Èmi ó ha sì kú"},{"start":15.541,"end":16.642,"text":"Ni alainireti?","marked":"Ní aláìnírètí?"},{"start":17.092,"end":18.487,"text":"Mo r'ayo ninu iku Re","marked":"Mo r'ayọ̀ nínú ikú Rẹ"},{"start":18.937,"end":20.218,"text":"Fun otosi b'emi.","marked":"Fún òtòṣì b'èmi."}],"end":20.218},{"key":"4","start":21.168,"lines":[{"start":21.168,"end":22.316,"text":"Eje ni ti o ta","marked":"Ẹ̀jẹ̀ ni tí ó ta"},{"start":22.766,"end":23.743,"text":"T'ise or'ofe Re","marked":"T'iṣẹ́ ọr'ọ̀fẹ́ Rẹ"},{"start":24.193,"end":26.436,"text":"Le w'elese, t'o buru ju","marked":"Lè w'ẹlẹ́ṣẹ̀, t'ó burú jù"},{"start":26.886,"end":28.095,"text":"Le m'okan lile ro.","marked":"Lè m'ọkàn líle rò."}],"end":28.095},{"key":"5","start":29.045,"lines":[{"start":29.045,"end":30.642,"text":"pp Mo wolẹ l'ẹsẹ Rẹ,","marked":"pp Mo wólẹ̀ l'ẹsẹ̀ Rẹ"},{"start":31.092,"end":32.282,"text":"Jọ k'O dariji mi;","marked":"Jọ k'Ó dáríjì mi"},{"start":32.732,"end":34.053,"text":"Nihin l'emi o wa titi,","marked":"Níhìn l'èmi ó wà títí"},{"start":34.503,"end":35.746,"text":"'Wọ o wi pé, ―Dide.","marked":"'Wọ ó wí pé, ―Dìde."}],"end":35.746}]}