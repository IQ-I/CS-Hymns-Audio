{"v":3,"coll":"y","num":599,"id":"hymn_599","title":"Gba t'a b'Oluwa rin","duration":70.088,"voices":{"male":{"file":"y-599-male-v3.m4a","bytes":499249,"sha256":"5096377a04dfaf31823caa88808bfcf6a9a1c2e48a0f0ee9f70e2fd6c80af1a6","duration":70.1},"female":{"file":"y-599-female-v3.m4a","bytes":515865,"sha256":"f8650d5ec2a00e71dff3244baa411273e37c3b6fdd5cc61901cdd2c28bef8de5","duration":70.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.489,"text":"Gba t'a b'Oluwa rin","marked":"Gba t'á b'Olúwa rìn"},{"start":1.939,"end":3.217,"text":"N'nu 'mole Oro re","marked":"N'nú mọ́lẹ̀ Ọ̀rọ̀ rẹ"},{"start":3.667,"end":5.726,"text":"Ona wa yoo ti ni 'mole to","marked":"Ọ̀nà wa yóò ti ní mọ́lẹ̀ tó"},{"start":6.176,"end":7.405,"text":"Gba t'a ba n se 'fe Re","marked":"Gba t'á bá ń ṣe fẹ́ Rẹ"},{"start":7.855,"end":9.173,"text":"Oun yoo maa ba wa gbe","marked":"Òun yóò máa bá wa gbé"},{"start":9.623,"end":11.208,"text":"Ati awon t'o gbekele won le e","marked":"Àti àwọn t'ó gbẹ́kẹ̀lé wọn lé e"}],"end":11.208},{"key":"CHORUS","start":12.158,"lines":[{"start":12.158,"end":13.12,"text":"Sa gekele e","marked":"Sá gẹ́kẹ̀lé e"},{"start":13.57,"end":14.727,"text":"Ona miiran ko si","marked":"Ọ̀nà mìíràn kò sí"},{"start":15.177,"end":16.748,"text":"Lati l'ayo n'nu Jesu","marked":"Láti l'ayọ̀ n'nú Jésù"},{"start":17.198,"end":18.608,"text":"Ju pe k'a gbeke le.","marked":"Ju pé k'á gbẹ́kẹ̀ le."}],"end":18.608},{"key":"2","start":19.558,"lines":[{"start":19.558,"end":20.728,"text":"Ko s'ohun t'o le de","marked":"Kò s'ohun t'ó lè dé"},{"start":21.178,"end":22.566,"text":"L'oke tabi n'ile","marked":"L'òkè tàbí n'ilẹ̀"},{"start":23.016,"end":24.817,"text":"T'o le ko agbara Re l'oju","marked":"T'ó lè kó agbára Rẹ̀ l'ojú"},{"start":25.267,"end":27.138,"text":"Iyemeji, eru","marked":"Iyèméjì, ẹ̀rù"},{"start":27.588,"end":29.27,"text":"Ibanuje, ekun","marked":"Ìbànújẹ́, ẹkún"},{"start":29.72,"end":31.313,"text":"Ko le duro b'a ba gbekele e.","marked":"Kò lè dúró b'á bá gbẹ́kẹ̀lé e."}],"end":31.313},{"key":"3","start":32.263,"lines":[{"start":32.263,"end":33.293,"text":"Ko si wahala mo","marked":"Kò sì wàhálà mọ́"},{"start":33.743,"end":34.769,"text":"Tabi ibanuje","marked":"Tàbí ìbànújẹ́"},{"start":35.219,"end":37.002,"text":"O ti san gbogbo 'gbese wonyi","marked":"Ó ti san gbogbo gbèsè wọ̀nyí"},{"start":37.452,"end":38.493,"text":"Ko si arokan mo","marked":"Kò sí àrọ̀kan mọ́"},{"start":38.943,"end":39.934,"text":"Tabi ifajuro","marked":"Tàbí ìfàjúrò"},{"start":40.384,"end":42.195,"text":"Sugbon 'bukun b'a bagbekele e.","marked":"Ṣùgbọ́n bùkún b'á bágbẹ́kẹ̀lé e."}],"end":42.195},{"key":"4","start":43.145,"lines":[{"start":43.145,"end":44.215,"text":"A ko le f'enu so","marked":"A kò lè f'ẹnu sọ"},{"start":44.665,"end":45.962,"text":"B'ife Re ti po to","marked":"B'ìfẹ́ Rẹ ti pọ̀ tó"},{"start":46.412,"end":48.427,"text":"Titi a o fi f'ara wa rubo","marked":"Títí a ó fi f'ara wa rúbọ"},{"start":48.877,"end":50.321,"text":"Aanu ti o n fi han","marked":"Àánú tí ó ń fi hàn"},{"start":50.771,"end":52.379,"text":"At'ayo t'O n fun ni","marked":"Àt'ayọ̀ t'Ó ń fún ni"},{"start":52.829,"end":55.046,"text":"Je ti awon ti o gbekele e.","marked":"Jẹ́ ti àwọn tí ó gbẹ́kẹ̀lé e."}],"end":55.046},{"key":"5","start":55.996,"lines":[{"start":55.996,"end":57.164,"text":"N'idapo pelu Re","marked":"N'ìdàpọ̀ pẹ̀lú Rẹ"},{"start":57.614,"end":58.912,"text":"A o jokoo l'ese re","marked":"A ó jókòó l'ẹsẹ̀ rẹ̀"},{"start":59.362,"end":61.16,"text":"Tabi ki a maa rin pelu Re","marked":"Tàbí kí a máa rìn pẹ̀lú Rẹ"},{"start":61.61,"end":62.917,"text":"Awa yoo gbo ti Re","marked":"Àwa yóò gbọ́ tí Rẹ"},{"start":63.367,"end":64.646,"text":"A o j'ise t'O ran wa","marked":"A ò j'iṣẹ́ t'Ó ràn wá"},{"start":65.096,"end":67.532,"text":"Ma beru, sa gbekele e nikan.","marked":"Má bẹ̀rù, sá gbẹ́kẹ̀lé e nìkan."},{"start":67.982,"end":68.539,"text":"Amin.","marked":"Àmín."}],"end":68.539}]}