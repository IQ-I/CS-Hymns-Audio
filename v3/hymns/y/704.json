{"v":3,"coll":"y","num":704,"id":"hymn_704","title":"ALAFIA ni f'Egbe na","duration":63.41,"voices":{"male":{"file":"y-704-male-v3.m4a","bytes":436500,"sha256":"53f896b0f55af06a8cd98445bebbd4865f22391a404800e8213d67c82e69e00e","duration":63.5},"female":{"file":"y-704-female-v3.m4a","bytes":451864,"sha256":"0e30aa508866a5377623fa6009fabc833362eb398d19e877fbe41417fab08656","duration":63.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.009,"text":"ALAFIA ni f'Ẹgbẹ na,","marked":"Àlàáfíà ni f'Ẹ̀gbẹ́ ná"},{"start":2.459,"end":3.765,"text":"T'o n se ajọdun loni,","marked":"T'ó ń ṣe àjọ̀dún lónì"},{"start":4.215,"end":5.947,"text":"Kérúbù t'oke sọkalẹ,","marked":"Kérúbù t'òkè sọ̀kalẹ̀"},{"start":6.397,"end":8.023,"text":"Lati ba wa yọ ayọ na.","marked":"Láti bá wa yọ ayọ̀ ná."}],"end":8.023},{"key":"CHORUS","start":8.973,"lines":[{"start":8.973,"end":9.727,"text":"Awa n jo","marked":"Àwa ń jó"},{"start":10.177,"end":11.741,"text":"-- awa n yọ ) Ogun orun sokale 2ce","marked":"àwa ń yọ Ogun ọ̀run sọ̀kalẹ̀"}],"end":11.741},{"key":"2","start":12.691,"lines":[{"start":12.691,"end":14.117,"text":"Ọmọ Ẹgbẹ Kristi Mimọ,","marked":"Ọmọ Ẹgbẹ́ Kristi Mímọ́"},{"start":14.567,"end":16.365,"text":"Ẹ wa k'a jọ y'ayọ na,","marked":"Ẹ wá k'á jọ y'ayọ̀ ná"},{"start":16.815,"end":18.272,"text":"K'ẹnikẹni ma ku sẹyin,","marked":"K'ẹnikẹ́ni má kú sẹ́yìn"},{"start":18.722,"end":20.183,"text":"Gbogbo wa ni Jesu n pe.","marked":"Gbogbo wa ni Jésù ń pè."}],"end":20.183},{"key":"3","start":21.133,"lines":[{"start":21.133,"end":22.581,"text":"Ẹgbẹ Kérúbù Séráfù,","marked":"Ẹgbẹ́ Kérúbù Séráfù"},{"start":23.031,"end":24.03,"text":"At'awọn aladura,","marked":"Àt'àwọn aládúrà"},{"start":24.48,"end":25.848,"text":"At'ẹyin onisin-owurọ,","marked":"Àt'ẹ̀yin onisin-owurọ"},{"start":26.298,"end":27.781,"text":"Jẹ k'a kọrin na soke.","marked":"Jẹ́ k'á kọrin nà sókè."}],"end":27.781},{"key":"4","start":28.731,"lines":[{"start":28.731,"end":31.046,"text":"Egbe Mary, Egbe Martha","marked":"Ẹgbẹ́ Mary, Ẹgbẹ́ Martha"},{"start":31.496,"end":33.108,"text":"Egbe Ayaba Esther","marked":"Ẹgbẹ́ Ayaba Esther"},{"start":33.558,"end":35.283,"text":"Egbe Dorcas gbohun soke","marked":"Ẹgbẹ́ Dorcas gbóhùn sókè"},{"start":35.733,"end":37.169,"text":"K'a jumo yo ayo na.","marked":"K'á jùmọ̀ yọ ayọ̀ ná."}],"end":37.169},{"key":"5","start":38.119,"lines":[{"start":38.119,"end":39.928,"text":"Orin Halle, Halleluyah,","marked":"Orin Halle, Hallelúyà"},{"start":40.378,"end":41.704,"text":"L'awa yoo ma kọ lorun,","marked":"L'àwa yóò má kọ lọ́rùn"},{"start":42.154,"end":43.477,"text":"Gba t'a ba ri Olugbala,","marked":"Gba t'á bá rí Olùgbàlà"},{"start":43.927,"end":45.18,"text":"Lor' itẹ Baba loke.","marked":"Lọ́r ìtẹ́ Baba lókè."}],"end":45.18},{"key":"6","start":46.13,"lines":[{"start":46.13,"end":48.49,"text":"Ẹgbẹ Dafidi: Ẹgbẹ Aaroni,","marked":"Ẹgbẹ́ Dafidi: Ẹgbẹ́ Aaroni"},{"start":48.94,"end":50.261,"text":"Ẹgbẹ F'Ogo Ọlọrun han,","marked":"Ẹgbẹ́ F'Ògo Ọlọ́run hàn"},{"start":50.711,"end":52.157,"text":"Ẹgbẹ Baba nla mejila,","marked":"Ẹgbẹ́ Baba ńlá méjìlá"},{"start":52.607,"end":54.064,"text":"Gbe'da 'sẹgun yin soke.","marked":"Gbé'dà 'sẹgun yín sókè."}],"end":54.064},{"key":"7","start":55.014,"lines":[{"start":55.014,"end":56.608,"text":"E f'Ogo fun Baba loke","marked":"Ẹ f'Ògo fún Baba lókè"},{"start":57.058,"end":58.234,"text":"E f'Ogo fun Omo Re","marked":"Ẹ f'Ògo fún Ọmọ Rẹ"},{"start":58.684,"end":59.914,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":60.364,"end":61.861,"text":"Ope ye Metalokan.","marked":"Ọpẹ́ yẹ Mẹ́talọ́kan."}],"end":61.861}]}