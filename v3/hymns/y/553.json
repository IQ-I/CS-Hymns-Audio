{"v":3,"coll":"y","num":553,"id":"hymn_553","title":"EGBE Seraf'e w'asia","duration":66.932,"voices":{"male":{"file":"y-553-male-v3.m4a","bytes":470614,"sha256":"5108f26af1b54c59718eff6453b8b10f1b079128dd232701e7c5c67157e990d2","duration":67.0},"female":{"file":"y-553-female-v3.m4a","bytes":489473,"sha256":"3e5eba479e0dd2c0349f16657535958020642898e57bcea328479a30fc55fc6d","duration":67.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.855,"text":"EGBE Seraf'e w'asia","marked":"Ẹgbẹ́ Seraf'ẹ́ w'asia"},{"start":2.305,"end":3.496,"text":"Bo ti nfe lele","marked":"Bó ti ńfẹ́ lélẹ̀"},{"start":3.946,"end":5.317,"text":"Awa Kerub' si ti mura","marked":"Àwa Kerub sì ti múra"},{"start":5.767,"end":6.983,"text":"Awa yio segun.","marked":"Àwa yóò ṣẹ́gun."},{"start":7.433,"end":8.867,"text":"Egbe:  Nde Baba Aladura nde","marked":"Ǹdé Baba Aládúrà ńdé"},{"start":9.317,"end":10.394,"text":"Jesu lo ran O","marked":"Jésù lọ rán Ọ"},{"start":10.844,"end":12.162,"text":"Awa Omo Re ti mura","marked":"Àwa Ọmọ Rẹ ti múra"},{"start":12.612,"end":13.891,"text":"Awa ki yio beru.","marked":"Àwa kí yóò bẹ̀rù."}],"end":13.891},{"key":"CHORUS","start":14.841,"lines":[{"start":14.841,"end":16.425,"text":"Nde Baba Aladura nde","marked":"Ǹdé Baba Aládúrà ńdé"},{"start":16.875,"end":17.954,"text":"Jesu lo ran O","marked":"Jésù lọ rán Ọ"},{"start":18.404,"end":19.692,"text":"Awa Omo Re ti mura","marked":"Àwa Ọmọ Rẹ ti múra"},{"start":20.142,"end":21.351,"text":"Awa ki yio beru.","marked":"Àwa kí yóò bẹ̀rù."}],"end":21.351},{"key":"2","start":22.301,"lines":[{"start":22.301,"end":23.691,"text":"Wo Satan pel'ogun re","marked":"Wo Satan pẹ̀l'ogun rẹ̀"},{"start":24.141,"end":25.421,"text":"Maikiel fon won ka","marked":"Maikiel fọ́n wọn ká"},{"start":25.871,"end":27.051,"text":"Awon Alagbara subu","marked":"Àwọn Alágbára ṣubú"},{"start":27.501,"end":28.829,"text":"Seraf' te won pa.","marked":"Seraf tẹ́ wọn pa."},{"start":29.279,"end":30.649,"text":"Egbe:  Nde Baba Aladura...","marked":"Ǹdẹ Baba Aládúrà"}],"end":30.649},{"key":"3","start":31.599,"lines":[{"start":31.599,"end":33.055,"text":"Jesu Olugbala wipe","marked":"Jésù Olùgbàlà wípé"},{"start":33.505,"end":34.344,"text":"Emi fere de","marked":"Èmi fèrè dé"},{"start":34.794,"end":36.008,"text":"A si ayo dahun pe","marked":"A sí ayọ̀ dáhùn pé"},{"start":36.458,"end":37.674,"text":"E dide asegun.","marked":"Ẹ dìde aṣẹ́gun."},{"start":38.124,"end":39.329,"text":"Egbe:  Nde Baba Aladura...","marked":"Ǹdẹ Baba Aládúrà"}],"end":39.329},{"key":"4","start":40.279,"lines":[{"start":40.279,"end":41.791,"text":"Nigbati ogun ba gbona","marked":"Nígbàtí ogun bá gbóná"},{"start":42.241,"end":43.623,"text":"O pe, Ma beru","marked":"Ó pè, Má bẹ̀rù"},{"start":44.073,"end":45.803,"text":"L'o to Balogun wa Maikiel","marked":"L'ó tó Balógun wá Maikiel"},{"start":46.253,"end":47.447,"text":"Si fa da re yo.","marked":"Sì fà dá rẹ̀ yọ."},{"start":47.897,"end":49.11,"text":"Egbe:  Nde Baba Aladura...","marked":"Ǹdẹ Baba Aládúrà"}],"end":49.11},{"key":"5","start":50.06,"lines":[{"start":50.06,"end":52.126,"text":"Wo Asia Jesu ti nfe","marked":"Wo Asia Jésù tí ńfẹ́"},{"start":52.576,"end":53.461,"text":"Ohun lpe ndun","marked":"Ohun Ìpè ńdùn"},{"start":53.911,"end":55.679,"text":"Mose yio segun gbogbo ota","marked":"Mósè yóò ṣẹ́gun gbogbo ọ̀tá"},{"start":56.129,"end":57.271,"text":"Lagbara Jesu.","marked":"Lágbára Jésù."},{"start":57.721,"end":59.161,"text":"Egbe:  Nde Baba Aladura nde","marked":"Ǹdé Baba Aládúrà ńdé"},{"start":59.611,"end":60.693,"text":"Jesu lo ran O","marked":"Jésù lọ rán Ọ"},{"start":61.143,"end":62.46,"text":"Awa Omo Re ti mura","marked":"Àwa Ọmọ Rẹ ti múra"},{"start":62.91,"end":65.383,"text":"Awa ki yio beru.  Jesu","marked":"Àwa kí yóò bẹ̀rù. Jésù"}],"end":65.383}]}