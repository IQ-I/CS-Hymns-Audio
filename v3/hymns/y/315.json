{"v":3,"coll":"y","num":315,"id":"hymn_315","title":"ISINMI awon mimo","duration":56.269,"voices":{"male":{"file":"y-315-male-v3.m4a","bytes":392805,"sha256":"e9603960ede4dc9c025c34a2833c669f393e2a89750e035fc2c034f14cef7f97","duration":56.3},"female":{"file":"y-315-female-v3.m4a","bytes":413579,"sha256":"a64f0cc7590ce28113d5ff357b5957588411befe27730f72af952f666f099e49","duration":56.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.361,"text":"ISINMI awọn mimọ,","marked":"Ìsinmi àwọn mímọ́"},{"start":1.811,"end":2.804,"text":"Ọjọ ohun ijinlẹ,","marked":"Ọjọ́ ohun ìjìnlẹ̀"},{"start":3.254,"end":4.564,"text":"Ti Ẹlẹda ti bukun","marked":"Tí Ẹlẹda ti bùkún"},{"start":5.014,"end":6.046,"text":"Apẹrẹ isinmi Rẹ,","marked":"Apẹ̀rẹ̀ ìsinmi Rẹ̀"},{"start":6.496,"end":7.704,"text":"Oluwa sinmi 'sẹ Rẹ,","marked":"Olúwa sinmi 'sẹ Rẹ̀"},{"start":8.154,"end":9.539,"text":"O ya 'jọ na si mimọ.","marked":"Ó ya 'jọ ná sí mímọ́."}],"end":9.539},{"key":"2","start":10.489,"lines":[{"start":10.489,"end":11.754,"text":"Loni oku Oluwa,","marked":"Lónì òkú Olúwa"},{"start":12.204,"end":13.497,"text":"N sinmi ninu iboji:","marked":"Ń sinmi nínú ibojì"},{"start":13.947,"end":15.413,"text":"A ti we l'asọ oku,","marked":"A ti wẹ l'asọ òkú"},{"start":15.863,"end":17.226,"text":"Lat' ori titi d'ẹsẹ,","marked":"Lát orí títí d'ẹsẹ̀"},{"start":17.676,"end":18.971,"text":"A si fi okuta se,","marked":"A sì fi òkúta ṣe"},{"start":19.421,"end":20.913,"text":"A si fi edidi di.","marked":"A sì fi èdìdì di."}],"end":20.913},{"key":"3","start":21.863,"lines":[{"start":21.863,"end":23.51,"text":"Oluwa, titi ayé,","marked":"Olúwa, títí ayé"},{"start":23.96,"end":25.2,"text":"L'a o ma pa eyi mọ,","marked":"L'á ò má pa èyí mọ́"},{"start":25.65,"end":27.048,"text":"A o t'ilẹkun pinpin,","marked":"A ò t'ìlẹ̀kùn pínpín"},{"start":27.498,"end":28.658,"text":"K'ariwo ma ba wọle,","marked":"K'ariwo má bá wọlé"},{"start":29.108,"end":30.473,"text":"A o fi suru duro,","marked":"A ó fi sùrù dúró"},{"start":30.923,"end":32.11,"text":"Tit' Iwọ o tun pada.","marked":"Tít Ìwọ ó tún padà."}],"end":32.11},{"key":"4","start":33.06,"lines":[{"start":33.06,"end":34.347,"text":"Gbogbo awọn t'o si sun,","marked":"Gbogbo àwọn t'ó sì sùn"},{"start":34.797,"end":36.022,"text":"Wọn o wa ba Ọ sinmi;","marked":"Wọn ó wà bá Ọ sinmi"},{"start":36.472,"end":37.452,"text":"Wọn o bọ lọwọ lala,","marked":"Wọn ó bọ́ lọ́wọ́ lálà"},{"start":37.902,"end":39.165,"text":"Wọn n reti ipe 'kẹhin,","marked":"Wọ́n ń retí ìpè 'kẹhin"},{"start":39.615,"end":41.211,"text":"T'a o di ẹda titun,","marked":"T'a ó di ẹ̀dà titun"},{"start":41.661,"end":43.773,"text":"T'ayọ wa ki y'o lopin.","marked":"T'ayọ̀ wa kí y'ó lópin."}],"end":43.773},{"key":"5","start":44.723,"lines":[{"start":44.723,"end":46.173,"text":"Jesu yọ wa nin' ẹsẹ,","marked":"Jésù yọ wá nín ẹsẹ̀"},{"start":46.623,"end":47.884,"text":"K'a ba le ba wọn wọle,","marked":"K'á bá lè bá wọn wọlé"},{"start":48.334,"end":49.56,"text":"Ewu ati 'sẹ y'o tan,","marked":"Ewu àti 'sẹ y'ó tán"},{"start":50.01,"end":51.336,"text":"A o f'ayọ goke lọ,","marked":"A ò f'ayọ̀ gòkè lọ"},{"start":51.786,"end":52.835,"text":"A o ri Ọlọrun wa,","marked":"A ó rí Ọlọ́run wa"},{"start":53.285,"end":54.72,"text":"A o si ma sin lailai.","marked":"A ó sì má sìn láéláé."}],"end":54.72}]}