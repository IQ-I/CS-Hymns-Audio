{"v":3,"coll":"y","num":833,"id":"hymn_833","title":"AJA ni gbo Ekun a ja","duration":39.746,"voices":{"male":{"file":"y-833-male-v3.m4a","bytes":271557,"sha256":"6ee21f008f4c8fde1f1de01ac9f53658716fc51494c470d954ba26c25c036cfe","duration":39.8},"female":{"file":"y-833-female-v3.m4a","bytes":282188,"sha256":"c8ff01d5aa06ab8b2843e898cc43a8271e6d8163877ea13546a07e1332363eae","duration":39.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.315,"text":"AJA ni gbo Ẹkun a ja,","marked":"Ajá ni gbọ́ Ẹkún a jà"},{"start":2.765,"end":4.007,"text":"Bẹ l'a sa s'ẹda wọn;","marked":"Bẹ́ l'á sá s'ẹ̀dà wọn"},{"start":4.457,"end":6.301,"text":"Ogidan, l'ola iju,","marked":"Ọ̀gídán, l'ọ̀la ijù"},{"start":6.751,"end":8.06,"text":"L'akọmọ l'ai l'abẹ.","marked":"L'àkọ́mọ l'àì l'abẹ́."}],"end":8.06},{"key":"2","start":9.01,"lines":[{"start":9.01,"end":10.429,"text":"Sugbọn eniyan l'a da yin,","marked":"Sùgbọ́n ènìyàn l'á dá yín"},{"start":10.879,"end":12.016,"text":"Ẹ hu wa bi ọmọ;","marked":"Ẹ hù wá bí ọmọ"},{"start":12.466,"end":14.007,"text":"K'ẹ mase ba ara yin ja,","marked":"K'ẹ́ máṣe bá ara yín jà"},{"start":14.457,"end":15.729,"text":"Ere ni k'ẹ ma se.","marked":"Èrè ni k'ẹ má ṣe."}],"end":15.729},{"key":"3","start":16.679,"lines":[{"start":16.679,"end":17.829,"text":"Bi ọmọ-rere Maria,","marked":"Bí ọmọ-rere Màríà"},{"start":18.279,"end":19.608,"text":"Ni k'iwa yin tutu;","marked":"Ní k'ìwà yín tútù"},{"start":20.058,"end":21.7,"text":"K'ẹ pọ n'ifẹ bi Oluwa,","marked":"K'ẹ́ pọ̀ n'ìfẹ́ bí Olúwa"},{"start":22.15,"end":23.413,"text":"Jesu Ọm'-Ọlọrun.","marked":"Jésù Ọm'-Ọlọrun."}],"end":23.413},{"key":"4","start":24.363,"lines":[{"start":24.363,"end":25.608,"text":"Ẹni jẹjẹ bi aguntan,","marked":"Ẹni jẹ́jẹ́ bí àgùntàn"},{"start":26.058,"end":27.28,"text":"Ti iwa Rẹ wu ni,","marked":"Tí ìwà Rẹ̀ wù ni"},{"start":27.73,"end":28.988,"text":"Eniyan ati Ọlọrun,","marked":"Ènìyàn àti Ọlọ́run"},{"start":29.438,"end":30.661,"text":"N'idagba Rẹ si wu.","marked":"N'ìdàgbà Rẹ sì wù."}],"end":30.661},{"key":"5","start":31.611,"lines":[{"start":31.611,"end":32.938,"text":"Oluwa gunwa bi Ọba,","marked":"Olúwa gúnwà bí Ọba"},{"start":33.388,"end":34.572,"text":"L'ori 'tẹ Rẹ lọrun;","marked":"L'orí 'tẹ Rẹ̀ lọ́rùn"},{"start":35.022,"end":36.438,"text":"O n wo aw'ọmọ t'o n'ifẹ,","marked":"Ó ń wo àw'ọmọ t'ó n'ìfẹ́"},{"start":36.888,"end":38.197,"text":"O si n sami si wọn.","marked":"Ó sì ń sàmì sí wọn."}],"end":38.197}]}