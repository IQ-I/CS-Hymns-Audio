{"v":3,"coll":"y","num":416,"id":"hymn_416","title":"OLUWA, a wa 'do Re","duration":33.657,"voices":{"male":{"file":"y-416-male-v3.m4a","bytes":232231,"sha256":"05768071f3f5ac19485c65775dfda3dde1116e59964f14f9cb352c107f5be3f7","duration":33.7},"female":{"file":"y-416-female-v3.m4a","bytes":239192,"sha256":"d36e409b5d9c4cd2866c8152528d58467a26aee1ee13656dfeea00c7ed7353ea","duration":33.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.023,"text":"OLUWA, a wa 'dọ Rẹ,","marked":"Olúwa, a wá 'dọ Rẹ̀"},{"start":2.473,"end":4.071,"text":"L'ẹsẹ Rẹ l'a kunlẹ si;","marked":"L'ẹsẹ̀ Rẹ̀ l'á kúnlẹ̀ sí"},{"start":4.521,"end":6.267,"text":"A! ma kẹgan ẹbẹ wa,","marked":"A! má kẹ́gàn ẹ̀bẹ̀ wá"},{"start":6.717,"end":7.851,"text":"A o wa Ọ lasan bi?","marked":"A ó wà Ọ́ lásán bí?"}],"end":7.851},{"key":"2","start":8.801,"lines":[{"start":8.801,"end":10.248,"text":"L'ọna ti O yan fun wa","marked":"L'ọ́nà tí Ó yàn fún wa"},{"start":10.698,"end":11.767,"text":"L'a n wa Ọ lọwọlọwọ:","marked":"L'á ń wá Ọ lọ́wọ́lọ́wọ́"},{"start":12.217,"end":13.784,"text":"Oluwa, a ki o lọ,","marked":"Olúwa, a kí ó lọ"},{"start":14.234,"end":15.698,"text":"Titi 'Wọ o bukun wa.","marked":"Títí 'Wọ ó bùkún wá."}],"end":15.698},{"key":"3","start":16.648,"lines":[{"start":16.648,"end":17.763,"text":"Ranse lat'oro Re wa","marked":"Ránṣẹ́ lát'ọ̀rọ̀ Rẹ̀ wá"},{"start":18.213,"end":19.566,"text":"Ti O fi ayo‐fun wa","marked":"Tí Ó fi ayo-fun wa"},{"start":20.016,"end":21.338,"text":"Je ki emi Re ko fun","marked":"Jẹ́ kí ẹ̀mí Rẹ kò fún"},{"start":21.788,"end":22.919,"text":"Okan wa ni igbala.","marked":"Ọkàn wa ní ìgbàlà."}],"end":22.919},{"key":"4","start":23.869,"lines":[{"start":23.869,"end":25.795,"text":"Jẹ k'a wa, k'a si ri Ọ","marked":"Jẹ́ k'á wá, k'á sì rí Ọ"},{"start":26.245,"end":27.231,"text":"Ni Ọlọrun Olore,","marked":"Ní Ọlọ́run Ọlọ́rẹ́"},{"start":27.681,"end":30.331,"text":"p W'alaisan, da' 'gbekun si,","marked":"p W'aláìsàn, dá gbèkùn sí"},{"start":30.781,"end":32.107,"text":"Ki gbogbo wa yọ si Ọ.","marked":"Kí gbogbo wa yọ sí Ọ."}],"end":32.107}]}