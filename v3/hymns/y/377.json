{"v":3,"coll":"y","num":377,"id":"hymn_377","title":"EMI orun jare wa","duration":58.773,"voices":{"male":{"file":"y-377-male-v3.m4a","bytes":412708,"sha256":"cab2708c39953c029d791540da069d114c2e3af5af1487d20ae364ec6b199875","duration":58.8},"female":{"file":"y-377-female-v3.m4a","bytes":419100,"sha256":"3f6fbb67c50ee9043c3393b5da53aac2d0c2c0790caaebadb495efab92ff9249","duration":58.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.451,"text":"ẸMI ọrun jare wa,","marked":"Ẹ̀mí ọ̀run jàre wá"},{"start":1.901,"end":3.207,"text":"Wa gunwa s'ọkan wa;","marked":"Wá gúnwà s'ọkàn wa"},{"start":3.657,"end":4.93,"text":"Ko se'le rẹ ninu wa,","marked":"Kò ṣe'lè rẹ̀ nínú wa"},{"start":5.38,"end":6.559,"text":"Awa ẹlẹsẹ mbẹ Ọ o.","marked":"Àwa ẹlẹ́sẹ̀ mbẹ́ Ọ ọ́."}],"end":6.559},{"key":"2","start":7.509,"lines":[{"start":7.509,"end":8.962,"text":"Gba t'a wa n'ile ayé,","marked":"Gba t'á wà n'ilẹ̀ ayé"},{"start":9.412,"end":10.685,"text":"A kun f'ọpọ asise;","marked":"A kún f'ọ̀pọ̀ àṣìṣe"},{"start":11.135,"end":12.604,"text":"T'o ń fa 'danwo wa ba wa,","marked":"T'ó ń fa dánwò wa bá wa"},{"start":13.054,"end":15.178,"text":"Oluwa ye, jọwọ gba wa o.","marked":"Olúwa yẹ, jọ̀wọ́ gbà wá ọ."}],"end":15.178},{"key":"3","start":16.128,"lines":[{"start":16.128,"end":17.687,"text":"Nigba ti idanwo ba de,","marked":"Nígbà tí ìdánwò bá dé"},{"start":18.137,"end":19.527,"text":"T'ara gbogbo le ko wa;","marked":"T'ara gbogbo lè kọ́ wá"},{"start":19.977,"end":21.845,"text":"Mura s'ẹsin, gbadura,","marked":"Múra s'ẹ̀sìn, gbàdúrà"},{"start":22.295,"end":24.089,"text":"Jesu yoo si wa gbe ọ leke.","marked":"Jésù yóò sì wá gbé ọ lékè."}],"end":24.089},{"key":"4","start":25.039,"lines":[{"start":25.039,"end":26.222,"text":"Nihin l'ore le tan o","marked":"Níhìn l'ọ̀rẹ́ lè tán ọ́"},{"start":26.672,"end":28.114,"text":"Pelu baba at'iya","marked":"Pẹ̀lú Baba àt'ìyá"},{"start":28.564,"end":30.188,"text":"Mura s'esin, p'Oluwa","marked":"Múra s'ẹṣin, p'Olúwa"},{"start":30.638,"end":32.5,"text":"'Gbayi ni iwo mo Jesu l'ore.","marked":"gbáyí ni ìwọ mọ Jésù l'ọ̀rẹ́."}],"end":32.5},{"key":"5","start":33.45,"lines":[{"start":33.45,"end":35.176,"text":"T'ọsan t'oru l'O ń gbọ","marked":"T'ọ̀sán t'òru l'Ó ń gbọ́"},{"start":35.626,"end":36.721,"text":"Gbogbo imikanlẹ rẹ;","marked":"Gbogbo ìmìkanlẹ̀ rẹ"},{"start":37.171,"end":38.299,"text":"Ki o to pe O gbọ ọ,","marked":"Kí ó tó pé Ó gbọ́ ọ"},{"start":38.749,"end":40.165,"text":"Bayi ni ileri Rẹ si ọ.","marked":"Báyì ni ìlérí Rẹ̀ sí ọ."}],"end":40.165},{"key":"6","start":41.115,"lines":[{"start":41.115,"end":42.462,"text":"Pe mi loru ati ọsan,","marked":"Pè mi lóru àti ọ̀sán"},{"start":42.912,"end":44.308,"text":"Pẹlu ẹmi igbagbọ;","marked":"Pẹ̀lú ẹ̀mí ìgbàgbọ́"},{"start":44.758,"end":46.143,"text":"Gb'ọkan s'oke s'Oluwa,","marked":"Gb'ọkàn s'òkè s'Olúwa"},{"start":46.593,"end":48.375,"text":"Jehovah Jire yoo silẹkun.","marked":"Jehovah Jire yóò sílẹ̀kùn."}],"end":48.375},{"key":"7","start":49.325,"lines":[{"start":49.325,"end":51.319,"text":"F'ifẹ han k'o si ma se,","marked":"F'ìfẹ́ hàn k'ó sì má ṣe"},{"start":51.769,"end":53.133,"text":"Isẹ idariji niso;","marked":"Isẹ́ ìdáríjì nìṣó"},{"start":53.583,"end":54.861,"text":"Mu 'gbagbọ pẹlu 'sẹ rẹ,","marked":"Mú 'gbagbọ pẹ̀lú 'sẹ rẹ"},{"start":55.311,"end":57.224,"text":"'Gbayi ni Jesu to gba o la.","marked":"gbáyí ni Jésù tó gbà ọ́ là."}],"end":57.224}]}