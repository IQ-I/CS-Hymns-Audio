{"v":3,"coll":"y","num":759,"id":"hymn_759","title":"LALA alagbase, tan","duration":53.918,"voices":{"male":{"file":"y-759-male-v3.m4a","bytes":377635,"sha256":"8d87587cb55148692984dbea00e0a773ff9bc92eb02a704427940bffe49822f2","duration":54.0},"female":{"file":"y-759-female-v3.m4a","bytes":384600,"sha256":"05187b7a26a677034c449d3a4a8d634338cca90ae74f578c0a71992da3066fb2","duration":54.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.229,"text":"LALA alagbase, tan;","marked":"Lálá alágbàṣe, tán"},{"start":2.679,"end":3.794,"text":"Ojo ogun ti pari;","marked":"Ọjọ́ ogun ti parí"},{"start":4.244,"end":5.482,"text":"L'ebute jijin rere,","marked":"L'èbúté jíjìn rere"},{"start":5.932,"end":7.481,"text":"Ni oko re ti gun si.","marked":"Ní ọkọ rẹ̀ ti gùn sí."}],"end":7.481},{"key":"CHORUS","start":8.431,"lines":[{"start":8.431,"end":10.549,"text":"Baba, labẹ itoju Re, L'awa","marked":"Baba, lábẹ́ ìtọ́jú Rẹ, L'áwa"},{"start":10.999,"end":12.088,"text":"f'iranse Re yi si.","marked":"f'ìránṣẹ́ Rẹ yí sí."}],"end":12.088},{"key":"2","start":13.038,"lines":[{"start":13.038,"end":14.62,"text":"Nibẹ l'a rẹ wọn l'ẹkun;","marked":"Níbẹ̀ l'a rẹ̀ wọ́n l'ẹkún"},{"start":15.07,"end":16.596,"text":"Nibẹ, wọn m'ohun gbogbo,","marked":"Níbẹ̀, wọ́n m'ohun gbogbo"},{"start":17.046,"end":18.598,"text":"Nibẹ l'Onidaj' otọ,","marked":"Níbẹ̀ l'Onidaj òtọ̀"},{"start":19.048,"end":20.245,"text":"N dan isẹ ayé wọn wo.","marked":"Ń dán isẹ́ ayé wọn wò."}],"end":20.245},{"key":"3","start":21.195,"lines":[{"start":21.195,"end":22.388,"text":"Nibẹ l'olus' aguntan,","marked":"Níbẹ̀ l'olùṣ àgùntàn"},{"start":22.838,"end":24.145,"text":"N ko awọn aguntan lọ;","marked":"Ń kó àwọn àgùntàn lọ"},{"start":24.595,"end":25.896,"text":"Nibẹ l'o n dabo bo wọn,","marked":"Níbẹ̀ l'ó ń dàbò bò wọ́n"},{"start":26.346,"end":28.437,"text":"Koriko ko le de'bẹ.","marked":"Koríko kò lè dé'bẹ̀."}],"end":28.437},{"key":"4","start":29.387,"lines":[{"start":29.387,"end":30.549,"text":"Nibẹ l'awọn ẹlẹsẹ,","marked":"Níbẹ̀ l'àwọn ẹlẹ́sẹ̀"},{"start":30.999,"end":32.406,"text":"Ti n tẹju m'agbelebu,","marked":"Tí ń tẹ́jú m'àgbélébùú"},{"start":32.856,"end":34.453,"text":"Y'o mọ ifẹ Kristi tan,","marked":"Y'ó mọ ìfẹ́ Kristi tán"},{"start":34.903,"end":36.419,"text":"L'ẹsẹ Rẹ ni Paradise.","marked":"L'ẹsẹ̀ Rẹ̀ ni Paradise."}],"end":36.419},{"key":"5","start":37.369,"lines":[{"start":37.369,"end":38.713,"text":"Nibẹ l'agbara Esu,","marked":"Níbẹ̀ l'agbára Èṣù"},{"start":39.163,"end":40.451,"text":"Ko le b'ayọ wọn jẹ mọ;","marked":"Kò lè b'ayọ̀ wọn jẹ́ mọ́"},{"start":40.901,"end":42.71,"text":"Kristi Jesu a n sọ wọn;","marked":"Kristi Jésù à ń sọ wọ́n"},{"start":43.16,"end":44.818,"text":"Oun t'o ku fun dande wọn.","marked":"Òun t'ó kú fún dàǹdè wọn."}],"end":44.818},{"key":"6","start":45.768,"lines":[{"start":45.768,"end":46.826,"text":"Erupẹ fun erupẹ,","marked":"Erùpẹ̀ fún erùpẹ̀"},{"start":47.276,"end":48.643,"text":"L'ede wa nisinsin yi;","marked":"L'èdè wa nísinsin yí"},{"start":49.093,"end":50.519,"text":"A tẹ silẹ lati sun,","marked":"A tẹ̀ sílẹ̀ láti sùn"},{"start":50.969,"end":52.369,"text":"Titi d'ọjọ ajinde.","marked":"Títí d'ọjọ́ àjíǹde."}],"end":52.369}]}