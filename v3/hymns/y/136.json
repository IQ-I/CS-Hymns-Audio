{"v":3,"coll":"y","num":136,"id":"hymn_136","title":"F'IBUKUN f'Oluwa!","duration":39.826,"voices":{"male":{"file":"y-136-male-v3.m4a","bytes":273589,"sha256":"efb326eac99913ffd5ade7790a8296ecb80889ffeb1fc7ec46c61cfd146c0cc6","duration":39.9},"female":{"file":"y-136-female-v3.m4a","bytes":284128,"sha256":"ac519992c50cde7f0ad3cbd71d9fe007f5f646655959997bbfe34cad3fcf8940","duration":39.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.661,"text":"F'IBUKUN f'Oluwa!","marked":"F'Ìbùkún f'Olúwa!"},{"start":2.111,"end":3.449,"text":"K'ọkan at'inu mi,","marked":"K'ọkàn àt'inú mi"},{"start":3.899,"end":5.349,"text":"Pẹl' ahọn mi yin ookọ Rẹ,","marked":"Pẹl' ahọ́n mi yin oókọ Rẹ"},{"start":5.799,"end":7.079,"text":"Fun gbogbo oore Rẹ.","marked":"Fún gbogbo oore Rẹ."}],"end":7.079},{"key":"2","start":8.029,"lines":[{"start":8.029,"end":9.282,"text":"F'ibukun f'Oluwa!","marked":"F'ìbùkún f'Olúwa!"},{"start":9.732,"end":10.805,"text":"Ọkan mi ma gbagbe,","marked":"Ọkàn mi má gbàgbé"},{"start":11.255,"end":13.729,"text":"Lati s'ọpẹ, lati f'iyin,","marked":"Láti s'ọ̀pẹ, láti f'ìyìn"},{"start":14.179,"end":15.331,"text":"Fun ọpọ anu Rẹ.","marked":"Fún ọ̀pọ̀ àánú Rẹ."}],"end":15.331},{"key":"3","start":16.281,"lines":[{"start":16.281,"end":17.438,"text":"O f'ese re ji O","marked":"Ó f'ẹsẹ̀ rẹ̀ jì Ọ"},{"start":17.888,"end":18.98,"text":"O mu 'rora re lo","marked":"Ó mú rọra rẹ̀ lọ"},{"start":19.43,"end":20.684,"text":"O wo gbogbo arun re san,","marked":"Ó wo gbogbo àrùn rẹ̀ sàn"},{"start":21.134,"end":22.545,"text":"O so o d'atunbi.","marked":"Ó sọ ọ́ d'àtúnbí."}],"end":22.545},{"key":"4","start":23.495,"lines":[{"start":23.495,"end":24.667,"text":"O f'ounjẹ f'alaini,","marked":"Ó f'oúnjẹ f'aláìní"},{"start":25.117,"end":26.235,"text":"Isinmi f'ojiya;","marked":"Ìsinmi f'òjìyà"},{"start":26.685,"end":28.382,"text":"Y'o se 'dajọ agberega,","marked":"Y'ó ṣe 'dajọ àgbèrègà"},{"start":28.832,"end":30.019,"text":"Y'o gbeja alaisẹ.","marked":"Y'ó gbèjà aláìsẹ̀."}],"end":30.019},{"key":"5","start":30.969,"lines":[{"start":30.969,"end":32.065,"text":"O f'isẹ 'yanu rẹ,","marked":"Ó f'isẹ́ yanu rẹ̀"},{"start":32.515,"end":34.478,"text":"Han, lat'ọwọ Mose;","marked":"Hàn, lát'ọwọ́ Mósè"},{"start":34.928,"end":36.616,"text":"Sugbon ootọ at'ore Rẹ,","marked":"Ṣùgbọ́n òótọ́ àt'ọrẹ Rẹ"},{"start":37.066,"end":38.277,"text":"L'o fi ran Ọmọ Rẹ.","marked":"L'ó fi rán Ọmọ Rẹ̀."}],"end":38.277}]}