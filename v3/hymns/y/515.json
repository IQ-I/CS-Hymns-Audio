{"v":3,"coll":"y","num":515,"id":"hymn_515","title":"B'ORUKO Jesu ti dun to","duration":51.481,"voices":{"male":{"file":"y-515-male-v3.m4a","bytes":363125,"sha256":"0201e8fb65fb9f6019e51e3cfc7e4b95b7b79e8836af9303a70291235b3f3661","duration":51.5},"female":{"file":"y-515-female-v3.m4a","bytes":377587,"sha256":"8eeda7d006e2d34f1726508b894ad72405c20f8f52e77167a016b9a30e787cbf","duration":51.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.116,"text":"B'ORUKỌ Jesu ti dun to,","marked":"B'Orúkọ Jésù ti dùn tó"},{"start":2.566,"end":3.836,"text":"Leti onigbagbọ!","marked":"Létí onígbàgbọ́!"},{"start":4.286,"end":5.904,"text":"O tan 'banujẹ oun ọgbẹ,","marked":"Ó tan 'banujẹ òun ọgbẹ́"},{"start":6.354,"end":7.66,"text":"O si le ẹru lọ.","marked":"Ó sì lé ẹrú lọ."}],"end":7.66},{"key":"2","start":8.61,"lines":[{"start":8.61,"end":10.059,"text":"O wo ọkan to gbọgbẹ san,","marked":"Ó wo ọkàn tó gbọgbẹ́ sàn"},{"start":10.509,"end":11.722,"text":"O mu aya balẹ;","marked":"Ó mú aya balẹ̀"},{"start":12.172,"end":13.704,"text":"Manna ni fun ọkan ebi,","marked":"Manna ni fún ọkàn ebi"},{"start":14.154,"end":15.496,"text":"Isinmi f'alarẹ.","marked":"Ìsinmi f'alárẹ."}],"end":15.496},{"key":"3","start":16.446,"lines":[{"start":16.446,"end":18.513,"text":"Apata ti mo kole le","marked":"Àpáta tí mo kọ́lé lé"},{"start":18.963,"end":20.039,"text":"Ibi isadi mi","marked":"Ibi ìsádi mi"},{"start":20.489,"end":21.79,"text":"Ile isura mi t'o kun","marked":"Ilé ìṣúra mi t'ó kún"},{"start":22.24,"end":23.45,"text":"F'opo ore-ofe.","marked":"F'ọ̀pọ̀ oore-ọ̀fẹ́."}],"end":23.45},{"key":"4","start":24.4,"lines":[{"start":24.4,"end":26.981,"text":"Jesu, Oko mi, Ore mi","marked":"Jésù, Ọkọ mi, Ọ̀rẹ́ mi"},{"start":27.431,"end":28.887,"text":"Woli mi, Oba mi","marked":"Wòlí mi, Ọba mi"},{"start":29.337,"end":32.028,"text":"Alufa mi, Ona, Iye","marked":"Àlùfá mi, Ọ̀nà, Ìyè"},{"start":32.478,"end":33.435,"text":"Gba orin iyin mi.","marked":"Gba orin ìyìn mi."}],"end":33.435},{"key":"5","start":34.385,"lines":[{"start":34.385,"end":35.736,"text":"Ailera l'agbara 'nu mi,","marked":"Àìlera l'agbára nù mi"},{"start":36.186,"end":37.371,"text":"Tutu si l'ero mi;","marked":"Tútù sì l'èrò mi"},{"start":37.821,"end":39.216,"text":"'Gba mo ba ri Ọ b'O ti ri,","marked":"gbà mo bá rí Ọ b'Ó ti rí"},{"start":39.666,"end":41.257,"text":"N ó yin Ọ b'o ti yẹ.","marked":"N ó yìn Ọ́ b'ó ti yẹ."}],"end":41.257},{"key":"6","start":42.207,"lines":[{"start":42.207,"end":43.726,"text":"Tit' igbana ni ohun mi,","marked":"Tít ìgbàná ni ohun mi"},{"start":44.176,"end":45.47,"text":"Y'o ma rohin 'fẹ Rẹ;","marked":"Y'ó má ròhìn 'fẹ Rẹ"},{"start":45.92,"end":48.1,"text":"di Nigba iku, k'Orukọ Rẹ,","marked":"di Nígbà ikú, k'Orúkọ Rẹ"},{"start":48.55,"end":49.932,"text":"F'itura f'ọkan mi.","marked":"F'ìtura f'ọkàn mi."}],"end":49.932}]}