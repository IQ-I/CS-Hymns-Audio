{"v":3,"coll":"y","num":794,"id":"hymn_794","title":"YIKA or'ite Olorun","duration":61.492,"voices":{"male":{"file":"y-794-male-v3.m4a","bytes":431526,"sha256":"bc8770117383494a7366abea07d17b8a2c161370f8834481626d6ba3839c0e38","duration":61.5},"female":{"file":"y-794-female-v3.m4a","bytes":446760,"sha256":"23bd90130f1b569f4d82a48ab4649184cc31f41803b671c8498605a678cb6371","duration":61.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.09,"text":"YIKA or'itẹ Ọlọrun,","marked":"Yíká or'ìtẹ́ Ọlọ́run"},{"start":2.54,"end":3.62,"text":"Ẹgbẹrun ewe wa;","marked":"Ẹgbẹ̀rún èwe wa"},{"start":4.07,"end":5.619,"text":"Ewe t'a dari ẹsẹ ji,","marked":"Ewé t'á dárí ẹsẹ̀ jì"},{"start":6.069,"end":7.016,"text":"Awọn ẹgbẹ mimọ;","marked":"Àwọn ẹgbẹ́ mímọ́"},{"start":7.466,"end":9.332,"text":"Ń kọrin Ogo, ogo, ogo.","marked":"Ń kọrin Ògo, ògo, ògo."}],"end":9.332},{"key":"2","start":10.282,"lines":[{"start":10.282,"end":11.937,"text":"Wo! olukuluku wọn wo,","marked":"Wò! olúkúlùkù wọn wò"},{"start":12.387,"end":13.382,"text":"Asọ ala mimọ;","marked":"Asọ̀ àlá mímọ́"},{"start":13.832,"end":15.355,"text":"Ninu imọlẹ ailopin,","marked":"Nínú ìmọ́lẹ̀ àìlópin"},{"start":15.805,"end":17.124,"text":"At'ayọ ti ki sa,","marked":"Àt'ayọ̀ tí kì sá"},{"start":17.574,"end":19.431,"text":"Ń kọrin Ogo, ogo, ogo.","marked":"Ń kọrin Ògo, ògo, ògo."}],"end":19.431},{"key":"3","start":20.381,"lines":[{"start":20.381,"end":21.916,"text":"Ki l'o mu wọn de ayé na,","marked":"Kí l'ó mú wọn dé ayé ná"},{"start":22.366,"end":23.427,"text":"Orun t'o se mimọ,","marked":"Ọ̀run t'ó ṣe mímọ́"},{"start":23.877,"end":25.394,"text":"Nib' alafia at'ayọ,","marked":"Níb àlàáfíà àt'ayọ̀"},{"start":25.844,"end":27.07,"text":"Bi wọn ti se de 'bẹ?","marked":"Bí wọ́n ti ṣe dé 'bẹ?"},{"start":27.52,"end":29.651,"text":"Ń kọrin Ogo, ogo, ogo.","marked":"Ń kọrin Ògo, ògo, ògo."}],"end":29.651},{"key":"4","start":30.601,"lines":[{"start":30.601,"end":32.141,"text":"Nitori Jesu ta 'jẹ Rẹ,","marked":"Nítorí Jésù ta 'jẹ Rẹ"},{"start":32.591,"end":34.02,"text":"Lati k'ẹsẹ wọn lọ;","marked":"Láti k'ẹsẹ̀ wọn lọ"},{"start":34.47,"end":35.703,"text":"A ri wọn ninu ẹjẹ na,","marked":"A rí wọn nínú ẹ̀jẹ̀ ná"},{"start":36.153,"end":37.361,"text":"Wọn di mimọ laulau;","marked":"Wọ́n di mímọ́ láúláù"},{"start":37.811,"end":39.743,"text":"Ń kọrin Ogo, ogo, ogo.","marked":"Ń kọrin Ògo, ògo, ògo."}],"end":39.743},{"key":"5","start":40.693,"lines":[{"start":40.693,"end":42.609,"text":"L'ayé, wọn wa Olugbala,","marked":"L'ayé, wọ́n wá Olùgbàlà"},{"start":43.059,"end":44.291,"text":"Wọn fẹ orukọ Rẹ;","marked":"Wọ́n fẹ́ orúkọ Rẹ"},{"start":44.741,"end":45.995,"text":"Nisinsin yi wọn r'oju Rẹ,","marked":"Nísinsin yí wọn r'ojú Rẹ"},{"start":46.445,"end":47.553,"text":"Wọn wa niwaju Rẹ;","marked":"Wọ́n wà níwájú Rẹ̀"},{"start":48.003,"end":49.768,"text":"Ń kọrin Ogo, ogo, ogo.","marked":"Ń kọrin Ògo, ògo, ògo."}],"end":49.768},{"key":"6","start":50.718,"lines":[{"start":50.718,"end":52.185,"text":"Orisun na ha n san loni?","marked":"Orísun na ha ń sàn lónì?"},{"start":52.635,"end":54.005,"text":"Jesu, mu wa de 'bẹ;","marked":"Jésù, mú wa dé 'bẹ"},{"start":54.455,"end":55.935,"text":"K'a le ri awọn mimọ na,","marked":"K'á lè rí àwọn mímọ́ ná"},{"start":56.385,"end":57.509,"text":"K'a si ba wọn yin Ọ,","marked":"K'á sì bá wọn yín Ọ"},{"start":57.959,"end":59.943,"text":"Ń kọrin Ogo, ogo, ogo.","marked":"Ń kọrin Ògo, ògo, ògo."}],"end":59.943}]}