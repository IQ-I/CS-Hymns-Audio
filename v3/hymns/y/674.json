{"v":3,"coll":"y","num":674,"id":"hymn_674","title":"ILE-EKO ojo 'sinmi","duration":46.356,"voices":{"male":{"file":"y-674-male-v3.m4a","bytes":310045,"sha256":"bfbd67e6d2a35cf41d5283a011153d2e2e152b6ac0532d38f53f1cdc4a6668bc","duration":46.4},"female":{"file":"y-674-female-v3.m4a","bytes":325076,"sha256":"8c6159282ea682e4b8f6e6e7c5f69e191de6bf797176d0fa877718817be79ecc","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.738,"text":"ILE-ẸKỌ ọjọ 'sinmi,","marked":"Ile-Ẹkọ ọjọ́ sinmi"},{"start":2.188,"end":3.793,"text":"A, mo ti fẹ ọ to!","marked":"A, mo ti fẹ́ ọ tó!"},{"start":4.243,"end":5.527,"text":"Inu mi dun mọ daraya,","marked":"Inú mi dùn mọ́ dárayá"},{"start":5.977,"end":7.114,"text":"Lati yọ ayọ rẹ.","marked":"Láti yọ ayọ̀ rẹ̀."}],"end":7.114},{"key":"2","start":8.064,"lines":[{"start":8.064,"end":9.568,"text":"Ile-ẹkọ ọjọ 'sinmi,","marked":"Ile-ẹkọ ọjọ́ sinmi"},{"start":10.018,"end":10.997,"text":"Ore rẹ papọju;","marked":"Ọrẹ rẹ̀ pàpọ̀jù"},{"start":11.447,"end":12.893,"text":"T'agba t'ewe wa n kọrin rẹ,","marked":"T'àgbà t'èwe wà ń kọrin rẹ̀"},{"start":13.343,"end":14.388,"text":"A n se afẹri rẹ.","marked":"A ń ṣe àfẹ́rí rẹ̀."}],"end":14.388},{"key":"3","start":15.338,"lines":[{"start":15.338,"end":16.878,"text":"Ile-ẹkọ ọjọ 'sinmi,","marked":"Ile-ẹkọ ọjọ́ sinmi"},{"start":17.328,"end":18.501,"text":"Jesu l'o ti kọ ọ;","marked":"Jésù l'ó ti kọ̀ ọ́"},{"start":18.951,"end":20.28,"text":"Ẹmi Mimọ Olukọni,","marked":"Ẹ̀mí Mímọ́ Olùkọ́ni"},{"start":20.73,"end":22.192,"text":"L'o si n se 'tọju rẹ.","marked":"L'ó sì ń ṣe 'tọju rẹ̀."}],"end":22.192},{"key":"4","start":23.142,"lines":[{"start":23.142,"end":24.604,"text":"Ile-ẹkọ ọjọ 'sinmi,","marked":"Ile-ẹkọ ọjọ́ sinmi"},{"start":25.054,"end":26.09,"text":"Awa ri ẹri gba,","marked":"Àwa rí ẹ̀rí gbà"},{"start":26.54,"end":27.599,"text":"P'Ọlọrun Olodumare,","marked":"P'Ọlọ́run Olódùmarè"},{"start":28.049,"end":29.329,"text":"F'ibukun sori rọ.","marked":"F'ìbùkún sórí rọ."}],"end":29.329},{"key":"5","start":30.279,"lines":[{"start":30.279,"end":31.671,"text":"Ile-ẹkọ ojọ 'sinmi,","marked":"Ile-ẹkọ ojọ́ sinmi"},{"start":32.121,"end":33.522,"text":"B'orun n ran l'aranju;","marked":"B'ọ̀run ń ràn l'aranjú"},{"start":33.972,"end":35.329,"text":"B'ojo su dudu lọrun,","marked":"B'ọjọ́ ṣú dúdú lọ́rùn"},{"start":35.779,"end":36.965,"text":"Ninu rẹ l'emi o wa.","marked":"Nínú rẹ̀ l'èmi ó wà."}],"end":36.965},{"key":"6","start":37.915,"lines":[{"start":37.915,"end":39.369,"text":"Ile-ẹkọ ọjọ 'sinmi,","marked":"Ile-ẹkọ ọjọ́ sinmi"},{"start":39.819,"end":40.971,"text":"Mo 'yọ lari ri Ọ,","marked":"Mo 'yọ lárí rí Ọ"},{"start":41.421,"end":43.005,"text":"'Wọ y'o ha kọja lori mi,","marked":"'Wọ y'ó ha kọjá lórí mi"},{"start":43.455,"end":44.807,"text":"Loni, l'a ri 'bukun?","marked":"Lónì, l'á rí bùkún?"}],"end":44.807}]}