{"v":3,"coll":"y","num":32,"id":"hymn_32","title":"EYI l'ojo t'oluwa da","duration":41.768,"voices":{"male":{"file":"y-32-male-v3.m4a","bytes":285631,"sha256":"93e6b0865406a1220dbcf3a64527c76ca8d2c1ec808f88ba7db26b40efa1f6fd","duration":41.8},"female":{"file":"y-32-female-v3.m4a","bytes":297790,"sha256":"e502de94ae6ec3a0f219166fbde2bf24522955b4cbcc5c315d88ca8feea283d1","duration":41.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.651,"text":"EYI l'ọjọ t'Oluwa da,","marked":"Èyí l'ọjọ́ t'Olúwa dá"},{"start":2.101,"end":3.365,"text":"O pe 'gba na n tire;","marked":"Ó pé gba ná ń tirẹ̀"},{"start":3.815,"end":6.171,"text":"K'ọrun k'o yọ, k'ayé ko yọ,","marked":"K'ọ̀run k'ò yọ, k'ayé kò yọ"},{"start":6.621,"end":7.796,"text":"K'iyin yi'tẹ naa ka.","marked":"K'ìyìn yí'tẹ́ náà ká."}],"end":7.796},{"key":"2","start":8.746,"lines":[{"start":8.746,"end":10.945,"text":"Loni, o jinde 'nu oku,","marked":"Lónì, ó jíǹde nù òkú"},{"start":11.395,"end":12.79,"text":"Ijọba Satan tu:","marked":"Ìjọba Satan tú"},{"start":13.24,"end":14.602,"text":"'Wọn mimọ tan 'sẹgun Rẹ ka,","marked":"'Wọn mímọ́ tan 'sẹgun Rẹ̀ ká"},{"start":15.052,"end":16.259,"text":"Wọn n sọrọ 'yanu Rẹ.","marked":"Wọ́n ń sọ̀rọ̀ yanu Rẹ̀."}],"end":16.259},{"key":"3","start":17.209,"lines":[{"start":17.209,"end":19.098,"text":"Hosanna si Ọba t'a yan,","marked":"Hosanna sí Ọba t'á yàn"},{"start":19.548,"end":20.805,"text":"S'Ọmọ mimọ Dafid:","marked":"S'Ọmọ mímọ́ Dafid"},{"start":21.255,"end":22.683,"text":"Oluwa, jọ sọkalẹ wa,","marked":"Olúwa, jọ sọ̀kalẹ̀ wá"},{"start":23.133,"end":24.387,"text":"T'Iwọ t'igbala Rẹ.","marked":"T'Ìwọ t'ìgbàlà Rẹ."}],"end":24.387},{"key":"4","start":25.337,"lines":[{"start":25.337,"end":26.873,"text":"Abukun l'Oluwa t'o wa","marked":"Àbùkún l'Olúwa t'ó wà"},{"start":27.323,"end":28.663,"text":"N'isẹ oore-ọfẹ,","marked":"N'ìsẹ oore-ọfẹ"},{"start":29.113,"end":30.475,"text":"T'o wa l'orukọ Baba Rẹ,","marked":"T'ó wà l'orúkọ Baba Rẹ"},{"start":30.925,"end":32.142,"text":"Lati gbà'ran wa là.","marked":"Láti gbà'ran wa là."}],"end":32.142},{"key":"5","start":33.092,"lines":[{"start":33.092,"end":34.961,"text":"ff Hosanna ni ohun gooro,","marked":"ff Hosanna ní ohun gooro"},{"start":35.411,"end":36.52,"text":"L'orin Ijọ t'ayé,","marked":"L'orin Ìjọ t'ayé"},{"start":36.97,"end":38.283,"text":"Orin t'oke ọrun l'ọhun","marked":"Orin t'òkè ọ̀run l'ọ́hun"},{"start":38.733,"end":40.219,"text":"Yoo dun ju bẹ lọ.","marked":"Yóò dùn ju bẹ lọ."}],"end":40.219}]}