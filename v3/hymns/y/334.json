{"v":3,"coll":"y","num":334,"id":"hymn_334","title":"ALLELUYAH! O ti jinde","duration":42.463,"voices":{"male":{"file":"y-334-male-v3.m4a","bytes":292855,"sha256":"ff0bd35855eb87cf7b702efbd07b747c53f92e1388011281182a5aa6764be5fa","duration":42.5},"female":{"file":"y-334-female-v3.m4a","bytes":304936,"sha256":"89d849880c23c0463b9dc98c3c383512ac188406b532278f9f5f00e50c4ff87f","duration":42.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.356,"text":"ALLELUYAH! O ti jinde","marked":"Alleluyah! Ó ti jíǹde"},{"start":2.806,"end":4.305,"text":"Jesu goke lo s'orun","marked":"Jésù gòkè lọ s'ọ̀run"},{"start":4.755,"end":6.209,"text":"O si fo itegun ẹsẹ,","marked":"Ó sì fọ́ ìtẹ̀gùn ẹsẹ̀"},{"start":6.659,"end":8.519,"text":"Angeli ho, eniyan dahun.","marked":"Áńgẹ́lì hó, ènìyàn dáhùn."}],"end":8.519},{"key":"CHORUS","start":9.469,"lines":[{"start":9.469,"end":11.385,"text":"O ti jinde, O ti jinde","marked":"Ó ti jíǹde, Ó ti jíǹde"},{"start":11.835,"end":13.749,"text":"O Wa laye, ko ku mo.","marked":"Ó Wà láyé, kò kú mọ́."}],"end":13.749},{"key":"2","start":14.699,"lines":[{"start":14.699,"end":16.69,"text":"Alleluyah! O ti jinde","marked":"Alleluyah! Ó ti jíǹde"},{"start":17.14,"end":18.014,"text":"Ẹni ti o ga","marked":"Ẹni tí ó ga"},{"start":18.464,"end":19.845,"text":"julo Jeri si Emi naa","marked":"jùlọ Jeri sí Èmi náà"},{"start":20.295,"end":21.37,"text":"wi pé, Oun ni","marked":"wí pé, Òun ni"},{"start":21.82,"end":22.716,"text":"alagbawi wa,","marked":"alágbàwí wa"}],"end":22.716},{"key":"CHORUS-2","start":23.666,"lines":[{"start":23.666,"end":25.592,"text":"O ti jinde, o ti jinde,","marked":"Ó ti jíǹde, ó ti jíǹde"},{"start":26.042,"end":27.633,"text":"Fun awa t'a da lare.","marked":"Fún àwa t'a dá láre."}],"end":27.633},{"key":"3","start":28.583,"lines":[{"start":28.583,"end":30.664,"text":"Alleluyah! O ti jinde","marked":"Alleluyah! Ó ti jíǹde"},{"start":31.114,"end":32.493,"text":"Iku ko tun n'ipa mo","marked":"Ikú kò tún n'ipa mọ́"},{"start":32.943,"end":34.656,"text":"Kristi papa ni Ajinde","marked":"Kristi pápá ní Àjíǹde"},{"start":35.106,"end":36.563,"text":"Yoo si m'awon Tire wa.","marked":"Yóò sì m'àwọn Tire wá."}],"end":36.563},{"key":"CHORUS-3","start":37.513,"lines":[{"start":37.513,"end":39.423,"text":"O ti jinde, o ti jinde,","marked":"Ó ti jíǹde, ó ti jíǹde"},{"start":39.873,"end":40.914,"text":"Oluwa Ọba Iye.","marked":"Olúwa Ọba Ìyè."}],"end":40.914}]}