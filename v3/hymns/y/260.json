{"v":3,"coll":"y","num":260,"id":"hymn_260","title":"Elese, e yi pada","duration":65.701,"voices":{"male":{"file":"y-260-male-v3.m4a","bytes":469418,"sha256":"eb227f9e8227b3a98e19af84b621c1e506c6f08cfe07f47b720311280d4618da","duration":65.8},"female":{"file":"y-260-female-v3.m4a","bytes":500288,"sha256":"7fef71899daa1ba8582821d252d03ccb125a85495fc7689a984b403ab65dadd4","duration":65.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.193,"text":"Ẹlẹsẹ, ẹ yi pada,","marked":"Ẹlẹ́sẹ̀, ẹ yí padà"},{"start":2.643,"end":4.166,"text":"Eese ti ẹ o fi ku?","marked":"Èéṣe tí ẹ ó fi kú?"},{"start":4.616,"end":6.033,"text":"Ẹlẹda yin lo n bere?","marked":"Ẹlẹda yín ló ń bẹ̀rẹ̀?"},{"start":6.483,"end":8.371,"text":"T'o fẹ ki ẹ ba Oun gbe,","marked":"T'ó fẹ́ kí ẹ bá Òun gbé"},{"start":8.821,"end":10.199,"text":"Ọran nla ni O mbi yin,","marked":"Ọ̀ràn ńlá ni Ó mbí yín"},{"start":10.649,"end":11.881,"text":"Isẹ ọwọ Rẹ ni yin,","marked":"Isẹ́ ọwọ́ Rẹ ni yín"},{"start":12.331,"end":13.918,"text":"A! ẹyin alailọpẹ,","marked":"A! ẹ̀yin aláìlọ́pẹ́"},{"start":14.368,"end":15.888,"text":"Eese t'ẹ o ko 'fẹ Rẹ.","marked":"Èéṣe t'ẹ́ ó kò 'fẹ Rẹ̀."}],"end":15.888},{"key":"2","start":16.838,"lines":[{"start":16.838,"end":18.515,"text":"Ẹlẹsẹ, ẹ yi pada,","marked":"Ẹlẹ́sẹ̀, ẹ yí padà"},{"start":18.965,"end":20.559,"text":"Eese ti ẹ fi ku?","marked":"Èéṣe tí ẹ fi kú?"},{"start":21.009,"end":22.148,"text":"Olugbala ni n bere,","marked":"Olùgbàlà ní ń bẹ̀rẹ̀"},{"start":22.598,"end":24.046,"text":"Ẹni t'o gb'ẹmi yin la;","marked":"Ẹni t'ó gb'ẹ̀mí yín là"},{"start":24.496,"end":25.964,"text":"Iku Rẹ y'o j'asan bi?","marked":"Ikú Rẹ̀ y'ó j'asán bí?"},{"start":26.414,"end":27.773,"text":"Ẹ o tun kan mọ 'gi bi?","marked":"Ẹ ó tún kan mọ́ gi bí?"},{"start":28.223,"end":30.08,"text":"Ẹni 'rapada, eese","marked":"Ẹni ràpadà, èéṣe"},{"start":30.53,"end":31.709,"text":"Ti ẹ o gan ore Rẹ?","marked":"Tí ẹ ó gan ọ̀rẹ́ Rẹ̀?"}],"end":31.709},{"key":"3","start":32.659,"lines":[{"start":32.659,"end":34.554,"text":"Ẹlẹsẹ, ẹ yi pada,","marked":"Ẹlẹ́sẹ̀, ẹ yí padà"},{"start":35.004,"end":36.682,"text":"Eese ti ẹ o fi ku?","marked":"Èéṣe tí ẹ ó fi kú?"},{"start":37.132,"end":38.576,"text":"Ẹmi Mimọ ni n bere,","marked":"Ẹ̀mí Mímọ́ ní ń bẹ̀rẹ̀"},{"start":39.026,"end":40.544,"text":"Ti n f'ọjọ gbogbo rọ yin,","marked":"Tí ń f'ọjọ́ gbogbo rọ̀ yín"},{"start":40.994,"end":42.256,"text":"Ẹ ki o ha gb'ọrọ Rẹ?","marked":"Ẹ kí ó ha gb'ọ̀rọ̀ Rẹ?"},{"start":42.706,"end":43.914,"text":"Ẹ o ko iye silẹ?","marked":"Ẹ ó kọ iye sílẹ̀?"},{"start":44.364,"end":46.208,"text":"A ti n wa yin pẹ, eese,","marked":"A ti ń wá yín pẹ́, èéṣe"},{"start":46.658,"end":47.824,"text":"T'ẹ n bi Ọlọrun ninu?","marked":"T'ẹ̀ ń bí Ọlọ́run nínú?"}],"end":47.824},{"key":"4","start":48.774,"lines":[{"start":48.774,"end":50.29,"text":"Iyemeji ha n se yin,","marked":"Iyèméjì ha ń ṣe yín"},{"start":50.74,"end":51.991,"text":"Pe Ifẹ ni Ọlọrun?","marked":"Pé Ìfẹ́ ni Ọlọ́run?"},{"start":52.441,"end":53.62,"text":"Ẹ ki o ha gb'ọrọ Rẹ,","marked":"Ẹ kí ó ha gb'ọ̀rọ̀ Rẹ"},{"start":54.07,"end":55.404,"text":"K' ẹ gba ileri rẹ gbọ?","marked":"K ẹ gba ìlérí rẹ̀ gbọ́?"},{"start":55.854,"end":57.716,"text":"W'Oluwa yin; lọdọ yin,","marked":"W'Olúwa yín; lọ́dọ̀ yín"},{"start":58.166,"end":60.406,"text":"Jesu n sun; w'omije Rẹ,","marked":"Jésù ń sùn; w'omijé Rẹ̀"},{"start":60.856,"end":62.252,"text":"Ẹjẹ Rẹ pẹlu n ke, pe,","marked":"Ẹ̀jẹ̀ Rẹ̀ pẹ̀lú ń ké, pé"},{"start":62.702,"end":64.152,"text":"\"Eese ti ẹ o fi ku?\".","marked":"Èéṣe tí ẹ ó fi kú?."}],"end":64.152}]}