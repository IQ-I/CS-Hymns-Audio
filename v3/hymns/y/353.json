{"v":3,"coll":"y","num":353,"id":"hymn_353","title":"E WA k'a da orin wa po","duration":40.971,"voices":{"male":{"file":"y-353-male-v3.m4a","bytes":283503,"sha256":"65594f188ebb3a1892deeb10d504426699578fe554267d18d6e7efa2488ad59c","duration":41.0},"female":{"file":"y-353-female-v3.m4a","bytes":296324,"sha256":"6c252313cfcb4462652b5a64c18232d43af6421ae95cf62941383b43b94614af","duration":41.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.037,"text":"E WA k'a da orin wa po","marked":"Ẹ Wá k'á dá orin wa pọ̀"},{"start":2.487,"end":3.431,"text":"Mo t'awon Angeli","marked":"Mo t'àwọn Áńgẹ́lì"},{"start":3.881,"end":5.357,"text":"Egbegberun ni ohun won","marked":"Ẹgbẹgbẹ̀rún ni ohun wọn"},{"start":5.807,"end":6.999,"text":"Okan ni ayo won.","marked":"Ọkàn ni ayọ̀ wọn."}],"end":6.999},{"key":"2","start":7.949,"lines":[{"start":7.949,"end":10.5,"text":"Wọn n kọrin pe, Ọla-nla yẹ,","marked":"Wọ́n ń kọrin pé, Ọla-nla yẹ"},{"start":10.95,"end":12.351,"text":"Ọd'-aguntan t'a pa,‖","marked":"Ọd'-aguntan t'á pa,‖"},{"start":12.801,"end":14.359,"text":"K'a gberin pe ―Ọla-nla yẹ,","marked":"K'á gberin pé ―Ọla-nla yẹ"},{"start":14.809,"end":15.962,"text":"'Tori O ku fun wa.","marked":"torí Ó kú fún wa."}],"end":15.962},{"key":"3","start":16.912,"lines":[{"start":16.912,"end":18.765,"text":"Jesu, ni O yẹ lati gba,","marked":"Jésù, ni Ó yẹ láti gbà"},{"start":19.215,"end":20.428,"text":"Ọla at'agbara;","marked":"Ọlá àt'agbára"},{"start":20.878,"end":22.495,"text":"K'iyin t'ẹnu wa ko le gba,","marked":"K'ìyìn t'ẹnu wa kò lè gbà"},{"start":22.945,"end":24.177,"text":"Jẹ Tirẹ, Oluwa.","marked":"Jẹ́ Tirẹ̀, Olúwa."}],"end":24.177},{"key":"4","start":25.127,"lines":[{"start":25.127,"end":26.324,"text":"K'awon t'o wa loke orun","marked":"K'àwọn t'ó wà lókè ọ̀run"},{"start":26.774,"end":27.854,"text":"At'ile at'okun","marked":"Àt'ilẹ̀ àt'òkun"},{"start":28.304,"end":29.994,"text":"Dapo lati gb'ogo Re ga","marked":"Dàpọ̀ láti gb'ògo Rẹ̀ ga"},{"start":30.444,"end":31.453,"text":"Jumo yin ola Re.","marked":"Jùmọ̀ yin ọlá Rẹ."}],"end":31.453},{"key":"5","start":32.403,"lines":[{"start":32.403,"end":33.986,"text":"ff Ki gbogbo ẹda d'ohun pọ,","marked":"ff Kí gbogbo ẹ̀dá d'ohun pọ̀"},{"start":34.436,"end":35.566,"text":"Lati yin orukọ,","marked":"Láti yin orúkọ"},{"start":36.016,"end":37.563,"text":"Ẹni t'o joko lor'itẹ,","marked":"Ẹni t'ó jókò lór'ìtẹ́"},{"start":38.013,"end":39.421,"text":"Ki wọn si wolẹ fun.","marked":"Kí wọ́n sì wólẹ̀ fún."}],"end":39.421}]}