{"v":3,"coll":"y","num":848,"id":"hymn_848","title":"ERO s'orun l'awa n se","duration":88.696,"voices":{"male":{"file":"y-848-male-v3.m4a","bytes":655678,"sha256":"fdfd1c0b66508860e0fb0da017f02032c657bd1149d643d7e8941373ef48fcb4","duration":88.7},"female":{"file":"y-848-female-v3.m4a","bytes":674884,"sha256":"ed37f4c26c2037f1939fc762e2871df520501d65813d4615349719a234f0c451","duration":88.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.631,"text":"ERO s'ọrun l'awa n se,","marked":"Èrò s'ọ̀run l'àwa ń ṣe"},{"start":2.081,"end":3.453,"text":"Ayé l'ọja ọrun n'ile wa;","marked":"Ayé l'ọjà ọ̀run n'ilẹ̀ wa"},{"start":3.903,"end":5.535,"text":"Atipo ni awa jẹ o ,","marked":"Àtìpó ni àwa jẹ́ ọ́"},{"start":5.985,"end":7.855,"text":"Ayé l'ajo, ọrun n'ile wa;","marked":"Ayé l'àjọ, ọ̀run n'ilẹ̀ wa"},{"start":8.305,"end":9.775,"text":"Gbogbo ewu lo duro o,","marked":"Gbogbo ewu ló dúró ọ"},{"start":10.225,"end":11.394,"text":"Yika wa l'ọjọ gbogbo,","marked":"Yíká wa l'ọjọ́ gbogbo"},{"start":11.844,"end":14.053,"text":"Ẹkun l'oni, ẹrin l'ọla;","marked":"Ẹkún l'òní, ẹ̀rín l'ọ̀la"},{"start":14.503,"end":16.643,"text":"Ayé l'ọja, ọrun n'ile wa.","marked":"Ayé l'ọ̀já, ọ̀run n'ilé wà."}],"end":16.643},{"key":"2","start":17.593,"lines":[{"start":17.593,"end":19.15,"text":"Iransẹ ti sun n'nu Oluwa,","marked":"Ìránsẹ́ ti sùn n'nú Olúwa"},{"start":19.6,"end":21.662,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":22.112,"end":24.284,"text":"Isẹ d'opin, ija d'opin,","marked":"Isẹ́ d'òpin, ìjà d'òpin"},{"start":24.734,"end":26.826,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":27.276,"end":28.714,"text":"O ti jagun f'Oluwa,","marked":"Ó ti jagun f'Olúwa"},{"start":29.164,"end":30.339,"text":"O bọ s'ayọ Baba rẹ;","marked":"Ó bọ́ s'ayọ̀ Baba rẹ̀"},{"start":30.789,"end":32.12,"text":"Titi la o se 'ranti rẹ,","marked":"Títí la ó ṣe rántí rẹ̀"},{"start":32.57,"end":34.166,"text":"Ayé l'ọja ọrun n'ile wa.","marked":"Ayé l'ọjà ọ̀run n'ilẹ̀ wa."}],"end":34.166},{"key":"3","start":35.116,"lines":[{"start":35.116,"end":37.185,"text":"Ọmọde n ku, agba n ku o,","marked":"Ọmọdé ń kú, àgbà ń kú ọ"},{"start":37.635,"end":39.646,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":40.096,"end":41.748,"text":"K'a ku n'nu Jesu lo dara,","marked":"K'á kú n'nú Jésù lọ dára"},{"start":42.198,"end":44.061,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":44.511,"end":46.007,"text":"Ka lọ 'gba wa fun Jesu,","marked":"Ká lọ gbà wá fún Jésù"},{"start":46.457,"end":47.704,"text":"'Tori ọjọ iku mbẹ;","marked":"torí ọjọ́ ikú mbẹ́"},{"start":48.154,"end":49.801,"text":"Ko s'ẹni ti ko ni ku o,","marked":"Kò s'ẹni tí kò ní kú ọ́"},{"start":50.251,"end":52.236,"text":"Ayé l'ọja, ọrun n'ile wa.","marked":"Ayé l'ọ̀já, ọ̀run n'ilé wà."}],"end":52.236},{"key":"4","start":53.186,"lines":[{"start":53.186,"end":54.932,"text":"Lọd' Oluwa ni 'sinmi mbẹ,","marked":"Lọd' Olúwa ni sinmi mbẹ́"},{"start":55.382,"end":57.462,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":57.912,"end":59.302,"text":"'Banujẹ kan ko si nibẹ,","marked":"'Banujẹ kan kò sí níbẹ̀"},{"start":59.752,"end":61.828,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":62.278,"end":63.375,"text":"Ọpọ ibugbe lo wa,","marked":"Ọ̀pọ̀ ibùgbé ló wà"},{"start":63.825,"end":65.18,"text":"T'Ọlọrun ti ko s'ọrun,","marked":"T'Ọlọ́run tí kò s'ọ̀run"},{"start":65.63,"end":67.089,"text":"F'awọn to ba sin dopin,","marked":"F'àwọn tó bá sìn dópin"},{"start":67.539,"end":69.726,"text":"Ayé l'ọja, ọrun n'ile wa.","marked":"Ayé l'ọ̀já, ọ̀run n'ilé wà."}],"end":69.726},{"key":"5","start":70.676,"lines":[{"start":70.676,"end":72.256,"text":"Iransẹ naa yọ n'nu Oluwa,","marked":"Ìránsẹ́ náà yọ n'nú Olúwa"},{"start":72.706,"end":74.737,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":75.187,"end":76.869,"text":"O ti ri Jesu to fẹ ọ,","marked":"Ó ti rí Jésù tó fẹ́ ọ"},{"start":77.319,"end":79.314,"text":"Ayé l'ọja, ọrun n'ile wa;","marked":"Ayé l'ọ̀já, ọ̀run n'ilẹ̀ wa"},{"start":79.764,"end":81.04,"text":"Baba rere tọju wa,","marked":"Baba rere tọ́jú wa"},{"start":81.49,"end":82.806,"text":"K'ayé mase gbe wa lọ!","marked":"K'ayé máṣe gbé wa lọ!"},{"start":83.256,"end":84.575,"text":"K'a le j'ẹni idalare;","marked":"K'á lè j'ẹni ìdáláre"},{"start":85.025,"end":87.148,"text":"Ayé l'ọja, ọrun n'ile wa.","marked":"Ayé l'ọ̀já, ọ̀run n'ilé wà."}],"end":87.148}]}