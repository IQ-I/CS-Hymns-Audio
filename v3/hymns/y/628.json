{"v":3,"coll":"y","num":628,"id":"hymn_628","title":"IGBA mi mbe ni owo Re","duration":57.389,"voices":{"male":{"file":"y-628-male-v3.m4a","bytes":392607,"sha256":"be1d84712d00a4dfc6c5d78ff37d71b971f862e8fd81560eb8cc79a94ec04b86","duration":57.4},"female":{"file":"y-628-female-v3.m4a","bytes":406066,"sha256":"5e4590f41b2a2ed84f453b1293cb1207a5c07439ed979ba32d9c5e0b4ee5081a","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.531,"text":"IGBA mi mbe li owo re","marked":"Ìgbà mi mbẹ́ lí ọwọ́ rẹ"},{"start":1.981,"end":3.114,"text":"Jesu Olugbala","marked":"Jésù Olùgbàlà"},{"start":3.564,"end":5.056,"text":"Gbogb' aniyan at'ero mi","marked":"Gbogb àníyàn àt'èrò mi"},{"start":5.506,"end":6.901,"text":"Ni mo fi ro s'odo Re.","marked":"Ni mo fi rò s'ọ́dọ̀ Rẹ."}],"end":6.901},{"key":"CHORUS","start":7.851,"lines":[{"start":7.851,"end":9.748,"text":"Sanu fun mi, gb'adura mi","marked":"Ṣànù fún mi, gb'àdúrà mi"},{"start":10.198,"end":10.925,"text":"Ran mi lowo","marked":"Ràn mí lọ́wọ́"},{"start":11.375,"end":13.39,"text":"Sanu fun mi, gb'adura mi","marked":"Ṣànù fún mi, gb'àdúrà mi"},{"start":13.84,"end":14.705,"text":"Ran mi lowo","marked":"Ràn mí lọ́wọ́"},{"start":15.155,"end":16.583,"text":"Iwo ni mo gbekele.","marked":"Ìwọ ni mo gbẹ́kẹ̀lé."}],"end":16.583},{"key":"2","start":17.533,"lines":[{"start":17.533,"end":18.851,"text":"Igba mi mbe li owo Re","marked":"Ìgbà mi mbẹ́ lí ọwọ́ Rẹ"},{"start":19.301,"end":20.494,"text":"Ko si 'foiya fun mi mo","marked":"Kò sì fòìyà fún mi mọ́"},{"start":20.944,"end":22.398,"text":"Baba ki yio je k'omo Re","marked":"Baba kì yóò jẹ́ k'ọmọ Rẹ"},{"start":22.848,"end":24.151,"text":"Sokun ni ainidi.","marked":"Sọkún ni àìnídì."}],"end":24.151},{"key":"3","start":25.101,"lines":[{"start":25.101,"end":26.86,"text":"Tani yio gbe Jakobu dide","marked":"Tani yóò gbé Jakọbu dìde"},{"start":27.31,"end":28.645,"text":"Ni ero araiye","marked":"Ní èrò aráìyè"},{"start":29.095,"end":30.462,"text":"Egun gbigbe tun le soji","marked":"Ègún gbígbẹ tún lè sọjí"},{"start":30.912,"end":32.376,"text":"Lagbara Oga Ogo.","marked":"Lágbára Ọ̀gá Ògo."}],"end":32.376},{"key":"4","start":33.326,"lines":[{"start":33.326,"end":34.962,"text":"B'aiye tile d'oju ko mi","marked":"B'ayé tilẹ̀ d'ojú kọ̀ mí"},{"start":35.412,"end":36.501,"text":"Ti ota nlepa mi","marked":"Tí ọ̀tá ńlépa mi"},{"start":36.951,"end":38.493,"text":"Sibe b'O ba wa pelu mi","marked":"Síbẹ̀ b'Ó bá wà pẹ̀lú mi"},{"start":38.943,"end":40.501,"text":"Kini yio fo mi l'aiya.","marked":"Kíni yóò fọ́ mi l'àìyà."}],"end":40.501},{"key":"5","start":41.451,"lines":[{"start":41.451,"end":42.942,"text":"Bi ko tile s'alabaro","marked":"Bí kò tilẹ̀ s'alábàrò"},{"start":43.392,"end":44.557,"text":"Ti Olutunu jina","marked":"Tí Olùtùnú jìnà"},{"start":45.007,"end":46.299,"text":"Olorun yio bo asiri","marked":"Ọlọ́run yóò bo àṣírí"},{"start":46.749,"end":48.139,"text":"F'enit'o ba gbeke E.","marked":"F'ẹnit'ó bá gbẹ́kẹ̀ Ẹ."}],"end":48.139},{"key":"6","start":49.089,"lines":[{"start":49.089,"end":50.403,"text":"Apata mi aiyeraiye","marked":"Àpáta mi ayérayé"},{"start":50.853,"end":52.079,"text":"Wo ni mo gbekle","marked":"Wò ni mo gbẹ́klẹ̀"},{"start":52.529,"end":54.11,"text":"Jowo ma jek'Oju ti mi","marked":"Jọ̀wọ́ má jẹ́k'ojú tì mí"},{"start":54.56,"end":55.84,"text":"Ttti ngo fi d'odo re.","marked":"Ttti ńgò fi d'ọ̀dọ̀ rẹ̀."}],"end":55.84}]}