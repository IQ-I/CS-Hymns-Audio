{"v":3,"coll":"y","num":160,"id":"hymn_160","title":"EMI Olorun mi","duration":47.025,"voices":{"male":{"file":"y-160-male-v3.m4a","bytes":337010,"sha256":"46803ae3b2ea66d726aff1b52e947e7c0cd4fe8f3430002604f502283d3f473e","duration":47.1},"female":{"file":"y-160-female-v3.m4a","bytes":346554,"sha256":"b9ec9f08b7f3cae55a8ad3a16076b299e60b6213b43cdcc264765613d81b8c1a","duration":47.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.183,"text":"ẸMI Ọlọrun mi,","marked":"Ẹ̀mí Ọlọ́run mi"},{"start":1.633,"end":2.932,"text":"L'ọjọ 'tẹwọgba yi,","marked":"L'ọjọ́ 'tẹwọgba yí"},{"start":3.382,"end":5.083,"text":"Gẹgẹ b'ọjọ Pẹntikọsti,","marked":"Gẹ́gẹ́ b'ọjọ́ Pẹntikọsti"},{"start":5.533,"end":6.801,"text":"f Sọkalẹ l'agbara;","marked":"f Sọ̀kalẹ̀ l'agbára"},{"start":7.251,"end":9.243,"text":"L'ọkan kan l'apade","marked":"L'ọkàn kan l'àpàdé"},{"start":9.693,"end":10.712,"text":"Ninu ile Rẹ yii,","marked":"Nínú ilé Rẹ yìí"},{"start":11.162,"end":12.44,"text":"A duro de ileri Rẹ,","marked":"A dúró de ìlérí Rẹ̀"},{"start":12.89,"end":14.076,"text":"A duro de Ẹmi.","marked":"A dúró de Ẹ̀mí."}],"end":14.076},{"key":"2","start":15.026,"lines":[{"start":15.026,"end":16.347,"text":"B'iro iji lile,","marked":"B'írò ìjì líle"},{"start":16.797,"end":18.046,"text":"Wa kun 'nu ile yi;","marked":"Wá kún nú ilẹ̀ yí"},{"start":18.496,"end":20.299,"text":"Mi Ẹmi isọkan si wa,","marked":"Mi Ẹ̀mí ìsọ̀kan sì wà"},{"start":20.749,"end":22.308,"text":"Ọkan kan, imọ kan,","marked":"Ọkàn kan, ìmọ̀ kan"},{"start":22.758,"end":24.382,"text":"Fun ewe at'agba,","marked":"Fún èwe àt'àgbà"},{"start":24.832,"end":26.211,"text":"L'ọgbọn at'oke wa,","marked":"L'ọgbọ́n àt'òkè wà"},{"start":26.661,"end":27.961,"text":"Fi ọkan gbigbona fun wa,","marked":"Fi ọkàn gbígbóná fún wa"},{"start":28.411,"end":30.477,"text":"K'a yin, k'agbadura.","marked":"K'á yín, k'àgbàdúrà."}],"end":30.477},{"key":"3","start":31.427,"lines":[{"start":31.427,"end":32.355,"text":"Ẹmi imọlẹ wa,","marked":"Ẹ̀mí ìmọ́lẹ̀ wà"},{"start":32.805,"end":34.198,"text":"Le okunkun jade,","marked":"Lé òkùnkùn jáde"},{"start":34.648,"end":36.184,"text":"Siwaju ni k'imọlẹ tan,","marked":"Síwájú ni k'ìmọ́lẹ̀ tán"},{"start":36.634,"end":37.859,"text":"Titi d'ọsangangan,","marked":"Títí d'ọ̀sangàngàn"},{"start":38.309,"end":39.351,"text":"Emi otitọ wa,","marked":"Ẹ̀mí òtítọ́ wà"},{"start":39.801,"end":41.168,"text":"S'amọna wa titi,","marked":"S'amọ̀nà wà títí"},{"start":41.618,"end":43.667,"text":"Ẹmi Isọdọmọ, si wa,","marked":"Ẹ̀mí Ìsọdọmọ, sì wá"},{"start":44.117,"end":45.476,"text":"S'ọkan wa di mimọ.","marked":"S'ọkàn wa di mímọ́."}],"end":45.476}]}