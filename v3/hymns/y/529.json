{"v":3,"coll":"y","num":529,"id":"hymn_529","title":"ALAFIA ni f'okan na","duration":64.826,"voices":{"male":{"file":"y-529-male-v3.m4a","bytes":449995,"sha256":"057339c7347145bec0b0452934132901551da0d94419fe4f565300ce34cd9e90","duration":64.9},"female":{"file":"y-529-female-v3.m4a","bytes":466873,"sha256":"84a1f9979f3a6304de490fffd7959ae22ef78e62341b61a3c38dd5526d9ce4d8","duration":64.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.856,"text":"ALAFIA ni f'ọkan na;","marked":"Àlàáfíà ni f'ọkàn ná"},{"start":2.306,"end":3.341,"text":"Nibi ti 'fẹ gbe wa,","marked":"Níbi tí 'fẹ gbé wá"},{"start":3.791,"end":5.196,"text":"Kérúbù pẹlu Séráfù,","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":5.646,"end":6.859,"text":"Ẹ fẹran ara yin.","marked":"Ẹ fẹ́ràn ara yín."}],"end":6.859},{"key":"2","start":7.809,"lines":[{"start":7.809,"end":9.332,"text":"Gẹgẹ bi Kérúbù ọrun,","marked":"Gẹ́gẹ́ bí Kérúbù ọ̀run"},{"start":9.782,"end":10.977,"text":"Pẹlu Seraf' ọrun;","marked":"Pẹ̀lú Seraf ọ̀run"},{"start":11.427,"end":12.76,"text":"Awọn ni wọn yi 'tẹ na ka,","marked":"Àwọn ni wọ́n yí 'tẹ ná ká"},{"start":13.21,"end":14.386,"text":"Wọn yin Baba logo.","marked":"Wọ́n yin Baba lógo."}],"end":14.386},{"key":"3","start":15.336,"lines":[{"start":15.336,"end":16.791,"text":"Asan ni gbogbo 'gbagbọ jẹ,","marked":"Asán ni gbogbo 'gbagbọ jẹ́"},{"start":17.241,"end":18.588,"text":"Bi ko si 'fẹ nibẹ;","marked":"Bí kò sì 'fẹ níbẹ̀"},{"start":19.038,"end":20.564,"text":"Ẹsẹ yoo jọba lọkan wa,","marked":"Ẹsẹ̀ yóò jọba lọ́kàn wá"},{"start":21.014,"end":22.439,"text":"B' ifẹ ko si nibẹ.","marked":"B ìfẹ́ kò sí níbẹ̀."}],"end":22.439},{"key":"4","start":23.389,"lines":[{"start":23.389,"end":24.763,"text":"Ifẹ nikan ni yoo r'opin,","marked":"Ìfẹ́ nìkan ni yóò r'òpin"},{"start":25.213,"end":26.386,"text":"Ẹ fẹran ara yin,","marked":"Ẹ fẹ́ràn ara yín"},{"start":26.836,"end":29.124,"text":"Ma banujẹ, ma b'ohun bọ,","marked":"Má banújẹ́, má b'ohun bọ̀"},{"start":29.574,"end":30.896,"text":"Ade yoo jẹ tiwa.","marked":"Adé yóò jẹ́ tiwa."}],"end":30.896},{"key":"5","start":31.846,"lines":[{"start":31.846,"end":33.409,"text":"Sugbọn ifẹ ni n wi bayi,","marked":"Sùgbọ́n ìfẹ́ ní ń wí báyì"},{"start":33.859,"end":35.045,"text":"Ẹ fẹran ara yin;","marked":"Ẹ fẹ́ràn ara yín"},{"start":35.495,"end":37.153,"text":"Nipa ifẹ a o ri Baba,","marked":"Nípa ìfẹ́ a ó rí Baba"},{"start":37.603,"end":38.657,"text":"L'oke ọrun lọhun.","marked":"L'òkè ọ̀run lọ́hùn."}],"end":38.657},{"key":"6","start":39.607,"lines":[{"start":39.607,"end":41.116,"text":"Jehovah-Nissi Baba wa,","marked":"Jehovah-nissi Baba wa"},{"start":41.566,"end":42.901,"text":"Pe wa n' Tirẹ loke;","marked":"Pé wá ń Tirẹ̀ lókè"},{"start":43.351,"end":44.559,"text":"Ẹmi Mimọ 'daba ọrun,","marked":"Ẹ̀mí Mímọ́ dàbà ọ̀run"},{"start":45.009,"end":46.228,"text":"Jọwọ f'ọna han ni.","marked":"Jọ̀wọ́ f'ọ̀nà hàn ni."}],"end":46.228},{"key":"7","start":47.178,"lines":[{"start":47.178,"end":49.433,"text":"Jesu Olugbala, owon","marked":"Jésù Olùgbàlà, ọ̀wọ́n"},{"start":49.883,"end":51.078,"text":"Fun Kerubu n'ife","marked":"Fún Kérúbù n'ìfẹ́"},{"start":51.528,"end":53.062,"text":"Gege bi Kerubu orun","marked":"Gẹ́gẹ́ bí Kérúbù ọ̀run"},{"start":53.512,"end":54.816,"text":"Pelu Seraf' orun.","marked":"Pẹ̀lú Seraf ọ̀run."}],"end":54.816},{"key":"8","start":55.766,"lines":[{"start":55.766,"end":57.51,"text":"Jehovah-Rufi Baba wa","marked":"Jehovah-rufi Baba wa"},{"start":57.96,"end":59.246,"text":"Fun wa l'okun 'lera","marked":"Fún wa l'òkun lera"},{"start":59.696,"end":61.444,"text":"Ka le jo fi 'yin fun Baba","marked":"Ká lè jọ fi yín fún Baba"},{"start":61.894,"end":63.277,"text":"Gege b'awon t'orun.","marked":"Gẹ́gẹ́ b'àwọn t'ọ̀run."}],"end":63.277}]}