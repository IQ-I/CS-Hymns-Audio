{"v":3,"coll":"y","num":695,"id":"hymn_695","title":"GBE ori iyin s'oke, eyin","duration":35.17,"voices":{"male":{"file":"y-695-male-v3.m4a","bytes":253615,"sha256":"2ecf666fc5ee211efe69d1f4e50312140217f01c0aabfe37ff62a79770c33d4d","duration":35.2},"female":{"file":"y-695-female-v3.m4a","bytes":260363,"sha256":"5f45739d0565eaf0f53b396eae582c9bf953928d459e82c372c9ab16ea62d95c","duration":35.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.42,"text":"GBE ori iyin s'oke, eyin","marked":"Gbé orí ìyìn s'ókè, ẹ̀yin"},{"start":2.87,"end":4.023,"text":"'Lekun aiyeraiye:","marked":"lẹ́kùn ayérayé"},{"start":4.473,"end":7.19,"text":"Gba oba ogo: wo, o mbo","marked":"Gba ọba ògo: wò, ó mbọ̀"},{"start":7.64,"end":8.712,"text":"Pel'ogun orun Re.","marked":"Pẹ̀l'ogun ọ̀run Rẹ."},{"start":9.162,"end":10.943,"text":"Ta l'Oba Ogo yi? Tani?","marked":"Ta l'Ọba Ògo yí? Tani?"},{"start":11.393,"end":12.626,"text":"Oluwa t'o ni ipa","marked":"Olúwa t'ọ́ ní ipa"},{"start":13.076,"end":14.735,"text":"T'o lagbara l'o or'ota Re","marked":"T'ó lágbára l'o ọr'ọ̀tá Rẹ"},{"start":15.185,"end":16.818,"text":"Asegun, Alade.","marked":"Aṣẹ́gun, Aládé."}],"end":16.818},{"key":"2","start":17.768,"lines":[{"start":17.768,"end":19.743,"text":"Gbe ori yin s'oke, enyin","marked":"Gbé orí yín s'ókè, ẹ̀yin"},{"start":20.193,"end":21.804,"text":"Ilekun; lati gbaa","marked":"Ìlẹ̀kùn; láti gbàá"},{"start":22.254,"end":24.343,"text":"Oba ogo, pe we, o mbo","marked":"Ọba ògo, pé wẹ̀, ó mbọ̀"},{"start":24.793,"end":25.779,"text":"Pel' ogun didan Re","marked":"Pẹ̀l ogun dídán Rẹ̀"},{"start":26.229,"end":27.249,"text":"Tal'oba Ogo yi?","marked":"Tál'ọba Ògo yí?"},{"start":27.699,"end":28.9,"text":"Oluwa t'o n'ipa","marked":"Olúwa t'ó n'ipa"},{"start":29.35,"end":30.641,"text":"L'ogo on nikan Ii oba","marked":"L'ògo ọn nìkan Ìí ọba"},{"start":31.091,"end":32.518,"text":"Ta f'ogo de l'ade.","marked":"Ta f'ògo dé l'adé."},{"start":32.968,"end":33.62,"text":"Amin.","marked":"Àmín."}],"end":33.62}]}