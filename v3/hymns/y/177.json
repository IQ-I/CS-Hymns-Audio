{"v":3,"coll":"y","num":177,"id":"hymn_177","title":"IJO ti nduro pe","duration":68.312,"voices":{"male":{"file":"y-177-male-v3.m4a","bytes":484139,"sha256":"77667c2ae76f0d87cda8c6dbb315e0aa77ca0888c017fdbeffdba04d423289a1","duration":68.4},"female":{"file":"y-177-female-v3.m4a","bytes":508850,"sha256":"53acd5444235af843e159a7d9b14d80c5f2b3c57556ba038132b96353f0ea748","duration":68.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.361,"text":"IJO ti nduro pe","marked":"Ìjọ ti ńdúró pé"},{"start":1.811,"end":2.854,"text":"Lati ri Oluwa","marked":"Láti rí Olúwa"},{"start":3.304,"end":4.687,"text":"O si wa bakan na sibe","marked":"Ó sì wà bákan ná síbẹ̀"},{"start":5.137,"end":6.425,"text":"Ko s'alabaro fun","marked":"Kò s'alábàrò fún"},{"start":6.875,"end":8.194,"text":"Odun nyi lu odun","marked":"Ọdún nyí lu ọdún"},{"start":8.644,"end":9.648,"text":"Ojo ngori ojo","marked":"Ọjọ́ ńgorí ọjọ́"},{"start":10.098,"end":11.685,"text":"Sibe lairi Oluwa re","marked":"Síbẹ̀ láìrí Olúwa rẹ̀"},{"start":12.135,"end":13.217,"text":"O wa ninu ofo","marked":"Ó wà nínú ọ̀fọ̀"},{"start":13.667,"end":15.176,"text":"Ma bo, Jesu ma bo!","marked":"Má bọ̀, Jésù má bọ̀!"}],"end":15.176},{"key":"2","start":16.126,"lines":[{"start":16.126,"end":17.164,"text":"Awon mimo l'aiye","marked":"Àwọn mímọ́ l'ayé"},{"start":17.614,"end":18.81,"text":"Opo won l'oti ku","marked":"Ọ̀pọ̀ wọn l'ọtí kú"},{"start":19.26,"end":21.218,"text":"Bi won si ti nlo l'okankan","marked":"Bí wọ́n sì ti ńlọ l'ọ̀kankan"},{"start":21.668,"end":22.917,"text":"L'a te won gbe 'ra won","marked":"L'á tẹ́ wọn gbé ra wọn"},{"start":23.367,"end":24.501,"text":"A te won lati sun","marked":"A tẹ̀ wọ́n láti sùn"},{"start":24.951,"end":26.02,"text":"Ki se ainireti","marked":"Kí ṣe àìnírètí"},{"start":26.47,"end":28.236,"text":"A te won lati r'eju ni","marked":"A tẹ̀ wọ́n láti r'ẹjú ni"},{"start":28.686,"end":30.08,"text":"K'ile ogo to mo","marked":"K'ilẹ̀ ògo tó mọ́"},{"start":30.53,"end":31.909,"text":"Ma bo, Jesu mabo!","marked":"Má bọ̀, Jésù màbọ̀!"}],"end":31.909},{"key":"3","start":32.859,"lines":[{"start":32.859,"end":33.908,"text":"Awon ola npo si","marked":"Àwọn ọlá ńpọ̀ sí"},{"start":34.358,"end":35.513,"text":"Abgara esu nga","marked":"Abgara èṣù ńgà"},{"start":35.963,"end":37.783,"text":"Ogun ngbona, igbagbo nku","marked":"Ogun ńgbóná, ìgbàgbọ́ ńkú"},{"start":38.233,"end":39.63,"text":"lfe si di tutu","marked":"Ìfẹ́ sì di tútù"},{"start":40.08,"end":41.435,"text":"Y'o ti pe to Baba","marked":"Y'ó ti pẹ́ tó Baba"},{"start":41.885,"end":42.865,"text":"Oloto Olore","marked":"Ọlọ́tọ̀ Ọlọ́rẹ̀"},{"start":43.315,"end":44.88,"text":"Wo ki y'o koya omije","marked":"Wò kí y'ó kóyá omijé"},{"start":45.33,"end":46.449,"text":"At'eje Ijo Re","marked":"Àt'ẹ̀jẹ̀ Ìjọ Rẹ"},{"start":46.899,"end":48.452,"text":"Ma bo Jesu ma bo!","marked":"Má bọ́ Jésù má bọ́!"}],"end":48.452},{"key":"4","start":49.402,"lines":[{"start":49.402,"end":50.591,"text":"A nfe gbo ohun Re","marked":"A ńfẹ́ gbọ́ ohùn Rẹ̀"},{"start":51.041,"end":52.286,"text":"A nfe f'oju kan O","marked":"A ńfẹ́ f'ojú kan Ọ"},{"start":52.736,"end":54.511,"text":"K'a le gba ade at' ogo","marked":"K'á lè gba adé àt ògo"},{"start":54.961,"end":56.222,"text":"B'a ti ngha ore Re","marked":"B'á ti ńgha ọ̀rẹ́ Rẹ"},{"start":56.672,"end":58.312,"text":"Jo, wa m'ese kuro","marked":"Jọ, wá m'ẹsẹ̀ kúrò"},{"start":58.762,"end":60.241,"text":"A t'egun at'eri","marked":"A t'ẹ̀gùn àt'ẹ̀rí"},{"start":60.691,"end":62.207,"text":"K'o si so aye osi yi","marked":"K'ó sì sọ ayé òsì yí"},{"start":62.657,"end":63.819,"text":"D'aye rere Tire","marked":"D'ayé rere Tire"},{"start":64.269,"end":65.696,"text":"Ma bo, Jesu ma bo.","marked":"Má bọ̀, Jésù má bọ̀."},{"start":66.146,"end":66.763,"text":"Amin.","marked":"Àmín."}],"end":66.763}]}