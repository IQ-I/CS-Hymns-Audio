{"v":3,"coll":"y","num":236,"id":"hymn_236","title":"MOKANDILOGORUN dubule je","duration":67.201,"voices":{"male":{"file":"y-236-male-v3.m4a","bytes":490874,"sha256":"a1c88aced7e2b5bdbf81f1bed865219563f04046693edb2e3e21a8376f3f4d8e","duration":67.3},"female":{"file":"y-236-female-v3.m4a","bytes":507477,"sha256":"33de6d8107f9d0fabc307abd5c844cd0534af751b9fbfd84f9f83713b1ee2436","duration":67.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.272,"text":"MỌKANDILỌGỌRUN dubule jẹ,","marked":"Mọ́kàndílọ́gọ́rùn dùbúlẹ̀ jẹ́"},{"start":2.722,"end":3.967,"text":"Labẹ oji nin' agbo;","marked":"Lábẹ́ òjì nín agbo"},{"start":4.417,"end":6.233,"text":"Sugbọn ọkan jẹ lọ or'oke,","marked":"Sùgbọ́n ọkàn jẹ́ lọ ọ̀r'òkè"},{"start":6.683,"end":7.874,"text":"Jina s'ilekun wura;","marked":"Jìnà s'ìlẹ̀kùn wúrà"},{"start":8.324,"end":9.802,"text":"Jina rere l' or' oke sisa,","marked":"Jìnà rere l ọ̀r òkè sísá"},{"start":10.252,"end":11.749,"text":"Jina rere s'Olus' aguntan.","marked":"Jìnà rere s'Olùṣ àgùntàn."}],"end":11.749},{"key":"2","start":12.699,"lines":[{"start":12.699,"end":14.901,"text":"Mọkandilọgọrun Tirẹ leyi:","marked":"Mọ́kàndílọ́gọ́rùn Tirẹ̀ lèyí"},{"start":15.351,"end":17.555,"text":"Jesu, wọn ko ha to fun O?‖","marked":"Jésù, wọn kò ha tó fún Ọ?‖"},{"start":18.005,"end":20.224,"text":"Olus'-aguntan dahun, ―Temi yi,","marked":"Olus'-aguntan dáhùn, ―Tèmi yí"},{"start":20.674,"end":21.746,"text":"Ti sako lọdọ mi;","marked":"Ti ṣáko lọ́dọ̀ mi"},{"start":22.196,"end":23.568,"text":"B'ọna tilẹ ri palapala,","marked":"B'ọ̀nà tilẹ̀ rí pálapàla"},{"start":24.018,"end":25.881,"text":"N ó w'aginju lọ w'aguntan mi.","marked":"N ó w'aginjù lọ w'àgùntàn mi."}],"end":25.881},{"key":"3","start":26.831,"lines":[{"start":26.831,"end":28.236,"text":"Ọkan nin' awọn t'a ra pada,","marked":"Ọkàn nín àwọn t'á rà padà"},{"start":28.686,"end":29.982,"text":"Ko mọ jinjin omi na;","marked":"Kò mọ jinjin omi ná"},{"start":30.432,"end":32.517,"text":"Ati duru oru ti Jesu kọja,","marked":"Àti dùrù òru tí Jésù kọjá"},{"start":32.967,"end":34.44,"text":"K'o to r'aguntan Rẹ he;","marked":"K'ó tó r'àgùntàn Rẹ̀ he"},{"start":34.89,"end":36.413,"text":"L'aginju rere l'o gbọ 'gbe re,","marked":"L'aginjù rere l'ó gbọ́ gbé rẹ̀"},{"start":36.863,"end":39.193,"text":"O ti rẹ tan, o si ti ku tan.","marked":"Ó ti rẹ̀ tán, ó sì ti kú tán."}],"end":39.193},{"key":"4","start":40.143,"lines":[{"start":40.143,"end":41.661,"text":"Nibo n'iro ẹjẹ ni ti wa,","marked":"Níbo n'ìró ẹ̀jẹ̀ ní ti wà"},{"start":42.111,"end":43.433,"text":"T'o f'ọna or' oke han?","marked":"T'ó f'ọ̀nà ọ̀r òkè hàn?"},{"start":43.883,"end":46.095,"text":"A ta silẹ f'ẹnikan t'o sako,","marked":"A ta sílẹ̀ f'ẹnìkan t'ó ṣáko"},{"start":46.545,"end":48.671,"text":"K'Olusaguntan to mu pada","marked":"K'Olùṣàgùntàn tó mú padà"},{"start":49.121,"end":51.501,"text":"Jesu, kil'o gun ọwọ Rẹ bẹẹ?","marked":"Jésù, kíl'ó gun ọwọ́ Rẹ̀ bẹ́ẹ̀?"},{"start":51.951,"end":53.485,"text":"Ẹgun pupọ l'o gun mi nibe.","marked":"Ẹ̀gún púpọ̀ l'ó gún mi níbẹ̀."}],"end":53.485},{"key":"5","start":54.435,"lines":[{"start":54.435,"end":55.784,"text":"Sugbon ni gbogbo ori oke","marked":"Ṣùgbọ́n ní gbogbo orí òkè"},{"start":56.234,"end":57.421,"text":"Ati l'ori apata","marked":"Àti l'orí àpáta"},{"start":57.871,"end":59.582,"text":"Igbe ta l'oke orun wi","marked":"Igbe ta l'òkè ọ̀run wí"},{"start":60.032,"end":61.944,"text":"pé, “Yo, mo r'aguntan mi","marked":"pé, Yó, mo r'àgùntàn mi"},{"start":62.394,"end":64.53,"text":"he\" 'Yo, Jesu m'ohun Tire","marked":"he yọ̀, Jésù m'ohun Tire"},{"start":64.98,"end":65.652,"text":"pada.","marked":"padà."}],"end":65.652}]}