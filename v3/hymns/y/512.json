{"v":3,"coll":"y","num":512,"id":"hymn_512","title":"EGBE Seraf e ma beru","duration":82.06,"voices":{"male":{"file":"y-512-male-v3.m4a","bytes":586526,"sha256":"253005349c61ddea854cc5fe46fc3b69dfe59e4b009140874d8c8e93fb3b0a53","duration":82.1},"female":{"file":"y-512-female-v3.m4a","bytes":619557,"sha256":"bc54f41f14218b43c74a947d4b68323dca127711b52b8bbc32ac511ab4baec12","duration":82.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.514,"text":"Ẹgbẹ Seraf, ẹ ma bẹru,","marked":"Ẹgbẹ́ Seraf, ẹ má bẹ̀rù"},{"start":2.964,"end":4.099,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":4.549,"end":6.449,"text":"B'esu gbe tasi rẹ si wa,","marked":"B'èṣù gbé tàsí rẹ̀ sí wa"},{"start":6.899,"end":8.178,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":8.628,"end":10.218,"text":"Jesu Kristi l'Ọgagun wa,","marked":"Jésù Kristi l'Ọ̀gágun wà"},{"start":10.668,"end":12.237,"text":"Yo fo'tẹgun esu tutu","marked":"Yọ fó'tẹ́gùn èṣù tútù"},{"start":12.687,"end":14.304,"text":"Esu yoo wolẹ labẹ Rẹ,","marked":"Èṣù yóò wólẹ̀ lábẹ́ Rẹ"},{"start":14.754,"end":15.956,"text":"Ki yoo si nkan.","marked":"Kì yóò sí nǹkan."}],"end":15.956},{"key":"2","start":16.906,"lines":[{"start":16.906,"end":18.296,"text":"B'a ba ń rin l'afonifoji,","marked":"B'á bá ń rìn l'àfonífojì"},{"start":18.746,"end":19.994,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":20.444,"end":22.377,"text":"B'iku ń pa l'ọtun ń pa l'osi","marked":"B'ikú ń pa l'ọ̀tún ń pa l'òṣì"},{"start":22.827,"end":24.016,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":24.466,"end":26.686,"text":"Mase foya, Ijọ Seraf,","marked":"Mase fòyà, Ìjọ Seraf"},{"start":27.136,"end":28.34,"text":"Tẹsiwaju b'ọmọ ogun,","marked":"Tẹ̀síwájú b'ọmọ ogun"},{"start":28.79,"end":30.559,"text":"Krist' Ọgagun wa niwaju,","marked":"Krist Ọ̀gágun wà níwájú"},{"start":31.009,"end":32.211,"text":"Ki yoo si nkan.","marked":"Kì yóò sí nǹkan."}],"end":32.211},{"key":"3","start":33.161,"lines":[{"start":33.161,"end":34.578,"text":"Kil' ohun ti mba yin lẹru,","marked":"Kìl ohun tí mbà yín lẹ́rù"},{"start":35.028,"end":35.879,"text":"Ẹgbẹ Seraf;","marked":"Ẹgbẹ́ Seraf"},{"start":36.329,"end":37.873,"text":"'Gbati Jesu wa pẹlu wa,","marked":"gbàtí Jésù wà pẹ̀lú wa"},{"start":38.323,"end":39.525,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":39.975,"end":41.841,"text":"Sa gbadura, tẹ siwaju,","marked":"Sá gbàdúrà, tẹ̀ síwájú"},{"start":42.291,"end":44.568,"text":"Oke nla yoo di pẹtẹlẹ;","marked":"Òkè ńlá yóò di pẹ̀tẹ́lẹ̀"},{"start":45.018,"end":46.482,"text":"Ayé ko le ri wa gbe se,","marked":"Ayé kò lè rí wa gbé ṣe"},{"start":46.932,"end":48.176,"text":"Ki yoo si nkan.","marked":"Kì yóò sí nǹkan."}],"end":48.176},{"key":"4","start":49.126,"lines":[{"start":49.126,"end":50.735,"text":"Ẹgbẹ Seraf, tẹ siwaju,","marked":"Ẹgbẹ́ Seraf, tẹ̀ síwájú"},{"start":51.185,"end":51.963,"text":"Larin ina,","marked":"Lárin iná"},{"start":52.413,"end":53.841,"text":"Ina Esu ko le jo wa,","marked":"Iná Èṣù kò lè jọ wá"},{"start":54.291,"end":55.07,"text":"Dajudaju,","marked":"Dájúdájú"},{"start":55.52,"end":58.527,"text":"Bi Sedraki, Mesaki ati","marked":"Bí Ṣedraki, Meṣaki àti"},{"start":58.977,"end":60.255,"text":"Abednigo ninu ina,","marked":"Abednigo nínú iná"},{"start":60.705,"end":62.625,"text":"Be la o duro pẹlu Jesu,","marked":"Bẹ̀ la ó dúró pẹ̀lú Jésù"},{"start":63.075,"end":64.32,"text":"Ki yoo si nkan.","marked":"Kì yóò sí nǹkan."}],"end":64.32},{"key":"5","start":65.27,"lines":[{"start":65.27,"end":67.735,"text":"Ẹgbẹ Seraf, ẹ ho f'ayọ,","marked":"Ẹgbẹ́ Seraf, ẹ hó f'ayọ̀"},{"start":68.185,"end":69.43,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":69.88,"end":71.51,"text":"Jesu ti fọ 'tẹgun esu,","marked":"Jésù ti fọ́ 'tẹgun èṣù"},{"start":71.96,"end":72.734,"text":"Dajudaju ;","marked":"Dájúdájú"},{"start":73.184,"end":74.99,"text":"Ogo, iyin fun Ọba wa,","marked":"Ògo, ìyìn fún Ọba wa"},{"start":75.44,"end":76.951,"text":"To ra wa pada lọwọ 'ku,","marked":"Tó rà wá padà lọ́wọ́ kú"},{"start":77.401,"end":78.986,"text":"To sọ wa d'ominira lai;","marked":"Tó sọ wá d'òmìnira láì"},{"start":79.436,"end":80.511,"text":"Kabiyesi.","marked":"Kábíyèsí."}],"end":80.511}]}