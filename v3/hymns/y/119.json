{"v":3,"coll":"y","num":119,"id":"hymn_119","title":"GBOGBO aye, gbe Jesu ga","duration":49.187,"voices":{"male":{"file":"y-119-male-v3.m4a","bytes":344167,"sha256":"2e080898f112f912128bb1462dd3c0281f3063de2f886cd5f30535879bcf34c9","duration":49.2},"female":{"file":"y-119-female-v3.m4a","bytes":358815,"sha256":"8c325a31a31142559abc7db7868c587f695b1ae3bd32804b66d5f564a1071110","duration":49.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.343,"text":"GBOGBO ayé, gbe Jesu ga,","marked":"Gbogbo ayé, gbé Jésù ga"},{"start":2.793,"end":4.679,"text":"Angẹl, ẹ wolẹ fun;","marked":"Angẹl, ẹ wólẹ̀ fún"},{"start":5.129,"end":6.351,"text":"Ẹ mu ade Ọba Rẹ wa,","marked":"Ẹ mú adé Ọba Rẹ̀ wá"},{"start":6.801,"end":8.265,"text":"Se l'Ọba awọn Ọba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":8.265},{"key":"2","start":9.215,"lines":[{"start":9.215,"end":11.183,"text":"Ẹ se l'Ọba, ẹyin Martyr,","marked":"Ẹ ṣe l'Ọba, ẹ̀yin Martyr"},{"start":11.633,"end":12.849,"text":"Ti n pe ni pẹpẹ Rẹ;","marked":"Tí ń pè ní pẹpẹ Rẹ"},{"start":13.299,"end":14.864,"text":"Gbe gbongbon-igi Jesse ga,","marked":"Gbé gbongbon-igi Jesse ga"},{"start":15.314,"end":16.829,"text":"Se l'Ọba awọn Ọba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":16.829},{"key":"3","start":17.779,"lines":[{"start":17.779,"end":18.961,"text":"Ẹyin iru-ọmọ Israel,","marked":"Ẹ̀yin iru-ọmọ Israẹl"},{"start":19.411,"end":20.428,"text":"Ti a ti rapada;","marked":"Tí a ti ràpadà"},{"start":20.878,"end":22.389,"text":"Ẹ ki ẹni t'o gba yin la,","marked":"Ẹ kí ẹni t'ó gbà yín là"},{"start":22.839,"end":24.293,"text":"Se l'Ọba awọn Ọba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":24.293},{"key":"4","start":25.243,"lines":[{"start":25.243,"end":26.324,"text":"Gbogbo eniyan ẹlẹsẹ,","marked":"Gbogbo ènìyàn ẹlẹ́sẹ̀"},{"start":26.774,"end":27.815,"text":"Ranti 'banujẹ yin;","marked":"Rántí 'banujẹ yín"},{"start":28.265,"end":29.689,"text":"Ẹ tẹ 'kogun yin s'ẹsẹ Rẹ,","marked":"Ẹ tẹ́ kógun yín s'ẹsẹ̀ Rẹ̀"},{"start":30.139,"end":31.536,"text":"Se l'Ọba awọn Ọba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":31.536},{"key":"5","start":32.486,"lines":[{"start":32.486,"end":33.6,"text":"Ki gbogbo orilẹ-ede,","marked":"Kí gbogbo orilẹ-ede"},{"start":34.05,"end":35.107,"text":"Ni gbogbo agbayé;","marked":"Ní gbogbo agbayé"},{"start":35.557,"end":37.66,"text":"Ki wọn ki, ―Kabiyesilẹ‖,","marked":"Kí wọn kí, ―Kábíyèsílẹ̀‖"},{"start":38.11,"end":39.449,"text":"Se l'Ọba awọn Ọba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":39.449},{"key":"6","start":40.399,"lines":[{"start":40.399,"end":42.215,"text":"A bale pẹl'awọn t'ọrun,","marked":"A balẹ̀ pẹ̀l'àwọn t'ọ̀run"},{"start":42.665,"end":43.749,"text":"Lati ma juba Rẹ;","marked":"Láti má júbà Rẹ"},{"start":44.199,"end":45.825,"text":"K'a ba le jọ jumọ kọrin,","marked":"K'á bá lè jọ jùmọ̀ kọrin"},{"start":46.275,"end":47.638,"text":"Se l'Ọba awọn Ọba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":47.638}]}