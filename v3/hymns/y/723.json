{"v":3,"coll":"y","num":723,"id":"hymn_723","title":"OGO fun Olorun Baba","duration":35.023,"voices":{"male":{"file":"y-723-male-v3.m4a","bytes":244156,"sha256":"8dd5d86d1b2a967fb527d6ce7a5b1b6532c3511cf0473a7322f86a6d1f92d4a5","duration":35.1},"female":{"file":"y-723-female-v3.m4a","bytes":250516,"sha256":"6a23b8e04dfc06f87b32201cdd9b2b8fe26018c2656a58e2eb64ffba40921078","duration":35.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.532,"text":"OGO fun Olorun Baba","marked":"Ògo fún Ọlọ́run Baba"},{"start":1.982,"end":3.24,"text":"Ogo f'Olorun Omo","marked":"Ògo f'Ọlọ́run Ọmọ"},{"start":3.69,"end":5.249,"text":"Ogo fun Olorun Emi","marked":"Ògo fún Ọlọ́run Èmi"},{"start":5.699,"end":7.654,"text":"Jehofa, Metalokan","marked":"Jèhófà, Mẹ́talọ́kan"},{"start":8.104,"end":8.826,"text":"Ogo, Ogo","marked":"Ògo, Ògo"},{"start":9.276,"end":10.786,"text":"B'ayeraye ti nkoja.","marked":"B'ayérayé ti ńkọjá."}],"end":10.786},{"key":"2","start":11.736,"lines":[{"start":11.736,"end":13.083,"text":"Ogo fun Eni t'o fe wa","marked":"Ògo fún Ẹni t'ó fẹ́ wá"},{"start":13.533,"end":15.204,"text":"T'o we abawon wa nu","marked":"T'ó wẹ àbàwọ́n wà nù"},{"start":15.654,"end":17.065,"text":"Ogo fun Eni t'o ra wa","marked":"Ògo fún Ẹni t'ó rà wá"},{"start":17.515,"end":18.694,"text":"T'o mu wa ba On j'Oba","marked":"T'ó mú wa bá Ọn j'Ọba"},{"start":19.144,"end":19.86,"text":"Ogo, ogo","marked":"Ògo, ògo"},{"start":20.31,"end":21.786,"text":"Fun Od'agutan t'a pa.","marked":"Fún Ọ̀d'àgùtàn t'á pa."}],"end":21.786},{"key":"3","start":22.736,"lines":[{"start":22.736,"end":24.651,"text":"'Ogo, bukun, iyin laelae","marked":"ògo, bùkún, ìyìn láéláé"},{"start":25.101,"end":26.473,"text":"L'awon ogun orun nko","marked":"L'àwọn ogun ọ̀run ńkọ́"},{"start":26.923,"end":29.065,"text":"'Ola, oro, ipa, 'joba!","marked":"ọlá, ọ̀rọ̀, ipá, jọba!"},{"start":29.515,"end":30.581,"text":"L'awon eda fi nyin I,","marked":"L'àwọn ẹ̀dá fi yín I"},{"start":31.031,"end":31.759,"text":"Ogo, ogo,","marked":"Ògo, ògo"},{"start":32.209,"end":33.474,"text":"Fun Oba awon Oba.","marked":"Fún Ọba àwọn Ọba."}],"end":33.474}]}