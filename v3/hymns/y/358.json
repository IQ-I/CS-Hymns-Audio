{"v":3,"coll":"y","num":358,"id":"hymn_358","title":"BABA to da orun meje","duration":64.248,"voices":{"male":{"file":"y-358-male.m4a","bytes":452116,"sha256":"7384d44e4e57dc8e356d248e8be130d16914dc5cb243a5164592d1c1148592ef","duration":64.3},"female":{"file":"y-358-female.m4a","bytes":469907,"sha256":"d48e2e517ef4508e50b3fa5481ca66f31e448b56200588c3d4ea82b5ddd1a31c","duration":64.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.672,"text":"BABA to da orun meje","marked":"Bàbá tó dá ọ̀run méje"},{"start":2.052,"end":3.39,"text":"Ati 'le meje pelu","marked":"Àti 'lé méje pẹ̀lú"},{"start":3.77,"end":5.484,"text":"Aiye lo se ekedogun","marked":"Àìyẹ́ ló ṣe ẹ̀kẹ́dógún"},{"start":5.864,"end":7.322,"text":"Iyin ni f'oruko Re.","marked":"Ìyìn ni f'orúkọ Rẹ̀."}],"end":7.322},{"key":"CHORUS","start":8.272,"lines":[{"start":8.272,"end":9.586,"text":"Ijinle loro na","marked":"Ìjìnlẹ̀ lọ̀rọ̀ ná"},{"start":9.966,"end":11.135,"text":"Awamaridi si ni,","marked":"Àwámáridì sì ni"},{"start":11.515,"end":12.894,"text":"Ijinle loro na","marked":"Ìjìnlẹ̀ lọ̀rọ̀ ná"},{"start":13.274,"end":14.619,"text":"Awamaridi si ni.","marked":"Àwámáridì sì ni."}],"end":14.619},{"key":"2","start":15.569,"lines":[{"start":15.569,"end":17.317,"text":"Orun, Osupa, Irawo","marked":"Ọ̀run, Òṣùpá, Ìràwọ̀"},{"start":17.697,"end":19.172,"text":"Awon ni 'mole aiye","marked":"Àwọn ni 'mọ́lẹ̀ aiye"},{"start":19.552,"end":20.93,"text":"Okuta Oniyebiye","marked":"Òkúta Oníyebíye"},{"start":21.31,"end":22.604,"text":"Awon ni 'mole 'sale.","marked":"Àwọn ni 'mọ́lẹ̀ 'sàlẹ̀."}],"end":22.604},{"key":"3","start":23.554,"lines":[{"start":23.554,"end":24.779,"text":"Abo Oluwa Onike","marked":"Abo Olúwa Onike"},{"start":25.159,"end":26.444,"text":"L'awa Egbe bora mo","marked":"L'áwá Ẹgbẹ́ bora mọ́"},{"start":26.824,"end":28.366,"text":"Ko s'ohun 'bi to le se wa","marked":"Kò s'óhun 'bí tó lè ṣe wá"},{"start":28.746,"end":29.838,"text":"Lagbara Metalokan.","marked":"Lágbára Mẹ́talọ́kan."}],"end":29.838},{"key":"4","start":30.788,"lines":[{"start":30.788,"end":32.05,"text":"Eni loyun a bimo la","marked":"Ẹní lóyún á bímọ lá"},{"start":32.43,"end":33.93,"text":"Agan a t'owo b'osun","marked":"Àgàn a t'ọwọ́ b'osùn"},{"start":34.31,"end":35.602,"text":"Olomo ko ni padanu","marked":"Ọlọ́mọ kò ní pàdánù"},{"start":35.982,"end":37.465,"text":"Iku ko ri wa gbe se.","marked":"Ikú kọ́ rí wa gbé ṣe."}],"end":37.465},{"key":"5","start":38.415,"lines":[{"start":38.415,"end":40.028,"text":"Ko s'eniti nri 'di okun","marked":"Kò s'énítì ńrí 'di òkun"},{"start":40.408,"end":41.792,"text":"A ki nri 'di olosa","marked":"A kì ńrí 'di ọlọ́sà"},{"start":42.172,"end":44.36,"text":"Baba to da orun on aiye","marked":"Bàbá tó dá ọ̀run ọ́n aiye"},{"start":44.74,"end":46.35,"text":"Ma je k'aiye r'idi mi.","marked":"Má jẹ k'áíyé r'ìdì mi."}],"end":46.35},{"key":"6","start":47.3,"lines":[{"start":47.3,"end":48.83,"text":"Awon Agbara Emi meje","marked":"Àwọn Agbára Ẹ̀mí méje"},{"start":49.21,"end":50.569,"text":"Ta fi wo HOLY MICHAEL","marked":"Ta fi wo Holy Michael"},{"start":50.949,"end":52.482,"text":"To si fi segun Lusifa","marked":"Tó sì fi ṣẹ́gun Lúsífà"},{"start":52.862,"end":54.186,"text":"Lojo ogun Olorun.","marked":"Lọ́jọ́ ogun Ọlọ́run."}],"end":54.186},{"key":"7","start":55.136,"lines":[{"start":55.136,"end":56.918,"text":"Baba, Omo, Emi Mimo","marked":"Bàbá, Ọmọ, Ẹ̀mí Mímọ́́"},{"start":57.298,"end":59.028,"text":"Metalokan to gunwa","marked":"Mẹ́talọ́kan tó gúnwà"},{"start":59.408,"end":60.949,"text":"Jowo ko gbo adura wa,","marked":"Jọ̀wọ́ kò gbọ́ àdúrà wa"},{"start":61.329,"end":62.699,"text":"Larin Egbe Serafu.","marked":"Lárin Ẹgbẹ́ Séráfù."}],"end":62.699}]}