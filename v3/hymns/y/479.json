{"v":3,"coll":"y","num":479,"id":"hymn_479","title":"ANU Re, Oluwa, l'awa n toro","duration":77.764,"voices":{"male":{"file":"y-479-male-v3.m4a","bytes":547102,"sha256":"5ec25f5de7988bc4706c75253be27426131ed1b33187b811b65470ce85904390","duration":77.8},"female":{"file":"y-479-female-v3.m4a","bytes":556696,"sha256":"c1c2dceae704f2c27eb259fe299b572e30eb42736dbe5cba2e5861d2dd6b37ac","duration":77.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.274,"text":"ANU Re, Oluwa, l'awa ntoro","marked":"Àánú Rẹ, Olúwa, l'àwa ńtọrọ"},{"start":2.724,"end":3.714,"text":"Ro jo Re le wa","marked":"Rò jọ Rẹ̀ lè wá"},{"start":4.164,"end":6.514,"text":"Eiye ti nfo at'era to nrin 'le","marked":"Èíye tí ńfọ̀ àt'ẹra tó ńrìn lé"},{"start":6.964,"end":8.178,"text":"Nri won lopolopo.","marked":"Nrí wọn lọ́pọ̀lọpọ̀."}],"end":8.178},{"key":"CHORUS","start":9.128,"lines":[{"start":9.128,"end":11.225,"text":"Anu, Anu, Anu Re","marked":"Àánú, Àánú, Àánú Rẹ̀"},{"start":11.675,"end":12.641,"text":"Baba wa orun","marked":"Baba wa ọ̀run"},{"start":13.091,"end":14.177,"text":"L'awa ntoro","marked":"L'àwa ńtọrọ"},{"start":14.627,"end":16.277,"text":"Abiyamo ki gbagbe omo Re","marked":"Abiyamọ kí gbàgbé ọmọ Rẹ̀"},{"start":16.727,"end":17.864,"text":"Jesu ma gbagbe mi.","marked":"Jésù má gbàgbé mi."}],"end":17.864},{"key":"2","start":18.814,"lines":[{"start":18.814,"end":20.565,"text":"Orun l'osan nipa ase Re ni","marked":"Ọ̀run l'ọ̀sán nípa àṣẹ Rẹ̀ ni"},{"start":21.015,"end":22.153,"text":"At'osupa l'oru","marked":"Àt'òṣùpá l'òru"},{"start":22.603,"end":24.417,"text":"Igba ojo at'igba ikore","marked":"Ìgbà ọjọ́ àt'ìgbà ìkórè"},{"start":24.867,"end":25.981,"text":"Lowo re ni nwon wa.","marked":"Lọ́wọ́ rẹ̀ ni wọ́n wà."}],"end":25.981},{"key":"3","start":26.931,"lines":[{"start":26.931,"end":28.939,"text":"Gbati esu at'ese ndode wa","marked":"Gbátí èṣù àt'ẹsẹ̀ ńdọdẹ wá"},{"start":29.389,"end":30.595,"text":"Ikolu won soro","marked":"Ìkọlù wọn sọ̀rọ̀"},{"start":31.045,"end":32.968,"text":"Logo asan arankan ti p'aiya","marked":"Lógo asán àrànkàn ti p'àìyà"},{"start":33.418,"end":34.515,"text":"Oluwa gba wa la.","marked":"Olúwa gbà wá là."}],"end":34.515},{"key":"4","start":35.465,"lines":[{"start":35.465,"end":37.25,"text":"Dafidi ko le gbagbe anu Re","marked":"Dafidi kò lè gbàgbé àánú Rẹ̀"},{"start":37.7,"end":38.698,"text":"Niwaju Golayat,","marked":"Níwájú Golayat"},{"start":39.148,"end":40.804,"text":"Danieli 'nu iho Kiniun","marked":"Daniẹli nu ihò Kiniun"},{"start":41.254,"end":42.641,"text":"lwo lo ns'abo re.","marked":"Ìwọ ló ńṣ'abo rẹ."}],"end":42.641},{"key":"5","start":43.591,"lines":[{"start":43.591,"end":45.285,"text":"lru anu wonyi l'awa ntoro","marked":"Irú àánú wọ̀nyí l'àwa ńtọrọ"},{"start":45.735,"end":46.762,"text":"Ro ojo Re le wa","marked":"Rọ ọjọ́ Rẹ lé wá"},{"start":47.212,"end":48.674,"text":"Larin ota je ki awa ma gba","marked":"Lárin ọ̀tá jẹ́ kí àwa má gbà"},{"start":49.124,"end":50.161,"text":"Fun iyin ogo Re.","marked":"Fún ìyìn ògo Rẹ."}],"end":50.161},{"key":"6","start":51.111,"lines":[{"start":51.111,"end":52.899,"text":"Anu bi Batimeu afoju","marked":"Àánú bí Batimeu afọ́jú"},{"start":53.349,"end":54.699,"text":"L'a ntoro lodo Re","marked":"L'á ńtọrọ lọ́dọ̀ Rẹ"},{"start":55.149,"end":56.672,"text":"Ati gbogbo awon alailera","marked":"Àti gbogbo àwọn aláìlera"},{"start":57.122,"end":58.338,"text":"Nwonri anu Re gba.","marked":"Ǹwọ̀nrí àánú Rẹ̀ gbà."}],"end":58.338},{"key":"7","start":59.288,"lines":[{"start":59.288,"end":61.189,"text":"Ayaba Esita ko le gbagbe","marked":"Ayaba Eṣita kò lè gbàgbé"},{"start":61.639,"end":62.888,"text":"Lasiko 'damu Re","marked":"Lásìkò dàmú Rẹ̀"},{"start":63.338,"end":64.935,"text":"Adura lo fi segun ota re","marked":"Àdúrà ló fi ṣẹ́gun ọ̀tá rẹ̀"},{"start":65.385,"end":66.632,"text":"Olorun lo ja fun.","marked":"Ọlọ́run ló jà fún."}],"end":66.632},{"key":"8","start":67.582,"lines":[{"start":67.582,"end":69.547,"text":"Ota ile ko le se o nibi","marked":"Ọ̀tá ilé kò lè ṣe ọ́ níbi"},{"start":69.997,"end":71.335,"text":"Gbeke re le Jesu","marked":"Gbẹ́kẹ̀ rẹ̀ lé Jésù"},{"start":71.785,"end":74.198,"text":"Aje, oso ati alawirin","marked":"Ajé, ọ̀ṣọ́ àti aláwìrìn"},{"start":74.648,"end":76.215,"text":"Nwon npete l'asan ni.","marked":"Wọ́n ńpète l'asán ni."}],"end":76.215}]}