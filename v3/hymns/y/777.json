{"v":3,"coll":"y","num":777,"id":"hymn_777","title":"JESU Olori Egbe wa","duration":56.127,"voices":{"male":{"file":"y-777-male-v3.m4a","bytes":390614,"sha256":"e8e6d74f4a2d747b95cf8f2e193e6b460ec62de9e5190049b7f6bcc5bb8053b0","duration":56.2},"female":{"file":"y-777-female-v3.m4a","bytes":404532,"sha256":"b30e26ac1c7b8c312693cbc6da20ef289de3f037ef4fb02272e09ef4e930a662","duration":56.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.653,"text":"JESU Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":2.103,"end":3.492,"text":"Bukun wa k'awa to lo","marked":"Bùkún wa k'àwa tó lọ"},{"start":3.942,"end":5.227,"text":"Baba Olorisun gbogbo","marked":"Baba Olórísun gbogbo"},{"start":5.677,"end":7.093,"text":"Je ka ri O larin wa.","marked":"Jẹ́ ká rí Ó lárin wa."}],"end":7.093},{"key":"CHORUS","start":8.043,"lines":[{"start":8.043,"end":11.276,"text":"Jah Jehovah! Jah Jehovah! Kabiyesi","marked":"Jah Jehovah! Jah Jehovah! Kábìyèsí"},{"start":11.726,"end":12.406,"text":"Oba wa (6 times)","marked":"Ọba wa"}],"end":12.406},{"key":"2","start":13.356,"lines":[{"start":13.356,"end":14.891,"text":"Jọwọ Jesu awa mbẹ Ọ,","marked":"Jọ̀wọ́ Jésù àwa mbẹ́ Ọ"},{"start":15.341,"end":16.972,"text":"K'a ma ri agbako ayé;","marked":"K'á má rí àgbáko ayé"},{"start":17.422,"end":19.518,"text":"Ka ri'se, k'ọja k'o ta,","marked":"Ká rí'ṣẹ, k'ọjá k'ó ta"},{"start":19.968,"end":21.591,"text":"K'ọmọ Rẹ ma rahun mọ.","marked":"K'ọmọ Rẹ̀ má ráhùn mọ́."}],"end":21.591},{"key":"3","start":22.541,"lines":[{"start":22.541,"end":24.16,"text":"Sure fun wa l'ọjọ ayé wa,","marked":"Súre fún wa l'ọjọ́ ayé wa"},{"start":24.61,"end":26.296,"text":"K'ebi alẹ ma pa wa;","marked":"K'ebi alẹ́ má pa wá"},{"start":26.746,"end":28.05,"text":"K'ẹnikẹni mase rahun;","marked":"K'ẹnikẹ́ni máṣe ráhùn"},{"start":28.5,"end":29.781,"text":"M'ẹsẹ Ẹgbẹ wa duro.","marked":"M'ẹsẹ̀ Ẹgbẹ́ wa dúró."}],"end":29.781},{"key":"4","start":30.731,"lines":[{"start":30.731,"end":32.177,"text":"Ma je ki fitila re ku,","marked":"Má jẹ́ kí fìtílà rẹ kú"},{"start":32.627,"end":33.755,"text":"Larin Egbe Serafu","marked":"Lárin Ẹgbẹ́ Séráfù"},{"start":34.205,"end":35.684,"text":"Gege bi Serafu t'orun","marked":"Gẹ́gẹ́ bí Séráfù t'ọ̀run"},{"start":36.134,"end":37.429,"text":"Ki gbogbo wa jo yin O.","marked":"Kí gbogbo wa jọ yín Ọ."}],"end":37.429},{"key":"5","start":38.379,"lines":[{"start":38.379,"end":39.96,"text":"Rant' ẹgbẹ t'o wa l'okere,","marked":"Rant ẹgbẹ́ t'ó wà l'òkèrè"},{"start":40.41,"end":41.608,"text":"Fun wọn l'okun ilera;","marked":"Fún wọn l'okùn ìlera"},{"start":42.058,"end":44.548,"text":"Ajẹ, oso ko ma ri wọn,","marked":"Àjẹ́, ọ̀ṣọ́ kò má rí wọn"},{"start":44.998,"end":46.545,"text":"Iwọ lo n s'Alabo wọn.","marked":"Ìwọ ló ń s'Alábọ́ wọn."}],"end":46.545},{"key":"6","start":47.495,"lines":[{"start":47.495,"end":49.197,"text":"Jehovah Jireh Ọba wa,","marked":"Jehovah Jireh Ọba wa"},{"start":49.647,"end":51.076,"text":"Jehovah Nissi Baba,","marked":"Jehovah Nissi Baba"},{"start":51.526,"end":52.583,"text":"Jehovah Shalom,","marked":"Jehovah Shalom"},{"start":53.033,"end":54.578,"text":"S'amọna wa lọjọ 'ku.","marked":"S'amọ̀nà wà lọ́jọ́ kú."}],"end":54.578}]}