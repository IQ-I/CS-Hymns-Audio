{"v":3,"coll":"y","num":349,"id":"hymn_349","title":"O ti lo, Awosanma","duration":95.133,"voices":{"male":{"file":"y-349-male-v3.m4a","bytes":694053,"sha256":"582286b0385541e74138f4b7df2a620dee6e3d804863276ea3f12ac369ecb747","duration":95.2},"female":{"file":"y-349-female-v3.m4a","bytes":719804,"sha256":"c2c82db40b1e4b522a9ba5f2c3e67e7faa62626fdd9b750bed3e8e99044d6128","duration":95.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.77,"text":"O ti lọ, Awọsanma,","marked":"Ó ti lọ, Àwọsánmà"},{"start":2.22,"end":3.404,"text":"Ti gba kuro loju wa,","marked":"Ti gbà kúrò lójú wa"},{"start":3.854,"end":5.269,"text":"Soke ọrun nibi ti,","marked":"Sókè ọ̀run níbi tí"},{"start":5.719,"end":6.862,"text":"Oju wa ko le tẹle;","marked":"Ojú wa kò le tẹ̀lé"},{"start":7.312,"end":8.755,"text":"O ti kuro l'ayé yi,","marked":"Ó ti kúrò l'ayé yí"},{"start":9.205,"end":10.373,"text":"O ti de ibi mimọ,","marked":"Ó ti dé ibi mímọ́"},{"start":10.823,"end":12.248,"text":"Lala at'irora tan","marked":"Lálà àt'ìrora tán"},{"start":12.698,"end":14.34,"text":"Ija tan, o ti sẹgun.","marked":"Ìjà tán, ó ti sẹ́gun."}],"end":14.34},{"key":"2","start":15.29,"lines":[{"start":15.29,"end":17.235,"text":"O ti lọ, Awa si wa,","marked":"Ó ti lọ, Àwa sì wá"},{"start":17.685,"end":18.882,"text":"L'ayé ẹsẹ at'iku;","marked":"L'ayé ẹsẹ̀ àt'ikú"},{"start":19.332,"end":20.577,"text":"A ni 'sẹ lati se fun,","marked":"A ní 'sẹ láti ṣe fún"},{"start":21.027,"end":22.552,"text":"L'ayé t'o ti fi silẹ;","marked":"L'ayé t'ó ti fi sílẹ̀"},{"start":23.002,"end":24.417,"text":"K'a si tẹle ọna Rẹ:","marked":"K'á sì tẹ̀lé ọ̀nà Rẹ"},{"start":24.867,"end":26.204,"text":"K'a tẹle tọkantọkan,","marked":"K'á tẹ̀lé tọkàntọkàn"},{"start":26.654,"end":28.23,"text":"K'a s'ọta Rẹ di ọrẹ,","marked":"K'á s'ọ̀tá Rẹ di ọ̀rẹ́"},{"start":28.68,"end":30.481,"text":"K'a fi Kristi han n'iwa wa.","marked":"K'á fi Kristi hàn n'ìwà wa."}],"end":30.481},{"key":"3","start":31.431,"lines":[{"start":31.431,"end":33.218,"text":"O ti lọ, Oun ti wi pé,","marked":"Ó ti lọ, Òun ti wí pé"},{"start":33.668,"end":34.808,"text":"O dara ki Emi lọ,‖","marked":"Ó dára kí Èmi lọ,‖"},{"start":35.258,"end":36.656,"text":"Ni ara sa l'o ya wa:","marked":"Ní ara sá l'ó yà wá"},{"start":37.106,"end":38.516,"text":"Sugbọn or'ọfẹ Rẹ wa:","marked":"Sùgbọ́n or'ọ̀fẹ́ Rẹ wà"},{"start":38.966,"end":40.155,"text":"Oun ni awa ko ri mọ,","marked":"Òun ni àwa kò rí mọ́"},{"start":40.605,"end":41.654,"text":"A ni Olutunu re,","marked":"A ní Olùtùnú rẹ̀"},{"start":42.104,"end":43.301,"text":"Ẹmi Rẹ si jẹ tiwa,","marked":"Ẹ̀mí Rẹ̀ sì jẹ́ tiwa"},{"start":43.751,"end":45.501,"text":"Oun n s'agbara wa d'ọtun.","marked":"Òun ń s'agbára wa d'ọ̀tún."}],"end":45.501},{"key":"4","start":46.451,"lines":[{"start":46.451,"end":48.622,"text":"O ti lọ, L'ọna kanna,","marked":"Ó ti lọ, L'ọ́nà kànnà"},{"start":49.072,"end":50.566,"text":"L'o yẹ k'Ijọ Rẹ ma lo:","marked":"L'ó yẹ k'Ìjọ Rẹ má lọ"},{"start":51.016,"end":52.347,"text":"f K'a gbagbe ohun ẹhin,","marked":"f K'á gbàgbé ohun ẹ̀hìn"},{"start":52.797,"end":54.166,"text":"K'a si ma tẹ siwaju,","marked":"K'á sì má tẹ̀ síwájú"},{"start":54.616,"end":55.929,"text":"Ọrọ Rẹ ni 'mọlẹ wa,","marked":"Ọ̀rọ̀ Rẹ ni 'mọlẹ wá"},{"start":56.379,"end":57.788,"text":"Titi de opin ayé,","marked":"Títí dé òpin ayé"},{"start":58.238,"end":59.369,"text":"Nibi ti otọ Rẹ wa,","marked":"Níbi tí òtọ̀ Rẹ̀ wà"},{"start":59.819,"end":61.363,"text":"Y'o pese fun alaini.","marked":"Y'ó pèsè fún aláìní."}],"end":61.363},{"key":"5","start":62.313,"lines":[{"start":62.313,"end":64.234,"text":"O ti lọ, lẹkan si i,","marked":"Ó ti lọ, lẹ́kàn sí i"},{"start":64.684,"end":65.966,"text":"A o tun f'oju wa ri,","marked":"A ó tún f'ojú wa rí"},{"start":66.416,"end":68.008,"text":"f O wa bakan naa l'ọrun,","marked":"f Ó wà bákan náà l'ọ̀run"},{"start":68.458,"end":69.918,"text":"Gẹgẹ b'o ti wa l'ayé:","marked":"Gẹ́gẹ́ b'ó ti wà l'ayé"},{"start":70.368,"end":72.072,"text":"N'nu 'bugbe t'o wa nibẹ,","marked":"N'nú bùgbé t'ó wà níbẹ̀"},{"start":72.522,"end":74.049,"text":"Y'o pese aye fun wa,","marked":"Y'ó pèsè ayé fún wa"},{"start":74.499,"end":75.985,"text":"Ninu ayé ti mbọ wa,","marked":"Nínú ayé tí mbọ̀ wá"},{"start":76.435,"end":77.782,"text":"A o j'ọkan pẹlu Rẹ.","marked":"A ò j'ọkàn pẹ̀lú Rẹ̀."}],"end":77.782},{"key":"6","start":78.732,"lines":[{"start":78.732,"end":80.666,"text":"O ti lọ, Fun ire wa,","marked":"Ó ti lọ, Fún ìre wa"},{"start":81.116,"end":82.306,"text":"Ẹ jẹ ki a duro de;","marked":"Ẹ jẹ́ kí a dúró dé"},{"start":82.756,"end":84.466,"text":"O jinde, ko si nihin,","marked":"Ó jíǹde, kò sì níhìn"},{"start":84.916,"end":86.41,"text":"O ti goke re ọrun;","marked":"Ó ti gòkè rẹ ọ̀run"},{"start":86.86,"end":88.212,"text":"Jẹ k'a gb'ọkan wa soke,","marked":"Jẹ́ k'á gb'ọkàn wá sókè"},{"start":88.662,"end":90.21,"text":"Sibi ti Jesu ti lọ,","marked":"Síbi tí Jésù ti lọ"},{"start":90.66,"end":91.771,"text":"Si ọdọ Ọlọrun wa,","marked":"Sí ọ̀dọ̀ Ọlọ́run wa"},{"start":92.221,"end":93.585,"text":"Nibẹ l'alafia wa.","marked":"Níbẹ̀ l'àlàáfíà wà."}],"end":93.585}]}