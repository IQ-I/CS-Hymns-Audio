{"v":3,"coll":"y","num":188,"id":"hymn_188","title":"Yo eyin onigbagbo","duration":73.987,"voices":{"male":{"file":"y-188-male-v3.m4a","bytes":522934,"sha256":"8a494881e65da2fc8e22964410c8f28410552dd1a979d0ff82513e20feb6ff6c","duration":74.0},"female":{"file":"y-188-female-v3.m4a","bytes":542129,"sha256":"1773e64ba2558e1175645f71401ac9c1195a3e35ea5b86bf3612779cdcf68a7d","duration":74.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.845,"text":"Yọ ẹyin onigbagbọ,","marked":"Yọ ẹ̀yin onígbàgbọ́"},{"start":2.295,"end":3.462,"text":"Jẹ ki 'mọlẹ yin tan;","marked":"Jẹ́ kí 'mọlẹ yín tán"},{"start":3.912,"end":5.102,"text":"Igba alẹ mbọ tete,","marked":"Ìgbà alẹ́ mbọ́ tètè"},{"start":5.552,"end":6.77,"text":"Oru si fẹrẹ de,","marked":"Òru sì fẹ́rẹ̀ dé"},{"start":7.22,"end":8.522,"text":"Ọkọ Iyawo dide,","marked":"Ọkọ Ìyàwó dìde"},{"start":8.972,"end":10.155,"text":"O fẹrẹ sunmọ'le","marked":"Ó fẹ̀rẹ̀ súnmọ́'lé"},{"start":10.605,"end":12.367,"text":"Dide, gbadura, sọra,","marked":"Dìde, gbàdúrà, sọ́ra"},{"start":12.817,"end":14.14,"text":"L'oru n'igbe y'o ta.","marked":"L'òru n'ìgbẹ́ y'ó ta."}],"end":14.14},{"key":"2","start":15.09,"lines":[{"start":15.09,"end":16.435,"text":"Ẹ bẹ fitila yin wo,","marked":"Ẹ bẹ fìtílà yín wò"},{"start":16.885,"end":17.983,"text":"F'ororo sinu wọn;","marked":"F'òróró sínú wọn"},{"start":18.433,"end":19.74,"text":"Ẹ duro de 'gbala yin;","marked":"Ẹ dúró de gbàlà yín"},{"start":20.19,"end":21.496,"text":"Ipari 'sẹ ayé;","marked":"Ìparí 'sẹ ayé"},{"start":21.946,"end":23.172,"text":"Awọn olusọ ẹ wi pé,","marked":"Àwọn olùsọ́ ẹ wí pé"},{"start":23.622,"end":24.79,"text":"Ọkọ 'yawo de tan;","marked":"Ọkọ̀ yàwó dé tán"},{"start":25.24,"end":27.222,"text":"Ẹ pade rẹ, b'O ti mbọ;","marked":"Ẹ pàdé rẹ̀, b'Ó ti mbọ̀"},{"start":27.672,"end":28.476,"text":"Pẹlu orin iyin.","marked":"Pẹ̀lú orin ìyìn."}],"end":28.476},{"key":"3","start":29.426,"lines":[{"start":29.426,"end":30.456,"text":"Ẹyin wundia mimọ,","marked":"Ẹ̀yin wúńdíá mímọ́"},{"start":30.906,"end":32.136,"text":"Gbe ohun yin soke,","marked":"Gbé ohùn yín sókè"},{"start":32.586,"end":33.895,"text":"Titi n'nu orin ayọ,","marked":"Títí n'nú orin ayọ̀"},{"start":34.345,"end":35.742,"text":"Pẹlu awọn Angẹl,","marked":"Pẹ̀lú àwọn Angẹl"},{"start":36.192,"end":37.377,"text":"Ounjẹ iyawo se tan,","marked":"Oúnjẹ ìyàwó ṣe tán"},{"start":37.827,"end":39.017,"text":"'Lẹkun naa si silẹ,","marked":"'Lẹkun náà sì sílẹ̀"},{"start":39.467,"end":41.148,"text":"Dide, arole ogo,","marked":"Dìde, àrọ̀lẹ ògo"},{"start":41.598,"end":42.8,"text":"Ọkọ Iyawo mbọ.","marked":"Ọkọ Ìyàwó mbọ́."}],"end":42.8},{"key":"4","start":43.75,"lines":[{"start":43.75,"end":44.903,"text":"Ẹyin ti ẹ fi suru,","marked":"Ẹ̀yin tí ẹ fi sùrù"},{"start":45.353,"end":46.684,"text":"Ru agbelebu yin,","marked":"Rú àgbélébùú yín"},{"start":47.134,"end":48.86,"text":"Ẹ o si j'ọba lailai,","marked":"Ẹ ó sì j'ọba láéláé"},{"start":49.31,"end":50.459,"text":"'Gba ti'pọnju ba tan;","marked":"gbà tí'pọ́njú bá tán"},{"start":50.909,"end":52.361,"text":"Yi itẹ ogo Rẹ ka,","marked":"Yí ìtẹ́ ògo Rẹ ká"},{"start":52.811,"end":54.022,"text":"Ẹ o r'Ọd' aguntan,","marked":"Ẹ ò r'Ọd' àgùntàn"},{"start":54.472,"end":55.727,"text":"Ẹ o f' ade ogo yin,","marked":"Ẹ ò f adé ògo yín"},{"start":56.177,"end":57.425,"text":"Lelẹ niwaju Rẹ.","marked":"Lélẹ̀ níwájú Rẹ."}],"end":57.425},{"key":"5","start":58.375,"lines":[{"start":58.375,"end":60.476,"text":"Jesu, 'Wọ ireti wa,","marked":"Jésù, 'Wọ ìrètí wa"},{"start":60.926,"end":62.297,"text":"F'ara Rẹ han fun wa;","marked":"F'ara Rẹ hàn fún wa"},{"start":62.747,"end":64.267,"text":"'Wọ Orun t'a ti ń reti,","marked":"'Wọ Ọ̀run t'á ti ń retí"},{"start":64.717,"end":65.898,"text":"Ran s'ori ilẹ wa","marked":"Rán s'orí ilẹ̀ wa"},{"start":66.348,"end":67.488,"text":"A gbe ọwọ wa s'oke,","marked":"A gbé ọwọ́ wa s'ókè"},{"start":67.938,"end":69.035,"text":"Oluwa jẹ k'a ri,","marked":"Olúwa jẹ́ k'á rí"},{"start":69.485,"end":70.723,"text":"Ọjọ 'rapada ayé,","marked":"Ọjọ́ ràpadà ayé"},{"start":71.173,"end":72.438,"text":"T'o mu wa d'ọdọ Rẹ.","marked":"T'ó mú wa d'ọ̀dọ̀ Rẹ."}],"end":72.438}]}