{"v":3,"coll":"y","num":398,"id":"hymn_398","title":"JESU, oro Re ye","duration":45.38,"voices":{"male":{"file":"y-398-male-v3.m4a","bytes":304324,"sha256":"7ac3937fd87ac8d9d495379c55f907771e11cbe84241e8bba3ff3328fa7e46aa","duration":45.4},"female":{"file":"y-398-female-v3.m4a","bytes":318227,"sha256":"d491c88e5e4a7f1f2a0105a69df5352573321401e847f71fb7d7ff592e57c24e","duration":45.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.936,"text":"Jesu, Ọrọ Rẹ ye,","marked":"Jésù, Ọ̀rọ̀ Rẹ̀ yẹ"},{"start":2.386,"end":3.752,"text":"O si n tọ 'sisẹ wa;","marked":"Ó sì ń tọ́ 'sisẹ wa"},{"start":4.202,"end":5.533,"text":"Ẹni t'o ba gbagbọ,","marked":"Ẹni t'ó bá gbàgbọ́"},{"start":5.983,"end":7.404,"text":"Y'o l'ayọ oun 'mọlẹ.","marked":"Y'ó l'ayọ̀ òun 'mọlẹ."}],"end":7.404},{"key":"2","start":8.354,"lines":[{"start":8.354,"end":9.48,"text":"Nigb' ọta sunmọ wa,","marked":"Nígb ọ̀tá súnmọ́ wa"},{"start":9.93,"end":11.01,"text":"Ọrọ Rẹ l' odi wa,","marked":"Ọ̀rọ̀ Rẹ̀ l odi wá"},{"start":11.46,"end":12.511,"text":"Ọrọ itunu ni,","marked":"Ọ̀rọ̀ ìtùnú ni"},{"start":12.961,"end":14.263,"text":"Ikọ igbala ni.","marked":"Ikọ̀ ìgbàlà ni."}],"end":14.263},{"key":"3","start":15.213,"lines":[{"start":15.213,"end":16.439,"text":"B'igbi at'okunkun","marked":"B'ìgbì àt'òkùnkùn"},{"start":16.889,"end":17.972,"text":"Tile bo wa mole","marked":"Tilẹ̀ bọ̀ wá mọ́lẹ̀"},{"start":18.422,"end":19.908,"text":"Mole re y'o to wa","marked":"Mọ́lẹ̀ rẹ̀ y'ó tó wá"},{"start":20.358,"end":21.643,"text":"Y'o si dabobo wa.","marked":"Y'ó sì dàbòbò wá."}],"end":21.643},{"key":"4","start":22.593,"lines":[{"start":22.593,"end":23.891,"text":"Tani le sọ ayọ,","marked":"Tani lè sọ ayọ̀"},{"start":24.341,"end":25.454,"text":"T'o le ka isura,","marked":"T'ó lè ka ìṣúra"},{"start":25.904,"end":27.076,"text":"Ti ọrọ Rẹ n fi fun","marked":"Tí ọ̀rọ̀ Rẹ̀ ń fi fún"},{"start":27.526,"end":28.451,"text":"Ọkan onirẹlẹ?","marked":"Ọkàn onírẹ̀lẹ̀?"}],"end":28.451},{"key":"5","start":29.401,"lines":[{"start":29.401,"end":31.071,"text":"Ọrọ anu, o n fi,","marked":"Ọ̀rọ̀ àánú, ó ń fi"},{"start":31.521,"end":32.662,"text":"'Lera fun alaye;","marked":"lera fún àlàyé"},{"start":33.112,"end":34.731,"text":"Ọrọ iye, o n fi;","marked":"Ọ̀rọ̀ ìyè, ó ń fi"},{"start":35.181,"end":36.431,"text":"Itunu f'ẹni n ku.","marked":"Ìtùnú f'ẹni ń kú."}],"end":36.431},{"key":"6","start":37.381,"lines":[{"start":37.381,"end":38.718,"text":"mf Awa iba le mọ,","marked":"mf Àwa ìbá le mọ́"},{"start":39.168,"end":40.688,"text":"Ẹko ti o n kọ'ni,","marked":"Ẹ̀kó tí ó ń kọ́'ni"},{"start":41.138,"end":42.119,"text":"Ki a ba le fẹ Ọ,","marked":"Kí a bá lè fẹ́ Ọ"},{"start":42.569,"end":43.831,"text":"K'a si le sunmọ Ọ.","marked":"K'á sì lè súnmọ́ Ọ."}],"end":43.831}]}