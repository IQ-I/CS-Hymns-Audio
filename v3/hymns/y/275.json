{"v":3,"coll":"y","num":275,"id":"hymn_275","title":"BABA wa orun n pe","duration":38.755,"voices":{"male":{"file":"y-275-male-v3.m4a","bytes":262983,"sha256":"18dc2d39e1785498d0ca0131cf98bf4f49e222b698249c765fa4aba3a86da40a","duration":38.8},"female":{"file":"y-275-female-v3.m4a","bytes":280153,"sha256":"ba13ae64bc8951b3c4f51078afd5361f0f2ee58dba4be97a27726951d872f3b9","duration":38.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.566,"text":"BABA wa ọrun ń pe,","marked":"Baba wa ọ̀run ń pè"},{"start":2.016,"end":3.566,"text":"Kristi ń pe wa sọdọ Rẹ;","marked":"Kristi ń pè wá sọ́dọ̀ Rẹ̀"},{"start":4.016,"end":5.582,"text":"Ọrẹ wa pẹlu wọn o dun,","marked":"Ọrẹ wà pẹ̀lú wọn ó dùn"},{"start":6.032,"end":7.396,"text":"'Dapọ wa y'o s'ọwọn.","marked":"'Dapọ wa y'ó s'ọwọ̀n."}],"end":7.396},{"key":"2","start":8.346,"lines":[{"start":8.346,"end":9.375,"text":"Ọlọrun ń kanu mi;","marked":"Ọlọ́run ń kànú mi"},{"start":9.825,"end":11.007,"text":"O dar'ẹsẹ mi ji,","marked":"Ó dár'ẹ̀sẹ̀ mi jì"},{"start":11.457,"end":12.754,"text":"Olodumare s'ọkan mi,","marked":"Olódùmarè s'ọkàn mi"},{"start":13.204,"end":14.42,"text":"O f'ọgbọn tọ 'pa mi.","marked":"Ó f'ọgbọ́n tọ̀ pa mí."}],"end":14.42},{"key":"3","start":15.37,"lines":[{"start":15.37,"end":16.676,"text":"Ẹbun Rẹ ti pọ to!","marked":"Ẹ̀bùn Rẹ̀ ti pọ̀ tó!"},{"start":17.126,"end":18.116,"text":"O l'ọpọ isura,","marked":"Ó l'ọ̀pọ̀ ìṣúra"},{"start":18.566,"end":20.105,"text":"T'a t'owo Olugbala pin,","marked":"T'á t'ọwọ́ Olùgbàlà pín"},{"start":20.555,"end":21.736,"text":"Ti a f'ẹjẹ rẹ ra!","marked":"Tí a f'ẹ̀jẹ̀ rẹ̀ rà!"}],"end":21.736},{"key":"4","start":22.686,"lines":[{"start":22.686,"end":24.489,"text":"Jesu, Ori 'ye mi","marked":"Jésù, Orí yé mi"},{"start":24.939,"end":26.185,"text":"Mo fi 'bukun fun O","marked":"Mo fi bùkún fún Ọ"},{"start":26.635,"end":27.948,"text":"Alagbawi lodo Baba","marked":"Alágbàwí lọ́dọ̀ Baba"},{"start":28.398,"end":29.638,"text":"Asaju lodo Re.","marked":"Aṣájú lọ́dọ̀ Rẹ."}],"end":29.638},{"key":"5","start":30.588,"lines":[{"start":30.588,"end":31.881,"text":"Ọkan at'ifẹ mi,","marked":"Ọkàn àt'ìfẹ́ mi"},{"start":32.331,"end":33.472,"text":"Ẹ duro jẹ nihin;","marked":"Ẹ dúró jẹ́ níhìn"},{"start":33.922,"end":35.406,"text":"Titi 'dapọ yoo fi kun,","marked":"Títí 'dapọ yóò fi kún"},{"start":35.856,"end":37.206,"text":"L'oke ọrun l'ọhun.","marked":"L'òkè ọ̀run l'ọ̀hún."}],"end":37.206}]}