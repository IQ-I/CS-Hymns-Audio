{"v":3,"coll":"y","num":781,"id":"hymn_781","title":"SURE fun wa loni, Baba orun","duration":49.887,"voices":{"male":{"file":"y-781-male-v3.m4a","bytes":353201,"sha256":"7c980f573fd63f0977faff3e4ab31f387c27201fa34f8e470ce5c40aeb28fc1a","duration":49.9},"female":{"file":"y-781-female-v3.m4a","bytes":368902,"sha256":"b07b5ad80bb12cfd8932f0f7e98032733cde5b2f25ac0d9d3a8a10107cd2eea8","duration":49.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.914,"text":"SURE fun wa loni, Baba wa orun","marked":"Súre fún wa lónì, Baba wa ọ̀run"},{"start":3.364,"end":4.79,"text":"A gboju wa soke si O,","marked":"A gbójú wa sókè sí Ọ"},{"start":5.24,"end":6.632,"text":"Wo to sure f'Abraham","marked":"Wo tó súre f'Abraham"},{"start":7.082,"end":8.0,"text":"baba wa,","marked":"Baba wa"},{"start":8.45,"end":9.662,"text":"Jowo sure fun wa.","marked":"Jọ̀wọ́ súre fún wa."}],"end":9.662},{"key":"CHORUS","start":10.612,"lines":[{"start":10.612,"end":12.115,"text":"Egbe: Alpha ati Omega","marked":"Alpha àti Omega"},{"start":12.565,"end":14.132,"text":"A si okan wa paya fun O,","marked":"A sí ọkàn wa payá fún Ọ"},{"start":14.582,"end":15.998,"text":"Ma je ka lo Iofo.","marked":"Má jẹ́ ká lọ lófo."}],"end":15.998},{"key":"2","start":16.948,"lines":[{"start":16.948,"end":18.584,"text":"Metalokan Mimo Alagbara","marked":"Mẹ́talọ́kan Mímọ́ Alágbára"},{"start":19.034,"end":20.591,"text":"lfe to jinle julo","marked":"Ìfẹ́ tó jinlẹ̀ jùlọ"},{"start":21.041,"end":22.676,"text":"Awamaridi Olodumare","marked":"Àwamaridi Olódùmarè"},{"start":23.126,"end":24.43,"text":"Jo f'ire kari wa.","marked":"Jọ f'ire kárí wa."},{"start":24.88,"end":26.291,"text":"Egbe: Alpha ati Omega...","marked":"Alpha àti Omega"}],"end":26.291},{"key":"3","start":27.241,"lines":[{"start":27.241,"end":29.426,"text":"Awa nke pe O loni, Baba wa,","marked":"Àwa ńké pé Ó lónì, Baba wa"},{"start":29.876,"end":31.045,"text":"Ma je k'omo Re rahun","marked":"Má jẹ́ k'ọmọ Rẹ ráhùn"},{"start":31.495,"end":33.381,"text":"Ko sohun ti jamo lehin ekun","marked":"Kò sọhùn tí jámọ́ lẹ́hìn ẹkún"},{"start":33.831,"end":35.034,"text":"Jowo dabobo wa.","marked":"Jọ̀wọ́ dàbòbò wá."},{"start":35.484,"end":36.843,"text":"Egbe: Alpha ati Omega...","marked":"Alpha àti Omega"}],"end":36.843},{"key":"4","start":37.793,"lines":[{"start":37.793,"end":39.655,"text":"Wo lo m'omi lat'inu apata","marked":"Wò lọ m'omi lát'inú àpáta"},{"start":40.105,"end":41.216,"text":"F'awon enia Re saju","marked":"F'àwọn ẹnìà Rẹ sájú"},{"start":41.666,"end":43.656,"text":"O rojo manna pelu lat'orun","marked":"Ó rojọ́ manna pẹ̀lú lát'ọ̀run"},{"start":44.106,"end":45.418,"text":"Jowo pese fun wa.","marked":"Jọ̀wọ́ pèsè fún wa."},{"start":45.868,"end":47.363,"text":"Egbe: Alpha ati Omega...","marked":"Alpha àti Omega"},{"start":47.813,"end":48.338,"text":"Amin.","marked":"Àmín."}],"end":48.338}]}