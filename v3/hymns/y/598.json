{"v":3,"coll":"y","num":598,"id":"hymn_598","title":"OKAN are ile kan mbe","duration":41.05,"voices":{"male":{"file":"y-598-male-v3.m4a","bytes":288141,"sha256":"d114ee5f89f6ffed66d7289f2ec75eef3bc6f6c30cd88c607b3099ba806b4a8a","duration":41.1},"female":{"file":"y-598-female-v3.m4a","bytes":295367,"sha256":"5655aa84463efd0a3961bc9a987c6af3f16e0681186ba27a14cbdb746bc9e3ad","duration":41.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.776,"text":"ỌKAN arẹ ile kan mbẹ,","marked":"Ọkàn àrẹ ilẹ̀ kan mbẹ́"},{"start":2.226,"end":3.846,"text":"Lọna jinjin s'ayé isẹ;","marked":"Lọ́nà jinjìn s'ayé isẹ́"},{"start":4.296,"end":5.937,"text":"Ile t'ayida ko le de,","marked":"Ilẹ̀ t'àyídá kò lè dé"},{"start":6.387,"end":7.899,"text":"Tani ko fẹ sinmi nibẹ.","marked":"Tani kò fẹ́ sinmi níbẹ̀."}],"end":7.899},{"key":"CHORUS","start":8.849,"lines":[{"start":8.849,"end":10.006,"text":"Duro roju duro mase","marked":"Dúró rọ́jú dúró máṣẹ"},{"start":10.456,"end":11.613,"text":"kun! (2ce) Duro, duro, sa","marked":"kún! Dúró, dúró, sá"},{"start":12.063,"end":13.378,"text":"roju duro mase kun.","marked":"rojú dúró máṣe kún."}],"end":13.378},{"key":"2","start":14.328,"lines":[{"start":14.328,"end":15.643,"text":"Bi wahala bo ọ mọlẹ,","marked":"Bí wàhálà bò ọ́ mọ́lẹ̀"},{"start":16.093,"end":17.529,"text":"B'ipin rẹ layé ba buru,","marked":"B'ípín rẹ̀ layé bá burú"},{"start":17.979,"end":19.566,"text":"W'oke s'ile ibukun na,","marked":"W'òkè s'ilẹ̀ ìbùkún ná"},{"start":20.016,"end":22.021,"text":"Sa rọju, duro mase kun.","marked":"Sá rọ́jú, dúró máṣe kún."}],"end":22.021},{"key":"3","start":22.971,"lines":[{"start":22.971,"end":24.317,"text":"Bi egun ba wa lona re","marked":"Bí ègún bá wà lọ́nà rẹ"},{"start":24.767,"end":26.385,"text":"Ranti ori t'a f 'egun de","marked":"Rántí orí t'á f ègún dé"},{"start":26.835,"end":28.494,"text":"Bi 'banuje bo okan re","marked":"Bí banújẹ́ bo ọkàn rẹ"},{"start":28.944,"end":30.36,"text":"O ti ri be f'Olugbala.","marked":"Ó ti rí bẹ f'Olùgbàlà."}],"end":30.36},{"key":"4","start":31.31,"lines":[{"start":31.31,"end":33.361,"text":"f Ma sisẹ lọ, mase ro pe,","marked":"f Má sisẹ́ lọ, máṣe rò pé"},{"start":33.811,"end":35.113,"text":"A ko gbadura ẹdun rẹ,","marked":"A kò gbàdúrà ẹ̀dùn rẹ̀"},{"start":35.563,"end":37.217,"text":"Ọjọ isinmi mbọ kankan,","marked":"Ọjọ́ ìsinmi mbọ́ kankan"},{"start":37.667,"end":39.501,"text":"Sa rọju duro, mase kun.","marked":"Sá rọ́jú dúró, máṣe kún."}],"end":39.501}]}