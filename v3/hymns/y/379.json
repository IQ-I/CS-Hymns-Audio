{"v":3,"coll":"y","num":379,"id":"hymn_379","title":"WA mi si wa, Emi Mimo","duration":36.854,"voices":{"male":{"file":"y-379-male-v3.m4a","bytes":255171,"sha256":"1183feb029bc78ea907d49d0d6ba7247992dbeb2ef1e3ba7a07a503ccab95c93","duration":36.9},"female":{"file":"y-379-female-v3.m4a","bytes":259901,"sha256":"225e0c84f14a723153d9cbc07fcf0f9c16326cba377ba2734241dead173afc2f","duration":36.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.186,"text":"WA mi si wa, Ẹmi Mimọ ,","marked":"Wá mi sì wá, Ẹ̀mí Mímọ́"},{"start":2.636,"end":4.027,"text":"Tan 'na ọrun si ọkan wa:","marked":"Tan na ọ̀run sí ọkàn wa"},{"start":4.477,"end":5.732,"text":"Ẹmi af'ororo yan 'ni,","marked":"Ẹ̀mí àf'òróró yàn ni"},{"start":6.182,"end":7.707,"text":"Ti f'ẹmi meje Rẹ fun'ni.","marked":"Ti f'ẹ̀mí méje Rẹ fún'ni."}],"end":7.707},{"key":"2","start":8.657,"lines":[{"start":8.657,"end":10.562,"text":"Isẹ nla Rẹ at'oke wa:","marked":"Isẹ́ ńlá Rẹ àt'òkè wá"},{"start":11.012,"end":14.051,"text":"N'itunu, iye, ina ifẹ;","marked":"N'ìtùnú, iye, iná ìfẹ́"},{"start":14.501,"end":16.061,"text":"F'imọlẹ Rẹ igba gbogbo;","marked":"F'ìmọ́lẹ̀ Rẹ ìgbà gbogbo"},{"start":16.511,"end":17.969,"text":"Le okunkun ọkan wa lọ.","marked":"Lé òkùnkùn ọkàn wa lọ."}],"end":17.969},{"key":"3","start":18.919,"lines":[{"start":18.919,"end":20.528,"text":"F'ororo ore-ọfẹ Rẹ,","marked":"F'òróró ore-ọfẹ Rẹ"},{"start":20.978,"end":22.208,"text":"Pa oju eri wa ko dan;","marked":"Pa ojú ẹ̀rí wa kò dán"},{"start":22.658,"end":24.301,"text":"di L'ọta jina s'ibugbe wa,","marked":"di L'ọ̀tá jìnà s'ibùgbé wa"},{"start":24.751,"end":26.435,"text":"Ire n' igbe 'biti 'Wọ ń sọ.","marked":"Ire ń igbe bítí 'Wọ ń sọ."}],"end":26.435},{"key":"4","start":27.385,"lines":[{"start":27.385,"end":28.914,"text":"Kọ wa k'a mọ Baba Ọmọ,","marked":"Kọ́ wá k'á mọ Baba Ọmọ"},{"start":29.364,"end":30.809,"text":"Pẹlu Rẹ l'ọkansoso;","marked":"Pẹ̀lú Rẹ l'ọkànsoso"},{"start":31.259,"end":33.087,"text":"Titi ayé ainipẹkun,","marked":"Títí ayé àìnípẹ̀kun"},{"start":33.537,"end":35.304,"text":"Ni k'eyi ma jẹ orin wa.","marked":"Ní k'èyí má jẹ́ orin wa."}],"end":35.304}]}