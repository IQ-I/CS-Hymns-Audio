{"v":3,"coll":"y","num":383,"id":"hymn_383","title":"EMI Eleda nipa Re","duration":50.056,"voices":{"male":{"file":"y-383-male-v3.m4a","bytes":349224,"sha256":"00719a9161d69dfbf1dc25c1d5165c30f9d2d65200ae15855f0b0c4b8325d155","duration":50.1},"female":{"file":"y-383-female-v3.m4a","bytes":371687,"sha256":"aaeba71d6dc1cad7ee0d676e9c40398adc9efe76f6da15d74134091e2b4fb72a","duration":50.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.07,"text":"EMI Ẹlẹda, nipa Rẹ,","marked":"Ẹ̀mí Ẹlẹda, nípa Rẹ̀"},{"start":2.52,"end":4.014,"text":"L'a f'ipilẹ ayé sọlẹ,","marked":"L'á f'ìpìlẹ̀ ayé sọlẹ̀"},{"start":4.464,"end":6.168,"text":"p Ma sai bẹ gbogbo ọkan wo,","marked":"p Má ṣàì bẹ gbogbo ọkàn wò"},{"start":6.618,"end":8.141,"text":"Fi ayọ Rẹ si ọkan wa;","marked":"Fi ayọ̀ Rẹ sí ọkàn wa"},{"start":8.591,"end":10.259,"text":"Yọ wa nin' ẹsẹ at'egbe,","marked":"Yọ wà nín ẹsẹ̀ àt'ẹgbẹ́"},{"start":10.709,"end":12.039,"text":"K'o fi wa se ibugbe Rẹ.","marked":"K'ó fi wá ṣe ibùgbé Rẹ̀."}],"end":12.039},{"key":"2","start":12.989,"lines":[{"start":12.989,"end":14.375,"text":"Orisun imọlẹ ni Ọ,","marked":"Orísun ìmọ́lẹ̀ ni Ọ"},{"start":14.825,"end":16.358,"text":"Ti Baba ti se ileri;","marked":"Tí Baba ti ṣe ìlérí"},{"start":16.808,"end":17.867,"text":"Iwọ Ina mimọ ọrun,","marked":"Ìwọ Iná mímọ́ ọ̀run"},{"start":18.317,"end":19.937,"text":"Fi 'fẹ ọrun kun ọkan wa;","marked":"Fi 'fẹ ọ̀run kún ọkàn wa"},{"start":20.387,"end":21.646,"text":"Jọ tu ororo mimọ Rẹ,","marked":"Jọ tú òróró mímọ́ Rẹ"},{"start":22.096,"end":23.849,"text":"Sori wa bi a ti ń kọrin.","marked":"Sórí wa bí a ti ń kọrin."}],"end":23.849},{"key":"3","start":24.799,"lines":[{"start":24.799,"end":25.953,"text":"Da opo ore-ofe Re","marked":"Dá ọ̀pọ̀ oore-ọ̀fẹ́ Rẹ"},{"start":26.403,"end":27.861,"text":"Lat'orun sori gbogbo wa","marked":"Lát'ọ̀run sórí gbogbo wa"},{"start":28.311,"end":29.722,"text":"Je k'a gba otito Re gbo","marked":"Jẹ́ k'á gba òtítọ́ Rẹ gbọ́"},{"start":30.172,"end":32.053,"text":"K'a si ma sa ro l'okan wa","marked":"K'á sì má sá rò l'ọkàn wa"},{"start":32.503,"end":33.975,"text":"F'ara Re han wa k'a le ri","marked":"F'ara Rẹ̀ hàn wá k'á lè rí"},{"start":34.425,"end":35.807,"text":"Baba at'Omo ninu Re.","marked":"Baba àt'ọmọ nínú Rẹ̀."}],"end":35.807},{"key":"4","start":36.757,"lines":[{"start":36.757,"end":38.606,"text":"K'a fi ọla ati iyin,","marked":"K'á fi ọlá àti ìyìn"},{"start":39.056,"end":40.23,"text":"Fun Baba Olodumare,","marked":"Fún Baba Olódùmarè"},{"start":40.68,"end":42.406,"text":"K'a yin ọkọ Jesu logo,","marked":"K'á yin ọkọ Jésù lógo"},{"start":42.856,"end":44.352,"text":"Ẹni t'o ku lati gba wa;","marked":"Ẹni t'ó kù láti gbà wá"},{"start":44.802,"end":46.364,"text":"Iyin bakan naa ni fun Ọ,","marked":"Ìyìn bákan náà ni fún Ọ"},{"start":46.814,"end":48.507,"text":"Parakliti Ayérayé.","marked":"Parakliti Ayérayé."}],"end":48.507}]}