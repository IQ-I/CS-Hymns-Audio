{"v":3,"coll":"y","num":776,"id":"hymn_776","title":"E TUN won ko fun mi ki n gbo","duration":45.368,"voices":{"male":{"file":"y-776-male-v3.m4a","bytes":329367,"sha256":"95848c975a29eec2ce64fceb0af771124f559af02c864c5c178a607f985f1bd3","duration":45.4},"female":{"file":"y-776-female-v3.m4a","bytes":331410,"sha256":"6edebe82741fe2e0cd89c5e60280c080ae4f158241d8f9dc3eea89d525f53871","duration":45.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.083,"text":"Ẹ TUN wọn ko fun mi ki n gbọ,","marked":"Ẹ Tún wọn kò fún mi kí n gbọ́"},{"start":2.533,"end":3.562,"text":"Ọrọ 'yanu t'iye!","marked":"Ọ̀rọ̀ yanu t'iye!"},{"start":4.012,"end":5.388,"text":"Jẹ ki n si tun ẹwa wọn ri,","marked":"Jẹ́ kí n sì tún ẹwà wọn rí"},{"start":5.838,"end":7.08,"text":"Ọrọ 'yanu t'iye,","marked":"Ọ̀rọ̀ yanu t'iye"},{"start":7.53,"end":10.074,"text":"Ọrọ iye at'ẹwa ti n ko mi n'igba gbogbo.","marked":"Ọ̀rọ̀ iye àt'ẹwà tí ń kọ́ mi n'ìgbà gbogbo."},{"start":10.524,"end":12.202,"text":"Ọrọ didun! ọrọ 'yanu!","marked":"Ọ̀rọ̀ dídùn! ọ̀rọ̀ yanu!"},{"start":12.652,"end":13.976,"text":"Ọrọ 'yanu t' iye.","marked":"Ọ̀rọ̀ yanu t iye."}],"end":13.976},{"key":"2","start":14.926,"lines":[{"start":14.926,"end":16.618,"text":"Kristi nikan l'o n fi funni,","marked":"Kristi nìkan l'ó ń fi fúnni"},{"start":17.068,"end":18.439,"text":"Ọrọ 'yanu at' iye!","marked":"Ọ̀rọ̀ yanu àt ìyè!"},{"start":18.889,"end":21.024,"text":"Ẹlẹsẹ, gbọ 'pe ifẹ na,","marked":"Ẹlẹ́sẹ̀, gbọ́ pé ìfẹ́ ná"},{"start":21.474,"end":22.821,"text":"Ọrọ 'yanu at'iye!","marked":"Ọ̀rọ̀ yanu àt'ìyè!"},{"start":23.271,"end":26.317,"text":"L'ọfẹ l'a fifun wa, ko le to wa sọrun!","marked":"L'ọ̀fẹ́ l'á fífún wa, kò lè tọ̀ wá sọ́rùn!"},{"start":26.767,"end":28.701,"text":"Ọrọ didun! ọrọ 'yanu.","marked":"Ọ̀rọ̀ dídùn! ọ̀rọ̀ yanu."}],"end":28.701},{"key":"3","start":29.651,"lines":[{"start":29.651,"end":30.729,"text":"Gbe ohun ihinrere na,","marked":"Gbé ohun ìhìnrere ná"},{"start":31.179,"end":32.572,"text":"Ọrọ 'yanu at' iye!","marked":"Ọ̀rọ̀ yanu àt ìyè!"},{"start":33.022,"end":34.382,"text":"F'igbala lọ gbogbo eniyan,","marked":"F'ìgbàlà lọ gbogbo ènìyàn"},{"start":34.832,"end":36.228,"text":"Ọrọ 'yanu at' iye,","marked":"Ọ̀rọ̀ yanu àt iye"},{"start":36.678,"end":39.633,"text":"Jesu Olugbala, wẹ wa mọ titi lai!","marked":"Jésù Olùgbàlà, wẹ̀ wá mọ́ títí láì!"},{"start":40.083,"end":41.896,"text":"Ọrọ didun! ọrọ 'yanu!","marked":"Ọ̀rọ̀ dídùn! ọ̀rọ̀ yanu!"},{"start":42.346,"end":43.819,"text":"Ọrọ 'yanu at' iye.","marked":"Ọ̀rọ̀ yanu àt iye."}],"end":43.819}]}