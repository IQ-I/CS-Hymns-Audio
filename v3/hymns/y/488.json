{"v":3,"coll":"y","num":488,"id":"hymn_488","title":"WO awon t'o wo 'so ala","duration":47.54,"voices":{"male":{"file":"y-488-male-v3.m4a","bytes":341411,"sha256":"3387a537215833e6cf59e34a4325932e1df7c1f0b6d62bb66edf5da7e78c6417","duration":47.6},"female":{"file":"y-488-female-v3.m4a","bytes":347471,"sha256":"17fefbf7e46da474be8402f1addb357540c682fee132475d31da38825fc4e62c","duration":47.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.79,"text":"WO awon t'o wo 'so ala","marked":"Wo àwọn t'ó wó sọ àlá"},{"start":2.24,"end":3.313,"text":"Won duro leti odo","marked":"Wọ́n dúró létí odò"},{"start":3.763,"end":5.758,"text":"Won k'eyin s'aye at'esu","marked":"Wọ́n k'ẹyìn s'ayé àt'èṣù"},{"start":6.208,"end":7.495,"text":"Won ntele Atebomi","marked":"Wọ́n ńtẹ̀lé Àtẹ̀bọmi"},{"start":7.945,"end":9.049,"text":"Won si nreti","marked":"Wọ́n sì ńretí"},{"start":9.499,"end":10.897,"text":"Lati se ase Jesu.","marked":"Láti ṣe àṣẹ Jésù."}],"end":10.897},{"key":"2","start":11.847,"lines":[{"start":11.847,"end":13.183,"text":"Wo bi won ti duro l'eru","marked":"Wo bí wọ́n ti dúró l'ẹ́rù"},{"start":13.633,"end":14.891,"text":"Sugbon pelu ireti","marked":"Ṣùgbọ́n pẹ̀lú ìrètí"},{"start":15.341,"end":16.83,"text":"Won mo pe Olugbala won","marked":"Wọ́n mọ̀ pé Olùgbàlà wọn"},{"start":17.28,"end":19.041,"text":"L'O pase odo lilo","marked":"L'Ó pàṣẹ odò lílò"},{"start":19.491,"end":20.46,"text":"Jordan tutu","marked":"Jordan tútù"},{"start":20.91,"end":22.244,"text":"Sugbon igbagbo gbona.","marked":"Ṣùgbọ́n ìgbàgbọ́ gbóná."}],"end":22.244},{"key":"3","start":23.194,"lines":[{"start":23.194,"end":24.766,"text":"Si wo awon arakunrin","marked":"Sì wo àwọn arákùnrin"},{"start":25.216,"end":26.612,"text":"Egbon won ninu Jesu","marked":"Ẹ̀gbọ́n wọn nínú Jésù"},{"start":27.062,"end":28.616,"text":"Wo bi won ti na' wo ife","marked":"Wo bí wọ́n ti nà wo ìfẹ́"},{"start":29.066,"end":31.824,"text":"Won sa ti dabi won ri, Nisisiyi","marked":"Wọ́n sá ti dàbí wọn rí, Nísísíyì"},{"start":32.274,"end":33.647,"text":"Won ny'ayo idariji.","marked":"Wọ́n ńy'ayọ̀ ìdáríjì."}],"end":33.647},{"key":"4","start":34.597,"lines":[{"start":34.597,"end":36.585,"text":"Lo, tele Olugbala yin","marked":"Lọ, tẹ̀lé Olùgbàlà yín"},{"start":37.035,"end":38.244,"text":"E f'oju igbagbo ri","marked":"Ẹ f'ojú ìgbàgbọ́ rí"},{"start":38.694,"end":41.045,"text":"A! orun si, Emi Baba","marked":"A! ọ̀run sì, Ẹ̀mí Baba"},{"start":41.495,"end":43.135,"text":"Si nke lat'oke wipe","marked":"Sì ńké lát'òkè wípé"},{"start":43.585,"end":44.227,"text":"Awon wonyi","marked":"Àwọn wọ̀nyí"},{"start":44.677,"end":45.991,"text":"Ni ayanfe omo Mi.","marked":"Ní àyànfẹ́ ọmọ Mi."}],"end":45.991}]}