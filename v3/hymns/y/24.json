{"v":3,"coll":"y","num":24,"id":"hymn_24","title":"OLUSO AGUNTAN mi","duration":35.24,"voices":{"male":{"file":"y-24-male-v3.m4a","bytes":233866,"sha256":"6807fc5c483eb6656f24a25469534469623e4d96f08b9481da8d8834abef1fd1","duration":35.3},"female":{"file":"y-24-female-v3.m4a","bytes":246734,"sha256":"ebe5a96ca7af1800e862358128f9c2c20bf3fafbff8167532b78b0df0c8efeeb","duration":35.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.346,"text":"OLUS' AGUNTAN mi,","marked":"Olùṣ Àgùntàn mi"},{"start":1.796,"end":2.812,"text":"Ma bọ mi titi;","marked":"Má bọ̀ mí títí"},{"start":3.262,"end":4.23,"text":"Olus'agutan mi,","marked":"Olùṣ'àgùtàn mi"},{"start":4.68,"end":5.887,"text":"Ma tọ ẹsẹ mi.","marked":"Má tọ ẹsẹ̀ mi."}],"end":5.887},{"key":"2","start":6.837,"lines":[{"start":6.837,"end":8.442,"text":"Di mimu, si tọ mi,","marked":"Di mímú, sì tọ̀ mi"},{"start":8.892,"end":9.896,"text":"Ni ọna hiha;","marked":"Ní ọ̀nà híhá"},{"start":10.346,"end":11.46,"text":"B'O ba wa lọdọ mi,","marked":"B'Ó bá wà lọ́dọ̀ mi"},{"start":11.91,"end":12.981,"text":"Emi ko sina.","marked":"Èmi kò ṣìnà."}],"end":12.981},{"key":"3","start":13.931,"lines":[{"start":13.931,"end":14.949,"text":"Sin mi s'ona orun","marked":"Sìn mí s'ọ̀nà ọ̀run"},{"start":15.399,"end":16.259,"text":"Ni ojojumo","marked":"Ní ojojúmọ́"},{"start":16.709,"end":18.013,"text":"Ma busi 'gbagbo mi","marked":"Má bùsi gbàgbọ́ mi"},{"start":18.463,"end":19.79,"text":"Si mu mi fe O.","marked":"Sì mú mi fẹ́ Ọ."}],"end":19.79},{"key":"4","start":20.74,"lines":[{"start":20.74,"end":22.32,"text":"K'ayo at'alafia","marked":"K'ayọ̀ àt'àlàfíà"},{"start":22.77,"end":23.76,"text":"Ti odo Re wa","marked":"Ti ọ̀dọ̀ Rẹ wá"},{"start":24.21,"end":25.227,"text":"K'iye ainipekun","marked":"K'íyè àìnípẹ̀kun"},{"start":25.677,"end":27.12,"text":"Le je ayo mi.","marked":"Lè jẹ́ ayọ̀ mi."}],"end":27.12},{"key":"5","start":28.07,"lines":[{"start":28.07,"end":29.227,"text":"Ma pese okan mi,","marked":"Má pèsè ọkàn mi"},{"start":29.677,"end":30.47,"text":"Ni ojojumo","marked":"Ní ojojúmọ́"},{"start":30.92,"end":32.148,"text":"Si je k'Angeli Re,","marked":"Sì jẹ́ k'Áńgẹ́lì Rẹ"},{"start":32.598,"end":33.69,"text":"Sin mi lo ile.","marked":"Sìn mí lọ ilẹ̀."}],"end":33.69}]}