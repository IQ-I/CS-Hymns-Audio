{"v":3,"coll":"y","num":151,"id":"hymn_151","title":"JI! ko orin Mose","duration":41.973,"voices":{"male":{"file":"y-151-male-v3.m4a","bytes":289787,"sha256":"5cab105ea3decccd6f4ece9de108069e1d1ffaf25146059d694110df3350b139","duration":42.0},"female":{"file":"y-151-female-v3.m4a","bytes":300660,"sha256":"47f4f36c0f187665b5dab9f627168733071328b99e1570485efc9a12c2f1abde","duration":42.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.298,"text":"JI! Kọ orin Mose,","marked":"Jí! Kọ orin Mósè"},{"start":2.748,"end":3.901,"text":"Ati t'Ọdaguntan;","marked":"Àti t'Ọ̀dàgùntàn"},{"start":4.351,"end":6.026,"text":"Ji gbogbo ọkan at'ahọn,","marked":"Jí gbogbo ọkàn àt'ahọ́n"},{"start":6.476,"end":7.443,"text":"Ki wọn yin oluwa.","marked":"Kí wọ́n yin Olúwa."}],"end":7.443},{"key":"2","start":8.393,"lines":[{"start":8.393,"end":9.505,"text":"Korin ti iku re,","marked":"Kọrin tí ikú rẹ̀"},{"start":9.955,"end":11.181,"text":"Korin ajinde Re,","marked":"Kọrin àjíǹde Rẹ"},{"start":11.631,"end":13.186,"text":"Korin b'o ti mbebe loke","marked":"Kọrin b'ó ti mbẹ̀bẹ̀ lókè"},{"start":13.636,"end":15.107,"text":"F'ese awon t'O ru.","marked":"F'ẹsẹ̀ àwọn t'Ó rú."}],"end":15.107},{"key":"3","start":16.057,"lines":[{"start":16.057,"end":16.962,"text":"Ẹyin ero l'ọna,","marked":"Ẹ̀yin èrò l'ọ̀nà"},{"start":17.412,"end":18.68,"text":"Ẹ kọrin b'ẹ ti ń lọ;","marked":"Ẹ kọrin b'ẹ ti ń lọ"},{"start":19.13,"end":20.763,"text":"Ẹ yọ ninu Ọd'aguntan,","marked":"Ẹ yọ̀ nínú Ọ̀d'àgùntàn"},{"start":21.213,"end":22.421,"text":"Ninu Kristi Ọba.","marked":"Nínú Kristi Ọba."}],"end":22.421},{"key":"4","start":23.371,"lines":[{"start":23.371,"end":24.889,"text":"Ẹ fẹ gbọ k'O wi pé,","marked":"Ẹ fẹ́ gbọ́ k'Ó wí pé"},{"start":25.339,"end":27.597,"text":"―Alabukun, ẹ wa","marked":"―Alábùkún, ẹ wà"},{"start":28.047,"end":29.626,"text":"Oun fẹrẹ pe yin lọ kuro,","marked":"Òun fẹ́rẹ̀ pé yín lọ kúrò"},{"start":30.076,"end":31.509,"text":"K'O mu Tirẹ lọ'le.","marked":"K'Ó mú Tirẹ̀ lọ́'lé."}],"end":31.509},{"key":"5","start":32.459,"lines":[{"start":32.459,"end":34.049,"text":"Nibẹ l'a o kọrin,","marked":"Níbẹ̀ l'á ó kọrin"},{"start":34.499,"end":36.023,"text":"Iyin Rẹ ailopin;","marked":"Ìyìn Rẹ àìlópin"},{"start":36.473,"end":38.658,"text":"f Ọrun y'o si gbe 'rin Mose,","marked":"f Ọ̀run y'ó sì gbé rin Mósè"},{"start":39.108,"end":40.424,"text":"Ati t' Ọd'aguntan.","marked":"Àti t Ọ̀d'àgùntàn."}],"end":40.424}]}