{"v":3,"coll":"y","num":816,"id":"hymn_816","title":"JESU Iwo Oba mi","duration":88.779,"voices":{"male":{"file":"y-816-male-v3.m4a","bytes":630093,"sha256":"1c17c13dc8f19b3d0e04a97caabfd4e8da341a69a54973c1b571a5b7e920715d","duration":88.8},"female":{"file":"y-816-female-v3.m4a","bytes":648893,"sha256":"a9d64f7db68a392430919c6524b3caa355d44a692aa3a53cfc29160e805cc6da","duration":88.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.723,"text":"JESU Iwọ Ọba mi,","marked":"Jésù Ìwọ Ọba mi"},{"start":2.173,"end":3.594,"text":"Iwọ ni mo gbẹkẹle,","marked":"Ìwọ ni mo gbẹ́kẹ̀lé"},{"start":4.044,"end":5.473,"text":"L'ayé yi n ko l'ẹnikan,","marked":"L'ayé yí ń kò l'ẹnìkan"},{"start":5.923,"end":7.065,"text":"Lẹhin Rẹ 'Wọ Ọba mi,","marked":"Lẹ́hìn Rẹ 'Wọ Ọba mi"},{"start":7.515,"end":9.016,"text":"'Tori naa gbe mi leke,","marked":"torí náà gbé mi lékè"},{"start":9.466,"end":10.788,"text":"Gbe mi bori ọta mi,","marked":"Gbé mi borí ọ̀tá mi"},{"start":11.238,"end":12.846,"text":"Ki n layọ ki n ni'sẹgun,","marked":"Kí n láyọ̀ kí n ní'sẹ́gun"},{"start":13.296,"end":14.467,"text":"L'ọjọ ayé mi gbogbo.","marked":"L'ọjọ́ ayé mi gbogbo."}],"end":14.467},{"key":"2","start":15.417,"lines":[{"start":15.417,"end":16.571,"text":"Fun mi ni ore-ọfẹ,","marked":"Fún mi ní ore-ọfẹ"},{"start":17.021,"end":18.228,"text":"Se mi yẹ l'ẹni tirẹ;","marked":"Ṣé mi yẹ̀ l'ẹni tirẹ̀"},{"start":18.678,"end":19.914,"text":"S'ayé mi d'ire fun mi,","marked":"S'ayé mi d'ìre fún mi"},{"start":20.364,"end":21.744,"text":"'Wọ t'o sọ ayé Esther,","marked":"'Wọ t'ó sọ ayé Esther"},{"start":22.194,"end":23.258,"text":"rere fun nigbani;","marked":"rere fún nígbànì"},{"start":23.708,"end":25.033,"text":"Wa s'ayé mi di rere,","marked":"Wá s'ayé mi di rere"},{"start":25.483,"end":27.063,"text":"Jẹ ki im'ọta le d'ofo.","marked":"Jẹ́ kí ìm'ọ̀tá lè d'òfo."}],"end":27.063},{"key":"3","start":28.013,"lines":[{"start":28.013,"end":29.773,"text":"Gbe mi leke, mo fẹ bẹ,","marked":"Gbé mi lékè, mo fẹ́ bẹ"},{"start":30.223,"end":31.831,"text":"'Wọ Ọba agbara gbogbo,","marked":"'Wọ Ọba agbára gbogbo"},{"start":32.281,"end":34.305,"text":"Ipa ọta ko to nkan,","marked":"Ipa ọ̀tá kò tó nǹkan"},{"start":34.755,"end":36.001,"text":"Niwaju agbara Rẹ,","marked":"Níwájú agbára Rẹ"},{"start":36.451,"end":38.146,"text":"'Tori na, Ẹlẹda mi,","marked":"torí ná, Ẹlẹda mi"},{"start":38.596,"end":39.813,"text":"Pa agbara ọta run,","marked":"Pa agbára ọ̀tá run"},{"start":40.263,"end":41.487,"text":"K'ọta ma yọ mi lẹnu,","marked":"K'ọ̀tá má yọ mí lẹ́nu"},{"start":41.937,"end":43.125,"text":"Gbe mi leke isoro.","marked":"Gbé mi lékè ìṣòro."}],"end":43.125},{"key":"4","start":44.075,"lines":[{"start":44.075,"end":45.61,"text":"'Wọ ti wa k'ayé to wa,","marked":"'Wọ ti wá k'ayé tó wá"},{"start":46.06,"end":47.599,"text":"'Wọ ti wa k'ọrun to wa,","marked":"'Wọ ti wá k'ọ̀run tó wá"},{"start":48.049,"end":49.358,"text":"'Tori na Jesu temi,","marked":"torí na Jésù tèmi"},{"start":49.808,"end":50.996,"text":"Jẹ k'ọla Rẹ han fun mi;","marked":"Jẹ́ k'ọlá Rẹ hàn fún mi"},{"start":51.446,"end":52.993,"text":"Tobẹ t'emi naa yoo ri,","marked":"Tóbẹ̀ t'èmi náà yóò rí"},{"start":53.443,"end":55.311,"text":"T'ayé yoo si ri pẹlu,","marked":"T'ayé yóò sì rí pẹ̀lú"},{"start":55.761,"end":57.209,"text":"Pe 'Wọ l'agbara Gbogbo.","marked":"Pé 'Wọ l'agbára Gbogbo."}],"end":57.209},{"key":"5","start":58.159,"lines":[{"start":58.159,"end":59.358,"text":"Fi Ọla Rẹ yi mi ka,","marked":"Fi Ọlá Rẹ yí mi ká"},{"start":59.808,"end":61.2,"text":"Fi Ogo Rẹ yi mi ka,","marked":"Fi Ògo Rẹ yí mi ká"},{"start":61.65,"end":62.845,"text":"K'agbara Rẹ s'abo mi,","marked":"K'agbára Rẹ s'àbọ̀ mi"},{"start":63.295,"end":64.791,"text":"K'orukọ Rẹ s'abo mi,","marked":"K'orúkọ Rẹ s'àbọ̀ mi"},{"start":65.241,"end":66.847,"text":"Tobẹ ti n o di tirẹ,","marked":"Tòbẹ̀ tí n ó di tirẹ̀"},{"start":67.297,"end":68.54,"text":"K'ayé ma le ridi mi,","marked":"K'ayé má lè rìdí mi"},{"start":68.99,"end":70.38,"text":"K'owo esu ma te mi,","marked":"K'ọwọ́ èṣù má tẹ̀ mí"},{"start":70.83,"end":72.056,"text":"Tobẹ k'ayé mi l'ayọ.","marked":"Tóbẹ̀ k'ayé mi l'ayọ̀."}],"end":72.056},{"key":"6","start":73.006,"lines":[{"start":73.006,"end":74.239,"text":"Gba mo ba si de ọrun,","marked":"Gbà mo bá sì dé ọ̀run"},{"start":74.689,"end":76.137,"text":"Fun mi ni ipo lọdọ Rẹ,","marked":"Fún mi ní ipò lọ́dọ̀ Rẹ"},{"start":76.587,"end":77.737,"text":"Ki n j'ẹni ọwọ 'tun Rẹ,","marked":"Kí n j'ẹni ọwọ́ tún Rẹ"},{"start":78.187,"end":79.438,"text":"Ki n yẹ ni ori itẹ Rẹ,","marked":"Kí n yẹ ní orí ìtẹ́ Rẹ"},{"start":79.888,"end":81.429,"text":"'Gbana l'ayọ mi y'o kun,","marked":"gbáná l'ayọ̀ mi y'ó kún"},{"start":81.879,"end":83.454,"text":"Nin' ogo ti ko l'opin,","marked":"Nín ògo tí kò l'òpin"},{"start":83.904,"end":85.427,"text":"Ninu ayọ ti ki tan,","marked":"Nínú ayọ̀ tí kì tán"},{"start":85.877,"end":87.23,"text":"Ninu ọla ti ki sa.","marked":"Nínú ọlá tí kì sá."}],"end":87.23}]}