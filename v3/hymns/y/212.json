{"v":3,"coll":"y","num":212,"id":"hymn_212","title":"OJO ati akoko n lo","duration":74.274,"voices":{"male":{"file":"y-212-male-v3.m4a","bytes":519905,"sha256":"62e0e3574f8ea518c97673037f624e6efca2e0f195f6bfdba6e409a9c459f169","duration":74.3},"female":{"file":"y-212-female-v3.m4a","bytes":543250,"sha256":"1751b9e2667ff8d08b855ff9716371ac5c28ce98739b2bba87bd3e3b34f73374","duration":74.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.915,"text":"ỌJỌ ati akoko ń lọ,","marked":"Ọjọ́ àti àkókò ń lọ"},{"start":2.365,"end":4.535,"text":"Wọn ń sun wa s'eti, 'boji","marked":"Wọ́n ń sùn wá s'etí, bojì"},{"start":4.985,"end":6.319,"text":"Awa fẹrẹ dubulẹ na,","marked":"Àwa fẹ́rẹ̀ dùbúlẹ̀ ná"},{"start":6.769,"end":7.914,"text":"Ninu iho 'busun wa.","marked":"Nínú ihò bùsùn wà."}],"end":7.914},{"key":"2","start":8.864,"lines":[{"start":8.864,"end":10.909,"text":"Jesu, 'Wọ Olurapada,","marked":"Jésù, 'Wọ Olùràpadà"},{"start":11.359,"end":12.839,"text":"Ji ọkan t'o ku s'ẹsẹ;","marked":"Jí ọkàn t'ó kù s'ẹsẹ̀"},{"start":13.289,"end":14.644,"text":"Ji gbogbo ọkan ti ń togbe.","marked":"Jí gbogbo ọkàn tí ń tọgbẹ́."},{"start":15.094,"end":16.517,"text":"Lati yan ipa iye.","marked":"Láti yan ipa ìyè."}],"end":16.517},{"key":"3","start":17.467,"lines":[{"start":17.467,"end":18.992,"text":"Bi akoko ti ń sunmọle,","marked":"Bí àkókò tí ń súnmọ́lè"},{"start":19.442,"end":20.88,"text":"Jẹ k'a ro 'bi ti a ń lọ;","marked":"Jẹ́ k'á rọ bí tí à ń lọ"},{"start":21.33,"end":22.961,"text":"Bi lati r'ayọ ailopin,","marked":"Bí láti r'ayọ̀ àìlópin"},{"start":23.411,"end":24.963,"text":"Tabi egbe ailopin.","marked":"Tàbí ẹgbẹ́ àìlópin."}],"end":24.963},{"key":"4","start":25.913,"lines":[{"start":25.913,"end":26.801,"text":"Ayé wa ń lọ!","marked":"Ayé wà ń lọ!"},{"start":27.251,"end":28.336,"text":"Iku de tan,","marked":"Ikú dé tán"},{"start":28.786,"end":30.109,"text":"Jesu, sọ wa,","marked":"Jésù, sọ wá"},{"start":30.559,"end":31.624,"text":"Tit' O fi de,","marked":"Tít Ó fi dé"},{"start":32.074,"end":33.026,"text":"K'a ba Ọ gbe,","marked":"K'á bá Ọ gbé"},{"start":33.476,"end":34.567,"text":"K'a ba Ọ ku,","marked":"K'á bá Ọ kú"},{"start":35.017,"end":36.695,"text":"K'a ba Ọ jọba titi lailai","marked":"K'á bá Ọ jọba títí láéláé"}],"end":36.695},{"key":"5","start":37.645,"lines":[{"start":37.645,"end":39.128,"text":"Ayé wa ń kọja b'ojiji,","marked":"Ayé wà ń kọjá b'òjìji"},{"start":39.578,"end":41.17,"text":"O si ń fo lọ bi 'kuku;","marked":"Ó sì ń fò lọ bí kúkú"},{"start":41.62,"end":43.542,"text":"Fun gbogbo ọdun t'o kọja,","marked":"Fún gbogbo ọdún t'ó kọjá"},{"start":43.992,"end":45.461,"text":"Dariji wa, mu wa gbọn.","marked":"Dáríjì wá, mú wa gbọ́n."}],"end":45.461},{"key":"6","start":46.411,"lines":[{"start":46.411,"end":48.058,"text":"Kọ wa lati ka ọjọ wa,","marked":"Kọ́ wá láti ka ọjọ́ wa"},{"start":48.508,"end":49.858,"text":"La ti ba ẹsẹ wa ja,","marked":"La ti bá ẹsẹ̀ wa jà"},{"start":50.308,"end":52.66,"text":"K'a ma sare, k'a ma togbe,","marked":"K'á má sáré, k'á má tọ̀gbẹ́"},{"start":53.11,"end":54.735,"text":"Tit'a o fi ri 'sinmi.","marked":"Tít'à ó fi rí sinmi."}],"end":54.735},{"key":"7","start":55.685,"lines":[{"start":55.685,"end":57.013,"text":"Gbogbo wa fẹrẹ duro na,","marked":"Gbogbo wa fẹ́rẹ̀ dúró ná"},{"start":57.463,"end":58.746,"text":"Niwaju itẹ 'dajọ;","marked":"Níwájú ìtẹ́ 'dajọ"},{"start":59.196,"end":61.312,"text":"Jesu, 'Wọ t'o sẹgun iku,","marked":"Jésù, 'Wọ t'ó sẹ́gun ikú"},{"start":61.762,"end":63.132,"text":"Fiwa s'apa ọtun Rẹ.","marked":"Fìwà s'apá ọ̀tún Rẹ."}],"end":63.132},{"key":"8","start":64.082,"lines":[{"start":64.082,"end":65.021,"text":"Ayé wa ń lọ!","marked":"Ayé wà ń lọ!"},{"start":65.471,"end":66.53,"text":"Iku de tan,","marked":"Ikú dé tán"},{"start":66.98,"end":67.692,"text":"Olugbala!","marked":"Olùgbàlà!"},{"start":68.142,"end":68.955,"text":"Jọ pa wa mọ,","marked":"Jọ pa wá mọ́"},{"start":69.405,"end":70.533,"text":"K'a ba Ọ ku,","marked":"K'á bá Ọ kú"},{"start":70.983,"end":72.725,"text":"K'a ba Ọ jọba titi lailai.","marked":"K'á bá Ọ jọba títí láéláé."}],"end":72.725}]}