{"v":3,"coll":"y","num":98,"id":"hymn_98","title":"EYIN egbe Serafu","duration":68.691,"voices":{"male":{"file":"y-98-male-v3.m4a","bytes":482981,"sha256":"be6c99e73c2f2da530f1635421b20fe98260d289a4b1d60bfd00a8095e296782","duration":68.7},"female":{"file":"y-98-female-v3.m4a","bytes":504868,"sha256":"eac95707812535d583e9eb5a6fb1b4a3befb07bd742956ed50b03e362fa3faa7","duration":68.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.438,"text":"ẸYIN egbe Serafu,","marked":"Ẹ̀yin ẹgbẹ́ Séráfù"},{"start":1.888,"end":3.259,"text":"Wa fi ayo yin han,","marked":"Wá fi ayọ̀ yín hàn"},{"start":3.709,"end":5.028,"text":"E jumo ko orin didun","marked":"Ẹ jùmọ̀ kọ orin dídùn"},{"start":5.478,"end":6.95,"text":"Fun 'sẹ 'yanu to se fun","marked":"Fún 'sẹ yanu tó ṣe fún"},{"start":7.4,"end":16.124,"text":"wa Ti ko je ka sonu kuro ni ona Re. A ń yan lọ si Sion, Sion to dara julọ, A ń yan goke lọ si Sion, Ilu Ọlọrun wa.","marked":"wá Tí kò jẹ́ ká sọnù kúrò ní ọ̀nà Rẹ̀. A ń yàn lọ sí Sion, Sion tó dára jùlọ, A ń yàn gòkè lọ sí Sion, Ìlú Ọlọ́run wa."}],"end":16.124},{"key":"CHORUS","start":17.074,"lines":[{"start":17.074,"end":18.319,"text":"A nyan lo si Sion,","marked":"A nyan lọ sí Sion"},{"start":18.769,"end":20.051,"text":"Sion to dara julo","marked":"Sion tó dára jùlọ"},{"start":20.501,"end":21.899,"text":"A nyan goke lo si Sion","marked":"A nyan gòkè lọ sí Sion"},{"start":22.349,"end":23.339,"text":"Ilu Olorun wa.","marked":"Ìlú Ọlọ́run wa."}],"end":23.339},{"key":"2","start":24.289,"lines":[{"start":24.289,"end":25.492,"text":"Baba Aladura,","marked":"Baba Aládúrà"},{"start":25.942,"end":27.164,"text":"F'ọpẹ fun Ọlọrun,","marked":"F'ọpẹ́ fún Ọlọ́run"},{"start":27.614,"end":29.009,"text":"T'o mu O bori awọn ọta,","marked":"T'ó mú Ó borí àwọn ọ̀tá"},{"start":29.459,"end":30.924,"text":"Ti ko jẹ ki ọta yọ ọ,","marked":"Tí kò jẹ́ kí ọ̀tá yọ ọ́"},{"start":31.374,"end":32.523,"text":"To fi ọ se ori,","marked":"Tó fi ọ́ ṣe orí"},{"start":32.973,"end":34.206,"text":"Yio fi o se d'opin.","marked":"Yóò fi ó ṣe d'òpin."}],"end":34.206},{"key":"3","start":35.156,"lines":[{"start":35.156,"end":36.441,"text":"Ẹyin Ẹgbẹ Akọrin,","marked":"Ẹ̀yin Ẹgbẹ́ Akọrin"},{"start":36.891,"end":38.043,"text":"Ẹ fi ayọ yin han;","marked":"Ẹ fi ayọ̀ yín hàn"},{"start":38.493,"end":40.274,"text":"Fun Majẹmu Rẹ ti ko yẹ,","marked":"Fún Májẹ̀mú Rẹ tí kò yẹ"},{"start":40.724,"end":42.028,"text":"Ni arin Ẹgbẹ Séráfù,","marked":"Ní àrín Ẹgbẹ́ Séráfù"},{"start":42.478,"end":43.62,"text":"To musẹ di oni,","marked":"Tó músẹ́ di òní"},{"start":44.07,"end":45.321,"text":"Ati ayé ti mbọ.","marked":"Àti ayé ti mbọ̀."}],"end":45.321},{"key":"4","start":46.271,"lines":[{"start":46.271,"end":47.357,"text":"Eniyan le ma kẹgan,","marked":"Ènìyàn lè má kẹ́gàn"},{"start":47.807,"end":48.81,"text":"Wọn si le ma sata;","marked":"Wọ́n sì lè má ṣátá"},{"start":49.26,"end":50.531,"text":"Awọn ti ko m'Ọlọrun wa,","marked":"Àwọn tí kò m'Ọlọ́run wá"},{"start":50.981,"end":52.529,"text":"Sugbọn awa Ẹgbẹ Kérúbù,","marked":"Sùgbọ́n àwa Ẹgbẹ́ Kérúbù"},{"start":52.979,"end":54.352,"text":"A si m'ẹni t'a ń sin,","marked":"A sì m'ẹni t'á ń sìn"},{"start":54.802,"end":56.096,"text":"Yio si fun wa lere","marked":"Yóò sì fún wa lérè"}],"end":56.096},{"key":"5","start":57.046,"lines":[{"start":57.046,"end":58.277,"text":"Kérúbù Séráfù,","marked":"Kérúbù Séráfù"},{"start":58.727,"end":59.82,"text":"Ẹ mura sis'ẹmi,","marked":"Ẹ múra sís'ẹ̀mi"},{"start":60.27,"end":61.914,"text":"Ẹyin yoo sisẹ naa dopin,","marked":"Ẹ̀yin yóò sisẹ́ náà dópin"},{"start":62.364,"end":63.691,"text":"Ẹ o si ri Olugbala,","marked":"Ẹ ó sì rí Olùgbàlà"},{"start":64.141,"end":65.365,"text":"L'aye mimọ loke,","marked":"L'ayé mímọ́ lókè"},{"start":65.815,"end":67.142,"text":"Ati l'ọrun pẹlu.","marked":"Àti l'ọ̀run pẹ̀lú."}],"end":67.142}]}