{"v":3,"coll":"y","num":138,"id":"hymn_138","title":"IBA SE p'Oluwa","duration":81.442,"voices":{"male":{"file":"y-138-male-v3.m4a","bytes":592750,"sha256":"18f7f74cbf4e04284da4e2469c64b76f86d4f523a342a1b3e67c840bb5a73eed","duration":81.5},"female":{"file":"y-138-female-v3.m4a","bytes":604188,"sha256":"1113265d19b22a8f415eb7e117b5b79eb85b86bd57a0ea5762a5563889815a6f","duration":81.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":0.998,"text":"IBA SE","marked":"Ìbá Ṣe"},{"start":1.448,"end":2.783,"text":"p'Oluwa Ko ti wa ni","marked":"p'Olúwa Kò ti wà ni"},{"start":3.233,"end":4.645,"text":"tiwa Lo ye k'awa ma","marked":"tiwa Ló yẹ k'àwa má"},{"start":5.095,"end":15.455,"text":"wi Nigba t'esu gbogun tiwa. Ọpẹ ni f'Oluwa, Ọba wa Olore, A ke Kabiyesi, A f'ọpẹ fun jehofa, T'o gba wa lọwọ ọta, A dupẹ Oluwa.","marked":"wí Nígbà t'èṣù gbógun tiwa. Ọpẹ́ ni f'Olúwa, Ọba wa Ọlọ́rẹ́, A ké Kabiyesi, A f'ọpẹ́ fún jèhófà, T'ó gbà wá lọ́wọ́ ọ̀tá, A dúpẹ́ Olúwa."}],"end":15.455},{"key":"CHORUS","start":16.405,"lines":[{"start":16.405,"end":17.577,"text":"Ope ni f'Oluwa","marked":"Ọpẹ́ ni f'Olúwa"},{"start":18.027,"end":18.98,"text":"Oba wa Olore","marked":"Ọba wa Ọlọ́rẹ́"},{"start":19.43,"end":20.745,"text":"A ke kabiyesi","marked":"A ké kábíyèsí"},{"start":21.195,"end":22.439,"text":"A f'ope fun Jehofa","marked":"A f'ọpẹ́ fún Jèhófà"},{"start":22.889,"end":24.221,"text":"T'o gba wa Iowo ota,","marked":"T'ó gbà wá lọ́wọ́ ọ̀tá"},{"start":24.671,"end":25.647,"text":"A dupe Oluwu.","marked":"A dúpẹ́ Olúwu."}],"end":25.647},{"key":"2","start":26.597,"lines":[{"start":26.597,"end":27.757,"text":"Wọn 'ba bo wa mọlẹ,","marked":"Wọ́n bá bọ̀ wá mọ́lẹ̀"},{"start":28.207,"end":29.214,"text":"Pẹlu agbara wọn,","marked":"Pẹ̀lú agbára wọn"},{"start":29.664,"end":30.787,"text":"Ọpẹ ni f'Oluwa,","marked":"Ọpẹ́ ni f'Olúwa"},{"start":31.237,"end":32.962,"text":"Ti ko jẹ ki t'esu bori.","marked":"Tí kò jẹ́ kí t'eṣú borí."}],"end":32.962},{"key":"3","start":33.912,"lines":[{"start":33.912,"end":35.121,"text":"Ọkan wa yọ b'ẹyẹ,","marked":"Ọkàn wa yọ b'ẹyẹ"},{"start":35.571,"end":36.596,"text":"Nin' okun apẹyẹ,","marked":"Nín okùn apẹyẹ"},{"start":37.046,"end":38.799,"text":"Okun ja, awa yọ,","marked":"Òkun jà, àwa yọ̀"},{"start":39.249,"end":40.796,"text":"Ẹ yọ Jesu da wa silẹ.","marked":"Ẹ yọ Jésù dá wa sílẹ̀."}],"end":40.796},{"key":"4","start":41.746,"lines":[{"start":41.746,"end":42.944,"text":"Tire ni Oluwa","marked":"Tìrẹ ni Olúwa"},{"start":43.394,"end":44.742,"text":"Lati gbe wa leke","marked":"Láti gbé wa lékè"},{"start":45.192,"end":46.013,"text":"Gbogbo awon ota,","marked":"Gbogbo àwọn ọ̀tá"},{"start":46.463,"end":48.269,"text":"T'o wu ko tile yi wa ka.","marked":"T'ó wù kò tilẹ̀ yí wa ká."}],"end":48.269},{"key":"5","start":49.219,"lines":[{"start":49.219,"end":50.375,"text":"Ara f'ọkan balẹ,","marked":"Ara f'ọkàn balẹ̀"},{"start":50.825,"end":52.066,"text":"S'ọdọ Olugbala,","marked":"S'ọ́dọ̀ Olùgbàlà"},{"start":52.516,"end":53.748,"text":"B'esu ti gbọn to ni,","marked":"B'èṣù ti gbọ́n tó ni"},{"start":54.198,"end":55.849,"text":"Ko to kini kan fun Jesu.","marked":"Kò tó kiní kan fún Jésù."}],"end":55.849},{"key":"6","start":56.799,"lines":[{"start":56.799,"end":57.789,"text":"Iranlọwọ wa mbẹ,","marked":"Ìrànlọ́wọ́ wá mbẹ́"},{"start":58.239,"end":59.26,"text":"L'orukọ Oluwa,","marked":"L'orúkọ Olúwa"},{"start":59.71,"end":61.019,"text":"T'O da ọrun oun ayé,","marked":"T'Ó dá ọ̀run òun ayé"},{"start":61.469,"end":62.728,"text":"Ọba awọn ẹni mimọ.","marked":"Ọba àwọn ẹni mímọ́."}],"end":62.728},{"key":"7","start":63.678,"lines":[{"start":63.678,"end":64.693,"text":"Ogo fun Baba wa,","marked":"Ògo fún Baba wa"},{"start":65.143,"end":66.228,"text":"Ogo fun Omo Re,","marked":"Ògo fún Ọmọ Rẹ"},{"start":66.678,"end":67.728,"text":"Ogo f'Emi Mimo","marked":"Ògo f'Ẹ̀mí Mímọ́"},{"start":68.178,"end":79.893,"text":", Metalokan jo gbo tiwa. Ọpẹ ni f'Oluwa, Ọba wa Olore, A ke Kabiyesi, A f'ọpẹ fun jehofa, T'o gba wa lọwọ ọta, A dupẹ Oluwa.","marked":"Mẹ́talọ́kan jọ gbọ́ tiwa. Ọpẹ́ ni f'Olúwa, Ọba wa Ọlọ́rẹ́, A ké Kábíyèsí, A f'ọpẹ́ fún jèhófà, T'ó gbà wá lọ́wọ́ ọ̀tá, A dúpẹ́ Olúwa."}],"end":79.893}]}