{"v":3,"coll":"y","num":727,"id":"hymn_727","title":"OKUNKUN su imole kan si n tan","duration":63.123,"voices":{"male":{"file":"y-727-male-v3.m4a","bytes":449761,"sha256":"e1f231a362961ac3ae4ae512550c84ba20e949264a4469c11e3da7ee5e285598","duration":63.2},"female":{"file":"y-727-female-v3.m4a","bytes":471857,"sha256":"8ad412df9fdd7c8809d3b83280e00f682b8903c122836aac7805f4713fdcba06","duration":63.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.992,"text":"OKUNKUN su imole kan si ntan","marked":"Òkùnkùn ṣú ìmọ́lẹ̀ kan sí ńtán"},{"start":2.442,"end":3.616,"text":"Larin Egbe Serafu","marked":"Lárin Ẹgbẹ́ Séráfù"},{"start":4.066,"end":6.429,"text":"Maikeli si ni Balogun Egbe na,","marked":"Maikeli sì ni Balógun Ẹgbẹ́ ná"},{"start":6.879,"end":8.308,"text":"Samona lojo na.","marked":"Ṣamọ̀nà lọ́jọ́ ná."}],"end":8.308},{"key":"CHORUS","start":9.258,"lines":[{"start":9.258,"end":11.192,"text":"Maikel, Maikel,","marked":"Maikel, Maikel"},{"start":11.642,"end":13.653,"text":"Maikel, si ni Balagun.","marked":"Maikel, sì ni Balagun."},{"start":14.103,"end":15.109,"text":"Egbe Serafu,","marked":"Ẹgbẹ́ Séráfù"},{"start":15.559,"end":17.318,"text":"Jah Jehovah l'o d'egbe yi sile,","marked":"Jah Jehovah l'ó d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":17.768,"end":19.055,"text":"Ki ise araiye kan.","marked":"Kí iṣẹ́ aráìyè kan."}],"end":19.055},{"key":"2","start":20.005,"lines":[{"start":20.005,"end":22.029,"text":"Nigbati Ogun Maikeli ba dide","marked":"Nígbàtí Ogun Maikeli bá dìde"},{"start":22.479,"end":23.792,"text":"Esu yio si subu","marked":"Èṣù yóò sì ṣubú"},{"start":24.242,"end":26.111,"text":"Jah Jehovah l'od'egbe yi sile","marked":"Jah Jehovah l'ọ́d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":26.561,"end":27.91,"text":"Ki se araiye kan.","marked":"Kí ṣe aráìyè kan."}],"end":27.91},{"key":"3","start":28.86,"lines":[{"start":28.86,"end":31.054,"text":"B'aiye nsata t'esu si ndimopo","marked":"B'ayé ńṣátà t'èṣù sì ńdímọ́pọ̀"},{"start":31.504,"end":32.818,"text":"Oluwa yio segun","marked":"Olúwa yóò ṣẹ́gun"},{"start":33.268,"end":35.042,"text":"Jah Jehovah l'o d'egbe yi sile","marked":"Jah Jehovah l'ó d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":35.492,"end":36.738,"text":"Ki se araiye kan.","marked":"Kí ṣe aráìyè kan."}],"end":36.738},{"key":"4","start":37.688,"lines":[{"start":37.688,"end":39.821,"text":"Olugbala ti jagun O molu","marked":"Olùgbàlà ti jagun Ó mọ́lù"},{"start":40.271,"end":41.299,"text":"lyin f'oruko Re","marked":"Ìyìn f'orúkọ Rẹ"},{"start":41.749,"end":43.644,"text":"Ja Jehovah to d'egbe yi sile","marked":"Ja Jehovah tó d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":44.094,"end":45.42,"text":"Ki se araiye kan.","marked":"Kí ṣe aráìyè kan."}],"end":45.42},{"key":"5","start":46.37,"lines":[{"start":46.37,"end":47.839,"text":"Agbara emi meje t'Olorun","marked":"Agbára ẹ̀mí méje t'Ọlọ́run"},{"start":48.289,"end":49.441,"text":"Awamaridi ni","marked":"Àwamaridi ni"},{"start":49.891,"end":51.562,"text":"Jah Jehovah lo d'egbe yi sile","marked":"Jah Jehovah ló d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":52.012,"end":53.399,"text":"Ki se araiye kan.","marked":"Kí ṣe aráìyè kan."}],"end":53.399},{"key":"6","start":54.349,"lines":[{"start":54.349,"end":56.027,"text":"Orin isegun l'awa y'ma ko","marked":"Orin ìṣẹ́gun l'àwa y'má kọ"},{"start":56.477,"end":57.807,"text":"Awa Ege Serafu","marked":"Àwa Ègè Séráfù"},{"start":58.257,"end":59.808,"text":"Ja Jehovah lo d'egbe yi sile","marked":"Ja Jehovah ló d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":60.258,"end":61.574,"text":"Ki se araiye kan.","marked":"Kí ṣe aráìyè kan."}],"end":61.574}]}