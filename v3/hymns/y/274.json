{"v":3,"coll":"y","num":274,"id":"hymn_274","title":"B'ERU ese re ba n wo o lorun","duration":60.341,"voices":{"male":{"file":"y-274-male-v3.m4a","bytes":435644,"sha256":"8cdb97e50d52c839286e9ad306dfa9cca38d34438d1c616d63843be1388f7510","duration":60.4},"female":{"file":"y-274-female-v3.m4a","bytes":442169,"sha256":"cc41cad447c4a58d1140334a34eb9af1461a816f20de71d6a2d25e06685fd5cb","duration":60.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.499,"text":"B'ERU ese re ba n wọ o","marked":"B'Ẹ̀rù ẹsẹ̀ rẹ̀ bá ń wọ̀ ó"},{"start":1.949,"end":4.132,"text":"lọrun, Pe Jesu wole Okan","marked":"lọ́rùn, Pé Jésù wọlé Ọkàn"},{"start":4.582,"end":5.83,"text":"re B'o n daniyan isoji","marked":"rẹ̀ B'ó ń dániyàn ìṣòjì"},{"start":6.28,"end":15.646,"text":"Okan re Pe Jesu wole okan re. Le 'yemeji rẹ sọnu, Ba Oluwa rẹ laja; Si ọkan rẹ paya fun, Pe Jesu wọle ọkan rẹ.","marked":"Ọkàn rẹ̀ Pé Jésù wọlé ọkàn rẹ̀. Lé yẹméjì rẹ̀ sọnù, Bá Olúwa rẹ̀ làjà; Sí ọkàn rẹ̀ payá fún, Pé Jésù wọlé ọkàn rẹ̀."}],"end":15.646},{"key":"CHORUS","start":16.596,"lines":[{"start":16.596,"end":18.068,"text":"Le'yemeji re sonu","marked":"Lẹ́'yẹ̀méjì rẹ̀ sọnù"},{"start":18.518,"end":19.591,"text":"Ba Oluwa re laja","marked":"Bá Olúwa rẹ̀ làjà"},{"start":20.041,"end":21.349,"text":"Si okan re paya fun","marked":"Sí ọkàn rẹ payá fún"},{"start":21.799,"end":23.448,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":23.448},{"key":"2","start":24.398,"lines":[{"start":24.398,"end":26.125,"text":"Bi o ba n wa iwẹnumọ kiri,","marked":"Bí ó bá ń wá ìwẹ̀nùmọ́ kiri"},{"start":26.575,"end":28.039,"text":"Pe Jesu wọle ọkan rẹ;","marked":"Pé Jésù wọlé ọkàn rẹ̀"},{"start":28.489,"end":30.081,"text":"Oni 'wẹnumọ ko jina si ọ,","marked":"Òní 'wẹnumọ kò jìnà sí ọ"},{"start":30.531,"end":31.975,"text":"Pe Jesu wọle ọkan rẹ.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":31.975},{"key":"3","start":32.925,"lines":[{"start":32.925,"end":34.47,"text":"B' igbi wahala ba n gba ọ kiri","marked":"B ìgbì wàhálà bá ń gbà ọ́ kiri"},{"start":34.92,"end":36.286,"text":"Pe Jesu wọle ọkan rẹ;","marked":"Pé Jésù wọlé ọkàn rẹ̀"},{"start":36.736,"end":38.756,"text":"B'afo ba wa ti aye ko le di,","marked":"B'àfo bá wà tí ayé kò lè di"},{"start":39.206,"end":40.706,"text":"Pe Jesu wọle ọkan rẹ.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":40.706},{"key":"4","start":41.656,"lines":[{"start":41.656,"end":43.549,"text":"Bi ọrẹ t'o gbẹkẹle ba da ọ,","marked":"Bí ọ̀rẹ́ t'ó gbẹ́kẹ̀lé bá dá ọ"},{"start":43.999,"end":45.534,"text":"Pe Jesu wọle ọkan rẹ;","marked":"Pé Jésù wọlé ọkàn rẹ̀"},{"start":45.984,"end":47.847,"text":"Bi o n fẹ wọ agbala isinmi,","marked":"Bí ó ń fẹ́ wọ àgbàlá ìsinmi"},{"start":48.297,"end":49.796,"text":"Pe Jesu wọle ọkan rẹ.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":49.796},{"key":"5","start":50.746,"lines":[{"start":50.746,"end":52.642,"text":"B'o nfe korin awon alabukun","marked":"B'ó ńfẹ́ kọrin àwọn alábùkún"},{"start":53.092,"end":54.568,"text":"Pe Jesu wole okan re","marked":"Pé Jésù wọlé ọkàn rẹ̀"},{"start":55.018,"end":56.808,"text":"Bi o nfe wo agbala isimi","marked":"Bí ó ńfẹ́ wọ àgbàlá ìṣimi"},{"start":57.258,"end":58.792,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":58.792}]}