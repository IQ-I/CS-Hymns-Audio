{"v":3,"coll":"y","num":647,"id":"hymn_647","title":"OLUGBALA a de loni","duration":68.212,"voices":{"male":{"file":"y-647-male-v3.m4a","bytes":469017,"sha256":"ba494f266aa906a6462be85f873b55cd51bf7d6fb879f8310620263b02e2e503","duration":68.3},"female":{"file":"y-647-female-v3.m4a","bytes":484231,"sha256":"2998c5e62a8522ddd1a850bf2faf6a84879d70f22a54e07bc874ce40a9d027bf","duration":68.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.714,"text":"OLUGBALA a de loni","marked":"Olùgbàlà a dé lónì"},{"start":2.164,"end":3.54,"text":"Lati wa da Majemu","marked":"Láti wá dá Májẹ̀mú"},{"start":3.99,"end":5.483,"text":"Ran Emi Iye Re si wa","marked":"Rán Ẹ̀mí Iye Rẹ sí wa"},{"start":5.933,"end":7.483,"text":"K'O so gbogbo wa dotun.","marked":"K'Ó sọ gbogbo wa dọ́tun."}],"end":7.483},{"key":"CHORUS","start":8.433,"lines":[{"start":8.433,"end":9.628,"text":"Emi Mimo sokale wa","marked":"Ẹ̀mí Mímọ́ sọ̀kalẹ̀ wá"},{"start":10.078,"end":11.369,"text":"Wa fi agbara Re han","marked":"Wá fi agbára Rẹ̀ hàn"},{"start":11.819,"end":13.051,"text":"Olugbala, Olugbala","marked":"Olùgbàlà, Olùgbàlà"},{"start":13.501,"end":15.233,"text":"Olugbala, ba wa pe.","marked":"Olùgbàlà, bá wa pé."}],"end":15.233},{"key":"2","start":16.183,"lines":[{"start":16.183,"end":17.735,"text":"Wa tun 'baje inu wa se","marked":"Wá tún bàjẹ́ inú wa ṣe"},{"start":18.185,"end":19.428,"text":"F'ara re han wa loni","marked":"F'ara rẹ̀ hàn wá lónì"},{"start":19.878,"end":21.412,"text":"Ma je ki Esu ba wa pe","marked":"Má jẹ́ kí Èṣù bá wa pé"},{"start":21.862,"end":23.307,"text":"Ran Emi Re si arin wa.","marked":"Rán Ẹ̀mí Rẹ̀ sí arin wa."},{"start":23.757,"end":24.495,"text":"Egbe:  Emi Mimo...","marked":"Ẹ̀mí Mímọ́"}],"end":24.495},{"key":"3","start":25.445,"lines":[{"start":25.445,"end":26.657,"text":"Emi Agbara sokale","marked":"Ẹ̀mí Agbára sọ̀kalẹ̀"},{"start":27.107,"end":28.399,"text":"F'owo ife yi wa ka","marked":"F'ọwọ́ ìfẹ́ yí wa ká"},{"start":28.849,"end":30.116,"text":"Ka simi le ileri Re","marked":"Ká ṣímí lé ìlérí Rẹ̀"},{"start":30.566,"end":32.058,"text":"Ka mase siyemeji.","marked":"Ká máṣe ṣiyèméjì."},{"start":32.508,"end":33.25,"text":"Egbe:  Emi Mimo...","marked":"Ẹ̀mí Mímọ́"}],"end":33.25},{"key":"4","start":34.2,"lines":[{"start":34.2,"end":35.682,"text":"Ma je ki ife wa tutu","marked":"Má jẹ́ kí ìfẹ́ wa tútù"},{"start":36.132,"end":37.349,"text":"Larin Egbe Mimo yi","marked":"Lárin Ẹgbẹ́ Mímọ́ yí"},{"start":37.799,"end":39.023,"text":"Ka le fa opo agutan","marked":"Ká lè fa ọ̀pọ̀ àgùtàn"},{"start":39.473,"end":40.776,"text":"Si 'nu agbo Mimo yi.","marked":"Sì nu agbo Mímọ́ yí."},{"start":41.226,"end":42.011,"text":"Egbe:  Emi Mimo...","marked":"Ẹ̀mí Mímọ́"}],"end":42.011},{"key":"5","start":42.961,"lines":[{"start":42.961,"end":44.442,"text":"Baba wa gbo tiwa loni","marked":"Baba wa gbọ́ tiwa lónì"},{"start":44.892,"end":46.105,"text":"Sokale nin'ola Re","marked":"Sọ̀kalẹ̀ nín'ọlá Rẹ"},{"start":46.555,"end":48.051,"text":"Lati wa ya wa si mimo","marked":"Láti wá yà wá sí mímọ́"},{"start":48.501,"end":49.783,"text":"K'Emi Mimo ba le wa.","marked":"K'Ẹ̀mí Mímọ́ bá lè wà."},{"start":50.233,"end":50.974,"text":"Egbe:  Emi Mimo...","marked":"Ẹ̀mí Mímọ́"}],"end":50.974},{"key":"6","start":51.924,"lines":[{"start":51.924,"end":53.282,"text":"E f'Ogo fun Baba l'oke","marked":"Ẹ f'Ògo fún Baba l'òkè"},{"start":53.732,"end":54.919,"text":"E f'ogo fun Omo Re","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":55.369,"end":56.589,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":57.039,"end":58.148,"text":"Ogo fun Metalokan.","marked":"Ògo fún Mẹ́talọ́kan."},{"start":58.598,"end":59.906,"text":"Egbe:  Emi Mimo sokale wa","marked":"Ẹ̀mí Mímọ́ sọ̀kalẹ̀ wá"},{"start":60.356,"end":61.601,"text":"Wa fi agbara Re han","marked":"Wá fi agbára Rẹ̀ hàn"},{"start":62.051,"end":63.389,"text":"Olugbala, Olugbala","marked":"Olùgbàlà, Olùgbàlà"},{"start":63.839,"end":65.625,"text":"Olugbala, ba wa pe.","marked":"Olùgbàlà, bá wa pé."},{"start":66.075,"end":66.663,"text":"Amin.","marked":"Àmín."}],"end":66.663}]}