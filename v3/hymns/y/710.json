{"v":3,"coll":"y","num":710,"id":"hymn_710","title":"OGO, iyin, ola","duration":56.705,"voices":{"male":{"file":"y-710-male-v3.m4a","bytes":392377,"sha256":"f0c5acd427528eff5da36167c1f18baa940d91725ebbb2b9fab24ca43a691e71","duration":56.8},"female":{"file":"y-710-female-v3.m4a","bytes":415400,"sha256":"fe33bba4315368d3ec2f1ccebe295b2505f55db4fefe44389e257baab7458619","duration":56.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.389,"text":"OGO, iyin, ola","marked":"Ògo, ìyìn, ọlá"},{"start":1.839,"end":2.806,"text":"Fun Olugbala wa","marked":"Fún Olùgbàlà wa"},{"start":3.256,"end":4.675,"text":"T'o da eni wa si","marked":"T'ó dá ẹni wa sí"},{"start":5.125,"end":6.619,"text":"Titi d'ojo oni","marked":"Títí d'ọjọ́ òní"},{"start":7.069,"end":8.142,"text":"Ayo kun okan wa","marked":"Ayọ̀ kún ọkàn wa"},{"start":8.592,"end":9.944,"text":"Fun anfani nla yi","marked":"Fún àǹfàní ńlá yí"},{"start":10.394,"end":11.735,"text":"Lati sise fun O","marked":"Láti ṣiṣẹ́ fún Ọ"},{"start":12.185,"end":13.351,"text":"N'nu ogba re laye.","marked":"N'nú ọgbà rẹ̀ láyé."}],"end":13.351},{"key":"2","start":14.301,"lines":[{"start":14.301,"end":15.701,"text":"A dupe fun toni","marked":"A dúpẹ́ fún tóní"},{"start":16.151,"end":17.545,"text":"On agbara t'erni","marked":"Ọ̀n agbára t'erni"},{"start":17.995,"end":19.041,"text":"At'ebun ife nla","marked":"Àt'ẹ̀bùn ìfẹ́ ńlá"},{"start":19.491,"end":20.687,"text":"Ti o fi so wa po","marked":"Tí ó fi sọ wá pọ̀"},{"start":21.137,"end":22.286,"text":"Olusagutan wa","marked":"Olùṣàgùtàn wà"},{"start":22.736,"end":23.792,"text":"Tewo gba iyin wa","marked":"Tẹ́wọ́ gba ìyìn wa"},{"start":24.242,"end":25.148,"text":"Nitori anu Re","marked":"Nítorí àánú Rẹ"},{"start":25.598,"end":27.036,"text":"Se wa l'okan laelae.","marked":"Ṣe wá l'ọkàn láéláé."}],"end":27.036},{"key":"3","start":27.986,"lines":[{"start":27.986,"end":29.209,"text":"Bukun wa, Oluwa","marked":"Bùkún wá, Olúwa"},{"start":29.659,"end":30.764,"text":"Loni ajodun wa","marked":"Lóní àjọ̀dún wa"},{"start":31.214,"end":32.28,"text":"Ran ami Re si wa","marked":"Rán àmì Rẹ sí wa"},{"start":32.73,"end":34.051,"text":"K'a layo n'nu sin Re","marked":"K'á láyọ̀ n'nú sin Rẹ̀"},{"start":34.501,"end":35.575,"text":"Ka si s'aseyori","marked":"Ká sì s'àṣeyọrí"},{"start":36.025,"end":37.175,"text":"N'nu ise isin wa","marked":"N'nú iṣẹ́ ìsìn wa"},{"start":37.625,"end":39.006,"text":"K'a si fi Jesu se","marked":"K'á sì fi Jésù ṣe"},{"start":39.456,"end":40.636,"text":"Igbekele wa lae.","marked":"Ìgbẹ́kẹ̀lé wa láé."}],"end":40.636},{"key":"4","start":41.586,"lines":[{"start":41.586,"end":42.828,"text":"Eleda, Oluwa","marked":"Ẹlẹ́dàá, Olúwa"},{"start":43.278,"end":44.311,"text":"Orisun gbala wa","marked":"Orísun gbàlà wà"},{"start":44.761,"end":46.056,"text":"Se wa ye f'ajodun","marked":"Ṣé wá yẹ f'àjọ̀dún"},{"start":46.506,"end":47.397,"text":"Ti ibugbe loke","marked":"Ti ibùgbé lókè"},{"start":47.847,"end":49.193,"text":"N'ipari ajo wa","marked":"N'ìparí àjọ wa"},{"start":49.643,"end":50.952,"text":"N'nu aye osi yi","marked":"N'nú ayé òsì yí"},{"start":51.402,"end":52.544,"text":"K'a le ni ibugbe","marked":"K'á lè ní ibùgbé"},{"start":52.994,"end":54.2,"text":"Lodo Re Oluwa.","marked":"Lọ́dọ̀ Rẹ Olúwa."},{"start":54.65,"end":55.156,"text":"Amin.","marked":"Àmín."}],"end":55.156}]}