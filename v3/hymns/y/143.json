{"v":3,"coll":"y","num":143,"id":"hymn_143","title":"GBOGBO Egbe Onigbagbo","duration":104.037,"voices":{"male":{"file":"y-143-male-v3.m4a","bytes":746760,"sha256":"96fe462d58413f49798f1acce6a7f2ca794e6e8de2aba7d2144a57ce6a7bd724","duration":104.1},"female":{"file":"y-143-female-v3.m4a","bytes":769158,"sha256":"b96da7f3211e9bf955af9c53db4c79d2566a9801e8c39fb96d666a481692609f","duration":104.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.488,"text":"GBOGBO Egbe Onigbagbo","marked":"Gbogbo Ẹgbẹ́ Onígbàgbọ́"},{"start":1.938,"end":3.143,"text":"T'o wa ni gbogbo ayé;","marked":"T'ó wà ní gbogbo ayé"},{"start":3.593,"end":5.012,"text":"T'awon to wa nigberiko","marked":"T'àwọn tó wà nígbèríko"},{"start":5.462,"end":13.682,"text":"Ko jade wa woran. Ka jọ ho: Halleluyah! F'Ọba Olodumare, A sọpẹ... a t'ọpẹ da, T'o mu wa dọjọ oni.","marked":"Kò jáde wá wòran. Ká jọ hó: Hallelúyà! F'Ọba Olódùmarè, A sọpẹ́ a t'ọ́pẹ́ dá, T'ó mú wa dọ́jọ́ òní."}],"end":13.682},{"key":"CHORUS","start":14.632,"lines":[{"start":14.632,"end":17.005,"text":"Ka jo ho. Halleluya!","marked":"Ká jọ hó. Hallelúyà!"},{"start":17.455,"end":18.507,"text":"F' Oba Olodumare","marked":"F Ọba Olódùmarè"},{"start":18.957,"end":20.403,"text":"A sope a t'ope da,","marked":"A ṣọpẹ́ a t'ọpẹ́ dá"},{"start":20.853,"end":22.288,"text":"T'o mu wa dojo oni.","marked":"T'ó mú wa dọ́jọ́ òní."}],"end":22.288},{"key":"2","start":23.238,"lines":[{"start":23.238,"end":24.889,"text":"Gbogbo ẹgbẹ ni gbogbo Ijọ,","marked":"Gbogbo ẹ̀gbẹ́ ni gbogbo Ìjọ"},{"start":25.339,"end":26.566,"text":"Ko si'ru eyi ri:","marked":"Kò sí'ru èyí rí"},{"start":27.016,"end":28.792,"text":"Ti Maikẹl jẹ Balogun fun,","marked":"Tí Maikẹl jẹ́ Balógun fún"},{"start":29.242,"end":30.708,"text":"Ko s'ijọ to dun to.","marked":"Kò s'ìjọ tó dùn tó."}],"end":30.708},{"key":"3","start":31.658,"lines":[{"start":31.658,"end":33.36,"text":"Ẹmi Mimọ lo n dari wa,","marked":"Ẹ̀mí Mímọ́ ló ń darí wa"},{"start":33.81,"end":34.964,"text":"T'ẹnikan ko le mọ,","marked":"T'ẹnìkan kò le mọ́"},{"start":35.414,"end":36.898,"text":"A f'awọn t'a firan naa han,","marked":"A f'àwọn t'á firan náà hàn"},{"start":37.348,"end":38.62,"text":"Lo mọ ijinlẹ rẹ.","marked":"Lọ mọ ìjìnlẹ̀ rẹ."}],"end":38.62},{"key":"4","start":39.57,"lines":[{"start":39.57,"end":40.888,"text":"At'okunrin at'obinrin,","marked":"Àt'ọkùnrin àt'obìnrin"},{"start":41.338,"end":42.579,"text":"T'o wa ni Serafu","marked":"T'ó wà ní Séráfù"},{"start":43.029,"end":44.446,"text":"Egbe ogun onigbagbo","marked":"Ẹgbẹ́ ogun onígbàgbọ́"},{"start":44.896,"end":46.186,"text":"K'a jumo d'orin po.","marked":"K'á jùmọ̀ d'orin pọ̀."}],"end":46.186},{"key":"5","start":47.136,"lines":[{"start":47.136,"end":49.662,"text":"Ajẹ, Oso, ko n'ipa kan,","marked":"Àjẹ́, Ọ̀ṣọ́, kò n'ipa kan"},{"start":50.112,"end":51.389,"text":"Lor' Ijọ t'a wa yi,","marked":"Lór Ìjọ t'á wà yí"},{"start":51.839,"end":53.306,"text":"Balogun Ijọ Séráfù,","marked":"Balógun Ìjọ Séráfù"},{"start":53.756,"end":54.988,"text":"Ti jagun o molu.","marked":"Ti jagun ò mọ́lù."}],"end":54.988},{"key":"6","start":55.938,"lines":[{"start":55.938,"end":57.294,"text":"Awamaridi n'isẹ Rẹ,","marked":"Àwamaridi n'isẹ́ Rẹ̀"},{"start":57.744,"end":59.006,"text":"T'ẹnikan ko le mọ;","marked":"T'ẹnìkan kò le mọ́"},{"start":59.456,"end":61.243,"text":"Ẹda ayé, ẹda ọrun,","marked":"Ẹ̀dá ayé, ẹ̀dá ọ̀run"},{"start":61.693,"end":62.958,"text":"Ko le ridi 'sẹ Rẹ.","marked":"Kò lè rìdí 'sẹ Rẹ̀."}],"end":62.958},{"key":"7","start":63.908,"lines":[{"start":63.908,"end":65.283,"text":"Gbogbo awọn alailera,","marked":"Gbogbo àwọn aláìlera"},{"start":65.733,"end":66.934,"text":"To wa nin' Ijọ naa;","marked":"Tó wà nín Ìjọ náà"},{"start":67.384,"end":68.988,"text":"N jẹri si ohun ti wọn ri,","marked":"Ń jẹ́rí sí ohun tí wọ́n rí"},{"start":69.438,"end":70.705,"text":"Oluwa lo n sabo wọn.","marked":"Olúwa ló ń sábọ̀ wọn."}],"end":70.705},{"key":"8","start":71.655,"lines":[{"start":71.655,"end":73.201,"text":"Awọn Ẹgbẹ to wa lọrun,","marked":"Àwọn Ẹgbẹ́ tó wà lọ́rùn"},{"start":73.651,"end":75.39,"text":"N kọ si Séráfù t'ayé;","marked":"N kọ́ sí Séráfù t'ayé"},{"start":75.84,"end":77.526,"text":"Pe ka mura ka s'ọwọ pọ,","marked":"Pé ká múra ká s'ọwọ́ pọ̀"},{"start":77.976,"end":79.428,"text":"Ka jọ yin Ọba Ogo.","marked":"Ká jọ yín Ọba Ògo."}],"end":79.428},{"key":"9","start":80.378,"lines":[{"start":80.378,"end":82.412,"text":"Pipe, Mimọ Titọ, Rere,","marked":"Pípẹ́, Mímọ́ Títọ́, Rere"},{"start":82.862,"end":83.909,"text":"F'awọn to wa lọrun;","marked":"F'àwọn tó wà lọ́rùn"},{"start":84.359,"end":85.809,"text":"Imọlẹ itansan si n tan,","marked":"Ìmọ́lẹ̀ ìtànṣán sì ń tàn"},{"start":86.259,"end":87.303,"text":"Irawọ Owurọ.","marked":"Ìràwọ̀ Òwúrọ̀."}],"end":87.303},{"key":"10","start":88.253,"lines":[{"start":88.253,"end":89.879,"text":"Mimo ati Mimo julo","marked":"Mímọ́ àti Mímọ́ jùlọ"},{"start":90.329,"end":91.416,"text":"Jehofa-Jire wa,","marked":"Jehofa-jire wa"},{"start":91.866,"end":93.748,"text":"Jehofa-Rufi yoo so wa","marked":"Jehofa-rufi yóò sọ wá"},{"start":94.198,"end":102.488,"text":"Latubotan ayé wa. Ka jọ ho: Halleluyah! F'Ọba Olodumare, A sọpẹ... a t'ọpẹ da, T'o mu wa dọjọ oni.","marked":"Látùbọ̀tán ayé wà. Ká jọ hó: Hallelúyà! F'Ọba Olódùmarè, A sọpẹ́ a t'ọ́pẹ́ dá, T'ó mú wa dọ́jọ́ òní."}],"end":102.488}]}