{"v":3,"coll":"y","num":108,"id":"hymn_108","title":"KERUBU ati Serafu","duration":66.577,"voices":{"male":{"file":"y-108-male-v3.m4a","bytes":474251,"sha256":"9eac8168bf29ee21a01b8ace6952f38c773dea2fef147fe65a9da0c014cf71b0","duration":66.6},"female":{"file":"y-108-female-v3.m4a","bytes":494730,"sha256":"1cd390b53de6a2676584b33b314ff949d623a985d2aac1b35503e493b1f8b096","duration":66.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.072,"text":"KÉRÚBÙ ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":2.522,"end":3.944,"text":"Ẹ fun irugbin rere s'ayé,","marked":"Ẹ fún irúgbìn rere s'ayé"},{"start":4.394,"end":6.051,"text":"Ẹyin l'a pe lati s'awọn","marked":"Ẹ̀yin l'á pẹ́ láti s'àwọ́n"},{"start":6.501,"end":8.059,"text":"Ti yoo pade Oluwa l'oke.","marked":"Tí yóò pàdé Olúwa l'òkè."},{"start":8.509,"end":9.693,"text":"Gbọ, gbọ, gbọ b'awọn","marked":"Gbọ́, gbọ́, gbọ́ b'àwọn"},{"start":10.143,"end":11.742,"text":"Séráfù ti n ke,","marked":"Séráfù tí ń ké"},{"start":12.192,"end":13.423,"text":"Gbọ, gbọ, gbọ b'awọn","marked":"Gbọ́, gbọ́, gbọ́ b'àwọn"},{"start":13.873,"end":15.218,"text":"Kérúbù ti n ke","marked":"Kérúbù tí ń ké"},{"start":15.668,"end":17.508,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":17.958,"end":19.427,"text":"Halleluyah, f'Ọba wa.","marked":"Hallelúyà, f'Ọba wa."}],"end":19.427},{"key":"2","start":20.377,"lines":[{"start":20.377,"end":21.908,"text":"Onigbagbọ, ẹ ji giri,","marked":"Onígbàgbọ́, ẹ jí gírí"},{"start":22.358,"end":23.746,"text":"K'a fi iwa ẹsẹ s'ilẹ,","marked":"K'á fi ìwà ẹsẹ̀ s'ilẹ̀"},{"start":24.196,"end":25.615,"text":"K'a se ifẹ Oluwa wa,","marked":"K'á ṣe ìfẹ́ Olúwa wa"},{"start":26.065,"end":27.492,"text":"K'a le r'oju rere Ọlọrun.","marked":"K'á lè r'ojú rere Ọlọ́run."}],"end":27.492},{"key":"3","start":28.442,"lines":[{"start":28.442,"end":30.492,"text":"Onigbagbọ, ẹ gb' adura,","marked":"Onígbàgbọ́, ẹ gb àdúrà"},{"start":30.942,"end":32.537,"text":"Ẹ fi ọkan funfun sisẹ,","marked":"Ẹ fi ọkàn funfun sisẹ́"},{"start":32.987,"end":34.561,"text":"Ẹ gb'awẹ pẹlu iwa mimọ,","marked":"Ẹ gb'àwẹ̀ pẹ̀lú ìwà mímọ́"},{"start":35.011,"end":36.834,"text":"Eyi ni Jesu wa se l'aye.","marked":"Èyí ni Jésù wá ṣe l'ayé."}],"end":36.834},{"key":"4","start":37.784,"lines":[{"start":37.784,"end":40.454,"text":"Ẹyin araye, ẹ tun aye se,","marked":"Ẹ̀yin aráyé, ẹ tún ayé ṣe"},{"start":40.904,"end":42.319,"text":"Fun bibọ jesu Oluwa -","marked":"Fún bíbọ́ Jésù Olúwa"},{"start":42.769,"end":45.292,"text":"K'ẹsẹ dinku, k'ajakalẹ arun,","marked":"K'ẹsẹ̀ dínkù, k'àjàkálẹ̀ àrùn"},{"start":45.742,"end":47.444,"text":"Ma ti wa lọ s'ọrun apadi.","marked":"Má ti wá lọ s'ọ̀run àpadì."}],"end":47.444},{"key":"5","start":48.394,"lines":[{"start":48.394,"end":49.732,"text":"Onigbagbọ bẹru Ọlọrun,","marked":"Onígbàgbọ́ bẹ̀rù Ọlọ́run"},{"start":50.182,"end":51.469,"text":"Fẹran ọmọnikeji rẹ,","marked":"Fẹ́ràn ọmọnìkejì rẹ"},{"start":51.919,"end":53.394,"text":"Mase pẹgan mase binu,","marked":"Màṣẹ pẹ̀gàn màṣẹ bínú"},{"start":53.844,"end":55.072,"text":"Ọlọrun adura rẹ.","marked":"Ọlọ́run àdúrà rẹ̀."}],"end":55.072},{"key":"6","start":56.022,"lines":[{"start":56.022,"end":57.593,"text":"Opo idanwo l'o wa l'aye,","marked":"Ọ̀pọ̀ ìdánwò l'ó wà l'ayé"},{"start":58.043,"end":59.815,"text":"Sugbon eyi t'o buruju","marked":"Ṣùgbọ́n èyí t'ó burújú"},{"start":60.265,"end":62.825,"text":"K'a ma r'owo, k'aisan de ni","marked":"K'á má r'ọwọ́, k'àìsàn dé ni"},{"start":63.275,"end":65.028,"text":"JAH jowo ma fi eyi se wa.","marked":"Jah jọ̀wọ́ má fi èyí ṣe wá."}],"end":65.028}]}