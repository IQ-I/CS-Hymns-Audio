{"v":3,"coll":"y","num":487,"id":"hymn_487","title":"LATI 'nu ide ibanuje","duration":67.92,"voices":{"male":{"file":"y-487-male-v3.m4a","bytes":492919,"sha256":"36bf316b187dc30f421c834043a3b0383da5223ffd9cb3df7433e5a1659c4bb1","duration":68.0},"female":{"file":"y-487-female-v3.m4a","bytes":512527,"sha256":"56539898791216d4b5ab96041ae0354e003336950356320eafebffbe4559db52","duration":68.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.637,"text":"LATI 'nu ide ibanuje","marked":"Láti nú idẹ ìbànújẹ́"},{"start":2.087,"end":3.974,"text":"Jesu mo de, Jesu mo de","marked":"Jésù mo dé, Jésù mo dé"},{"start":4.424,"end":6.356,"text":"Mo wa gba omnira at'ayo","marked":"Mo wá gba omnira àt'ayọ̀"},{"start":6.806,"end":7.875,"text":"Jesu mo wa do Re","marked":"Jésù mọ̀ wá dó Rẹ̀"},{"start":8.325,"end":10.685,"text":"Alaisan, emi nfe iwosan","marked":"Aláìsàn, èmi ńfẹ́ ìwòsàn"},{"start":11.135,"end":13.142,"text":"Alaini, so mi di oloro","marked":"Aláìní, sọ mí di ọlọ́rọ̀"},{"start":13.592,"end":15.669,"text":"Elese, mo wa si odo Re","marked":"Ẹlẹ́ṣẹ̀, mo wá sí ọ̀dọ̀ Rẹ"},{"start":16.119,"end":17.599,"text":"Jesu, mo wa'do Re.","marked":"Jésù, mo wá'dó Rẹ̀."}],"end":17.599},{"key":"2","start":18.549,"lines":[{"start":18.549,"end":20.078,"text":"Eni-tiju ati eIeya","marked":"Eni-tiju àti ẹlẹ́yà"},{"start":20.528,"end":22.372,"text":"Jesu mo de, Jesu mo de","marked":"Jésù mo dé, Jésù mo dé"},{"start":22.822,"end":24.488,"text":"Mo wa jere nla n'nu iku Re","marked":"Mo wá jèrè ńlá n'nú ikú Rẹ̀"},{"start":24.938,"end":26.002,"text":"Jesu mo wa'do Re","marked":"Jésù mọ̀ wá'dó Rẹ̀"},{"start":26.452,"end":27.923,"text":"Wo n'itunu fun ibanuje","marked":"Wò n'ìtùnú fún ìbànújẹ́"},{"start":28.373,"end":29.816,"text":"Wo n'isimi fun gbogbo iji","marked":"Wò n'ìṣímí fún gbogbo ìjì"},{"start":30.266,"end":31.566,"text":"Jesu mo wa'do Re.","marked":"Jésù mọ̀ wá'dó Rẹ̀."}],"end":31.566},{"key":"3","start":32.516,"lines":[{"start":32.516,"end":34.415,"text":"Ninu rudurudu aiye yi","marked":"Nínú rúdurùdu ayé yí"},{"start":34.865,"end":36.721,"text":"Jesu mo de, Jesu mo de","marked":"Jésù mo dé, Jésù mo dé"},{"start":37.171,"end":39.31,"text":"Mo wa s'inu pipe ife Re","marked":"Mo wá s'inú pípé ìfẹ́ Rẹ"},{"start":39.76,"end":40.768,"text":"Jesu mo wa'do Re","marked":"Jésù mọ̀ wá'dó Rẹ̀"},{"start":41.218,"end":42.625,"text":"Mu mi kuro n'nu ife ara","marked":"Mú mi kúrò n'nú ìfẹ́ ara"},{"start":43.075,"end":44.642,"text":"Kuro ninu aiye asan yi","marked":"Kúrò nínú ayé asán yí"},{"start":45.092,"end":46.743,"text":"Ki nle wa fi'ye idi goke","marked":"Kí ńlè wá fi'yẹ ìdí gòkè"},{"start":47.193,"end":48.467,"text":"Jesu mo wa'do Re.","marked":"Jésù mọ̀ wá'dó Rẹ̀."}],"end":48.467},{"key":"4","start":49.417,"lines":[{"start":49.417,"end":51.646,"text":"N'nu eru iku at'iboji","marked":"N'nu ẹ̀rù ikú àt'ibojì"},{"start":52.096,"end":54.06,"text":"Jesu mo de, Jesu mo de","marked":"Jésù mo dé, Jésù mo dé"},{"start":54.51,"end":56.062,"text":"Mo wa s'inu ayo ile mi","marked":"Mo wá s'inú ayọ̀ ilé mi"},{"start":56.512,"end":57.663,"text":"Jesu mo wa'do Re","marked":"Jésù mọ̀ wá'dó Rẹ̀"},{"start":58.113,"end":59.646,"text":"Lati nu iho iparun nla","marked":"Láti nu ihò ìparun ńlá"},{"start":60.096,"end":62.159,"text":"Sinu alafia t'o jinle","marked":"Sínú àlàáfíà t'ó jinlẹ̀"},{"start":62.609,"end":64.572,"text":"Lati wa w'oju Re ologo","marked":"Láti wá w'ojú Rẹ ológo"},{"start":65.022,"end":66.371,"text":"Jesu mo wa'do Re.","marked":"Jésù mọ̀ wá'dó Rẹ̀."}],"end":66.371}]}