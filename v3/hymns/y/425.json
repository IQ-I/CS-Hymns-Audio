{"v":3,"coll":"y","num":425,"id":"hymn_425","title":"JESU, nib'eni Re pade","duration":43.885,"voices":{"male":{"file":"y-425-male-v3.m4a","bytes":312827,"sha256":"5602ad377f2198cef3e2a38903f28f3587a7e074abd1a87ae281c3d0522c632f","duration":43.9},"female":{"file":"y-425-female-v3.m4a","bytes":318281,"sha256":"0068a3a187171a27298686c21ac2e4093649a1899f17a82552cd49ac9cb559fc","duration":43.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.241,"text":"JESU, nib'ẹni Rẹ pade,","marked":"Jésù, níb'ẹ̀ni Rẹ̀ pàdé"},{"start":2.691,"end":4.452,"text":"Nibẹ, wọn r'itẹ anu Rẹ;","marked":"Níbẹ̀, wọ́n r'ìtẹ́ àánú Rẹ̀"},{"start":4.902,"end":6.599,"text":"Nibẹ, wọn wa Ọ, wọn ri Ọ,","marked":"Níbẹ̀, wọ́n wá Ọ, wọ́n rí Ọ"},{"start":7.049,"end":8.318,"text":"Ibikibi n'ilẹ ọwọ.","marked":"Ibikíbi n'ilẹ́ ọwọ́."}],"end":8.318},{"key":"2","start":9.268,"lines":[{"start":9.268,"end":10.958,"text":"Ko s'ogiri t'o se Ọ mọ,","marked":"Kò s'ógìrì t'ó ṣe Ọ́ mọ́"},{"start":11.408,"end":12.595,"text":"O gbe inu onirẹlẹ,","marked":"Ó gbé inú onírẹ̀lẹ̀"},{"start":13.045,"end":14.651,"text":"Wọn mu Ọ wa 'bi wọn ba wa","marked":"Wọ́n mú Ọ wá bí wọ́n bá wà"},{"start":15.101,"end":16.567,"text":"'Gba wọn n lọ'le wọn mu Ọ lọ.","marked":"gbà wọ́n ń lọ'lé wọn mú Ọ lọ."}],"end":16.567},{"key":"3","start":17.517,"lines":[{"start":17.517,"end":18.735,"text":"Olus'aguntan ẹni Rẹ,","marked":"Olùṣ'àgùntàn ẹni Rẹ"},{"start":19.185,"end":20.589,"text":"Sọ anu Rẹ 'gbani d'ọtun,","marked":"Sọ àánú Rẹ gbani d'ọ̀tún"},{"start":21.039,"end":22.59,"text":"Sọ adun orukọ nla Rẹ,","marked":"Sọ adùn orúkọ ńlá Rẹ"},{"start":23.04,"end":24.613,"text":"Fun ọkan ti n wa oju Rẹ.","marked":"Fún ọkàn tí ń wá ojú Rẹ."}],"end":24.613},{"key":"4","start":25.563,"lines":[{"start":25.563,"end":26.965,"text":"Je k'a r'ipa adua nihin","marked":"Jẹ́ k'á r'ipa àdúà níhìn"},{"start":27.415,"end":29.148,"text":"Lati so 'gbagbo di lile","marked":"Láti sọ gbàgbọ́ di líle"},{"start":29.598,"end":31.311,"text":"Lati gbe ife wa soke","marked":"Láti gbé ìfẹ́ wá sókè"},{"start":31.761,"end":33.458,"text":"Lati gb'orun ka 'waju wa.","marked":"Láti gb'ọ̀run ká wájú wá."}],"end":33.458},{"key":"5","start":34.408,"lines":[{"start":34.408,"end":36.189,"text":"Oluwa,'Wo wa nitosi","marked":"Oluwa,'wo wà nítòsí"},{"start":36.639,"end":38.241,"text":"N'apa Re de 'ti Re sile","marked":"N'apá Rẹ̀ dé ti Rẹ̀ sílẹ̀"},{"start":38.691,"end":40.488,"text":"Si orun sokale kankan","marked":"Sí ọ̀run sọ̀kalẹ̀ kankan"},{"start":40.938,"end":42.336,"text":"Se gbogbo okan ni Tire.","marked":"Ṣe gbogbo ọkàn ní Tìrẹ."}],"end":42.336}]}