{"v":3,"coll":"y","num":322,"id":"hymn_322","title":"OLUWA ji loto","duration":60.883,"voices":{"male":{"file":"y-322-male-v3.m4a","bytes":430557,"sha256":"b10dd7698c4cf4bce3bba266d24e3fb01a15aaa68ee23314c5d868cda61a4e0b","duration":60.9},"female":{"file":"y-322-female-v3.m4a","bytes":446753,"sha256":"56b82857a0c0659250da978bf12edbc983601caacd781649c52668459bf57f2a","duration":60.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.499,"text":"OLUWA ji lotọ,","marked":"Olúwa jí lótọ̀"},{"start":1.949,"end":3.053,"text":"Olugbala dide,","marked":"Olùgbàlà dìde"},{"start":3.503,"end":4.594,"text":"O f'agbara Rẹ han,","marked":"Ó f'agbára Rẹ̀ hàn"},{"start":5.044,"end":6.204,"text":"L'o r'ọrun apadi:","marked":"L'ó r'ọ̀run àpadì"},{"start":6.654,"end":8.535,"text":"N'ibẹru nla; awọn ẹsọ,","marked":"N'ìbẹ̀rù ńlá; àwọn ẹ̀sọ̀"},{"start":8.985,"end":11.075,"text":"Subu lulẹ, wọn si daku.","marked":"Ṣubú lulẹ̀, wọ́n sì dákú."}],"end":11.075},{"key":"2","start":12.025,"lines":[{"start":12.025,"end":13.558,"text":"Wo, ẹgbẹ angẹli,","marked":"Wò, ẹ̀gbẹ́ áńgẹ́lì"},{"start":14.008,"end":15.249,"text":"Pade l'ajo kikun;","marked":"Pàdé l'àjọ kíkún"},{"start":15.699,"end":16.951,"text":"Lati gbọ asẹ Rẹ,","marked":"Láti gbọ́ àsẹ Rẹ"},{"start":17.401,"end":18.677,"text":"Ati la ti juba:","marked":"Àti la ti júbà"},{"start":19.127,"end":21.421,"text":"Wọn f'ayọ wa, wọn si n fo lọ","marked":"Wọ́n f'ayọ̀ wá, wọ́n sì ń fò lọ"},{"start":21.871,"end":23.464,"text":"Lati ọrun si 'boji na.","marked":"Láti ọ̀run sí bojì ná."}],"end":23.464},{"key":"3","start":24.414,"lines":[{"start":24.414,"end":25.809,"text":"Wọn tutu fo lọ s'ọrun,","marked":"Wọ́n tútù fò lọ s'ọ̀run"},{"start":26.259,"end":27.378,"text":"Wọn mu 'hin ayọ lọ:","marked":"Wọ́n mú hin ayọ̀ lọ"},{"start":27.828,"end":28.678,"text":"Gbọ iro orin wọn,","marked":"Gbọ́ ìró orin wọn"},{"start":29.128,"end":30.388,"text":"Bi wọn si ti n fo lọ,","marked":"Bí wọ́n sì ti ń fò lọ"},{"start":30.838,"end":32.921,"text":"Orin wọn ni, Jesu t'o ku,","marked":"Orin wọn ni, Jésù t'ó kú"},{"start":33.371,"end":35.214,"text":"Ti ji dide, o ji loni.","marked":"Ti jí dìde, ó jí lónì."}],"end":35.214},{"key":"4","start":36.164,"lines":[{"start":36.164,"end":37.398,"text":"Ẹyin t'a ra pada","marked":"Ẹ̀yin t'á rà padà"},{"start":37.848,"end":39.011,"text":"Ẹ gberin ayọ na:","marked":"Ẹ gbẹ̀rin ayọ̀ ná"},{"start":39.461,"end":40.492,"text":"Si gbogbo agbayé,","marked":"Sí gbogbo agbayé"},{"start":40.942,"end":43.557,"text":"Ẹ ho f'ayọ, Jesu t'o ku,","marked":"Ẹ hó f'ayọ̀, Jésù t'ó kú"},{"start":44.007,"end":46.167,"text":"Ti ji dide, ki y'o ku mọ.","marked":"Ti jí dìde, kí y'ó kú mọ́."}],"end":46.167},{"key":"5","start":47.117,"lines":[{"start":47.117,"end":48.945,"text":"Kabiyesi! Jesu!","marked":"Kábíyèsí! Jésù!"},{"start":49.395,"end":50.538,"text":"T'o f'ẹjẹ Rẹ gba wa;","marked":"T'ó f'ẹ̀jẹ̀ Rẹ gbà wá"},{"start":50.988,"end":51.915,"text":"Ki iyin Rẹ jale,","marked":"Kí ìyìn Rẹ jalè"},{"start":52.365,"end":53.758,"text":"Iwọ t'o ji dide:","marked":"Ìwọ t'ó jí dìde"},{"start":54.208,"end":56.273,"text":"A ba Ọ ji, a si jọba,","marked":"A bá Ọ jí, a sì jọba"},{"start":56.723,"end":59.334,"text":"Pẹlu Rẹ lai: l'oke ọrun.","marked":"Pẹ̀lú Rẹ̀ láì: l'òkè ọ̀run."}],"end":59.334}]}