{"v":3,"coll":"y","num":103,"id":"hymn_103","title":"Oluwa l'Olus'aguntan mi","duration":61.466,"voices":{"male":{"file":"y-103-male-v3.m4a","bytes":438223,"sha256":"fac4b4de3ba238ffc6f9d0a08b4ec34fca7d8e864f6c9b819ac8b3ebf69b584a","duration":61.5},"female":{"file":"y-103-female-v3.m4a","bytes":450653,"sha256":"47b1a607e4311ff246c4bb91ff3b3fd2390219ec15257e9d6b75b12ee4729bf4","duration":61.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.694,"text":"Oluwa l'Olus'aguntan mi,","marked":"Olúwa l'Olùṣ'àgùntàn mi"},{"start":2.144,"end":3.387,"text":"Emi k'o salaini,","marked":"Èmi k'ó ṣaláìní"},{"start":3.837,"end":5.513,"text":"O mu mi dubulẹ 'nu papa oko,","marked":"Ó mú mi dùbúlẹ̀ nù pápá oko"},{"start":5.963,"end":7.12,"text":"Tutu minimini.","marked":"Tútù mínimíni."},{"start":7.57,"end":9.647,"text":"Awa dupẹ, at' ọpẹ da,","marked":"Àwa dúpẹ́, àt ọpẹ́ dá"},{"start":10.097,"end":11.353,"text":"Fun idasi Rẹ fun wa,","marked":"Fún ìdásí Rẹ fún wa"},{"start":11.803,"end":13.269,"text":"Larin Ijọ Séráfù.","marked":"Lárin Ìjọ Séráfù."}],"end":13.269},{"key":"2","start":14.219,"lines":[{"start":14.219,"end":15.69,"text":"O mu mi lọ si iha omi,","marked":"Ó mú mi lọ sí ìhà omi"},{"start":16.14,"end":17.344,"text":"Idakẹ rọrọ si de,","marked":"Ìdákẹ́ rọ́rọ́ sì dé"},{"start":17.794,"end":19.027,"text":"O si tu ọkan mi lara,","marked":"Ó sì tú ọkàn mi lára"},{"start":19.477,"end":20.749,"text":"Ni ipa orukọ Rẹ.","marked":"Ní ipa orúkọ Rẹ."}],"end":20.749},{"key":"3","start":21.699,"lines":[{"start":21.699,"end":23.483,"text":"Ni tootọ bi mo tilẹ ń rin,","marked":"Ní tòótọ́ bí mo tilẹ̀ ń rìn"},{"start":23.933,"end":25.188,"text":"Larin afonifoji,","marked":"Lárin àfonífojì"},{"start":25.638,"end":27.1,"text":"Emi ki yoo bẹru ibi kan,","marked":"Èmi kì yóò bẹ̀rù ibi kan"},{"start":27.55,"end":28.891,"text":"Nitori o wa pẹlu mi.","marked":"Nítorí ó wà pẹ̀lú mi."}],"end":28.891},{"key":"4","start":29.841,"lines":[{"start":29.841,"end":31.548,"text":"Ogo Rẹ ati ọpa Rẹ,","marked":"Ògo Rẹ àti ọ̀pá Rẹ"},{"start":31.998,"end":33.401,"text":"Wọn si n tu mi ninu,","marked":"Wọ́n sì ń tù mí nínú"},{"start":33.851,"end":35.623,"text":"Iwọ tẹ tabili ounjẹ silẹ,","marked":"Ìwọ tẹ́ tábìlì oúnjẹ sílẹ̀"},{"start":36.073,"end":37.209,"text":"Ni iwaju mi.","marked":"Ní iwájú mi."}],"end":37.209},{"key":"5","start":38.159,"lines":[{"start":38.159,"end":40.138,"text":"Ni tootọ ire ati anu,","marked":"Ní tòótọ́ ìre àti àánú"},{"start":40.588,"end":41.779,"text":"Ni yoo ma tọ mi lehin,","marked":"Ni yóò má tọ̀ mí lẹ́hìn"},{"start":42.229,"end":43.475,"text":"Emi o gbẹkẹle Oluwa,","marked":"Èmi ó gbẹ́kẹ̀lé Olúwa"},{"start":43.925,"end":45.284,"text":"Ni gbogbo ọjọ ayé mi.","marked":"Ní gbogbo ọjọ́ ayé mi."}],"end":45.284},{"key":"6","start":46.234,"lines":[{"start":46.234,"end":47.853,"text":"K'a f'ogo fun Baba wa loke,","marked":"K'á f'ògo fún Baba wa lókè"},{"start":48.303,"end":49.731,"text":"K'a f'ogo fun Ọmọ Rẹ,","marked":"K'á f'ògo fún Ọmọ Rẹ"},{"start":50.181,"end":51.712,"text":"K'a fogo fun Ẹmi Mimọ,","marked":"K'á fògo fún Ẹ̀mí Mímọ́"},{"start":52.162,"end":53.797,"text":"Mẹtalọkan l'ọpẹ yẹ","marked":"Mẹ́talọ́kan l'ọ̀pẹ yẹ"},{"start":54.247,"end":56.393,"text":"Awa dupẹ, at'ọpẹ da,","marked":"Àwa dúpẹ́, àt'ọpẹ́ dá"},{"start":56.843,"end":58.083,"text":"Fun idasi Rẹ fun wa,","marked":"Fún ìdásí Rẹ fún wa"},{"start":58.533,"end":59.917,"text":"Larin Ijọ Séráfù.","marked":"Lárin Ìjọ Séráfù."}],"end":59.917}]}