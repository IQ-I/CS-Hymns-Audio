{"v":3,"coll":"y","num":304,"id":"hymn_304","title":"E JE k' a to Jesu wa lo","duration":31.042,"voices":{"male":{"file":"y-304-male-v3.m4a","bytes":211146,"sha256":"2b4e0423d74da49b1c2960945b1ada9b3e1f76f18e3c8ca981473c0c4f481595","duration":31.1},"female":{"file":"y-304-female-v3.m4a","bytes":221407,"sha256":"f3fcbe63e156dca3e9979744adb6887dbf102715f54c4f0d038bbc2bee150681","duration":31.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.023,"text":"Ẹ JẸ k'a tọ Jesu wa lọ,","marked":"Ẹ Jẹ́ k'á tọ Jésù wá lọ"},{"start":2.473,"end":3.727,"text":"Ni agbala nla ni;","marked":"Ní àgbàlá ńlá ni"},{"start":4.177,"end":5.414,"text":"Nibi ti O n lọ gbadura,","marked":"Níbi tí Ó ń lọ gbàdúrà"},{"start":5.864,"end":7.256,"text":"Nibi t'O n lọ kanu.","marked":"Níbi t'Ó ń lọ kánú."}],"end":7.256},{"key":"2","start":8.206,"lines":[{"start":8.206,"end":9.807,"text":"K'a wo b'O ti dojubolẹ","marked":"K'á wo b'Ó ti dojúbolẹ̀"},{"start":10.257,"end":11.301,"text":"T'o n mi imi ẹdun;","marked":"T'ó ń mí ìmí ẹ̀dùn"},{"start":11.751,"end":13.081,"text":"Ẹru ẹsẹ wa l'O gberu,","marked":"Ẹ̀rù ẹsẹ̀ wa l'Ó gbèrú"},{"start":13.531,"end":14.496,"text":"Ẹsẹ gbogbo ayé.","marked":"Ẹsẹ̀ gbogbo ayé."}],"end":14.496},{"key":"3","start":15.446,"lines":[{"start":15.446,"end":16.879,"text":"Ẹlẹsẹ, wo Oluwa rẹ,","marked":"Ẹlẹ́sẹ̀, wo Olúwa rẹ"},{"start":17.329,"end":18.516,"text":"Ẹni mimọ julọ;","marked":"Ẹni mímọ́ jùlọ"},{"start":18.966,"end":20.369,"text":"Nitori rẹ ni Baba ko,","marked":"Nítorí rẹ̀ ni Baba kọ"},{"start":20.819,"end":21.936,"text":"Ayé si d'ọta rẹ.","marked":"Ayé sì d'ọ̀tá rẹ̀."}],"end":21.936},{"key":"4","start":22.886,"lines":[{"start":22.886,"end":24.475,"text":"Iwọ o ha wo laironu,","marked":"Ìwọ ó ha wọ̀ láìrònú"},{"start":24.925,"end":26.076,"text":"Lai k'ẹsẹ rẹ silẹ?","marked":"Láì k'ẹsẹ̀ rẹ̀ sílẹ̀?"},{"start":26.526,"end":27.755,"text":"Ọjọ idariji n kọja,","marked":"Ọjọ́ ìdáríjì ń kọjá"},{"start":28.205,"end":29.492,"text":"Ọjọ igbala n lọ.","marked":"Ọjọ́ ìgbàlà ń lọ."}],"end":29.492}]}