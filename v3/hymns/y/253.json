{"v":3,"coll":"y","num":253,"id":"hymn_253","title":"BABA, ma yi oju kuro","duration":48.319,"voices":{"male":{"file":"y-253-male-v3.m4a","bytes":334193,"sha256":"5dbad1cfd6f8d7d82ee603fce1d6e276bd19517d2106586e0bcb0a3c2c96e395","duration":48.4},"female":{"file":"y-253-female-v3.m4a","bytes":346669,"sha256":"aaf5dbff27ceb5062abfdb4d1dc4cd2bf2f5cbd583d8a8508ced5a7ddac1e062","duration":48.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.153,"text":"BABA, ma yi oju kuro,","marked":"Baba, má yí ojú kúrò"},{"start":2.603,"end":3.615,"text":"Fun emi otosi;","marked":"Fún ẹ̀mí òtòṣì"},{"start":4.065,"end":5.393,"text":"Ti n ponhunrere ẹsẹ mi,","marked":"Tí ń ponhunréré ẹsẹ̀ mi"},{"start":5.843,"end":7.072,"text":"N' iwaju itẹ Rẹ.","marked":"Ń iwájú ìtẹ́ Rẹ."}],"end":7.072},{"key":"2","start":8.022,"lines":[{"start":8.022,"end":9.493,"text":"'Lẹkun aanu to si silẹ,","marked":"'Lẹkun àánú tó ṣí sílẹ̀"},{"start":9.943,"end":11.349,"text":"F'akerora ẹsẹ,","marked":"F'akérora ẹsẹ̀"},{"start":11.799,"end":13.092,"text":"p Mase ti mọ mi Oluwa,","marked":"p Mase ti mọ̀ mi Olúwa"},{"start":13.542,"end":14.582,"text":"Jẹ ki emi wọle.","marked":"Jẹ́ kí èmi wọlé."}],"end":14.582},{"key":"3","start":15.532,"lines":[{"start":15.532,"end":16.909,"text":"Emi ko ni pe mo n jẹwọ,","marked":"Èmi kò ní pé mò ń jẹ́wọ́"},{"start":17.359,"end":18.482,"text":"B'aye mi ti ri ri;","marked":"B'ayé mi ti rí rí"},{"start":18.932,"end":21.002,"text":"Gbogbo rẹ lat' ẹhin wa, ni","marked":"Gbogbo rẹ̀ lát ẹ̀hìn wá, ni"},{"start":21.452,"end":22.688,"text":"'Wọ mọ dajudaju.","marked":"'Wọ mọ̀ dájúdájú."}],"end":22.688},{"key":"4","start":23.638,"lines":[{"start":23.638,"end":24.993,"text":"Mo wa si 'lẹkun anu Rẹ","marked":"Mo wá sí 'lẹkun àánú Rẹ"},{"start":25.443,"end":26.457,"text":"Nibi ti anu pọ:","marked":"Níbi tí àánú pọ̀"},{"start":26.907,"end":28.254,"text":"Mo fẹ 'dariji ẹsẹ mi,","marked":"Mo fẹ́ dáríjì ẹsẹ̀ mi"},{"start":28.704,"end":30.1,"text":"K'O mu ọkan mi da.","marked":"K'Ó mú ọkàn mi dá."}],"end":30.1},{"key":"5","start":31.05,"lines":[{"start":31.05,"end":32.317,"text":"Emi ko ni ma tẹnumọ,","marked":"Èmi kò ní má tẹnumọ́"},{"start":32.767,"end":34.104,"text":"Itunu ti mo n fẹ;","marked":"Ìtùnú tí mo ń fẹ́"},{"start":34.554,"end":36.713,"text":"'Wọ mọ, Baba, ki n to bere,","marked":"'Wọ mọ́, Baba, kí n tó bẹ̀rẹ̀"},{"start":37.163,"end":38.28,"text":"Ibukun t'emi n wa.","marked":"Ìbùkún t'èmi ń wá."}],"end":38.28},{"key":"6","start":39.23,"lines":[{"start":39.23,"end":40.877,"text":"Anu, Oluwa, ni mo fẹ,","marked":"Àánú, Olúwa, ni mo fẹ́"},{"start":41.327,"end":42.944,"text":"Eyi yii l'opin na;","marked":"Èyí yìí l'òpin ná"},{"start":43.394,"end":45.156,"text":"Oluwa, anu l'o yẹ mi,","marked":"Olúwa, àánú l'ó yẹ mi"},{"start":45.606,"end":46.77,"text":"Jẹ ki anu Rẹ wa.","marked":"Jẹ́ kí àánú Rẹ wà."}],"end":46.77}]}