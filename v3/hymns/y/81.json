{"v":3,"coll":"y","num":81,"id":"hymn_81","title":"E YO nin'Oluwa, e yo","duration":53.358,"voices":{"male":{"file":"y-81-male-v3.m4a","bytes":376133,"sha256":"fa324ede3b493bec461f2bca2cdf2c083a72eba5cfd53149ab5d4ee423c423e1","duration":53.4},"female":{"file":"y-81-female-v3.m4a","bytes":391303,"sha256":"5133004da869843694cc246df451468e2b0253e5221ae32bf1716de452ecc650","duration":53.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.106,"text":"E YO nin'Oluwa, e yo","marked":"Ẹ Yọ̀ nín'olúwa, ẹ yọ̀"},{"start":2.556,"end":3.758,"text":"Ẹyin olokan diduro","marked":"Ẹ̀yin ọlọ́kàn dídúró"},{"start":4.208,"end":5.301,"text":"At'ẹyin t'a se","marked":"Àt'ẹ̀yin t'á ṣe"},{"start":5.751,"end":11.457,"text":"l'ayanfe Mu 'banuje kuro l'okan yin. Ẹ yọ, ẹ yọ, ẹ yọ nin' ) Oluwa, ẹ yọ. )2ce","marked":"l'àyànfẹ́ Mú banújẹ́ kúrò l'ọkàn yín. Ẹ yọ, ẹ yọ, ẹ yọ nín Olúwa, ẹ yọ."}],"end":11.457},{"key":"CHORUS","start":12.407,"lines":[{"start":12.407,"end":15.031,"text":"E yo, e yo, e yo nin' Oluwa,","marked":"Ẹ yọ̀, ẹ yọ̀, ẹ yọ̀ nín Olúwa"},{"start":15.481,"end":16.034,"text":"e yo. 2ce","marked":"ẹ yọ̀."}],"end":16.034},{"key":"2","start":16.984,"lines":[{"start":16.984,"end":18.966,"text":"Ẹ yọ n'tori Oun l'Oluwa,","marked":"Ẹ yọ̀ n'torí Òun l'Olúwa"},{"start":19.416,"end":21.246,"text":"L'ayé ati l'ọrun pẹlu;","marked":"L'ayé àti l'ọ̀run pẹ̀lú"},{"start":21.696,"end":23.147,"text":"O n j'Ọba nipa asẹ Rẹ,","marked":"Ó ń j'Ọba nípa àsẹ Rẹ̀"},{"start":23.597,"end":25.058,"text":"O l'agbara lati gbala.","marked":"Ó l'agbára láti gbàlà."}],"end":25.058},{"key":"3","start":26.008,"lines":[{"start":26.008,"end":27.517,"text":"Nigba ti ogun ba gbona,","marked":"Nígbà tí ogun bá gbóná"},{"start":27.967,"end":29.469,"text":"T'ọta ba fẹrẹ sẹgun yin;","marked":"T'ọ̀tá bá fẹ́rẹ̀ sẹ́gun yín"},{"start":29.919,"end":31.834,"text":"Ogun Jesu ti a ko ri,","marked":"Ogun Jésù tí a kò rí"},{"start":32.284,"end":33.876,"text":"Pọ ju gbogbo ọta yin lọ.","marked":"Pọ̀ ju gbogbo ọ̀tá yín lọ."}],"end":33.876},{"key":"4","start":34.826,"lines":[{"start":34.826,"end":36.477,"text":"B'ọsan d'oru mọ yin loju,","marked":"B'ọ̀sán d'òru mọ́ yín lójú"},{"start":36.927,"end":38.42,"text":"T'okunkun rẹ n dẹru ba yin;","marked":"T'òkùnkùn rẹ̀ ń dẹ́rù bà yín"},{"start":38.87,"end":40.546,"text":"Ẹ ma jẹ k'ọkan yin bajẹ,","marked":"Ẹ má jẹ́ k'ọkàn yín bàjẹ́"},{"start":40.996,"end":42.746,"text":"Gbẹkẹle tit'ewu yoo tan.","marked":"Gbẹ́kẹ̀lé tít'ewu yóò tàn."}],"end":42.746},{"key":"5","start":43.696,"lines":[{"start":43.696,"end":44.79,"text":"E yo nin' Oluwa e","marked":"Ẹ yọ̀ nín Olúwa ẹ"},{"start":45.24,"end":46.637,"text":"yo E f'orin didun yin","marked":"yọ Ẹ f'orin dídùn yín"},{"start":47.087,"end":48.903,"text":"logo Fi duru, fere,","marked":"lógo Fi dùrù, fèrè"},{"start":49.353,"end":50.688,"text":"at'ohun Korin Halleluyah","marked":"at'ohun Kọrin Hallelúyà"},{"start":51.138,"end":51.809,"text":"kikan.","marked":"kíkan."}],"end":51.809}]}