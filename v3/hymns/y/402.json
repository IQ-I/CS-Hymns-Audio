{"v":3,"coll":"y","num":402,"id":"hymn_402","title":"Tori Mi at'Ihinrere","duration":67.467,"voices":{"male":{"file":"y-402-male-v3.m4a","bytes":486987,"sha256":"7d8d0026ac1abe44bb2c78d0c520a3a3f20629c828d84282d7568c5a7f615525","duration":67.5},"female":{"file":"y-402-female-v3.m4a","bytes":502500,"sha256":"e8ce30d8da8cdc602702d5248b4fdec3d57d8f4d61d81fa6d4cc7f03af1bc533","duration":67.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.734,"text":"Tori Mi at'Ihinrere,","marked":"Torí Mi àt'ìhìnrere"},{"start":2.184,"end":3.504,"text":"Ẹ lọ sọ t'irapada;","marked":"Ẹ lọ sọ t'ìràpadà"},{"start":3.954,"end":5.663,"text":"Awọn onsẹ Rẹ n ke, 'Amin'!","marked":"Àwọn òǹsẹ́ Rẹ̀ ń ké, àmín!"},{"start":6.113,"end":7.495,"text":"Tirẹ ni gbogbo ogo,","marked":"Tirẹ̀ ni gbogbo ògo"},{"start":7.945,"end":11.384,"text":"Wọn n sọ t'ibi, t'iya, t'iku","marked":"Wọ́n ń sọ t'ibi, t'ìyá, t'ikú"},{"start":11.834,"end":13.113,"text":"Ifẹ etutu nla Rẹ;","marked":"Ìfẹ́ ètùtù ńlá Rẹ"},{"start":13.563,"end":15.13,"text":"Wọn ka ohun ayé s'ofo","marked":"Wọ́n ka ohun ayé s'ọ̀fọ̀"},{"start":15.58,"end":17.041,"text":"T'ajinde oun 'jọba Rẹ.","marked":"T'àjíǹde òun 'jọba Rẹ̀."}],"end":17.041},{"key":"2","start":17.991,"lines":[{"start":17.991,"end":19.898,"text":"Gbọ, gbọ ipe ti Jubili,","marked":"Gbọ́, gbọ́ ìpè ti Jubili"},{"start":20.348,"end":21.782,"text":"O n dun yi gbogbo ayé ka;","marked":"Ó ń dùn yí gbogbo ayé ká"},{"start":22.232,"end":23.88,"text":"N'ile ati l'oju okun,","marked":"N'ilẹ̀ àti l'ojú òkun"},{"start":24.33,"end":25.525,"text":"A n tan ihin igbala,","marked":"À ń tan ìhín ìgbàlà"},{"start":25.975,"end":28.1,"text":"Bi ọjọ na ti n sunmọ'le,","marked":"Bí ọjọ́ ná ti ń súnmọ́'lé"},{"start":28.55,"end":30.102,"text":"T'ogun si n gbona janjan,","marked":"T'ogun sì ń gbóná janjan"},{"start":30.552,"end":31.937,"text":"Imọlẹ Ila-orun na,","marked":"Ìmọ́lẹ̀ Ila-orun ná"},{"start":32.387,"end":33.609,"text":"Y'o mọ larin okunkun.","marked":"Y'ó mọ́ lárin òkùnkùn."}],"end":33.609},{"key":"3","start":34.559,"lines":[{"start":34.559,"end":36.018,"text":"Siwaju ati siwaju,","marked":"Síwájú àti síwájú"},{"start":36.468,"end":38.143,"text":"La o ma gbọ Halleluyah,","marked":"La ó má gbọ́ Hallelúyà"},{"start":38.593,"end":40.063,"text":"Ijọ ajagun y'o ma yọ,","marked":"Ìjọ ajagun y'ó má yọ̀"},{"start":40.513,"end":41.861,"text":"Pẹl' awọn oku mimọ;","marked":"Pẹl' àwọn òkú mímọ́"},{"start":42.311,"end":43.763,"text":"A fọ asọ wọn n'nu ẹjẹ,","marked":"A fọ asọ̀ wọn n'nú ẹ̀jẹ̀"},{"start":44.213,"end":45.464,"text":"Duru wura wọn si n dun;","marked":"Dùrù wúrà wọ́n sì ń dùn"},{"start":45.914,"end":47.427,"text":"Ayé at'ọrun d'ohun pọ,","marked":"Ayé àt'ọ̀run d'ohun pọ̀"},{"start":47.877,"end":49.281,"text":"Wọn n kọ orin isẹgun.","marked":"Wọ́n ń kọ orin ìsẹ́gun."}],"end":49.281},{"key":"4","start":50.231,"lines":[{"start":50.231,"end":52.157,"text":"O de, Ẹni t'a n w'ọna Rẹ,","marked":"Ó dé, Ẹni t'á ń w'ọ̀nà Rẹ"},{"start":52.607,"end":53.697,"text":"Ẹni ikẹhin na de,","marked":"Ẹni ìkẹ́hìn nà dé"},{"start":54.147,"end":56.131,"text":"Immanueli t'o d'ade,","marked":"Immanueli t'ó d'adé"},{"start":56.581,"end":57.503,"text":"Oluwa awọn mimọ,","marked":"Olúwa àwọn mímọ́"},{"start":57.953,"end":60.239,"text":"Iye, Imọlẹ at'Ifẹ,","marked":"Iye, Ìmọ́lẹ̀ àt'Ìfẹ́"},{"start":60.689,"end":62.016,"text":"Mẹtalọkan titi lai;","marked":"Mẹ́talọ́kan títí láì"},{"start":62.466,"end":63.985,"text":"Tirẹ ni Itẹ Ọlọrun,","marked":"Tirẹ̀ ní Ìtẹ́ Ọlọ́run"},{"start":64.435,"end":65.918,"text":"Ati t'Ọda-aguntan.","marked":"Àti t'Ọda-aguntan."}],"end":65.918}]}