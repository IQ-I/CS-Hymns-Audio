{"v":3,"coll":"y","num":84,"id":"hymn_84","title":"EYIN Angel to wa l'orun","duration":108.239,"voices":{"male":{"file":"y-84-male-v3.m4a","bytes":782644,"sha256":"e8ea95a56f3e7013c7e6350951184e1c3a7a2e79d609a19ee1a1b17acf3f96cd","duration":108.3},"female":{"file":"y-84-female-v3.m4a","bytes":819865,"sha256":"f0b124cceea42b9ce4a7d294281b4b32f1bb1f8afde0d2fb370f4f013560fa0f","duration":108.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.913,"text":"ẸYIN Angẹl to wa l'ọrun,","marked":"Ẹ̀yin Angẹl tó wà l'ọ̀run"},{"start":2.363,"end":3.743,"text":"Ẹ fi iyin fun Baba;","marked":"Ẹ fi ìyìn fún Baba"},{"start":4.193,"end":5.747,"text":"Fun‘jọ to da silẹ layé,","marked":"Fún'jọ tó dá sílẹ̀ layé"},{"start":6.197,"end":7.23,"text":"Fun igbala ẹmi,","marked":"Fún ìgbàlà ẹ̀mí"},{"start":7.68,"end":9.053,"text":"O yẹ ki inu wa ko dun,","marked":"Ó yẹ kí inú wa kò dùn"},{"start":9.503,"end":11.072,"text":"Ki awa ki o si ma yọ!","marked":"Kí àwa kí ó sì má yọ̀!"},{"start":11.522,"end":13.102,"text":"Fun iranti iku Jesu,","marked":"Fún ìrántí ikú Jésù"},{"start":13.552,"end":14.663,"text":"Lori Agbelebu.","marked":"Lórí Àgbélébùú."},{"start":15.113,"end":16.462,"text":"A pa lasẹ l'agbala ọrun,","marked":"A pa lásẹ l'àgbàlá ọ̀run"},{"start":16.912,"end":18.636,"text":"Pe k'Ẹgbẹ yi ma bi si;","marked":"Pé k'Ẹgbẹ́ yí má bí sí"},{"start":19.086,"end":20.467,"text":"A pa lasẹ l'agbala ọrun,","marked":"A pa lásẹ l'àgbàlá ọ̀run"},{"start":20.917,"end":22.124,"text":"Pe ko si ma rẹ si;","marked":"Pé kò sì má rẹ̀ sí"},{"start":22.574,"end":24.051,"text":"Titi gbogbo ifọju ọkan,","marked":"Títí gbogbo ìfọ́jú ọkàn"},{"start":24.501,"end":25.697,"text":"Yio o fi tan layé;","marked":"Yóò ó fi tàn layé"},{"start":26.147,"end":27.58,"text":"T'iku Jesu Oluwa wa,","marked":"T'ikú Jésù Olúwa wà"},{"start":28.03,"end":29.302,"text":"Ko ni jẹ asan mọ.","marked":"Kò ní jẹ́ asán mọ́."}],"end":29.302},{"key":"CHORUS","start":30.252,"lines":[{"start":30.252,"end":32.027,"text":"A pa lase I'agbala orun","marked":"A pa láṣẹ l'àgbàlá ọ̀run"},{"start":32.477,"end":33.98,"text":"Pe k'Egbe yi ma bi si","marked":"Pé k'Ègbé yí má bí sí"},{"start":34.43,"end":35.878,"text":"A pa lase I'agbala orun","marked":"A pa láṣẹ l'àgbàlá ọ̀run"},{"start":36.328,"end":37.989,"text":"Pe O si ma re si;","marked":"Pé Ó sì má rẹ̀ sí"},{"start":38.439,"end":39.899,"text":"Titi gbogbo ifoju okan","marked":"Títí gbogbo ìfọ́jú ọkàn"},{"start":40.349,"end":41.557,"text":"Yio fi tan laiye","marked":"Yóò fi tàn láìyẹ"},{"start":42.007,"end":43.22,"text":"T'iku Jesu Oluwa wa,","marked":"T'ikú Jésù Olúwa wà"},{"start":43.67,"end":44.961,"text":"Ko ni je asan mo.","marked":"Kò ní jẹ́ asán mọ́."}],"end":44.961},{"key":"2","start":45.911,"lines":[{"start":45.911,"end":47.675,"text":"Kérúbù ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":48.125,"end":49.519,"text":"Ẹ fi iyin fun Baba;","marked":"Ẹ fi ìyìn fún Baba"},{"start":49.969,"end":51.355,"text":"Ti o da Ẹgbẹ yi silẹ,","marked":"Tí ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":51.805,"end":53.077,"text":"Pe k'a le ri igbala,","marked":"Pé k'á lè rí ìgbàlà"},{"start":53.527,"end":55.222,"text":"'Tori na, ẹ jẹ k'a mura,","marked":"torí ná, ẹ jẹ́ k'á múra"},{"start":55.672,"end":56.926,"text":"Lati sare ije yi,","marked":"Láti sáré ìje yí"},{"start":57.376,"end":58.961,"text":"Bi a ba foriti d'opin,","marked":"Bí a bá forítì d'òpin"},{"start":59.411,"end":60.69,"text":"Iye y'o jẹ tiwa.","marked":"Iye y'ó jẹ́ tiwa."}],"end":60.69},{"key":"3","start":61.64,"lines":[{"start":61.64,"end":63.669,"text":"Gbogbo isẹ wa ti a n se,","marked":"Gbogbo isẹ́ wa tí à ń ṣe"},{"start":64.119,"end":65.382,"text":"Gbogbo iwa ti a n hu,","marked":"Gbogbo ìwà tí à ń hù"},{"start":65.832,"end":67.637,"text":"Gbogbo ọrọ wa ti a n sọ,","marked":"Gbogbo ọ̀rọ̀ wa tí à ń sọ"},{"start":68.087,"end":69.228,"text":"Ẹ jẹ k'a ma sọra,","marked":"Ẹ jẹ́ k'á má sọ́ra"},{"start":69.678,"end":70.918,"text":"Nitori Oluwa yoo mu,","marked":"Nítorí Olúwa yóò mú"},{"start":71.368,"end":72.668,"text":"Gbogbo 'sẹ wa si 'dajọ,","marked":"Gbogbo 'sẹ wá sí 'dajọ"},{"start":73.118,"end":74.486,"text":"Ati gbogbo ohun 'kọkọ,","marked":"Àti gbogbo ohun 'kọkọ"},{"start":74.936,"end":76.106,"text":"Ire tabi ibi.","marked":"Ìre tàbí ibi."}],"end":76.106},{"key":"4","start":77.056,"lines":[{"start":77.056,"end":78.292,"text":"Awa ni imọlẹ ayé,","marked":"Àwa ní ìmọ́lẹ̀ ayé"},{"start":78.742,"end":80.189,"text":"Lati le okunkun lọ,","marked":"Láti lé òkùnkùn lọ"},{"start":80.639,"end":81.841,"text":"Ilu ta tẹ sori oke,","marked":"Ìlú ta tẹ́ sórí òkè"},{"start":82.291,"end":83.61,"text":"A ko le fara sin;","marked":"A kò lè fara sin"},{"start":84.06,"end":85.632,"text":"Awa si ni iyọ ayé,","marked":"Àwa sì ní iyọ̀ ayé"},{"start":86.082,"end":87.258,"text":"Ti a o mu ayé dun,","marked":"Tí a ó mú ayé dùn"},{"start":87.708,"end":89.204,"text":"Sugbọn b'iyọ ba di obu,","marked":"Sùgbọ́n b'iyọ̀ bá di obú"},{"start":89.654,"end":90.704,"text":"Bawo ni yoo se dun?","marked":"Báwo ni yóò ṣe dùn?"}],"end":90.704},{"key":"5","start":91.654,"lines":[{"start":91.654,"end":93.016,"text":"Ope lo ye Olugbala,","marked":"Ọpẹ́ ló yẹ Olùgbàlà"},{"start":93.466,"end":94.842,"text":"Fun ife to ni si wa,","marked":"Fún ìfẹ́ tó ní sí wa"},{"start":95.292,"end":96.658,"text":"Ti o pe wa si Egbe yi,","marked":"Tí ó pè wá sí Ègbé yí"},{"start":97.108,"end":98.158,"text":"Oko 'gbala 'kehin","marked":"Oko gbàlà kẹhìn"},{"start":98.608,"end":100.43,"text":"Ogo, ola at'agbara","marked":"Ògo, ọlá àt'agbára"},{"start":100.88,"end":102.195,"text":"Ola nla at'ipa","marked":"Ọlá ńlá àt'ipá"},{"start":102.645,"end":104.772,"text":"Ni fun Baba, Omo, Emi","marked":"Ní fún Baba, Ọmọ, Èmi"},{"start":105.222,"end":106.69,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":106.69}]}