{"v":3,"coll":"y","num":514,"id":"hymn_514","title":"JESU, kiki ironu Re","duration":43.728,"voices":{"male":{"file":"y-514-male-v3.m4a","bytes":307886,"sha256":"3327024fa3e2d621d1bd6d66a34a1c3e7f316bfff2328ee189f5171af1900ca4","duration":43.8},"female":{"file":"y-514-female-v3.m4a","bytes":322194,"sha256":"95d00092eeab705e50864f2773478c929a817e06913ce30246a1b7bc03f73e2d","duration":43.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.748,"text":"JESU, kiki ironu Rẹ,","marked":"Jésù, kìkì ìrònú Rẹ"},{"start":3.198,"end":4.464,"text":"Fi ayọ kun ọkan;","marked":"Fi ayọ̀ kún ọkàn"},{"start":4.914,"end":6.935,"text":"Sugbọn k'a ri Ọ lo dun ju,","marked":"Sùgbọ́n k'á rí Ọ ló dùn jù"},{"start":7.385,"end":8.738,"text":"K'a sinmi lọdọ Rẹ.","marked":"K'á sinmi lọ́dọ̀ Rẹ."}],"end":8.738},{"key":"2","start":9.688,"lines":[{"start":9.688,"end":11.978,"text":"Ẹnu ko sọ, eti ko gbọ,","marked":"Ẹnu kò sọ, etí kò gbọ́"},{"start":12.428,"end":13.704,"text":"Ko ti ọkan wa ri;","marked":"Kò tí ọkàn wa rí"},{"start":14.154,"end":16.828,"text":"Oko, t'o sọwọn, t'o dun bi","marked":"Oko, t'ó sọ̀wọ́n, t'ó dùn bí"},{"start":17.278,"end":18.433,"text":"Ti Jesu Oluwa.","marked":"Ti Jésù Olúwa."}],"end":18.433},{"key":"3","start":19.383,"lines":[{"start":19.383,"end":20.774,"text":"Ireti ọkan ti ń kanu,","marked":"Ìrètí ọkàn tí ń kanu"},{"start":21.224,"end":22.165,"text":"Olore ẹlẹsẹ,","marked":"Ọlọ́rẹ́ ẹlẹ́sẹ̀"},{"start":22.615,"end":24.021,"text":"O seun f'awọn ti ń wa Ọ,","marked":"Ó ṣeun f'àwọn tí ń wá Ọ"},{"start":24.471,"end":25.651,"text":"Awọn t'o ri Ọ yọ.","marked":"Àwọn t'ó rí Ọ yọ."}],"end":25.651},{"key":"4","start":26.601,"lines":[{"start":26.601,"end":28.447,"text":"Ayọ wọn, ẹnu ko le sọ,","marked":"Ayọ̀ wọn, ẹnu kò lè sọ"},{"start":28.897,"end":30.102,"text":"Ẹda ko le royin,","marked":"Ẹ̀dá kò lè ròyìn"},{"start":30.552,"end":32.382,"text":"Ifẹ Jesu b'o ti pọ to.","marked":"Ìfẹ́ Jésù b'ó ti pọ̀ tó."},{"start":32.832,"end":34.063,"text":"Awọn Tirẹ l'o mọ.","marked":"Àwọn Tirẹ̀ l'ó mọ́."}],"end":34.063},{"key":"5","start":35.013,"lines":[{"start":35.013,"end":37.031,"text":"Jesu, 'Wọ ma jẹ ayọ wa,","marked":"Jésù, 'Wọ má jẹ́ ayọ̀ wa"},{"start":37.481,"end":38.553,"text":"'Wọ sa ni ere wa;","marked":"'Wọ sá ni èrè wa"},{"start":39.003,"end":40.586,"text":"Ma jẹ ogo wa nisinyi,","marked":"Má jẹ́ ògo wa nísìnyí"},{"start":41.036,"end":42.179,"text":"Ati titi lailai.","marked":"Àti títí láéláé."}],"end":42.179}]}