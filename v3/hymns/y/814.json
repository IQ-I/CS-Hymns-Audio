{"v":3,"coll":"y","num":814,"id":"hymn_814","title":"JESU, Ooto, Ona","duration":61.492,"voices":{"male":{"file":"y-814-male-v3.m4a","bytes":422312,"sha256":"3f2f3fe66dfae49fa3d0c73644cd9400b2da34218ebd14be4fcdf3c66d0f09c3","duration":61.5},"female":{"file":"y-814-female-v3.m4a","bytes":445440,"sha256":"659563c912e2b6b00cba0dedf42734bd14130c4d044e550c586f4cbb6ace1e13","duration":61.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.962,"text":"JESU, Ootọ, Ọna,","marked":"Jésù, Òótọ́, Ọ̀nà"},{"start":2.412,"end":3.606,"text":"'Mọlẹ mi t'o daju,","marked":"'Mọlẹ mi t'ó dájú"},{"start":4.056,"end":5.346,"text":"Gbe ẹsẹ mi ailokun ro,","marked":"Gbé ẹsẹ̀ mi àìlókun rọ"},{"start":5.796,"end":6.854,"text":"Tọ mi s'ọna titọ.","marked":"Tọ̀ mi s'ọ́nà títọ́."}],"end":6.854},{"key":"2","start":7.804,"lines":[{"start":7.804,"end":8.964,"text":"Ọgbọn at'Amọna,","marked":"Ọgbọ́n àt'Amọ̀nà"},{"start":9.414,"end":10.434,"text":"Oludamọran mi;","marked":"Olùdámọ̀ràn mi"},{"start":10.884,"end":12.507,"text":"Ma jẹ ki n fi Ọ silẹ lai,","marked":"Má jẹ́ kí n fi Ọ́ sílẹ̀ láì"},{"start":12.957,"end":14.095,"text":"Tabi ki n sako lọ!","marked":"Tàbí kí n ṣáko lọ!"}],"end":14.095},{"key":"3","start":15.045,"lines":[{"start":15.045,"end":16.162,"text":"Mo gb'oju mi soke,","marked":"Mo gb'ojú mi sókè"},{"start":16.612,"end":18.223,"text":"Wo O, Ọd'-aguntan,","marked":"Wò Ó, Ọd'-aguntan"},{"start":18.673,"end":19.874,"text":"Ki O ba le mi l'o yẹ,","marked":"Kí Ó bá lè mi l'ó yẹ"},{"start":20.324,"end":21.666,"text":"K'oju mase ti mi.","marked":"K'ojú máṣe tì mí."}],"end":21.666},{"key":"4","start":22.616,"lines":[{"start":22.616,"end":23.973,"text":"N ki o gba ọran mi,","marked":"N kí ó gba ọ̀ràn mi"},{"start":24.423,"end":25.442,"text":"Kuro ni ọwọ Rẹ;","marked":"Kúrò ní ọwọ́ Rẹ"},{"start":25.892,"end":27.457,"text":"N ó sinmi le 'fẹ 'rapada,","marked":"N ó sinmi lè 'fẹ ràpadà"},{"start":27.907,"end":29.315,"text":"N ó rọ m'agbelebu.","marked":"N ó rọ m'àgbélébùú."}],"end":29.315},{"key":"5","start":30.265,"lines":[{"start":30.265,"end":31.288,"text":"Kọ mi ki n mọ adun,","marked":"Kọ́ mi kí n mọ adùn"},{"start":31.738,"end":32.774,"text":"Ati gbẹkẹle Ọ;","marked":"Àti gbẹ́kẹ̀lé Ọ"},{"start":33.224,"end":35.313,"text":"Jọ, Oluwa, mase ya mi,","marked":"Jọ, Olúwa, máṣe yà mi"},{"start":35.763,"end":37.243,"text":"Sugbọn fẹ mi d'opin!","marked":"Sùgbọ́n fẹ́ mi d'òpin!"}],"end":37.243},{"key":"6","start":38.193,"lines":[{"start":38.193,"end":39.285,"text":"Mu mi la 'danwo ja,","marked":"Mú mi là dánwò jà"},{"start":39.735,"end":40.837,"text":"De 'le alafia;","marked":"Dé lé àlàáfíà"},{"start":41.287,"end":42.907,"text":"Si kọ mi ni orin titun,","marked":"Sì kọ́ mi ní orin titun"},{"start":43.357,"end":44.685,"text":"'Gba mo ba di pipe.","marked":"gbà mo bá di pípé."}],"end":44.685},{"key":"7","start":45.635,"lines":[{"start":45.635,"end":46.752,"text":"Jẹ ki n le dabi Rẹ,","marked":"Jẹ́ kí n lè dàbí Rẹ"},{"start":47.202,"end":48.64,"text":"Ki n to se alaisi!","marked":"Kí n tó ṣe aláìsí!"},{"start":49.09,"end":50.571,"text":"Fi ẹsẹ mi mulẹ sinsin,","marked":"Fi ẹsẹ̀ mi múlẹ̀ ṣinṣin"},{"start":51.021,"end":52.398,"text":"Ki n dagba n'nu ifẹ.","marked":"Kí n dàgbà n'nú ìfẹ́."}],"end":52.398},{"key":"8","start":53.348,"lines":[{"start":53.348,"end":54.556,"text":"Jẹ ki n j'ẹlẹri Rẹ,","marked":"Jẹ́ kí n j'ẹlẹ́rí Rẹ"},{"start":55.006,"end":56.18,"text":"'Gba t'ẹsẹ ba run tan;","marked":"gbà t'ẹsẹ̀ bá run tán"},{"start":56.63,"end":58.087,"text":"Gba ọkan mi ailabawọn,","marked":"Gba ọkàn mi àìlàbàwọ́n"},{"start":58.537,"end":59.943,"text":"K'O si mu mi d'ọrun.","marked":"K'Ó sì mú mi d'ọ̀run."}],"end":59.943}]}