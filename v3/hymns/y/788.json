{"v":3,"coll":"y","num":788,"id":"hymn_788","title":"OGO OBA wa ti po to","duration":41.663,"voices":{"male":{"file":"y-788-male-v3.m4a","bytes":287553,"sha256":"5c0489d221466fc2e2c630c1748dcc12bd507f26a5263571be62e48c0b0baf94","duration":41.7},"female":{"file":"y-788-female-v3.m4a","bytes":294231,"sha256":"f067597417b04b0cfe3911464b955b9855911731127bc22c8566aff78130aeba","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.942,"text":"OGO OBA wa ti po to","marked":"Ògo Ọba wa ti pọ̀ tó"},{"start":2.392,"end":3.764,"text":"Ti mbe l'oke orun,","marked":"Ti mbẹ́ l'òkè ọ̀run"},{"start":4.214,"end":5.77,"text":"Omo-kekere wo l'o le,","marked":"Omo-kekere wo l'ó lé"},{"start":6.22,"end":7.296,"text":"Korin ola 'nla Re.","marked":"Kọrin ọlá ńlá Rẹ."}],"end":7.296},{"key":"2","start":8.246,"lines":[{"start":8.246,"end":9.955,"text":"Ta l'o le rohin ipa Rẹ,","marked":"Ta l'ó lè ròhìn ipá Rẹ̀"},{"start":10.405,"end":11.486,"text":"At' ore-ọfẹ Rẹ,","marked":"Àt ore-ọfẹ Rẹ"},{"start":11.936,"end":13.785,"text":"Ko s'ẹnikan l'ayé l'ọrun,","marked":"Kò s'ẹnìkan l'ayé l'ọ̀run"},{"start":14.235,"end":15.329,"text":"T'o mọ titobi wọn","marked":"T'ó mọ títóbi wọn"}],"end":15.329},{"key":"3","start":16.279,"lines":[{"start":16.279,"end":18.149,"text":"Angẹli t'o yi Oluwa ka,","marked":"Áńgẹ́lì t'ó yí Olúwa ká"},{"start":18.599,"end":19.741,"text":"Ko jẹ sọ 'tumọ rẹ,","marked":"Kò jẹ́ sọ 'tumọ rẹ̀"},{"start":20.191,"end":21.852,"text":"Sugbọn wọn n pa asẹ rẹ mọ,","marked":"Sùgbọ́n wọ́n ń pa àsẹ rẹ̀ mọ́"},{"start":22.302,"end":23.448,"text":"Wọn si n kọrin 'yin Rẹ","marked":"Wọ́n sì ń kọrin yìn Rẹ̀"}],"end":23.448},{"key":"4","start":24.398,"lines":[{"start":24.398,"end":26.351,"text":"Njẹ mo fẹ ma ba wọn kọrin,","marked":"Ǹjẹ́ mo fẹ́ má bá wọn kọrin"},{"start":26.801,"end":28.061,"text":"Ki n m'ọrẹ temi wa,","marked":"Kí n m'ọrẹ tèmi wá"},{"start":28.511,"end":30.309,"text":"Ọga-Ogo ki y'o kẹgan,","marked":"Ọga-Ogo kí y'ó kẹ́gàn"},{"start":30.759,"end":31.707,"text":"Ohun orin ewe.","marked":"Ohun orin èwe."}],"end":31.707},{"key":"5","start":32.657,"lines":[{"start":32.657,"end":34.846,"text":"Mura, ọkan at'ahọn mi,","marked":"Múra, ọkàn àt'ahọ́n mi"},{"start":35.296,"end":36.326,"text":"Lati kọrin iyin,","marked":"Láti kọrin ìyìn"},{"start":36.776,"end":38.23,"text":"S'Olodumare Ẹlẹda.","marked":"S'Olódùmarè Ẹlẹda."},{"start":38.68,"end":40.114,"text":"Ayọ aw' Angeli.","marked":"Ayọ̀ àw Áńgẹ́lì."}],"end":40.114}]}