{"v":3,"coll":"y","num":167,"id":"hymn_167","title":"EDUMARE Jah Jehovah","duration":79.229,"voices":{"male":{"file":"y-167-male-v3.m4a","bytes":568499,"sha256":"4f29b5e3154dd5779fcbff96c055c845d696e49e7faf7eac68493ae990a7a83e","duration":79.3},"female":{"file":"y-167-female-v3.m4a","bytes":579295,"sha256":"7633f0b725784d565edd18552fc37f452d304b2839343f32076217999295fde1","duration":79.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.009,"text":"EDUMARE Jah Jehovah","marked":"Èdúmarè Jah Jehovah"},{"start":2.459,"end":3.513,"text":"OBA Onibu-Ore","marked":"Ọba Onibu-ore"},{"start":3.963,"end":5.264,"text":"Mo mu ope mi wa fun O","marked":"Mo mú ọpẹ́ mi wá fún Ọ"},{"start":5.714,"end":14.057,"text":"Mo wa jewo ore Re. Wa Olugbohun, Tẹwọ gbohun ẹbẹ mi, Baba mo wa d'opo Rẹ mu, F'oyin s'ayé fun mi.","marked":"Mo wá jẹ́wọ́ ọ̀rẹ́ Rẹ. Wá Olùgbóhùn, Tẹ́wọ́ gbóhùn ẹ̀bẹ̀ mi, Baba mo wá d'òpọ̀ Rẹ̀ mú, F'oyin s'ayé fún mi."}],"end":14.057},{"key":"CHORUS","start":15.007,"lines":[{"start":15.007,"end":15.909,"text":"Wa Olugbohun","marked":"Wá Olùgbóhùn"},{"start":16.359,"end":17.435,"text":"Tewogb'ohun ebe mi","marked":"Tẹwọ́gb'ohun ẹ̀bẹ̀ mi"},{"start":17.885,"end":19.314,"text":"Baba mo wa d'opo Re mu","marked":"Baba mo wá d'òpó Rẹ̀ mú"},{"start":19.764,"end":21.144,"text":"F'oyin s'aiye fun mi.","marked":"F'oyin s'ayé fún mi."}],"end":21.144},{"key":"2","start":22.094,"lines":[{"start":22.094,"end":23.643,"text":"Edumare Jah Jehovah,","marked":"Èdúmarè Jah Jehovah"},{"start":24.093,"end":25.319,"text":"Rẹ mi lẹkun layé mi;","marked":"Rẹ̀ mí lẹ́kun layé mi"},{"start":25.769,"end":27.273,"text":"Mase jẹ ki ọta yọ mi,","marked":"Mase jẹ́ kí ọ̀tá yọ mí"},{"start":27.723,"end":28.91,"text":"Gbe mi leke isoro.","marked":"Gbé mi lékè ìṣòro."}],"end":28.91},{"key":"3","start":29.86,"lines":[{"start":29.86,"end":31.652,"text":"Edumare Jah Jehovah,","marked":"Èdúmarè Jah Jehovah"},{"start":32.102,"end":33.279,"text":"Ko s'alabaro fun mi;","marked":"Kò s'alábàrò fún mi"},{"start":33.729,"end":35.282,"text":"Mo ko aniyan mi tọ Ọ wa,","marked":"Mo kó àníyàn mi tọ̀ Ọ́ wà"},{"start":35.732,"end":37.234,"text":"Majẹ k'ayé r'idi mi.","marked":"Májẹ̀ k'ayé r'ìdí mi."}],"end":37.234},{"key":"4","start":38.184,"lines":[{"start":38.184,"end":39.728,"text":"Edumare Jah Jehovah","marked":"Èdúmarè Jah Jehovah"},{"start":40.178,"end":41.224,"text":"Fun mi n'ibale okan","marked":"Fún mi n'ìbàlẹ̀ ọkàn"},{"start":41.674,"end":43.47,"text":"Mase je ki ile le mi","marked":"Mase jẹ́ kí ilẹ̀ lè mi"},{"start":43.92,"end":45.787,"text":"Mase je k'ona na mi.","marked":"Mase jẹ́ k'ọ̀nà nà mí."}],"end":45.787},{"key":"5","start":46.737,"lines":[{"start":46.737,"end":48.18,"text":"Edumare Jah Jehovah,","marked":"Èdúmarè Jah Jehovah"},{"start":48.63,"end":50.015,"text":"Jẹ k'awọn 'mọ wa tun la;","marked":"Jẹ́ k'àwọn 'mọ wá tún là"},{"start":50.465,"end":51.735,"text":"Awọn agan ń wo Ọ loju,","marked":"Àwọn àgàn ń wò Ọ́ lójú"},{"start":52.185,"end":53.604,"text":"F'ọmọ rere jinki wọn.","marked":"F'ọmọ rere jìǹkí wọn."}],"end":53.604},{"key":"6","start":54.554,"lines":[{"start":54.554,"end":56.124,"text":"Edumare Jah Jehovah,","marked":"Èdúmarè Jah Jehovah"},{"start":56.574,"end":57.606,"text":"Se ayé mi ni rere;","marked":"Ṣe ayé mi ní rere"},{"start":58.056,"end":60.225,"text":"Gba mi lọwọ oso, ajẹ,","marked":"Gbà mí lọ́wọ́ ọ̀ṣọ́, àjẹ́"},{"start":60.675,"end":62.254,"text":"Ma fi mi t'ọrẹ f'esu.","marked":"Má fi mí t'ọrẹ f'eṣú."}],"end":62.254},{"key":"7","start":63.204,"lines":[{"start":63.204,"end":64.813,"text":"Edumare Jah Jehovah,","marked":"Èdúmarè Jah Jehovah"},{"start":65.263,"end":66.579,"text":"Bukun wa tile-tona","marked":"Bùkún wà tile-tona"},{"start":67.029,"end":68.558,"text":"S'opo at'asa Ijo wa,","marked":"S'ọ́pọ̀ àt'àṣà Ìjọ wà"},{"start":69.008,"end":77.68,"text":"Bukun wa kari-kari. Wa Olugbohun, Tẹwọ gbohun ẹbẹ mi, Baba mo wa d'opo Rẹ mu, F'oyin s'ayé fun mi.","marked":"Bùkún wa kari-kari. Wá Olùgbóhùn, Tẹ́wọ́ gbóhùn ẹ̀bẹ̀ mi, Baba mo wá d'òpó Rẹ̀ mú, F'oyin s'ayé fún mi."}],"end":77.68}]}