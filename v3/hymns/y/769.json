{"v":3,"coll":"y","num":769,"id":"hymn_769","title":"JESU Oluwa ni 'se","duration":74.879,"voices":{"male":{"file":"y-769-male-v3.m4a","bytes":528980,"sha256":"b2b995a72acd2acb85820418cae5d1a7bb9c9154085fef74cf486781d0367e90","duration":74.9},"female":{"file":"y-769-female-v3.m4a","bytes":549485,"sha256":"04e13f8811d85cb5f956a69c3561aa60bf0c1368b7f2ab5d43fb3acdb53ee976","duration":74.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.587,"text":"JESU Oluwa ni 'se","marked":"Jésù Olúwa ni ṣe"},{"start":2.037,"end":3.066,"text":"Ipilẹ Ijọ Rẹ;","marked":"Ìpìlẹ̀ Ìjọ Rẹ"},{"start":3.516,"end":4.752,"text":"Omi ati ọrọ Rẹ,","marked":"Omi àti ọ̀rọ̀ Rẹ"},{"start":5.202,"end":6.806,"text":"Ni Oun si fi tun da;","marked":"Ni Òun sì fi tún dá"},{"start":7.256,"end":8.995,"text":"O t'ọrun wa, O fi se,","marked":"Ó t'ọ̀run wá, Ó fi ṣe"},{"start":9.445,"end":10.396,"text":"Iyawo mimọ Rẹ:","marked":"Ìyàwó mímọ́ Rẹ"},{"start":10.846,"end":12.37,"text":"Ẹjẹ Rẹ l'O si fi ra,","marked":"Ẹ̀jẹ̀ Rẹ̀ l'Ó sì fi rà"},{"start":12.82,"end":13.929,"text":"Ti O si ku fun u.","marked":"Tí Ó sì kú fún u."}],"end":13.929},{"key":"2","start":14.879,"lines":[{"start":14.879,"end":16.074,"text":"N'ile gbogbo l'a sa wọn,","marked":"N'ilé gbogbo l'a sá wọn"},{"start":16.524,"end":17.648,"text":"Sugbọn wọn jẹ ọkan,","marked":"Sùgbọ́n wọ́n jẹ́ ọkàn"},{"start":18.098,"end":19.755,"text":"Oluwa kan, 'gbagbọ kan,","marked":"Olúwa kan, 'gbagbọ kan"},{"start":20.205,"end":21.414,"text":"Ati baptisi kan;","marked":"Àti baptisi kan"},{"start":21.864,"end":23.088,"text":"Orukọ kan ni wọn yin","marked":"Orúkọ kan ni wọ́n yín"},{"start":23.538,"end":24.675,"text":"Ounjẹ kan ni wọn n jẹ,","marked":"Oúnjẹ kan ni wọ́n ń jẹ"},{"start":25.125,"end":26.647,"text":"Opin kan ni wọn n lepa,","marked":"Òpin kan ni wọ́n ń lépa"},{"start":27.097,"end":28.177,"text":"Nipa ore-ọfẹ.","marked":"Nípa ore-ọfẹ."}],"end":28.177},{"key":"3","start":29.127,"lines":[{"start":29.127,"end":30.951,"text":"Bi ayé tilẹ n kẹgan,","marked":"Bí ayé tilẹ̀ ń kẹ́gàn"},{"start":31.401,"end":32.582,"text":"Gba t'iyọnu de ba ;","marked":"Gba t'ìyọnu dé bá"},{"start":33.032,"end":34.463,"text":"Bi 'ja oun ẹkọ-kẹ-kọọ,","marked":"Bí já òun ẹkọ-kẹ-kọọ"},{"start":34.913,"end":36.033,"text":"Ba mu iyapa wa,","marked":"Bá mú ìyapa wá"},{"start":36.483,"end":38.093,"text":"Awọn mimọ yoo ma ke,","marked":"Àwọn mímọ́ yóò má ké"},{"start":38.543,"end":39.968,"text":"Wi pé y'o ti pẹ to?","marked":"Wí pé y'ó ti pẹ́ tó?"},{"start":40.418,"end":41.723,"text":"Oru ẹkun fẹrẹ di,","marked":"Òru ẹkún fẹ́rẹ́ di"},{"start":42.173,"end":43.246,"text":"Oorọ orin ayọ.","marked":"Oorọ orin ayọ̀."}],"end":43.246},{"key":"4","start":44.196,"lines":[{"start":44.196,"end":45.294,"text":"L'arin gbogbo 'banujẹ,","marked":"L'árín gbogbo 'banujẹ"},{"start":45.744,"end":47.069,"text":"At' iyọnu ayé,","marked":"Àt ìyọnu ayé"},{"start":47.519,"end":48.713,"text":"O n reti ọjọ 'kẹhin,","marked":"Ó ń retí ọjọ́ 'kẹhin"},{"start":49.163,"end":50.303,"text":"Alafia lailai;","marked":"Àlàáfíà láéláé"},{"start":50.753,"end":52.27,"text":"Titi y'o f'oju rẹ ri,","marked":"Títí y'ó f'ojú rẹ̀ rí"},{"start":52.72,"end":53.607,"text":"Iran ologo na,","marked":"Ìran ológo ná"},{"start":54.057,"end":55.355,"text":"Ti ijọ nla asẹgun,","marked":"Tí ìjọ ńlá asẹ́gun"},{"start":55.805,"end":57.567,"text":"Y'o d'ijọ ti n sinmi.","marked":"Y'ó d'ìjọ tí ń sinmi."}],"end":57.567},{"key":"5","start":58.517,"lines":[{"start":58.517,"end":60.486,"text":"L'ayé, yi o ni 'dapọ,","marked":"L'ayé, yí ó ní 'dapọ"},{"start":60.936,"end":62.103,"text":"Pẹlu Mẹtalọkan!","marked":"Pẹ̀lú Mẹ́talọ́kan!"},{"start":62.553,"end":64.029,"text":"O si ni 'dapọ didun;","marked":"Ó sì ní 'dapọ dídùn"},{"start":64.479,"end":65.897,"text":"Pẹl' awọn t'o ti sun;","marked":"Pẹl' àwọn t'ó ti sùn"},{"start":66.347,"end":67.898,"text":"A! alabukun mimọ!","marked":"A! alábùkún mímọ́!"},{"start":68.348,"end":69.72,"text":"Oluwa, fi fun wa,","marked":"Olúwa, fi fún wa"},{"start":70.17,"end":71.517,"text":"Ka ba le ri bi awọn,","marked":"Ká bá lè rí bí àwọn"},{"start":71.967,"end":73.33,"text":"Ka ba Ọ gbe 'lọrun.","marked":"Ká bá Ọ gbé 'lọrun."}],"end":73.33}]}