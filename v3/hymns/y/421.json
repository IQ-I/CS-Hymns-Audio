{"v":3,"coll":"y","num":421,"id":"hymn_421","title":"WO bi awa eniyan Re","duration":41.393,"voices":{"male":{"file":"y-421-male-v3.m4a","bytes":287992,"sha256":"486af524a4bca22cff43070ecad153cd80f00b59fe30a45c371e996e74484573","duration":41.4},"female":{"file":"y-421-female-v3.m4a","bytes":296144,"sha256":"ecd0a09daf49a04e80884bf2050df9157cfc8964c134528a7b2e73734da091d4","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.531,"text":"WO bi awa eniyan Rẹ","marked":"Wo bí àwa ènìyàn Rẹ"},{"start":1.981,"end":3.479,"text":"Ti wolẹ l'ẹsẹ Rẹ;","marked":"Ti wólẹ̀ l'ẹsẹ̀ Rẹ"},{"start":3.929,"end":5.912,"text":"Ọlọrun! kiki anu Rẹ,","marked":"Ọlọ́run! kìkì àánú Rẹ"},{"start":6.362,"end":7.393,"text":"Ni igbẹkẹle wa .","marked":"Ní ìgbẹ́kẹ̀lé wa ."}],"end":7.393},{"key":"2","start":8.343,"lines":[{"start":8.343,"end":9.702,"text":"Idajọ t'o ba ni lẹru,","marked":"Ìdájọ́ t'ó bá ní lẹ́rù"},{"start":10.152,"end":11.475,"text":"N fi agbara Rẹ han;","marked":"Ń fi agbára Rẹ̀ hàn"},{"start":11.925,"end":13.335,"text":"Sibẹ anu da 'lu wa si,","marked":"Síbẹ̀ àánú dá lù wá sí"},{"start":13.785,"end":15.133,"text":"Awa si n gbadura.","marked":"Àwa sì ń gbàdúrà."}],"end":15.133},{"key":"3","start":16.083,"lines":[{"start":16.083,"end":17.965,"text":"Ọlọrun, o se da wa si,","marked":"Ọlọ́run, ó ṣe dá wa sí"},{"start":18.415,"end":19.369,"text":"Awa alaimore?","marked":"Àwa aláìmọ́rẹ́?"},{"start":19.819,"end":22.116,"text":"Jọ, jẹ k'a gbọ ikilọ Rẹ,","marked":"Jọ, jẹ́ k'á gbọ́ ìkìlọ̀ Rẹ"},{"start":22.566,"end":23.955,"text":"Nigba ti anu wa.","marked":"Nígbà tí àánú wà."}],"end":23.955},{"key":"4","start":24.905,"lines":[{"start":24.905,"end":26.273,"text":"Iwa buburu ti pọ to,","marked":"Ìwà búburú ti pọ̀ tó"},{"start":26.723,"end":28.013,"text":"Yika ile wa yi!","marked":"Yíká ilẹ̀ wa yí!"},{"start":28.463,"end":30.023,"text":"Buburu ilẹ wa lo to 'yi;","marked":"Búburú ilẹ̀ wa ló tó yí"},{"start":30.473,"end":31.854,"text":"Wo b'o ti buru to.","marked":"Wò b'ó ti burú tó."}],"end":31.854},{"key":"5","start":32.804,"lines":[{"start":32.804,"end":34.446,"text":"Oluwa, fi ore-ofe","marked":"Olúwa, fi oore-ọ̀fẹ́"},{"start":34.896,"end":36.033,"text":"Yi wa lokan pada!","marked":"Yí wá lọ́kàn padà!"},{"start":36.483,"end":37.965,"text":"Ki a le gba oro Re gbo","marked":"Kí a lè gba ọ̀rọ̀ Rẹ gbọ́"},{"start":38.415,"end":39.843,"text":"K'a si wa oju Re.","marked":"K'á sì wá ojú Rẹ."}],"end":39.843}]}