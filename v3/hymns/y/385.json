{"v":3,"coll":"y","num":385,"id":"hymn_385","title":"EMI Mimo 'Daba orun","duration":35.506,"voices":{"male":{"file":"y-385-male-v3.m4a","bytes":250649,"sha256":"ed3e41c339d49f426a963008b699ab4612e90216cd12ca49901cfa68e9f2aa1d","duration":35.6},"female":{"file":"y-385-female-v3.m4a","bytes":255269,"sha256":"b179e8b70e974f9ae91ac00233cbcd1b705ff52ad8f9c3802115c46c9dc965d4","duration":35.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.493,"text":"EMI Mimo 'Daba orun","marked":"Ẹ̀mí Mímọ́ dàbà ọ̀run"},{"start":1.943,"end":3.396,"text":"Wa mu itunu sokale","marked":"Wá mú ìtùnú sọ̀kalẹ̀"},{"start":3.846,"end":5.634,"text":"Se Oga at'Oluto wa,","marked":"Ṣe Ọ̀gá àt'olùtọ́ wa"},{"start":6.084,"end":7.597,"text":"Ma pelu gbogbo ero wa.","marked":"Má pẹ̀lú gbogbo èrò wa."}],"end":7.597},{"key":"2","start":8.547,"lines":[{"start":8.547,"end":9.967,"text":"Jo, fi Otito Re han wa","marked":"Jọ, fi Òtítọ́ Rẹ hàn wá"},{"start":10.417,"end":11.816,"text":"K'a le fe k'a si m'ona Re","marked":"K'á lè fẹ́ k'á sí m'ọ̀nà Rẹ"},{"start":12.266,"end":13.678,"text":"Gbin ife toto s'okan wa","marked":"Gbin ìfẹ́ tọ́tọ̀ s'ọkàn wa"},{"start":14.128,"end":15.514,"text":"K'a ma le pada lehin Re.","marked":"K'á má lè padà lẹ́hìn Rẹ."}],"end":15.514},{"key":"3","start":16.464,"lines":[{"start":16.464,"end":17.999,"text":"Mu wa k'a tọ ọna mimọ;","marked":"Mú wa k'á tọ ọ̀nà mímọ́"},{"start":18.449,"end":19.938,"text":"T'a le gba d'ọdọ Ọlọrun;","marked":"T'a lè gbà d'ọ̀dọ̀ Ọlọ́run"},{"start":20.388,"end":22.572,"text":"Mu wa to Krist, Ọna Iye,","marked":"Mú wa tó Krist, Ọ̀nà Ìyè"},{"start":23.022,"end":24.682,"text":"Ma jẹ ki awa sina lọ.","marked":"Má jẹ́ kí àwa ṣìnà lọ."}],"end":24.682},{"key":"4","start":25.632,"lines":[{"start":25.632,"end":26.909,"text":"Mu wa t'Ọlọrun 'sinmi wa,","marked":"Mú wa t'Ọlọ́run sinmi wa"},{"start":27.359,"end":29.147,"text":"K'a le ma ba gbe titi lai;","marked":"K'á lè má bá gbé títí láì"},{"start":29.597,"end":32.177,"text":"Tọ wa wa s'ọrun, k'a le n'ipin,","marked":"Tọ̀ wá wá s'ọ̀run, k'á lè n'ìpín"},{"start":32.627,"end":33.957,"text":"L'ọwọ ọtun Ọlọrun wa.","marked":"L'ọ́wọ́ ọ̀tún Ọlọ́run wa."}],"end":33.957}]}