{"v":3,"coll":"y","num":689,"id":"hymn_689","title":"IPILE ti Jesu fi le'le l'eyi","duration":64.694,"voices":{"male":{"file":"y-689-male-v3.m4a","bytes":469416,"sha256":"4953cb459d91d7edf2225ebc31cf13e0027ae5f3fb73f1e6f87fbb0b054bbbad","duration":64.7},"female":{"file":"y-689-female-v3.m4a","bytes":477202,"sha256":"54bb47ebe4f88fab76fe5911a918d4e80ada8b45dc1a868c70a93d7d2f799254","duration":64.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.814,"text":"IPILẸ ti Jesu fi le'lẹ l'eyi","marked":"Ìpìlẹ̀ tí Jésù fi lé'lẹ́ l'èyí"},{"start":3.264,"end":4.818,"text":"Ti Baba Aladura n tọ,","marked":"Tí Baba Aládúrà ń tọ́"},{"start":5.268,"end":6.553,"text":"K'ẹda mase ro pe,","marked":"K'ẹ̀dà máṣe rò pé"},{"start":7.003,"end":10.097,"text":"O yẹ kuro nibẹ, o duro le Krist' apata.","marked":"Ó yẹ kúrò níbẹ̀, ó dúró lé Krist àpáta."}],"end":10.097},{"key":"CHORUS","start":11.047,"lines":[{"start":11.047,"end":13.263,"text":"Kerubu E yo, Serafu ẹ","marked":"Kérúbù Ẹ yọ̀, Séráfù ẹ"},{"start":13.713,"end":16.271,"text":"yọ, A fi pile lele lori otito (2)","marked":"yọ̀, A fi pilẹ̀ lélẹ̀ lórí òtítọ́"}],"end":16.271},{"key":"2","start":17.221,"lines":[{"start":17.221,"end":19.509,"text":"Bi ara n san ẹgbagbeje ohun,","marked":"Bí ara ń san ẹgbàgbèje ọ̀hún"},{"start":19.959,"end":21.743,"text":"Ọmọ Jesu yoo duro ti,","marked":"Ọmọ Jésù yóò dúró ti"},{"start":22.193,"end":23.988,"text":"K'eniyan ma kẹgan ọkọ Noa,","marked":"K'ènìyàn má kẹ́gàn ọkọ Noa"},{"start":24.438,"end":26.028,"text":"Oko refo ọmọ Jesu la.","marked":"Ọkọ̀ rẹ̀fọ̀ ọmọ Jésù là."}],"end":26.028},{"key":"3","start":26.978,"lines":[{"start":26.978,"end":30.28,"text":"A ro‘jọ mọ Stephen, a ro'jọ mọ Peter,","marked":"A rò'jọ̀ mọ́ Stephen, a rò'jọ̀ mọ́ Peter"},{"start":30.73,"end":32.775,"text":"A ro‘jọ mọ Jesu Oluwa,","marked":"A rò'jọ̀ mọ́ Jésù Olúwa"},{"start":33.225,"end":35.107,"text":"A ro‘jọ mọ Mose Orimọlade,","marked":"A rò'jọ̀ mọ́ Mósè Orímọ́ládé"},{"start":35.557,"end":37.362,"text":"K'ẹda k'o kiyes' ara.","marked":"K'ẹ̀dà k'ó kíyès ara."}],"end":37.362},{"key":"4","start":38.312,"lines":[{"start":38.312,"end":40.034,"text":"Baba Aladura dide damure,","marked":"Baba Aládúrà dìde dàmúrè"},{"start":40.484,"end":42.489,"text":"Lati pade awọn Kérúbù,","marked":"Láti pàdé àwọn Kérúbù"},{"start":42.939,"end":45.104,"text":"Ọlọrun ti yin isẹ Rẹ lat'oke wa,","marked":"Ọlọ́run ti yin isẹ́ Rẹ̀ lát'òkè wá"},{"start":45.554,"end":47.298,"text":"Ade iye yoo jẹ tirẹ.","marked":"Adé ìyè yóò jẹ́ tirẹ̀."}],"end":47.298},{"key":"5","start":48.248,"lines":[{"start":48.248,"end":50.973,"text":"B'ayé mbu Mose, awọn Angeli n fẹ,","marked":"B'ayé mbú Mósè, àwọn Áńgẹ́lì ń fẹ́"},{"start":51.423,"end":52.915,"text":"Ọlọrun Abraham n fẹ,","marked":"Ọlọ́run Abraham ń fẹ́"},{"start":53.365,"end":54.996,"text":"Awọn Ogun Ọrun si n gbadura rẹ,","marked":"Àwọn Ogun Ọ̀run sì ń gbàdúrà rẹ̀"},{"start":55.446,"end":56.539,"text":"Ọlọrun Mẹtalọkan.","marked":"Ọlọ́run Mẹ́talọ́kan."}],"end":56.539},{"key":"CHORUS-5","start":57.489,"lines":[{"start":57.489,"end":60.188,"text":"Kérúbù ẹ yọ, Séráfù ẹ yọ,","marked":"Kérúbù ẹ yọ, Séráfù ẹ yọ"},{"start":60.638,"end":63.145,"text":"A f' ipilẹ lelẹ lori otitọ (2)","marked":"A f ìpìlẹ̀ lélẹ̀ lórí òtítọ́"}],"end":63.145}]}