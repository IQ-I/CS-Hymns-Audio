{"v":3,"coll":"y","num":118,"id":"hymn_118","title":"EWE ti Oba orun","duration":81.855,"voices":{"male":{"file":"y-118-male-v3.m4a","bytes":579534,"sha256":"95f5817ab59b2e9d06779f8a7b1b1fe94ff183c4c0086a783ce7148e1fdc7e2f","duration":81.9},"female":{"file":"y-118-female-v3.m4a","bytes":600741,"sha256":"04215d7cd53774e1b0b3ebef0d192f2201007848e6db79daa9cb4a3b74885bab","duration":81.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.468,"text":"EWE ti Oba orun,","marked":"Èwe ti Ọba ọ̀run"},{"start":1.918,"end":3.013,"text":"Korin didun be ti n","marked":"Kọrin dídùn bẹ ti ń"},{"start":3.463,"end":4.308,"text":"lọ; Korin 'yin","marked":"lọ; Kọrin yín"},{"start":4.758,"end":13.993,"text":"Olugbala Ologo 'nu ise Re. A n lọ'le sọdọ Ọlọrun Lọna t'awọn Baba rin; Wọn si n yọ; nisinsin yii, Ayọ wọn l'awa o ri.","marked":"Olùgbàlà Ológo nu iṣẹ́ Rẹ̀. A ń lọ'lé sọ́dọ̀ Ọlọ́run Lọ́nà t'àwọn Baba rìn; Wọ́n sì ń yọ̀; nísinsin yìí, Ayọ̀ wọn l'àwa ó rí."}],"end":13.993},{"key":"CHORUS","start":14.943,"lines":[{"start":14.943,"end":16.444,"text":"A nlo 'le sodo Olorun","marked":"A ńlọ lè sọ́dọ̀ Ọlọ́run"},{"start":16.894,"end":17.985,"text":"Lona t'awon Baba rin","marked":"Lọ́nà t'àwọn Baba rìn"},{"start":18.435,"end":20.221,"text":"Nwon si nyo: nisisiyi","marked":"Wọ́n sì nyọ̀: níṣísíyì"},{"start":20.671,"end":21.968,"text":"Ayo won l'awa o ri.","marked":"Ayọ̀ wọn l'àwa ó rí."}],"end":21.968},{"key":"2","start":22.918,"lines":[{"start":22.918,"end":24.359,"text":"A n lọ sọdọ Ọlọrun,","marked":"À ń lọ sọ́dọ̀ Ọlọ́run"},{"start":24.809,"end":25.974,"text":"Lọna t'awọn Baba rin;","marked":"Lọ́nà t'àwọn Baba rìn"},{"start":26.424,"end":28.819,"text":"Wọn si n yọ; nisinsin yii,","marked":"Wọ́n sì ń yọ̀; nísinsin yìí"},{"start":29.269,"end":30.643,"text":"Ayọ wọn l'awa o ri.","marked":"Ayọ̀ wọn l'àwa ó rí."}],"end":30.643},{"key":"3","start":31.593,"lines":[{"start":31.593,"end":33.289,"text":"Kọrin agbo kekere,","marked":"Kọrin agbo kékeré"},{"start":33.739,"end":35.046,"text":"Ẹ o sinmi n'itẹ Rẹ;","marked":"Ẹ ò sinmi n'ìtẹ́ Rẹ"},{"start":35.496,"end":37.004,"text":"'Bit'a pese 'joko yin,","marked":"bít'a pèsè jókò yín"},{"start":37.454,"end":38.968,"text":"Ibẹ si n' ijọba yin.","marked":"Ibẹ̀ sì ń ìjọba yín."}],"end":38.968},{"key":"4","start":39.918,"lines":[{"start":39.918,"end":41.447,"text":"W'Oke, ọmọ imọlẹ,","marked":"W'Òkè, ọmọ ìmọ́lẹ̀"},{"start":41.897,"end":43.096,"text":"Ilu Sion wa lọọkan;","marked":"Ìlú Sion wà lọ́ọ̀kan"},{"start":43.546,"end":44.838,"text":"Ibẹ n'ile wa titi,","marked":"Ibẹ̀ n'ilẹ̀ wà títí"},{"start":45.288,"end":46.729,"text":"Ibẹ l'a o r'Oluwa.","marked":"Ibẹ̀ l'a ó r'Olúwa."}],"end":46.729},{"key":"5","start":47.679,"lines":[{"start":47.679,"end":49.394,"text":"Kérúbù, tẹsiwaju,","marked":"Kérúbù, tẹ̀síwájú"},{"start":49.844,"end":51.94,"text":"Séráfù, ma jafara,","marked":"Séráfù, má jáfara"},{"start":52.39,"end":54.245,"text":"Kristi Ọmọ Baba n wi,","marked":"Kristi Ọmọ Baba ń wí"},{"start":54.695,"end":56.207,"text":"Pe laifoya ka ma lọ.","marked":"Pé láìfòyà ká má lọ."}],"end":56.207},{"key":"6","start":57.157,"lines":[{"start":57.157,"end":59.283,"text":"Jesu, a n lọ l'asẹ Rẹ,","marked":"Jésù, à ń lọ l'àsẹ Rẹ"},{"start":59.733,"end":61.068,"text":"A kọ'hun gbogbo sile;","marked":"A kọ́'hùn gbogbo sílẹ̀"},{"start":61.518,"end":62.685,"text":"Iwọ ma j'amọna wa,","marked":"Ìwọ má j'amọ̀nà wá"},{"start":63.135,"end":64.466,"text":"A o si ma ba ọ lọ.","marked":"A ó sì má bá ọ lọ."}],"end":64.466},{"key":"7","start":65.416,"lines":[{"start":65.416,"end":66.556,"text":"A f'ogo fun Baba wa,","marked":"A f'ògo fún Baba wa"},{"start":67.006,"end":68.229,"text":"A f'ogo fun Omo Re;","marked":"A f'ògo fún Ọmọ Rẹ"},{"start":68.679,"end":69.892,"text":"Ogo ni f'Emi Mimo,","marked":"Ògo ni f'Ẹ̀mí Mímọ́"},{"start":70.342,"end":71.895,"text":", Mu wa de'le ayo naa.","marked":"Mú wa dé'lé ayọ̀ náà."},{"start":72.345,"end":74.793,"text":"A n lọ'le sodo Olorun. Lọna","marked":"A ń lọ'lé sọ́dọ̀ Ọlọ́run. Lọ́nà"},{"start":75.243,"end":80.306,"text":"t'awọn Baba rin; Wọn si n yọ; nisinsin yii, Ayọ wọn l'awa o ri.","marked":"t'àwọn Baba rìn; Wọ́n sì ń yọ̀; nísinsin yìí, Ayọ̀ wọn l'àwa ó rí."}],"end":80.306}]}