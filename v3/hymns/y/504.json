{"v":3,"coll":"y","num":504,"id":"hymn_504","title":"AW' OMO ogun Oba ti a f'eje Re ra","duration":65.823,"voices":{"male":{"file":"y-504-male-v3.m4a","bytes":487235,"sha256":"f1323ac5b90ccd4afcd5f369b9857f324d00a32693077112f64d2ec7d3d25d1e","duration":65.9},"female":{"file":"y-504-female-v3.m4a","bytes":502282,"sha256":"a25c7904f3847de9673847d56d79e1ca957802a2893acdf79e4e6c993b49bb47","duration":65.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.507,"text":"AWA omo ogun Oba ti a f'eje Re ra","marked":"Àwa ọmọ ogun Ọba tí a f'ẹ̀jẹ̀ Rẹ̀ rà"},{"start":2.957,"end":5.233,"text":"A si mura lati jagun fun Kristi Oluwa","marked":"A sì múra láti jagun fún Kristi Olúwa"},{"start":5.683,"end":7.55,"text":"A ngb'arin ota wa, sugbon","marked":"A ńgb'arin ọ̀tá wa, ṣùgbọ́n"},{"start":8.0,"end":9.373,"text":"A nf'ayo korin","marked":"A ńf'ayọ̀ kọrin"},{"start":9.823,"end":11.511,"text":"Okan wa yio duro gbonyin-gbonyin.","marked":"Ọkàn wa yóò dúró gbonyin-gbonyin."},{"start":11.961,"end":13.438,"text":"Egbe:  Awa omo ogun Oba","marked":"Àwa ọmọ ogun Ọba"},{"start":13.888,"end":14.873,"text":"A o korin iyin Re","marked":"A ó kọrin ìyìn Rẹ̀"},{"start":15.323,"end":16.844,"text":"A o si ja tokan‐tokan","marked":"A ó sì jà tokan-tokan"},{"start":17.294,"end":18.564,"text":"F'Oba Ologo julo.","marked":"F'Ọba Ológo jùlọ."}],"end":18.564},{"key":"CHORUS","start":19.514,"lines":[{"start":19.514,"end":20.655,"text":"Awa omo ogun Oba","marked":"Àwa ọmọ ogun Ọba"},{"start":21.105,"end":22.227,"text":"A o korin iyin Re","marked":"A ó kọrin ìyìn Rẹ̀"},{"start":22.677,"end":24.143,"text":"A o si ja tokan‐tokan","marked":"A ó sì jà tokan-tokan"},{"start":24.593,"end":25.975,"text":"F'Oba Ologo julo.","marked":"F'Ọba Ológo jùlọ."}],"end":25.975},{"key":"2","start":26.925,"lines":[{"start":26.925,"end":29.949,"text":"Aw'omo ogun Oba, a o f'ayo j'oko Re","marked":"Àw'ọmọ ogun Ọba, a ó f'ayọ̀ j'oko Rẹ̀"},{"start":30.399,"end":32.293,"text":"O ko eniti a kan mo 'gi","marked":"Ó kó ẹnìtí a kan mọ́ gi"},{"start":32.743,"end":34.545,"text":"Gba Kristi Oba wa mbe","marked":"Gba Kristi Ọba wá mbẹ́"},{"start":34.995,"end":37.282,"text":"Adanu l'ere aiye ao f'ayo gba iya","marked":"Àdánù l'èrè ayé àò f'ayọ̀ gba ìyá"},{"start":37.732,"end":40.61,"text":"Lati bowo f'oruko Re, b' omo ogun Oba.","marked":"Láti bọ̀wọ̀ f'orúkọ Rẹ, b ọmọ ogun Ọba."},{"start":41.06,"end":42.119,"text":"Egbe:  Awa omo ogun Oba...","marked":"Àwa ọmọ ogun Ọba"}],"end":42.119},{"key":"3","start":43.069,"lines":[{"start":43.069,"end":46.016,"text":"Awa omo ogun Oba, ao jade pelu Re","marked":"Àwa ọmọ ogun Ọba, àó jáde pẹ̀lú Rẹ̀"},{"start":46.466,"end":49.417,"text":"Bi awa ba le jiya, k'a si ru itiju","marked":"Bí àwa bá lè jìyà, k'á sì ru ìtìjú"},{"start":49.867,"end":52.37,"text":"K'a gb'asia Re ga, 'tori akoko nlo","marked":"K'á gb'àsíá Rẹ̀ ga, torí àkókò ńlọ"},{"start":52.82,"end":54.473,"text":"A ti gba ade nsunmole","marked":"A ti gba adé ńsúnmọ́lẹ̀"},{"start":54.923,"end":56.052,"text":"F'awon omo ogun Oba.","marked":"F'àwọn ọmọ ogun Ọba."},{"start":56.502,"end":57.823,"text":"Egbe:  Awa omo ogun Oba","marked":"Àwa ọmọ ogun Ọba"},{"start":58.273,"end":59.37,"text":"A o korin iyin Re","marked":"A ó kọrin ìyìn Rẹ̀"},{"start":59.82,"end":61.324,"text":"A o si ja tokan‐tokan","marked":"A ó sì jà tokan-tokan"},{"start":61.774,"end":63.233,"text":"F'Oba Ologo julo.","marked":"F'Ọba Ológo jùlọ."},{"start":63.683,"end":64.274,"text":"Amin.","marked":"Àmín."}],"end":64.274}]}