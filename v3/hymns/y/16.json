{"v":3,"coll":"y","num":16,"id":"hymn_16","title":"OLUWA, ojo t'o fun wa pin","duration":47.853,"voices":{"male":{"file":"y-16-male.m4a","bytes":346340,"sha256":"656251d791b895300e68391a7f5fbc09825c7ba7ca0aed99c0dce7d58749b832","duration":47.9},"female":{"file":"y-16-female.m4a","bytes":359540,"sha256":"a8ebc87d007e1b279a49525fa46ef3cb269303968cef0a5e4c99e385bf3777f0","duration":47.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.96,"text":"OLUWA, ojo t'o fun wa pin","marked":"Olúwa, ọjọ́ t'ó fún wa pín"},{"start":2.34,"end":3.716,"text":"Okunkun si de l'ase Re,","marked":"Òkùnkùn sì dé l'àsè Rẹ"},{"start":4.096,"end":5.824,"text":"'Wo l'a korin owuro wa si,","marked":"'Wò l'á kọrin òwúrọ̀ wa sí"},{"start":6.204,"end":7.885,"text":"Iyin Re y'o m'ale wa dun.","marked":"Ìyìn Rẹ̀ y'ó m'álẹ̀ wa dùn."}],"end":7.885},{"key":"2","start":8.835,"lines":[{"start":8.835,"end":11.042,"text":"A dupe ti Ijo Re ko nsun,","marked":"A dúpẹ́ tí Ìjọ Rẹ̀ kò ńsùn"},{"start":11.422,"end":13.331,"text":"B'aiye ti nyi lo s'imole","marked":"B'aiye ti nyi lọ s'ìmọ́lẹ̀̀"},{"start":13.711,"end":16.064,"text":"O si nsona ti gbogbo aiye","marked":"Ó sì ńṣọ́nà ti gbogbo aiye"},{"start":16.444,"end":17.96,"text":"Ko simi tosan-toru.","marked":"Kò símí tọ̀sán-tòru."}],"end":17.96},{"key":"3","start":18.91,"lines":[{"start":18.91,"end":20.818,"text":"B'ile si ti mo lojujumo","marked":"B'ilẹ̀ sì ti mọ́ lojujumo"},{"start":21.198,"end":22.802,"text":"Ni orile at'ekusu","marked":"Ní orílẹ̀ àt'èkùṣù"},{"start":23.182,"end":24.487,"text":"Ohun adura ko dake ri,","marked":"Ohun àdúrà kò dákẹ́ rí"},{"start":24.867,"end":26.335,"text":"Be l'orin iyin ko dekun.","marked":"Bẹ́ l'orin ìyìn kò dẹkùn."}],"end":26.335},{"key":"4","start":27.285,"lines":[{"start":27.285,"end":29.325,"text":"Orun t'o wo fun wa, si ti la","marked":"Ọ̀run t'ó wọ̀ fún wa, sì ti là"},{"start":29.705,"end":30.891,"text":"S'awon eda iwo-orun","marked":"S'àwọn ẹ̀dá ìwò-ọ̀run"},{"start":31.271,"end":33.244,"text":"Nigbakugba li enu si nso","marked":"Nígbàkugbà li ẹnu sí ǹṣó"},{"start":33.624,"end":34.929,"text":"Ise 'yanu Re di mimo.","marked":"Iṣẹ́ 'yanu Rẹ̀ di mímọ́́."}],"end":34.929},{"key":"5","start":35.879,"lines":[{"start":35.879,"end":38.042,"text":"Be, Oluwa, lai n'ijoba Re,","marked":"Bẹ̀, Olúwa, láì ń'ìjọba Rẹ̀"},{"start":38.422,"end":39.988,"text":"Ko dabi ijoba aiye","marked":"Kò dàbí ìjọba aiye"},{"start":40.368,"end":42.953,"text":"O duro, o si nse akoso","marked":"Ó dúró, ó sì ńṣe àkóso"},{"start":43.333,"end":45.316,"text":"Tit' eda Re o juba Re.","marked":"Tít' ẹ̀dà Rẹ ò júbà Rẹ."},{"start":45.696,"end":46.303,"text":"Amin.","marked":"Àmín."}],"end":46.303}]}