{"v":3,"coll":"y","num":116,"id":"hymn_116","title":"EMI ba n'egberun ahon","duration":46.681,"voices":{"male":{"file":"y-116-male-v3.m4a","bytes":322853,"sha256":"ed80850ac5480e8983150d444aa5f01630070444d8efda3ce422afc9c6c5ba7b","duration":46.7},"female":{"file":"y-116-female-v3.m4a","bytes":327114,"sha256":"71f5918e3d1338bb362cb9f912ebedda83887c7d18384122a6ff45d21a8f6675","duration":46.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.783,"text":"EMI ba n'ẹgbẹrun ahọn,","marked":"Èmi bá n'ẹgbẹ̀rún ahọ́n"},{"start":2.233,"end":3.213,"text":"Fun 'yin Olugbala;","marked":"Fún yin Olùgbàlà"},{"start":3.663,"end":5.223,"text":"Ogo Ọlọrun, Ọba mi,","marked":"Ògo Ọlọ́run, Ọba mi"},{"start":5.673,"end":6.911,"text":"Isẹgun ore Rẹ.","marked":"Ìsẹ́gun ọrẹ Rẹ."}],"end":6.911},{"key":"2","start":7.861,"lines":[{"start":7.861,"end":9.33,"text":"Jesu t'O s'eru wa d'ayo","marked":"Jésù t'Ó s'ẹrù wá d'ayọ̀"},{"start":9.78,"end":10.906,"text":"T'o mu banuje tan","marked":"T'ó mú banújẹ́ tán"},{"start":11.356,"end":12.621,"text":"Orin ni l'eti elese","marked":"Orin ní l'etí ẹlẹ́ṣẹ̀"},{"start":13.071,"end":14.339,"text":"Iye at'ilera.","marked":"Iye àt'ìlera."}],"end":14.339},{"key":"3","start":15.289,"lines":[{"start":15.289,"end":16.622,"text":"O sẹgun agbara ẹsẹ,","marked":"Ó sẹ́gun agbára ẹsẹ̀"},{"start":17.072,"end":18.17,"text":"O da onde silẹ;","marked":"Ó dá òǹdè sílẹ̀"},{"start":18.62,"end":19.805,"text":"Ẹjẹ Rẹ le w'eleri mọ,","marked":"Ẹ̀jẹ̀ Rẹ̀ lè w'ẹlẹ́rí mọ́"},{"start":20.255,"end":21.259,"text":"Ẹjẹ Rẹ seun fun mi.","marked":"Ẹ̀jẹ̀ Rẹ ṣeun fún mi."}],"end":21.259},{"key":"4","start":22.209,"lines":[{"start":22.209,"end":23.415,"text":"O sọrọ oku gb'ohun Rẹ,","marked":"Ó sọ̀rọ̀ òkú gb'ohùn Rẹ̀"},{"start":23.865,"end":25.152,"text":"O gba ẹmi titun;","marked":"Ó gba ẹ̀mí titun"},{"start":25.602,"end":26.879,"text":"Onirobinujẹ y'ayọ,","marked":"Oníròbìnújẹ́ y'ayọ̀"},{"start":27.329,"end":28.703,"text":"Otosi si gbagbọ.","marked":"Òtòṣì sì gbàgbọ́."}],"end":28.703},{"key":"5","start":29.653,"lines":[{"start":29.653,"end":31.238,"text":"Odi, e korin iyin Re,","marked":"Odi, ẹ kọrin ìyìn Rẹ̀"},{"start":31.688,"end":33.158,"text":"Aditi, gb'ohun Re","marked":"Adití, gb'ohùn Rẹ̀"},{"start":33.608,"end":35.507,"text":"Afoju, Olugbala de,","marked":"Afọ́jú, Olùgbàlà dé"},{"start":35.957,"end":37.741,"text":"Ayaro, fo f'ayo.","marked":"Àyàrò, fò f'ayọ̀."}],"end":37.741},{"key":"6","start":38.691,"lines":[{"start":38.691,"end":40.1,"text":"Baba mi at'Ọlọrun mi,","marked":"Baba mi àt'Ọlọ́run mi"},{"start":40.55,"end":41.541,"text":"Fun mi n'iranwọ Rẹ;","marked":"Fún mi n'ìrànwọ́ Rẹ"},{"start":41.991,"end":43.673,"text":"Ki n le ro ka gbogbo ayé,","marked":"Kí n lè rò ká gbogbo ayé"},{"start":44.123,"end":45.132,"text":"Ọla Orukọ Rẹ.","marked":"Ọlá Orúkọ Rẹ̀."}],"end":45.132}]}