{"v":3,"coll":"y","num":332,"id":"hymn_332","title":"MO wi fun olukuluku","duration":41.695,"voices":{"male":{"file":"y-332-male-v3.m4a","bytes":286079,"sha256":"bfd0c6bec95d79e755a2c2587b6153deb793212b03f218d3187d7b4047d4b767","duration":41.7},"female":{"file":"y-332-female-v3.m4a","bytes":298144,"sha256":"cb88d8469f91eafc0a3c3f85a2f2e0d4fb7a2e1ba34e42c8304f6763b6953ddf","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.677,"text":"MO wi fun olukuluku,","marked":"Mo wí fún olúkúlùkù"},{"start":2.127,"end":4.129,"text":"Pe, Oun ji, O si ye;","marked":"Pé, Òun jí, Ó sì yẹ"},{"start":4.579,"end":5.933,"text":"O si wa larin wa pẹlu,","marked":"Ó sì wà lárin wa pẹ̀lú"},{"start":6.383,"end":7.351,"text":"Nipa Ẹmi iye.","marked":"Nípa Ẹ̀mí ìyè."}],"end":7.351},{"key":"2","start":8.301,"lines":[{"start":8.301,"end":9.783,"text":"Ẹ wi fun ẹnikeji yin,","marked":"Ẹ wí fún ẹnìkejì yín"},{"start":10.233,"end":11.359,"text":"Ki wọn ji pẹlu wa,","marked":"Kí wọn jí pẹ̀lú wa"},{"start":11.809,"end":13.424,"text":"K'imọlẹ k'o wa kakiri,","marked":"K'ìmọ́lẹ̀ k'ó wà kákiri"},{"start":13.874,"end":14.999,"text":"Ni gbogbo ayé wa.","marked":"Ní gbogbo ayé wà."}],"end":14.999},{"key":"3","start":15.949,"lines":[{"start":15.949,"end":17.649,"text":"Nisinsin yii ayé yi ri,","marked":"Nísinsin yìí ayé yí rí"},{"start":18.099,"end":19.326,"text":"Bi ile Baba wa;","marked":"Bí ilé Baba wa"},{"start":19.776,"end":21.82,"text":"Iye titun ti Oun fun ni,","marked":"Iye titun tí Òun fún ni"},{"start":22.27,"end":23.664,"text":"O sọ d'ile Baba.","marked":"Ó sọ d'ilé Baba."}],"end":23.664},{"key":"4","start":24.614,"lines":[{"start":24.614,"end":26.099,"text":"Ọna okun ti Oun ti rin,","marked":"Ọ̀nà òkun tí Òun ti rìn"},{"start":26.549,"end":27.724,"text":"Mu ni lọ si ọrun:","marked":"Mú ni lọ sí ọ̀run"},{"start":28.174,"end":29.811,"text":"Ẹni t'o rin bi Oun ti rin,","marked":"Ẹni t'ó rìn bí Òun ti rìn"},{"start":30.261,"end":31.834,"text":"Y'o d'ọdọ Rẹ l'ọrun","marked":"Y'ó d'ọ̀dọ̀ Rẹ l'ọ̀run"}],"end":31.834},{"key":"5","start":32.784,"lines":[{"start":32.784,"end":35.144,"text":"Oun ye, O si wa pẹlu wa,","marked":"Òun yẹ, Ó sì wà pẹ̀lú wa"},{"start":35.594,"end":36.625,"text":"Ni gbogbo ayé yi:","marked":"Ní gbogbo ayé yí"},{"start":37.075,"end":38.53,"text":"Ati nigba ti a f'ara wa,","marked":"Àti nígbà tí a f'ara wa"},{"start":38.98,"end":40.146,"text":"F'erupẹ ni 'reti.","marked":"F'erùpẹ̀ ni retí."}],"end":40.146}]}