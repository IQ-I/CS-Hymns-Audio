{"v":3,"coll":"y","num":120,"id":"hymn_120","title":"JI, Okan mi, dide layo","duration":61.947,"voices":{"male":{"file":"y-120-male-v3.m4a","bytes":442032,"sha256":"9c2e97ddf420918d59b9f41a7f5b7d767d42d1c2a3f2ba301774f648c2442bb7","duration":62.0},"female":{"file":"y-120-female-v3.m4a","bytes":453814,"sha256":"a462fe84e8d161824ec62cf960dbc2f7b0bfeede2a4c3f34eda98fec4f387198","duration":62.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.267,"text":"JI, Okan mi, dide layo","marked":"Jí, Ọkàn mi, dìde láyọ̀"},{"start":2.717,"end":3.76,"text":"Korin iyin Olugbala","marked":"Kọrin ìyìn Olùgbàlà"},{"start":4.21,"end":5.43,"text":"Ola Re bere orin mi","marked":"Ọlá Rẹ bẹ̀rẹ̀ orin mi"},{"start":5.88,"end":7.281,"text":"Seun ife Re ti po to!","marked":"Seun ìfẹ́ Rẹ̀ ti pọ̀ tó!"}],"end":7.281},{"key":"2","start":8.231,"lines":[{"start":8.231,"end":9.814,"text":"O ri mo segbe n'isubu,","marked":"Ó rí mo ṣègbé n'ìṣubú"},{"start":10.264,"end":12.236,"text":"Sibẹ, O fẹ mi l'afẹtan;","marked":"Síbẹ̀, Ó fẹ́ mi l'àfẹ̀tàn"},{"start":12.686,"end":14.016,"text":"O yọ mi ninu osi mi,","marked":"Ó yọ mí nínú òsì mi"},{"start":14.466,"end":16.262,"text":"'Seun ifẹ Rẹ ti tobi to!","marked":"seun ìfẹ́ Rẹ ti tóbi tó!"}],"end":16.262},{"key":"3","start":17.212,"lines":[{"start":17.212,"end":18.54,"text":"Ogun ọta dide si mi,","marked":"Ogun ọ̀tá dìde sí mi"},{"start":18.99,"end":20.887,"text":"Ayé at'Esu n de'na mi,","marked":"Ayé àt'èṣù ń dẹ̀'nà mi"},{"start":21.337,"end":22.675,"text":"Oun n mu mi la gbogbo rẹ ja,","marked":"Òun ń mú mi la gbogbo rẹ̀ jà"},{"start":23.125,"end":24.698,"text":"'Seun ifẹ Rẹ ti n'ipa to!","marked":"seun ìfẹ́ Rẹ̀ ti n'ipa tó!"}],"end":24.698},{"key":"4","start":25.648,"lines":[{"start":25.648,"end":27.744,"text":"'Gba 'yọnu de, b'awọsanma,","marked":"gba 'yọnu dé, b'àwọsánmà"},{"start":28.194,"end":30.619,"text":"T'o su dudu t'o n san ara;","marked":"T'ó ṣú dúdú t'ó ń san ara"},{"start":31.069,"end":32.301,"text":"O duro ti mi larin rẹ,","marked":"Ó dúró tì mí lárin rẹ̀"},{"start":32.751,"end":34.419,"text":"'Seun ifẹ Rẹ ti dara to!","marked":"ṣeun ìfẹ́ Rẹ ti dára tó!"}],"end":34.419},{"key":"5","start":35.369,"lines":[{"start":35.369,"end":36.95,"text":"'Gba gbogbo l'ọkan ẹsẹ mi,","marked":"gba gbogbo l'ọkàn ẹsẹ̀ mi"},{"start":37.4,"end":38.748,"text":"N fẹ ya lẹhin Oluwa mi;","marked":"Ń fẹ́ ya lẹ́hìn Olúwa mi"},{"start":39.198,"end":40.602,"text":"Sugbọn bi mo ti n gbagbe Rẹ,","marked":"Sùgbọ́n bí mo ti ń gbàgbé Rẹ̀"},{"start":41.052,"end":42.867,"text":"Iseun ifẹ Rẹ ki yẹ.","marked":"Ìṣeun ìfẹ́ Rẹ̀ kì yẹ̀."}],"end":42.867},{"key":"6","start":43.817,"lines":[{"start":43.817,"end":45.285,"text":"Mo fẹrẹ f'ayé silẹ na,","marked":"Mo fẹ́rẹ̀ f'ayé sílẹ̀ ná"},{"start":45.735,"end":47.299,"text":"Mo fẹ bọ lọw'ara iku;","marked":"Mo fẹ́ bọ́ lọ́w'àrá ikú"},{"start":47.749,"end":49.334,"text":"A! k'emi kẹhin mi kọrin","marked":"A! k'èmi kẹ́hìn mi kọrin"},{"start":49.784,"end":51.055,"text":"Iseun ifẹ Rẹ n'iku.","marked":"Ìṣeun ìfẹ́ Rẹ̀ n'ikú."}],"end":51.055},{"key":"7","start":52.005,"lines":[{"start":52.005,"end":54.188,"text":"Njẹ ki n fo lọ, ki n si goke,","marked":"Ǹjẹ́ kí n fò lọ, kí n sì gòkè"},{"start":54.638,"end":56.641,"text":"S'ayé imọlẹ titi lai;","marked":"S'ayé ìmọ́lẹ̀ títí láì"},{"start":57.091,"end":58.774,"text":"Ki n f'ayọ iyanu kọrin,","marked":"Kí n f'ayọ̀ ìyanu kọrin"},{"start":59.224,"end":60.398,"text":"Iseun ifẹ Rẹ lọrun.","marked":"Ìṣeun ìfẹ́ Rẹ̀ lọ́rùn."}],"end":60.398}]}