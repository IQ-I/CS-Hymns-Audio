{"v":3,"coll":"y","num":233,"id":"hymn_233","title":"ESE won ti da to","duration":38.661,"voices":{"male":{"file":"y-233-male-v3.m4a","bytes":264317,"sha256":"4aadf6718b761040e5434a0f64c7dba23bb92fedeed030e952eb49a83842aad8","duration":38.7},"female":{"file":"y-233-female-v3.m4a","bytes":267642,"sha256":"0df070edecda2820fd3324550f5e1a3cf014145e444ca37417e7f802b276f6cc","duration":38.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.656,"text":"ẸSẸ wọn ti da to!","marked":"Ẹsẹ̀ wọn ti dá tó!"},{"start":2.106,"end":3.213,"text":"Ti n duro ni Sion;","marked":"Tí ń dúró ní Sion"},{"start":3.663,"end":5.014,"text":"Awọn t'o mu 'hin gbala wa,","marked":"Àwọn t'ó mú hín gbàlà wá"},{"start":5.464,"end":6.649,"text":"Awọn t'o f'ayọ han","marked":"Àwọn t'ó f'ayọ̀ hàn"}],"end":6.649},{"key":"2","start":7.599,"lines":[{"start":7.599,"end":8.617,"text":"Ohun wọn ti wọ to!","marked":"Ohun wọn ti wọ́ tó!"},{"start":9.067,"end":10.18,"text":"Ihin naa ti dun to!","marked":"Ìhín náà ti dùn tó!"},{"start":10.63,"end":12.152,"text":"Sion, w'Ọlọrun Ọba rẹ","marked":"Sion, w'Ọlọ́run Ọba rẹ̀"},{"start":12.602,"end":13.664,"text":"B'o ti sẹgun nihin.","marked":"B'ó ti sẹ́gun níhìn."}],"end":13.664},{"key":"3","start":14.614,"lines":[{"start":14.614,"end":15.737,"text":"Eti wa ti yọ to!","marked":"Etí wa tí yọ́ tó!"},{"start":16.187,"end":17.292,"text":"Lati gbọrọ ayọ;","marked":"Láti gbọ́rọ̀ ayọ̀"},{"start":17.742,"end":19.698,"text":"Woli, Ọba, ti duro de,","marked":"Wòlí, Ọba, ti dúró dé"},{"start":20.148,"end":21.609,"text":"Wọn wa, wọn ko si ri.","marked":"Wọ́n wá, wọn kò sì rí."}],"end":21.609},{"key":"4","start":22.559,"lines":[{"start":22.559,"end":23.688,"text":"Oju wa ti yọ to!","marked":"Ojú wa tí yọ tó!"},{"start":24.138,"end":25.306,"text":"T'o ri 'mọlẹ ọrun;","marked":"T'ó rí 'mọlẹ ọ̀run"},{"start":25.756,"end":27.982,"text":"Ọba, Woli, wọn wa titi,","marked":"Ọba, Wòlí, wọ́n wà títí"},{"start":28.432,"end":30.151,"text":"Wọn si ku, wọn ko ri.","marked":"Wọ́n sì kú, wọn kò rí."}],"end":30.151},{"key":"5","start":31.101,"lines":[{"start":31.101,"end":32.643,"text":"Oluwa, f'ipa han;","marked":"Olúwa, f'ipá hàn"},{"start":33.093,"end":34.035,"text":"Lori gbogbo ayé;","marked":"Lórí gbogbo ayé"},{"start":34.485,"end":35.582,"text":"Ki gbogbo orilẹ ede,","marked":"Kí gbogbo orílẹ̀ èdè"},{"start":36.032,"end":37.112,"text":"W'Ọba Ọlọrun won.","marked":"W'Ọba Ọlọ́run wọn."}],"end":37.112}]}