{"v":3,"coll":"y","num":821,"id":"hymn_821","title":"E JE K'A yin Olugbala","duration":52.604,"voices":{"male":{"file":"y-821-male-v3.m4a","bytes":381516,"sha256":"c6a5c424b40d25f5be0fd59ddc4d9dd91da2041192512f7ccdd9ac2cab186df8","duration":52.7},"female":{"file":"y-821-female-v3.m4a","bytes":393577,"sha256":"1f55b9c2f72b7ba543ea3086601d82e37f64f9b01a30142c1caf7af365b1a5e9","duration":52.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.602,"text":"Ẹ JẸ K'A yin Olùgbàlà,","marked":"Ẹ Jẹ́ K'A yin Olùgbàlà"},{"start":2.052,"end":3.538,"text":"T'o da Ẹmi wa si di oni,","marked":"T'ó dá Ẹ̀mí wa sì di òní"},{"start":3.988,"end":5.371,"text":"Nitori a ko mọ ọjọ,","marked":"Nítorí a kò mọ ọjọ́"},{"start":5.821,"end":7.335,"text":"T'o mbọ wa se 'dajọ ayé;","marked":"T'ó mbọ̀ wá ṣe 'dajọ ayé"},{"start":7.785,"end":9.601,"text":"Ọjọ kan mbọ 'gba ayé ba pin,","marked":"Ọjọ́ kan mbọ́ gba ayé bá pín"},{"start":10.051,"end":12.21,"text":"Kérúbù yoo kọ'rin Aleluya.","marked":"Kérúbù yóò kọ́'rin Alelúyà."}],"end":12.21},{"key":"2","start":13.16,"lines":[{"start":13.16,"end":14.387,"text":"Ọjọ 'dajọ ọjọ ẹru,","marked":"Ọjọ́ 'dajọ ọjọ́ ẹrú"},{"start":14.837,"end":16.732,"text":"'Gba Jesu yoo ya Àgùntàn Rẹ,","marked":"gba Jésù yóò ya Àgùntàn Rẹ̀"},{"start":17.182,"end":18.58,"text":"Kuro ninu agbo esu;","marked":"Kúrò nínú agbo èṣù"},{"start":19.03,"end":20.965,"text":"'Gbana ipe nla yoo si dun,","marked":"gbàná ìpè ńlá yóò sì dùn"},{"start":21.415,"end":23.726,"text":"Gbogbo ayé yoo wa si idajọ,","marked":"Gbogbo ayé yóò wá sí ìdájọ́"},{"start":24.176,"end":26.406,"text":"Séráfù yoo kọ'rin Aleluya.","marked":"Séráfù yóò kọ́'rin Alelúyà."}],"end":26.406},{"key":"3","start":27.356,"lines":[{"start":27.356,"end":28.791,"text":"Awọn ẹlẹsẹ yoo fẹ sa,","marked":"Àwọn ẹlẹ́sẹ̀ yóò fẹ́ sá"},{"start":29.241,"end":30.511,"text":"Kuro niwaju Olùgbàlà,","marked":"Kúrò níwájú Olùgbàlà"},{"start":30.961,"end":32.54,"text":"Sugbọn iye ko ni si mọ,","marked":"Sùgbọ́n iye kò ní sí mọ́"},{"start":32.99,"end":34.359,"text":"Wọn yoo ke gba mi Oluwa,","marked":"Wọn yóò ké gbà mi Olúwa"},{"start":34.809,"end":36.538,"text":"Sugbọn ọjọ anu kọja,","marked":"Sùgbọ́n ọjọ́ àánú kọjá"},{"start":36.988,"end":39.058,"text":"Kérúbù yoo ma kọ Aleluya.","marked":"Kérúbù yóò má kọ Alelúyà."}],"end":39.058},{"key":"4","start":40.008,"lines":[{"start":40.008,"end":41.593,"text":"Ara mi jẹ k'a gba adura,","marked":"Ara mi jẹ́ k'á gba àdúrà"},{"start":42.043,"end":43.238,"text":"S'Ọlọrun Mẹtalọkan,","marked":"S'Ọlọ́run Mẹ́talọ́kan"},{"start":43.688,"end":45.292,"text":"Tori oun lo da ayé,","marked":"Torí òun ló dá ayé"},{"start":45.742,"end":46.96,"text":"Ati gbogbo ẹda 'nu rẹ,","marked":"Àti gbogbo ẹ̀dá nù rẹ̀"},{"start":47.41,"end":48.943,"text":"Yoo si ko awọn Tirẹ jọ,","marked":"Yóò sì kó àwọn Tirẹ̀ jọ"},{"start":49.393,"end":51.055,"text":"Lati ma kọrin niwaju itẹ.","marked":"Láti má kọrin níwájú ìtẹ́."}],"end":51.055}]}