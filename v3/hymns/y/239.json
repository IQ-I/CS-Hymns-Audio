{"v":3,"coll":"y","num":239,"id":"hymn_239","title":"JESU, agbara mi","duration":59.289,"voices":{"male":{"file":"y-239-male-v3.m4a","bytes":411258,"sha256":"bcbeb7723956df96c847577be159c11bdf80ec5bb209fd4d4bef71ca87b34188","duration":59.3},"female":{"file":"y-239-female-v3.m4a","bytes":434382,"sha256":"c85807037025cf5cc505a69f7d3737ff80c9d16f3b5b0234a8254ca2a9667b12","duration":59.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.475,"text":"JESU, agbara mi,","marked":"Jésù, agbára mi"},{"start":2.925,"end":3.969,"text":"Iwọ l'aniyan mi,","marked":"Ìwọ l'àníyàn mi"},{"start":4.419,"end":5.79,"text":"Emi fi igbagbọ woke;","marked":"Èmi fi ìgbàgbọ́ wòkè"},{"start":6.24,"end":7.323,"text":"Iwọ l'o n gbadura,","marked":"Ìwọ l'ó ń gbàdúrà"},{"start":7.773,"end":8.776,"text":"Jẹ ki n duro de Ọ,","marked":"Jẹ́ kí n dúró dé Ọ"},{"start":9.226,"end":10.379,"text":"Ki n le se ifẹ Rẹ,","marked":"Kí n lè ṣe ìfẹ́ Rẹ"},{"start":10.829,"end":11.981,"text":"Ki iwọ Olodumare,","marked":"Kí ìwọ Olódùmarè"},{"start":12.431,"end":13.872,"text":"K'o sọ mi di ọtun.","marked":"K'ó sọ mí di ọ̀tún."}],"end":13.872},{"key":"2","start":14.822,"lines":[{"start":14.822,"end":15.858,"text":"Fun mi l'ọkan 'rẹlẹ,","marked":"Fún mi l'ọkàn 'rẹlẹ"},{"start":16.308,"end":17.546,"text":"Ti 'ma sẹ ara rẹ;","marked":"Tí má sẹ́ ara rẹ"},{"start":17.996,"end":20.427,"text":"Ti n tẹmọlẹ, ti ko naani,","marked":"Tí ń tẹ̀mọ́lẹ̀, tí kò náání"},{"start":20.877,"end":22.062,"text":"Ikẹkun Satani;","marked":"Ìkẹ́kùn Sátánì"},{"start":22.512,"end":23.562,"text":"Ọkan t'ara rẹ mọ,","marked":"Ọkàn t'ara rẹ̀ mọ́"},{"start":24.012,"end":25.065,"text":"Irora at'isẹ;","marked":"Ìrora àt'isẹ́"},{"start":25.515,"end":27.423,"text":"T'o n fi suuru at' igboya","marked":"T'ó ń fi sùúrù àt ìgboyà"},{"start":27.873,"end":29.105,"text":"Ru agbelebu rẹ.","marked":"Rú àgbélébùú rẹ."}],"end":29.105},{"key":"3","start":30.055,"lines":[{"start":30.055,"end":30.98,"text":"Fun mi l'ẹru ọrun,","marked":"Fún mi l'ẹ̀rù ọ̀run"},{"start":31.43,"end":32.559,"text":"Oju to mu hanhan;","marked":"Ojú tó mú hànhàn"},{"start":33.009,"end":34.467,"text":"T' yo wo Ọ n gb'ẹsẹ sunmọle,","marked":"T yó wó Ọ ń gb'ẹsẹ̀ súnmọ́lè"},{"start":34.917,"end":36.379,"text":"K'o ri b'Esu ti n sa;","marked":"K'ó rí b'Èṣù tí ń sá"},{"start":36.829,"end":37.995,"text":"Fun mi ni ẹmi ni,","marked":"Fún mi ni ẹ̀mí ni"},{"start":38.445,"end":39.579,"text":"T'o ti pese tẹlẹ;","marked":"T'ó ti pèsè tẹ́lẹ̀"},{"start":40.029,"end":41.464,"text":"Ẹmi t'o n duro gangan lai","marked":"Ẹ̀mí t'ó ń dúró gangan láì"},{"start":41.914,"end":43.392,"text":"T'o n f'adura sọna.","marked":"T'ó ń f'àdúrà sọ́nà."}],"end":43.392},{"key":"4","start":44.342,"lines":[{"start":44.342,"end":45.621,"text":"Mo gbẹkẹl' ọrọ Rẹ,","marked":"Mo gbẹkẹl' ọ̀rọ̀ Rẹ"},{"start":46.071,"end":47.329,"text":"'Wọ l'o leri fun mi;","marked":"'Wọ l'ó lérí fún mi"},{"start":47.779,"end":49.193,"text":"Iranwọ at'igbala mi,","marked":"Ìrànwọ́ àt'ìgbàlà mi"},{"start":49.643,"end":50.877,"text":"Y'o t'ọdọ Rẹ wa se,","marked":"Y'ó t'ọ̀dọ̀ Rẹ̀ wá ṣe"},{"start":51.327,"end":52.788,"text":"Sa jẹ ki n le duro.","marked":"Sá jẹ́ kí n lè dúró."},{"start":53.238,"end":54.25,"text":"K'ireti mi ma yẹ,","marked":"K'ìrètí mi má yẹ"},{"start":54.7,"end":56.059,"text":"Tit' Iwọ o fi m'ọkan mi,","marked":"Tít Ìwọ ó fi m'ọkàn mi"},{"start":56.509,"end":57.74,"text":"Wọ 'nu isinmi Rẹ.","marked":"Wọ nu ìsinmi Rẹ."}],"end":57.74}]}