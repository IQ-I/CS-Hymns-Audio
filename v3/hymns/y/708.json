{"v":3,"coll":"y","num":708,"id":"hymn_708","title":"BABA Orun wa gb'ope wa","duration":82.905,"voices":{"male":{"file":"y-708-male-v3.m4a","bytes":575483,"sha256":"b4b4ddbe5c4d11bc79527b62cf9d5de0058ca791cf44cc21d848bee4837375f7","duration":83.0},"female":{"file":"y-708-female-v3.m4a","bytes":613292,"sha256":"d83790aa97d890f3145a7ae71fcaf1f00cdbc37f632ab46092cadc5e7e3bf2d9","duration":83.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.662,"text":"BABA Orun wa gb'ope wa","marked":"Baba Ọ̀run wa gb'ọpẹ́ wa"},{"start":2.112,"end":3.616,"text":"Fun ajodun wa oni yi","marked":"Fún àjọ̀dún wa òní yí"},{"start":4.066,"end":5.995,"text":"Fun idasi at'abo Re","marked":"Fún ìdásí àt'abo Rẹ"},{"start":6.445,"end":7.838,"text":"To nfun wa lojojumo.","marked":"Tó ńfún wà lójojúmọ́."}],"end":7.838},{"key":"CHORUS","start":8.788,"lines":[{"start":8.788,"end":9.919,"text":"Jehovha Jire","marked":"Jehovha Jire"},{"start":10.369,"end":11.733,"text":"Ran ibukun Re si wa","marked":"Rán ìbùkún Rẹ sí wa"},{"start":12.183,"end":13.562,"text":"K'awa le se 'fe Re d'opin","marked":"K'àwa lè ṣe fẹ́ Rẹ d'òpin"},{"start":14.012,"end":15.375,"text":"Ko wa de Paradise.","marked":"Kò wá dé Paradise."}],"end":15.375},{"key":"2","start":16.325,"lines":[{"start":16.325,"end":17.7,"text":"Olugbala wa gb'ope wa","marked":"Olùgbàlà wa gb'ọpẹ́ wa"},{"start":18.15,"end":19.905,"text":"T'isegun t'o nse fun wa","marked":"T'ìṣègùn t'ó ńṣe fún wa"},{"start":20.355,"end":22.081,"text":"Gbat'esu nfe bi wa subu","marked":"Gbàt'èṣù ńfẹ́ bí wá ṣubú"},{"start":22.531,"end":23.761,"text":"Ti a si nri 'ranwo Re.","marked":"Tí a sì ńrí rànwọ́ Rẹ̀."}],"end":23.761},{"key":"3","start":24.711,"lines":[{"start":24.711,"end":26.503,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":26.953,"end":28.228,"text":"E jek'a yin Baba wa","marked":"Ẹ jẹ́k'á yin Baba wa"},{"start":28.678,"end":30.246,"text":"Ti ko f'emi adaba Re","marked":"Tí kò f'ẹ̀mí àdàbà Rẹ"},{"start":30.696,"end":32.003,"text":"Fun eranko igbe je.","marked":"Fún ẹranko igbe jẹ́."}],"end":32.003},{"key":"4","start":32.953,"lines":[{"start":32.953,"end":34.554,"text":"Jehovha Shammah mbe fun wa","marked":"Jehovha Shammah mbẹ́ fún wa"},{"start":35.004,"end":36.498,"text":"T'o ran Maikaeli si wa","marked":"T'ó rán Maikaeli sí wa"},{"start":36.948,"end":38.985,"text":"Fun 'segun wa l'ona gbogbo","marked":"Fún ṣẹ́gun wa l'ọ̀nà gbogbo"},{"start":39.435,"end":40.876,"text":"Iyin fun Metalokan.","marked":"Ìyìn fún Mẹ́talọ́kan."}],"end":40.876},{"key":"5","start":41.826,"lines":[{"start":41.826,"end":43.157,"text":"Olupese wa y'o pese","marked":"Olùpèsè wa y'ó pèsè"},{"start":43.607,"end":44.833,"text":"Pese 'se rere fun wa","marked":"Pèsè ṣe rere fún wa"},{"start":45.283,"end":46.503,"text":"Awon agan y'o bimo","marked":"Àwọn àgàn y'ó bímọ"},{"start":46.953,"end":48.344,"text":"Enit' o bi a tunla.","marked":"Ẹnit ó bí a túnlá."}],"end":48.344},{"key":"6","start":49.294,"lines":[{"start":49.294,"end":50.854,"text":"Wa pelu Egbe Idale","marked":"Wá pẹ̀lú Ẹgbẹ́ Ìdálẹ̀"},{"start":51.304,"end":52.641,"text":"Kerubu on Serafu","marked":"Kérúbù on Séráfù"},{"start":53.091,"end":54.508,"text":"Pese fun won l'ona gbogbo","marked":"Pèsè fún wọn l'ọ̀nà gbogbo"},{"start":54.958,"end":56.524,"text":"Baba wa ba won 'segun.","marked":"Baba wá bá wọn ṣẹ́gun."}],"end":56.524},{"key":"7","start":57.474,"lines":[{"start":57.474,"end":58.81,"text":"A mbebe f'awon eda Re","marked":"A mbẹ̀bẹ̀ f'àwọn ẹ̀dà Rẹ̀"},{"start":59.26,"end":60.322,"text":"T'o wa ni gbogbo aiye","marked":"T'ó wà ní gbogbo ayé"},{"start":60.772,"end":62.28,"text":"K'a ronu pa iwa wa da","marked":"K'á ronú pa ìwà wa dá"},{"start":62.73,"end":63.967,"text":"K'a le ye 'bugbe orun.","marked":"K'á lè yẹ bùgbé ọ̀run."}],"end":63.967},{"key":"8","start":64.917,"lines":[{"start":64.917,"end":66.33,"text":"Gbogbo enyin ero mimo","marked":"Gbogbo ẹ̀yin èrò mímọ́"},{"start":66.78,"end":67.859,"text":"Ti Egbe Aladura","marked":"Ti Ẹgbẹ́ Aládúrà"},{"start":68.309,"end":69.765,"text":"E se ran nyin l'okansoso","marked":"Ẹ ṣe rán yín l'ọkànṣoṣo"},{"start":70.215,"end":71.441,"text":"Gege bi Metalokan.","marked":"Gẹ́gẹ́ bí Mẹ́talọ́kan."}],"end":71.441},{"key":"9","start":72.391,"lines":[{"start":72.391,"end":74.419,"text":"Orin Halle, Halleluyah,","marked":"Orin Halle, Hallelúyà"},{"start":74.869,"end":76.369,"text":"Ni awa y'o ko l'orun","marked":"Ní àwa y'ó kò l'ọ̀run"},{"start":76.819,"end":78.635,"text":"Nigbat' a ba de 'te Baba","marked":"Nígbàt a bá dé tẹ Baba"},{"start":79.085,"end":80.382,"text":"N'ile isura orun.","marked":"N'ilé ìṣúra ọ̀run."},{"start":80.832,"end":81.357,"text":"Amin.","marked":"Àmín."}],"end":81.357}]}