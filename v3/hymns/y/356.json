{"v":3,"coll":"y","num":356,"id":"hymn_356","title":"ALABUKUN n'nu Jesu","duration":34.975,"voices":{"male":{"file":"y-356-male-v3.m4a","bytes":234608,"sha256":"cf8ae8ec732a0b58d7a5c76d21bb1f05635fdf92025e4bb4c55b281604a9a6e9","duration":35.0},"female":{"file":"y-356-female-v3.m4a","bytes":240376,"sha256":"2eb697e8361de92c17db20a15c590e223d08fef7b7c7183df899e9e0edfb5aad","duration":35.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.832,"text":"ALABUKUN n'nu Jesu,","marked":"Alábùkún n'nú Jésù"},{"start":2.282,"end":3.277,"text":"Ni awọn ọm'Ọlọrun,","marked":"Ní àwọn ọm'Ọlọ́run"},{"start":3.727,"end":4.837,"text":"Ti a f'ẹjẹ Rẹ ra,","marked":"Tí a f'ẹ̀jẹ̀ Rẹ̀ rà"},{"start":5.287,"end":6.775,"text":"Lati' inu iku s'iye;","marked":"Láti inú ikú s'ìyẹ́"}],"end":6.775},{"key":"CHORUS","start":7.725,"lines":[{"start":7.725,"end":8.879,"text":"A ba je ka wa mo won","marked":"A bá jẹ́ ká wá mọ̀ wọn"},{"start":9.329,"end":11.282,"text":"L'ayé yi, ati l'ọrun.","marked":"L'ayé yí, àti l'ọ̀run."}],"end":11.282},{"key":"2","start":12.232,"lines":[{"start":12.232,"end":13.378,"text":"Awọn ti o da l'are;","marked":"Àwọn tí ó dá l'àre"},{"start":13.828,"end":14.987,"text":"Nipa ore-ọfẹ Rẹ;","marked":"Nípa ore-ọfẹ Rẹ"},{"start":15.437,"end":16.714,"text":"A wẹ gbogbo ẹsẹ wọn,","marked":"A wẹ gbogbo ẹsẹ̀ wọn"},{"start":17.164,"end":18.641,"text":"Wọn o bọ lọjọ 'dajọ,,,,","marked":"Wọn ó bọ́ lọ́jọ́ 'dajọ"}],"end":18.641},{"key":"3","start":19.591,"lines":[{"start":19.591,"end":21.16,"text":"Wọn s'eso ore-ọfẹ;","marked":"Wọ́n s'èso ore-ọfẹ"},{"start":21.61,"end":22.873,"text":"Ninu isẹ ododo,","marked":"Nínú isẹ́ òdodo"},{"start":23.323,"end":24.344,"text":"Irira l'ẹsẹ si wọn;","marked":"Ìríra l'ẹsẹ̀ sí wọn"},{"start":24.794,"end":25.951,"text":"Ọr'-Ọlọrun n gbe 'nu wọn;","marked":"Ọr'-Ọlọrun ń gbé nù wọn"}],"end":25.951},{"key":"4","start":26.901,"lines":[{"start":26.901,"end":28.22,"text":"Nipa Ẹj'Ọdaguntan,","marked":"Nípa Ẹj'Ọ̀dàgùntàn"},{"start":28.67,"end":29.874,"text":"Wọn mba Ọlọrun kẹgbẹ,","marked":"Wọ́n mba Ọlọ́run kẹ́gbẹ́"},{"start":30.324,"end":31.69,"text":"Pẹlu Ọla-nla Jesu,","marked":"Pẹ̀lú Ọla-nla Jésù"},{"start":32.14,"end":33.426,"text":"A wọ wọn l'asọ ogo.","marked":"A wọ wọ́n l'asọ ògo."}],"end":33.426}]}