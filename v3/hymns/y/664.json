{"v":3,"coll":"y","num":664,"id":"hymn_664","title":"ALABUKUN FUN l'omo na","duration":48.13,"voices":{"male":{"file":"y-664-male-v3.m4a","bytes":336778,"sha256":"05d07dbb5aa9de4d6254c037c2192f65689877f31e38df3288c0b9eb2e875e13","duration":48.2},"female":{"file":"y-664-female-v3.m4a","bytes":345995,"sha256":"6d1b5ee3ff7d53d730de603d39fcbb68f26c99675b8d5bec4dff64571764513f","duration":48.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.837,"text":"ALABUKUN FUN l'omo na","marked":"Alábùkún Fún l'ọmọ ná"},{"start":2.287,"end":3.292,"text":"Lati igba ewe","marked":"Láti ìgbà èwe"},{"start":3.742,"end":5.013,"text":"Ti ki rin l'ona iparun","marked":"Tí kí rìn l'ọ̀nà ìparun"},{"start":5.463,"end":6.557,"text":"Ti mberu Olorun.","marked":"Ti mbẹ̀rù Ọlọ́run."}],"end":6.557},{"key":"2","start":7.507,"lines":[{"start":7.507,"end":9.025,"text":"K'a fi ara wa f'Ọlọrun,","marked":"K'á fi ara wa f'Ọlọ́run"},{"start":9.475,"end":10.543,"text":"Lat' igba ewe dun;","marked":"Lát ìgbà èwe dùn"},{"start":10.993,"end":12.483,"text":"Ẹbun giga n'itanna jẹ,","marked":"Ẹ̀bùn gíga n'ìtànná jẹ́"},{"start":12.933,"end":14.303,"text":"'Gba to ba sẹsẹ n yo.","marked":"gbà tó bá sẹ̀sẹ̀ ń yọ̀."}],"end":14.303},{"key":"3","start":15.253,"lines":[{"start":15.253,"end":16.42,"text":"K'a t'ewe bẹru Oluwa,","marked":"K'á t'èwe bẹ̀rù Olúwa"},{"start":16.87,"end":17.912,"text":"Rọrun lọpọlọpọ;","marked":"Rọrùn lọ́pọ̀lọpọ̀"},{"start":18.362,"end":20.126,"text":"Bi ẹlẹsẹ ti n dagba to","marked":"Bí ẹlẹ́sẹ̀ tí ń dàgbà tó"},{"start":20.576,"end":22.003,"text":"L'ọkan wọn si nle to.","marked":"L'ọkàn wọn sì ńlè tó."}],"end":22.003},{"key":"4","start":22.953,"lines":[{"start":22.953,"end":25.031,"text":"Ka gbọ ti isin Ọlọrun,","marked":"Ká gbọ́ tí ìsìn Ọlọ́run"},{"start":25.481,"end":26.571,"text":"Lati igba ewe,","marked":"Láti ìgbà èwe"},{"start":27.021,"end":28.63,"text":"N'nu ewe pupọ ni a n yọ,","marked":"N'nú ewé púpọ̀ ni à ń yọ̀"},{"start":29.08,"end":30.324,"text":"A si fun-ni n' ipa","marked":"A sì fun-ni ń ipá"}],"end":30.324},{"key":"5","start":31.274,"lines":[{"start":31.274,"end":32.356,"text":"Ọlọrun Olodumare,","marked":"Ọlọ́run Olódùmarè"},{"start":32.806,"end":34.02,"text":"A f'ara wa fun Ọ,","marked":"A f'ara wa fún Ọ"},{"start":34.47,"end":36.351,"text":"K'a jẹ tirẹ lat'ewe lọ,","marked":"K'á jẹ́ tirẹ̀ lát'èwe lọ"},{"start":36.801,"end":38.084,"text":"Titi d'opin ayé.","marked":"Títí d'òpin ayé."}],"end":38.084},{"key":"6","start":39.034,"lines":[{"start":39.034,"end":40.378,"text":"K'isẹ adura at'iyin,","marked":"K'isẹ́ àdúrà àt'ìyìn"},{"start":40.828,"end":41.852,"text":"Jẹ isẹ ayé mi;","marked":"Jẹ́ isẹ́ ayé mi"},{"start":42.302,"end":44.727,"text":"Lọjọ iku, k'yoo jẹ ki n yẹ,","marked":"Lọ́jọ́ ikú, k'yóò jẹ́ kí n yẹ"},{"start":45.177,"end":46.58,"text":"Lati f'ayọ r'ọrun.","marked":"Láti f'ayọ̀ r'ọ̀run."}],"end":46.58}]}