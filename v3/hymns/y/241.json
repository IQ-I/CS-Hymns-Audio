{"v":3,"coll":"y","num":241,"id":"hymn_241","title":"ARE mu o aye su o","duration":53.411,"voices":{"male":{"file":"y-241-male-v3.m4a","bytes":360291,"sha256":"afb07697549e982fe899a25347b0b81c249f66d8ff7f3cf59020d27469142ac1","duration":53.5},"female":{"file":"y-241-female-v3.m4a","bytes":369493,"sha256":"547075aa8c7fe50c535da45a96e238691cb82de210666b8050ae584e0b9a246d","duration":53.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.517,"text":"ARẸ mu o ayé su ọ,","marked":"Àrẹ mú ọ ayé ṣú ọ"},{"start":1.967,"end":2.961,"text":"Lala pọ fun ọ?","marked":"Lálà pọ̀ fún ọ?"},{"start":3.411,"end":5.206,"text":"Jesu ni, 'Wa si ọdọ mi,","marked":"Jésù ni, wá sí ọ̀dọ̀ mi"},{"start":5.656,"end":6.726,"text":"K'o sinmi.","marked":"K'ó sinmi."}],"end":6.726},{"key":"2","start":7.676,"lines":[{"start":7.676,"end":8.967,"text":"Ami wo l'emi o fi mọ,","marked":"Àmì wo l'èmi ó fi mọ́"},{"start":9.417,"end":10.752,"text":"Pe Oun l'o n pe mi?","marked":"Pé Òun l'ó ń pè mí?"},{"start":11.202,"end":13.173,"text":"Am' iso wa lọwọ, ati ẹsẹ Rẹ.","marked":"Àm ìṣọ́ wà lọ́wọ́, àti ẹsẹ̀ Rẹ̀."}],"end":13.173},{"key":"3","start":14.123,"lines":[{"start":14.123,"end":15.741,"text":"O ha ni ade bi Oba","marked":"Ó ha ní adé bí Ọba"},{"start":16.191,"end":17.307,"text":"Ti mo le fi mo?","marked":"Tí mo lè fi mọ̀?"},{"start":17.757,"end":19.508,"text":"Toto, ade wa lori Re,","marked":"Tọ̀tọ̀, adé wà lórí Rẹ̀"},{"start":19.958,"end":20.96,"text":"T'egun ni.","marked":"T'ègún ni."}],"end":20.96},{"key":"4","start":21.91,"lines":[{"start":21.91,"end":23.909,"text":"Bi mo ba ri, bi mo tẹle,","marked":"Bí mo bá rí, bí mo tẹ̀lé"},{"start":24.359,"end":25.174,"text":"Kini ere mi?","marked":"Kíni èrè mi?"},{"start":25.624,"end":27.101,"text":"p Ọpọlọpọ iya ati","marked":"p Ọ̀pọ̀lọpọ̀ ìyá àti"},{"start":27.551,"end":28.358,"text":"'Banujẹ.","marked":"'Banujẹ."}],"end":28.358},{"key":"5","start":29.308,"lines":[{"start":29.308,"end":31.427,"text":"Bi mo tẹle tit' ayé mi,","marked":"Bí mo tẹ̀lé tít ayé mi"},{"start":31.877,"end":32.767,"text":"Kini n ó ri gba?","marked":"Kíni n ó rí gbà?"},{"start":33.217,"end":35.168,"text":"Ẹkun a dopin, o sinmi,","marked":"Ẹkún a dópin, ó sinmi"},{"start":35.618,"end":36.478,"text":"Tit' ayé.","marked":"Tít ayé."}],"end":36.478},{"key":"6","start":37.428,"lines":[{"start":37.428,"end":39.048,"text":"Bi mo bere pe ki O gba mi","marked":"Bí mo bẹ̀rẹ̀ pé kí Ó gbà mí"},{"start":39.498,"end":40.826,"text":"Y'o kọ fun mi bi?","marked":"Y'ó kọ́ fún mi bí?"},{"start":41.276,"end":42.886,"text":"B'ọrun at'ayé n kọja lọ,","marked":"B'ọ̀run at'ayé ń kọjá lọ"},{"start":43.336,"end":44.251,"text":"Ko jẹ kọ.","marked":"Kò jẹ́ kọ."}],"end":44.251},{"key":"7","start":45.201,"lines":[{"start":45.201,"end":47.507,"text":"Bi mo ba ri, ti mo n tẹle,","marked":"Bí mo bá rí, tí mo ń tẹ̀lé"},{"start":47.957,"end":49.098,"text":"Y'o ha bukun mi?","marked":"Y'ó ha bùkún mi?"},{"start":49.548,"end":50.663,"text":"Awọn ogun ọrun wi pé,","marked":"Àwọn ogun ọ̀run wí pé"},{"start":51.113,"end":51.862,"text":"Yio se.","marked":"Yóò ṣe."}],"end":51.862}]}