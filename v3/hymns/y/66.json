{"v":3,"coll":"y","num":66,"id":"hymn_66","title":"IGBALA ni, igbala ni","duration":49.837,"voices":{"male":{"file":"y-66-male-v3.m4a","bytes":344562,"sha256":"70de66768884ba4f2f72d53766c3bdda0cc785f060971a4694281b455c8dbe55","duration":49.9},"female":{"file":"y-66-female-v3.m4a","bytes":353712,"sha256":"f65f2b149172c089db31d375a1e5f1fd9477ee0fe59f8f585644e4b04f74bd88","duration":49.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.007,"text":"IGBALA ni, igbala ni,","marked":"Ìgbàlà ni, ìgbàlà ni"},{"start":2.457,"end":3.549,"text":"Awa ẹlẹsẹ n fẹ;","marked":"Àwa ẹlẹ́sẹ̀ ń fẹ́"},{"start":3.999,"end":5.291,"text":"Nitori ninu buburu","marked":"Nítorí nínú búburú"},{"start":5.741,"end":7.217,"text":"T'a se l'awa n segbe.","marked":"T'á ṣe l'àwa ń ṣègbé."}],"end":7.217},{"key":"2","start":8.167,"lines":[{"start":8.167,"end":9.696,"text":"Isẹ ọwọ wa ti a n se,","marked":"Isẹ́ ọwọ́ wa tí à ń ṣe"},{"start":10.146,"end":11.199,"text":"O n wi nigba gbogbo,","marked":"Ó ń wí nígbà gbogbo"},{"start":11.649,"end":13.6,"text":"mp Pe, igbala ko si nibẹ","marked":"mp Pé, ìgbàlà kò sí níbẹ̀"},{"start":14.05,"end":15.974,"text":"Isẹ ko le gba ni.","marked":"Isẹ́ kò lè gbà ni."}],"end":15.974},{"key":"3","start":16.924,"lines":[{"start":16.924,"end":18.681,"text":"Awa n sẹbọ, awa n rubọ,","marked":"Àwa ń sẹ́bọ́, àwa ń rúbọ"},{"start":19.131,"end":20.897,"text":"A n kọrin, a si n jo;","marked":"À ń kọrin, a sì ń jó"},{"start":21.347,"end":22.794,"text":"Sugbọn a ko ri igbala,","marked":"Sùgbọ́n a kò rí ìgbàlà"},{"start":23.244,"end":24.369,"text":"Ninu gbogbo wọnyi.","marked":"Nínú gbogbo wọ̀nyí."}],"end":24.369},{"key":"4","start":25.319,"lines":[{"start":25.319,"end":26.587,"text":"Nibo ni igbala gbe wa?","marked":"Níbo ni ìgbàlà gbé wà?"},{"start":27.037,"end":28.458,"text":"Fi han ni, fi han ni","marked":"Fi hàn ni, fi hàn ni"},{"start":28.908,"end":31.297,"text":"B'o wa loke, bi isale","marked":"B'ó wà lókè, bí ìsàlẹ̀"},{"start":31.747,"end":33.254,"text":"B'o ba mo, wi fun wa.","marked":"B'ó bá mọ́, wí fún wa."}],"end":33.254},{"key":"5","start":34.204,"lines":[{"start":34.204,"end":35.659,"text":"Jesu ni se Olugbala,","marked":"Jésù ni ṣe Olùgbàlà"},{"start":36.109,"end":37.176,"text":"Jesu l'Oluwa wa;","marked":"Jésù l'Olúwa wa"},{"start":37.626,"end":38.804,"text":"Igbala wa ni ọwọ Rẹ;","marked":"Ìgbàlà wà ní ọwọ́ Rẹ"},{"start":39.254,"end":40.355,"text":"Fun awa ẹlẹsẹ.","marked":"Fún àwa ẹlẹ́sẹ̀."}],"end":40.355},{"key":"6","start":41.305,"lines":[{"start":41.305,"end":43.136,"text":"Wa nisinsin yii, wa tọrọ,","marked":"Wá nísinsin yìí, wá tọ́rọ̀"},{"start":43.586,"end":44.528,"text":"Ifẹ wa ninu Rẹ;","marked":"Ìfẹ́ wà nínú Rẹ̀"},{"start":44.978,"end":46.515,"text":"Ẹyin ti o buru l'O n pe;","marked":"Ẹ̀yin tí ó burú l'Ó ń pè"},{"start":46.965,"end":48.288,"text":"Ẹ wa gba igbala.","marked":"Ẹ wá gba ìgbàlà."}],"end":48.288}]}