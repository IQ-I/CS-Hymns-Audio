{"v":3,"coll":"y","num":58,"id":"hymn_58","title":"OBA TI ki ye Majemu","duration":57.795,"voices":{"male":{"file":"y-58-male-v3.m4a","bytes":410623,"sha256":"40832501e7d05bec47eca042e4d284a0dc74f08c21df841f0b67439c55b81ad8","duration":57.8},"female":{"file":"y-58-female-v3.m4a","bytes":416903,"sha256":"2dd316013047f03562dae1a343e99c1c2de55a6af27a7774da5a72ef1ec86c3f","duration":57.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.834,"text":"OBA TI ki ye Majemu","marked":"Ọba Tí kì yẹ Májẹ̀mú"},{"start":2.284,"end":3.524,"text":"F'ore ofe Re fun wa,","marked":"F'oore ọ̀fẹ́ Rẹ fún wa"},{"start":3.974,"end":5.83,"text":"Majemu ti a ba O da,","marked":"Májẹ̀mú tí a bá Ó dá"},{"start":6.28,"end":11.546,"text":"Ki awa ko le mu se. Nitori iku Messiah ) Jọwọ ko sanu fun wa )2ce","marked":"Kí àwa kò lè mú ṣe. Nítorí ikú Messiah Jọ̀wọ́ kò ṣanú fún wa"}],"end":11.546},{"key":"CHORUS","start":12.496,"lines":[{"start":12.496,"end":13.878,"text":"Nitori iku Messaiah","marked":"Nítorí ikú Messaiah"},{"start":14.328,"end":15.8,"text":"Jowo ko sanu fun wa. 2ce","marked":"Jọ̀wọ́ kò ṣanú fún wa."}],"end":15.8},{"key":"2","start":16.75,"lines":[{"start":16.75,"end":18.093,"text":"Ọba Mimọ Ọba Ogo,","marked":"Ọba Mímọ́ Ọba Ògo"},{"start":18.543,"end":20.034,"text":"'Wọ l'awa n fi iyin fun,","marked":"'Wọ l'àwa ń fi ìyìn fún"},{"start":20.484,"end":22.091,"text":"Kérúbù ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":22.541,"end":24.163,"text":"S'ọpẹ ọdun titun yi.","marked":"S'ọ́pẹ́ ọdún titun yí."}],"end":24.163},{"key":"3","start":25.113,"lines":[{"start":25.113,"end":26.555,"text":"Alaileso jẹ k'o s'eso,","marked":"Aláìléso jẹ́ k'ó s'èṣọ́"},{"start":27.005,"end":28.316,"text":"Ninu ọdun t'a wa yi,","marked":"Nínú ọdún t'á wá yí"},{"start":28.766,"end":30.187,"text":"Alaigbagbọ jẹ ko gbagbọ,","marked":"Aláìgbàgbọ́ jẹ́ kó gbàgbọ́"},{"start":30.637,"end":31.939,"text":"Ki gbogbo wa di yiye.","marked":"Kí gbogbo wa di yíyẹ."}],"end":31.939},{"key":"4","start":32.889,"lines":[{"start":32.889,"end":34.232,"text":"Oba Mimo Jehofa NLA","marked":"Ọba Mímọ́ Jèhófà Ńlá"},{"start":34.682,"end":36.149,"text":"Gb'ope Ajodun wa yi,","marked":"Gb'ọpẹ́ Àjọ̀dún wa yí"},{"start":36.599,"end":38.285,"text":"Seri Ibukun Re sori","marked":"Ṣèrì Ìbùkún Rẹ sórí"},{"start":38.735,"end":40.267,"text":"Omode at'agba wa.","marked":"Ọmọdé àt'àgbà wá."}],"end":40.267},{"key":"5","start":41.217,"lines":[{"start":41.217,"end":42.511,"text":"Pese f'awon alairise,","marked":"Pèsè f'àwọn aláìríṣẹ́"},{"start":42.961,"end":44.093,"text":"Pese omo fun agan","marked":"Pèsè ọmọ fún àgàn"},{"start":44.543,"end":45.991,"text":"Fi ilera fun alaisan","marked":"Fi ìlera fún aláìsàn"},{"start":46.441,"end":47.68,"text":"K'omo Re mase rahun.","marked":"K'ọmọ Rẹ̀ máṣe ráhùn."}],"end":47.68},{"key":"6","start":48.63,"lines":[{"start":48.63,"end":50.319,"text":"F'agbara Re f 'Egbe Serafu,","marked":"F'agbára Rẹ̀ f ẹgbẹ́ Séráfù"},{"start":50.769,"end":52.276,"text":"Lati sin O de opin","marked":"Láti sin Ó dé òpin"},{"start":52.726,"end":54.444,"text":"Mase je k'ise wa laiye","marked":"Maṣe jẹ́ k'iṣẹ́ wa láìyẹ"},{"start":54.894,"end":56.246,"text":"Ja s'asan niwaju Re.","marked":"Já s'ásán níwájú Rẹ."}],"end":56.246}]}