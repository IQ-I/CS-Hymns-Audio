{"v":3,"coll":"y","num":809,"id":"hymn_809","title":"ARE mu o, okan re poruru","duration":47.779,"voices":{"male":{"file":"y-809-male.m4a","bytes":348339,"sha256":"1e477c0a26250070bef47fba82fc6eab3960b0f511cd96fc42003c7a55ab4530","duration":47.8},"female":{"file":"y-809-female.m4a","bytes":359743,"sha256":"51abebf8e6da10b47b08bfa7fea60c43ea97b60c45e54508076aef843e9c4594","duration":47.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.336,"text":"ARE mu o, okan re poruru","marked":"Are mú ọ, ọkàn rẹ pòrúrù"},{"start":2.716,"end":5.201,"text":"So fun Jesu, so fun Jesu","marked":"Sọ fún Jésù, sọ fún Jésù"},{"start":5.581,"end":7.129,"text":"Ibanuje dipo ayo fun o?","marked":"Ìbànújẹ́ dípò ayọ̀ fún ọ?"},{"start":7.509,"end":8.886,"text":"So fun Jesu nikan.","marked":"Sọ fún Jésù nìkan."}],"end":8.886},{"key":"CHORUS","start":9.836,"lines":[{"start":9.836,"end":12.061,"text":"So fun Jesu, so fun Jesu","marked":"Sọ fún Jésù, sọ fún Jésù"},{"start":12.441,"end":13.668,"text":"On l'ore t'o daju","marked":"On l'ọ̀rẹ́ t'ó dájú"},{"start":14.048,"end":14.976,"text":"Ko tun s'ore","marked":"Kò tún s'ore"},{"start":15.356,"end":16.494,"text":"Ati 'yekan bi Re","marked":"Àti 'yẹ̀kan bí Rẹ"},{"start":16.874,"end":18.314,"text":"So fun Jesu nikan.","marked":"Sọ fún Jésù nìkan."}],"end":18.314},{"key":"2","start":19.264,"lines":[{"start":19.264,"end":21.173,"text":"Asun-dekun omije l'o nsun bi?","marked":"Àsun-dẹ́kun omijé l'ó ńsùn bí?"},{"start":21.553,"end":23.667,"text":"So fun Jesu, so fun Jesu","marked":"Sọ fún Jésù, sọ fún Jésù"},{"start":24.047,"end":26.108,"text":"O l'ese to farasin f'enia?","marked":"Ó l'ẹsẹ̀ tó farasin f'enia?"},{"start":26.488,"end":27.804,"text":"So fun Jesu nikan.","marked":"Sọ fún Jésù nìkan."}],"end":27.804},{"key":"3","start":28.754,"lines":[{"start":28.754,"end":30.29,"text":"'Banuje teri okan re ba bi?","marked":"'Bànújẹ́ tẹrí ọkàn rẹ bá bí?"},{"start":30.67,"end":33.073,"text":"So fun Jesu, so fun Jesu","marked":"Sọ fún Jésù, sọ fún Jésù"},{"start":33.453,"end":35.01,"text":"O ha ns'aniyan ojo ola bi?","marked":"Ó ha ns'àníyàn ọjọ́ ọ̀la bí?"},{"start":35.39,"end":36.734,"text":"So fun Jesu nikan.","marked":"Sọ fún Jésù nìkan."}],"end":36.734},{"key":"4","start":37.684,"lines":[{"start":37.684,"end":39.271,"text":"Ironu iku mu o damu bi?","marked":"Ìrònú ikú mú ọ dàmú bí?"},{"start":39.651,"end":42.326,"text":"So fun Jesu, so fun Jesu","marked":"Sọ fún Jésù, sọ fún Jésù"},{"start":42.706,"end":44.502,"text":"Okan re nfe ijoba Jesu bi?","marked":"Ọkàn rẹ ńfẹ́ ìjọba Jésù bí?"},{"start":44.882,"end":46.229,"text":"So fun Jesu nikan.","marked":"Sọ fún Jésù nìkan."}],"end":46.229}]}