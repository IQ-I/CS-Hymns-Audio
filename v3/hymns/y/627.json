{"v":3,"coll":"y","num":627,"id":"hymn_627","title":"L'EKAN mo jina s'Oluwa","duration":61.849,"voices":{"male":{"file":"y-627-male-v3.m4a","bytes":425270,"sha256":"722b58d64c2eee181bb06a88744bfb58261c8f47327192b39c25045788ecb9f4","duration":61.9},"female":{"file":"y-627-female-v3.m4a","bytes":437897,"sha256":"a8e591e530292c3b20614987a6554494732032bf373c036fcfacd15e592514e0","duration":61.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.743,"text":"L'EKAN mo jina s'Oluwa","marked":"L'Ẹ̀kan mo jìnà s'Olúwa"},{"start":2.193,"end":3.624,"text":"Mo nfi iwa mi bi ninu","marked":"Mo ńfi ìwà mi bí nínú"},{"start":4.074,"end":5.743,"text":"Sugbon Jesu ti gba mi,","marked":"Ṣùgbọ́n Jésù ti gbà mí"},{"start":6.193,"end":7.171,"text":"Halleluya.","marked":"Hallelúyà."}],"end":7.171},{"key":"CHORUS","start":8.121,"lines":[{"start":8.121,"end":9.559,"text":"A, bi o ti dun to","marked":"A, bí ó ti dùn tó"},{"start":10.009,"end":11.34,"text":"Dun to, dun to dun to","marked":"Dùn tó, dùn tó dùn tó"},{"start":11.79,"end":13.285,"text":"A, bi o ti dun to","marked":"A, bí ó ti dùn tó"},{"start":13.735,"end":15.42,"text":"Ki Jesu ma gbe inu mi.","marked":"Kí Jésù má gbé inú mi."}],"end":15.42},{"key":"2","start":16.37,"lines":[{"start":16.37,"end":17.829,"text":"Ibinu ati runu mi","marked":"Ìbínú àti runú mi"},{"start":18.279,"end":19.932,"text":"Ewon ti Esu fi de mi","marked":"Ẹ̀wọ̀n tí Èṣù fi dè mí"},{"start":20.382,"end":21.747,"text":"Jesu ti da ide na","marked":"Jésù ti dá idẹ ná"},{"start":22.197,"end":23.175,"text":"Halleluya.","marked":"Hallelúyà."}],"end":23.175},{"key":"3","start":24.125,"lines":[{"start":24.125,"end":25.475,"text":"Ifekufe kun okan mi","marked":"Ìfẹ́kúfẹ́ kún ọkàn mi"},{"start":25.925,"end":27.039,"text":"Pelu igberaga gbogbo","marked":"Pẹ̀lú ìgbéraga gbogbo"},{"start":27.489,"end":28.586,"text":"In'Emi ti jo won","marked":"In'èmi ti jó wọn"},{"start":29.036,"end":29.986,"text":"Halleluya.","marked":"Hallelúyà."}],"end":29.986},{"key":"4","start":30.936,"lines":[{"start":30.936,"end":32.182,"text":"Mo bo lowo irewesi,","marked":"Mo bọ̀ lọ́wọ́ ìrẹ̀wẹ̀sì"},{"start":32.632,"end":34.342,"text":"Lowo ko gbona ko tutu,","marked":"Lọ́wọ́ kò gbóná kò tútù"},{"start":34.792,"end":35.9,"text":"E ba mi yin Oluwa","marked":"Ẹ bá mi yin Olúwa"},{"start":36.35,"end":37.248,"text":"Halleluya.","marked":"Hallelúyà."}],"end":37.248},{"key":"5","start":38.198,"lines":[{"start":38.198,"end":39.774,"text":"Mo nkorin si lojojumo","marked":"Mo ńkọrin sí lójojúmọ́"},{"start":40.224,"end":42.134,"text":"Mo nyo mo si tun nfo s'oke","marked":"Mo nyọ̀ mo sì tún ńfọ̀ s'òkè"},{"start":42.584,"end":44.195,"text":"Nipa gbara Emi","marked":"Nípa gbára Èmi"},{"start":44.645,"end":45.594,"text":"Halleluya.","marked":"Hallelúyà."}],"end":45.594},{"key":"6","start":46.544,"lines":[{"start":46.544,"end":47.928,"text":"Eje yebiye we mi mo","marked":"Ẹ̀jẹ̀ yẹ̀bíyẹ́ wẹ̀ mi mọ́"},{"start":48.378,"end":49.72,"text":"Omi iye nsan ninu mi","marked":"Omi iye ńṣàn nínú mi"},{"start":50.17,"end":51.373,"text":"Igbala mi di kikun","marked":"Ìgbàlà mi di kíkún"},{"start":51.823,"end":52.812,"text":"Halleluya.","marked":"Hallelúyà."}],"end":52.812},{"key":"7","start":53.762,"lines":[{"start":53.762,"end":55.239,"text":"Enyin ara at'ore mi","marked":"Ẹ̀yin ará àt'ọrẹ mi"},{"start":55.689,"end":56.96,"text":"Tani ko fe ri igbala","marked":"Tani kò fẹ́ rí ìgbàlà"},{"start":57.41,"end":58.886,"text":"Ofe ni l'odo Jesu","marked":"Ọ̀fẹ́ ni l'ọ̀dọ̀ Jésù"},{"start":59.336,"end":60.3,"text":"Halleluya.","marked":"Hallelúyà."}],"end":60.3}]}