{"v":3,"coll":"y","num":540,"id":"hymn_540","title":"EWA 'tanna ooro kutu","duration":46.012,"voices":{"male":{"file":"y-540-male-v3.m4a","bytes":329420,"sha256":"5edf044478055a7922583f62ce3863c0d95cfc1f19d41761315b4fe7790b9b01","duration":46.1},"female":{"file":"y-540-female-v3.m4a","bytes":338062,"sha256":"5471cd1ade49bc5e15ca84c35f1f6b6f81bd2b074cea6c0a7ec1dbe52401e5a0","duration":46.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.766,"text":"ẸWA 'tanna oorọ kutu,","marked":"Ẹwà tanná oorọ kùtù"},{"start":2.216,"end":3.284,"text":"'Mọlẹ ọsan gangan,","marked":"'Mọlẹ ọ̀sán gangan"},{"start":3.734,"end":5.151,"text":"Pipọn orun ni ọjọrọ,","marked":"Pípọ́n ọ̀run ni ọjọ́rọ̀"},{"start":5.601,"end":6.97,"text":"di Wọn ti n yara sa to!","marked":"di Wọ́n ti ń yára sá tó!"},{"start":7.42,"end":8.963,"text":"A n fẹ ẹnubode ọrun,","marked":"A ń fẹ́ ẹnubodè ọ̀run"},{"start":9.413,"end":10.493,"text":"Ita wura didan:","marked":"Ìta wúrà dídán"},{"start":10.943,"end":12.701,"text":"Awa n fẹ Orun Ododo,","marked":"Àwa ń fẹ́ Ọ̀run Òdodo"},{"start":13.151,"end":14.399,"text":"Ti ki wọ titi lai.","marked":"Tí kì wọ títí láì."}],"end":14.399},{"key":"2","start":15.349,"lines":[{"start":15.349,"end":16.732,"text":"B' ireti giga wa layé,","marked":"B ìrètí gíga wà layé"},{"start":17.182,"end":18.606,"text":"Ti n tete saki to!","marked":"Tí ń tètè ṣákì tó!"},{"start":19.056,"end":20.085,"text":"Abawọn melomelo ni,","marked":"Àbàwọ́n mélòmélò ni"},{"start":20.535,"end":22.057,"text":"Nb'agbada Kristian jẹ?","marked":"Ǹb'agbádá Kristian jẹ́?"},{"start":22.507,"end":24.146,"text":"A n fẹ ọkan ti ki dẹsẹ;","marked":"À ń fẹ́ ọkàn tí kì dẹ́sẹ̀"},{"start":24.596,"end":25.68,"text":"Ọkan ti a wẹ mọ;","marked":"Ọkàn tí a wẹ̀ mọ́"},{"start":26.13,"end":27.331,"text":"Ohun lati yin Ọba wa,","marked":"Ohun láti yin Ọba wá"},{"start":27.781,"end":28.964,"text":"Lọsan-loru titi.","marked":"Lọsan-loru títí."}],"end":28.964},{"key":"3","start":29.914,"lines":[{"start":29.914,"end":31.563,"text":"Nihin 'gbagbọ oun 'reti mbẹ,","marked":"Níhìn 'gbagbọ òun retí mbẹ́"},{"start":32.013,"end":33.451,"text":"Lati tọ wa soke;","marked":"Láti tọ́ wá sókè"},{"start":33.901,"end":35.973,"text":"Lohun, pipe alafia,","marked":"Lóhùn, pípé àlàáfíà"},{"start":36.423,"end":37.597,"text":"Ju b'a ti le fẹ lọ:","marked":"Ju b'á ti lè fẹ́ lọ"},{"start":38.047,"end":39.38,"text":"Nipa ifẹ oun 'rora Rẹ,","marked":"Nípa ìfẹ́ òun rora Rẹ̀"},{"start":39.83,"end":40.882,"text":"Nitori iku Rẹ,","marked":"Nítorí ikú Rẹ̀"},{"start":41.332,"end":42.716,"text":"Ma jẹ ka subu lọna Rẹ.","marked":"Má jẹ́ ká ṣubú lọ́nà Rẹ."},{"start":43.166,"end":44.463,"text":"K'a sọ ade wa nu.","marked":"K'á sọ adé wa nù."}],"end":44.463}]}