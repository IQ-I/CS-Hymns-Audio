{"v":3,"coll":"y","num":560,"id":"hymn_560","title":"NIHIN mo j'alejo","duration":51.886,"voices":{"male":{"file":"y-560-male-v3.m4a","bytes":348064,"sha256":"5e293353a0e4608109b666814e220de37960c1e2bfe017dbde2618561d62dcc9","duration":51.9},"female":{"file":"y-560-female-v3.m4a","bytes":361967,"sha256":"ef4353851ded3d66e3437eb4a85e4701443fce1f31c6ab26580eeadb416f9a90","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.378,"text":"Nihin mo j' alejo,","marked":"Níhìn mo j àlejò"},{"start":1.828,"end":2.646,"text":"Ọrun n'ile,","marked":"Ọ̀run n'ilẹ̀"},{"start":3.096,"end":4.286,"text":"Atipo ni mo n se,","marked":"Àtìpó ni mò ń ṣe"},{"start":4.736,"end":5.716,"text":"Ọrun n'ile,","marked":"Ọ̀run n'ilẹ̀"},{"start":6.166,"end":7.547,"text":"Ewu oun 'banujẹ,","marked":"Ẹ̀wù òun 'banujẹ"},{"start":7.997,"end":9.074,"text":"Wa yi mi kakiri,","marked":"Wá yí mi kákiri"},{"start":9.524,"end":10.537,"text":"Ọrun ni ilu mi,","marked":"Ọ̀run ni ìlú mi"},{"start":10.987,"end":11.888,"text":"Ọrun n'ile.","marked":"Ọ̀run n'ilẹ̀."}],"end":11.888},{"key":"2","start":12.838,"lines":[{"start":12.838,"end":14.021,"text":"B'iji ba tilẹ n ja,","marked":"B'ìjì bá tilẹ̀ ń jà"},{"start":14.471,"end":15.331,"text":"Ọrun n'ile;","marked":"Ọ̀run n'ilẹ̀"},{"start":15.781,"end":17.205,"text":"di Kukuru l'ajo mi,","marked":"di Kukuru l'àjọ mi"},{"start":17.655,"end":18.576,"text":"Ọrun n'ile,","marked":"Ọ̀run n'ilẹ̀"},{"start":19.026,"end":20.28,"text":"Iji lile ti n ja,","marked":"Ìjì líle tí ń jà"},{"start":20.73,"end":21.782,"text":"Fẹ rekoja lọ na;","marked":"Fẹ́ rékọjá lọ nà"},{"start":22.232,"end":23.725,"text":"N ó sa de'le dandan,","marked":"N ó sá dé'lé dandan"},{"start":24.175,"end":25.009,"text":"Ọrun n'ile.","marked":"Ọ̀run n'ilẹ̀."}],"end":25.009},{"key":"3","start":25.959,"lines":[{"start":25.959,"end":27.064,"text":"Lọdọ Olugbala,","marked":"Lọ́dọ̀ Olùgbàlà"},{"start":27.514,"end":28.376,"text":"Ọrun n'ile;","marked":"Ọ̀run n'ilẹ̀"},{"start":28.826,"end":29.901,"text":"A o se mi logo,","marked":"A ó ṣe mí lógo"},{"start":30.351,"end":31.092,"text":"Ọrun n' ile","marked":"Ọ̀run ń ilẹ̀"},{"start":31.542,"end":32.731,"text":"Nib' awọn mimọ wa,","marked":"Níb àwọn mímọ́ wà"},{"start":33.181,"end":34.263,"text":"Lẹhin 'rin-ajo wọn,","marked":"Lẹ́hìn rin-ajo wọn"},{"start":34.713,"end":35.729,"text":"Ti wọn ni 'sinmi wọn,","marked":"Tí wọ́n ní sinmi wọn"},{"start":36.179,"end":37.115,"text":"Nibẹ n' ile.","marked":"Níbẹ̀ ń ilẹ̀."}],"end":37.115},{"key":"4","start":38.065,"lines":[{"start":38.065,"end":39.671,"text":"Njẹ n ki o kun, tori","marked":"Ǹjẹ́ n kí ó kún, torí"},{"start":40.121,"end":40.838,"text":"Ọrun n' ile;","marked":"Ọ̀run ń ilẹ̀"},{"start":41.288,"end":42.632,"text":"Ohun t'o wu ki n ri,","marked":"Ohun t'ó wù kí n rí"},{"start":43.082,"end":44.038,"text":"Ọrun n'ile","marked":"Ọ̀run n'ilẹ̀"},{"start":44.488,"end":45.865,"text":"N ó sa duro dandan;","marked":"N ó sá dúró dandan"},{"start":46.315,"end":47.304,"text":"L'ọtun Oluwa mi","marked":"L'ọ́tún Olúwa mi"},{"start":47.754,"end":49.014,"text":"Ọrun ni ilu mi.","marked":"Ọ̀run ni ìlú mi."},{"start":49.464,"end":50.337,"text":"Ọrun n' ile.","marked":"Ọ̀run ń ilẹ̀."}],"end":50.337}]}