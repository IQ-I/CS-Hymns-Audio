{"v":3,"coll":"y","num":197,"id":"hymn_197","title":"OJO nla kan ma mbo","duration":30.354,"voices":{"male":{"file":"y-197-male-v3.m4a","bytes":202706,"sha256":"d5647eef500b9d61f8900284aa4434186668a3eea5b283b3bfe81359d804230c","duration":30.4},"female":{"file":"y-197-female-v3.m4a","bytes":210508,"sha256":"8b398093e4f9891f4ffed927b57b833f5b42676ecadad43a23cb592ceaff15aa","duration":30.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.649,"text":"ỌJỌ nla kan ma mbọ,","marked":"Ọjọ́ ńlá kan má mbọ̀"},{"start":2.099,"end":3.652,"text":"T' Olusiro y'o de,","marked":"T Olùṣirò y'ó dé"},{"start":4.102,"end":5.386,"text":"Gbogbo eniyan yoo ri,","marked":"Gbogbo ènìyàn yóò rí"},{"start":5.836,"end":6.975,"text":"Ayé yoo wariri.","marked":"Ayé yóò wárìrì."}],"end":6.975},{"key":"2","start":7.925,"lines":[{"start":7.925,"end":9.053,"text":"Igbagbo re ha da","marked":"Ìgbàgbọ́ rẹ ha dá"},{"start":9.503,"end":10.614,"text":"Wo ti ko m'Olorun","marked":"Wo tí kò m'Ọlọ́run"},{"start":11.064,"end":12.434,"text":"T'o f'eda se igbekele","marked":"T'ó f'ẹ̀dà ṣe ìgbẹ́kẹ̀lé"},{"start":12.884,"end":14.246,"text":"T'o f' Oluwa sile.","marked":"T'ó f Olúwa sílẹ̀."}],"end":14.246},{"key":"3","start":15.196,"lines":[{"start":15.196,"end":16.483,"text":"Ayọ pupọ yoo wa,","marked":"Ayọ̀ púpọ̀ yóò wà"},{"start":16.933,"end":18.431,"text":"L'ọkan ti Jesu ń gbe,","marked":"L'ọkàn tí Jésù ń gbé"},{"start":18.881,"end":20.259,"text":"Ti wọn ti kọ ayé silẹ,","marked":"Tí wọ́n ti kọ ayé sílẹ̀"},{"start":20.709,"end":21.65,"text":"T'o gba Ẹmi Mimọ.","marked":"T'ó gba Ẹ̀mí Mímọ́."}],"end":21.65},{"key":"4","start":22.6,"lines":[{"start":22.6,"end":23.697,"text":"Ẹ ku 'sẹ Oluwa,","marked":"Ẹ kú 'sẹ Olúwa"},{"start":24.147,"end":25.406,"text":"Ẹyin ara at'ọrẹ,","marked":"Ẹ̀yin ará àt'ọrẹ"},{"start":25.856,"end":27.029,"text":"Ki Baba Olodumare,","marked":"Kí Baba Olódùmarè"},{"start":27.479,"end":28.804,"text":"Bukun fun gbogbo wa.","marked":"Bùkún fún gbogbo wa."}],"end":28.804}]}