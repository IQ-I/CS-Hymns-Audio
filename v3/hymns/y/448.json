{"v":3,"coll":"y","num":448,"id":"hymn_448","title":"EYIN Omo Egbe Kerubu","duration":76.386,"voices":{"male":{"file":"y-448-male-v3.m4a","bytes":542820,"sha256":"9636f8a84a403a05dd4c9aadf13a891a20c07cb7f97614f12388b45246655236","duration":76.4},"female":{"file":"y-448-female-v3.m4a","bytes":567581,"sha256":"a41b0c6edd7507141b1f85c180a9fc6579ad7a074430722e6500835b9f3251c3","duration":76.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.944,"text":"ENYIN Omo Egbe Kerubu","marked":"Ẹ̀yin Ọmọ Ẹgbẹ́ Kérúbù"},{"start":2.394,"end":3.771,"text":"Ma beru, ma sojo","marked":"Má bẹ̀rù, má ṣojo"},{"start":4.221,"end":5.706,"text":"Oluwa l'o n ran wa n'ise","marked":"Olúwa l'ó ń ràn wá n'iṣẹ́"},{"start":6.156,"end":7.413,"text":"Awa ki yio beru.","marked":"Àwa kí yóò bẹ̀rù."},{"start":7.863,"end":9.59,"text":"Egbe:  Baiye nsata pelu Esu","marked":"Báìyẹ́ ńṣátà pẹ̀lú Èṣù"},{"start":10.04,"end":11.882,"text":"Eke ni won, nwon nse lasan","marked":"Èké ni wọ́n, wọ́n ńṣe lásán"},{"start":12.332,"end":14.302,"text":"B'aiye nsatan, pelu esu","marked":"B'ayé ńṣátán, pẹ̀lú èṣù"},{"start":14.752,"end":16.687,"text":"Eke ni nwon, nwon nse lasan.","marked":"Èké ni wọ́n, wọ́n ńṣe lásán."}],"end":16.687},{"key":"2","start":17.637,"lines":[{"start":17.637,"end":19.09,"text":"Enyin Omo Egbe Serafu","marked":"Ẹ̀yin Ọmọ Ẹgbẹ́ Séráfù"},{"start":19.54,"end":20.888,"text":"Ma je k'oju ti nyin","marked":"Má jẹ́ k'ojú ti yín"},{"start":21.338,"end":23.002,"text":"lse Oluwa l'a wa nje","marked":"Iṣẹ́ Olúwa l'á wá ǹjẹ́"},{"start":23.452,"end":24.781,"text":"Awa ki yio tiju.","marked":"Àwa kí yóò tijú."},{"start":25.231,"end":26.764,"text":"Egbe:  Baiye nsata pelu Esu...","marked":"Báìyẹ́ ńṣátà pẹ̀lú Èṣù"}],"end":26.764},{"key":"3","start":27.714,"lines":[{"start":27.714,"end":29.093,"text":"Enyin Egbe Aladura","marked":"Ẹ̀yin Ẹgbẹ́ Aládúrà"},{"start":29.543,"end":30.822,"text":"E mura s'ise nyin","marked":"Ẹ múra s'iṣẹ́ yín"},{"start":31.272,"end":33.15,"text":"Gbogbo ise nyin ti e nse","marked":"Gbogbo iṣẹ́ yín tí ẹ ńṣe"},{"start":33.6,"end":35.017,"text":"Okan ko lo lasan.","marked":"Ọkàn kò lọ lásán."},{"start":35.467,"end":36.925,"text":"Egbe:  Baiye nsata pelu Esu...","marked":"Báìyẹ́ ńṣátà pẹ̀lú Èṣù"}],"end":36.925},{"key":"4","start":37.875,"lines":[{"start":37.875,"end":39.248,"text":"Enyin Omo Egbe Bibeli","marked":"Ẹ̀yin Ọmọ Ẹgbẹ́ Bíbélì"},{"start":39.698,"end":40.817,"text":"E mura s'adura","marked":"Ẹ múra s'àdúrà"},{"start":41.267,"end":42.79,"text":"K'Olorun la oju emi nyin","marked":"K'Ọlọ́run la ojú ẹ̀mí yín"},{"start":43.24,"end":44.496,"text":"Lati rohun ijinle.","marked":"Láti rohùn ìjìnlẹ̀."},{"start":44.946,"end":46.655,"text":"Egbe:  Baiye nsata pelu Esu...","marked":"Báìyẹ́ ńṣátà pẹ̀lú Èṣù"}],"end":46.655},{"key":"5","start":47.605,"lines":[{"start":47.605,"end":49.02,"text":"Enyin Omo Egbe Akorin","marked":"Ẹ̀yin Ọmọ Ẹgbẹ́ Akọrin"},{"start":49.47,"end":50.643,"text":"E tun ohun nyin se,","marked":"Ẹ tún ohun yín ṣe"},{"start":51.093,"end":52.676,"text":"Orin l'awa yio ko lorun","marked":"Orin l'àwa yóò kò lọ́rùn"},{"start":53.126,"end":54.317,"text":"A ko n'ise miran.","marked":"A kò n'iṣẹ́ míràn."},{"start":54.767,"end":56.348,"text":"Egbe:  Baiye nsata pelu Esu...","marked":"Báìyẹ́ ńṣátà pẹ̀lú Èṣù"}],"end":56.348},{"key":"6","start":57.298,"lines":[{"start":57.298,"end":58.611,"text":"E'ogo fun Metalokan","marked":"E'ògo fún Mẹ́talọ́kan"},{"start":59.061,"end":60.954,"text":"Baba Omo, Emi","marked":"Baba Ọmọ, Èmi"},{"start":61.404,"end":62.996,"text":"Titi aiye ainipekun","marked":"Títí ayé àìnípẹ̀kun"},{"start":63.446,"end":64.761,"text":"Amin! beni ki o ri.","marked":"Àmín! bẹ́ni kí ó rí."},{"start":65.211,"end":66.729,"text":"Egbe:  Baiye nsata pelu Esu","marked":"Báìyẹ́ ńṣátà pẹ̀lú Èṣù"},{"start":67.179,"end":69.091,"text":"Eke ni won, nwon nse lasan","marked":"Èké ni wọ́n, wọ́n ńṣe lásán"},{"start":69.541,"end":71.381,"text":"B'aiye nsatan, pelu esu","marked":"B'ayé ńṣátán, pẹ̀lú èṣù"},{"start":71.831,"end":73.793,"text":"Eke ni nwon, nwon nse lasan.","marked":"Èké ni wọ́n, wọ́n ńṣe lásán."},{"start":74.243,"end":74.837,"text":"Amin.","marked":"Àmín."}],"end":74.837}]}