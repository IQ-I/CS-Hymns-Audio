{"v":3,"coll":"y","num":770,"id":"hymn_770","title":"EYIN 'ranse Kristi","duration":30.52,"voices":{"male":{"file":"y-770-male-v3.m4a","bytes":203187,"sha256":"2cd05883ffac10eb5c0612427e32a18be2cd5d783a35b342573093c75672abbe","duration":30.6},"female":{"file":"y-770-female-v3.m4a","bytes":211726,"sha256":"1e07d3dbd81d0279bb643f42f9c2652cb63a9028689d39704e72e7101072771f","duration":30.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.646,"text":"ẸYIN 'ransẹ Kristi,","marked":"Ẹ̀yin 'ransẹ Kristi"},{"start":2.096,"end":3.181,"text":"Gbọ ohun ipe Rẹ,","marked":"Gbọ́ ohùn ìpè Rẹ"},{"start":3.631,"end":4.998,"text":"Ẹ tẹle 'bi t'o fọna han,","marked":"Ẹ tẹ̀lé bí t'ó fọ̀nà hàn"},{"start":5.448,"end":6.683,"text":"A n pe yin s'ọna Rẹ.","marked":"A ń pè yín s'ọ́nà Rẹ̀."}],"end":6.683},{"key":"2","start":7.633,"lines":[{"start":7.633,"end":8.913,"text":"Baba ti ẹyin n sin,","marked":"Baba tí ẹ̀yin ń sìn"},{"start":9.363,"end":10.807,"text":"O n'ipa to fun yin;","marked":"Ó n'ipa tó fún yín"},{"start":11.257,"end":12.707,"text":"N'igbẹkẹle ileri Rẹ,","marked":"N'ìgbẹ́kẹ̀lé ìlérí Rẹ"},{"start":13.157,"end":14.39,"text":"Ẹ ja bi ọkunrin.","marked":"Ẹ jà bí ọkùnrin."}],"end":14.39},{"key":"3","start":15.34,"lines":[{"start":15.34,"end":16.373,"text":"Lo f'Olugbala han","marked":"Lọ f'Olùgbàlà hàn"},{"start":16.823,"end":17.853,"text":"Ati anu nla Re","marked":"Àti àánú ńlá Rẹ"},{"start":18.303,"end":19.486,"text":"F'awon otosi elese","marked":"F'àwọn òtòṣì ẹlẹ́ṣẹ̀"},{"start":19.936,"end":20.954,"text":"Ninu omo Adam.","marked":"Nínú ọmọ Adam."}],"end":20.954},{"key":"4","start":21.904,"lines":[{"start":21.904,"end":23.225,"text":"L'orukọ Jesu wa,","marked":"L'orúkọ Jésù wà"},{"start":23.675,"end":24.933,"text":"A ki yin, ―Ọna rẹ! ‖","marked":"A kí yín, ―Ọ̀nà rẹ̀! ‖"},{"start":25.383,"end":27.031,"text":"A mbẹ Ẹni t'o ran yin lọ,","marked":"A mbẹ Ẹni t'ó rán yín lọ"},{"start":27.481,"end":28.971,"text":"K'O busi isẹ yin.","marked":"K'Ó bùsi isẹ́ yín."}],"end":28.971}]}