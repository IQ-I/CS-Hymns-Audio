{"v":3,"coll":"y","num":532,"id":"hymn_532","title":"FE enikeji re","duration":37.931,"voices":{"male":{"file":"y-532-male-v3.m4a","bytes":254803,"sha256":"ace6464d1dc9f37580509f8482b8d4c18e8776598aef96560a4ce75c0900a37d","duration":38.0},"female":{"file":"y-532-female-v3.m4a","bytes":272152,"sha256":"5111690461002d85ed8282727e65c1a06c139854de477ec66c0eae7b789298ce","duration":38.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.425,"text":"'FẸ ẹnikeji rẹ,","marked":"'Fẹ ẹnìkejì rẹ"},{"start":1.875,"end":2.895,"text":"Asẹ Oluwa ni;","marked":"Àsẹ Olúwa ni"},{"start":3.345,"end":4.853,"text":"O wa f'ara Rẹ s'apẹrẹ,","marked":"Ó wá f'ara Rẹ̀ s'apẹ̀rẹ̀"},{"start":5.303,"end":6.568,"text":"Ni fifẹ t'O fẹ wa.","marked":"Ní fífẹ́ t'Ó fẹ́ wá."}],"end":6.568},{"key":"2","start":7.518,"lines":[{"start":7.518,"end":8.636,"text":"Fe enikeji re","marked":"Fẹ́ ẹnìkejì rẹ"},{"start":9.086,"end":10.428,"text":"N'ire tabi n'ija","marked":"N'ìre tàbí n'ìjà"},{"start":10.878,"end":13.131,"text":"O ko wa pe k'a f'ota wa","marked":"Ó kò wá pé k'á f'ọ̀tá wa"},{"start":13.581,"end":14.827,"text":"K'a f'ore san ibi.","marked":"K'á f'ọrẹ san ibi."}],"end":14.827},{"key":"3","start":15.777,"lines":[{"start":15.777,"end":17.012,"text":"Fẹ enikeji rẹ.","marked":"Fẹ́ ẹnìkejì rẹ."},{"start":17.462,"end":18.576,"text":"Oluwa n ke tantan;","marked":"Olúwa ń ké tàntàn"},{"start":19.026,"end":20.328,"text":"O yẹ ki gbogbo wa mura,","marked":"Ó yẹ kí gbogbo wa múra"},{"start":20.778,"end":22.083,"text":"K'a f'ẹnikeji wa.","marked":"K'á f'ẹnìkejì wá."}],"end":22.083},{"key":"4","start":23.033,"lines":[{"start":23.033,"end":24.2,"text":"Fe enikeji re","marked":"Fẹ́ ẹnìkejì rẹ"},{"start":24.65,"end":25.624,"text":"At'aladugbo re","marked":"Àt'aládùgbò rẹ"},{"start":26.074,"end":27.281,"text":"Pelu gbogb'eni yi o ka","marked":"Pẹ̀lú gbogb'ẹni yí ó ká"},{"start":27.731,"end":28.814,"text":"At' ota re pelu.","marked":"Àt ọ̀tá rẹ̀ pẹ̀lú."}],"end":28.814},{"key":"5","start":29.764,"lines":[{"start":29.764,"end":31.014,"text":"K'a f'enikeji wa","marked":"K'á f'ẹnìkejì wa"},{"start":31.464,"end":32.835,"text":"Bi Jesu ti fe wa","marked":"Bí Jésù ti fẹ́ wá"},{"start":33.285,"end":34.727,"text":"Jesu sa f'awon ota Re","marked":"Jésù sá f'àwọn ọ̀tá Rẹ̀"},{"start":35.177,"end":36.382,"text":"O si sure fun won.","marked":"Ó sì súre fún wọn."}],"end":36.382}]}