{"v":3,"coll":"y","num":737,"id":"hymn_737","title":"GBOGBO aye Serafu de","duration":129.662,"voices":{"male":{"file":"y-737-male-v3.m4a","bytes":899848,"sha256":"097e54a98292aaf0e5fc64b818ab2eaf4bd7dc70cc4f6470a32cf6786b580e24","duration":129.7},"female":{"file":"y-737-female-v3.m4a","bytes":937692,"sha256":"850a25e566790090fe27b3549f1a00fcdec67acf0fe2f9436eb80257d0e9ad97","duration":129.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.738,"text":"GBOGBO aiye Serafu de","marked":"Gbogbo ayé Séráfù dé"},{"start":2.188,"end":3.588,"text":"Lati kede oro na","marked":"Láti kéde ọ̀rọ̀ ná"},{"start":4.038,"end":5.458,"text":"T'Olugbala ti fi lele","marked":"T'Olùgbàlà ti fi lélẹ̀"},{"start":5.908,"end":7.326,"text":"Lowo Orimolade.","marked":"Lọ́wọ́ Orímọ́ládé."}],"end":7.326},{"key":"CHORUS","start":8.276,"lines":[{"start":8.276,"end":9.766,"text":"Lodo Baba Aladura","marked":"Lọ́dọ̀ Baba Aládúrà"},{"start":10.216,"end":11.687,"text":"Eni to d'egbe yi sile","marked":"Ẹni tó d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":12.137,"end":14.43,"text":"Nibi Serafu, Kerubu","marked":"Níbi Séráfù, Kérúbù"},{"start":14.88,"end":16.285,"text":"Nyin Baba Mimo logo.","marked":"Yín Baba Mímọ́ lógo."}],"end":16.285},{"key":"2","start":17.235,"lines":[{"start":17.235,"end":19.136,"text":"Adahunse, ateyepe","marked":"Adáhùnṣe, àtẹ̀yẹpẹ́"},{"start":19.586,"end":20.87,"text":"Aye Egbe si sile","marked":"Ayé Ẹgbẹ́ sì sílẹ̀"},{"start":21.32,"end":22.577,"text":"K'enyin wa ronupiwada","marked":"K'ẹ̀yin wá ronúpìwàdà"},{"start":23.027,"end":24.349,"text":"Lodo orimolade.","marked":"Lọ́dọ̀ orímọ́ládé."}],"end":24.349},{"key":"3","start":25.299,"lines":[{"start":25.299,"end":27.27,"text":"Babalawo, onitira","marked":"Babalawo, onítira"},{"start":27.72,"end":28.847,"text":"E wa ronupiwada","marked":"Ẹ wá ronúpìwàdà"},{"start":29.297,"end":30.746,"text":"Ke wa di opo iye Re mu","marked":"Ké wá di ọ̀pọ̀ iye Rẹ̀ mú"},{"start":31.196,"end":32.501,"text":"Lodo Orimolade.","marked":"Lọ́dọ̀ Orímọ́ládé."}],"end":32.501},{"key":"4","start":33.451,"lines":[{"start":33.451,"end":35.39,"text":"Sonponna ko lo sora re","marked":"Ṣọ̀ǹpọ́nná kò lọ ṣọ́ra rẹ̀"},{"start":35.84,"end":37.224,"text":"Lodo Egbe Serafu","marked":"Lọ́dọ̀ Ẹgbẹ́ Séráfù"},{"start":37.674,"end":38.848,"text":"Oniwunde ti sokale","marked":"Oníwúńdè ti sọ̀kalẹ̀"},{"start":39.298,"end":40.552,"text":"Sinu Egbe Kerubu.","marked":"Sínú Ẹgbẹ́ Kérúbù."}],"end":40.552},{"key":"5","start":41.502,"lines":[{"start":41.502,"end":43.179,"text":"Egungun ati gelede","marked":"Egungun àti gẹlẹ́dẹ̀"},{"start":43.629,"end":44.824,"text":"E wa ronupiwada","marked":"Ẹ wá ronúpìwàdà"},{"start":45.274,"end":46.482,"text":"Ka jumo yin Olorun wa","marked":"Ká jùmọ̀ yin Ọlọ́run wa"},{"start":46.932,"end":48.246,"text":"Ninu Egbe Serafu.","marked":"Nínú Ẹgbẹ́ Séráfù."}],"end":48.246},{"key":"6","start":49.196,"lines":[{"start":49.196,"end":50.739,"text":"lgunnu ati agemo","marked":"Ìgùnnú àti àgẹ̀mọ́"},{"start":51.189,"end":52.371,"text":"E wa ronupiwada","marked":"Ẹ wá ronúpìwàdà"},{"start":52.821,"end":54.101,"text":"K'e wa di opo iye mu","marked":"K'é wá di ọ̀pọ̀ iye mú"},{"start":54.551,"end":55.987,"text":"Lodo Orimolade.","marked":"Lọ́dọ̀ Orímọ́ládé."}],"end":55.987},{"key":"7","start":56.937,"lines":[{"start":56.937,"end":58.046,"text":"A juba Olorun baba","marked":"A júbà Ọlọ́run Baba"},{"start":58.496,"end":59.629,"text":"Omo at'Emi Mimo","marked":"Ọmọ àt'ẹ̀mí Mímọ́"},{"start":60.079,"end":61.728,"text":"Metalokan aiyeraiye","marked":"Mẹ́talọ́kan ayérayé"},{"start":62.178,"end":63.51,"text":"Ninu Egbe Serafu.","marked":"Nínú Ẹgbẹ́ Séráfù."}],"end":63.51},{"key":"8","start":64.46,"lines":[{"start":64.46,"end":66.264,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":66.714,"end":67.915,"text":"T'o wa ni gbogbo aiye","marked":"T'ó wà ní gbogbo ayé"},{"start":68.365,"end":69.755,"text":"K'awa damure wa giri","marked":"K'àwa dàmúrè wa gírí"},{"start":70.205,"end":71.575,"text":"Lati kdede oro na.","marked":"Láti kdẹ̀dẹ̀ ọ̀rọ̀ ná."}],"end":71.575},{"key":"9","start":72.525,"lines":[{"start":72.525,"end":73.995,"text":"A ki Baba Aladura","marked":"A kí Baba Aládúrà"},{"start":74.445,"end":75.83,"text":"T'Olorun f'Egbe yi ran","marked":"T'Ọlọ́run f'Ègbé yí rán"},{"start":76.28,"end":77.652,"text":"Jerusalemu sokale","marked":"Jerúsálẹ́mù sọ̀kalẹ̀"},{"start":78.102,"end":79.47,"text":"Lodo Orimolade.","marked":"Lọ́dọ̀ Orímọ́ládé."}],"end":79.47},{"key":"10","start":80.42,"lines":[{"start":80.42,"end":82.322,"text":"Enyin ara, e ku 'duro","marked":"Ẹ̀yin ara, ẹ kú dúró"},{"start":82.772,"end":84.723,"text":"Enyin ara, e ku 'joko","marked":"Ẹ̀yin ara, ẹ kú jókò"},{"start":85.173,"end":86.604,"text":"Oko 'gbala wa lode Eko","marked":"Oko gbàlà wa lóde Ẹ̀kọ́"},{"start":87.054,"end":88.343,"text":"Lodo orimolade.","marked":"Lọ́dọ̀ orímọ́ládé."}],"end":88.343},{"key":"11","start":89.293,"lines":[{"start":89.293,"end":90.643,"text":"Olorun to gbo t'Elijah","marked":"Ọlọ́run tó gbọ́ t'Elijah"},{"start":91.093,"end":92.366,"text":"T'o so mu lo sodo Re","marked":"T'ó sọ mú lọ sọ́dọ̀ Rẹ"},{"start":92.816,"end":94.206,"text":"Ko wa ran Mosisi lowo","marked":"Kò wá rán Mosisi lọ́wọ́"},{"start":94.656,"end":96.033,"text":"Ko le wa d'odo Re.","marked":"Kò lè wá d'ọ̀dọ̀ Rẹ."}],"end":96.033},{"key":"12","start":96.983,"lines":[{"start":96.983,"end":98.003,"text":"Olorun Abraham","marked":"Ọlọ́run Abraham"},{"start":98.453,"end":99.936,"text":"Isaac ati Jakobu","marked":"Isaac àti Jakọbu"},{"start":100.386,"end":102.301,"text":"Baba, Omo, Emi Mimo","marked":"Baba, Ọmọ, Ẹ̀mí Mímọ́"},{"start":102.751,"end":104.576,"text":"Metalokan aiyeraiye.","marked":"Mẹ́talọ́kan ayérayé."}],"end":104.576},{"key":"13","start":105.526,"lines":[{"start":105.526,"end":107.401,"text":"Adaba orun, sokale","marked":"Àdàbà ọ̀run, sọ̀kalẹ̀"},{"start":107.851,"end":108.967,"text":"E wa ran baba lowo","marked":"Ẹ wá rán Baba lọ́wọ́"},{"start":109.417,"end":110.922,"text":"K'ade ogo le je tire","marked":"K'adé ògo lè jẹ́ tirẹ̀"},{"start":111.372,"end":112.756,"text":"Ti enikan ko le gba.","marked":"Tí ẹnìkan kò lè gbà."}],"end":112.756},{"key":"14","start":113.706,"lines":[{"start":113.706,"end":115.001,"text":"Michael Gabrieli,","marked":"Michael Gabrieli"},{"start":115.451,"end":116.559,"text":"Enyin agba Angeli","marked":"Ẹ̀yin àgbà Áńgẹ́lì"},{"start":117.009,"end":118.453,"text":"Emmanueli Oba wa","marked":"Emmanueli Ọba wa"},{"start":118.903,"end":120.394,"text":"Metalokan la o sin.","marked":"Mẹ́talọ́kan la ó sìn."}],"end":120.394},{"key":"15","start":121.344,"lines":[{"start":121.344,"end":122.673,"text":"A f'ope f'Olorun Baba","marked":"A f'ọpẹ́ f'Ọlọ́run Baba"},{"start":123.123,"end":124.261,"text":"Omo at'Emi Mimo","marked":"Ọmọ àt'ẹ̀mí Mímọ́"},{"start":124.711,"end":126.352,"text":"Metalokan aiyeraiye","marked":"Mẹ́talọ́kan ayérayé"},{"start":126.802,"end":128.114,"text":"Ninu Egbe Serafu.","marked":"Nínú Ẹgbẹ́ Séráfù."}],"end":128.114}]}