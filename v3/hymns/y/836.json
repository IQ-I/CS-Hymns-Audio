{"v":3,"coll":"y","num":836,"id":"hymn_836","title":"EMI okan at'ara","duration":45.747,"voices":{"male":{"file":"y-836-male.m4a","bytes":330806,"sha256":"af0d07816ed38e0d8a4140702f5fb4ba4ab194097dcd040ddb0bc0e9c4f831cb","duration":45.8},"female":{"file":"y-836-female.m4a","bytes":343136,"sha256":"1838d8cf1962b09ff39139463b85a23b6e3be14dcac1e3952b90bbf7d0174c9a","duration":45.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.746,"text":"EMI, okan at'ara","marked":"Èmi, ọkàn àt'ára"},{"start":2.126,"end":3.328,"text":"Jesu mo fi fun O","marked":"Jésù mo fi fún Ọ"},{"start":3.708,"end":4.887,"text":"Fun ebo mimo lati","marked":"Fún ẹbọ mímọ́́ láti"},{"start":5.267,"end":6.432,"text":"Ma je Tire titi","marked":"Má jẹ́ Tírè títí"},{"start":6.812,"end":8.101,"text":"Mo fi ara mi rubo","marked":"Mo fi ara mi rúbọ"},{"start":8.481,"end":10.102,"text":"Jesu Tire l'emi","marked":"Jésù Tírè l'èmi"},{"start":10.482,"end":11.983,"text":"Ki 'gbagbo mi mase ye","marked":"Kí 'gbàgbọ́ mi máṣe yé"},{"start":12.363,"end":13.727,"text":"Se mi mi ni tire nikan.","marked":"Ṣe mí mi ní tìrẹ nìkan."}],"end":13.727},{"key":"2","start":14.677,"lines":[{"start":14.677,"end":16.593,"text":"Jesu, Olugbala nla","marked":"Jésù, Olùgbàlà ńlá"},{"start":16.973,"end":18.266,"text":"Mo gbeke mi le O","marked":"Mo gbẹ́kẹ̀ mi lé O"},{"start":18.646,"end":20.164,"text":"Mo wa igbala nla Re","marked":"Mo wá ìgbàlà ńlá Rẹ"},{"start":20.544,"end":21.528,"text":"Mo bere 'leri Re","marked":"Mo bẹ̀rẹ̀ 'lérí Rẹ"},{"start":21.908,"end":23.518,"text":"Mo gba eya ara mi","marked":"Mo gba ẹ̀yà ara mi"},{"start":23.898,"end":25.134,"text":"Kuro labe ese","marked":"Kúrò lábẹ́ ẹsẹ̀"},{"start":25.514,"end":26.848,"text":"Mo fi fun o b'ohun elo","marked":"Mo fi fún ọ b'ohun èlò"},{"start":27.228,"end":28.622,"text":"Lati lo si segun.","marked":"Láti lọ sì ṣẹ́gun."}],"end":28.622},{"key":"3","start":29.572,"lines":[{"start":29.572,"end":31.053,"text":"Mo f'ise t'ara sile","marked":"Mo f'iṣẹ́ t'ára sílẹ̀"},{"start":31.433,"end":32.809,"text":"Ki nle wa lodo Re","marked":"Kí ńlẹ̀ wà lọ́dọ̀ Rẹ"},{"start":33.189,"end":34.685,"text":"Jesu Olugbala mi","marked":"Jésù Olùgbàlà mi"},{"start":35.065,"end":36.306,"text":"F'emi Re sinu mi","marked":"F'ẹ̀mí Rẹ sínú mi"},{"start":36.686,"end":38.512,"text":"Tire li emi, Jesu","marked":"Tìrẹ li èmi, Jésù"},{"start":38.892,"end":40.078,"text":"T'a f'eje Re we mo","marked":"T'á f'ẹ̀jẹ̀ Rẹ̀ wé mọ́"},{"start":40.458,"end":41.83,"text":"T'Emi ti ya si mimo","marked":"T'Èmi ti yà sí mímọ́́"},{"start":42.21,"end":43.23,"text":"Ebo fun Olorun.","marked":"Ẹbọ fún Ọlọ́run."},{"start":43.61,"end":44.197,"text":"Amin.","marked":"Àmín."}],"end":44.197}]}