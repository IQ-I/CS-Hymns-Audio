{"v":3,"coll":"y","num":321,"id":"hymn_321","title":"LO so fun gbogbo aye","duration":34.524,"voices":{"male":{"file":"y-321-male-v3.m4a","bytes":237529,"sha256":"611c60ebf89c968150e1369482f730dc2a53126c5ab31a6f5d8e07a71d9a2d2f","duration":34.6},"female":{"file":"y-321-female-v3.m4a","bytes":247220,"sha256":"8c2e609848cb0041fe40de87a5632139378cddb2ca5b513a80cf11dab419fb32","duration":34.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.609,"text":"LỌ sọ fun gbogbo ayé,","marked":"Lọ sọ fún gbogbo ayé"},{"start":2.059,"end":3.388,"text":"Lọ tan ihin ayọ yi;","marked":"Lọ tan ìhín ayọ̀ yí"},{"start":3.838,"end":5.876,"text":"Eti t'o ba gbọ, y'o si,","marked":"Etí t'ó bá gbọ́, y'ó sì"},{"start":6.326,"end":8.388,"text":"Ọkan t'o ba gbọ, y'o la.","marked":"Ọkàn t'ó bá gbọ́, y'ó là."}],"end":8.388},{"key":"2","start":9.338,"lines":[{"start":9.338,"end":10.647,"text":"Jesu Olugbala wa,","marked":"Jésù Olùgbàlà wa"},{"start":11.097,"end":13.348,"text":"T'a sin, fi 'boji silẹ;","marked":"T'á sìn, fi bojì sílẹ̀"},{"start":13.798,"end":14.957,"text":"Ọlọrun gba ẹbọ Rẹ,","marked":"Ọlọ́run gba ẹbọ Rẹ̀"},{"start":15.407,"end":16.496,"text":"Ẹbọ ẹsẹ arayé.","marked":"Ẹbọ ẹsẹ̀ arayé."}],"end":16.496},{"key":"3","start":17.446,"lines":[{"start":17.446,"end":18.744,"text":"O ji lati ma ku mọ,","marked":"Ó jí láti má kú mọ́"},{"start":19.194,"end":20.716,"text":"Akọbi awọn t'o sun;","marked":"Àkọ́bí àwọn t'ó sùn"},{"start":21.166,"end":22.574,"text":"Ẹni ti o ba gba a gbọ,","marked":"Ẹni tí ó bá gbà á gbọ́"},{"start":23.024,"end":25.245,"text":"Yoo ye, b'o tilẹ ku.","marked":"Yóò yẹ, b'ó tilẹ̀ kú."}],"end":25.245},{"key":"4","start":26.195,"lines":[{"start":26.195,"end":27.978,"text":"Angẹli! Ẹda ọrun,","marked":"Áńgẹ́lì! Ẹ̀dá ọ̀run"},{"start":28.428,"end":29.624,"text":"f Ẹ ba arayé gberin,","marked":"f Ẹ bá arayé gbẹ́rin"},{"start":30.074,"end":31.332,"text":"Jesu Oludande ji,","marked":"Jésù Olùdáǹdè jí"},{"start":31.782,"end":32.974,"text":"Alafia titi lai.","marked":"Àlàáfíà títí láì."}],"end":32.974}]}