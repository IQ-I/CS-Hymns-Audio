{"v":3,"coll":"y","num":832,"id":"hymn_832","title":"A DUPE lowo Jehofa","duration":63.374,"voices":{"male":{"file":"y-832-male.m4a","bytes":445414,"sha256":"ffdc1c7fb89be3b00906c3d8c0fc596a8a082ebd88feb1a62c84ca4e43636a55","duration":63.4},"female":{"file":"y-832-female.m4a","bytes":466236,"sha256":"0ed2aaf6433b80cb03dd042e4d1d5ae76881a7d303c0e8de8204c9848222d1a8","duration":63.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.614,"text":"A DUPE lowo Jehovah","marked":"A Dúpẹ́ lọ́wọ́ Jehovah"},{"start":1.994,"end":3.101,"text":"Oba Onibu-ore","marked":"Ọba Oníbù-ọrẹ́"},{"start":3.481,"end":5.782,"text":"Fun isegun t'o se fun wa","marked":"Fún ìṣègùn t'ó ṣe fún wa"},{"start":6.162,"end":7.524,"text":"Larin odun t'o koja.","marked":"Lárin ọdún t'ó kọjá."}],"end":7.524},{"key":"CHORUS","start":8.474,"lines":[{"start":8.474,"end":10.339,"text":"Awa si njo, awa si nyo","marked":"Àwa sì njo, àwa sì nyo"},{"start":10.719,"end":11.978,"text":"Fun idasi wa oni","marked":"Fún ìdásí wa ọ̀nì"},{"start":12.358,"end":13.717,"text":"Ayo kun okan wa loni","marked":"Ayọ̀ kún ọkàn wa lónì"},{"start":14.097,"end":15.326,"text":"Ogo fun metalokan.","marked":"Ògo fún Mẹ́talọ́kan."}],"end":15.326},{"key":"2","start":16.276,"lines":[{"start":16.276,"end":17.474,"text":"Ojo ayo l'oni fun wa","marked":"Ọjọ́ ayọ̀ l'ọ́ni fún wa"},{"start":17.854,"end":19.1,"text":"Awa si nse 'sin oro","marked":"Àwa sì ńṣe 'sin ọ̀rọ̀"},{"start":19.48,"end":21.102,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":21.482,"end":23.059,"text":"E jeki a jo yin Baba.","marked":"Ẹ jẹ́kí a jọ yin Bàbá."}],"end":23.059},{"key":"3","start":24.009,"lines":[{"start":24.009,"end":25.598,"text":"Jesu Olori Egbe wa","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":25.978,"end":27.374,"text":"jek' a ri O l'arin wa","marked":"jek' a rí Ò l'árín wa"},{"start":27.754,"end":29.016,"text":"Awa f'iyin fun O loni","marked":"Àwa f'ìyìn fún Ọ lónì"},{"start":29.396,"end":30.885,"text":"Fun idasi erni wa.","marked":"Fún ìdásí erni wa."}],"end":30.885},{"key":"4","start":31.835,"lines":[{"start":31.835,"end":33.572,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":33.952,"end":35.447,"text":"Awa l'ayanfe Omo","marked":"Àwa l'àyànfẹ́ Ọmọ"},{"start":35.827,"end":37.092,"text":"Fun Olorun Metalokan","marked":"Fún Ọlọ́run Mẹ́talọ́kan"},{"start":37.472,"end":38.563,"text":"Oba Awimayehun.","marked":"Ọba Awímáyẹhùn."}],"end":38.563},{"key":"5","start":39.513,"lines":[{"start":39.513,"end":41.005,"text":"Gbogbo aje t'o wa laiye","marked":"Gbogbo àjẹ́ t'ó wà láìyẹ"},{"start":41.385,"end":42.632,"text":"Agbara won ti wo mi","marked":"Agbára wọn ti wọ̀ mí"},{"start":43.012,"end":44.379,"text":"Ni agbara Metalokan","marked":"Ní agbára Mẹ́talọ́kan"},{"start":44.759,"end":46.242,"text":"Awa y'o segun esu.","marked":"Àwa y'ó ṣẹ́gun èṣù."}],"end":46.242},{"key":"6","start":47.192,"lines":[{"start":47.192,"end":48.803,"text":"Ojo aye wa nlo s'opin","marked":"Ọjọ́ ayé wa ńlọ s'òpin"},{"start":49.183,"end":50.539,"text":"E jek'a mura s'ise","marked":"Ẹ jẹ́k'á múra s'iṣẹ́"},{"start":50.919,"end":52.394,"text":"Gbogbo ise t'awa yio se","marked":"Gbogbo iṣẹ́ t'áwá yio ṣe"},{"start":52.774,"end":54.252,"text":"Okan ki yio lo lasan.","marked":"Ọ̀kan kí yío lọ lásán."}],"end":54.252},{"key":"7","start":55.202,"lines":[{"start":55.202,"end":56.651,"text":"A ki baba Aladura","marked":"A kí bàbá Aládúrà"},{"start":57.031,"end":58.355,"text":"K'Olorun ko bukun o","marked":"K'Ọlọ́run kò bùkún o"},{"start":58.735,"end":60.2,"text":"Ade Ogo y'o je tire","marked":"Adé Ògo y'ó jẹ́ tirẹ̀"},{"start":60.58,"end":61.824,"text":"L'Agbara Metalokan.","marked":"L'Agbára Mẹ́talọ́kan."}],"end":61.824}]}