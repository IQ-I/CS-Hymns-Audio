{"v":3,"coll":"y","num":497,"id":"hymn_497","title":"EGBE Aladura mura","duration":70.425,"voices":{"male":{"file":"y-497-male-v3.m4a","bytes":506597,"sha256":"41988ae72b3912de0d383cec0f0cecc875534109ca651227ded32325cf4750d7","duration":70.5},"female":{"file":"y-497-female-v3.m4a","bytes":524764,"sha256":"0b2fabe4856cf54170c7a7b1109e7c9a9409bb431581eed8795c4611dcff02f0","duration":70.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.582,"text":"EGBE Aladura mura","marked":"Ẹgbẹ́ Aládúrà múra"},{"start":2.032,"end":3.376,"text":"Lati pade Kerubu","marked":"Láti pàdé Kérúbù"},{"start":3.826,"end":5.475,"text":"Jesu lo pe nyin lo yan nyin","marked":"Jésù lọ pé yín ló yan yín"},{"start":5.925,"end":7.353,"text":"On lo d'Egbe yi sile","marked":"Òn ló d'Ẹgbẹ́ yí sílẹ̀"},{"start":7.803,"end":9.157,"text":"O si pe gbogbo aiye","marked":"Ó sì pe gbogbo ayé"},{"start":9.607,"end":11.142,"text":"Lati w'oko 'gbala yi","marked":"Láti w'ọkọ gbàlà yí"},{"start":11.592,"end":13.241,"text":"Jesu mu wa de 'te ogo","marked":"Jésù mú wa dé tẹ ògo"},{"start":13.691,"end":15.222,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":15.222},{"key":"CHORUS","start":16.172,"lines":[{"start":16.172,"end":17.926,"text":"Ojo nlo, Ojo nlo. 2ce","marked":"Ọjọ́ ńlọ, Ọjọ́ ńlọ."},{"start":18.376,"end":20.006,"text":"Ise po t'awa yio se","marked":"Iṣẹ́ pọ̀ t'àwa yóò ṣe"},{"start":20.456,"end":22.01,"text":"B' ojo wa ti nkoja Io.","marked":"B ọjọ́ wa ti ńkọjá lọ."}],"end":22.01},{"key":"2","start":22.96,"lines":[{"start":22.96,"end":24.438,"text":"Egbe Serafu d'amure","marked":"Ẹgbẹ́ Séráfù d'àmùrè"},{"start":24.888,"end":26.193,"text":"Lati pade Kerubu","marked":"Láti pàdé Kérúbù"},{"start":26.643,"end":28.249,"text":"E ma je k'amure nyin tu","marked":"Ẹ má jẹ́ k'àmùrè yín tú"},{"start":28.699,"end":30.015,"text":"Lati pade Kerubu","marked":"Láti pàdé Kérúbù"},{"start":30.465,"end":31.739,"text":"Gbe ida 'segun soke","marked":"Gbé idà ṣẹ́gun sókè"},{"start":32.189,"end":33.595,"text":"Iye s'Olorun Daniel","marked":"Iye s'Ọlọ́run Daniẹl"},{"start":34.045,"end":35.349,"text":"Alleluya Jesu mbo","marked":"Allelúyà Jésù mbọ̀"},{"start":35.799,"end":37.251,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":37.251},{"key":"3","start":38.201,"lines":[{"start":38.201,"end":39.399,"text":"Olorun Metalokan wa","marked":"Ọlọ́run Mẹ́talọ́kan wa"},{"start":39.849,"end":41.127,"text":"Lati gbo adura mi","marked":"Láti gbọ́ àdúrà mi"},{"start":41.577,"end":43.12,"text":"Jesu Olugbala mi wa","marked":"Jésù Olùgbàlà mi wà"},{"start":43.57,"end":44.826,"text":"Lati gb'ebo ope mi","marked":"Láti gb'ẹbọ ọpẹ́ mi"},{"start":45.276,"end":46.546,"text":"Emi Mimo sokale","marked":"Ẹ̀mí Mímọ́ sọ̀kalẹ̀"},{"start":46.996,"end":48.362,"text":"F'ore ofe ba wa gbe","marked":"F'oore ọ̀fẹ́ bá wa gbé"},{"start":48.812,"end":50.267,"text":"Ise po t'awa o se","marked":"Iṣẹ́ pọ̀ t'àwa ó ṣe"},{"start":50.717,"end":52.305,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":52.305},{"key":"4","start":53.255,"lines":[{"start":53.255,"end":54.675,"text":"F'okan fe so gbogbo wa po","marked":"F'ọkàn fẹ́ sọ gbogbo wa pọ̀"},{"start":55.125,"end":56.72,"text":"B'ojo wa ti nkoja lo","marked":"B'ọjọ́ wa ti ńkọjá lọ"},{"start":57.17,"end":59.122,"text":"Kokan la o fa won s'agbo wa,","marked":"Kọkàn la ó fà wọ́n s'àgbò wa"},{"start":59.572,"end":61.141,"text":"B'ojo wa ti nkoja lo","marked":"B'ọjọ́ wa ti ńkọjá lọ"},{"start":61.591,"end":62.898,"text":"Sugbon 'eso ti a gbin","marked":"Ṣùgbọ́n èso tí a gbìn"},{"start":63.348,"end":65.02,"text":"L'osan at'oru yio hu","marked":"L'ọ̀sán àt'òru yóò hù"},{"start":65.47,"end":66.958,"text":"Gb'awon to subu dide","marked":"Gb'àwọn tó ṣubú dìde"},{"start":67.408,"end":68.876,"text":"B'ojo wa ti nkoja lo.","marked":"B'ọjọ́ wa ti ńkọjá lọ."}],"end":68.876}]}