{"v":3,"coll":"y","num":344,"id":"hymn_344","title":"KRISTI, lehin isegun","duration":46.32,"voices":{"male":{"file":"y-344-male-v3.m4a","bytes":325707,"sha256":"8f0ac368371262403b87e519a540b2048f96757918c4c96d1b5a12a7faad025b","duration":46.4},"female":{"file":"y-344-female-v3.m4a","bytes":343840,"sha256":"3ca0acbdbea5debbf4b69e66494a648a6f7ceb2fabce2598ec3808958e9707a0","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.692,"text":"KRISTI, lẹhin isẹgun,","marked":"Kristi, lẹ́hìn ìsẹ̀gùn"},{"start":2.142,"end":3.293,"text":"Iwọ ti goke lọ,","marked":"Ìwọ ti gòkè lọ"},{"start":3.743,"end":5.53,"text":"Kérúbù at'ogun-orun,","marked":"Kérúbù at'ogun-orun"},{"start":5.98,"end":7.457,"text":"Wa sin Ọ goke lọ,","marked":"Wá sin Ọ gòkè lọ"},{"start":7.907,"end":9.305,"text":"'K'ayé sọ'tan na jade,","marked":"'K'ayé sọ̀'tán ná jáde"},{"start":9.755,"end":10.683,"text":"Emmanueli wa,","marked":"Emmanueli wá"},{"start":11.133,"end":12.487,"text":"Ti s'ara iy'ara wa.","marked":"Ti s'ára ìy'ára wa."},{"start":12.937,"end":14.056,"text":"G'or'itẹ Baba.","marked":"G'ór'ìtẹ́ Baba."}],"end":14.056},{"key":"2","start":15.006,"lines":[{"start":15.006,"end":17.5,"text":"Nibẹ l'O duro, t'O ń sọ,","marked":"Níbẹ̀ l'Ó dúró, t'Ó ń sọ"},{"start":17.95,"end":19.037,"text":"Agbara ẹjẹ Rẹ;","marked":"Agbára ẹ̀jẹ̀ Rẹ"},{"start":19.487,"end":20.814,"text":"O mbẹbẹ fun ẹlẹsẹ,","marked":"Ó mbẹ̀bẹ̀ fún ẹlẹ́sẹ̀"},{"start":21.264,"end":22.241,"text":"'Wọ Alagbawi wa,","marked":"'Wọ Alágbàwí wa"},{"start":22.691,"end":23.978,"text":"Gbogbo ayidayida,","marked":"Gbogbo àyídáyidà"},{"start":24.428,"end":26.391,"text":"T'ayọ, t'aniyan wa,","marked":"T'ayọ̀, t'àníyàn wà"},{"start":26.841,"end":28.065,"text":"N'Iwọ n se iyọnu si,","marked":"N'Ìwọ ń ṣe ìyọnu sí"},{"start":28.515,"end":29.95,"text":"T'Iwọ si mbẹbẹ fun.","marked":"T'Ìwọ sì mbẹ̀bẹ̀ fún."}],"end":29.95},{"key":"3","start":30.9,"lines":[{"start":30.9,"end":32.259,"text":"Nitori itoye nla,","marked":"Nítorí ìtòye ńlá"},{"start":32.709,"end":34.034,"text":"Ti agbelebu Rẹ,","marked":"Ti àgbélébùú Rẹ"},{"start":34.484,"end":35.768,"text":"K'O fi Ẹmi Rẹ fun wa","marked":"K'Ó fi Ẹ̀mí Rẹ̀ fún wa"},{"start":36.218,"end":37.257,"text":"Sọ ofo wa d'ere,","marked":"Sọ ọ̀fọ̀ wa d'èrè"},{"start":37.707,"end":39.086,"text":"Titi nipa iyanju,","marked":"Títí nípa ìyànjú"},{"start":39.536,"end":40.648,"text":"Ọkan wa o goke;","marked":"Ọkàn wa ó gòkè"},{"start":41.098,"end":42.864,"text":"La ti ba Ọ gbe titi,","marked":"La ti bá Ọ gbé títí"},{"start":43.314,"end":44.771,"text":"Ni ayọ ailopin.","marked":"Ní ayọ̀ àìlópin."}],"end":44.771}]}