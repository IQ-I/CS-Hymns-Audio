{"v":3,"coll":"y","num":802,"id":"hymn_802","title":"E fi ogo fun Baba","duration":33.56,"voices":{"male":{"file":"y-802-male.m4a","bytes":232532,"sha256":"6a45792055cca292a34c37e550b8d7658ed3b021591497d36e4dc41fc2a422a5","duration":33.6},"female":{"file":"y-802-female.m4a","bytes":245524,"sha256":"e38d37f22af0e388779ea3137d723f44dc76ac11cf8894511b23473364abb951","duration":33.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.486,"text":"E fi ogo fun Baba","marked":"Ẹ fi ògo fún Bàbá"},{"start":1.866,"end":3.093,"text":"Nipa Eni ti a wa","marked":"Nípa Ẹni tí a wà"},{"start":3.473,"end":4.905,"text":"O ngbo adura ewe","marked":"Ó ńgbọ́ àdúrà ewé"},{"start":5.285,"end":6.692,"text":"O nf'eti si orin won.","marked":"Ó ńf'etí sí orin wọn."}],"end":6.692},{"key":"2","start":7.642,"lines":[{"start":7.642,"end":8.808,"text":"E fi ogo fun Omo","marked":"Ẹ fi ògo fún Ọmọ"},{"start":9.188,"end":11.467,"text":"Kristi, 'Wo ni Oba wa","marked":"Kristi, 'Wò ni Ọba wa"},{"start":11.847,"end":13.975,"text":"E wa, e korin s'oke","marked":"Ẹ wá, ẹ kọrin s'oke"},{"start":14.355,"end":15.826,"text":"S'Od'agutan elese.","marked":"S'Od'ágùtàn ẹlẹ́sẹ̀."}],"end":15.826},{"key":"3","start":16.776,"lines":[{"start":16.776,"end":17.934,"text":"Ogo fun Emi Mimo","marked":"Ògo fún Ẹ̀mí Mímọ́́"},{"start":18.314,"end":19.807,"text":"Bi ojo Pentikosti","marked":"Bí ọjọ́ Pentikosti"},{"start":20.187,"end":21.494,"text":"Ru aya awon ewe","marked":"Rú aya àwọn èwe"},{"start":21.874,"end":23.868,"text":"F'orin mimo s'eti won.","marked":"F'orin mímọ́́ s'etí wọn."}],"end":23.868},{"key":"4","start":24.818,"lines":[{"start":24.818,"end":26.317,"text":"Ogo ni l'oke orun","marked":"Ògo ni l'òkè ọ̀run"},{"start":26.697,"end":27.958,"text":"Fun Eni Metalokan","marked":"Fún Ẹni Mẹ́talọ́kan"},{"start":28.338,"end":29.515,"text":"Nitori ihin rere","marked":"Nítorí ìhìn rere"},{"start":29.895,"end":31.187,"text":"Ati ife, Olorun.","marked":"Àti ìfẹ́, Ọlọ́run."},{"start":31.567,"end":32.01,"text":"Amin.","marked":"Àmín."}],"end":32.01}]}