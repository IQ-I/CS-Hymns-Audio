{"v":3,"coll":"y","num":382,"id":"hymn_382","title":"EMI anu, oto, ife","duration":25.893,"voices":{"male":{"file":"y-382-male-v3.m4a","bytes":179063,"sha256":"f62931ae1b32fd96eaa913cac2d79852c2b4fe073b3b625bbe6ea6414137d809","duration":25.9},"female":{"file":"y-382-female-v3.m4a","bytes":186021,"sha256":"ac67153c2f6403de5c1128254fb8b506297a745a477cb48975a02e32017e343f","duration":25.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.592,"text":"Ẹmi anu, otọ, ifẹ","marked":"Ẹ̀mí àánú, òtọ̀, ìfẹ́"},{"start":3.042,"end":4.594,"text":"Ran agbara Rẹ t'oke wa;","marked":"Rán agbára Rẹ t'òkè wá"},{"start":5.044,"end":6.371,"text":"Mu iyanu ọjọ oni,","marked":"Mú ìyanu ọjọ́ òní"},{"start":6.821,"end":8.129,"text":"De opin akoko gbogbo.","marked":"Dé òpin àkókò gbogbo."}],"end":8.129},{"key":"2","start":9.079,"lines":[{"start":9.079,"end":10.234,"text":"Ki gbogbo orilẹ ede,","marked":"Kí gbogbo orílẹ̀ èdè"},{"start":10.684,"end":12.15,"text":"Kọ orin ogo Ọlọrun;","marked":"Kọ orin ògo Ọlọ́run"},{"start":12.6,"end":14.127,"text":"Ki a si kọ gbogbo ayé,","marked":"Kí a sì kọ gbogbo ayé"},{"start":14.577,"end":16.159,"text":"N'isẹ Olurapada wa.","marked":"N'isẹ́ Olùràpadà wa."}],"end":16.159},{"key":"3","start":17.109,"lines":[{"start":17.109,"end":18.837,"text":"Olutunu at'Amọna,","marked":"Olùtùnú àt'Amọna"},{"start":19.287,"end":20.416,"text":"Jọba ijọ eniyan Rẹ,","marked":"Jọba ìjọ ènìyàn Rẹ"},{"start":20.866,"end":22.152,"text":"K'arayé mọ ibukun Rẹ,","marked":"K'arayé mọ ìbùkún Rẹ̀"},{"start":22.602,"end":24.343,"text":"Emi, anu, otọ, ifẹ.","marked":"Èmi, àánú, òtọ̀, ìfẹ́."}],"end":24.343}]}