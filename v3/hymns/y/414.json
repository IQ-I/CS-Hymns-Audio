{"v":3,"coll":"y","num":414,"id":"hymn_414","title":"JESU lo n gbebi aboyun","duration":78.935,"voices":{"male":{"file":"y-414-male-v3.m4a","bytes":555824,"sha256":"f8a6a371076ded822b3e54576ff15f7e07853d629cfe4e70b5c1190830556e46","duration":79.0},"female":{"file":"y-414-female-v3.m4a","bytes":573020,"sha256":"a87de478a7c314c354932fef0570af5459d49042392e9e0d01fcd3102f252110","duration":79.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.945,"text":"JESU lo ngbebi aboyun","marked":"Jésù ló ńgbẹ̀bi aboyún"},{"start":2.395,"end":3.773,"text":"E mase jek' a foiya","marked":"Ẹ máṣe jẹ́k a fòìyà"},{"start":4.223,"end":5.711,"text":"Olugbala wa ni Jesu","marked":"Olùgbàlà wà ní Jésù"},{"start":6.161,"end":7.488,"text":"E mase je k'a foiya.","marked":"Ẹ máṣe jẹ́ k'á fòìyà."}],"end":7.488},{"key":"CHORUS","start":8.438,"lines":[{"start":8.438,"end":9.35,"text":"E mase beru","marked":"Ẹ máṣe bẹ̀rù"},{"start":9.8,"end":10.762,"text":"E kun fun ayo","marked":"Ẹ kún fún ayọ̀"},{"start":11.212,"end":12.877,"text":"Nitori Jesu ni Oba wa","marked":"Nítorí Jésù ni Ọba wa"},{"start":13.327,"end":14.996,"text":"B'o ti wu k'iji na leto","marked":"B'ó ti wù k'ìjì ná lẹ́tọ́"},{"start":15.446,"end":16.936,"text":"Y'o da wa sile Iayo.","marked":"Y'ó dá wa sílẹ̀ láyọ̀."}],"end":16.936},{"key":"2","start":17.886,"lines":[{"start":17.886,"end":19.218,"text":"Enyin aboyun Serafu","marked":"Ẹ̀yin aboyún Séráfù"},{"start":19.668,"end":21.137,"text":"E kepe Jesu nikan","marked":"Ẹ kẹpẹ Jésù nìkan"},{"start":21.587,"end":23.212,"text":"K'e si gbeke nyin le pelu","marked":"K'é sì gbẹ́kẹ̀ yín le pẹ̀lú"},{"start":23.662,"end":25.207,"text":"Y'o da nyin sile l'ayo","marked":"Y'ó dá yín sílẹ̀ l'ayọ̀"}],"end":25.207},{"key":"3","start":26.157,"lines":[{"start":26.157,"end":28.14,"text":"Olugbala, 'Wo ti 'ya re","marked":"Olùgbàlà, wo ti yà rẹ"},{"start":28.59,"end":30.041,"text":"Ru O gba osu mesan","marked":"Rú Ó gba oṣù mẹ́sàn"},{"start":30.491,"end":32.027,"text":"Ni bethlehem Judea","marked":"Ní bethlehem Judea"},{"start":32.477,"end":33.864,"text":"Layo ibi sokale.","marked":"Láyọ̀ ibi sọ̀kalẹ̀."}],"end":33.864},{"key":"4","start":34.814,"lines":[{"start":34.814,"end":36.318,"text":"Ki l'ohun ti mba nyin l'eru","marked":"Kí l'ohun tí mbá yín l'ẹ̀rù"},{"start":36.768,"end":38.144,"text":"Enyin Omo ogun Kristi","marked":"Ẹ̀yin Ọmọ ogun Kristi"},{"start":38.594,"end":40.487,"text":"Gbati Jesu ti je tiwa","marked":"Gbátí Jésù ti jẹ́ tiwa"},{"start":40.937,"end":42.429,"text":"Ayo ni yio je tiwa.","marked":"Ayọ̀ ni yóò jẹ́ tiwa."}],"end":42.429},{"key":"5","start":43.379,"lines":[{"start":43.379,"end":45.864,"text":"Lowo, aje ati oso","marked":"Lọ́wọ́, ajé àti ọ̀ṣọ́"},{"start":46.314,"end":47.555,"text":"Lowo ajakale arun","marked":"Lọ́wọ́ àjàkálẹ̀ àrùn"},{"start":48.005,"end":50.496,"text":"Lowo lku, ekun, ose","marked":"Lọ́wọ́ Ikú, ẹkún, ọ̀sẹ̀"},{"start":50.946,"end":52.558,"text":"Jesu yio pa Tire mo.","marked":"Jésù yóò pa Tire mọ́."}],"end":52.558},{"key":"6","start":53.508,"lines":[{"start":53.508,"end":55.037,"text":"Metalokan Alagbara","marked":"Mẹ́talọ́kan Alágbára"},{"start":55.487,"end":56.644,"text":"Dabobo awon omo Re","marked":"Dàbòbò àwọn ọmọ Rẹ"},{"start":57.094,"end":58.902,"text":"Lowo ota ati esu","marked":"Lọ́wọ́ ọ̀tá àti èṣù"},{"start":59.352,"end":61.031,"text":"Jek' awa k'Alleluyah.","marked":"Jẹ́k àwa k'Alleluyah."}],"end":61.031},{"key":"7","start":61.981,"lines":[{"start":61.981,"end":63.285,"text":"Olorun to l'agan ninu","marked":"Ọlọ́run tó l'àgàn nínú"},{"start":63.735,"end":65.397,"text":"Y'o gbo t'enyin ti ntoro","marked":"Y'ó gbọ́ t'ẹ̀yin ti ńtọrọ"},{"start":65.847,"end":68.045,"text":"B'O ti s'ekun Hannah d'erin","marked":"B'Ó ti s'ẹkún Hannah d'ẹrin"},{"start":68.495,"end":69.909,"text":"Yo f'omo pa nyin l'erin.","marked":"Yọ f'ọmọ pa yín l'ẹrin."}],"end":69.909},{"key":"8","start":70.859,"lines":[{"start":70.859,"end":72.228,"text":"Ogo ni fun Baba l'oke","marked":"Ògo ni fún Baba l'òkè"},{"start":72.678,"end":73.853,"text":"Ogo ni fun Omo Re","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":74.303,"end":75.515,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":75.965,"end":77.386,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọ̀pẹ yẹ."}],"end":77.386}]}