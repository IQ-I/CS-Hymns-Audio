{"v":3,"coll":"y","num":21,"id":"hymn_21","title":"Ojo isinmi at'ayo","duration":74.555,"voices":{"male":{"file":"y-21-male-v3.m4a","bytes":531227,"sha256":"a883f897beae208dd3e72fb89855832f019bec3e3c3bfb4d4688478238226eca","duration":74.6},"female":{"file":"y-21-female-v3.m4a","bytes":547493,"sha256":"01632fa186bb3fd37178e1f5d134274144aa9011719bbe7e8aa4f42521593288","duration":74.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.09,"text":"ỌJỌ isinmi at'ayọ,","marked":"Ọjọ́ ìsinmi àt'ayọ̀"},{"start":2.54,"end":3.748,"text":"Ọjọ inu didun;","marked":"Ọjọ́ inú dídùn"},{"start":4.198,"end":5.313,"text":"Ogun fun ibanujẹ,","marked":"Ogun fún ìbànújẹ́"},{"start":5.763,"end":7.029,"text":"Ọjọ dida julọ;","marked":"Ọjọ́ dídá jùlọ"},{"start":7.479,"end":8.515,"text":"Ti awọn ẹni giga,","marked":"Ti àwọn ẹni gíga"},{"start":8.965,"end":10.001,"text":"Niwaju itẹ Rẹ,","marked":"Níwájú ìtẹ́ Rẹ"},{"start":10.451,"end":12.22,"text":"N kọ mimọ, mimọ, mimọ,","marked":"Ń kọ mímọ́, mímọ́, mímọ́"},{"start":12.67,"end":14.126,"text":"S'ẹni Mẹtalọkan.","marked":"S'ẹni Mẹ́talọ́kan."}],"end":14.126},{"key":"2","start":15.076,"lines":[{"start":15.076,"end":16.449,"text":"L'ọjọ yi ni 'mọlẹ la,","marked":"L'ọjọ́ yí ni 'mọlẹ là"},{"start":16.899,"end":17.889,"text":"Nigba didan ayé;","marked":"Nígbà dídán ayé"},{"start":18.339,"end":19.5,"text":"Ati fun igbala wa","marked":"Àti fún ìgbàlà wa"},{"start":19.95,"end":21.272,"text":"Kristi jinde loni;","marked":"Kristi jíǹde lónì"},{"start":21.722,"end":22.859,"text":"L'ọjọ oni l'Oluwa,","marked":"L'ọjọ́ òní l'Olúwa"},{"start":23.309,"end":24.44,"text":"Ran Ẹmi t'ọrun wa;","marked":"Rán Ẹ̀mí t'ọ̀run wá"},{"start":24.89,"end":25.969,"text":"Ọjọ ologo julọ,","marked":"Ọjọ́ ológo jùlọ"},{"start":26.419,"end":27.673,"text":"T'o ni 'mọlẹ pipe.","marked":"T'ó ní 'mọlẹ pípẹ́."}],"end":27.673},{"key":"3","start":28.623,"lines":[{"start":28.623,"end":29.99,"text":"Orisun 'tura ni Ọ,","marked":"Orísun tura ni Ọ"},{"start":30.44,"end":31.692,"text":"L'ayé aginju yi,","marked":"L'ayé aginjù yí"},{"start":32.142,"end":33.985,"text":"L'ori Rẹ, bi ni Pisga,","marked":"L'orí Rẹ, bí ni Piṣga"},{"start":34.435,"end":35.645,"text":"L'a n wo'lẹ ileri,","marked":"L'á ń wò'lẹ́ ìlérí"},{"start":36.095,"end":37.369,"text":"Ọjọ ironu didun","marked":"Ọjọ́ ìrònú dídùn"},{"start":37.819,"end":38.811,"text":"Ọjọ ifẹ mimọ","marked":"Ọjọ́ ìfẹ́ mímọ́"},{"start":39.261,"end":41.559,"text":"Ọjọ ajinde, lati","marked":"Ọjọ́ àjíǹde, láti"},{"start":42.009,"end":43.382,"text":"Ayé si nkan ọrun.","marked":"Ayé sí nǹkan ọ̀run."}],"end":43.382},{"key":"4","start":44.332,"lines":[{"start":44.332,"end":45.851,"text":"L'oni s'ilu t'arẹ mu,","marked":"L'óní s'ìlú t'àrẹ mú"},{"start":46.301,"end":47.494,"text":"Ni mana t'ọrun bọ;","marked":"Ní máná t'ọ̀run bọ̀"},{"start":47.944,"end":49.332,"text":"Si ipejọpọ mimọ,","marked":"Sí ìpéjọpọ̀ mímọ́"},{"start":49.782,"end":50.986,"text":"N'ipe fadaka ń dun,","marked":"N'ìpè fàdákà ń dùn"},{"start":51.436,"end":52.588,"text":"Nibi ti Ihin-rere,","marked":"Níbi tí Ihin-rere"},{"start":53.038,"end":54.428,"text":"N tan imọlẹ mimọ,","marked":"Ń tan ìmọ́lẹ̀ mímọ́"},{"start":54.878,"end":56.285,"text":"Omi iye n san jẹjẹ,","marked":"Omi ìyè ń sàn jẹ́jẹ́"},{"start":56.735,"end":57.868,"text":"Ti n tu ọkan lara.","marked":"Tí ń tu ọkàn lára."}],"end":57.868},{"key":"5","start":58.818,"lines":[{"start":58.818,"end":60.257,"text":"K'a r'ore-ọfẹ titun,","marked":"K'á r'ore-ọfẹ titun"},{"start":60.707,"end":61.858,"text":"L'ọjọ 'sinmi wa yi,","marked":"L'ọjọ́ sinmi wá yí"},{"start":62.308,"end":63.964,"text":"Ka si de sinmi t'o ku","marked":"Ká sì dé sinmi t'ó kú"},{"start":64.414,"end":65.727,"text":"F'awọn alabukun","marked":"F'àwọn alábùkún"},{"start":66.177,"end":67.762,"text":"Nibẹ ka gbohun soke","marked":"Níbẹ̀ ká gbóhùn sókè"},{"start":68.212,"end":69.484,"text":"Si Baba at'Ọmọ","marked":"Sí Baba àt'Ọmọ"},{"start":69.934,"end":71.227,"text":"Ati si Ẹmi Mimọ,","marked":"Àti sí Ẹ̀mí Mímọ́"},{"start":71.677,"end":73.006,"text":"N'iyin Mẹtalọkan.","marked":"N'ìyìn Mẹ́talọ́kan."}],"end":73.006}]}