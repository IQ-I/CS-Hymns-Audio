{"v":3,"coll":"y","num":822,"id":"hymn_822","title":"EGBE Iye l'Egbe Seraf","duration":38.387,"voices":{"male":{"file":"y-822-male.m4a","bytes":282881,"sha256":"eceea3653e177e09fa9400f7473852406107c211395a7fc746f4c10223b026bc","duration":38.4},"female":{"file":"y-822-female.m4a","bytes":292272,"sha256":"4a441c0e0c1ff539cf5c8c65179f8c1f6addd8a892afcc55c6df0786e2ab1003","duration":38.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.69,"text":"EGBE Iye l'Egbe Seraf,","marked":"Ẹgbẹ́ Iye l'Ẹgbẹ́ Séráf"},{"start":2.07,"end":3.179,"text":"Egbe Adura ni","marked":"Ẹgbẹ́ Àdúrà ni"},{"start":3.559,"end":5.199,"text":"Egbe ti ko gbeke l'egbo","marked":"Ẹgbẹ́ tí kò gbẹ́kẹ́ l'ègbò"},{"start":5.579,"end":7.625,"text":"Egbe ti ko gbekel' ewe","marked":"Ẹgbẹ́ tí kò gbekel' èwe"},{"start":8.005,"end":9.543,"text":"Kristi nikan ni 'Mole","marked":"Kristi nìkan ni 'Mọ́lẹ̀"},{"start":9.923,"end":11.213,"text":"On l'Oluwosan won.","marked":"On l'Olùwòsàn wọn."}],"end":11.213},{"key":"2","start":12.163,"lines":[{"start":12.163,"end":13.439,"text":"Enyin Olori Egbe Seraf","marked":"Enyin Olórí Ẹgbẹ́ Séráf"},{"start":13.819,"end":15.044,"text":"E s'otito d'opin","marked":"Ẹ s'òtítọ́́ d'òpin"},{"start":15.424,"end":17.007,"text":"Ati gbogb'Egbe Aladura","marked":"Àti gbogb'Ègbè Alàdúrà"},{"start":17.387,"end":18.697,"text":"Ati Baba nla mejila","marked":"Àti Bàbá ńlá méjìlá"},{"start":19.077,"end":21.27,"text":"E ma wo 'ya, e ma w'egan","marked":"Ẹ má wọ́ 'yà, ẹ má w'ẹ̀gàn"},{"start":21.65,"end":22.918,"text":"Ke le gbade Ogo.","marked":"Kẹ́ lè gbadé Ògo."}],"end":22.918},{"key":"3","start":23.868,"lines":[{"start":23.868,"end":25.745,"text":"Jesu Oba Egbe Seraf'","marked":"Jésù Ọba Ẹgbẹ́ Séráf'"},{"start":26.125,"end":27.287,"text":"Ma je ka padanu","marked":"Má jẹ́ ká pàdánù"},{"start":27.667,"end":29.689,"text":"L'ojo ta o se 'dajo aiye","marked":"L'ọjọ́ tá ò ṣe 'dájọ́ aiye"},{"start":30.069,"end":32.186,"text":"T'oju aiye, orun yio pe,","marked":"T'ojú aiye, orun yio pe"},{"start":32.566,"end":34.184,"text":"Messiah Nla Oba Ogo,","marked":"Messiah Ńlá Ọba Ògo"},{"start":34.564,"end":35.896,"text":"Je ka le d'odo Re.","marked":"Jẹ́ ká lè d'ọ̀dọ̀ Rẹ."},{"start":36.276,"end":36.837,"text":"Amin.","marked":"Àmín."}],"end":36.837}]}