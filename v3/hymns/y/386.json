{"v":3,"coll":"y","num":386,"id":"hymn_386","title":"'GBANI t'Olorun sokale","duration":55.81,"voices":{"male":{"file":"y-386-male-v3.m4a","bytes":388739,"sha256":"db047daa8bd81613f55b65064036482ed7a964daeb8ceb62a2fb55c8aed80d48","duration":55.9},"female":{"file":"y-386-female-v3.m4a","bytes":397681,"sha256":"8c7e2f1c65dba0d0a25dadd3d3bda5479239c9b39ee679e4f372b32c348cd985","duration":55.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.643,"text":"'GBANI t'Ọlọrun sọkalẹ;","marked":"gbani t'Ọlọ́run sọ̀kalẹ̀"},{"start":2.093,"end":3.106,"text":"O wa ni ibinu;","marked":"Ó wà ní ìbínú"},{"start":3.556,"end":5.052,"text":"Ara si ń san niwaju Rẹ.","marked":"Ara sì ń sàn níwájú Rẹ̀."},{"start":5.502,"end":6.48,"text":"Okunkun oun ina.","marked":"Òkùnkùn òun iná."}],"end":6.48},{"key":"2","start":7.43,"lines":[{"start":7.43,"end":8.968,"text":"Nigba t'o wa nigba keji,","marked":"Nígbà t'ó wà nígbà kejì"},{"start":9.418,"end":10.421,"text":"O wa ninu ifẹ;","marked":"Ó wà nínú ìfẹ́"},{"start":10.871,"end":12.233,"text":"Ẹmi Rẹ si ń tu ni lara,","marked":"Ẹ̀mí Rẹ̀ sì ń tù ni lára"},{"start":12.683,"end":13.892,"text":"B'afẹfẹ owurọ.","marked":"B'afẹ́fẹ́ òwúrọ̀."}],"end":13.892},{"key":"3","start":14.842,"lines":[{"start":14.842,"end":16.414,"text":"Ina Sinai ijọ kini,","marked":"Iná Sinai ìjọ kini"},{"start":16.864,"end":18.006,"text":"T'ọwọ re mbu soke,","marked":"T'ọwọ́ rẹ̀ mbú sókè"},{"start":18.456,"end":19.999,"text":"Sọkalẹ jẹjẹ bi ade,","marked":"Sọ̀kalẹ̀ jẹ́jẹ́ bí adé"},{"start":20.449,"end":21.72,"text":"Si ori gbogbo wọn.","marked":"Sí orí gbogbo wọn."}],"end":21.72},{"key":"4","start":22.67,"lines":[{"start":22.67,"end":24.009,"text":"Bi ohun ẹru na ti dun","marked":"Bí ohun ẹ̀rù ná ti dùn"},{"start":24.459,"end":25.49,"text":"Leti Israeli,","marked":"Létí Ísírẹ́lì"},{"start":25.94,"end":27.339,"text":"Ti wọn si gbọ iro ipe","marked":"Tí wọ́n sì gbọ́ ìró ìpè"},{"start":27.789,"end":29.013,"text":"T'o m'ohun angẹli gbọn.","marked":"T'ó m'ohun áńgẹ́lì gbọ́n."}],"end":29.013},{"key":"5","start":29.963,"lines":[{"start":29.963,"end":31.463,"text":"Be gẹgẹ nigba t'Ẹmi wa,","marked":"Bẹ gẹ́gẹ́ nígbà t'Ẹ̀mi wà"},{"start":31.913,"end":32.962,"text":"Ba le awọn Tirẹ;","marked":"Bá lé àwọn Tirẹ̀"},{"start":33.412,"end":35.044,"text":"Iro kan si ti ọrun wa,","marked":"Ìró kan sì ti ọ̀run wá"},{"start":35.494,"end":36.674,"text":"Iro iji lile.","marked":"Ìró ìjì líle."}],"end":36.674},{"key":"6","start":37.624,"lines":[{"start":37.624,"end":40.251,"text":"O ń kun, Ijọ Jesu, o ń kun","marked":"Ó ń kún, Ìjọ Jésù, ó ń kún"},{"start":40.701,"end":41.891,"text":"Ayé ẹsẹ yika;","marked":"Ayé ẹsẹ̀ yíká"},{"start":42.341,"end":44.001,"text":"L'o kan alaigbọran nikan,","marked":"L'ó kan aláìgbọ́ràn nìkan"},{"start":44.451,"end":45.825,"text":"Ni aye ko si fun.","marked":"Ní ayé kò sì fún."}],"end":45.825},{"key":"7","start":46.775,"lines":[{"start":46.775,"end":48.909,"text":"Wa, Ọgbọn, ifẹ, at'Ipa,","marked":"Wá, Ọgbọ́n, ìfẹ́, àt'ipa"},{"start":49.359,"end":50.425,"text":"Mu ki eti wa si;","marked":"Mú kí etí wá sí"},{"start":50.875,"end":52.453,"text":"K'a ma sọ akoko wa nu;","marked":"K'á má sọ àkókò wa nù"},{"start":52.903,"end":54.261,"text":"Ki 'fẹ Rẹ le gba wa.","marked":"Kí 'fẹ Rẹ lè gbà wá."}],"end":54.261}]}