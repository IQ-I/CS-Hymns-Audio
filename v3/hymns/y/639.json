{"v":3,"coll":"y","num":639,"id":"hymn_639","title":"OLORUN gbogbo araye","duration":82.131,"voices":{"male":{"file":"y-639-male-v3.m4a","bytes":587021,"sha256":"2cba061a0dd6b14acf8ab5cfe1a0bf10aa64026923d712faf59d041a1ec6274e","duration":82.2},"female":{"file":"y-639-female-v3.m4a","bytes":610603,"sha256":"7820b8b3fb88085a793686b8e4644f1e42a086b8cc41581b634a0d641029ab2b","duration":82.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.59,"text":"OLORUN gbogbo araiye","marked":"Ọlọ́run gbogbo aráìyè"},{"start":2.04,"end":4.051,"text":"Iwo t'o pe ki mole k'o wa","marked":"Ìwọ t'ó pè kí mọ́lẹ̀ k'ó wà"},{"start":4.501,"end":6.186,"text":"Iwo t'o pe k'eweko hu","marked":"Ìwọ t'ó pé k'ewéko hù"},{"start":6.636,"end":8.304,"text":"O si ri be nipa ase Re.","marked":"Ó sì rí bẹ nípa àṣẹ Rẹ̀."},{"start":8.754,"end":10.587,"text":"Egbe:  Gbo t'emi, gbo t'emi","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"},{"start":11.037,"end":12.131,"text":"Oba awimayehun","marked":"Ọba àwímáyèhùn"},{"start":12.581,"end":13.365,"text":"gbo t'emi - 3ce","marked":"gbọ́ t'èmi"},{"start":13.815,"end":14.987,"text":"Oba a wi‐ma-yehun.","marked":"Ọba a wi-ma-yehun."}],"end":14.987},{"key":"CHORUS","start":15.937,"lines":[{"start":15.937,"end":17.597,"text":"Gbo t'emi, gbo t'emi","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"},{"start":18.047,"end":19.241,"text":"Oba awimayehun","marked":"Ọba àwímáyèhùn"},{"start":19.691,"end":20.507,"text":"gbo t'emi - 3ce","marked":"gbọ́ t'èmi"},{"start":20.957,"end":22.117,"text":"Oba a wi‐ma-yehun.","marked":"Ọba a wi-ma-yehun."}],"end":22.117},{"key":"2","start":23.067,"lines":[{"start":23.067,"end":24.598,"text":"Olorun t'o gbo ti Mose","marked":"Ọlọ́run t'ó gbọ́ ti Mósè"},{"start":25.048,"end":27.028,"text":"T'a pa awon oba ko fi ka","marked":"T'á pa àwọn ọba kò fi ká"},{"start":27.478,"end":28.865,"text":"Olorun t'o gbo t'Elija","marked":"Ọlọ́run t'ó gbọ́ t'Elija"},{"start":29.315,"end":30.818,"text":"T'o si doju t'awon ota re.","marked":"T'ó sì dojú t'àwọn ọ̀tá rẹ̀."},{"start":31.268,"end":33.027,"text":"Egbe:  Gbo t'emi, gbo t'emi...","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"}],"end":33.027},{"key":"3","start":33.977,"lines":[{"start":33.977,"end":35.482,"text":"Olorun t'o pe k'okun wa","marked":"Ọlọ́run t'ó pè k'okùn wá"},{"start":35.932,"end":37.508,"text":"T'omo araiye ko ri di re","marked":"T'ọmọ aráìyè kò rí di rẹ̀"},{"start":37.958,"end":39.376,"text":"Olorun t'o pe k'osa wa","marked":"Ọlọ́run t'ó pè k'ọ̀sá wa"},{"start":39.826,"end":41.48,"text":"T'omo araiye ko ri di re.","marked":"T'ọmọ aráìyè kò rí di rẹ̀."},{"start":41.93,"end":43.405,"text":"Egbe:  Gbo t'emi, gbo t'emi...","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"}],"end":43.405},{"key":"4","start":44.355,"lines":[{"start":44.355,"end":45.721,"text":"Olorun t'o la gan ninu","marked":"Ọlọ́run t'ó là gan nínú"},{"start":46.171,"end":47.645,"text":"Baba awon alaini baba","marked":"Baba àwọn aláìní Baba"},{"start":48.095,"end":49.705,"text":"Olorun t'o gbo ti Estha","marked":"Ọlọ́run t'ó gbọ́ ti Estha"},{"start":50.155,"end":51.696,"text":"T'o si gbe leke awon ota re.","marked":"T'ó sì gbé lékè àwọn ọ̀tá rẹ̀."},{"start":52.146,"end":53.775,"text":"Egbe:  Gbo t'emi, gbo t'emi...","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"}],"end":53.775},{"key":"5","start":54.725,"lines":[{"start":54.725,"end":56.158,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":56.608,"end":58.118,"text":"F'ogo fun Baba loke","marked":"F'ògo fún Baba lókè"},{"start":58.568,"end":60.303,"text":"Fun isegun t'o nse fun wa","marked":"Fún ìṣẹ́gun t'ó ńṣe fún wa"},{"start":60.753,"end":62.456,"text":"Nigbat'awon aiye fe kegan.","marked":"Nígbàt'àwọn ayé fẹ́ kẹ́gàn."},{"start":62.906,"end":64.544,"text":"Egbe:  Gbo t'emi, gbo t'emi...","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"}],"end":64.544},{"key":"6","start":65.494,"lines":[{"start":65.494,"end":67.127,"text":"E f'ogo fun Baba loke","marked":"Ẹ f'ògo fún Baba lókè"},{"start":67.577,"end":68.863,"text":"A wa si f'ogo f'omo Re","marked":"A wá sì f'ògo f'ọmọ Rẹ̀"},{"start":69.313,"end":70.693,"text":"A f'ogo fun Emi Mimo","marked":"A f'ògo fún Ẹ̀mí Mímọ́"},{"start":71.143,"end":72.824,"text":"Metalokan ni ope ye fun.","marked":"Mẹ́talọ́kan ni ọpẹ́ yẹ fún."},{"start":73.274,"end":74.953,"text":"Egbe:  Gbo t'emi, gbo t'emi","marked":"Gbọ́ t'èmi, gbọ́ t'èmi"},{"start":75.403,"end":76.705,"text":"Oba awimayehun","marked":"Ọba àwímáyèhùn"},{"start":77.155,"end":77.996,"text":"gbo t'emi - 3ce","marked":"gbọ́ t'èmi"},{"start":78.446,"end":79.589,"text":"Oba a wi‐ma-yehun.","marked":"Ọba a wi-ma-yehun."},{"start":80.039,"end":80.582,"text":"Amin.","marked":"Àmín."}],"end":80.582}]}