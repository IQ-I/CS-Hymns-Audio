{"v":3,"coll":"y","num":755,"id":"hymn_755","title":"GB'ohun t'o t'orun wa ti wi","duration":23.806,"voices":{"male":{"file":"y-755-male-v3.m4a","bytes":157884,"sha256":"a0552420e7abd63dcc124baac924bb7a09255cf171201a6fb12d3edf5bfe7eaf","duration":23.9},"female":{"file":"y-755-female-v3.m4a","bytes":166543,"sha256":"dafdcd4c78624201e9724d17c58946dff42db8748021c1fd43398fd559716746","duration":23.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.966,"text":"GB'ohun t'o t'orun wa ti wi","marked":"Gb'ohun t'ó t'ọ̀run wá ti wí"},{"start":2.416,"end":3.431,"text":"F'awon oku mimo","marked":"F'àwọn òkú mímọ́"},{"start":3.881,"end":5.419,"text":"Didun n'irant'oruko won","marked":"Dídùn n'ìránt'orúkọ wọn"},{"start":5.869,"end":7.125,"text":"Busun won n'itura.","marked":"Bùsùn wọn n'ìtura."}],"end":7.125},{"key":"2","start":8.075,"lines":[{"start":8.075,"end":9.71,"text":"Wọn ku n'nu Jesu abukun,","marked":"Wọ́n kù n'nú Jésù àbùkùn"},{"start":10.16,"end":11.134,"text":"Orun wọn ti dun to!","marked":"Ọ̀run wọn ti dùn tó!"},{"start":11.584,"end":12.864,"text":"Ninu irora oun ẹsẹ,","marked":"Nínú ìrora òun ẹsẹ̀"},{"start":13.314,"end":14.642,"text":"Wọn yọ ninu 'danwo.","marked":"Wọ́n yọ̀ nínú dánwò."}],"end":14.642},{"key":"3","start":15.592,"lines":[{"start":15.592,"end":17.132,"text":"Lọna jijin s'ayé isẹ,","marked":"Lọ́nà jíjìn s'ayé isẹ́"},{"start":17.582,"end":18.64,"text":"Wọn mbẹ lọd' Oluwa;","marked":"Wọ́n mbẹ́ lọd' Olúwa"},{"start":19.09,"end":20.526,"text":"Isẹ wọn l'ayé iku yi,","marked":"Isẹ́ wọn l'ayé ikú yí"},{"start":20.976,"end":22.256,"text":"Pari ni ere nla.","marked":"Parí ni èrè ńlá."}],"end":22.256}]}