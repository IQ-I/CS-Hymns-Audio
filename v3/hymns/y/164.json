{"v":3,"coll":"y","num":164,"id":"hymn_164","title":"BABA wa orun, awa de","duration":48.721,"voices":{"male":{"file":"y-164-male-v3.m4a","bytes":347921,"sha256":"79f6bdb024642cf956d5c785c6d46eaba35615b7fe21b4f119ac80944675be75","duration":48.8},"female":{"file":"y-164-female-v3.m4a","bytes":363977,"sha256":"5baf1dc8904bfc60fc360311e2cbca88e66a08215ad156409365f32f63f5ca6e","duration":48.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.572,"text":"Baba wa ọrun, awa de,","marked":"Baba wa ọ̀run, àwa dé"},{"start":3.022,"end":4.233,"text":"Awa alailagbara;","marked":"Àwa aláìlágbára"},{"start":4.683,"end":6.172,"text":"Fi Ẹmi Mimọ Rẹ kun wa,","marked":"Fi Ẹ̀mí Mímọ́ Rẹ kún wá"},{"start":6.622,"end":8.036,"text":"K'o sọ gbogbo wa d'ọtun;","marked":"K'ó sọ gbogbo wa d'ọ̀tun"},{"start":8.486,"end":10.531,"text":"Wa! Ẹmi Mimọ, jare wa!","marked":"Wá! Ẹ̀mí Mímọ́, jàre wá!"},{"start":10.981,"end":12.183,"text":"F'ede titun s'ọkan wa,","marked":"F'èdè títún s'ọkàn wa"},{"start":12.633,"end":14.11,"text":"Ẹbun nla Rẹ ni l'a ń tọrọ,","marked":"Ẹ̀bùn ńlá Rẹ̀ ni l'à ń tọrọ"},{"start":14.56,"end":16.034,"text":"T'ọjọ nla Pẹntikọsti.","marked":"T'ọjọ́ ńlá Pẹntikọsti."}],"end":16.034},{"key":"2","start":16.984,"lines":[{"start":16.984,"end":18.599,"text":"Ranti ileri Rẹ, Jesu,","marked":"Rántí ìlérí Rẹ, Jésù"},{"start":19.049,"end":20.289,"text":"Tu Ẹmi Rẹ s'ara wa;","marked":"Tú Ẹ̀mí Rẹ s'ára wa"},{"start":20.739,"end":21.977,"text":"Fi alafia Rẹ fun wa,","marked":"Fi àlàáfíà Rẹ fún wa"},{"start":22.427,"end":23.873,"text":"T'ayé ko le fifun ni;","marked":"T'ayé kò lè fífún ni"},{"start":24.323,"end":26.385,"text":"Wa! Ẹmi Mimọ, jare wa!","marked":"Wá! Ẹ̀mí Mímọ́, jàre wá!"},{"start":26.835,"end":28.374,"text":"Pa ẹsẹ run l'ọkan wa,","marked":"Pa ẹsẹ̀ run l'ọkàn wa"},{"start":28.824,"end":30.278,"text":"Ẹbun nla Rẹ ni l'a n tọrọ,","marked":"Ẹ̀bùn ńlá Rẹ̀ ni l'à ń tọrọ"},{"start":30.728,"end":32.188,"text":"T'ọjọ nla Pẹntikọsti.","marked":"T'ọjọ́ ńlá Pẹntikọsti."}],"end":32.188},{"key":"3","start":33.138,"lines":[{"start":33.138,"end":34.996,"text":"Adaba ọrun! ba le wa,","marked":"Àdàbà ọ̀run! bá lè wà"},{"start":35.446,"end":36.621,"text":"Fi agbara Rẹ fun wa;","marked":"Fi agbára Rẹ fún wa"},{"start":37.071,"end":38.14,"text":"Ki gbogbo orilẹ ede,","marked":"Kí gbogbo orílẹ̀ èdè"},{"start":38.59,"end":39.666,"text":"Tẹriba f'Olugbala,","marked":"Tẹríba f'Olùgbàlà"},{"start":40.116,"end":41.602,"text":"K'a gburo Rẹ jakejado,","marked":"K'á gbúrò Rẹ̀ jákèjádò"},{"start":42.052,"end":43.322,"text":"Ilẹ okunkun wa yi,","marked":"Ilẹ̀ òkùnkùn wa yí"},{"start":43.772,"end":45.22,"text":"Ẹbun nla Rẹ ni l'a ń tọrọ,","marked":"Ẹ̀bùn ńlá Rẹ̀ ni l'à ń tọrọ"},{"start":45.67,"end":47.171,"text":"T'ọjọ nla Pẹntikọsti.","marked":"T'ọjọ́ ńlá Pẹntikọsti."}],"end":47.171}]}