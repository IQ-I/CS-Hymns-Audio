{"v":3,"coll":"y","num":46,"id":"hymn_46","title":"GB'ADURA wa, Oba aye","duration":46.894,"voices":{"male":{"file":"y-46-male-v3.m4a","bytes":333146,"sha256":"d054cac906677793be5ebf7ac1d066064f8e4cc4cebcc3a4719dda789b5c35fd","duration":46.9},"female":{"file":"y-46-female-v3.m4a","bytes":341734,"sha256":"3441354a8fdd02344b8463f2b964619ed6876df503b8112f6b127a67f88b9138","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.37,"text":"GB'ADURA wa, Ọba ayé,","marked":"Gb'àdúrà wa, Ọba ayé"},{"start":2.82,"end":3.897,"text":"'Gba t'a wolẹ fun Ọ,","marked":"gbà t'á wólẹ̀ fún Ọ"},{"start":4.347,"end":5.61,"text":"Gbogbo wa n kigbe n'irẹlẹ,","marked":"Gbogbo wa ń kígbe n'ìrẹ̀lẹ̀"},{"start":6.06,"end":7.149,"text":"A mbẹbẹ fun anu","marked":"A mbẹ̀bẹ̀ fún àánú"},{"start":7.599,"end":9.923,"text":"Tiwa l'ẹbi, tirẹ l'aanu","marked":"Tiwa l'ẹ̀bi, tirẹ̀ l'àánú"},{"start":10.373,"end":11.512,"text":"Mase le wa pada,","marked":"Máṣe lè wá padà"},{"start":11.962,"end":13.457,"text":"Sugbọn gbọ'gbe wa n'itẹ Rẹ","marked":"Sùgbọ́n gbọ́'gbé wà n'ìtẹ́ Rẹ"},{"start":13.907,"end":15.249,"text":"Ran adura wa lọwọ.","marked":"Rán àdúrà wa lọ́wọ́."}],"end":15.249},{"key":"2","start":16.199,"lines":[{"start":16.199,"end":17.845,"text":"Ẹsẹ awọn baba wa pọ,","marked":"Ẹsẹ̀ àwọn Baba wa pọ̀"},{"start":18.295,"end":19.358,"text":"Tiwa ko si kere,","marked":"Tiwa kò sì kéré"},{"start":19.808,"end":21.296,"text":"Sugbọn lati irandiran,","marked":"Sùgbọ́n láti ìrandíran"},{"start":21.746,"end":22.898,"text":"Lo ti f'ore Rẹ han,","marked":"Ló ti f'ọrẹ Rẹ̀ hàn"},{"start":23.348,"end":25.127,"text":"Nigba ewu, b'omi jija","marked":"Nígbà ewu, b'omi jíjà"},{"start":25.577,"end":26.825,"text":"Yi ilu wa yi ka,","marked":"Yí ìlú wa yí ká"},{"start":27.275,"end":28.964,"text":"Iwọ la n wo ta si n ke pe,","marked":"Ìwọ là ń wò tá sì ń ké pè"},{"start":29.414,"end":30.605,"text":"K'a ma r‘iranwọ Rẹ.","marked":"K'á má r'ìrànwọ́ Rẹ."}],"end":30.605},{"key":"3","start":31.555,"lines":[{"start":31.555,"end":32.992,"text":"L'ohun kan gbogbo wa wolẹ,","marked":"L'ohun kan gbogbo wa wólẹ̀"},{"start":33.442,"end":34.445,"text":"L'abẹ iyọnu Rẹ,","marked":"L'abẹ́ ìyọnu Rẹ"},{"start":34.895,"end":36.415,"text":"Gbogbo wa n jẹwọ ẹsẹ wa,","marked":"Gbogbo wa ń jẹ́wọ́ ẹsẹ̀ wa"},{"start":36.865,"end":38.114,"text":"A n gbawẹ fun 'le wa,","marked":"A ń gbàwẹ́ fún lè wá"},{"start":38.564,"end":40.134,"text":"F'oju anu wo aini wa,","marked":"F'ojú àánú wo àìní wa"},{"start":40.584,"end":41.921,"text":"Bi a ti n ke pe Ọ!","marked":"Bí a ti ń ké pè Ọ́!"},{"start":42.371,"end":43.638,"text":"Ma fi'dajọ Rẹ ba wa wi,","marked":"Má fi'dájọ́ Rẹ bá wa wí"},{"start":44.088,"end":45.345,"text":"Da wa si laanu Rẹ.","marked":"Dá wa sì láánú Rẹ."}],"end":45.345}]}