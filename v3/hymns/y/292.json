{"v":3,"coll":"y","num":292,"id":"hymn_292","title":"Krist' t'agbelegbu l'orin wa","duration":34.398,"voices":{"male":{"file":"y-292-male-v3.m4a","bytes":243265,"sha256":"5c45b268c61010eae22b6a775bd46398e648822cb1ab07c4549b926baf999954","duration":34.4},"female":{"file":"y-292-female-v3.m4a","bytes":255600,"sha256":"59c9ca5df080d6060db521c258fd3090c6ee40b77d5b3912856a105d501bbfb9","duration":34.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.046,"text":"Krist' t'agbelegbu l'orin wa,","marked":"Krist t'agbélégbù l'orin wa"},{"start":2.496,"end":3.875,"text":"Ijinlẹ t'awa n sọ;","marked":"Ìjìnlẹ̀ t'àwa ń sọ"},{"start":4.325,"end":6.169,"text":"O j'ẹgan loju awọn ju,","marked":"Ó j'ẹ̀gàn lójú àwọn ju"},{"start":6.619,"end":7.798,"text":"Were lọwọ Griki.","marked":"Wèrè lọ́wọ́ Griki."}],"end":7.798},{"key":"2","start":8.748,"lines":[{"start":8.748,"end":10.177,"text":"Sugbọn ọkan t'Ọlọrun kọ,","marked":"Sùgbọ́n ọkàn t'Ọlọ́run kọ"},{"start":10.627,"end":12.141,"text":"F'ayọ gba ọrọ naa;","marked":"F'ayọ̀ gba ọ̀rọ̀ náà"},{"start":12.591,"end":14.676,"text":"Wọn ri ọgbọn, ipa ifẹ,","marked":"Wọ́n rí ọgbọ́n, ipa ìfẹ́"},{"start":15.126,"end":16.408,"text":"T'o han n'Oluwa wọn.","marked":"T'ó hàn n'Olúwa wọn."}],"end":16.408},{"key":"3","start":17.358,"lines":[{"start":17.358,"end":19.217,"text":"Adun, oruko Re yiye","marked":"Adùn, orúkọ Rẹ̀ yíyẹ"},{"start":19.667,"end":20.776,"text":"Mu soji s'okan won","marked":"Mú ṣòjì s'ọkàn wọn"},{"start":21.226,"end":23.223,"text":"Aigbagbo l'ohun t'o ba ni je","marked":"Àìgbàgbọ́ l'ohun t'ó bá ní jẹ́"},{"start":23.673,"end":25.244,"text":"Si ebi at'iku.","marked":"Sí ebi àt'ikú."}],"end":25.244},{"key":"4","start":26.194,"lines":[{"start":26.194,"end":27.696,"text":"Lai j'ọlọrun t'or'ọfẹ ka","marked":"Láì j'ọlọ́run t'or'ọ̀fẹ́ ká"},{"start":28.146,"end":29.088,"text":"Bi ọwara ojo;","marked":"Bí ọ̀wàrà ọjọ́"},{"start":29.538,"end":30.97,"text":"Lasan l'Apollo funrugbin,","marked":"Lásán l'Apollo fúnrúgbìn"},{"start":31.42,"end":32.849,"text":"Paul si le gbin lasan.","marked":"Paul sì lè gbìn lásán."}],"end":32.849}]}