{"v":3,"coll":"y","num":619,"id":"hymn_619","title":"NIHIN YI n'isinmi gbe wa","duration":35.791,"voices":{"male":{"file":"y-619-male-v3.m4a","bytes":254090,"sha256":"0f7422cb9eee4556f4dd83d671ac11ea5028da8c6ad0bb447c67c1161d7f7d11","duration":35.8},"female":{"file":"y-619-female-v3.m4a","bytes":259713,"sha256":"23c5a8f3c7369d6721c66598ee7603147009bce55144531b816a1c83adb10335","duration":35.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.701,"text":"NIHIN YI n'isinmi gbe wa,","marked":"Níhìn Yí n'ìsinmi gbé wà"},{"start":2.151,"end":3.844,"text":"Niha rẹ ti ẹjẹ n san;","marked":"Níhà rẹ̀ tí ẹ̀jẹ̀ ń sàn"},{"start":4.294,"end":5.882,"text":"Eyi nikan n'ireti mi,","marked":"Èyí nìkan n'ìrètí mi"},{"start":6.332,"end":7.656,"text":"Pe Jesu ku fun mi.","marked":"Pé Jésù kú fún mi."}],"end":7.656},{"key":"2","start":8.606,"lines":[{"start":8.606,"end":9.917,"text":"Olugbal', Ọlọrun mi,","marked":"Olùgbàl, Ọlọ́run mi"},{"start":10.367,"end":11.469,"text":"Orisun f'ẹsẹ mi;","marked":"Orísun f'ẹsẹ̀ mi"},{"start":11.919,"end":13.635,"text":"Ma f'ẹjẹ rẹ wọn mi titi,","marked":"Má f'ẹ̀jẹ̀ rẹ̀ wọ́n mí títí"},{"start":14.085,"end":15.23,"text":"K'emi le di mimọ","marked":"K'èmi lè di mímọ́"}],"end":15.23},{"key":"3","start":16.18,"lines":[{"start":16.18,"end":18.138,"text":"Wẹ mi, si se mi ni Tirẹ,","marked":"Wẹ̀ mí, sì ṣe mí ní Tirẹ̀"},{"start":18.588,"end":20.658,"text":"Wẹ mi, si jẹ temi,","marked":"Wẹ̀ mí, sì jẹ́ tèmi"},{"start":21.108,"end":23.004,"text":"Wẹ mi, k'i s'ẹsẹ mi nikan,","marked":"Wẹ̀ mí, k'í s'ẹsẹ̀ mi nìkan"},{"start":23.454,"end":25.001,"text":"Ọwọ at'ọkan mi.","marked":"Ọwọ́ àt'ọkàn mi."}],"end":25.001},{"key":"4","start":25.951,"lines":[{"start":25.951,"end":28.257,"text":"Ma sisẹ lọkan mi, Jesu,","marked":"Má sisẹ́ lọ́kàn mi, Jésù"},{"start":28.707,"end":30.226,"text":"Titi 'gbagbọ y'o pin;","marked":"Títí 'gbagbọ y'ó pín"},{"start":30.676,"end":32.33,"text":"Tit' ireti y'o fi dopin;","marked":"Tít ìrètí y'ó fi dópin"},{"start":32.78,"end":34.242,"text":"T'ọkan mi yoo sinmi.","marked":"T'ọkàn mi yóò sinmi."}],"end":34.242}]}