{"v":3,"coll":"y","num":348,"id":"hymn_348","title":"lwo ti goke lo","duration":44.35,"voices":{"male":{"file":"y-348-male-v3.m4a","bytes":317160,"sha256":"a93ad425e73681c1d3457ccf9106dd68fa8cd347b2d958b0d1f67a808ddf439f","duration":44.4},"female":{"file":"y-348-female-v3.m4a","bytes":326308,"sha256":"c8b1ed13ac74286b90ac97026884c4727ae420ace1099bc1727b910a199ef952","duration":44.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.411,"text":"lwo ti goke lo,","marked":"Ìwọ ti gòkè lọ"},{"start":1.861,"end":3.083,"text":"S'ile ayo orun","marked":"S'ilé ayọ̀ ọ̀run"},{"start":3.533,"end":4.932,"text":"Lojojumo yite re ka","marked":"Lójojúmọ́ yítẹ́ rẹ̀ ká"},{"start":5.382,"end":6.567,"text":"L'a ngbo orin iyin","marked":"L'á ńgbọ́ orin ìyìn"},{"start":7.017,"end":8.431,"text":"Sugbon awa nduro","marked":"Ṣùgbọ́n àwa ńdúró"},{"start":8.881,"end":10.097,"text":"Labe eru ese","marked":"Lábẹ́ ẹrú ẹ̀ṣẹ̀"},{"start":10.547,"end":11.802,"text":"Jo ran Olutunu Re wa","marked":"Jọ rán Olùtùnú Rẹ̀ wá"},{"start":12.252,"end":13.837,"text":"K'o si mu wa lo 'le.","marked":"K'ó sì mú wa lọ lé."}],"end":13.837},{"key":"2","start":14.787,"lines":[{"start":14.787,"end":15.945,"text":"lwo ti goke lo","marked":"Ìwọ ti gòkè lọ"},{"start":16.395,"end":17.566,"text":"Sugbon saju eyi,","marked":"Ṣùgbọ́n sájú èyí"},{"start":18.016,"end":19.437,"text":"O koja 'rora kikoro","marked":"Ó kọjá rora kíkorò"},{"start":19.887,"end":21.086,"text":"K'o to le de ade","marked":"K'ó tó lè dé adé"},{"start":21.536,"end":22.521,"text":"Larin ibanuje","marked":"Lárin ìbànújẹ́"},{"start":22.971,"end":24.371,"text":"L'a o ma te siwaju","marked":"L'á ò má tẹ̀ síwájú"},{"start":24.821,"end":26.795,"text":"K'ona wa t'o kun f'omije","marked":"K'ọ̀nà wa t'ó kún f'omijé"},{"start":27.245,"end":28.546,"text":"To wa si odo Re.","marked":"Tó wá sí ọ̀dọ̀ Rẹ."}],"end":28.546},{"key":"3","start":29.496,"lines":[{"start":29.496,"end":30.582,"text":"Iwo ti goke lo","marked":"Ìwọ ti gòkè lọ"},{"start":31.032,"end":32.088,"text":"Iwo o tun pada","marked":"Ìwọ ó tún padà"},{"start":32.538,"end":33.846,"text":"Awon egbe mimo l'oke","marked":"Àwọn ẹgbẹ́ mímọ́ l'òkè"},{"start":34.296,"end":35.542,"text":"Ni y'o ba O pada","marked":"Ní y'ó bá Ọ padà"},{"start":35.992,"end":37.316,"text":"Nipa agbara Re","marked":"Nípa agbára Rẹ"},{"start":37.766,"end":39.028,"text":"K'awa k'a ku n'nu Re","marked":"K'àwa k'á kú n'nú Rẹ̀"},{"start":39.478,"end":41.149,"text":"Gbat'a ba ji l'ojo'dajo","marked":"Gbàt'á bá jí l'ọjọ́'dájọ́"},{"start":41.599,"end":42.801,"text":"Fi wa si otun Re.","marked":"Fi wá sí ọ̀tún Rẹ."}],"end":42.801}]}