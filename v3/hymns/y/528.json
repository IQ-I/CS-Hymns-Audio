{"v":3,"coll":"y","num":528,"id":"hymn_528","title":"ALABUKUN ni fun ife","duration":33.41,"voices":{"male":{"file":"y-528-male-v3.m4a","bytes":227474,"sha256":"c97bbba26e56826674017b6b84782d1f04d48e3ec2be52f1c86f3da11e4dab2c","duration":33.5},"female":{"file":"y-528-female-v3.m4a","bytes":236786,"sha256":"08c98e9560b708fa9c000e5a2ab48fa44002835c3d36390bc251733634964743","duration":33.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.724,"text":"ALABUKUN ni fun ifẹ,","marked":"Alábùkún ni fún ìfẹ́"},{"start":2.174,"end":3.518,"text":"Ti ki o jẹ k'a ya;","marked":"Tí kí ó jẹ́ k'á ya"},{"start":3.968,"end":5.41,"text":"Bi ara wa jina s'ara,","marked":"Bí ara wa jìnà s'ára"},{"start":5.86,"end":7.044,"text":"Ọkan wa wa l'ọkan.","marked":"Ọkàn wa wà l'ọkàn."}],"end":7.044},{"key":"2","start":7.994,"lines":[{"start":7.994,"end":9.364,"text":"Da ọpọ Ẹmi s'ori wa,","marked":"Dá ọ̀pọ̀ Ẹ̀mí s'orí wa"},{"start":9.814,"end":11.106,"text":"Ọna t'O la l'a n tọ;","marked":"Ọ̀nà t'Ó là l'á ń tọ́"},{"start":11.556,"end":13.414,"text":"Nipa ti Jesu l'a si n rin,","marked":"Nípa tí Jésù l'á sì ń rìn"},{"start":13.864,"end":15.007,"text":"Iyin Rẹ l'a n fi han.","marked":"Ìyìn Rẹ̀ l'à ń fi hàn."}],"end":15.007},{"key":"3","start":15.957,"lines":[{"start":15.957,"end":17.201,"text":"Awa ba ma rin l'ọna Rẹ,","marked":"Àwa bá má rìn l'ọ̀nà Rẹ"},{"start":17.651,"end":19.14,"text":"K'a ma si m'ohun kan,","marked":"K'á má sì m'ohun kan"},{"start":19.59,"end":21.96,"text":"K'a ma fẹ 'hun kan, bikose,","marked":"K'á má fẹ́ hun kan, bíkọsẹ̀"},{"start":22.41,"end":23.845,"text":"Jesu t'a pa fun wa.","marked":"Jésù t'a pa fún wa."}],"end":23.845},{"key":"4","start":24.795,"lines":[{"start":24.795,"end":26.483,"text":"K'a sunmo O girigiri","marked":"K'á súnmọ́ Ó gírígírí"},{"start":26.933,"end":27.965,"text":"Ati si ona Re","marked":"Àti sí ọ̀nà Rẹ"},{"start":28.415,"end":30.18,"text":"K'a ma r'ore gba lodo Re","marked":"K'á má r'ọrẹ gbà lọ́dọ̀ Rẹ"},{"start":30.63,"end":31.86,"text":"Ekun ore-ofe.","marked":"Ẹkún oore-ọ̀fẹ́."}],"end":31.86}]}