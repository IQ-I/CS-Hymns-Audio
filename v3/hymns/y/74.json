{"v":3,"coll":"y","num":74,"id":"hymn_74","title":"BABA niwaju ite Re","duration":46.473,"voices":{"male":{"file":"y-74-male-v3.m4a","bytes":328328,"sha256":"0b83a2b9777d5ec2bef255cbe742264d5e5a7daab2f471a008d1db4af5b73fc6","duration":46.5},"female":{"file":"y-74-female-v3.m4a","bytes":339921,"sha256":"ef5e04560150581ade9c71a490c8e48bada4a30e1d436db2ef22e129ae19dec8","duration":46.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.54,"text":"BABA niwaju itẹ Rẹ,","marked":"Baba níwájú ìtẹ́ Rẹ"},{"start":1.99,"end":3.154,"text":"L'Angẹli n tẹriba,","marked":"L'Áńgẹ́lì ń tẹríba"},{"start":3.604,"end":4.893,"text":"Nigba gbogbo niwaju Rẹ,","marked":"Nígbà gbogbo níwájú Rẹ̀"},{"start":5.343,"end":6.402,"text":"Ni wọn n kọrin iyin,","marked":"Ni wọ́n ń kọrin ìyìn"},{"start":6.852,"end":8.519,"text":"Wọn si n fi ade wura wọn,","marked":"Wọ́n sì ń fi adé wúrà wọn"},{"start":8.969,"end":10.593,"text":"Lelẹ y'itẹ naa ka,","marked":"Lélẹ̀ y'ìtẹ́ náà ká"},{"start":11.043,"end":12.472,"text":"Wọn n fi ohun pẹlu duru,","marked":"Wọ́n ń fi ohun pẹ̀lú dùrù"},{"start":12.922,"end":14.016,"text":"Kọrin si Oluwa.","marked":"Kọrin sí Olúwa."}],"end":14.016},{"key":"2","start":14.966,"lines":[{"start":14.966,"end":16.751,"text":"Didan osumare si n tan","marked":"Dídán òṣùmàrè sì ń tán"},{"start":17.201,"end":18.407,"text":"Si ara iyẹ wọn,","marked":"Sí ara ìyẹ́ wọn"},{"start":18.857,"end":20.573,"text":"Bi Seraf' ti n ke si Seraf',","marked":"Bí Seraf tí ń ké sí Seraf"},{"start":21.023,"end":22.006,"text":"Ti wọn kọrin 'yin Rẹ,","marked":"Tí wọ́n kọrin yìn Rẹ̀"},{"start":22.456,"end":23.791,"text":"Bi a ti kunlẹ nihin yii,","marked":"Bí a ti kúnlẹ̀ níhìn yìí"},{"start":24.241,"end":25.248,"text":"Ran ore Rẹ si wa,","marked":"Rán ọrẹ Rẹ sí wa"},{"start":25.698,"end":27.621,"text":"Ka mọ pe 'Wọ wa nitosi,","marked":"Ká mọ̀ pé 'Wọ wà nítòsí"},{"start":28.071,"end":29.444,"text":"Lati da wa l'ohun.","marked":"Láti dá wa l'ohun."}],"end":29.444},{"key":"3","start":30.394,"lines":[{"start":30.394,"end":31.732,"text":"Nihin nibi t'awọn Angẹli,","marked":"Níhìn níbi t'àwọn Áńgẹ́lì"},{"start":32.182,"end":34.526,"text":"N wo wa, ba ti n sin Ọ,","marked":"Ń wò wá, bá ti ń sìn Ọ"},{"start":34.976,"end":36.287,"text":"Kọ wa k'a wa ile ọrun,","marked":"Kọ́ wá k'á wá ilé ọ̀run"},{"start":36.737,"end":37.856,"text":"K'a sin Ọ bi ti wọn,","marked":"K'á sin Ọ́ bí tí wọ́n"},{"start":38.306,"end":39.651,"text":"K'a ba wọn kọ orin iyin,","marked":"K'á bá wọn kọ orin ìyìn"},{"start":40.101,"end":41.215,"text":"K'a ba wọn mọ 'fẹ Rẹ,","marked":"K'á bá wọn mọ́ 'fẹ Rẹ"},{"start":41.665,"end":43.162,"text":"Titi agbara y'o fi di,","marked":"Títí agbára y'ó fi di"},{"start":43.612,"end":44.924,"text":"Tirẹ Tirẹ nikan.","marked":"Tirẹ̀ Tirẹ̀ nìkan."}],"end":44.924}]}