{"v":3,"coll":"y","num":242,"id":"hymn_242","title":"KRISTI sun f'elese","duration":23.953,"voices":{"male":{"file":"y-242-male-v3.m4a","bytes":159561,"sha256":"c562d61ac8886a72b77d2b2cbbad3a7341d14e8a0b4c42cacd661794e397869f","duration":24.0},"female":{"file":"y-242-female-v3.m4a","bytes":165515,"sha256":"f0ce05c88ec9720793588f053cc2cfa95e3ad94e390b22bb66ad7f6587a800f9","duration":24.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.683,"text":"KRISTI sun f'elese","marked":"Kristi sùn f'ẹlẹ́ṣẹ̀"},{"start":2.133,"end":3.275,"text":"Oju wa o gbe bi?","marked":"Ojú wa ó gbé bí?"},{"start":3.725,"end":5.548,"text":"K'omi ronu at'ikanu","marked":"K'omi ronú àt'ìkanu"},{"start":5.998,"end":7.36,"text":"Tu jade l'oju wa.","marked":"Tú jáde l'ojú wa."}],"end":7.36},{"key":"2","start":8.31,"lines":[{"start":8.31,"end":9.334,"text":"Ọmọ Ọlọrun n sun,","marked":"Ọmọ Ọlọ́run ń sùn"},{"start":9.784,"end":11.038,"text":"Angẹli siju wo!","marked":"Áńgẹ́lì síjú wò!"},{"start":11.488,"end":13.221,"text":"K'o damu, iwọ ọkan mi,","marked":"K'ó dàmú, ìwọ ọkàn mi"},{"start":13.671,"end":14.892,"text":"O d'omi ni fun ọ.","marked":"Ó d'omi ni fún ọ."}],"end":14.892},{"key":"3","start":15.842,"lines":[{"start":15.842,"end":17.145,"text":"O sun k'awa k'o sun","marked":"Ó sùn k'àwa k'ó sùn"},{"start":17.595,"end":18.654,"text":"Ese bere ekun","marked":"Ẹ̀ṣẹ̀ bẹ̀rẹ̀ ẹkún"},{"start":19.104,"end":20.438,"text":"Orun nikan ni ko s'ese","marked":"Ọ̀run nìkan ni kò s'ẹ̀ṣẹ̀"},{"start":20.888,"end":22.404,"text":"Nibe ni ko s'ekun.","marked":"Níbẹ̀ ni kò s'ẹkún."}],"end":22.404}]}