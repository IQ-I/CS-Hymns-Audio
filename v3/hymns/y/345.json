{"v":3,"coll":"y","num":345,"id":"hymn_345","title":"OLORUN goke lo","duration":40.873,"voices":{"male":{"file":"y-345-male-v3.m4a","bytes":277466,"sha256":"4bc130b3d4c787dd3b8e118ccb768baf52fd23a3e6b8e50de4880281d49ab593","duration":40.9},"female":{"file":"y-345-female-v3.m4a","bytes":282237,"sha256":"a3d43b6074f03872ed7c0541129b5932551135dd0ee3410e8a39fb0be0f545fd","duration":40.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.422,"text":"Ọlọrun goke lọ,","marked":"Ọlọ́run gòkè lọ"},{"start":1.872,"end":2.898,"text":"Pẹlu ariwo nla;","marked":"Pẹ̀lú ariwo ńlá"},{"start":3.348,"end":4.248,"text":"Awọn ipe ọrun,","marked":"Àwọn ìpè ọ̀run"},{"start":4.698,"end":6.102,"text":"Ń fi ayọ Angẹli han,","marked":"Ń fi ayọ̀ Áńgẹ́lì hàn"}],"end":6.102},{"key":"CHORUS","start":7.052,"lines":[{"start":7.052,"end":8.83,"text":"Gbogbo ayé yo, k'e gberin","marked":"Gbogbo ayé yọ̀, k'é gberin"},{"start":9.28,"end":10.913,"text":"E f'ogo fun Oba Ogo.","marked":"Ẹ f'ògo fún Ọba Ògo."}],"end":10.913},{"key":"2","start":11.863,"lines":[{"start":11.863,"end":12.889,"text":"O j'eniyan layé","marked":"Ó j'ènìyàn layé"},{"start":13.339,"end":14.373,"text":"Ọba wa ni loke;","marked":"Ọba wà ní lókè"},{"start":14.823,"end":15.773,"text":"Ki gbogbo ilẹ mọ,","marked":"Kí gbogbo ilẹ̀ mọ́"},{"start":16.223,"end":17.462,"text":"Ifẹ nla Jesu wa;","marked":"Ìfẹ́ ńlá Jésù wà"}],"end":17.462},{"key":"3","start":18.412,"lines":[{"start":18.412,"end":19.721,"text":"Baba fi agbara,","marked":"Baba fi agbára"},{"start":20.171,"end":21.208,"text":"Fun Jesu Oluwa;","marked":"Fún Jésù Olúwa"},{"start":21.658,"end":22.946,"text":"Ogun Angẹl mbọ Ọ,","marked":"Ogun Angẹl mbọ̀ Ọ"},{"start":23.396,"end":24.843,"text":"Oun l'Ọba nla ọrun","marked":"Òun l'Ọba ńlá ọ̀run"}],"end":24.843},{"key":"4","start":25.793,"lines":[{"start":25.793,"end":26.867,"text":"L'or'itẹ Rẹ mimọ,","marked":"L'ór'ìtẹ́ Rẹ mímọ́"},{"start":27.317,"end":28.666,"text":"O gb'ọpa ododo;","marked":"Ó gb'ọ̀pá òdodo"},{"start":29.116,"end":30.092,"text":"Gbogbo ọta Rẹ ni,","marked":"Gbogbo ọ̀tá Rẹ ni"},{"start":30.542,"end":31.717,"text":"Yoo ka lo bẹrẹ.","marked":"Yóò ká lọ bẹ̀rẹ̀."}],"end":31.717},{"key":"5","start":32.667,"lines":[{"start":32.667,"end":33.889,"text":"f Ọta Rẹ l'ọta wa,","marked":"f Ọ̀tá Rẹ l'ọ̀tá wa"},{"start":34.339,"end":36.057,"text":"Esu, ayé, ẹsẹ;","marked":"Èṣù, ayé, ẹsẹ̀"},{"start":36.507,"end":37.668,"text":"Sugbọn y'o r'ẹhin wọn,","marked":"Sùgbọ́n y'ó r'ẹ̀hìn wọn"},{"start":38.118,"end":39.324,"text":"Ijọba Rẹ y'o de,","marked":"Ìjọba Rẹ y'ó dé"}],"end":39.324}]}