{"v":3,"coll":"y","num":263,"id":"hymn_263","title":"PADA asako s'ile re","duration":28.521,"voices":{"male":{"file":"y-263-male-v3.m4a","bytes":194960,"sha256":"01493a4a19c4082c059a136582fab5c7b018b41c8289d46edfb9cb87aff7a10d","duration":28.6},"female":{"file":"y-263-female-v3.m4a","bytes":206833,"sha256":"233739e6d2bf32982fff1f45a31ab2b9d30c53c3903fd9efeb3e3dca974c7e74","duration":28.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.919,"text":"Pada asako, s'ile rẹ,","marked":"Padà àṣàkò, s'ilé rẹ̀"},{"start":2.369,"end":3.581,"text":"Baba rẹ l'o n pe ọ;","marked":"Baba rẹ̀ l'ó ń pè ọ́"},{"start":4.031,"end":5.247,"text":"Mase alarinkiri mọ,","marked":"Máṣe alárìnkiri mọ́"},{"start":5.697,"end":7.098,"text":"Nin' ẹsẹ at'osi;","marked":"Nín ẹsẹ àt'òṣì"},{"start":7.548,"end":8.545,"text":"Pada, pada.","marked":"Padà, padà."}],"end":8.545},{"key":"2","start":9.495,"lines":[{"start":9.495,"end":10.813,"text":"Pada asako s'ile rẹ,","marked":"Padà àṣàkò s'ilẹ̀ rẹ̀"},{"start":11.263,"end":12.679,"text":"Jesu l'o sa n pe ọ;","marked":"Jésù l'ó sá ń pè ọ́"},{"start":13.129,"end":14.747,"text":"Ẹmi pẹlu Ijọ si n pe,","marked":"Ẹ̀mí pẹ̀lú Ìjọ sì ń pè"},{"start":15.197,"end":16.402,"text":"Yara sa asala;","marked":"Yára sá àsálà"},{"start":16.852,"end":17.735,"text":"Pada, pada.","marked":"Padà, padà."}],"end":17.735},{"key":"3","start":18.685,"lines":[{"start":18.685,"end":19.93,"text":"Pada asako s'ile re","marked":"Padà àṣàkò s'ilẹ̀ rẹ̀"},{"start":20.38,"end":22.266,"text":"Were ni, b'o ba pe","marked":"Wèrè ni, b'ó bá pè"},{"start":22.716,"end":24.193,"text":"Ko si 'dariji n'iboji","marked":"Kò sì dáríjì n'ibojì"},{"start":24.643,"end":25.586,"text":"Ojo anu kuru","marked":"Ọjọ́ àánú kúrú"},{"start":26.036,"end":26.971,"text":"Pada, pada.","marked":"Padà, padà."}],"end":26.971}]}