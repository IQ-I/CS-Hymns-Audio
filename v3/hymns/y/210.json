{"v":3,"coll":"y","num":210,"id":"hymn_210","title":"APATA ayeraye","duration":60.361,"voices":{"male":{"file":"y-210-male-v3.m4a","bytes":433513,"sha256":"f3c2761caae8a9d6dd2ce9284aca30133641ec5deb06cb9eaa276e08b0aae197","duration":60.4},"female":{"file":"y-210-female-v3.m4a","bytes":444941,"sha256":"362b9d3ee999491b280826c0e3660a4ba19c8f75ccc15d12ac6aabfc4ada6623","duration":60.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.663,"text":"APATA ayérayé,","marked":"Àpáta ayérayé"},{"start":2.113,"end":3.238,"text":"Ẹni t'o mbẹ lailai,","marked":"Ẹni t'ó mbẹ́ láéláé"},{"start":3.688,"end":5.017,"text":"Nigbakugba t'iji nla,","marked":"Nígbàkúgbà t'ìjì ńlá"},{"start":5.467,"end":6.509,"text":"'Wọ 'bugbe alafia;","marked":"'Wọ bùgbé àlàáfíà"},{"start":6.959,"end":8.136,"text":"Saaju dida ayé yi,","marked":"Ṣáájú dídá ayé yí"},{"start":8.586,"end":10.32,"text":"Iwọ mbẹ; bakan naa,","marked":"Ìwọ mbẹ́; bákan náà"},{"start":10.77,"end":12.271,"text":"Tit' ayé ainipẹkun,","marked":"Tít ayé àìnípẹ̀kun"},{"start":12.721,"end":13.742,"text":"Ayérayé ni 'Wo.","marked":"Ayérayé ni wò."}],"end":13.742},{"key":"2","start":14.692,"lines":[{"start":14.692,"end":15.952,"text":"Ọj'ọdun wa ri b'oji,","marked":"Ọj'ọdún wa rí b'òjì"},{"start":16.402,"end":17.68,"text":"T'o han l'ori oke;","marked":"T'ó hàn l'orí òkè"},{"start":18.13,"end":19.31,"text":"Bi koriko ipado,","marked":"Bí koríko ipadò"},{"start":19.76,"end":21.467,"text":"T'o ru ti o si ku;","marked":"T'ó ru tí ó sì kú"},{"start":21.917,"end":23.681,"text":"Bi ala; tabi b'itan,","marked":"Bí àlá; tàbí b'ìtàn"},{"start":24.131,"end":25.38,"text":"T'ẹnikan ń yara pa;","marked":"T'ẹnìkan ń yára pa"},{"start":25.83,"end":27.028,"text":"Ogo ti ko ni si mọ,","marked":"Ògo tí kò ní sí mọ́"},{"start":27.478,"end":28.671,"text":"Ohun t'o gbọ tan ni.","marked":"Ohun t'ó gbọ́ tán ni."}],"end":28.671},{"key":"3","start":29.621,"lines":[{"start":29.621,"end":30.935,"text":"‘Wọ ẹni ti ki togbe,","marked":"'Wọ ẹni tí kí tọ̀gbẹ́"},{"start":31.385,"end":32.558,"text":"'Mọlẹ ẹni t'itan:","marked":"'Mọlẹ ẹni t'ìtàn"},{"start":33.008,"end":34.52,"text":"Ko wa bi a o ti ka,","marked":"Kò wá bí a ó ti kà"},{"start":34.97,"end":36.065,"text":"Ọjọ wa ko to tan;","marked":"Ọjọ́ wa kò tó tán"},{"start":36.515,"end":37.781,"text":"Jẹ k'anu Rẹ ba le wa,","marked":"Jẹ́ k'àánú Rẹ bá lè wà"},{"start":38.231,"end":39.571,"text":"K'ore Rẹ pọ fun wa;","marked":"K'ọrẹ Rẹ pọ̀ fún wa"},{"start":40.021,"end":41.281,"text":"Si jẹ k'Ẹmi Mimọ Rẹ,","marked":"Sì jẹ́ k'Ẹ̀mí Mímọ́ Rẹ"},{"start":41.731,"end":43.046,"text":"Mọlẹ si ọkan wa.","marked":"Mọ́lẹ̀ sí ọkàn wa."}],"end":43.046},{"key":"4","start":43.996,"lines":[{"start":43.996,"end":46.179,"text":"Jesu, f'ẹwa at'ore,","marked":"Jésù, f'ẹwà àt'ọrẹ"},{"start":46.629,"end":47.993,"text":"De 'gbagbọ wa l'ade;","marked":"Dé 'gbagbọ wa l'adé"},{"start":48.443,"end":50.018,"text":"Tit' a o fi ri Ọ gbangba,","marked":"Tít a ó fi rí Ọ gbangba"},{"start":50.468,"end":51.738,"text":"Ninu 'mọlẹ lailai,","marked":"Nínú 'mọlẹ láéláé"},{"start":52.188,"end":53.434,"text":"Ayọ t'ẹnu ko le sọ,","marked":"Ayọ̀ t'ẹnu kò lè sọ"},{"start":53.884,"end":54.962,"text":"Orisun akunya,","marked":"Orísun àkúnya"},{"start":55.412,"end":57.013,"text":"Alafia Ailopin;","marked":"Àlàáfíà Àìlópin"},{"start":57.463,"end":58.812,"text":"Okun ailebute.","marked":"Òkun àìlébùté."}],"end":58.812}]}