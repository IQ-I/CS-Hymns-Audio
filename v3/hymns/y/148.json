{"v":3,"coll":"y","num":148,"id":"hymn_148","title":"IMOLE iyanu ntan","duration":60.773,"voices":{"male":{"file":"y-148-male-v3.m4a","bytes":429769,"sha256":"734d679f88ef328b37ebfa5b1ce48c56a056c84df8f8d1acc0563fb3a672e865","duration":60.8},"female":{"file":"y-148-female-v3.m4a","bytes":444837,"sha256":"549820ce61361b0c1386d93b0d1c15a2188efc01d4ec0f0ef613c7223d911fcc","duration":60.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.458,"text":"IMOLE iyanu ntan","marked":"Ìmọ́lẹ̀ ìyanu ńtán"},{"start":1.908,"end":3.338,"text":"Gba Kristien ba nkorin","marked":"Gba Kristien bá ńkọrin"},{"start":3.788,"end":4.966,"text":"Oluwa ni ngbe ni ro","marked":"Olúwa ní ńgbé ni rò"},{"start":5.416,"end":6.606,"text":"lwosan n'n'apa Re","marked":"Ìwòsàn n'n'apá Rẹ"},{"start":7.056,"end":8.428,"text":"'Gba olutunu jin'na","marked":"gba olùtùnú jìn'nà"},{"start":8.878,"end":10.175,"text":"O nfun okan ni'simi","marked":"Ó ńfun ọkàn ní'ṣímí"},{"start":10.625,"end":11.82,"text":"lmole otun y'o la","marked":"Ìmọ́lẹ̀ ọ̀tún y'ó là"},{"start":12.27,"end":13.62,"text":"Nigba t'ojo si da.","marked":"Nígbà t'ọjọ́ sì dá."}],"end":13.62},{"key":"2","start":14.57,"lines":[{"start":14.57,"end":16.033,"text":"Nigba t'ero mimo nso","marked":"Nígbà t'èrò mímọ́ ńṣọ́"},{"start":16.483,"end":18.04,"text":"L'ayo la'wa nlepa","marked":"L'ayọ̀ là'wá ńlépa"},{"start":18.49,"end":19.461,"text":"lgbala Olorun wa","marked":"Ìgbàlà Ọlọ́run wa"},{"start":19.911,"end":21.334,"text":"T'a si nri gba l'otun","marked":"T'a sì ńrí gbà l'ọ̀tún"},{"start":21.784,"end":23.262,"text":"O ngba wa n'nu 'banuje","marked":"Ó ńgbà wá n'nú banújẹ́"},{"start":23.712,"end":25.17,"text":"Awa le f'ayo wipe","marked":"Àwa lè f'ayọ̀ wípé"},{"start":25.62,"end":26.887,"text":"Je ki ola aimo de","marked":"Jẹ́ kí ọlá àìmọ́ dé"},{"start":27.337,"end":28.524,"text":"Ohun t'o wun k'o je.","marked":"Ohun t'ó wun k'ó jẹ́."}],"end":28.524},{"key":"3","start":29.474,"lines":[{"start":29.474,"end":30.638,"text":"Ohunkohun t'o le de","marked":"Ohunkóhun t'ó lè dé"},{"start":31.088,"end":32.544,"text":"Jesu y'o gba wa la","marked":"Jésù y'ó gbà wá là"},{"start":32.994,"end":34.663,"text":"On t'o wo lili l'aso","marked":"Òn t'ó wó lílì l'aṣọ"},{"start":35.113,"end":36.405,"text":"Y'o fi aso wo wa","marked":"Y'ó fi aṣọ wò wá"},{"start":36.855,"end":38.189,"text":"L'abe orun t'o teju","marked":"L'abẹ́ ọ̀run t'ó tẹ́jú"},{"start":38.639,"end":39.848,"text":"Ghogbo eda l'o nbo","marked":"Ghogbo ẹ̀dá l'ó ńbọ̀"},{"start":40.298,"end":41.544,"text":"On t'o nbo eiye orun","marked":"Òn t'ó ńbọ èìyẹ́ ọ̀run"},{"start":41.994,"end":43.211,"text":"Y'o bo aw'omo Re.","marked":"Y'ó bo àw'ọmọ Rẹ̀."}],"end":43.211},{"key":"4","start":44.161,"lines":[{"start":44.161,"end":45.676,"text":"B'ajara tabi opoto","marked":"B'àjàrà tàbí ọ̀pọ̀tọ́"},{"start":46.126,"end":47.488,"text":"Ko lati m'eso wa","marked":"Kò láti m'èso wá"},{"start":47.938,"end":49.216,"text":"Bi gbogbo eweko gbe","marked":"Bí gbogbo ewéko gbé"},{"start":49.666,"end":51.203,"text":"T' agbo agutan s'egbe","marked":"T agbo àgùtàn s'ẹgbẹ́"},{"start":51.653,"end":52.804,"text":"Olorun wa mbe sibe","marked":"Ọlọ́run wá mbẹ́ síbẹ̀"},{"start":53.254,"end":55.222,"text":"Iyin Re y'o kun enu mi","marked":"Ìyìn Rẹ̀ y'ó kún ẹnu mi"},{"start":55.672,"end":57.246,"text":"Bi mo gbekele E titi","marked":"Bí mo gbẹ́kẹ̀lé Ẹ títí"},{"start":57.696,"end":59.224,"text":"Ayo y'o je t'emi.","marked":"Ayọ̀ y'ó jẹ́ t'èmi."}],"end":59.224}]}