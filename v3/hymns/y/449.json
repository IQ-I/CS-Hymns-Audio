{"v":3,"coll":"y","num":449,"id":"hymn_449","title":"F'ERU re f'afefe","duration":31.163,"voices":{"male":{"file":"y-449-male-v3.m4a","bytes":205550,"sha256":"8704790dd336c5ee9ef3b51c571f044eb07957a5eba3b54ee35c26ae6971bebd","duration":31.2},"female":{"file":"y-449-female-v3.m4a","bytes":214251,"sha256":"6effe97010b34fe0f8e4242c7eec6fcbb58fa9039491979f4e3a6b6a502bf736","duration":31.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.496,"text":"F'ẸRU rẹ f'afẹfẹ;","marked":"F'Ẹ̀rù rẹ̀ f'afẹ́fẹ́"},{"start":1.946,"end":3.267,"text":"N'ireti ma foya;","marked":"N'ìrètí má fòyà"},{"start":3.717,"end":4.938,"text":"Ọlọrun gbọ 'mikanlẹ rẹ,","marked":"Ọlọ́run gbọ́ 'mikanlẹ rẹ̀"},{"start":5.388,"end":6.645,"text":"Yoo gb'ori rẹ ga.","marked":"Yóò gb'orí rẹ̀ ga."}],"end":6.645},{"key":"2","start":7.595,"lines":[{"start":7.595,"end":8.997,"text":"N'irumi at'iji","marked":"N'ìrumi àt'ìjì"},{"start":9.447,"end":10.536,"text":"Y'o s'ona re fefe","marked":"Y'ó s'ọ̀nà rẹ̀ fẹ́fẹ́"},{"start":10.986,"end":12.92,"text":"Duro de igba Re, oru","marked":"Dúró de ìgbà Rẹ, òru"},{"start":13.37,"end":14.688,"text":"Y'o pin s'ojo ayo.","marked":"Y'ó pín s'ọjọ́ ayọ̀."}],"end":14.688},{"key":"3","start":15.638,"lines":[{"start":15.638,"end":16.663,"text":"Iwọ r'ailera wa,","marked":"Ìwọ r'áìlera wa"},{"start":17.113,"end":18.193,"text":"Inu wa n'iwọ mọ;","marked":"Inú wa n'ìwọ mọ́"},{"start":18.643,"end":20.196,"text":"Gbe ọwọ t'o rọ si oke,","marked":"Gbé ọwọ́ t'ó rọ̀ sí òkè"},{"start":20.646,"end":21.956,"text":"M'ekun ailera le.","marked":"M'ẹ́kùn àìlera le."}],"end":21.956},{"key":"4","start":22.906,"lines":[{"start":22.906,"end":24.019,"text":"K'awa n'iye n'iku,","marked":"K'àwa n'ìyẹ́ n'ikú"},{"start":24.469,"end":25.764,"text":"Sọ, Ọrọ Rẹ tantan;","marked":"Sọ, Ọ̀rọ̀ Rẹ tàntàn"},{"start":26.214,"end":27.876,"text":"K'a sọ tit' opin ẹmi wa,","marked":"K'á sọ tít òpin ẹ̀mí wá"},{"start":28.326,"end":29.614,"text":"Ifẹ, itọju Rẹ.","marked":"Ìfẹ́, ìtọ́jú Rẹ."}],"end":29.614}]}