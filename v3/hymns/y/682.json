{"v":3,"coll":"y","num":682,"id":"hymn_682","title":"OJ' ONI lo","duration":38.331,"voices":{"male":{"file":"y-682-male-v3.m4a","bytes":245106,"sha256":"dc8a20010af6aa2ee2d1482f7d274a798aac14001e436de2d69c3ef39db4d20b","duration":38.4},"female":{"file":"y-682-female-v3.m4a","bytes":254915,"sha256":"7d32356e43cba78369f116cbef29fbd114e1215a59d00214155cca2f507480b0","duration":38.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.149,"text":"ỌJ' ONI lọ,","marked":"Ọj' Òní lọ"},{"start":1.599,"end":2.52,"text":"Jesu, Baba,","marked":"Jésù, Baba"},{"start":2.97,"end":4.47,"text":"Boju Rẹ w'emi ọmọ Rẹ.","marked":"Bojú Rẹ̀ w'ẹ̀mí ọmọ Rẹ."}],"end":4.47},{"key":"2","start":5.42,"lines":[{"start":5.42,"end":6.334,"text":"Wo Imole","marked":"Wo Ìmọ́lẹ̀"},{"start":6.784,"end":7.725,"text":"Se 'toju mi","marked":"Ṣe tọ́jú mi"},{"start":8.175,"end":9.494,"text":"Tan imole Re yi mi ka.","marked":"Tan ìmọ́lẹ̀ Rẹ yí mi ká."}],"end":9.494},{"key":"3","start":10.444,"lines":[{"start":10.444,"end":11.14,"text":"Olugbala,","marked":"Olùgbàlà"},{"start":11.59,"end":12.312,"text":"N ko ni bẹru,","marked":"N kò ní bẹ̀rù"},{"start":12.762,"end":14.357,"text":"Nitori O wa lọdọ mi.","marked":"Nítorí Ó wà lọ́dọ̀ mi."}],"end":14.357},{"key":"4","start":15.307,"lines":[{"start":15.307,"end":16.087,"text":"Nigba gbogbo,","marked":"Nígbà gbogbo"},{"start":16.537,"end":17.326,"text":"Ni oju Rẹ,","marked":"Ní ojú Rẹ"},{"start":17.776,"end":20.133,"text":"N sọ mi, gba t'ẹnikan ko si.","marked":"Ń sọ mí, gba t'ẹnìkan kò sí."}],"end":20.133},{"key":"5","start":21.083,"lines":[{"start":21.083,"end":21.915,"text":"Nigba gbogbo,","marked":"Nígbà gbogbo"},{"start":22.365,"end":23.143,"text":"Ni eti Rẹ,","marked":"Ní etí Rẹ"},{"start":23.593,"end":25.191,"text":"N si si adura ọmọde.","marked":"Ń sì ṣí àdúrà ọmọdé."}],"end":25.191},{"key":"6","start":26.141,"lines":[{"start":26.141,"end":26.906,"text":"Nitori naa,","marked":"Nítorí náà"},{"start":27.356,"end":28.281,"text":"Laisi foya,","marked":"Láìsí fòyà"},{"start":28.731,"end":30.842,"text":"Mo sun, mo si sinmi le Ọ.","marked":"Mo sùn, mo sì sinmi lé Ọ."}],"end":30.842},{"key":"7","start":31.792,"lines":[{"start":31.792,"end":33.095,"text":"Baba, Ọmọ,","marked":"Baba, Ọmọ"},{"start":33.545,"end":34.278,"text":"Ẹmi Mimọ,","marked":"Ẹ̀mí Mímọ́"},{"start":34.728,"end":36.781,"text":"Ni iyin yẹ l'ọrun, layé.","marked":"Ní ìyìn yẹ̀ l'ọ̀run, layé."}],"end":36.781}]}