{"v":3,"coll":"y","num":734,"id":"hymn_734","title":"EGBE Serafu, e dide","duration":35.104,"voices":{"male":{"file":"y-734-male-v3.m4a","bytes":252879,"sha256":"0cb97d02b19d4c142989fc6b58e71298d82fd5990be2382e499ce19aa5f47d2e","duration":35.2},"female":{"file":"y-734-female-v3.m4a","bytes":266633,"sha256":"089bd1d2e6df443bfaf92efa6a1b24898b69b37ecf0af8d94ef74ad141f5bfa3","duration":35.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.421,"text":"Ẹgbẹ Séráfù, ẹ dide,","marked":"Ẹgbẹ́ Séráfù, ẹ dìde"},{"start":2.871,"end":4.258,"text":"Ẹ d'amure yin giri;","marked":"Ẹ d'àmùrè yín gírí"},{"start":4.708,"end":6.339,"text":"Ọlọrun lo d'ẹgbẹ yi silẹ,","marked":"Ọlọ́run ló d'ẹ̀gbẹ́ yí sílẹ̀"},{"start":6.789,"end":8.166,"text":"Ẹ ma jẹ k'ẹru ba yin","marked":"Ẹ má jẹ́ k'ẹrú bá yín"},{"start":8.616,"end":10.071,"text":"Lọ wasu ihinrere Rẹ,","marked":"Lọ wàṣù ìhìnrere Rẹ"},{"start":10.521,"end":12.46,"text":"Yio pẹlu wa titi d'opin,","marked":"Yóò pẹ̀lú wa títí d'òpin"},{"start":12.91,"end":15.178,"text":"Kẹ 'sa ma wo Jesu ni ọkan,","marked":"Kẹ́ sá má wọ Jésù ní ọkàn"},{"start":15.628,"end":17.023,"text":"Titi a o fi sẹgun.","marked":"Títí a ó fi sẹ́gun."}],"end":17.023},{"key":"2","start":17.973,"lines":[{"start":17.973,"end":20.107,"text":"Ẹgbẹ Séráfù, ẹ dide,","marked":"Ẹgbẹ́ Séráfù, ẹ dìde"},{"start":20.557,"end":22.013,"text":"Lati tan Ọrọ Ọlọrun;","marked":"Láti tan Ọ̀rọ̀ Ọlọ́run"},{"start":22.463,"end":23.922,"text":"Paapaa larin ilu Eko,","marked":"Pàápàá lárin ìlú Ẹ̀kọ́"},{"start":24.372,"end":25.927,"text":"F'awọn to ti sako lọ,","marked":"F'àwọn tó ti ṣáko lọ"},{"start":26.377,"end":27.669,"text":"Ka le r'ẹni irapada,","marked":"Ká lè r'ẹni ìràpadà"},{"start":28.119,"end":29.627,"text":"Larin awọn ti o n segbe lọ,","marked":"Lárin àwọn tí ó ń ṣègbé lọ"},{"start":30.077,"end":31.775,"text":"Lati ran wọn s'agbo Jesu,","marked":"Láti rán wọn s'àgbò Jésù"},{"start":32.225,"end":33.554,"text":"Si iye ainipẹkun.","marked":"Sí ìyè àìnípẹ̀kun."}],"end":33.554}]}