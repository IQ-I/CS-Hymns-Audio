{"v":3,"coll":"y","num":685,"id":"hymn_685","title":"OMODE, e sunm' Olorun","duration":35.863,"voices":{"male":{"file":"y-685-male-v3.m4a","bytes":250309,"sha256":"9f90595cf853f52cb1788cc0d8604703e61034f7943f20f58f65d99644664da5","duration":35.9},"female":{"file":"y-685-female-v3.m4a","bytes":257751,"sha256":"c173a3290fcd15493c7e0bd8ca1206d999c2fdd5e0c10b3663b13afd98a65f38","duration":35.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.331,"text":"OMODE, e sunm' Olorun","marked":"Ọmọdé, ẹ súnm Ọlọ́run"},{"start":2.781,"end":4.23,"text":"Pelu irele at'eru","marked":"Pẹ̀lú ìrẹ̀lẹ̀ àt'ẹrù"},{"start":4.68,"end":6.186,"text":"Ki ekun gbogbo wole fun","marked":"Kí ẹkún gbogbo wọlé fún"},{"start":6.636,"end":8.294,"text":"Olugbala at'Ore wa.","marked":"Olùgbàlà àt'ọ̀rẹ́ wa."}],"end":8.294},{"key":"2","start":9.244,"lines":[{"start":9.244,"end":10.748,"text":"Oluwa, jẹ k'anu Rẹ nla,","marked":"Olúwa, jẹ́ k'àánú Rẹ̀ ńlá"},{"start":11.198,"end":12.559,"text":"Mu wa kun fun ọpẹ si Ọ;","marked":"Mú wa kún fún ọpẹ́ sí Ọ"},{"start":13.009,"end":15.183,"text":"Ati b'a ti n rin lọ l'ayé,","marked":"Àti b'á ti ń rìn lọ l'ayé"},{"start":15.633,"end":17.208,"text":"K'a ma ri ọpọ anu gba.","marked":"K'á má rí ọ̀pọ̀ àánú gbà."}],"end":17.208},{"key":"3","start":18.158,"lines":[{"start":18.158,"end":19.634,"text":"Oluwa! m'ero buburu,","marked":"Olúwa! m'èrò búburú"},{"start":20.084,"end":21.616,"text":"Jina rere si ọkan wa;","marked":"Jina rere sí ọkàn wa"},{"start":22.066,"end":23.726,"text":"L'ojojumọ fun wa l'ọgbọn,","marked":"L'ojojúmọ́ fún wa l'ọgbọ́n"},{"start":24.176,"end":25.831,"text":"Lati yan ọna toro ni.","marked":"Láti yan ọ̀nà tọ́rọ̀ ni."}],"end":25.831},{"key":"4","start":26.781,"lines":[{"start":26.781,"end":28.275,"text":"Igba aisan at'ilera,","marked":"Ìgbà àìsàn àt'ìlera"},{"start":28.725,"end":30.281,"text":"Igba aini tabi ọrọ;","marked":"Ìgbà àìní tàbí ọ̀rọ̀"},{"start":30.731,"end":32.219,"text":"Ati lakoko iku wa,","marked":"Àti lákokò ikú wá"},{"start":32.669,"end":34.314,"text":"Fi agbara Tirẹ gba wa.","marked":"Fi agbára Tìrẹ gbà wá."}],"end":34.314}]}