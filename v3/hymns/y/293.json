{"v":3,"coll":"y","num":293,"id":"hymn_293","title":"GBOGBO eje eran","duration":38.142,"voices":{"male":{"file":"y-293-male-v3.m4a","bytes":259477,"sha256":"179ad8e99fa0766d97018f7b3fbfa8c845ffba662c38f76491161574390e278c","duration":38.2},"female":{"file":"y-293-female-v3.m4a","bytes":272639,"sha256":"bd447c4495fd0c6d05a10970c933ad4b682bd8b11f38c4f4ec1c272885d7741f","duration":38.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.342,"text":"GBOGBO ẹjẹ ẹran,","marked":"Gbogbo ẹ̀jẹ̀ ẹran"},{"start":1.792,"end":2.933,"text":"Ti pẹpẹ awọn Ju;","marked":"Ti pẹpẹ àwọn Jù"},{"start":3.383,"end":4.958,"text":"Ko le f'ọkan l'alafia,","marked":"Kò lè f'ọkàn l'àlàáfíà"},{"start":5.408,"end":6.637,"text":"Ko le wẹ eeri nu.","marked":"Kò lè wẹ èérí nù."}],"end":6.637},{"key":"2","start":7.587,"lines":[{"start":7.587,"end":9.049,"text":"Kristi Ọd'aguntan,","marked":"Kristi Ọ̀d'àgùntàn"},{"start":9.499,"end":10.548,"text":"M'ẹsẹ wa gbogbo lọ;","marked":"M'ẹsẹ̀ wa gbogbo lọ"},{"start":10.998,"end":12.606,"text":"Ẹbọ t'o ni orukọ nla,","marked":"Ẹbọ t'ó ní orúkọ ńlá"},{"start":13.056,"end":14.319,"text":"T'o ju ẹjẹ wọn lọ.","marked":"T'ó ju ẹ̀jẹ̀ wọn lọ."}],"end":14.319},{"key":"3","start":15.269,"lines":[{"start":15.269,"end":16.463,"text":"Mo f'igbagbọ gb'ọwọ,","marked":"Mo f'ìgbàgbọ́ gb'ọwọ́"},{"start":16.913,"end":17.88,"text":"Le ori Rẹ ọwọn;","marked":"Lé orí Rẹ ọ̀wọ́n"},{"start":18.33,"end":19.657,"text":"B'ẹni t'o ronupiwada,","marked":"B'ẹni t'ó ronúpìwàdà"},{"start":20.107,"end":21.42,"text":"Mo jẹwọ ẹsẹ mi.","marked":"Mo jẹ́wọ́ ẹsẹ̀ mi."}],"end":21.42},{"key":"4","start":22.37,"lines":[{"start":22.37,"end":23.457,"text":"Ọkan mi n pada wo,","marked":"Ọkàn mi ń padà wò"},{"start":23.907,"end":25.028,"text":"Ẹru t'Iwọ ti ru;","marked":"Ẹ̀rù t'Ìwọ ti ru"},{"start":25.478,"end":27.052,"text":"Nigba ti a kan Ọ mọ'gi,","marked":"Nígbà tí a kan Ọ́ mọ́'gí"},{"start":27.502,"end":28.789,"text":"Ẹsẹ rẹ wa nibẹ.","marked":"Ẹsẹ̀ rẹ̀ wà níbẹ̀."}],"end":28.789},{"key":"5","start":29.739,"lines":[{"start":29.739,"end":31.18,"text":"f Awa n yọ ni 'gbagbọ,","marked":"f Àwa ń yọ̀ ní 'gbagbọ"},{"start":31.63,"end":33.033,"text":"Bi egun ti kuro;","marked":"Bí ègún ti kúrò"},{"start":33.483,"end":35.031,"text":"Awa yin Ọdọ-aguntan,","marked":"Àwa yin Ọdọ-aguntan"},{"start":35.481,"end":36.593,"text":"A n kọrin ifẹ rẹ.","marked":"A ń kọrin ìfẹ́ rẹ̀."}],"end":36.593}]}