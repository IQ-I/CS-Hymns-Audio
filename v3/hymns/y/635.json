{"v":3,"coll":"y","num":635,"id":"hymn_635","title":"'GBATI Samuel' ji","duration":55.911,"voices":{"male":{"file":"y-635-male-v3.m4a","bytes":390927,"sha256":"43b14d82b6c0391df3e1be083a5cac264e32b5ce3b0cbd6bc3778c004b1b8efc","duration":56.0},"female":{"file":"y-635-female-v3.m4a","bytes":401619,"sha256":"d5e9c45e09f6d08fd6d638b661e9f588de6feb845ce99fb5f8d300086f7be9dc","duration":56.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.586,"text":"'GBATI Samuel' ji,","marked":"gbati Samuẹl jí"},{"start":2.036,"end":3.101,"text":"T'o gb'ohun Ẹlẹda","marked":"T'ó gb'ohùn Ẹlẹda"},{"start":3.551,"end":4.623,"text":"Ni gbolohun kọkan,","marked":"Ní gbólóhùn kọkàn"},{"start":5.073,"end":6.24,"text":"Ayọ rẹ ti pọ to!","marked":"Ayọ̀ rẹ̀ ti pọ̀ tó!"},{"start":6.69,"end":8.076,"text":"Ibukun ni f'ọmọ t'o ri,","marked":"Ìbùkún ni f'ọmọ t'ó rí"},{"start":8.526,"end":9.879,"text":"Ọlọrun nitosi rẹ bẹ.","marked":"Ọlọ́run nítòsí rẹ̀ bẹ."}],"end":9.879},{"key":"2","start":10.829,"lines":[{"start":10.829,"end":11.88,"text":"B'Ọlọrun ba pe mi,","marked":"B'Ọlọ́run bá pè mí"},{"start":12.33,"end":13.832,"text":"Pe, ọrẹ mi ni Oun,","marked":"Pé, ọrẹ mi ni Òun"},{"start":14.282,"end":15.42,"text":"Ayọ mi y'o ti to!","marked":"Ayọ̀ mi y'ó ti tó!"},{"start":15.87,"end":17.084,"text":"N ó si f'eti silẹ,","marked":"N ó sì f'etí sílẹ̀"},{"start":17.534,"end":19.241,"text":"N ó sa f'ẹsẹ t'o kere ju,","marked":"N ó sá f'ẹsẹ̀ t'ó kéré jù"},{"start":19.691,"end":21.306,"text":"B'Ọlọrun sunmọ 'tosi bẹ.","marked":"B'Ọlọ́run súnmọ́ tòsí bẹ."}],"end":21.306},{"key":"3","start":22.256,"lines":[{"start":22.256,"end":23.391,"text":"Ko ha mba ni sọrọ?","marked":"Kò ha mbà ní sọ̀rọ̀?"},{"start":23.841,"end":25.317,"text":"Bẹni, n'nu ọrọ Rẹ,","marked":"Bẹni, n'nú ọ̀rọ̀ Rẹ"},{"start":25.767,"end":26.989,"text":"O n pe mi lati wa,","marked":"Ó ń pè mí láti wá"},{"start":27.439,"end":28.305,"text":"Ọlọrun Samuel;","marked":"Ọlọ́run Samuẹl"},{"start":28.755,"end":30.484,"text":"N'nu Iwe na ni mo ka pe,","marked":"N'nú Ìwé ná ni mo ká pé"},{"start":30.934,"end":32.236,"text":"Ọlọrun Samuel n pe mi.","marked":"Ọlọ́run Samuẹl ń pè mí."}],"end":32.236},{"key":"4","start":33.186,"lines":[{"start":33.186,"end":34.206,"text":"Mo le f'ori pamọ,","marked":"Mo lè f'orí pamọ́"},{"start":34.656,"end":35.852,"text":"S'abẹ itọju Rẹ,","marked":"S'abẹ́ ìtọ́jú Rẹ"},{"start":36.302,"end":37.365,"text":"Mo mọ p'Ọlọrun mbẹ,","marked":"Mo mọ̀ p'Ọlọ́run mbẹ́"},{"start":37.815,"end":39.307,"text":"Lọdọ mi n'gba gbogbo;","marked":"Lọ́dọ̀ mi n'gba gbogbo"},{"start":39.757,"end":41.07,"text":"O yẹ k'ẹru ẹsẹ ba mi,","marked":"Ó yẹ k'ẹrú ẹsẹ̀ bá mi"},{"start":41.52,"end":43.047,"text":"'Tor' Ọlọrun sunmọ 'tosi.","marked":"tọr Ọlọ́run súnmọ́ tòsí."}],"end":43.047},{"key":"5","start":43.997,"lines":[{"start":43.997,"end":45.323,"text":"'Gba mba n ka ọrọ Rẹ,","marked":"gbà mbá ń ka ọ̀rọ̀ Rẹ"},{"start":45.773,"end":46.937,"text":"Ki n wi bi Samuel pe;","marked":"Kí n wí bí Samuẹl pé"},{"start":47.387,"end":48.802,"text":"Ma wi, Oluwa mi,","marked":"Má wí, Olúwa mi"},{"start":49.252,"end":50.404,"text":"Emi y'o gbọ Tirẹ,","marked":"Èmi y'ó gbọ́ Tirẹ̀"},{"start":50.854,"end":52.204,"text":"'Gba mo ba si wa n'ile Rẹ,","marked":"gbà mo bá sì wà n'ilé Rẹ"},{"start":52.654,"end":54.362,"text":"Ma wi, 'tori 'ransẹ Rẹ n gbọ.","marked":"Má wí, torí 'ransẹ Rẹ̀ ń gbọ́."}],"end":54.362}]}