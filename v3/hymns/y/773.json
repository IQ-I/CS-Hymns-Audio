{"v":3,"coll":"y","num":773,"id":"hymn_773","title":"OLORUN awa fe","duration":44.501,"voices":{"male":{"file":"y-773-male-v3.m4a","bytes":298918,"sha256":"bb77815fffd32745483698c82a799dcb6016451ba59f7fccba72fc494856a251","duration":44.6},"female":{"file":"y-773-female-v3.m4a","bytes":308527,"sha256":"3dbf4c2424d074147fe05fecb140b2bfff2d7fc14b4f199d07672091cd161ecc","duration":44.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.066,"text":"OLORUN, awa fe","marked":"Ọlọ́run, àwa fẹ́"},{"start":2.516,"end":3.668,"text":"Ile t'ola Re wa","marked":"Ilẹ̀ t'ọlá Rẹ wà"},{"start":4.118,"end":5.09,"text":"Ayo ibugbe Re","marked":"Ayọ̀ ibùgbé Rẹ"},{"start":5.54,"end":6.805,"text":"Ju gbogbo ayo lo.","marked":"Ju gbogbo ayọ̀ lọ."}],"end":6.805},{"key":"2","start":7.755,"lines":[{"start":7.755,"end":8.875,"text":"Ile adura ni","marked":"Ilẹ̀ àdúrà ni"},{"start":9.325,"end":10.298,"text":"Fun awa omo Re","marked":"Fún àwa ọmọ Rẹ"},{"start":10.748,"end":12.344,"text":"Jesu, O wa nibe","marked":"Jésù, Ó wà níbẹ̀"},{"start":12.794,"end":14.315,"text":"Lati gbo ebe wa.","marked":"Láti gbọ́ ẹ̀bẹ̀ wá."}],"end":14.315},{"key":"3","start":15.265,"lines":[{"start":15.265,"end":16.424,"text":"Awa fẹ asẹ Rẹ,","marked":"Àwa fẹ́ àsẹ Rẹ̀"},{"start":16.874,"end":18.006,"text":"Ki 'o dun to layé;","marked":"Kí ó dùn tó layé"},{"start":18.456,"end":19.494,"text":"Nib' awọn olotọ,","marked":"Níb àwọn olótọ̀"},{"start":19.944,"end":20.952,"text":"N ri Ọ nitosi wọn.","marked":"Ń rí Ọ nítòsí wọn."}],"end":20.952},{"key":"4","start":21.902,"lines":[{"start":21.902,"end":23.212,"text":"Awa fẹ ọrọ Rẹ","marked":"Àwa fẹ́ ọ̀rọ̀ Rẹ"},{"start":23.662,"end":24.6,"text":"Ọrọ Alafia;","marked":"Ọ̀rọ̀ Àlàáfíà"},{"start":25.05,"end":26.454,"text":"Titunu at'iye;","marked":"Tìtùnú àt'iye"},{"start":26.904,"end":28.084,"text":"Ọrọ ayọ titi.","marked":"Ọ̀rọ̀ ayọ̀ títí."}],"end":28.084},{"key":"5","start":29.034,"lines":[{"start":29.034,"end":30.084,"text":"A fẹ kọrin anu,","marked":"A fẹ́ kọrin àánú"},{"start":30.534,"end":31.698,"text":"T'a n ri gba l'ayé yi,","marked":"T'á ń rí gbà l'ayé yí"},{"start":32.148,"end":33.298,"text":"Sugbọn awa fẹ mọ,","marked":"Sùgbọ́n àwa fẹ́ mọ́"},{"start":33.748,"end":35.008,"text":"Orin ayọ t'ọrun.","marked":"Orin ayọ̀ t'ọ̀run."}],"end":35.008},{"key":"6","start":35.958,"lines":[{"start":35.958,"end":37.599,"text":"Jesu, Oluwa wa","marked":"Jésù, Olúwa wa"},{"start":38.049,"end":39.152,"text":"Busi fe wa nihin","marked":"Bùsi fẹ́ wà níhìn"},{"start":39.602,"end":40.982,"text":"Mu wa de 'nu ogo","marked":"Mú wa dé nù ògo"},{"start":41.432,"end":42.952,"text":"Lati yin O titi.","marked":"Láti yìn Ọ́ títí."}],"end":42.952}]}