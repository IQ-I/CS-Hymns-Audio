{"v":3,"coll":"y","num":516,"id":"hymn_516","title":"OLUGBALA mi, ife Re","duration":41.239,"voices":{"male":{"file":"y-516-male-v3.m4a","bytes":285000,"sha256":"565eb8762b3185dbb973a04ad8e9d5f5fffc37adf68904ed3c1332f4b76e43e0","duration":41.3},"female":{"file":"y-516-female-v3.m4a","bytes":294052,"sha256":"91d680e5680dfa7861908963956d949cd23ac62baf9220fe54f22e88db8bc990","duration":41.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.282,"text":"OLUGBALA mi, ifẹ Rẹ,","marked":"Olùgbàlà mi, ìfẹ́ Rẹ"},{"start":2.732,"end":3.868,"text":"Ha tobi bẹ si mi?","marked":"Ha tóbi bẹ̀ sí mi?"},{"start":4.318,"end":6.228,"text":"Wo, mo f'ile mi, ọkan mi,","marked":"Wò, mo f'ilé mi, ọkàn mi"},{"start":6.678,"end":7.72,"text":"At'aya mi fun Ọ.","marked":"Àt'àyà mi fún Ọ."}],"end":7.72},{"key":"2","start":8.67,"lines":[{"start":8.67,"end":10.203,"text":"Mo fe O nitori 'toye","marked":"Mo fẹ́ Ọ nítorí tòye"},{"start":10.653,"end":11.571,"text":"Ti mo ri ninu Re","marked":"Tí mo rí nínú Rẹ̀"},{"start":12.021,"end":13.54,"text":"Mo fe O nitori iya","marked":"Mo fẹ́ Ọ nítorí ìyá"},{"start":13.99,"end":15.346,"text":"T'o f'ara da fun mi.","marked":"T'ó f'ara dá fún mi."}],"end":15.346},{"key":"3","start":16.296,"lines":[{"start":16.296,"end":17.533,"text":"Bi Iwọ ti jẹ Ọlọrun,","marked":"Bí Ìwọ ti jẹ́ Ọlọ́run"},{"start":17.983,"end":19.333,"text":"T'a f'ogo de l'ade,","marked":"T'á f'ògo dé l'adé"},{"start":19.783,"end":21.07,"text":"Iwọ ko kọ awọ eniyan,","marked":"Ìwọ kò kọ àwọ̀ ènìyàn"},{"start":21.52,"end":22.8,"text":"T'o kun fun iyọnu.","marked":"T'ó kún fún ìyọnu."}],"end":22.8},{"key":"4","start":23.75,"lines":[{"start":23.75,"end":25.451,"text":"'Wọ jẹ k'a bi Ọ l'eniyan,","marked":"'Wọ jẹ́ k'á bí Ọ l'ènìyàn"},{"start":25.901,"end":27.321,"text":"Sugbọn 'Wọ ko l'ẹsẹ;","marked":"Sùgbọ́n 'Wọ kò l'ẹsẹ̀"},{"start":27.771,"end":29.276,"text":"K'awa le ri b'Iwọ ti ri,","marked":"K'àwa lè rí b'Ìwọ ti rí"},{"start":29.726,"end":31.205,"text":"K'a le se b'O ti se.","marked":"K'á lè ṣe b'Ó ti ṣe."}],"end":31.205},{"key":"5","start":32.155,"lines":[{"start":32.155,"end":33.962,"text":"K'a dabi Rẹ ninu ifẹ,","marked":"K'á dàbí Rẹ nínú ìfẹ́"},{"start":34.412,"end":35.413,"text":"L'ẹwa iwa mimọ,","marked":"L'ẹwà ìwà mímọ́"},{"start":35.863,"end":37.79,"text":"B'a ti ń woju Rẹ, k'a ma lọ,","marked":"B'á ti ń wojú Rẹ̀, k'á má lọ"},{"start":38.24,"end":39.69,"text":"Lat'ogo de ogo.","marked":"Lát'ògo dé ògo."}],"end":39.69}]}