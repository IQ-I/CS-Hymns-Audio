{"v":3,"coll":"y","num":568,"id":"hymn_568","title":"EMI 'ba le f'iwa pele","duration":47.983,"voices":{"male":{"file":"y-568-male-v3.m4a","bytes":333461,"sha256":"5caa46c9fcb38a3394c4564ef464baa3a0e120c0d451d0156a0b54086b60535b","duration":48.0},"female":{"file":"y-568-female-v3.m4a","bytes":349417,"sha256":"e8f3da7f89cddc1effc01111683a2ed8bc8171b02135e4d4fce86aa29e894809","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.664,"text":"EMI 'ba le f'iwa pẹlẹ,","marked":"Èmi bá lè f'ìwà pẹ̀lẹ́"},{"start":2.114,"end":3.11,"text":"Ba Ọlọrun mi rin;","marked":"Bá Ọlọ́run mi rìn"},{"start":3.56,"end":5.244,"text":"Ki n ni imọlẹ ti n tọ mi,","marked":"Kí n ni ìmọ́lẹ̀ tí ń tọ̀ mi"},{"start":5.694,"end":6.899,"text":"Sọdọ Ọdaguntan!","marked":"Sọ́dọ̀ Ọ̀dàgùntàn!"}],"end":6.899},{"key":"2","start":7.849,"lines":[{"start":7.849,"end":9.606,"text":"Ibukun ti mo ni ha da","marked":"Ìbùkún tí mo ní ha dá"},{"start":10.056,"end":11.472,"text":"Gba mo ko mo Jesu?","marked":"Gbà mo kò mọ Jésù?"},{"start":11.922,"end":13.343,"text":"Itura okan na ha da","marked":"Ìtura ọkàn ná ha dá"},{"start":13.793,"end":15.163,"text":"T'oro Kristi fun mi?","marked":"T'ọ̀rọ̀ Kristi fún mi?"}],"end":15.163},{"key":"3","start":16.113,"lines":[{"start":16.113,"end":17.383,"text":"Alafia mi nigba naa,","marked":"Àlàáfíà mi nígbà náà"},{"start":17.833,"end":18.95,"text":"'Ranti rẹ ti dun to!","marked":"rántí rẹ ti dùn tó!"},{"start":19.4,"end":20.889,"text":"Sugbọn wọn ti b'afo silẹ,","marked":"Sùgbọ́n wọ́n ti b'àfọ̀ sílẹ̀"},{"start":21.339,"end":22.715,"text":"Ti ayé ko le di.","marked":"Tí ayé kò lè di."}],"end":22.715},{"key":"4","start":23.665,"lines":[{"start":23.665,"end":25.975,"text":"Pada, Emi Mimo, pada","marked":"Padà, Ẹ̀mí Mímọ́, padà"},{"start":26.425,"end":27.451,"text":"Ojise itunu","marked":"Òjíṣẹ́ ìtùnú"},{"start":27.901,"end":29.691,"text":"Mo ko ese t'o bi O n'nu","marked":"Mo kó ẹsẹ̀ t'ó bí Ó n'nù"},{"start":30.141,"end":31.403,"text":"T'o le O lokan mi.","marked":"T'ó lé Ọ lọ́kàn mi."}],"end":31.403},{"key":"5","start":32.353,"lines":[{"start":32.353,"end":33.829,"text":"Oosa ti mo fẹ rekọja,","marked":"Òósà tí mo fẹ́ rékọjá"},{"start":34.279,"end":35.452,"text":"Ohun t'o wu k'o jẹ,","marked":"Ohun t'ó wù k'ó jẹ́"},{"start":35.902,"end":37.326,"text":"Ba mi yọ kuro lọkan mi;","marked":"Bá mi yọ̀ kúrò lọ́kàn mi"},{"start":37.776,"end":39.223,"text":"Ki n le sin 'Wọ nikan.","marked":"Kí n lè sin 'Wọ nìkan."}],"end":39.223},{"key":"6","start":40.173,"lines":[{"start":40.173,"end":41.483,"text":"Bayi ni n ó b'Ọlọrun rin,","marked":"Báyì ni n ó b'Ọlọ́run rìn"},{"start":41.933,"end":42.916,"text":"Ara o rọ mi wọ!","marked":"Ara ò rọ̀ mí wọ!"},{"start":43.366,"end":44.722,"text":"'Mọlẹ ọrun y'o ma tọ mi,","marked":"'Mọlẹ ọ̀run y'ó má tọ̀ mi"},{"start":45.172,"end":46.434,"text":"Sọdọ Ọdaguntan.","marked":"Sọ́dọ̀ Ọ̀dàgùntàn."}],"end":46.434}]}