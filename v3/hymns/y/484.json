{"v":3,"coll":"y","num":484,"id":"hymn_484","title":"OLUWA da agan l'ohun","duration":57.912,"voices":{"male":{"file":"y-484-male-v3.m4a","bytes":384399,"sha256":"1059ae5eb8a95b95022cbc18c8397b094de9437428b1ea91d4a2b32e7984195f","duration":58.0},"female":{"file":"y-484-female-v3.m4a","bytes":396734,"sha256":"670b4d911d4deed84adfbd6aa96f1d851d0f285ad2430c0fb2fb75b31dd000f5","duration":58.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.567,"text":"OLUWA da agan l'ohun,","marked":"Olúwa dá àgàn l'ohun"},{"start":2.017,"end":3.648,"text":"B'o ti da Hannah l'ohun;","marked":"B'ó ti dá Hannah l'ohun"},{"start":4.098,"end":5.658,"text":"Ma doju 'gbagbọ ti awọn","marked":"Má dojú 'gbagbọ tí àwọn"},{"start":6.108,"end":7.518,"text":"Ti n ke pe orukọ Rẹ.","marked":"Tí ń ké pe orúkọ Rẹ."}],"end":7.518},{"key":"CHORUS","start":8.468,"lines":[{"start":8.468,"end":9.411,"text":"Da mi l'ohun (2)","marked":"Dá mi l'ohun"},{"start":9.861,"end":11.34,"text":"Ki n le ye ma banuje.","marked":"Kí n lè yẹ má banújẹ́."}],"end":11.34},{"key":"2","start":12.29,"lines":[{"start":12.29,"end":13.662,"text":"'Wọ gb' ẹkun Elisabet'","marked":"'Wọ gb ẹkún Elisabet"},{"start":14.112,"end":15.21,"text":"Larin awọn ẹlẹgan,","marked":"Lárin àwọn ẹlẹ́gàn"},{"start":15.66,"end":17.281,"text":"O fi Johannu re l'ẹkun,","marked":"Ó fi Johannu rẹ̀ l'ẹkún"},{"start":17.731,"end":19.099,"text":"P'ọmọ Rẹ ma sọkun mọ.","marked":"P'ọmọ Rẹ̀ má sọkún mọ́."}],"end":19.099},{"key":"CHORUS-2","start":20.049,"lines":[{"start":20.049,"end":20.905,"text":"Rẹ mi l'ẹkun (2)","marked":"Rẹ̀ mí l'ẹkún"},{"start":21.355,"end":22.707,"text":"Loju awọn ota mi.","marked":"Lójú àwọn ọ̀tá mi."}],"end":22.707},{"key":"3","start":23.657,"lines":[{"start":23.657,"end":25.006,"text":"Ranti ileri Rẹ 'gbani,","marked":"Rántí ìlérí Rẹ̀ gbani"},{"start":25.456,"end":26.779,"text":"At'ire t'O fun Noa,","marked":"Àt'ìrẹ t'Ó fún Noa"},{"start":27.229,"end":29.235,"text":"Pe k'ẹ ma bisi, k'ẹ ma rẹ,","marked":"Pé k'ẹ má bísí, k'ẹ má rẹ̀"},{"start":29.685,"end":30.927,"text":"Ni ori ilẹ ayé.","marked":"Ní orí ilẹ̀ ayé."}],"end":30.927},{"key":"CHORUS-3","start":31.877,"lines":[{"start":31.877,"end":32.777,"text":"Da mi l'ohun (2)","marked":"Dá mi l'ohun"},{"start":33.227,"end":34.199,"text":"Iwọ Ọba Olore.","marked":"Ìwọ Ọba Ọlọ́rẹ."}],"end":34.199},{"key":"4","start":35.149,"lines":[{"start":35.149,"end":36.552,"text":"'Wọ ti ko jẹ k'ẹran yagan,","marked":"'Wọ tí kò jẹ́ k'ẹran yàgàn"},{"start":37.002,"end":38.077,"text":"Tab' ẹyẹ oju ọrun,","marked":"Tàb ẹyẹ ojú ọ̀run"},{"start":38.527,"end":39.896,"text":"Sanu f'aworan ara Rẹ,","marked":"Ṣànù f'àwòrán ara Rẹ̀"},{"start":40.346,"end":41.597,"text":"Ki o si si mi ninu.","marked":"Kí ó sì ṣí mi nínú."}],"end":41.597},{"key":"CHORUS-4","start":42.547,"lines":[{"start":42.547,"end":43.367,"text":"Si mi ninu (2)","marked":"Sí mi nínú"},{"start":43.817,"end":44.856,"text":"Ọlọrun Onipin mi.","marked":"Ọlọ́run Onípín mi."}],"end":44.856},{"key":"5","start":45.806,"lines":[{"start":45.806,"end":47.223,"text":"Gbati mo ro okan mi wo","marked":"Gbátí mo rọ ọkàn mi wò"},{"start":47.673,"end":48.872,"text":"Mo mo p'elebi ni mi","marked":"Mo mọ̀ p'ẹlẹ́bi ni mí"},{"start":49.322,"end":50.746,"text":"Mo ti to pa fe inu mi","marked":"Mo ti tó pa fẹ́ inú mi"},{"start":51.196,"end":52.706,"text":"T'o ko wahala ba mi.","marked":"T'ó kó wàhálà bá mi."}],"end":52.706},{"key":"CHORUS-5","start":53.656,"lines":[{"start":53.656,"end":54.534,"text":"Dariji mi (2)","marked":"Dáríjì mi"},{"start":54.984,"end":56.363,"text":"'Wọ Oniyọnu julọ.","marked":"'Wọ Oníyọnu jùlọ."}],"end":56.363}]}