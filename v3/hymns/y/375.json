{"v":3,"coll":"y","num":375,"id":"hymn_375","title":"EMI mimo, 'daba orun","duration":32.425,"voices":{"male":{"file":"y-375-male-v3.m4a","bytes":218766,"sha256":"9d63e6cd2691acbe8369391e2dc5259012d518a69f8a82a41dfc6e0843fcecb0","duration":32.5},"female":{"file":"y-375-female-v3.m4a","bytes":230195,"sha256":"218e8e6861dd183ffc694f620cb8026b0220a3620aed7d37a51d697fe02015b2","duration":32.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.189,"text":"Ẹmi Mimọ, 'daba ọrun","marked":"Ẹ̀mí Mímọ́, dàbà ọ̀run"},{"start":2.639,"end":3.753,"text":"Wa ni agbara Rẹ;","marked":"Wà ní agbára Rẹ"},{"start":4.203,"end":5.719,"text":"K'o da ina ifẹ mimọ,","marked":"K'ó dá iná ìfẹ́ mímọ́"},{"start":6.169,"end":7.413,"text":"Ni ọkan tutu wa.","marked":"Ní ọkàn tútù wà."}],"end":7.413},{"key":"2","start":8.363,"lines":[{"start":8.363,"end":9.87,"text":"Wo b'a ti ń rapala nihin,","marked":"Wò b'á ti ń ràpalà níhìn"},{"start":10.32,"end":11.362,"text":"T'a fẹ ohun asan;","marked":"T'á fẹ́ ohun asán"},{"start":11.812,"end":13.475,"text":"Ọkan wa ko le fo k'o lọ,","marked":"Ọkàn wa kò lè fọ́ k'ó lọ"},{"start":13.925,"end":15.247,"text":"K'o de 'b'ayọ titi.","marked":"K'ò dé 'b'ayọ títí."}],"end":15.247},{"key":"3","start":16.197,"lines":[{"start":16.197,"end":18.383,"text":"Oluwa, a o ha wa titi,","marked":"Olúwa, a ó ha wà títí"},{"start":18.833,"end":20.126,"text":"Ni kiku osi yi?","marked":"Ní kíkú òsì yí?"},{"start":20.576,"end":22.054,"text":"Ifẹ wa tutu bẹ si Ọ,","marked":"Ìfẹ́ wa tútù bẹ̀ sí Ọ"},{"start":22.504,"end":23.699,"text":"Tirẹ tobi si wa.","marked":"Tirẹ̀ tóbi sí wà."}],"end":23.699},{"key":"4","start":24.649,"lines":[{"start":24.649,"end":25.9,"text":"Emi Mimo 'daba orun","marked":"Ẹ̀mí Mímọ́ dàbà ọ̀run"},{"start":26.35,"end":27.565,"text":"Wa ni agbara Re","marked":"Wà ní agbára Rẹ"},{"start":28.015,"end":29.285,"text":"Wa dana 'fe Olugbala","marked":"Wá dáná fẹ́ Olùgbàlà"},{"start":29.735,"end":30.876,"text":"Tiwa o si gbina.","marked":"Tiwa ó sì gbiná."}],"end":30.876}]}