{"v":3,"coll":"y","num":774,"id":"hymn_774","title":"E wa ka jo jumo korin","duration":62.936,"voices":{"male":{"file":"y-774-male-v3.m4a","bytes":446585,"sha256":"b9511650783d7490a65c7367b892e6c7ad5caeb8454b7ff76b9816985b915cba","duration":63.0},"female":{"file":"y-774-female-v3.m4a","bytes":462170,"sha256":"d348677ec016fcf4648c96cbd970453f8baa705cf77a50341df06817bbe0b593","duration":63.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.16,"text":"E wa k'a jo jumo korin","marked":"Ẹ wá k'á jọ jùmọ̀ kọrin"},{"start":2.61,"end":3.898,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":4.348,"end":6.049,"text":"Orun, aye mu yin won wa","marked":"Ọ̀run, ayé mú yín wọn wá"},{"start":6.499,"end":7.534,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":7.984,"end":9.191,"text":"Ki gbogbo okan ji kuro","marked":"Kí gbogbo ọkàn jí kúrò"},{"start":9.641,"end":11.299,"text":"Ninu ese ki won f'ayo","marked":"Nínú ẹ̀ṣẹ̀ kí wọ́n f'ayọ̀"},{"start":11.749,"end":13.189,"text":"Korin didun n'tori Jesu","marked":"Kọrin dídùn n'torí Jésù"},{"start":13.639,"end":14.835,"text":"lfe ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."}],"end":14.835},{"key":"2","start":15.785,"lines":[{"start":15.785,"end":17.259,"text":"E so ni gbogbo agbaye","marked":"Ẹ sọ ní gbogbo àgbáyé"},{"start":17.709,"end":18.907,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":19.357,"end":21.108,"text":"N'nu Krist' l'ekun 'rapada wa","marked":"N'nú Krist l'ẹkún ràpadà wá"},{"start":21.558,"end":22.714,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":23.164,"end":24.636,"text":"Eje Re le w'ese wa nu","marked":"Ẹ̀jẹ̀ Rẹ̀ lè w'ẹsẹ̀ wà nù"},{"start":25.086,"end":26.442,"text":"Emi Re s'oru wa d'osan","marked":"Ẹ̀mí Rẹ̀ s'òru wà d'ọ̀sán"},{"start":26.892,"end":28.893,"text":"O nto 'kan wa lati so pe","marked":"Ó ńtọ́ kan wá láti sọ pé"},{"start":29.343,"end":30.54,"text":"Ife ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."}],"end":30.54},{"key":"3","start":31.49,"lines":[{"start":31.49,"end":32.867,"text":"Ayo ni ipin wa nihin","marked":"Ayọ̀ ni ìpín wà níhìn"},{"start":33.317,"end":34.468,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":34.918,"end":36.285,"text":"Okan wa nyo si 'leri Re","marked":"Ọkàn wa ńyọ̀ sí lérí Rẹ̀"},{"start":36.735,"end":37.919,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":38.369,"end":39.759,"text":"Orun at' abo wa losan","marked":"Ọ̀run àt abo wà lọ́sàn"},{"start":40.209,"end":41.661,"text":"O si mba wa gbe ni oru","marked":"Ó sì mbà wá gbé ní òru"},{"start":42.111,"end":43.458,"text":"On yo wa pelu wa titi","marked":"Ọn yó wà pẹ̀lú wa títí"},{"start":43.908,"end":45.144,"text":"Ife ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."}],"end":45.144},{"key":"4","start":46.094,"lines":[{"start":46.094,"end":47.652,"text":"Ni Sion Iao tun korin yi","marked":"Ní Sion láó tún kọrin yí"},{"start":48.102,"end":49.301,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":49.751,"end":51.228,"text":"Orin t'o ga soke julo","marked":"Orin t'ó ga sókè jùlọ"},{"start":51.678,"end":52.929,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":53.379,"end":55.058,"text":"Titi aye aninipekun","marked":"Títí ayé aninipẹ̀kun"},{"start":55.508,"end":56.816,"text":"Pelu awon mimo loke","marked":"Pẹ̀lú àwọn mímọ́ lókè"},{"start":57.266,"end":58.662,"text":"Orin wa to dun julo ni","marked":"Orin wa tó dùn jùlọ ni"},{"start":59.112,"end":60.304,"text":"Ife ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."},{"start":60.754,"end":61.387,"text":"Amin.","marked":"Àmín."}],"end":61.387}]}