{"v":3,"coll":"y","num":282,"id":"hymn_282","title":"IFE l'Olorun, anu Re","duration":33.876,"voices":{"male":{"file":"y-282-male-v3.m4a","bytes":236277,"sha256":"fec41ddd4a8bb4533389b648f4f96afcc18d6f35e6fbf8fbb4e5264acbba57a8","duration":33.9},"female":{"file":"y-282-female-v3.m4a","bytes":242713,"sha256":"f3105da93f4c3e3dd3b4c27cc30e7eec81ad9d451fa747759380696598ec4a02","duration":33.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.973,"text":"IFE l'Olorun, anu Re","marked":"Ìfẹ́ l'Ọlọ́run, àánú Rẹ̀"},{"start":2.423,"end":3.458,"text":"Tan si ona wa gbogbo","marked":"Tàn sí ọ̀nà wa gbogbo"},{"start":3.908,"end":5.343,"text":"O fun wa ni alafia","marked":"Ó fún wa ní àlàáfíà"},{"start":5.793,"end":7.176,"text":"Ife ni Olorun wa.","marked":"Ìfẹ́ ni Ọlọ́run wa."}],"end":7.176},{"key":"2","start":8.126,"lines":[{"start":8.126,"end":9.967,"text":"p Iku n doro pupọpupọ,","marked":"p Ikú ń dọ́rọ̀ púpọ̀púpọ̀"},{"start":10.417,"end":11.992,"text":"di Eniyan si n dibajẹ,","marked":"di Ènìyàn sì ń díbàjẹ́"},{"start":12.442,"end":13.757,"text":"Sugbọn anu Rẹ wa titi,","marked":"Sùgbọ́n àánú Rẹ̀ wà títí"},{"start":14.207,"end":15.449,"text":"Ifẹ ni Ọlọrun wa","marked":"Ìfẹ́ ni Ọlọ́run wa"}],"end":15.449},{"key":"3","start":16.399,"lines":[{"start":16.399,"end":18.303,"text":"Lakoko t'o dab'o sokun,","marked":"Lákokò t'ó dàb'ọ́ sọkún"},{"start":18.753,"end":20.192,"text":"A ń ri Ore Rẹ daju,","marked":"À ń rí Ọrẹ Rẹ̀ dájú"},{"start":20.642,"end":22.052,"text":"O tan imọlẹ Rẹ fun wa,","marked":"Ó tan ìmọ́lẹ̀ Rẹ̀ fún wa"},{"start":22.502,"end":23.74,"text":"Ifẹ ni Ọlọrun wa.","marked":"Ìfẹ́ ni Ọlọ́run wa."}],"end":23.74},{"key":"4","start":24.69,"lines":[{"start":24.69,"end":26.66,"text":"O sọ 'reti, at'itunu,","marked":"Ó sọ retí, àt'ìtùnú"},{"start":27.11,"end":28.714,"text":"Mọ aniyan ayé wa,","marked":"Mọ àníyàn ayé wá"},{"start":29.164,"end":30.566,"text":"Ogo Rẹ ń tan nibi gbogbo,","marked":"Ògo Rẹ̀ ń tàn níbi gbogbo"},{"start":31.016,"end":32.326,"text":"Ifẹ ni Ọlọrun wa","marked":"Ìfẹ́ ni Ọlọ́run wa"}],"end":32.326}]}