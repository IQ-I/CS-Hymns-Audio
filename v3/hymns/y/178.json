{"v":3,"coll":"y","num":178,"id":"hymn_178","title":"IWO mbo wa, Oluwa","duration":68.506,"voices":{"male":{"file":"y-178-male-v3.m4a","bytes":482539,"sha256":"36be9f598efb2a884cd79a11523b269908f398e736a0903360d9a2e9ff57d9ac","duration":68.6},"female":{"file":"y-178-female-v3.m4a","bytes":496273,"sha256":"d1f2f83977bd4ff8dd425ce952a066d3e0fa5ef585ed6fc900c741cd5fd16885","duration":68.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.797,"text":"IWỌ mbo wa, Oluwa","marked":"Ìwọ mbọ̀ wá, Olúwa"},{"start":2.247,"end":3.868,"text":"Iwọ mbo wa, Oba mi","marked":"Ìwọ mbọ̀ wá, Ọba mi"},{"start":4.318,"end":5.462,"text":"Ninu 'tansan ewa Re","marked":"Nínú tànṣán ẹwà Rẹ"},{"start":5.912,"end":7.162,"text":"Ni titayo Ogo re","marked":"Ní títayọ Ògo rẹ"},{"start":7.612,"end":14.151,"text":"Mura de, mura de. Ọkọ 'yawo f'ẹrẹ de; L'oru ni igbe yoo ta, Mura l'ọ ko ọkan mi.","marked":"Múra dé, múra dé. Ọkọ yàwó f'ẹ̀rẹ̀ dé; L'òru ni igbe yóò ta, Múra l'ọ́ kọ ọkàn mi."}],"end":14.151},{"key":"CHORUS","start":15.101,"lines":[{"start":15.101,"end":16.368,"text":"Oko 'yawo f'ere de;","marked":"Ọkọ̀ yàwó f'èrè dé"},{"start":16.818,"end":18.457,"text":"L'oru ni igbe yio ta,","marked":"L'òru ni igbe yóò ta"},{"start":18.907,"end":20.417,"text":"Mura l'o ko okan mi.","marked":"Múra l'ó kọ ọkàn mi."}],"end":20.417},{"key":"2","start":21.367,"lines":[{"start":21.367,"end":23.014,"text":"Wundia to s'olotọ,","marked":"Wúńdíá tó s'olótọ̀"},{"start":23.464,"end":24.935,"text":"Ti mura nigba gbogbo;","marked":"Ti múra nígbà gbogbo"},{"start":25.385,"end":26.551,"text":"Igba ayọ sunmọle,","marked":"Ìgbà ayọ̀ súnmọ́lè"},{"start":27.001,"end":28.37,"text":"Igba awẹ y'o d'opin.","marked":"Ìgbà àwẹ̀ y'ó d'òpin."}],"end":28.37},{"key":"3","start":29.32,"lines":[{"start":29.32,"end":30.699,"text":"Iwọ mbọ wa nitotọ,","marked":"Ìwọ mbọ̀ wà nítòtọ́"},{"start":31.149,"end":32.357,"text":"A o pade Rẹ lọna;","marked":"A ó pàdé Rẹ̀ lọ́nà"},{"start":32.807,"end":34.9,"text":"A o ri Ọ, a o mọ Ọ,","marked":"A ò rí Ọ, a ò mọ̀ Ọ"},{"start":35.35,"end":36.677,"text":"Ni 'dapọ mimọ julọ.","marked":"Ní 'dapọ mímọ́ jùlọ."}],"end":36.677},{"key":"4","start":37.627,"lines":[{"start":37.627,"end":39.018,"text":"Wura ko ni le gba ọ,","marked":"Wúrà kò ní lè gbà ọ́"},{"start":39.468,"end":40.626,"text":"Ohun asan l'ọrọ jẹ;","marked":"Ohun asán l'ọ̀rọ̀ jẹ́"},{"start":41.076,"end":42.534,"text":"Igbagbọ ti ko mira,","marked":"Ìgbàgbọ́ tí kò mira"},{"start":42.984,"end":44.363,"text":"Ni y'o gb'ade nikẹhin.","marked":"Ní y'ó gb'adé níkẹ̀hìn."}],"end":44.363},{"key":"5","start":45.313,"lines":[{"start":45.313,"end":46.439,"text":"Wundia mẹwa l'a yan,","marked":"Wúńdíá mẹ́wà l'á yàn"},{"start":46.889,"end":48.017,"text":"Marun pere lo yege;","marked":"Márùn péré lọ yege"},{"start":48.467,"end":49.941,"text":"Marun ko ni ororo,","marked":"Márùn kò ní òróró"},{"start":50.391,"end":51.624,"text":"Ina ẹmi wọn ti ku.","marked":"Iná ẹ̀mí wọn ti kú."}],"end":51.624},{"key":"6","start":52.574,"lines":[{"start":52.574,"end":53.717,"text":"'Binu Rẹ tobi pupọ,","marked":"bínú Rẹ̀ tóbi púpọ̀"},{"start":54.167,"end":55.533,"text":"Si awọn t'o gbagbe Rẹ;","marked":"Sí àwọn t'ó gbàgbé Rẹ"},{"start":55.983,"end":57.098,"text":"Ewurẹ apa osi,","marked":"Ewúrẹ́ apá òsì"},{"start":57.548,"end":58.824,"text":"L'a o se wọn nikẹhin.","marked":"L'á ò ṣe wọ́n níkẹ̀hìn."}],"end":58.824},{"key":"7","start":59.774,"lines":[{"start":59.774,"end":61.302,"text":"Jọwọ se wa l'ayanfẹ,","marked":"Jọ̀wọ́ ṣe wá l'àyànfẹ́"},{"start":61.752,"end":62.965,"text":"Ki a le ba Ọ j'ọba;","marked":"Kí a lè bá Ọ j'ọba"},{"start":63.415,"end":65.031,"text":"Angeli l'a o ba kẹgbẹ,","marked":"Áńgẹ́lì l'a ó bá kẹ́gbẹ́"},{"start":65.481,"end":66.957,"text":"Ti a o gbe aiku wọ.","marked":"Tí a ó gbé àìkú wọ̀."}],"end":66.957}]}