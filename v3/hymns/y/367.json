{"v":3,"coll":"y","num":367,"id":"hymn_367","title":"WA k'a da m'awon ore wa","duration":48.809,"voices":{"male":{"file":"y-367-male-v3.m4a","bytes":335628,"sha256":"f4c458a623219820f50adba79477e60a731df4836e2f7d185159992fae0575dc","duration":48.9},"female":{"file":"y-367-female-v3.m4a","bytes":353551,"sha256":"c7f172046915a4d795e11b1b08fb45f02101b4c7bf73d01614dedf6ca73c328f","duration":48.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.767,"text":"WA k'a da m'awọn ọrẹ wa,","marked":"Wá k'á dá m'àwọn ọ̀rẹ́ wa"},{"start":2.217,"end":3.396,"text":"Ti wọn ti jere na;","marked":"Tí wọ́n ti jèrè ná"},{"start":3.846,"end":5.328,"text":"N'ifẹ k'a f'ọkan ba wọn lọ,","marked":"N'ìfẹ́ k'á f'ọkàn bá wọn lọ"},{"start":5.778,"end":6.802,"text":"S'ode ọrun lọhun.","marked":"S'òde ọ̀run lọ́hùn."}],"end":6.802},{"key":"2","start":7.752,"lines":[{"start":7.752,"end":9.251,"text":"K'awọn t'ayé dorin wọn mọ,","marked":"K'àwọn t'ayé dọ́rin wọn mọ́"},{"start":9.701,"end":11.005,"text":"T'awọn to lọ s'ogo;","marked":"T'àwọn tó lọ s'ògo"},{"start":11.455,"end":13.403,"text":"Awa l'ayé, awọn l'ọrun,","marked":"Àwa l'ayé, àwọn l'ọ̀run"},{"start":13.853,"end":14.948,"text":"Ọkan ni gbogbo wa.","marked":"Ọkàn ni gbogbo wa."}],"end":14.948},{"key":"3","start":15.898,"lines":[{"start":15.898,"end":17.567,"text":"Idile kan n'nu Krist' ni wa,","marked":"Ìdílé kan n'nú Krist ni wá"},{"start":18.017,"end":19.322,"text":"Ajọ kan l'a si jẹ;","marked":"Àjọ kan l'a sì jẹ́"},{"start":19.772,"end":21.236,"text":"Isan omi kan lo ya wa,","marked":"Ìṣàn omi kan ló yà wá"},{"start":21.686,"end":22.647,"text":"Isan omi iku.","marked":"Ìṣàn omi ikú."}],"end":22.647},{"key":"4","start":23.597,"lines":[{"start":23.597,"end":25.089,"text":"Ẹgbẹ ogun kan t'Ọlọrun,","marked":"Ẹgbẹ́ ogun kan t'Ọlọ́run"},{"start":25.539,"end":27.043,"text":"Asẹ Rẹ l'a si n se;","marked":"Àsẹ Rẹ̀ l'a sì ń ṣe"},{"start":27.493,"end":28.998,"text":"Apakan ti w'ọdo na ja;","marked":"Apákan tí w'ọdò nà jà"},{"start":29.448,"end":30.544,"text":"Apakan n wọ lọwọ!","marked":"Apákan ń wọ̀ lọ́wọ́!"}],"end":30.544},{"key":"5","start":31.494,"lines":[{"start":31.494,"end":32.722,"text":"Emi wa fere dapo na","marked":"Èmi wá fèrè dàpọ̀ ná"},{"start":33.172,"end":34.367,"text":"Y'o gb'Ade bi tiwon","marked":"Y'ó gb'adé bí tiwọn"},{"start":34.817,"end":36.294,"text":"A o yo s'ami Balogun wa","marked":"A ò yọ̀ s'àmì Balógun wá"},{"start":36.744,"end":38.232,"text":"Lati gbo ipe Re.","marked":"Láti gbọ́ ìpè Rẹ."}],"end":38.232},{"key":"6","start":39.182,"lines":[{"start":39.182,"end":41.602,"text":"Jesu, sọ wa, s'amọna wa,","marked":"Jésù, sọ wá, s'amọ̀nà wa"},{"start":42.052,"end":43.385,"text":"Gba t'onikọ ba de;","marked":"Gba t'onikọ bá dé"},{"start":43.835,"end":45.442,"text":"Oluwa, pin omi meji,","marked":"Olúwa, pín omi méjì"},{"start":45.892,"end":47.26,"text":"Mu wa gunlẹ l'ayọ.","marked":"Mú wa gúnlẹ̀ l'ayọ̀."}],"end":47.26}]}