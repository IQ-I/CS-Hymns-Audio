{"v":3,"coll":"y","num":539,"id":"hymn_539","title":"ORE-OFE b'o ti dun to","duration":34.377,"voices":{"male":{"file":"y-539-male-v3.m4a","bytes":237764,"sha256":"499b0c0b87175d31906f15d583d107248e172d3c52a4c592ec8cae5fae2eb9e1","duration":34.4},"female":{"file":"y-539-female-v3.m4a","bytes":243983,"sha256":"929237fd7146c96c6ce01e7715ef2e4d5dcf2eacbee4c6cf8728c4a33bf8d9c6","duration":34.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.841,"text":"ORE-ỌFẸ b'o ti dun to!","marked":"Ore-Ọfẹ b'ó ti dùn tó!"},{"start":2.291,"end":3.931,"text":"T'o gba em' abosi;","marked":"T'ó gba em àbòṣì"},{"start":4.381,"end":6.446,"text":"Mo ti sọnu, o wa mi ri,","marked":"Mo ti sọnù, ó wá mi rí"},{"start":6.896,"end":8.205,"text":"O si si mi loju.","marked":"Ó sì ṣí mi lójú."}],"end":8.205},{"key":"2","start":9.155,"lines":[{"start":9.155,"end":10.588,"text":"Or'ofe ko mi ki 'm' beru","marked":"Ọ̀r'ọ̀fẹ́ kọ́ mi kí m bẹ̀rù"},{"start":11.038,"end":12.331,"text":"O si l'eru mi lo","marked":"Ó sì l'ẹ̀rù mi lọ"},{"start":12.781,"end":14.428,"text":"B'ore-ofe na ti han to","marked":"B'oore-ọ̀fẹ́ ná ti hàn tó"},{"start":14.878,"end":16.165,"text":"Nigba mo ko gbagbo!","marked":"Nígbà mo kò gbàgbọ́!"}],"end":16.165},{"key":"3","start":17.115,"lines":[{"start":17.115,"end":18.741,"text":"Ọpọ ewu at' idẹkun,","marked":"Ọ̀pọ̀ ẹ̀wù àt ìdẹ̀kùn"},{"start":19.191,"end":20.426,"text":"Ni mo ti la kọja;","marked":"Ni mo ti là kọjá"},{"start":20.876,"end":22.447,"text":"Or-ọfẹ n pa mi mọ d'oni,","marked":"Or-ọfẹ ń pa mí mọ́ d'óní"},{"start":22.897,"end":24.313,"text":"Y'o si sin mi de 'le","marked":"Y'ó sì sin mí dé lé"}],"end":24.313},{"key":"4","start":25.263,"lines":[{"start":25.263,"end":27.249,"text":"Njẹ gbat' ara at' ọkan yẹ,","marked":"Ǹjẹ́ gbàt ara àt ọkàn yẹ"},{"start":27.699,"end":28.959,"text":"Ti ẹmi ba si pin","marked":"Tí ẹ̀mí bá sì pín"},{"start":29.409,"end":31.401,"text":"N ó gb' ayọ at' alafia,","marked":"N ó gb ayọ̀ àt àlàáfíà"},{"start":31.851,"end":32.828,"text":"Loke ọrun lọhun.","marked":"Lókè ọ̀run lọ́hùn."}],"end":32.828}]}