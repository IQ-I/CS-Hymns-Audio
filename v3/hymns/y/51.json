{"v":3,"coll":"y","num":51,"id":"hymn_51","title":"JESU n fe gba elese","duration":43.586,"voices":{"male":{"file":"y-51-male-v3.m4a","bytes":302903,"sha256":"84e0f7b734855a0b77d379d9d1204c914165af1cda8df26fcc4068a74e8a29b7","duration":43.6},"female":{"file":"y-51-female-v3.m4a","bytes":315675,"sha256":"586b04d88b589f16495f7b8df901bd855722439faa4646d1a095c2ca25d9a079","duration":43.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.425,"text":"Jesu n fẹ gba","marked":"Jésù ń fẹ́ gbà"},{"start":1.875,"end":3.388,"text":"elese Kede re fun gbogbo","marked":"ẹlẹ́ṣẹ̀ Kéde rẹ̀ fún gbogbo"},{"start":3.838,"end":6.302,"text":"eda, T'o yapa ona run","marked":"ẹ̀dà, T'ó yapa ọ̀nà run"},{"start":6.752,"end":8.69,"text":"le, At'awọn ti n jafara. Kọ ọ l'orin, ko si tun kọ, Kristi n gba gbogbo ẹlẹsẹ, Jẹ ki'hin na daju pe Kristi n gba gbogbo ẹlẹsẹ.","marked":"lé, Àt'àwọn tí ń jáfara. Kọ́ ọ l'orin, kò sì tún kọ́, Kristi ń gba gbogbo ẹlẹ́sẹ̀, Jẹ́ kí'hìn ná dájú pé Kristi ń gba gbogbo ẹlẹ́sẹ̀."}],"end":8.69},{"key":"CHORUS","start":9.64,"lines":[{"start":9.64,"end":11.504,"text":"Ko o Iorin ko si tun ko","marked":"Kọ́ ọ lọ́rin kò sì tún kọ́"},{"start":11.954,"end":13.505,"text":"Kristi ngba gbogbo elese","marked":"Kristi ńgba gbogbo ẹlẹ́ṣẹ̀"},{"start":13.955,"end":15.324,"text":"Je ki 'hin na daju pe","marked":"Jẹ́ kí hín ná dájú pé"},{"start":15.774,"end":17.353,"text":"Kristi ngba gbogbo elese.","marked":"Kristi ńgba gbogbo ẹlẹ́ṣẹ̀."}],"end":17.353},{"key":"2","start":18.303,"lines":[{"start":18.303,"end":19.679,"text":"Wa y'o fun ọ ni 'sinmi","marked":"Wá y'ó fún ọ ní sinmi"},{"start":20.129,"end":21.806,"text":"Gba A gbọ, ọrọ rẹ ni;","marked":"Gbà A gbọ́, ọ̀rọ̀ rẹ̀ ni"},{"start":22.256,"end":24.014,"text":"Y'o gb'ẹlẹsẹ to buru","marked":"Y'ó gb'ẹlẹ́sẹ̀ tó burú"},{"start":24.464,"end":26.23,"text":"Kristi n gba gbogbo ẹlẹsẹ.","marked":"Kristi ń gba gbogbo ẹlẹ́sẹ̀."}],"end":26.23},{"key":"3","start":27.18,"lines":[{"start":27.18,"end":28.597,"text":"Ọkan mi ko lebi mọ,","marked":"Ọkàn mi kò lẹ́bi mọ́"},{"start":29.047,"end":30.521,"text":"Mo mọ niwaju ofin,","marked":"Mo mọ̀ níwájú òfin"},{"start":30.971,"end":32.151,"text":"Ẹni t'o ti wẹ mi mọ,","marked":"Ẹni t'ó ti wẹ̀ mí mọ́"},{"start":32.601,"end":34.027,"text":"Ti san gbogbo gbese mi.","marked":"Ti san gbogbo gbèsè mi."}],"end":34.027},{"key":"4","start":34.977,"lines":[{"start":34.977,"end":36.492,"text":"Kristi gba gbogb' ẹlẹsẹ,","marked":"Kristi gba gbogb ẹlẹ́sẹ̀"},{"start":36.942,"end":38.403,"text":"An' emi to d'ẹsẹ ju,","marked":"Àn èmi tó d'ẹ̀sẹ̀ jù"},{"start":38.853,"end":40.176,"text":"T'a wẹ mọ patapata,","marked":"T'á wẹ̀ mọ́ pátápátá"},{"start":40.626,"end":42.037,"text":"Y'o ba wọ 'jọba ọrun.","marked":"Y'ó bá wọ 'jọba ọ̀run."}],"end":42.037}]}