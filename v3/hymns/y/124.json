{"v":3,"coll":"y","num":124,"id":"hymn_124","title":"NIWAJU ite Jehoval","duration":38.487,"voices":{"male":{"file":"y-124-male-v3.m4a","bytes":273629,"sha256":"6b7d02e098cc9558a6723f359e43171c91ed8fb0325363ffccb099ca435b5f18","duration":38.5},"female":{"file":"y-124-female-v3.m4a","bytes":281831,"sha256":"90395fb4fbc800120071d210cb5fcf66a9d2e9e43432d85da605ca5a435a6559","duration":38.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.02,"text":"NIWAJU itẹ Jehovah,","marked":"Níwájú ìtẹ́ Jehovah"},{"start":2.47,"end":4.455,"text":"Ẹ f'ayọ sin, oril'ede;","marked":"Ẹ f'ayọ̀ sin, oríl'èdè"},{"start":4.905,"end":7.021,"text":"Mọ p'Oluwa, oun kanso ni,","marked":"Mọ́ p'Olúwa, òun kànṣọ́ ni"},{"start":7.471,"end":9.558,"text":"O le da, O si le parun.","marked":"Ó lè dá, Ó sì lè parun."}],"end":9.558},{"key":"2","start":10.508,"lines":[{"start":10.508,"end":12.952,"text":"Ipa Rẹ, laisi 'ranwọ wa,","marked":"Ipa Rẹ̀, láìsí 'ranwọ wa"},{"start":13.402,"end":14.869,"text":"L'o f'amọ da wa l'eniyan;","marked":"L'ó f'amọ̀ dá wá l'ènìyàn"},{"start":15.319,"end":17.16,"text":"Nigba t'a sako b'aguntan,","marked":"Nígbà t'á ṣáko b'àgùntàn"},{"start":17.61,"end":19.092,"text":"O tun mu wa si agbo Rẹ.","marked":"Ó tún mú wa sí agbo Rẹ̀."}],"end":19.092},{"key":"3","start":20.042,"lines":[{"start":20.042,"end":21.548,"text":"A o f'orin sunmọ 'le Rẹ,","marked":"A ó f'orin súnmọ́ lé Rẹ̀"},{"start":21.998,"end":23.643,"text":"Lohun giga l'a o kọrin;","marked":"Lóhùn gíga l'a ó kọrin"},{"start":24.093,"end":25.382,"text":"Ayé l'oniruru ede,","marked":"Ayé l'onírúrú èdè"},{"start":25.832,"end":27.53,"text":"Y'o f'iyin kun agbala Rẹ.","marked":"Y'ó f'ìyìn kún àgbàlá Rẹ̀."}],"end":27.53},{"key":"4","start":28.48,"lines":[{"start":28.48,"end":30.144,"text":"Asẹ Rẹ gbooro b'agbayé,","marked":"Àsẹ Rẹ̀ gbòòrò b'agbayé"},{"start":30.594,"end":32.307,"text":"Ifẹ Rẹ pe b'ayerayé;","marked":"Ìfẹ́ Rẹ̀ pé b'ayerayé"},{"start":32.757,"end":34.744,"text":"Ootọ Rẹ yoo duro lailai,","marked":"Òótọ́ Rẹ yóò dúró láéláé"},{"start":35.194,"end":36.938,"text":"Gba t'ọdun ki yoo yipo mọ.","marked":"Gba t'ọdún kì yóò yípo mọ́."}],"end":36.938}]}