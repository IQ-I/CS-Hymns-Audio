{"v":3,"coll":"y","num":338,"id":"hymn_338","title":"'BUGBE Re ti l'ewa to!","duration":62.46,"voices":{"male":{"file":"y-338-male-v3.m4a","bytes":440472,"sha256":"d0ed3a8513d92125fc507a3a64b8fd31bde4fa3594a14da07702e168a079c601","duration":62.5},"female":{"file":"y-338-female-v3.m4a","bytes":457116,"sha256":"555043eb81f918d5a820172efbc1967e038971e42301ce6d9e5057aec6cd9aa6","duration":62.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.846,"text":"'BUGBE Re ti l'ewa to!","marked":"bùgbé Rẹ ti l'ẹwà tó!"},{"start":2.296,"end":3.978,"text":"Ni le 'mole at'ife","marked":"Ní lè mọ́lẹ̀ àt'ìfẹ́"},{"start":4.428,"end":5.893,"text":"'Bugbe Re ti l'ewa to!","marked":"bùgbé Rẹ ti l'ẹwà tó!"},{"start":6.343,"end":7.864,"text":"Laiye ese at'osi","marked":"Láìyẹ ẹ̀ṣẹ̀ àt'òṣì"},{"start":8.314,"end":9.756,"text":"Okan mi nfa nitoto","marked":"Ọkàn mi ńfà nítòtọ́"},{"start":10.206,"end":11.327,"text":"Fun idapo enia re","marked":"Fún ìdàpọ̀ ènìà rẹ"},{"start":11.777,"end":13.088,"text":"Fun imole oju Re","marked":"Fún ìmọ́lẹ̀ ojú Rẹ"},{"start":13.538,"end":14.896,"text":"Fun ekun Re, Olorun.","marked":"Fún ẹkún Rẹ, Ọlọ́run."}],"end":14.896},{"key":"2","start":15.846,"lines":[{"start":15.846,"end":16.966,"text":"Ayo ba awon eiye","marked":"Ayọ̀ bá àwọn èìyè"},{"start":17.416,"end":18.774,"text":"Ti nfo yi pepe Re ka","marked":"Ti ńfọ̀ yí pẹpẹ Rẹ ká"},{"start":19.224,"end":20.742,"text":"Ayo okan l'o simi","marked":"Ayọ̀ ọkàn l'ó ṣímí"},{"start":21.192,"end":22.487,"text":"L'aiya Baba l'o poju","marked":"L'àìyá Baba l'ó pọ̀jù"},{"start":22.937,"end":23.972,"text":"Gege b'adaba Noa","marked":"Gẹ́gẹ́ b'àdàbà Noa"},{"start":24.422,"end":25.695,"text":"Ti ko r'ibi simi le","marked":"Tí kò r'ibi sími le"},{"start":26.145,"end":27.459,"text":"Nwon pada sodo Baba","marked":"Wọ́n padà sọ́dọ̀ Baba"},{"start":27.909,"end":29.473,"text":"Nwon si nyo tili aiye.","marked":"Wọ́n sì ńyọ̀ tili ayé."}],"end":29.473},{"key":"3","start":30.423,"lines":[{"start":30.423,"end":31.964,"text":"Nwon ko simi iyin won","marked":"Wọ́n kò ṣímì ìyìn wọn"},{"start":32.414,"end":33.83,"text":"Ninu aiye osi yi","marked":"Nínú ayé òsì yí"},{"start":34.28,"end":35.913,"text":"Omi nsun ni aginju","marked":"Omi ńsùn ní aginjù"},{"start":36.363,"end":37.624,"text":"Manna nt'orun wa fun won","marked":"Manna ńt'ọ̀run wà fún wọn"},{"start":38.074,"end":39.798,"text":"Nwon nlo Iat' ipa de 'pa","marked":"Wọ́n ńlọ lát ipa dé pa"},{"start":40.248,"end":41.71,"text":"Titi nwon fi yo si O","marked":"Títí wọ́n fi yọ sí Ọ"},{"start":42.16,"end":43.852,"text":"Nwo si wole l'ese Re","marked":"Ǹwo sì wọlé l'ẹsẹ̀ Rẹ"},{"start":44.302,"end":45.787,"text":"T'O mu won la ewu ja.","marked":"T'Ó mú wọn la ewu jà."}],"end":45.787},{"key":"4","start":46.737,"lines":[{"start":46.737,"end":48.317,"text":"Baba, je ki njere be","marked":"Baba, jẹ́ kí ǹjèrè bẹ̀"},{"start":48.767,"end":50.037,"text":"S'amona mi l'aiye yi","marked":"S'amọ̀nà mi l'ayé yí"},{"start":50.487,"end":51.578,"text":"Fore ofe pa mi mo","marked":"Fọrẹ ọ̀fẹ́ pa mí mọ́"},{"start":52.028,"end":53.207,"text":"Fun mi l'aye lodo Re","marked":"Fún mi l'ayé lọ́dọ̀ Rẹ"},{"start":53.657,"end":55.057,"text":"lwo l'orun at'Asa","marked":"Ìwọ l'ọ̀run àt'asa"},{"start":55.507,"end":56.534,"text":"To okan isina mi","marked":"Tọ ọkàn ìṣìnà mi"},{"start":56.984,"end":58.094,"text":"lwo l'orisun ore","marked":"Ìwọ l'orísun ọrẹ"},{"start":58.544,"end":59.79,"text":"Ro ojo re sori mi.","marked":"Rọ ọjọ́ rẹ sórí mi."},{"start":60.24,"end":60.911,"text":"Amin.","marked":"Àmín."}],"end":60.911}]}