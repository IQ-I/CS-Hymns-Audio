{"v":3,"coll":"y","num":573,"id":"hymn_573","title":"HA! egbe mi, e w'asia","duration":70.065,"voices":{"male":{"file":"y-573-male-v3.m4a","bytes":510015,"sha256":"a351e208a3a72edcaae018e47ca802f5939485af1ccbd1f69b6068603fa64b30","duration":70.1},"female":{"file":"y-573-female-v3.m4a","bytes":520313,"sha256":"b78108488cd302c0108b74ff518f60127853e13199c5aba227833256bfb3fcf0","duration":70.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.05,"text":"HA! ẹgbẹ mi, ẹ w'asia,","marked":"Ha! ẹ̀gbẹ́ mi, ẹ w'asia"},{"start":3.5,"end":4.692,"text":"Bi ti n fẹ lẹlẹ!","marked":"Bí ti ń fẹ́ lẹ́lẹ̀!"},{"start":5.142,"end":6.706,"text":"Ogun Jesu fẹrẹ de na,","marked":"Ogun Jésù fẹ́rẹ̀ dé ná"},{"start":7.156,"end":8.115,"text":"A fẹrẹ sẹgun!","marked":"A fẹ́rẹ̀ sẹ́gun!"},{"start":8.565,"end":10.525,"text":"D'odi mu, emi fẹrẹ de,‖","marked":"D'òdì mú, èmi fẹ́rẹ̀ dé,‖"},{"start":10.975,"end":12.2,"text":"Bẹni Jesu n wi,","marked":"Bẹni Jésù ń wí"},{"start":12.65,"end":14.09,"text":"Ran 'dahun pada s'ọrun pe","marked":"Rán dáhùn padà s'ọ̀run pé"},{"start":14.54,"end":15.58,"text":"Awa o dimu.","marked":"Àwa ó dímú."}],"end":15.58},{"key":"CHORUS","start":16.53,"lines":[{"start":16.53,"end":18.312,"text":"D'odi mu, emi fere de","marked":"D'òdì mú, èmi fèrè dé"},{"start":18.762,"end":19.995,"text":"Beni Jesu nwi","marked":"Bẹni Jésù ńwí"},{"start":20.445,"end":21.875,"text":"Ran dahun pada s'orun pe","marked":"Rán dáhùn padà s'ọ̀run pé"},{"start":22.325,"end":23.278,"text":"Awa o dimu.","marked":"Àwa ó dímú."}],"end":23.278},{"key":"2","start":24.228,"lines":[{"start":24.228,"end":26.155,"text":"Wo opo ogun ti mbo wa,","marked":"Wo ọ̀pọ̀ ogun tí mbọ̀ wá"},{"start":26.605,"end":27.568,"text":"Esu n ko won","marked":"Èṣù ń kọ́ wọn"},{"start":28.018,"end":29.286,"text":"bo Awon alagbara","marked":"bọ́ Àwọn alágbára"},{"start":29.736,"end":31.31,"text":"n subu, A fe","marked":"ń ṣubú, A fẹ́"},{"start":31.76,"end":38.929,"text":"damu tan! D'odi mu... emi fẹrẹ de,‖ Bẹni Jesu n wi, Ran 'dahun pada s'ọrun pe Awa o dimu.","marked":"dàmú tán! D'òdì mú èmi fẹ́rẹ̀ dé,‖ Bẹni Jésù ń wí, Rán dáhùn padà s'ọ̀run pé Àwa ó dìmú."}],"end":38.929},{"key":"3","start":39.879,"lines":[{"start":39.879,"end":41.53,"text":"Wo asia Jesu ti n","marked":"Wo àsíá Jésù tí ń"},{"start":41.98,"end":43.075,"text":"fẹ; Gbo ohun","marked":"fẹ́; Gbọ́ ohùn"},{"start":43.525,"end":44.982,"text":"ipe A o segun gbogbo","marked":"ìpè A ó ṣẹ́gun gbogbo"},{"start":45.432,"end":46.47,"text":"ota Ni oruko","marked":"ọ̀tá Ní orúkọ"},{"start":46.92,"end":53.972,"text":"Re. D'odi mu... emi fẹrẹ de,‖ Bẹni Jesu n wi, Ran 'dahun pada s'ọrun pe Awa o dimu.","marked":"Rẹ̀. D'odi mú èmi fẹ́rẹ̀ dé,‖ Bẹni Jésù ń wí, Rán dáhùn padà s'ọ̀run pé Àwa ó dímú."}],"end":53.972},{"key":"4","start":54.922,"lines":[{"start":54.922,"end":56.246,"text":"Ogun n gbo'na girigiri,","marked":"Ogun ń gbó'ná girigiri"},{"start":56.696,"end":57.606,"text":"Iranwọ wa mbọ;","marked":"Ìrànwọ́ wà mbọ́"},{"start":58.056,"end":59.68,"text":"Balogun wa mbọ wa tete,","marked":"Balógun wá mbọ̀ wá tètè"},{"start":60.13,"end":61.216,"text":"Ẹgbẹ tujuka!","marked":"Ẹgbẹ́ tújúká!"},{"start":61.666,"end":63.547,"text":"D'odi mu, emi fẹrẹ de,‖","marked":"D'òdì mú, èmi fẹ́rẹ̀ dé,‖"},{"start":63.997,"end":65.221,"text":"Bẹni Jesu n wi,","marked":"Bẹni Jésù ń wí"},{"start":65.671,"end":67.04,"text":"Ran 'dahun pada s'ọrun pe","marked":"Rán dáhùn padà s'ọ̀run pé"},{"start":67.49,"end":68.516,"text":"Awa o dimu.","marked":"Àwa ó dímú."}],"end":68.516}]}