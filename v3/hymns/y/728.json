{"v":3,"coll":"y","num":728,"id":"hymn_728","title":"AJE nse lasan ni Kerubu","duration":49.271,"voices":{"male":{"file":"y-728-male-v3.m4a","bytes":316481,"sha256":"4c7aa7d184fb78cb5e6e7971058f1e885447d992ceae7971dd24072df72beac0","duration":49.3},"female":{"file":"y-728-female-v3.m4a","bytes":329327,"sha256":"bfde9a2a65dbc5d79ecde8b54eb6490fc7e41f632c5762c9480a82b3a29d6bc8","duration":49.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.778,"text":"AJE nse lasan ni Kerubu","marked":"Àjẹ́ ńṣe lásán ní Kérúbù"},{"start":2.228,"end":3.141,"text":"a pa won run","marked":"a pa wọ́n run"}],"end":3.141},{"key":"CHORUS","start":4.091,"lines":[{"start":4.091,"end":5.002,"text":"Oba awon oba","marked":"Ọba àwọn ọba"},{"start":5.452,"end":6.489,"text":"Olorun aiyeraiye,","marked":"Ọlọ́run ayérayé"},{"start":6.939,"end":7.687,"text":"Oba ogo.","marked":"Ọba ògo."}],"end":7.687},{"key":"2","start":8.637,"lines":[{"start":8.637,"end":10.174,"text":"Sonponna nse lasan ni","marked":"Ṣòǹpọ́nná ńṣe lásán ni"},{"start":10.624,"end":12.658,"text":"lmaikeli a sori fun etc.","marked":"Imaikeli a sórí fún etc."}],"end":12.658},{"key":"3","start":13.608,"lines":[{"start":13.608,"end":15.174,"text":"Babalawo nse lasan ni","marked":"Babalawo ńṣe lásán ni"},{"start":15.624,"end":17.39,"text":"Iserafu a pa won run.","marked":"Iṣerafu a pa wọ́n run."}],"end":17.39},{"key":"4","start":18.34,"lines":[{"start":18.34,"end":19.709,"text":"lgunnu nse lasan ni","marked":"Ìgùnnú ńṣe lásán ni"},{"start":20.159,"end":21.618,"text":"Kerubu a pa won run.","marked":"Kérúbù a pa wọ́n run."}],"end":21.618},{"key":"5","start":22.568,"lines":[{"start":22.568,"end":24.001,"text":"Egungun nse lasan ni","marked":"Egungun ńṣe lásán ni"},{"start":24.451,"end":26.13,"text":"Ikerubu a pa won run.","marked":"Ìkérúbù a pa wọ́n run."}],"end":26.13},{"key":"6","start":27.08,"lines":[{"start":27.08,"end":29.621,"text":"Enyin asaju wa, e foriti ka","marked":"Ẹ̀yin aṣájú wá, ẹ forítì ká"},{"start":30.071,"end":31.02,"text":"le gbade.","marked":"lè gbàdé."}],"end":31.02},{"key":"7","start":31.97,"lines":[{"start":31.97,"end":34.036,"text":"Baba Aladura ko le ko wa","marked":"Baba Aládúrà kò lè kọ́ wa"},{"start":34.486,"end":35.51,"text":"de le kenaan.","marked":"dé lè kẹ́nàán."}],"end":35.51},{"key":"8","start":36.46,"lines":[{"start":36.46,"end":37.746,"text":"Olorun Metalokan on Ii","marked":"Ọlọ́run Mẹ́talọ́kan ọn Ìí"},{"start":38.196,"end":39.326,"text":"Olorun lserafu.","marked":"Ọlọ́run Iserafu."}],"end":39.326},{"key":"9","start":40.276,"lines":[{"start":40.276,"end":41.734,"text":"Nigbati a ba d'orun","marked":"Nígbàtí a bá d'ọ̀run"},{"start":42.184,"end":43.571,"text":"A o korin Halleluyah.","marked":"A ó kọrin Hallelúyà."}],"end":43.571},{"key":"10","start":44.521,"lines":[{"start":44.521,"end":45.953,"text":"E ba wa k'alleluya Halle","marked":"Ẹ bá wa k'Allelúyà Halle"},{"start":46.403,"end":47.722,"text":"Halle Halleluyah.","marked":"Halle Hallelúyà."}],"end":47.722}]}