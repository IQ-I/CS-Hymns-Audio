{"v":3,"coll":"y","num":865,"id":"hymn_865","title":"OLUWA awa de","duration":47.987,"voices":{"male":{"file":"y-865-male-v3.m4a","bytes":324621,"sha256":"ceee5257a57bf2e466a0be2fa44777098eec1695eb9c4cddc25a1ed14926dd5e","duration":48.0},"female":{"file":"y-865-female-v3.m4a","bytes":336711,"sha256":"8ca8b8a5d07ca43051276a939dd7bb95a5bd4d044f884c8a4eb869786b0ca8ae","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.28,"text":"OLUWA awa de","marked":"Olúwa àwa dé"},{"start":1.73,"end":3.621,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":4.071,"end":5.519,"text":"Lati je ise to ra wa","marked":"Láti jẹ́ iṣẹ́ tó rà wá"},{"start":5.969,"end":7.207,"text":"Fun gbogbo agbaiye.","marked":"Fún gbogbo àgbàìyè."}],"end":7.207},{"key":"2","start":8.157,"lines":[{"start":8.157,"end":9.522,"text":"lse t'o ran l'eyi","marked":"Iṣẹ́ t'ó ràn l'èyí"},{"start":9.972,"end":11.087,"text":"Olorun Oluwa","marked":"Ọlọ́run Olúwa"},{"start":11.537,"end":13.308,"text":"P'a won ti nb'ojo isimi je","marked":"P'á wọn ti ńb'ọjọ́ ìṣímí jẹ́"},{"start":13.758,"end":15.083,"text":"Ni yio jebi poju.","marked":"Ní yóò jẹ̀bi pọ̀jù."}],"end":15.083},{"key":"3","start":16.033,"lines":[{"start":16.033,"end":17.311,"text":"K'araiye teriba","marked":"K'aráìyè tẹríba"},{"start":17.761,"end":18.936,"text":"Niwaju ase Re","marked":"Níwájú àṣẹ Rẹ"},{"start":19.386,"end":20.567,"text":"K'ibinu Olodumare","marked":"K'íbínú Olódùmarè"},{"start":21.017,"end":22.361,"text":"Le ka kuro l'aiye.","marked":"Lè ká kúrò l'ayé."}],"end":22.361},{"key":"4","start":23.311,"lines":[{"start":23.311,"end":24.615,"text":"Kerubu Serafu","marked":"Kérúbù Séráfù"},{"start":25.065,"end":26.158,"text":"Enyin n'iyo aiye","marked":"Ẹ̀yin n'iyọ̀ ayé"},{"start":26.608,"end":28.313,"text":"Iluu t'a te sori oke","marked":"Ìlùú t'á tẹ̀ sórí òkè"},{"start":28.763,"end":30.099,"text":"Yio ti se farasin.","marked":"Yóò ti ṣe farasin."}],"end":30.099},{"key":"5","start":31.049,"lines":[{"start":31.049,"end":32.493,"text":"E fun 'pe na kikan","marked":"Ẹ fún pé na kíkan"},{"start":32.943,"end":34.422,"text":"Nipa t'ojo isimi","marked":"Nípa t'ọjọ́ ìṣímí"},{"start":34.872,"end":36.087,"text":"Ki gbogbo orile-ede","marked":"Kí gbogbo orile-ede"},{"start":36.537,"end":37.756,"text":"Le p'ojo Mimo mo.","marked":"Lè p'ọjọ́ Mímọ́ mọ́."}],"end":37.756},{"key":"6","start":38.706,"lines":[{"start":38.706,"end":39.965,"text":"E f'Ogo fun Baba","marked":"Ẹ f'Ògo fún Baba"},{"start":40.415,"end":41.578,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":42.028,"end":43.537,"text":"E f'Ogo fun Emi Mimo","marked":"Ẹ f'Ògo fún Ẹ̀mí Mímọ́"},{"start":43.987,"end":45.371,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":45.821,"end":46.438,"text":"Amin.","marked":"Àmín."}],"end":46.438}]}