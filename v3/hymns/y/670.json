{"v":3,"coll":"y","num":670,"id":"hymn_670","title":"BI osun gbege eti'do","duration":40.392,"voices":{"male":{"file":"y-670-male-v3.m4a","bytes":271955,"sha256":"770b2c063fccda7ecc46b8d80a583dde10e57bac01c8c405225c45eeb6e36b42","duration":40.4},"female":{"file":"y-670-female-v3.m4a","bytes":286002,"sha256":"91e6b31c8f6921311fddc651a66427446e54bf239f8861ac43dda5498e0b538e","duration":40.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.842,"text":"BI osun gbẹgẹ eti'do,","marked":"Bí osùn gbẹ́gẹ́ etí'dó"},{"start":2.292,"end":3.385,"text":"Tutu mini-mini;","marked":"Tútù mini-mini"},{"start":3.835,"end":5.352,"text":"B'igbo dudu eti omi,","marked":"B'ígbó dúdú etí omi"},{"start":5.802,"end":6.774,"text":"B' itanna ipado.","marked":"B ìtànná ipadò."}],"end":6.774},{"key":"2","start":7.724,"lines":[{"start":7.724,"end":9.16,"text":"Be l'ọmọ na yoo dagba,","marked":"Bẹ́ l'ọmọ ná yóò dàgbà"},{"start":9.61,"end":10.804,"text":"Ti n rin l'ọna rere","marked":"Tí ń rìn l'ọ̀nà rere"},{"start":11.254,"end":12.63,"text":"T'ọkan rẹ n fa si Ọlọrun,","marked":"T'ọkàn rẹ̀ ń fà sí Ọlọ́run"},{"start":13.08,"end":14.135,"text":"Lat' igba ewe rẹ.","marked":"Lát ìgbà èwe rẹ̀."}],"end":14.135},{"key":"3","start":15.085,"lines":[{"start":15.085,"end":16.845,"text":"di Ewe tutu l'ẹba odo,","marked":"di Èwe tútù l'ẹ̀bá odò"},{"start":17.295,"end":18.934,"text":"B'o pẹ, a rẹ danu,","marked":"B'ó pẹ́, a rẹ̀ dànù"},{"start":19.384,"end":20.582,"text":"Bẹ n'itanna ipa omi,","marked":"Bẹ n'ìtànná ipa omi"},{"start":21.032,"end":22.304,"text":"Se n rẹ l'akoko Rẹ","marked":"Ṣe ń rẹ l'àkókò Rẹ"}],"end":22.304},{"key":"4","start":23.254,"lines":[{"start":23.254,"end":24.685,"text":"Ibukun ni fun Ọmọ na,","marked":"Ìbùkún ni fún Ọmọ ná"},{"start":25.135,"end":26.282,"text":"Ti n rin l'ọna Baba;","marked":"Tí ń rìn l'ọ̀nà Baba"},{"start":26.732,"end":28.184,"text":"Ọba ti ki pa ipo da,","marked":"Ọba tí kì pa ipò dà"},{"start":28.634,"end":29.759,"text":"Ẹni Mimọ lailai.","marked":"Ẹni Mímọ́ láéláé."}],"end":29.759},{"key":"5","start":30.709,"lines":[{"start":30.709,"end":32.603,"text":"Oluwa, Wo la gbekele","marked":"Olúwa, Wo la gbẹ́kẹ̀lé"},{"start":33.053,"end":34.283,"text":"Fun wa l'ore ofe","marked":"Fún wa l'oore ọ̀fẹ́"},{"start":34.733,"end":37.209,"text":"L'ewe, l'agba ati n'iku","marked":"L'èwe, l'àgbà àti n'ikú"},{"start":37.659,"end":38.843,"text":"Pa wa mo b'omo Re.","marked":"Pa wá mo b'ọmọ Rẹ."}],"end":38.843}]}