{"v":3,"coll":"y","num":846,"id":"hymn_846","title":"ONA Re, Oluwa","duration":45.703,"voices":{"male":{"file":"y-846-male.m4a","bytes":319669,"sha256":"4605379d82bca33414a09ec821c1024179139d3747d0bd956a28fa3265ec893c","duration":45.8},"female":{"file":"y-846-female.m4a","bytes":327431,"sha256":"4541f6634eb717a1d93d6fce17290c2324519998b77ffaac246996f7a63d7e1d","duration":45.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.6,"text":"ONA Re, Oluwa","marked":"Ọ̀nà Rẹ, Olúwa"},{"start":1.98,"end":3.183,"text":"B'o ti wu ko ha to!","marked":"B'ó ti wù kó ha tó!"},{"start":3.563,"end":4.826,"text":"Fi owo Re to mi","marked":"Fi ọwọ́ Rẹ tó mi"},{"start":5.206,"end":6.298,"text":"Yan ipa mi fun mi.","marked":"Yan ipa mi fún mi."}],"end":6.298},{"key":"2","start":7.248,"lines":[{"start":7.248,"end":8.422,"text":"B'o rorun b'o soro","marked":"B'ó rọrùn b'ó sọ̀rọ̀"},{"start":8.802,"end":9.967,"text":"Daradara lo je","marked":"Daradara ló jẹ́"},{"start":10.347,"end":12.21,"text":"B'o wo, b'o to tara","marked":"B'ó wó, b'ó tó tara"},{"start":12.59,"end":14.016,"text":"Lodo Re l'opin si.","marked":"Lọ́dọ̀ Rẹ l'òpin sí."}],"end":14.016},{"key":"3","start":14.966,"lines":[{"start":14.966,"end":16.317,"text":"Nko gbodo yan 'pin mi","marked":"Nkò gbọdọ̀ yan 'pín mi"},{"start":16.697,"end":17.874,"text":"Nko tile je yan an","marked":"Nkò tilẹ̀ jẹ́ yan án"},{"start":18.254,"end":19.285,"text":"Yan fun mi Olorun","marked":"Yàn fún mi Ọlọ́run"},{"start":19.665,"end":21.131,"text":"Ki mba le rin dede.","marked":"Kí ḿbá lè rìn dẹ̀dẹ̀."}],"end":21.131},{"key":"4","start":22.081,"lines":[{"start":22.081,"end":23.561,"text":"Ijoba ti mo nwa","marked":"Ìjọba tí mò ńwá"},{"start":23.941,"end":25.675,"text":"Tire ni, jek' ona","marked":"Tìrẹ ni, jẹ́k' ọ̀nà"},{"start":26.055,"end":27.254,"text":"T'o re 'be je Tire","marked":"T'ó rẹ́ 'bẹ̀ jẹ́ Tìrẹ"},{"start":27.634,"end":28.813,"text":"Bi beko un o sina.","marked":"Bí bẹkọ́ un ò ṣìnà."}],"end":28.813},{"key":"5","start":29.763,"lines":[{"start":29.763,"end":31.417,"text":"Gba ago mi, f'ayo","marked":"Gba àgọ́ mi, f'ayo"},{"start":31.797,"end":32.844,"text":"Tab'ibanuje kun","marked":"Tàb'ìbànújẹ́ kún"},{"start":33.224,"end":34.456,"text":"B'o ti to l'oju Re","marked":"B'ó ti tó l'ojú Rẹ"},{"start":34.836,"end":36.254,"text":"Yan 're tab'ibi mi.","marked":"Yan 're tab'ibi mi."}],"end":36.254},{"key":"6","start":37.204,"lines":[{"start":37.204,"end":38.477,"text":"Yiyan ki se temi","marked":"Yíyàn kí ṣe tèmi"},{"start":38.857,"end":39.776,"text":"Ninu ohunkohun","marked":"Nínú ohunkóhun"},{"start":40.156,"end":41.385,"text":"Iwo s'Oluto mi","marked":"Ìwo s'Olutọ mi"},{"start":41.765,"end":43.116,"text":"Ogbon, ohun gbogbo.","marked":"Ọgbọ́n, ohun gbogbo."},{"start":43.496,"end":44.153,"text":"Amin.","marked":"Àmín."}],"end":44.153}]}