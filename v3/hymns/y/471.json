{"v":3,"coll":"y","num":471,"id":"hymn_471","title":"ONA ara l'Olorun wa","duration":48.72,"voices":{"male":{"file":"y-471-male-v3.m4a","bytes":333557,"sha256":"56b8cfb965b26f094c782b7aa6112973e56675dd4f71a7213ad52e20a7585fa9","duration":48.8},"female":{"file":"y-471-female-v3.m4a","bytes":343786,"sha256":"6be919d1dcb3a314ef924a241a94efe913525d2882df82125648e20d24d2322c","duration":48.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.693,"text":"ỌNA ara l'Ọlọrun wa,","marked":"Ọ̀nà ara l'Ọlọ́run wa"},{"start":2.143,"end":3.522,"text":"Ngba sisẹ Rẹ layé;","marked":"Ǹgbà sisẹ́ Rẹ̀ layé"},{"start":3.972,"end":5.641,"text":"A n ri 'pasẹ Rẹ l'or' okun,","marked":"À ń rí 'pasẹ Rẹ l'ọ́r òkun"},{"start":6.091,"end":7.396,"text":"O n gun igbi l'ẹsin.","marked":"Ó ń gun ìgbì l'ẹsin."}],"end":7.396},{"key":"2","start":8.346,"lines":[{"start":8.346,"end":10.499,"text":"Ona Re, enikan ko mo","marked":"Ọ̀nà Rẹ, ẹnìkan kò mọ̀"},{"start":10.949,"end":12.077,"text":"Awamaridi ni","marked":"Àwamaridi ni"},{"start":12.527,"end":13.737,"text":"O pa ise ijinle mo","marked":"Ó pa iṣẹ́ ìjìnlẹ̀ mọ́"},{"start":14.187,"end":15.115,"text":"Oba awon oba.","marked":"Ọba àwọn ọba."}],"end":15.115},{"key":"3","start":16.065,"lines":[{"start":16.065,"end":17.995,"text":"Ma bẹru mọ, ẹyin mimọ,","marked":"Má bẹ̀rù mọ́, ẹ̀yin mímọ́"},{"start":18.445,"end":19.716,"text":"Ọrun t'o su bẹ ni;","marked":"Ọ̀run t'ó ṣú bẹ̀ ni"},{"start":20.166,"end":21.829,"text":"O kun fun anu yoo rọjo,","marked":"Ó kún fún àánú yóò rọ̀jò"},{"start":22.279,"end":23.559,"text":"Ibukun sori yin.","marked":"Ìbùkún sórí yín."}],"end":23.559},{"key":"4","start":24.509,"lines":[{"start":24.509,"end":26.159,"text":"Mase da Oluwa l'ejo","marked":"Mase dá Olúwa l'ẹjọ́"},{"start":26.609,"end":27.737,"text":"Sugbon gbeke re le","marked":"Ṣùgbọ́n gbẹ́kẹ̀ rẹ̀ lé"},{"start":28.187,"end":29.668,"text":"Gbati o ro pe O binu","marked":"Gbátí ó rò pé Ó bínú"},{"start":30.118,"end":31.349,"text":"Inu Re dun si o.","marked":"Inú Rẹ̀ dùn sí ọ."}],"end":31.349},{"key":"5","start":32.299,"lines":[{"start":32.299,"end":33.729,"text":"Ise Re fere ye wa na","marked":"Iṣẹ́ Rẹ̀ fẹ́rẹ̀ yẹ wá ná"},{"start":34.179,"end":35.357,"text":"Y'o ma han siwaju","marked":"Y'ó má hàn síwájú"},{"start":35.807,"end":37.335,"text":"Bi o tile koro loni","marked":"Bí ó tilẹ̀ korò lónì"},{"start":37.785,"end":39.303,"text":"O mbo wa dun l'ola.","marked":"Ó mbọ̀ wá dùn l'ọ̀la."}],"end":39.303},{"key":"6","start":40.253,"lines":[{"start":40.253,"end":41.969,"text":"Afọju ni alaigbagbọ,","marked":"Afọ́jú ni aláìgbàgbọ́"},{"start":42.419,"end":43.463,"text":"Ko mo'se Ọlọrun:","marked":"Kò mọ̀'ṣe Ọlọ́run"},{"start":43.913,"end":45.234,"text":"Ọlọrun ni Olutumọ,","marked":"Ọlọ́run ni Olùtúmọ̀"},{"start":45.684,"end":47.171,"text":"Y'o m'ọna Rẹ ye ni.","marked":"Y'ó m'ọ̀nà Rẹ yẹ ni."}],"end":47.171}]}