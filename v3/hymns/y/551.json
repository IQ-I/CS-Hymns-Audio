{"v":3,"coll":"y","num":551,"id":"hymn_551","title":"WA Emi, Mimo sokale","duration":18.38,"voices":{"male":{"file":"y-551-male-v3.m4a","bytes":125569,"sha256":"66becb31b81656ea4654ec1f23d8679cfeb21d6c5380f9b8623bdfd49ae864ff","duration":18.4},"female":{"file":"y-551-female-v3.m4a","bytes":129822,"sha256":"5d649d22c1a54a72a8c4fd9d03e2993132c02fed3550debc12fccee497ebc7eb","duration":18.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.228,"text":"WA Emi, Mimo sokale","marked":"Wá Ẹ̀mí, Mímọ́ sọ̀kalẹ̀"},{"start":2.678,"end":4.367,"text":"Onibaptisi okan wa","marked":"Oníbaptisi ọkàn wa"},{"start":4.817,"end":6.002,"text":"M'edidi majemu Re wa","marked":"M'èdìdì májẹ̀mú Rẹ̀ wà"},{"start":6.452,"end":8.041,"text":"K'o si se eri omi yi.","marked":"K'ó sì ṣe ẹ̀rí omi yí."}],"end":8.041},{"key":"2","start":8.991,"lines":[{"start":8.991,"end":10.378,"text":"Tu agbara nla Rẹ jade,","marked":"Tú agbára ńlá Rẹ̀ jáde"},{"start":10.828,"end":12.278,"text":"K' o si wọn ẹjẹ tutu,","marked":"K ó sì wọn ẹ̀jẹ̀ tútù"},{"start":12.728,"end":14.834,"text":"Ki Baba, Ọmọ at' Ẹmi,","marked":"Kí Baba, Ọmọ àt Ẹ̀mí"},{"start":15.284,"end":16.83,"text":"Jọ sọ wọn d' Ọmọ Ọlọrun.","marked":"Jọ sọ wọ́n d Ọmọ Ọlọ́run."}],"end":16.83}]}