{"v":3,"coll":"y","num":368,"id":"hymn_368","title":"JERUSALEM ibi ayo","duration":48.365,"voices":{"male":{"file":"y-368-male-v3.m4a","bytes":331976,"sha256":"4f187a3a9b40ac8ee3a4849f045ca7ef2428d0aa31fc4e28660c39e3bf97a6c1","duration":48.4},"female":{"file":"y-368-female-v3.m4a","bytes":351141,"sha256":"01fdd088e58456f25652db3d651266e8def6b98120e97dfaa51bd90b4c5b0a4e","duration":48.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.122,"text":"JERUSALEM ibi ayọ,","marked":"Jerusalẹm ibi ayọ̀"},{"start":2.572,"end":3.632,"text":"T'o se ọwọn fun mi,","marked":"T'ó ṣe ọ̀wọ́n fún mi"},{"start":4.082,"end":5.434,"text":"'Gbawo n'ise mi o pari,","marked":"gbàwo n'iṣẹ́ mi ò parí"},{"start":5.884,"end":7.133,"text":"L'ayọ l'alafia.","marked":"L'ayọ̀ l'àlàáfíà."}],"end":7.133},{"key":"2","start":8.083,"lines":[{"start":8.083,"end":9.589,"text":"Gbawo ni oju mi y'o ri","marked":"Gbàwo ní ojú mi y'ó rí"},{"start":10.039,"end":11.254,"text":"Enu bode pearl Re?","marked":"Ẹnu bodè pearl Rẹ̀?"},{"start":11.704,"end":13.007,"text":"Odi re t'o le fun 'gbala","marked":"Odi rẹ̀ t'ó le fún gbàlà"},{"start":13.457,"end":14.723,"text":"Ita wura didan.","marked":"Ìta wúrà dídán."}],"end":14.723},{"key":"3","start":15.673,"lines":[{"start":15.673,"end":17.162,"text":"'Gbawo, ilu Ọlọrun mi,","marked":"gbàwo, ìlú Ọlọ́run mi"},{"start":17.612,"end":18.782,"text":"L'emi o d'afin Rẹ?","marked":"L'èmi ó d'àfin Rẹ?"},{"start":19.232,"end":20.866,"text":"Nibi ti Ijọ ki 'tuka,","marked":"Níbi tí Ìjọ kì túká"},{"start":21.316,"end":22.77,"text":"N'ib' ayọ ailopin.","marked":"N'íb ayọ̀ àìlópin."}],"end":22.77},{"key":"4","start":23.72,"lines":[{"start":23.72,"end":25.072,"text":"Ẹsẹ t'emi o ko iya,","marked":"Ẹsẹ̀ t'èmi ó kọ ìyá"},{"start":25.522,"end":26.792,"text":"Iku at' ipọnju?","marked":"Ikú àt ìpọ́njú?"},{"start":27.242,"end":28.714,"text":"Mo n wo ilẹ rere Kenaan,","marked":"Mo ń wọ ilẹ̀ rere Kenaan"},{"start":29.164,"end":30.447,"text":"Ile 'mọlẹ titi.","marked":"Ilẹ̀ 'mọlẹ títí."}],"end":30.447},{"key":"5","start":31.397,"lines":[{"start":31.397,"end":33.936,"text":"Aposteli, Martyr, Woli,","marked":"Aposteli, Martyr, Wòlí"},{"start":34.386,"end":35.42,"text":"Wọn y'Olugbala ka:","marked":"Wọ́n y'Olùgbàlà ká"},{"start":35.87,"end":37.475,"text":"Awa tikara wa, fẹrẹ","marked":"Àwa tìkára wa, fẹ́rẹ̀"},{"start":37.925,"end":39.191,"text":"Dapọ mọ ogun na.","marked":"Dàpọ̀ mọ́ ogun ná."}],"end":39.191},{"key":"6","start":40.141,"lines":[{"start":40.141,"end":41.561,"text":"Jerusalem ilu ayọ,","marked":"Jerusalẹm ìlú ayọ̀"},{"start":42.011,"end":43.156,"text":"Ọkan mi n fa si Ọ;","marked":"Ọkàn mi ń fà sí Ọ"},{"start":43.606,"end":45.003,"text":"'Gba ti mo ba ri ayọ rẹ,","marked":"gbà tí mo bá rí ayọ̀ rẹ"},{"start":45.453,"end":46.816,"text":"Isẹ mi y'o pari.","marked":"Isẹ́ mi y'ó parí."}],"end":46.816}]}