{"v":3,"coll":"y","num":713,"id":"hymn_713","title":"GBO b'Olugbala ti wi","duration":76.12,"voices":{"male":{"file":"y-713-male-v3.m4a","bytes":540438,"sha256":"d9ed51ae946fd47727a596f666beb3b62d8573b661570951ca10fd2f079c3fd4","duration":76.2},"female":{"file":"y-713-female-v3.m4a","bytes":562413,"sha256":"630446c31e7dd9c76bc5dbf98bd5e9a3c8a349ed11e4867cf8839557f58dc099","duration":76.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.897,"text":"GBO b'Olugbala ti wi","marked":"Gbọ́ b'Olùgbàlà ti wí"},{"start":2.347,"end":3.628,"text":"Pe ise po n'nu ogba","marked":"Pé iṣẹ́ pọ̀ n'nú ọgbà"},{"start":4.078,"end":5.388,"text":"Alagbase ko si to","marked":"Alágbàṣe kò sì tó"},{"start":5.838,"end":7.236,"text":"O mu ra fun 'se na bi","marked":"Ó mú rà fún ṣe ná bí"},{"start":7.686,"end":9.072,"text":"Afunrugbin funrugbin","marked":"Afúnrúgbìn fúnrúgbìn"},{"start":9.522,"end":11.203,"text":"Oko pon, ikore de","marked":"Oko pọ́n, ìkórè dé"},{"start":11.653,"end":12.834,"text":"Olukore mu doje","marked":"Olùkórè mú dòjé"},{"start":13.284,"end":14.823,"text":"Lati ko 'rugbin wale.","marked":"Láti kọ́ rúgbìn wálẹ̀."}],"end":14.823},{"key":"2","start":15.773,"lines":[{"start":15.773,"end":16.964,"text":"Olugbala nke tantan","marked":"Olùgbàlà ńké tàntàn"},{"start":17.414,"end":18.757,"text":"P'eyin onise dide","marked":"P'ẹ̀yin oníṣẹ́ dìde"},{"start":19.207,"end":20.386,"text":"Gbe ihamora mi wo","marked":"Gbé ìhámọ́ra mi wò"},{"start":20.836,"end":22.239,"text":"Mura fun 'se lat'oni","marked":"Múra fún ṣe lát'òní"},{"start":22.689,"end":24.002,"text":"Akoko nsure tete","marked":"Àkókò ńṣúré tètè"},{"start":24.452,"end":25.641,"text":"Ojo ikore de tan","marked":"Ọjọ́ ìkórè dé tán"},{"start":26.091,"end":27.269,"text":"Olukore ti se tan","marked":"Olùkórè ti ṣe tán"},{"start":27.719,"end":29.267,"text":"Lati ko iti wole.","marked":"Láti kọ ìtì wọlé."}],"end":29.267},{"key":"3","start":30.217,"lines":[{"start":30.217,"end":31.313,"text":"Wundia mewa la yan","marked":"Wúńdíá mẹ́wà la yàn"},{"start":31.763,"end":33.304,"text":"Marun ko mura sile","marked":"Márùn kò múra sílẹ̀"},{"start":33.754,"end":34.998,"text":"Marun to ti mura tan","marked":"Márùn tó ti múra tán"},{"start":35.448,"end":36.724,"text":"Ba Oba Ogo wole","marked":"Bá Ọba Ògo wọlé"},{"start":37.174,"end":38.717,"text":"Lo talent ta fi fun o","marked":"Lọ tálẹ́ǹt ta fi fún ọ"},{"start":39.167,"end":40.266,"text":"Sise 'ranse re loni","marked":"Ṣíṣe ránṣẹ́ rẹ lónì"},{"start":40.716,"end":42.611,"text":"Foriti, tesiwaju","marked":"Forítì, tẹ̀síwájú"},{"start":43.061,"end":44.36,"text":"Wo o gbade isegun.","marked":"Wò ó gbàdé ìṣẹ́gun."}],"end":44.36},{"key":"4","start":45.31,"lines":[{"start":45.31,"end":46.602,"text":"Gbo ipe Olugbala","marked":"Gbọ́ ìpè Olùgbàlà"},{"start":47.052,"end":48.45,"text":"Wa je 'pe na nisisyi","marked":"Wá jẹ́ pé ná níṣìṣyí"},{"start":48.9,"end":50.391,"text":"Mase f'akoko dola","marked":"Máṣe f'àkókò dọ́là"},{"start":50.841,"end":51.96,"text":"Ojo igbala de tan","marked":"Ọjọ́ ìgbàlà dé tán"},{"start":52.41,"end":53.726,"text":"Ohun to npe nisisyi","marked":"Ohun tó ńpè níṣìṣyí"},{"start":54.176,"end":55.359,"text":"Le dekun ipe lola","marked":"Lè dẹ́kun ìpè lọ́lá"},{"start":55.809,"end":56.973,"text":"Se 'pinnu rere loni","marked":"Ṣe pinnu rere lónì"},{"start":57.423,"end":59.071,"text":"Ko le gba ade ogo.","marked":"Kò lè gba adé ògo."}],"end":59.071},{"key":"5","start":60.021,"lines":[{"start":60.021,"end":61.254,"text":"Oluwa, Olorun jo","marked":"Olúwa, Ọlọ́run jọ"},{"start":61.704,"end":63.258,"text":"Un o fi ayo jise Re","marked":"Un ó fi ayọ̀ jíṣẹ́ Rẹ"},{"start":63.708,"end":64.801,"text":"Fun mi ni ebun ahon","marked":"Fún mi ní ẹ̀bùn ahọ́n"},{"start":65.251,"end":66.901,"text":"Ki njise na laiberu","marked":"Kí ǹjiṣẹ́ nà láìbẹ̀rù"},{"start":67.351,"end":68.489,"text":"Nigbayi li okan mi","marked":"Nígbàyí lí ọkàn mi"},{"start":68.939,"end":70.134,"text":"Y'o ma korin iyin pe","marked":"Y'ó má kọrin ìyìn pé"},{"start":70.584,"end":71.71,"text":"Ti Oluwa Olorun","marked":"Ti Olúwa Ọlọ́run"},{"start":72.16,"end":73.514,"text":"Ni iyin ati ogo.","marked":"Ní ìyìn àti ògo."},{"start":73.964,"end":74.571,"text":"Amin.","marked":"Àmín."}],"end":74.571}]}