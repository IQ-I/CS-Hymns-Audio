{"v":3,"coll":"y","num":558,"id":"hymn_558","title":"A dupe lowo Oluwa","duration":57.457,"voices":{"male":{"file":"y-558-male-v3.m4a","bytes":394879,"sha256":"c6c2be226be269a5543904a2fc442cee11e7b2c0354ea52a5f5d53b46383ced9","duration":57.5},"female":{"file":"y-558-female-v3.m4a","bytes":412474,"sha256":"0166fe4d0395aa40d9a7012392ed39226d2a8a641d130cb14a46d97515ad1567","duration":57.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.501,"text":"A dupe lowo Oluwa,","marked":"A dúpẹ́ lọ́wọ́ Olúwa"},{"start":1.951,"end":2.983,"text":"E ki mi ku ewu","marked":"Ẹ kì mí kú ewu"},{"start":3.433,"end":5.176,"text":"Fun irin ajo mi yi na","marked":"Fún irin àjọ mi yí ná"},{"start":5.626,"end":6.747,"text":"Ope fun Oluwa.","marked":"Ọpẹ́ fún Olúwa."}],"end":6.747},{"key":"2","start":7.697,"lines":[{"start":7.697,"end":9.118,"text":"Kérúbù pẹlu Séráfù;","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":9.568,"end":10.98,"text":"F'Ogo f'orukọ Rẹ,","marked":"F'Ògo f'orúkọ Rẹ"},{"start":11.43,"end":12.808,"text":"F'ẹni to d'Ẹgbẹ yi silẹ,","marked":"F'ẹni tó d'Ẹ̀gbẹ́ yí sílẹ̀"},{"start":13.258,"end":14.615,"text":"Oun ni Ọba Ogo.","marked":"Òun ni Ọba Ògo."}],"end":14.615},{"key":"3","start":15.565,"lines":[{"start":15.565,"end":18.151,"text":"Ẹ ho, ẹ yọ, kọrin ogo,","marked":"Ẹ hó, ẹ yọ̀, kọrin ògo"},{"start":18.601,"end":20.075,"text":"Jesu Ọba Ogo;","marked":"Jésù Ọba Ògo"},{"start":20.525,"end":21.785,"text":"Orukọ Rẹ kari ayé,","marked":"Orúkọ Rẹ̀ kárí ayé"},{"start":22.235,"end":23.382,"text":"O mu mi lọ, mo bọ.","marked":"Ó mú mi lọ, mo bọ̀."}],"end":23.382},{"key":"4","start":24.332,"lines":[{"start":24.332,"end":25.658,"text":"Ope lo ye O, Oluwa","marked":"Ọpẹ́ ló yẹ Ọ, Olúwa"},{"start":26.108,"end":27.423,"text":"F'abo Re l'ori mi","marked":"F'abo Rẹ l'orí mi"},{"start":27.873,"end":29.152,"text":"Yika orile ede gbogbo","marked":"Yíká orílẹ̀ èdè gbogbo"},{"start":29.602,"end":30.886,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":30.886},{"key":"5","start":31.836,"lines":[{"start":31.836,"end":33.718,"text":"K'okiki Rẹ yika ayé,","marked":"K'òkìkí Rẹ yíká ayé"},{"start":34.168,"end":35.541,"text":"Ma bọ, Oluwa mi,","marked":"Má bọ̀, Olúwa mi"},{"start":35.991,"end":37.674,"text":"Ọba Mimọ, Ọba aiku,","marked":"Ọba Mímọ́, Ọba àìkú"},{"start":38.124,"end":39.274,"text":"Ẹni Mẹtalọkan.","marked":"Ẹni Mẹ́talọ́kan."}],"end":39.274},{"key":"6","start":40.224,"lines":[{"start":40.224,"end":41.487,"text":"E korin Ologo Mimo","marked":"Ẹ kọrin Ológo Mímọ́"},{"start":41.937,"end":42.992,"text":"Ope ni f'Oluwa","marked":"Ọpẹ́ ni f'Olúwa"},{"start":43.442,"end":45.38,"text":"A lo, a bo, l'alafia","marked":"A lọ, a bọ́, l'àlàáfíà"},{"start":45.83,"end":47.082,"text":"Mo dupe f'Oluwa.","marked":"Mo dúpẹ́ f'Olúwa."}],"end":47.082},{"key":"7","start":48.032,"lines":[{"start":48.032,"end":50.055,"text":"Ẹ ke Halle, Halleluyah,","marked":"Ẹ ké Halle, Hallelúyà"},{"start":50.505,"end":51.71,"text":"F'Ọlọrun Kérúbù;","marked":"F'Ọlọ́run Kérúbù"},{"start":52.16,"end":54.204,"text":"Ẹ ke Halle, Halleluyah,","marked":"Ẹ ké Halle, Hallelúyà"},{"start":54.654,"end":55.908,"text":"S'Ọlọrun Séráfù.","marked":"S'Ọlọ́run Séráfù."}],"end":55.908}]}