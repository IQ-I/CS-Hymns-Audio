{"v":3,"coll":"y","num":412,"id":"hymn_412","title":"LO, l'ooro kutukutu","duration":57.729,"voices":{"male":{"file":"y-412-male-v3.m4a","bytes":414486,"sha256":"18b50a87ba0168846630abba61e8f027cc6d02d4351a1d3dda8f0dbdfb7e73f6","duration":57.8},"female":{"file":"y-412-female-v3.m4a","bytes":420501,"sha256":"51b86af9add02e280673fa39412ce019c74e532af3fed1f8da34424862a136c0","duration":57.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.786,"text":"LỌ, l'oorọ kutukutu,","marked":"Lọ, l'oorọ kùtùkùtù"},{"start":2.236,"end":3.681,"text":"Lọ, ni ọsan gangan,","marked":"Lọ, ní ọ̀sán gangan"},{"start":4.131,"end":5.583,"text":"Lọ, ni igba asalẹ,","marked":"Lọ, ní ìgbà asálẹ̀"},{"start":6.033,"end":7.397,"text":"Lọ, ni ọganjọ oru,","marked":"Lọ, ní ọ̀gànjọ́ òru"},{"start":7.847,"end":9.327,"text":"Lọ, t'iwọ t'inu rere,","marked":"Lọ, t'ìwọ t'inú rere"},{"start":9.777,"end":10.765,"text":"Gbagbe ohun ayé,","marked":"Gbàgbé ohun ayé"},{"start":11.215,"end":12.524,"text":"Si kunlẹ n'iyẹwu rẹ,","marked":"Sì kúnlẹ̀ n'ìyẹ̀wù rẹ̀"},{"start":12.974,"end":14.196,"text":"Gbadura nikọkọ.","marked":"Gbàdúrà níkọ̀kọ̀."}],"end":14.196},{"key":"2","start":15.146,"lines":[{"start":15.146,"end":16.291,"text":"Ranti awọn t'o fẹ Ọ,","marked":"Rántí àwọn t'ó fẹ́ Ọ"},{"start":16.741,"end":18.116,"text":"At' awọn t'iwọ fẹ;","marked":"Àt àwọn t'ìwọ fẹ́"},{"start":18.566,"end":19.688,"text":"Awọn t'o korira rẹ;","marked":"Àwọn t'ó kóríra rẹ̀"},{"start":20.138,"end":21.373,"text":"Si gbadura fun wọn;","marked":"Sì gbàdúrà fún wọn"},{"start":21.823,"end":23.574,"text":"Lẹyin na, tọrọ 'bukun,","marked":"Lẹ́yìn ná, tọrọ bùkún"},{"start":24.024,"end":25.186,"text":"Run 'wọ tikalarẹ;","marked":"Run 'wọ tìkálárẹ"},{"start":25.636,"end":27.521,"text":"Ninu adura rẹ, ma","marked":"Nínú àdúrà rẹ, má"},{"start":27.971,"end":28.991,"text":"Pe orukọ Jesu.","marked":"Pé orúkọ Jésù."}],"end":28.991},{"key":"3","start":29.941,"lines":[{"start":29.941,"end":31.376,"text":"B'ayé ati gbadura,","marked":"B'ayé àti gbàdúrà"},{"start":31.826,"end":33.256,"text":"Ni kọkọ ko si si,","marked":"Ní kọ́kọ́ kò sì sí"},{"start":33.706,"end":34.815,"text":"T'ọkan rẹ fẹ gbadua,","marked":"T'ọkàn rẹ̀ fẹ́ gbàdùà"},{"start":35.265,"end":36.961,"text":"'Gbana, adura jẹjẹ,","marked":"gbàná, àdúrà jẹ́jẹ́"},{"start":37.411,"end":38.479,"text":"Lat'inu ọkan rẹ,","marked":"Lát'inú ọkàn rẹ̀"},{"start":38.929,"end":40.27,"text":"Y'o de ọdọ Ọlọrun.","marked":"Y'ó dé ọ̀dọ̀ Ọlọ́run."},{"start":40.72,"end":41.754,"text":"Ọlọrun Alanu.","marked":"Ọlọ́run Alánù."}],"end":41.754},{"key":"4","start":42.704,"lines":[{"start":42.704,"end":44.26,"text":"Ko si ayọ kan l'ayé,","marked":"Kò sí ayọ̀ kan l'ayé"},{"start":44.71,"end":46.044,"text":"T'o si ju eyi lọ;","marked":"T'ó sì ju èyí lọ"},{"start":46.494,"end":47.826,"text":"Ni t'agbara t'a fun wa,","marked":"Ní t'agbára t'á fún wa"},{"start":48.276,"end":49.47,"text":"Lati ma gbadura;","marked":"Láti má gbàdúrà"},{"start":49.92,"end":51.239,"text":"'Gba t'inu rẹ ko ba dun,","marked":"gbà t'inú rẹ̀ kò bá dùn"},{"start":51.689,"end":52.705,"text":"Jẹ k'ọkan rẹ wolẹ;","marked":"Jẹ́ k'ọkàn rẹ wólẹ̀"},{"start":53.155,"end":54.18,"text":"Ninu ayọ rẹ gbogbo,","marked":"Nínú ayọ̀ rẹ gbogbo"},{"start":54.63,"end":56.18,"text":"Ranti or'-ọfẹ rẹ.","marked":"Rántí or'-ọfẹ rẹ."}],"end":56.18}]}