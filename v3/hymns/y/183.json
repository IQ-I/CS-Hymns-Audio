{"v":3,"coll":"y","num":183,"id":"hymn_183","title":"OJO 'dajo oun 'binu","duration":31.403,"voices":{"male":{"file":"y-183-male-v3.m4a","bytes":212459,"sha256":"6ad7f09b16f28f38dfefe852be76d29da7b9cbbfd522a72876e0f27b8f37e02b","duration":31.5},"female":{"file":"y-183-female-v3.m4a","bytes":220868,"sha256":"3e59bc453719e14d0e2158047e9592a8893b46fb6c5e1fe6a65dd2c7e6216807","duration":31.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.479,"text":"ỌJỌ 'dajo oun 'binu,","marked":"Ọjọ́ dájọ́ òun bínú"},{"start":1.929,"end":3.492,"text":"Ọjọ ti Jesu pa ni,","marked":"Ọjọ́ tí Jésù pa ni"},{"start":3.942,"end":5.419,"text":"Gọngọ a sọ n'jọ naa!","marked":"Gọ́ńgọ́ á sọ n'jọ náà!"}],"end":5.419},{"key":"2","start":6.369,"lines":[{"start":6.369,"end":8.142,"text":"Kikan n'ipe o ma dun,","marked":"Kíkan n'ìpè ó má dùn"},{"start":8.592,"end":10.033,"text":"Isa oku yoo si,","marked":"Isà òkú yóò sí"},{"start":10.483,"end":12.007,"text":"Gbogbo oku y'o dide.","marked":"Gbogbo òkú y'ó dìde."}],"end":12.007},{"key":"3","start":12.957,"lines":[{"start":12.957,"end":14.468,"text":"Iku papa y'o diji","marked":"Ikú pápá y'ó díjì"},{"start":14.918,"end":16.427,"text":"Eda gbogbo y'o dide","marked":"Ẹ̀dà gbogbo y'ó dìde"},{"start":16.877,"end":18.261,"text":"Lati jipe Olorun.","marked":"Láti jípè Ọlọ́run."}],"end":18.261},{"key":"4","start":19.211,"lines":[{"start":19.211,"end":20.387,"text":"A o si Iwe sile","marked":"A ó sí Ìwé sílẹ̀"},{"start":20.837,"end":21.968,"text":"A o si ka ninu re","marked":"A ó sì kà nínú rẹ̀"},{"start":22.418,"end":24.069,"text":"Fun 'dajo t'o ku t'aye.","marked":"Fún dájọ́ t'ó kù t'ayé."}],"end":24.069},{"key":"5","start":25.019,"lines":[{"start":25.019,"end":26.05,"text":"Onidajọ Ododo,","marked":"Onídájọ́ Òdodo"},{"start":26.5,"end":27.761,"text":"Jọ w'ẹsẹ mi gbogbo nu,","marked":"Jọ w'ẹsẹ̀ mi gbogbo nù"},{"start":28.211,"end":29.854,"text":"K'ọjọ siro naa to de.","marked":"K'ọjọ́ ṣírò náà tó dé."}],"end":29.854}]}