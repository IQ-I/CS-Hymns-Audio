{"v":3,"coll":"y","num":508,"id":"hymn_508","title":"OLORUN t'o gbo ti Dafidi","duration":76.163,"voices":{"male":{"file":"y-508-male-v3.m4a","bytes":534141,"sha256":"0798c58d685d2f7926ca9fe8d0e15234a4b1a58b29888fc5eaacaa5dbf2c7a79","duration":76.2},"female":{"file":"y-508-female-v3.m4a","bytes":545045,"sha256":"3447574966a8124e4f22c0b402bfd5960438b652085b88ba061137303b4c9da5","duration":76.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.871,"text":"OLORUN t'o gbo ti Dafidi","marked":"Ọlọ́run t'ó gbọ́ ti Dafidi"},{"start":2.321,"end":3.403,"text":"Lori awon Ota re","marked":"Lórí àwọn Ọ̀tá rẹ"},{"start":3.853,"end":5.293,"text":"Olorun to gbo ti Esther","marked":"Ọlọ́run tó gbọ́ tí Esther"},{"start":5.743,"end":7.235,"text":"T'o si segun Hamani.","marked":"T'ó sì ṣẹ́gun Hamani."}],"end":7.235},{"key":"CHORUS","start":8.185,"lines":[{"start":8.185,"end":10.099,"text":"Gb'adura wa, Oba olore","marked":"Gb'àdúrà wa, Ọba ọlọ́rẹ̀"},{"start":10.549,"end":11.967,"text":"Gege bi a ti nke pe O","marked":"Gẹ́gẹ́ bí a ti ńké pé Ó"},{"start":12.417,"end":13.901,"text":"Mase je k'omo Re rahun","marked":"Mase jẹ́ k'ọmọ Rẹ̀ ráhùn"},{"start":14.351,"end":15.782,"text":"L'a tunbotan aiye wa.","marked":"L'á túnbọ̀tán ayé wa."}],"end":15.782},{"key":"2","start":16.732,"lines":[{"start":16.732,"end":18.315,"text":"Hosanna Oba Ologo","marked":"Hosanna Ọba Ológo"},{"start":18.765,"end":20.237,"text":"Kabiyesi f 'Oba wa,","marked":"Kábíyèsí f ọba wa"},{"start":20.687,"end":22.172,"text":"F'ebun ore-ofe Re fun wa","marked":"F'ẹ̀bùn oore-ọ̀fẹ́ Rẹ fún wa"},{"start":22.622,"end":24.508,"text":"K'awa le sin O d'opin.","marked":"K'àwa lè sìn Ó d'òpin."},{"start":24.958,"end":25.943,"text":"Egbe:  Gb'adura wa...","marked":"Gb'àdúrà wa"}],"end":25.943},{"key":"3","start":26.893,"lines":[{"start":26.893,"end":28.287,"text":"Olorun to gbo ti Hanna","marked":"Ọlọ́run tó gbọ́ tí Hanna"},{"start":28.737,"end":30.157,"text":"Jowo gbo t'awon agan wa","marked":"Jọ̀wọ́ gbọ́ t'àwọn àgàn wa"},{"start":30.607,"end":31.908,"text":"Olorun to gbo ti Serah","marked":"Ọlọ́run tó gbọ́ ti Serah"},{"start":32.358,"end":33.649,"text":"Sanu f'awa omo Re.","marked":"Ṣànù f'àwa ọmọ Rẹ̀."},{"start":34.099,"end":35.042,"text":"Egbe:  Gb'adura wa...","marked":"Gb'àdúrà wa"}],"end":35.042},{"key":"4","start":35.992,"lines":[{"start":35.992,"end":37.302,"text":"Awa Omo Egbe Serafu","marked":"Àwa Ọmọ Ẹgbẹ́ Séráfù"},{"start":37.752,"end":39.082,"text":"Ti aginju aiye yi","marked":"Ti aginjù ayé yí"},{"start":39.532,"end":40.883,"text":"F'ebun Emi Mimo Re fun wa,","marked":"F'ẹ̀bùn Ẹ̀mí Mímọ́ Rẹ fún wa"},{"start":41.333,"end":42.487,"text":"K'a wa le jere ade.","marked":"K'á wá lè jèrè adé."},{"start":42.937,"end":43.98,"text":"Egbe:  Gb'adura wa...","marked":"Gb'àdúrà wa"}],"end":43.98},{"key":"5","start":44.93,"lines":[{"start":44.93,"end":46.199,"text":"Olorun to gbo Elija","marked":"Ọlọ́run tó gbọ́ Elija"},{"start":46.649,"end":48.112,"text":"Leba odo Jodan","marked":"Leba odò Jodan"},{"start":48.562,"end":50.275,"text":"Olorun to gbo ti Mose","marked":"Ọlọ́run tó gbọ́ tí Mósè"},{"start":50.725,"end":52.033,"text":"Lori oke Sinai.","marked":"Lórí òkè Sinai."},{"start":52.483,"end":53.413,"text":"Egbe:  Gb'adura wa...","marked":"Gb'àdúrà wa"}],"end":53.413},{"key":"6","start":54.363,"lines":[{"start":54.363,"end":56.107,"text":"B'o ti wu k' orun ko mu to","marked":"B'ó ti wù k ọ̀run kò mú tó"},{"start":56.557,"end":58.483,"text":"Sanma dudu die yio wa","marked":"Sanma dúdú díẹ̀ yóò wá"},{"start":58.933,"end":60.602,"text":"B'o ti wu k'aiye wa l'ayo","marked":"B'ó ti wù k'ayé wà l'ayọ̀"},{"start":61.052,"end":62.271,"text":"Yo n' akoko ekun re.","marked":"Yó ń àkókò ẹkún rẹ̀."},{"start":62.721,"end":63.625,"text":"Egbe:  Gb'adura wa...","marked":"Gb'àdúrà wa"}],"end":63.625},{"key":"7","start":64.575,"lines":[{"start":64.575,"end":66.075,"text":"L'ohun kan gbogbo wa kunle","marked":"L'ohun kan gbogbo wa kúnlẹ̀"},{"start":66.525,"end":68.014,"text":"Pa ese run l'okan wa","marked":"Pa ẹsẹ̀ run l'ọkàn wa"},{"start":68.464,"end":70.188,"text":"F'ebun meje orun Re fun wa,","marked":"F'ẹ̀bùn méje ọ̀run Rẹ̀ fún wa"},{"start":70.638,"end":72.162,"text":"Ki 'fe wa le ma po si.","marked":"Kí fẹ́ wá lè má pọ̀ sí."},{"start":72.612,"end":73.598,"text":"Egbe:  Gb'adura wa...","marked":"Gb'àdúrà wa"},{"start":74.048,"end":74.614,"text":"Amin.","marked":"Àmín."}],"end":74.614}]}