{"v":3,"coll":"y","num":707,"id":"hymn_707","title":"A KI yin e ku ajodun oni","duration":56.293,"voices":{"male":{"file":"y-707-male-v3.m4a","bytes":398959,"sha256":"0a9d094fe4f63bc9c21290d2dadda3b0cd42a2df6f286e86862b0bbdd13618e0","duration":56.3},"female":{"file":"y-707-female-v3.m4a","bytes":411365,"sha256":"4166a3e8fd2b704ed22fc9825d1b0c2032d251e851f827432caa108ee823c23d","duration":56.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.412,"text":"A KI nyin e ku ajodun oni","marked":"A Kí yín ẹ kú àjọ̀dún òní"},{"start":2.862,"end":4.511,"text":"Enyin omo Egbe Serafu","marked":"Ẹ̀yin ọmọ Ẹgbẹ́ Séráfù"},{"start":4.961,"end":6.723,"text":"A dupe lowo Baba wa orun","marked":"A dúpẹ́ lọ́wọ́ Baba wa ọ̀run"},{"start":7.173,"end":8.715,"text":"T'o da wa si di oni.","marked":"T'ó dá wa sì di òní."}],"end":8.715},{"key":"CHORUS","start":9.665,"lines":[{"start":9.665,"end":12.072,"text":"E ho iho ayo gbogbo Serafu","marked":"Ẹ hó ihò ayọ̀ gbogbo Séráfù"},{"start":12.522,"end":13.989,"text":"Fun ogun rere ti fun wa","marked":"Fún ogun rere ti fún wa"},{"start":14.439,"end":16.134,"text":"Lat'owo Mose Orimolade","marked":"Lát'ọwọ́ Mósè Orímọ́ládé"},{"start":16.584,"end":18.301,"text":"T'o d'Egbe Serafu s'aiye.","marked":"T'ó d'Ẹgbẹ́ Séráfù s'ayé."}],"end":18.301},{"key":"2","start":19.251,"lines":[{"start":19.251,"end":20.921,"text":"Awon olufe wa ti goke lo","marked":"Àwọn olùfẹ́ wa ti gòkè lọ"},{"start":21.371,"end":22.776,"text":"Nwon koja s'aiya baba wa","marked":"Wọ́n kọjá s'àìyá Baba wa"},{"start":23.226,"end":25.304,"text":"Nwon mboju wo wa lati oke na","marked":"Wọ́n mbojú wò wá láti òkè ná"},{"start":25.754,"end":27.587,"text":"Lati wo b'a ti nsise.","marked":"Láti wò b'á ti ńṣiṣẹ́."}],"end":27.587},{"key":"3","start":28.537,"lines":[{"start":28.537,"end":30.114,"text":"Baba Aladura mura giri","marked":"Baba Aládúrà múra gírí"},{"start":30.564,"end":31.932,"text":"Lati tele ona na","marked":"Láti tẹ̀lé ọ̀nà ná"},{"start":32.382,"end":33.891,"text":"Sise pelu gbogbo agbara Re","marked":"Ṣiṣẹ́ pẹ̀lú gbogbo agbára Rẹ"},{"start":34.341,"end":35.931,"text":"K'egbe le tesiwaju.","marked":"K'ègbé lè tẹ̀síwájú."}],"end":35.931},{"key":"4","start":36.881,"lines":[{"start":36.881,"end":38.505,"text":"Eni owo 'tun Baba Aladura","marked":"Ẹni ọwọ́ tún Baba Aládúrà"},{"start":38.955,"end":40.688,"text":"Ogbeni Senior Apostle","marked":"Ọ̀gbẹ́ni Senior Apostle"},{"start":41.138,"end":42.803,"text":"Ati gbogbo awon Apostle","marked":"Àti gbogbo àwọn Apostle"},{"start":43.253,"end":44.988,"text":"E gbe iwo 'gbagbo s'oke.","marked":"Ẹ gbé ìwọ gbàgbọ́ s'ókè."}],"end":44.988},{"key":"5","start":45.938,"lines":[{"start":45.938,"end":47.648,"text":"A ki nyin gbogbo enyin oloye","marked":"A kí yín gbogbo ẹ̀yin olóye"},{"start":48.098,"end":49.543,"text":"E ku ajodun oni yi","marked":"Ẹ kú àjọ̀dún òní yí"},{"start":49.993,"end":51.656,"text":"L'okunrin, l'obinrin","marked":"L'ọkùnrin, l'obìnrin"},{"start":52.106,"end":53.722,"text":"K'a se 'yi ka s'amodun.","marked":"K'á ṣe yí ká s'àmọdún."},{"start":54.172,"end":54.744,"text":"Amin.","marked":"Àmín."}],"end":54.744}]}