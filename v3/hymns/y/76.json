{"v":3,"coll":"y","num":76,"id":"hymn_76","title":"WA, Parakliti Mimo,","duration":60.646,"voices":{"male":{"file":"y-76-male-v3.m4a","bytes":407564,"sha256":"a810188388131c52cc28837a832807de716f06bb2819f341f381ff12437cad76","duration":60.7},"female":{"file":"y-76-female-v3.m4a","bytes":424406,"sha256":"8cf327f6d2ee29ec21eae4d31b7ad63f7a717f8f552fe1692126b75669a5185a","duration":60.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.204,"text":"mp WA, Parakliti Mimọ,","marked":"mp Wá, Parakliti Mímọ́"},{"start":2.654,"end":3.803,"text":"Lat' ibugbe Rẹ ọrun,","marked":"Lát ibùgbé Rẹ ọ̀run"},{"start":4.253,"end":5.379,"text":"Ran itansan 'mọlẹ wa,","marked":"Rán ìtànṣán 'mọlẹ wá"}],"end":5.379},{"key":"2","start":6.329,"lines":[{"start":6.329,"end":8.033,"text":"Baba talaka, wa 'hin","marked":"Baba tálákà, wá hín"},{"start":8.483,"end":9.637,"text":"Olufunni l'ebun wa,","marked":"Olùfúnni l'ẹ̀bùn wà"},{"start":10.087,"end":11.596,"text":"Imole okan jo wa.","marked":"Ìmọ́lẹ̀ ọkàn jọ wá."}],"end":11.596},{"key":"3","start":12.546,"lines":[{"start":12.546,"end":13.733,"text":"Baba Olutunu wa,","marked":"Baba Olùtùnú wa"},{"start":14.183,"end":15.588,"text":"Alejo tootọ f'ọkan,","marked":"Àlejò tòótọ́ f'ọkàn"},{"start":16.038,"end":17.54,"text":"Pẹlu itura-Rẹ wa.","marked":"Pẹ̀lú itura-Rẹ wà."}],"end":17.54},{"key":"4","start":18.49,"lines":[{"start":18.49,"end":20.017,"text":"'Wọ n'isinmi n'nu lala,","marked":"'Wọ n'ìsinmi n'nù lala"},{"start":20.467,"end":21.738,"text":"Iboji ninu oorun,","marked":"Ibojì nínú oòrùn"},{"start":22.188,"end":23.605,"text":"Itunu ninu 'pọnju.","marked":"Ìtùnú nínú 'pọnju."}],"end":23.605},{"key":"5","start":24.555,"lines":[{"start":24.555,"end":25.911,"text":"'Wọ 'mọlẹ t'o mọ gara,","marked":"'Wọ 'mọlẹ t'ó mọ́ gara"},{"start":26.361,"end":27.633,"text":"Tan sinu aya awọn;","marked":"Tán sínú aya àwọn"},{"start":28.083,"end":29.211,"text":"Eniyan Rẹ olootọ.","marked":"Ènìyàn Rẹ̀ olóòtọ́."}],"end":29.211},{"key":"6","start":30.161,"lines":[{"start":30.161,"end":31.83,"text":"L'aisi Rẹ ki l'ẹda jẹ?","marked":"L'àìsí Rẹ̀ kí l'ẹ̀dà jẹ́?"},{"start":32.28,"end":33.657,"text":"Ise at'ero Mimọ,","marked":"Iṣẹ́ àt'ẹ̀rọ Mímọ́"},{"start":34.107,"end":35.555,"text":"Lat'ọdọ Rẹ wa ni wọn.","marked":"Lát'ọ̀dọ̀ Rẹ̀ wà ni wọ́n."}],"end":35.555},{"key":"7","start":36.505,"lines":[{"start":36.505,"end":38.265,"text":"Eleeri, sọ di mimọ,","marked":"Ẹlẹ́ẹ̀rí, sọ di mímọ́"},{"start":38.715,"end":40.056,"text":"Agbọgbẹ masai wo san,","marked":"Àgbọgbẹ́ masai wò sàn"},{"start":40.506,"end":42.041,"text":"Alaileso mu s'eso.","marked":"Aláìléso mú s'èṣọ́."}],"end":42.041},{"key":"8","start":42.991,"lines":[{"start":42.991,"end":44.277,"text":"Mu okan tutu gbona","marked":"Mú ọkàn tútù gbóná"},{"start":44.727,"end":45.841,"text":"M'alagidi teriba,","marked":"M'alágídí tẹríba"},{"start":46.291,"end":48.027,"text":"Fa asako wa jeje.","marked":"Fa àṣàkò wà jẹ́jẹ́."}],"end":48.027},{"key":"9","start":48.977,"lines":[{"start":48.977,"end":50.17,"text":"F'ẹmi 'jinlẹ Rẹ meje,","marked":"F'ẹ̀mí 'jinlẹ Rẹ méje"},{"start":50.62,"end":51.618,"text":"Kun awọn olootọ Rẹ,","marked":"Kún àwọn olóòtọ́ Rẹ"},{"start":52.068,"end":53.45,"text":"F'agbara Rẹ s'abo wọn.","marked":"F'agbára Rẹ̀ s'abo wọn."}],"end":53.45},{"key":"10","start":54.4,"lines":[{"start":54.4,"end":55.541,"text":"Ran or'ọfẹ Rẹ sihin,","marked":"Rán or'ọ̀fẹ́ Rẹ síhìn"},{"start":55.991,"end":57.259,"text":"Ẹkun igbala layé,","marked":"Ẹkún ìgbàlà layé"},{"start":57.709,"end":59.097,"text":"At'alafia l'ọrun.","marked":"Àt'àlàfíà l'ọ̀run."}],"end":59.097}]}