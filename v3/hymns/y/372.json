{"v":3,"coll":"y","num":372,"id":"hymn_372","title":"OLORI Ijo t'orun","duration":63.601,"voices":{"male":{"file":"y-372-male-v3.m4a","bytes":457542,"sha256":"81a63e76434eb8c125b31dbab014a5df638aaae763f4e2c2e47af074ae37e23f","duration":63.7},"female":{"file":"y-372-female-v3.m4a","bytes":466866,"sha256":"1f30a783bdd12d140c476a68c1b2e39cbd200e69f1cf160e809d7f7dd82623eb","duration":63.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.47,"text":"OLORI Ijo t'orun","marked":"Olórí Ìjọ t'ọ̀run"},{"start":1.92,"end":3.368,"text":"L'ayo l'a wole fun O","marked":"L'ayọ̀ l'a wọlé fún Ọ"},{"start":3.818,"end":5.83,"text":"K'O to de, Ijo t'aiye","marked":"K'Ó tó dé, Ìjọ t'ayé"},{"start":6.28,"end":7.655,"text":"Y'o ma korin bi t'orun","marked":"Y'ó má kọrin bí t'ọ̀run"},{"start":8.105,"end":9.489,"text":"A gbe okan wa s'oke","marked":"A gbé ọkàn wa s'ókè"},{"start":9.939,"end":11.568,"text":"Ni 'reti t'o ni 'bukun","marked":"Ní retí t'ó ní bùkún"},{"start":12.018,"end":13.971,"text":"Awa kigbe, awa f'iyin","marked":"Àwa kígbe, àwa f'ìyìn"},{"start":14.421,"end":15.594,"text":"F'Olorun igbala wa.","marked":"F'Ọlọ́run ìgbàlà wa."}],"end":15.594},{"key":"2","start":16.544,"lines":[{"start":16.544,"end":18.095,"text":"Gbat' a wa ninu iponju","marked":"Gbàt a wà nínú ìpọ́njú"},{"start":18.545,"end":19.768,"text":"T'a nkoja ninu ina","marked":"T'á ńkọjá nínú iná"},{"start":20.218,"end":21.563,"text":"Orin ife l'awa o ko","marked":"Orin ìfẹ́ l'àwa ó kò"},{"start":22.013,"end":23.243,"text":"Ti o nmu wa sunmoO","marked":"Tí ó ńmú wa súnmọ́ọ"},{"start":23.693,"end":25.643,"text":"Awa sope, a si yo","marked":"Àwa ṣọpẹ́, a sì yọ̀"},{"start":26.093,"end":27.168,"text":"Ninu ojurere Re","marked":"Nínú ojúrere Rẹ"},{"start":27.618,"end":29.355,"text":"lfe t'o so wa di Tire","marked":"Ìfẹ́ t'ó sọ wá di Tìrẹ"},{"start":29.805,"end":31.386,"text":"Y'o se wa ni Tire lai.","marked":"Y'ó ṣe wà ní Tire láì."}],"end":31.386},{"key":"3","start":32.336,"lines":[{"start":32.336,"end":33.421,"text":"lwo mu awon enia Re","marked":"Ìwọ mú àwọn ènìà Rẹ"},{"start":33.871,"end":35.565,"text":"Koja isan idanwo","marked":"Kọjá ìṣàn ìdánwò"},{"start":36.015,"end":37.271,"text":"“Tori O wa nitosi","marked":"Torí Ó wà nítòsí"},{"start":37.721,"end":40.077,"text":"Aiye, ese, at'esu","marked":"Ayé, ẹ̀ṣẹ̀, àt'èṣù"},{"start":40.527,"end":41.781,"text":"Kojuja si wa lasan","marked":"Kojújá sì wà lásán"},{"start":42.231,"end":44.488,"text":"L' agbara Re, a o segun","marked":"L agbára Rẹ̀, a ó ṣẹ́gun"},{"start":44.938,"end":46.352,"text":"A o si ko orin Mose.","marked":"A ó sì kọ orin Mósè."}],"end":46.352},{"key":"4","start":47.302,"lines":[{"start":47.302,"end":48.618,"text":"Awa f'igbagbo r'ogo","marked":"Àwa f'ìgbàgbọ́ r'ògo"},{"start":49.068,"end":50.574,"text":"T'O tun nfe fi wa si","marked":"T'Ó tún ńfẹ́ fi wá sí"},{"start":51.024,"end":52.257,"text":"A kegan aiye 'tori","marked":"A kẹ́gàn ayé torí"},{"start":52.707,"end":53.897,"text":"Ere nla iwaju wa","marked":"Èrè ńlá iwájú wa"},{"start":54.347,"end":55.708,"text":"Bi O ba si ka wa ye","marked":"Bí Ó bá sì kà wá yẹ"},{"start":56.158,"end":58.197,"text":"Awa pelu Stefen t'o ku","marked":"Àwa pẹ̀lú Stefen t'ó kú"},{"start":58.647,"end":60.063,"text":"Y'o ri O bi O ti duro","marked":"Y'ó rí Ọ bí Ó ti dúró"},{"start":60.513,"end":62.052,"text":"Lati pe wa lo s'orun.","marked":"Láti pè wá lọ s'ọ̀run."}],"end":62.052}]}