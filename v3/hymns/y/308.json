{"v":3,"coll":"y","num":308,"id":"hymn_308","title":"EKUN ko le gba mi","duration":69.042,"voices":{"male":{"file":"y-308-male-v3.m4a","bytes":489292,"sha256":"8a2755a7ea9b90f2c76c141b3bc16fa32480b722eb90c4cabf2710ed3154f34f","duration":69.1},"female":{"file":"y-308-female-v3.m4a","bytes":511731,"sha256":"ab9568b70980ff9331ac3d61067872af2a405bddefe7d70ee27fcf174481cac8","duration":69.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.646,"text":"EKUN ko le gba mi,","marked":"Ẹkún kò lè gbà mí"},{"start":2.096,"end":3.827,"text":"Bi mo le f'ekun we 'ju;","marked":"Bí mo lè f'ẹkún wẹ̀ ju"},{"start":4.277,"end":5.499,"text":"Ko le mu eru mi tan,","marked":"Kò lè mú ẹ̀rù mi tán"},{"start":5.949,"end":7.388,"text":"Ko le we ese mi nu;","marked":"Kò lè wẹ ẹsẹ̀ mi nù"},{"start":7.838,"end":9.275,"text":"Ekin ko le gba mi.","marked":"Ẹ̀kín kò lè gbà mí."},{"start":9.725,"end":11.782,"text":"Egbe: Jesu sun, O ku fun mi,","marked":"Jésù sùn, Ó kú fún mi"},{"start":12.232,"end":13.585,"text":"O jiya lori igi","marked":"Ó jìyà lórí igi"},{"start":14.035,"end":15.559,"text":"Lati so mi d'ominira","marked":"Láti sọ mí d'òmìnira"},{"start":16.009,"end":17.325,"text":"On na l'O le gba mi.","marked":"Ọ́n nà l'Ó lè gbà mí."}],"end":17.325},{"key":"CHORUS","start":18.275,"lines":[{"start":18.275,"end":20.216,"text":"Jesu sun, O ku fun mi,","marked":"Jésù sùn, Ó kú fún mi"},{"start":20.666,"end":21.941,"text":"O jiya lori igi","marked":"Ó jìyà lórí igi"},{"start":22.391,"end":24.01,"text":"Lati so mi d'ominira","marked":"Láti sọ mí d'òmìnira"},{"start":24.46,"end":25.603,"text":"On na l'O le gba mi.","marked":"Ọ́n nà l'Ó lè gbà mí."}],"end":25.603},{"key":"2","start":26.553,"lines":[{"start":26.553,"end":27.749,"text":"lse ko le gba mi","marked":"Iṣẹ́ kò lè gbà mí"},{"start":28.199,"end":29.462,"text":"lse mi t'o dara ju","marked":"Iṣẹ́ mi t'ó dára jù"},{"start":29.912,"end":31.126,"text":"Ero mi t'o mo julo","marked":"Èrò mi t'ó mọ́ jùlọ"},{"start":31.576,"end":32.835,"text":"Ko le s'okan mi d'otun","marked":"Kò lè s'ọkàn mi d'ọ̀tun"},{"start":33.285,"end":34.754,"text":"Ise ko le gba mi.","marked":"Iṣẹ́ kò lè gbà mí."},{"start":35.204,"end":37.231,"text":"Egbe: Jesu sun, O ku fun mi...","marked":"Jésù sùn, Ó kú fún mi"}],"end":37.231},{"key":"3","start":38.181,"lines":[{"start":38.181,"end":39.336,"text":"'Duro ko le gba mi","marked":"dúró kò lè gbà mí"},{"start":39.786,"end":41.608,"text":"Enit'o junu ni mi","marked":"Ẹnit'ó jùnú ni mí"},{"start":42.058,"end":43.783,"text":"L'eti mi l'anu nke pe","marked":"L'etí mi l'àánú ńké pé"},{"start":44.233,"end":45.591,"text":"Bi mo ba duro ngo ku","marked":"Bí mo bá dúró ńgọ́ kú"},{"start":46.041,"end":47.146,"text":"'Duro ko le gba mi.","marked":"dúró kò lè gbà mí."},{"start":47.596,"end":49.562,"text":"Egbe: Jesu sun, O ku fun mi...","marked":"Jésù sùn, Ó kú fún mi"}],"end":49.562},{"key":"4","start":50.512,"lines":[{"start":50.512,"end":51.569,"text":"Igbagbo le gba mi","marked":"Ìgbàgbọ́ lè gbà mí"},{"start":52.019,"end":53.267,"text":"Jeki ngbekel'Omo Re","marked":"Jẹ́kí ńgbẹ́kẹ̀l'ọmọ Rẹ"},{"start":53.717,"end":55.193,"text":"Jeki ngbekele s'ise Re","marked":"Jẹ́kí ńgbẹ́kẹ̀lé s'iṣẹ́ Rẹ"},{"start":55.643,"end":56.94,"text":"Jeki nsa si apa Re","marked":"Jẹ́kí ńṣà sí apá Rẹ"},{"start":57.39,"end":58.54,"text":"Igbagbo le gba mi.","marked":"Ìgbàgbọ́ lè gbà mí."},{"start":58.99,"end":60.902,"text":"Egbe: Jesu sun, O ku fun mi,","marked":"Jésù sùn, Ó kú fún mi"},{"start":61.352,"end":62.714,"text":"O jiya lori igi","marked":"Ó jìyà lórí igi"},{"start":63.164,"end":64.792,"text":"Lati so mi d'ominira","marked":"Láti sọ mí d'òmìnira"},{"start":65.242,"end":66.457,"text":"On na l'O le gba mi.","marked":"Ọ́n nà l'Ó lè gbà mí."},{"start":66.907,"end":67.493,"text":"Amin.","marked":"Àmín."}],"end":67.493}]}