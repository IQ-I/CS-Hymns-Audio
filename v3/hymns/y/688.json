{"v":3,"coll":"y","num":688,"id":"hymn_688","title":"WO awon apere wonni","duration":49.424,"voices":{"male":{"file":"y-688-male-v3.m4a","bytes":343359,"sha256":"6faf1e4420024b0f5fc8efb67d56cfd76816d1f2815cab6777501ed49573d01f","duration":49.5},"female":{"file":"y-688-female-v3.m4a","bytes":354026,"sha256":"0d3f2cda19ca0f55e2446d37d511286f680a4751a93c22ab8c0d67ad5f6f22d7","duration":49.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.334,"text":"WO awon apere wonni","marked":"Wo àwọn apẹ̀rẹ̀ wọnni"},{"start":1.784,"end":3.108,"text":"Ti mbe n'nu Bibeli","marked":"Ti mbẹ́ n'nú Bíbélì"},{"start":3.558,"end":5.407,"text":"T'awon t'o fe Isin Jesu","marked":"T'àwọn t'ó fẹ́ Ìsìn Jésù"},{"start":5.857,"end":6.99,"text":"Lati 'gba ewe won.","marked":"Láti gba èwe wọn."}],"end":6.99},{"key":"2","start":7.94,"lines":[{"start":7.94,"end":10.059,"text":"Jesu, Ọba l'oke ọrun,","marked":"Jésù, Ọba l'òkè ọ̀run"},{"start":10.509,"end":11.567,"text":"T'ọla Rẹ kun ayé,","marked":"T'ọlá Rẹ kún ayé"},{"start":12.017,"end":13.275,"text":"Jẹ ọmọde bi emi ri,","marked":"Jẹ́ ọmọdé bí èmi rí"},{"start":13.725,"end":15.072,"text":"O n p'ofin Baba mọ.","marked":"Ó ń p'òfin Baba mọ́."}],"end":15.072},{"key":"3","start":16.022,"lines":[{"start":16.022,"end":17.363,"text":"Mejila pere l'ọdun Rẹ;","marked":"Méjìlá péré l'ọdún Rẹ"},{"start":17.813,"end":19.016,"text":"'Gb'o n damu awọn Ju;","marked":"gb'ó ń dàmú àwọn Jù"},{"start":19.466,"end":21.643,"text":"Sugbọn sibẹ, o tẹriba,","marked":"Sùgbọ́n síbẹ̀, ó tẹríba"},{"start":22.093,"end":23.283,"text":"O si gbọ t'iya Rẹ.","marked":"Ó sì gbọ́ t'ìyá Rẹ̀."}],"end":23.283},{"key":"4","start":24.233,"lines":[{"start":24.233,"end":25.626,"text":"B'awọn agba ti n kẹgan to,","marked":"B'àwọn àgbà tí ń kẹ́gàn tó"},{"start":26.076,"end":27.183,"text":"Ti wọn n s'abuku Rẹ,","marked":"Tí wọ́n ń s'àbùkù Rẹ̀"},{"start":27.633,"end":29.136,"text":"Bẹ l'awọn ewe yin logo,","marked":"Bẹ́ l'àwọn èwe yín lógo"},{"start":29.586,"end":31.059,"text":"Ti wọn n ke Hosanna!","marked":"Tí wọ́n ń ké Hosanna!"}],"end":31.059},{"key":"5","start":32.009,"lines":[{"start":32.009,"end":34.102,"text":"Bi Samueli, Timoti,","marked":"Bí Samuẹli, Timoti"},{"start":34.552,"end":35.66,"text":"Lat' igba ewe wọn;","marked":"Lát ìgbà èwe wọn"},{"start":36.11,"end":37.637,"text":"Ti n f'itara sin Oluwa,","marked":"Tí ń f'ìtara sin Olúwa"},{"start":38.087,"end":39.59,"text":"Bẹ l'o yẹ ki n ma se.","marked":"Bẹ́ l'ó yẹ kí n má ṣe."}],"end":39.59},{"key":"6","start":40.54,"lines":[{"start":40.54,"end":42.496,"text":"Ko tọ ki n f'isin Oluwa,","marked":"Kò tọ́ kí n f'ìsìn Olúwa"},{"start":42.946,"end":44.063,"text":"Se 'jafara rara;","marked":"Ṣe jáfara rárá"},{"start":44.513,"end":46.449,"text":"Ki y'o di ọla ki n to bẹrẹ,","marked":"Kí y'ó di ọlá kí n tó bẹ̀rẹ̀"},{"start":46.899,"end":47.874,"text":"Si isẹ rere yi.","marked":"Sí isẹ́ rere yí."}],"end":47.874}]}