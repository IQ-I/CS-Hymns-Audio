{"v":3,"coll":"y","num":733,"id":"hymn_733","title":"EGBE Kerubu Serafu","duration":73.225,"voices":{"male":{"file":"y-733-male-v3.m4a","bytes":515982,"sha256":"99a22ce705910a7657a37831aa3989324f9fe4f3b3b1eec9e76291d3b46fd194","duration":73.3},"female":{"file":"y-733-female-v3.m4a","bytes":538376,"sha256":"ccd87d2a4cffc66fd1802dbb2aad441a74d64b000e149dbf1c3984a2cdaa9f74","duration":73.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.597,"text":"ẸGBẸ Kérúbù Seraf'","marked":"Ẹgbẹ́ Kérúbù Seraf"},{"start":2.047,"end":3.133,"text":"Ẹgbẹ ogun ọrun,","marked":"Ẹgbẹ́ ogun ọ̀run"},{"start":3.583,"end":4.906,"text":"Ẹgbẹ awọn Apostel,","marked":"Ẹgbẹ́ àwọn Apostel"},{"start":5.356,"end":6.349,"text":"Ẹgbẹ Ijọ Mimọ,","marked":"Ẹgbẹ́ Ìjọ Mímọ́"},{"start":6.799,"end":7.857,"text":"Gbogbo wọn loke ọrun,","marked":"Gbogbo wọn lókè ọ̀run"},{"start":8.307,"end":10.368,"text":"N yin Ọ t'ọsan, t'oru,","marked":"N yín Ọ t'ọ̀sán, t'òru"},{"start":10.818,"end":11.942,"text":"W'Ọlọrun Mẹtalọkan;","marked":"W'Ọlọ́run Mẹ́talọ́kan"},{"start":12.392,"end":13.673,"text":"Ọga Ogo julọ.","marked":"Ọ̀gá Ògo jùlọ."}],"end":13.673},{"key":"2","start":14.623,"lines":[{"start":14.623,"end":15.792,"text":"Awa Ẹgbẹ Séráfù,","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":16.242,"end":18.203,"text":"Ayé yin Ọ, Baba,","marked":"Ayé yín Ọ, Baba"},{"start":18.653,"end":20.552,"text":"Ifẹ Tirẹ ni ki a se,","marked":"Ìfẹ́ Tirẹ̀ ni kí a ṣe"},{"start":21.002,"end":22.191,"text":"Bi wọn ti n se lọrun;","marked":"Bí wọ́n ti ń ṣe lọ́rùn"},{"start":22.641,"end":24.007,"text":"Pẹlu wa b'a ti pejọ,","marked":"Pẹ̀lú wa b'á ti péjọ"},{"start":24.457,"end":25.572,"text":"Jẹ k'a le sin l'emi,","marked":"Jẹ́ k'á lè sin l'èmi"},{"start":26.022,"end":27.763,"text":"Baba wa, jọ sọkalẹ,","marked":"Baba wa, jọ sọ̀kalẹ̀"},{"start":28.213,"end":29.454,"text":"F'ogo Rẹ han nihin.","marked":"F'ògo Rẹ̀ hàn níhìn."}],"end":29.454},{"key":"3","start":30.404,"lines":[{"start":30.404,"end":31.612,"text":"Larin ainiye ibi,","marked":"Lárin àìníye ibi"},{"start":32.062,"end":33.36,"text":"To rọgba yi wa ka,","marked":"Tó rọ̀gbà yí wa ká"},{"start":33.81,"end":35.844,"text":"Larin 'jamba oun 'pọnju,","marked":"Lárin jamba òun 'pọnju"},{"start":36.294,"end":37.383,"text":"To ja ni igboro wa;","marked":"Tó jà ní ìgboro wa"},{"start":37.833,"end":38.982,"text":"Emi o f'ọpẹ fun Ọ,","marked":"Èmi ó f'ọpẹ́ fún Ọ"},{"start":39.432,"end":40.753,"text":"Tori Iwọ da mi si:","marked":"Torí Ìwọ dá mi sí"},{"start":41.203,"end":42.303,"text":"Ọba Afẹnifẹ-re,","marked":"Ọba Afẹnifẹ-re"},{"start":42.753,"end":44.002,"text":"Ogo f'Orukọ Rẹ.","marked":"Ògo f'Orúkọ Rẹ."}],"end":44.002},{"key":"4","start":44.952,"lines":[{"start":44.952,"end":46.317,"text":"'Gba Noah rubọ ọpẹ,","marked":"gba Noah rúbọ ọpẹ́"},{"start":46.767,"end":47.969,"text":"'Wọ f'osumare han;","marked":"'Wọ f'òṣùmárè hàn"},{"start":48.419,"end":49.607,"text":"Majẹmu pe ikunmi,","marked":"Májẹ̀mú pé ìkunmi"},{"start":50.057,"end":51.036,"text":"Ki yoo bo ayé mọ;","marked":"Kì yóò bo ayé mọ́"},{"start":51.486,"end":52.795,"text":"Baba f'osumare han,","marked":"Baba f'òṣùmárè hàn"},{"start":53.245,"end":54.479,"text":"N'irubọ isin wa,","marked":"N'ìrúbọ ìsìn wa"},{"start":54.929,"end":56.101,"text":"K'a mase ri ibi mọ,","marked":"K'á máṣe rí ibi mọ́"},{"start":56.551,"end":57.562,"text":"Jekejado 'le wa.","marked":"Jèkéjádò lè wà."}],"end":57.562},{"key":"5","start":58.512,"lines":[{"start":58.512,"end":59.75,"text":"'Wọ lo d'Ẹgbẹ yi silẹ,","marked":"'Wọ ló d'Ẹgbẹ́ yí sílẹ̀"},{"start":60.2,"end":61.431,"text":"Se Ẹgbẹ na logo;","marked":"Ṣe Ẹgbẹ́ ná lógo"},{"start":61.881,"end":63.441,"text":"S'Amọna at'Odi rẹ,","marked":"S'Amọ̀nà àt'odi rẹ̀"},{"start":63.891,"end":64.973,"text":"Larin 'danwo ayé;","marked":"Lárin dánwò ayé"},{"start":65.423,"end":66.465,"text":"Baba Olodumare;","marked":"Baba Olódùmarè"},{"start":66.915,"end":68.389,"text":"'Wọ lo n pe ko yẹni;","marked":"'Wọ ló ń pè kó yẹni"},{"start":68.839,"end":70.218,"text":"Jẹ k'o y'Ẹgbẹ yi kalẹ,","marked":"Jẹ́ k'ó y'Ẹgbẹ́ yí kalẹ̀"},{"start":70.668,"end":71.677,"text":"Nitori Ọmọ Rẹ.","marked":"Nítorí Ọmọ Rẹ."}],"end":71.677}]}