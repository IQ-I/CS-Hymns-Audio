{"v":3,"coll":"y","num":714,"id":"hymn_714","title":"ISODOMO akoko","duration":55.903,"voices":{"male":{"file":"y-714-male-v3.m4a","bytes":383264,"sha256":"372a96a4c6737cf0d7912f6dcde83d6fb8afb5cb14023e77753508f5fa7ecaa0","duration":56.0},"female":{"file":"y-714-female-v3.m4a","bytes":400949,"sha256":"6224f37113a5bf8caf5ed81e48fcf5742caed1364b7e26e8323cc105a3c68815","duration":56.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.884,"text":"ISODOMO akoko","marked":"Ìsọdọmọ àkọ́kọ́"},{"start":2.334,"end":3.544,"text":"Jesu Olugbala","marked":"Jésù Olùgbàlà"},{"start":3.994,"end":5.179,"text":"Isodomo ikehin","marked":"Ìsọdọmọ ìkẹhìn"},{"start":5.629,"end":6.976,"text":"Mose Orimolade.","marked":"Mósè Orímọ́ládé."}],"end":6.976},{"key":"CHORUS","start":7.926,"lines":[{"start":7.926,"end":9.761,"text":"Ngo fo, ngo fo bayi","marked":"Ngọ́ fọ́, ngọ́ fọ́ báyì"},{"start":10.211,"end":11.872,"text":"Ngo yo, ngo sese","marked":"Ngọ́ yọ̀, ngọ́ ṣẹ̀ṣẹ̀"},{"start":12.322,"end":13.73,"text":"Ngo korin Angeli","marked":"Ǹgọ́ kọrin Áńgẹ́lì"},{"start":14.18,"end":15.312,"text":"Halleluya Ogo.","marked":"Hallelúyà Ògo."}],"end":15.312},{"key":"2","start":16.262,"lines":[{"start":16.262,"end":17.788,"text":"Kini se t'e nyo bayi","marked":"Kíni ṣe t'é ńyọ̀ báyì"},{"start":18.238,"end":19.543,"text":"Pelu mope owo nyin","marked":"Pẹ̀lú mọpẹ́ ọwọ́ yín"},{"start":19.993,"end":21.424,"text":"Awa ri Jesu loni","marked":"Àwa rí Jésù lónì"},{"start":21.874,"end":23.034,"text":"Ati Olorun Baba.","marked":"Àti Ọlọ́run Baba."}],"end":23.034},{"key":"3","start":23.984,"lines":[{"start":23.984,"end":26.018,"text":"Kerubu, Serafu aiye","marked":"Kérúbù, Séráfù ayé"},{"start":26.468,"end":27.719,"text":"Ayo lo po to bayi","marked":"Ayọ̀ ló pọ̀ tó báyì"},{"start":28.169,"end":29.846,"text":"Aso funfun Ade Ogo","marked":"Aṣọ funfun Adé Ògo"},{"start":30.296,"end":31.552,"text":"Jesu ti fi fun wa.","marked":"Jésù ti fi fún wa."}],"end":31.552},{"key":"4","start":32.502,"lines":[{"start":32.502,"end":34.164,"text":"Jesu ko oruko siwaju wa","marked":"Jésù kọ orúkọ síwájú wa"},{"start":34.614,"end":35.862,"text":"Oruko ti Baba Re","marked":"Orúkọ ti Baba Rẹ"},{"start":36.312,"end":37.749,"text":"Oruko t'Angeli ko mo","marked":"Orúkọ t'Áńgẹ́lì kò mọ̀"},{"start":38.199,"end":39.668,"text":"A f'awa t'a fifun.","marked":"A f'àwa t'á fífún."}],"end":39.668},{"key":"5","start":40.618,"lines":[{"start":40.618,"end":42.0,"text":"A o ba Jesu joba","marked":"A ó bá Jésù jọba"},{"start":42.45,"end":43.446,"text":"Ni Egberun odun","marked":"Ní Ẹgbẹ̀rún ọdún"},{"start":43.896,"end":45.192,"text":"Lehin na a o joba","marked":"Lẹ́hìn ná a ó jọba"},{"start":45.642,"end":46.956,"text":"Aiye ainipekun.","marked":"Ayé àìnípẹ̀kun."}],"end":46.956},{"key":"6","start":47.906,"lines":[{"start":47.906,"end":49.09,"text":"A ki Oloye meta","marked":"A kí Olóye mẹ́ta"},{"start":49.54,"end":50.587,"text":"E ku ori ire","marked":"Ẹ kú orí ìre"},{"start":51.037,"end":52.112,"text":"At' agbagba Obinrin","marked":"Àt àgbàgbà Obìnrin"},{"start":52.562,"end":54.354,"text":"lru eyi s'oju emi wa.","marked":"Irú èyí s'ojú èmi wà."}],"end":54.354}]}