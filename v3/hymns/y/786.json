{"v":3,"coll":"y","num":786,"id":"hymn_786","title":"A DUPE lowo Olorun","duration":119.956,"voices":{"male":{"file":"y-786-male-v3.m4a","bytes":859808,"sha256":"89457f7418de9dee8ab0330474d52cb61709e094a6d4bf36919edda3ad941aad","duration":120.0},"female":{"file":"y-786-female-v3.m4a","bytes":891311,"sha256":"7714c5095f3372f16d7487165666010c86f1dbe3afcb0aeda2afc2241c45780b","duration":120.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.415,"text":"A DUPE lowo Olorun","marked":"A Dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":1.865,"end":3.456,"text":"T'O fi Jesu kristi fun wa,","marked":"T'Ó fi Jésù Kristi fún wa"},{"start":3.906,"end":5.241,"text":"Lati ra raiye pada","marked":"Láti ra ràìyè padà"},{"start":5.691,"end":7.528,"text":"Lowo ese ati esu.","marked":"Lọ́wọ́ ẹ̀ṣẹ̀ àti èṣù."}],"end":7.528},{"key":"CHORUS","start":8.478,"lines":[{"start":8.478,"end":10.154,"text":"Egbe: E yin logo, e f'ope fun","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"},{"start":10.604,"end":11.651,"text":"Olorun Metalokan","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":12.101,"end":13.493,"text":"Fun anu at'ore Re","marked":"Fún àánú àt'ọrẹ Rẹ"},{"start":13.943,"end":15.469,"text":"Lori gbogbo Egbe Serafu.","marked":"Lórí gbogbo Ẹgbẹ́ Séráfù."}],"end":15.469},{"key":"2","start":16.419,"lines":[{"start":16.419,"end":17.641,"text":"Agbara Olorun ndagba","marked":"Agbára Ọlọ́run ńdàgbà"},{"start":18.091,"end":19.785,"text":"Ogo Jesu nhan si wa","marked":"Ògo Jésù ńhán sí wa"},{"start":20.235,"end":21.535,"text":"Agbara Emi Mimo wa,","marked":"Agbára Ẹ̀mí Mímọ́ wà"},{"start":21.985,"end":23.311,"text":"Larin Egbe Serafu.","marked":"Lárin Ẹgbẹ́ Séráfù."},{"start":23.761,"end":25.632,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":25.632},{"key":"3","start":26.582,"lines":[{"start":26.582,"end":28.427,"text":"Gbogbo enia at'orile-ede","marked":"Gbogbo ènìà at'orile-ede"},{"start":28.877,"end":30.247,"text":"Dorikodo s'adura","marked":"Doríkodò s'àdúrà"},{"start":30.697,"end":32.209,"text":"E yipada l'emi oto","marked":"Ẹ yípadà l'ẹ̀mí ọ̀tọ̀"},{"start":32.659,"end":34.015,"text":"Ki Baba orun gba wa.","marked":"Kí Baba ọ̀run gbà wá."},{"start":34.465,"end":35.972,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":35.972},{"key":"4","start":36.922,"lines":[{"start":36.922,"end":39.217,"text":"Ese po, aiye yi daru","marked":"Ẹ̀ṣẹ̀ pọ̀, ayé yí dàrú"},{"start":39.667,"end":41.947,"text":"Esu njale, o si nyo","marked":"Èṣù ńjalè, ó sì ńyọ"},{"start":42.397,"end":44.056,"text":"K'onigbagbo pe adura po","marked":"K'onígbàgbọ́ pé àdúrà pọ̀"},{"start":44.506,"end":46.501,"text":"K'a Ie segun ese at'esu.","marked":"K'á lè ṣẹ́gun ẹ̀ṣẹ̀ àt'eṣú."},{"start":46.951,"end":48.776,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":48.776},{"key":"5","start":49.726,"lines":[{"start":49.726,"end":51.706,"text":"Olufokansin onigbagbo","marked":"Olùfọkànsìn onígbàgbọ́"},{"start":52.156,"end":53.763,"text":"Jesu mo ise ikoko re","marked":"Jésù mọ iṣẹ́ ìkọ̀kọ̀ rẹ̀"},{"start":54.213,"end":56.032,"text":"Mase lo, l'ohun Oluwa nwi","marked":"Mase lọ, l'ohun Olúwa ńwí"},{"start":56.482,"end":57.717,"text":"Oluko re nsunmole.","marked":"Olùkọ́ rẹ̀ ńsúnmọ́lẹ̀."},{"start":58.167,"end":59.852,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":59.852},{"key":"6","start":60.802,"lines":[{"start":60.802,"end":62.875,"text":"Kerubu, Serafu, mura","marked":"Kérúbù, Séráfù, múra"},{"start":63.325,"end":65.632,"text":"Alufa, Bishop, mura","marked":"Àlùfá, Bishop, múra"},{"start":66.082,"end":68.292,"text":"Enyin to mo Jesu, e mura","marked":"Ẹ̀yin tó mọ Jésù, ẹ múra"},{"start":68.742,"end":70.434,"text":"Lojo kehin ojo dajo.","marked":"Lọ́jọ́ kẹhìn ọjọ́ dájọ́."},{"start":70.884,"end":72.664,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":72.664},{"key":"7","start":73.614,"lines":[{"start":73.614,"end":75.314,"text":"Ajodun miran l'awa nse","marked":"Àjọ̀dún míràn l'àwa ńṣe"},{"start":75.764,"end":76.721,"text":"T'Olorun ran Moses","marked":"T'Ọlọ́run rán Moses"},{"start":77.171,"end":78.84,"text":"Lati s'egbe yi loruko","marked":"Láti s'ègbé yí lórúkọ"},{"start":79.29,"end":80.596,"text":"Ogun orun Serafu.","marked":"Ogun ọ̀run Séráfù."},{"start":81.046,"end":82.68,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":82.68},{"key":"8","start":83.63,"lines":[{"start":83.63,"end":85.862,"text":"Egbe Mose, e mura dide","marked":"Ẹgbẹ́ Mósè, ẹ múra dìde"},{"start":86.312,"end":88.767,"text":"Larin egbe Kerubu, Serafu","marked":"Lárin ẹgbẹ́ Kérúbù, Séráfù"},{"start":89.217,"end":90.459,"text":"Olorun Baba lo fun wa","marked":"Ọlọ́run Baba lọ fún wa"},{"start":90.909,"end":92.273,"text":"Gbe asia re soke.","marked":"Gbé àsíá rẹ̀ sókè."},{"start":92.723,"end":94.298,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":94.298},{"key":"9","start":95.248,"lines":[{"start":95.248,"end":97.756,"text":"Keferi, Imale, ewa","marked":"Kèfèrí, Ìmàlẹ̀, ẹwà"},{"start":98.206,"end":100.173,"text":"Onigbagbo, e ma kalo","marked":"Onígbàgbọ́, ẹ má kálọ"},{"start":100.623,"end":102.002,"text":"Ka jo yin Olorun logo","marked":"Ká jọ yín Ọlọ́run lógo"},{"start":102.452,"end":103.892,"text":"Ka le gba ade iye.","marked":"Ká lè gba adé ìyè."},{"start":104.342,"end":106.102,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"}],"end":106.102},{"key":"10","start":107.052,"lines":[{"start":107.052,"end":108.206,"text":"Olorun Baba sanu wa","marked":"Ọlọ́run Baba ṣanú wa"},{"start":108.656,"end":110.767,"text":"Dariji wa, pa wa mo","marked":"Dáríjì wá, pa wá mọ́"},{"start":111.217,"end":113.167,"text":"Ran wa lowo, gbadura wa","marked":"Ràn wá lọ́wọ́, gbàdúrà wa"},{"start":113.617,"end":115.146,"text":"Titi aiye ainipekun.","marked":"Títí ayé àìnípẹ̀kun."},{"start":115.596,"end":117.375,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yín lógo, ẹ f'ọpẹ́ fún"},{"start":117.825,"end":118.408,"text":"Amin.","marked":"Àmín."}],"end":118.408}]}