{"v":3,"coll":"y","num":71,"id":"hymn_71","title":"GBANGBA l'oju Re Olorun","duration":47.359,"voices":{"male":{"file":"y-71-male-v3.m4a","bytes":326212,"sha256":"0d4e1d01b24e9969b5eb514300bf5332602ab7a7879210da08fd2c15059a12c4","duration":47.4},"female":{"file":"y-71-female-v3.m4a","bytes":348297,"sha256":"7fe5f33f7b01577618ead6d56a1be8688fc345b5372fbe6e48634fa7d769fa12","duration":47.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.552,"text":"GBANGBA l'oju Rẹ Ọlọrun,","marked":"Gbangba l'ojú Rẹ Ọlọ́run"},{"start":2.002,"end":3.409,"text":"Sohun gbogbo ta n se;","marked":"Sohun gbogbo ta ń ṣe"},{"start":3.859,"end":5.725,"text":"T'ọsan t'oru bakan naa ni,","marked":"T'ọ̀sán t'òru bákan náà ni"},{"start":6.175,"end":7.367,"text":"Loju Oluwa wa.","marked":"Lójú Olúwa wa."}],"end":7.367},{"key":"2","start":8.317,"lines":[{"start":8.317,"end":10.472,"text":"Ko s'ese kan ti a le da","marked":"Kò s'ẹ̀ṣẹ̀ kan tí a lè dá"},{"start":10.922,"end":12.305,"text":"Ko s'oro t'a le so","marked":"Kò s'ọ̀rọ̀ t'á lè sọ"},{"start":12.755,"end":14.091,"text":"Ti ko si ninu iwe Re","marked":"Tí kò sí nínú ìwé Rẹ"},{"start":14.541,"end":15.586,"text":"Fun iranti gbogbo.","marked":"Fún ìrántí gbogbo."}],"end":15.586},{"key":"3","start":16.536,"lines":[{"start":16.536,"end":18.237,"text":"Ese ole, ese iro","marked":"Ẹsẹ̀ olè, ẹsẹ̀ irọ́"},{"start":18.687,"end":19.859,"text":"Ese aiforiji","marked":"Ẹ̀ṣẹ̀ àìforíjì"},{"start":20.309,"end":21.828,"text":"Ese ka soro eni lehin","marked":"Ẹ̀ṣẹ̀ ká sọ̀rọ̀ ẹni lẹ́hìn"},{"start":22.278,"end":23.554,"text":"Baba dariji wa.","marked":"Baba dáríjì wá."}],"end":23.554},{"key":"4","start":24.504,"lines":[{"start":24.504,"end":25.678,"text":"Ese igberaga okan","marked":"Ẹ̀ṣẹ̀ ìgbéraga ọkàn"},{"start":26.128,"end":27.216,"text":"Ese isokuso","marked":"Ẹ̀ṣẹ̀ ìsọkúsọ"},{"start":27.666,"end":29.276,"text":"Ese aini 'gbagbo daju","marked":"Ẹsẹ̀ àìní gbàgbọ́ dájú"},{"start":29.726,"end":30.963,"text":"Baba dariji wa.","marked":"Baba dáríjì wá."}],"end":30.963},{"key":"5","start":31.913,"lines":[{"start":31.913,"end":33.373,"text":"A! l'ọjọ nla ọjọ 'dajọ,","marked":"A! l'ọjọ́ ńlá ọjọ́ 'dajọ"},{"start":33.823,"end":34.985,"text":"Ma jẹ k'oju tiwa;","marked":"Má jẹ́ k'ojú tiwa"},{"start":35.435,"end":36.665,"text":"T'oju gbogbo ayé yoo pe,","marked":"T'ojú gbogbo ayé yóò pé"},{"start":37.115,"end":38.431,"text":"Baba dariji wa.","marked":"Baba dáríjì wá."}],"end":38.431},{"key":"6","start":39.381,"lines":[{"start":39.381,"end":40.568,"text":"Dariji mi Ọlọrun mi,","marked":"Dáríjì mi Ọlọ́run mi"},{"start":41.018,"end":42.39,"text":"Ki n to lọ layé yi;","marked":"Kí n tó lọ layé yí"},{"start":42.84,"end":44.056,"text":"Si pa gbogbo ẹsẹ mi rẹ,","marked":"Sì pa gbogbo ẹsẹ̀ mi rẹ"},{"start":44.506,"end":45.81,"text":"Baba dariji mi.","marked":"Baba dáríjì mi."}],"end":45.81}]}