{"v":3,"coll":"y","num":541,"id":"hymn_541","title":"JESU mo gb'agbelebu mi","duration":65.139,"voices":{"male":{"file":"y-541-male-v3.m4a","bytes":465837,"sha256":"ac6fbdba7b01ebe0e54a3211c50b54125d0ff2d01406b10331bd821446e23050","duration":65.2},"female":{"file":"y-541-female-v3.m4a","bytes":486949,"sha256":"f2e2179abb9ae7a5913c10245a3a41478c318aadd90f3d15e277be7c47474ac6","duration":65.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.88,"text":"JESU mo gb'agbelebu mi,","marked":"Jésù mo gb'àgbélébù mi"},{"start":2.33,"end":3.477,"text":"Ki nle ma to O lehin","marked":"Kí ńlè má tọ̀ Ọ́ lẹ́hìn"},{"start":3.927,"end":5.457,"text":"Otosi at'eni egan","marked":"Òtòṣì àt'ẹni ẹ̀gàn"},{"start":5.907,"end":6.967,"text":"Wo l'ohun gbogbo fun mi","marked":"Wò l'ohun gbogbo fún mi"},{"start":7.417,"end":8.789,"text":"Bi ini mi gbogbo segbe","marked":"Bí ìní mi gbogbo ṣègbé"},{"start":9.239,"end":10.365,"text":"Ti ero mi gbogbo pin","marked":"Ti èrò mi gbogbo pín"},{"start":10.815,"end":12.7,"text":"Sibe oloro ni mo je!","marked":"Síbẹ̀ ọlọ́rọ̀ ni mo jẹ́!"},{"start":13.15,"end":14.944,"text":"Temi ni Krisit' at'Orun.","marked":"Tèmi ni Krisit àt'ọ̀run."}],"end":14.944},{"key":"2","start":15.894,"lines":[{"start":15.894,"end":17.209,"text":"Eda le ma wahala mi","marked":"Ẹ̀dá lè má wàhálà mi"},{"start":17.659,"end":18.856,"text":"Y'o mu mi sunmo O ni","marked":"Y'ó mú mi súnmọ́ Ọ ní"},{"start":19.306,"end":20.581,"text":"Idanwo aiye le ba mi","marked":"Ìdánwò ayé lè bá mi"},{"start":21.031,"end":22.151,"text":"Orun o mu 'simi wa","marked":"Ọ̀run ò mú ṣímí wá"},{"start":22.601,"end":24.356,"text":"Ibanuje ko le se nkan","marked":"Ìbànújẹ́ kò lè ṣe nǹkan"},{"start":24.806,"end":26.033,"text":"B'ife R eba wa fun mi","marked":"B'ìfẹ́ R ẹ̀bá wà fún mi"},{"start":26.483,"end":27.775,"text":"Ayo ko si le dun mo mi","marked":"Ayọ̀ kò sì lè dùn mọ́ mi"},{"start":28.225,"end":29.599,"text":"B'Iwo ko si ninu re.","marked":"B'Ìwọ kò sí nínú rẹ̀."}],"end":29.599},{"key":"3","start":30.549,"lines":[{"start":30.549,"end":32.226,"text":"Okan mi, gba igbala re","marked":"Ọkàn mi, gba ìgbàlà rẹ"},{"start":32.676,"end":34.032,"text":"Bori ese at'eru","marked":"Borí ẹ̀ṣẹ̀ àt'ẹrú"},{"start":34.482,"end":36.781,"text":"F'ayo a wa ni ipokipo","marked":"F'ayọ̀ a wà ní ipòkípò"},{"start":37.231,"end":39.246,"text":"Ma sise, si ma jiya","marked":"Má ṣiṣẹ́, sì má jìyà"},{"start":39.696,"end":41.088,"text":"Ro t'Emi t'o wa ninu re?","marked":"Rò t'Èmi t'ó wà nínú rẹ̀?"},{"start":41.538,"end":42.656,"text":"At'ife Baba si O","marked":"Àt'ìfẹ́ Baba sí Ọ"},{"start":43.106,"end":44.822,"text":"W'Olugbala t'o ku fun o","marked":"W'Olùgbàlà t'ó kú fún ọ"},{"start":45.272,"end":46.942,"text":"Omo orun, ma se kun!","marked":"Ọmọ ọ̀run, má ṣe kún!"}],"end":46.942},{"key":"4","start":47.892,"lines":[{"start":47.892,"end":49.908,"text":"Nje koja lat'ore s'ogo","marked":"Ǹjẹ́ kọjá lát'ọ̀rẹ́ s'ògo"},{"start":50.358,"end":51.835,"text":"N'n'adura on igbagbo","marked":"N'ń'àdúrà ọn ìgbàgbọ́"},{"start":52.285,"end":53.509,"text":"Ojo ailopin wa fun O","marked":"Ọjọ́ àìlópin wà fún Ọ"},{"start":53.959,"end":55.333,"text":"Baba y'o mu o de be","marked":"Baba y'ó mú ọ dé bẹ"},{"start":55.783,"end":57.162,"text":"Ise re l'aiye fere pin","marked":"Iṣẹ́ rẹ̀ l'ayé fèrè pín"},{"start":57.612,"end":58.775,"text":"Ojo ajo re mbuse","marked":"Ọjọ́ àjọ rẹ̀ mbúṣẹ"},{"start":59.225,"end":60.8,"text":"Ireti y'o pada s'ayo","marked":"Ìrètí y'ó padà s'ayọ̀"},{"start":61.25,"end":62.561,"text":"Adura s'orin iyin.","marked":"Àdúrà s'orin ìyìn."},{"start":63.011,"end":63.59,"text":"Amin.","marked":"Àmín."}],"end":63.59}]}