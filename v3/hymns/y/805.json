{"v":3,"coll":"y","num":805,"id":"hymn_805","title":"OLUPAMO gbogbo eda","duration":57.519,"voices":{"male":{"file":"y-805-male-v3.m4a","bytes":405214,"sha256":"102e47db76df4d20c54f1e8cd8c59d25e83e0cc9800a1093fdfd95b2856f43d1","duration":57.6},"female":{"file":"y-805-female-v3.m4a","bytes":412558,"sha256":"3601d2804b0f15fcd55934febc52f0589c262124f3fe297bc465dce6978a4f05","duration":57.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.503,"text":"OLUPAMO gbogbo eda,","marked":"Olùpamọ́ gbogbo ẹ̀dá"},{"start":1.953,"end":3.45,"text":"Oba Asekan-maku","marked":"Ọba Asekan-maku"},{"start":3.9,"end":5.321,"text":"Awa fi malu ete wa","marked":"Àwa fi màlú ètè wa"},{"start":5.771,"end":6.872,"text":"Rubo ope si O.","marked":"Rúbọ ọpẹ́ sí Ọ."}],"end":6.872},{"key":"2","start":7.822,"lines":[{"start":7.822,"end":9.355,"text":"T'ọmọde at'agba dupẹ,","marked":"T'ọmọdé àt'àgbà dúpẹ́"},{"start":9.805,"end":11.487,"text":"F'abo Rẹ lori wa,","marked":"F'abo Rẹ̀ lórí wa"},{"start":11.937,"end":13.821,"text":"Fun ikẹ ati igẹ Rẹ,","marked":"Fún ìkẹ́ àti igẹ̀ Rẹ"},{"start":14.271,"end":15.572,"text":"Lori wa lat'esi.","marked":"Lórí wa lát'èsì."}],"end":15.572},{"key":"3","start":16.522,"lines":[{"start":16.522,"end":17.823,"text":"Ẹ bu s'ayọ ọmọ 'gun,","marked":"Ẹ bú s'ayọ̀ ọmọ gun"},{"start":18.273,"end":19.407,"text":"Ati gbogbo ẹgbẹ,","marked":"Àti gbogbo ẹgbẹ́"},{"start":19.857,"end":21.762,"text":"Ajọdun t'oni t'o ba wa,","marked":"Àjọ̀dún t'òní t'ó bá wà"},{"start":22.212,"end":23.285,"text":"Lorilẹ alaye.","marked":"Lórílẹ̀ àlàyé."}],"end":23.285},{"key":"4","start":24.235,"lines":[{"start":24.235,"end":26.615,"text":"Ẹlẹru, Niyin, a bẹ Ọ,","marked":"Ẹlẹ́rù, Nìyìn, a bẹ̀ Ọ"},{"start":27.065,"end":28.179,"text":"Se wa l'eniyan Rẹ,","marked":"Ṣe wá l'ènìyàn Rẹ"},{"start":28.629,"end":29.919,"text":"K'a mase pada lọdọ Rẹ,","marked":"K'á máṣe padà lọ́dọ̀ Rẹ"},{"start":30.369,"end":31.795,"text":"K'a le sin Ọ dopin.","marked":"K'á lè sìn Ọ́ dópin."}],"end":31.795},{"key":"5","start":32.745,"lines":[{"start":32.745,"end":34.165,"text":"Awa si mbẹbẹ siwaju,","marked":"Àwa sì mbẹ̀bẹ̀ síwájú"},{"start":34.615,"end":35.822,"text":"Nin' ọdun t'a wa yi,","marked":"Nín ọdún t'á wá yí"},{"start":36.272,"end":37.536,"text":"Fi ohun rere kari wa,","marked":"Fi ohun rere kárí wa"},{"start":37.986,"end":39.402,"text":"S'ayé wa ni rere.","marked":"S'ayé wà ní rere."}],"end":39.402},{"key":"6","start":40.352,"lines":[{"start":40.352,"end":41.841,"text":"Ọba amọna gbogb' ẹda,","marked":"Ọba amọ̀nà gbogb ẹ̀dá"},{"start":42.291,"end":43.543,"text":"S'amọna wa dopin,","marked":"S'amọ̀nà wá dópin"},{"start":43.993,"end":45.459,"text":"Ma jẹ k'esu ba wa d'ẹgbọn;","marked":"Má jẹ́ k'èṣù bá wa d'ẹ̀gbọ́n"},{"start":45.909,"end":47.245,"text":"Ma jẹ k'a padanu.","marked":"Má jẹ́ k'á pàdánù."}],"end":47.245},{"key":"7","start":48.195,"lines":[{"start":48.195,"end":50.516,"text":"B'a ti n jọsin, t'a si n yin Ọ,","marked":"B'á ti ń jọ́sìn, t'á sì ń yín Ọ"},{"start":50.966,"end":52.156,"text":"L'aginju ayé yi,","marked":"L'aginjù ayé yí"},{"start":52.606,"end":54.182,"text":"Se wa yẹ k'a tun le yin Ọ,","marked":"Ṣé wá yẹ k'á tún lè yín Ọ"},{"start":54.632,"end":55.969,"text":"Loke ọrun pẹlu.","marked":"Lókè ọ̀run pẹ̀lú."}],"end":55.969}]}