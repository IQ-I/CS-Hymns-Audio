{"v":3,"coll":"y","num":799,"id":"hymn_799","title":"OBA rere wa gbo","duration":52.563,"voices":{"male":{"file":"y-799-male.m4a","bytes":371276,"sha256":"96b77af26fd9d010e34ecdda409fbd98925aa11d7a77eb3468321744c29a8be8","duration":52.6},"female":{"file":"y-799-female.m4a","bytes":382866,"sha256":"263ff2d2f20dbeeb870a76a7403de4f86d887dafcca8814a91858f29cc3e506f","duration":52.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.558,"text":"Oba rere wa wa gbo - 2ce","marked":"Ọba rere wa wá gbọ́"},{"start":1.938,"end":3.368,"text":"F'ire fun wa loni Baba o","marked":"F'ire fún wa lọ́ni Bàbá o"},{"start":3.748,"end":5.521,"text":"Ye dakun, Baba rere.","marked":"Yé dákun, Bàbá rere."}],"end":5.521},{"key":"CHORUS","start":6.471,"lines":[{"start":6.471,"end":8.298,"text":"Ire-Ire o, Baba - 2ce","marked":"Irè-Irè o, Bàbá"},{"start":8.678,"end":11.053,"text":"Ire owo ni-Ire o, Baba","marked":"Irè owó ni-Ire o, Bàbá"},{"start":11.433,"end":14.268,"text":"Ire omo ni-Ire o, Baba,","marked":"Irè ọmọ ni-Ire o, Bàbá"},{"start":14.648,"end":17.072,"text":"K'a agbadura ire ti mbe n'isale","marked":"K'á àgbàdúrà ire ti ḿbẹ n'ísàlẹ̀"},{"start":17.452,"end":20.243,"text":"Eyiti mbo loke, ma fi wa sehin;","marked":"Èyítì mbo lókè, má fi wá sẹ́hìn"},{"start":20.623,"end":21.455,"text":"Baba rere.","marked":"Bàbá rere."}],"end":21.455},{"key":"2","start":22.405,"lines":[{"start":22.405,"end":23.493,"text":"A juba Ajodun - 2ce","marked":"A júbà Àjọ̀dún"},{"start":23.873,"end":25.555,"text":"K'ajodun yi san wa loni o","marked":"K'àjọ̀dún yí san wá lónì o"},{"start":25.935,"end":27.352,"text":"K'a r'ire kari kari.","marked":"K'á r'ire kárí kárí."}],"end":27.352},{"key":"3","start":28.302,"lines":[{"start":28.302,"end":29.662,"text":"K'a gbadun ajodun 2ce","marked":"K'á gbádùn àjọ̀dún"},{"start":30.042,"end":31.983,"text":"K'ajodun yi an wa loni o","marked":"K'àjọ̀dún yí an wá lónì o"},{"start":32.363,"end":33.798,"text":"K'a r'ire kari kari.","marked":"K'á r'ire kárí kárí."}],"end":33.798},{"key":"4","start":34.748,"lines":[{"start":34.748,"end":35.64,"text":"Olu Orun ye - 2ce","marked":"Olú Ọ̀run yè"},{"start":36.02,"end":37.534,"text":"Ki a to pada sile wa o","marked":"Kí á tó padà sílé wa o"},{"start":37.914,"end":39.16,"text":"K'a r'ire Baba rere.","marked":"K'á r'ire Bàbá rere."}],"end":39.16},{"key":"5","start":40.11,"lines":[{"start":40.11,"end":41.207,"text":"Olubukun ni O - 2ce","marked":"Olùbùkún ni O"},{"start":41.587,"end":43.084,"text":"Bukun fun wa loni Baba o,","marked":"Bùkún fún wa lọ́ni Bàbá o"},{"start":43.464,"end":45.116,"text":"Ye dakun, Eni rere.","marked":"Yé dákun, Ẹni rere."}],"end":45.116},{"key":"6","start":46.066,"lines":[{"start":46.066,"end":47.153,"text":"Olupese ni o - 2ce","marked":"Olùpèsè ni o"},{"start":47.533,"end":49.077,"text":"Pese fun wa loni Baba o","marked":"Pèsè fún wa lọ́ni Bàbá o"},{"start":49.457,"end":51.013,"text":"Ye dakun, Baba rere.","marked":"Yé dákun, Bàbá rere."}],"end":51.013}]}