{"v":3,"coll":"y","num":701,"id":"hymn_701","title":"OLUWA, a gbe okan wa","duration":64.19,"voices":{"male":{"file":"y-701-male-v3.m4a","bytes":458895,"sha256":"da86102af2a5a04e5de3085c77f44525b6241db3bb39339e6a20ad21fb8274c6","duration":64.2},"female":{"file":"y-701-female-v3.m4a","bytes":471418,"sha256":"1cc443c9745c5f911d20ae5f4cbce9b4184da4ce2b806a7951a6593f8c4da8d6","duration":64.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.012,"text":"OLUWA, a gbe okan wa","marked":"Olúwa, a gbé ọkàn wa"},{"start":2.462,"end":3.691,"text":"Si O n'nu orin iyin","marked":"Sí Ó n'nu orin ìyìn"},{"start":4.141,"end":5.373,"text":"A m'ore ope wa fun O","marked":"A m'ọrẹ ọpẹ́ wà fún Ọ"},{"start":5.823,"end":6.973,"text":"Pelu iho ayo nla","marked":"Pẹ̀lú ihò ayọ̀ ńlá"},{"start":7.423,"end":8.866,"text":"Gbogbo papa f'ewa bora","marked":"Gbogbo pápá f'ẹwà bora"},{"start":9.316,"end":10.597,"text":"Awon oke nho f'ayo","marked":"Àwọn òkè ńhó f'ayọ̀"},{"start":11.047,"end":12.515,"text":"Oka po l'afonifoji","marked":"Ọkà pọ̀ l'àfonífojì"},{"start":12.965,"end":14.534,"text":"Tobe ti won fi nkorin.","marked":"Tọ̀bẹ̀ tí wọ́n fi ńkọrin."}],"end":14.534},{"key":"2","start":15.484,"lines":[{"start":15.484,"end":17.298,"text":"Loni, ojo ikore wa","marked":"Lónì, ọjọ́ ìkórè wà"},{"start":17.748,"end":18.756,"text":"Awa jewo ore Re","marked":"Àwa jẹ́wọ́ ọrẹ Rẹ"},{"start":19.206,"end":20.462,"text":"Awa f'ope mu ebun wa","marked":"Àwa f'ọpẹ́ mú ẹ̀bùn wá"},{"start":20.912,"end":22.115,"text":"Akoso ibukun Re","marked":"Àkóso ìbùkún Rẹ"},{"start":22.565,"end":24.324,"text":"Wo l'o nfi ore-ofe bo","marked":"Wò l'ó ńfi oore-ọ̀fẹ́ bọ"},{"start":24.774,"end":25.782,"text":"Okan awa eda Re","marked":"Ọkàn àwa ẹ̀dá Rẹ̀"},{"start":26.232,"end":27.653,"text":"Wo ti npese onje ojo","marked":"Wo ti ńpèsè onje ọjọ́"},{"start":28.103,"end":29.627,"text":"Fi onje orun bo wa.","marked":"Fi oǹjẹ ọ̀run bọ̀ wá."}],"end":29.627},{"key":"3","start":30.577,"lines":[{"start":30.577,"end":32.092,"text":"A nfarada oru ojo","marked":"A ńfaradà òru ọjọ́"},{"start":32.542,"end":34.14,"text":"Laalaa a si ma su-ni","marked":"Làálàá a sì má su-ni"},{"start":34.59,"end":35.975,"text":"Sugbon nigbati oorun wo","marked":"Ṣùgbọ́n nígbàtí oòrùn wò"},{"start":36.425,"end":37.668,"text":"Simi de fun alaare","marked":"Ṣímí dé fún aláárẹ̀"},{"start":38.118,"end":39.634,"text":"Se wa l'eni itwogba","marked":"Ṣe wá l'ẹni ìtwọ́gba"},{"start":40.084,"end":41.42,"text":"Gbat' angeli ba nkore","marked":"Gbàt áńgẹ́lì bá ńkórè"},{"start":41.87,"end":43.663,"text":"K'a je alikama Kristi","marked":"K'a jẹ́ alikama Kristi"},{"start":44.113,"end":45.401,"text":"Ti On y'o to si aba.","marked":"Tí Ọn y'ó tó sí àbà."}],"end":45.401},{"key":"4","start":46.351,"lines":[{"start":46.351,"end":47.686,"text":"lbukun n'ile Olorun","marked":"Ìbùkún n'ilé Ọlọ́run"},{"start":48.136,"end":49.293,"text":"Bit' awon mimo wa lae","marked":"Bít àwọn mímọ́ wà láé"},{"start":49.743,"end":51.584,"text":"Papa wura teju ni be","marked":"Pápá wúrà tẹ́jú ni bẹ"},{"start":52.034,"end":53.891,"text":"Odo re ndan bi Kristal","marked":"Ọ̀dọ̀ rẹ̀ ńdán bí Kristal"},{"start":54.341,"end":55.766,"text":"Orin egbe mimo t'ohun","marked":"Orin ẹgbẹ́ mímọ́ t'ohun"},{"start":56.216,"end":57.58,"text":"Dapo mo tiwa loni","marked":"Dàpọ̀ mo tiwa lónì"},{"start":58.03,"end":59.534,"text":"Bukun orin kore na po","marked":"Bùkún orin kórè na pọ̀"},{"start":59.984,"end":61.57,"text":"Ti a o ma ko titi.","marked":"Tí a ó má kọ́ títí."},{"start":62.02,"end":62.641,"text":"Amin.","marked":"Àmín."}],"end":62.641}]}