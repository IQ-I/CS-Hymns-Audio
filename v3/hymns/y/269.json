{"v":3,"coll":"y","num":269,"id":"hymn_269","title":"Kii se l'ainireti","duration":66.687,"voices":{"male":{"file":"y-269-male-v3.m4a","bytes":461117,"sha256":"611451cd941256e70a95c8da41688b462a913ad945e5506b394f22359efc1a0b","duration":66.7},"female":{"file":"y-269-female-v3.m4a","bytes":485090,"sha256":"6476c2d0aa916269f3e5daec33800672495f1bdc9127f04ffa1bc7b7d8211282","duration":66.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.671,"text":"Kii se l'ainireti,","marked":"Kìí ṣe l'àìnírètí"},{"start":2.121,"end":3.088,"text":"Ni mo tọ wa;","marked":"Ni mo tọ̀ wá"},{"start":3.538,"end":4.764,"text":"Kii se l'aini 'gbagbọ,","marked":"Kìí ṣe l'àìní 'gbagbọ"},{"start":5.214,"end":6.244,"text":"Ni mo kunlẹ;","marked":"Ni mo kúnlẹ̀"},{"start":6.694,"end":7.901,"text":"Ẹsẹ ti gori mi,","marked":"Ẹsẹ̀ ti gorí mi"},{"start":8.351,"end":9.519,"text":"Eyi sa l'ẹbẹ mi,","marked":"Èyí sá l'ẹ̀bẹ̀ mi"},{"start":9.969,"end":11.099,"text":"Eyi sa l'ẹbẹ mi","marked":"Èyí sá l'ẹ̀bẹ̀ mi"},{"start":11.549,"end":12.541,"text":"Jesu ti ku.","marked":"Jésù ti kú."}],"end":12.541},{"key":"2","start":13.491,"lines":[{"start":13.491,"end":15.007,"text":"A! ẹsẹ mi pọ ju,","marked":"A! ẹsẹ̀ mi pọ̀ ju"},{"start":15.457,"end":16.364,"text":"O pọn kọkọ!","marked":"Ó pọ́n kọ́kọ́!"},{"start":16.814,"end":18.283,"text":"Adale, adale,","marked":"Adalẹ̀, adalẹ̀"},{"start":18.733,"end":19.891,"text":"Ni mo n d'ẹsẹ!","marked":"Ni mò ń d'ẹsẹ!"},{"start":20.341,"end":21.358,"text":"Ẹsẹ aifẹran Rẹ,","marked":"Ẹsẹ̀ àìfẹ́ràn Rẹ̀"},{"start":21.808,"end":22.822,"text":"Ẹsẹ aigba Ọ gbọ;","marked":"Ẹsẹ̀ àìgbà Ọ gbọ́"},{"start":23.272,"end":24.225,"text":"Ẹsẹ aigba Ọ gbọ;","marked":"Ẹsẹ̀ àìgbà Ọ gbọ́"},{"start":24.675,"end":25.549,"text":"Ẹsẹ nlanla!","marked":"Ẹsẹ̀ ńláńlá!"}],"end":25.549},{"key":"3","start":26.499,"lines":[{"start":26.499,"end":27.543,"text":"Oluwa mo jẹwọ","marked":"Olúwa mo jẹ́wọ́"},{"start":27.993,"end":28.895,"text":"Ẹsẹ nla mi;","marked":"Ẹsẹ̀ ńlá mi"},{"start":29.345,"end":30.409,"text":"O mọ bi mo ti ri,","marked":"Ó mọ bí mo ti rí"},{"start":30.859,"end":31.765,"text":"Bi mo ti wa;","marked":"Bí mo ti wá"},{"start":32.215,"end":33.234,"text":"Jọ wẹ ẹsẹ mi nu!","marked":"Jọ wẹ ẹsẹ̀ mi nù!"},{"start":33.684,"end":34.679,"text":"K' ọkan mi mọ loni,","marked":"K ọkàn mi mọ́ lónì"},{"start":35.129,"end":36.145,"text":"K'ọkan mi mọ loni,","marked":"K'ọkàn mi mọ́ lónì"},{"start":36.595,"end":37.615,"text":"Ki n di mimọ.","marked":"Kí n di mímọ́."}],"end":37.615},{"key":"4","start":38.565,"lines":[{"start":38.565,"end":40.638,"text":"Olododo ni O, O n","marked":"Olódodo ni Ọ, Ó ń"},{"start":41.088,"end":43.608,"text":"dariji; L'ẹsẹ agbelebu","marked":"dáríjì; L'ẹsẹ̀ àgbélébùú"},{"start":44.058,"end":44.947,"text":"Ni mo wole","marked":"Ni mo wọlé"},{"start":45.397,"end":46.309,"text":"Jẹ k'ẹjẹ","marked":"Jẹ́ k'ẹ̀jẹ̀"},{"start":46.759,"end":49.313,"text":"iwenu Eje Odagutan, Eje","marked":"ìwẹ̀nù Ẹ̀jẹ̀ Ọ̀dágùtàn, Ẹ̀jẹ̀"},{"start":49.763,"end":51.304,"text":"Odagutan We okan mi.","marked":"Ọ̀dàgùtàn Wẹ ọkàn mi."}],"end":51.304},{"key":"5","start":52.254,"lines":[{"start":52.254,"end":53.71,"text":"'Gba naa, alafia,","marked":"gbà náà, àlàáfíà"},{"start":54.16,"end":55.172,"text":"Y'o d'ọkan mi;","marked":"Y'ó d'ọkàn mi"},{"start":55.622,"end":57.496,"text":"'Gba naa, n o ba Ọ rin,","marked":"gbà náà, n ò bá Ọ rìn"},{"start":57.946,"end":58.646,"text":"Ọrẹ airi;","marked":"Ọrẹ àìrí"},{"start":59.096,"end":60.57,"text":"mf Em' o f'ara ti Ọ,","marked":"mf Èm ó f'ara tí Ọ"},{"start":61.02,"end":62.227,"text":"Jọ ma tọ mi s'ọna","marked":"Jọ má tọ̀ mi s'ọ́nà"},{"start":62.677,"end":63.792,"text":"Jọ ma tọ mi s'ọna","marked":"Jọ má tọ̀ mi s'ọ́nà"},{"start":64.242,"end":65.139,"text":"Titi aiye.","marked":"Títí ayé."}],"end":65.139}]}