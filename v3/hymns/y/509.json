{"v":3,"coll":"y","num":509,"id":"hymn_509","title":"OM'OGBE Kerubu jade","duration":78.96,"voices":{"male":{"file":"y-509-male-v3.m4a","bytes":556445,"sha256":"54216d195d894d6957ee0279b1c48c2131f4956aacda8489485420858fa91396","duration":79.0},"female":{"file":"y-509-female-v3.m4a","bytes":578208,"sha256":"ebf67071c390d21f2b668ada9d3afef4ed4b7e354088a8b1a8b1215ead62767e","duration":79.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.557,"text":"OM'OGBE Kerubu jade","marked":"Ọm'ọgbẹ́ Kérúbù jáde"},{"start":2.007,"end":3.328,"text":"Gbogbo aje pagan mo","marked":"Gbogbo àjẹ́ pàgàn mọ́"},{"start":3.778,"end":5.215,"text":"Awa Serafu l'o pejo","marked":"Àwa Séráfù l'ó péjọ"},{"start":5.665,"end":7.256,"text":"Lati gb'ogo Jesu ga.","marked":"Láti gb'ògo Jésù ga."},{"start":7.706,"end":8.75,"text":"Egbe:  Maikeli Mimo","marked":"Maikeli Mímọ́"},{"start":9.2,"end":10.767,"text":"Ni Balogun Egbe wa.","marked":"Ní Balógun Ẹgbẹ́ wa."},{"start":11.217,"end":12.349,"text":"Maikeli Mimo","marked":"Maikeli Mímọ́"},{"start":12.799,"end":14.56,"text":"Ni Balogun Egbe wa.","marked":"Ní Balógun Ẹgbẹ́ wa."}],"end":14.56},{"key":"CHORUS","start":15.51,"lines":[{"start":15.51,"end":16.596,"text":"Maikeli Mimo","marked":"Maikeli Mímọ́"},{"start":17.046,"end":18.698,"text":"Ni Balogun Egbe wa.","marked":"Ní Balógun Ẹgbẹ́ wa."},{"start":19.148,"end":20.28,"text":"Maikeli Mimo","marked":"Maikeli Mímọ́"},{"start":20.73,"end":22.456,"text":"Ni Balogun Egbe wa.","marked":"Ní Balógun Ẹgbẹ́ wa."}],"end":22.456},{"key":"2","start":23.406,"lines":[{"start":23.406,"end":25.33,"text":"Aje ko Ie ri wa gbese","marked":"Àjẹ́ kò lè rí wa gbèsè"},{"start":25.78,"end":27.244,"text":"Labe opagun Jesu","marked":"Lábẹ́ ọ̀págun Jésù"},{"start":27.694,"end":29.004,"text":"Niwaju awon Serafu","marked":"Níwájú àwọn Séráfù"},{"start":29.454,"end":30.706,"text":"Gbogbo aje a fo lo.","marked":"Gbogbo ajé a fò lọ."},{"start":31.156,"end":32.241,"text":"Egbe:  Maikeli Mimo...","marked":"Maikeli Mímọ́"}],"end":32.241},{"key":"3","start":33.191,"lines":[{"start":33.191,"end":34.715,"text":"Idarudapo yio b'aje","marked":"Ìdàrúdàpọ̀ yóò b'àjẹ́"},{"start":35.165,"end":36.491,"text":"Niwaju ogun Jesu","marked":"Níwájú ogun Jésù"},{"start":36.941,"end":38.176,"text":"ldaj'Olorun de be won","marked":"Ìdáj'ọlọ́run dé bẹ̀ wọn"},{"start":38.626,"end":39.884,"text":"Lagbara Metalokan.","marked":"Lágbára Mẹ́talọ́kan."},{"start":40.334,"end":41.473,"text":"Egbe:  Maikeli Mimo...","marked":"Maikeli Mímọ́"}],"end":41.473},{"key":"4","start":42.423,"lines":[{"start":42.423,"end":44.2,"text":"Halleluya! Halleluya!","marked":"Hallelúyà! Hallelúyà!"},{"start":44.65,"end":45.914,"text":"Jek'a ko Halleluyah","marked":"Jek'a kọ́ Hallelúyà"},{"start":46.364,"end":47.802,"text":"Ajekaje ko lagbara","marked":"Àjẹkajẹ kò lágbára"},{"start":48.252,"end":49.493,"text":"Lori Egbe Kerubu.","marked":"Lórí Ẹgbẹ́ Kérúbù."},{"start":49.943,"end":51.119,"text":"Egbe:  Maikeli Mimo...","marked":"Maikeli Mímọ́"}],"end":51.119},{"key":"5","start":52.069,"lines":[{"start":52.069,"end":53.912,"text":"Gidigbo, gidigbo heyah","marked":"Gidigbo, gidigbo heyah"},{"start":54.362,"end":55.439,"text":"A p'awon aje n'ija","marked":"A p'àwọn ajé n'ìjà"},{"start":55.889,"end":57.613,"text":"Ati soponna baba won","marked":"Àti ṣọ́pọ́nná Baba wọn"},{"start":58.063,"end":59.53,"text":"Loruko Metalokan.","marked":"Lórúkọ Mẹ́talọ́kan."},{"start":59.98,"end":61.138,"text":"Egbe:  Maikeli Mimo...","marked":"Maikeli Mímọ́"}],"end":61.138},{"key":"6","start":62.088,"lines":[{"start":62.088,"end":63.628,"text":"E f'ogo fun baba loke","marked":"Ẹ f'ògo fún Baba lókè"},{"start":64.078,"end":65.254,"text":"E f'ogo fun Omo Re","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":65.704,"end":67.017,"text":"E.f'ogo fun Emi Mimo","marked":"E.f'ogo fún Ẹ̀mí Mímọ́"},{"start":67.467,"end":68.941,"text":"F' ogo fun Metalokan.","marked":"F ògo fún Mẹ́talọ́kan."},{"start":69.391,"end":70.524,"text":"Egbe:  Maikeli Mimo","marked":"Maikeli Mímọ́"},{"start":70.974,"end":72.738,"text":"Ni Balogun Egbe wa.","marked":"Ní Balógun Ẹgbẹ́ wa."},{"start":73.188,"end":74.296,"text":"Maikeli Mimo","marked":"Maikeli Mímọ́"},{"start":74.746,"end":76.376,"text":"Ni Balogun Egbe wa.","marked":"Ní Balógun Ẹgbẹ́ wa."},{"start":76.826,"end":77.411,"text":"Amin.","marked":"Àmín."}],"end":77.411}]}