{"v":3,"coll":"y","num":306,"id":"hymn_306","title":"OKE Kan mbe jina rere","duration":41.163,"voices":{"male":{"file":"y-306-male-v3.m4a","bytes":283537,"sha256":"8c3e2ce45c480046be47dc9b47c4dd81a99f215605e72d0358232156b0f24919","duration":41.2},"female":{"file":"y-306-female-v3.m4a","bytes":297718,"sha256":"76cd3086fe0126e84fb9c1987a2eeb1170f7d012afafdbe073b1c5ebdabde497","duration":41.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.675,"text":"OKE kan mbẹ jina rere,","marked":"Òkè kan mbẹ́ jìnà rere"},{"start":2.125,"end":3.214,"text":"Lẹhin odi ilu,","marked":"Lẹ́hìn odi ìlú"},{"start":3.664,"end":5.358,"text":"Nibi t'a kan Oluwa mọ,","marked":"Níbi t'á kan Olúwa mọ́"},{"start":5.808,"end":7.141,"text":"Ẹni t'O ku fun wa.","marked":"Ẹni t'Ó kú fún wa."}],"end":7.141},{"key":"2","start":8.091,"lines":[{"start":8.091,"end":9.934,"text":"A ko le mọ, a ko le sọ,","marked":"A kò lè mọ̀, a kò lè sọ"},{"start":10.384,"end":11.518,"text":"B'irora Rẹ ti to;","marked":"B'írora Rẹ ti tó"},{"start":11.968,"end":13.819,"text":"Sugbọn a mọ pe n' tori wa,","marked":"Sùgbọ́n a mọ̀ pé ń torí wa"},{"start":14.269,"end":15.637,"text":"L'O se jiya nibẹ.","marked":"L'Ó ṣe jìyà níbẹ̀."}],"end":15.637},{"key":"3","start":16.587,"lines":[{"start":16.587,"end":18.012,"text":"O ku ka le huwa rere,","marked":"Ó kù ká lè hùwà rere"},{"start":18.462,"end":19.787,"text":"K'a le ri 'dariji;","marked":"K'á lè rí dáríjì"},{"start":20.237,"end":21.652,"text":"K'a si le d'ọrun nikẹhin,","marked":"K'á sì lè d'ọ̀run níkẹ̀hìn"},{"start":22.102,"end":23.728,"text":"N'itoye ẹjẹ Rẹ.","marked":"N'ìtòye ẹ̀jẹ̀ Rẹ."}],"end":23.728},{"key":"4","start":24.678,"lines":[{"start":24.678,"end":26.026,"text":"Ko tun s'ẹni re miran mọ","marked":"Kò tún s'ẹ́ni rẹ̀ míràn mọ́"},{"start":26.476,"end":27.642,"text":"To le sanwo ẹsẹ,","marked":"Tó lè sanwó ẹsẹ̀"},{"start":28.092,"end":29.486,"text":"Oun lo le silẹkun ọrun,","marked":"Òun ló lè sílẹ̀kùn ọ̀run"},{"start":29.936,"end":31.137,"text":"K'O si gba wa silẹ.","marked":"K'Ó sì gbà wá sílẹ̀."}],"end":31.137},{"key":"5","start":32.087,"lines":[{"start":32.087,"end":34.077,"text":"A! b'ifẹ Rẹ ti sọwọn to,","marked":"A! b'ìfẹ́ Rẹ ti sọ̀wọ́n tó"},{"start":34.527,"end":35.607,"text":"O yẹ ka fẹran Rẹ;","marked":"Ó yẹ ká fẹ́ràn Rẹ̀"},{"start":36.057,"end":37.73,"text":"K'a si gbẹkẹle ẹjẹ Rẹ,","marked":"K'á sì gbẹ́kẹ̀lé ẹ̀jẹ̀ Rẹ̀"},{"start":38.18,"end":39.614,"text":"K'a si se ifẹ Rẹ.","marked":"K'á sì ṣe ìfẹ́ Rẹ."}],"end":39.614}]}