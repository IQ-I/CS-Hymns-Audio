{"v":3,"coll":"y","num":699,"id":"hymn_699","title":"ILE kan mbe to dara julo","duration":58.419,"voices":{"male":{"file":"y-699-male-v3.m4a","bytes":415232,"sha256":"6d2d34e9eea21e53f38c7b48a6bc49fb2d92c5733f1a2d3ebe634c4ff16374d0","duration":58.5},"female":{"file":"y-699-female-v3.m4a","bytes":424607,"sha256":"fe6df1c85d96ab1f8cc979762014c061822f01128e94bcf9b15ce116640c4eae","duration":58.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.08,"text":"ILẸ kan mbẹ to dara julọ,","marked":"Ilẹ̀ kan mbẹ́ tó dára jùlọ"},{"start":2.53,"end":4.1,"text":"A le fi 'gbagbọ ri l'okere,","marked":"A lè fi 'gbagbọ rí l'òkèrè"},{"start":4.55,"end":5.902,"text":"Nitori Baba duro l'ọna,","marked":"Nítorí Baba dúró l'ọ̀nà"},{"start":6.352,"end":7.976,"text":"Lati fi'le kan fun wa nibẹ.","marked":"Láti fi'lé kan fún wa níbẹ̀."}],"end":7.976},{"key":"CHORUS","start":8.926,"lines":[{"start":8.926,"end":10.896,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":11.346,"end":12.835,"text":"E ho fun ayo lojo oni - 2ce","marked":"Ẹ hó fún ayọ̀ lọ́jọ́ òní"}],"end":12.835},{"key":"2","start":13.785,"lines":[{"start":13.785,"end":15.302,"text":"Awa y'o korin l'ebute na","marked":"Àwa y'ó kọrin l'èbúté ná"},{"start":15.752,"end":17.372,"text":"Orin didun awon t'a bukun","marked":"Orin dídùn àwọn t'á bùkún"},{"start":17.822,"end":19.442,"text":"Okan wa ko ni banuje mo","marked":"Ọkàn wa kò ní banújẹ́ mọ́"},{"start":19.892,"end":21.653,"text":"Tori ayo ailopin wa n'be.","marked":"Torí ayọ̀ àìlópin wá n'bẹ."}],"end":21.653},{"key":"3","start":22.603,"lines":[{"start":22.603,"end":23.977,"text":"Baba wa olore ni ọrun,","marked":"Baba wa ọlọ́rẹ ní ọ̀run"},{"start":24.427,"end":26.456,"text":"Nikan n'iyin at'ọpẹ yẹ fun;","marked":"Nìkan n'ìyìn àt'ọpẹ́ yẹ fún"},{"start":26.906,"end":28.166,"text":"'Tori ẹbun ogo ifẹ Rẹ,","marked":"torí ẹ̀bùn ògo ìfẹ́ Rẹ"},{"start":28.616,"end":30.285,"text":"Eyi ti se Olugbala wa.","marked":"Èyí ti ṣe Olùgbàlà wa."}],"end":30.285},{"key":"4","start":31.235,"lines":[{"start":31.235,"end":32.616,"text":"Tan 'mọlẹ Rẹ si okunkun wa,","marked":"Tan 'mọlẹ Rẹ̀ sí òkùnkùn wà"},{"start":33.066,"end":35.075,"text":"L'akoko t'ẹgbẹ Séráfù de;","marked":"L'àkókò t'ẹgbẹ́ Séráfù dé"},{"start":35.525,"end":37.084,"text":"Ki gbogbo ayé le yipada,","marked":"Kí gbogbo ayé lè yípadà"},{"start":37.534,"end":39.365,"text":"Lati juba fun Krisit Oluwa.","marked":"Láti júbà fún Krisit Olúwa."}],"end":39.365},{"key":"5","start":40.315,"lines":[{"start":40.315,"end":41.997,"text":"Gba t'a gbe ago erupe wo","marked":"Gba t'á gbé àgọ́ erùpẹ̀ wò"},{"start":42.447,"end":43.814,"text":"Ti ota ba fe se wa n'ibi","marked":"Tí ọ̀tá bá fẹ́ ṣe wá n'ibi"},{"start":44.264,"end":45.686,"text":"T'erokero ba fe gb'okan wa,","marked":"T'èròkèrò bá fẹ́ gb'ọkàn wa"},{"start":46.136,"end":48.183,"text":"Ki Jehofa ko gbo ebe wa.","marked":"Kí Jèhófà kò gbọ́ ẹ̀bẹ̀ wa."}],"end":48.183},{"key":"6","start":49.133,"lines":[{"start":49.133,"end":50.644,"text":"Nigba t'o ba d'ọjọ ikẹhin,","marked":"Nígbà t'ó bá d'ọjọ́ ìkẹhìn"},{"start":51.094,"end":52.542,"text":"Ti ọmọ ko ni mọ baba rẹ;","marked":"Tí ọmọ kò ní mọ Baba rẹ̀"},{"start":52.992,"end":54.717,"text":"Ma jẹ k'oju ti wa lọjọ na,","marked":"Má jẹ́ k'ojú ti wá lọ́jọ́ ná"},{"start":55.167,"end":56.87,"text":"Ki Mẹtalọkan tẹwọ gba wa.","marked":"Kí Mẹ́talọ́kan tẹ́wọ́ gbà wá."}],"end":56.87}]}