{"v":3,"coll":"y","num":94,"id":"hymn_94","title":"JESU mo wa sodo Re,","duration":101.256,"voices":{"male":{"file":"y-94-male-v3.m4a","bytes":731819,"sha256":"63d28dde0e24f3535fb42b54d58f463780ac48ca5b020d6b20de4d621f173a25","duration":101.3},"female":{"file":"y-94-female-v3.m4a","bytes":763909,"sha256":"e866c4f20feae58c001e821456e760187607ddfd775231f72f1124c3068bbd27","duration":101.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.448,"text":"JESU mo wa sodo Re,","marked":"Jésù mọ̀ wá sọ́dọ̀ Rẹ̀"},{"start":1.898,"end":3.172,"text":"Je ki n le ma to O","marked":"Jẹ́ kí n lè má tọ̀ Ọ́"},{"start":3.622,"end":5.5,"text":"lẹyin, Bi 'ni mi gbogbo segbe,","marked":"lẹ́yìn, Bí ní mi gbogbo ṣègbé"},{"start":5.95,"end":16.429,"text":"Ti ero mi gbogbo si pin. Ẹ yin logo, ẹyin Mimọ, Ẹ f'ọpẹ fun Baba loke, Da wa si l'ẹgbẹ Séráfù, Ni 'kẹhin gba ọkan wa la.","marked":"Tí èrò mi gbogbo sì pín. Ẹ yin lógo, ẹ̀yin Mímọ́, Ẹ f'ọpẹ́ fún Baba lókè, Dá wa sí l'ẹ̀gbẹ́ Séráfù, Ní 'kẹhin gba ọkàn wa là."}],"end":16.429},{"key":"CHORUS","start":17.379,"lines":[{"start":17.379,"end":19.077,"text":"E yin logo, enyin Mimo","marked":"Ẹ yin lógo, ẹ̀yin Mímọ́"},{"start":19.527,"end":20.97,"text":"E f'ope fun Baba loke","marked":"Ẹ f'ọpẹ́ fún Baba lókè"},{"start":21.42,"end":22.755,"text":"Da wa si I'egbe Serafu,","marked":"Dá wa sí l'ẹgbẹ́ Séráfù"},{"start":23.205,"end":24.61,"text":"Ni kehin gba okan wa la.","marked":"Ní kẹ́hìn gba ọkàn wa là."}],"end":24.61},{"key":"2","start":25.56,"lines":[{"start":25.56,"end":27.589,"text":"Keferi, Imale, ẹ wa,","marked":"Kèfèrí, Ìmàlẹ̀, ẹ wà"},{"start":28.039,"end":29.714,"text":"Onigbagbọ, ma kalọ,","marked":"Onígbàgbọ́, má kálọ"},{"start":30.164,"end":31.357,"text":"K'a jọ yin Ọlọrun wa,","marked":"K'á jọ yin Ọlọ́run wa"},{"start":31.807,"end":33.09,"text":"K'a le d'ade ni 'kẹhin.","marked":"K'á lè d'áde ní 'kẹhin."}],"end":33.09},{"key":"3","start":34.04,"lines":[{"start":34.04,"end":35.136,"text":"A dupẹ lọwọ Ọlọrun,","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":35.586,"end":37.317,"text":"T'o fi Jesu Kristi fun wa,","marked":"T'ó fi Jésù Kristi fún wa"},{"start":37.767,"end":39.478,"text":"Lati ra arayé pada,","marked":"Láti ra arayé padà"},{"start":39.928,"end":41.271,"text":"Lọwọ ẹsẹ at'esu.","marked":"Lọ́wọ́ ẹsẹ̀ àt'eṣú."}],"end":41.271},{"key":"4","start":42.221,"lines":[{"start":42.221,"end":43.702,"text":"Ẹgbe Séráfù damure,","marked":"Ẹgbé Séráfù dàmúrè"},{"start":44.152,"end":45.78,"text":"Ẹgbe Kérúbù kun f'adura,","marked":"Ẹgbé Kérúbù kún f'àdúrà"},{"start":46.23,"end":47.615,"text":"Olugbala yoo gba wa la,","marked":"Olùgbàlà yóò gbà wá là"},{"start":48.065,"end":49.623,"text":"Oluwosan yoo wo wa san.","marked":"Olùwòsàn yóò wò wá sàn."}],"end":49.623},{"key":"5","start":50.573,"lines":[{"start":50.573,"end":52.333,"text":"Ọjọ mbọ t'ayé yoo pin,","marked":"Ọjọ́ mbọ́ t'ayé yóò pín"},{"start":52.783,"end":54.014,"text":"Ẹ sọra ẹyin Mimọ;","marked":"Ẹ sọ́ra ẹ̀yin Mímọ́"},{"start":54.464,"end":55.866,"text":"K'ẹni ‘waju tẹ siwaju,","marked":"K'ẹ́ni wájú tẹ̀ síwájú"},{"start":56.316,"end":57.768,"text":"K'ẹni ẹhin ma jafara.","marked":"K'ẹni ẹ̀hìn má jáfara."}],"end":57.768},{"key":"6","start":58.718,"lines":[{"start":58.718,"end":60.062,"text":"Awọn to sẹgun saju,","marked":"Àwọn tó sẹ́gun sájú"},{"start":60.512,"end":62.275,"text":"Wọn n wo wa b'a ti n yọ loni,","marked":"Wọ́n ń wò wá b'á ti ń yọ̀ lónì"},{"start":62.725,"end":64.491,"text":"Wọn nkan sara si wa wi pé,","marked":"Wọ́n nǹkan sára sí wa wí pé"},{"start":64.941,"end":67.326,"text":"Tẹ siwaju, ma fa s'ẹyin.","marked":"Tẹ̀ síwájú, má fa s'ẹ́yìn."}],"end":67.326},{"key":"7","start":68.276,"lines":[{"start":68.276,"end":69.684,"text":"Ma siyemeji lọna yii,","marked":"Má ṣiyèméjì lọ́nà yìí"},{"start":70.134,"end":71.862,"text":"B'o ti wu k'o le fun ọ to;","marked":"B'ó ti wù k'ó lè fún ọ tó"},{"start":72.312,"end":73.845,"text":"Séráfù mase foya,","marked":"Séráfù máṣe fòyà"},{"start":74.295,"end":75.749,"text":"Adun y'o kẹhin ayé rẹ.","marked":"Adùn y'ó kẹhìn ayé rẹ̀."}],"end":75.749},{"key":"8","start":76.699,"lines":[{"start":76.699,"end":78.142,"text":"Nigba ti 'pe kẹhin ba dun,","marked":"Nígbà tí pé kẹ́hìn bá dùn"},{"start":78.592,"end":80.592,"text":"Jesu y'o ko wa de Kenaani,","marked":"Jésù y'ó kọ́ wá dé Kenaani"},{"start":81.042,"end":82.376,"text":"Jẹ ka l'ayọ lọdọ Rẹ,","marked":"Jẹ́ ká l'ayọ̀ lọ́dọ̀ Rẹ"},{"start":82.826,"end":84.339,"text":"Fi wa s'agbala itura.","marked":"Fi wá s'àgbàlá ìtura."}],"end":84.339},{"key":"9","start":85.289,"lines":[{"start":85.289,"end":86.891,"text":"E f'ogo fun Baba loke,","marked":"Ẹ f'ògo fún Baba lókè"},{"start":87.341,"end":88.863,"text":"E f'ogo fun Omo pelu","marked":"Ẹ f'ògo fún Ọmọ pẹ̀lú"},{"start":89.313,"end":90.767,"text":"E f'ogo fun Emi Mimo","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́"},{"start":91.217,"end":99.707,"text":"Metalokan lope ye fun. Ẹ yin logo, ẹyin Mimọ, Ẹ f'ọpẹ fun Baba loke, Da wa si n'Ijọ Séráfù, Ni 'kẹhin gba ọkan wa la.","marked":"Mẹ́talọ́kan lọ́pẹ́ yẹ fún. Ẹ yin lógo, ẹ̀yin Mímọ́, Ẹ f'ọpẹ́ fún Baba lókè, Dá wa sì n'Ìjọ Séráfù, Ní 'kẹhin gba ọkàn wa là."}],"end":99.707}]}