{"v":3,"coll":"y","num":686,"id":"hymn_686","title":"OPO ikan omi","duration":41.328,"voices":{"male":{"file":"y-686-male-v3.m4a","bytes":278249,"sha256":"b6fb746cd6b61984bf222f313199773523bfa183ed9655103cdbf516b4be151f","duration":41.4},"female":{"file":"y-686-female-v3.m4a","bytes":289271,"sha256":"258453574a1d4e6d896823ee9e9b59a9efae86dfd172e330d9e820ffe30a46f4","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.292,"text":"ỌPỌ ikan omi,","marked":"Ọ̀pọ̀ ìkán omi"},{"start":1.742,"end":2.655,"text":"Yanrin kekeke;","marked":"Yanrìn kékeké"},{"start":3.105,"end":4.484,"text":"'Wọnyi l'o d'okun nla,","marked":"'Wọnyi l'ó d'okùn ńlá"},{"start":4.934,"end":5.917,"text":"At' ile ayé.","marked":"Àt ilẹ̀ ayé."}],"end":5.917},{"key":"2","start":6.867,"lines":[{"start":6.867,"end":7.915,"text":"Iseju wa kokan","marked":"Ìṣẹ́jú wà kọkàn"},{"start":8.365,"end":9.405,"text":"Ti a ko ka si","marked":"Tí a kò kà sí"},{"start":9.855,"end":11.286,"text":"Lo d'odun aimoye","marked":"Lọ d'ọdún àìmọye"},{"start":11.736,"end":12.87,"text":"Ti ainipekun.","marked":"Ti àìnípẹ̀kun."}],"end":12.87},{"key":"3","start":13.82,"lines":[{"start":13.82,"end":14.652,"text":"Iwa ore diẹ,","marked":"Ìwà ọ̀rẹ́ díẹ̀"},{"start":15.102,"end":16.018,"text":"Ọrọ 'fẹ diẹ,","marked":"Ọ̀rọ̀ 'fẹ díẹ̀"},{"start":16.468,"end":17.917,"text":"L'o n s'ayé di Eden,","marked":"L'ó ń s'ayé di Eden"},{"start":18.367,"end":19.242,"text":"Bi oke ọrun.","marked":"Bí òkè ọ̀run."}],"end":19.242},{"key":"4","start":20.192,"lines":[{"start":20.192,"end":21.441,"text":"Isisẹ kekeke,","marked":"Ìsisẹ́ kékeké"},{"start":21.891,"end":23.015,"text":"Lo n mọkan sina,","marked":"Ló ń mọ́kàn ṣìnà"},{"start":23.465,"end":24.56,"text":"Kuro l'ọna rere,","marked":"Kúrò l'ọ̀nà rere"},{"start":25.01,"end":26.133,"text":"Si ipa ẹsẹ.","marked":"Sí ipa ẹsẹ̀."}],"end":26.133},{"key":"5","start":27.083,"lines":[{"start":27.083,"end":28.08,"text":"Isẹ anu diẹ,","marked":"Isẹ́ àánú díẹ̀"},{"start":28.53,"end":29.626,"text":"T'a se l'ọmọde,","marked":"T'á ṣe l'ọmọdé"},{"start":30.076,"end":31.359,"text":"Di 'bukun f'orilẹ,","marked":"Di bùkún f'orílẹ̀"},{"start":31.809,"end":32.86,"text":"To jina rere.","marked":"Tó jìnà rere."}],"end":32.86},{"key":"6","start":33.81,"lines":[{"start":33.81,"end":34.891,"text":"Awọn ewe logo,","marked":"Àwọn èwe lógo"},{"start":35.341,"end":36.432,"text":"N gberin Angẹli;","marked":"Ń gberin Áńgẹ́lì"},{"start":36.882,"end":38.237,"text":"Se wa yẹ, Oluwa,","marked":"Ṣé wá yẹ, Olúwa"},{"start":38.687,"end":39.779,"text":"F'ẹgbẹ mimọ wọn.","marked":"F'ẹgbẹ́ mímọ́ wọn."}],"end":39.779}]}