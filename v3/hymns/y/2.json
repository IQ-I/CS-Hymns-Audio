{"v":3,"coll":"y","num":2,"id":"hymn_2","title":"Mo ji, Mo ji, Ogun orun","duration":34.673,"voices":{"male":{"file":"y-2-male.m4a","bytes":248754,"sha256":"5875029473ab8ab0556f84d7220adf31a6c0e7a0d3118a14fa1855bdbfb8de91","duration":34.7},"female":{"file":"y-2-female.m4a","bytes":253438,"sha256":"6b71dde920bf270ed3a93359716002d8777186b5f20241cf472e95136f5b21c4","duration":34.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.617,"text":"Mo ji, Mo ji, Ogun orun","marked":"Mo jí, Mo jí, Ogun ọ̀run"},{"start":2.997,"end":4.563,"text":"K'emi l'agbara bi ti nyin","marked":"K'èmí l'ágbára bí ti nyin"},{"start":4.943,"end":6.253,"text":"K'emi ba le lo ojo mi","marked":"K'èmi bá lè lo ọjọ́ mi"},{"start":6.633,"end":7.844,"text":"Fun iyin Olugbala mi.","marked":"Fún ìyìn Olùgbàlà mi."}],"end":7.844},{"key":"2","start":8.794,"lines":[{"start":8.794,"end":10.412,"text":"Ogo fun Eru' o so mi","marked":"Ògo fún Ẹrú' ò sọ mí"},{"start":10.792,"end":12.193,"text":"To tu mi lara loju Orun","marked":"Tó tù mí lára lójú Ọ̀run"},{"start":12.573,"end":13.982,"text":"Oluwa ijo mo ba ku","marked":"Olúwa ìjọ mo bá kú"},{"start":14.362,"end":15.861,"text":"Ji mi s'iye ainipekun.","marked":"Jí mi s'ìyè àìnípẹ̀kun."}],"end":15.861},{"key":"3","start":16.811,"lines":[{"start":16.811,"end":18.202,"text":"Oluwa mo tun eje je","marked":"Olúwa mo tún ẹ̀jẹ̀ jẹ"},{"start":18.582,"end":20.624,"text":"Tu ese ka b'iri oro","marked":"Tú ẹsẹ̀ ká b'iri oró"},{"start":21.004,"end":22.274,"text":"So akoronu mi oni","marked":"Sọ akọ̀rònú mi ọ̀nì"},{"start":22.654,"end":24.277,"text":"Si f'Emi Re kun inu mi.","marked":"Sì f'Èmi Rẹ kún inú mi."}],"end":24.277},{"key":"4","start":25.227,"lines":[{"start":25.227,"end":26.554,"text":"Oro at'ise mi oni","marked":"Ọ̀rọ̀ àt'iṣẹ́ mi òní"},{"start":26.934,"end":28.469,"text":"Ki nwon le re bi eko Re","marked":"Kí nwọn lè rẹ̀ bí ẹ̀kọ́ Rẹ"},{"start":28.849,"end":30.252,"text":"K'emi si f'ipa mi gbogbo","marked":"K'èmí sì f'ipa mi gbogbo"},{"start":30.632,"end":32.062,"text":"Sise rere fun Ogo Re.","marked":"Ṣíṣe rere fún Ògo Rẹ."},{"start":32.442,"end":33.123,"text":"Amin.","marked":"Àmín."}],"end":33.123}]}