{"v":3,"coll":"y","num":771,"id":"hymn_771","title":"ISIN Jesu ni funni","duration":16.709,"voices":{"male":{"file":"y-771-male-v3.m4a","bytes":112935,"sha256":"fc266a15e0005098316655abf9d6173084459e2830db1aaa03699ed9ebc00cf4","duration":16.8},"female":{"file":"y-771-female-v3.m4a","bytes":115229,"sha256":"5fef23874e8a6bc0e30aaee85d3f35c101195720deceafa36b3244d19d538069","duration":16.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.738,"text":"ISIN Jesu ni 'funni,","marked":"Ìsìn Jésù ni fúnni"},{"start":2.188,"end":3.757,"text":"L'ayọ totọ, layé yi,","marked":"L'ayọ̀ tótọ́, layé yí"},{"start":4.207,"end":5.639,"text":"Isin Jesu ni funni,","marked":"Ìsìn Jésù ni fúnni"},{"start":6.089,"end":7.442,"text":"N'itunu ninu iku.","marked":"N'ìtùnú nínú ikú."}],"end":7.442},{"key":"2","start":8.392,"lines":[{"start":8.392,"end":9.876,"text":"Lehin 'ku ayo na mbe","marked":"Lẹ́hìn kú ayọ̀ ná mbẹ́"},{"start":10.326,"end":11.748,"text":"Ti ko ni d'opin lailai","marked":"Tí kò ní d'òpin láéláé"},{"start":12.198,"end":13.393,"text":"K'Olorun sa je temi","marked":"K'Ọlọ́run sá jẹ́ tèmi"},{"start":13.843,"end":15.159,"text":"Ayo mi ki o l'opin.","marked":"Ayọ̀ mi kí ó l'òpin."}],"end":15.159}]}