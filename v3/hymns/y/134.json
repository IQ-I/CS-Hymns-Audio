{"v":3,"coll":"y","num":134,"id":"hymn_134","title":"B'ORUKO Jesu ti dun to","duration":42.896,"voices":{"male":{"file":"y-134-male-v3.m4a","bytes":298815,"sha256":"e8ee317b9fd53bd1e01be3de42fb33ee99ee8824d7a1d069710ba58b7b5d3c13","duration":42.9},"female":{"file":"y-134-female-v3.m4a","bytes":304757,"sha256":"fa7fb1c32f52005a24ac5feb38fdf3dcc5b8da05b54e407e9a074cb0ac16b171","duration":42.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.001,"text":"B'ORUKO Jesu ti dun to","marked":"B'Orúkọ Jésù ti dùn tó"},{"start":2.451,"end":3.697,"text":"Ogo ni fun Oruko re","marked":"Ògo ni fún Orúkọ rẹ"},{"start":4.147,"end":5.767,"text":"O tan banuje at'ogbe","marked":"Ó tan banújẹ́ àt'ọgbẹ́"},{"start":6.217,"end":7.707,"text":"Ogo ni fun Oruko Re.","marked":"Ògo ni fún Orúkọ Rẹ."}],"end":7.707},{"key":"CHORUS","start":8.657,"lines":[{"start":8.657,"end":10.836,"text":"Ogo f'oko Re, Ogo f'oko Re","marked":"Ògo f'ọkọ Rẹ, Ògo f'ọkọ Rẹ"},{"start":11.286,"end":12.509,"text":"Ogo f'oruko Oluwa","marked":"Ògo f'orúkọ Olúwa"},{"start":12.959,"end":15.237,"text":"Ogo f'oko Re, Ogo f'oko Re","marked":"Ògo f'ọkọ Rẹ, Ògo f'ọkọ Rẹ"},{"start":15.687,"end":17.093,"text":"Ogo f'oruko Oluwa.","marked":"Ògo f'orúkọ Olúwa."}],"end":17.093},{"key":"2","start":18.043,"lines":[{"start":18.043,"end":19.588,"text":"O wo okan to gb'ogbe san","marked":"Ó wo ọkàn tó gb'ọgbẹ́ sàn"},{"start":20.038,"end":21.345,"text":"Ogo ni fun oruko Re","marked":"Ògo ni fún orúkọ Rẹ"},{"start":21.795,"end":23.312,"text":"Onje ni f 'okan t'ebi npa","marked":"Oǹjẹ ni f ọkàn t'ebi ńpa"},{"start":23.762,"end":25.219,"text":"Ogo ni fun oruko Re.","marked":"Ògo ni fún orúkọ Rẹ."}],"end":25.219},{"key":"3","start":26.169,"lines":[{"start":26.169,"end":27.621,"text":"O tan aniyan elese","marked":"Ó tan àníyàn ẹlẹ́ṣẹ̀"},{"start":28.071,"end":29.377,"text":"Ogo ni fun Oruko re","marked":"Ògo ni fún Orúkọ rẹ"},{"start":29.827,"end":31.184,"text":"O fun alare ni simi","marked":"Ó fún aláre ní ṣímí"},{"start":31.634,"end":33.181,"text":"Ogo ni fun oruko re.","marked":"Ògo ni fún orúkọ rẹ."}],"end":33.181},{"key":"4","start":34.131,"lines":[{"start":34.131,"end":35.884,"text":"Nje un o royin na f'elese","marked":"Ǹjẹ́ un ó ròyìn ná f'ẹlẹ́ṣẹ̀"},{"start":36.334,"end":37.675,"text":"Ogo ni fun oruko Re","marked":"Ògo ni fún orúkọ Rẹ"},{"start":38.125,"end":39.4,"text":"Pe mo ti ri Olugbala","marked":"Pé mo ti rí Olùgbàlà"},{"start":39.85,"end":41.346,"text":"Ogo ni fun oruko Re.","marked":"Ògo ni fún orúkọ Rẹ."}],"end":41.346}]}