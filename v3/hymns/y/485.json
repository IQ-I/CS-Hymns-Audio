{"v":3,"coll":"y","num":485,"id":"hymn_485","title":"OLUWA yoo pese","duration":64.223,"voices":{"male":{"file":"y-485-male-v3.m4a","bytes":434915,"sha256":"3250532ad695e1d5153ba90d6b510cde4f1622a6c252783058d917f2007def54","duration":64.3},"female":{"file":"y-485-female-v3.m4a","bytes":447893,"sha256":"e4237206212225972a2058fb63bed98f205262e42b982e91b5df0386f049508a","duration":64.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.349,"text":"OLUWA yoo pese,","marked":"Olúwa yóò pèsè"},{"start":1.799,"end":2.893,"text":"Fun gbogbo aini wa,","marked":"Fún gbogbo àìní wa"},{"start":3.343,"end":4.64,"text":"Ẹni ko bi a bi,","marked":"Ẹni kò bí a bí"},{"start":5.09,"end":6.311,"text":"Ẹni bi a tun la.","marked":"Ẹni bí a tún là."}],"end":6.311},{"key":"CHORUS","start":7.261,"lines":[{"start":7.261,"end":8.537,"text":"Ese wa fun awon ẹyẹ,","marked":"Ẹ̀ṣẹ̀ wà fún àwọn ẹyẹ"},{"start":8.987,"end":10.884,"text":"Ma kominu, ma kominu","marked":"Má kọminú, má kọminú"},{"start":11.334,"end":12.217,"text":"yoo pese.","marked":"yóò pèsè."}],"end":12.217},{"key":"2","start":13.167,"lines":[{"start":13.167,"end":14.223,"text":"Oluwa yoo pese,","marked":"Olúwa yóò pèsè"},{"start":14.673,"end":15.687,"text":"Isẹ rere fun wa,","marked":"Isẹ́ rere fún wa"},{"start":16.137,"end":17.508,"text":"Igba rere yoo de,","marked":"Ìgbà rere yóò dé"},{"start":17.958,"end":19.194,"text":"Ọja wa yoo si ta.","marked":"Ọjà wa yóò sì ta."}],"end":19.194},{"key":"3","start":20.144,"lines":[{"start":20.144,"end":21.175,"text":"Oluwa yoo pese,","marked":"Olúwa yóò pèsè"},{"start":21.625,"end":22.727,"text":"Ọpọ ọja yoo de,","marked":"Ọ̀pọ̀ ọjà yóò dé"},{"start":23.177,"end":25.04,"text":"Ẹni n ra yoo si ri,","marked":"Ẹni ń rà yóò sì rí"},{"start":25.49,"end":26.904,"text":"Ẹni n ta yoo si ta.","marked":"Ẹní ń ta yóò sì ta."}],"end":26.904},{"key":"4","start":27.854,"lines":[{"start":27.854,"end":28.868,"text":"Oluwa yoo pese,","marked":"Olúwa yóò pèsè"},{"start":29.318,"end":30.439,"text":"Alafia ara,","marked":"Àlàáfíà ara"},{"start":30.889,"end":32.457,"text":"Alaisan yoo dide,","marked":"Aláìsàn yóò dìde"},{"start":32.907,"end":34.411,"text":"Ẹni n ku lọ yoo san.","marked":"Ẹní ń kú lọ yóò san."}],"end":34.411},{"key":"5","start":35.361,"lines":[{"start":35.361,"end":36.423,"text":"Oluwa yoo pese","marked":"Olúwa yóò pèsè"},{"start":36.873,"end":37.874,"text":"Ẹmi gigun fun wa,","marked":"Ẹ̀mí gígùn fún wa"},{"start":38.324,"end":39.444,"text":"Angẹli yoo sọ wa,","marked":"Áńgẹ́lì yóò sọ wá"},{"start":39.894,"end":41.248,"text":"A ko ni r'agbako.","marked":"A kò ní r'àgbáko."}],"end":41.248},{"key":"6","start":42.198,"lines":[{"start":42.198,"end":43.316,"text":"Oluwa yoo pese,","marked":"Olúwa yóò pèsè"},{"start":43.766,"end":45.242,"text":"Tabi, tabi ko si,","marked":"Tàbí, tàbí kò sí"},{"start":45.692,"end":46.783,"text":"F'ẹni to ba gbagbọ,","marked":"F'ẹni tó bá gbàgbọ́"},{"start":47.233,"end":48.667,"text":"Gbagbọ tọkan-tọkan.","marked":"Gbàgbọ́ tọkan-tọkan."}],"end":48.667},{"key":"7","start":49.617,"lines":[{"start":49.617,"end":50.671,"text":"Oluwa yoo pese,","marked":"Olúwa yóò pèsè"},{"start":51.121,"end":52.466,"text":"Awa-maridi ni:","marked":"Awa-maridi ni"},{"start":52.916,"end":54.043,"text":"Ju gbogbo wọnyi lọ,","marked":"Ju gbogbo wọ̀nyí lọ"},{"start":54.493,"end":55.794,"text":"Awa yoo ba goke.","marked":"Àwa yóò bá gòkè."}],"end":55.794},{"key":"8","start":56.744,"lines":[{"start":56.744,"end":57.852,"text":"Oluwa yoo pese,","marked":"Olúwa yóò pèsè"},{"start":58.302,"end":59.336,"text":"Gbogbo wa yoo riran,","marked":"Gbogbo wa yóò ríran"},{"start":59.786,"end":60.89,"text":"Aini ko ni si mọ,","marked":"Àìní kò ní sí mọ́"},{"start":61.34,"end":62.675,"text":"Kedere l'a o mọ","marked":"Kedere l'a ó mọ́"}],"end":62.675}]}