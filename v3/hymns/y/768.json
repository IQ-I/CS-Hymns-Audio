{"v":3,"coll":"y","num":768,"id":"hymn_768","title":"OJO Wura oj'Olorun","duration":71.999,"voices":{"male":{"file":"y-768-male.m4a","bytes":521107,"sha256":"18830aab576853f1b6a819fb40a552a926015406405e8977ec9b5175e6efe705","duration":72.0},"female":{"file":"y-768-female.m4a","bytes":539677,"sha256":"44de98aed75fec0e314a7c04d91369a18f8c2f5771227d9edc0b8c0a2d981309","duration":72.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.494,"text":"OJO Wura oj'Olorun","marked":"Ọjọ́ Wúrà òj'Ọlọ́run"},{"start":1.874,"end":3.211,"text":"T'okan aise nin'ogbe na","marked":"T'ọkàn àìṣe nìn'ọ́gbẹ́ ná"},{"start":3.591,"end":5.932,"text":"Nib'ayo nla ko si l'aiye","marked":"Níb'áyò ńlá kò sí l'aiye"},{"start":6.312,"end":8.18,"text":"Bi tura ni Paradise.","marked":"Bí tura ni Párádísè."}],"end":8.18},{"key":"CHORUS","start":9.13,"lines":[{"start":9.13,"end":10.329,"text":"Egbe: Paradise...Paradise","marked":"Párádísè Párádísè"},{"start":10.709,"end":12.864,"text":"A pe k'a to f'aiye sile","marked":"A pe k'á tó f'aiye sílẹ̀"},{"start":13.244,"end":14.758,"text":"Nib'imole...Paradise","marked":"Níb'ìmọ́lẹ̀̀ Párádísè"},{"start":15.138,"end":16.734,"text":"Jesu j'Oba loke lohun.","marked":"Jésù j'Ọba lókè lóhùn."}],"end":16.734},{"key":"2","start":17.684,"lines":[{"start":17.684,"end":19.716,"text":"Subu ara, ese'tiju","marked":"Ṣubú ara, ẹsẹ̀'tiju"},{"start":20.096,"end":21.673,"text":"Iku 'dajo, Ida 'jo won","marked":"Ikú 'dájọ́, Ida 'jọ wọn"},{"start":22.053,"end":23.447,"text":"Dekun ese pare lohun","marked":"Dẹ́kun ẹsẹ̀ parẹ́ lọ́hùn"},{"start":23.827,"end":25.216,"text":"Aiye lo ni Paradise.","marked":"Aiye ló ní Párádísè."}],"end":25.216},{"key":"3","start":26.166,"lines":[{"start":26.166,"end":28.019,"text":"Ko s'adura, ko si ewu","marked":"Kò s'àdúrà, kò sí ewu"},{"start":28.399,"end":30.332,"text":"Ko s'edun mo, ipo sofo","marked":"Kò s'ẹ̀dùn mọ́, ipò ṣòfò"},{"start":30.712,"end":32.114,"text":"Boji ati ibanuje","marked":"Bọ́jì àti ìbànújẹ́"},{"start":32.494,"end":33.879,"text":"Ko si won ni Paradise.","marked":"Kò sí wọn ní Párádísè."}],"end":33.879},{"key":"4","start":34.829,"lines":[{"start":34.829,"end":36.478,"text":"Krist'Oluwa lori igi","marked":"Krist'Olúwa lórí igi"},{"start":36.858,"end":39.197,"text":"Elese ke, pe ranti mi","marked":"Ẹlẹ́sẹ̀ kẹ̀, pé rántí mi"},{"start":39.577,"end":40.96,"text":"Loni 'wo y'o Oluwa wi","marked":"Lòní 'wò y'ó Olúwa wí"},{"start":41.34,"end":42.824,"text":"Pelu mi ni Pradaise.","marked":"Pẹ̀lú mi ní Pradaise."}],"end":42.824},{"key":"5","start":43.774,"lines":[{"start":43.774,"end":45.991,"text":"Ojo wura, gba Krsiti ji","marked":"Ọjọ́ wúrà, gba Krsiti jí"},{"start":46.371,"end":48.394,"text":"Boji sile, aro si pin","marked":"Bòjì sílẹ̀, aró sì pín"},{"start":48.774,"end":50.874,"text":"Ogo nla bo, oku ji, y'o","marked":"Ògo ńlá bọ́, òkú jí, y'o"},{"start":51.254,"end":52.745,"text":"Ba joba ni Paradise.","marked":"Bá jọba ní Párádísè."}],"end":52.745},{"key":"6","start":53.695,"lines":[{"start":53.695,"end":56.068,"text":"Kerubu ho, Serafu yo","marked":"Kérúbù hó, Séráfù yó"},{"start":56.448,"end":58.309,"text":"Eyi ko ha t'ayo re bi","marked":"Èyí kò ha t'àyò rẹ bí"},{"start":58.689,"end":60.131,"text":"Pe Jesu la ona 'gbala","marked":"Pé Jésù la ọ̀nà 'gbàlà"},{"start":60.511,"end":62.127,"text":"Lati aiye lo de orun.","marked":"Láti aiye ló dé ọ̀run."}],"end":62.127},{"key":"7","start":63.077,"lines":[{"start":63.077,"end":64.826,"text":"Tera-mose, ni ere re","marked":"Tẹra-mọ́ṣẹ́, ní èrè rẹ"},{"start":65.206,"end":66.552,"text":"Lati le ri 'hin rere je","marked":"Láti lè rí 'hìn rere jẹ"},{"start":66.932,"end":68.462,"text":"K'a ma kuna Paradise","marked":"K'á má kùnà Párádísè"},{"start":68.842,"end":70.449,"text":"Ope ni fun Metalokan.","marked":"Ọpẹ́ ni fún Mẹ́talọ́kan."}],"end":70.449}]}