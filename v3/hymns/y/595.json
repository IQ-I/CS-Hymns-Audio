{"v":3,"coll":"y","num":595,"id":"hymn_595","title":"FUNRUGBIN lowuro","duration":39.684,"voices":{"male":{"file":"y-595-male-v3.m4a","bytes":272501,"sha256":"edc2a53a2460889fffbb4ebc298e28c2670668d3ab57b1f45d767e83df0065fe","duration":39.7},"female":{"file":"y-595-female-v3.m4a","bytes":280668,"sha256":"73a8f67668fb7bb3ec08f98c667aa51e5df99e1c108af249a983742a35e057e0","duration":39.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.433,"text":"FUNRUGBIN lowurọ,","marked":"Fúnrúgbìn lówúrọ̀"},{"start":1.883,"end":2.932,"text":"Ma sinmi tit' alẹ;","marked":"Má sinmi tít alẹ́"},{"start":3.382,"end":5.497,"text":"F'ẹru oun 'yemeji silẹ,","marked":"F'ẹ́rù òun yẹ̀méjì sílẹ̀"},{"start":5.947,"end":7.264,"text":"Ma fun sibi gbogbo.","marked":"Má fún síbi gbogbo."}],"end":7.264},{"key":"2","start":8.214,"lines":[{"start":8.214,"end":9.331,"text":"'Wọ ko mọ 'yi n hu,","marked":"'Wọ kò mọ yí ń hù"},{"start":9.781,"end":11.153,"text":"T'orọ tabi t'alẹ:","marked":"T'òrọ̀ tàbí t'alẹ̀"},{"start":11.603,"end":12.91,"text":"Ore-ọfẹ yoo pa mọ,","marked":"Ore-ọfẹ yóò pa mọ́"},{"start":13.36,"end":15.039,"text":"'Bi t'o wu k'o bọ si.","marked":"bí t'ó wù k'ó bọ́ sí."}],"end":15.039},{"key":"3","start":15.989,"lines":[{"start":15.989,"end":17.2,"text":"Yoo si hu jade,","marked":"Yóò sì hù jáde"},{"start":17.65,"end":19.01,"text":"L'ẹwa tutu yoyo,","marked":"L'ẹwà tútù yọyọ"},{"start":19.46,"end":21.199,"text":"Bẹni y'o si dagba soke,","marked":"Bẹni y'ó sì dàgbà sókè"},{"start":21.649,"end":22.861,"text":"Y'o s'eso nikẹhin.","marked":"Y'ó s'èso níkẹhìn."}],"end":22.861},{"key":"4","start":23.811,"lines":[{"start":23.811,"end":25.187,"text":"'Wọ k' y'o sisẹ lasan!","marked":"'Wọ k y'ó sisẹ́ lásán!"},{"start":25.637,"end":27.06,"text":"Ojo, iri, orun,","marked":"Ọjọ́, ìrì, ọ̀run"},{"start":27.51,"end":28.938,"text":"Yoo jumọ sisẹ pọ,","marked":"Yóò jùmọ̀ sisẹ́ pọ̀"},{"start":29.388,"end":30.534,"text":"Fun ikore ọrun.","marked":"Fún ìkórè ọ̀run."}],"end":30.534},{"key":"5","start":31.484,"lines":[{"start":31.484,"end":32.806,"text":"Njẹ nikẹhin ojo,","marked":"Ǹjẹ́ níkẹhìn ọjọ́"},{"start":33.256,"end":34.584,"text":"Nigba t'opin ba de,","marked":"Nígbà t'òpin bá dé"},{"start":35.034,"end":36.416,"text":"Awọn Angel' y'o si wa ko,","marked":"Àwọn Angẹl y'ó sì wá kọ"},{"start":36.866,"end":38.135,"text":"Ikore lọ sile.","marked":"Ìkórè lọ sílẹ̀."}],"end":38.135}]}