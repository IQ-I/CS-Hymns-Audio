{"v":3,"coll":"y","num":858,"id":"hymn_858","title":"MO mbo nib agbelebu","duration":33.088,"voices":{"male":{"file":"y-858-male.m4a","bytes":232917,"sha256":"d0c83a9ed1c3f3c3fdd772de9800d2d8720ae5a84bd87c0b01a1be1e6bf8587d","duration":33.1},"female":{"file":"y-858-female.m4a","bytes":239355,"sha256":"c4a8cd9ce2e4e9b1852e150ae62a65cd08afea016bb33e14f9f7665a3cca527a","duration":33.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.555,"text":"MO mbo nib agbelebu","marked":"Mo ḿbọ̀ nib àgbélébùú"},{"start":1.935,"end":3.202,"text":"Emi abosi julo","marked":"Èmi àbòsí jùlọ"},{"start":3.582,"end":5.355,"text":"Mo ka gbogbo nkan s'ofo","marked":"Mo ka gbogbo nkan s'ọ́fọ́"},{"start":5.735,"end":7.546,"text":"Lati ri gbala kikun.","marked":"Láti rí gbàlà kíkún."}],"end":7.546},{"key":"CHORUS","start":8.496,"lines":[{"start":8.496,"end":10.073,"text":"Mo gbekele O, Jesu","marked":"Mo gbẹ́kẹ̀lé O, Jésù"},{"start":10.453,"end":11.52,"text":"Odagutan Kalfari","marked":"Ọ̀dàgùtàn Kalfárì"},{"start":11.9,"end":13.127,"text":"Mo fi 'rele teriba","marked":"Mo fi 'rẹ́lẹ̀ tẹríbá"},{"start":13.507,"end":15.001,"text":"Gba mi, Jesu loni yi.","marked":"Gbà mí, Jésù lọni yí."}],"end":15.001},{"key":"2","start":15.951,"lines":[{"start":15.951,"end":17.253,"text":"Mo gbekele 'leri Re","marked":"Mo gbẹ́kẹ̀lé 'lérí Rẹ"},{"start":17.633,"end":18.899,"text":"At'agbara eje ni","marked":"Àt'agbára ẹ̀jẹ̀ ni"},{"start":19.279,"end":20.6,"text":"Mo pon ara mi l'oju","marked":"Mo pọ́n ara mi l'ojú"},{"start":20.98,"end":22.272,"text":"Mo ru agbelebu Re.","marked":"Mo ru àgbélébùú Rẹ̀."}],"end":22.272},{"key":"3","start":23.222,"lines":[{"start":23.222,"end":25.03,"text":"Jesu fi ayo kun mi","marked":"Jésù fi ayọ̀ kún mi"},{"start":25.41,"end":26.827,"text":"O si so mi di pipe","marked":"Ó sì sọ mí di pípé"},{"start":27.207,"end":28.622,"text":"Mo ni ilera pipe","marked":"Mo ní ìlera pípé"},{"start":29.002,"end":30.535,"text":"Ogo ni f'od'agutan.","marked":"Ògo ni f'ọ̀d'àgùtàn."},{"start":30.915,"end":31.538,"text":"Amin.","marked":"Àmín."}],"end":31.538}]}