{"v":3,"coll":"y","num":481,"id":"hymn_481","title":"DURO lori ileri Kristi Oba","duration":47.426,"voices":{"male":{"file":"y-481-male-v3.m4a","bytes":331452,"sha256":"861629337ce6ffd91f01a6bab2120c797169ceba668a2d3ccf40d7b73ff2e932","duration":47.5},"female":{"file":"y-481-female-v3.m4a","bytes":341002,"sha256":"4ee6e7e5afdac2380cfd5903b0e379de822191b5ecfedcf2ad63c08944f3ccbc","duration":47.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.003,"text":"DURO lori ileri Kristi Oba","marked":"Dúró lórí ìlérí Kristi Ọba"},{"start":2.453,"end":4.13,"text":"L'ojo gbogbo K'iyin Re gba aye kan","marked":"L'ọjọ́ gbogbo K'ìyìn Rẹ̀ gba ayé kan"},{"start":4.58,"end":6.685,"text":"Ogo f'Olorun l'oke em'o korin","marked":"Ògo f'Ọlọ́run l'òkè ẹ̀m'ò kọrin"},{"start":7.135,"end":8.483,"text":"Duro lori 'leri Olorun.","marked":"Dúró lórí lérí Ọlọ́run."}],"end":8.483},{"key":"CHORUS","start":9.433,"lines":[{"start":9.433,"end":10.603,"text":"Duro, duro, duro lori","marked":"Dúró, dúró, dúró lórí"},{"start":11.053,"end":12.436,"text":"'leri Jesu Olugbala","marked":"lérí Jésù Olùgbàlà"},{"start":12.886,"end":14.235,"text":"Duro, duro, mo nduro","marked":"Dúró, dúró, mo ńdúró"},{"start":14.685,"end":15.862,"text":"lori 'Ieri Olorun.","marked":"lórí lérí Ọlọ́run."}],"end":15.862},{"key":"2","start":16.812,"lines":[{"start":16.812,"end":19.089,"text":"Duro lori ileri ti ko le ye","marked":"Dúró lórí ìlérí tí kò lè yẹ"},{"start":19.539,"end":22.246,"text":"Gba t'iji aye nja, ti 'yemeji de","marked":"Gba t'ìjì ayé ǹjà, tí yẹméjì dé"},{"start":22.696,"end":24.695,"text":"Nipa Oro Olorun ni ngo bori","marked":"Nípa Ọ̀rọ̀ Ọlọ́run ni ńgò borí"},{"start":25.145,"end":26.564,"text":"Duro lori 'Ieri Olorun.","marked":"Dúró lórí lérí Ọlọ́run."}],"end":26.564},{"key":"3","start":27.514,"lines":[{"start":27.514,"end":29.214,"text":"Duro lori 'leri Kristi Oluwa","marked":"Dúró lórí lérí Kristi Olúwa"},{"start":29.664,"end":31.495,"text":"Ki 'fe ayeraye so yin po s'okan","marked":"Kí fẹ́ ayérayé sọ yín pọ̀ s'ọkàn"},{"start":31.945,"end":34.098,"text":"J'asegun nipa 'gbara ida Emi","marked":"J'àṣẹ́gun nípa gbára idà Èmi"},{"start":34.548,"end":35.951,"text":"Duro lori 'leri Olorun.","marked":"Dúró lórí lérí Ọlọ́run."}],"end":35.951},{"key":"4","start":36.901,"lines":[{"start":36.901,"end":39.375,"text":"Duro lor ileri, nko le kuna","marked":"Dúró lór ìlérí, ńkò lè kùnà"},{"start":39.825,"end":41.802,"text":"Te'ti sile lati gbo ipe Emi","marked":"Tẹ̀'tí sílẹ̀ láti gbọ́ ìpè Èmi"},{"start":42.252,"end":44.001,"text":"Ki nsimi l'Olugbala mi lohungbogbo","marked":"Kí ńṣìmí l'Olùgbàlà mi lóhùngbogbo"},{"start":44.451,"end":45.876,"text":"Duro lori 'leri Olorun.","marked":"Dúró lórí lérí Ọlọ́run."}],"end":45.876}]}