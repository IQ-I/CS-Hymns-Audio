{"v":3,"coll":"y","num":380,"id":"hymn_380","title":"Emi Mimo sokale","duration":33.627,"voices":{"male":{"file":"y-380-male-v3.m4a","bytes":229680,"sha256":"d721e352d35aad777b96ceaea88e7e1f357156f1d0dbb05085252a246153b7e0","duration":33.7},"female":{"file":"y-380-female-v3.m4a","bytes":235979,"sha256":"bba06a4ba5b685f9ae2f383c107e7976b54a7da2a7ede815b9475d5b72e6de98","duration":33.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.44,"text":"Ẹmi Mimọ sọkalẹ,","marked":"Ẹ̀mí Mímọ́ sọ̀kalẹ̀"},{"start":1.89,"end":3.207,"text":"Ba wa gbe ni ayé yi;","marked":"Bá wa gbé ní ayé yí"},{"start":3.657,"end":4.847,"text":"Fi ohun ọrun han ni,","marked":"Fi ohun ọ̀run hàn ni"},{"start":5.297,"end":6.774,"text":"Si ba ni sin Ọlọrun.","marked":"Sì bá ní sin Ọlọ́run."}],"end":6.774},{"key":"2","start":7.724,"lines":[{"start":7.724,"end":9.306,"text":"Ese wa ni okan wa","marked":"Ẹ̀ṣẹ̀ wa ni ọkàn wa"},{"start":9.756,"end":11.079,"text":"Ti a ko le fi sile","marked":"Tí a kò lè fi sílẹ̀"},{"start":11.529,"end":13.405,"text":"Agbara wa ko to se","marked":"Agbára wa kò tó ṣe"},{"start":13.855,"end":15.414,"text":"Bi “Wo ko ba pelu wa\".","marked":"Bí Wò kò bá pẹ̀lú wa."}],"end":15.414},{"key":"3","start":16.364,"lines":[{"start":16.364,"end":17.74,"text":"Awa ń fẹ k'ẹsẹ parun,","marked":"Àwa ń fẹ́ k'ẹsẹ̀ parun"},{"start":18.19,"end":20.002,"text":"L'ọkan ati l'ara wa;","marked":"L'ọkàn àti l'ara wa"},{"start":20.452,"end":22.106,"text":"Wa, Ẹmi Mimọ, jọ wa,","marked":"Wá, Ẹ̀mí Mímọ́, jọ wá"},{"start":22.556,"end":24.044,"text":"Ko wẹ gbogbo ẹsẹ nu.","marked":"Kò wẹ gbogbo ẹsẹ̀ nù."}],"end":24.044},{"key":"4","start":24.994,"lines":[{"start":24.994,"end":26.816,"text":"Ọlọrun, 'Wọ l'awa ń fẹ,","marked":"Ọlọ́run, 'Wọ l'àwa ń fẹ́"},{"start":27.266,"end":28.655,"text":"Fi Ẹmi Rẹ naa fun wa;","marked":"Fi Ẹ̀mí Rẹ náà fún wa"},{"start":29.105,"end":30.339,"text":"K'a le pa ofin Rẹ mọ,","marked":"K'á lè pa òfin Rẹ̀ mọ́"},{"start":30.789,"end":32.078,"text":"K'a si rin ni ọna Rẹ.","marked":"K'á sì rìn ní ọ̀nà Rẹ̀."}],"end":32.078}]}