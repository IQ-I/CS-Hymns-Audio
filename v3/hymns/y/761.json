{"v":3,"coll":"y","num":761,"id":"hymn_761","title":"ITANNA t'o bo'gbe l'aso","duration":53.467,"voices":{"male":{"file":"y-761-male-v3.m4a","bytes":382223,"sha256":"a7e6e49abe9c3d7865713da6f89933880cc8094ed2511980c43a35a1a77377b9","duration":53.5},"female":{"file":"y-761-female-v3.m4a","bytes":389271,"sha256":"e6e6b00955ed01ec1185e74f0f6f3c23026d51fe277b58bd2b6629e2bbe26f17","duration":53.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.535,"text":"ITANNA t'o bo gbe l'aso","marked":"Ìtànná t'ó bó gbé l'aṣọ"},{"start":2.985,"end":4.323,"text":"T'o tutu yoyo be","marked":"T'ó tútù yọyọ̀ bẹ"},{"start":4.773,"end":6.943,"text":"Gba 'doje ba kan, a si ku","marked":"Gba dòjé bá kan, a sì kú"},{"start":7.393,"end":9.121,"text":"A subu, a si ro.","marked":"A ṣubú, a sì rò."}],"end":9.121},{"key":"2","start":10.071,"lines":[{"start":10.071,"end":11.533,"text":"Apere yi ye f'ara wa","marked":"Apẹ̀rẹ̀ yí yẹ f'ara wa"},{"start":11.983,"end":13.017,"text":"B'or' Olorun ti wi","marked":"B'ọ́r Ọlọ́run ti wí"},{"start":13.467,"end":15.065,"text":"K'omode at'agbalagba","marked":"K'ọmọdé àt'àgbàlagbà"},{"start":15.515,"end":16.894,"text":"Mo ra won l'eweko.","marked":"Mo rà wọ́n l'ewéko."}],"end":16.894},{"key":"3","start":17.844,"lines":[{"start":17.844,"end":19.526,"text":"A! ma gbẹkẹle ẹmi rẹ,","marked":"A! má gbẹ́kẹ̀lé ẹ̀mí rẹ"},{"start":19.976,"end":21.207,"text":"Ma pe 'gba re n' tirẹ;","marked":"Má pe gba rẹ̀ ń tirẹ̀"},{"start":21.657,"end":23.207,"text":"Yika l'a n ri doje iku,","marked":"Yíká l'à ń rí dòjé ikú"},{"start":23.657,"end":24.908,"text":"O mbẹ 'gbẹrun lulẹ.","marked":"Ó mbẹ́ 'gbẹrun lulẹ̀."}],"end":24.908},{"key":"4","start":25.858,"lines":[{"start":25.858,"end":27.409,"text":"Ẹyin t'a dasi di oni,","marked":"Ẹ̀yin t'á dásí di òní"},{"start":27.859,"end":30.251,"text":"Laipẹ, ẹmi y'o pin,","marked":"Láìpẹ́, ẹ̀mí y'ó pín"},{"start":30.701,"end":32.195,"text":"Mura k'ẹ si gbọn l'akoko,","marked":"Múra k'ẹ́ sì gbọ́n l'àkókò"},{"start":32.645,"end":33.951,"text":"Kikọ iku to de.","marked":"Kíkọ́ ikú tó dé."}],"end":33.951},{"key":"5","start":34.901,"lines":[{"start":34.901,"end":37.398,"text":"Koriko, b'o ku, ki ji mo","marked":"Koríko, b'ó kú, kí jí mọ́"},{"start":37.848,"end":39.176,"text":"E ku lati tun ye","marked":"Ẹ kú láti tún yẹ"},{"start":39.626,"end":41.601,"text":"A! b'iku lo je lekun nko","marked":"A! b'ikú ló jẹ́ lẹ́kun ńkọ́"},{"start":42.051,"end":43.577,"text":"S'irora ailopin.","marked":"S'ìrora àìlópin."}],"end":43.577},{"key":"6","start":44.527,"lines":[{"start":44.527,"end":46.127,"text":"Oluwa, jẹ k'a jẹ‘pe Rẹ,","marked":"Olúwa, jẹ́ k'á jẹ'pé Rẹ"},{"start":46.577,"end":47.89,"text":"K'a kuro n'nu ẹsẹ;","marked":"K'á kúrò n'nú ẹsẹ̀"},{"start":48.34,"end":50.062,"text":"Gba t'a lulẹ bi koriko,","marked":"Gba t'á lulẹ̀ bí koríko"},{"start":50.512,"end":51.918,"text":"K'ọkan wa yọ si Ọ.","marked":"K'ọkàn wa yọ̀ sí Ọ."}],"end":51.918}]}