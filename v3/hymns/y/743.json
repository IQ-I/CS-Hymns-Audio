{"v":3,"coll":"y","num":743,"id":"hymn_743","title":"KERUBU ati Serafu","duration":68.735,"voices":{"male":{"file":"y-743-male-v3.m4a","bytes":478449,"sha256":"f373dc9b9f83f952561ceb16e3390ecb73307ca51d42c78ce231b16ed18631ae","duration":68.8},"female":{"file":"y-743-female-v3.m4a","bytes":488184,"sha256":"0f4ef9ff94737e946f1f1a6b3a2ec033e1ec11178d3227a31504d7ccb45011ee","duration":68.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.052,"text":"KÉRÚBÙ ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":2.502,"end":3.838,"text":"Wọn n yi'tẹ Baba ka,","marked":"Wọ́n ń yí'tẹ́ Baba ká"},{"start":4.288,"end":5.664,"text":"Nigbakugba niwaju Rẹ,","marked":"Nígbàkúgbà níwájú Rẹ̀"},{"start":6.114,"end":7.302,"text":"Ni wọn n kọrin ogo.","marked":"Ni wọ́n ń kọrin ògo."}],"end":7.302},{"key":"CHORUS","start":8.252,"lines":[{"start":8.252,"end":10.218,"text":"N kọrin Ogo, Ogo,","marked":"N kọrin Ògo, Ògo"},{"start":10.668,"end":11.189,"text":"Ogo (2).","marked":"Ògo ."}],"end":11.189},{"key":"2","start":12.139,"lines":[{"start":12.139,"end":13.613,"text":"Gbogb' Ọmọ Ẹgbẹ Kérúbù,","marked":"Gbogb Ọmọ Ẹgbẹ́ Kérúbù"},{"start":14.063,"end":15.384,"text":"Ẹ tọju iwa yin;","marked":"Ẹ tọ́jú ìwà yín"},{"start":15.834,"end":17.259,"text":"Gbogbo Ẹgbẹ t'o wa l'ayé,","marked":"Gbogbo Ẹgbẹ́ t'ó wà l'ayé"},{"start":17.709,"end":19.091,"text":"Ni 'dapọ mọ t'ọrun.","marked":"Ní 'dapọ mọ́ t'ọ̀run."}],"end":19.091},{"key":"3","start":20.041,"lines":[{"start":20.041,"end":21.648,"text":"Gbogb' Ọmọ Ẹgbẹ Séráfù,","marked":"Gbogb Ọmọ Ẹgbẹ́ Séráfù"},{"start":22.098,"end":23.411,"text":"Ẹ tọju iwa yin;","marked":"Ẹ tọ́jú ìwà yín"},{"start":23.861,"end":25.302,"text":"K'a ba le pẹl' awọn t'ọrun,","marked":"K'á bá lè pẹl' àwọn t'ọ̀run"},{"start":25.752,"end":27.059,"text":"Lati ma juba Rẹ.","marked":"Láti má júbà Rẹ."}],"end":27.059},{"key":"4","start":28.009,"lines":[{"start":28.009,"end":29.356,"text":"Awọn ẹgbẹ t'o wa l'orun,","marked":"Àwọn ẹgbẹ́ t'ó wà l'ọ̀run"},{"start":29.806,"end":31.557,"text":"Wọn wo bi a ti n ja;","marked":"Wọ́n wò bí a ti ń jà"},{"start":32.007,"end":33.704,"text":"Wọn si n fi ohun kan wi pé,","marked":"Wọ́n sì ń fi ohun kan wí pé"},{"start":34.154,"end":35.497,"text":"Ẹ ma tẹ siwaju.","marked":"Ẹ má tẹ̀ síwájú."}],"end":35.497},{"key":"5","start":36.447,"lines":[{"start":36.447,"end":37.934,"text":"Ninu ipọnju at'ẹgun,","marked":"Nínú ìpọ́njú àt'ẹ̀gún"},{"start":38.384,"end":39.446,"text":"Ninu 'rukerudo;","marked":"Nínú rúkèrúdò"},{"start":39.896,"end":41.508,"text":"Ninu irumi at'iji,","marked":"Nínú ìrumi àt'ìjì"},{"start":41.958,"end":43.274,"text":"Yoo s'ọna wa fefe.","marked":"Yóò s'ọ̀nà wa fẹ́fẹ́."}],"end":43.274},{"key":"6","start":44.224,"lines":[{"start":44.224,"end":45.964,"text":"Majẹmu ati ẹjẹ rẹ,","marked":"Májẹ̀mú àti ẹ̀jẹ̀ rẹ"},{"start":46.414,"end":47.428,"text":"Ni igbẹkẹle wa;","marked":"Ní ìgbẹ́kẹ̀lé wa"},{"start":47.878,"end":49.249,"text":"B' ileri na tilẹ falẹ,","marked":"B ìlérí ná tilẹ̀ falẹ̀"},{"start":49.699,"end":51.448,"text":"Sugbọn ko le pẹ de.","marked":"Sùgbọ́n kò lè pẹ́ dé."}],"end":51.448},{"key":"7","start":52.398,"lines":[{"start":52.398,"end":53.853,"text":"Nigba t'a ba par' isẹ wa,","marked":"Nígbà t'á bá par isẹ́ wa"},{"start":54.303,"end":55.517,"text":"Ni ayé osi yi;","marked":"Ní ayé òsì yí"},{"start":55.967,"end":57.778,"text":"Ade Ogo yoo jẹ tiwa,","marked":"Adé Ògo yóò jẹ́ tiwa"},{"start":58.228,"end":59.697,"text":"T'ẹnikan ko le gba.","marked":"T'ẹnìkan kò lè gbà."}],"end":59.697},{"key":"8","start":60.647,"lines":[{"start":60.647,"end":62.227,"text":"Ogo, ọla at'agbara,","marked":"Ògo, ọlá àt'agbára"},{"start":62.677,"end":63.884,"text":"Ni fun Mẹtalọkan,","marked":"Ní fún Mẹ́talọ́kan"},{"start":64.334,"end":65.402,"text":"Ayérayé Ọlọrun wa,","marked":"Ayérayé Ọlọ́run wa"},{"start":65.852,"end":67.187,"text":"Amin, bẹni ki o ri.","marked":"Àmín, bẹ́ni kí ó rí."}],"end":67.187}]}