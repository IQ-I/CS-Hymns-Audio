{"v":3,"coll":"y","num":547,"id":"hymn_547","title":"JESU, ayo okan gbogbo","duration":46.781,"voices":{"male":{"file":"y-547-male-v3.m4a","bytes":331493,"sha256":"6ee61ec063476dc8dab2c9530232c71bf1bd4b8deb8096384f505e9cb839c470","duration":46.8},"female":{"file":"y-547-female-v3.m4a","bytes":345921,"sha256":"f92630cf446484d62c6455047a19a94a4c0bee966f113dd01fc4c7b83256eb73","duration":46.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.459,"text":"JESU, ayọ ọkan gbogbo,","marked":"Jésù, ayọ̀ ọkàn gbogbo"},{"start":2.909,"end":4.7,"text":"Orisun 'ye, imọlẹ wa,","marked":"Orísun yè, ìmọ́lẹ̀ wà"},{"start":5.15,"end":6.7,"text":"Nin' ọpọ bukun ayé yi,","marked":"Nín ọ̀pọ̀ bùkún ayé yí"},{"start":7.15,"end":9.407,"text":"Lainitẹlọrun: a tọ wa.","marked":"Láìnítẹ̀lọ́rùn: a tọ̀ wá."}],"end":9.407},{"key":"2","start":10.357,"lines":[{"start":10.357,"end":11.636,"text":"Otitọ rẹ duro lailai,","marked":"Òtítọ́ rẹ dúró láéláé"},{"start":12.086,"end":13.968,"text":"'Wọn gba awọn to ke pe Ọ la,","marked":"'Wọn gba àwọn tó ké pè Ọ́ là"},{"start":14.418,"end":15.852,"text":"Awọn ti o wa Ọ, ri Ọ,","marked":"Àwọn tí ó wà Ọ́, rí Ọ"},{"start":16.302,"end":17.686,"text":"Bi gbogbo nin' ohun gbogbo","marked":"Bí gbogbo nín ohun gbogbo"}],"end":17.686},{"key":"3","start":18.636,"lines":[{"start":18.636,"end":20.604,"text":"A tọ Ọ wa, Ounjẹ iye,","marked":"A tọ̀ Ọ́ wá, Oúnjẹ iye"},{"start":21.054,"end":22.7,"text":"A fẹ jẹ l'arẹ Rẹ titi,","marked":"A fẹ́ jẹ́ l'àrẹ Rẹ̀ títí"},{"start":23.15,"end":25.009,"text":"A mu ninu Rẹ, Orisun,","marked":"A mú nínú Rẹ̀, Orísun"},{"start":25.459,"end":27.397,"text":"Lati pa oungbẹ ọkan wa.","marked":"Láti pa òùngbẹ ọkàn wá."}],"end":27.397},{"key":"4","start":28.347,"lines":[{"start":28.347,"end":29.977,"text":"Oungbẹ Rẹ sa n gbẹ ọkan wa,","marked":"Òùngbẹ Rẹ̀ sá ń gbẹ ọkàn wá"},{"start":30.427,"end":32.786,"text":"Nibikibi t'o wu k'a wa;","marked":"Níbikíbi t'ó wù k'á wá"},{"start":33.236,"end":34.705,"text":"'Gba t'a ba ri Ọ awa yọ,","marked":"gbà t'á bá rí Ọ àwa yọ̀"},{"start":35.155,"end":36.935,"text":"Ayọ nigba t'a gba Ọ gbọ.","marked":"Ayọ̀ nígbà t'á gbà Ọ́ gbọ́."}],"end":36.935},{"key":"5","start":37.885,"lines":[{"start":37.885,"end":39.582,"text":"Jesu, wa ba wa gbe titi,","marked":"Jésù, wá bá wa gbé títí"},{"start":40.032,"end":41.599,"text":"Se akoko wa ni rere;","marked":"Ṣe àkókò wa ní rere"},{"start":42.049,"end":43.451,"text":"Le okunkun ẹsẹ kuro,","marked":"Lé òkùnkùn ẹsẹ̀ kúrò"},{"start":43.901,"end":45.231,"text":"Tan 'mọlẹ Rẹ mimọ s'ayé.","marked":"Tan 'mọlẹ Rẹ mímọ́ s'ayé."}],"end":45.231}]}