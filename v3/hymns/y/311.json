{"v":3,"coll":"y","num":311,"id":"hymn_311","title":"OLUWA mi ha ta eje Re sile, O si ku?","duration":54.017,"voices":{"male":{"file":"y-311-male.m4a","bytes":391860,"sha256":"9144319b5f21bb4655f6f28025602b7811f36be17d2e045f19423826ac1c4617","duration":54.1},"female":{"file":"y-311-female.m4a","bytes":404152,"sha256":"a894272c6310762b04ddbfad3065278d4db8a805f47f7b3e2c3b459fb282d474","duration":54.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.004,"text":"OLUWA mi ha ta eje Re sile, O si ku?","marked":"Olúwa mi ha ta ẹ̀jẹ̀ Rẹ̀ sílẹ̀, Ó sì kú?"},{"start":3.384,"end":5.03,"text":"O wa f'ori ogo Re ni","marked":"Ó wá f'orí ògo Rẹ̀ ni"},{"start":5.41,"end":6.594,"text":"Sile fun 'ru emi?","marked":"Sílé fún 'ru èmi?"},{"start":6.974,"end":9.149,"text":"Egbe: Nibi agbelebu ni mo ko r'imole","marked":"Níbi àgbélébùú ni mo kọ r'ìmọ́lẹ̀̀"},{"start":9.529,"end":11.172,"text":"Nibe I'eru okan mi si fo lo","marked":"Níbẹ̀ l'ẹrù ọkàn mi sì fò lọ"},{"start":11.552,"end":12.452,"text":"(si fo Io)","marked":"sì fò lọ"},{"start":12.832,"end":14.397,"text":"Nibe nipa igbagbo mo riran","marked":"Níbẹ̀ nípa ìgbàgbọ́́ mo ríran"},{"start":14.777,"end":16.619,"text":"N'sinyi mo wa I 'alaafia titi.","marked":"N'sìnyí mo wá I 'àlàáfíà títí."}],"end":16.619},{"key":"CHORUS","start":17.569,"lines":[{"start":17.569,"end":19.708,"text":"Nibi agbelebu ni mo ko r'imole","marked":"Níbi àgbélébùú ni mo kọ r'ìmọ́lẹ̀̀"},{"start":20.088,"end":21.879,"text":"Nibe I'eru okan mi si fo lo","marked":"Níbẹ̀ l'ẹrù ọkàn mi sì fò lọ"},{"start":22.259,"end":23.249,"text":"(si fo Io)","marked":"sì fò lọ"},{"start":23.629,"end":25.248,"text":"Nibe nipa igbagbo mo riran","marked":"Níbẹ̀ nípa ìgbàgbọ́́ mo ríran"},{"start":25.628,"end":27.903,"text":"N'sinyi mo wa I 'alaafia titi.","marked":"N'sìnyí mo wá I 'àlàáfíà títí."}],"end":27.903},{"key":"2","start":28.853,"lines":[{"start":28.853,"end":30.468,"text":"Nje n'tori 'se 'bi mi l'O se","marked":"Ǹjẹ́ n'torí 'ṣe 'bí mi l'Ó ṣe"},{"start":30.848,"end":31.96,"text":"Kerora lor'igi'?","marked":"Kèrora lor'igi'?"},{"start":32.34,"end":33.558,"text":"Oore-ofe iyanu ni","marked":"Oore-ọ̀fẹ́ ìyanu ni"},{"start":33.938,"end":35.102,"text":"At'ife ailegbe!","marked":"Àt'ìfẹ́ àìlẹ́gbẹ́!"}],"end":35.102},{"key":"3","start":36.052,"lines":[{"start":36.052,"end":37.404,"text":"OOrun wo s'inu okunkun","marked":"OOrun wọ s'ínú òkùnkùn"},{"start":37.784,"end":38.899,"text":"O b'ogo Re mole","marked":"Ó b'ògo Rẹ̀ mọ́lẹ̀"},{"start":39.279,"end":41.428,"text":"'Gba ti Kristi, Eleda ku","marked":"'Gbà tí Kristi, Ẹlẹ́dàá kú"},{"start":41.808,"end":43.016,"text":"Fun ese eniyan.","marked":"Fún ẹ̀ṣẹ̀ ènìyàn."}],"end":43.016},{"key":"4","start":43.966,"lines":[{"start":43.966,"end":45.388,"text":"Sugbon omije ko le san","marked":"Ṣùgbọ́n omijé kò lè ṣàn"},{"start":45.768,"end":47.709,"text":"Gbese 'f'e ti mo je","marked":"Gbèsè 'f'é tí mo jẹ́"},{"start":48.089,"end":49.94,"text":"Oluwa, mo f'ara mi 'le","marked":"Olúwa, mo f'ara mi 'le"},{"start":50.32,"end":51.494,"text":"Fun ife Re nikan.","marked":"Fún ìfẹ́ Rẹ nìkan."},{"start":51.874,"end":52.467,"text":"Amin.","marked":"Àmín."}],"end":52.467}]}