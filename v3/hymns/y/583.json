{"v":3,"coll":"y","num":583,"id":"hymn_583","title":"IRANSE Oluwa!","duration":40.257,"voices":{"male":{"file":"y-583-male-v3.m4a","bytes":273856,"sha256":"cd067c0b576509747a2070e2258d9bb50c9ddffc2ec6665e3ca905cb838c2a23","duration":40.3},"female":{"file":"y-583-female-v3.m4a","bytes":283642,"sha256":"de3d562fbb630c22495f5da1408be10018d1bfb6c2ce6323cdb0dfe98fff3b8d","duration":40.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.3,"text":"IRANSẸ Oluwa!","marked":"Ìránsẹ́ Olúwa!"},{"start":1.75,"end":2.808,"text":"Ẹ duro nid' isẹ,","marked":"Ẹ dúró níd isẹ́"},{"start":3.258,"end":4.434,"text":"Ẹ tọju ọrọ mimọ Rẹ,","marked":"Ẹ tọ́jú ọ̀rọ̀ mímọ́ Rẹ̀"},{"start":4.884,"end":5.955,"text":"Ẹ ma sọna Rẹ sa.","marked":"Ẹ má sọ́nà Rẹ̀ sá."}],"end":5.955},{"key":"2","start":6.905,"lines":[{"start":6.905,"end":8.137,"text":"Jẹ k'imọlẹ yin tan,","marked":"Jẹ́ k'ìmọ́lẹ̀ yín tán"},{"start":8.587,"end":9.754,"text":"Ẹ tun fitila se;","marked":"Ẹ tún fìtílà ṣe"},{"start":10.204,"end":11.502,"text":"Ẹ damure girigiri,","marked":"Ẹ dàmúrè gírígírí"},{"start":11.952,"end":13.235,"text":"Orukọ Rẹ l'ẹru.","marked":"Orúkọ Rẹ l'ẹ́rù."}],"end":13.235},{"key":"3","start":14.185,"lines":[{"start":14.185,"end":16.247,"text":"Sọra! l'asẹ Jesu,","marked":"Sọ́ra! l'àsẹ Jésù"},{"start":16.697,"end":18.449,"text":"B'a ti n sọ, ko jina;","marked":"B'á ti ń sọ, kò jìnà"},{"start":18.899,"end":20.657,"text":"B'o ba kuku ti kan 'lẹkun,","marked":"B'ó bá kúkú ti kan 'lẹkun"},{"start":21.107,"end":22.55,"text":"Ki ẹ si fun lọgan.","marked":"Kí ẹ sì fún lọ́gán."}],"end":22.55},{"key":"4","start":23.5,"lines":[{"start":23.5,"end":24.581,"text":"Iransẹ 'rẹ l'eni,","marked":"Ìránsẹ́ 'rẹ l'ẹni"},{"start":25.031,"end":26.209,"text":"Ti a ba nipo yi;","marked":"Tí a bá nípò yí"},{"start":26.659,"end":28.78,"text":"Ayọ l'oun o fi r'Oluwa,","marked":"Ayọ̀ l'òun ó fi r'Olúwa"},{"start":29.23,"end":30.782,"text":"Y'o f'ọla de l'ade.","marked":"Y'ó f'ọlá dé l'adé."}],"end":30.782},{"key":"5","start":31.732,"lines":[{"start":31.732,"end":33.093,"text":"Kristi tikalare","marked":"Kristi tìkáláre"},{"start":33.543,"end":35.027,"text":"Y'o te tabili fun","marked":"Y'ó tẹ́ tábìlì fún"},{"start":35.477,"end":36.859,"text":"Y'o gb'ori iranse na ga","marked":"Y'ó gb'orí ìránṣẹ́ ná ga"},{"start":37.309,"end":38.707,"text":"Larin egbe Angel.","marked":"Lárin ẹgbẹ́ Angẹl."}],"end":38.707}]}