{"v":3,"coll":"y","num":215,"id":"hymn_215","title":"KI gbogbo ojubo Oro d'oko","duration":133.725,"voices":{"male":{"file":"y-215-male-v3.m4a","bytes":968506,"sha256":"e81d5b6cbe80b2ffea16de525b9e402c9167df757ad2c85f8b9bfe90f6ef8d19","duration":133.8},"female":{"file":"y-215-female-v3.m4a","bytes":1003178,"sha256":"c5ac6e4cb4b51518c8c86cfb3a3780c32d60153ee451b094f65a5f4044cf96c5","duration":133.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.069,"text":"KI gbogbo ojubo Oro d'oko,","marked":"Kí gbogbo ojúbọ Ọ̀rọ̀ d'oko"},{"start":2.519,"end":6.553,"text":"T'Ọya, t'Ogun ati t'Esu, ki wọn","marked":"T'Ọ̀yà, t'Ogun àti t'Èṣù, kí wọn"},{"start":7.003,"end":9.365,"text":"dojubo Jesu Oba, L'adura Ijọ","marked":"dojúbọ Jésù Ọba, L'àdúrà Ìjọ"},{"start":9.815,"end":19.238,"text":"Serafu. Oluwa, se wa ni Tirẹ, Tirẹ sa ni wa titi ayé, Nitori Kristi Ọmọ Baba, Da wa si n'Ijọ Séráfù.","marked":"Séráfù. Olúwa, ṣe wà ní Tirẹ̀, Tirẹ̀ sá ni wá títí ayé, Nítorí Kristi Ọmọ Baba, Dá wa sì n'Ìjọ Séráfù."}],"end":19.238},{"key":"CHORUS","start":20.188,"lines":[{"start":20.188,"end":21.557,"text":"Oluwa, se wa ni Tire,","marked":"Olúwa, ṣe wà ní Tìrẹ"},{"start":22.007,"end":24.034,"text":"Tire sa ni wa titi aiye,","marked":"Tirẹ̀ sá ni wá títí ayé"},{"start":24.484,"end":26.031,"text":"Nitori Kristi Omo Baba,","marked":"Nítorí Kristi Ọmọ Baba"},{"start":26.481,"end":27.95,"text":"Da wa sil' Egbe Sarafu.","marked":"Dá wa síl Ẹgbẹ́ Sarafu."}],"end":27.95},{"key":"2","start":28.9,"lines":[{"start":28.9,"end":30.499,"text":"Ki gbogbo ojubọ Irumọlẹ","marked":"Kí gbogbo ojúbọ Ìrúmọ́lẹ̀"},{"start":30.949,"end":32.679,"text":"Ti Sangó ati sanponna,","marked":"Ti Sangó àti ṣànpọ́nná"},{"start":33.129,"end":34.825,"text":"Ki wọn dojubọ Jesu Ọba,","marked":"Kí wọ́n dojúbọ Jésù Ọba"},{"start":35.275,"end":36.833,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":36.833},{"key":"3","start":37.783,"lines":[{"start":37.783,"end":39.463,"text":"Ki gbogbo ojubọ Irumọlẹ,","marked":"Kí gbogbo ojúbọ Ìrúmọ́lẹ̀"},{"start":39.913,"end":41.755,"text":"T'Ifa ati t'Ọbaluayé,","marked":"T'Ifa àti t'Ọbaluayé"},{"start":42.205,"end":43.777,"text":"Ki wọn dojubọ Jesu Ọba,","marked":"Kí wọ́n dojúbọ Jésù Ọba"},{"start":44.227,"end":45.703,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":45.703},{"key":"4","start":46.653,"lines":[{"start":46.653,"end":48.194,"text":"Ki gbogbo ojubọ 'risa loko,","marked":"Kí gbogbo ojúbọ rìṣà lóko"},{"start":48.644,"end":50.39,"text":"Ti babaji ati osun,","marked":"Ti babaji àti osùn"},{"start":50.84,"end":52.544,"text":"Ki wọn dojubọ Jesu Ọba,","marked":"Kí wọ́n dojúbọ Jésù Ọba"},{"start":52.994,"end":54.543,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":54.543},{"key":"5","start":55.493,"lines":[{"start":55.493,"end":56.993,"text":"K'awọn agbagba le yipada,","marked":"K'àwọn àgbàgbà lè yípadà"},{"start":57.443,"end":59.048,"text":"Ati Ọba Osemọwe,","marked":"Àti Ọba Òsemọ̀wé"},{"start":59.498,"end":61.135,"text":"Ki wọn le juba Jesu Ọba,","marked":"Kí wọ́n lè júbà Jésù Ọba"},{"start":61.585,"end":63.086,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":63.086},{"key":"6","start":64.036,"lines":[{"start":64.036,"end":65.266,"text":"Ki gbogbo ojubọ Ọlọrun,","marked":"Kí gbogbo ojúbọ Ọlọ́run"},{"start":65.716,"end":67.44,"text":"Ti 'Gunnu ati Gelede,","marked":"Ti gunnu àti Gẹlẹ́dẹ̀"},{"start":67.89,"end":69.559,"text":"Ki wọn dojubọ Jesu Ọba,","marked":"Kí wọ́n dojúbọ Jésù Ọba"},{"start":70.009,"end":71.569,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":71.569},{"key":"7","start":72.519,"lines":[{"start":72.519,"end":74.276,"text":"K'awọn Keferi le yipada,","marked":"K'àwọn Kèfèrí lè yípadà"},{"start":74.726,"end":75.905,"text":"At'awọn Elegun pẹlu,","marked":"Àt'àwọn Elégun pẹ̀lú"},{"start":76.355,"end":78.037,"text":"Ki wọn le juba Jesu Ọba,","marked":"Kí wọ́n lè júbà Jésù Ọba"},{"start":78.487,"end":80.08,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":80.08},{"key":"8","start":81.03,"lines":[{"start":81.03,"end":82.754,"text":"K'awọn ọlọya le yipada,","marked":"K'àwọn ọlọ́yà lè yípadà"},{"start":83.204,"end":84.367,"text":"At'awọn alagẹmo,","marked":"Àt'àwọn alágẹmo"},{"start":84.817,"end":86.449,"text":"Ki wọn le juba Jesu Ọba,","marked":"Kí wọ́n lè júbà Jésù Ọba"},{"start":86.899,"end":88.479,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":88.479},{"key":"9","start":89.429,"lines":[{"start":89.429,"end":90.868,"text":"Ki gbogbo ọmọ 'jọ Séráfù,","marked":"Kí gbogbo ọmọ 'jọ Séráfù"},{"start":91.318,"end":92.795,"text":"At'Ijọ Kérúbù pẹlu,","marked":"Àt'Ìjọ Kérúbù pẹ̀lú"},{"start":93.245,"end":94.823,"text":"Ki wọn le juba Jesu Ọba,","marked":"Kí wọ́n lè júbà Jésù Ọba"},{"start":95.273,"end":96.806,"text":"L'adura Ijọ Séráfù.","marked":"L'àdúrà Ìjọ Séráfù."}],"end":96.806},{"key":"10","start":97.756,"lines":[{"start":97.756,"end":99.087,"text":"Ki gbogb' awọn Ẹgbẹ Akọrin,","marked":"Kí gbogb àwọn Ẹgbẹ́ Akọrin"},{"start":99.537,"end":101.004,"text":"Ati Ẹgbẹ Aladura","marked":"Àti Ẹgbẹ́ Aládúrà"},{"start":101.454,"end":102.885,"text":"Ki Ẹgbẹ Igbimọ Séráfù,","marked":"Kí Ẹgbẹ́ Ìgbìmọ̀ Séráfù"},{"start":103.335,"end":104.857,"text":"Ki wọn d'amure wọn giri.","marked":"Kí wọ́n d'àmùrè wọn gírí."}],"end":104.857},{"key":"11","start":105.807,"lines":[{"start":105.807,"end":107.435,"text":"K'Ọlọrun da alagba wa si,","marked":"K'Ọlọ́run dá alàgbà wa sí"},{"start":107.885,"end":109.14,"text":"Ati awọn Isọngbe rẹ","marked":"Àti àwọn Ìsọ̀ǹgbè rẹ̀"},{"start":109.59,"end":111.084,"text":"K'Ọlọrun tubo ran yin lọwọ,","marked":"K'Ọlọ́run túbọ̀ ràn yín lọ́wọ́"},{"start":111.534,"end":113.245,"text":"K'O di yin l'amure ododo.","marked":"K'Ó di yín l'àmùrè òdodo."}],"end":113.245},{"key":"12","start":114.195,"lines":[{"start":114.195,"end":115.762,"text":"K'a fi ogo fun Baba l'oke,","marked":"K'á fi ògo fún Baba l'òkè"},{"start":116.212,"end":118.958,"text":"k'a f'ogo fun Omo pelu, K'a","marked":"k'á f'ògo fún Ọmọ pẹ̀lú, K'á"},{"start":119.408,"end":122.085,"text":"fi ogo fun Emi Mimo , Metalokan","marked":"fi ògo fún Ẹ̀mí Mímọ́ , Mẹ́talọ́kan"},{"start":122.535,"end":132.177,"text":"l'ope ye fun. Oluwa, se wa ni Tirẹ, Tirẹ sa ni wa titi ayé, Nitori Kristi Ọmọ Baba, Da wa si n'Ijọ Séráfù.","marked":"l'ọpẹ́ yẹ fún. Olúwa, ṣe wà ní Tirẹ̀, Tirẹ̀ sá ni wá títí ayé, Nítorí Kristi Ọmọ Baba, Dá wa sì n'Ìjọ Séráfù."}],"end":132.177}]}