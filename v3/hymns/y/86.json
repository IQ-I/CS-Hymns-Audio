{"v":3,"coll":"y","num":86,"id":"hymn_86","title":"OLUWA ọrun oun ayé,","duration":70.926,"voices":{"male":{"file":"y-86-male-v3.m4a","bytes":483877,"sha256":"e07a52ceba2c4070bb91c9e103e192114920617be4069b9282c0d2081b01dc18","duration":71.0},"female":{"file":"y-86-female-v3.m4a","bytes":496506,"sha256":"a909ec69a11b2b2349290477af704e3ae1e38010df9ea7156aeb26d0ed62b8c5","duration":71.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.527,"text":"OLUWA ọrun oun ayé,","marked":"Olúwa ọ̀run òun ayé"},{"start":1.977,"end":3.715,"text":"Wọ n'iyin at'ọpẹ yẹ fun;","marked":"Wọ n'ìyìn àt'ọpẹ́ yẹ fún"},{"start":4.165,"end":5.805,"text":"Bawo l'a ba ti fẹ Ọ to?","marked":"Báwo l'a bá ti fẹ́ Ọ tó?"},{"start":6.255,"end":7.173,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":7.173},{"key":"2","start":8.123,"lines":[{"start":8.123,"end":9.514,"text":"Orun ti ń ran at'afẹfẹ,","marked":"Ọ̀run tí ń ràn àt'afẹ́fẹ́"},{"start":9.964,"end":11.619,"text":"Gbogbo eweko ń sọ'fẹ Rẹ;","marked":"Gbogbo ewéko ń sọ'fẹ́ Rẹ"},{"start":12.069,"end":13.429,"text":"'Wọ l'O ń mu irugbin dara,","marked":"'Wọ l'Ó ń mú irúgbìn dára"},{"start":13.879,"end":14.769,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":14.769},{"key":"3","start":15.719,"lines":[{"start":15.719,"end":17.067,"text":"Fun ara lile wa gbogbo,","marked":"Fún ara líle wa gbogbo"},{"start":17.517,"end":18.981,"text":"Fun gbogbo ibukun ayé;","marked":"Fún gbogbo ìbùkún ayé"},{"start":19.431,"end":21.621,"text":"Awa yin Ọ, a si dupẹ,","marked":"Àwa yìn Ọ́, a sì dúpẹ́"},{"start":22.071,"end":22.993,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":22.993},{"key":"4","start":23.943,"lines":[{"start":23.943,"end":25.306,"text":"O ko du wa ni ọmọ Rẹ,","marked":"O kò dù wá ní ọmọ Rẹ̀"},{"start":25.756,"end":27.189,"text":"O fi fun ayé ẹsẹ wa;","marked":"Ó fi fún ayé ẹsẹ̀ wa"},{"start":27.639,"end":29.083,"text":"O si f'ẹbun gbogbo pẹlu,","marked":"Ó sì f'ẹ̀bùn gbogbo pẹ̀lú"},{"start":29.533,"end":30.39,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":30.39},{"key":"5","start":31.34,"lines":[{"start":31.34,"end":32.609,"text":"O fun wa l'Emi Mimo Re,","marked":"Ó fún wa l'Ẹ̀mí Mímọ́ Rẹ̀"},{"start":33.059,"end":34.739,"text":"Emi iye at'agbara","marked":"Ẹ̀mí ìyè àt'agbára"},{"start":35.189,"end":36.439,"text":"O rojo ekun 'bukun Re,","marked":"Ó rọ̀jò ẹkún bùkún Rẹ̀"},{"start":36.889,"end":37.859,"text":"Le wa lori.","marked":"Lè wà lórí."}],"end":37.859},{"key":"6","start":38.809,"lines":[{"start":38.809,"end":40.35,"text":"Fun idariji ẹsẹ wa,","marked":"Fún ìdáríjì ẹsẹ̀ wa"},{"start":40.8,"end":42.115,"text":"Ati fun ireti ọrun;","marked":"Àti fún ìrètí ọ̀run"},{"start":42.565,"end":43.983,"text":"Ki l'ohun t'a ba fi fun Ọ?","marked":"Kí l'ohun t'a bá fi fún Ọ?"},{"start":44.433,"end":45.311,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":45.311},{"key":"7","start":46.261,"lines":[{"start":46.261,"end":48.0,"text":"Owo, ti a ń na, ofo ni,","marked":"Ọwọ́, tí à ń nà, ọ̀fọ̀ ni"},{"start":48.45,"end":50.312,"text":"Sugbọn eyi t'a fi fun Ọ;","marked":"Sùgbọ́n èyí t'a fi fún Ọ"},{"start":50.762,"end":52.2,"text":"O jẹ isura tit'ayé,","marked":"Ó jẹ́ ìṣúra tit'ayé"},{"start":52.65,"end":53.496,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":53.496},{"key":"8","start":54.446,"lines":[{"start":54.446,"end":55.61,"text":"Ohun t'a bun Ọ Oluwa,","marked":"Ohun t'a bùn Ọ́ Olúwa"},{"start":56.06,"end":57.577,"text":"'Wọ o san le e pada fun wa;","marked":"'Wọ ó sàn lé e padà fún wa"},{"start":58.027,"end":59.81,"text":"Layọ l'a o ta Ọ lọrẹ,","marked":"Láyọ̀ l'a ò ta Ọ́ lọ́rẹ̀"},{"start":60.26,"end":61.236,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":61.236},{"key":"9","start":62.186,"lines":[{"start":62.186,"end":63.887,"text":"Ni ọdọ Rẹ l'a ti san wa,","marked":"Ní ọ̀dọ̀ Rẹ l'á ti sàn wá"},{"start":64.337,"end":65.41,"text":"Ọlọrun Olodumare;","marked":"Ọlọ́run Olódùmarè"},{"start":65.86,"end":68.015,"text":"Jẹ k'a le ba Ọ gbe titi","marked":"Jẹ́ k'á lè bá Ọ gbé títí"},{"start":68.465,"end":69.378,"text":"Onibu-ọrẹ.","marked":"Onibu-ọrẹ."}],"end":69.378}]}