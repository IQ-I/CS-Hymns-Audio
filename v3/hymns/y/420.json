{"v":3,"coll":"y","num":420,"id":"hymn_420","title":"PASE 'bukun Re t'oke wa","duration":27.772,"voices":{"male":{"file":"y-420-male-v3.m4a","bytes":195111,"sha256":"7e534d300eabc511835907aefcc3fd8f3032642c3897678b486d42c716bd9f0c","duration":27.8},"female":{"file":"y-420-female-v3.m4a","bytes":203988,"sha256":"8d08491ea7df90f050048cfb51bbfb6e07192862f47cc0c1f6df551477ad049c","duration":27.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.802,"text":"PASẸ 'bukun Rẹ t'oke wa,","marked":"Pasẹ̀ bùkún Rẹ t'òkè wá"},{"start":2.252,"end":4.046,"text":"Ọlọrun, s'ara Ijọ yi;","marked":"Ọlọ́run, s'ára Ìjọ yí"},{"start":4.496,"end":6.261,"text":"Fi ifẹ ti Baba wọ wa,","marked":"Fi ìfẹ́ tí Baba wọ wá"},{"start":6.711,"end":8.319,"text":"Gba' a f'ẹru gboju s'oke","marked":"Gbà a f'ẹ́rù gbójú s'òkè"}],"end":8.319},{"key":"2","start":9.269,"lines":[{"start":9.269,"end":11.281,"text":"Pase ibukun Re, Jesu","marked":"Pàṣẹ ìbùkún Rẹ̀, Jésù"},{"start":11.731,"end":13.074,"text":"K'a le se omo ehin Re","marked":"K'á lè ṣe ọmọ ẹ̀hìn Rẹ̀"},{"start":13.524,"end":14.988,"text":"Soro ipa s'okan gbogbo","marked":"Sọ̀rọ̀ ipa s'ọkàn gbogbo"},{"start":15.438,"end":17.791,"text":"So f 'alailera, tele mi.","marked":"Sọ f aláìlera, tẹ̀lé mi."}],"end":17.791},{"key":"3","start":18.741,"lines":[{"start":18.741,"end":20.281,"text":"PASE 'bukun l'akoko yi","marked":"Pàṣẹ bùkún l'àkókò yí"},{"start":20.731,"end":22.15,"text":"Emi oto, kun ibi yi","marked":"Èmi ọ̀tọ̀, kún ibi yí"},{"start":22.6,"end":24.278,"text":"F'agbara iwosan Re kun","marked":"F'agbára ìwòsàn Rẹ kún"},{"start":24.728,"end":26.223,"text":"At'ore-ofe isoji.","marked":"At'ore-ofe ìṣòjì."}],"end":26.223}]}