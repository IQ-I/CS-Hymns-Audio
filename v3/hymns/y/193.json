{"v":3,"coll":"y","num":193,"id":"hymn_193","title":"ONIDAJO naa de, o de","duration":38.045,"voices":{"male":{"file":"y-193-male-v3.m4a","bytes":272360,"sha256":"e46025d61a5ea7c3d3893e0d57155d55f713acdb4e59d8e65391e734184dd35f","duration":38.1},"female":{"file":"y-193-female-v3.m4a","bytes":274638,"sha256":"a714ccfb16bcb1d5fe9f14221bdb771329cac9ae875526d584ea8a02250d57fc","duration":38.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.196,"text":"ONIDAJỌ naa de, o de!","marked":"Onídájọ́ náà dé, ó dé!"},{"start":2.646,"end":4.391,"text":"Bẹni 'pe keje ti ń dun ń wi,","marked":"Bẹni pé keje tí ń dùn ń wí"},{"start":4.841,"end":7.028,"text":"Manamana ń kọ, ara ń san,","marked":"Mànàmàná ń kọ́, ara ń sàn"},{"start":7.478,"end":8.966,"text":"Onigbagbọ y'o ti yọ to!","marked":"Onígbàgbọ́ y'ó ti yọ tó!"}],"end":8.966},{"key":"2","start":9.916,"lines":[{"start":9.916,"end":12.143,"text":"A ń gbọ, Angẹl ọrun ń wi pé,","marked":"À ń gbọ́, Angẹl ọ̀run ń wí pé"},{"start":12.593,"end":14.03,"text":"Jesu Oluwa wa d'ade,","marked":"Jésù Olúwa wà d'adé"},{"start":14.48,"end":16.226,"text":"Or'ọfẹ l'Oun fi damure,","marked":"Or'ọ̀fẹ́ l'Òun fi dàmúrè"},{"start":16.676,"end":18.483,"text":"Ogo l'Oun fi s'ọsọ boju.","marked":"Ògo l'Òun fi s'ọ̀sọ́ bojú."}],"end":18.483},{"key":"3","start":19.433,"lines":[{"start":19.433,"end":21.112,"text":"'Wọ sọkalẹ l'or'itẹ Rẹ,","marked":"'Wọ sọ̀kalẹ̀ l'or'ìtẹ́ Rẹ"},{"start":21.562,"end":22.943,"text":"O gba ijọba fun'ra Rẹ,","marked":"Ó gba ìjọba fún'ra Rẹ̀"},{"start":23.393,"end":24.928,"text":"Ijọba gbogbo gba Tirẹ,","marked":"Ìjọba gbogbo gba Tìrẹ"},{"start":25.378,"end":27.031,"text":"Wọn gba b'Oluwa t'o sẹgun.","marked":"Wọ́n gba b'Olúwa t'ó sẹ́gun."}],"end":27.031},{"key":"4","start":27.981,"lines":[{"start":27.981,"end":30.058,"text":"Gbogbo ara ọrun, ẹ ho","marked":"Gbogbo ara ọ̀run, ẹ hó"},{"start":30.508,"end":32.315,"text":"At' eniyan; Oluwa wa,","marked":"Àt ènìyàn; Olúwa wà"},{"start":32.765,"end":34.326,"text":"Oga ogo t'o gba ọla,","marked":"Ọ̀gá ògo t'ó gba ọlá"},{"start":34.776,"end":36.496,"text":"Yoo jọba lai lati lai.","marked":"Yóò jọba láì láti láì."}],"end":36.496}]}