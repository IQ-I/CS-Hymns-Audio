{"v":3,"coll":"y","num":388,"id":"hymn_388","title":"OLORUN Metalokan","duration":31.192,"voices":{"male":{"file":"y-388-male-v3.m4a","bytes":212659,"sha256":"3766ea48ef7add3ae988aa7e4006c687813b2c81cb4b8f90dda79fc01b2f7853","duration":31.2},"female":{"file":"y-388-female-v3.m4a","bytes":220512,"sha256":"ab6fe8eef9845fbb1a0badd03cf437fa2aaa3c2b89cf76339c98ffdffc2c145e","duration":31.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.405,"text":"Ọlọrun Mẹtalọkan,","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":1.855,"end":3.361,"text":"Ọba ilẹ at'okun;","marked":"Ọba ilẹ̀ àt'òkun"},{"start":3.811,"end":5.441,"text":"Gbọ tiwa bi a ti n kọ,","marked":"Gbọ́ tiwa bí a ti ń kọ́"},{"start":5.891,"end":6.665,"text":"Orin iyin Rẹ.","marked":"Orin ìyìn Rẹ̀."}],"end":6.665},{"key":"2","start":7.615,"lines":[{"start":7.615,"end":9.344,"text":"'Wọ imọlẹ, l'owurọ,","marked":"'Wọ ìmọ́lẹ̀, l'òwúrọ̀"},{"start":9.794,"end":10.993,"text":"Tan 'mọlẹ Rẹ yi wa ka,","marked":"Tan 'mọlẹ Rẹ̀ yí wa ká"},{"start":11.443,"end":12.693,"text":"Jẹ ki ẹbun rere Rẹ,","marked":"Jẹ́ kí ẹ̀bùn rere Rẹ"},{"start":13.143,"end":14.217,"text":"M'aya wa balẹ","marked":"M'àyà wà balẹ̀"}],"end":14.217},{"key":"3","start":15.167,"lines":[{"start":15.167,"end":17.014,"text":"Wo 'mole, nigb'orun wo,","marked":"Wò mọ́lẹ̀, nígb'ọ̀run wo"},{"start":17.464,"end":18.837,"text":"K'a ri idariji gba;","marked":"K'á rí ìdáríjì gbà"},{"start":19.287,"end":20.679,"text":"Ki alafia orun","marked":"Kí àlàáfíà ọ̀run"},{"start":21.129,"end":22.364,"text":"F'itura fun wa.","marked":"F'ìtura fún wa."}],"end":22.364},{"key":"4","start":23.314,"lines":[{"start":23.314,"end":24.42,"text":"Ọlọrun Mẹtalọkan!","marked":"Ọlọ́run Mẹ́talọ́kan!"},{"start":24.87,"end":26.177,"text":"Isin wa layé ko to!","marked":"Ìsìn wa layé kò tó!"},{"start":26.627,"end":28.093,"text":"A ń reti lati dapọ,","marked":"À ń retí láti dàpọ̀"},{"start":28.543,"end":29.643,"text":"Mọ awọn t'ọrun.","marked":"Mọ àwọn t'ọ̀run."}],"end":29.643}]}