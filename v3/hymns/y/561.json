{"v":3,"coll":"y","num":561,"id":"hymn_561","title":"MA toju wa Baba Orun","duration":39.015,"voices":{"male":{"file":"y-561-male-v3.m4a","bytes":270295,"sha256":"622dea18f990471e9a8c88d940c13d6d485d6698cbd0b318cab38b9dc52c1635","duration":39.1},"female":{"file":"y-561-female-v3.m4a","bytes":287061,"sha256":"04f982762e407da9a4c310508dd0ec29d4ca141e673c589266f1cfe80f27817c","duration":39.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.529,"text":"MA tọju wa Baba Ọrun,","marked":"Má tọ́jú wá Baba Ọ̀run"},{"start":1.979,"end":3.177,"text":"Larin 'damu ayé yi,","marked":"Lárin dàmú ayé yí"},{"start":3.627,"end":5.554,"text":"Pa wa mọ k'o si ma bọ wa,","marked":"Pa wá mọ́ k'ó sì má bọ̀ wá"},{"start":6.004,"end":7.104,"text":"A ko n' iranwọ miran;","marked":"A kò ń ìrànwọ́ míràn"},{"start":7.554,"end":8.908,"text":"Sugbọn gbogbo 'bukun l'a ni,","marked":"Sùgbọ́n gbogbo bùkún l'á ni"},{"start":9.358,"end":10.808,"text":"B'Ọlọrun jẹ Baba wa.","marked":"B'Ọlọ́run jẹ́ Baba wa."}],"end":10.808},{"key":"2","start":11.758,"lines":[{"start":11.758,"end":13.514,"text":"Olugbala, dariji wa,","marked":"Olùgbàlà, dáríjì wá"},{"start":13.964,"end":15.25,"text":"Iwọ sa m'ailera wa;","marked":"Ìwọ sá m'àìlera wa"},{"start":15.7,"end":17.193,"text":"'Wọ ti rin ayé saaju wa,","marked":"'Wọ ti rìn ayé ṣáájú wá"},{"start":17.643,"end":18.98,"text":"'Wọ ti mọ 'se inu rẹ;","marked":"'Wọ tí mọ ṣe inú rẹ"},{"start":19.43,"end":20.945,"text":"B' ẹn' ikanu at' alarẹ,","marked":"B ẹn' ìkanu àt alárẹ"},{"start":21.395,"end":22.962,"text":"L'O ti la 'ginju yi ja.","marked":"L'Ó ti la ginjù yí jà."},{"start":23.412,"end":24.926,"text":"L'O ti la 'ginju yi ja.","marked":"L'Ó ti la ginjù yí jà."}],"end":24.926},{"key":"3","start":25.876,"lines":[{"start":25.876,"end":27.489,"text":"Ẹmi Ọlọrun, sọkalẹ,","marked":"Ẹ̀mí Ọlọ́run, sọ̀kalẹ̀"},{"start":27.939,"end":29.428,"text":"F'ayọ ọrun k'ọkan wa,","marked":"F'ayọ̀ ọ̀run k'ọkàn wá"},{"start":29.878,"end":31.448,"text":"K'ifẹ dapọ mọ iya wa,","marked":"K'ìfẹ́ dàpọ̀ mọ́ ìyá wa"},{"start":31.898,"end":33.74,"text":"At'adun ti ki su ni,","marked":"At'adùn tí kì ṣú ni"},{"start":34.19,"end":35.908,"text":"B'a ba pese fun wa bayi,","marked":"B'á bá pèsè fún wa báyì"},{"start":36.358,"end":37.465,"text":"Ki l'o le mu sinmi wa?","marked":"Kí l'ó lè mú sinmi wá?"}],"end":37.465}]}