{"v":3,"coll":"y","num":14,"id":"hymn_14","title":"IFE Re da wa wa si loni","duration":35.396,"voices":{"male":{"file":"y-14-male-v3.m4a","bytes":250593,"sha256":"983f9606e3018309d1d2b2a96fc73167037bcdcbcaf5aff4e7a788a45af92c80","duration":35.4},"female":{"file":"y-14-female-v3.m4a","bytes":253889,"sha256":"52e0e7419a42c4aae02840450156ade99ab1b54ecb66af68918a1b261cc3bcc9","duration":35.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.656,"text":"IFE Re da wa si loni,","marked":"Ìfẹ́ Rẹ̀ dá wa sí lónì"},{"start":2.106,"end":3.503,"text":"L'are a si dubule;","marked":"L'àrẹ a sì dùbúlẹ̀"},{"start":3.953,"end":5.418,"text":"Ma so wa ni dake oru","marked":"Má sọ wá ní dákẹ́ òru"},{"start":5.868,"end":7.151,"text":"K'ota ma yo wa lenu;","marked":"K'ọ̀tá má yọ wá lẹ́nu"},{"start":7.601,"end":9.532,"text":"Jesu, se Olutoju wa,","marked":"Jésù, ṣe Olùtọ́jú wa"},{"start":9.982,"end":11.476,"text":"lwo l'o dun gbekele.","marked":"Ìwọ l'ó dùn gbẹ́kẹ̀lé."}],"end":11.476},{"key":"CHORUS","start":12.426,"lines":[{"start":12.426,"end":14.3,"text":"Halleluyah, Halleluyah","marked":"Hallelúyà, Hallelúyà"},{"start":14.75,"end":16.353,"text":"Ni won nko t'osan t'oru","marked":"Ní wọ́n ńkọ́ t'ọ̀sán t'òru"},{"start":16.803,"end":18.025,"text":"Nibi t'Olugbala ngbe","marked":"Níbi t'Olùgbàlà ńgbé"},{"start":18.475,"end":19.957,"text":"Ni won nko t'osan t'orun","marked":"Ní wọ́n ńkọ́ t'ọ̀sán t'ọ̀run"}],"end":19.957},{"key":"2","start":20.907,"lines":[{"start":20.907,"end":22.557,"text":"Ero at'alejo l'aiye","marked":"Èrò àt'àlejò l'ayé"},{"start":23.007,"end":24.262,"text":"A ngb'arin awon ota!","marked":"A ńgb'arin àwọn ọ̀tá!"},{"start":24.712,"end":26.703,"text":"Yo wa, at'ile wa l'ewu","marked":"Yọ wá, àt'ilé wa l'ewu"},{"start":27.153,"end":28.666,"text":"L'apa Re ni ka sun si;","marked":"L'apá Rẹ̀ ni ká sùn sí"},{"start":29.116,"end":30.692,"text":"N'ijo iyonu aiye pin,","marked":"N'ìjọ ìyọnu ayé pín"},{"start":31.142,"end":32.765,"text":"Ka le simi l'odo Re.","marked":"Ká lè ṣímì l'ọ̀dọ̀ Rẹ."},{"start":33.215,"end":33.847,"text":"Amin.","marked":"Àmín."}],"end":33.847}]}