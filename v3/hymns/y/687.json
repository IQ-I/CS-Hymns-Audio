{"v":3,"coll":"y","num":687,"id":"hymn_687","title":"WO alapon kokoro ni","duration":32.34,"voices":{"male":{"file":"y-687-male-v3.m4a","bytes":222231,"sha256":"09a4e101dfc7c3ec8a2794f64a9771ad625377edb8f73ce342a446530684154a","duration":32.4},"female":{"file":"y-687-female-v3.m4a","bytes":229824,"sha256":"0aa151fea8e88a578ac12fbded32d7728ac56eda9000af3044b4f3ed34157b1a","duration":32.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.667,"text":"WO alapọn kokoro ni,","marked":"Wo alápọ́n kòkòrò ni"},{"start":2.117,"end":3.128,"text":"N'nu gbogbo itanna,","marked":"N'nú gbogbo ìtànná"},{"start":3.578,"end":5.228,"text":"Bi o ti n fa oyin jade,","marked":"Bí ó ti ń fa oyin jáde"},{"start":5.678,"end":6.759,"text":"Lara ewe gbogbo!","marked":"Lára èwe gbogbo!"}],"end":6.759},{"key":"2","start":7.709,"lines":[{"start":7.709,"end":9.465,"text":"W'Ounjẹ didun ti o n kojọ,","marked":"W'Oúnjẹ dídùn tí ó ń kójọ"},{"start":9.915,"end":10.967,"text":"Si inu ile rẹ!","marked":"Sí inú ilé rẹ!"},{"start":11.417,"end":13.523,"text":"Wo, b'o ti se f'ara rẹ da,","marked":"Wò, b'ó ti ṣe f'ara rẹ̀ dá"},{"start":13.973,"end":15.258,"text":"Wo ida didan rẹ!","marked":"Wo idà dídán rẹ!"}],"end":15.258},{"key":"3","start":16.208,"lines":[{"start":16.208,"end":17.739,"text":"Bẹ l'o yẹ ki n ma se aapọn,","marked":"Bẹ́ l'ó yẹ kí n má ṣe àápọ́n"},{"start":18.189,"end":19.215,"text":"N'nu gbogbo isẹ mi:-","marked":"N'nú gbogbo isẹ́ mi"},{"start":19.665,"end":21.482,"text":"Esu ki s'alairi 'se kan,","marked":"Èṣù kí s'aláìrí ṣe kan"},{"start":21.932,"end":23.446,"text":"T'o buru f'ọlẹ se.","marked":"T'ó burú f'ọ́lẹ̀ ṣe."}],"end":23.446},{"key":"4","start":24.396,"lines":[{"start":24.396,"end":25.924,"text":"N ó ma kọ iwe l'akoko,","marked":"N ó má kọ ìwé l'àkọ́kọ́"},{"start":26.374,"end":27.435,"text":"Lat' igba ewe mi,","marked":"Lát ìgbà èwe mi"},{"start":27.885,"end":29.239,"text":"N ó si mura si isẹ mi,","marked":"N ó sì múra sí isẹ́ mi"},{"start":29.689,"end":30.79,"text":"K'oju ma ba ti mi!","marked":"K'ojú má bá tì mí!"}],"end":30.79}]}