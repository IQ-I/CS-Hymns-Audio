{"v":3,"coll":"y","num":456,"id":"hymn_456","title":"LAIFOYA l'apa Jesu","duration":65.983,"voices":{"male":{"file":"y-456-male-v3.m4a","bytes":485234,"sha256":"1e2568130b5751e99791ce59b521f69de29c5a3ef53b4d94cbd16971adc155e4","duration":66.0},"female":{"file":"y-456-female-v3.m4a","bytes":502032,"sha256":"2e9215641814ab18042dc7e299e4b9705563fa04d617298211aa46ac72121e81","duration":66.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.904,"text":"LAIFOYA l'apa Jesu,","marked":"Láìfòyà l'apá Jésù"},{"start":2.354,"end":3.572,"text":"Laifoya laya Rẹ,","marked":"Láìfòyà láyà Rẹ"},{"start":4.022,"end":5.389,"text":"cr Labẹ ojij' ifẹ Rẹ,","marked":"cr Lábẹ́ òjìj ìfẹ́ Rẹ"},{"start":5.839,"end":7.01,"text":"L'ọkan mi o sinmi.","marked":"L'ọkàn mi ò sinmi."},{"start":7.46,"end":9.21,"text":"Gbọ! ohun Angẹli ni,","marked":"Gbọ́! ohun Áńgẹ́lì ni"},{"start":9.66,"end":10.774,"text":"Orin wọn d'eti mi,","marked":"Orin wọn d'etí mi"},{"start":11.224,"end":12.594,"text":"Lati papa ogo wa,","marked":"Láti pápá ògo wá"},{"start":13.044,"end":14.5,"text":"Lati okun Jaspi,","marked":"Láti okùn Jaspi"},{"start":14.95,"end":18.064,"text":"Laifoya l'apa Jesu, Laifoya","marked":"Láìfòyà l'apá Jésù, Láìfòyà"},{"start":18.514,"end":19.261,"text":"laya Rẹ,","marked":"láyà Rẹ"},{"start":19.711,"end":22.762,"text":"L'abẹ ojij' ifẹ Rẹ, l'ọkan mi o sinmi.","marked":"L'abẹ́ òjìj ìfẹ́ Rẹ, l'ọkàn mi ò sinmi."}],"end":22.762},{"key":"2","start":23.712,"lines":[{"start":23.712,"end":25.18,"text":"Laifoya lapa Jesu,","marked":"Láìfòyà lápá Jésù"},{"start":25.63,"end":26.696,"text":"Mo bọ lọw' aniyan,","marked":"Mo bọ̀ lọw' àníyàn"},{"start":27.146,"end":28.311,"text":"Mo bọ lọwọ idanwo,","marked":"Mo bọ́ lọ́wọ́ ìdánwò"},{"start":28.761,"end":29.941,"text":"Ẹsẹ ko n'ipa mo,","marked":"Ẹsẹ̀ kò n'ipa mọ́"},{"start":30.391,"end":31.418,"text":"Mo bọ lọwọ ẹru,","marked":"Mo bọ̀ lọ́wọ́ ẹ̀rù"},{"start":31.868,"end":33.015,"text":"O ku idanwo diẹ!","marked":"Ó kú ìdánwò díẹ̀!"},{"start":33.465,"end":34.555,"text":"O k'omije diẹ!","marked":"Ó k'omijé díẹ̀!"},{"start":35.005,"end":38.452,"text":"Laifoya lapa Jesu, Laifoya Laya Rẹ,","marked":"Láìfòyà lápá Jésù, Láìfòyà Láyà Rẹ̀"},{"start":38.902,"end":41.988,"text":"L'abẹ ojij' ifẹ Rẹ, l'ọkan mi o sinmi.","marked":"L'abẹ́ òjìj ìfẹ́ Rẹ, l'ọkàn mi ò sinmi."}],"end":41.988},{"key":"3","start":42.938,"lines":[{"start":42.938,"end":44.75,"text":"Jesu, abo ọkan mi,","marked":"Jésù, abo ọkàn mi"},{"start":45.2,"end":46.643,"text":"Jesu ti ku fun mi;","marked":"Jésù ti kú fún mi"},{"start":47.093,"end":48.563,"text":"Apata ayérayé,","marked":"Àpáta ayérayé"},{"start":49.013,"end":50.051,"text":"L'emi o gbẹkẹle,","marked":"L'èmi ó gbẹ́kẹ̀lé"},{"start":50.501,"end":52.276,"text":"mp Nihin l'emi o duro,","marked":"mp Níhìn l'èmi ó dúró"},{"start":52.726,"end":54.321,"text":"Tit' oru y'o kọja;","marked":"Tít òru y'ó kọjá"},{"start":54.771,"end":55.985,"text":"Titi n ó fi r'imọlẹ,","marked":"Títí n ó fi r'ìmọ́lẹ̀"},{"start":56.435,"end":57.558,"text":"Ni ebute ogo,","marked":"Ní èbúté ògo"},{"start":58.008,"end":61.077,"text":"Laifoya lapa Jesu, Laifoya laya Rẹ,","marked":"Láìfòyà lápá Jésù, Láìfòyà láyà Rẹ̀"},{"start":61.527,"end":64.434,"text":"L'abẹ ojij' ifẹ Rẹ, l'ọkan mi o sinmi.","marked":"L'abẹ́ òjìj ìfẹ́ Rẹ, l'ọkàn mi ò sinmi."}],"end":64.434}]}