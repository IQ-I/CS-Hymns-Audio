{"v":3,"coll":"y","num":754,"id":"hymn_754","title":"ALABUKUN l'awon oku","duration":55.174,"voices":{"male":{"file":"y-754-male-v3.m4a","bytes":383608,"sha256":"f2adde7b399d716137f0cf844840b20047f62c3d87525e16fbdf40e379661f6d","duration":55.2},"female":{"file":"y-754-female-v3.m4a","bytes":398976,"sha256":"9e731403a5c7c785dbbe3a26a9508bd5e809ed55e7b76ba6a98750825a465d40","duration":55.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.737,"text":"ALABUKUN l'awọn oku","marked":"Alábùkún l'àwọn òkú"},{"start":2.187,"end":3.271,"text":"Nipa ti Oluwa,","marked":"Nípa ti Olúwa"},{"start":3.721,"end":5.554,"text":"Kowe rẹ bẹni Ẹmi wi,","marked":"Kọ̀wé rẹ̀ bẹni Ẹ̀mí wí"},{"start":6.004,"end":7.225,"text":"'Sẹ wọn n tọ wọn lẹhin.","marked":"'Sẹ wọn ń tọ̀ wọ́n lẹ́hìn."}],"end":7.225},{"key":"2","start":8.175,"lines":[{"start":8.175,"end":9.478,"text":"Wọn sinmi ninu lala wọn,","marked":"Wọ́n sinmi nínú làlà wọn"},{"start":9.928,"end":11.141,"text":"Kuro l'aginju yi,","marked":"Kúrò l'aginjù yí"},{"start":11.591,"end":13.123,"text":"Wọn n yọ larin Ẹgbẹ Mimọ,","marked":"Wọ́n ń yọ̀ lárin Ẹgbẹ́ Mímọ́"},{"start":13.573,"end":14.572,"text":"Loke ọrun lọhun.","marked":"Lókè ọ̀run lọ́hùn."}],"end":14.572},{"key":"3","start":15.522,"lines":[{"start":15.522,"end":16.876,"text":"Ayọ wọn ko se f'ẹnu sọ,","marked":"Ayọ̀ wọn kò ṣe f'ẹnu sọ"},{"start":17.326,"end":18.586,"text":"Larin Ẹgbẹ Ogo,","marked":"Lárin Ẹgbẹ́ Ògo"},{"start":19.036,"end":21.031,"text":"Jesu ti wọn ti gbẹkẹle,","marked":"Jésù tí wọ́n ti gbẹ́kẹ̀lé"},{"start":21.481,"end":22.891,"text":"Si ti rẹ wọn lẹkun.","marked":"Sì ti rẹ̀ wọ́n lẹ́kun."}],"end":22.891},{"key":"4","start":23.841,"lines":[{"start":23.841,"end":25.026,"text":"Ainiye l'awọn Kérúbù,","marked":"Àìníye l'àwọn Kérúbù"},{"start":25.476,"end":26.737,"text":"To y'itẹ Baba ka;","marked":"Tó y'ìtẹ́ Baba ká"},{"start":27.187,"end":29.223,"text":"Seraf' t'ẹnikan ko le ka,","marked":"Seraf t'ẹnìkan kò lè kà"},{"start":29.673,"end":30.855,"text":"Wọn n kọ Halleluyah!","marked":"Wọ́n ń kọ́ Hallelúyà!"}],"end":30.855},{"key":"5","start":31.805,"lines":[{"start":31.805,"end":32.97,"text":"Agbagba Mẹrinlelogun,","marked":"Àgbàgbà Mẹ́rìnlélógún"},{"start":33.42,"end":34.571,"text":"Ẹda 'alaye Mẹrin,","marked":"Ẹ̀dà àlàyé Mẹ́rin"},{"start":35.021,"end":36.318,"text":"Wọn y'itẹ Olugbala ka,","marked":"Wọ́n y'ìtẹ́ Olùgbàlà ká"},{"start":36.768,"end":38.119,"text":"Wọn n kọ Mimọ, Mimọ.","marked":"Wọ́n ń kọ Mímọ́, Mímọ́."}],"end":38.119},{"key":"6","start":39.069,"lines":[{"start":39.069,"end":40.297,"text":"Ẹwa ogo 'bẹ ti pọ to?","marked":"Ẹwà ògo 'bẹ ti pọ̀ tó?"},{"start":40.747,"end":41.87,"text":"A ko le fẹnu sọ;","marked":"A kò lè fẹnu sọ"},{"start":42.32,"end":43.937,"text":"Didan l'awọn ta se logo,","marked":"Dídán l'àwọn ta ṣe lógo"},{"start":44.387,"end":45.847,"text":"Wọn n kọ orin Mose.","marked":"Wọ́n ń kọ orin Mósè."}],"end":45.847},{"key":"7","start":46.797,"lines":[{"start":46.797,"end":48.329,"text":"A f'ogo fun Baba l'oke","marked":"A f'ògo fún Baba l'òkè"},{"start":48.779,"end":49.79,"text":"A f'ogo fun Omo","marked":"A f'ògo fún Ọmọ"},{"start":50.24,"end":51.723,"text":"A f'ogo fun Emi Mimo","marked":"A f'ògo fún Ẹ̀mí Mímọ́"},{"start":52.173,"end":53.625,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":53.625}]}