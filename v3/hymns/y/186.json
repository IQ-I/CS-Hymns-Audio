{"v":3,"coll":"y","num":186,"id":"hymn_186","title":"OLUWA mbo; aye o mi","duration":45.293,"voices":{"male":{"file":"y-186-male-v3.m4a","bytes":319750,"sha256":"cc08138d395279a2a94fd1911162872c69bc22b9cf46224a73438e526b326f8f","duration":45.3},"female":{"file":"y-186-female-v3.m4a","bytes":332320,"sha256":"28ae9c5ac2ddb8993e465eab06c9ce0f4278ec499bd2f3115a465b7a57ca50e8","duration":45.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.0,"text":"OLUWA mbọ; ayé o mi,","marked":"Olúwa mbọ̀; ayé ò mì"},{"start":2.45,"end":4.016,"text":"Oke y'o sidi n'ipo wọn,","marked":"Òkè y'ó sídi n'ipò wọn"},{"start":4.466,"end":5.894,"text":"At' irawọ oju ọrun,","marked":"Àt ìràwọ̀ ojú ọ̀run"},{"start":6.344,"end":7.841,"text":"Y'o mu imọlẹ wọn kuro.","marked":"Y'ó mú ìmọ́lẹ̀ wọn kúrò."}],"end":7.841},{"key":"2","start":8.791,"lines":[{"start":8.791,"end":11.036,"text":"Oluwa mbọ; bakan naa kọ,","marked":"Olúwa mbọ̀; bákan náà kọ"},{"start":11.486,"end":12.886,"text":"Bi o ti wa n'irẹlẹ ri;","marked":"Bí ó ti wá n'ìrẹ̀lẹ̀ rí"},{"start":13.336,"end":15.139,"text":"Ọdọ-aguntan ti a pa,","marked":"Ọdọ-aguntan tí a pa"},{"start":15.589,"end":17.292,"text":"Ẹni-iya ti o si ku.","marked":"Ẹni-iya tí ó sì kú."}],"end":17.292},{"key":"3","start":18.242,"lines":[{"start":18.242,"end":19.941,"text":"Oluwa mbọ; ni ẹru nla,","marked":"Olúwa mbọ̀; ní ẹ̀rù ńlá"},{"start":20.391,"end":21.74,"text":"L'ọwọ ina pẹlu ija,","marked":"L'ọ́wọ́ iná pẹ̀lú ìjà"},{"start":22.19,"end":23.477,"text":"L'or' iyẹ apa Kérúbù,","marked":"L'ór ìyẹ́ apá Kérúbù"},{"start":23.927,"end":25.419,"text":"Mbọ, Onidajọ arayé.","marked":"Mbọ́, Onídájọ́ arayé."}],"end":25.419},{"key":"4","start":26.369,"lines":[{"start":26.369,"end":27.742,"text":"Eyi ha ni ẹni ti ń rin,","marked":"Èyí ha ni ẹni tí ń rìn"},{"start":28.192,"end":29.494,"text":"Bi ero l'opopo ayé?","marked":"Bí èrò l'òpópó ayé?"},{"start":29.944,"end":31.139,"text":"Ti a se 'nunibini i?","marked":"Tí a ṣe nunibíni i?"},{"start":31.589,"end":33.776,"text":"A! Ẹni ti a pa l'eyi?","marked":"A! Ẹni tí a pa l'èyí?"}],"end":33.776},{"key":"5","start":34.726,"lines":[{"start":34.726,"end":36.636,"text":"Ika: b'ẹ wọ 'nu apata,","marked":"Ìkà: b'ẹ́ wọ nù àpáta"},{"start":37.086,"end":38.941,"text":"B'ẹ wọ 'nu iho, lasan ni;","marked":"B'ẹ́ wọ nú ihò, lásán ni"},{"start":39.391,"end":41.251,"text":"Sugbọn igbagbọ t'o sẹgun","marked":"Sùgbọ́n ìgbàgbọ́ t'ó sẹ́gun"},{"start":41.701,"end":43.744,"text":"Y'o kọrin pe, Oluwa de.","marked":"Y'ó kọrin pé, Olúwa dé."}],"end":43.744}]}