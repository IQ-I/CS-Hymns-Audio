{"v":3,"coll":"y","num":745,"id":"hymn_745","title":"NINU egbe Mimo yi","duration":75.385,"voices":{"male":{"file":"y-745-male.m4a","bytes":559961,"sha256":"0bf18eae4879b153da738c5fe9a4a6e821d8a80f9cafd9bd568654be2a634336","duration":75.4},"female":{"file":"y-745-female.m4a","bytes":578541,"sha256":"0a95d3381fce6c8031bb8137c203ddc3393983b40d0cdc9d00738cd6a34a3e7d","duration":75.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.104,"text":"NINU egbe Mimo yi, ti","marked":"Nínú ẹgbẹ́ Mímọ́́ yí, tí"},{"start":2.484,"end":3.555,"text":"Moses gbe kale","marked":"Moses gbé kalẹ̀"},{"start":3.935,"end":5.981,"text":"L'Oluwa s'awon Tire ni ayanfe","marked":"L'Olúwa s'àwọn Tírè ní àyànfẹ́"},{"start":6.361,"end":9.697,"text":"Araiye le ma kegan, araiye le ma sata,","marked":"Aráìyé lè má kẹ́gàn, araiye lè má ṣátá"},{"start":10.077,"end":12.409,"text":"Sugbon Serafu mo eniti nwon nsin.","marked":"Ṣùgbọ́n Séráfù mọ ẹniti nwọn ńsin."}],"end":12.409},{"key":"CHORUS","start":13.359,"lines":[{"start":13.359,"end":14.795,"text":"Egbe na, egbe na,","marked":"Ẹgbẹ́ ná, ẹgbẹ́ ná"},{"start":15.175,"end":16.154,"text":"Ta fi ran Moses","marked":"Ta fi rán Moses"},{"start":16.534,"end":17.315,"text":"Orimolade,","marked":"Orímọládé"},{"start":17.695,"end":18.864,"text":"Ta fi ife se 'pile","marked":"Ta fi ìfẹ́ ṣe 'pilẹ̀"},{"start":19.244,"end":20.64,"text":"K' enikeni fese le,","marked":"K' ẹnikẹ́ni fẹsẹ̀ lé"},{"start":21.02,"end":23.616,"text":"K'ibukun aiyeraiye Ie je tiwa.","marked":"K'ìbùkún aiyérayé lè jẹ́ tiwa."}],"end":23.616},{"key":"2","start":24.566,"lines":[{"start":24.566,"end":26.676,"text":"O yan Baba 'ladura lati","marked":"Ó yan Bàbá 'ládúrà láti"},{"start":27.056,"end":28.189,"text":"j'Oluropo re,","marked":"j'Olùrọ́pọ̀ rẹ"},{"start":28.569,"end":31.042,"text":"Nigbati ipe de lati mu re 'le","marked":"Nígbàtí ìpè dé láti mú rẹ 'le"},{"start":31.422,"end":33.282,"text":"O yan awon Aposteli lati","marked":"Ó yan àwọn Aposteli láti"},{"start":33.662,"end":34.64,"text":"gberin egbe na,","marked":"gbẹ̀rín ẹgbẹ́ ná"},{"start":35.02,"end":36.401,"text":"Ki nwon mura lati tan 'hin","marked":"Kí nwọn múra láti tàn 'hìn"},{"start":36.781,"end":37.521,"text":"na kale.","marked":"ná kalẹ̀."}],"end":37.521},{"key":"3","start":38.471,"lines":[{"start":38.471,"end":40.302,"text":"Bi nwon ti je oloye ki","marked":"Bí nwọn ti jẹ́ olóye kí"},{"start":40.682,"end":41.882,"text":"nwon je onirele,","marked":"nwọn jẹ́ onírẹ̀lẹ̀"},{"start":42.262,"end":44.185,"text":"Lati tele 'pase Jesu Oluwa","marked":"Láti tẹ̀lé 'pase Jésù Olúwa"},{"start":44.565,"end":46.228,"text":"Ka le se won l'asepe bi","marked":"Ká lè ṣe wọ́n l'àṣepé bí"},{"start":46.608,"end":47.826,"text":"Aposteli 'gbani,","marked":"Apostelì 'gbani"},{"start":48.206,"end":50.067,"text":"Ti adura won je amu‐bi-ina.","marked":"Ti àdúrà wọn jẹ́ àmú-bí-iná."}],"end":50.067},{"key":"4","start":51.017,"lines":[{"start":51.017,"end":52.034,"text":"Gbogbo obinrin oloye,","marked":"Gbogbo obìnrin olóye"},{"start":52.414,"end":55.005,"text":"Mary, Martha, Esther,","marked":"Mary, Martha, Esther"},{"start":55.385,"end":57.412,"text":"Ni eto enyin oloye meteta,","marked":"Ní ètò ẹ̀nyìn olóye mẹ́tẹ̀ta"},{"start":57.792,"end":59.942,"text":"E mura giri s'ise bi awon ti igbani,","marked":"Ẹ múra gírí s'iṣẹ́ bí àwọn ti ìgbani"},{"start":60.322,"end":62.57,"text":"Nwon ko ya awon Apostili lese kan.","marked":"Nwọn kò ya àwọn Apostili lẹ́sẹ̀ kan."}],"end":62.57},{"key":"5","start":63.52,"lines":[{"start":63.52,"end":65.666,"text":"Ki Ore-Ofe Jesu Kristi wa lori papo","marked":"Kí Ọ̀rẹ́-Ọ̀fẹ́ Jésù Kristi wà lórí papọ̀"},{"start":66.046,"end":68.371,"text":"Ko si ba wa gbe lai ati lailai,","marked":"Kò sì bá wa gbé láì àti láíláí"},{"start":68.751,"end":72.207,"text":"Mary, Martha, Esta, 'ti","marked":"Mary, Martha, Esta, 'ti"},{"start":72.587,"end":73.836,"text":"Baba nla mejila.","marked":"Bàbá ńlá méjìlá."}],"end":73.836}]}