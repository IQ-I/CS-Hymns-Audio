{"v":3,"coll":"y","num":29,"id":"hymn_29","title":"OLORUN wa orun","duration":45.349,"voices":{"male":{"file":"y-29-male-v3.m4a","bytes":303168,"sha256":"e78964feed6b9353bfc9e97b888d67f761940657c9827b18fb859c12940e546e","duration":45.4},"female":{"file":"y-29-female-v3.m4a","bytes":317386,"sha256":"383211f600759a27e7c1fe8a65a711462900e499726c6edd201e446c6d3978fa","duration":45.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.2,"text":"ỌLỌRUN wa ọrun,","marked":"Ọlọ́run wá ọ̀run"},{"start":1.65,"end":2.716,"text":"T'o fi ọjọ mẹfa","marked":"T'ó fi ọjọ́ mẹ́fà"},{"start":3.166,"end":4.938,"text":"Da nkan gbogbo ti mbẹ layé,","marked":"Dá nǹkan gbogbo ti mbẹ̀ layé"},{"start":5.388,"end":6.63,"text":"Sinmi nijọ keje.","marked":"Sinmi níjọ́ keje."}],"end":6.63},{"key":"2","start":7.58,"lines":[{"start":7.58,"end":8.913,"text":"O pasẹ k'a bọwọ","marked":"Ó pàsẹ k'á bọ̀wọ̀"},{"start":9.363,"end":10.503,"text":"Fun ọjọ sinmi;","marked":"Fún ọjọ́ sinmi"},{"start":10.953,"end":12.208,"text":"Ibinu Rẹ tobi pupọ","marked":"Ìbínú Rẹ̀ tóbi púpọ̀"},{"start":12.658,"end":14.076,"text":"S'awọn t'o rufin yi.","marked":"S'àwọn t'ó rùfin yí."}],"end":14.076},{"key":"3","start":15.026,"lines":[{"start":15.026,"end":16.061,"text":"Awọn baba nla wa","marked":"Àwọn Baba ńlá wa"},{"start":16.511,"end":17.834,"text":"p Ti ku nin'okunkun;","marked":"p Ti kú nín'òkùnkùn"},{"start":18.284,"end":19.802,"text":"Wọn jẹ ogbo aborisa","marked":"Wọ́n jẹ́ ọ̀gbọ̀ abọ̀rìṣà"},{"start":20.252,"end":21.445,"text":"Wọn ko mọ ofin Rẹ.","marked":"Wọn kò mọ òfin Rẹ̀."}],"end":21.445},{"key":"4","start":22.395,"lines":[{"start":22.395,"end":23.595,"text":"Awa de, Oluwa,","marked":"Àwa dé, Olúwa"},{"start":24.045,"end":25.132,"text":"Gẹgẹ bi asẹ Rẹ,","marked":"Gẹ́gẹ́ bí àsẹ Rẹ"},{"start":25.582,"end":27.017,"text":"Lẹyin isẹ ọjọ mẹfa,","marked":"Lẹ́yìn isẹ́ ọjọ́ mẹ́fà"},{"start":27.467,"end":28.805,"text":"Lati se ifẹ Rẹ.","marked":"Láti ṣe ìfẹ́ Rẹ."}],"end":28.805},{"key":"5","start":29.755,"lines":[{"start":29.755,"end":30.782,"text":"Mimọ l'ọjọ oni;","marked":"Mímọ́ l'ọjọ́ òní"},{"start":31.232,"end":32.529,"text":"O yẹ ki a sinmi;","marked":"Ó yẹ kí a sinmi"},{"start":32.979,"end":34.695,"text":"K'a pẹjọ ninu ile Rẹ;","marked":"K'á pẹ́jọ nínú ilé Rẹ"},{"start":35.145,"end":36.256,"text":"K'a gbọ'rọ mimọ Rẹ.","marked":"K'á gbọ́'rọ̀ mímọ́ Rẹ."}],"end":36.256},{"key":"6","start":37.206,"lines":[{"start":37.206,"end":38.666,"text":"Isinmi nla kan ku","marked":"Ìsinmi ńlá kan kú"},{"start":39.116,"end":40.029,"text":"F'awọn eniyan Rẹ;","marked":"F'àwọn ènìyàn Rẹ"},{"start":40.479,"end":42.185,"text":"Ọm'Ọlọrun, Alabukun","marked":"Ọm'Ọlọ́run, Alábùkún"},{"start":42.635,"end":43.8,"text":"Mu wa de 'sinmi Rẹ!","marked":"Mú wa dé sinmi Rẹ!"}],"end":43.8}]}