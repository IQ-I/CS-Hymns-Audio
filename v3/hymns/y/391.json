{"v":3,"coll":"y","num":391,"id":"hymn_391","title":"BABA, Eleda wa,","duration":48.864,"voices":{"male":{"file":"y-391-male-v3.m4a","bytes":348262,"sha256":"5ded063f13c1a52c7eda1a3580e8de3d57ffde0d4511bab37951ebbed599b94e","duration":48.9},"female":{"file":"y-391-female-v3.m4a","bytes":356322,"sha256":"951dc1bcb0da7dbe1f8d30fd692d694094062a4009933078c200b5e6aa21b4f0","duration":48.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.178,"text":"BABA, Ẹlẹda wa,","marked":"Baba, Ẹlẹda wa"},{"start":2.628,"end":3.558,"text":"Gbọ orin iyin wa,","marked":"Gbọ́ orin ìyìn wá"},{"start":4.008,"end":5.678,"text":"L'ayé ati l'ọrun","marked":"L'ayé àti l'ọ̀run"},{"start":6.128,"end":7.194,"text":"Baba Olubukun;","marked":"Baba Olùbùkún"},{"start":7.644,"end":9.429,"text":"Iwọ l'ogo ati iyin,","marked":"Ìwọ l'ògo àti ìyìn"},{"start":9.879,"end":11.748,"text":"Ọpẹ, ati ọla yẹ fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":11.748},{"key":"2","start":12.698,"lines":[{"start":12.698,"end":13.754,"text":"'Wọ Ọlọrun Ọmọ,","marked":"'Wọ Ọlọ́run Ọmọ"},{"start":14.204,"end":15.576,"text":"T'O ku lati gba wa;","marked":"T'Ó kú láti gbà wá"},{"start":16.026,"end":17.345,"text":"Ẹni t'O ji dide,","marked":"Ẹni t'Ó jí dìde"},{"start":17.795,"end":19.081,"text":"Ti O si goke lọ;","marked":"Tí Ó sì gòkè lọ"},{"start":19.531,"end":21.163,"text":"Iwọ l'ogo, ati iyin,","marked":"Ìwọ l'ògo, àti ìyìn"},{"start":21.613,"end":23.467,"text":"Ọpẹ, ati ọla yẹ fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":23.467},{"key":"3","start":24.417,"lines":[{"start":24.417,"end":25.418,"text":"Si Ọ Ẹmi Mimọ ,","marked":"Sí Ọ Ẹ̀mí Mímọ́"},{"start":25.868,"end":26.874,"text":"Ni a kọrin iyin;","marked":"Ní a kọrin ìyìn"},{"start":27.324,"end":28.449,"text":"Iwọ t'o f'imọlẹ,","marked":"Ìwọ t'ó f'ìmọ́lẹ̀"},{"start":28.899,"end":29.995,"text":"Iye si ọkan wa;","marked":"Iye sí ọkàn wa"},{"start":30.445,"end":32.289,"text":"Iwọ l'ogo, ati iyin,","marked":"Ìwọ l'ògo, àti ìyìn"},{"start":32.739,"end":34.633,"text":"Ọpẹ, ati ọla yẹ fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":34.633},{"key":"4","start":35.583,"lines":[{"start":35.583,"end":37.001,"text":"Mimọ, mimọ, mimọ,","marked":"Mímọ́, mímọ́, mímọ́"},{"start":37.451,"end":38.574,"text":"N'iyin Mẹtalọkan;","marked":"N'ìyìn Mẹ́talọ́kan"},{"start":39.024,"end":40.637,"text":"L'ayé ati l'ọrun,","marked":"L'ayé àti l'ọ̀run"},{"start":41.087,"end":42.477,"text":"L'a o ma kọrin pe;","marked":"L'a ò má kọrin pé"},{"start":42.927,"end":44.785,"text":"Iwọ l'ogo, ati iyin,","marked":"Ìwọ l'ògo, àti ìyìn"},{"start":45.235,"end":47.315,"text":"Ọpẹ, ati ọla yẹ fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":47.315}]}