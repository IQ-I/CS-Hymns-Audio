{"v":3,"coll":"y","num":591,"id":"hymn_591","title":"TAN 'mole Re si wa","duration":55.203,"voices":{"male":{"file":"y-591-male-v3.m4a","bytes":376859,"sha256":"7e220c7288e0ae942383da929749ce06d39b5fe89a8444ce9e57ddec4ab3a02f","duration":55.3},"female":{"file":"y-591-female-v3.m4a","bytes":394798,"sha256":"f5c807f61a6213b280cd2177c10f7e070a0dc5e68b4b09538e863c15a08ccbd2","duration":55.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.277,"text":"TAN 'mole Re si wa","marked":"Tan mọ́lẹ̀ Rẹ sì wá"},{"start":1.727,"end":2.792,"text":"Loni yi Oluwa","marked":"Lónì yí Olúwa"},{"start":3.242,"end":4.458,"text":"Fi ara Re han wa","marked":"Fi ara Rẹ hàn wá"},{"start":4.908,"end":5.994,"text":"N'nu oro Mimo Re","marked":"N'nú ọ̀rọ̀ Mímọ́ Rẹ"},{"start":6.444,"end":7.813,"text":"Jo m'okan wa gbona","marked":"Jọ m'ọkàn wa gbóná"},{"start":8.263,"end":9.434,"text":"K'a ma wo oju Re","marked":"K'á má wo ojú Rẹ"},{"start":9.884,"end":11.209,"text":"K'awon 'mode le ko","marked":"K'àwọn mọdẹ lè kọ"},{"start":11.659,"end":12.8,"text":"Iyanu ore Re.","marked":"Ìyanu ọrẹ Rẹ."}],"end":12.8},{"key":"2","start":13.75,"lines":[{"start":13.75,"end":14.768,"text":"Mi si wa Oluwa,","marked":"Mi sì wá Olúwa"},{"start":15.218,"end":16.113,"text":"Ina Ẹmi Mimọ ,","marked":"Iná Ẹ̀mí Mímọ́"},{"start":16.563,"end":17.733,"text":"K'a le fi ọkan kan,","marked":"K'á lè fi ọkàn kan"},{"start":18.183,"end":19.125,"text":"Gbe orukọ Rẹ ga;","marked":"Gbé orúkọ Rẹ̀ ga"},{"start":19.575,"end":20.987,"text":"Jọ fi eti igbọ,","marked":"Jọ fi etí ìgbọ́"},{"start":21.437,"end":22.627,"text":"At'ọkan ironu,","marked":"Àt'ọkàn ìrònú"},{"start":23.077,"end":24.328,"text":"Fun awọn ti a n kọ,","marked":"Fún àwọn tí a ń kọ"},{"start":24.778,"end":26.682,"text":"L'ohun nla t'O ti se.","marked":"L'ohun ńlá t'Ó ti ṣe."}],"end":26.682},{"key":"3","start":27.632,"lines":[{"start":27.632,"end":28.782,"text":"Ba ni sọ, Oluwa,","marked":"Bá ní sọ, Olúwa"},{"start":29.232,"end":30.392,"text":"Ohun to yẹ k'a sọ,","marked":"Ohun tó yẹ k'á sọ"},{"start":30.842,"end":32.02,"text":"Gẹgẹ bi ọrọ Rẹ,","marked":"Gẹ́gẹ́ bí ọ̀rọ̀ Rẹ"},{"start":32.47,"end":33.733,"text":"Ni ki ẹkọ wa jẹ;","marked":"Ní kí ẹ̀kọ́ wa jẹ́"},{"start":34.183,"end":35.073,"text":"K'awọn aguntan Rẹ,","marked":"K'àwọn àgùntàn Rẹ"},{"start":35.523,"end":36.771,"text":"Le ma mọ ohun rẹ,","marked":"Lè má mọ ohun rẹ"},{"start":37.221,"end":38.746,"text":"Ibi t'O n tọ wọn si,","marked":"Ibi t'Ó ń tọ̀ wọ́n sí"},{"start":39.196,"end":40.38,"text":"Ki wọn si le ma yọ.","marked":"Kí wọ́n sì lè má yọ̀."}],"end":40.38},{"key":"4","start":41.33,"lines":[{"start":41.33,"end":42.664,"text":"Gbe 'nu wa, Oluwa,","marked":"Gbé nù wá, Olúwa"},{"start":43.114,"end":44.318,"text":"K'ifẹ Rẹ jẹ tiwa,","marked":"K'ìfẹ́ Rẹ jẹ́ tiwa"},{"start":44.768,"end":45.973,"text":"Iwọ nikan la o fi","marked":"Ìwọ nìkan la ó fi"},{"start":46.423,"end":47.748,"text":"Ipa wa gbogbo sin;","marked":"Ipa wa gbogbo sin"},{"start":48.198,"end":49.216,"text":"K'iwa wa jẹ ẹkọ,","marked":"K'ìwà wa jẹ́ ẹ̀kọ́"},{"start":49.666,"end":50.539,"text":"Fun awọn ọmọ RẸ,","marked":"Fún àwọn ọmọ Rẹ"},{"start":50.989,"end":52.131,"text":"K'o si ma kede Rẹ,","marked":"K'ó sì má kéde Rẹ̀"},{"start":52.581,"end":53.654,"text":"Ninu gbogbo ọkan.","marked":"Nínú gbogbo ọkàn."}],"end":53.654}]}