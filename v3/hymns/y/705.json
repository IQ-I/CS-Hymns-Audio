{"v":3,"coll":"y","num":705,"id":"hymn_705","title":"ARA, e ba wa yo","duration":57.328,"voices":{"male":{"file":"y-705-male-v3.m4a","bytes":397690,"sha256":"c8b5531472db3035857fef31909cb581fa539ca664e6ba26edae301785b83c6e","duration":57.4},"female":{"file":"y-705-female-v3.m4a","bytes":408917,"sha256":"369e17aa99733d8f6f437a8f4a2b764d200dac44b3577145d3f12c47cf748260","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.129,"text":"ARA, e ba wa yo","marked":"Ara, ẹ bá wa yọ̀"},{"start":2.579,"end":3.778,"text":"Ka jo d'orin wa po","marked":"Ká jọ d'orin wá pọ̀"},{"start":4.228,"end":6.093,"text":"Nipa ti Kerubu t'a ri","marked":"Nípa ti Kérúbù t'á rí"},{"start":6.543,"end":7.961,"text":"T'o si s'oju emi.","marked":"T'ó sì s'ojú ẹ̀mí."}],"end":7.961},{"key":"2","start":8.911,"lines":[{"start":8.911,"end":10.049,"text":"Gbogbo Ẹgbẹ Séráfù,","marked":"Gbogbo Ẹgbẹ́ Séráfù"},{"start":10.499,"end":11.659,"text":"Baba Aladura,","marked":"Baba Aládúrà"},{"start":12.109,"end":14.239,"text":"Captain, ayọ ni eyi jẹ,","marked":"Captain, ayọ̀ ni èyí jẹ́"},{"start":14.689,"end":15.942,"text":"Pe Kérúbù tun de.","marked":"Pé Kérúbù tún dé."}],"end":15.942},{"key":"3","start":16.892,"lines":[{"start":16.892,"end":18.161,"text":"E wa ka s'owo po","marked":"Ẹ wá ká s'ọwọ́ pọ̀"},{"start":18.611,"end":20.057,"text":"K'a yin Baba l'oke","marked":"K'á yin Baba l'òkè"},{"start":20.507,"end":22.215,"text":"K'a fi gbogbo keta sile","marked":"K'á fi gbogbo kẹta sílẹ̀"},{"start":22.665,"end":24.032,"text":"K'okan wa kun f'ayo.","marked":"K'ọkàn wa kún f'ayọ̀."}],"end":24.032},{"key":"4","start":24.982,"lines":[{"start":24.982,"end":25.997,"text":"Ẹgbẹ Aladura,","marked":"Ẹgbẹ́ Aládúrà"},{"start":26.447,"end":27.605,"text":"Ẹ ku afojuba,","marked":"Ẹ kú àfojúbá"},{"start":28.055,"end":29.355,"text":"Ẹgbẹ Igbimọ Séráfù,","marked":"Ẹgbẹ́ Ìgbìmọ̀ Séráfù"},{"start":29.805,"end":31.135,"text":"Ẹ ku ayọ ọkan.","marked":"Ẹ kú ayọ̀ ọkàn."}],"end":31.135},{"key":"5","start":32.085,"lines":[{"start":32.085,"end":33.422,"text":"Ẹyin Ẹgbẹ Akọrin,","marked":"Ẹ̀yin Ẹgbẹ́ Akọrin"},{"start":33.872,"end":34.973,"text":"Ẹ tun ohun yin se;","marked":"Ẹ tún ohun yín ṣe"},{"start":35.423,"end":37.343,"text":"Ki fere dun, ki duru dun;","marked":"Kí fèrè dùn, kí dùrù dùn"},{"start":37.793,"end":39.124,"text":"Ki a jumọ ho ye.","marked":"Kí a jùmọ̀ hó yẹ."}],"end":39.124},{"key":"6","start":40.074,"lines":[{"start":40.074,"end":41.307,"text":"Kerubu Serafu","marked":"Kérúbù Séráfù"},{"start":41.757,"end":42.951,"text":"Awon l'o gbode kan","marked":"Àwọn l'ó gbọdẹ kan"},{"start":43.401,"end":44.882,"text":"Ase, Oluwa l'eyi je","marked":"Àṣẹ, Olúwa l'èyí jẹ́"},{"start":45.332,"end":46.924,"text":"Ko s'egbe to dun to.","marked":"Kò s'ègbé tó dùn tó."}],"end":46.924},{"key":"7","start":47.874,"lines":[{"start":47.874,"end":48.951,"text":"Orin Halleluya!","marked":"Orin Hallelúyà!"},{"start":49.401,"end":50.968,"text":"L'a wa yoo kọ l'ọrun;","marked":"L'á wá yóò kọ́ l'ọ̀run"},{"start":51.418,"end":54.223,"text":"Halle! Halle!! Halleluya!!!","marked":"Halle! Halle!! Hallelúyà!!!"},{"start":54.673,"end":55.779,"text":"Amin, Amin, Asẹ.","marked":"Àmín, Àmín, Àsẹ."}],"end":55.779}]}