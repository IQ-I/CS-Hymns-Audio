{"v":3,"coll":"y","num":301,"id":"hymn_301","title":"IFE lo to bayi!","duration":54.445,"voices":{"male":{"file":"y-301-male-v3.m4a","bytes":372524,"sha256":"1aa10d26ed500f691b07e886a4692196326ceeff0e26ab4d46ac1169ba96722d","duration":54.5},"female":{"file":"y-301-female-v3.m4a","bytes":391597,"sha256":"753b794dec122dd72db1663ae09e9c8c7ff6fedbe8b5ff09e8a49eee40805971","duration":54.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.423,"text":"IFẸ lo to bayi!","marked":"Ìfẹ́ ló tó báyì!"},{"start":1.873,"end":2.773,"text":"Ohun gbogbo pari,","marked":"Ohun gbogbo parí"},{"start":3.223,"end":4.737,"text":"O ti pari gbogbo isẹ,","marked":"Ó ti parí gbogbo isẹ́"},{"start":5.187,"end":6.421,"text":"T'o tori rẹ w'ayé.","marked":"T'ó torí rẹ̀ w'ayé."}],"end":6.421},{"key":"2","start":7.371,"lines":[{"start":7.371,"end":8.463,"text":"Ohun ti Baba fẹ,","marked":"Ohun tí Baba fẹ́"},{"start":8.913,"end":10.438,"text":"Ni Jesu ti se tan:","marked":"Ní Jésù ti ṣe tán"},{"start":10.888,"end":12.351,"text":"Wahala ati iya Rẹ,","marked":"Wàhálà àti ìyá Rẹ̀"},{"start":12.801,"end":13.902,"text":"Mu Iwe Mimọ sẹ.","marked":"Mú Ìwé Mímọ́ sẹ́."}],"end":13.902},{"key":"3","start":14.852,"lines":[{"start":14.852,"end":16.048,"text":"Ko s'irora wa kan,","marked":"Kò s'ìrora wa kan"},{"start":16.498,"end":17.964,"text":"Ti Jesu ko jẹ ri;","marked":"Tí Jésù kò jẹ́ rí"},{"start":18.414,"end":20.184,"text":"Gbogbo ẹdun at'aniyan,","marked":"Gbogbo ẹ̀dùn àt'àníyàn"},{"start":20.634,"end":21.878,"text":"L'ọkan Rẹ si ti mọ.","marked":"L'ọkàn Rẹ sì ti mọ̀."}],"end":21.878},{"key":"4","start":22.828,"lines":[{"start":22.828,"end":24.167,"text":"L'ori t'a f'ẹgun de,","marked":"L'orí t'á f'ẹ̀gún dé"},{"start":24.617,"end":25.667,"text":"At'ọkan Rẹ mimọ,","marked":"Àt'ọkàn Rẹ mímọ́"},{"start":26.117,"end":27.938,"text":"L'a ko gbogbo ẹsẹ wa le,","marked":"L'á kó gbogbo ẹsẹ̀ wa lé"},{"start":28.388,"end":29.745,"text":"K'O ba le wo wa san.","marked":"K'Ó bá lè wò wá sàn."}],"end":29.745},{"key":"5","start":30.695,"lines":[{"start":30.695,"end":32.281,"text":"Ife lo mu k' O ku,","marked":"Ìfẹ́ ló mú k Ó kú"},{"start":32.731,"end":33.875,"text":"Fun emi otosi;","marked":"Fún ẹ̀mí òtòṣì"},{"start":34.325,"end":35.867,"text":"'Wo Etutu f' ese gbogbo,","marked":"wo Ètùtù f ẹsẹ̀ gbogbo"},{"start":36.317,"end":37.636,"text":"Mo f' igbagbo ro mo.","marked":"Mo f ìgbàgbọ́ rò mọ́."}],"end":37.636},{"key":"6","start":38.586,"lines":[{"start":38.586,"end":39.608,"text":"Nigba aini gbogbo,","marked":"Nígbà àìní gbogbo"},{"start":40.058,"end":41.471,"text":"Ati n' ite 'dajo,","marked":"Àti ń ìtẹ́ dájọ́"},{"start":41.921,"end":44.218,"text":"Jesu, ododo Re nikan,","marked":"Jésù, òdodo Rẹ̀ nìkan"},{"start":44.668,"end":45.671,"text":"Ni igbekele mi.","marked":"Ní ìgbẹ́kẹ̀lé mi."}],"end":45.671},{"key":"7","start":46.621,"lines":[{"start":46.621,"end":47.793,"text":"Jọ sisẹ ninu mi,","marked":"Jọ sisẹ́ nínú mi"},{"start":48.243,"end":49.458,"text":"Bi O ti se fun mi,","marked":"Bí Ó ti ṣe fún mi"},{"start":49.908,"end":51.39,"text":"Si jẹ ki ifẹ mi si Ọ,","marked":"Sì jẹ́ kí ìfẹ́ mi sí Ọ"},{"start":51.84,"end":52.896,"text":"Ma fi ore Rẹ han.","marked":"Má fi ọrẹ Rẹ hàn."}],"end":52.896}]}