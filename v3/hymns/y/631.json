{"v":3,"coll":"y","num":631,"id":"hymn_631","title":"MO ti seleri Jesu","duration":75.965,"voices":{"male":{"file":"y-631-male-v3.m4a","bytes":543065,"sha256":"fe21061de021d1bf88ab6ba36756b233963f657a16d6b16e3243311773c7a056","duration":76.0},"female":{"file":"y-631-female-v3.m4a","bytes":562459,"sha256":"41f35575b3095b79699afceef545565c973a8b9e1ca54be649708e0da3c5a4db","duration":76.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.768,"text":"MO ti seleri Jesu,","marked":"Mo ti ṣèlérí Jésù"},{"start":2.218,"end":3.64,"text":"Lati sin Ọ dopin;","marked":"Láti sin Ọ́ dópin"},{"start":4.09,"end":5.312,"text":"Ma wa lọdọ mi titi,","marked":"Má wà lọ́dọ̀ mi títí"},{"start":5.762,"end":7.453,"text":"Baba mi, Ọrẹ mi;","marked":"Baba mi, Ọ̀rẹ́ mi"},{"start":7.903,"end":9.198,"text":"Emi ki y'o bẹru ogun,","marked":"Èmi kí y'ó bẹ̀rù ogun"},{"start":9.648,"end":10.641,"text":"B'Iwọ ba sunmọ mi;","marked":"B'Ìwọ bá súnmọ́ mi"},{"start":11.091,"end":12.365,"text":"Emi ki y'o si sina,","marked":"Èmi kí y'ó sì ṣìnà"},{"start":12.815,"end":14.088,"text":"B'O ba f'ọna han mi","marked":"B'Ó bá f'ọ̀nà hàn mí"}],"end":14.088},{"key":"2","start":15.038,"lines":[{"start":15.038,"end":16.381,"text":"Jẹ ki n mọ p'O sunmọ mi,","marked":"Jẹ́ kí n mọ p'Ó súnmọ́ mi"},{"start":16.831,"end":17.828,"text":"'Tor' ibajẹ ayé;","marked":"tor ìbàjẹ́ ayé"},{"start":18.278,"end":19.554,"text":"Ayé fẹ gba ọkan mi,","marked":"Ayé fẹ́ gba ọkàn mi"},{"start":20.004,"end":21.285,"text":"Ayé fẹ tan mi jẹ;","marked":"Ayé fẹ́ tàn mí jẹ"},{"start":21.735,"end":23.059,"text":"Ọta yi mi ka kiri,","marked":"Ọ̀tá yí mi ká kiri"},{"start":23.509,"end":24.851,"text":"Lode ati ninu;","marked":"Lóde àti nínú"},{"start":25.301,"end":27.724,"text":"Sugbọn Jesu, sunmọ mi,","marked":"Sùgbọ́n Jésù, súnmọ́ mi"},{"start":28.174,"end":29.416,"text":"Dabobo ọkan mi,","marked":"Dàbòbò ọkàn mi"}],"end":29.416},{"key":"3","start":30.366,"lines":[{"start":30.366,"end":31.535,"text":"Jẹ ki emi k'o ma gbọ,","marked":"Jẹ́ kí èmi k'ó má gbọ́"},{"start":31.985,"end":33.289,"text":"Ohun Rẹ, Jesu mi,","marked":"Ohùn Rẹ, Jésù mi"},{"start":33.739,"end":35.12,"text":"Ninu igbi ayé yi,","marked":"Nínú ìgbì ayé yí"},{"start":35.57,"end":36.534,"text":"Titi nigba gbogbo;","marked":"Títí nígbà gbogbo"},{"start":36.984,"end":38.513,"text":"Sọ, mu k'o da mi l'oju,","marked":"Sọ, mú k'ó dá mi l'ojú"},{"start":38.963,"end":40.194,"text":"K'ọkan mi ni'janu,","marked":"K'ọkàn mi ní'jánu"},{"start":40.644,"end":42.311,"text":"Sọ, si mu mi gbọ Tirẹ,","marked":"Sọ, sì mú mi gbọ́ Tirẹ̀"},{"start":42.761,"end":43.967,"text":"'Wọ Olutọju mi.","marked":"'Wọ Olùtọ́jú mi."}],"end":43.967},{"key":"4","start":44.917,"lines":[{"start":44.917,"end":46.4,"text":"'Wọ ti seleri, Jesu,","marked":"'Wọ ti ṣèlérí, Jésù"},{"start":46.85,"end":48.109,"text":"F'awọn t'o tẹle Ọ;","marked":"F'àwọn t'ó tẹ̀lé Ọ"},{"start":48.559,"end":50.158,"text":"Pe ibikibi t'O wa,","marked":"Pé ibikíbi t'Ó wà"},{"start":50.608,"end":51.548,"text":"L'awọn yoo si wa;","marked":"L'àwọn yóò sì wà"},{"start":51.998,"end":53.564,"text":"Mo ti seleri, Jesu,","marked":"Mo ti ṣèlérí, Jésù"},{"start":54.014,"end":55.359,"text":"Lati sin Ọ dopin,","marked":"Láti sin Ọ́ dópin"},{"start":55.809,"end":57.149,"text":"Jẹ ki n ma tọ Ọ lẹhin,","marked":"Jẹ́ kí n má tọ̀ Ọ́ lẹ́hìn"},{"start":57.599,"end":59.165,"text":"Baba mi, Ọrẹ mi.","marked":"Baba mi, Ọ̀rẹ́ mi."}],"end":59.165},{"key":"5","start":60.115,"lines":[{"start":60.115,"end":61.487,"text":"Jẹ ki n ma ri 'pasẹ Rẹ,","marked":"Jẹ́ kí n má rí 'pasẹ Rẹ"},{"start":61.937,"end":63.209,"text":"Ki n le ma tẹle Ọ,","marked":"Kí n lè má tẹ̀lé Ọ"},{"start":63.659,"end":65.019,"text":"Agbara Rẹ nikan ni,","marked":"Agbára Rẹ̀ nìkan ni"},{"start":65.469,"end":66.578,"text":"Ti mba le tẹle Ọ;","marked":"Tí mbá le tẹ̀lé Ọ"},{"start":67.028,"end":69.235,"text":"Tọ mi, pe mi, si fa mi,","marked":"Tọ̀ mi, pè mí, sì fà mí"},{"start":69.685,"end":70.693,"text":"Di mi mu de opin;","marked":"Dì mí mú dé òpin"},{"start":71.143,"end":72.409,"text":"Si gba mi si ọdọ Rẹ,","marked":"Sì gbà mí sí ọ̀dọ̀ Rẹ"},{"start":72.859,"end":74.417,"text":"Baba mi, Ọrẹ mi.","marked":"Baba mi, Ọ̀rẹ́ mi."}],"end":74.417}]}