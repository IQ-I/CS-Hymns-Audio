{"v":3,"coll":"y","num":638,"id":"hymn_638","title":"OLORUN gb'okan mi loni","duration":41.335,"voices":{"male":{"file":"y-638-male-v3.m4a","bytes":278694,"sha256":"e81fc71bc716b7e7e6fd3795c07f22ad436d26b6ee760beaf0fb4e015cd177f0","duration":41.4},"female":{"file":"y-638-female-v3.m4a","bytes":288813,"sha256":"3d119ca7a839a9f1572e6720e482d628aa0f44e0ef1bb71743544264e50b43e0","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.455,"text":"ỌLỌRUN gb'ọkan mi loni,","marked":"Ọlọ́run gb'ọkàn mi lónì"},{"start":1.905,"end":3.041,"text":"Si ma se ni Tirẹ;","marked":"Sí má ṣe ní Tirẹ̀"},{"start":3.491,"end":4.925,"text":"Ki n ma sako lọdọ Rẹ mọ,","marked":"Kí n má ṣáko lọ́dọ̀ Rẹ mọ́"},{"start":5.375,"end":6.664,"text":"Ki n ma yẹ lọdọ Rẹ.","marked":"Kí n má yẹ lọ́dọ̀ Rẹ."}],"end":6.664},{"key":"2","start":7.614,"lines":[{"start":7.614,"end":9.581,"text":"Wo! mo wolẹ buruburu","marked":"Wò! mo wólẹ̀ burúburú"},{"start":10.031,"end":11.192,"text":"Lẹsẹ agbelebu;","marked":"Lẹ́sẹ̀ àgbélébùú"},{"start":11.642,"end":12.87,"text":"Kan gbogbo ẹsẹ mi mọ'gi,","marked":"Kan gbogbo ẹsẹ̀ mi mọ́'gí"},{"start":13.32,"end":14.73,"text":"Ki Krist' j'ohun gbogbo.","marked":"Kí Krist j'ohun gbogbo."}],"end":14.73},{"key":"3","start":15.68,"lines":[{"start":15.68,"end":17.199,"text":"F'ore ọfẹ ọrun fun mi,","marked":"F'oore ọ̀fẹ́ ọ̀run fún mi"},{"start":17.649,"end":18.879,"text":"Si se mi ni Tirẹ;","marked":"Sì ṣe mí ní Tirẹ̀"},{"start":19.329,"end":21.19,"text":"Ki n le r'oju Rẹ t'o logo,","marked":"Kí n lè r'ojú Rẹ̀ t'ó lógo"},{"start":21.64,"end":22.786,"text":"Ki n ma sin n'itẹ Rẹ.","marked":"Kí n má sìn n'ìtẹ́ Rẹ̀."}],"end":22.786},{"key":"4","start":23.736,"lines":[{"start":23.736,"end":26.739,"text":"K'ero, ọrọ, at'ise mi,","marked":"K'èrò, ọ̀rọ̀, àt'iṣẹ́ mi"},{"start":27.189,"end":28.592,"text":"Jẹ Tirẹ titi lai;","marked":"Jẹ́ Tirẹ̀ títí láì"},{"start":29.042,"end":30.421,"text":"Ki n fi gbogb' ayé mi sin Ọ,","marked":"Kí n fi gbogb ayé mi sìn Ọ"},{"start":30.871,"end":32.282,"text":"K'iku jẹ isinmi.","marked":"K'ikú jẹ́ ìsinmi."}],"end":32.282},{"key":"5","start":33.232,"lines":[{"start":33.232,"end":34.619,"text":"Ogo gbogbo ni fun Baba","marked":"Ògo gbogbo ni fún Baba"},{"start":35.069,"end":36.13,"text":"Ogo ni fun Omo","marked":"Ògo ni fún Ọmọ"},{"start":36.58,"end":37.814,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":38.264,"end":39.786,"text":"Titi ainipekun.","marked":"Títí àìnípẹ̀kun."}],"end":39.786}]}