{"v":3,"coll":"y","num":211,"id":"hymn_211","title":"LEHIN odun die","duration":68.292,"voices":{"male":{"file":"y-211-male-v3.m4a","bytes":499588,"sha256":"f5986538c86e0510a719550619d98891c05cc0cd3695b48c537eb242ccef6789","duration":68.3},"female":{"file":"y-211-female-v3.m4a","bytes":501752,"sha256":"82c5cc3bbacf98c7533c28b23259202a40c7fd6e34cc0d67b1d84012bd4ef46b","duration":68.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.462,"text":"LEHIN odun die,","marked":"Lẹ́hìn ọdún díẹ̀"},{"start":1.912,"end":2.886,"text":"Lehin igba die,","marked":"Lẹ́hìn ìgbà díẹ̀"},{"start":3.336,"end":4.875,"text":"A o ko wa jo pẹl'awọn","marked":"A ó kó wá jọ pẹ̀l'àwọn"},{"start":5.325,"end":14.054,"text":"Ti o sun n'iboji. Oluwa, mu mi ye, Fun ọjọ nlanla na! Jọ, wẹ mi ninu ẹjẹ Rẹ, Si ko ẹsẹ mi lọ.","marked":"Tí ó sùn n'ibojì. Olúwa, mú mi yẹ, Fún ọjọ́ ńláńlá ná! Jọ, wẹ̀ mi nínú ẹ̀jẹ̀ Rẹ, Sì kó ẹsẹ̀ mi lọ."}],"end":14.054},{"key":"CHORUS","start":15.004,"lines":[{"start":15.004,"end":16.076,"text":"Oluwa, mu mi ye,","marked":"Olúwa, mú mi yẹ"},{"start":16.526,"end":17.629,"text":"Fun ojo nlanla na!","marked":"Fún ọjọ́ ńláńlá ná!"},{"start":18.079,"end":19.44,"text":"Jo, we mi ninu eje Re,","marked":"Jọ, wẹ̀ mi nínú ẹ̀jẹ̀ Rẹ"},{"start":19.89,"end":21.362,"text":"Si ko ese mi lo.","marked":"Sì kó ẹsẹ̀ mi lọ."}],"end":21.362},{"key":"2","start":22.312,"lines":[{"start":22.312,"end":23.485,"text":"Lẹhin ọjọ diẹ,","marked":"Lẹ́hìn ọjọ́ díẹ̀"},{"start":23.935,"end":25.115,"text":"Layé buburu yi,","marked":"Layé búburú yí"},{"start":25.565,"end":27.476,"text":"di A o de b'orun ko si mọ,","marked":"di A ó dé b'ọ̀run kò sì mọ̀"},{"start":27.926,"end":28.905,"text":"Ile daradara.","marked":"Ilẹ̀ dáradára."}],"end":28.905},{"key":"3","start":29.855,"lines":[{"start":29.855,"end":31.185,"text":"mp Lẹhin igbi diẹ;","marked":"mp Lẹ́hìn ìgbì díẹ̀"},{"start":31.635,"end":32.872,"text":"L'ebute lile yi,","marked":"L'èbúté líle yí"},{"start":33.322,"end":34.833,"text":"A o de b'iji ko si mọ,","marked":"A ò dé b'ìjì kò sì mọ́"},{"start":35.283,"end":36.85,"text":"T'o kun ki bu soke;","marked":"T'ó kún kí bu sókè"}],"end":36.85},{"key":"4","start":37.8,"lines":[{"start":37.8,"end":38.827,"text":"Lehin 'yonu die;","marked":"Lẹ́hìn yọnu díẹ̀"},{"start":39.277,"end":40.517,"text":"Lehin 'pinya die;","marked":"Lẹ́hìn pínyà díẹ̀"},{"start":40.967,"end":42.743,"text":"Lehin ekun ati aro,","marked":"Lẹ́hìn ẹkún àti arọ"},{"start":43.193,"end":44.379,"text":"A ki sokun mo.","marked":"A kì sọkún mọ́."}],"end":44.379},{"key":"5","start":45.329,"lines":[{"start":45.329,"end":46.353,"text":"Ọjọ 'sinmi diẹ,","marked":"Ọjọ́ sinmi díẹ̀"},{"start":46.803,"end":48.068,"text":"La ni tun ri layé;","marked":"La ni tún rí layé"},{"start":48.518,"end":49.766,"text":"A o de ibi sinmi,","marked":"A ó dé ibi sinmi"},{"start":50.216,"end":51.385,"text":"Ti ki o pin lailai,","marked":"Tí kí ó pín láéláé"}],"end":51.385},{"key":"6","start":52.335,"lines":[{"start":52.335,"end":53.647,"text":"Ojo die l'o ku,","marked":"Ọjọ́ díẹ̀ l'ó kú"},{"start":54.097,"end":55.255,"text":"Oun o tun pada wa,","marked":"Òun ó tún padà wá"},{"start":55.705,"end":57.366,"text":"Ẹni ti o ku k'awa le","marked":"Ẹni tí ó kù k'àwa le"},{"start":57.816,"end":66.743,"text":"ye, K'a ba le ba joba. Oluwa, mu mi ye, Fun ọjọ nlanla na! Jọ, wẹ mi ninu ẹjẹ Rẹ, Si ko ẹsẹ mi lọ.","marked":"yẹ, K'a bá lè bá jọba. Olúwa, mú mi yẹ, Fún ọjọ́ ńláńlá ná! Jọ, wẹ̀ mi nínú ẹ̀jẹ̀ Rẹ, Sì kó ẹsẹ̀ mi lọ."}],"end":66.743}]}