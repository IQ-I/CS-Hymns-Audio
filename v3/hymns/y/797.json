{"v":3,"coll":"y","num":797,"id":"hymn_797","title":"EMI at'ara ile mi","duration":71.954,"voices":{"male":{"file":"y-797-male-v3.m4a","bytes":508715,"sha256":"2014c7dc88e4e2e9e6bbf975d28a1c2665832f4d9dfb5da8e7de73f95a5dd674","duration":72.0},"female":{"file":"y-797-female-v3.m4a","bytes":531997,"sha256":"e4716c30d1d5573eb200cdd971cb5cb89aa13078b13bf6acbdb134e1bac39ce4","duration":72.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.63,"text":"EMI at'ara ile mi,","marked":"Èmi àt'ara ilé mi"},{"start":2.08,"end":3.487,"text":"Yoo ma sin Oluwa wa;","marked":"Yóò má sin Olúwa wa"},{"start":3.937,"end":5.106,"text":"Sugbọn emi papa;","marked":"Sùgbọ́n èmi pápá"},{"start":5.556,"end":7.177,"text":"Yoo f'iwa at'ọrọ han,","marked":"Yóò f'ìwà àt'ọ̀rọ̀ hàn"},{"start":7.627,"end":8.848,"text":"Pe mo mọ Oluwa t'ọrun,","marked":"Pé mo mọ Olúwa t'ọ̀run"},{"start":9.298,"end":10.647,"text":"Mo n fi ọkan totọ sin.","marked":"Mo ń fi ọkàn tòtọ́ sìn."}],"end":10.647},{"key":"2","start":11.597,"lines":[{"start":11.597,"end":13.008,"text":"Em'o f'apẹrẹ 're le'lẹ;","marked":"Èm'ó f'apẹ́rẹ́ rẹ̀ lé'lẹ́"},{"start":13.458,"end":14.87,"text":"N ó mu idena na kuro;","marked":"N ó mú ìdènà nà kúrò"},{"start":15.32,"end":16.374,"text":"Lọdọ ọm'ọdọ mi;","marked":"Lọ́dọ̀ ọm'ọ̀dọ̀ mi"},{"start":16.824,"end":18.35,"text":"N ó f'isẹ wọn han n'iwa mi","marked":"N ó f'isẹ́ wọn hàn n'ìwà mi"},{"start":18.8,"end":21.123,"text":"Sibẹ n'nu 'sẹ mi ki n si ni","marked":"Síbẹ̀ n'nú 'sẹ mí kí n sì ní"},{"start":21.573,"end":22.933,"text":"Ọla na ti ifẹ.","marked":"Ọlá na ti ìfẹ́."}],"end":22.933},{"key":"3","start":23.883,"lines":[{"start":23.883,"end":25.383,"text":"Emi ki y'o soro gb'ipẹ,","marked":"Èmi kí y'ó sọ̀rọ̀ gb'ìpẹ́"},{"start":25.833,"end":27.494,"text":"Emi ki y'o pẹ tu ninu,","marked":"Èmi kí y'ó pẹ́ tù nínú"},{"start":27.944,"end":29.141,"text":"Ọm' ẹhin Ọlọrun;","marked":"Ọm' ẹ̀hìn Ọlọ́run"},{"start":29.591,"end":31.087,"text":"Mo si fẹ jẹ ẹni mimọ;","marked":"Mo sì fẹ́ jẹ́ ẹni mímọ́"},{"start":31.537,"end":33.055,"text":"Ki n si fa gbogbo ile mi,","marked":"Kí n sì fa gbogbo ilẹ̀ mi"},{"start":33.505,"end":34.427,"text":"S'oju ọna ọrun","marked":"S'ojú ọ̀nà ọ̀run"}],"end":34.427},{"key":"4","start":35.377,"lines":[{"start":35.377,"end":38.072,"text":"Jesu, b'O ba de'na 'fẹ na,","marked":"Jésù, b'Ó bá dé'nà 'fẹ ná"},{"start":38.522,"end":39.779,"text":"Ohun elo t'Iwọ fẹ lo,","marked":"Ohun èlò t'Ìwọ fẹ́ lọ"},{"start":40.229,"end":41.337,"text":"Gba s'ọwọ ara Rẹ!","marked":"Gba s'ọwọ́ ara Rẹ!"},{"start":41.787,"end":43.263,"text":"Sisẹ ifẹ rere n'nu mi,","marked":"Sísẹ ìfẹ́ rere n'nú mi"},{"start":43.713,"end":45.201,"text":"Ki n fi b'onigbagbọ totọ,","marked":"Kí n fi b'onígbàgbọ́ tòtọ́"},{"start":45.651,"end":46.821,"text":"Ti ń gbe l'ayé han wọn","marked":"Tí ń gbé l'ayé hàn wọ́n"}],"end":46.821},{"key":"5","start":47.771,"lines":[{"start":47.771,"end":49.296,"text":"Fun mi l'ore-ofe toto","marked":"Fún mi l'oore-ọ̀fẹ́ tòtọ́"},{"start":49.746,"end":51.799,"text":"Nje! Emi de lati jeri","marked":"Ǹjẹ́! Èmi dé láti jẹ́rí"},{"start":52.249,"end":53.189,"text":"Yanu oruko Re","marked":"Yanu orúkọ Rẹ"},{"start":53.639,"end":54.854,"text":"Ti o gba mi l'owo egbe","marked":"Tí ó gbà mí l'ọ̀wọ́ ẹgbẹ́"},{"start":55.304,"end":56.545,"text":"Ire eyi t'a mo l'okan","marked":"Ìrè èyí t'a mọ́ l'ọkàn"},{"start":56.995,"end":58.072,"text":"Ti gbogb'ahon le so.","marked":"Tí gbogb'ahọ́n lè sọ."}],"end":58.072},{"key":"6","start":59.022,"lines":[{"start":59.022,"end":60.331,"text":"Emi t'o bọ lọwọ ẹsẹ,","marked":"Èmi t'ó bọ́ lọ́wọ́ ẹsẹ̀"},{"start":60.781,"end":62.127,"text":"Mo wa lati gba'le mi la,","marked":"Mo wá láti gbà'lé mi là"},{"start":62.577,"end":63.74,"text":"Ki n wasu 'dariji;","marked":"Kí n wàṣù dáríjì"},{"start":64.19,"end":66.721,"text":"F'ọmọ, f'aya, f'ọmọ-dọ mi","marked":"F'ọmọ, f'àyà, f'ọmọ-dọ mi"},{"start":67.171,"end":68.728,"text":"Lati mu wọn tọ'na rere,","marked":"Láti mú wọn tọ́'ná rere"},{"start":69.178,"end":70.405,"text":"Lọ si ọrun mimọ.","marked":"Lọ sí ọ̀run mímọ́."}],"end":70.405}]}