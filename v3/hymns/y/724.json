{"v":3,"coll":"y","num":724,"id":"hymn_724","title":"AWA si n jo, awa si n yo","duration":71.442,"voices":{"male":{"file":"y-724-male-v3.m4a","bytes":504688,"sha256":"bb0c81cc6de815a0fa10dfa375f26ceb44bcdc9ac61db21d5af12dbe409c7a2a","duration":71.5},"female":{"file":"y-724-female-v3.m4a","bytes":528832,"sha256":"489a4f83e2caa352605fed8bca465a7487d315598164dba3b4a78e434625cb7d","duration":71.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.63,"text":"AWA si njo, awa si nyo","marked":"Àwa sì ǹjọ, àwa sì ǹyọ"},{"start":3.08,"end":4.388,"text":"Fun ajodun ojo oni","marked":"Fún àjọ̀dún ọjọ́ òní"},{"start":4.838,"end":6.743,"text":"Olorun na, Enit' a nsin","marked":"Ọlọ́run ná, Ẹnit a ńṣin"},{"start":7.193,"end":8.88,"text":"K'o so ayo na di kikun.","marked":"K'ó sọ ayọ̀ ná di kíkún."}],"end":8.88},{"key":"CHORUS","start":9.83,"lines":[{"start":9.83,"end":11.628,"text":"Amin Amin Amin Ase","marked":"Àmín Àmín Àmín Àṣẹ"},{"start":12.078,"end":13.679,"text":"Amin Amin beni k'o ri","marked":"Àmín Àmín bẹni k'ó rí"},{"start":14.129,"end":16.24,"text":"Olorun na, Enit'a nsin","marked":"Ọlọ́run ná, Ẹnit'a ńṣin"},{"start":16.69,"end":18.695,"text":"K'o gb'adura, at'ebe wa.","marked":"K'ò gb'àdúrà, àt'ẹ̀bẹ̀ wa."}],"end":18.695},{"key":"2","start":19.645,"lines":[{"start":19.645,"end":21.468,"text":"Gbogbo aiye, e be wa yo","marked":"Gbogbo ayé, ẹ bẹ̀ wá yọ"},{"start":21.918,"end":23.124,"text":"Awa Egbe Serafu","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":23.574,"end":24.632,"text":"K'Olorun Olodumare","marked":"K'Ọlọ́run Olódùmarè"},{"start":25.082,"end":26.669,"text":"K'O fi ayo na kari wa.","marked":"K'Ó fi ayọ̀ ná kárí wa."}],"end":26.669},{"key":"3","start":27.619,"lines":[{"start":27.619,"end":29.516,"text":"Egbe Kerubu, Egbe Seraf'","marked":"Ẹgbẹ́ Kérúbù, Ẹgbẹ́ Seraf"},{"start":29.966,"end":31.564,"text":"E damuso k'e si ma yo","marked":"Ẹ dàmúṣọ k'é sì má yọ̀"},{"start":32.014,"end":33.459,"text":"Ki Metalokan t'a nsin","marked":"Kí Mẹ́talọ́kan t'á ńṣin"},{"start":33.909,"end":35.338,"text":"Fi ibukun Re kari wa.","marked":"Fi ìbùkún Rẹ kárí wa."}],"end":35.338},{"key":"4","start":36.288,"lines":[{"start":36.288,"end":38.185,"text":"Enyin Agan, e fo soke","marked":"Ẹ̀yin Àgàn, ẹ fò sókè"},{"start":38.635,"end":40.198,"text":"K'eyin Olupese l'ogo","marked":"K'ẹ́yìn Olùpèsè l'ògo"},{"start":40.648,"end":42.027,"text":"Olorun t'o gbo ti Serah","marked":"Ọlọ́run t'ó gbọ́ ti Serah"},{"start":42.477,"end":44.086,"text":"Yio pa gbogbo nyn l'erin.","marked":"Yóò pa gbogbo nyn l'ẹrin."}],"end":44.086},{"key":"5","start":45.036,"lines":[{"start":45.036,"end":46.934,"text":"Alailera, alairise","marked":"Aláìlera, aláìríṣẹ́"},{"start":47.384,"end":48.889,"text":"E ho f'ayo l'ojo oni","marked":"Ẹ hó f'ayọ̀ l'ọjọ́ òní"},{"start":49.339,"end":51.186,"text":"Oluwosan, Olupese","marked":"Olúwòsàn, Olùpèsè"},{"start":51.636,"end":53.293,"text":"Ti pase 'bukun s'ori nyin.","marked":"Ti pàṣẹ bùkún s'orí yín."}],"end":53.293},{"key":"6","start":54.243,"lines":[{"start":54.243,"end":55.673,"text":"Enyin ara ati ore","marked":"Ẹ̀yin ará àti ọrẹ"},{"start":56.123,"end":58.192,"text":"E ba wa jo, e ba wa yo","marked":"Ẹ bá wa jọ, ẹ bá wa yọ̀"},{"start":58.642,"end":59.797,"text":"Ki Olorun Emi Mimo","marked":"Kí Ọlọ́run Ẹ̀mí Mímọ́"},{"start":60.247,"end":61.923,"text":"Pe nyin s'agbo fun Ara Re.","marked":"Pé yín s'àgbò fún Ara Rẹ."}],"end":61.923},{"key":"7","start":62.873,"lines":[{"start":62.873,"end":64.192,"text":"Baba Omo Emi Mimo","marked":"Baba Ọmọ Ẹ̀mí Mímọ́"},{"start":64.642,"end":66.304,"text":"Gba ope ajodun wa yi","marked":"Gba ọpẹ́ àjọ̀dún wa yí"},{"start":66.754,"end":68.087,"text":"Jowo pese fun aini wa,","marked":"Jọ̀wọ́ pèsè fún àìní wa"},{"start":68.537,"end":69.893,"text":"K'o f'ese Egbe wa mule.","marked":"K'ò f'ẹsẹ̀ Ẹgbẹ́ wa múlẹ̀."}],"end":69.893}]}