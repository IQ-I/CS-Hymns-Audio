{"v":3,"coll":"y","num":614,"id":"hymn_614","title":"OHUN ti n dun l'aginju","duration":59.283,"voices":{"male":{"file":"y-614-male-v3.m4a","bytes":426290,"sha256":"d0e7ad4fbbd5f67c93cc68ccb16e366ae0db238ad5c8083facce9bee93ca6135","duration":59.3},"female":{"file":"y-614-female-v3.m4a","bytes":439381,"sha256":"1298c9837afdf46a7b4291dc68485064783682295703cb55e6f0e15d7a521db9","duration":59.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.586,"text":"OHUN ti n dun l'aginju,","marked":"Ohun tí ń dùn l'aginjù"},{"start":2.036,"end":3.083,"text":"Ohun alore ni,","marked":"Ohun alóre ni"},{"start":3.533,"end":5.208,"text":"Gbọ b'o ti n dun rara pe","marked":"Gbọ́ b'ó ti ń dùn rárá pé"},{"start":5.658,"end":6.587,"text":"Ẹ ronupiwada!","marked":"Ẹ ronúpìwàdà!"},{"start":7.037,"end":8.885,"text":"Ohun naa ko ha dun to?","marked":"Ohun náà kò ha dùn tó?"},{"start":9.335,"end":10.436,"text":"Ipe na ko kan ọ!","marked":"Ìpè ná kò kàn ọ́!"},{"start":10.886,"end":12.153,"text":"Ki l'o se arakunrin,","marked":"Kí l'ó ṣe arákùnrin"},{"start":12.603,"end":13.721,"text":"Ti o ko fi mira?","marked":"Tí ó kò fi mira?"}],"end":13.721},{"key":"2","start":14.671,"lines":[{"start":14.671,"end":16.007,"text":"Ijọba ku si dẹdẹ,","marked":"Ìjọba kú sí dẹ̀dẹ̀"},{"start":16.457,"end":17.712,"text":"Ijọba Ọlọrun,","marked":"Ìjọba Ọlọ́run"},{"start":18.162,"end":19.471,"text":"Awọn t'o ti fọ'sọ wọn,","marked":"Àwọn t'ó ti fọ́'sọ wọn"},{"start":19.921,"end":21.092,"text":"Nikan ni yoo gunwa;","marked":"Nìkan ni yóò gúnwà"},{"start":21.542,"end":23.175,"text":"Ese t'o ko fi nani,","marked":"Ẹsẹ̀ t'ó kò fi nani"},{"start":23.625,"end":24.561,"text":"Ohun alore yi,","marked":"Ohun alóre yí"},{"start":25.011,"end":26.24,"text":"Ti dun l'eti rẹ tantan,","marked":"Ti dùn l'etí rẹ̀ tàntàn"},{"start":26.69,"end":27.805,"text":"Pe ronupiwada.","marked":"Pé ronúpìwàdà."}],"end":27.805},{"key":"3","start":28.755,"lines":[{"start":28.755,"end":30.392,"text":"Abana pẹlu Fapar,","marked":"Abana pẹ̀lú Fapar"},{"start":30.842,"end":32.291,"text":"Le jẹ odo mimọ,","marked":"Lè jẹ́ ọ̀dọ̀ mímọ́"},{"start":32.741,"end":34.015,"text":"Sugbọn asẹ 'wẹnumọ,","marked":"Sùgbọ́n asẹ́ 'wẹnumọ"},{"start":34.465,"end":35.965,"text":"Jordan nikan l'o ni,","marked":"Jordan nìkan l'ó ní"},{"start":36.415,"end":37.778,"text":"Ju ero rẹ s'apakan,","marked":"Ju èrò rẹ̀ s'àpákàn"},{"start":38.228,"end":39.439,"text":"Se asẹ Oluwa,","marked":"Ṣe àsẹ Olúwa"},{"start":39.889,"end":41.248,"text":"Wa sun adagun yi,","marked":"Wá sun adágún yí"},{"start":41.698,"end":43.059,"text":"Wẹ k'o si di mimọ.","marked":"Wẹ́ k'ó sì di mímọ́."}],"end":43.059},{"key":"4","start":44.009,"lines":[{"start":44.009,"end":45.142,"text":"Kin' iba da ọ duro?","marked":"Kín ìbá dá ọ dúró?"},{"start":45.592,"end":46.691,"text":"Awawi kan ko si,","marked":"Àwáwí kan kò sí"},{"start":47.141,"end":49.172,"text":"Wọ odo, wo Johanu rẹ,","marked":"Wọ odò, wo Johanu rẹ"},{"start":49.622,"end":50.532,"text":"Ohun gbogbo setan;","marked":"Ohun gbogbo ṣetán"},{"start":50.982,"end":52.716,"text":"O pẹ ti o ti n jiyan,","marked":"Ó pẹ́ tí ó ti ń jiyàn"},{"start":53.166,"end":54.348,"text":"O ha bu Emi ku?","marked":"Ó ha bu Èmi kú?"},{"start":54.798,"end":56.034,"text":"Ẹlẹsẹ gbọ alore,","marked":"Ẹlẹ́sẹ̀ gbọ́ alóre"},{"start":56.484,"end":57.734,"text":"Si ronupiwada.","marked":"Sì ronúpìwàdà."}],"end":57.734}]}