{"v":3,"coll":"y","num":156,"id":"hymn_156","title":"SI O olutunu Orun","duration":52.964,"voices":{"male":{"file":"y-156-male-v3.m4a","bytes":368454,"sha256":"f6c3745c2be01a45874106f589c3a716e3ee893a747f30575abe3f50d0bbb773","duration":53.0},"female":{"file":"y-156-female-v3.m4a","bytes":376478,"sha256":"9a9f47d88db5ef058564e0d4f9c7c2837e863346baa1eb4a6ed3369ddb215c87","duration":53.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.549,"text":"SI Ọ Olutunu ọrun,","marked":"Sí Ọ Olùtùnú ọ̀run"},{"start":1.999,"end":3.766,"text":"Fun oore at'agbara Rẹ,","marked":"Fún oore àt'agbára Rẹ̀"},{"start":4.216,"end":5.543,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":5.543},{"key":"2","start":6.493,"lines":[{"start":6.493,"end":8.512,"text":"Si Ọ, ifẹ ẹni t'o wa,","marked":"Sí Ọ, ìfẹ́ ẹni t'ó wà"},{"start":8.962,"end":10.039,"text":"Ninu Majẹmu Ọlọrun,","marked":"Nínú Májẹ̀mú Ọlọ́run"},{"start":10.489,"end":11.841,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":11.841},{"key":"3","start":12.791,"lines":[{"start":12.791,"end":14.115,"text":"Si Ọ ohun ẹni ti ń pe,","marked":"Sí Ọ ohun ẹni tí ń pè"},{"start":14.565,"end":16.028,"text":"Asako kuro ninu ẹsẹ,","marked":"Àṣàkò kúrò nínú ẹsẹ̀"},{"start":16.478,"end":17.848,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":17.848},{"key":"4","start":18.798,"lines":[{"start":18.798,"end":20.571,"text":"Si Ọ, agbara ẹni ti,","marked":"Sí Ọ, agbára ẹni tí"},{"start":21.021,"end":23.189,"text":"O ń wẹ'ni mo, t'o ń wo'ni san,","marked":"Ó ń wẹ̀'ni mọ́, t'ó ń wọ̀'ni sàn"},{"start":23.639,"end":25.046,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":25.046},{"key":"5","start":25.996,"lines":[{"start":25.996,"end":27.262,"text":"Si Ọ ododo Ẹni ti,","marked":"Sí Ọ òdodo Ẹni tí"},{"start":27.712,"end":28.976,"text":"Gbogbo ileri Rẹ jẹ tiwa,","marked":"Gbogbo ìlérí Rẹ̀ jẹ́ tiwa"},{"start":29.426,"end":30.773,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":30.773},{"key":"6","start":31.723,"lines":[{"start":31.723,"end":33.944,"text":"Si Ọ, Olukọ at'Ọrẹ,","marked":"Sí Ọ, Olùkọ́ àt'Ọ̀rẹ́"},{"start":34.394,"end":36.181,"text":"Amọna wa titi d'opin,","marked":"Amọ̀nà wà títí d'òpin"},{"start":36.631,"end":37.973,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":37.973},{"key":"7","start":38.923,"lines":[{"start":38.923,"end":40.941,"text":"Si Ọ, Ẹni ti Kristi ran,","marked":"Sí Ọ, Ẹni tí Kristi rán"},{"start":41.391,"end":42.851,"text":"f Ade oun gbogbo ẹbun Rẹ,","marked":"f Adé òun gbogbo ẹ̀bùn Rẹ"},{"start":43.301,"end":44.686,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":44.686},{"key":"8","start":45.636,"lines":[{"start":45.636,"end":47.671,"text":"f Si Ọ, Ẹni t'o jẹ ọkan,","marked":"f Sí Ọ, Ẹni t'ó jẹ́ ọkàn"},{"start":48.121,"end":49.657,"text":"Pẹlu Baba ati Ọmọ,","marked":"Pẹ̀lú Baba àti Ọmọ"},{"start":50.107,"end":51.415,"text":"A ń kọ Alleluya.","marked":"À ń kọ́ Allelúyà."}],"end":51.415}]}