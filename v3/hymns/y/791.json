{"v":3,"coll":"y","num":791,"id":"hymn_791","title":"OLORUN lat'ooro d'ale","duration":55.926,"voices":{"male":{"file":"y-791-male-v3.m4a","bytes":389356,"sha256":"000138ad89e244b92676aabfef12a7c6eae485b4efa5318bfccc56654995d3ec","duration":56.0},"female":{"file":"y-791-female-v3.m4a","bytes":402107,"sha256":"87af5f0bf7f2448e8e1e521e0f88313783437338c42c115a07f5008c16251847","duration":56.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.738,"text":"ỌLỌRUN lat'oorọ d'alẹ,","marked":"Ọlọ́run lát'oorọ d'alẹ́"},{"start":2.188,"end":3.688,"text":"Wakati wo lo dun pupọ,","marked":"Wákàtí wo ló dùn púpọ̀"},{"start":4.138,"end":5.375,"text":"B'eyi to pe mi wa'dọ Rẹ,","marked":"B'èyí tó pè mí wá'dọ̀ Rẹ"},{"start":5.825,"end":6.852,"text":"Fun Adura? (2 times).","marked":"Fún Àdúrà? ."}],"end":6.852},{"key":"2","start":7.802,"lines":[{"start":7.802,"end":9.39,"text":"Ibukun n'itura òórọ,","marked":"Ìbùkún n'ìtura òórọ"},{"start":9.84,"end":11.432,"text":"Ibukun si l'oju alẹ;","marked":"Ìbùkún sì l'ojú alẹ́"},{"start":11.882,"end":13.533,"text":"Gbati mo f'adura goke","marked":"Gbátí mo f'àdúrà gòkè"},{"start":13.983,"end":14.907,"text":"Kuro l'ayé.","marked":"Kúrò l'ayé."}],"end":14.907},{"key":"3","start":15.857,"lines":[{"start":15.857,"end":17.552,"text":"'Gbana 'mole kan mo si mi,","marked":"gbàná mọ́lẹ̀ kan mo sí mi"},{"start":18.002,"end":19.455,"text":"O dan ju 'mọlẹ ọrun lọ;","marked":"Ó dán ju 'mọlẹ ọ̀run lọ"},{"start":19.905,"end":21.284,"text":"Iri 'bukun t'ayé ko mọ,","marked":"Ìrì bùkún t'ayé kò mọ"},{"start":21.734,"end":22.739,"text":"T'ọdọ Rẹ wa.","marked":"T'ọ̀dọ̀ Rẹ wà."}],"end":22.739},{"key":"4","start":23.689,"lines":[{"start":23.689,"end":25.159,"text":"Gbana l'agbara mi d'otun","marked":"Gbàná l'agbára mi d'ọ̀tún"},{"start":25.609,"end":26.911,"text":"Gbana l'a f'ese ji mi","marked":"Gbáná l'á f'ẹsẹ̀ jí mi"},{"start":27.361,"end":28.723,"text":"Gbana l'o f'ireti orun","marked":"Gbàná l'ó f'ìrètí ọ̀run"},{"start":29.173,"end":30.142,"text":"M'ara mi ya.","marked":"M'ara mi ya."}],"end":30.142},{"key":"5","start":31.092,"lines":[{"start":31.092,"end":32.324,"text":"Ẹnu ko le sọ ibukun,","marked":"Ẹnu kò lè sọ ìbùkún"},{"start":32.774,"end":34.21,"text":"Ti mo n ri f'aini mi gbogbo;","marked":"Tí mo ń rí f'àìní mi gbogbo"},{"start":34.66,"end":36.956,"text":"Agbara, itunu, ati","marked":"Agbára, ìtùnú, àti"},{"start":37.406,"end":38.288,"text":"Alafia.","marked":"Àlàáfíà."}],"end":38.288},{"key":"6","start":39.238,"lines":[{"start":39.238,"end":40.92,"text":"Eru ati iyemeji tan","marked":"Ẹ̀rù àti iyèméjì tán"},{"start":41.37,"end":42.842,"text":"Okan mi f'orun se ile","marked":"Ọkàn mi f'ọ̀run ṣe ilé"},{"start":43.292,"end":44.505,"text":"Omije 'ronupiwada","marked":"Omijé ronúpìwàdà"},{"start":44.955,"end":45.949,"text":"L'a nu kuro.","marked":"L'á nù kúrò."}],"end":45.949},{"key":"7","start":46.899,"lines":[{"start":46.899,"end":48.367,"text":"Titi n ó de'lẹ 'bukun na,","marked":"Títí n ó dé'lẹ́ bùkún ná"},{"start":48.817,"end":51.187,"text":"Ko s'anfani t'o le dun, bi","marked":"Kò s'àǹfàní t'ó lè dùn, bí"},{"start":51.637,"end":52.959,"text":"Ki n ma tu ọkan mi fun Ọ,","marked":"Kí n má tú ọkàn mi fún Ọ"},{"start":53.409,"end":54.377,"text":"Nin' adura.","marked":"Nín àdúrà."}],"end":54.377}]}