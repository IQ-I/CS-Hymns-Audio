{"v":3,"coll":"y","num":494,"id":"hymn_494","title":"ONISEGUN nla wa nihin","duration":42.286,"voices":{"male":{"file":"y-494-male-v3.m4a","bytes":293752,"sha256":"52e70c4ea60d56a65c218d0abfe4af4b0e44fb08d36a01ccac0939152c5d78ae","duration":42.3},"female":{"file":"y-494-female-v3.m4a","bytes":297038,"sha256":"9b1a9bbb1565089556df26292435a6c83988a6ed1c638e0147f7e86394d4c2b5","duration":42.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.709,"text":"ONISEGUN nla wa nihin","marked":"Oníṣègùn ńlá wà níhìn"},{"start":2.159,"end":3.73,"text":"Jesu A-bani daro","marked":"Jésù A-bani dárò"},{"start":4.18,"end":5.622,"text":"Oro re mu ni l'ara ya","marked":"Ọ̀rọ̀ rẹ̀ mú ni l'ara ya"},{"start":6.072,"end":7.443,"text":"A gbo ohun ti Jesu.","marked":"A gbọ́ ohun tí Jésù."}],"end":7.443},{"key":"CHORUS","start":8.393,"lines":[{"start":8.393,"end":10.124,"text":"Iro didun I'orin Serafu","marked":"Ìró dídùn l'orin Séráfù"},{"start":10.574,"end":12.699,"text":"Oruko didan l'enu enia","marked":"Orúkọ dídán l'ẹnu ẹnià"},{"start":13.149,"end":14.288,"text":"Orin ti o dun julo","marked":"Orin tí ó dùn jùlọ"},{"start":14.738,"end":16.884,"text":"Ni Jesu! Jesu! Jesu!","marked":"Ní Jésù! Jésù! Jésù!"}],"end":16.884},{"key":"2","start":17.834,"lines":[{"start":17.834,"end":19.148,"text":"Oruko Re le eru mi,","marked":"Orúkọ Rẹ lé ẹrú mi"},{"start":19.598,"end":21.114,"text":"Oruko Jesu nikan","marked":"Orúkọ Jésù nìkan"},{"start":21.564,"end":23.108,"text":"B'okan mi ti fe lati gbo","marked":"B'ọkàn mi ti fẹ́ láti gbọ́"},{"start":23.558,"end":24.677,"text":"Oruko Re 'yebiye.","marked":"Orúkọ Rẹ yẹbíyẹ́."}],"end":24.677},{"key":"3","start":25.627,"lines":[{"start":25.627,"end":27.197,"text":"Omode at'agbalagba","marked":"Ọmọdé àt'àgbàlagbà"},{"start":27.647,"end":29.167,"text":"T'o fe oruko Jesu","marked":"T'ó fẹ́ orúkọ Jésù"},{"start":29.617,"end":31.379,"text":"Le gba ipe ore-ofe","marked":"Lè gba ìpè oore-ọ̀fẹ́"},{"start":31.829,"end":33.187,"text":"Lati sise fun Jesu.","marked":"Láti ṣiṣẹ́ fún Jésù."}],"end":33.187},{"key":"4","start":34.137,"lines":[{"start":34.137,"end":35.503,"text":"Nigbat' a ba si de orun","marked":"Nígbàt a bá sì dé ọ̀run"},{"start":35.953,"end":37.344,"text":"Ti a ba si ri Jesu","marked":"Tí a bá sì rí Jésù"},{"start":37.794,"end":39.023,"text":"Ao korin y'ite Re ka","marked":"Àó kọrin y'ìtẹ́ Rẹ̀ ká"},{"start":39.473,"end":40.737,"text":"Orin Oruko Jesu.","marked":"Orin Orúkọ Jésù."}],"end":40.737}]}