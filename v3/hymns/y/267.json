{"v":3,"coll":"y","num":267,"id":"hymn_267","title":"Ise gbogbo ti awa n se","duration":31.614,"voices":{"male":{"file":"y-267-male-v3.m4a","bytes":215428,"sha256":"a7c0e362d18f70120dadc5eb010f8c73b61954edb795090ea6ea234a5e27cbd3","duration":31.7},"female":{"file":"y-267-female-v3.m4a","bytes":222416,"sha256":"d2875260b93bca1737382f4c6666f5f9a87fe83c150843e8425f8444bcdc87de","duration":31.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.889,"text":"Isẹ gbogbo ti awa n se,","marked":"Isẹ́ gbogbo tí àwa ń ṣe"},{"start":2.339,"end":3.532,"text":"Ni Ọlọrun ti ri;","marked":"Ni Ọlọ́run ti rí"},{"start":3.982,"end":5.447,"text":"Ero gbogbo t'o wa ninu,","marked":"Èrò gbogbo t'ó wà nínú"},{"start":5.897,"end":6.989,"text":"Ni Ọlọrun si mọ.","marked":"Ni Ọlọ́run sì mọ́."}],"end":6.989},{"key":"2","start":7.939,"lines":[{"start":7.939,"end":9.35,"text":"A ko le f'ẹsẹ wa pamọ,","marked":"A kò lè f'ẹsẹ̀ wa pamọ́"},{"start":9.8,"end":10.956,"text":"Gbogbo wọn l'O ti mọ;","marked":"Gbogbo wọn l'Ó ti mọ̀"},{"start":11.406,"end":13.399,"text":"A n purọ, a n tan 'ra wa jẹ,","marked":"A ń purọ́, à ń tan ra wa jẹ́"},{"start":13.849,"end":15.177,"text":"B'a ro pe ko mọ wọn.","marked":"B'á rò pé kò mọ̀ wọ́n."}],"end":15.177},{"key":"3","start":16.127,"lines":[{"start":16.127,"end":17.456,"text":"Ohun gbogbo han ni gbangban,","marked":"Ohun gbogbo hàn ní gbangban"},{"start":17.906,"end":18.8,"text":"Ni oju Ọlọrun;","marked":"Ní ojú Ọlọ́run"},{"start":19.25,"end":20.617,"text":"Okunkun ati imọlẹ,","marked":"Òkùnkùn àti ìmọ́lẹ̀"},{"start":21.067,"end":22.579,"text":"Si ri bakan naa fun.","marked":"Sì rí bákan náà fún."}],"end":22.579},{"key":"4","start":23.529,"lines":[{"start":23.529,"end":24.92,"text":"Ọlọrun, jẹ k'a ranti pe,","marked":"Ọlọ́run, jẹ́ k'á rántí pé"},{"start":25.37,"end":26.351,"text":"Oju rẹ si ri wa;","marked":"Ojú rẹ̀ sì rí wa"},{"start":26.801,"end":28.19,"text":"Si jẹ ki awa k'o bẹru,","marked":"Sì jẹ́ kí àwa k'ó bẹ̀rù"},{"start":28.64,"end":30.064,"text":"Lati dẹsẹ si Ọ.","marked":"Láti dẹ́sẹ̀ sí Ọ."}],"end":30.064}]}