{"v":3,"coll":"y","num":537,"id":"hymn_537","title":"Fun mi n'iwa mimo","duration":39.516,"voices":{"male":{"file":"y-537-male-v3.m4a","bytes":281453,"sha256":"f5e0a8727918618fae80488192a49f723d809f4ec7d3118b990c962b8ee41db5","duration":39.6},"female":{"file":"y-537-female-v3.m4a","bytes":290832,"sha256":"6b501554c90bacf5d5a0aa9ae97c95ff7433f6a6d3f7ed9f6441c5b1cb2aaa7a","duration":39.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.245,"text":"FUN mi n'iwa mimọ;","marked":"Fún mi n'ìwà mímọ́"},{"start":1.695,"end":2.662,"text":"Igbona ọkan;","marked":"Ìgbóná ọkàn"},{"start":3.112,"end":6.007,"text":"Suuru ninu iya; aro fun ẹsẹ;","marked":"Sùúrù nínú ìyá; arọ fún ẹsẹ̀"},{"start":6.457,"end":9.616,"text":"Igbagbọ n'nu Jesu: ki n mọ 'tọju Rẹ;","marked":"Ìgbàgbọ́ n'nú Jésù: kí n mọ̀ 'tọju Rẹ"},{"start":10.066,"end":12.519,"text":"Ayọ n'nu isin Rẹ; ẹmi adura.","marked":"Ayọ̀ n'nú ìsìn Rẹ̀; ẹ̀mí àdúrà."}],"end":12.519},{"key":"2","start":13.469,"lines":[{"start":13.469,"end":14.55,"text":"Fun mi l'ọkan ọpẹ;","marked":"Fún mi l'ọkàn ọpẹ́"},{"start":15.0,"end":15.898,"text":"Igbẹkẹle Krist'","marked":"Ìgbẹ́kẹ̀lé Krist"},{"start":16.348,"end":18.824,"text":"Itara f'ogo Rẹ; 'reti n'n 'ọrọ Rẹ;","marked":"Ìtara f'ògo Rẹ̀; retí n'ń 'ọrọ Rẹ̀"},{"start":19.274,"end":21.723,"text":"Ẹkun fun iya Rẹ; rora f'ọgbẹ Rẹ","marked":"Ẹkún fún ìyá Rẹ̀; rọra f'ọgbẹ́ Rẹ̀"},{"start":22.173,"end":24.746,"text":"Irẹlẹ n'nu 'danwo; iyin fun 'ranwọ.","marked":"Ìrẹ̀lẹ̀ n'nú dánwò; ìyìn fún 'ranwọ."}],"end":24.746},{"key":"3","start":25.696,"lines":[{"start":25.696,"end":27.027,"text":"Fun mi n'iwa funfun","marked":"Fún mi n'ìwà funfun"},{"start":27.477,"end":28.5,"text":"fun mi n'isegun","marked":"fún mi n'ìṣẹ́gun"},{"start":28.95,"end":29.906,"text":"We abawon mi nu;","marked":"Wẹ àbàwọ́n mi nù"},{"start":30.356,"end":31.132,"text":"fa 'fe mi","marked":"fa fẹ́ mi"},{"start":31.582,"end":34.005,"text":"s'orun Mu mi ye 'joba Re, ki n wulo","marked":"s'ọ̀run Mú mi yẹ jọba Rẹ, kí n wúlò"},{"start":34.455,"end":36.328,"text":"fun O Ki n j'alabukun fun,","marked":"fún Ọ Kí ń j'alábùkún fún"},{"start":36.778,"end":37.967,"text":"ki n dabi Jesu.","marked":"kí n dàbí Jésù."}],"end":37.967}]}