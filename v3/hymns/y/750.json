{"v":3,"coll":"y","num":750,"id":"hymn_750","title":"O sun, ni Jesu wi","duration":55.768,"voices":{"male":{"file":"y-750-male-v3.m4a","bytes":387552,"sha256":"bcd12831cd924f88c69ada9a9b7a7e31d8af1471ed5694e1993dd385b322cbbb","duration":55.8},"female":{"file":"y-750-female-v3.m4a","bytes":398240,"sha256":"5534d1fff4af38f3dd6cf9df7f557ef198a3819ed2bcecefc19cc16a7c4ef828","duration":55.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.836,"text":"O SUN, ni Jesu wi,","marked":"Ó Sùn, ni Jésù wí"},{"start":2.286,"end":3.439,"text":"Nigba ti Lasaru,","marked":"Nígbà tí Lasaru"},{"start":3.889,"end":5.641,"text":"Ẹni t'o ku, ti a ti sin,","marked":"Ẹni t'ó kú, tí a ti sìn"},{"start":6.091,"end":7.387,"text":"T'a ti tẹ s'iboji.","marked":"T'á ti tẹ̀ s'ibojì."}],"end":7.387},{"key":"2","start":8.337,"lines":[{"start":8.337,"end":9.279,"text":"Oku ọjọ mẹrin,","marked":"Òkú ọjọ́ mẹ́rin"},{"start":9.729,"end":11.16,"text":"Sun ni, loju Jesu;","marked":"Sùn ni, lójú Jésù"},{"start":11.61,"end":13.112,"text":"Oun l'Ajinde ati Iye,","marked":"Òun l'Àjíǹde àti Iye"},{"start":13.562,"end":15.03,"text":"Fun awọn t'o gbagbọ.","marked":"Fún àwọn t'ó gbàgbọ́."}],"end":15.03},{"key":"3","start":15.98,"lines":[{"start":15.98,"end":17.306,"text":"Ọrẹ Jesu ki ku,","marked":"Ọrẹ Jésù kì kú"},{"start":17.756,"end":18.983,"text":"Wọn a ma parada,","marked":"Wọn a má paradà"},{"start":19.433,"end":20.727,"text":"Kuro ni kokoro ilẹ,","marked":"Kúrò ní kòkòrò ilẹ̀"},{"start":21.177,"end":22.499,"text":"S'ohun ti n fo l'oke","marked":"S'ohun tí ń fò l'òkè"}],"end":22.499},{"key":"4","start":23.449,"lines":[{"start":23.449,"end":25.269,"text":"di Sun, ara, olufẹ,","marked":"di Sun, ará, olùfẹ́"},{"start":25.719,"end":27.068,"text":"Jesu duro ti ọ,","marked":"Jésù dúró tì ọ́"},{"start":27.518,"end":29.458,"text":"Ma foya, o ti seleri,","marked":"Má fòyà, ó ti ṣèlérí"},{"start":29.908,"end":31.287,"text":"Ajinde f'ẹni Re.","marked":"Àjíǹde f'ẹni Rẹ."}],"end":31.287},{"key":"5","start":32.237,"lines":[{"start":32.237,"end":33.491,"text":"O fere gb'ohun na","marked":"Ó fẹ́rẹ́ gb'ohun ná"},{"start":33.941,"end":35.027,"text":"Lat'oju orun re","marked":"Lát'ojú ọ̀run rẹ̀"},{"start":35.477,"end":37.044,"text":"Ohun didun Jesu ti y'o","marked":"Ohun dídùn Jésù ti y'ọ́"},{"start":37.494,"end":38.793,"text":"Pe o si ajinde.","marked":"Pé ó sí àjíǹde."}],"end":38.793},{"key":"6","start":39.743,"lines":[{"start":39.743,"end":40.953,"text":"A ko ni barajẹ,","marked":"A kò ní bàràjẹ́"},{"start":41.403,"end":42.594,"text":"Bi alainireti,","marked":"Bí aláìnírètí"},{"start":43.044,"end":45.168,"text":"O d'owurọ l'a o ki o,","marked":"Ó d'òwúrọ̀ l'á ọ kí o"},{"start":45.618,"end":46.421,"text":"Sunre Sun re.","marked":"Sùnrẹ̀ Sùn rẹ̀."}],"end":46.421},{"key":"7","start":47.371,"lines":[{"start":47.371,"end":48.57,"text":"Awa pẹlu y'o sun,","marked":"Àwa pẹ̀lú y'ó sùn"},{"start":49.02,"end":50.271,"text":"Ni akoko tiwa;","marked":"Ní àkókò tiwa"},{"start":50.721,"end":52.727,"text":"A! k'ilẹ mọ ba gbogbo wa,","marked":"A! k'ilẹ̀ mọ́ bá gbogbo wa"},{"start":53.177,"end":54.219,"text":"L'ẹsẹ Olugbala.","marked":"L'ẹsẹ̀ Olùgbàlà."}],"end":54.219}]}