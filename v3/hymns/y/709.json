{"v":3,"coll":"y","num":709,"id":"hymn_709","title":"A dupe Oluwa","duration":61.958,"voices":{"male":{"file":"y-709-male-v3.m4a","bytes":427251,"sha256":"9a39b8a3992b94e836facdbb45f0b0b765c3f37b9f1e20923dcfe1ca50534d4f","duration":62.0},"female":{"file":"y-709-female-v3.m4a","bytes":444563,"sha256":"edce562381fbd9c5bef1e8d8662c026fae5fa4fae8595e468150524afdfc866d","duration":62.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.321,"text":"A dupe Oluwa","marked":"A dúpẹ́ Olúwa"},{"start":1.771,"end":3.023,"text":"F'ajodun oni","marked":"F'àjọ̀dún òní"},{"start":3.473,"end":4.646,"text":"O da emi wa si","marked":"Ó dá ẹ̀mí wá sí"},{"start":5.096,"end":6.089,"text":"Ogo f'oko Re","marked":"Ògo f'ọkọ Rẹ"},{"start":6.539,"end":7.523,"text":"Pelu orin ayo","marked":"Pẹ̀lú orin ayọ̀"},{"start":7.973,"end":8.97,"text":"L'a o fi josin","marked":"L'a ó fi jọ́sìn"},{"start":9.42,"end":10.561,"text":"Fun bukun aye wa","marked":"Fún bùkún ayé wa"},{"start":11.011,"end":12.187,"text":"On reti orun.","marked":"Òn retí ọ̀run."}],"end":12.187},{"key":"CHORUS","start":13.137,"lines":[{"start":13.137,"end":14.969,"text":"Ajodun de, e yo","marked":"Àjọ̀dún dé, ẹ yọ̀"},{"start":15.419,"end":16.476,"text":"Ke, AIeluya","marked":"Ké, Alelúyà"},{"start":16.926,"end":17.995,"text":"A m 'ore ope wa","marked":"A m ọrẹ ọpẹ́ wa"},{"start":18.445,"end":19.532,"text":"Tewo gb'ore wa.","marked":"Tẹ́wọ́ gb'ọrẹ wa."}],"end":19.532},{"key":"2","start":20.482,"lines":[{"start":20.482,"end":21.564,"text":"Opo l'elegbe wa","marked":"Ọ̀pọ̀ l'ẹlẹgbẹ́ wa"},{"start":22.014,"end":23.048,"text":"Ni ko tun si mo","marked":"Ni kò tún sí mọ́"},{"start":23.498,"end":24.842,"text":"Opo ti sako lo","marked":"Ọ̀pọ̀ ti ṣáko lọ"},{"start":25.292,"end":26.092,"text":"Kuro lodo Krist","marked":"Kúrò lọ́dọ̀ Krist"},{"start":26.542,"end":27.57,"text":"A dupe Oluwa","marked":"A dúpẹ́ Olúwa"},{"start":28.02,"end":29.177,"text":"Pe O da wa si","marked":"Pé Ó dá wa sí"},{"start":29.627,"end":30.901,"text":"O si tun ka wa ye","marked":"Ó sì tún kà wá yẹ"},{"start":31.351,"end":32.55,"text":"F'ajodun oni.","marked":"F'àjọ̀dún òní."}],"end":32.55},{"key":"3","start":33.5,"lines":[{"start":33.5,"end":34.543,"text":"Baba wa li orun","marked":"Baba wa lí ọ̀run"},{"start":34.993,"end":36.027,"text":"Awa se pinu","marked":"Àwa ṣe pínú"},{"start":36.477,"end":37.675,"text":"Pe ao sin Jesu","marked":"Pé àó sin Jésù"},{"start":38.125,"end":39.084,"text":"L'ojo aye wa","marked":"L'ọjọ́ ayé wà"},{"start":39.534,"end":40.884,"text":"A o sise fun dagba","marked":"A ó ṣiṣẹ́ fún dàgbà"},{"start":41.334,"end":42.498,"text":"Soke ijo wa","marked":"Sókè ìjọ wa"},{"start":42.948,"end":44.384,"text":"Tit' ao fi je 'pe Re","marked":"Tít àó fi jẹ́ pé Rẹ"},{"start":44.834,"end":46.178,"text":"Fun 'simi orun.","marked":"Fún ṣímí ọ̀run."}],"end":46.178},{"key":"4","start":47.128,"lines":[{"start":47.128,"end":48.244,"text":"Wo Oluw'ajodun","marked":"Wo Olúw'àjọ̀dún"},{"start":48.694,"end":49.678,"text":"A f'ope fun O","marked":"A f'ọpẹ́ fún Ọ"},{"start":50.128,"end":51.601,"text":"Je k'ire ajodun","marked":"Jẹ́ k'ìre àjọ̀dún"},{"start":52.051,"end":53.034,"text":"kari gbogbo wa","marked":"kárí gbogbo wa"},{"start":53.484,"end":54.8,"text":"A be O, Olorun","marked":"A bẹ̀ Ọ́, Ọlọ́run"},{"start":55.25,"end":56.168,"text":"Fun wa l'agbara","marked":"Fún wa l'agbára"},{"start":56.618,"end":57.969,"text":"Lati sin O d'opin","marked":"Láti sin Ó d'òpin"},{"start":58.419,"end":59.349,"text":"Ojo aye wa.","marked":"Ọjọ́ ayé wà."},{"start":59.799,"end":60.409,"text":"Amin.","marked":"Àmín."}],"end":60.409}]}