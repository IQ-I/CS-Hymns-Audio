{"v":3,"coll":"y","num":244,"id":"hymn_244","title":"OKAN mi sunme te anu","duration":38.831,"voices":{"male":{"file":"y-244-male-v3.m4a","bytes":263175,"sha256":"53d7211f2c1f75cfef419d0551f173a5a57295cb24fe11626cc1baebe31ffe03","duration":38.9},"female":{"file":"y-244-female-v3.m4a","bytes":275445,"sha256":"8c9f9b39987c6024f33399981fafe2ef9c01d7efa47b472569ac44344ce9cc12","duration":38.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.609,"text":"ỌKAN mi sunmọ tẹ anu,","marked":"Ọkàn mi súnmọ́ tẹ àánú"},{"start":2.059,"end":3.331,"text":"Nibi Jesu n gb‘ẹbẹ;","marked":"Níbi Jésù ń gb'ẹ̀bẹ̀"},{"start":3.781,"end":5.333,"text":"F‘irẹlẹ wolẹ l‘ẹsẹ Rẹ,","marked":"F'ìrẹ̀lẹ̀ wólẹ̀ l'ẹsẹ̀ Rẹ"},{"start":5.783,"end":7.117,"text":"Wọ ko le gbe nibẹ.","marked":"Wọ kò lè gbé níbẹ̀."}],"end":7.117},{"key":"2","start":8.067,"lines":[{"start":8.067,"end":9.354,"text":"Ileri Rẹ ni ẹbẹ mi,","marked":"Ìlérí Rẹ̀ ni ẹ̀bẹ̀ mi"},{"start":9.804,"end":10.787,"text":"Eyi ni mo mu wa;","marked":"Èyí ni mo mú wá"},{"start":11.237,"end":12.727,"text":"Iwọ n pe ọkan t‘ẹru npa,","marked":"Ìwọ ń pe ọkàn t'ẹrú ńpa"},{"start":13.177,"end":14.325,"text":"Bi emi Oluwa.","marked":"Bí ẹ̀mí Olúwa."}],"end":14.325},{"key":"3","start":15.275,"lines":[{"start":15.275,"end":16.66,"text":"Ẹru ẹsẹ wọ mi l‘ọrun,","marked":"Ẹ̀rù ẹsẹ̀ wọ̀ mí l'ọ̀run"},{"start":17.11,"end":18.274,"text":"Ẹsẹ n sẹ mi n‘isẹ;","marked":"Ẹsẹ̀ ń sẹ́ mí n'isẹ́"},{"start":18.724,"end":20.509,"text":"Ogun l‘ode, ẹru ninu,","marked":"Ogun l'òde, ẹ̀rù nínú"},{"start":20.959,"end":22.312,"text":"Mo wa isinmi mi.","marked":"Mo wá ìsinmi mi."}],"end":22.312},{"key":"4","start":23.262,"lines":[{"start":23.262,"end":24.961,"text":"Se Apata at‘Asa mi,","marked":"Ṣe Àpáta àt'àṣà mi"},{"start":25.411,"end":26.49,"text":"Ki n fi Ọ se abo;","marked":"Kí n fi Ọ́ ṣe abo"},{"start":26.94,"end":28.518,"text":"Ki n doju ti Olufisun,","marked":"Kí n dojú ti Olùfisùn"},{"start":28.968,"end":30.441,"text":"Ki n sọ pe Kristi ku.","marked":"Kí n sọ pé Kristi kú."}],"end":30.441},{"key":"5","start":31.391,"lines":[{"start":31.391,"end":33.065,"text":"Ife Iyanu! Iwo ku","marked":"Ìfẹ́ Ìyanu! Ìwọ kú"},{"start":33.515,"end":34.651,"text":"Ki elese b'iru","marked":"Kí ẹlẹ́ṣẹ̀ b'irú"},{"start":35.101,"end":36.355,"text":"emi Le be l‘orukọ","marked":"èmi Lè bẹ̀ l'orúkọ"},{"start":36.805,"end":37.281,"text":"Re.","marked":"Rẹ."}],"end":37.281}]}