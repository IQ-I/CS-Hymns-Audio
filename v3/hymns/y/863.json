{"v":3,"coll":"y","num":863,"id":"hymn_863","title":"OMO'GUN Kristi, e dide","duration":38.94,"voices":{"male":{"file":"y-863-male-v3.m4a","bytes":276947,"sha256":"d602a812617045e68adadcd9056a3c91e9975b35bcaf9c298164bcbf9fe0337e","duration":39.0},"female":{"file":"y-863-female-v3.m4a","bytes":284080,"sha256":"c2f9ff4592aaca6189882bf850c81721a52f27a9110f2066033ff07dc87eacdc","duration":39.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.713,"text":"OMO'GUN Kristi, e dide","marked":"Ọmọ'gun Kristi, ẹ dìde"},{"start":3.163,"end":4.779,"text":"So f'araiye p'Oluwa mbo","marked":"Sọ f'aráìyè p'Olúwa mbọ̀"},{"start":5.229,"end":6.892,"text":"E busayo k'e si ho ye","marked":"Ẹ bùsayọ̀ k'é sì hó yẹ"},{"start":7.342,"end":8.78,"text":"K'e f'orin pade Oluwa.","marked":"K'é f'orin pàdé Olúwa."}],"end":8.78},{"key":"CHORUS","start":9.73,"lines":[{"start":9.73,"end":12.422,"text":"O mbo, O mbo, O fere de","marked":"Ó mbọ̀, Ó mbọ̀, Ó fẹ́rẹ̀ dé"},{"start":12.872,"end":14.15,"text":"Oluwa mbo l'awonsanma","marked":"Olúwa mbọ́ l'àwọnsánmà"},{"start":14.6,"end":17.029,"text":"O mbo, O mbo, O fere de","marked":"Ó mbọ̀, Ó mbọ̀, Ó fẹ́rẹ̀ dé"},{"start":17.479,"end":19.043,"text":"Oluwa mbo l'awonsanmo.","marked":"Olúwa mbọ́ l'àwọnsánmọ̀."}],"end":19.043},{"key":"2","start":19.993,"lines":[{"start":19.993,"end":21.365,"text":"Oluwa s'ohun nla fun wa","marked":"Olúwa s'ohun ńlá fún wa"},{"start":21.815,"end":23.955,"text":"Nitorina, e jek'a yo","marked":"Nítorínà, ẹ jẹ́k'á yọ"},{"start":24.405,"end":26.271,"text":"Ajodun t'oni to ba wa","marked":"Àjọ̀dún t'òní tó bá wà"},{"start":26.721,"end":28.162,"text":"Ope lo ye fun Jehovah.","marked":"Ọpẹ́ ló yẹ fún Jehovah."}],"end":28.162},{"key":"3","start":29.112,"lines":[{"start":29.112,"end":30.713,"text":"Omo'gun Kristi e mura","marked":"Ọmọ'gún Kristi ẹ múra"},{"start":31.163,"end":32.6,"text":"De bibo Jesu Oluwa","marked":"Dé bíbọ̀ Jésù Olúwa"},{"start":33.05,"end":34.424,"text":"Oluwa mbo bakanna ko","marked":"Olúwa mbọ́ bákanná kọ"},{"start":34.874,"end":36.318,"text":"Bi o ti wa n'irele ri.","marked":"Bí ó ti wá n'ìrẹ̀lẹ̀ rí."},{"start":36.768,"end":37.391,"text":"Amin.","marked":"Àmín."}],"end":37.391}]}