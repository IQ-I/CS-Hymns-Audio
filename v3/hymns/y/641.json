{"v":3,"coll":"y","num":641,"id":"hymn_641","title":"F'ore-ofe Re ba wa gbe","duration":46.05,"voices":{"male":{"file":"y-641-male-v3.m4a","bytes":316912,"sha256":"ab4a4f470bda6a4fcc42749375107d9cf712ccb68dd6c199e681abb30532cb1f","duration":46.1},"female":{"file":"y-641-female-v3.m4a","bytes":326863,"sha256":"4648209294770bdcb787ba884095f465176cfb89ee72b2fd3879fb0a5b7a0546","duration":46.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.767,"text":"F'ORE-ọfẹ Rẹ ba wa gbe,","marked":"F'Ore-ọfẹ Rẹ bá wa gbé"},{"start":2.217,"end":3.362,"text":"Jesu Olugbala;","marked":"Jésù Olùgbàlà"},{"start":3.812,"end":4.957,"text":"Ki ẹni arekereke,","marked":"Kí ẹni àrékérekè"},{"start":5.407,"end":6.852,"text":"K'o ma le koju wa.","marked":"K'ó má lè kojú wá."}],"end":6.852},{"key":"2","start":7.802,"lines":[{"start":7.802,"end":9.166,"text":"F'ọrọ mimọ Rẹ ba wa gbe,","marked":"F'ọ̀rọ̀ mímọ́ Rẹ bá wa gbé"},{"start":9.616,"end":10.918,"text":"Jesu iyebiye:","marked":"Jésù iyebíye"},{"start":11.368,"end":12.735,"text":"K'a ri igbala oun iye,","marked":"K'á rí ìgbàlà òun ìyè"},{"start":13.185,"end":14.194,"text":"Lọhun bi nihinyi.","marked":"Lọ́hùn bí níhìnyí."}],"end":14.194},{"key":"3","start":15.144,"lines":[{"start":15.144,"end":16.541,"text":"Fi 'bukun Tirẹ ba wa gbe,","marked":"Fi bùkún Tirẹ̀ bá wa gbé"},{"start":16.991,"end":17.878,"text":"Oluwa Olore;","marked":"Olúwa Ọlọ́rẹ̀"},{"start":18.328,"end":19.564,"text":"Fi ẹbun ọrun rere Rẹ,","marked":"Fi ẹ̀bùn ọ̀run rere Rẹ"},{"start":20.014,"end":21.274,"text":"Fun wa l'ọpọlọpọ.","marked":"Fún wa l'ọ̀pọ̀lọpọ̀."}],"end":21.274},{"key":"4","start":22.224,"lines":[{"start":22.224,"end":23.783,"text":"Fi 'pamọ Tirẹ ba wa gbe,","marked":"Fi 'pamọ Tirẹ̀ bá wa gbé"},{"start":24.233,"end":25.188,"text":"Iwọ Alagbara;","marked":"Ìwọ Alágbára"},{"start":25.638,"end":27.377,"text":"K'awa k'o le sa ọta ti,","marked":"K'àwa k'ó lè ṣá ọ̀tá tì"},{"start":27.827,"end":29.184,"text":"K'ayé k'o ma de wa.","marked":"K'ayé k'ó má dé wa."}],"end":29.184},{"key":"5","start":30.134,"lines":[{"start":30.134,"end":31.488,"text":"Fi otito Re ba wa gbe","marked":"Fi òtítọ́ Rẹ bá wa gbé"},{"start":31.938,"end":32.841,"text":"Olorun Olore","marked":"Ọlọ́run Ọlọ́rẹ́"},{"start":33.291,"end":34.638,"text":"Ninu ponju wa ba wa re","marked":"Nínú pọ́njú wa bá wá rẹ"},{"start":35.088,"end":36.298,"text":"Mu wa fi ori ti.","marked":"Mú wa fi orí tì."}],"end":36.298},{"key":"6","start":37.248,"lines":[{"start":37.248,"end":38.53,"text":"F'alafia Rẹ ba wa gbe,","marked":"F'àlàáfíà Rẹ bá wa gbé"},{"start":38.98,"end":40.322,"text":"Nigba t'iku ba de ;","marked":"Nígbà t'ikú bá dé"},{"start":40.772,"end":42.706,"text":"N'isẹju na, sọ fun wa pe,","marked":"N'ìsẹ́jú ná, sọ fún wa pé"},{"start":43.156,"end":44.501,"text":"Igbala yin ti de.","marked":"Ìgbàlà yín ti dé."}],"end":44.501}]}