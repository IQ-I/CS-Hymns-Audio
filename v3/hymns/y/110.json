{"v":3,"coll":"y","num":110,"id":"hymn_110","title":"GBOGBO omo egbe Serafu","duration":41.264,"voices":{"male":{"file":"y-110-male-v3.m4a","bytes":287360,"sha256":"ece531cfcaba982442695040230ea10d45977ec98e0411d67a392ede546cc2cf","duration":41.3},"female":{"file":"y-110-female-v3.m4a","bytes":297770,"sha256":"a71625424dce6f9d4fb7925310e876a09e25e46f43f89ed7dbc6ceec8fb3303b","duration":41.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.974,"text":"GBOGB' ọmọ ẹgbẹ Séráfù,","marked":"Gbogb ọmọ ẹgbẹ́ Séráfù"},{"start":2.424,"end":3.756,"text":"Ati Kérúbù l'ayé,","marked":"Àti Kérúbù l'ayé"},{"start":4.206,"end":6.076,"text":"K'ẹ da'lu ati 'jo yin pọ,","marked":"K'ẹ dà'lù àti jọ yín pọ̀"},{"start":6.526,"end":7.779,"text":"K'ẹ si yin Ọba-Ogo.","marked":"K'ẹ́ sì yin Ọba-Ogo."},{"start":8.229,"end":9.841,"text":"Yin Oluwa, yin l'ẹgbẹgbẹ,","marked":"Yín Olúwa, yín l'ẹgbẹgbẹ́"},{"start":10.291,"end":11.607,"text":"Yin Oluwa lọkọọkan,","marked":"Yín Olúwa lọ́kọ̀ọ̀kan"},{"start":12.057,"end":13.101,"text":"Ọba mimọ l'Ọlọrun","marked":"Ọba mímọ́ l'Ọlọ́run"},{"start":13.551,"end":14.849,"text":"Yin Oluwa 'wọ ọkan mi.","marked":"Yín Olúwa 'wọ ọkàn mi."}],"end":14.849},{"key":"2","start":15.799,"lines":[{"start":15.799,"end":17.508,"text":"Larin wahala ati 'ja,","marked":"Lárin wàhálà àti jà"},{"start":17.958,"end":19.323,"text":"Larin idẹkun esu,","marked":"Lárin ìdẹ̀kùn èṣù"},{"start":19.773,"end":21.299,"text":"Larin isimu at'ẹgan,","marked":"Lárin ìṣímú àt'ẹ̀gàn"},{"start":21.749,"end":23.28,"text":"Ni Séráfù n y'Oluwa.","marked":"Ní Séráfù ń y'Olúwa."}],"end":23.28},{"key":"3","start":24.23,"lines":[{"start":24.23,"end":25.407,"text":"Ọbangiji Ọba Mimọ,","marked":"Ọbangíjì Ọba Mímọ́"},{"start":25.857,"end":27.54,"text":"Ni 'yin at'ọpẹ yẹ fun,","marked":"Ní yín àt'ọpẹ́ yẹ fún"},{"start":27.99,"end":29.366,"text":"K'a mu kèéta gbogbo kuro,","marked":"K'á mú kèéta gbogbo kúrò"},{"start":29.816,"end":31.212,"text":"K'a le gb'ade irawọ.","marked":"K'á lè gb'adé ìràwọ̀."}],"end":31.212},{"key":"4","start":32.162,"lines":[{"start":32.162,"end":33.714,"text":"Baba Ogo dariji wa,","marked":"Baba Ògo dáríjì wá"},{"start":34.164,"end":35.245,"text":"Omo Mimo da wa si,","marked":"Ọmọ Mímọ́ dá wa sí"},{"start":35.695,"end":36.712,"text":"Emi Mimo radọ bo","marked":"Ẹ̀mí Mímọ́ rádọ̀ bọ́"},{"start":37.162,"end":38.706,"text":"wa, K'a si jogun 'te","marked":"wá, K'á sì jogún tẹ́"},{"start":39.156,"end":39.715,"text":"ogo.","marked":"ògo."}],"end":39.715}]}