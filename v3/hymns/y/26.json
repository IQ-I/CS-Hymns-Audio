{"v":3,"coll":"y","num":26,"id":"hymn_26","title":"GBOGBO ara aye","duration":47.833,"voices":{"male":{"file":"y-26-male-v3.m4a","bytes":315519,"sha256":"2c0a1cd70ce1d8bd1de49dd344e0d47594f34f9973fff87c29dca7e4a4015b1e","duration":47.9},"female":{"file":"y-26-female-v3.m4a","bytes":333095,"sha256":"45ab0e7c7da900a7621958216fc385d8d756a7fd1e471d9c2f08a87bbf1fff3a","duration":47.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.286,"text":"GBOGBO ara ayé","marked":"Gbogbo ara ayé"},{"start":1.736,"end":2.79,"text":"T'o wa ninu ese","marked":"T'ó wà nínú ẹ̀ṣẹ̀"},{"start":3.24,"end":4.412,"text":"T'o n b'ọjọ 'sinmi je","marked":"T'ó ń b'ọjọ́ sinmi jẹ́"},{"start":4.862,"end":6.101,"text":"Oluwa ń ke si yin. Ẹgbẹ Kérúbù, Séráfù Sọ farayé p'Oluwa mbọ (2)","marked":"Olúwa ń ké sí yín. Ẹgbẹ́ Kérúbù, Séráfù Sọ farayé p'Olúwa mbọ̀"}],"end":6.101},{"key":"CHORUS","start":7.051,"lines":[{"start":7.051,"end":9.099,"text":"Egbe Kerubu, Serafu","marked":"Ẹgbẹ́ Kérúbù, Séráfù"},{"start":9.549,"end":11.083,"text":"So faraiye p'Oluwa mbo. (2ce)","marked":"Sọ faraiyé p'Olúwa mbọ̀."}],"end":11.083},{"key":"2","start":12.033,"lines":[{"start":12.033,"end":13.145,"text":"Ẹ damure giri,","marked":"Ẹ dàmúrè gírí"},{"start":13.595,"end":15.36,"text":"Kérúbù, Séráfù,","marked":"Kérúbù, Séráfù"},{"start":15.81,"end":17.178,"text":"Ẹ funpe na kikan,","marked":"Ẹ fúnpẹ́ ná kíkan"},{"start":17.628,"end":18.982,"text":"Nipa t'ọjọ 'sinmi.","marked":"Nípa t'ọjọ́ sinmi."}],"end":18.982},{"key":"3","start":19.932,"lines":[{"start":19.932,"end":20.975,"text":"Ẹyin Onigbagbọ,","marked":"Ẹ̀yin Onígbàgbọ́"},{"start":21.425,"end":22.505,"text":"L'awọn Imale ń wo,","marked":"L'àwọn Ìmàlẹ̀ ń wò"},{"start":22.955,"end":24.0,"text":"At'awọn Keferi,","marked":"Àt'àwọn Kèfèrí"},{"start":24.45,"end":25.734,"text":"Nipa t'ọjọ 'sinmi.","marked":"Nípa t'ọjọ́ sinmi."}],"end":25.734},{"key":"4","start":26.684,"lines":[{"start":26.684,"end":27.802,"text":"E mura lati ba,","marked":"Ẹ múra láti bá"},{"start":28.252,"end":29.226,"text":"Oluwa yin laja","marked":"Olúwa yín làjà"},{"start":29.676,"end":30.816,"text":"Mase f'aye silẹ","marked":"Máṣe f'ayé sílẹ̀"},{"start":31.266,"end":32.565,"text":"F'esu lati mi yin","marked":"F'èṣù láti mí yín"}],"end":32.565},{"key":"5","start":33.515,"lines":[{"start":33.515,"end":34.57,"text":"Tọrọ ida Ẹmi,","marked":"Tọrọ idà Ẹ̀mí"},{"start":35.02,"end":36.15,"text":"Lọwọ Ọlọrun rẹ,","marked":"Lọ́wọ́ Ọlọ́run rẹ"},{"start":36.6,"end":37.519,"text":"Pẹlu bata irin","marked":"Pẹ̀lú bàtà irin"},{"start":37.969,"end":39.326,"text":"Lati t'esu mọlẹ.","marked":"Láti t'èṣù mọ́lẹ̀."}],"end":39.326},{"key":"6","start":40.276,"lines":[{"start":40.276,"end":41.414,"text":"Oluwa fun wa se,","marked":"Olúwa fún wa ṣe"},{"start":41.864,"end":43.071,"text":"K'a p'ojo mimo mo","marked":"K'á p'ọjọ́ mímọ́ mọ́"},{"start":43.521,"end":44.54,"text":"Ka le ri igbala","marked":"Ká lè rí ìgbàlà"},{"start":44.99,"end":46.284,"text":"Nikehin ojo wa.","marked":"Níkẹ̀hìn ọjọ́ wa."}],"end":46.284}]}