{"v":3,"coll":"y","num":5,"id":"hymn_5","title":"WA s'adura oro","duration":32.366,"voices":{"male":{"file":"y-5-male.m4a","bytes":230962,"sha256":"8bc1e279ba9c200852bf4da08c95d973c70331bc44372b29c90df6b923e5ee50","duration":32.4},"female":{"file":"y-5-female.m4a","bytes":233968,"sha256":"84fcb86518a814c384c48ad58a3ba3ba801b1fceb8881f43f1eb4a8839f21b88","duration":32.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.463,"text":"WA s'adura oro","marked":"Wá s'àdúrà ọ̀rọ̀"},{"start":1.843,"end":3.315,"text":"Kunle k'a gbadura;","marked":"Kúnlé k'á gbàdúrà"},{"start":3.695,"end":5.336,"text":"Adura ni opa Kristiani,","marked":"Àdúrà ni ọ̀pá Kristiani"},{"start":5.716,"end":6.893,"text":"Lati b'Olorun rin.","marked":"Láti b'Ọlọ́run rìn."}],"end":6.893},{"key":"2","start":7.843,"lines":[{"start":7.843,"end":9.396,"text":"Losan, wole labe","marked":"Lọ́sàn, wọlé lábẹ́"},{"start":9.776,"end":11.385,"text":"Apat' aiyeraiye;","marked":"Apat' aiyérayé"},{"start":11.765,"end":13.286,"text":"Itura ojiji Re dun,","marked":"Ìtura òjijì Rẹ̀ dùn"},{"start":13.666,"end":14.806,"text":"Nigbat' orun ba mu.","marked":"Nígbàt' ọ̀run bá mú."}],"end":14.806},{"key":"3","start":15.756,"lines":[{"start":15.756,"end":16.733,"text":"Je ki gbogbo ile,","marked":"Jẹ́ kí gbogbo ilé"},{"start":17.113,"end":18.583,"text":"Wa gbadura l'ale","marked":"Wá gbàdúrà l'álẹ̀"},{"start":18.963,"end":20.354,"text":"Ki ile wa di t'Olorun,","marked":"Kí ilé wa di t'Ọlọ́run"},{"start":20.734,"end":21.887,"text":"Ati 'bode orun.","marked":"Àti 'bọ́de ọ̀run."}],"end":21.887},{"key":"4","start":22.837,"lines":[{"start":22.837,"end":24.258,"text":"Nigbati od'oganjo","marked":"Nígbàtí od'oganjo"},{"start":24.638,"end":26.009,"text":"Jek'a wi l'emi, pe","marked":"Jek'á wí l'èmi, pé"},{"start":26.389,"end":28.442,"text":"Mo sun, sugbon okan mi ji","marked":"Mo sùn, ṣùgbọ́n ọkàn mi jí"},{"start":28.822,"end":30.104,"text":"Lati ba O sona.","marked":"Láti bá Ọ sọ́nà."},{"start":30.484,"end":30.816,"text":"Amin.","marked":"Àmín."}],"end":30.816}]}