{"v":3,"coll":"y","num":466,"id":"hymn_466","title":"NIPA ife Olugbala","duration":46.244,"voices":{"male":{"file":"y-466-male-v3.m4a","bytes":328292,"sha256":"00b2cd46d21b1ec725e27d5b7dffae2e21a60b2e1b56f77a10bb310575bea3ac","duration":46.3},"female":{"file":"y-466-female-v3.m4a","bytes":347588,"sha256":"f86db8b075630c41b954acf3545e5fb702175dc92f27e9318bdc5ce652882326","duration":46.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.512,"text":"NIPA ifẹ Olugbala,","marked":"Nípa ìfẹ́ Olùgbàlà"},{"start":1.962,"end":3.084,"text":"Ki yoo si nkan;","marked":"Kì yóò sí nǹkan"},{"start":3.534,"end":4.73,"text":"Ojurere Rẹ ki pada,","marked":"Ojúrere Rẹ̀ kí padà"},{"start":5.18,"end":6.343,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":6.793,"end":8.192,"text":"Ọwọn l'ẹjẹ t'o wo wa san;","marked":"Ọwọ́n l'ẹ̀jẹ̀ t'ó wò wá sàn"},{"start":8.642,"end":10.251,"text":"Pipe l'edidi or'-ọfẹ,","marked":"Pípẹ́ l'èdìdì or'-ọfẹ"},{"start":10.701,"end":12.312,"text":"Agbara l'ọwọ t'o gba ni;","marked":"Agbára l'ọwọ́ t'ó gbà ni"},{"start":12.762,"end":13.983,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":13.983},{"key":"2","start":14.933,"lines":[{"start":14.933,"end":16.514,"text":"Bi a wa ninu ipọnju,","marked":"Bí a wà nínú ìpọ́njú"},{"start":16.964,"end":18.205,"text":"Ki yoo si nkan:","marked":"Kì yóò sí nǹkan"},{"start":18.655,"end":19.913,"text":"Igbala kikun ni tiwa,","marked":"Ìgbàlà kíkún ni tiwa"},{"start":20.363,"end":21.616,"text":"Ki yoo si nkan:","marked":"Kì yóò sí nǹkan"},{"start":22.066,"end":23.278,"text":"Igbẹkẹle Ọlọrun dun;","marked":"Ìgbẹ́kẹ̀lé Ọlọ́run dùn"},{"start":23.728,"end":25.06,"text":"Gbigbe inu Krist' l'ere,","marked":"Gbígbé inú Krist l'èrè"},{"start":25.51,"end":27.034,"text":"Ẹmi si n sọ wa di mimọ;","marked":"Ẹ̀mí sì ń sọ wá di mímọ́"},{"start":27.484,"end":28.697,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":28.697},{"key":"3","start":29.647,"lines":[{"start":29.647,"end":31.167,"text":"Ọjọ ọla yoo dara,","marked":"Ọjọ́ ọlá yóò dára"},{"start":31.617,"end":32.912,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":33.362,"end":34.991,"text":"'Gbagbọ le kọrin n'ipọnju,","marked":"'Gbagbọ lè kọrin n'ìpọ́njú"},{"start":35.441,"end":36.703,"text":"Ki yoo si nkan,","marked":"Kì yóò sí nǹkan"},{"start":37.153,"end":38.633,"text":"A gbẹkẹle 'fẹ Baba wa,","marked":"A gbẹ́kẹ̀lé 'fẹ Baba wa"},{"start":39.083,"end":40.679,"text":"Jesu n fun wa l'ohun gbogbo","marked":"Jésù ń fún wa l'ohun gbogbo"},{"start":41.129,"end":43.065,"text":"Ni yiye tabi ni kiku,","marked":"Ní yíyẹ tàbí ní kíkú"},{"start":43.515,"end":44.694,"text":"Ko le si nkan.","marked":"Kò lè sí nǹkan."}],"end":44.694}]}