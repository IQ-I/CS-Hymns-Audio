{"v":3,"coll":"y","num":174,"id":"hymn_174","title":"Ojo ibukun y'o si ro!","duration":55.877,"voices":{"male":{"file":"y-174-male-v3.m4a","bytes":416809,"sha256":"a46c359f2be4dbaccab7301dc755cf496bc631a490b479b6b09b54aa9b9425ba","duration":55.9},"female":{"file":"y-174-female-v3.m4a","bytes":421633,"sha256":"faa6da6503970e0586e7ebda2654fe16a5acfd1c53998e1c6102b2d8f1702a13","duration":55.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.112,"text":"Ojo ibukun y'o si ro!","marked":"Ọjọ́ ìbùkún y'ó sì rọ!"},{"start":2.562,"end":4.022,"text":"Ileri ife l'eyi","marked":"Ìlérí ìfẹ́ l'èyí"},{"start":4.472,"end":5.87,"text":"A o ni itura didun","marked":"A ò ní ìtura dídùn"},{"start":6.32,"end":14.231,"text":"Lat'odo Olugbala. Ojo ibukun, Ojo ibukun l'a ń fẹ, Iri anu ń sẹ yi wa ka, Sugbọn ojo l'a ń tọrọ.","marked":"Lát'ọ̀dọ̀ Olùgbàlà. Ọjọ́ ìbùkún, Ọjọ́ ìbùkún l'á ń fẹ́, Ìrì àánú ń sẹ́ yí wa ká, Sùgbọ́n ọjọ́ l'á ń tọrọ."}],"end":14.231},{"key":"CHORUS","start":15.181,"lines":[{"start":15.181,"end":18.111,"text":"Ojo Ibukun, Ojo ibukun l'a nfe","marked":"Ọjọ́ Ìbùkún, Ọjọ́ ìbùkún l'á ńfẹ́"},{"start":18.561,"end":19.902,"text":"Iri anu nse yi wa ka","marked":"Ìrì àánú ńṣe yí wa ká"},{"start":20.352,"end":22.158,"text":"Sugbon ojo l'a ntoro.","marked":"Ṣùgbọ́n ọjọ́ l'á ńtọrọ."}],"end":22.158},{"key":"2","start":23.108,"lines":[{"start":23.108,"end":25.104,"text":"Ojo ibukun y'o si rọ!‖","marked":"Ọjọ́ ìbùkún y'ó sì rọ!‖"},{"start":25.554,"end":26.681,"text":"Isọji iyebiye;","marked":"Ìsọjí iyebíye"},{"start":27.131,"end":28.691,"text":"Lori oke oun pẹtẹlẹ,","marked":"Lórí òkè òun pẹ̀tẹ́lẹ̀"},{"start":29.141,"end":30.516,"text":"Iro ọpọ ojo mbọ.","marked":"Ìró ọ̀pọ̀ ọjọ́ mbọ́."}],"end":30.516},{"key":"3","start":31.466,"lines":[{"start":31.466,"end":33.382,"text":"'Ojo ibukun y'o si ro","marked":"ọjọ́ ìbùkún y'ó sì rọ"},{"start":33.832,"end":34.973,"text":"Ran won si wa Oluwa","marked":"Rán wọ́n sì wá Olúwa"},{"start":35.423,"end":36.988,"text":"Fun wa ni itura didun","marked":"Fún wa ní ìtura dídùn"},{"start":37.438,"end":38.999,"text":"Wa, f'ola fun oro Re.","marked":"Wá, f'ọlá fún ọ̀rọ̀ Rẹ."}],"end":38.999},{"key":"4","start":39.949,"lines":[{"start":39.949,"end":42.004,"text":"'Ojo ibukun y'o si ro","marked":"ọjọ́ ìbùkún y'ó sì rọ"},{"start":42.454,"end":43.634,"text":"Iba je le ro loni!","marked":"Ìbá jẹ́ lè rò lóní!"},{"start":44.084,"end":45.608,"text":"B'a ti ń jẹwọ f'Olorun","marked":"B'á ti ń jẹ́wọ́ f'Ọlọ́run"},{"start":46.058,"end":54.327,"text":"wa T'a ń pe oruko Jesu. Ojo ibukun, Ojo ibukun l'a ń fẹ, Iri anu ń sẹ yi wa ka, Sugbọn ojo l'a ń tọrọ.","marked":"wá T'á ń pe orúkọ Jésù. Ọjọ́ ìbùkún, Ọjọ́ ìbùkún l'á ń fẹ́, Ìrì àánú ń sẹ́ yí wa ká, Sùgbọ́n ọjọ́ l'á ń tọrọ."}],"end":54.327}]}