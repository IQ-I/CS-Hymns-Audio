{"v":3,"coll":"y","num":370,"id":"hymn_370","title":"LEHIN aye buburu yi","duration":36.522,"voices":{"male":{"file":"y-370-male-v3.m4a","bytes":254534,"sha256":"8a9848e666ff7a4ed75b2d144aeb5eb473feb699cf29676c8cd34715a349ac13","duration":36.6},"female":{"file":"y-370-female-v3.m4a","bytes":264708,"sha256":"3a6f6d866143c6482803894cc6b18d54506e3166f2eae97ae7d1a5c33711f077","duration":36.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.546,"text":"LẸHIN ayé buburu yi,","marked":"Lẹ́hìn ayé búburú yí"},{"start":1.996,"end":3.858,"text":"Ayé ẹkun oun osi yi,","marked":"Ayé ẹkún òun òsì yí"},{"start":4.308,"end":5.311,"text":"Ibi rere kan wa,","marked":"Ibi rere kan wà"},{"start":5.761,"end":7.119,"text":"Ayipada ko si nibẹ,","marked":"Àyípadà kò sí níbẹ̀"},{"start":7.569,"end":9.978,"text":"Ko s'oru af'ọsan titi,","marked":"Kò s'òru àf'ọ̀sán títí"},{"start":10.428,"end":11.745,"text":"Wi mi, 'wọ o wa nibẹ?","marked":"Wí mi, 'wọ ó wà níbẹ̀?"}],"end":11.745},{"key":"2","start":12.695,"lines":[{"start":12.695,"end":14.215,"text":"'Lẹkun ogo rẹ ti m'ẹsẹ,","marked":"'Lẹkun ògo rẹ̀ ti m'ẹsẹ̀"},{"start":14.665,"end":16.231,"text":"Ohun eri ko le wọ'bẹ,","marked":"Ohun ẹ̀rí kò lè wọ'bẹ̀"},{"start":16.681,"end":17.888,"text":"Lati b'ẹwa rẹ jẹ,","marked":"Láti b'ẹwà rẹ̀ jẹ́"},{"start":18.338,"end":19.589,"text":"L'ebute daradara ni,","marked":"L'èbúté dáradára ni"},{"start":20.039,"end":21.343,"text":"A ko ni gburo egun mọ,","marked":"A kò ní gbúrò ègún mọ́"},{"start":21.793,"end":22.955,"text":"Wi mi, 'wọ o wa nibẹ?","marked":"Wí mi, 'wọ ó wà níbẹ̀?"}],"end":22.955},{"key":"3","start":23.905,"lines":[{"start":23.905,"end":25.844,"text":"Tani o de 'bẹ? Onirẹlẹ,","marked":"Tani ó dé 'bẹ? Onírẹ̀lẹ̀"},{"start":26.294,"end":27.501,"text":"To f'ibẹru sin Oluwa,","marked":"Tó f'ìbẹ̀rù sin Olúwa"},{"start":27.951,"end":29.296,"text":"T' wọn ko nani ayé;","marked":"T wọn kò náni ayé"},{"start":29.746,"end":31.23,"text":"Awọn t'a f'Ẹmi Mimọ tọ,","marked":"Àwọn t'a f'Ẹ̀mí Mímọ́ tọ̀"},{"start":31.68,"end":33.215,"text":"Awọn t'o n rin lọ'na toro,","marked":"Àwọn t'ó ń rìn lọ́'nà tòrò"},{"start":33.665,"end":34.973,"text":"Awọn ni o wa nibẹ.","marked":"Àwọn ni ó wà níbẹ̀."}],"end":34.973}]}