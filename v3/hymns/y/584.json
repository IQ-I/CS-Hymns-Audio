{"v":3,"coll":"y","num":584,"id":"hymn_584","title":"MO sinmi le Jesu","duration":48.16,"voices":{"male":{"file":"y-584-male-v3.m4a","bytes":341549,"sha256":"4e2d9f88a2fe48965991d8d72a84429e064ddf4bc6acefb9d475e642631de5f6","duration":48.2},"female":{"file":"y-584-female-v3.m4a","bytes":351017,"sha256":"395fd3acb15d80d488efa12809e97e7a6be0815c2b94f54da453de8e6a18b3ca","duration":48.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.546,"text":"MO sinmi le Jesu,","marked":"Mo sinmi lé Jésù"},{"start":1.996,"end":3.293,"text":"'Wọ ni mo gbẹkẹle,","marked":"'Wọ ni mo gbẹ́kẹ̀lé"},{"start":3.743,"end":5.666,"text":"Mo kun fun ẹsẹ at'osi,","marked":"Mo kún fún ẹsẹ àt'òṣì"},{"start":6.116,"end":7.271,"text":"Tani mba tun tọ lọ?","marked":"Tani mbá tún tọ́ lọ?"},{"start":7.721,"end":9.168,"text":"Ni okan aya Rẹ nikan,","marked":"Ní ọkàn àyà Rẹ nìkan"},{"start":9.618,"end":11.274,"text":"L'ọkan arẹ mi sinmi le.","marked":"L'ọkàn àrẹ mi sinmi le."}],"end":11.274},{"key":"2","start":12.224,"lines":[{"start":12.224,"end":13.147,"text":"Iwọ Ẹni Mimọ!","marked":"Ìwọ Ẹni Mímọ́!"},{"start":13.597,"end":14.872,"text":"Baba sinmi n'nu Rẹ;","marked":"Baba sinmi n'nú Rẹ̀"},{"start":15.322,"end":16.985,"text":"Ẹjẹ etutu ti O ta,","marked":"Ẹ̀jẹ̀ ètùtù tí Ó ta"},{"start":17.435,"end":18.785,"text":"L'o si mbẹbẹ fun mi:","marked":"L'ó sì mbẹ̀bẹ̀ fún mi"},{"start":19.235,"end":21.41,"text":"Egun tan, mo d'alabukun:","marked":"Ègún tán, mo d'alábùkún"},{"start":21.86,"end":23.365,"text":"Mo sinmi ninu Baba mi.","marked":"Mo sinmi nínú Baba mi."}],"end":23.365},{"key":"3","start":24.315,"lines":[{"start":24.315,"end":25.576,"text":"Ẹru ẹsẹ ni mi!","marked":"Ẹ̀rù ẹsẹ̀ ni mí!"},{"start":26.026,"end":27.519,"text":"'Wọ l'o da mi n'ide;","marked":"'Wọ l'ó dá mi n'idẹ"},{"start":27.969,"end":29.493,"text":"Ọkan mi si fẹ lati gba,","marked":"Ọkàn mi sì fẹ́ láti gbà"},{"start":29.943,"end":31.065,"text":"Ajaga Rẹ s'ọrun:","marked":"Àjàgà Rẹ̀ s'ọ̀run"},{"start":31.515,"end":33.091,"text":"Ifẹ Rẹ t'o gba aya mi,","marked":"Ìfẹ́ Rẹ t'ó gba àyà mi"},{"start":33.541,"end":35.17,"text":"Sọ 'sẹ ati lala d'ayọ.","marked":"Sọ 'sẹ àti lala d'ayọ̀."}],"end":35.17},{"key":"4","start":36.12,"lines":[{"start":36.12,"end":37.425,"text":"Opin fẹrẹ de na,","marked":"Òpin fẹ́rẹ̀ dé ná"},{"start":37.875,"end":38.896,"text":"Isinmi ọrun mbọ;","marked":"Ìsinmi ọ̀run mbọ́"},{"start":39.346,"end":41.051,"text":"Ẹsẹ at' irora y'o tan,","marked":"Ẹsẹ̀ àt ìrora y'ó tán"},{"start":41.501,"end":42.791,"text":"Emi o si de 'le:","marked":"Èmi ó sì dé lé"},{"start":43.241,"end":44.7,"text":"N ó jogun ilẹ ileri,","marked":"N ó jogún ilẹ̀ ìlérí"},{"start":45.15,"end":46.61,"text":"Ọkan mi o sinmi lailai.","marked":"Ọkàn mi ò sinmi láéláé."}],"end":46.61}]}