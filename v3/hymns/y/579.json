{"v":3,"coll":"y","num":579,"id":"hymn_579","title":"NINU oru ibanuje","duration":65.403,"voices":{"male":{"file":"y-579-male-v3.m4a","bytes":450518,"sha256":"dd660891d42c09642c603dcc72d89a32447520eb9dd97b05c8b8f695a3957a79","duration":65.5},"female":{"file":"y-579-female-v3.m4a","bytes":464658,"sha256":"9b2927c3146e0ba1f7a74be904ba6a3839710448cc79cea8a96b0ccfce59fa5e","duration":65.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.402,"text":"NINU oru ibanujẹ,","marked":"Nínú òru ìbànújẹ́"},{"start":1.852,"end":3.069,"text":"L'awọn ẹgbẹ ero n rin;","marked":"L'àwọn ẹgbẹ́ èrò ń rìn"},{"start":3.519,"end":5.308,"text":"Wọn n kọrin 'reti at'ayọ,","marked":"Wọ́n ń kọrin retí àt'ayọ̀"},{"start":5.758,"end":7.159,"text":"Wọn n lọ silẹ ileri.","marked":"Wọ́n ń lọ sílẹ̀ ìlérí."}],"end":7.159},{"key":"2","start":8.109,"lines":[{"start":8.109,"end":9.471,"text":"Niwaju wa nin' okunkun,","marked":"Níwájú wà nín òkùnkùn"},{"start":9.921,"end":11.375,"text":"Ni imọlẹ didan n tan;","marked":"Ní ìmọ́lẹ̀ dídán ń tàn"},{"start":11.825,"end":13.207,"text":"Awọn arakunrin n satẹ,","marked":"Àwọn arákùnrin ń sàtẹ̀"},{"start":13.657,"end":15.051,"text":"Wọn n rin lọ ni aifoya.","marked":"Wọ́n ń rìn lọ ní àìfòyà."}],"end":15.051},{"key":"3","start":16.001,"lines":[{"start":16.001,"end":17.133,"text":"Ọkan mi imọlẹ ọrun,","marked":"Ọkàn mi ìmọ́lẹ̀ ọ̀run"},{"start":17.583,"end":18.88,"text":"Ti n tan s'ara eniyan Rẹ;","marked":"Tí ń tan s'ára ènìyàn Rẹ"},{"start":19.33,"end":20.624,"text":"Ti n le gbogbo ẹru jina,","marked":"Tí ń lé gbogbo ẹ̀rù jìnà"},{"start":21.074,"end":22.628,"text":"Ti n dan yi ọna wa ka.","marked":"Tí ń dán yí ọ̀nà wa ká."}],"end":22.628},{"key":"4","start":23.578,"lines":[{"start":23.578,"end":24.888,"text":"Okan ni iro ajo wa","marked":"Ọkàn ni ìró àjọ wà"},{"start":25.338,"end":26.335,"text":"Okan ni igbagbo wa","marked":"Ọkàn ni ìgbàgbọ́ wa"},{"start":26.785,"end":28.248,"text":"Okan l'eni t'a gbekele","marked":"Ọkàn l'ẹni t'á gbẹ́kẹ̀lé"},{"start":28.698,"end":29.857,"text":"Okan ni ireti wa.","marked":"Ọkàn ni ìrètí wà."}],"end":29.857},{"key":"5","start":30.807,"lines":[{"start":30.807,"end":32.213,"text":"Ọkan l'orin t'ẹgbẹrun n kọ,","marked":"Ọkàn l'orin t'ẹgbẹ̀rún ń kọ"},{"start":32.663,"end":33.966,"text":"Bi lati ọkan kan wa,","marked":"Bí láti ọkàn kan wá"},{"start":34.416,"end":36.18,"text":"Ọkan n'ija, ọkan l'ewu,","marked":"Ọkàn n'ìjà, ọkàn l'ewu"},{"start":36.63,"end":38.247,"text":"Ọkan ni irin ọrun.","marked":"Ọkàn ni irin ọ̀run."}],"end":38.247},{"key":"6","start":39.197,"lines":[{"start":39.197,"end":40.608,"text":"Ọkan ni inu didun wa,","marked":"Ọkàn ni inú dídùn wà"},{"start":41.058,"end":42.485,"text":"L'ebute ainipẹkun,","marked":"L'èbúté àìnípẹ̀kun"},{"start":42.935,"end":44.255,"text":"Nibi ti Baba wa ọrun,","marked":"Níbi tí Baba wá ọ̀run"},{"start":44.705,"end":46.229,"text":"Y'o ma jọba titi lai.","marked":"Y'ó má jọba títí láì."}],"end":46.229},{"key":"7","start":47.179,"lines":[{"start":47.179,"end":48.862,"text":"Njẹ k'a ma n sọ arakunrin,","marked":"Ǹjẹ́ k'a má ń sọ arákùnrin"},{"start":49.312,"end":50.667,"text":"T'awa ti agbelebu,","marked":"T'àwa ti àgbélébùú"},{"start":51.117,"end":53.188,"text":"Ẹ jẹ k'a ru, k'a si jiya,","marked":"Ẹ jẹ́ k'á ru, k'á sì jìyà"},{"start":53.638,"end":55.376,"text":"Ti t'a o fi ri 'sinmi.","marked":"Ti t'á ó fi rí sinmi."}],"end":55.376},{"key":"8","start":56.326,"lines":[{"start":56.326,"end":58.036,"text":"Ajinde nla fere de na","marked":"Àjíǹde ńlá fẹ́rẹ̀ dé ná"},{"start":58.486,"end":59.801,"text":"Boji fere si sile","marked":"Bojì fẹ́rẹ̀ sí sílẹ̀"},{"start":60.251,"end":61.916,"text":"Gbogbo okun y'o si tuka","marked":"Gbogbo okùn y'ó sì túká"},{"start":62.366,"end":63.854,"text":"Gbogbo lala y'o si tan.","marked":"Gbogbo làlá y'ó sì tàn."}],"end":63.854}]}