{"v":3,"coll":"y","num":209,"id":"hymn_209","title":"AJIN jin, oru mimo","duration":52.325,"voices":{"male":{"file":"y-209-male-v3.m4a","bytes":377653,"sha256":"5bb5845bf0bf9a1dd212b38e369b1d2408fa3dc7e5b52e7fdedaaa85063acc26","duration":52.4},"female":{"file":"y-209-female-v3.m4a","bytes":390946,"sha256":"894b0913849c8b6e0766b81476409ab754522e58d51fb66f4dc728ea6e5283e6","duration":52.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.084,"text":"AJIN jin, oru mimọ,","marked":"Ajin jìn, òru mímọ́"},{"start":2.534,"end":4.324,"text":"Okun su, 'mọlẹ de,","marked":"Òkun ṣú, 'mọlẹ dé"},{"start":4.774,"end":6.081,"text":"Awọn Olus'aguntan ń sọna,","marked":"Àwọn Olùṣ'àgùntàn ń sọ́nà"},{"start":6.531,"end":8.546,"text":"Ọmọ titun t'o wa l'oju orun.","marked":"Ọmọ titun t'ó wà l'ojú ọ̀run."},{"start":8.996,"end":10.316,"text":"Sinmi n'nu alafia,","marked":"Sinmi n'nú àlàáfíà"},{"start":10.766,"end":12.213,"text":"Sinmi n'nu alafia.","marked":"Sinmi n'nú àlàáfíà."}],"end":12.213},{"key":"2","start":13.163,"lines":[{"start":13.163,"end":15.364,"text":"Ajin jin, oru mimọ,","marked":"Ajin jìn, òru mímọ́"},{"start":15.814,"end":17.958,"text":"Mọlẹ de, okun sa,","marked":"Mọ́lẹ̀ dé, òkun sá"},{"start":18.408,"end":20.034,"text":"Olusọ aguntan gb'orin Angẹli,","marked":"Olùsọ́ àgùntàn gb'orin Áńgẹ́lì"},{"start":20.484,"end":22.365,"text":"Kabiyesi Alleluya Ọba.","marked":"Kabiyesi Allelúyà Ọba."},{"start":22.815,"end":24.185,"text":"Jesu Olugbala de,","marked":"Jésù Olùgbàlà dé"},{"start":24.635,"end":25.968,"text":"Jesu Olugbala de.","marked":"Jésù Olùgbàlà dé."}],"end":25.968},{"key":"3","start":26.918,"lines":[{"start":26.918,"end":28.627,"text":"Ajin jin, oru mimo,","marked":"Ajin jìn, òru mímọ́"},{"start":29.077,"end":30.352,"text":"'Rawo orun tan 'mole,","marked":"rawọ ọ̀run tán mọ́lẹ̀"},{"start":30.802,"end":32.194,"text":"Wo awon Amoye ila orun,","marked":"Wo àwọn Amòye ìlà ọ̀run"},{"start":32.644,"end":34.013,"text":"Mu ore won wa fun Oba wa.","marked":"Mú ọrẹ wọn wá fún Ọba wa."},{"start":34.463,"end":35.892,"text":"Jesu Olugbala de,","marked":"Jésù Olùgbàlà dé"},{"start":36.342,"end":37.713,"text":"Jesu Olugbala de.","marked":"Jésù Olùgbàlà dé."}],"end":37.713},{"key":"4","start":38.663,"lines":[{"start":38.663,"end":40.431,"text":"Ajin jin, oru mimọ,","marked":"Ajin jìn, òru mímọ́"},{"start":40.881,"end":42.518,"text":"'Rawọ, ọrun tan 'mọlẹ,","marked":"'Rawọ, ọ̀run tán 'mọlẹ"},{"start":42.968,"end":44.772,"text":"Ka pẹlu awọn Angẹli kọrin,","marked":"Ká pẹ̀lú àwọn Áńgẹ́lì kọrin"},{"start":45.222,"end":47.203,"text":"Kabiyesi Alleluya Ọba.","marked":"Kabiyesi Allelúyà Ọba."},{"start":47.653,"end":48.958,"text":"Jesu Olugbala de,","marked":"Jésù Olùgbàlà dé"},{"start":49.408,"end":50.775,"text":"Jesu Olugbala de.","marked":"Jésù Olùgbàlà dé."}],"end":50.775}]}