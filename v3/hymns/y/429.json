{"v":3,"coll":"y","num":429,"id":"hymn_429","title":"OLUWA, 'Wo ki o si gba","duration":24.816,"voices":{"male":{"file":"y-429-male-v3.m4a","bytes":168522,"sha256":"0122d71d8b4780664a3e48fb1e65ef4ff65cc50935d25dcfe933aef311602a3f","duration":24.9},"female":{"file":"y-429-female-v3.m4a","bytes":175071,"sha256":"1350c75e8b1e4d5acbe241ff60f1b339d58be5a03bbf5e27492cc44c941d153e","duration":24.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.802,"text":"OLUWA, 'Wọ ki o si gba","marked":"Olúwa, 'Wọ kí o sì gbà"},{"start":2.252,"end":3.355,"text":"Ẹni osi b'emi,","marked":"Ẹni òsì b'èmi"},{"start":3.805,"end":5.051,"text":"K'emi le sunmọ itẹ Rẹ,","marked":"K'èmi lè súnmọ́ ìtẹ́ Rẹ"},{"start":5.501,"end":7.307,"text":"Ki n ke Abba, Baba?","marked":"Kí n ké Abba, Baba?"}],"end":7.307},{"key":"2","start":8.257,"lines":[{"start":8.257,"end":10.509,"text":"Jesu, jowo fi oro Re,","marked":"Jésù, jọ̀wọ́ fi ọ̀rọ̀ Rẹ"},{"start":10.959,"end":12.244,"text":"S'okunkun mi d'osan","marked":"S'òkùnkùn mi d'ọ̀sán"},{"start":12.694,"end":13.936,"text":"Ki gbogbo ayo tun pada","marked":"Kí gbogbo ayọ̀ tún padà"},{"start":14.386,"end":15.727,"text":"Ti mo f'ese gbon nu.","marked":"Tí mo f'ẹsẹ̀ gbọ́n nù."}],"end":15.727},{"key":"3","start":16.677,"lines":[{"start":16.677,"end":18.298,"text":"Oluwa, mo f'iyanu sin,","marked":"Olúwa, mo f'ìyanu sìn"},{"start":18.748,"end":19.712,"text":"Ore Re tobi ju","marked":"Ọrẹ Rẹ̀ tóbi jù"},{"start":20.162,"end":21.392,"text":"Pa mi mo ninu ife Re","marked":"Pa mí mọ́ nínú ìfẹ́ Rẹ"},{"start":21.842,"end":23.266,"text":"K'emi ma d'ese mo.","marked":"K'èmi má d'ẹ̀ṣẹ̀ mọ́."}],"end":23.266}]}