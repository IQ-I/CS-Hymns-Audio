{"v":3,"coll":"y","num":157,"id":"hymn_157","title":"J'ALAGBARA n'nu","duration":61.058,"voices":{"male":{"file":"y-157-male-v3.m4a","bytes":438117,"sha256":"31d3db4ad4b8f55efc127295e1e024a2506e824c9f96848a0aa58c9ddc8f2fee","duration":61.1},"female":{"file":"y-157-female-v3.m4a","bytes":453286,"sha256":"ef005d82bb9f119736675b3da0ecf16289e0bd744cb182cb93e670720020b3fd","duration":61.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.311,"text":"J'ALAGBARA n'nu","marked":"J'Alágbára n'nù"},{"start":1.761,"end":4.165,"text":"Krist, ati pa agbara Re","marked":"Krist, àti pa agbára Rẹ̀"},{"start":4.615,"end":6.569,"text":"Duro sinsin f'otito oro Re","marked":"Dúró ṣinṣin f'òtítọ́ ọ̀rọ̀ Rẹ"},{"start":7.019,"end":8.373,"text":"Y'o mu o koja lo larin","marked":"Y'ó mú ọ kọjá lọ lárin"},{"start":8.823,"end":9.93,"text":"ogun to gbona","marked":"ogun tó gbóná"},{"start":10.38,"end":12.192,"text":"'Wo y'o segun l'Oruko Oluwa,","marked":"wò y'ó ṣẹ́gun l'Orúkọ Olúwa"},{"start":12.642,"end":14.437,"text":"Duro gbonyin, f'otito Lo","marked":"Dúró gbọ̀nyín, f'òtítọ́ Lọ"},{"start":14.887,"end":16.419,"text":"si 'segun ni ase Oba Fun","marked":"sí ṣẹ́gun ni àṣẹ Ọba Fún"},{"start":16.869,"end":18.81,"text":"Ola Oluwa Re ati 'segun","marked":"Ọlá Olúwa Rẹ àti ṣẹ́gun"},{"start":19.26,"end":20.638,"text":"oro Re, Duro","marked":"ọ̀rọ̀ Rẹ, Dúró"},{"start":21.088,"end":22.421,"text":"gbonyin l'agbara Oluwa.","marked":"gbọ̀nyín l'agbára Olúwa."}],"end":22.421},{"key":"CHORUS","start":23.371,"lines":[{"start":23.371,"end":25.162,"text":"Duro gbonyin, f'otito","marked":"Dúró gbọ̀nyín, f'òtítọ́"},{"start":25.612,"end":26.99,"text":"Lo si 'segun Ii ase Oba","marked":"Lọ sí ṣẹ́gun Ìí àṣẹ Ọba"},{"start":27.44,"end":29.105,"text":"Fun Ola Oluwa Re ati","marked":"Fún Ọlá Olúwa Rẹ àti"},{"start":29.555,"end":30.557,"text":"'segun oro Re,","marked":"ṣẹ́gun ọ̀rọ̀ Rẹ"},{"start":31.007,"end":32.746,"text":"Duro gbonyin I'agbara Oluwa.","marked":"Dúró gbọ̀nyín l'agbára Olúwa."}],"end":32.746},{"key":"2","start":33.696,"lines":[{"start":33.696,"end":36.058,"text":"J'alagbara n'nu Krist' ati","marked":"J'alágbára n'nú Krist àti"},{"start":36.508,"end":37.552,"text":"'pa agbara Re.","marked":"pa agbára Rẹ."},{"start":38.002,"end":40.046,"text":"Mase pehinda niwaju ota","marked":"Maṣe pẹ̀hìndà níwájú ọ̀tá"},{"start":40.496,"end":42.689,"text":"Yoo duro ti o b'o ti ń ja fun","marked":"Yóò dúró tí ó b'ó ti ń jà fún"},{"start":43.139,"end":45.459,"text":"Otito Te siwaju n'nu 'pa agbara","marked":"Òtítọ́ Tẹ́ síwájú n'nú pa agbára"},{"start":45.909,"end":46.395,"text":"Re.","marked":"Rẹ."}],"end":46.395},{"key":"3","start":47.345,"lines":[{"start":47.345,"end":48.48,"text":"J'alagbara n'nu Krist'","marked":"J'alágbára n'nú Krist"},{"start":48.93,"end":50.431,"text":"ati 'pa agbara Re,","marked":"àti pa agbára Rẹ̀"},{"start":50.881,"end":53.095,"text":"'Tori 'leri Re ki yoo ye lai","marked":"torí lérí Rẹ̀ kì yóò yẹ láì"},{"start":53.545,"end":54.859,"text":"Yo dowo re mu gbat'o","marked":"Yọ dọ́wọ́ rẹ̀ mú gbàt'ọ́"},{"start":55.309,"end":56.178,"text":"ń ja fun","marked":"ń jà fún"},{"start":56.628,"end":58.376,"text":"otito Gbekele wo o ma segun","marked":"òtítọ́ Gbẹ́kẹ̀lé wò ó má ṣẹ́gun"},{"start":58.826,"end":59.509,"text":"lailai","marked":"láéláé"}],"end":59.509}]}