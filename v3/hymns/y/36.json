{"v":3,"coll":"y","num":36,"id":"hymn_36","title":"NIGBAWO Olugbala mi","duration":33.053,"voices":{"male":{"file":"y-36-male-v3.m4a","bytes":229320,"sha256":"5ea208acea7853a6e7829329b2d57325bfc41b8806df31685647f95e30fd56cb","duration":33.1},"female":{"file":"y-36-female-v3.m4a","bytes":234606,"sha256":"de707d4b47a5c8738ef75b1b41d2a1309943ae09904a6f1da57ee157866debbc","duration":33.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.423,"text":"NIGBAWO Olugbala mi,","marked":"Nígbàwo Olùgbàlà mi"},{"start":1.873,"end":2.996,"text":"L'emi o ri Ọ jẹ?","marked":"L'èmi ó rí Ọ jẹ?"},{"start":3.446,"end":5.076,"text":"N'isinmi t'o ni ibukun,","marked":"N'ìsinmi t'ó ní ìbùkún"},{"start":5.526,"end":6.999,"text":"Laisi 'boju larin.","marked":"Láìsí bojú lárin."}],"end":6.999},{"key":"2","start":7.949,"lines":[{"start":7.949,"end":9.188,"text":"Ran mi lọwọ n'irinkiri,","marked":"Ràn mí lọ́wọ́ n'ìrìnkiri"},{"start":9.638,"end":11.07,"text":"L'ayé aniyan yi;","marked":"L'ayé àníyàn yí"},{"start":11.52,"end":13.149,"text":"Se mi ki n fi 'fẹ gbadura,","marked":"Ṣé mi kí n fi 'fẹ gbàdúrà"},{"start":13.599,"end":14.982,"text":"Si gba adura mi.","marked":"Sì gba àdúrà mi."}],"end":14.982},{"key":"3","start":15.932,"lines":[{"start":15.932,"end":18.032,"text":"Da mi si, Baba, da mi si","marked":"Dá mi sí, Baba, dá mi sí"},{"start":18.482,"end":19.702,"text":"Mo f'ara mi fun O","marked":"Mo f'ara mi fún Ọ"},{"start":20.152,"end":21.522,"text":"Gba ohun gbogbo ti mo ni,","marked":"Gba ohun gbogbo tí mo ní"},{"start":21.972,"end":23.248,"text":"Si f'ara Re fun mi.","marked":"Sì f'ara Rẹ fún mi."}],"end":23.248},{"key":"4","start":24.198,"lines":[{"start":24.198,"end":25.968,"text":"Ẹmi rẹ, Baba, fifun mi,","marked":"Ẹ̀mí rẹ, Baba, fífún mi"},{"start":26.418,"end":27.733,"text":"K'o le ma pẹlu mi,","marked":"K'ó lè má pẹ̀lú mi"},{"start":28.183,"end":29.567,"text":"K'o se imọlẹ ẹsẹ mi,","marked":"K'ó ṣe ìmọ́lẹ̀ ẹsẹ̀ mi"},{"start":30.017,"end":31.504,"text":"S'isinmi ailopin.","marked":"S'ìsinmi àìlópin."}],"end":31.504}]}