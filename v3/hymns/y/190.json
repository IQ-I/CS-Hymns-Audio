{"v":3,"coll":"y","num":190,"id":"hymn_190","title":"OJO 'binu ojo eru","duration":28.691,"voices":{"male":{"file":"y-190-male-v3.m4a","bytes":201677,"sha256":"49f51f3260725973ff682abffdcfb657844daabb2ec101c14178930697f6e3cd","duration":28.7},"female":{"file":"y-190-female-v3.m4a","bytes":208194,"sha256":"f91345e378387a70f6c496b1c14e85f7f79575f9447c91c232e61abcef3c4c44","duration":28.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.542,"text":"f ỌJỌ 'binu ọjọ eru,","marked":"f Ọjọ́ bínú ọjọ́ ẹrú"},{"start":1.992,"end":4.042,"text":"T'ayé at'ọrun y'o fo lọ,","marked":"T'ayé àt'ọ̀run y'ó fò lọ"},{"start":4.492,"end":5.857,"text":"Kin' igbẹkẹle ẹlẹsẹ?","marked":"Kín ìgbẹ́kẹ̀lé ẹlẹ́sẹ̀?"},{"start":6.307,"end":8.024,"text":"Y'o se le yọju l'ọjọ na?","marked":"Y'ó ṣe lè yọjú l'ọjọ́ ná?"}],"end":8.024},{"key":"2","start":8.974,"lines":[{"start":8.974,"end":10.526,"text":"Nigba ti ọrun y'o kako,","marked":"Nígbà tí ọ̀run y'ó kákò"},{"start":10.976,"end":13.323,"text":"Bi awọ ti a fi ina sun;","marked":"Bí awọ tí a fi iná sun"},{"start":13.773,"end":15.171,"text":"T'ipe ajinde o ma dun,","marked":"T'ìpẹ́ àjíǹde ò má dùn"},{"start":15.621,"end":17.687,"text":"Kikankikan, tẹrutẹru.","marked":"Kíkankíkan, tẹrùtẹrù."}],"end":17.687},{"key":"3","start":18.637,"lines":[{"start":18.637,"end":19.743,"text":"A! l'ọjọ 'binu,","marked":"A! l'ọjọ́ bínú"},{"start":20.193,"end":22.2,"text":"T'ọda yoo ji si 'dajọ,","marked":"T'ọ̀dá yóò jí sí 'dajọ"},{"start":22.65,"end":25.104,"text":"Kristi, jo se 'gbẹkẹle wa,","marked":"Kristi, jọ ṣe 'gbẹkẹle wa"},{"start":25.554,"end":27.141,"text":"'Gba t'aye t'ọrun ba fo lọ.","marked":"gbà t'ayé t'ọ̀run bá fò lọ."}],"end":27.141}]}