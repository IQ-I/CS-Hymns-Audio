{"v":3,"coll":"y","num":240,"id":"hymn_240","title":"JI se Re nde Jesu","duration":41.63,"voices":{"male":{"file":"y-240-male-v3.m4a","bytes":290162,"sha256":"a8b717105f6d1e73f99d478b27a3333b1f2d4da07d58807c2c73e423e11d8ee6","duration":41.7},"female":{"file":"y-240-female-v3.m4a","bytes":300529,"sha256":"bb3d5f467fe63a7c2e95fd040d9800b03516913271404e6a66a0f88d43f5b2a8","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.068,"text":"JI 'sẹ Rẹ nde, Jesu!","marked":"Jí 'sẹ Rẹ̀ ńdẹ, Jésù!"},{"start":2.518,"end":3.707,"text":"Fi agbara Rẹ han!","marked":"Fi agbára Rẹ hàn!"},{"start":4.157,"end":5.899,"text":"Fọ'hun t'o le j'oku dide!","marked":"Fọ'hun t'ó lè j'òkú dìde!"},{"start":6.349,"end":7.389,"text":"Mu k'eniyan rẹ gbọ.","marked":"Mú k'ènìyàn rẹ gbọ́."}],"end":7.389},{"key":"2","start":8.339,"lines":[{"start":8.339,"end":10.226,"text":"Ji'sẹ Rẹ nde, Jesu!","marked":"Jí'sẹ̀ Rẹ̀ ńdẹ, Jésù!"},{"start":10.676,"end":12.045,"text":"Tọ orun iku yi!","marked":"Tọ ọ̀run ikú yí!"},{"start":12.495,"end":13.924,"text":"Fi Ẹmi agbara nla Rẹ,","marked":"Fi Ẹ̀mí agbára ńlá Rẹ"},{"start":14.374,"end":15.54,"text":"Ji ọkan ti n togbe.","marked":"Jí ọkàn tí ń tọgbẹ́."}],"end":15.54},{"key":"3","start":16.49,"lines":[{"start":16.49,"end":18.694,"text":"mf Ji'sẹ Rẹ nde, Jesu!","marked":"mf Jí'sẹ̀ Rẹ̀ ńdẹ, Jésù!"},{"start":19.144,"end":20.334,"text":"Mu k'oungbẹ Rẹ gbẹ wa:","marked":"Mú k'oúngbẹ Rẹ gbẹ wá"},{"start":20.784,"end":22.569,"text":"Si mu k'ebi pa ọkan wa,","marked":"Sì mú k'ebi pa ọkàn wa"},{"start":23.019,"end":24.245,"text":"Fun Ounjẹ iye naa.","marked":"Fún Oúnjẹ iye náà."}],"end":24.245},{"key":"4","start":25.195,"lines":[{"start":25.195,"end":26.971,"text":"Ji 'se Re nde, Jesu","marked":"Jí ṣe Rẹ̀ ńdẹ, Jésù"},{"start":27.421,"end":28.414,"text":"Gbe oruko Re ga","marked":"Gbé orúkọ Rẹ̀ ga"},{"start":28.864,"end":30.293,"text":"Mu k'ife Re kun okan wa","marked":"Mú k'ìfẹ́ Rẹ kún ọkàn wa"},{"start":30.743,"end":31.859,"text":"Nipa Emi Mimo.","marked":"Nípa Ẹ̀mí Mímọ́."}],"end":31.859},{"key":"5","start":32.809,"lines":[{"start":32.809,"end":34.234,"text":"Ji 'se Re nde, Jesu","marked":"Jí ṣe Rẹ̀ ńdẹ, Jésù"},{"start":34.684,"end":36.077,"text":"Ro 'jo itura Re","marked":"Rò jọ ìtura Rẹ"},{"start":36.527,"end":38.226,"text":"Ogo y'o je Tire nikan","marked":"Ògo y'ó jẹ́ Tire nìkan"},{"start":38.676,"end":40.081,"text":"K'ibukun je tiwa.","marked":"K'ìbùkún jẹ́ tiwa."}],"end":40.081}]}