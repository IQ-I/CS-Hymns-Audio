{"v":3,"coll":"y","num":390,"id":"hymn_390","title":"E fi ogo fun baba","duration":32.051,"voices":{"male":{"file":"y-390-male-v3.m4a","bytes":219258,"sha256":"360b0b491cd549783cb6eb8f64e0e85ff10538810942bee0ab1b17dc0765de7a","duration":32.1},"female":{"file":"y-390-female-v3.m4a","bytes":225831,"sha256":"e9b0068652d889fc132d72b3e48d999429a0ffa469368922ea053843099535c2","duration":32.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.574,"text":"Ẹ FI ogo fun Baba,","marked":"Ẹ Fi ògo fún Baba"},{"start":2.024,"end":3.316,"text":"Nipa Ẹni ti a wa;","marked":"Nípa Ẹni tí a wà"},{"start":3.766,"end":4.867,"text":"O n gbọ adura ewe,","marked":"Ó ń gbọ́ àdúrà ewé"},{"start":5.317,"end":6.849,"text":"O n f'eti si orin wọn.","marked":"Ó ń f'etí sí orin wọn."}],"end":6.849},{"key":"2","start":7.799,"lines":[{"start":7.799,"end":8.946,"text":"Ẹ fi ogo fun Ọmọ,","marked":"Ẹ fi ògo fún Ọmọ"},{"start":9.396,"end":11.341,"text":"Kristi, 'Wọ ni Ọba wa;","marked":"Kristi, 'Wọ ni Ọba wa"},{"start":11.791,"end":13.672,"text":"Ẹ wa, ẹ kọrin s'oke,","marked":"Ẹ wá, ẹ kọrin s'òkè"},{"start":14.122,"end":15.527,"text":"S'Ọdaguntan ẹlẹsẹ.","marked":"S'Ọ̀dàgùntàn ẹlẹ́sẹ̀."}],"end":15.527},{"key":"3","start":16.477,"lines":[{"start":16.477,"end":17.586,"text":"Ogo fun Ẹmi Mimọ,","marked":"Ògo fún Ẹ̀mí Mímọ́"},{"start":18.036,"end":19.568,"text":"Bi ọjọ Pentikosti;","marked":"Bí ọjọ́ Pentikosti"},{"start":20.018,"end":21.219,"text":"Ru aya awọn ewe,","marked":"Rú aya àwọn èwe"},{"start":21.669,"end":23.363,"text":"F'orin mimọ s'ete wọn.","marked":"F'orin mímọ́ s'ètè wọn."}],"end":23.363},{"key":"4","start":24.313,"lines":[{"start":24.313,"end":25.641,"text":"Ogo ni l'oke orun","marked":"Ògo ní l'òkè ọ̀run"},{"start":26.091,"end":27.326,"text":"Fun Eni Metalokan","marked":"Fún Ẹni Mẹ́talọ́kan"},{"start":27.776,"end":28.785,"text":"Nitori ihin rere","marked":"Nítorí ìhín rere"},{"start":29.235,"end":30.502,"text":"Ati ife Olorun.","marked":"Àti ìfẹ́ Ọlọ́run."}],"end":30.502}]}