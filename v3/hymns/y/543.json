{"v":3,"coll":"y","num":543,"id":"hymn_543","title":"IWO l'Ona-odo re ni","duration":33.54,"voices":{"male":{"file":"y-543-male-v3.m4a","bytes":227796,"sha256":"4130a2bfcb15cde34a94091b7f1d661a43be6f5951fb91d6d9a17118ddef8913","duration":33.6},"female":{"file":"y-543-female-v3.m4a","bytes":234037,"sha256":"071de4d2a14fe34ec87d989fe6e25f9fcea76d3e631d177e9ebe1704df2d6492","duration":33.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.238,"text":"IWỌ l' Ọna: - ọdọ Rẹ ni","marked":"Ìwọ l Ọ̀nà: ọ̀dọ̀ Rẹ ni"},{"start":2.688,"end":3.715,"text":"Awa o ma sa bọ;","marked":"Àwa ó má sá bọ̀"},{"start":4.165,"end":5.649,"text":"Awọn t'o n safẹri Baba,","marked":"Àwọn t'ó ń sàfẹ́rí Baba"},{"start":6.099,"end":7.359,"text":"Yio wa s'ọdọ Rẹ.","marked":"Yóò wá s'ọ́dọ̀ Rẹ."}],"end":7.359},{"key":"2","start":8.309,"lines":[{"start":8.309,"end":9.751,"text":"Iwo l'Oto-oro Tire","marked":"Ìwọ l'Oto-oro Tìrẹ"},{"start":10.201,"end":11.358,"text":"L'o le f'ogbon fun wa","marked":"L'ó lè f'ọgbọ́n fún wa"},{"start":11.808,"end":13.319,"text":"Iwo nikan l' o le ko wa","marked":"Ìwọ nìkan l ó lè kọ́ wá"},{"start":13.769,"end":14.708,"text":"T'O si le we okan.","marked":"T'Ó sì lè wẹ ọkàn."}],"end":14.708},{"key":"3","start":15.658,"lines":[{"start":15.658,"end":17.539,"text":"Iwọn n' Iye: iboji Rẹ,","marked":"Ìwọ̀n ń Iye: ibojì Rẹ"},{"start":17.989,"end":19.18,"text":"Fi agbara Rẹ han;","marked":"Fi agbára Rẹ hàn"},{"start":19.63,"end":21.018,"text":"Awọn t'o gbẹkẹ wọn le Ọ,","marked":"Àwọn t'ó gbẹ́kẹ̀ wọn lé Ọ"},{"start":21.468,"end":22.504,"text":"Wọn bọ lọwọ iku.","marked":"Wọ́n bọ́ lọ́wọ́ ikú."}],"end":22.504},{"key":"4","start":23.454,"lines":[{"start":23.454,"end":25.871,"text":"Iwọ l' Ọna, Otọ, Iye,","marked":"Ìwọ l Ọ̀nà, Òtọ̀, Ìyè"},{"start":26.321,"end":27.34,"text":"Jẹ k'a mọ ọna Rẹ;","marked":"Jẹ́ k'á mọ ọ̀nà Rẹ"},{"start":27.79,"end":29.685,"text":"K'a mọ otitọ at' iye,","marked":"K'á mọ òtítọ́ àt iye"},{"start":30.135,"end":31.991,"text":"T'ayọ rẹ ko l'opin.","marked":"T'ayọ̀ rẹ̀ kò l'òpin."}],"end":31.991}]}