{"v":3,"coll":"y","num":115,"id":"hymn_115","title":"FUN anu to po b'iyanrin","duration":40.88,"voices":{"male":{"file":"y-115-male-v3.m4a","bytes":278704,"sha256":"47fe4cf97c99d390e416368056efff9d3c95b979c999d28c459df8db3b47b9dc","duration":40.9},"female":{"file":"y-115-female-v3.m4a","bytes":291021,"sha256":"c141d42d1d74c423d43b7bee06b3cc4360ce3026ce1169bd69d3bb0d6b201b3c","duration":40.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.015,"text":"FUN anu to pọ b'iyanrin,","marked":"Fún àánú tó pọ̀ b'iyanrìn"},{"start":2.465,"end":3.595,"text":"Ti mo n gba l'ojumọ;","marked":"Tí mo ń gbà l'ojúmọ́"},{"start":4.045,"end":5.58,"text":"Lat'ọdọ Jesu Oluwa,","marked":"Lát'ọ̀dọ̀ Jésù Olúwa"},{"start":6.03,"end":7.299,"text":"Ki l'emi o fi fun?","marked":"Kí l'èmi ó fi fún?"}],"end":7.299},{"key":"2","start":8.249,"lines":[{"start":8.249,"end":9.551,"text":"Kini n ó fi fun Oluwa,","marked":"Kíni n ó fi fún Olúwa"},{"start":10.001,"end":11.099,"text":"Lat' inu ọkan mi?","marked":"Lát inú ọkàn mi?"},{"start":11.549,"end":13.049,"text":"Ẹsẹ ti ba gbogbo rẹ jẹ,","marked":"Ẹsẹ̀ ti bá gbogbo rẹ̀ jẹ́"},{"start":13.499,"end":14.987,"text":"Ko tilẹ ja mọ nkan.","marked":"Kò tilẹ̀ jà mọ́ nǹkan."}],"end":14.987},{"key":"3","start":15.937,"lines":[{"start":15.937,"end":17.427,"text":"Eyi l'ohun t'emi o se,","marked":"Èyí l'ohun t'èmi ó ṣe"},{"start":17.877,"end":19.28,"text":"F'ohun to se fun mi,","marked":"F'ohun tó ṣe fún mi"},{"start":19.73,"end":21.248,"text":"Em'o mu ago igbala,","marked":"Èm'ó mú àgọ́ ìgbàlà"},{"start":21.698,"end":23.045,"text":"N ó ke pe Ọlọrun.","marked":"N ó ké pe Ọlọ́run."}],"end":23.045},{"key":"4","start":23.995,"lines":[{"start":23.995,"end":25.303,"text":"Eyi l'ọpẹ ti mo le da,","marked":"Èyí l'ọpẹ́ tí mo lè dá"},{"start":25.753,"end":27.5,"text":"Emi osi, are:","marked":"Èmi òsì, àre"},{"start":27.95,"end":29.178,"text":"Em'o ma sọrọ ẹbun Rẹ,","marked":"Èm'ó má sọ̀rọ̀ ẹ̀bùn Rẹ̀"},{"start":29.628,"end":31.03,"text":"N ó si ma bere si.","marked":"N ó sì má bẹ̀rẹ̀ sí."}],"end":31.03},{"key":"5","start":31.98,"lines":[{"start":31.98,"end":33.701,"text":"Emi ko le sin b'o ti to","marked":"Èmi kò lè sin b'ó ti tó"},{"start":34.151,"end":35.691,"text":"N ko n'ise kan to pe;","marked":"N kò n'iṣẹ́ kan tó pé"},{"start":36.141,"end":37.804,"text":"Sugbon em'o sogo yi pe,","marked":"Ṣùgbọ́n èm'ó ṣògo yí pé"},{"start":38.254,"end":39.331,"text":"'Gbese ope mi po.","marked":"gbèsè ọpẹ́ mi pọ̀."}],"end":39.331}]}