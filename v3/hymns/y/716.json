{"v":3,"coll":"y","num":716,"id":"hymn_716","title":"GBO ohun Jesu ti nke pe","duration":64.222,"voices":{"male":{"file":"y-716-male-v3.m4a","bytes":455281,"sha256":"0730b74f29fef9b2b01ab4f5049ab54bd7e8ba49599568a8bdb184ac708c0949","duration":64.3},"female":{"file":"y-716-female-v3.m4a","bytes":476379,"sha256":"eb37f9225d7dbb54a809b9e5c2c8c859c4809cc9a130aed4f09a16223c53a209","duration":64.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.101,"text":"GBO ohun Jesu ti nke pe","marked":"Gbọ́ ohùn Jésù ti ńké pé"},{"start":2.551,"end":3.847,"text":"Tani y'o sise loni","marked":"Tani y'ó ṣiṣẹ́ lónì"},{"start":4.297,"end":5.929,"text":"Oko pon pupo fun 'kore","marked":"Oko pọ́n púpọ̀ fún kórè"},{"start":6.379,"end":7.908,"text":"Tani y'o lo ko wa l'e","marked":"Tani y'ó lọ kò wá l'è"},{"start":8.358,"end":9.738,"text":"Kikan kikan l'Oluwa npe","marked":"Kíkan kíkan l'Olúwa ńpè"},{"start":10.188,"end":11.423,"text":"Ebun nla ni y'O fun o","marked":"Ẹ̀bùn ńlá ni y'Ó fún ọ"},{"start":11.873,"end":13.281,"text":"Tani y'o fl ayo dahun","marked":"Tani y'ó fl ayọ̀ dáhùn"},{"start":13.731,"end":14.999,"text":"Pe” Emi ni yi ran mi?","marked":"Pé Èmi ni yí rán mi?"}],"end":14.999},{"key":"2","start":15.949,"lines":[{"start":15.949,"end":17.28,"text":"B'iwo ko le okun lo","marked":"B'ìwọ kò lé òkun lọ"},{"start":17.73,"end":18.951,"text":"Lati w'awon keferi","marked":"Láti w'àwọn kèfèrí"},{"start":19.401,"end":20.853,"text":"O le ri won nitosi re","marked":"Ó lè rí wọn nítòsí rẹ"},{"start":21.303,"end":22.325,"text":"Nwon wa l'enu ona","marked":"Wọ́n wà l'ẹnu ọ̀nà"},{"start":22.775,"end":24.267,"text":"B'o ko le fi wura tore","marked":"B'ó kò lè fi wúrà tọrẹ"},{"start":24.717,"end":26.301,"text":"Ebun miran ko kere","marked":"Ẹ̀bùn míràn kò kéré"},{"start":26.751,"end":28.359,"text":"Die t'o sise fun Jesu","marked":"Díẹ̀ t'ó ṣiṣẹ́ fún Jésù"},{"start":28.809,"end":30.167,"text":"'Yebiye ni l'oju Re.","marked":"yẹ̀bíye ni l'ojú Rẹ̀."}],"end":30.167},{"key":"3","start":31.117,"lines":[{"start":31.117,"end":32.46,"text":"B'iwo ko le se alore","marked":"B'ìwọ kò lè ṣe alóre"},{"start":32.91,"end":34.205,"text":"L'ori odi Sioni","marked":"L'orí odi Síónì"},{"start":34.655,"end":36.223,"text":"Lati t'oka s'ona orun","marked":"Láti t'ọkà s'ọ̀nà ọ̀run"},{"start":36.673,"end":38.217,"text":"Lati f'iye lo eda","marked":"Láti f'ìyẹ́ lọ ẹ̀dá"},{"start":38.667,"end":40.193,"text":"Wole f'adura at'ore","marked":"Wọlé f'àdúrà àt'ọrẹ"},{"start":40.643,"end":41.738,"text":"Se ohun t'Olorun wi","marked":"Ṣe ohun t'Ọlọ́run wí"},{"start":42.188,"end":43.933,"text":"Wo le se gegebi Aaron","marked":"Wo lè ṣe gẹ́gẹ́bi Aaron"},{"start":44.383,"end":45.95,"text":"T'o gbowo woli soke.","marked":"T'ó gbọ́wọ́ wòlí sókè."}],"end":45.95},{"key":"4","start":46.9,"lines":[{"start":46.9,"end":48.592,"text":"Ma je k'a gbo ki o wipe","marked":"Má jẹ́ k'á gbọ́ kí ó wípé"},{"start":49.042,"end":50.66,"text":"Ko si nkan t'emi le se","marked":"Kò sí nǹkan t'èmi lè ṣe"},{"start":51.11,"end":52.533,"text":"Nigbat' emi eniyan nku","marked":"Nígbàt ẹ̀mí ènìyàn ńkú"},{"start":52.983,"end":54.277,"text":"Ti Oluwa si npe o","marked":"Tí Olúwa sì ńpè ọ́"},{"start":54.727,"end":56.27,"text":"F'ayo gba ise t'O ran o,","marked":"F'ayọ̀ gba iṣẹ́ t'Ó rán ọ́"},{"start":56.72,"end":57.913,"text":"Fise Re se ayo re","marked":"Fiṣẹ́ Rẹ ṣe ayọ̀ rẹ"},{"start":58.363,"end":60.528,"text":"Gbat' o npe o, tara dahun","marked":"Gbàt ò ńpè ọ́, tara dáhùn"},{"start":60.978,"end":62.672,"text":"Pe emi ni yi, ran mi.","marked":"Pé èmi ni yí, rán mi."}],"end":62.672}]}