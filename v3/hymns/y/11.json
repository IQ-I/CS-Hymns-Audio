{"v":3,"coll":"y","num":11,"id":"hymn_11","title":"K'A to sun, Olugbala wa","duration":51.744,"voices":{"male":{"file":"y-11-male-v3.m4a","bytes":357393,"sha256":"978c2efc525301b35f32d5229798c33d1a0e20647f574fecc41fe365f7663a1c","duration":51.8},"female":{"file":"y-11-female-v3.m4a","bytes":377459,"sha256":"78ccca8db33b319e12b401d4dcf81494358262b5b99f4b38c486ab1afb1db40e","duration":51.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.402,"text":"K'A to sun, Olugbala wa,","marked":"K'A tó sùn, Olùgbàlà wa"},{"start":2.852,"end":4.487,"text":"Fun wa n'ibukun ale,","marked":"Fún wa n'ìbùkún alẹ́"},{"start":4.937,"end":6.155,"text":"A jewo ese fun O,","marked":"A jẹ́wọ́ ẹ̀ṣẹ̀ fún Ọ"},{"start":6.605,"end":7.942,"text":"Iwo lo le gba wa la.","marked":"Ìwọ ló lè gbà wá là."}],"end":7.942},{"key":"2","start":8.892,"lines":[{"start":8.892,"end":10.488,"text":"B'ile tile ti su dudu","marked":"B'ilẹ̀ tilẹ̀ ti ṣú dúdú"},{"start":10.938,"end":12.411,"text":"Okun ko le se wa mo","marked":"Okùn kò lè ṣe wá mọ́"},{"start":12.861,"end":14.115,"text":"Iwo eniti ki sare,","marked":"Ìwọ ẹnití kí sáré"},{"start":14.565,"end":15.838,"text":"Nso awon enia Re.","marked":"Ǹṣọ́ àwọn ẹnìà Rẹ."}],"end":15.838},{"key":"3","start":16.788,"lines":[{"start":16.788,"end":18.295,"text":"B'iparun tile yi wa ka,","marked":"B'ìparun tilẹ̀ yí wa ká"},{"start":18.745,"end":20.081,"text":"Ti ofa nfo wa koja","marked":"Tí ọfà ńfọ̀ wá kọjá"},{"start":20.531,"end":21.799,"text":"Awon Angeli yi wa ka,","marked":"Àwọn Áńgẹ́lì yí wa ká"},{"start":22.249,"end":23.544,"text":"Awa o wa l'ailewu.","marked":"Àwa ó wà l'áìléwu."}],"end":23.544},{"key":"4","start":24.494,"lines":[{"start":24.494,"end":26.168,"text":"Sugbon b'iku ba ji wa pa,","marked":"Ṣùgbọ́n b'ikú bá jí wa pa"},{"start":26.618,"end":27.961,"text":"Ti busun wa d'iboji","marked":"Ti bùsùn wá d'ibojì"},{"start":28.411,"end":30.009,"text":"Je k' ile mo wa sodo Re,","marked":"Jẹ́ k ilẹ̀ mo wá sọ́dọ̀ Rẹ"},{"start":30.459,"end":31.934,"text":"L' ayo at' alafia.","marked":"L ayọ̀ àt àlàáfíà."}],"end":31.934},{"key":"5","start":32.884,"lines":[{"start":32.884,"end":34.743,"text":"N'irele awa f'ara wa,","marked":"N'ìrẹ̀lẹ̀ àwa f'ara wa"},{"start":35.193,"end":37.205,"text":"Sabe abo Re, Baba","marked":"Sábẹ́ abo Rẹ, Baba"},{"start":37.655,"end":40.069,"text":"Jesu, 'Wo t'osun bi awa","marked":"Jésù, wò t'osùn bí àwa"},{"start":40.519,"end":41.948,"text":"Se orun wa bi Tire.","marked":"Ṣe ọ̀run wà bí Tire."}],"end":41.948},{"key":"6","start":42.898,"lines":[{"start":42.898,"end":44.134,"text":"Emi Mimo rado bo wa,","marked":"Ẹ̀mí Mímọ́ rádọ̀ bọ̀ wá"},{"start":44.584,"end":45.743,"text":"Tan 'mole s'okunkun wa,","marked":"Tan mọ́lẹ̀ s'òkùnkùn wà"},{"start":46.193,"end":47.426,"text":"Tit'awa o fi ri ojo","marked":"Tít'àwa ó fi rí ọjọ́"},{"start":47.876,"end":49.115,"text":"Imole aiyeraiye.","marked":"Ìmọ́lẹ̀ ayérayé."},{"start":49.565,"end":50.195,"text":"Amin.","marked":"Àmín."}],"end":50.195}]}