{"v":3,"coll":"y","num":169,"id":"hymn_169","title":"OLUWA awa omo Re tun de","duration":75.674,"voices":{"male":{"file":"y-169-male-v3.m4a","bytes":552267,"sha256":"757c42b3cd4d656b42c1f162c41530ef706d7cf516991e04391275b7e29d3e39","duration":75.7},"female":{"file":"y-169-female-v3.m4a","bytes":564277,"sha256":"bd1bf5a3e97953f14529570ac9f6a846b9c468e82a0a909d1257cb17b3a09aea","duration":75.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.812,"text":"OLUWA awa omo Re tun de","marked":"Olúwa àwa ọmọ Rẹ̀ tún dé"},{"start":2.262,"end":3.499,"text":"Lati wa anu re.","marked":"Láti wá àánú rẹ̀."},{"start":3.949,"end":5.542,"text":"Ni ajodun isin Ikore wa,","marked":"Ní àjọ̀dún ìsìn Ìkórè wà"},{"start":5.992,"end":15.171,"text":"Masai saanu fun wa. Anu! Anu! Anu la ń fẹ lọwọ Rẹ Baba wa ọrun; Jọ si ferese ọrun Rẹ loni, Rọjo anu le wa.","marked":"Masai ṣàánú fún wa. Àánú! Àánú! Àánú là ń fẹ́ lọ́wọ́ Rẹ̀ Baba wa ọ̀run; Jọ sì fèrèsé ọ̀run Rẹ̀ lónì, Rọ̀jò àánú lè wà."}],"end":15.171},{"key":"CHORUS","start":16.121,"lines":[{"start":16.121,"end":18.838,"text":"Anu! Anu! Anu la nfe","marked":"Àánú! Àánú! Àánú là ńfẹ́"},{"start":19.288,"end":19.989,"text":"Iowo Re","marked":"lọ́wọ́ Rẹ̀"},{"start":20.439,"end":21.321,"text":"Baba wa orun","marked":"Baba wa ọ̀run"},{"start":21.771,"end":23.267,"text":"Jo si ferese Orun Re loni","marked":"Jọ sì fèrèsé Ọ̀run Rẹ̀ lónì"},{"start":23.717,"end":24.88,"text":"Rojo anu le wa.","marked":"Rọ́jọ́ àánú lè wà."}],"end":24.88},{"key":"2","start":25.83,"lines":[{"start":25.83,"end":27.256,"text":"Jesu Oluwa l'ọjọ ayé Rẹ,","marked":"Jésù Olúwa l'ọjọ́ ayé Rẹ̀"},{"start":27.706,"end":28.953,"text":"Ọba 'lanu ni Ọ;","marked":"Ọba lanu ni Ọ"},{"start":29.403,"end":31.095,"text":"Awọn adẹtẹ ati afọju,","marked":"Àwọn adẹ́tẹ̀ àti afọ́jú"},{"start":31.545,"end":32.727,"text":"R'anu gba lọwọ Rẹ.","marked":"R'àánú gbà lọ́wọ́ Rẹ."}],"end":32.727},{"key":"3","start":33.677,"lines":[{"start":33.677,"end":35.799,"text":"Lọdun yi, Oluwa awa mbẹ Ọ,","marked":"Lọ́dún yí, Olúwa àwa mbẹ́ Ọ"},{"start":36.249,"end":37.377,"text":"Ma jẹ k'isẹ wọn wa;","marked":"Má jẹ́ k'ìsẹ wọn wá"},{"start":37.827,"end":39.995,"text":"K'O si jẹ k'a s'owo b'ode p'ade,","marked":"K'Ó sì jẹ́ k'á s'ọwọ́ b'òde p'ádé"},{"start":40.445,"end":41.798,"text":"K'ara dẹ gbogbo wa.","marked":"K'ara dẹ gbogbo wa."}],"end":41.798},{"key":"4","start":42.748,"lines":[{"start":42.748,"end":44.864,"text":"Mase jẹ ki esu ri wa gbe se,","marked":"Máṣe jẹ́ kí èṣù rí wa gbé ṣe"},{"start":45.314,"end":46.474,"text":"Ni gbogb' ọjọ ayé wa;","marked":"Ní gbogb ọjọ́ ayé wà"},{"start":46.924,"end":48.8,"text":"Ko si ti 'lẹkun iku at'arun,","marked":"Kò sì ti 'lẹkun ikú àt'àrùn"},{"start":49.25,"end":50.588,"text":"Mu wa di amọdun.","marked":"Mú wa di àmọ́dún."}],"end":50.588},{"key":"5","start":51.538,"lines":[{"start":51.538,"end":53.049,"text":"Oluwa, dari ese wa ji wa","marked":"Olúwa, dárí ẹ̀ṣẹ̀ wa jì wá"},{"start":53.499,"end":54.645,"text":"T'a fi bi O ninu","marked":"T'a fi bí Ọ nínú"},{"start":55.095,"end":56.528,"text":"Jo se ayipada rere fun wa","marked":"Jọ ṣe àyípadà rere fún wa"},{"start":56.978,"end":58.377,"text":"K'a le ma je Tire.","marked":"K'á lè má jẹ́ Tire."}],"end":58.377},{"key":"6","start":59.327,"lines":[{"start":59.327,"end":60.684,"text":"Nigba t'ikore ayé ba","marked":"Nígbà t'ìkórè ayé bá"},{"start":61.134,"end":62.457,"text":"pari T'a ko awa naa","marked":"parí T'á kọ àwa náà"},{"start":62.907,"end":64.141,"text":"jo B' ikore sinu aba","marked":"jọ B ìkórè sínú àbà"},{"start":64.591,"end":74.125,"text":"Re orun F'anu tewogba wa. Anu! Anu! Anu la ń fẹ lọwọ Rẹ Baba wa ọrun; Jọ si ferese ọrun Rẹ loni, Rọjo anu le wa.","marked":"Rẹ ọ̀run F'àánú tẹ́wọ́gbà wa. Àánú! Àánú! Àánú là ń fẹ́ lọ́wọ́ Rẹ Baba wa ọ̀run; Jọ sì fèrèsé ọ̀run Rẹ lónì, Rọ̀jò àánú lè wà."}],"end":74.125}]}