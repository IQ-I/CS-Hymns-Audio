{"v":3,"coll":"y","num":465,"id":"hymn_465","title":"NIHIN l'ayida wa","duration":49.42,"voices":{"male":{"file":"y-465-male-v3.m4a","bytes":349943,"sha256":"301c804bb69a12b59f3739795e0df6226dd83f6eaa4deb556f27a692a3c9cad8","duration":49.5},"female":{"file":"y-465-female-v3.m4a","bytes":356875,"sha256":"d508efda822c1ddec0f5ba422327d2ed4147182b67233b0f5d6ceeed6fe330ee","duration":49.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.267,"text":"Nihin l'ayida wa;","marked":"Níhìn l'àyídá wa"},{"start":1.717,"end":2.874,"text":"Ojo, ẹrun, n kọja,","marked":"Ọjọ́, ẹ̀rùn, ń kọjá"},{"start":3.324,"end":5.24,"text":"di Ilẹ ni ń yan, ti o si ń sa,","marked":"di Ilẹ̀ ní ń yàn, tí ó sì ń sá"},{"start":5.69,"end":6.985,"text":"'Tana dada si n ku:","marked":"taná dada sì ń kú"},{"start":7.435,"end":9.055,"text":"Sugbọn ọrọ Jesu duro,","marked":"Sùgbọ́n ọ̀rọ̀ Jésù dúró"},{"start":9.505,"end":11.49,"text":"N ó wa pẹlu rẹ,‖ ni Oun wi.","marked":"N ó wà pẹ̀lú rẹ̀,‖ ni Òun wí."}],"end":11.49},{"key":"2","start":12.44,"lines":[{"start":12.44,"end":13.506,"text":"Nihin l'ayida wa,","marked":"Níhìn l'àyídá wa"},{"start":13.956,"end":15.263,"text":"L'ona ajo ọrun;","marked":"L'ọ́nà àjọ ọ̀run"},{"start":15.713,"end":18.598,"text":"N'nu 'gbagbọ, 'reti, at'ẹru,","marked":"N'nú 'gbagbọ, retí, àt'ẹrù"},{"start":19.048,"end":20.406,"text":"N'nu 'fẹ s'Ọlọrun wa;","marked":"N'nú 'fẹ s'Ọlọ́run wa"},{"start":20.856,"end":22.599,"text":"A ń saika ọrọ yi si po!","marked":"À ń ṣàìká ọ̀rọ̀ yí sí pọ̀!"},{"start":23.049,"end":24.969,"text":"N ó wa pẹlu ẹ.‖ ni Oun wi.","marked":"N ó wà pẹ̀lú ẹ.‖ ni Òun wí."}],"end":24.969},{"key":"3","start":25.919,"lines":[{"start":25.919,"end":26.97,"text":"Nihin l'ayida wa;","marked":"Níhìn l'àyídá wa"},{"start":27.42,"end":28.559,"text":"Sugbọn l'a rin eyi,","marked":"Sùgbọ́n l'a rìn èyí"},{"start":29.009,"end":30.79,"text":"L'arin ayidayid' ayé;","marked":"L'árín àyídáyíd ayé"},{"start":31.24,"end":32.344,"text":"Ọkan wa ti ki yi;","marked":"Ọkàn wa tí kì yí"},{"start":32.794,"end":34.099,"text":"Ọrọ Jehofa ki pada;","marked":"Ọ̀rọ̀ Jèhófà kì padà"},{"start":34.549,"end":36.498,"text":"N ó wa pẹlu rẹ,‖ ni Oun wi.","marked":"N ó wà pẹ̀lú rẹ̀,‖ ni Òun wí."}],"end":36.498},{"key":"4","start":37.448,"lines":[{"start":37.448,"end":38.557,"text":"Ọna alafia:","marked":"Ọ̀nà àlàáfíà"},{"start":39.007,"end":39.93,"text":"Immanueli wa;","marked":"Immanueli wá"},{"start":40.38,"end":42.145,"text":"Majẹmu ti ore ọfẹ,","marked":"Májẹ̀mú ti oore ọ̀fẹ́"},{"start":42.595,"end":43.819,"text":"Lai wọn ki yipada;","marked":"Láì wọn kí yípadà"},{"start":44.269,"end":45.704,"text":"'Nki yipada‖ l'ọrọ Baba,","marked":"ńkì yípadà‖ l'ọ̀rọ̀ Baba"},{"start":46.154,"end":47.87,"text":"Mo wa pẹlu rẹ,‖ ni Oun wi.","marked":"Mo wà pẹ̀lú rẹ,‖ ni Òun wí."}],"end":47.87}]}