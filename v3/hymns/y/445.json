{"v":3,"coll":"y","num":445,"id":"hymn_445","title":"Olorun 'yanu ọna kan","duration":29.93,"voices":{"male":{"file":"y-445-male-v3.m4a","bytes":202111,"sha256":"fab1a9f79850d85821ea3c395ae3851569846f55b9b0f9be5ffde7afdfe7b03c","duration":30.0},"female":{"file":"y-445-female-v3.m4a","bytes":213128,"sha256":"78390fb6431bfc8ad274322da1dc0ad3e7f60710d951046239e9c7b47d9fb288","duration":30.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.461,"text":"Ọlọrun 'yanu ọna kan,","marked":"Ọlọ́run yanu ọ̀nà kan"},{"start":1.911,"end":3.44,"text":"Ti o da bi Tirẹ ko si:","marked":"Tí ó dá bí Tirẹ̀ kò sí"},{"start":3.89,"end":5.307,"text":"Gbogb' ogo ore-ọfẹ Rẹ,","marked":"Gbogb ògo ore-ọfẹ Rẹ"},{"start":5.757,"end":7.114,"text":"L'o farahan bi Ọlọrun,","marked":"L'ó farahàn bí Ọlọ́run"}],"end":7.114},{"key":"CHORUS","start":8.064,"lines":[{"start":8.064,"end":9.246,"text":"Ta l'Ọlọrun ti n dariji,","marked":"Ta l'Ọlọ́run tí ń dáríjì"},{"start":9.696,"end":11.125,"text":"Ore ta l'o pọ bi Tirẹ?","marked":"Ọrẹ ta l'ó pọ̀ bí Tirẹ̀?"}],"end":11.125},{"key":"2","start":12.075,"lines":[{"start":12.075,"end":14.003,"text":"N' iyanu at'ayọ l'a gba,","marked":"N ìyanu àt'ayọ̀ l'á gbà"},{"start":14.453,"end":15.834,"text":"Idariji Ọlọrun wa;","marked":"Ìdáríjì Ọlọ́run wa"},{"start":16.284,"end":18.077,"text":"'Dariji f'ẹsẹ t'o tobi,","marked":"dáríjì f'ẹsẹ̀ t'ó tóbi"},{"start":18.527,"end":20.083,"text":"T'a f'ẹjẹ Jesu s'edidi.","marked":"T'á f'ẹ̀jẹ̀ Jésù s'èdìdì."}],"end":20.083},{"key":"3","start":21.033,"lines":[{"start":21.033,"end":22.267,"text":"Je ki ore-ofe re yi","marked":"Jẹ́ kí oore-ọ̀fẹ́ rẹ yí"},{"start":22.717,"end":23.945,"text":"Ife iyanu nla Re yi","marked":"Ìfẹ́ ìyanu ńlá Rẹ̀ yí"},{"start":24.395,"end":26.088,"text":"K'o f'iyin kun gbogbo ayé,","marked":"K'ó f'ìyìn kún gbogbo ayé"},{"start":26.538,"end":28.381,"text":"Pelu egbe Angel l'oke.","marked":"Pẹ̀lú ẹgbẹ́ Angẹl l'òkè."}],"end":28.381}]}