{"v":3,"coll":"y","num":640,"id":"hymn_640","title":"A! Ko s'alabaro l'aye","duration":88.625,"voices":{"male":{"file":"y-640-male-v3.m4a","bytes":624531,"sha256":"8b92c3fcb88548a29e6a4151de4b722d7ef417e86e3f5457c9e9787a66827f9f","duration":88.7},"female":{"file":"y-640-female-v3.m4a","bytes":654304,"sha256":"488bdfc10243d4e39eb1d19058dcbbabcaef0606059842c7a1a5fc6720c6e982","duration":88.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.346,"text":"A! Ko s'alabaro l'ayé,","marked":"A! Kò s'alábàrò l'ayé"},{"start":2.796,"end":3.977,"text":"Mase ronu nitori,","marked":"Máṣe ronú nítorí"},{"start":4.427,"end":5.963,"text":"Ti ko si alabaro mọ,","marked":"Tí kò sí alábàrò mọ́"},{"start":6.413,"end":8.138,"text":"Jesu ju Iya oun Baba.","marked":"Jésù ju Ìyá òun Baba."},{"start":8.588,"end":9.38,"text":"Tu 'ju rẹ ka,","marked":"Tú ju rẹ̀ ká"},{"start":9.83,"end":10.997,"text":"Sa gbẹkẹle Ọlọrun.","marked":"Sá gbẹ́kẹ̀lé Ọlọ́run."}],"end":10.997},{"key":"CHORUS","start":11.947,"lines":[{"start":11.947,"end":12.792,"text":"Tu 'ju re ka","marked":"Tú ju rẹ̀ ká"},{"start":13.242,"end":14.37,"text":"Sa gbekele Olorun.","marked":"Sá gbẹ́kẹ̀lé Ọlọ́run."}],"end":14.37},{"key":"2","start":15.32,"lines":[{"start":15.32,"end":17.404,"text":"A! ko s'alabaro l'ayé,","marked":"A! kò s'alábàrò l'ayé"},{"start":17.854,"end":19.663,"text":"Mase bẹru, bi ayé,","marked":"Maṣe bẹ̀rù, bí ayé"},{"start":20.113,"end":21.643,"text":"Ba n yi o ka ninu ẹru,","marked":"Bá ń yí ọ kà nínú ẹ̀rù"},{"start":22.093,"end":23.498,"text":"Jesu yoo wa pẹlu rẹ,","marked":"Jésù yóò wà pẹ̀lú rẹ"},{"start":23.948,"end":24.94,"text":"Kẹ pe Jesu,","marked":"Kẹ̀ pé Jésù"},{"start":25.39,"end":26.51,"text":"Iwọ yoo sẹgun wọn.","marked":"Ìwọ yóò sẹ́gun wọn."}],"end":26.51},{"key":"3","start":27.46,"lines":[{"start":27.46,"end":29.575,"text":"A! ko s'alabaro l'ayé,","marked":"A! kò s'alábàrò l'ayé"},{"start":30.025,"end":31.256,"text":"Ma foya b'igbi ayé,","marked":"Má fòyà b'ìgbì ayé"},{"start":31.706,"end":33.485,"text":"Ba bo ọ mọlẹ b'okun nla,","marked":"Bá bò ọ́ mọ́lẹ̀ b'okùn ńlá"},{"start":33.935,"end":35.346,"text":"Iwọ yoo bori dandan,","marked":"Ìwọ yóò borí dandan"},{"start":35.796,"end":37.113,"text":"A! ma bẹru,","marked":"A! má bẹ̀rù"},{"start":37.563,"end":38.924,"text":"Jesu yoo wa pẹlu rẹ.","marked":"Jésù yóò wà pẹ̀lú rẹ̀."}],"end":38.924},{"key":"4","start":39.874,"lines":[{"start":39.874,"end":41.987,"text":"A! ko s'alabaro l'ayé,","marked":"A! kò s'alábàrò l'ayé"},{"start":42.437,"end":43.718,"text":"Ma binu b'ayé n kẹgan,","marked":"Má bínú b'ayé ń kẹ́gàn"},{"start":44.168,"end":45.928,"text":"T'o si n sata rẹ nitori,","marked":"T'ó sì ń ṣàtà rẹ̀ nítorí"},{"start":46.378,"end":47.587,"text":"T'iwọ ko ni ẹnikan,","marked":"T'ìwọ kò ní ẹnìkan"},{"start":48.037,"end":49.062,"text":"Sa gbadura ,","marked":"Sá gbàdúrà"},{"start":49.512,"end":51.044,"text":"Ibanujẹ yoo dayọ.","marked":"Ìbànújẹ́ yóò dáyọ̀."}],"end":51.044},{"key":"5","start":51.994,"lines":[{"start":51.994,"end":54.13,"text":"A! ko s'alabaro l'ayé,","marked":"A! kò s'alábàrò l'ayé"},{"start":54.58,"end":56.25,"text":"Ma roju b'ebi n pa ọ,","marked":"Má rojú b'ebi ń pa ọ́"},{"start":56.7,"end":58.067,"text":"Ọlọrun to mbọ eera 'lẹ,","marked":"Ọlọ́run tó mbọ́ èèrà 'lẹ"},{"start":58.517,"end":60.141,"text":"Oun na y'o si bọ ọ yo.","marked":"Òun nà y'ó sì bọ́ ọ́ yọ."},{"start":60.591,"end":61.387,"text":"Gbẹkẹle mi,","marked":"Gbẹ́kẹ̀lé mi"},{"start":61.837,"end":63.173,"text":"Eyi l'asẹ Jehofa.","marked":"Èyí l'àsẹ Jèhófà."}],"end":63.173},{"key":"6","start":64.123,"lines":[{"start":64.123,"end":66.171,"text":"A! ko s'alabaro l'ayé,","marked":"A! kò s'alábàrò l'ayé"},{"start":66.621,"end":68.028,"text":"Ma kanu 'po rẹ l'ayé,","marked":"Má kanú pọ̀ rẹ̀ l'ayé"},{"start":68.478,"end":69.859,"text":"Ọlọrun yoo le esinsin,","marked":"Ọlọ́run yóò lè eṣinṣin"},{"start":70.309,"end":71.842,"text":"Fun malu ti ko n'iru.","marked":"Fún màlú tí kò n'irú."},{"start":72.292,"end":73.47,"text":"Sa wo Jesu,","marked":"Sá wo Jésù"},{"start":73.92,"end":75.75,"text":"Ẹkun re yoo si d'ayọ.","marked":"Ẹkún rẹ̀ yóò sì d'ayọ̀."}],"end":75.75},{"key":"7","start":76.7,"lines":[{"start":76.7,"end":78.108,"text":"Jesu nikan l'Alabaro,","marked":"Jésù nìkan l'Alábarò"},{"start":78.558,"end":80.002,"text":"Oun l'Ọrẹ ti ki dani,","marked":"Òun l'Ọ̀rẹ́ tí kì dáni"},{"start":80.452,"end":81.791,"text":"Oun ni Ọkọ awọn opo,","marked":"Òun ni Ọkọ̀ àwọn opó"},{"start":82.241,"end":83.93,"text":"Oun Baba 'laini baba.","marked":"Òun Baba láìní Baba."},{"start":84.38,"end":85.279,"text":"Sa gbẹkẹle,","marked":"Sá gbẹ́kẹ̀lé"},{"start":85.729,"end":87.077,"text":"Oun o si ran ọ lọwọ.","marked":"Òun ó sì ràn ọ́ lọ́wọ́."}],"end":87.077}]}