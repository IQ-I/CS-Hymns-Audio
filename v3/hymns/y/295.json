{"v":3,"coll":"y","num":295,"id":"hymn_295","title":"ARA, e wa ba mi sofo","duration":62.609,"voices":{"male":{"file":"y-295-male-v3.m4a","bytes":444540,"sha256":"c60f13c04efe6115280e4daf24b027f77df788d7d6b203eb16822404e4d7f5b0","duration":62.7},"female":{"file":"y-295-female-v3.m4a","bytes":459777,"sha256":"06f829b2536a4163cccfb3393df353f6923221055fe806921da39e79832e5e5c","duration":62.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.307,"text":"ARA, ẹ wa ba mi sọfọ;","marked":"Ara, ẹ wá bá mi sọ̀fọ̀"},{"start":2.757,"end":3.998,"text":"Ẹ wa sọdọ Olugbala;","marked":"Ẹ wá sọ́dọ̀ Olùgbàlà"},{"start":4.448,"end":6.678,"text":"Wa, ẹ jẹ k'a jumọ sọfọ;","marked":"Wá, ẹ jẹ́ k'á jùmọ̀ sọ̀fọ̀"},{"start":7.128,"end":8.683,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù m'àgbélébùú."}],"end":8.683},{"key":"2","start":9.633,"lines":[{"start":9.633,"end":10.899,"text":"Ko ha s'omije loju wa,","marked":"Kò ha s'omijé lójú wa"},{"start":11.349,"end":13.062,"text":"Bi awọn Ju ti n fi sẹfẹ?","marked":"Bí àwọn Jù tí ń fi sẹ̀fẹ̀?"},{"start":13.512,"end":15.753,"text":"A! ẹ wo, b'O ti tẹriba;","marked":"A! ẹ wò, b'Ó ti tẹríba"},{"start":16.203,"end":17.829,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù m'àgbélébùú."}],"end":17.829},{"key":"3","start":18.779,"lines":[{"start":18.779,"end":20.208,"text":"Ẹẹmeje l'O sọrọ ifẹ:","marked":"Ẹ̀ẹ̀méje l'Ó sọ̀rọ̀ ìfẹ́"},{"start":20.658,"end":22.134,"text":"Idakẹ wakati mẹta;","marked":"Ìdákẹ́ wákàtí mẹ́ta"},{"start":22.584,"end":23.985,"text":"L'o fi n tọrọ anu f'eniyan:","marked":"L'ó fi ń tọrọ àánú f'ènìyàn"},{"start":24.435,"end":26.004,"text":"A kan Jesu m'agbelebu","marked":"A kan Jésù m'àgbélébùú"}],"end":26.004},{"key":"4","start":26.954,"lines":[{"start":26.954,"end":29.174,"text":"Bu s'ẹkun, ọkan lile mi!","marked":"Bú s'ẹkún, ọkàn líle mi!"},{"start":29.624,"end":31.29,"text":"p Ẹsẹ at'igberaga rẹ,","marked":"p Ẹsẹ̀ àt'ìgbéraga rẹ̀"},{"start":31.74,"end":33.403,"text":"L'o fa Oluwa rẹ l'ẹbi,","marked":"L'ó fa Olúwa rẹ̀ l'ẹ̀bi"},{"start":33.853,"end":35.403,"text":"A kan Jesu m'agbelebu","marked":"A kan Jésù m'àgbélébùú"}],"end":35.403},{"key":"5","start":36.353,"lines":[{"start":36.353,"end":37.78,"text":"Wa duro ti agbelebu,","marked":"Wá dúró ti àgbélébùú"},{"start":38.23,"end":39.943,"text":"K'ẹjẹ ti n jade niha Rẹ,","marked":"K'ẹ̀jẹ̀ tí ń jáde níhà Rẹ̀"},{"start":40.393,"end":41.804,"text":"Ba le ma san le ọ lori;","marked":"Bá lè má sàn lé ọ lórí"},{"start":42.254,"end":43.871,"text":"A kan Jesu m'agbelebu","marked":"A kan Jésù m'àgbélébùú"}],"end":43.871},{"key":"6","start":44.821,"lines":[{"start":44.821,"end":46.461,"text":"Ibanujẹ at'omije,","marked":"Ìbànújẹ́ àt'omijé"},{"start":46.911,"end":48.218,"text":"Bere a ki o fi du ọ;","marked":"Bẹ̀rẹ̀ a kí o fi dù ọ́"},{"start":48.668,"end":50.072,"text":"'Banujẹ l'o n f'ifẹ rẹ han;","marked":"'Banujẹ l'ó ń f'ìfẹ́ rẹ̀ hàn"},{"start":50.522,"end":52.047,"text":"A kan Jesu m'agbelebu","marked":"A kan Jésù m'àgbélébùú"}],"end":52.047},{"key":"7","start":52.997,"lines":[{"start":52.997,"end":54.813,"text":"Ifẹ Baba, ẹsẹ ẹda,","marked":"Ìfẹ́ Baba, ẹsẹ̀ ẹ̀dá"},{"start":55.263,"end":56.645,"text":"Nihin l'a ri agbara rẹ;","marked":"Níhìn l'á rí agbára rẹ̀"},{"start":57.095,"end":59.294,"text":"Ifẹ l'o si di Asẹgun;","marked":"Ìfẹ́ l'ó sì di Asẹ́gun"},{"start":59.744,"end":61.06,"text":"A kan Olufẹ wa mọ'gi","marked":"A kan Olùfẹ́ wa mọ́'gí"}],"end":61.06}]}