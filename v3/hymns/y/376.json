{"v":3,"coll":"y","num":376,"id":"hymn_376","title":"TANI o gbe Jakob dide","duration":34.498,"voices":{"male":{"file":"y-376-male-v3.m4a","bytes":241373,"sha256":"4f8525ebe4b79ad1e65dc3975bd5598920d9d2acbab5e20fc76c4ac0b5fe6729","duration":34.5},"female":{"file":"y-376-female-v3.m4a","bytes":247513,"sha256":"ef15423f89418cd2cf94377d5f98b339678c0f48faafd21573a5c223c15de75c","duration":34.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.308,"text":"TANI o gbe Jakọb dide,","marked":"Tani ó gbé Jakọb dìde"},{"start":2.758,"end":3.984,"text":"Ọrọ jakob ko pọ;","marked":"Ọ̀rọ̀ jakọb kò pọ̀"},{"start":4.434,"end":6.157,"text":"Eyi t'o jẹ 'yanu ni pe;","marked":"Èyí t'ó jẹ́ yanu ni pé"},{"start":6.607,"end":7.609,"text":"Imọ wọn ko s'ọkan.","marked":"Ìmọ̀ wọn kò s'ọkàn."}],"end":7.609},{"key":"2","start":8.559,"lines":[{"start":8.559,"end":10.596,"text":"Tani o gbe Jakob dide","marked":"Tani ó gbé Jakọb dìde"},{"start":11.046,"end":12.408,"text":"Ọta Jakob nipa,","marked":"Ọ̀tá Jakọb nípa"},{"start":12.858,"end":14.637,"text":"Mo r'ayọ 'sẹgun loju wọn,","marked":"Mo r'ayọ̀ 'sẹgun lójú wọn"},{"start":15.087,"end":16.427,"text":"Wọn ni, o pari fun.","marked":"Wọ́n ní, ó parí fún."}],"end":16.427},{"key":"3","start":17.377,"lines":[{"start":17.377,"end":19.37,"text":"Tani o gbe Jakob dide","marked":"Tani ó gbé Jakọb dìde"},{"start":19.82,"end":21.023,"text":"A ha r'eni le wi?","marked":"A ha r'ẹni lè wí?"},{"start":21.473,"end":23.018,"text":"E ka to ro nibule yi","marked":"Ẹ ká tó rò níbùlẹ̀ yí"},{"start":23.468,"end":24.539,"text":"O ha tun le ye mo?","marked":"Ó ha tún lè yé mọ́?"}],"end":24.539},{"key":"4","start":25.489,"lines":[{"start":25.489,"end":27.122,"text":"Oluwa mi, isẹ Rẹ ni!","marked":"Olúwa mi, isẹ́ Rẹ ni!"},{"start":27.572,"end":29.527,"text":"Ko s'ẹni t'o le se:","marked":"Kò s'ẹni t'ó lè ṣe"},{"start":29.977,"end":31.303,"text":"Sẹ b'iri s'ori Jakob,","marked":"Sẹ́ b'ìrì s'orí Jakọb"},{"start":31.753,"end":32.948,"text":"Oun yoo si tun ye.","marked":"Òun yóò sì tún yẹ."}],"end":32.948}]}