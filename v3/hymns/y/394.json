{"v":3,"coll":"y","num":394,"id":"hymn_394","title":"MO f'iyin ailopin","duration":44.319,"voices":{"male":{"file":"y-394-male-v3.m4a","bytes":304163,"sha256":"feeb098724c5af1956a970a2283dafcab93fd65d092a9a0d9a1b71833863d073","duration":44.4},"female":{"file":"y-394-female-v3.m4a","bytes":323215,"sha256":"f9b2a31174a9ba80af8703906a71c8d9ac9ee5f7f785587b945eea9a06851fbe","duration":44.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.57,"text":"Mo f'iyin ailopin,","marked":"Mo f'ìyìn àìlópin"},{"start":2.02,"end":2.985,"text":"Fun Ọlọrun Baba,","marked":"Fún Ọlọ́run Baba"},{"start":3.435,"end":4.578,"text":"Fun ore ayé mi,","marked":"Fún ọrẹ ayé mi"},{"start":5.028,"end":6.207,"text":"At' ireti t'ọrun,","marked":"Àt ìrètí t'ọ̀run"},{"start":6.657,"end":7.853,"text":"O ran Ọmọ Rẹ ayanfẹ,","marked":"Ó rán Ọmọ Rẹ̀ àyànfẹ́"},{"start":8.303,"end":9.93,"text":"Lati ku fun ẹsẹ ayé.","marked":"Láti kú fún ẹsẹ̀ ayé."}],"end":9.93},{"key":"2","start":10.88,"lines":[{"start":10.88,"end":12.238,"text":"Mo f'iyin ailopin","marked":"Mo f'ìyìn àìlópin"},{"start":12.688,"end":13.768,"text":"Fun Ọlọrun Ọmọ,","marked":"Fún Ọlọ́run Ọmọ"},{"start":14.218,"end":15.316,"text":"T'O f'ẹjẹ Rẹ wẹ wa,","marked":"T'Ó f'ẹ̀jẹ̀ Rẹ̀ wẹ̀ wá"},{"start":15.766,"end":16.78,"text":"Kuro ninu egbe;","marked":"Kúrò nínú ẹgbẹ́"},{"start":17.23,"end":19.041,"text":"Nisinsin yii O wa l'Ọba,","marked":"Nísinsin yìí Ó wà l'Ọba"},{"start":19.491,"end":20.77,"text":"O n ri eso irora Rẹ.","marked":"Ó ń rí èso ìrora Rẹ̀."}],"end":20.77},{"key":"3","start":21.72,"lines":[{"start":21.72,"end":23.13,"text":"Mo f'iyin ailopin","marked":"Mo f'ìyìn àìlópin"},{"start":23.58,"end":24.797,"text":"Fun Olorun Emi","marked":"Fún Ọlọ́run Èmi"},{"start":25.247,"end":26.342,"text":"Eni f 'agbara Re","marked":"Ẹni f agbára Rẹ̀"},{"start":26.792,"end":27.978,"text":"So elese d'aye","marked":"Sọ ẹlẹ́ṣẹ̀ d'ayé"},{"start":28.428,"end":29.61,"text":"O pari ise igbala","marked":"Ó parí iṣẹ́ ìgbàlà"},{"start":30.06,"end":31.676,"text":"O si fi ayo kun okan.","marked":"Ó sì fi ayọ̀ kún ọkàn."}],"end":31.676},{"key":"4","start":32.626,"lines":[{"start":32.626,"end":34.021,"text":"Mo f'ola ailopin","marked":"Mo f'ọlá àìlópin"},{"start":34.471,"end":35.421,"text":"Fun Olodumare","marked":"Fún Olódùmarè"},{"start":35.871,"end":36.975,"text":"Wo Ologo meta","marked":"Wo Ológo mẹ́ta"},{"start":37.425,"end":38.474,"text":"Sugbon okansoso","marked":"Ṣùgbọ́n ọkànṣoṣo"},{"start":38.924,"end":40.759,"text":"B'O ti ju imo wa lo ni,","marked":"B'Ó ti ju ìmọ̀ wa lọ ni"},{"start":41.209,"end":42.77,"text":"A o ma f'igbagbo yin O.","marked":"A ò má f'ìgbàgbọ́ yín Ọ."}],"end":42.77}]}