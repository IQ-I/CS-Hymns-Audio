{"v":3,"coll":"y","num":706,"id":"hymn_706","title":"AWA l'omo ogun Kristi, Alleluyah","duration":67.899,"voices":{"male":{"file":"y-706-male-v3.m4a","bytes":484491,"sha256":"3384972f74c6b1b8949c6d63bc1dec8d1d375b2b435b8e0db2a072fe1d0e2b1d","duration":67.9},"female":{"file":"y-706-female-v3.m4a","bytes":499347,"sha256":"348eecc7af880d6a2dda321fcb90bef8861a810f1af5dfe0c0214c273e85f2e7","duration":67.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.206,"text":"AWA l'omo ogun Kristi Alleluya","marked":"Àwa l'ọmọ ogun Kristi Allelúyà"},{"start":2.656,"end":4.236,"text":"T'Oluwa gbe dide funra Re","marked":"T'Olúwa gbé dìde fúnra Rẹ̀"},{"start":4.686,"end":6.483,"text":"Awa nsajodun loni Alleluya","marked":"Àwa ńṣàjọ̀dún lóní Allelúyà"},{"start":6.933,"end":8.568,"text":"A dupe fun 'dasi emi wa.","marked":"A dúpẹ́ fún dásí èmi wà."}],"end":8.568},{"key":"CHORUS","start":9.518,"lines":[{"start":9.518,"end":11.224,"text":"Damuso Omo-Ogun Kristi","marked":"Damuso Omo-ogun Kristi"},{"start":11.674,"end":12.911,"text":"Korin soke s'Oba wa","marked":"Kọrin sókè s'Ọba wa"},{"start":13.361,"end":15.155,"text":"Ope ni fun Olugbala Alleluyah","marked":"Ọpẹ́ ni fún Olùgbàlà Alleluyah"},{"start":15.605,"end":17.353,"text":"Fun idasi wa d'ojo loni.","marked":"Fún ìdásí wa d'ọjọ́ lónì."}],"end":17.353},{"key":"2","start":18.303,"lines":[{"start":18.303,"end":20.306,"text":"Gbogbo egbe Kaduna Alleluyah","marked":"Gbogbo ẹgbẹ́ Kaduna Alleluyah"},{"start":20.756,"end":22.322,"text":"E f'ogo fun Baba wa l'oke","marked":"Ẹ f'ògo fún Baba wa l'òkè"},{"start":22.772,"end":25.149,"text":"F'Egbe Omo-Ogun Kristi Alleluyah","marked":"F'Ẹgbẹ́ Omo-ogun Kristi Alleluyah"},{"start":25.599,"end":27.153,"text":"T'Oluwa gbe dide larin yin.","marked":"T'Olúwa gbé dìde lárin yín."}],"end":27.153},{"key":"3","start":28.103,"lines":[{"start":28.103,"end":29.616,"text":"Esu ma gbogun titi, Alleluyah","marked":"Èṣù má gbógun títí, Alleluyah"},{"start":30.066,"end":31.727,"text":"Lati b'egbe Mimo yi subu","marked":"Láti b'ẹ̀gbẹ́ Mímọ́ yí ṣubú"},{"start":32.177,"end":34.286,"text":"Sugbon Jesu gbe wa ro Alleluyah","marked":"Ṣùgbọ́n Jésù gbé wá rọ Alleluyah"},{"start":34.736,"end":36.327,"text":"Ogo ni fun Baba wa loke.","marked":"Ògo ni fún Baba wa lókè."}],"end":36.327},{"key":"4","start":37.277,"lines":[{"start":37.277,"end":39.02,"text":"Ope FOlugbala wa Alleluyah","marked":"Ọpẹ́ Folùgbàlà wa Alleluyah"},{"start":39.47,"end":41.408,"text":"T'o da wa si lati esi wa","marked":"T'ó dá wa sí láti èsì wa"},{"start":41.858,"end":44.527,"text":"Awa si ngbadura, Alleluyah","marked":"Àwa sì ńgbàdúrà, Alleluyah"},{"start":44.977,"end":46.553,"text":"K'a le se opolopo odun.","marked":"K'á lè ṣe ọ̀pọ̀lọpọ̀ ọdún."}],"end":46.553},{"key":"5","start":47.503,"lines":[{"start":47.503,"end":49.847,"text":"Jesu Olor'egbe wa, Alleluyah","marked":"Jésù Ọlọ́r'ẹgbẹ́ wa, Alleluyah"},{"start":50.297,"end":51.734,"text":"A f'ogo f'oruko Mimo Re","marked":"A f'ògo f'orúkọ Mímọ́ Rẹ"},{"start":52.184,"end":54.221,"text":"Jowo di wa l'amure Alleluyah","marked":"Jọ̀wọ́ di wá l'àmùrè Alleluyah"},{"start":54.671,"end":56.475,"text":"K'a le jagun b'omogun toto.","marked":"K'á lè jagun b'ọ̀mọ̀gún tọ́tọ̀."}],"end":56.475},{"key":"6","start":57.425,"lines":[{"start":57.425,"end":59.332,"text":"Ki gbogbo egbe ho ye Alleluyah","marked":"Kí gbogbo ẹgbẹ́ hó yẹ Alleluyah"},{"start":59.782,"end":61.34,"text":"K'a f'ogo fun baba wa l'oke","marked":"K'á f'ògo fún Baba wa l'òkè"},{"start":61.79,"end":63.195,"text":"K'a f'ogo fun Omo Re","marked":"K'á f'ògo fún Ọmọ Rẹ"},{"start":63.645,"end":65.367,"text":"K'a tun f'ogo fun Emi Mimo.","marked":"K'á tún f'ògo fún Ẹ̀mí Mímọ́."},{"start":65.817,"end":66.35,"text":"Amin.","marked":"Àmín."}],"end":66.35}]}