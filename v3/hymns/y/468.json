{"v":3,"coll":"y","num":468,"id":"hymn_468","title":"OLORUN kan lo to k'a sin","duration":58.463,"voices":{"male":{"file":"y-468-male-v3.m4a","bytes":411706,"sha256":"635383fedfe70aae1510da2b30cafd30843b94c689eda666b8a92ac8397e5420","duration":58.5},"female":{"file":"y-468-female-v3.m4a","bytes":425111,"sha256":"953802de6b9476721869b5d3ab1010efb862e398b900ef406d2d434ddf8c771a","duration":58.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.863,"text":"OLORUN kan lo to k'a sin","marked":"Ọlọ́run kan ló tó k'á sìn"},{"start":2.313,"end":4.086,"text":"K'a si feran Re l'afetan","marked":"K'á sì fẹ́ràn Rẹ l'àfẹ̀tàn"},{"start":4.536,"end":5.913,"text":"A ko gbodo bo orisa","marked":"A kò gbọdọ̀ bọ òrìṣà"},{"start":6.363,"end":7.672,"text":"Nitori ohun asan ni.","marked":"Nítorí ohun asán ni."}],"end":7.672},{"key":"CHORUS","start":8.622,"lines":[{"start":8.622,"end":10.656,"text":"K'a ranti pe lati ri igbala","marked":"K'á rántí pé láti rí ìgbàlà"},{"start":11.106,"end":12.55,"text":"O to ka p'ofin mo","marked":"Ó tó ká p'òfin mọ́"},{"start":13.0,"end":14.388,"text":"Ti Olorun ti so fun wa","marked":"Tí Ọlọ́run ti sọ fún wa"},{"start":14.838,"end":16.14,"text":"Ti Olorun ti so fun wa.","marked":"Tí Ọlọ́run ti sọ fún wa."}],"end":16.14},{"key":"2","start":17.09,"lines":[{"start":17.09,"end":18.484,"text":"Kerubu pelu serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":18.934,"end":20.181,"text":"Feran omonikeji re","marked":"Fẹ́ràn ọmọnìkejì rẹ"},{"start":20.631,"end":21.926,"text":"Ife ni awon angeli","marked":"Ìfẹ́ ni àwọn áńgẹ́lì"},{"start":22.376,"end":24.067,"text":"Ni nwon fi sin Baba loke.","marked":"Ní wọ́n fi sin Baba lókè."}],"end":24.067},{"key":"3","start":25.017,"lines":[{"start":25.017,"end":26.446,"text":"Baba aladura mura","marked":"Baba aládúrà múra"},{"start":26.896,"end":28.345,"text":"Lati pad'awon kerubu","marked":"Láti pad'àwọn Kérúbù"},{"start":28.795,"end":30.259,"text":"Ade ogo yio je tire","marked":"Adé ògo yóò jẹ́ tirẹ̀"},{"start":30.709,"end":32.258,"text":"T'omo araiye ko le gba.","marked":"T'ọmọ aráìyè kò lè gbà."}],"end":32.258},{"key":"4","start":33.208,"lines":[{"start":33.208,"end":34.801,"text":"Ileri to se fun Mose","marked":"Ìlérí tó ṣe fún Mósè"},{"start":35.251,"end":36.444,"text":"Ni ori oke Sion","marked":"Ní orí òkè Sion"},{"start":36.894,"end":38.605,"text":"T'ope On yio wa pelu re","marked":"T'ọpẹ́ Ọn yóò wà pẹ̀lú rẹ"},{"start":39.055,"end":40.882,"text":"Lati ko wa de le Kenani.","marked":"Láti kọ́ wa dé lé Kenani."}],"end":40.882},{"key":"5","start":41.832,"lines":[{"start":41.832,"end":43.057,"text":"Agbagba merinlelogun","marked":"Àgbàgbà mẹ́rìnlélógún"},{"start":43.507,"end":44.951,"text":"Ajuba oruko nla nyin","marked":"Àjùbá orúkọ ńlá yín"},{"start":45.401,"end":46.743,"text":"Ati eda 'laye merin","marked":"Àti ẹ̀dà láyé mẹ́rin"},{"start":47.193,"end":48.854,"text":"Ke s'amin si adura wa.","marked":"Ké s'àmín sí àdúrà wa."}],"end":48.854},{"key":"6","start":49.804,"lines":[{"start":49.804,"end":51.236,"text":"Jehovah Jire Oba wa","marked":"Jehovah Jire Ọba wa"},{"start":51.686,"end":53.036,"text":"Gbadura Egbe Kerubu","marked":"Gbàdúrà Ẹgbẹ́ Kérúbù"},{"start":53.486,"end":54.955,"text":"Jehovah Nissi Baba wa","marked":"Jehovah Nissi Baba wa"},{"start":55.405,"end":56.914,"text":"Metalokan gbadura wa.","marked":"Mẹ́talọ́kan gbàdúrà wa."}],"end":56.914}]}