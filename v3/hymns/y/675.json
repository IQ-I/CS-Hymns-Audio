{"v":3,"coll":"y","num":675,"id":"hymn_675","title":"AWON omode s'eka wewe","duration":60.54,"voices":{"male":{"file":"y-675-male-v3.m4a","bytes":435458,"sha256":"d5761df9d6eb519c0440e6e82cde044e83db11480f617a5ae528634bd26619e9","duration":60.6},"female":{"file":"y-675-female-v3.m4a","bytes":454350,"sha256":"15fa9bdbee62950628681b19cafb372ef3c8f2ccaefe2f8720ecf3f4823fe290","duration":60.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.604,"text":"AWON omode s'eka wewe","marked":"Àwọn ọmọdé s'ẹ̀ka wẹ́wẹ́"},{"start":2.054,"end":3.215,"text":"at'imope s'ona","marked":"àt'ìmọ́pẹ́ s'ọ̀nà"},{"start":3.665,"end":5.981,"text":"Won si nke, Hosana","marked":"Wọ́n sì ńké, Hosana"},{"start":6.431,"end":8.669,"text":"Eyi ni orin segun t'a ko wonu","marked":"Èyí ni orin ṣẹ́gun t'á kó wọnú"},{"start":9.119,"end":9.934,"text":"Jerusalem","marked":"Jerusalẹm"},{"start":10.384,"end":12.19,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"}],"end":12.19},{"key":"CHORUS","start":13.14,"lines":[{"start":13.14,"end":16.176,"text":"Eyi l'Omo nla Dafidi ati Oba Israeli","marked":"Èyí l'Ọmọ ńlá Dafidi àti Ọba Ísírẹ́lì"},{"start":16.626,"end":18.318,"text":"Ogun ketekete lo fun igbala omo","marked":"Ogun kẹ́tẹ́kẹ́tẹ́ lọ fún ìgbàlà ọmọ"},{"start":18.768,"end":19.349,"text":"eniyan","marked":"ènìyàn"},{"start":19.799,"end":21.376,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"},{"start":21.826,"end":23.571,"text":"Hosana si Omo Dafidi.","marked":"Hosana sí Ọmọ Dafidi."}],"end":23.571},{"key":"2","start":24.521,"lines":[{"start":24.521,"end":26.106,"text":"Awon agbagba gbiyanju lati","marked":"Àwọn àgbàgbà gbìyànjú láti"},{"start":26.556,"end":27.355,"text":"pa won lenu mo","marked":"pa wọ́n lẹ́nu mọ́"},{"start":27.805,"end":29.149,"text":"Won tun nke Hosana","marked":"Wọ́n tún ńké Hosana"},{"start":29.599,"end":31.141,"text":"B'awon wonyi pa enu won mo","marked":"B'àwọn wọ̀nyí pa ẹnu wọn mọ́"},{"start":31.591,"end":32.773,"text":"okuta yo soro","marked":"òkúta yó sọ̀rọ̀"},{"start":33.223,"end":34.95,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"}],"end":34.95},{"key":"3","start":35.9,"lines":[{"start":35.9,"end":37.586,"text":"E so fun omo binrin Sion pe","marked":"Ẹ sọ fún ọmọ bìnrin Sion pé"},{"start":38.036,"end":39.017,"text":"Oba re mbo wa","marked":"Ọba rẹ̀ mbọ̀ wá"},{"start":39.467,"end":41.219,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"},{"start":41.669,"end":44.552,"text":"O tenu, O si joko lori omo Ketekete","marked":"Ó tẹnu, Ó sì jókò lórí ọmọ Kẹ́tẹ́kẹ́tẹ́"},{"start":45.002,"end":46.828,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"}],"end":46.828},{"key":"4","start":47.778,"lines":[{"start":47.778,"end":49.612,"text":"Olubukun I'Eni ti mbo wa l'oruko","marked":"Olùbùkún l'Ẹni tí mbọ̀ wà l'orúkọ"},{"start":50.062,"end":50.657,"text":"Oluwa","marked":"Olúwa"},{"start":51.107,"end":52.723,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"},{"start":53.173,"end":55.335,"text":"E te okan yin si ona fun Kristi","marked":"Ẹ tẹ́ ọkàn yín sí ọ̀nà fún Kristi"},{"start":55.785,"end":56.517,"text":"Oba Ogo","marked":"Ọba Ògo"},{"start":56.967,"end":58.991,"text":"Hosana! Hosana!","marked":"Hosana! Hosana!"}],"end":58.991}]}