{"v":3,"coll":"y","num":491,"id":"hymn_491","title":"EMI iwosan sokale wa","duration":66.562,"voices":{"male":{"file":"y-491-male-v3.m4a","bytes":465089,"sha256":"5d45720e5f2274358a2034695b370bffed4b9417a03e180e97626b470b14b913","duration":66.6},"female":{"file":"y-491-female-v3.m4a","bytes":475868,"sha256":"e7cd08609cdb5976a04d180ce3d0e2d45c32985eff62ec052d69018dd5c2a259","duration":66.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.697,"text":"EMI iwosan sokale wa","marked":"Èmi ìwòsàn sọ̀kalẹ̀ wá"},{"start":2.147,"end":3.524,"text":"Wa pelu agbara Re","marked":"Wá pẹ̀lú agbára Rẹ"},{"start":3.974,"end":5.7,"text":"Wa pelu ogo at'Ola Re","marked":"Wà pẹ̀lú ògo àt'ọlá Rẹ"},{"start":6.15,"end":7.357,"text":"Wa pelu Ase Nla Re","marked":"Wà pẹ̀lú Àṣẹ Ńlá Rẹ"}],"end":7.357},{"key":"CHORUS","start":8.307,"lines":[{"start":8.307,"end":9.574,"text":"Wo iranse re san","marked":"Wo ìránṣẹ́ rẹ sàn"},{"start":10.024,"end":11.004,"text":"Fun ni alafia","marked":"Fún ní àlàáfíà"},{"start":11.454,"end":12.588,"text":"Fun ni ara lile","marked":"Fún ní ara líle"},{"start":13.038,"end":14.3,"text":"K'emi re s'owon loju Re.","marked":"K'èmi rẹ̀ s'ọ̀wọ̀n lójú Rẹ̀."}],"end":14.3},{"key":"2","start":15.25,"lines":[{"start":15.25,"end":16.634,"text":"Emi iwosan sokale wa","marked":"Èmi ìwòsàn sọ̀kalẹ̀ wá"},{"start":17.084,"end":18.326,"text":"Dar'ese omo re ji","marked":"Dár'ẹ̀ṣẹ̀ ọmọ rẹ̀ jì"},{"start":18.776,"end":20.045,"text":"Ki o ya omo Re si mimo","marked":"Kí ó ya ọmọ Rẹ̀ sí mímọ́"},{"start":20.495,"end":22.535,"text":"Ki ebe wa je itewogba.","marked":"Kí ẹ̀bẹ̀ wá jẹ́ ìtẹ́wọ́gbà."}],"end":22.535},{"key":"3","start":23.485,"lines":[{"start":23.485,"end":25.016,"text":"Emi ti nji oku did e","marked":"Èmi ti ǹjí òkú dìd ẹ"},{"start":25.466,"end":27.129,"text":"Emi to ba Elisah sise","marked":"Èmi tó bá Eliṣah ṣiṣẹ́"},{"start":27.579,"end":29.117,"text":"Emi to ba Elijah sise","marked":"Èmi tó bá Elijah ṣiṣẹ́"},{"start":29.567,"end":31.188,"text":"Sokale l'agbara Re e.","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀ ẹ́."}],"end":31.188},{"key":"4","start":32.138,"lines":[{"start":32.138,"end":33.64,"text":"Emi ti n gbe ro dide","marked":"Èmi tí ń gbé ró dìde"},{"start":34.09,"end":35.813,"text":"Emi to ba Peteru sise","marked":"Èmi tó bá Peteru ṣiṣẹ́"},{"start":36.263,"end":37.833,"text":"Emi to ba Johanu sise","marked":"Èmi tó bá Johanu ṣiṣẹ́"},{"start":38.283,"end":39.735,"text":"Sokale l'agbara Re e.","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀ ẹ́."}],"end":39.735},{"key":"5","start":40.685,"lines":[{"start":40.685,"end":42.511,"text":"Emi ti nso oku d'alaye","marked":"Èmi ti ńṣọ́ òkú d'àlàyé"},{"start":42.961,"end":44.46,"text":"Emi to ba Mose sise","marked":"Èmi tó bá Mósè ṣiṣẹ́"},{"start":44.91,"end":46.072,"text":"Orimolade Baba wa","marked":"Orímọ́ládé Baba wa"},{"start":46.522,"end":47.929,"text":"Wa pelu Ase Nla Re.","marked":"Wà pẹ̀lú Àṣẹ Ńlá Rẹ."}],"end":47.929},{"key":"6","start":48.879,"lines":[{"start":48.879,"end":50.531,"text":"Emi to nla oju afoju","marked":"Èmi tó ńlá ojú afọ́jú"},{"start":50.981,"end":52.238,"text":"Emi to nwo alarun san","marked":"Èmi tó ńwọ alárùn sàn"},{"start":52.688,"end":54.324,"text":"Emi ti ns'adete di mimo","marked":"Èmi tí ńṣ'adẹ́tẹ̀ di mímọ́"},{"start":54.774,"end":56.314,"text":"Emi ti nsise iyanu nla.","marked":"Èmi ti ńṣiṣẹ́ ìyanu ńlá."}],"end":56.314},{"key":"7","start":57.264,"lines":[{"start":57.264,"end":58.85,"text":"Emi ti nwo asinwin san,","marked":"Èmi ti ńwọ asínwín sàn"},{"start":59.3,"end":60.535,"text":"Emi ti nporo ofa ota","marked":"Èmi ti ńpọ̀rọ̀ ọfà ọ̀tá"},{"start":60.985,"end":63.058,"text":"Emi ti nsegun agbara aje","marked":"Èmi ti ńṣẹ́gun agbára ajé"},{"start":63.508,"end":65.014,"text":"Emi Ito Alafia.","marked":"Ẹ̀mí Ìtọ́ Àlàáfíà."}],"end":65.014}]}