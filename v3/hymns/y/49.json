{"v":3,"coll":"y","num":49,"id":"hymn_49","title":"OLUGBALA gbohun mi","duration":57.91,"voices":{"male":{"file":"y-49-male-v3.m4a","bytes":405446,"sha256":"24de7324cb47a33a7b175ecd50498fc82d0de4a8bbbf0b18291037848875c16f","duration":58.0},"female":{"file":"y-49-female-v3.m4a","bytes":414733,"sha256":"80a4e690de853df64f9cd83c301474b26bbefa1cf18b42edd96df702bf0c7bef","duration":58.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.433,"text":"OLUGBALA gbohun mi,","marked":"Olùgbàlà gbóhùn mi"},{"start":1.883,"end":3.225,"text":"Gbohun mi, gbohun mi,","marked":"Gbóhùn mi, gbóhùn mi"},{"start":3.675,"end":4.893,"text":"Mo wa sodo Re gba mi","marked":"Mo wá sọ́dọ̀ Rẹ gbà mí"},{"start":5.343,"end":6.472,"text":"Nibi agbelebu,","marked":"Níbi àgbélébùú"},{"start":6.922,"end":8.63,"text":"Emi se, sugbon O ku","marked":"Èmi ṣe, ṣùgbọ́n Ó kú"},{"start":9.08,"end":10.479,"text":"Iwọ ku, Iwọ ku,","marked":"Ìwọ kú, Ìwọ kú"},{"start":10.929,"end":12.085,"text":"Fi anu Re pa mi mo,","marked":"Fi àánú Rẹ pa mí mọ́"},{"start":12.535,"end":19.598,"text":"Nibi agbelebu. Oluwa jọ gba mi N k'y'o bi Ọ ninu mọ! Alabukun gba mi Nibi Agbelebu","marked":"Níbi àgbélébùú. Olúwa jọ gbà mí Ń k'y'ọ́ bí Ọ nínú mọ́! Alábùkún gbà mí Níbi Àgbélébùú"}],"end":19.598},{"key":"CHORUS","start":20.548,"lines":[{"start":20.548,"end":21.683,"text":"Oluwa jo gba mi","marked":"Olúwa jọ gbà mí"},{"start":22.133,"end":23.443,"text":"Nk'y'o bi O ninu mo!","marked":"Ǹk'y'ó bí Ọ nínú mọ́!"},{"start":23.893,"end":25.057,"text":"Alabukun gba mi","marked":"Alábùkún gbà mí"},{"start":25.507,"end":26.658,"text":"Nibi Agbelebu.","marked":"Níbi Àgbélébùú."}],"end":26.658},{"key":"2","start":27.608,"lines":[{"start":27.608,"end":28.987,"text":"Tori ki n ma ba segbe,","marked":"Torí kí n má bá ṣègbé"},{"start":29.437,"end":31.331,"text":"N ó bẹbẹ! N ó bẹbẹ!","marked":"N ó bẹ̀bẹ̀! N ó bẹ̀bẹ̀!"},{"start":31.781,"end":32.931,"text":"Iwọ ni ọna iye","marked":"Ìwọ ni ọ̀nà ìyè"},{"start":33.381,"end":34.603,"text":"Nibi agbelebu,","marked":"Níbi àgbélébùú"},{"start":35.053,"end":36.276,"text":"Ore-ọfẹ Rẹ t'a gba","marked":"Ore-ọfẹ Rẹ t'á gbà"},{"start":36.726,"end":38.301,"text":"Lọfẹ ni! lọfẹ ni!","marked":"Lọ́fẹ́ ni! lọ́fẹ́ ni!"},{"start":38.751,"end":40.02,"text":"F'oju aanu Rẹ wo mi","marked":"F'ojú àánú Rẹ̀ wò mí"},{"start":40.47,"end":41.647,"text":"Nibi agbelebu.","marked":"Níbi àgbélébùú."}],"end":41.647},{"key":"3","start":42.597,"lines":[{"start":42.597,"end":43.855,"text":"F'ẹjẹ mimọ Rẹ wẹ mi,","marked":"F'ẹ̀jẹ̀ mímọ́ Rẹ wẹ mi"},{"start":44.305,"end":46.032,"text":"Fi wẹ mi! fi wẹ mi!","marked":"Fi wẹ̀ mi! fi wẹ̀ mi!"},{"start":46.482,"end":47.625,"text":"Ri mi sinu ibu Rẹ,","marked":"Rí mi sínú ibú Rẹ"},{"start":48.075,"end":49.292,"text":"Nibi agbelebu","marked":"Níbi àgbélébùú"},{"start":49.742,"end":51.003,"text":"Gbagbọ l'o le fun wa ni,","marked":"Gbàgbọ́ l'ó lè fún wa ni"},{"start":51.453,"end":52.85,"text":"'Dariji! 'Dariji!","marked":"dáríjì! dáríjì!"},{"start":53.3,"end":54.658,"text":"Mo f'igbagbọ rọ mọ Ọ","marked":"Mo f'ìgbàgbọ́ rọ̀ mọ́ Ọ"},{"start":55.108,"end":56.361,"text":"Nibi agbelebu.","marked":"Níbi àgbélébùú."}],"end":56.361}]}