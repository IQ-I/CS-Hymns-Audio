{"v":3,"coll":"y","num":317,"id":"hymn_317","title":"LO kede ayo na fun gbogbo aye","duration":93.784,"voices":{"male":{"file":"y-317-male-v3.m4a","bytes":679822,"sha256":"3761c3fa039d092e6832cd406097cfe3094acb66194c18f375742fa988bc0d22","duration":93.8},"female":{"file":"y-317-female-v3.m4a","bytes":700513,"sha256":"93b04780cf9e9f15803005c126b62230f284e6ab0a46469d72d336dfa88c3ba4","duration":93.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.291,"text":"LO kede ayo na fun gbogbo aiye","marked":"Lọ kéde ayọ̀ ná fún gbogbo ayé"},{"start":2.741,"end":4.289,"text":"P'Omo Olorun segun iku","marked":"P'Ọmọ Ọlọ́run ṣẹ́gun ikú"},{"start":4.739,"end":6.613,"text":"Fi iyin-tiyin pel'ayo rohin na,","marked":"Fi iyin-tiyin pẹ̀l'ayọ̀ ròhìn ná"},{"start":7.063,"end":8.421,"text":"Emi Mimo to gunwa.","marked":"Ẹ̀mí Mímọ́ tó gúnwà."},{"start":8.871,"end":9.626,"text":"Egbe: Oba mi de!","marked":"Ọba mi dé!"},{"start":10.076,"end":11.027,"text":"Asegun mi de!","marked":"Aṣẹ́gun mi dé!"},{"start":11.477,"end":13.836,"text":"Ogo, Ola at'agbara ati 'pa","marked":"Ògo, Ọlá àt'agbára àti pa"},{"start":14.286,"end":15.705,"text":"F 'Odagutan to gunwa.","marked":"F ọ̀dàgùtàn tó gúnwà."}],"end":15.705},{"key":"CHORUS","start":16.655,"lines":[{"start":16.655,"end":17.471,"text":"Oba mi de!","marked":"Ọba mi dé!"},{"start":17.921,"end":18.84,"text":"Asegun mi de!","marked":"Aṣẹ́gun mi dé!"},{"start":19.29,"end":21.647,"text":"Ogo, Ola at'agbara ati 'pa","marked":"Ògo, Ọlá àt'agbára àti pa"},{"start":22.097,"end":23.646,"text":"F 'Odagutan to gunwa.","marked":"F ọ̀dàgùtàn tó gúnwà."}],"end":23.646},{"key":"2","start":24.596,"lines":[{"start":24.596,"end":25.963,"text":"lyin Jesu l'awon","marked":"Ìyìn Jésù l'àwọn"},{"start":26.413,"end":27.386,"text":"Ange li nke","marked":"Àǹgẹ lí ńké"},{"start":27.836,"end":29.043,"text":"T'o wa ra 'raiye pada","marked":"T'ó wá ra ràìyè padà"},{"start":29.493,"end":31.665,"text":"Okan soso ajanaku ni Jesu,","marked":"Ọkàn ṣoṣo àjànàkú ni Jésù"},{"start":32.115,"end":33.468,"text":"T'o m'aiye pelu orun.","marked":"T'ó m'ayé pẹ̀lú ọ̀run."},{"start":33.918,"end":34.666,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":34.666},{"key":"3","start":35.616,"lines":[{"start":35.616,"end":37.269,"text":"Kabiyesi Oba Alaiyeluwa","marked":"Kábíyèsí Ọba Aláìyelúwa"},{"start":37.719,"end":39.287,"text":"Metalokan Alagbara","marked":"Mẹ́talọ́kan Alágbára"},{"start":39.737,"end":41.433,"text":"Awamaridi Olodumare","marked":"Àwamaridi Olódùmarè"},{"start":41.883,"end":42.901,"text":"T'o nse ise iyanu.","marked":"T'ó ńṣe iṣẹ́ ìyanu."},{"start":43.351,"end":44.135,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":44.135},{"key":"4","start":45.085,"lines":[{"start":45.085,"end":46.753,"text":"ltiju nla d a bo awon ika","marked":"Ìtìjú ńlá d á bo àwọn ìkà"},{"start":47.203,"end":48.637,"text":"T'o kan Oluwa wa mo 'gi","marked":"T'ó kan Olúwa wa mọ́ gi"},{"start":49.087,"end":51.401,"text":"Rikisi ikoko ota ti d' asan","marked":"Ríkìsí ìkòkò ọ̀tá ti d asán"},{"start":51.851,"end":53.276,"text":"Olugbala ji dide.","marked":"Olùgbàlà jí dìde."},{"start":53.726,"end":54.591,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":54.591},{"key":"5","start":55.541,"lines":[{"start":55.541,"end":57.349,"text":"Bi orile-ede enia dudu","marked":"Bí orile-ede ẹnìà dúdú"},{"start":57.799,"end":59.335,"text":"Ati ka wa si eweko","marked":"Àti ká wá sí ewéko"},{"start":59.785,"end":61.745,"text":"Sugbon awa ni Baba kan l'oke","marked":"Ṣùgbọ́n àwa ni Baba kan l'òkè"},{"start":62.195,"end":63.419,"text":"T'o mo pe 'se Re ni wa.","marked":"T'ó mọ̀ pé ṣe Rẹ̀ ni wá."},{"start":63.869,"end":64.662,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":64.662},{"key":"6","start":65.612,"lines":[{"start":65.612,"end":67.294,"text":"Ayo t'o wa ninu Ajinde","marked":"Ayọ̀ t'ó wà nínú Àjíǹde"},{"start":67.744,"end":69.007,"text":"Jowo fun wa Olugbala","marked":"Jọ̀wọ́ fún wa Olùgbàlà"},{"start":69.457,"end":71.808,"text":"'Gbat'a ba yo si O Eleda wa","marked":"gbàt'á bá yọ sí Ọ Ẹlẹ́dàá wa"},{"start":72.258,"end":73.823,"text":"K'awa le gb'ade ogo.","marked":"K'àwa lè gb'adé ògo."},{"start":74.273,"end":75.067,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":75.067},{"key":"7","start":76.017,"lines":[{"start":76.017,"end":77.738,"text":"Awa f'ogo fun Baba wa l'oke","marked":"Àwa f'ògo fún Baba wa l'òkè"},{"start":78.188,"end":79.452,"text":"A tun f'ogo fun Omo Re","marked":"A tún f'ògo fún Ọmọ Rẹ̀"},{"start":79.902,"end":81.732,"text":"Awa tun f'ogo fun O Emi Mimo","marked":"Àwa tún f'ògo fún Ọ Ẹ̀mí Mímọ́"},{"start":82.182,"end":83.573,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọ̀pẹ yẹ."},{"start":84.023,"end":84.815,"text":"Egbe: Oba mi de!","marked":"Ọba mi dé!"},{"start":85.265,"end":86.209,"text":"Asegun mi de!","marked":"Aṣẹ́gun mi dé!"},{"start":86.659,"end":89.306,"text":"Ogo, Ola at'agbara ati 'pa","marked":"Ògo, Ọlá àt'agbára àti pa"},{"start":89.756,"end":91.177,"text":"F 'Odagutan to gunwa.","marked":"F ọ̀dàgùtàn tó gúnwà."},{"start":91.627,"end":92.236,"text":"Amin.","marked":"Àmín."}],"end":92.236}]}