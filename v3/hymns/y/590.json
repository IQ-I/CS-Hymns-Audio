{"v":3,"coll":"y","num":590,"id":"hymn_590","title":"GBA AGBELEBU re ni Kristi wi","duration":45.419,"voices":{"male":{"file":"y-590-male-v3.m4a","bytes":316030,"sha256":"607cb6f72d07bc8982536de755963f826ea0d78656209009da1d30019b083155","duration":45.5},"female":{"file":"y-590-female-v3.m4a","bytes":327727,"sha256":"5313fa8888bc240fa11b6db29249b4e1bf7318e9035fa66de4ec33468df0f636","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.223,"text":"GB'AGBELEBU re ni Kristi wi","marked":"Gb'àgbélébù rẹ̀ ni Kristi wí"},{"start":2.673,"end":3.993,"text":"B'o ba fe s'omo ehin Mi","marked":"B'ó bá fẹ́ s'ọmọ ẹ̀hìn Mi"},{"start":4.443,"end":5.971,"text":"Se 'ra re ko aiye sile","marked":"Ṣe ra rẹ̀ kọ ayé sílẹ̀"},{"start":6.421,"end":7.971,"text":"Si ma fi 'rele tele mi.","marked":"Sì má fi rẹlẹ̀ tẹ́lẹ̀ mi."}],"end":7.971},{"key":"2","start":8.921,"lines":[{"start":8.921,"end":10.982,"text":"Gb'agbelebu re, ma je ki","marked":"Gb'àgbélébù rẹ, má jẹ́ kí"},{"start":11.432,"end":13.01,"text":"Iwuwo re fo o laiya","marked":"Ìwúwo rẹ̀ fọ́ ọ láìyá"},{"start":13.46,"end":14.921,"text":"Ipa mi y'o gb'emi re ro","marked":"Ipa mi y'ó gb'ẹ̀mí rẹ̀ rò"},{"start":15.371,"end":17.17,"text":"Y'o m'okan at'apa re le.","marked":"Y'ó m'ọkàn àt'apá rẹ̀ le."}],"end":17.17},{"key":"3","start":18.12,"lines":[{"start":18.12,"end":19.902,"text":"Gb'agbelebu re ma tiju","marked":"Gb'àgbélébù rẹ̀ má tijú"},{"start":20.352,"end":21.594,"text":"Ma je k'okan were re ko","marked":"Má jẹ́ k'ọkàn wèrè rẹ̀ kọ"},{"start":22.044,"end":23.306,"text":"Oluwa ru agbelebu","marked":"Olúwa rú àgbélébùú"},{"start":23.756,"end":25.184,"text":"Lati gba o lowo iku.","marked":"Láti gbà ọ́ lọ́wọ́ ikú."}],"end":25.184},{"key":"4","start":26.134,"lines":[{"start":26.134,"end":28.265,"text":"Gb'agbelebu re, ma tele","marked":"Gb'àgbélébù rẹ, má tẹ̀lé"},{"start":28.715,"end":30.344,"text":"Mase gbe sile tit'iku","marked":"Mase gbé sílẹ̀ tít'ikú"},{"start":30.794,"end":32.359,"text":"Enit' o ru agbelebu","marked":"Ẹnit ó ru àgbélébùú"},{"start":32.809,"end":34.602,"text":"L'o le reti lati d'ade.","marked":"L'ó lè retí láti d'adé."}],"end":34.602},{"key":"5","start":35.552,"lines":[{"start":35.552,"end":36.77,"text":"'Wo Olorun Metalokan","marked":"wo Ọlọ́run Mẹ́talọ́kan"},{"start":37.22,"end":38.954,"text":"L'a o ma yin titi aiye","marked":"L'á ó má yín títí ayé"},{"start":39.404,"end":41.067,"text":"Fun wa k'a le ri n'ile wa","marked":"Fún wa k'á lè rí n'ilé wa"},{"start":41.517,"end":42.856,"text":"Ayo orun ti ko lopin.","marked":"Ayọ̀ ọ̀run tí kò lópin."},{"start":43.306,"end":43.869,"text":"Amin.","marked":"Àmín."}],"end":43.869}]}