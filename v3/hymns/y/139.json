{"v":3,"coll":"y","num":139,"id":"hymn_139","title":"KURUBU e ho f'ayo","duration":80.613,"voices":{"male":{"file":"y-139-male-v3.m4a","bytes":587710,"sha256":"86db24b20b8aedcaa0488d0ff70e4460414f46d7f7a7d63e2077c08bc0e97fca","duration":80.7},"female":{"file":"y-139-female-v3.m4a","bytes":601822,"sha256":"d78f7a20b3d83fda942f4977cbc12ebead89c9d001eb6ab55ca34a0aed96579b","duration":80.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.919,"text":"KERUBU e ho f'ayo","marked":"Kérúbù ẹ hó f'ayọ̀"},{"start":2.369,"end":3.717,"text":"K'a f'ope f'Olorun wa,","marked":"K'á f'ọpẹ́ f'Ọlọ́run wa"},{"start":4.167,"end":5.709,"text":"Fun idasi wa oni,","marked":"Fún ìdásí wa òní"},{"start":6.159,"end":18.587,"text":"Iyin fun Metalokan. Ẹ ho ye, Kérúbù, ẹ gbe'rin, Ẹ ho ye, Séráfù, ẹ gberin, Halleluyah, Halleluyah, Halleluyah, s'Ọba wa.","marked":"Ìyìn fún Mẹ́talọ́kan. Ẹ hó yẹ, Kérúbù, ẹ gbé'rin, Ẹ hó yẹ, Séráfù, ẹ gberin, Hallelúyà, Hallelúyà, Hallelúyà, s'Ọba wa."}],"end":18.587},{"key":"CHORUS","start":19.537,"lines":[{"start":19.537,"end":22.592,"text":"E ho ye, Kerubu, e gbe 'rin","marked":"Ẹ hó yẹ, Kérúbù, ẹ gbé rìn"},{"start":23.042,"end":25.833,"text":"E ho ye, Serafu, egbe 'rin","marked":"Ẹ hó yẹ, Séráfù, ẹgbẹ́ rìn"},{"start":26.283,"end":28.141,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":28.591,"end":30.503,"text":"Halleluyah, s'Oba wa.","marked":"Hallelúyà, s'Ọba wa."}],"end":30.503},{"key":"2","start":31.453,"lines":[{"start":31.453,"end":32.794,"text":"Oluwa, gba ore wa","marked":"Olúwa, gba ọrẹ wa"},{"start":33.244,"end":34.61,"text":"Fun ajodun t'oni yi,","marked":"Fún àjọ̀dún t'óní yí"},{"start":35.06,"end":36.35,"text":"Ran 'bukun Re s'ori wa","marked":"Rán bùkún Rẹ̀ s'orí wa"},{"start":36.8,"end":38.371,"text":"Fun wa ni ayo kikun.","marked":"Fún wa ní ayọ̀ kíkún."}],"end":38.371},{"key":"3","start":39.321,"lines":[{"start":39.321,"end":40.328,"text":"Yin Ọlọrun Ọba wa,","marked":"Yín Ọlọ́run Ọba wa"},{"start":40.778,"end":41.887,"text":"Ẹ gbe ohun iyin ga;","marked":"Ẹ gbé ohun ìyìn ga"},{"start":42.337,"end":43.512,"text":"Fun ifẹ ojojumọ,","marked":"Fún ìfẹ́ ojojúmọ́"},{"start":43.962,"end":45.116,"text":"Orisun ayọ gbogbo.","marked":"Orísun ayọ̀ gbogbo."}],"end":45.116},{"key":"4","start":46.066,"lines":[{"start":46.066,"end":47.351,"text":"Fun wa l'ounjẹ ojọ wa,","marked":"Fún wa l'oúnjẹ ojọ́ wa"},{"start":47.801,"end":49.274,"text":"At'asọ to yẹ fun wa;","marked":"Àt'asọ tó yẹ fún wa"},{"start":49.724,"end":50.841,"text":"Ki ọmọ Rẹ ma rahun mọ,","marked":"Kí ọmọ Rẹ má ráhùn mọ́"},{"start":51.291,"end":52.868,"text":"Sure fun wa lọjọ ayé wa.","marked":"Súre fún wa lọ́jọ́ ayé wa."}],"end":52.868},{"key":"5","start":53.818,"lines":[{"start":53.818,"end":54.969,"text":"Ẹyin Ijọ Aladura,","marked":"Ẹ̀yin Ìjọ Aládúrà"},{"start":55.419,"end":56.645,"text":"K'ẹ mura si adura;","marked":"K'ẹ múra sí àdúrà"},{"start":57.095,"end":58.589,"text":"Orin isẹgun l'a o kọ,","marked":"Orin ìsẹ́gun l'a ó kọ"},{"start":59.039,"end":60.321,"text":"Lagbara Mẹtalọkan.","marked":"Lágbára Mẹ́talọ́kan."}],"end":60.321},{"key":"6","start":61.271,"lines":[{"start":61.271,"end":62.72,"text":"Jowo Jehofa Mimo","marked":"Jọ̀wọ́ Jèhófà Mímọ́"},{"start":63.17,"end":64.576,"text":"M'ese Ijọ wa duro","marked":"M'ẹsẹ̀ Ìjọ wa dúró"},{"start":65.026,"end":66.31,"text":"Jehofa Nissi Baba","marked":"Jèhófà Nissi Baba"},{"start":66.76,"end":79.064,"text":"K'a le sin O de opin. Ẹ ho ye, Kérúbù, ẹ gbe'rin, Ẹ ho ye, Séráfù, ẹ gbe‘rin, Halleluyah, Halleluyah, Halleluyah, s'Ọba wa.","marked":"K'á lè sìn Ó dé òpin. Ẹ hó yẹ, Kérúbù, ẹ gbẹ̀'rìn, Ẹ hó yẹ, Séráfù, ẹ gbẹ̀'rìn, Hallelúyà, Hallelúyà, Hallelúyà, s'Ọba wa."}],"end":79.064}]}