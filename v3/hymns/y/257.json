{"v":3,"coll":"y","num":257,"id":"hymn_257","title":"JESU, nigba 'danwo","duration":54.943,"voices":{"male":{"file":"y-257-male-v3.m4a","bytes":375115,"sha256":"0a0cb11f4e70e7b20f3e3cf2270a4d55a9fb79665b41bf43ae7962bb707c79df","duration":55.0},"female":{"file":"y-257-female-v3.m4a","bytes":392103,"sha256":"70351c9a58254f59e997a84deb0df178b649827b9e73864251d2c44c4688ef46","duration":55.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.017,"text":"JESU, nigba 'danwo,","marked":"Jésù, nígbà dánwò"},{"start":2.467,"end":3.43,"text":"Gbadura fun mi,","marked":"Gbàdúrà fún mi"},{"start":3.88,"end":4.974,"text":"K' emi ma ba sẹ Ọ,","marked":"K èmi má bá sẹ́ Ọ"},{"start":5.424,"end":6.556,"text":"Ki n si sako lọ;","marked":"Kí n sì ṣáko lọ"},{"start":7.006,"end":8.279,"text":"'Gba mba siyemeji,","marked":"gbà mbá ṣiyèméjì"},{"start":8.729,"end":9.77,"text":"K'O bojuwo mi;","marked":"K'Ó bojúwò mi"},{"start":10.22,"end":11.737,"text":"K' ẹru tab' isaju.","marked":"K ẹrú tàb ìṣájú."},{"start":12.187,"end":13.154,"text":"Ma mu mi subu.","marked":"Má mú mi ṣubú."}],"end":13.154},{"key":"2","start":14.104,"lines":[{"start":14.104,"end":15.588,"text":"B'aye ba si n fa mi,","marked":"B'ayé bá sì ń fà mí"},{"start":16.038,"end":16.929,"text":"Pẹlu adun rẹ;","marked":"Pẹ̀lú adùn rẹ̀"},{"start":17.379,"end":18.405,"text":"T' Ohun 'sura aye,","marked":"T Ohun ṣúra ayé"},{"start":18.855,"end":19.975,"text":"Fẹ han mi l'emọ;","marked":"Fẹ́ hàn mí l'èmọ̀"},{"start":20.425,"end":21.688,"text":"Jọ mu Gatsemane,","marked":"Jọ mú Gatṣemane"},{"start":22.138,"end":23.249,"text":"Wa s'iranti mi,","marked":"Wá s'ìrántí mi"},{"start":23.699,"end":24.607,"text":"Tabi irora Rẹ,","marked":"Tàbí ìrora Rẹ"},{"start":25.057,"end":26.36,"text":"Loke Kalfari.","marked":"Lókè Kalfárì."}],"end":26.36},{"key":"3","start":27.31,"lines":[{"start":27.31,"end":28.542,"text":"B'O ba pọn mi loju,","marked":"B'Ó bá pọ́n mi lójú"},{"start":28.992,"end":29.927,"text":"Ninu ifẹ Rẹ;","marked":"Nínú ìfẹ́ Rẹ"},{"start":30.377,"end":31.66,"text":"Da ibukun Rẹ le;","marked":"Dá ìbùkún Rẹ lé"},{"start":32.11,"end":32.991,"text":"Ori ẹbọ na:","marked":"Orí ẹbọ ná"},{"start":33.441,"end":34.677,"text":"Ki n f'ara mi fun Ọ,","marked":"Kí n f'ara mi fún Ọ"},{"start":35.127,"end":36.183,"text":"Lori pẹpẹ Rẹ;","marked":"Lórí pẹpẹ Rẹ"},{"start":36.633,"end":37.95,"text":"B'ara kọ ago na","marked":"B'ara kọ́ àgọ́ ná"},{"start":38.4,"end":39.522,"text":"Igbagbọ y'o mu.","marked":"Ìgbàgbọ́ y'ó mú."}],"end":39.522},{"key":"4","start":40.472,"lines":[{"start":40.472,"end":41.626,"text":"p 'Gba mo ba n re 'boji,","marked":"p gbà mo bá ń rẹ bojì"},{"start":42.076,"end":43.226,"text":"Sinu ekuru;","marked":"Sínú ekuru"},{"start":43.676,"end":44.912,"text":"T'ogo ọrun si n kọ,","marked":"T'ògo ọ̀run sì ń kọ"},{"start":45.362,"end":46.348,"text":"Leti bebe na;","marked":"Létí bẹ̀bẹ̀ ná"},{"start":46.798,"end":48.065,"text":"N o gbẹkẹl' ootọ Rẹ,","marked":"N ó gbẹkẹl' òótọ́ Rẹ"},{"start":48.515,"end":49.699,"text":"N' ijakadi 'ku;","marked":"N ìjàkadì kú"},{"start":50.149,"end":51.214,"text":"Oluwa, gb'ẹmi mi,","marked":"Olúwa, gb'ẹ̀mí mi"},{"start":51.664,"end":53.394,"text":"S' iye ailopin.","marked":"Ṣ iye àìlópin."}],"end":53.394}]}