{"v":3,"coll":"y","num":696,"id":"hymn_696","title":"OGUN Orun, e wa ba wa yo","duration":40.553,"voices":{"male":{"file":"y-696-male-v3.m4a","bytes":274398,"sha256":"7eee279b68c890227f34155a71e75c30f7866cedd487f6243538261e62ff459b","duration":40.6},"female":{"file":"y-696-female-v3.m4a","bytes":281690,"sha256":"7c7847eef37f45566be6075b7fc3b1e96ae178e8ae132bf15ede39a3a5b9fbfd","duration":40.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.583,"text":"OGUN Orun, e wa ba wa yo","marked":"Ogun Ọ̀run, ẹ wá bá wa yọ̀"},{"start":3.033,"end":4.313,"text":"Fun ile t'a nsi loni","marked":"Fún ilẹ̀ t'á ńṣi lónì"},{"start":4.763,"end":6.373,"text":"Awa be O Jesu baba wa","marked":"Àwa bẹ̀ Ọ́ Jésù Baba wa"},{"start":6.823,"end":8.17,"text":"Ma sai bukun wa loni.","marked":"Má ṣàì bùkún wa lónì."}],"end":8.17},{"key":"CHORUS","start":9.12,"lines":[{"start":9.12,"end":11.078,"text":"Yala Eru l'o nkepe O","marked":"Yálà Ẹ̀rù l'ó ńkẹpẹ Ọ"},{"start":11.528,"end":13.709,"text":"Tabi ominira, Baba","marked":"Tàbí òmìnira, Baba"},{"start":14.159,"end":15.448,"text":"Ko gbo n'ile yi.","marked":"Kò gbọ́ n'ilẹ̀ yí."}],"end":15.448},{"key":"2","start":16.398,"lines":[{"start":16.398,"end":18.051,"text":"Awa dupe lowo Re Baba","marked":"Àwa dúpẹ́ lọ́wọ́ Rẹ̀ Baba"},{"start":18.501,"end":19.815,"text":"T'o mu ileri Re se","marked":"T'ó mú ìlérí Rẹ̀ ṣe"},{"start":20.265,"end":21.818,"text":"Baba se leri fun Kerubu","marked":"Baba ṣe lérí fún Kérúbù"},{"start":22.268,"end":23.703,"text":"O mu se fun Serafu.","marked":"Ó mú ṣe fún Séráfù."}],"end":23.703},{"key":"3","start":24.653,"lines":[{"start":24.653,"end":26.253,"text":"Baba se 'leri fun Abraham","marked":"Baba ṣe lérí fún Abraham"},{"start":26.703,"end":28.14,"text":"O mu se fun Isaaki","marked":"Ó mú ṣe fún Isaaki"},{"start":28.59,"end":30.016,"text":"Baba se 'leri fun Dafidi","marked":"Baba ṣe lérí fún Dafidi"},{"start":30.466,"end":31.853,"text":"O mu se fun Solomon.","marked":"Ó mú ṣe fún Solomon."}],"end":31.853},{"key":"4","start":32.803,"lines":[{"start":32.803,"end":34.199,"text":"Ogo ati Ola fun Baba","marked":"Ògo àti Ọlá fún Baba"},{"start":34.649,"end":35.808,"text":"Ogo F'Omo Re pelu","marked":"Ògo F'Ọmọ Rẹ̀ pẹ̀lú"},{"start":36.258,"end":37.897,"text":"Ogo ati ola fun Eni.","marked":"Ògo àti ọlá fún Ẹni."},{"start":38.347,"end":39.003,"text":"Amin.","marked":"Àmín."}],"end":39.003}]}