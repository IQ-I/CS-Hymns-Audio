{"v":3,"coll":"y","num":712,"id":"hymn_712","title":"EGBE Kerubu to jade","duration":85.953,"voices":{"male":{"file":"y-712-male-v3.m4a","bytes":599782,"sha256":"53714d74cd864d75c375ca62e2809b83fb5723621f70b5aa25a9c5c6d9e60421","duration":86.0},"female":{"file":"y-712-female-v3.m4a","bytes":612052,"sha256":"ea8c5e7c991e27f1995333b8d52966d5d2b45ea6f16eeabdeeec91d39e85c8d3","duration":86.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.026,"text":"ẸGBẸ Kérúbù to jade,","marked":"Ẹgbẹ́ Kérúbù tó jáde"},{"start":2.476,"end":3.728,"text":"Awa lo n s'ajọdun wa,","marked":"Àwa ló ń s'àjọ̀dún wa"},{"start":4.178,"end":5.722,"text":"K'ogun ọrun ba wa gberin,","marked":"K'ogun ọ̀run bá wá gbẹ́rin"},{"start":6.172,"end":7.579,"text":"K'arayé gbohun soke,","marked":"K'arayé gbóhùn sókè"}],"end":7.579},{"key":"CHORUS","start":8.529,"lines":[{"start":8.529,"end":10.438,"text":"Halleluya, Halleluya","marked":"Hallelúyà, Hallelúyà"},{"start":10.888,"end":12.282,"text":"T'ewe t'agba ko gbe rin - 2ce","marked":"T'èwe t'àgbà kò gbé rìn"}],"end":12.282},{"key":"2","start":13.232,"lines":[{"start":13.232,"end":14.698,"text":"Ope lo ye f'Olugbala","marked":"Ọpẹ́ ló yẹ f'Olùgbàlà"},{"start":15.148,"end":16.489,"text":"Fun idasi wa oni","marked":"Fún ìdásí wa òní"},{"start":16.939,"end":18.267,"text":"Ota ka wa nibi gbogbo","marked":"Ọ̀tá ká wà níbi gbogbo"},{"start":18.717,"end":20.24,"text":"Sugbon Jesu ko wa yo.","marked":"Ṣùgbọ́n Jésù kò wá yọ̀."}],"end":20.24},{"key":"3","start":21.19,"lines":[{"start":21.19,"end":22.474,"text":"Emi Mimo ko pelu wa","marked":"Ẹ̀mí Mímọ́ kò pẹ̀lú wa"},{"start":22.924,"end":24.769,"text":"L'okunrin at'lobinrin","marked":"L'ọkùnrin àt'lobìnrin"},{"start":25.219,"end":26.596,"text":"kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":27.046,"end":28.589,"text":"K'a pade n'ijo t'orun.","marked":"K'á pàdé n'ìjọ t'ọ̀run."}],"end":28.589},{"key":"4","start":29.539,"lines":[{"start":29.539,"end":30.563,"text":"Olorun Olodumare","marked":"Ọlọ́run Olódùmarè"},{"start":31.013,"end":32.134,"text":"Obangiji Oba wa","marked":"Ọbangíjì Ọba wa"},{"start":32.584,"end":34.219,"text":"Ma je k'ebi ale pa wa","marked":"Má jẹ́ k'ebi alẹ́ pa wá"},{"start":34.669,"end":36.092,"text":"K'enikeni ma pose.","marked":"K'ẹnikẹ́ni má pòṣé."}],"end":36.092},{"key":"5","start":37.042,"lines":[{"start":37.042,"end":38.315,"text":"Kérúbù pẹlu ogun rẹ,","marked":"Kérúbù pẹ̀lú ogun rẹ̀"},{"start":38.765,"end":39.851,"text":"Ni awọn ariran n ri;","marked":"Ní àwọn aríran ń rí"},{"start":40.301,"end":42.152,"text":"Holy Maikeli pẹlu 'da Rẹ,","marked":"Holy Maikeli pẹ̀lú dá Rẹ̀"},{"start":42.602,"end":44.099,"text":"O n gẹsin poyi wa ka.","marked":"Ó ń gẹsin pòyì wá ká."}],"end":44.099},{"key":"6","start":45.049,"lines":[{"start":45.049,"end":46.308,"text":"Abo Oluwa Onike","marked":"Abo Olúwa Oníkẹ̀"},{"start":46.758,"end":48.006,"text":"L'awa Egbe bora mo","marked":"L'àwa Ẹgbẹ́ bora mọ́"},{"start":48.456,"end":50.099,"text":"Ko s'ohun ibi to le se wa","marked":"Kò s'ohun ibi tó lè ṣe wá"},{"start":50.549,"end":51.746,"text":"Lagbara Metalokan.","marked":"Lágbára Mẹ́talọ́kan."}],"end":51.746},{"key":"7","start":52.696,"lines":[{"start":52.696,"end":54.461,"text":"Eni l'oyun a bimo la","marked":"Ẹni l'oyún a bímọ là"},{"start":54.911,"end":56.031,"text":"Agan a f'owo bosun","marked":"Àgàn a f'ọwọ́ bọ̀sùn"},{"start":56.481,"end":57.842,"text":"Olomo ko ni padanu","marked":"Ọlọ́mọ kò ní pàdánù"},{"start":58.292,"end":59.971,"text":"Iku ko ni ri wa gbe se.","marked":"Ikú kò ní rí wa gbé ṣe."}],"end":59.971},{"key":"8","start":60.921,"lines":[{"start":60.921,"end":62.413,"text":"Gbogbo awon ti ko ri se","marked":"Gbogbo àwọn tí kò rí ṣe"},{"start":62.863,"end":64.108,"text":"L'okunrin l'obinrin","marked":"L'ọkùnrin l'obìnrin"},{"start":64.558,"end":65.919,"text":"Ipese Olodumare","marked":"Ìpèsè Olódùmarè"},{"start":66.369,"end":67.666,"text":"Awamaridi lo je.","marked":"Àwamaridi ló jẹ́."}],"end":67.666},{"key":"9","start":68.616,"lines":[{"start":68.616,"end":70.231,"text":"Ẹ wa ba wa k'Alleluya,","marked":"Ẹ wá bá wa k'Allelúyà"},{"start":70.681,"end":72.022,"text":"F'ọdun miran Kérúbù,","marked":"F'ọdún míràn Kérúbù"},{"start":72.472,"end":74.049,"text":"T'Oluwa d'ẹgbẹ na silẹ,","marked":"T'Olúwa d'ẹ̀gbẹ́ ná sílẹ̀"},{"start":74.499,"end":75.836,"text":"Larin Ẹgbẹ Séráfù.","marked":"Lárin Ẹgbẹ́ Séráfù."}],"end":75.836},{"key":"10","start":76.786,"lines":[{"start":76.786,"end":78.247,"text":"Ọba aw'Ẹgbẹ Kérúbù,","marked":"Ọba àw'Ẹgbẹ́ Kérúbù"},{"start":78.697,"end":80.096,"text":"Jesu Kristi Oluwa,","marked":"Jésù Kristi Olúwa"},{"start":80.546,"end":82.614,"text":"Awa n kọrin, awa si n yọ,","marked":"Àwa ń kọrin, àwa sì ń yọ̀"},{"start":83.064,"end":84.404,"text":"Ogo fun Ọd'aguntan.","marked":"Ògo fún Ọd'àgùntàn."}],"end":84.404}]}