{"v":3,"coll":"y","num":620,"id":"hymn_620","title":"EMI Olorun wa","duration":15.634,"voices":{"male":{"file":"y-620-male-v3.m4a","bytes":103519,"sha256":"cd21a4d28638c3d5c790344324c757c3ff92ec04b85a7f3bc9bdcce85c612c76","duration":15.7},"female":{"file":"y-620-female-v3.m4a","bytes":108422,"sha256":"878c595353b2e4b3092331e1fb5e621f5ea4bbf97df05a624161f5bd5fe8e22b","duration":15.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.218,"text":"EMI Olorun wa,","marked":"Ẹ̀mí Ọlọ́run wa"},{"start":1.668,"end":2.901,"text":"Baptis awon wonyi","marked":"Baptis àwọn wọ̀nyí"},{"start":3.351,"end":4.625,"text":"Ba won da majemu mimo","marked":"Bá wọn dá májẹ̀mú mímọ́"},{"start":5.075,"end":6.211,"text":"We won kuro l'ese.","marked":"Wẹ̀ wọn kúrò l'ẹ̀ṣẹ̀."}],"end":6.211},{"key":"2","start":7.161,"lines":[{"start":7.161,"end":8.466,"text":"F'ọpa esu tutu,","marked":"F'ọ̀pá èṣù tútù"},{"start":8.916,"end":10.051,"text":"Wẹ wọn n'nu ẹjẹ Rẹ;","marked":"Wẹ̀ wọ́n n'nú ẹ̀jẹ̀ Rẹ"},{"start":10.501,"end":12.489,"text":"Baba, Ọmọ, Ẹmi Mimọ ,","marked":"Baba, Ọmọ, Ẹ̀mí Mímọ́"},{"start":12.939,"end":14.084,"text":"Sọ wọn di ọmọ Rẹ.","marked":"Sọ wọ́n di ọmọ Rẹ̀."}],"end":14.084}]}