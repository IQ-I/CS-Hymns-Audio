{"v":3,"coll":"y","num":354,"id":"hymn_354","title":"F'AWON Ijo ti n sinmi","duration":297.284,"voices":{"male":{"file":"y-354-male-v3.m4a","bytes":2120960,"sha256":"ea7e0bc07296ca5373715260b44f6875ae40d37840e1493f0a6e5eb6e1673194","duration":297.3},"female":{"file":"y-354-female-v3.m4a","bytes":2208050,"sha256":"e5a647e019cf238e6ad4e2067212d07a1ca29b07e6b224d8c55e4f583acdef79","duration":297.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.784,"text":"F'AWON Ijo ti nsimi","marked":"F'Àwọn Ìjọ ti ńṣimí"},{"start":2.234,"end":3.435,"text":"Awa ijo t'aiye","marked":"Àwa ìjọ t'ayé"},{"start":3.885,"end":5.11,"text":"A f'iyin gbogbo fun o","marked":"A f'ìyìn gbogbo fún ọ"},{"start":5.56,"end":6.794,"text":"Jesu olubukun","marked":"Jésù olùbùkún"},{"start":7.244,"end":8.882,"text":"Oluwa, o ti segun","marked":"Olúwa, ó ti ṣẹ́gun"},{"start":9.332,"end":10.419,"text":"Ki nwon ba le segun","marked":"Kí wọ́n bá lè ṣẹ́gun"},{"start":10.869,"end":11.983,"text":"'Mole ade ogo won","marked":"mọ́lẹ̀ adé ògo wọn"},{"start":12.433,"end":13.789,"text":"Lat'odo re wa ni.","marked":"Lát'ọ̀dọ̀ rẹ̀ wà ni."}],"end":13.789},{"key":"2","start":14.739,"lines":[{"start":14.739,"end":15.87,"text":"A yin o fun 'ranse re","marked":"A yìn ọ́ fún ránṣẹ́ rẹ"},{"start":16.32,"end":17.37,"text":"Ti o ko j'ipe re","marked":"Tí ó kò j'ìpè rẹ̀"},{"start":17.82,"end":18.954,"text":"T'o mu arakunrin re,","marked":"T'ó mú arákùnrin rẹ̀"},{"start":19.404,"end":20.951,"text":"Wa, lati ri Kristi","marked":"Wá, láti rí Kristi"},{"start":21.401,"end":22.507,"text":"Pese okan wa sile,","marked":"Pèsè ọkàn wa sílẹ̀"},{"start":22.957,"end":24.215,"text":"K'a s'ona lodun yi,","marked":"K'á s'ọ̀nà lọ́dún yí"},{"start":24.665,"end":26.006,"text":"K'a m'awon ara wa wa","marked":"K'á m'àwọn ará wa wá"},{"start":26.456,"end":27.763,"text":"Lati ri bibo Re.","marked":"Láti rí bíbọ̀ Rẹ."}],"end":27.763},{"key":"3","start":28.713,"lines":[{"start":28.713,"end":30.27,"text":"A yin O, fun 'ranse Re","marked":"A yìn Ọ́, fún ránṣẹ́ Rẹ"},{"start":30.72,"end":31.91,"text":"T'isiyemeji re,","marked":"T'ìṣíyèméjì rẹ̀"},{"start":32.36,"end":33.85,"text":"F'ese 'gbagbo wa mule","marked":"F'ẹsẹ̀ gbàgbọ́ wa múlẹ̀"},{"start":34.3,"end":35.483,"text":"T'o so fi 'fe Re han","marked":"T'ó sọ fi fẹ́ Rẹ hàn"},{"start":35.933,"end":37.473,"text":"Oluwa, f 'alafia","marked":"Olúwa, f àlàáfíà"},{"start":37.923,"end":39.108,"text":"F'awon ti nreti Re","marked":"F'àwọn tí ńretí Rẹ"},{"start":39.558,"end":40.845,"text":"Jek' a mo O lotito","marked":"Jẹ́k a mọ̀ Ọ́ lótítọ́"},{"start":41.295,"end":42.796,"text":"L'enia at' Olorun.","marked":"L'ẹ́nìà àt Ọlọ́run."}],"end":42.796},{"key":"4","start":43.746,"lines":[{"start":43.746,"end":45.424,"text":"A yin O, fun 'ranse Re,","marked":"A yìn Ọ́, fún ránṣẹ́ Rẹ"},{"start":45.874,"end":47.113,"text":"Ajeriku 'kini","marked":"Ajẹ́ríkù kíni"},{"start":47.563,"end":49.063,"text":"Eni, ninu wahala","marked":"Ẹni, nínú wàhálà"},{"start":49.513,"end":50.834,"text":"T'o nkepe Olorun","marked":"T'ó ńképe Ọlọ́run"},{"start":51.284,"end":52.666,"text":"Oluwa, b'o ba kan wa,","marked":"Olúwa, b'ó bá kàn wá"},{"start":53.116,"end":54.305,"text":"Lati jiya fun O","marked":"Láti jìyà fún Ọ"},{"start":54.755,"end":56.747,"text":"L'aiye, je k'a jeri Re,","marked":"L'ayé, jẹ́ k'á jẹ́rí Rẹ"},{"start":57.197,"end":59.364,"text":"L'orun, je k'a gb'ade.","marked":"L'ọ̀run, jẹ́ k'á gb'adé."}],"end":59.364},{"key":"5","start":60.314,"lines":[{"start":60.314,"end":61.829,"text":"A yin O, fun 'ranse Re,","marked":"A yìn Ọ́, fún ránṣẹ́ Rẹ"},{"start":62.279,"end":63.531,"text":"L'erekusu Patmo","marked":"L'erékùṣù Patmo"},{"start":63.981,"end":66.065,"text":"A yin O, f'eri toto","marked":"A yìn Ọ́, f'ẹ́rí tòtọ́"},{"start":66.515,"end":67.547,"text":"Ti o je nipa Re","marked":"Tí ó jẹ́ nípa Rẹ"},{"start":67.997,"end":69.146,"text":"A yin O fun iran na","marked":"A yìn Ọ́ fún ìran ná"},{"start":69.596,"end":70.692,"text":"Ti o fi han fun wa","marked":"Tí ó fi hàn fún wa"},{"start":71.142,"end":72.444,"text":"A o fi suru duro","marked":"A ó fi sùrù dúró"},{"start":72.894,"end":74.289,"text":"K'a le ka wa mo won.","marked":"K'á lè kà wá mọ́ wọn."}],"end":74.289},{"key":"6","start":75.239,"lines":[{"start":75.239,"end":77.158,"text":"A yin O, f'awon ewe","marked":"A yìn Ọ́, f'àwọn èwe"},{"start":77.608,"end":78.839,"text":"Ajeriku mimo","marked":"Ajẹ́ríkù mímọ́"},{"start":79.289,"end":80.047,"text":"A si mimo","marked":"A sí mímọ́"},{"start":80.497,"end":81.659,"text":"A si won l'owo ogun","marked":"A sì wọn l'ọwọ́ ogun"},{"start":82.109,"end":83.18,"text":"Lo sibi isimi","marked":"Lọ síbi ìṣimi"},{"start":83.63,"end":85.774,"text":"Rakelieli, ma sokun mo","marked":"Rakelieli, má sọkún mọ́"},{"start":86.224,"end":87.088,"text":"Nwon bo lowo 'rora","marked":"Wọ́n bọ́ lọ́wọ́ rora"},{"start":87.538,"end":88.945,"text":"F'okan ailetan fun wa","marked":"F'ọkàn àìlẹ́tàn fún wa"},{"start":89.395,"end":90.776,"text":"K'a gb'ade bi tiwon.","marked":"K'á gb'adé bí tiwọn."}],"end":90.776},{"key":"7","start":91.726,"lines":[{"start":91.726,"end":93.523,"text":"A yin O, fun imole","marked":"A yìn Ọ́, fún ìmọ́lẹ̀"},{"start":93.973,"end":95.069,"text":"At'ohun lat'orun","marked":"Àt'ohun lát'ọ̀run"},{"start":95.519,"end":97.429,"text":"A si yin O, fun iran","marked":"A sì yìn Ọ́, fún ìran"},{"start":97.879,"end":99.058,"text":"Ti abinuku ri","marked":"Tí abínúkú rí"},{"start":99.508,"end":100.982,"text":"Ati fun 'yipada re","marked":"Àti fún yípadà rẹ"},{"start":101.432,"end":102.48,"text":"A fi ogo fun O","marked":"A fi ògo fún Ọ"},{"start":102.93,"end":104.564,"text":"Jo, tan ina Emi Re","marked":"Jọ, tan iná Ẹ̀mí Rẹ"},{"start":105.014,"end":106.121,"text":"Sinu okunkun wa.","marked":"Sínú òkùnkùn wà."}],"end":106.121},{"key":"8","start":107.071,"lines":[{"start":107.071,"end":108.196,"text":"Oluwa, lwo t'o wa","marked":"Olúwa, Ìwọ t'ọ́ wá"},{"start":108.646,"end":109.695,"text":"Pel'awon t'o pejo","marked":"Pẹ̀l'àwọn t'ó péjọ"},{"start":110.145,"end":111.432,"text":"lwo t'o yan Mattia","marked":"Ìwọ t'ó yan Mattia"},{"start":111.882,"end":113.148,"text":"Lati ropo Juda","marked":"Láti rọ́pò Juda"},{"start":113.598,"end":115.682,"text":"A'mbe O, gba Ijo Re","marked":"A'mbẹ Ọ, gba Ìjọ Rẹ"},{"start":116.132,"end":117.206,"text":"Lowo eke woli","marked":"Lọ́wọ́ èké wòlí"},{"start":117.656,"end":119.506,"text":"Rant'ileri Re, Jesu","marked":"Ránt'ìlérí Rẹ̀, Jésù"},{"start":119.956,"end":121.259,"text":"Pelu 'jo Re dopin.","marked":"Pẹ̀lú jọ Rẹ̀ dópin."}],"end":121.259},{"key":"9","start":122.209,"lines":[{"start":122.209,"end":123.352,"text":"A yin O fun 'ranse Re,","marked":"A yìn Ọ́ fún ránṣẹ́ Rẹ"},{"start":123.802,"end":124.885,"text":"T'lwo f'agbara fun","marked":"T'lwo f'agbára fún"},{"start":125.335,"end":126.291,"text":"Enit' ihinrere Re,","marked":"Ẹnit ìhìnrere Rẹ̀"},{"start":126.741,"end":127.846,"text":"Mu orin 'segun dun","marked":"Mú orin ṣẹ́gun dùn"},{"start":128.296,"end":129.897,"text":"Ati n'nu ailera wa,","marked":"Àti n'nu àìlera wa"},{"start":130.347,"end":131.376,"text":"Jo je agbara wa","marked":"Jọ jẹ́ agbára wa"},{"start":131.826,"end":133.041,"text":"Je ka s'eso ninu Re,","marked":"Jẹ́ ká s'èso nínú Rẹ̀"},{"start":133.491,"end":134.533,"text":"lwo Ajara wa.","marked":"Ìwọ Àjàrà wa."}],"end":134.533},{"key":"10","start":135.483,"lines":[{"start":135.483,"end":136.582,"text":"A yin O fun 'ranse Re,","marked":"A yìn Ọ́ fún ránṣẹ́ Rẹ"},{"start":137.032,"end":138.148,"text":"Filippi amona","marked":"Filippi amọ̀nà"},{"start":138.598,"end":139.904,"text":"Ati f'arakonrin Re,","marked":"Àti f'arákọ́nrin Rẹ"},{"start":140.354,"end":141.813,"text":"Se wa l'arakorin","marked":"Ṣe wá l'arákọrin"},{"start":142.263,"end":143.731,"text":"Masai je k'a le mo O,","marked":"Masai jẹ́ k'á lè mọ̀ Ọ́"},{"start":144.181,"end":145.899,"text":"Ona, lye, Ooto","marked":"Ọ̀nà, Ìyè, Òótọ́"},{"start":146.349,"end":147.793,"text":"K'a doju ko idanwo","marked":"K'á dojú kọ ìdánwò"},{"start":148.243,"end":149.501,"text":"Titi ao fi segun.","marked":"Títí àó fi ṣẹ́gun."}],"end":149.501},{"key":"11","start":150.451,"lines":[{"start":150.451,"end":152.366,"text":"A yin O, fun Barnaba,","marked":"A yìn Ọ́, fún Barnaba"},{"start":152.816,"end":154.053,"text":"Eni't ife re mu","marked":"Ẹni't ìfẹ́ rẹ̀ mú"},{"start":154.503,"end":156.228,"text":"K'o ko 'hun aiye sile","marked":"K'ó kò hun ayé sílẹ̀"},{"start":156.678,"end":157.783,"text":"K'o wa ohun orun","marked":"K'ó wá ohun ọ̀run"},{"start":158.233,"end":160.245,"text":"Bi aiye ti n gbile si,","marked":"Bí ayé tí ń gbilẹ̀ sí"},{"start":160.695,"end":161.94,"text":"Ran emi Re si wa","marked":"Rán ẹ̀mí Rẹ sí wa"},{"start":162.39,"end":163.541,"text":"Ki itunu Re toto","marked":"Kí ìtùnú Rẹ̀ tòtọ́"},{"start":163.991,"end":165.314,"text":"Tan bo gbogbo aiye.","marked":"Tán bo gbogbo ayé."}],"end":165.314},{"key":"12","start":166.264,"lines":[{"start":166.264,"end":167.905,"text":"A yin O f'Onibaptis,","marked":"A yín Ó f'Onibaptis"},{"start":168.355,"end":169.252,"text":"Asaju Oluwa","marked":"Aṣájú Olúwa"},{"start":169.702,"end":171.099,"text":"Elija toto ni 'se","marked":"Elija tọ́tọ̀ ni ṣe"},{"start":171.549,"end":172.942,"text":"Lati tun ona se","marked":"Láti tún ọ̀nà ṣe"},{"start":173.392,"end":174.871,"text":"Woli to ga julo ni","marked":"Wòlí tó ga jùlọ ni"},{"start":175.321,"end":176.479,"text":"O ri owuro Re","marked":"Ó rí òwúrọ̀ Rẹ"},{"start":176.929,"end":178.455,"text":"Se wa l'alabukun fun,","marked":"Ṣe wá l'alábùkún fún"},{"start":178.905,"end":179.958,"text":"Ti nreti ojo re.","marked":"Ti ńretí ọjọ́ rẹ."}],"end":179.958},{"key":"13","start":180.908,"lines":[{"start":180.908,"end":182.497,"text":"A yin O, fun'ranse Re;","marked":"A yìn Ọ́, fún'ránṣẹ́ Rẹ"},{"start":182.947,"end":184.087,"text":"Ogboiya ninu won","marked":"Ògbòìyà nínú wọn"},{"start":184.537,"end":185.951,"text":"O subu nigba meta","marked":"Ó ṣubú nígbà mẹ́ta"},{"start":186.401,"end":187.389,"text":"O ronupiwada","marked":"Ó ronúpìwàdà"},{"start":187.839,"end":188.789,"text":"Pelu awon alufa","marked":"Pẹ̀lú àwọn àlùfá"},{"start":189.239,"end":190.567,"text":"Lati toju agbo","marked":"Láti tọ́jú agbo"},{"start":191.017,"end":192.27,"text":"Si fun won ni igboiya","marked":"Sì fún wọn ní ìgbòìyà"},{"start":192.72,"end":193.963,"text":"At'itara pelu.","marked":"Àt'ìtara pẹ̀lú."}],"end":193.963},{"key":"14","start":194.913,"lines":[{"start":194.913,"end":196.406,"text":"A yin O, fun 'ranse re","marked":"A yìn Ọ́, fún ránṣẹ́ rẹ"},{"start":196.856,"end":198.287,"text":"Eniti Herod pa","marked":"Ẹnìtí Herod pa"},{"start":198.737,"end":200.016,"text":"O mu ago iya Re","marked":"Ó mú àgọ́ ìyá Rẹ̀"},{"start":200.466,"end":201.646,"text":"O mu oro Re se","marked":"Ó mú ọ̀rọ̀ Rẹ̀ ṣẹ̀"},{"start":202.096,"end":203.411,"text":"K'a ko iwara sile","marked":"K'á kọ ìwàrà sílẹ̀"},{"start":203.861,"end":205.125,"text":"K'a fi suru duro","marked":"K'á fi sùrù dúró"},{"start":205.575,"end":207.011,"text":"K'a ka iya si ayo","marked":"K'á ka ìyá sí ayọ̀"},{"start":207.461,"end":208.718,"text":"B'O ba fa we mo O.","marked":"B'Ó bá fà wẹ̀ mọ́ Ọ."}],"end":208.718},{"key":"15","start":209.668,"lines":[{"start":209.668,"end":211.173,"text":"A yin O, fun 'ranse Re","marked":"A yìn Ọ́, fún ránṣẹ́ Rẹ"},{"start":211.623,"end":212.774,"text":"Eni oloto ni","marked":"Ẹni ọlọ́tọ̀ ni"},{"start":213.224,"end":214.208,"text":"Enit'oju Re ti ri","marked":"Ẹnít'ojú Rẹ ti rí"},{"start":214.658,"end":215.956,"text":"Labe 'gi opoto","marked":"Lábẹ́ gi ọ̀pọ̀tọ́"},{"start":216.406,"end":217.641,"text":"Jo, se wa l'ailetan","marked":"Jọ, ṣe wá l'àìlẹ́tàn"},{"start":218.091,"end":219.058,"text":"lsraeli toto","marked":"Ísírẹ́lì tọ́tọ̀"},{"start":219.508,"end":220.687,"text":"Ki O le ma ba wa gbe","marked":"Kí Ó lè má bá wa gbé"},{"start":221.137,"end":222.422,"text":"K'O ma bo okan wa.","marked":"K'Ó má bo ọkàn wa."}],"end":222.422},{"key":"16","start":223.372,"lines":[{"start":223.372,"end":224.935,"text":"A yin O, fun'ranse re,","marked":"A yìn Ọ́, fún'ránṣẹ́ rẹ"},{"start":225.385,"end":226.435,"text":"T'o so ti ibi Re;","marked":"T'ó sọ ti ibi Rẹ"},{"start":226.885,"end":228.033,"text":"To ko'hun aiye sile","marked":"Tó kó'hùn ayé sílẹ̀"},{"start":228.483,"end":229.584,"text":"T'o yan ona iye","marked":"T'ó yan ọ̀nà ìyè"},{"start":230.034,"end":231.837,"text":"Jo, da okan wa nide","marked":"Jọ, dá ọkàn wa nídè"},{"start":232.287,"end":233.194,"text":"Lowo ife owo","marked":"Lọ́wọ́ ìfẹ́ ọwọ́"},{"start":233.644,"end":234.896,"text":"Je ka le je ipe Re","marked":"Jẹ́ ká lè jẹ́ ìpè Rẹ̀"},{"start":235.346,"end":236.827,"text":"K'a nde ka tele O.","marked":"K'á ńdẹ ká tẹ̀lé Ọ."}],"end":236.827},{"key":"17","start":237.777,"lines":[{"start":237.777,"end":239.74,"text":"A yin O, f'onisegun","marked":"A yìn Ọ́, f'oníṣègùn"},{"start":240.19,"end":241.011,"text":"Ti ihinrere re","marked":"Ti ìhìnrere rẹ"},{"start":241.461,"end":242.852,"text":"Fi O han b'Onisegun","marked":"Fi Ó hàn b'Oníṣègùn"},{"start":243.302,"end":244.317,"text":"At'Abanidaro","marked":"At'abanidaro"},{"start":244.767,"end":246.37,"text":"Jo, f'ororo iwosan","marked":"Jọ, f'òróró ìwòsàn"},{"start":246.82,"end":247.947,"text":"Si okan gbogbo wa,","marked":"Sí ọkàn gbogbo wa"},{"start":248.397,"end":249.712,"text":"At' ikunra 'yebiye","marked":"Àt ìkunra yẹ̀bíyẹ́"},{"start":250.162,"end":251.423,"text":"Kun wa nigbagbogbo.","marked":"Kún wa nígbàgbogbo."}],"end":251.423},{"key":"18","start":252.373,"lines":[{"start":252.373,"end":253.461,"text":"F'awon iranse Re yi","marked":"F'àwọn ìránṣẹ́ Rẹ yí"},{"start":253.911,"end":255.062,"text":"A yin O, Oluwa","marked":"A yìn Ọ́, Olúwa"},{"start":255.512,"end":256.749,"text":"Ife kanna l'o mu won","marked":"Ìfẹ́ kànnà l'ó mú wọn"},{"start":257.199,"end":258.3,"text":"Lati gb'ona rnimo","marked":"Láti gb'ọ̀nà rnímọ́"},{"start":258.75,"end":259.811,"text":"Awa iba le jo won","marked":"Àwa ìbá lè jọ wọn"},{"start":260.261,"end":261.631,"text":"Lati gbe Jesu ga","marked":"Láti gbé Jésù ga"},{"start":262.081,"end":263.482,"text":"Ki ife so wa sokan","marked":"Kí ìfẹ́ sọ wá ṣọ̀kan"},{"start":263.932,"end":265.118,"text":"K'a de ibi isimi.","marked":"K'á dé ibi ìṣímí."}],"end":265.118},{"key":"19","start":266.068,"lines":[{"start":266.068,"end":268.407,"text":"Apostle, Woli, Martyr","marked":"Apostle, Wòlí, Martyr"},{"start":268.857,"end":269.788,"text":"Awon egbe mimo","marked":"Àwọn ẹgbẹ́ mímọ́"},{"start":270.238,"end":271.645,"text":"Nwon ko d'ekun orin won","marked":"Wọ́n kò d'ẹkún orin wọn"},{"start":272.095,"end":273.096,"text":"Nwon wo aso ala","marked":"Wọ́n wọ aṣọ àlá"},{"start":273.546,"end":275.571,"text":"F'awonyi t'o ti koja","marked":"F'àwọ̀nyí t'ó ti kọjá"},{"start":276.021,"end":277.242,"text":"A yin O, Oluwa;","marked":"A yìn Ọ́, Olúwa"},{"start":277.692,"end":279.304,"text":"A o tele ipase won","marked":"A ó tẹ̀lé ipasẹ̀ wọn"},{"start":279.754,"end":280.969,"text":"A o si ma sin O.","marked":"A ó sì má sin Ọ́."}],"end":280.969},{"key":"20","start":281.919,"lines":[{"start":281.919,"end":283.148,"text":"Iyin f'Olorun Baba","marked":"Ìyìn f'Ọlọ́run Baba"},{"start":283.598,"end":284.579,"text":"At'Olorun Omo","marked":"Àt'ọlọ́run Ọmọ"},{"start":285.029,"end":286.048,"text":"Olorun Emi Mimo","marked":"Ọlọ́run Ẹ̀mí Mímọ́"},{"start":286.498,"end":287.669,"text":"Metalokan Mimo","marked":"Mẹ́talọ́kan Mímọ́"},{"start":288.119,"end":289.402,"text":"Awon ti a ra pada,","marked":"Àwọn tí a rà padà"},{"start":289.852,"end":291.17,"text":"Y'o teriba fun O","marked":"Y'ó tẹríba fún Ọ"},{"start":291.62,"end":293.197,"text":"Tire l'ola, at'ipa","marked":"Tirẹ̀ l'ọ̀la, àt'ipá"},{"start":293.647,"end":294.69,"text":"At'ogo, Olorun.","marked":"Àt'ògo, Ọlọ́run."},{"start":295.14,"end":295.738,"text":"Amin.","marked":"Àmín."}],"end":295.738}]}