{"v":3,"coll":"y","num":173,"id":"hymn_173","title":"WA, eyin olope wa","duration":62.542,"voices":{"male":{"file":"y-173-male-v3.m4a","bytes":449992,"sha256":"d25504193eea5c71a8549c46ca79548261de4c25c964dcb5fa5042ebd7ad0220","duration":62.6},"female":{"file":"y-173-female-v3.m4a","bytes":465867,"sha256":"c90e209d66a98769cf88fe9f06accd48cc64e5c7714f799ac5e2fe91b942f0ae","duration":62.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.924,"text":"WA, ẹyin ọlọpẹ wa,","marked":"Wá, ẹ̀yin ọlọ́pẹ́ wa"},{"start":2.374,"end":3.611,"text":"Gbe orin ikore ga;","marked":"Gbé orin ìkórè ga"},{"start":4.061,"end":5.337,"text":"Ire gbogbo ti wọle,","marked":"Ìrè gbogbo ti wọlé"},{"start":5.787,"end":7.21,"text":"K'otutu ọyẹ to de;","marked":"K'òtútù ọyẹ́ tó dé"},{"start":7.66,"end":8.919,"text":"Ọlọrun Ẹlẹda wa,","marked":"Ọlọ́run Ẹlẹda wa"},{"start":9.369,"end":10.757,"text":"L'o ti pese f'aini wa,","marked":"L'ó ti pèsè f'àìní wa"},{"start":11.207,"end":12.476,"text":"Wa k'a re 'le Ọlọrun,","marked":"Wá k'á rẹ̀ lé Ọlọ́run"},{"start":12.926,"end":14.338,"text":"Gbe orin ikore ga.","marked":"Gbé orin ìkórè ga."}],"end":14.338},{"key":"2","start":15.288,"lines":[{"start":15.288,"end":16.548,"text":"Oko, Ọlọrun l'ayé,","marked":"Oko, Ọlọ́run l'ayé"},{"start":16.998,"end":18.204,"text":"Lati s'eso iyin Rẹ,","marked":"Láti s'èso ìyìn Rẹ"},{"start":18.654,"end":20.273,"text":"Alikama at'epo,","marked":"Alikama àt'epo"},{"start":20.723,"end":22.454,"text":"Ń dagba f'aro tab'ayọ;","marked":"Ń dàgbà f'àrò táb'ayọ̀"},{"start":22.904,"end":24.718,"text":"Eehu na, ipẹ tẹlẹ,","marked":"Èéhù ná, ìpẹ́ tẹ́lẹ̀"},{"start":25.168,"end":26.422,"text":"Siri ọka nikẹhin,","marked":"Siri ọkà níkẹhìn"},{"start":26.872,"end":28.407,"text":"Oluwa 'kore, mu wa,","marked":"Olúwa kórè, mú wa"},{"start":28.857,"end":30.34,"text":"Jẹ eso rere fun Ọ.","marked":"Jẹ́ èso rere fún Ọ."}],"end":30.34},{"key":"3","start":31.29,"lines":[{"start":31.29,"end":32.689,"text":"N'tori Ọlọrun wa mbọ,","marked":"N'torí Ọlọ́run wa mbọ̀"},{"start":33.139,"end":34.499,"text":"Y'o si kore Rẹ s'ilẹ,","marked":"Y'ó sì kórè Rẹ̀ s'ilẹ̀"},{"start":34.949,"end":36.171,"text":"Oun gbọn gbogbo panti,","marked":"Òun gbọ́n gbogbo pàǹtí"},{"start":36.621,"end":38.201,"text":"Kuro l'oko Rẹ n'jọ naa,","marked":"Kúrò l'ọ̀kọ̀ Rẹ̀ n'jọ náà"},{"start":38.651,"end":40.11,"text":"Y'o f'asẹ f'awọn Angẹl'","marked":"Y'ó f'àsẹ f'àwọn Angẹl'"},{"start":40.56,"end":42.216,"text":"Lati gba epo s'ina,","marked":"Láti gba epo s'iná"},{"start":42.666,"end":44.304,"text":"Lati ko alikama jọ,","marked":"Láti kọ́ alikama jọ"},{"start":44.754,"end":46.215,"text":"Si aba Rẹ titi lai.","marked":"Sí àbá Rẹ títí láì."}],"end":46.215},{"key":"4","start":47.165,"lines":[{"start":47.165,"end":48.538,"text":"Bẹni, ma wa, Oluwa,","marked":"Bẹni, má wá, Olúwa"},{"start":48.988,"end":50.296,"text":"Si ikore ikẹhin:","marked":"Sí ìkórè ìkẹ́hìn"},{"start":50.746,"end":51.86,"text":"Ko awọn eniyan Rẹ jọ,","marked":"Kó àwọn ènìyàn Rẹ jọ"},{"start":52.31,"end":53.852,"text":"Kuro l'ẹsẹ at'aro;","marked":"Kúrò l'ẹsẹ̀ àt'àrọ"},{"start":54.302,"end":55.7,"text":"Sọ wọn di mimọ lailai,","marked":"Sọ wọ́n di mímọ́ láéláé"},{"start":56.15,"end":57.365,"text":"Ki wọn le ma ba Ọ gbe,","marked":"Kí wọn lè má bá Ọ gbé"},{"start":57.815,"end":59.123,"text":"Wa t'iwọ t'Angẹli Rẹ,","marked":"Wá t'ìwọ t'Áńgẹ́lì Rẹ"},{"start":59.573,"end":60.993,"text":"Gbe orin ikore ga.","marked":"Gbé orin ìkórè ga."}],"end":60.993}]}