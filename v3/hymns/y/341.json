{"v":3,"coll":"y","num":341,"id":"hymn_341","title":"MO n tesiwaju l'ona naa","duration":51.814,"voices":{"male":{"file":"y-341-male-v3.m4a","bytes":370397,"sha256":"cd3aed5e327912dc61cb3519e5bc3931693f0e7348e1f792fdd6c5c56fdfcbf5","duration":51.9},"female":{"file":"y-341-female-v3.m4a","bytes":380320,"sha256":"0c7aac6db43e9101214f2c69b665c31436a7d6c8f6f4a19e2ccb8d23a03cfc67","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.934,"text":"MO n tesiwaju l'ona naa","marked":"Mò ń tẹ̀síwájú l'ọ̀nà náà"},{"start":2.384,"end":3.931,"text":"Mo n g'oke si l'ojoojumo","marked":"Mò ń g'òkè sí l'ojoojúmọ́"},{"start":4.381,"end":6.341,"text":"Mo n gbadura bi mo ti n lo","marked":"Mo ń gbàdúrà bí mo ti ń lọ"},{"start":6.791,"end":8.014,"text":"Oluwa f'ese mi mu le.","marked":"Olúwa f'ẹsẹ̀ mi mú lé."}],"end":8.014},{"key":"CHORUS","start":8.964,"lines":[{"start":8.964,"end":10.488,"text":"Oluwa joo gbe mi s'oke","marked":"Olúwa jọ̀ọ́ gbé mi s'ókè"},{"start":10.938,"end":13.016,"text":"S'ile orun nipa gbagbo","marked":"S'ilé ọ̀run nípa gbàgbọ́"},{"start":13.466,"end":14.898,"text":"Bi t'ayo at'ife gbe wa","marked":"Bí t'ayọ̀ àt'ìfẹ́ gbé wà"},{"start":15.348,"end":16.568,"text":"Oluwa f'ese mi mu le.","marked":"Olúwa f'ẹsẹ̀ mi mú lé."}],"end":16.568},{"key":"2","start":17.518,"lines":[{"start":17.518,"end":19.134,"text":"lfe okan mi ko duro","marked":"Ìfẹ́ ọkàn mi kò dúró"},{"start":19.584,"end":21.445,"text":"Laarin yemeji at'eru","marked":"Láàrín yẹ̀méjì àt'ẹrú"},{"start":21.895,"end":23.779,"text":"Awon miiran le maa gbe be","marked":"Àwọn mìíràn lè máa gbé bẹ"},{"start":24.229,"end":25.549,"text":"llepa mi n'ibi giga.","marked":"Ìlépa mi n'ibi gíga."}],"end":25.549},{"key":"3","start":26.499,"lines":[{"start":26.499,"end":27.807,"text":"Em'o bori b'idanwo de","marked":"Èm'ó borí b'ìdánwò dé"},{"start":28.257,"end":29.807,"text":"Okan mi yoo sinmi le O","marked":"Ọkàn mi yóò sinmi lé Ọ"},{"start":30.257,"end":31.457,"text":"Alaafia kikun si nbe","marked":"Àlàáfíà kíkún sì ńbẹ"},{"start":31.907,"end":33.44,"text":"F'awon t'o ngbe ibi giga.","marked":"F'àwọn t'ó ńgbé ibi gíga."}],"end":33.44},{"key":"4","start":34.39,"lines":[{"start":34.39,"end":35.853,"text":"Mo fe de 'bi giga julo","marked":"Mo fẹ́ dé bí gíga jùlọ"},{"start":36.303,"end":37.994,"text":"B'o ti wu ki'ija naa le to","marked":"B'ó ti wù kí'ìjà náà le tó"},{"start":38.444,"end":40.057,"text":"No ma ko'rin bi mo ti n lo","marked":"Nó má kò'rìn bí mo ti ń lọ"},{"start":40.507,"end":41.768,"text":"Oluwa joo mu mi de be.","marked":"Olúwa jọ̀ọ́ mú mi dé bẹ̀."}],"end":41.768},{"key":"5","start":42.718,"lines":[{"start":42.718,"end":44.062,"text":"Oluwa joo s'amona mi","marked":"Olúwa jọ̀ọ́ s'amọ̀nà mi"},{"start":44.512,"end":46.291,"text":"Laisi Re n ko ni le de be","marked":"Láìsí Rẹ̀ ń kò ní lè dé bẹ̀"},{"start":46.741,"end":48.089,"text":"Gba m'ba si de ilu Orun","marked":"Gba m'bá sì dé ìlú Ọ̀run"},{"start":48.539,"end":50.265,"text":"Okan mi yoo f'ope fun O.","marked":"Ọkàn mi yóò f'ọpẹ́ fún Ọ."}],"end":50.265}]}