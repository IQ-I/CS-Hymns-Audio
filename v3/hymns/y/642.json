{"v":3,"coll":"y","num":642,"id":"hymn_642","title":"GB'ORI yin s'oke ero mimo","duration":47.974,"voices":{"male":{"file":"y-642-male-v3.m4a","bytes":333315,"sha256":"bbd9d98314d2e4f2217d248f9fbf88a89d38fda09c8f37d7a543da75704fa855","duration":48.0},"female":{"file":"y-642-female-v3.m4a","bytes":340222,"sha256":"7202d07193a43e04a0f787ca813262208d5ff2920b0cd609bc3fd22966f8e419","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.071,"text":"GB'ori nyin s'oke ero mimo","marked":"Gb'orí yín s'òkè èrò mímọ́"},{"start":2.521,"end":4.095,"text":"Gbo, ayo mbo li owuro","marked":"Gbọ́, ayọ̀ mbọ́ lí òwúrọ̀"},{"start":4.545,"end":5.937,"text":"Olorun ti so'nu Oro re","marked":"Ọlọ́run ti sọ'nù Ọ̀rọ̀ rẹ̀"},{"start":6.387,"end":7.756,"text":"Pe, ayo mbo l'owuro.","marked":"Pé, ayọ̀ mbọ́ l'òwúrọ̀."}],"end":7.756},{"key":"CHORUS","start":8.706,"lines":[{"start":8.706,"end":9.944,"text":"Ayo mbo Ii owuro - 2ce","marked":"Ayọ̀ mbọ̀ Ìí òwúrọ̀"},{"start":10.394,"end":11.933,"text":"Bi ekun pe d'ale kan","marked":"Bí ẹkún pè d'alẹ́ kan"},{"start":12.383,"end":13.787,"text":"Ayo sa mbo Ii owuro.","marked":"Ayọ̀ sá mbọ́ Ìí òwúrọ̀."}],"end":13.787},{"key":"2","start":14.737,"lines":[{"start":14.737,"end":16.309,"text":"Enyin Mimo, mase beru","marked":"Ẹ̀yin Mímọ́, máṣe bẹ̀rù"},{"start":16.759,"end":18.259,"text":"Gbo, ayo mbo l'owuro","marked":"Gbọ́, ayọ̀ mbọ́ l'òwúrọ̀"},{"start":18.709,"end":20.898,"text":"Enyin elekun, n'omije nu","marked":"Ẹ̀yin ẹlẹ́kùn, n'omijé nù"},{"start":21.348,"end":22.745,"text":"Gbo, ayo mbo l'owuro.","marked":"Gbọ́, ayọ̀ mbọ́ l'òwúrọ̀."},{"start":23.195,"end":24.451,"text":"Egbe: Ayo mbo Ii owuro...","marked":"Ayọ̀ mbọ̀ Ìí òwúrọ̀"}],"end":24.451},{"key":"3","start":25.401,"lines":[{"start":25.401,"end":27.323,"text":"Yo; oru fere rekoja","marked":"Yọ̀; òru fèrè rékọjá"},{"start":27.773,"end":29.232,"text":"Wo, ayo mbo l'owuro","marked":"Wò, ayọ̀ mbọ́ l'òwúrọ̀"},{"start":29.682,"end":31.49,"text":"Gbana l'owuro Ogo yio de","marked":"Gbáná l'òwúrọ̀ Ògo yóò dé"},{"start":31.94,"end":33.426,"text":"Yio m'owuro ayo wa de.","marked":"Yóò m'òwúrọ̀ ayọ̀ wa dé."},{"start":33.876,"end":35.074,"text":"Egbe: Ayo mbo Ii owuro...","marked":"Ayọ̀ mbọ̀ Ìí òwúrọ̀"}],"end":35.074},{"key":"4","start":36.024,"lines":[{"start":36.024,"end":37.551,"text":"E jek' a kun f'ayo loni","marked":"Ẹ jẹ́k a kún f'ayọ̀ lónì"},{"start":38.001,"end":39.526,"text":"Pe, ayo mbo l'owuro","marked":"Pé, ayọ̀ mbọ́ l'òwúrọ̀"},{"start":39.976,"end":41.454,"text":"Olorun yio n'omile wa nu","marked":"Ọlọ́run yóò n'òmílé wà nù"},{"start":41.904,"end":43.653,"text":"A! ayo mbo l'owuro.","marked":"A! ayọ̀ mbọ́ l'òwúrọ̀."},{"start":44.103,"end":45.379,"text":"Egbe: Ayo mbo Ii owuro ...","marked":"Ayọ̀ mbọ̀ Ìí òwúrọ̀"},{"start":45.829,"end":46.425,"text":"Amin.","marked":"Àmín."}],"end":46.425}]}