{"v":3,"coll":"y","num":53,"id":"hymn_53","title":"'K'E wole f'Oba Ologo","duration":80.619,"voices":{"male":{"file":"y-53-male-v3.m4a","bytes":558896,"sha256":"10f76b1f6270cdd9ce665493a45cd5f38d8513cd9857e707e096224e89321e3b","duration":80.7},"female":{"file":"y-53-female-v3.m4a","bytes":577805,"sha256":"12bc33790a2a4bcca13ae20cfa654cfbedb07f21b14234a3ca511f4fc9b07a9d","duration":80.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.778,"text":"'K'E wole f'Oba Ologo","marked":"k'ẹ wọlé f'Ọba Ológo"},{"start":2.228,"end":3.404,"text":"Eni O ngbe 'nu imole","marked":"Ẹni Ó ńgbé nu ìmọ́lẹ̀"},{"start":3.854,"end":5.491,"text":"T'oju elese kan ko ri","marked":"T'ojú ẹlẹ́ṣẹ̀ kan kò rí"},{"start":5.941,"end":7.183,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":7.183},{"key":"2","start":8.133,"lines":[{"start":8.133,"end":9.929,"text":"Gbogbo omo Egbe Serafu,","marked":"Gbogbo ọmọ Ẹgbẹ́ Séráfù"},{"start":10.379,"end":11.763,"text":"L'okunrin at'obinrin","marked":"L'ọkùnrin àt'obìnrin"},{"start":12.213,"end":13.786,"text":"K'a ronu ese ti a da,","marked":"K'á ronú ẹ̀ṣẹ̀ tí a dá"},{"start":14.236,"end":15.411,"text":"K'a toro 'dariji.","marked":"K'á tọrọ dáríjì."}],"end":15.411},{"key":"3","start":16.361,"lines":[{"start":16.361,"end":17.738,"text":"B'a ba mo'ra wa l'elese,","marked":"B'á bá mọ̀'rà wá l'ẹlẹ́ṣẹ̀"},{"start":18.188,"end":19.606,"text":"K'a jewo re la je tan,","marked":"K'á jẹ́wọ́ rẹ̀ la jẹ́ tán"},{"start":20.056,"end":21.569,"text":"K'a ronu k'a si pawada,","marked":"K'á ronú k'á sì pàwádà"},{"start":22.019,"end":23.168,"text":"Baba yio dariji.","marked":"Baba yóò dáríjì."}],"end":23.168},{"key":"4","start":24.118,"lines":[{"start":24.118,"end":25.721,"text":"Ese aini 'fe l'o poju","marked":"Ẹsẹ̀ àìní fẹ́ l'ó pọ̀jù"},{"start":26.171,"end":27.488,"text":"Larin wa ba ti kunle","marked":"Lárin wa bá ti kúnlẹ̀"},{"start":27.938,"end":29.677,"text":"Esu l'o ngb' ogun re ti wa","marked":"Èṣù l'ó ńgb ogun rẹ̀ ti wá"},{"start":30.127,"end":31.401,"text":"Baba jo dariji.","marked":"Baba jọ dáríjì."}],"end":31.401},{"key":"5","start":32.351,"lines":[{"start":32.351,"end":33.79,"text":"Ninu 'wa wa ati 'se wa,","marked":"Nínú wa wa àti ṣe wá"},{"start":34.24,"end":35.204,"text":"Ninu oro enu wa,","marked":"Nínú ọ̀rọ̀ ẹnu wa"},{"start":35.654,"end":36.92,"text":"“Nu gigan enikeji wa","marked":"Nù gígan ẹnìkejì wà"},{"start":37.37,"end":38.577,"text":"Dariji, Daniji.","marked":"Dáríjì, Danijì."}],"end":38.577},{"key":"6","start":39.527,"lines":[{"start":39.527,"end":40.977,"text":"Gbogbo wa Iati f'oju ri,","marked":"Gbogbo wa láti f'ojú rí"},{"start":41.427,"end":42.652,"text":"'Wo lo ran 'mole si wa,","marked":"wò ló rán mọ́lẹ̀ sí wa"},{"start":43.102,"end":44.528,"text":"Lati fi ona Re han wa","marked":"Láti fi ọ̀nà Rẹ hàn wá"},{"start":44.978,"end":46.282,"text":"Dariji, Daniji.","marked":"Dáríjì, Danijì."}],"end":46.282},{"key":"7","start":47.232,"lines":[{"start":47.232,"end":48.59,"text":"Bi ko ba se anu Re ni","marked":"Bí kò bá ṣe àánú Rẹ̀ ni"},{"start":49.04,"end":50.429,"text":"Ka to de 'nu 'mole yi","marked":"Ká tó dé nù mọ́lẹ̀ yí"},{"start":50.879,"end":52.479,"text":"Esu ba l'ayo lori wa","marked":"Èṣù bá l'ayọ̀ lórí wa"},{"start":52.929,"end":54.16,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":54.16},{"key":"8","start":55.11,"lines":[{"start":55.11,"end":57.089,"text":"Bi ko ba s'esu t'o ngb'ogun","marked":"Bí kò bá s'eṣú t'ó ńgb'ogun"},{"start":57.539,"end":58.662,"text":"A le f'ibi s'olore,","marked":"A lè f'ibi s'ọlọ́rẹ̀"},{"start":59.112,"end":60.75,"text":"Jowo pa ise esu run","marked":"Jọ̀wọ́ pa iṣẹ́ èṣù run"},{"start":61.2,"end":62.425,"text":"Dariji, Daniji.","marked":"Dáríjì, Danijì."}],"end":62.425},{"key":"9","start":63.375,"lines":[{"start":63.375,"end":65.268,"text":"Wo ti 'ya ti Jesu wa je","marked":"Wò ti yà tí Jésù wá jẹ"},{"start":65.718,"end":66.799,"text":"'Ranti ogun eje Re,","marked":"rántí ogun ẹ̀jẹ̀ Rẹ"},{"start":67.249,"end":68.616,"text":"Nin'ogba Gestesmani","marked":"Nín'ọgbà Gestesmani"},{"start":69.066,"end":70.347,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":70.347},{"key":"10","start":71.297,"lines":[{"start":71.297,"end":72.964,"text":"A dupe p'O ti gbo tiwa","marked":"A dúpẹ́ p'Ó ti gbọ́ tiwa"},{"start":73.414,"end":74.991,"text":"Ma je k'a tun d'ese mo,","marked":"Má jẹ́ k'a tún d'ẹ̀ṣẹ̀ mọ́"},{"start":75.441,"end":77.108,"text":"Tun wa yipada Oiuwa,","marked":"Tún wá yípadà Oíúwa"},{"start":77.558,"end":79.07,"text":"K'a l'ayo l'ojo 'kehin.","marked":"K'á l'ayọ̀ l'ọjọ́ kẹhìn."}],"end":79.07}]}