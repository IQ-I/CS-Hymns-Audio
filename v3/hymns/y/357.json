{"v":3,"coll":"y","num":357,"id":"hymn_357","title":"'LAI lodo Oluwa!","duration":61.754,"voices":{"male":{"file":"y-357-male-v3.m4a","bytes":439356,"sha256":"296ccfdefe1a164c2dbd780bb1cce84ffa35a712afff143360789a558c879db0","duration":61.8},"female":{"file":"y-357-female-v3.m4a","bytes":452214,"sha256":"573328d31701d51e6670e9e1013bfba9cad48a9b958d6e3906e7f9787fe122ad","duration":61.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.56,"text":"'LAI lọdọ Oluwa!","marked":"láì lọ́dọ̀ Olúwa!"},{"start":2.01,"end":3.126,"text":"Amin, bẹni ko ri,","marked":"Àmín, bẹ́ni kò rí"},{"start":3.576,"end":5.005,"text":"Iye wa ninu ọrọ na,","marked":"Iye wà nínú ọ̀rọ̀ ná"},{"start":5.455,"end":6.792,"text":"Aiku ni titi lai,","marked":"Àìkú ni títí láì"},{"start":7.242,"end":8.29,"text":"Nihin ninu ara,","marked":"Níhìn nínú ara"},{"start":8.74,"end":10.209,"text":"Mo sako jina si;","marked":"Mo ṣáko jìnà sí"},{"start":10.659,"end":12.929,"text":"Sibẹ, alalẹ ni mo n fi,","marked":"Síbẹ̀, alálẹ́ ni mo ń fi"},{"start":13.379,"end":14.747,"text":"Ọjọ kan sun mọle!","marked":"Ọjọ́ kan sùn mọ́lé!"}],"end":14.747},{"key":"2","start":15.697,"lines":[{"start":15.697,"end":16.921,"text":"Ile Baba loke,","marked":"Ilé Baba lókè"},{"start":17.371,"end":18.478,"text":"Ile ọkan mi ni;","marked":"Ilé ọkàn mi ni"},{"start":18.928,"end":20.456,"text":"Emi n fi oju igbagbọ,","marked":"Èmi ń fi ojú ìgbàgbọ́"},{"start":20.906,"end":22.133,"text":"Wo 'bode wura rẹ!","marked":"Wo bodè wúrà rẹ!"},{"start":22.583,"end":23.737,"text":"Ọkan mi n fa pupọ,","marked":"Ọkàn mi ń fa púpọ̀"},{"start":24.187,"end":25.928,"text":"S'ile na ti mo fẹ,","marked":"S'ilẹ̀ ná tí mo fẹ́"},{"start":26.378,"end":27.778,"text":"Ile didan t'awọn mimọ,","marked":"Ilẹ̀ dídán t'àwọn mímọ́"},{"start":28.228,"end":29.581,"text":"Jerusalem t'ọrun","marked":"Jerusalẹm t'ọ̀run"}],"end":29.581},{"key":"3","start":30.531,"lines":[{"start":30.531,"end":31.531,"text":"Awọsanmọ dide,","marked":"Àwọsánmọ̀ dìde"},{"start":31.981,"end":32.977,"text":"Gbogbo ero mi pin;","marked":"Gbogbo èrò mi pín"},{"start":33.427,"end":35.311,"text":"Bi adaba Noa, mo n fo","marked":"Bí àdàbà Noa, mò ń fò"},{"start":35.761,"end":36.769,"text":"Larin iji lile,","marked":"Lárin ìjì líle"},{"start":37.219,"end":38.393,"text":"Sugbọn sanmọ kuro,","marked":"Sùgbọ́n sánmọ̀ kúrò"},{"start":38.843,"end":40.028,"text":"Iji si rekọja,","marked":"Ìjì sì rékọjá"},{"start":40.478,"end":41.963,"text":"Ayọ ati alafia,","marked":"Ayọ̀ àti àlàáfíà"},{"start":42.413,"end":43.793,"text":"Si gba ọkan mi kan.","marked":"Sì gba ọkàn mi kan."}],"end":43.793},{"key":"4","start":44.743,"lines":[{"start":44.743,"end":46.217,"text":"Loorọ ati l'alẹ,","marked":"Lóòrọ́ àti l'alẹ́"},{"start":46.667,"end":48.064,"text":"Lọsan ati l'oru,","marked":"Lọ́sàn àti l'òru"},{"start":48.514,"end":50.477,"text":"Mo n gbọ orin ọrun, bori","marked":"Mo ń gbọ́ orin ọ̀run, borí"},{"start":50.927,"end":52.064,"text":"Rudurudu ayé;","marked":"Rúdurùdu ayé"},{"start":52.514,"end":53.69,"text":"Ọrọ ajinde ni,","marked":"Ọ̀rọ̀ àjíǹde ni"},{"start":54.14,"end":55.243,"text":"Hiho isẹgun ni","marked":"Híhó ìsẹ́gun ni"},{"start":55.693,"end":58.373,"text":"Lẹkan si, ―Lai lọd' Oluwa","marked":"Lẹ́kàn sí, ―Láì lọd' Olúwa"},{"start":58.823,"end":60.205,"text":"Amin, bẹni k'o ri.","marked":"Àmín, bẹ́ni k'ó rí."}],"end":60.205}]}