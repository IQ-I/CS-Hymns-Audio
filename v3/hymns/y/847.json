{"v":3,"coll":"y","num":847,"id":"hymn_847","title":"AWON mimo, lala pari","duration":67.199,"voices":{"male":{"file":"y-847-male-v3.m4a","bytes":492388,"sha256":"6eeeb702a392b7656b127b308e94ff977b23842a1fefb253b56bbd9aef31c57c","duration":67.2},"female":{"file":"y-847-female-v3.m4a","bytes":501385,"sha256":"ed6a68901b0a3a85847565af10fde617c1a5a526aacfb555dd2d5c1a783c055d","duration":67.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.071,"text":"AWỌN mimọ, lala pari,","marked":"Àwọn mímọ́, lálà parí"},{"start":2.521,"end":4.545,"text":"Wọn ti ja, wọn si ti sẹgun,","marked":"Wọ́n ti jà, wọ́n sì ti sẹ́gun"},{"start":4.995,"end":6.651,"text":"Wọn ko fẹ ohun ija mọ,","marked":"Wọn kò fẹ́ ohun ìjà mọ́"},{"start":7.101,"end":8.755,"text":"Wọn da wọn 'lẹ l'ẹsẹ Jesu","marked":"Wọ́n dá wọn 'lẹ l'ẹsẹ̀ Jésù"},{"start":9.205,"end":10.528,"text":"A! ẹyin ẹni ibukun,","marked":"A! ẹ̀yin ẹni ìbùkún"},{"start":10.978,"end":12.638,"text":"Isinmi yin ti daju to!","marked":"Ìsinmi yín ti dájú tó!"}],"end":12.638},{"key":"2","start":13.588,"lines":[{"start":13.588,"end":15.287,"text":"Awọn mimọ, irin pari,","marked":"Àwọn mímọ́, irin parí"},{"start":15.737,"end":17.271,"text":"Wọn ko tun sure ije mọ,","marked":"Wọn kò tún súre ìjẹ mọ́"},{"start":17.721,"end":19.197,"text":"Arẹ at' isubu d'opin,","marked":"Àrẹ àt ìṣubú d'òpin"},{"start":19.647,"end":21.299,"text":"Ọta oun ẹru ko si mọ;","marked":"Ọ̀tá òun ẹ̀rù kò sì mọ̀"},{"start":21.749,"end":23.478,"text":"A! ẹyin ẹni ibukun,","marked":"A! ẹ̀yin ẹni ìbùkún"},{"start":23.928,"end":25.352,"text":"Isinmi yin ha ti dun to!","marked":"Ìsinmi yín ha ti dùn tó!"}],"end":25.352},{"key":"3","start":26.302,"lines":[{"start":26.302,"end":28.174,"text":"Awọn mimọ, ajo pari,","marked":"Àwọn mímọ́, àjọ parí"},{"start":28.624,"end":29.907,"text":"Wọn ti gun s'ilẹ ibukun,","marked":"Wọ́n ti gún s'ilẹ̀ ìbùkún"},{"start":30.357,"end":32.036,"text":"Iji ko dẹruba wọn mọ,","marked":"Ìjì kò dẹ́rùbà wọn mọ́"},{"start":32.486,"end":34.041,"text":"Igbi omi ko n'ipa mọ;","marked":"Ìgbì omi kò n'ipa mọ́"},{"start":34.491,"end":36.202,"text":"A! ẹyin ẹni ibukun,","marked":"A! ẹ̀yin ẹni ìbùkún"},{"start":36.652,"end":38.07,"text":"Ẹ n sinmi n'ib'alafia.","marked":"Ẹ ń sinmi n'ìb'àlàfíà."}],"end":38.07},{"key":"4","start":39.02,"lines":[{"start":39.02,"end":41.03,"text":"Awọn mimọ, oku wọn sun,","marked":"Àwọn mímọ́, òkú wọn sùn"},{"start":41.48,"end":43.573,"text":"Ninu ile, awọn n sọna,","marked":"Nínú ilé, àwọn ń sọ́nà"},{"start":44.023,"end":45.519,"text":"Titi wọn yoo fi jinde,","marked":"Títí wọn yóò fi jíǹde"},{"start":45.969,"end":47.426,"text":"Lati fi ayọ goke lọ;","marked":"Láti fi ayọ̀ gòkè lọ"},{"start":47.876,"end":50.219,"text":"A! ẹni 'bukun, ẹ koriin;","marked":"A! ẹni bùkún, ẹ kọrìín"},{"start":50.669,"end":52.314,"text":"Oluwa at'Ọba yin mbọ.","marked":"Olúwa àt'Ọba yín mbọ̀."}],"end":52.314},{"key":"5","start":53.264,"lines":[{"start":53.264,"end":55.245,"text":"Ọlọrun wọn, 'Wọ l'a n ke pe,","marked":"Ọlọ́run wọn, 'Wọ l'á ń ké pè"},{"start":55.695,"end":57.567,"text":"Jesu, bẹbẹ fun wa l'oke;","marked":"Jésù, bẹ̀bẹ̀ fún wa l'òkè"},{"start":58.017,"end":59.895,"text":"Ẹmi Mimọ, Olutọ wa,","marked":"Ẹ̀mí Mímọ́, Olùtọ́ wà"},{"start":60.345,"end":61.913,"text":"F'ore-ọfẹ fun wa d'opin;","marked":"F'ore-ọfẹ fún wa d'òpin"},{"start":62.363,"end":63.763,"text":"K'a le b'awọn mimọ sinmi,","marked":"K'á lè b'àwọn mímọ́ sinmi"},{"start":64.213,"end":65.65,"text":"Ni Paradise pẹlu Rẹ.","marked":"Ní Paradise pẹ̀lú Rẹ̀."}],"end":65.65}]}