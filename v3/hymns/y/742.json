{"v":3,"coll":"y","num":742,"id":"hymn_742","title":"KERUBU ati/Serafu","duration":56.37,"voices":{"male":{"file":"y-742-male-v3.m4a","bytes":384369,"sha256":"1ae44ab043d8411bc5d115a5c20c9945c9fc099aa8757319d2234ecbf0d6ca13","duration":56.4},"female":{"file":"y-742-female-v3.m4a","bytes":403787,"sha256":"d6ec9467851fcf9064ddce3721e092467539778af9ac0a65913ff8fd7b5d79a6","duration":56.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.997,"text":"KÉRÚBÙ ati / Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":2.447,"end":3.994,"text":"Wọn n yin Baba / wa loke,","marked":"Wọ́n ń yin Baba wa lókè"},{"start":4.444,"end":6.451,"text":"Baba Mimọ, Baba /Ogo,","marked":"Baba Mímọ́, Baba Ògo"},{"start":6.901,"end":7.792,"text":"Ko sọ wa.","marked":"Kò sọ wá."}],"end":7.792},{"key":"2","start":8.742,"lines":[{"start":8.742,"end":10.19,"text":"Jesu Olori/Egbe wa","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":10.64,"end":11.851,"text":"O ti ji di/de loni","marked":"Ó ti jí di dé lónì"},{"start":12.301,"end":14.087,"text":"Kerubu ati Se/rafu","marked":"Kérúbù àti Ṣe rafu"},{"start":14.537,"end":15.473,"text":"Kun fun ayo.","marked":"Kún fún ayọ̀."}],"end":15.473},{"key":"3","start":16.423,"lines":[{"start":16.423,"end":17.745,"text":"Jehovah Ji/reh Ọba,","marked":"Jehovah Jí rẹ̀h Ọba"},{"start":18.195,"end":19.598,"text":"Jehovah Nis/si Baba,","marked":"Jehovah Nis sí Baba"},{"start":20.048,"end":21.854,"text":"Jehovah Rufi/yi o sọ wa","marked":"Jehovah Rufi yí ó sọ wá"},{"start":22.304,"end":23.246,"text":"Titi lai.","marked":"Títí láì."}],"end":23.246},{"key":"4","start":24.196,"lines":[{"start":24.196,"end":25.789,"text":"Ẹyin ọmọ ẹgbẹ / Kérúbù,","marked":"Ẹ̀yin ọmọ ẹgbẹ́ Kérúbù"},{"start":26.239,"end":27.443,"text":"To wa lori /'lẹ ayé;","marked":"Tó wà lórí 'lẹ ayé"},{"start":27.893,"end":29.24,"text":"Jesu Olori Ẹgbẹ wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":29.69,"end":30.345,"text":"Ji loni","marked":"Jí lónì"}],"end":30.345},{"key":"5","start":31.295,"lines":[{"start":31.295,"end":33.611,"text":"Ẹgbẹ to n damu / nisinsin yi,","marked":"Ẹgbẹ́ tó ń dàmú nísinsin yí"},{"start":34.061,"end":35.59,"text":"To si n gbadu / ra kikan,","marked":"Tó sì ń gbàdù ra kíkan"},{"start":36.04,"end":37.719,"text":"Yoo bu s'orin a/yọ lọjọ,","marked":"Yóò bú s'orin a yọ lọ́jọ́"},{"start":38.169,"end":39.044,"text":"Ajinde.","marked":"Àjíǹde."}],"end":39.044},{"key":"6","start":39.994,"lines":[{"start":39.994,"end":41.406,"text":"Ẹgbẹ Mimọ to / wa loke,","marked":"Ẹgbẹ́ Mímọ́ tó wà lókè"},{"start":41.856,"end":43.075,"text":"Wọn yin Baba / wa logo;","marked":"Wọ́n yin Baba wa lógo"},{"start":43.525,"end":45.162,"text":"Ẹ jẹ k'awa ta / wa layé,","marked":"Ẹ jẹ́ k'àwa ta wá layé"},{"start":45.612,"end":46.407,"text":"Ka mura.","marked":"Ká múra."}],"end":46.407},{"key":"7","start":47.357,"lines":[{"start":47.357,"end":49.835,"text":"Ajẹ, Oso ko ni/ipa kan,","marked":"Àjẹ́, Ọ̀ṣọ́ kò ní ipa kan"},{"start":50.285,"end":51.612,"text":"Lori Ẹgbẹ / Kérúbù,","marked":"Lórí Ẹgbẹ́ Kérúbù"},{"start":52.062,"end":53.423,"text":"Jesu Olori/Ẹgbẹ wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":53.873,"end":54.821,"text":"Ti sẹgun.","marked":"Ti sẹ́gun."}],"end":54.821}]}