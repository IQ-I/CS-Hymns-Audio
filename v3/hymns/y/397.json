{"v":3,"coll":"y","num":397,"id":"hymn_397","title":"BAWO ni awon ewa wa","duration":32.242,"voices":{"male":{"file":"y-397-male-v3.m4a","bytes":214003,"sha256":"7de44a096d145000cbdf1b16eced8c0a9d273e1821a9b30b1081a5c431d2fa25","duration":32.3},"female":{"file":"y-397-female-v3.m4a","bytes":222145,"sha256":"83940de4f7bb49386a20c36f7d95d98aea191300f4f6b1988edf14b149f12a35","duration":32.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.692,"text":"BAWO ni awọn ẹwa wa,","marked":"Báwo ni àwọn ẹwà wa"},{"start":2.142,"end":3.302,"text":"Y'o ti ma sọra wọn?","marked":"Y'ó ti má sọ́ra wọn?"},{"start":3.752,"end":5.561,"text":"Bikose nipa 'kiyesi,","marked":"Bíkọ̀sẹ̀ nípa kíyèsi"},{"start":6.011,"end":7.481,"text":"Gẹgẹ bi ọrọ Rẹ.","marked":"Gẹ́gẹ́ bí ọ̀rọ̀ Rẹ."}],"end":7.481},{"key":"2","start":8.431,"lines":[{"start":8.431,"end":10.326,"text":"Gba oro na wo 'nu okan","marked":"Gba ọ̀rọ̀ ná wò nù ọkàn"},{"start":10.776,"end":12.14,"text":"A tan imole ka","marked":"A tan ìmọ́lẹ̀ ká"},{"start":12.59,"end":13.86,"text":"Oro na ko ope l'ogbon","marked":"Ọ̀rọ̀ nà kó ọpẹ́ l'ọgbọ́n"},{"start":14.31,"end":15.407,"text":"At'imo Olorun.","marked":"Àt'ìmọ̀ Ọlọ́run."}],"end":15.407},{"key":"3","start":16.357,"lines":[{"start":16.357,"end":17.947,"text":"Ọrun ni, imọlẹ wa ni,","marked":"Ọ̀run ni, ìmọ́lẹ̀ wa ni"},{"start":18.397,"end":19.406,"text":"Amọna wa l'ọsan;","marked":"Amọ̀nà wà l'ọ̀sán"},{"start":19.856,"end":21.86,"text":"Fitila ti n f'ọna han wa,","marked":"Fìtílà tí ń f'ọ̀nà hàn wá"},{"start":22.31,"end":23.293,"text":"Ninu ewu oru.","marked":"Nínú ewu òru."}],"end":23.293},{"key":"4","start":24.243,"lines":[{"start":24.243,"end":25.922,"text":"Oro Re, oto ni titi","marked":"Ọ̀rọ̀ Rẹ, ọ̀tọ̀ ni títí"},{"start":26.372,"end":27.363,"text":"Mimo ni gbogbo re","marked":"Mímọ́ ni gbogbo rẹ̀"},{"start":27.813,"end":28.99,"text":"Amona wa l'ojo ewe","marked":"Amọ̀nà wà l'ọjọ́ èwe"},{"start":29.44,"end":30.693,"text":"Opa l'ojo ogbo.","marked":"Ọ̀pá l'ọjọ́ ogbó."}],"end":30.693}]}