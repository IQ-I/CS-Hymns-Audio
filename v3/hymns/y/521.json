{"v":3,"coll":"y","num":521,"id":"hymn_521","title":"OKAN mi, Oluwa ni","duration":52.138,"voices":{"male":{"file":"y-521-male-v3.m4a","bytes":363556,"sha256":"0ae24f1956c21c99012f3e937dcd0aaf356a94cfe205d7d2587f5dc0a40cf5b2","duration":52.2},"female":{"file":"y-521-female-v3.m4a","bytes":374352,"sha256":"7fdc5b8c123f24e031a6385946871d3afdb25f8932b060aac0faf1f685ba032c","duration":52.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.838,"text":"OKAN mi, Oluwa ni","marked":"Ọkàn mi, Olúwa ni"},{"start":2.288,"end":4.144,"text":"Jesu re ni, gboro Re","marked":"Jésù rẹ̀ ni, gbọ́rọ̀ Rẹ"},{"start":4.594,"end":6.607,"text":"Jesu nso, O mba o so","marked":"Jésù ńṣọ́, Ó mbá ọ sọ"},{"start":7.057,"end":8.674,"text":"Pe, elese 'Wo fe mi?","marked":"Pé, ẹlẹ́ṣẹ̀ wò fẹ́ mi?"}],"end":8.674},{"key":"2","start":9.624,"lines":[{"start":9.624,"end":11.336,"text":"Gbat' a de o, Mo da o","marked":"Gbàt a dé ọ, Mo dá ọ"},{"start":11.786,"end":13.844,"text":"O gb'ogbe, Mo wo o san","marked":"Ó gb'ọgbẹ́, Mo wò ó sàn"},{"start":14.294,"end":16.745,"text":"Gb' o sako, Mo mu o bo","marked":"Gb ó ṣáko, Mo mú ọ bọ́"},{"start":17.195,"end":18.732,"text":"Mo s'okun re d'imole.","marked":"Mo s'okùn rẹ̀ d'ìmọ́lẹ̀."}],"end":18.732},{"key":"3","start":19.682,"lines":[{"start":19.682,"end":20.944,"text":"Kike iya ha le mo","marked":"Kíké ìyá ha lè mọ́"},{"start":21.394,"end":22.544,"text":"Si omo re ti o bi?","marked":"Sí ọmọ rẹ̀ tí ó bí?"},{"start":22.994,"end":24.176,"text":"Lotito o le gbagbe","marked":"Lótítọ́ ò lè gbàgbé"},{"start":24.626,"end":26.108,"text":"Sugbon Em'o ranti re.","marked":"Ṣùgbọ́n Èm'ó rántí rẹ̀."}],"end":26.108},{"key":"4","start":27.058,"lines":[{"start":27.058,"end":28.47,"text":"Ife t'Emi ki ye lai","marked":"Ìfẹ́ t'Èmi kì yè láì"},{"start":28.92,"end":30.12,"text":"O ga rekoja orun","marked":"Ó ga rékọjá ọ̀run"},{"start":30.57,"end":31.767,"text":"O si jin ju okun lo","marked":"Ó sì jìn ju okùn lọ"},{"start":32.217,"end":33.431,"text":"Ife alailegbe ni.","marked":"Ìfẹ́ aláìlẹ́gbẹ́ ni."}],"end":33.431},{"key":"5","start":34.381,"lines":[{"start":34.381,"end":35.85,"text":"Wo fere r'ogo Mi na","marked":"Wo fèrè r'ògo Mi ná"},{"start":36.3,"end":37.62,"text":"Gb'ise ore-ofe tan","marked":"Gb'iṣẹ́ oore-ọ̀fẹ́ tán"},{"start":38.07,"end":39.28,"text":"Wo o ba Mi gunwa po","marked":"Wò ó bá Mi gúnwà pọ̀"},{"start":39.73,"end":41.533,"text":"Wi, elese, wo fe mi?","marked":"Wí, ẹlẹ́ṣẹ̀, wo fẹ́ mi?"}],"end":41.533},{"key":"6","start":42.483,"lines":[{"start":42.483,"end":43.573,"text":"Olori aroye mi","marked":"Olórí àròyé mi"},{"start":44.023,"end":45.455,"text":"Ni pe ife mi tutu","marked":"Ní pé ìfẹ́ mi tútù"},{"start":45.905,"end":47.557,"text":"Sugbon mo fe O Jesu","marked":"Ṣùgbọ́n mo fẹ́ Ọ Jésù"},{"start":48.007,"end":49.498,"text":"A! mba le fe O ju yi!.","marked":"A! mbá lè fẹ́ Ọ jù yí!."},{"start":49.948,"end":50.589,"text":"Amin.","marked":"Àmín."}],"end":50.589}]}