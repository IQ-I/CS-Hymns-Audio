{"v":3,"coll":"y","num":763,"id":"hymn_763","title":"NIHIN l'awa n je 'rora","duration":44.249,"voices":{"male":{"file":"y-763-male.m4a","bytes":309667,"sha256":"8d37bf7f5c752b651acad705321fd52a185ee25a9203e8bf696418e811444677","duration":44.3},"female":{"file":"y-763-female.m4a","bytes":316399,"sha256":"37b5d88ef263d31234b9d3390cfcc7397b1f6276192bcbb32ee749da8e9bdc5e","duration":44.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.754,"text":"NIHIN l'awa nje 'rora","marked":"Nihin l'áwá ńjẹ́ 'rora"},{"start":2.134,"end":3.293,"text":"Nihin ni a ma pinya","marked":"Níhìn ni a ma pínyà"},{"start":3.673,"end":5.466,"text":"L'orun, ko si 'pinya.","marked":"L'ọ́run, kò sí 'pínyà."}],"end":5.466},{"key":"CHORUS","start":6.416,"lines":[{"start":6.416,"end":7.608,"text":"Egbe: A! bi o ti dun to!","marked":"A! bí ó ti dùn tó!"},{"start":7.988,"end":9.359,"text":"Dun to, dun to, dun to!","marked":"Dùn tó, dùn tó, dùn tó!"},{"start":9.739,"end":11.349,"text":"A! bi o ti dun to,","marked":"A! bí ó ti dùn tó"},{"start":11.729,"end":13.19,"text":"Gba t'a ki o pinya mo.","marked":"Gba t'á kí ó pínyà mọ́."}],"end":13.19},{"key":"2","start":14.14,"lines":[{"start":14.14,"end":15.606,"text":"Awon t'o feran Jesu","marked":"Àwọn t'ó fẹ́ràn Jésù"},{"start":15.986,"end":17.478,"text":"Nwon o lo s'oke orun","marked":"Nwọn ò lọ s'òkè ọ̀run"},{"start":17.858,"end":19.195,"text":"Lo b'awon t'o ti lo.","marked":"Lo b'àwọn t'ó ti lọ."}],"end":19.195},{"key":"3","start":20.145,"lines":[{"start":20.145,"end":21.482,"text":"Omode y'o wa nibe","marked":"Ọmọdé y'ó wà níbẹ̀"},{"start":21.862,"end":23.379,"text":"T'o wa Olorun l'aiye","marked":"T'ó wá Ọlọ́run l'aiye"},{"start":23.759,"end":24.995,"text":"Ni gbogbo 'le eko.","marked":"Ní gbogbo 'lé ẹ̀kọ́."}],"end":24.995},{"key":"4","start":25.945,"lines":[{"start":25.945,"end":27.226,"text":"Oluko, baba, iya,","marked":"Olùkọ́, bàbá, ìyá"},{"start":27.606,"end":28.856,"text":"Nwon a pade nibe na,","marked":"Nwọ̀n á pàdé níbẹ̀ ná"},{"start":29.236,"end":30.57,"text":"Nwon ki o pinya mo.","marked":"Nwọn kí ó pínyà mọ́."}],"end":30.57},{"key":"5","start":31.52,"lines":[{"start":31.52,"end":33.471,"text":"Bi a o ti yo po to!","marked":"Bí a ò ti yó pọ̀ tó!"},{"start":33.851,"end":35.032,"text":"Gba t'a ba r' Olugbala","marked":"Gba t'á bá r' Olùgbàlà"},{"start":35.412,"end":36.585,"text":"Ni ori ite Re!","marked":"Ní orí ìtẹ́ Rẹ!"}],"end":36.585},{"key":"6","start":37.535,"lines":[{"start":37.535,"end":38.903,"text":"Nibe l'ao korin ayo","marked":"Níbẹ̀ l'áo kọrin ayò"},{"start":39.283,"end":40.83,"text":"Titi aiye ailopin","marked":"Títí àìyẹ́ àìlópin"},{"start":41.21,"end":42.7,"text":"L'a o ma yin Jesu.","marked":"L'á ò má yin Jésù."}],"end":42.7}]}