{"v":3,"coll":"y","num":443,"id":"hymn_443","title":"JESU l'Olusaguntan mi","duration":49.581,"voices":{"male":{"file":"y-443-male-v3.m4a","bytes":352004,"sha256":"38405d5d447e683c38f1e3d6dbbc110a357f435a2a8e69f3cd6d17d732a046e4","duration":49.6},"female":{"file":"y-443-female-v3.m4a","bytes":362987,"sha256":"0ab218d8a4337d51abba6afc88c2cbce5d7e62e15060e262fc169858db37f312","duration":49.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.855,"text":"JESU l'Olusaguntan mi","marked":"Jésù l'Olùṣàgùntàn mi"},{"start":2.305,"end":3.728,"text":"Njẹ k'ibẹru lọ jina;","marked":"Ǹjẹ́ k'ìbẹ̀rù lọ jìnà"},{"start":4.178,"end":5.577,"text":"Lọwọ kiniun at'ẹkun,","marked":"Lọ́wọ́ kìnìún àt'ẹkùn"},{"start":6.027,"end":7.157,"text":"Lọwọ ẹranko ibi,","marked":"Lọ́wọ́ ẹranko ibi"},{"start":7.607,"end":9.284,"text":"Yoo sọ aguntan Tirẹ,","marked":"Yóò sọ àgùntàn Tirẹ̀"},{"start":9.734,"end":11.397,"text":"Jesu y'o pa Tirẹ mọ","marked":"Jésù y'ó pa Tirẹ̀ mọ́"}],"end":11.397},{"key":"2","start":12.347,"lines":[{"start":12.347,"end":13.737,"text":"Nigb' ọta fẹ lati mu mi,","marked":"Nígb ọ̀tá fẹ́ láti mú mi"},{"start":14.187,"end":15.936,"text":"Oun ni: Àgùntàn mi ni,","marked":"Òun ni: Àgùntàn mi ni"},{"start":16.386,"end":18.395,"text":"O si ku, lati gba wa la;","marked":"Ó sì kú, láti gbà wá là"},{"start":18.845,"end":20.327,"text":"Jesu ifẹ ki l'eyi?","marked":"Jésù ìfẹ́ kí l'èyí?"},{"start":20.777,"end":22.16,"text":"Isẹgun ni ọna Tirẹ,","marked":"Ìsẹ́gun ní ọ̀nà Tirẹ̀"},{"start":22.61,"end":24.207,"text":"Ko s'ohun t'o le se e.","marked":"Kò s'ohun t'ó lè ṣe é."}],"end":24.207},{"key":"3","start":25.157,"lines":[{"start":25.157,"end":26.691,"text":"Lọna iye l'o n dari mi","marked":"Lọ́nà ìyè l'ó ń darí mi"},{"start":27.141,"end":28.985,"text":"Let' isan t'o n san pele;","marked":"Lét ìṣàn t'ó ń sàn pẹ̀lẹ́"},{"start":29.435,"end":30.913,"text":"Ninu oko tutu yọyọ,","marked":"Nínú oko tútù yọyọ"},{"start":31.363,"end":32.73,"text":"Nib' ewe oro ki hu,","marked":"Níb ewé ọ̀rọ̀ kí hù"},{"start":33.18,"end":34.69,"text":"Nibẹ ni mo gbohun Jesu,","marked":"Níbẹ̀ ni mo gbóhùn Jésù"},{"start":35.14,"end":36.536,"text":"Nibẹ l'o m'ọkan mi yọ.","marked":"Níbẹ̀ l'ó m'ọkàn mi yọ̀."}],"end":36.536},{"key":"4","start":37.486,"lines":[{"start":37.486,"end":39.0,"text":"Gba mo ba n lọ s'isa oku,","marked":"Gba mo bá ń lọ s'isà òkú"},{"start":39.45,"end":40.807,"text":"B'ẹru tilẹ wa l'ọna,","marked":"B'ẹ̀rù tilẹ̀ wà l'ọ̀nà"},{"start":41.257,"end":42.394,"text":"Emi ki o bẹrukẹru,","marked":"Èmi kí ó bẹ̀rùkẹ̀rù"},{"start":42.844,"end":44.12,"text":"Tor' Olusaguntan wa;","marked":"Tọr Olùṣàgùntàn wa"},{"start":44.57,"end":46.309,"text":"'Gba mo r'ogo at'ọpa Rẹ,","marked":"gbà mo r'ògo àt'ọ̀pá Rẹ"},{"start":46.759,"end":48.032,"text":"Mo mọ p'aguntan Rẹ yo.","marked":"Mo mọ̀ p'àgùntàn Rẹ̀ yọ."}],"end":48.032}]}