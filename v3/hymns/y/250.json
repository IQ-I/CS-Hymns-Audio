{"v":3,"coll":"y","num":250,"id":"hymn_250","title":"JESU, jo ranti mi","duration":42.815,"voices":{"male":{"file":"y-250-male-v3.m4a","bytes":293304,"sha256":"83db71f4c9b4a2b90a4e27e7b2f28e33e7531b1a80e3f9ca72dfd6b0d6d4dbf2","duration":42.9},"female":{"file":"y-250-female-v3.m4a","bytes":308565,"sha256":"59c26de471d2816d54832219e0aec5c0ec9538f340c487978754e9a51ce0498a","duration":42.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.375,"text":"JESU, jo ranti mi","marked":"Jésù, jọ rántí mi"},{"start":2.825,"end":4.204,"text":"K'O si w'ese mi nu","marked":"K'Ó sì w'ẹsẹ̀ mi nù"},{"start":4.654,"end":6.078,"text":"Gba mi low'ese 'binibi","marked":"Gbà mí lọ́w'ẹsẹ̀ bínibí"},{"start":6.528,"end":7.764,"text":"Si we okan mi mo.","marked":"Sì wẹ ọkàn mi mọ́."}],"end":7.764},{"key":"2","start":8.714,"lines":[{"start":8.714,"end":10.431,"text":"Jesu, jọ ranti mi,","marked":"Jésù, jọ rántí mi"},{"start":10.881,"end":12.089,"text":"Em' ẹni 'nilara;","marked":"Ẹ̀m ẹni nílára"},{"start":12.539,"end":14.636,"text":"Ki m'se 'ransẹ t'o n'ifẹ Rẹ","marked":"Kí m'ṣe 'ransẹ t'ó n'ìfẹ́ Rẹ"},{"start":15.086,"end":16.31,"text":"Ki m'tọ 'sinmi Rẹ wo.","marked":"Kí m'tọ́ sinmi Rẹ̀ wò."}],"end":16.31},{"key":"3","start":17.26,"lines":[{"start":17.26,"end":19.054,"text":"Jesu, jọ ranti mi,","marked":"Jésù, jọ rántí mi"},{"start":19.504,"end":20.948,"text":"Mase jẹ ki n sako;","marked":"Maṣe jẹ́ kí n ṣáko"},{"start":21.398,"end":23.147,"text":"N'nu 'damu oun okun aye,","marked":"N'nú dàmú òun òkun ayé"},{"start":23.597,"end":24.777,"text":"F'ọna ọrun han mi.","marked":"F'ọ̀nà ọ̀run hàn mí."}],"end":24.777},{"key":"4","start":25.727,"lines":[{"start":25.727,"end":27.725,"text":"Jesu, jọ ranti mi,","marked":"Jésù, jọ rántí mi"},{"start":28.175,"end":29.351,"text":"Gba gbogbo rẹ kọja,","marked":"Gba gbogbo rẹ̀ kọjá"},{"start":29.801,"end":31.596,"text":"Ki n le r'ogo ainipẹkun,","marked":"Kí n lè r'ògo àìnípẹ̀kun"},{"start":32.046,"end":33.23,"text":"Ki n si le ba Ọ yọ.","marked":"Kí n sì lè bá Ọ yọ̀."}],"end":33.23},{"key":"5","start":34.18,"lines":[{"start":34.18,"end":35.382,"text":"Jesu jọ ranti mi,","marked":"Jésù jọ rántí mi"},{"start":35.832,"end":37.079,"text":"Ki n le kọrin loke;","marked":"Kí n lè kọrin lókè"},{"start":37.529,"end":39.392,"text":"Si Baba, mi ati Rẹ,","marked":"Sí Baba, mi àti Rẹ̀"},{"start":39.842,"end":41.265,"text":"Orin 'yin at' ifẹ.","marked":"Orin yín àt ìfẹ́."}],"end":41.265}]}