{"v":3,"coll":"y","num":393,"id":"hymn_393","title":"OLORUN Olodumare","duration":38.233,"voices":{"male":{"file":"y-393-male-v3.m4a","bytes":261423,"sha256":"71e48036706c66956ff785b69bd50f212d5b344bb051b552dd2544e4970d4dd3","duration":38.3},"female":{"file":"y-393-female-v3.m4a","bytes":264809,"sha256":"afaed4f78e5a07a43b5b93b9421671a6dff8e013c5a92ac552a98c318c2469dc","duration":38.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.311,"text":"Ọlọrun Olodumare,","marked":"Ọlọ́run Olódùmarè"},{"start":1.761,"end":3.891,"text":"Baba, Ọmọ, Ẹmi,","marked":"Baba, Ọmọ, Ẹ̀mí"},{"start":4.341,"end":5.996,"text":"Riri ẹni t'a ko le mọ,","marked":"Rírí ẹni t'á kò le mọ́"},{"start":6.446,"end":7.987,"text":"Ẹni t'a ko le ri.","marked":"Ẹni t'á kò lè rí."}],"end":7.987},{"key":"2","start":8.937,"lines":[{"start":8.937,"end":10.305,"text":"Ye! Baba Olodumare,","marked":"Yẹ! Baba Olódùmarè"},{"start":10.755,"end":11.792,"text":"K'a wariri fun Ọ,","marked":"K'á wárìrì fún Ọ"},{"start":12.242,"end":13.294,"text":"Ni gbogbo orilẹ ede,","marked":"Ní gbogbo orílẹ̀ èdè"},{"start":13.744,"end":14.962,"text":"Ni a o ma sin Ọ.","marked":"Ni a ó má sin Ọ́."}],"end":14.962},{"key":"3","start":15.912,"lines":[{"start":15.912,"end":17.396,"text":"Olorun omo, Ore wa","marked":"Ọlọ́run ọmọ, Ọ̀rẹ́ wa"},{"start":17.846,"end":18.968,"text":"Wo t'o ra wa pada","marked":"Wò t'ó rà wá padà"},{"start":19.418,"end":20.768,"text":"Ma jowo wa, Olugbala!","marked":"Má jọ̀wọ́ wá, Olùgbàlà!"},{"start":21.218,"end":22.425,"text":"Gba wa patapata.","marked":"Gbà wá pátápátá."}],"end":22.425},{"key":"4","start":23.375,"lines":[{"start":23.375,"end":24.825,"text":"A! Olorun Emi Mimo","marked":"A! Ọlọ́run Ẹ̀mí Mímọ́"},{"start":25.275,"end":26.333,"text":"'Wo olore‐ofe","marked":"wo olore-ofe"},{"start":26.783,"end":28.401,"text":"A be O, fun wa ni imo","marked":"A bẹ̀ Ọ́, fún wa ní ìmọ̀"},{"start":28.851,"end":29.989,"text":"K'a m'Olorun n'ife.","marked":"K'á m'Ọlọ́run n'ìfẹ́."}],"end":29.989},{"key":"5","start":30.939,"lines":[{"start":30.939,"end":32.244,"text":"Ọkansoso sugbọn mẹta,","marked":"Ọkànsoso sùgbọ́n mẹ́ta"},{"start":32.694,"end":33.71,"text":"Ẹmi Mẹtalọkan,","marked":"Ẹ̀mí Mẹ́talọ́kan"},{"start":34.16,"end":35.298,"text":"Ọlọrun awamaridi,","marked":"Ọlọ́run awamaridi"},{"start":35.748,"end":36.683,"text":"Ẹni Mẹtalọkan!","marked":"Ẹni Mẹ́talọ́kan!"}],"end":36.683}]}