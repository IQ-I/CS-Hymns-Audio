{"v":3,"coll":"y","num":125,"id":"hymn_125","title":"GBOGBO eda abe orun","duration":17.48,"voices":{"male":{"file":"y-125-male-v3.m4a","bytes":115069,"sha256":"ea55b944b64013f57ce2cb5903e9297850f9488d59ad8bd5ab9e404993fa6055","duration":17.5},"female":{"file":"y-125-female-v3.m4a","bytes":118950,"sha256":"3f0dab8dba436ed38f809485a15b4168b4b1311aee05b200fc0e893b3e52c907","duration":17.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.758,"text":"GBOGBO eda abe orun","marked":"Gbogbo ẹ̀dá abẹ́ ọ̀run"},{"start":2.208,"end":3.532,"text":"E f'iyin fun Eleda wa,","marked":"Ẹ f'ìyìn fún Ẹlẹ́dàá wa"},{"start":3.982,"end":5.235,"text":"Ki gbogbo orile-ede","marked":"Kí gbogbo orile-ede"},{"start":5.685,"end":6.674,"text":"Korin iyin Olugbala.","marked":"Kọrin ìyìn Olùgbàlà."}],"end":6.674},{"key":"2","start":7.624,"lines":[{"start":7.624,"end":9.47,"text":"Oluwa, anu Rẹ ki ti,","marked":"Olúwa, àánú Rẹ̀ kí tí"},{"start":9.92,"end":11.39,"text":"Ootọ Rẹ si duro lailai;","marked":"Òótọ́ Rẹ̀ sì dúró láéláé"},{"start":11.84,"end":13.578,"text":"Iyin Rẹ y'o tan kakiri,","marked":"Ìyìn Rẹ̀ y'ó tàn kákiri"},{"start":14.028,"end":15.931,"text":"Tit' orun y'o la laiwọ mọ.","marked":"Tít ọ̀run y'ó là láìwọ mọ́."}],"end":15.931}]}