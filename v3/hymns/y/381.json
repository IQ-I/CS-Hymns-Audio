{"v":3,"coll":"y","num":381,"id":"hymn_381","title":"ADABA orun sokale","duration":34.508,"voices":{"male":{"file":"y-381-male-v3.m4a","bytes":240786,"sha256":"7c3d18edc469404e3492158d0f83c7d28e590546398c94b83a70e8bfac322451","duration":34.6},"female":{"file":"y-381-female-v3.m4a","bytes":244970,"sha256":"ca2ae027c51762a4c50596be659fc02044c02c8860580feeb56eea7138291ddb","duration":34.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.133,"text":"Adaba ọrun, sọkalẹ,","marked":"Àdàbà ọ̀run, sọ̀kalẹ̀"},{"start":2.583,"end":4.469,"text":"Gbe wa lọ l'apa iyẹ Rẹ;","marked":"Gbé wa lọ l'apá ìyẹ́ Rẹ"},{"start":4.919,"end":6.723,"text":"f Ki o si gbe wa ga soke,","marked":"f Kí o sì gbé wa ga sókè"},{"start":7.173,"end":8.42,"text":"Ju gbogbo ohun ayé lọ.","marked":"Ju gbogbo ohun ayé lọ."}],"end":8.42},{"key":"2","start":9.37,"lines":[{"start":9.37,"end":10.628,"text":"Awa iba le ri ite","marked":"Àwa ìbá lè rí ìtẹ́"},{"start":11.078,"end":12.3,"text":"Olodumare Baba wa","marked":"Olódùmarè Baba wa"},{"start":12.75,"end":14.185,"text":"Olugbala joko nibe","marked":"Olùgbàlà jókò níbẹ̀"},{"start":14.635,"end":16.292,"text":"O gunwa l'awo bi tiwa.","marked":"Ó gúnwà l'àwo bí tiwa."}],"end":16.292},{"key":"3","start":17.242,"lines":[{"start":17.242,"end":18.593,"text":"Ẹgbẹ mimọ duro yi ka,","marked":"Ẹgbẹ́ mímọ́ dúró yí ká"},{"start":19.043,"end":20.375,"text":"Itẹ Agbara wolẹ fun,","marked":"Ìtẹ́ Agbára wólẹ̀ fún"},{"start":20.825,"end":22.011,"text":"Ọlọrun han ninu ara,","marked":"Ọlọ́run hàn nínú ara"},{"start":22.461,"end":24.111,"text":"O si tan ogo yi wọn ka.","marked":"Ó sì tan ògo yí wọn ká."}],"end":24.111},{"key":"4","start":25.061,"lines":[{"start":25.061,"end":26.646,"text":"Oluwa, akoko wo ni,","marked":"Olúwa, àkókò wo ni"},{"start":27.096,"end":28.561,"text":"Emi o de bugbe loke?","marked":"Èmi ó dé bùgbé lókè?"},{"start":29.011,"end":30.246,"text":"T'emi o ma ba wọn wolẹ,","marked":"T'èmi ó má bá wọn wólẹ̀"},{"start":30.696,"end":32.958,"text":"Ki n ma sin Ọ, ki n ma kọrin?","marked":"Kí n má sin Ọ, kí n má kọrin?"}],"end":32.958}]}