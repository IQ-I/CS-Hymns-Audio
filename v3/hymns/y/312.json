{"v":3,"coll":"y","num":312,"id":"hymn_312","title":"OLORUN fe araye","duration":47.993,"voices":{"male":{"file":"y-312-male-v3.m4a","bytes":332183,"sha256":"1d9b5a0a7374ae6876a786837ae69d486ff772eb63aa077d56eff05c69c0cda4","duration":48.0},"female":{"file":"y-312-female-v3.m4a","bytes":347650,"sha256":"0478fcda9d7a923e054c6e188dbcb5a54d7f51308ba8c3bbf68fb142956a3aca","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.713,"text":"OLORUN fe araye,","marked":"Ọlọ́run fẹ́ aráyé"},{"start":2.163,"end":3.342,"text":"O fe tobe ge:","marked":"Ó fẹ́ tóbẹ̀ gé"},{"start":3.792,"end":4.851,"text":"T' O ran omo Re w' aiye","marked":"T Ó rán ọmọ Rẹ̀ w ayé"},{"start":5.301,"end":6.249,"text":"T' Oku fun elese,","marked":"T Òkú fún ẹlẹ́ṣẹ̀"},{"start":6.699,"end":7.933,"text":"Olorun ti mo tele,","marked":"Ọlọ́run tí mo tẹ́lẹ̀"},{"start":8.383,"end":9.806,"text":"Pe, emi o se si","marked":"Pé, èmi ó ṣe sí"},{"start":10.256,"end":11.724,"text":"Ofin ati Ife Re,","marked":"Òfin àti Ìfẹ́ Rẹ"},{"start":12.174,"end":13.198,"text":"lwo ha fe mi bi?","marked":"Ìwọ ha fẹ́ mi bí?"}],"end":13.198},{"key":"2","start":14.148,"lines":[{"start":14.148,"end":15.945,"text":"Loto, Olorun fe mi,","marked":"Lọ́tọ̀, Ọlọ́run fẹ́ mi"},{"start":16.395,"end":17.662,"text":"Ani ani ko si,","marked":"Àní àní kò sí"},{"start":18.112,"end":19.432,"text":"Awon t' o yipada si,","marked":"Àwọn t ó yípadà sí"},{"start":19.882,"end":20.935,"text":"Igbala ni nwon ri","marked":"Ìgbàlà ni wọ́n rí"},{"start":21.385,"end":22.813,"text":"Wo! Jesu Kristi jiya,","marked":"Wò! Jésù Kristi jìyà"},{"start":23.263,"end":24.999,"text":"Igi I'a kan A mo,","marked":"Igi l'á kan A mọ́"},{"start":25.449,"end":27.864,"text":"Wo ! eje Re ti o san,","marked":"Wò ! ẹ̀jẹ̀ Rẹ tí ó sàn"},{"start":28.314,"end":30.259,"text":"Wo! ro! ma dese mo.","marked":"Wò! rò! má dẹ́ṣẹ̀ mọ́."}],"end":30.259},{"key":"3","start":31.209,"lines":[{"start":31.209,"end":33.472,"text":"Jesu, agbelebu Re ni,","marked":"Jésù, àgbélébùú Rẹ̀ ni"},{"start":33.922,"end":35.14,"text":"Ngo kan ese mi Mo;","marked":"Ǹgò kan ẹsẹ̀ mi Mọ́"},{"start":35.59,"end":36.748,"text":"Labe agbelebu Re,","marked":"Lábẹ́ àgbélébùú Rẹ"},{"start":37.198,"end":38.324,"text":"Ngo we ese mi nu,","marked":"Ǹgò wẹ ẹsẹ̀ mi nù"},{"start":38.774,"end":40.049,"text":"Nigbati emi o ri O,","marked":"Nígbàtí èmi ó rí Ọ"},{"start":40.499,"end":41.478,"text":"Ni orun rere Re:","marked":"Ní ọ̀run rere Rẹ"},{"start":41.928,"end":43.153,"text":"Nki yio dekun yin O,","marked":"Ǹkì yóò dẹ́kun yín Ọ"},{"start":43.603,"end":45.369,"text":"F' ogo at'ola Re.","marked":"F ògo àt'ọlá Rẹ."},{"start":45.819,"end":46.444,"text":"Amin.","marked":"Àmín."}],"end":46.444}]}