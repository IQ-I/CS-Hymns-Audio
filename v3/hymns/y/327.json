{"v":3,"coll":"y","num":327,"id":"hymn_327","title":"HALLELUYA, Halleluya","duration":81.405,"voices":{"male":{"file":"y-327-male-v3.m4a","bytes":582747,"sha256":"43771b6c0b10c90161a48ca59e06588d88e8f21571b733648e407f697c24c311","duration":81.5},"female":{"file":"y-327-female-v3.m4a","bytes":599768,"sha256":"98b92370693e6784b1e4e39073b4453f4a4b493157c6d3577063988e9253c3c5","duration":81.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.207,"text":"HALLELUYA, Halleluya,","marked":"Hallelúyà, Hallelúyà"},{"start":2.657,"end":3.961,"text":"Ẹ gbe ohun ayọ ga,","marked":"Ẹ gbé ohun ayọ̀ ga"},{"start":4.411,"end":5.592,"text":"Ẹ kọ orin inu didun,","marked":"Ẹ kọ orin inú dídùn"},{"start":6.042,"end":7.083,"text":"K'ẹ si yin Ọlọrun wa!","marked":"K'ẹ sì yin Ọlọ́run wa!"},{"start":7.533,"end":9.036,"text":"Ẹni t'a kan m'agbelebu,","marked":"Ẹni t'á kan m'àgbélébùú"},{"start":9.486,"end":10.705,"text":"T'o jiya fun ẹsẹ wa;","marked":"T'ó jìyà fún ẹsẹ̀ wa"},{"start":11.155,"end":12.911,"text":"Jesu Kristi Ọba Ogo,","marked":"Jésù Kristi Ọba Ògo"},{"start":13.361,"end":14.792,"text":"Jinde kuro n'nu oku.","marked":"Jíǹde kúrò n'nú òkú."}],"end":14.792},{"key":"2","start":15.742,"lines":[{"start":15.742,"end":17.096,"text":"Irin idabu sẹ kuro,","marked":"Irin ìdàbú sẹ́ kúrò"},{"start":17.546,"end":19.306,"text":"Kristi ku O si tun ye,","marked":"Kristi kú Ó sì tún yẹ"},{"start":19.756,"end":21.711,"text":"O mu iye ati aiku,","marked":"Ó mú ìyè àti àìkú"},{"start":22.161,"end":23.593,"text":"Wa l'ọrọ ajinde Rẹ,","marked":"Wá l'ọ̀rọ̀ àjíǹde Rẹ"},{"start":24.043,"end":26.355,"text":"Krist ti sẹgun, awa sẹgun,","marked":"Krist ti sẹ́gun, àwa sẹ́gun"},{"start":26.805,"end":28.123,"text":"Nipa agbara nla Rẹ,","marked":"Nípa agbára ńlá Rẹ"},{"start":28.573,"end":30.106,"text":"Awa o jinde pelu Rẹ,","marked":"Àwa ó jíǹde pẹ̀lú Rẹ"},{"start":30.556,"end":31.913,"text":"A o ba wọ 'nu Ogo.","marked":"A ò bá wọ nù Ògo."}],"end":31.913},{"key":"3","start":32.863,"lines":[{"start":32.863,"end":35.093,"text":"Kristi jinde, akọbi ni,","marked":"Kristi jíǹde, àkọ́bí ni"},{"start":35.543,"end":36.816,"text":"Ninu awọn t'o ti sun,","marked":"Nínú àwọn t'ó ti sùn"},{"start":37.266,"end":38.762,"text":"Awọn yi ni y'o ji dide,","marked":"Àwọn yí ni y'ó jí dìde"},{"start":39.212,"end":40.667,"text":"Ni abọ Rẹ ẹkeji;","marked":"Ní àbọ̀ Rẹ̀ ẹ̀kejì"},{"start":41.117,"end":42.836,"text":"Ikore ti wọn ti pọn tan,","marked":"Ìkórè tí wọ́n ti pọ́n tán"},{"start":43.286,"end":44.683,"text":"Wọn n reti Olukore,","marked":"Wọ́n ń retí Olùkórè"},{"start":45.133,"end":46.418,"text":"Ẹni ti y'o mu wọn kuro,","marked":"Ẹni tí y'ó mú wọn kúrò"},{"start":46.868,"end":47.927,"text":"Ninu isa oku wọn.","marked":"Nínú isà òkú wọn."}],"end":47.927},{"key":"4","start":48.877,"lines":[{"start":48.877,"end":50.497,"text":"Awa jinde pẹlu Kristi,","marked":"Àwa jíǹde pẹ̀lú Kristi"},{"start":50.947,"end":52.316,"text":"To n fun wa l'ohun gbogbo,","marked":"Tó ń fún wa l'ohun gbogbo"},{"start":52.766,"end":54.555,"text":"Ojo, iri, ati ogo,","marked":"Ọjọ́, ìrì, àti ògo"},{"start":55.005,"end":56.267,"text":"To n tan jade loju Rẹ,","marked":"Tó ń tàn jáde lójú Rẹ̀"},{"start":56.717,"end":58.787,"text":"Oluwa, b'a ti wa l'ayé,","marked":"Olúwa, b'á ti wà l'ayé"},{"start":59.237,"end":60.457,"text":"Fa ọkan wa sọdọ Rẹ,","marked":"Fa ọkàn wá sọ́dọ̀ Rẹ"},{"start":60.907,"end":62.242,"text":"K'awọn angẹli sa wa jọ,","marked":"K'àwọn áńgẹ́lì sá wà jọ"},{"start":62.692,"end":64.119,"text":"Ki wọn ko wa d'ọdọ Rẹ.","marked":"Kí wọn kò wá d'ọ̀dọ̀ Rẹ."}],"end":64.119},{"key":"5","start":65.069,"lines":[{"start":65.069,"end":66.655,"text":"Halleluya, Halleluya!","marked":"Hallelúyà, Hallelúyà!"},{"start":67.105,"end":68.367,"text":"Ogo ni fun Ọlọrun;","marked":"Ògo ni fún Ọlọ́run"},{"start":68.817,"end":70.333,"text":"Halleluya, f'Olugbala,","marked":"Hallelúyà, f'Olùgbàlà"},{"start":70.783,"end":72.012,"text":"Ẹni t'o sẹgun iku;","marked":"Ẹni t'ó sẹ́gun ikú"},{"start":72.462,"end":73.615,"text":"Halleluya f'Ẹmi Mimọ ,","marked":"Hallelúyà f'Ẹ̀mí Mímọ́"},{"start":74.065,"end":75.671,"text":"Orisun 'fẹ, 'wa mimọ,","marked":"Orísun 'fẹ, wá mímọ́"},{"start":76.121,"end":77.986,"text":"Halleluya, Halleluya,","marked":"Hallelúyà, Hallelúyà"},{"start":78.436,"end":79.856,"text":"F'Ọlọrun Mẹtalọkan.","marked":"F'Ọlọ́run Mẹ́talọ́kan."}],"end":79.856}]}