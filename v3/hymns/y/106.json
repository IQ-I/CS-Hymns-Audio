{"v":3,"coll":"y","num":106,"id":"hymn_106","title":"YIN Oluwa, enyin mimo","duration":43.632,"voices":{"male":{"file":"y-106-male-v3.m4a","bytes":298132,"sha256":"fdfa65ce406c8f884dd13839a7767d0f79ee0cc78038121d8e20cf5c171ce937","duration":43.7},"female":{"file":"y-106-female-v3.m4a","bytes":311547,"sha256":"07b78fd71f19e221e609f1af742ecd2c0072fefbd2ad8e7d08f60f116ff0cb6f","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.79,"text":"YIN Oluwa, enyin mimo","marked":"Yín Olúwa, ẹ̀yin mímọ́"},{"start":2.24,"end":3.667,"text":"Awa ti je ni 'gbese to?","marked":"Àwa ti jẹ́ ní gbèsè tó?"},{"start":4.117,"end":5.424,"text":"Je k'a mu gbogbo ini wa","marked":"Jẹ́ k'á mú gbogbo ìní wá"},{"start":5.874,"end":6.89,"text":"Wa pelu ayo.","marked":"Wá pẹ̀lú ayọ̀."}],"end":6.89},{"key":"2","start":7.84,"lines":[{"start":7.84,"end":9.407,"text":"Jesus l'Oko t'o dara ju","marked":"Jésù l'Oko t'ó dára jù"},{"start":9.857,"end":11.525,"text":"O nfun wa l'okun l'oju 'ja","marked":"Ó ńfún wa l'òkun l'ojú jà"},{"start":11.975,"end":13.384,"text":"lbi kan ko le de ba wa","marked":"Ibi kan kò lè dé bá wa"},{"start":13.834,"end":15.043,"text":"'Gbat' a gbekele.","marked":"gbàt a gbẹ́kẹ̀lé."}],"end":15.043},{"key":"3","start":15.993,"lines":[{"start":15.993,"end":17.91,"text":"Gbekele yin le, eyin mimo","marked":"Gbẹ́kẹ̀lé yín lé, ẹ̀yin mímọ́"},{"start":18.36,"end":19.624,"text":"Olododo l'Olorun wa","marked":"Olódodo l'Ọlọ́run wa"},{"start":20.074,"end":22.625,"text":"Ko s'ohun to le, ya awon","marked":"Kò s'ohun tó le, ya àwọn"},{"start":23.075,"end":24.342,"text":"T'O fe l'odo Re.","marked":"T'Ó fẹ́ l'ọ̀dọ̀ Rẹ."}],"end":24.342},{"key":"4","start":25.292,"lines":[{"start":25.292,"end":26.658,"text":"F'ore ofe Re pa wa mo","marked":"F'oore ọ̀fẹ́ Rẹ pa wá mọ́"},{"start":27.108,"end":28.552,"text":"K'a le tubo faramo O","marked":"K'á lè túbọ̀ faramọ́ Ọ"},{"start":29.002,"end":30.575,"text":"Titi ao fi de 'nu ogo","marked":"Títí àó fi dé nù ògo"},{"start":31.025,"end":32.236,"text":"At' ayo l'orun.","marked":"Àt ayọ̀ l'ọ̀run."}],"end":32.236},{"key":"5","start":33.186,"lines":[{"start":33.186,"end":34.652,"text":"'Gbana l' ao de ibi mimo","marked":"gbáná l àó dé ibi mímọ́"},{"start":35.102,"end":36.916,"text":"'Gbana l'a o si di mimo","marked":"gbàná l'a ó sì di mímọ́"},{"start":37.366,"end":39.185,"text":"Ayo nla ti a ko so","marked":"Ayọ̀ ńlá tí a kò sọ"},{"start":39.635,"end":41.003,"text":"Ni y'o je ti wa.","marked":"Ní y'ó jẹ́ ti wá."},{"start":41.453,"end":42.083,"text":"Amin.","marked":"Àmín."}],"end":42.083}]}