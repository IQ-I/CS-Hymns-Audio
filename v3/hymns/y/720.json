{"v":3,"coll":"y","num":720,"id":"hymn_720","title":"OJO ayo l'eyi je","duration":67.999,"voices":{"male":{"file":"y-720-male-v3.m4a","bytes":464188,"sha256":"a15ff7d06da1618ed44649d535030d86238910d856c8a6a55ebd8ed81e956840","duration":68.0},"female":{"file":"y-720-female-v3.m4a","bytes":483312,"sha256":"fcfddd980d51b5366c765fc77b2c7e6f162f4b53bef4b9e70124a12be243e222","duration":68.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.438,"text":"ỌJỌ ayọ l'eyi jẹ,","marked":"Ọjọ́ ayọ̀ l'èyí jẹ́"},{"start":1.888,"end":3.085,"text":"Awa n s'ajọdun wa;","marked":"Àwa ń s'àjọ̀dún wa"},{"start":3.535,"end":4.994,"text":"Kérúbù n pe Séráfù,","marked":"Kérúbù ń pe Séráfù"},{"start":5.444,"end":6.564,"text":"Ẹ jade wa woran.","marked":"Ẹ jáde wá wòran."}],"end":6.564},{"key":"CHORUS","start":7.514,"lines":[{"start":7.514,"end":9.688,"text":"Halleluyah! korin kikan soke","marked":"Hallelúyà! kọrin kíkan sókè"},{"start":10.138,"end":12.243,"text":"Halleluyah! f'Oba Olorun wa.","marked":"Hallelúyà! f'Ọba Ọlọ́run wa."}],"end":12.243},{"key":"2","start":13.193,"lines":[{"start":13.193,"end":14.579,"text":"Ẹgbẹ ogun ọrun n ki wa,","marked":"Ẹgbẹ́ ogun ọ̀run ń kí wá"},{"start":15.029,"end":16.138,"text":"Pe mase jafara;","marked":"Pé máṣe jáfara"},{"start":16.588,"end":18.224,"text":"Akoko diẹ lo ku,","marked":"Àkókò díẹ̀ ló kú"},{"start":18.674,"end":19.975,"text":"T'ayé y'o kọja lọ.","marked":"T'ayé y'ó kọjá lọ."}],"end":19.975},{"key":"3","start":20.925,"lines":[{"start":20.925,"end":22.006,"text":"Ohun iyanu l'eyi,","marked":"Ohun ìyanu l'èyí"},{"start":22.456,"end":23.624,"text":"Nipa ti Ẹgbẹ na;","marked":"Nípa ti Ẹ̀gbẹ́ ná"},{"start":24.074,"end":25.548,"text":"Nigba t'igbagbọ ti sẹ,","marked":"Nígbà t'ìgbàgbọ́ ti sẹ́"},{"start":25.998,"end":27.502,"text":"A ko ri iru eyi ri.","marked":"A kò rí irú èyí rí."}],"end":27.502},{"key":"4","start":28.452,"lines":[{"start":28.452,"end":29.866,"text":"Gbogb' awọn alailera,","marked":"Gbogb àwọn aláìlera"},{"start":30.316,"end":31.592,"text":"T'o wa nin' Ẹgbẹ na;","marked":"T'ó wà nín Ẹgbẹ́ ná"},{"start":32.042,"end":33.413,"text":"Ọkunrin at'Obrinrin,","marked":"Ọkùnrin àt'ọbrìnrin"},{"start":33.863,"end":35.077,"text":"N jẹri si eyi na,","marked":"Ń jẹ́rí sí èyí ná"}],"end":35.077},{"key":"5","start":36.027,"lines":[{"start":36.027,"end":37.25,"text":"'Wọn to wa nigberiko,","marked":"'Wọn tó wà nígbèríko"},{"start":37.7,"end":39.14,"text":"N jẹri si otitọ;","marked":"Ń jẹ́rí sí òtítọ́"},{"start":39.59,"end":41.15,"text":"Pe ajẹ ko n'ipa mọ,","marked":"Pé àjẹ́ kò n'ipa mọ́"},{"start":41.6,"end":42.819,"text":"'Nu ẹgbẹ Séráfù.","marked":"nu ẹgbẹ́ Séráfù."}],"end":42.819},{"key":"6","start":43.769,"lines":[{"start":43.769,"end":44.918,"text":"Awọn t'o wa n'idalẹ,","marked":"Àwọn t'ó wà n'ìdálẹ̀"},{"start":45.368,"end":47.426,"text":"Wọn n sọpẹ, wọn si n jo,","marked":"Wọ́n ń sọpẹ́, wọ́n sì ń jó"},{"start":47.876,"end":49.553,"text":"Sanpọnna ko n'ipa mọ,","marked":"Sanpọ́nná kò n'ipa mọ́"},{"start":50.003,"end":51.092,"text":"'Nu ẹgbẹ Kérúbù","marked":"nu ẹgbẹ́ Kérúbù"}],"end":51.092},{"key":"7","start":52.042,"lines":[{"start":52.042,"end":53.835,"text":"Séráfù ma gbode kan,","marked":"Séráfù má gbọdẹ kan"},{"start":54.285,"end":55.534,"text":"Ko si'ru eyi ri;","marked":"Kò sí'ru èyí rí"},{"start":55.984,"end":57.34,"text":"Kérúbù ma gbode kan,","marked":"Kérúbù má gbọdẹ kan"},{"start":57.79,"end":59.381,"text":"Wọn n ji oku dide.","marked":"Wọ́n ń jí òkú dìde."}],"end":59.381},{"key":"8","start":60.331,"lines":[{"start":60.331,"end":61.471,"text":"Ogo fun Baba l'oke,","marked":"Ògo fún Baba l'òkè"},{"start":61.921,"end":62.973,"text":"Ogo ni fun Ọmọ;","marked":"Ògo ni fún Ọmọ"},{"start":63.423,"end":64.614,"text":"Ogo ni fun Ẹmi Mimọ ,","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":65.064,"end":66.45,"text":"Mẹtalọkan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":66.45}]}