{"v":3,"coll":"y","num":191,"id":"hymn_191","title":"WO! Oluwa l'awosanma","duration":52.345,"voices":{"male":{"file":"y-191-male-v3.m4a","bytes":365674,"sha256":"23ba3eb038ecc426a4db8d022f6c4be77718a1550881532e794632286eb4fdc9","duration":52.4},"female":{"file":"y-191-female-v3.m4a","bytes":375186,"sha256":"54de3ff48b1a642c2634be7dfb61e61891c082cb7725baa129db680edbd80f2f","duration":52.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.909,"text":"WO! Oluwa l'awọsanma,","marked":"Wò! Olúwa l'àwọsánmà"},{"start":2.359,"end":3.933,"text":"O mbọ l'ogo l'ọla Rẹ,","marked":"Ó mbọ̀ l'ògo l'ọlá Rẹ̀"},{"start":4.383,"end":5.902,"text":"Ẹni t'a pa fun ẹlẹsẹ,","marked":"Ẹni t'a pa fún ẹlẹ́sẹ̀"},{"start":6.352,"end":7.766,"text":"Mbọ pẹlu Angẹli Rẹ.","marked":"Mbọ́ pẹ̀lú Áńgẹ́lì Rẹ̀."},{"start":8.216,"end":9.041,"text":"Halleluyah!","marked":"Hallelúyà!"},{"start":9.491,"end":11.122,"text":"Halleluyah! Amin.","marked":"Hallelúyà! Àmín."}],"end":11.122},{"key":"CHORUS","start":12.072,"lines":[{"start":12.072,"end":12.927,"text":"Halleluyah!","marked":"Hallelúyà!"},{"start":13.377,"end":14.237,"text":"Halleluyah!","marked":"Hallelúyà!"}],"end":14.237},{"key":"2","start":15.187,"lines":[{"start":15.187,"end":16.972,"text":"Gbogbo ẹda, wa wo Jesu,","marked":"Gbogbo ẹ̀dá, wá wo Jésù"},{"start":17.422,"end":19.018,"text":"Asọ ogo l'a wọ fun,","marked":"Asọ̀ ògo l'á wọ̀ fún"},{"start":19.468,"end":21.656,"text":"Awọn t'o gan, awọn t'o pa,","marked":"Àwọn t'ó gan, àwọn t'ó pa"},{"start":22.106,"end":23.441,"text":"T'o kan mọ Agbelebu;","marked":"T'ó kan mọ́ Àgbélébùú"},{"start":23.891,"end":24.836,"text":"Wọn o sọkun,","marked":"Wọn ó sọkún"},{"start":25.286,"end":26.46,"text":"Bi wọn ba ri Oluwa.","marked":"Bí wọ́n bá rí Olúwa."}],"end":26.46},{"key":"3","start":27.41,"lines":[{"start":27.41,"end":29.186,"text":"Erekusu, okun, oke,","marked":"Erékùṣù, òkun, òkè"},{"start":29.636,"end":31.909,"text":"Ọrun, ayé, a fo lọ,","marked":"Ọ̀run, ayé, a fò lọ"},{"start":32.359,"end":34.448,"text":"Awọn t'o kọ, a da wọn ru,","marked":"Àwọn t'ó kọ́, a dá wọn rú"},{"start":34.898,"end":36.019,"text":"Nigba ti wọn gb'ohun Rẹ,","marked":"Nígbà tí wọ́n gb'ohùn Rẹ̀"},{"start":36.469,"end":37.562,"text":"Wa s'idajọ,","marked":"Wá s'ìdájọ́"},{"start":38.012,"end":39.573,"text":"Wa s'idajọ, wa ka lọ!","marked":"Wá s'ìdájọ́, wa ká lọ!"}],"end":39.573},{"key":"4","start":40.523,"lines":[{"start":40.523,"end":42.167,"text":"Irapada t'a ti ń reti,","marked":"Ìràpadà t'a ti ń retí"},{"start":42.617,"end":44.068,"text":"O de pẹlu ogo nla!","marked":"Ó dé pẹ̀lú ògo ńlá!"},{"start":44.518,"end":45.789,"text":"Awọn ti a gan pẹlu Rẹ,","marked":"Àwọn tí a gan pẹ̀lú Rẹ"},{"start":46.239,"end":47.862,"text":"Yoo pade Rẹ loj'ọrun!","marked":"Yóò pàdé Rẹ̀ lój'ọ̀run!"},{"start":48.312,"end":49.057,"text":"Halleluyah","marked":"Hallelúyà"},{"start":49.507,"end":50.795,"text":"Ọjọ Olugbala de.","marked":"Ọjọ́ Olùgbàlà dé."}],"end":50.795}]}