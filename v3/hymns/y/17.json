{"v":3,"coll":"y","num":17,"id":"hymn_17","title":"ERO di dun kan nso","duration":47.59,"voices":{"male":{"file":"y-17-male.m4a","bytes":344186,"sha256":"8cec72a3f7dbd317d8d65c12728db871718c8bb363f8c4cfbbe1ff95e85ece4c","duration":47.6},"female":{"file":"y-17-female.m4a","bytes":357467,"sha256":"3fd8d5902b10bcdab6ff8d931a7d6d227ea75af8302ae849a86e73d78faef49a","duration":47.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.938,"text":"ERO di dun kan nso","marked":"Èrò di dùn kan ǹṣó"},{"start":2.318,"end":3.756,"text":"S'okan mi fi ri fi ri,","marked":"S'ọkàn mi fi rí fi rí"},{"start":4.136,"end":5.624,"text":"Mo sunmo 'le mi lo ni","marked":"Mo súnmọ́ 'lé mi lọ ni"},{"start":6.004,"end":7.457,"text":"Ju bi mo ti sunmo ri.","marked":"Ju bí mo ti súnmọ́ rí."}],"end":7.457},{"key":"2","start":8.407,"lines":[{"start":8.407,"end":9.77,"text":"Mo sunmo 'te nla ni,","marked":"Mo súnmọ́ 'tẹ́ ńlá ni"},{"start":10.15,"end":11.569,"text":"Mo sunm'okan Kristi","marked":"Mo sùnm'ọkàn Kristi"},{"start":11.949,"end":13.174,"text":"Mo sumo 'le Baba","marked":"Mo súmó 'lé Bàbá"},{"start":13.554,"end":14.893,"text":"Nibiti 'bugbe pupo wa.","marked":"Níbitì 'bùgbé púpọ̀ wà."}],"end":14.893},{"key":"3","start":15.843,"lines":[{"start":15.843,"end":17.445,"text":"Mo sunmo 'te nla ni,","marked":"Mo súnmọ́ 'tẹ́ ńlá ni"},{"start":17.825,"end":18.876,"text":"T'a so e ru kale","marked":"T'á sọ ẹ́ ru kalẹ̀"},{"start":19.256,"end":20.567,"text":"T'a gb'agbele bu si le","marked":"T'á gb'àgbélé bù sí lé"},{"start":20.947,"end":22.352,"text":"T'a si be re gb'ade.","marked":"T'á sì bẹ̀ rẹ́ gb'adé."}],"end":22.352},{"key":"4","start":23.302,"lines":[{"start":23.302,"end":24.551,"text":"Lagbedemeji eyi,","marked":"Lágbẹ̀dẹ̀mejì èyí"},{"start":24.931,"end":25.911,"text":"Ni 'san‐omi dudu","marked":"Ní 'sàn-omi dúdú"},{"start":26.291,"end":27.872,"text":"Ti a o la koja dandan","marked":"Tí a ò là kọjá dandan"},{"start":28.252,"end":29.671,"text":"K'a to de 'mole na.","marked":"K'á tó dé 'mọ́lẹ̀ ná."}],"end":29.671},{"key":"5","start":30.621,"lines":[{"start":30.621,"end":32.118,"text":"Jesu, jo se mi pe","marked":"Jésù, jọ ṣe mí pé"},{"start":32.498,"end":33.74,"text":"So 'gba gbo mi di lile","marked":"Ṣó 'gbà gbọ́ mi di líle"},{"start":34.12,"end":35.587,"text":"Je ki n mo p'O sunmo mi","marked":"Jẹ́ kí n mọ p'Ó súnmọ́ mi"},{"start":35.967,"end":37.361,"text":"Leti bebe iku.","marked":"Létí bẹ̀bẹ̀ ikú."}],"end":37.361},{"key":"6","start":38.311,"lines":[{"start":38.311,"end":39.471,"text":"Ki nmo p'O sunmo mi","marked":"Kí nmo p'Ó súnmọ́ mi"},{"start":39.851,"end":41.297,"text":"Gba mba njin si koto;","marked":"Gba ḿbá ńjin sí kòtò"},{"start":41.677,"end":43.249,"text":"O le je pe mo nsumole,","marked":"Ó lè jẹ́ pé mo ńṣúmọlẹ̀"},{"start":43.629,"end":45.11,"text":"Sunmo ju bi mo ti ro.","marked":"Súnmọ́ ju bí mo ti rò."},{"start":45.49,"end":46.04,"text":"Amin.","marked":"Àmín."}],"end":46.04}]}