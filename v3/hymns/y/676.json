{"v":3,"coll":"y","num":676,"id":"hymn_676","title":"IYA l'olore mi","duration":35.295,"voices":{"male":{"file":"y-676-male-v3.m4a","bytes":234650,"sha256":"888ca472100b4202dc7d7cdc8b67dd3b16ce9fb37f54e1e0a0df3a15db2c7551","duration":35.3},"female":{"file":"y-676-female-v3.m4a","bytes":242288,"sha256":"e5088178b5be22fc14b2b6ab1c67125a7b54edb35ac86cf29e707c0df15ead1d","duration":35.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.377,"text":"IYA l'olore mi","marked":"Ìyá l'ọlọ́rẹ̀ mi"},{"start":1.827,"end":3.187,"text":"Ti ntoju mi Iaiye","marked":"Ti ńtọ́jú mi láìyẹ"},{"start":3.637,"end":4.814,"text":"Ti ngbe mi pon losan","marked":"Tí ńgbé mi pọ́n lọ́sàn"},{"start":5.264,"end":6.795,"text":"Ti nsun ti mi loru.","marked":"Tí ńsùn tì mí lóru."}],"end":6.795},{"key":"CHORUS","start":7.745,"lines":[{"start":7.745,"end":8.838,"text":"Iya ku ise","marked":"Ìyá kú iṣẹ́"},{"start":9.288,"end":10.098,"text":"Nigbawo ni","marked":"Nígbàwo ni"},{"start":10.548,"end":11.464,"text":"Ngo f'ope fun o","marked":"Ngọ́ f'ọpẹ́ fún ọ"},{"start":11.914,"end":12.86,"text":"Fun' toju mi?","marked":"Fún tọ́jú mi?"}],"end":12.86},{"key":"2","start":13.81,"lines":[{"start":13.81,"end":15.028,"text":"Eni bi 'ya ko si","marked":"Ẹni bí ya kò sí"},{"start":15.478,"end":16.521,"text":"Ninu gbogb'ebi mi","marked":"Nínú gbogb'ẹ̀bi mi"},{"start":16.971,"end":18.05,"text":"K'Olorun da mi si","marked":"K'Ọlọ́run dá mi sí"},{"start":18.5,"end":19.882,"text":"Ki nto iya temi.","marked":"Kí ńtọ́ ìyá tèmi."}],"end":19.882},{"key":"3","start":20.832,"lines":[{"start":20.832,"end":22.094,"text":"Baba ni jigi mi","marked":"Baba ni jìgì mi"},{"start":22.544,"end":23.485,"text":"Iya mi ni wura","marked":"Ìyá mi ní wúrà"},{"start":23.935,"end":25.186,"text":"Ti nsun ti mi loru","marked":"Tí ńsùn tì mí lóru"},{"start":25.636,"end":26.894,"text":"Ti ngbe mi pon kiri.","marked":"Ti ńgbé mi pọ́n kiri."}],"end":26.894},{"key":"4","start":27.844,"lines":[{"start":27.844,"end":28.948,"text":"Bi mo l'ogbon laiye","marked":"Bí mo l'ọgbọ́n láìyẹ"},{"start":29.398,"end":30.55,"text":"O wa lowo 'ya mi","marked":"Ó wà lọ́wọ́ yà mi"},{"start":31.0,"end":32.108,"text":"Bi mo si alagbon","marked":"Bí mo sí alágbọ́n"},{"start":32.558,"end":33.746,"text":"Ebi iya mi ni.","marked":"Ẹ̀bi ìyá mi ni."}],"end":33.746}]}