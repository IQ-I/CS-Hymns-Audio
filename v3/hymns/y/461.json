{"v":3,"coll":"y","num":461,"id":"hymn_461","title":"MO fi gbagbo ba Olorun mi rin","duration":64.852,"voices":{"male":{"file":"y-461-male-v3.m4a","bytes":458455,"sha256":"cbafb875c961131cc2e720845f651d79152b3287373b52f642edd50f98ccd81c","duration":64.9},"female":{"file":"y-461-female-v3.m4a","bytes":474913,"sha256":"e3f12a80726c69a235df4ed213e304f8b50f18792d4bd861232e0db7e2eaf517","duration":64.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.742,"text":"MO fi gbagbo ba Olorun mi rin","marked":"Mo fi gbàgbọ́ bá Ọlọ́run mi rìn"},{"start":2.192,"end":3.906,"text":"Ti ngo fi de 'te ogo","marked":"Tí ńgò fi dé tẹ́ ògo"},{"start":4.356,"end":5.994,"text":"Jowo Oluwa se mi ni Tire","marked":"Jọ̀wọ́ Olúwa ṣe mí ní Tìrẹ"},{"start":6.444,"end":7.497,"text":"K'emi r'oju rere Re.","marked":"K'èmi r'ojú rere Rẹ̀."}],"end":7.497},{"key":"CHORUS","start":8.447,"lines":[{"start":8.447,"end":10.148,"text":"Fa mi mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra Olúwa"},{"start":10.598,"end":12.308,"text":"S'ibi agbelebu t'oku","marked":"S'ibi àgbélébùú t'òkú"},{"start":12.758,"end":14.756,"text":"Fa mi mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra Olúwa"},{"start":15.206,"end":17.098,"text":"S'ibi eje Re t'o n'iye.","marked":"S'ibi ẹ̀jẹ̀ Rẹ̀ t'ó n'ìyẹ́."}],"end":17.098},{"key":"2","start":18.048,"lines":[{"start":18.048,"end":20.212,"text":"Nin'egba mefa nin' eya Lefi","marked":"Nín'ẹ̀gbà mẹ́fà nín ẹ̀yà Lefi"},{"start":20.662,"end":21.996,"text":"A f'edidi sami won,","marked":"A f'èdìdì sàmì wọn"},{"start":22.446,"end":24.899,"text":"Jehofa_Jire, k'O le ka wa kun","marked":"Jèhófà Jíre, k'Ó lè kà wá kún"},{"start":25.349,"end":26.55,"text":"Awon 'yanfe Re 'saju.","marked":"Àwọn yànfẹ́ Rẹ̀ sájú."}],"end":26.55},{"key":"3","start":27.5,"lines":[{"start":27.5,"end":29.701,"text":"Nin'Egba mefa eya Manase","marked":"Nín'ẹgbà mẹ́fà ẹ̀yà Manase"},{"start":30.151,"end":31.508,"text":"A f'edidi sami won","marked":"A f'èdìdì sàmì wọn"},{"start":31.958,"end":33.524,"text":"Oluwa jowo k'a le f'edidi","marked":"Olúwa jọ̀wọ́ k'á lè f'èdìdì"},{"start":33.974,"end":35.907,"text":"Sami s'Egbe Serafu (Kerubu).","marked":"Ṣàmì s'Ẹgbẹ́ Séráfù Kérúbù."}],"end":35.907},{"key":"4","start":36.857,"lines":[{"start":36.857,"end":38.988,"text":"Nin' egbe mefa eya Josefu","marked":"Nín ẹgbẹ́ mẹ́fà ẹ̀yà Josẹfu"},{"start":39.438,"end":40.73,"text":"A f 'edidi sami won","marked":"A f èdìdì sàmì wọn"},{"start":41.18,"end":43.706,"text":"Jehofa-Nassi K'O le f'edidi","marked":"Jehofa-nassi K'Ó lè f'èdìdì"},{"start":44.156,"end":46.005,"text":"Semi s'Egbe Kerubu (Serafu).","marked":"Ṣèmi s'Ẹgbẹ́ Kérúbù Séráfù."}],"end":46.005},{"key":"5","start":46.955,"lines":[{"start":46.955,"end":48.667,"text":"Oro Jehovah ko le lo l'ofo,","marked":"Ọ̀rọ̀ Jehovah kò lè lọ l'ọ̀fọ̀"},{"start":49.117,"end":50.661,"text":"Oro Baba ki sai se","marked":"Ọ̀rọ̀ Baba kì ṣàì ṣe"},{"start":51.111,"end":52.812,"text":"Ileri t'o se fun Abrahamu","marked":"Ìlérí t'ó ṣe fún Abrahamu"},{"start":53.262,"end":54.657,"text":"O mu se fun Isaaki.","marked":"Ó mú ṣe fún Isaaki."}],"end":54.657},{"key":"6","start":55.607,"lines":[{"start":55.607,"end":57.444,"text":"Enia Olorun kan ko le tosi","marked":"Ẹnìà Ọlọ́run kan kò lè tòsí"},{"start":57.894,"end":59.181,"text":"Nigbati aiye ti se","marked":"Nígbàtí ayé ti ṣe"},{"start":59.631,"end":61.486,"text":"Ma je ki ebi oro at'ale","marked":"Má jẹ́ kí ẹ̀bi ọ̀rọ̀ àt'àlè"},{"start":61.936,"end":63.303,"text":"P'awon Egbe Serafu.","marked":"P'àwọn Ẹgbẹ́ Séráfù."}],"end":63.303}]}