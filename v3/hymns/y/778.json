{"v":3,"coll":"y","num":778,"id":"hymn_778","title":"K'ORE-OFE Krist'Oluwa","duration":17.035,"voices":{"male":{"file":"y-778-male-v3.m4a","bytes":115438,"sha256":"cfa0351dc1767e826979de2a97c9d3588d87f17528b2d7d92dca6436b0803e0d","duration":17.1},"female":{"file":"y-778-female-v3.m4a","bytes":117974,"sha256":"396c6d383bacb680df0184f4614eafc8144feeb85847b3437da75518e0e69154","duration":17.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.888,"text":"K'ORE-OFE Krist'Oluwa","marked":"K'Oore-ọ̀fẹ́ Krist'olúwa"},{"start":2.338,"end":3.733,"text":"Ife Baba ailopin","marked":"Ìfẹ́ Baba àìlópin"},{"start":4.183,"end":5.358,"text":"Oju rere Emi Mimo","marked":"Ojú rere Ẹ̀mí Mímọ́"},{"start":5.808,"end":7.394,"text":"K'o t'oke ba s'ori wa.","marked":"K'ó t'òkè bá s'orí wa."}],"end":7.394},{"key":"2","start":8.344,"lines":[{"start":8.344,"end":9.936,"text":"Bayi l'a le wa n'irẹpọ,","marked":"Báyì l'a lè wà n'ìrẹpọ̀"},{"start":10.386,"end":11.55,"text":"Ninu wa pẹl' Oluwa,","marked":"Nínú wa pẹl' Olúwa"},{"start":12.0,"end":13.503,"text":"K'a si le n'idapọ didun,","marked":"K'á sì lè n'ìdàpọ̀ dídùn"},{"start":13.953,"end":15.485,"text":"At'ayọ t'ayé ko ni.","marked":"Àt'ayọ̀ t'ayé kò ní."}],"end":15.485}]}