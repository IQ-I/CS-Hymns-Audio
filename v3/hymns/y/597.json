{"v":3,"coll":"y","num":597,"id":"hymn_597","title":"JEHOVAH Rufi Baba wa","duration":105.689,"voices":{"male":{"file":"y-597-male-v3.m4a","bytes":732125,"sha256":"d6079c07e2b7f691632d3a11d6414edd0167227ef3145402c8d6c6ca25057014","duration":105.7},"female":{"file":"y-597-female-v3.m4a","bytes":762824,"sha256":"befd4744b4695a59d3eb534a69af363afc6c87f09b01967579301716ae827bb2","duration":105.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.849,"text":"JEHOVAH Rufi Baba wa","marked":"Jehovah Rufi Baba wa"},{"start":2.299,"end":3.801,"text":"Fun wa l'okan okun ilera","marked":"Fún wa l'ọkàn okùn ìlera"},{"start":4.251,"end":6.012,"text":"Ki a le jo f'iyin fun Baba","marked":"Kí a lè jọ f'ìyìn fún Baba"},{"start":6.462,"end":7.68,"text":"Gege bi awon t'orun.","marked":"Gẹ́gẹ́ bí àwọn t'ọ̀run."}],"end":7.68},{"key":"CHORUS","start":8.63,"lines":[{"start":8.63,"end":10.526,"text":"A! e wa k'a sin Jesu","marked":"A! ẹ wá k'á sin Jésù"},{"start":10.976,"end":13.39,"text":"Ipe na ndun, ronupiwada","marked":"Ìpè ná ńdùn, ronúpìwàdà"},{"start":13.84,"end":15.733,"text":"A! e wa k'a sin Jesu.","marked":"A! ẹ wá k'á sin Jésù."}],"end":15.733},{"key":"2","start":16.683,"lines":[{"start":16.683,"end":18.688,"text":"Gbogbo aiye, e yin Jesu","marked":"Gbogbo ayé, ẹ yin Jésù"},{"start":19.138,"end":20.105,"text":"Ohun rere d'ode","marked":"Ohun rere d'òde"},{"start":20.555,"end":22.022,"text":"E f'iyin fun Baba l'oke","marked":"Ẹ f'ìyìn fún Baba l'òkè"},{"start":22.472,"end":23.865,"text":"T'o d'Egbe yi sile.","marked":"T'ó d'Ẹgbẹ́ yí sílẹ̀."}],"end":23.865},{"key":"3","start":24.815,"lines":[{"start":24.815,"end":26.134,"text":"Gbogbo onigbagbo Ijo","marked":"Gbogbo onígbàgbọ́ Ìjọ"},{"start":26.584,"end":27.762,"text":"Orun ododo d'ode","marked":"Ọ̀run òdodo d'òde"},{"start":28.212,"end":29.464,"text":"Olorun npe nsisiyi","marked":"Ọlọ́run ńpè ńṣísíyì"},{"start":29.914,"end":31.421,"text":"E jek'a gbo ipe Re.","marked":"Ẹ jẹ́k'á gbọ́ ìpè Rẹ̀."}],"end":31.421},{"key":"4","start":32.371,"lines":[{"start":32.371,"end":34.03,"text":"Jehovah Nissi Baba wa","marked":"Jehovah Nissi Baba wa"},{"start":34.48,"end":35.696,"text":"Jek'a le je tire","marked":"Jẹ́k'á lè jẹ́ tirẹ̀"},{"start":36.146,"end":37.394,"text":"Emi Mimo 'Daba orun","marked":"Ẹ̀mí Mímọ́ dàbà ọ̀run"},{"start":37.844,"end":39.137,"text":"Jowo to wa s'ona.","marked":"Jọ̀wọ́ tó wá s'ọ̀nà."}],"end":39.137},{"key":"5","start":40.087,"lines":[{"start":40.087,"end":42.247,"text":"Ma banuje, ma b'ohun bo","marked":"Má banújẹ́, má b'ohun bọ̀"},{"start":42.697,"end":43.985,"text":"Ninu Egbe Serafu","marked":"Nínú Ẹgbẹ́ Séráfù"},{"start":44.435,"end":46.144,"text":"Olupese, Olugbala","marked":"Olùpèsè, Olùgbàlà"},{"start":46.594,"end":47.888,"text":"Ki yio fi o sile.","marked":"Kí yóò fi ọ́ sílẹ̀."}],"end":47.888},{"key":"6","start":48.838,"lines":[{"start":48.838,"end":50.113,"text":"Enyin Angeli mererin","marked":"Ẹ̀yin Áńgẹ́lì mẹ́rẹ̀rin"},{"start":50.563,"end":51.617,"text":"T'e gbe aiye dani","marked":"T'ẹ gbé ayé dáni"},{"start":52.067,"end":53.674,"text":"E jowo ma f'aiye sile O","marked":"Ẹ jọ̀wọ́ má f'ayé sílẹ̀ Ọ"},{"start":54.124,"end":55.287,"text":"E ma wo ' wa eda.","marked":"Ẹ má wò ' wá ẹ̀dá."}],"end":55.287},{"key":"7","start":56.237,"lines":[{"start":56.237,"end":58.049,"text":"Maikeli mimo pelu ida Re","marked":"Maikeli mímọ́ pẹ̀lú idà Rẹ"},{"start":58.499,"end":59.989,"text":"Ngesin fo yi wa ka","marked":"Ngẹ́sìn fò yí wa ká"},{"start":60.439,"end":61.796,"text":"Kerubu pelu ogun re","marked":"Kérúbù pẹ̀lú ogun rẹ̀"},{"start":62.246,"end":63.719,"text":"La 'ju awon ariran.","marked":"La ju àwọn aríran."}],"end":63.719},{"key":"8","start":64.669,"lines":[{"start":64.669,"end":66.372,"text":"A! ojo nla, ojo dajo","marked":"A! ọjọ́ ńlá, ọjọ́ dájọ́"},{"start":66.822,"end":68.165,"text":"Ma jek'oju ti wa","marked":"Má jẹ́k'ojú ti wá"},{"start":68.615,"end":69.956,"text":"T'oju gbogbo aiye yio pe","marked":"T'ojú gbogbo ayé yóò pé"},{"start":70.406,"end":71.761,"text":"Lodo Baba l'oke.","marked":"Lọ́dọ̀ Baba l'òkè."}],"end":71.761},{"key":"9","start":72.711,"lines":[{"start":72.711,"end":74.154,"text":"Jesu masai ran wa lowo","marked":"Jésù masai ràn wá lọ́wọ́"},{"start":74.604,"end":75.634,"text":"Mase fi wa sile","marked":"Máṣe fi wá sílẹ̀"},{"start":76.084,"end":77.647,"text":"Gbati danwo ba yi wa ka","marked":"Gbátí dánwò bá yí wa ká"},{"start":78.097,"end":79.375,"text":"Jesu gbe wa leke.","marked":"Jésù gbé wa lékè."}],"end":79.375},{"key":"10","start":80.325,"lines":[{"start":80.325,"end":82.178,"text":"Ko s'ore t'o dabi Jesu","marked":"Kò s'ọrẹ t'ó dàbí Jésù"},{"start":82.628,"end":83.984,"text":"Ko s'eni mba kepe","marked":"Kò s'ẹni mbá kẹpẹ"},{"start":84.434,"end":85.739,"text":"Mo wo waju mo wo ehin","marked":"Mo wọ̀ wájú mo wọ ẹ̀hìn"},{"start":86.189,"end":87.532,"text":"Alabaro ko si.","marked":"Alábàrò kò sí."}],"end":87.532},{"key":"11","start":88.482,"lines":[{"start":88.482,"end":90.141,"text":"Ranti pe o ti ko esu","marked":"Rántí pé ó ti kọ èṣù"},{"start":90.591,"end":91.81,"text":"Ati gbogbo ise re","marked":"Àti gbogbo iṣẹ́ rẹ"},{"start":92.26,"end":94.071,"text":"Egun ni fun o bi o tun","marked":"Ègún ni fún ọ bí ó tún"},{"start":94.521,"end":95.745,"text":"Pada sodo Esu.","marked":"Padà sọ́dọ̀ Èṣù."}],"end":95.745},{"key":"12","start":96.695,"lines":[{"start":96.695,"end":98.013,"text":"Ogo ni fun Baba l'oke","marked":"Ògo ni fún Baba l'òkè"},{"start":98.463,"end":99.55,"text":"Ogo ni f'Omo Re","marked":"Ògo ni f'Ọmọ Rẹ"},{"start":100.0,"end":101.254,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":101.704,"end":103.052,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":103.502,"end":104.14,"text":"Amin.","marked":"Àmín."}],"end":104.14}]}