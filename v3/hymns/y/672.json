{"v":3,"coll":"y","num":672,"id":"hymn_672","title":"FUN iyin Olodumare","duration":49.956,"voices":{"male":{"file":"y-672-male-v3.m4a","bytes":343728,"sha256":"b9fe2a940a5d445fb998a87b2f434c99db282ae41ce83dcb57707375348298d5","duration":50.0},"female":{"file":"y-672-female-v3.m4a","bytes":355888,"sha256":"f857e28a583db34f706d0b7ad9e327dbc210a189f30060628f6d67c733c4c90f","duration":50.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.525,"text":"FUN iyin Olodumare,","marked":"Fún ìyìn Olódùmarè"},{"start":1.975,"end":3.12,"text":"L'a s'ẹda ahọn wa,","marked":"L'á s'ẹ̀dà ahọ́n wa"},{"start":3.57,"end":5.187,"text":"L'awọn kan tilẹ kẹgan wa,","marked":"L'àwọn kan tilẹ̀ kẹ́gàn wá"},{"start":5.637,"end":6.941,"text":"K'a s'adura fun wọn.","marked":"K'á s'àdúrà fún wọn."}],"end":6.941},{"key":"2","start":7.891,"lines":[{"start":7.891,"end":9.255,"text":"Ifi-ni s'ẹsin ẹlẹya,","marked":"Ifi-ni s'ẹ̀sìn ẹlẹ́yà"},{"start":9.705,"end":10.779,"text":"Ko tọ n'ile-iwe,","marked":"Kò tọ́ n'ile-iwe"},{"start":11.229,"end":12.744,"text":"K'a si p'eniyan ni were","marked":"K'á sì p'ènìyàn ni wèrè"},{"start":13.194,"end":14.581,"text":"S'ewu iparun ni.","marked":"S'ẹ̀wù ìparun ni."}],"end":14.581},{"key":"3","start":15.531,"lines":[{"start":15.531,"end":17.4,"text":"Ẹnikẹni t'o wu k'o se","marked":"Ẹnikẹ́ni t'ó wù k'ó ṣe"},{"start":17.85,"end":19.277,"text":"Ti ba n so 'sọkusọ,","marked":"Tí bá ń sọ 'sọkusọ"},{"start":19.727,"end":21.499,"text":"S'awọn mimọ, s'ohun mimọ,","marked":"S'àwọn mímọ́, s'ohun mímọ́"},{"start":21.949,"end":23.14,"text":"L'Oluwa y'o lu pa.","marked":"L'Olúwa y'ó lu pa."}],"end":23.14},{"key":"4","start":24.09,"lines":[{"start":24.09,"end":25.346,"text":"'Gbat' awọn 'mọ buburu ni,","marked":"gbàt àwọn 'mọ búburú ni"},{"start":25.796,"end":27.376,"text":"N fi Elisa s'ẹsin,","marked":"Ń fi Eliṣa s'ẹ̀sìn"},{"start":27.826,"end":29.64,"text":"Ti wọn ń kigbe soke, wi pé,","marked":"Tí wọ́n ń kígbe sókè, wí pé"},{"start":30.09,"end":31.909,"text":"Goke lọ, 'wọ apari.","marked":"Gòkè lọ, 'wọ apárí."}],"end":31.909},{"key":"5","start":32.859,"lines":[{"start":32.859,"end":34.636,"text":"Lọgan k'Ọlọrun lu wọn pa?","marked":"Lọ́gán k'Ọlọ́run lù wọ́n pa?"},{"start":35.086,"end":36.449,"text":"T'o ran beari meji?","marked":"T'ó rán beari méjì?"},{"start":36.899,"end":38.523,"text":"T'o fa wọn ya pẹrẹpẹrẹ,","marked":"T'ó fà wọ́n ya pẹ́rẹpẹ̀rẹ"},{"start":38.973,"end":40.339,"text":"Titi wọn fi ke ku?","marked":"Títí wọ́n fi ké kú?"}],"end":40.339},{"key":"6","start":41.289,"lines":[{"start":41.289,"end":42.586,"text":"Ibinu Rẹ ti l'ẹru to!","marked":"Ìbínú Rẹ̀ ti l'ẹ̀rù tó!"},{"start":43.036,"end":43.998,"text":"S'awọn ọmọ-kọmọ;","marked":"S'àwọn ọmọ-kọmọ"},{"start":44.448,"end":46.861,"text":"Fi ore-ọfẹ Rẹ, Baba,","marked":"Fi ore-ọfẹ Rẹ, Baba"},{"start":47.311,"end":48.407,"text":"K'ahọn mi n'ijanu.","marked":"K'ahọ́n mi n'ìjánu."}],"end":48.407}]}