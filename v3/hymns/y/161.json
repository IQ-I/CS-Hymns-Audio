{"v":3,"coll":"y","num":161,"id":"hymn_161","title":"Emi Orun wa nisin yii","duration":43.423,"voices":{"male":{"file":"y-161-male-v3.m4a","bytes":300158,"sha256":"5dc409b7d5062fb3c8471317cd5ea068da57bcd0c37ede644cf6be79da806a4f","duration":43.5},"female":{"file":"y-161-female-v3.m4a","bytes":313527,"sha256":"b49f0813e24b14a81faf85b300fb476b29d26daeae37f6995939ac7765be3313","duration":43.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.798,"text":"Ẹmi Ọrun wa nisin yii,","marked":"Ẹ̀mí Ọ̀run wà nísìn yìí"},{"start":2.248,"end":3.696,"text":"Mi si wa b'a ti ń gbadura;","marked":"Mi sì wá b'á ti ń gbàdúrà"},{"start":4.146,"end":5.868,"text":"Orisun 'ye titun ni Ọ,","marked":"Orísun yẹ titun ni Ọ"},{"start":6.318,"end":8.38,"text":"Imọlẹ, ọjọ wa titun.","marked":"Ìmọ́lẹ̀, ọjọ́ wa titun."}],"end":8.38},{"key":"2","start":9.33,"lines":[{"start":9.33,"end":11.01,"text":"O mba wa gbe l'ọna ara,","marked":"Ó mbá wá gbé l'ọ̀nà ara"},{"start":11.46,"end":12.705,"text":"Iwọ ko si jinna si wa;","marked":"Ìwọ kò sì jìnnà sí wa"},{"start":13.155,"end":15.213,"text":"A o gbọ ohun Rẹ nitosi,","marked":"A ó gbọ́ ohùn Rẹ̀ nítòsí"},{"start":15.663,"end":16.89,"text":"Ẹmi rẹ n bẹmi wa sọrọ.","marked":"Ẹ̀mí rẹ̀ ń bẹ̀mí wá sọ̀rọ̀."}],"end":16.89},{"key":"3","start":17.84,"lines":[{"start":17.84,"end":19.531,"text":"Krist' l'Alagbawi wa loke","marked":"Krist l'Alágbàwí wà lókè"},{"start":19.981,"end":21.386,"text":"Iwo l'Alagbawi n'nu wa","marked":"Ìwọ l'Alágbàwí n'nú wa"},{"start":21.836,"end":23.067,"text":"Fi otito da wa lebi","marked":"Fi òtítọ́ dá wa lẹ́bi"},{"start":23.517,"end":24.938,"text":"Gbogbo awawi ese wa.","marked":"Gbogbo àwáwí ẹ̀ṣẹ̀ wa."}],"end":24.938},{"key":"4","start":25.888,"lines":[{"start":25.888,"end":27.199,"text":"Ọkan mi sẹ aigbagbọ pọ!!","marked":"Ọkàn mi sẹ́ àìgbàgbọ́ pọ̀!!"},{"start":27.649,"end":29.257,"text":"Mo m'ọna at' Olutọ mi;","marked":"Mo m'ọ̀nà àt Olùtọ́ mi"},{"start":29.707,"end":31.419,"text":"Dariji mi, 'Wọ Ọrẹ mi,","marked":"Dáríjì mi, 'Wọ Ọ̀rẹ́ mi"},{"start":31.869,"end":33.703,"text":"Fun 'yapa, mi igbakugba.","marked":"Fún yapa, mi ìgbàkúgbà."}],"end":33.703},{"key":"5","start":34.653,"lines":[{"start":34.653,"end":35.968,"text":"Pẹlu mi n' igba ko s'ọrẹ,","marked":"Pẹ̀lú mi ń ìgbà kò s'ọrẹ"},{"start":36.418,"end":37.646,"text":"Ti mo le f'asiri mi han;","marked":"Tí mo lè f'àṣírí mi hàn"},{"start":38.096,"end":39.5,"text":"'Gbat' ẹru leke l'ọkan mi,","marked":"gbàt ẹ̀rù lékè l'ọkàn mi"},{"start":39.95,"end":41.873,"text":"Jẹ ki n mọ Ọ, l'Olutunu.","marked":"Jẹ́ kí n mọ̀ Ọ́, l'Olùtùnú."}],"end":41.873}]}