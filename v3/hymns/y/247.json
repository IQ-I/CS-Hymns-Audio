{"v":3,"coll":"y","num":247,"id":"hymn_247","title":"NIGBA wen kehin si Sioni","duration":47.866,"voices":{"male":{"file":"y-247-male-v3.m4a","bytes":332263,"sha256":"dc48df2ec5c6a329a1f690aa92c91c7cd092cd560990b13e3b6dee9fa212c3ec","duration":47.9},"female":{"file":"y-247-female-v3.m4a","bytes":337488,"sha256":"5d91843d14349b61601cc02ba6e15e1ffa58d24c3d5c4520f493b250e3cdaafc","duration":47.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.769,"text":"NIGBA wọn kẹhin si Sioni,","marked":"Nígbà wọ́n kẹ́hìn sí Síónì"},{"start":2.219,"end":3.713,"text":"A! ọpọ n‘iye wọn;","marked":"A! ọ̀pọ̀ n'iye wọn"},{"start":4.163,"end":5.683,"text":"Mo sẹ b‘Olugbala wi pe,","marked":"Mo sẹ́ b'Olùgbàlà wí pé"},{"start":6.133,"end":7.493,"text":"Wọ fẹ kọ mi pẹlu?","marked":"Wọ́ fẹ́ kọ́ mi pẹ̀lú?"}],"end":7.493},{"key":"2","start":8.443,"lines":[{"start":8.443,"end":9.975,"text":"T‘emi t‘ọkan b‘iru eyi,","marked":"T'èmi t'ọkàn b'irú èyí"},{"start":10.425,"end":11.584,"text":"A fi b‘O di mi mu;","marked":"A fi b'Ó di mí mú"},{"start":12.034,"end":14.016,"text":"N ko le se ki n ma fa sẹhin,","marked":"N kò lè ṣe kí n má fà sẹ́hìn"},{"start":14.466,"end":15.711,"text":"K‘emi si dabi wọn.","marked":"K'èmi sì dàbí wọn."}],"end":15.711},{"key":"3","start":16.661,"lines":[{"start":16.661,"end":18.629,"text":"Mo mọ, Iwọ l‘o l‘agbara,","marked":"Mo mọ̀, Ìwọ l'ó l'agbára"},{"start":19.079,"end":20.392,"text":"Lati gba otosi;","marked":"Láti gba òtòṣì"},{"start":20.842,"end":22.057,"text":"Odọ tani emi o lọ?","marked":"Odọ̀ tani èmi ó lọ?"},{"start":22.507,"end":23.85,"text":"Bi mo kẹhin si Ọ?","marked":"Bí mo kẹ́hìn sí Ọ?"}],"end":23.85},{"key":"4","start":24.8,"lines":[{"start":24.8,"end":26.248,"text":"O da mi loju papa pe,","marked":"Ó dá mi lójú pápá pé"},{"start":26.698,"end":28.078,"text":"Iwọ ni Kristi na!","marked":"Ìwọ ni Kristi ná!"},{"start":28.528,"end":29.88,"text":"Ẹni t'o ni ẹmi iye,","marked":"Ẹni t'ó ní ẹ̀mí ìyè"},{"start":30.33,"end":31.536,"text":"Nipa ti ẹjẹ Rẹ.","marked":"Nípa ti ẹ̀jẹ̀ Rẹ."}],"end":31.536},{"key":"5","start":32.486,"lines":[{"start":32.486,"end":33.77,"text":"Ohun Rẹ f'isinmi fun mi,","marked":"Ohun Rẹ f'ìsinmi fún mi"},{"start":34.22,"end":35.511,"text":"O si l'ẹru mi lọ;","marked":"Ó sì l'ẹ̀rù mi lọ"},{"start":35.961,"end":37.33,"text":"Ifẹ Rẹ lo le mu mi yọ,","marked":"Ìfẹ́ Rẹ ló lè mú mi yọ̀"},{"start":37.78,"end":39.213,"text":"O si to f'ọkan mi.","marked":"Ó sì tó f'ọkàn mi."}],"end":39.213},{"key":"6","start":40.163,"lines":[{"start":40.163,"end":41.515,"text":"Bi 'bere yi ti dun mi to","marked":"Bí bẹ̀rẹ̀ yí ti dùn mí tó"},{"start":41.965,"end":42.836,"text":"'Pe emi o lo bi?","marked":"pé èmi ó lọ bí?"},{"start":43.286,"end":44.588,"text":"Oluwa, ni 'gbekele Re","marked":"Olúwa, ni gbẹ́kẹ̀lé Rẹ"},{"start":45.038,"end":46.316,"text":"Mo dahun pe “Beko.”","marked":"Mo dáhùn pé Beko."}],"end":46.316}]}