{"v":3,"coll":"y","num":399,"id":"hymn_399","title":"IWO Oro Olorun","duration":56.489,"voices":{"male":{"file":"y-399-male-v3.m4a","bytes":393031,"sha256":"fcc1437cd0c1773899126f4b97af663a6bb854e4a8d5d2f7753f43fbd67bb151","duration":56.5},"female":{"file":"y-399-female-v3.m4a","bytes":405184,"sha256":"e06a683523ea5842eda32ae8d056557c196387bcc8359e34f99b469c07c2ccc6","duration":56.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.238,"text":"IWỌ Ọrọ Ọlọrun,","marked":"Ìwọ Ọ̀rọ̀ Ọlọ́run"},{"start":1.688,"end":3.004,"text":"Ọgbọn at'oke wa,","marked":"Ọgbọ́n àt'òkè wá"},{"start":3.454,"end":4.922,"text":"Otọ ti ki yipada,","marked":"Òtọ̀ tí kì yípadà"},{"start":5.372,"end":6.373,"text":"Imọlẹ ayé wa:","marked":"Ìmọ́lẹ̀ ayé wà"},{"start":6.823,"end":8.046,"text":"Awa yin Ọ fun 'mọlẹ,","marked":"Àwa yín Ọ fún 'mọlẹ"},{"start":8.496,"end":9.384,"text":"T'inu Iwe mimọ;","marked":"T'inú Ìwé mímọ́"},{"start":9.834,"end":11.088,"text":"Fitila fun ẹsẹ wa;","marked":"Fìtílà fún ẹsẹ̀ wa"},{"start":11.538,"end":12.901,"text":"Ti n tan titi ayé.","marked":"Tí ń tàn títí ayé."}],"end":12.901},{"key":"2","start":13.851,"lines":[{"start":13.851,"end":15.201,"text":"Oluwa l'o f'ẹbun yi,","marked":"Olúwa l'ó f'ẹ̀bùn yí"},{"start":15.651,"end":16.765,"text":"Fun Ijọ Rẹ l'ayé,","marked":"Fún Ìjọ Rẹ̀ l'ayé"},{"start":17.215,"end":18.489,"text":"A n gbe 'mọlẹ na soke,","marked":"À ń gbé 'mọlẹ nà sókè"},{"start":18.939,"end":20.156,"text":"Lati tan y'ayé ka,","marked":"Láti tan y'ayé ká"},{"start":20.606,"end":21.877,"text":"Apoti wura n'ise,","marked":"Àpótí wúrà n'iṣẹ́"},{"start":22.327,"end":23.434,"text":"O kun fun Otitọ;","marked":"Ó kún fún Òtítọ́"},{"start":23.884,"end":25.28,"text":"Aworan Kristi si ni;","marked":"Àwòrán Kristi sì ni"},{"start":25.73,"end":26.902,"text":"Ọrọ iye totọ.","marked":"Ọ̀rọ̀ ìyè tótọ́."}],"end":26.902},{"key":"3","start":27.852,"lines":[{"start":27.852,"end":29.257,"text":"O n fẹ lẹlẹ b'asia,","marked":"Ó ń fẹ́ lẹ́lẹ̀ b'asia"},{"start":29.707,"end":30.887,"text":"T'a ta loju ogun;","marked":"T'á ta lójú ogun"},{"start":31.337,"end":32.691,"text":"O n tan b'ina alore;","marked":"Ó ń tan b'iná alóre"},{"start":33.141,"end":34.362,"text":"Si okunkun ayé,","marked":"Sí òkùnkùn ayé"},{"start":34.812,"end":36.029,"text":"Amọna eniyan ni","marked":"Amọ̀nà ènìyàn ni"},{"start":36.479,"end":37.595,"text":"Ni wahala gbogbo,","marked":"Ní wàhálà gbogbo"},{"start":38.045,"end":39.351,"text":"Nin' arin omi ayé;","marked":"Nín arin omi ayé"},{"start":39.801,"end":41.004,"text":"O n tọ wa sọdọ Krist.","marked":"Ó ń tọ̀ wá sọ́dọ̀ Krist."}],"end":41.004},{"key":"4","start":41.954,"lines":[{"start":41.954,"end":43.043,"text":"Olugbala, se 'jọ Rẹ,","marked":"Olùgbàlà, ṣe 'jọ Rẹ"},{"start":43.493,"end":44.458,"text":"Ni fitila wura;","marked":"Ní fìtílà wúrà"},{"start":44.908,"end":46.235,"text":"Lati tan imọlẹ Rẹ,","marked":"Láti tan ìmọ́lẹ̀ Rẹ"},{"start":46.685,"end":47.631,"text":"B'ayé igbani;","marked":"B'ayé ìgbáni"},{"start":48.081,"end":49.387,"text":"Kọ awọn ti o sako,","marked":"Kọ àwọn tí ó ṣáko"},{"start":49.837,"end":51.202,"text":"Lati lo 'mọlẹ yi;","marked":"Láti lọ 'mọlẹ yí"},{"start":51.652,"end":53.323,"text":"Tit' okun ayé y'o pin,","marked":"Tít okùn ayé y'ó pín"},{"start":53.773,"end":54.94,"text":"Ti wọn o r'oju Rẹ.","marked":"Tí wọn ó r'ojú Rẹ."}],"end":54.94}]}