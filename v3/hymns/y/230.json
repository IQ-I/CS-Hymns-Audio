{"v":3,"coll":"y","num":230,"id":"hymn_230","title":"ODUN miiran tun ti de","duration":91.03,"voices":{"male":{"file":"y-230-male-v3.m4a","bytes":651232,"sha256":"58f55e30bda39c26f6f01024e00ff06b68d06ac0181b8b11cdcd52ae0ff25f13","duration":91.1},"female":{"file":"y-230-female-v3.m4a","bytes":664909,"sha256":"8b6daa6128d9eb80801e20723959cb63f9c34de35bee881a54b19e5df262aa69","duration":91.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.908,"text":"ODUN miiran tun ti de","marked":"Ọdún mìíràn tún ti dé"},{"start":2.358,"end":3.445,"text":"Ona t'a ko rin ri","marked":"Ọ̀nà t'a kò rìn rí"},{"start":3.895,"end":5.118,"text":"Yoo fun mi ni ikilo","marked":"Yóò fún mi ní ìkìlọ̀"},{"start":5.568,"end":6.667,"text":"B'iranlowo ko si","marked":"B'ìrànlọ́wọ́ kò sí"},{"start":7.117,"end":8.742,"text":"Sugbon Eni t'O to mi","marked":"Ṣùgbọ́n Ẹni t'Ó tọ̀ mi"},{"start":9.192,"end":10.399,"text":"Ni odun t'o koja","marked":"Ní ọdún t'ó kọjá"},{"start":10.849,"end":12.394,"text":"Se 'leri p'Oun yoo duro","marked":"Ṣe lérí p'Òun yóò dúró"},{"start":12.844,"end":13.853,"text":"Ti mi nigba gbogbo.","marked":"Tì mí nígbà gbogbo."}],"end":13.853},{"key":"2","start":14.803,"lines":[{"start":14.803,"end":16.148,"text":"Odun mii pelu Jesu","marked":"Ọdún míì pẹ̀lú Jésù"},{"start":16.598,"end":17.694,"text":"Emi ko mo 'foya","marked":"Èmi kò mọ fòyà"},{"start":18.144,"end":19.392,"text":"Yebiye ni ife Re","marked":"Yẹ̀bíye ni ìfẹ́ Rẹ"},{"start":19.842,"end":21.319,"text":"B'o ti wu k'iji le","marked":"B'ó ti wù k'ìjì le"},{"start":21.769,"end":23.206,"text":"Gba t'iji ba tile le","marked":"Gba t'ìjì bá tilẹ̀ lé"},{"start":23.656,"end":24.68,"text":"No sinmi ninu Re","marked":"Nó sinmi nínú Rẹ̀"},{"start":25.13,"end":26.281,"text":"No r'alaafia didun","marked":"Nó r'àlàáfíà dídùn"},{"start":26.731,"end":28.03,"text":"Ni ookan aya Re.","marked":"Ní oókan àyà Rẹ."}],"end":28.03},{"key":"3","start":28.98,"lines":[{"start":28.98,"end":30.471,"text":"Odun ti n o gbekele E","marked":"Ọdún tí n ó gbẹ́kẹ̀lé Ẹ"},{"start":30.921,"end":32.229,"text":"N o tun gbekele I'Eni","marked":"N ó tún gbẹ́kẹ̀lé l'Ẹni"},{"start":32.679,"end":33.917,"text":"Ti koja mi kule ri","marked":"Ti kọjá mi kulẹ̀ rí"},{"start":34.367,"end":35.541,"text":"Gba ti mo n wo'oju Re","marked":"Gbà tí mo ń wo'ojú Rẹ"},{"start":35.991,"end":37.692,"text":"O f'ogo at'opa Re","marked":"Ó f'ògo àt'ọ̀pá Rẹ̀"},{"start":38.142,"end":39.524,"text":"Fun mi, fun okun mi","marked":"Fún mi, fún okùn mi"},{"start":39.974,"end":41.578,"text":"Jeejee l'O si n to mi lo","marked":"Jéèjéé l'Ó sì ń tọ̀ mí lọ"},{"start":42.028,"end":43.366,"text":"L'ona mi lo s'ile.","marked":"L'ọ́nà mi lọ s'ilẹ̀."}],"end":43.366},{"key":"4","start":44.316,"lines":[{"start":44.316,"end":45.826,"text":"Odun miiran lnti sin in","marked":"Ọdún mìíràn Ìǹtí sin ín"},{"start":46.276,"end":47.723,"text":"Ki n s'ise fun un nihin","marked":"Kí n s'iṣẹ́ fún un níhìn"},{"start":48.173,"end":49.519,"text":"Gba l'ojiji tile gun","marked":"Gba l'òjìji tilẹ̀ gùn"},{"start":49.969,"end":51.173,"text":"Orun tun n sunmo le","marked":"Ọ̀run tún ń súnmọ́ lé"},{"start":51.623,"end":53.373,"text":"N ko mo gba ti yoo pe mi","marked":"N kò mo gbà tí yóò pè mí"},{"start":53.823,"end":55.23,"text":"Lati f'ise sile","marked":"Láti f'iṣẹ́ sílẹ̀"},{"start":55.68,"end":57.399,"text":"je ki n le je olooto","marked":"jẹ́ kí n lè jẹ́ olóòtọ́"},{"start":57.849,"end":59.231,"text":"B'ojo ti n sure lo.","marked":"B'ọjọ́ tí ń súre lọ."}],"end":59.231},{"key":"5","start":60.181,"lines":[{"start":60.181,"end":61.422,"text":"Odun miiran lati fe E","marked":"Ọdún mìíràn láti fẹ́ Ẹ"},{"start":61.872,"end":63.101,"text":"Eni ti mo feran","marked":"Ẹni tí mo fẹ́ràn"},{"start":63.551,"end":65.008,"text":"Odun miiran lati yin in","marked":"Ọdún mìíràn láti yìn ín"},{"start":65.458,"end":66.477,"text":"Pelu orin segun","marked":"Pẹ̀lú orin ṣẹ́gun"},{"start":66.927,"end":68.011,"text":"Ohun t'ola le mu wa","marked":"Ohun t'ọlá lè mú wá"},{"start":68.461,"end":69.884,"text":"Banuje tab'iya","marked":"Banújẹ́ tàb'ìyá"},{"start":70.334,"end":71.606,"text":"lfe Re duro laelae","marked":"Ìfẹ́ Rẹ dúró láéláé"},{"start":72.056,"end":73.538,"text":"Okan naa ni titi.","marked":"Ọkàn náà ni títí."}],"end":73.538},{"key":"6","start":74.488,"lines":[{"start":74.488,"end":75.877,"text":"Odun mii pelu Jesu","marked":"Ọdún míì pẹ̀lú Jésù"},{"start":76.327,"end":77.331,"text":"Oluwa mo dupe","marked":"Olúwa mo dúpẹ́"},{"start":77.781,"end":79.659,"text":"F'oju Re ti ki i kuna","marked":"F'ojú Rẹ tí kì í kùnà"},{"start":80.109,"end":81.23,"text":"L'ona ajo aye","marked":"L'ọ́nà àjọ ayé"},{"start":81.68,"end":83.065,"text":"Joo maa to mi, Oluwa","marked":"Jọ̀ọ́ máa tọ̀ mi, Olúwa"},{"start":83.515,"end":84.635,"text":"Ko mi ki n se 'fe Re","marked":"Kò mi kí n ṣe fẹ́ Rẹ"},{"start":85.085,"end":86.468,"text":"Si mu ete ti Re se","marked":"Sì mú ètè tí Rẹ̀ ṣe"},{"start":86.918,"end":88.456,"text":"L'aye mi l'ojoojo.","marked":"L'ayé mi l'ọjọ́ọjọ́."},{"start":88.906,"end":89.482,"text":"Amin.","marked":"Àmín."}],"end":89.482}]}