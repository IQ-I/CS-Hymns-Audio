 'pa titi o)","marked":"Ngọ́ má lọ lát ipa dé pa títí ó"},{"start":32.886,"end":34.734,"text":"Ngo fi gunle s'ebute Ogo). - 2ce","marked":"Ngo fi gúnlẹ̀ s'èbúté Ògo."}],"end":34.734},{"key":"3","start":35.684,"lines":[{"start":35.684,"end":37.45,"text":"Ojo kan ninu agbala Oluwa)","marked":"Ọjọ́ kan nínú àgbàlá Olúwa"},{"start":37.9,"end":39.68,"text":"O san ju egberun ojo lo)","marked":"Ó sàn ju ẹgbẹ̀rún ọjọ́ lọ"},{"start":40.13,"end":42.339,"text":"Ore-Ofe pelu ibukun je t'Olorun) - 2ce","marked":"Oore-ọ̀fẹ́ pẹ̀lú ìbùkún jẹ́ t'Ọlọ́run"},{"start":42.789,"end":44.347,"text":"Ibukun ni f'eni to sin.","marked":"Ìbùkún ni f'ẹni tó sìn."}],"end":44.347},{"key":"4","start":45.297,"lines":[{"start":45.297,"end":47.429,"text":"Mimo, Pipe, l'Obaluwaiye)","marked":"Mímọ́, Pípẹ́, l'Obaluwaiye"},{"start":47.879,"end":48.543,"text":"Mimo o)","marked":"Mímọ́ ọ"},{"start":48.993,"end":51.244,"text":"Angeli e wa ka jumo sin o)","marked":"Áńgẹ́lì ẹ wá ká jùmọ̀ sìn ọ́"},{"start":51.694,"end":53.314,"text":"Eni ba sin Erintunde)","marked":"Ẹni bá sin Erintunde"},{"start":53.764,"end":54.661,"text":"titi d'opin)","marked":"títí d'òpin"},{"start":55.111,"end":57.092,"text":"Yio gba ade iye l'ebute ogo) - 2ce","marked":"Yóò gba adé ìyè l'èbúté ògo"}],"end":57.092}]}