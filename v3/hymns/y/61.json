{"v":3,"coll":"y","num":61,"id":"hymn_61","title":"BABA WA ti mbe l'orun","duration":101.575,"voices":{"male":{"file":"y-61-male-v3.m4a","bytes":716908,"sha256":"d65712d40ea6d3c65ab80d3f5e377d8842fa710d96075f749fa2621977f136f6","duration":101.6},"female":{"file":"y-61-female-v3.m4a","bytes":755313,"sha256":"6b7d779f21903d8305306407830dace30c1c1b24489691ae49ea08484fe34cbe","duration":101.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.729,"text":"BABA wa ti mbẹ l'ọrun,","marked":"Baba wa ti mbẹ̀ l'ọ̀run"},{"start":2.179,"end":3.386,"text":"Ọwọ forukọ Rẹ,","marked":"Ọwọ́ forúkọ Rẹ"},{"start":3.836,"end":5.365,"text":"Ifẹ tirẹ ni ka se","marked":"Ìfẹ́ tirẹ̀ ni ká ṣe"},{"start":5.815,"end":6.956,"text":"Bi wọn ti n se lọrun,","marked":"Bí wọ́n ti ń ṣe lọ́rùn"},{"start":7.406,"end":8.673,"text":"Fun wa l'Ounjẹ ojọ wa","marked":"Fún wa l'Oúnjẹ ojọ́ wa"},{"start":9.123,"end":10.246,"text":"'Dari ẹsẹ ji wa,","marked":"dárí ẹsẹ̀ jì wá"},{"start":10.696,"end":11.894,"text":"Gba wa lọwọ idanwo,","marked":"Gbà wá lọ́wọ́ ìdánwò"},{"start":12.344,"end":13.375,"text":"Gba wa lọwọ ewu.","marked":"Gbà wá lọ́wọ́ ewu."}],"end":13.375},{"key":"2","start":14.325,"lines":[{"start":14.325,"end":15.584,"text":"Iwọ to gbọ t'Elijah","marked":"Ìwọ tó gbọ́ t'Elijah"},{"start":16.034,"end":17.336,"text":"L'ẹba odo Kedron","marked":"L'ẹ̀bá ọ̀dọ̀ Kedron"},{"start":17.786,"end":19.426,"text":"Iwọ to gbọ ti Daniel,","marked":"Ìwọ tó gbọ́ tí Daniẹl"},{"start":19.876,"end":20.949,"text":"Ko gbọ ti wa loni,","marked":"Kò gbọ́ ti wá lónì"},{"start":21.399,"end":22.608,"text":"Fun wa niru agbara","marked":"Fún wa nírú agbára"},{"start":23.058,"end":24.522,"text":"To fi f'awọn Apostle","marked":"Tó fi f'àwọn Apostle"},{"start":24.972,"end":26.186,"text":"K'awa le wulo fun Ọ","marked":"K'àwa lè wúlò fún Ọ"},{"start":26.636,"end":27.753,"text":"Ka jere bi ti wọn.","marked":"Ká jèrè bí ti wọ́n."}],"end":27.753},{"key":"3","start":28.703,"lines":[{"start":28.703,"end":29.934,"text":"Fun wa lọkan igbagbọ","marked":"Fún wa lọ́kàn ìgbàgbọ́"},{"start":30.384,"end":31.764,"text":"Ti ki y'o yẹ lailai,","marked":"Tí kì y'ó yẹ láéláé"},{"start":32.214,"end":33.567,"text":"Ka gbẹkẹle Ọ titi,","marked":"Ká gbẹ́kẹ̀lé Ọ títí"},{"start":34.017,"end":35.003,"text":"A o fi r'oju Rẹ,","marked":"A ó fi r'ojú Rẹ̀"},{"start":35.453,"end":36.747,"text":"Jẹ ka le ni ireti,","marked":"Jẹ́ ká lè ní ìrètí"},{"start":37.197,"end":38.261,"text":"Ninu Iwọ nikan,","marked":"Nínú Ìwọ nìkan"},{"start":38.711,"end":40.14,"text":"Ka nifẹ s'ẹnikeji,","marked":"Ká nífẹ́ s'ẹ́nikeji"},{"start":40.59,"end":41.872,"text":"Ka si n'iwa pẹlẹ.","marked":"Ká sì n'ìwà pẹ̀lẹ́."}],"end":41.872},{"key":"4","start":42.822,"lines":[{"start":42.822,"end":44.123,"text":"Baba a si tun mbẹ Ọ,","marked":"Baba a sì tún mbẹ́ Ọ"},{"start":44.573,"end":45.609,"text":"Ani fun Olori wa,","marked":"Àní fún Olórí wa"},{"start":46.059,"end":47.473,"text":"Ko fi Ẹmi meje Rẹ,","marked":"Kò fi Ẹ̀mí méje Rẹ̀"},{"start":47.923,"end":49.207,"text":"Se 'tura f'ọkan rẹ,","marked":"Ṣe tura f'ọkàn rẹ"},{"start":49.657,"end":50.868,"text":"Jẹ ki awa le ma rin","marked":"Jẹ́ kí àwa lè má rìn"},{"start":51.318,"end":52.781,"text":"Lọna to n tọ wa si,","marked":"Lọ́nà tó ń tọ̀ wá sí"},{"start":53.231,"end":54.711,"text":"Ko le ko wa de Canaan","marked":"Kò lè kọ́ wa dé Canaan"},{"start":55.161,"end":56.465,"text":"Niwaju Itẹ Rẹ.","marked":"Níwájú Ìtẹ́ Rẹ."}],"end":56.465},{"key":"5","start":57.415,"lines":[{"start":57.415,"end":58.729,"text":"Iwọ to gbọ ti Sedrak,","marked":"Ìwọ tó gbọ́ ti Sedrak"},{"start":59.179,"end":61.53,"text":"Mesak, Abednego","marked":"Meṣak, Abednego"},{"start":61.98,"end":63.294,"text":"Gbọ t'awa Ẹgbẹ Seraf',","marked":"Gbọ́ t'àwa Ẹgbẹ́ Seraf"},{"start":63.744,"end":65.117,"text":"Gba t'a ba n ke pe Ọ","marked":"Gba t'á bá ń ké pe Ọ"},{"start":65.567,"end":66.939,"text":"Fi agbara Rẹ wọ wa","marked":"Fi agbára Rẹ̀ wọ wá"},{"start":67.389,"end":68.874,"text":"Bi ti wolii isaju","marked":"Bí ti wòlíì ìṣájú"},{"start":69.324,"end":70.7,"text":"Ka ni 'gboya bi tiwọn,","marked":"Ká ni gboyà bí tiwọn"},{"start":71.15,"end":72.49,"text":"Ka sẹgun ayé yi.","marked":"Ká sẹ́gun ayé yí."}],"end":72.49},{"key":"6","start":73.44,"lines":[{"start":73.44,"end":74.283,"text":"Awọn ọmọ Israel,","marked":"Àwọn ọmọ Israẹl"},{"start":74.733,"end":75.661,"text":"Ninu rin ajo wọn,","marked":"Nínú rìn àjọ wọn"},{"start":76.111,"end":77.397,"text":"Iwọ lo n s'amọna wọn,","marked":"Ìwọ ló ń s'amọ̀nà wọn"},{"start":77.847,"end":78.887,"text":"Ati abo fun wọn","marked":"Àti abo fún wọn"},{"start":79.337,"end":80.696,"text":"Bi wọn ti n dẹsẹ si Ọ,","marked":"Bí wọ́n ti ń dẹ́sẹ̀ sí Ọ"},{"start":81.146,"end":82.377,"text":"Bẹẹ lo n dariji wọn,","marked":"Bẹ́ẹ̀ ló ń dáríjì wọn"},{"start":82.827,"end":84.253,"text":"Jọwọ ko dariji wa,","marked":"Jọ̀wọ́ kò dáríjì wá"},{"start":84.703,"end":85.986,"text":"Awa Ẹgbẹ Séráfù.","marked":"Àwa Ẹgbẹ́ Séráfù."}],"end":85.986},{"key":"7","start":86.936,"lines":[{"start":86.936,"end":88.078,"text":"Ọlọrun Abrahamu,","marked":"Ọlọ́run Abrahamu"},{"start":88.528,"end":89.644,"text":"Ọlọrun Isaaki,","marked":"Ọlọ́run Isaaki"},{"start":90.094,"end":91.279,"text":"Ati Ọlọrun Jakọbu,","marked":"Àti Ọlọ́run Jakọbu"},{"start":91.729,"end":92.79,"text":"Awa f'ọpẹ fun Ọ,","marked":"Àwa f'ọpẹ́ fún Ọ"},{"start":93.24,"end":94.671,"text":"Ogo, iyin, ọlanla","marked":"Ògo, ìyìn, ọláńlá"},{"start":95.121,"end":96.222,"text":"S'Ẹni Mẹtalọkan,","marked":"S'Ẹni Mẹ́talọ́kan"},{"start":96.672,"end":98.055,"text":"Halleluyah s'Ọlọrun,","marked":"Hallelúyà s'Ọlọ́run"},{"start":98.505,"end":100.026,"text":"Ayé ainipẹkun","marked":"Ayé àìnípẹ̀kun"}],"end":100.026}]}