{"v":3,"coll":"y","num":114,"id":"hymn_114","title":"Ninu gbogbo ayida aye","duration":47.693,"voices":{"male":{"file":"y-114-male-v3.m4a","bytes":329135,"sha256":"ee1edb864e983bac1c251d00f18cebaab0ef3c09166ecd1b64391b33d2d58b1c","duration":47.7},"female":{"file":"y-114-female-v3.m4a","bytes":337582,"sha256":"24257ec5dc6f6aa3b073a33d3d28b6b442c6b413ef2e0a6ba84ed8db021a36d1","duration":47.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.541,"text":"N'nu gbogbo ayida ayé,","marked":"N'nú gbogbo àyídà ayé"},{"start":1.991,"end":3.46,"text":"Ayọ oun wahala;","marked":"Ayọ̀ òun wàhálà"},{"start":3.91,"end":5.247,"text":"Iyin Ọlọrun ni y'o ma,","marked":"Ìyìn Ọlọ́run ni y'ó má"},{"start":5.697,"end":7.055,"text":"Wa l'nu mi titi.","marked":"Wá l'nú mi títí."}],"end":7.055},{"key":"2","start":8.005,"lines":[{"start":8.005,"end":9.217,"text":"Gbe Oluwa ga pẹlu mi,","marked":"Gbé Olúwa ga pẹ̀lú mi"},{"start":9.667,"end":10.897,"text":"Ba mi gb'ookọ Rẹ ga;","marked":"Bá mi gb'oòkọ Rẹ̀ ga"},{"start":11.347,"end":13.469,"text":"p N'nu wahala, 'gba mo ke pe,","marked":"p N'nú wàhálà, gbà mo ké pè"},{"start":13.919,"end":15.151,"text":"O si yọ mi kuro.","marked":"Ó sì yọ mí kúrò."}],"end":15.151},{"key":"3","start":16.101,"lines":[{"start":16.101,"end":17.431,"text":"f Ogun Ọlọrun wa yika,","marked":"f Ogun Ọlọ́run wa yíká"},{"start":17.881,"end":18.885,"text":"Ibugbe olootọ;","marked":"Ibùgbé olóòtọ́"},{"start":19.335,"end":20.516,"text":"Ẹni ti o ba gbẹkẹle,","marked":"Ẹni tí ó bá gbẹ́kẹ̀lé"},{"start":20.966,"end":22.149,"text":"Yoo si ri 'gbala.","marked":"Yóò sì rí gbàlà."}],"end":22.149},{"key":"4","start":23.099,"lines":[{"start":23.099,"end":24.882,"text":"Sa dan ifẹ Rẹ wo lẹkan,","marked":"Sá dán ìfẹ́ Rẹ̀ wò lẹ́kàn"},{"start":25.332,"end":26.583,"text":"Gbana 'wọ o mọ pe,","marked":"Gbàná 'wọ ó mọ̀ pé"},{"start":27.033,"end":28.48,"text":"Awọn t'o di ootọ rẹ mu,","marked":"Àwọn t'ó di òótọ́ rẹ̀ mú"},{"start":28.93,"end":30.186,"text":"Nikan l'ẹni 'bukun.","marked":"Nìkan l'ẹni bùkún."}],"end":30.186},{"key":"5","start":31.136,"lines":[{"start":31.136,"end":32.669,"text":"Ẹ bẹru Rẹ, ẹyin mimọ,","marked":"Ẹ bẹ̀rù Rẹ̀, ẹ̀yin mímọ́"},{"start":33.119,"end":34.415,"text":"Ẹru miran ko si;","marked":"Ẹ̀rù míràn kò sí"},{"start":34.865,"end":36.476,"text":"Sa jẹ ki'sin Rẹ j'ayọ yin,","marked":"Sá jẹ́ kí'sin Rẹ j'ayọ̀ yín"},{"start":36.926,"end":38.376,"text":"Oun y'o ma tọju yin.","marked":"Òun y'ó má tọ́jú yín."}],"end":38.376},{"key":"6","start":39.326,"lines":[{"start":39.326,"end":40.738,"text":"Em'o yangan ti segun Re","marked":"Èm'ó yangàn ti ṣẹ́gun Rẹ̀"},{"start":41.188,"end":42.217,"text":"Tit'awon t'eru npa","marked":"Tít'àwọn t'ẹrú ńpa"},{"start":42.667,"end":44.346,"text":"Y'o fi mi se awokose","marked":"Y'ó fi mí ṣe àwòkọ́ṣe"},{"start":44.796,"end":46.143,"text":"Ti banuje y'o tan.","marked":"Tí banújẹ́ y'ó tán."}],"end":46.143}]}