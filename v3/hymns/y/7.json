{"v":3,"coll":"y","num":7,"id":"hymn_7","title":"JESU oorun ododo","duration":54.298,"voices":{"male":{"file":"y-7-male-v3.m4a","bytes":376392,"sha256":"853b176f07e7c404576a9d941891edd00025d9b18ca47d87309ec9c8b4b9742c","duration":54.3},"female":{"file":"y-7-female-v3.m4a","bytes":389379,"sha256":"8a8b8b039f62881b137c9fedca73613fee576a2b26588821a0f7cda716370709","duration":54.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.46,"text":"JESU oorun ododo,","marked":"Jésù oòrùn òdodo"},{"start":1.91,"end":3.071,"text":"Iwọ imọle ifẹ;","marked":"Ìwọ ìmọ́lè ìfẹ́"},{"start":3.521,"end":4.56,"text":"Gbat'imọlẹ owurọ,","marked":"Gbàt'ímọ́lẹ̀ òwúrọ̀"},{"start":5.01,"end":6.3,"text":"Ba n t'ila oorun tan wa,","marked":"Bá ń t'ìlà oòrùn tán wá"},{"start":6.75,"end":7.833,"text":"Tan'mọlẹ ododo Rẹ","marked":"Tàn'mọ́lẹ̀ òdodo Rẹ"},{"start":8.283,"end":9.193,"text":"Yi wa ka.","marked":"Yí wa ká."}],"end":9.193},{"key":"2","start":10.143,"lines":[{"start":10.143,"end":11.317,"text":"Gẹgẹ bi iri ti ń sẹ,","marked":"Gẹ́gẹ́ bí ìrì tí ń sẹ̀"},{"start":11.767,"end":13.179,"text":"Sori eweko gbogbo,","marked":"Sórí ewéko gbogbo"},{"start":13.629,"end":14.835,"text":"K'Ẹmi ore' ọfẹ Rẹ","marked":"K'Ẹ̀mí oore ọ̀fẹ́ Rẹ"},{"start":15.285,"end":16.53,"text":"Sọ ọkan wa di ọtun;","marked":"Sọ ọkàn wa di ọ̀tún"},{"start":16.98,"end":18.078,"text":"Rọ ojo ibukun Rẹ","marked":"Rọ ọjọ́ ìbùkún Rẹ"},{"start":18.528,"end":19.315,"text":"Sori wa","marked":"Sórí wa"}],"end":19.315},{"key":"3","start":20.265,"lines":[{"start":20.265,"end":21.437,"text":"B' imọlẹ orun ti n ran,","marked":"B ìmọ́lẹ̀ ọ̀run tí ń ràn"},{"start":21.887,"end":23.255,"text":"K' imọlẹ ifẹ Tirẹ,","marked":"K ìmọ́lẹ̀ ìfẹ́ Tirẹ̀"},{"start":23.705,"end":25.366,"text":"Si ma gbona l'ọkan wa;","marked":"Sí má gbóná l'ọkàn wa"},{"start":25.816,"end":27.224,"text":"K'o si mu wa l'ara ya,","marked":"K'ó sì mú wa l'ára ya"},{"start":27.674,"end":29.06,"text":"Ka le ma fayọ sin Ọ","marked":"Ká lè má fàyọ sìn Ọ"},{"start":29.51,"end":30.424,"text":"L'aye wa.","marked":"L'ayé wà."}],"end":30.424},{"key":"4","start":31.374,"lines":[{"start":31.374,"end":33.013,"text":"Amọna, ireti wa,","marked":"Amọ̀nà, ìrètí wà"},{"start":33.463,"end":35.023,"text":"Ma fi wa silẹ titi,","marked":"Má fi wá sílẹ̀ títí"},{"start":35.473,"end":36.809,"text":"Fi wa sabẹ isọ Rẹ","marked":"Fi wá sábẹ́ ìsọ Rẹ"},{"start":37.259,"end":38.548,"text":"Titi opin ẹmi wa.","marked":"Títí òpin ẹ̀mí wà."},{"start":38.998,"end":40.491,"text":"Sin wa la ajo wa ja","marked":"Sin wá la àjọ wa jà"},{"start":40.941,"end":41.778,"text":"S'ile wa.","marked":"S'ilẹ̀ wà."}],"end":41.778},{"key":"5","start":42.728,"lines":[{"start":42.728,"end":44.364,"text":"Pa wa mọ n'nu ifẹ Rẹ,","marked":"Pa wá mọ́ n'nú ìfẹ́ Rẹ"},{"start":44.814,"end":46.252,"text":"Lọjọ aye wa gbogbo.","marked":"Lọ́jọ́ ayé wà gbogbo."},{"start":46.702,"end":48.05,"text":"Si mu wa bori iku,","marked":"Sì mú wa borí ikú"},{"start":48.5,"end":49.874,"text":"Mu wa de'le ayọ naa,","marked":"Mú wa dé'lé ayọ̀ náà"},{"start":50.324,"end":51.573,"text":"Ka le b'awọn mimọ gba","marked":"Ká lè b'àwọn mímọ́ gbà"},{"start":52.023,"end":52.749,"text":"isinmi","marked":"ìsinmi"}],"end":52.749}]}