{"v":3,"coll":"y","num":246,"id":"hymn_246","title":"JINA s‘ile orun","duration":39.613,"voices":{"male":{"file":"y-246-male-v3.m4a","bytes":270756,"sha256":"9ad103cb86833f5f44b9f61667c6a4d99e8dac1dd05089336c75a52b5deabbe8","duration":39.7},"female":{"file":"y-246-female-v3.m4a","bytes":284036,"sha256":"5ac9944264d0fe38fe8ab1ea2193914763bd26a158905c09f7b05e2c8ed973b1","duration":39.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.328,"text":"JINA s‘ile ọrun,","marked":"Jìnà s'ilẹ̀ ọ̀run"},{"start":1.778,"end":3.554,"text":"S‘ọkan aya Baba,","marked":"S'ọkàn aya Baba"},{"start":4.004,"end":6.054,"text":"Emi bukun wa, mo n daku","marked":"Èmi bùkún wá, mò ń dákú"},{"start":6.504,"end":7.602,"text":"Mu mi re bi sinmi.","marked":"Mú mi rẹ bí sinmi."}],"end":7.602},{"key":"2","start":8.552,"lines":[{"start":8.552,"end":9.661,"text":"Mo fi duru mi kọ,","marked":"Mo fi dùrù mi kọ"},{"start":10.111,"end":11.265,"text":"S‘ori igi wilo;","marked":"S'orí igi wílò"},{"start":11.715,"end":14.085,"text":"N o se kọrin ayọ, gbati","marked":"N ó ṣe kọrin ayọ̀, gbátí"},{"start":14.535,"end":15.94,"text":"Wọ ko i t‘ahọn mi se?","marked":"Wọ kò í t'ahọ́n mi ṣe?"}],"end":15.94},{"key":"3","start":16.89,"lines":[{"start":16.89,"end":17.891,"text":"Ẹmi mi lọ sile,","marked":"Ẹ̀mí mi lọ sílẹ̀"},{"start":18.341,"end":19.803,"text":"A! mba le fo de bẹ,","marked":"A! mbá lè fọ́ dé bẹ̀"},{"start":20.253,"end":21.663,"text":"Ayun rẹ n yun mi wọ Sioni,","marked":"Ayùn rẹ̀ ń yùn mí wọ Síónì"},{"start":22.113,"end":23.274,"text":"Gba mo ba ranti rẹ.","marked":"Gbà mo bá rántí rẹ."}],"end":23.274},{"key":"4","start":24.224,"lines":[{"start":24.224,"end":25.369,"text":"Sọdọ rẹ mo n t‘ọna,","marked":"Sọ́dọ̀ rẹ̀ mò ń t'ọ̀nà"},{"start":25.819,"end":26.988,"text":"T‘o kun fun isoro;","marked":"T'ó kún fún ìṣòro"},{"start":27.438,"end":29.016,"text":"Gbawo ni n o kọj‘ aginju,","marked":"Gbàwo ni n ó kọj' aginjù"},{"start":29.466,"end":30.433,"text":"De lẹ awọn mimọ?","marked":"Dé lẹ̀ àwọn mímọ́?"}],"end":30.433},{"key":"5","start":31.383,"lines":[{"start":31.383,"end":32.645,"text":"Sunmọ mi, Ọlọrun,","marked":"Súnmọ́ mi, Ọlọ́run"},{"start":33.095,"end":34.301,"text":"Wọ ni mo gbẹkẹle;","marked":"Wọ ni mo gbẹ́kẹ̀lé"},{"start":34.751,"end":36.272,"text":"Sin mi la aginju aye;","marked":"Sìn mí la aginjù ayé"},{"start":36.722,"end":38.064,"text":"Ki n de le nikẹhin.","marked":"Kí n dé lè níkẹ̀hìn."}],"end":38.064}]}