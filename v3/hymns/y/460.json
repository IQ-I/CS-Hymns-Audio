{"v":3,"coll":"y","num":460,"id":"hymn_460","title":"Mo f'emi mi sabe","duration":31.124,"voices":{"male":{"file":"y-460-male-v3.m4a","bytes":209285,"sha256":"b21bc5a871c64275f0eee1218f25654c39115a0fc4e6b982988ab33345700095","duration":31.2},"female":{"file":"y-460-female-v3.m4a","bytes":217355,"sha256":"66af749cee37ce16d991b3d1bd6ca4a86888f99e698a824226a08d9c97bafd96","duration":31.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.434,"text":"Mo f'emi mi sabe","marked":"Mo f'ẹ̀mí mi sábẹ́"},{"start":1.884,"end":3.194,"text":"Itoju Re Jesu","marked":"Ìtọ́jú Rẹ Jésù"},{"start":3.644,"end":5.445,"text":"'Wo ko Jo mi l'ainireti","marked":"wò kó Jọ mi l'àìnírètí"},{"start":5.895,"end":7.052,"text":"Wo l'Olorun Ife.","marked":"Wò l'Ọlọ́run Ìfẹ́."}],"end":7.052},{"key":"2","start":8.002,"lines":[{"start":8.002,"end":9.252,"text":"'Wo ni mo gbekele","marked":"wo ni mo gbẹ́kẹ̀lé"},{"start":9.702,"end":10.994,"text":"'Wo ni mo f'ara ti","marked":"wo ni mo f'ara tì"},{"start":11.444,"end":12.92,"text":"Rere at'Otito ni O","marked":"Rere àt'òtítọ́ ni Ọ"},{"start":13.37,"end":14.831,"text":"Eyi t'O se l'o to.","marked":"Èyí t'Ó ṣe l'ó tó."}],"end":14.831},{"key":"3","start":15.781,"lines":[{"start":15.781,"end":16.875,"text":"Ohun t'o wu k'o de,","marked":"Ohun t'ó wù k'ó dé"},{"start":17.325,"end":18.686,"text":"Ifẹ Rẹ ni wọn ń se:","marked":"Ìfẹ́ Rẹ ni wọ́n ń ṣe"},{"start":19.136,"end":20.635,"text":"Mo f'ori pamọ s'aya Rẹ,","marked":"Mo f'orí pamọ́ s'àyà Rẹ"},{"start":21.085,"end":22.539,"text":"N ko foya iji yi.","marked":"N kò fòyà ìjì yí."}],"end":22.539},{"key":"4","start":23.489,"lines":[{"start":23.489,"end":24.65,"text":"B'ibi tab' ire de,","marked":"B'ibi tàb ìre dé"},{"start":25.1,"end":26.31,"text":"Y'o dara fun mi sa!","marked":"Y'ó dára fún mi sá!"},{"start":26.76,"end":28.08,"text":"Ki ń sa ni O l'ohun gbogbo,","marked":"Kí ń sá ni Ó l'ohun gbogbo"},{"start":28.53,"end":29.575,"text":"Ohun gbogbo n'nu Rẹ.","marked":"Ohun gbogbo n'nú Rẹ̀."}],"end":29.575}]}