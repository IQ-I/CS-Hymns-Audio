{"v":3,"coll":"y","num":715,"id":"hymn_715","title":"JESU Olugbala wa","duration":129.57,"voices":{"male":{"file":"y-715-male-v3.m4a","bytes":926814,"sha256":"59ab8bf50fd38f495df6916330b0f2a40b288347dde1f40e8463b1f4a487224b","duration":129.6},"female":{"file":"y-715-female-v3.m4a","bytes":957081,"sha256":"f27ead121a82dd40a8984fe216718b2bcddcff86229cba541401369d2d6931a8","duration":129.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.589,"text":"JESU Olugbala wa,","marked":"Jésù Olùgbàlà wa"},{"start":2.039,"end":3.058,"text":"Awa fi iyin fun Ọ,","marked":"Àwa fi ìyìn fún Ọ"},{"start":3.508,"end":5.036,"text":"Fun 'dasi ati 'pamọ Rẹ,","marked":"Fún dásí àti 'pamọ Rẹ"},{"start":5.486,"end":7.143,"text":"Lori wa lat' esi;","marked":"Lórí wa lát èsì"},{"start":7.593,"end":9.007,"text":"A tun pejọ loni yi,","marked":"A tún péjọ lónì yí"},{"start":9.457,"end":10.641,"text":"Lati yin orukọ Rẹ,","marked":"Láti yin orúkọ Rẹ"},{"start":11.091,"end":12.474,"text":"Awa Ọmọ Ogun Kristi,","marked":"Àwa Ọmọ Ogun Kristi"},{"start":12.924,"end":14.729,"text":"Kérúbù, Séráfù,","marked":"Kérúbù, Séráfù"},{"start":15.179,"end":16.562,"text":"Awa n s'ajọdun wa,","marked":"Àwa ń s'àjọ̀dún wa"},{"start":17.012,"end":18.349,"text":"L'oni niwaju Rẹ,","marked":"L'óní níwájú Rẹ"},{"start":18.799,"end":20.344,"text":"Ogo, iyin ọla ni fun","marked":"Ògo, ìyìn ọlá ni fún"},{"start":20.794,"end":22.257,"text":"Mẹtalọkan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":22.257},{"key":"2","start":23.207,"lines":[{"start":23.207,"end":24.591,"text":"Baba Mimọ bukun wa,","marked":"Baba Mímọ́ bùkún wá"},{"start":25.041,"end":26.219,"text":"Ninu ajọdun yi,","marked":"Nínú àjọ̀dún yí"},{"start":26.669,"end":27.855,"text":"Fi Ẹmi Mimọ Rẹ fun wa,","marked":"Fi Ẹ̀mí Mímọ́ Rẹ fún wa"},{"start":28.305,"end":29.567,"text":"At'agbara Ẹmi,","marked":"At'agbára Ẹ̀mí"},{"start":30.017,"end":31.324,"text":"K'a le sin Ọ ni Mimọ;","marked":"K'á lè sìn Ọ́ ní Mímọ́"},{"start":31.774,"end":32.767,"text":"Gba wa lọwọ ẹsẹ,","marked":"Gbà wá lọ́wọ́ ẹsẹ̀"},{"start":33.217,"end":34.936,"text":"Ayé, esu, idanwo,","marked":"Ayé, èṣù, ìdánwò"},{"start":35.386,"end":36.744,"text":"Fun wa ni isẹgun.","marked":"Fún wa ní ìsẹ́gun."},{"start":37.194,"end":38.312,"text":"Ki 'mọlẹ wa ma tan,","marked":"Kí 'mọlẹ wa má tán"},{"start":38.762,"end":39.947,"text":"Bi 'lu lori oke,","marked":"Bí lù lórí òkè"},{"start":40.397,"end":42.066,"text":"Ẹ jẹ k'a juba fun Jesu,","marked":"Ẹ jẹ́ k'á júbà fún Jésù"},{"start":42.516,"end":43.466,"text":"Ọba wa olore","marked":"Ọba wá ọlọ́rẹ̀"}],"end":43.466},{"key":"3","start":44.416,"lines":[{"start":44.416,"end":45.734,"text":"Ẹyin Ọm' ogun Kristi,","marked":"Ẹ̀yin Ọm' ogun Kristi"},{"start":46.184,"end":47.313,"text":"Ẹ ku ewu ọdun,","marked":"Ẹ kú ẹ̀wù ọdún"},{"start":47.763,"end":49.051,"text":"Ẹ fun ipe Ọdaguntan,","marked":"Ẹ fún ìpè Ọ̀dàgùntàn"},{"start":49.501,"end":50.667,"text":"Ti Baba fi fun yin;","marked":"Tí Baba fi fún yín"},{"start":51.117,"end":52.415,"text":"Ẹyin ti ẹ n fi suru,","marked":"Ẹ̀yin tí ẹ ń fi sùrù"},{"start":52.865,"end":54.062,"text":"Ru agbelebu yin,","marked":"Rú àgbélébùú yín"},{"start":54.512,"end":55.954,"text":"Ẹ o si jọba lailai,","marked":"Ẹ ó sì jọba láéláé"},{"start":56.404,"end":57.806,"text":"Nigba 'pọnju ba tan,","marked":"Nígbà 'pọnju bá tán"},{"start":58.256,"end":59.362,"text":"Ipe 'kẹhin dun tan,","marked":"Ìpè 'kẹhin dùn tán"},{"start":59.812,"end":61.009,"text":"Fun idajọ ayé,","marked":"Fún ìdájọ́ ayé"},{"start":61.459,"end":62.675,"text":"Onidajọ arayé yọ,","marked":"Onídàjọ́ arayé yọ"},{"start":63.125,"end":64.419,"text":"O gunwa lori 'tẹ.","marked":"Ó gúnwà lórí 'tẹ."}],"end":64.419},{"key":"4","start":65.369,"lines":[{"start":65.369,"end":66.715,"text":"Ọpọ ẹlẹgbẹ wa ni,","marked":"Ọ̀pọ̀ ẹlẹgbẹ́ wa ni"},{"start":67.165,"end":68.299,"text":"Ko ri ọjọ oni,","marked":"Kò rí ọjọ́ òní"},{"start":68.749,"end":70.186,"text":"Ninu idamu ayé yi,","marked":"Nínú ìdàmú ayé yí"},{"start":70.636,"end":71.848,"text":"Ọpọ ti sako lọ,","marked":"Ọ̀pọ̀ ti ṣáko lọ"},{"start":72.298,"end":73.723,"text":"Jesu n pe l'ohun jẹjẹ,","marked":"Jésù ń pè l'ohun jẹ́jẹ́"},{"start":74.173,"end":75.434,"text":"Pe ỌMỌ ma sako,","marked":"Pé Ọmọ má ṣáko"},{"start":75.884,"end":77.095,"text":"Pada ọmọ imọlẹ,","marked":"Padà ọmọ ìmọ́lẹ̀"},{"start":77.545,"end":78.809,"text":"Sinu agbo Jesu.","marked":"Sínú agbo Jésù."},{"start":79.259,"end":80.522,"text":"Ẹ kede jake jado,","marked":"Ẹ kéde jákè jado"},{"start":80.972,"end":82.089,"text":"Fun awọn Keferi,","marked":"Fún àwọn Kèfèrí"},{"start":82.539,"end":84.159,"text":"Pe, ọjọ Oluwa de tan,","marked":"Pé, ọjọ́ Olúwa dé tán"},{"start":84.609,"end":85.723,"text":"Ẹ ronupiwada.","marked":"Ẹ ronúpìwàdà."}],"end":85.723},{"key":"5","start":86.673,"lines":[{"start":86.673,"end":87.85,"text":"Ọlọrun ni Ẹlẹda,","marked":"Ọlọ́run ni Ẹlẹda"},{"start":88.3,"end":89.526,"text":"Ọrun ati ayé,","marked":"Ọ̀run àti ayé"},{"start":89.976,"end":91.284,"text":"O n fun itanna l'awọ,","marked":"Ó ń fún ìtànná l'awọ"},{"start":91.734,"end":92.832,"text":"O n mu irawọ tan,","marked":"Ó ń mú ìràwọ̀ tán"},{"start":93.282,"end":94.535,"text":"Iji gba ohun rẹ gbọ;","marked":"Ìjì gba ohun rẹ̀ gbọ́"},{"start":94.985,"end":95.989,"text":"O n bọ awọn ẹyẹ,","marked":"Ó ń bọ́ àwọn ẹyẹ"},{"start":96.439,"end":97.425,"text":"Papa awa ọmọ Rẹ,","marked":"Pápá àwa ọmọ Rẹ"},{"start":97.875,"end":99.159,"text":"T'o n bo lojojumọ,","marked":"T'ó ń bọ̀ lójojúmọ́"},{"start":99.609,"end":100.531,"text":"Ẹbun rere gbogbo,","marked":"Ẹ̀bùn rere gbogbo"},{"start":100.981,"end":102.327,"text":"Lati ọrun wa ni,","marked":"Láti ọ̀run wá ni"},{"start":102.777,"end":103.911,"text":"A dupẹ lọwọ Ọlọrun,","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":104.361,"end":105.52,"text":"Fun gbogbo ifẹ Rẹ.","marked":"Fún gbogbo ìfẹ́ Rẹ."}],"end":105.52},{"key":"6","start":106.47,"lines":[{"start":106.47,"end":107.618,"text":"Igba wa mbẹ l'ọwọ Rẹ,","marked":"Ìgbà wa mbẹ́ l'ọwọ́ Rẹ"},{"start":108.068,"end":109.256,"text":"Nin' ọdun t'a wa yi,","marked":"Nín ọdún t'á wá yí"},{"start":109.706,"end":111.948,"text":"Ọm'ogun Kristi, ẹ gbadura,","marked":"Ọm'ogun Kristi, ẹ gbàdúrà"},{"start":112.398,"end":113.79,"text":"Mẹtalọkan y'o gbọ,","marked":"Mẹ́talọ́kan y'ó gbọ́"},{"start":114.24,"end":116.477,"text":"Iwọ l'a n wo t'a si n sin,","marked":"Ìwọ l'á ń wò t'á sì ń sìn"},{"start":116.927,"end":118.168,"text":"Ma jẹ k'oju tiwa,","marked":"Má jẹ́ k'ojú tiwa"},{"start":118.618,"end":119.85,"text":"Ma jẹ k'awa ọmọ Rẹ,","marked":"Má jẹ́ k'àwa ọmọ Rẹ"},{"start":120.3,"end":121.576,"text":"Sọkun ni ainidi.","marked":"Sọkún ni àìnídì."},{"start":122.026,"end":123.192,"text":"Iwọ la gbẹkẹle,","marked":"Ìwọ la gbẹ́kẹ̀lé"},{"start":123.642,"end":124.689,"text":"Iwọ ni 'reti wa,","marked":"Ìwọ ni retí wà"},{"start":125.139,"end":126.554,"text":"Ran wa lọwọ k'a le sin Ọ","marked":"Ràn wá lọ́wọ́ k'á lè sìn Ọ"},{"start":127.004,"end":128.022,"text":"De opin ẹmi wa.","marked":"Dé òpin ẹ̀mí wà."}],"end":128.022}]}