{"v":3,"coll":"y","num":857,"id":"hymn_857","title":"MASE beru 'wo okan mi","duration":88.463,"voices":{"male":{"file":"y-857-male-v3.m4a","bytes":631748,"sha256":"9852e971b69eefe4a349ca3ac25ff6dba7445a3abb0f40549ea262fa02a54ef9","duration":88.5},"female":{"file":"y-857-female-v3.m4a","bytes":655787,"sha256":"640369ba0ff132be5a2c8a901b9c3a08e6087d4782cfce4f8045f1cc6d7aa479","duration":88.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.58,"text":"MASE beru 'wo okan mi","marked":"Máṣe bẹ̀rù wò ọkàn mi"},{"start":2.03,"end":3.335,"text":"Eleda mi ni nma foya","marked":"Ẹlẹ́dàá mi ní ńmá fòyà"},{"start":3.785,"end":5.05,"text":"Oluwa pe mi l'oruko","marked":"Olúwa pè mí l'orúkọ"},{"start":5.5,"end":7.42,"text":"O ndabobo, ko si jinna","marked":"Ó ńdàbòbò, kò sì jìnnà"},{"start":7.87,"end":9.384,"text":"Eje Re ti s'etu fun mi","marked":"Ẹ̀jẹ̀ Rẹ ti s'ẹ́tù fún mi"},{"start":9.834,"end":11.865,"text":"O nfe, O si nto mi sibe.","marked":"Ó ńfẹ́, Ó sì ńtọ̀ mi síbẹ̀."}],"end":11.865},{"key":"2","start":12.815,"lines":[{"start":12.815,"end":14.192,"text":"'Gba mo nkoja larin ibu","marked":"gbà mo ńkọjá lárin ìbú"},{"start":14.642,"end":16.104,"text":"Mo f'igbagbo toro 'ranwo","marked":"Mo f'ìgbàgbọ́ tọ́rọ̀ rànwọ́"},{"start":16.554,"end":18.035,"text":"Igbi si duro l'okere","marked":"Ìgbì sì dúró l'òkèrè"},{"start":18.485,"end":20.075,"text":"Won bi kuro Ii ori mi","marked":"Wọ́n bí kúrò Ìí orí mi"},{"start":20.525,"end":21.836,"text":"Emi ko beru ipa won","marked":"Èmi kò bẹ̀rù ipa wọn"},{"start":22.286,"end":24.057,"text":"Ko si ewu, Olorun mbe.","marked":"Kò sí ewu, Ọlọ́run mbẹ́."}],"end":24.057},{"key":"3","start":25.007,"lines":[{"start":25.007,"end":26.507,"text":"Mo yi oju igbagbo s'i","marked":"Mo yí ojú ìgbàgbọ́ s'í"},{"start":26.957,"end":28.406,"text":"Mo ntesiwaju larin 'na","marked":"Mo ńtẹ̀síwájú lárin na"},{"start":28.856,"end":30.519,"text":"Ina gbagbe lati jo mi","marked":"Iná gbàgbé láti jó mi"},{"start":30.969,"end":32.284,"text":"Owo ina njo yi mi ka","marked":"Ọwọ́ iná ńjọ yí mi ká"},{"start":32.734,"end":34.112,"text":"Mo jewo agbar'ami na","marked":"Mo jẹ́wọ́ agbár'àmì ná"},{"start":34.562,"end":36.074,"text":"Mo ke pe\" Temi ni Jesu.","marked":"Mo ké pe Tèmi ni Jésù."}],"end":36.074},{"key":"4","start":37.024,"lines":[{"start":37.024,"end":38.498,"text":"Olugbala, duro ti mi","marked":"Olùgbàlà, dúró tì mí"},{"start":38.948,"end":40.275,"text":"Dabobo mi nigba 'danwo","marked":"Dàbòbò mi nígbà dánwò"},{"start":40.725,"end":42.268,"text":"Pa mi mo ni ikawo Re","marked":"Pa mí mọ́ ní ìkáwọ́ Rẹ"},{"start":42.718,"end":44.191,"text":"F'agbara 'gbala han n'nu mi","marked":"F'agbára gbàlà hàn n'nù mi"},{"start":44.641,"end":46.213,"text":"Ki apa Re je abo mi","marked":"Kí apá Rẹ jẹ́ abo mi"},{"start":46.663,"end":48.003,"text":"Ko s'ohun le ja mi kuro.","marked":"Kò s'ohun lè jà mi kúrò."}],"end":48.003},{"key":"5","start":48.953,"lines":[{"start":48.953,"end":51.281,"text":"B'O si ti pe mi pe ki nwa","marked":"B'Ó sì ti pè mí pé kí ńwá"},{"start":51.731,"end":53.273,"text":"Wo Olore ti ngba ni la","marked":"Wo Ọlọ́rẹ́ ti ńgbà ni là"},{"start":53.723,"end":55.275,"text":"Un o rin lori okun ti nja","marked":"Un ó rìn lórí òkun ti ǹjà"},{"start":55.725,"end":57.215,"text":"Igbi yo gbe ese mi ro","marked":"Ìgbì yó gbé ẹsẹ̀ mi ró"},{"start":57.665,"end":59.022,"text":"Nki yo beru isan na","marked":"Ǹkí yó bẹ̀rù iṣan ná"},{"start":59.472,"end":60.952,"text":"Bi o ti wu ki o le to.","marked":"Bí ó ti wù kí ó lè tó."}],"end":60.952},{"key":"6","start":61.902,"lines":[{"start":61.902,"end":63.492,"text":"Gbat'okunkun b'oju orun","marked":"Gbàt'òkùnkùn b'ojú ọ̀run"},{"start":63.942,"end":65.247,"text":"T'igbi 'banuje yi mi ka","marked":"T'ìgbì banújẹ́ yí mi ká"},{"start":65.697,"end":67.126,"text":"T'iji ibinu ru soke","marked":"T'ìjì ìbínú ru sókè"},{"start":67.576,"end":68.835,"text":"To fere bori okan mi","marked":"Tó fẹ́rẹ̀ borí ọkàn mi"},{"start":69.285,"end":70.819,"text":"Emi mi yo ri dake je","marked":"Ẹ̀mí mi yó rí dákẹ́ jẹ́"},{"start":71.269,"end":73.107,"text":"Y'o gb'ohun jeje pe, 'simi.","marked":"Y'ó gb'ohùn jẹ́jẹ́ pé, ṣímí."}],"end":73.107},{"key":"7","start":74.057,"lines":[{"start":74.057,"end":75.345,"text":"Bi mo wa n'nu eru 'ponju","marked":"Bí mo wá n'nú ẹ̀rù pọ́njú"},{"start":75.795,"end":77.736,"text":"Laisewu un o sete iku","marked":"Láìséwu un ó ṣètè ikú"},{"start":78.186,"end":79.543,"text":"B'ese doju ija ko mi","marked":"B'ẹ̀ṣẹ̀ dojú ìjà kọ́ mi"},{"start":79.993,"end":81.579,"text":"Ti esu gbe ogun ti mi","marked":"Tí èṣù gbé ogun tì mí"},{"start":82.029,"end":84.021,"text":"B'igbo Mose, un o ma gberu","marked":"B'ígbó Mósè, un ó má gbèrú"},{"start":84.471,"end":85.882,"text":"Ina ki o pa mi lara.","marked":"Iná kí ó pa mí lára."},{"start":86.332,"end":86.915,"text":"Amin.","marked":"Àmín."}],"end":86.915}]}