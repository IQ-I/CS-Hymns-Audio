{"v":3,"coll":"y","num":264,"id":"hymn_264","title":"IBU anu! O le je","duration":64.695,"voices":{"male":{"file":"y-264-male-v3.m4a","bytes":463679,"sha256":"7a9bd868f61887c9eb87178d389a98aee8a71687ee34502259ba43c2fe3e3070","duration":64.7},"female":{"file":"y-264-female-v3.m4a","bytes":479562,"sha256":"c88adeaf216e5b5f32afda9e3de5df57f1f346189a2d1024b2cd716f7087702e","duration":64.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.034,"text":"Ibu anu! O le jẹ","marked":"Ìbú àánú! Ó lè jẹ́"},{"start":2.484,"end":3.615,"text":"P'anu si mbẹ fun mi?","marked":"P'àánú sì mbẹ́ fún mi?"},{"start":4.065,"end":5.132,"text":"Ọlọrun le mu suru,","marked":"Ọlọ́run lè mú sùrù"},{"start":5.582,"end":6.72,"text":"F'emi olori ẹlẹsẹ?","marked":"F'èmi olórí ẹlẹ́sẹ̀?"},{"start":7.17,"end":8.885,"text":"Mo ti kọ or'-ọfẹ Rẹ,","marked":"Mo ti kọ or'-ọfẹ Rẹ"},{"start":9.335,"end":10.771,"text":"Mo bi n'nu lojukoju;","marked":"Mo bí n'nú lójúkojú"},{"start":11.221,"end":12.63,"text":"N ko f'eti si ipe Rẹ;","marked":"N kò f'etí sí ìpè Rẹ̀"},{"start":13.08,"end":14.537,"text":"Mo sọ ninu l'ainiye.","marked":"Mo sọ nínú l'àìníye."}],"end":14.537},{"key":"2","start":15.487,"lines":[{"start":15.487,"end":16.911,"text":"Mo tan an ni suru to;","marked":"Mo tàn án ní sùrù tó"},{"start":17.361,"end":18.866,"text":"Sibẹ o si da mi si;","marked":"Síbẹ̀ ó sì dá mi sí"},{"start":19.316,"end":21.034,"text":"O n ke, \"N o se jọwọ rẹ!","marked":"Ó ń ké, N ó ṣe jọ̀wọ́ rẹ̀!"},{"start":21.484,"end":22.927,"text":"Sa gba ago igbala,","marked":"Sá gba àgọ́ ìgbàlà"},{"start":23.377,"end":24.531,"text":"Olugbala mi n duro,","marked":"Olùgbàlà mi ń dúró"},{"start":24.981,"end":26.406,"text":"O si n fi ọgbẹ Rẹ han,","marked":"Ó sì ń fi ọgbẹ́ Rẹ̀ hàn"},{"start":26.856,"end":28.558,"text":"Mo mọ, ifẹ l'Ọlọrun;","marked":"Mo mọ̀, ìfẹ́ l'Ọlọ́run"},{"start":29.008,"end":30.827,"text":"Jesu, n sun, O fẹran mi.","marked":"Jésù, ń sùn, Ó fẹ́ràn mi."}],"end":30.827},{"key":"3","start":31.777,"lines":[{"start":31.777,"end":34.385,"text":"mp Jesu, dahun lat' oke;","marked":"mp Jésù, dáhùn lát òkè"},{"start":34.835,"end":36.143,"text":"Ifẹ k'iwa Rẹ gbogbo?","marked":"Ìfẹ́ k'ìwà Rẹ gbogbo?"},{"start":36.593,"end":38.005,"text":"'Wọ ki y'o dariji mi,","marked":"'Wọ kí y'ó dáríjì mi"},{"start":38.455,"end":40.117,"text":"Ki n wolẹ ni ẹsẹ Rẹ?","marked":"Kí n wólẹ̀ ní ẹsẹ̀ Rẹ?"},{"start":40.567,"end":41.678,"text":"Bi 'm' ba mọ inu Rẹ re,","marked":"Bí m bá mọ inú Rẹ̀ rẹ̀"},{"start":42.128,"end":43.301,"text":"B' Iwọ 'ba se alanu,","marked":"B Ìwọ bá ṣe alánù"},{"start":43.751,"end":44.933,"text":"F'anu dẹti Rẹ silẹ,","marked":"F'àánú dẹtí Rẹ̀ sílẹ̀"},{"start":45.383,"end":47.571,"text":"Dariji, k'a si gba mi.","marked":"Dáríjì, k'á sì gbà mí."}],"end":47.571},{"key":"4","start":48.521,"lines":[{"start":48.521,"end":49.895,"text":"F'oju iyọnu wo mi,","marked":"F'ojú ìyọnu wò mí"},{"start":50.345,"end":51.54,"text":"Fi wuwo oju pe mi,","marked":"Fi wúwo ojú pè mí"},{"start":51.99,"end":53.348,"text":"Mu ọkan okuta rọ,","marked":"Mú ọkàn òkúta rọ"},{"start":53.798,"end":55.552,"text":"Yipada, rọ mi lọkan,","marked":"Yípadà, rọ̀ mí lọ́kàn"},{"start":56.002,"end":57.1,"text":"Mu mi ronupiwada;","marked":"Mú mi ronúpìwàdà"},{"start":57.55,"end":59.053,"text":"Jẹ ki n gbawẹ f'ẹsẹ mi;","marked":"Jẹ́ kí n gbàwẹ́ f'ẹsẹ̀ mi"},{"start":59.503,"end":60.78,"text":"Ki n si kaanu isẹ mi,","marked":"Kí n sì káànú isẹ́ mi"},{"start":61.23,"end":63.146,"text":"Ki n gbagbọ, ki n ye dẹsẹ.","marked":"Kí n gbàgbọ́, kí n yẹ dẹ́sẹ̀."}],"end":63.146}]}