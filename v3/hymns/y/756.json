{"v":3,"coll":"y","num":756,"id":"hymn_756","title":"GBA ta kun fun 'banuje","duration":51.043,"voices":{"male":{"file":"y-756-male-v3.m4a","bytes":355175,"sha256":"0dc80178076988f6be46cb78b450f7028cc339d31aea43c8d757371c6cb12777","duration":51.1},"female":{"file":"y-756-female-v3.m4a","bytes":367877,"sha256":"fb1e00889f939b1b94f50af0ac0e601ce61129cd2df0ef595d57d0eb85a2122f","duration":51.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.784,"text":"'GBA ta kun fun 'banujẹ,","marked":"gbà ta kún fún 'banujẹ"},{"start":2.234,"end":3.465,"text":"Gb'omije n san loju wa;","marked":"Gb'omijé ń sàn lójú wa"},{"start":3.915,"end":6.084,"text":"Gba t'a n sọkun t'a n sọfọ,","marked":"Gba t'à ń sọkún t'à ń sọ̀fọ̀"},{"start":6.534,"end":8.313,"text":"Olugbala, gbọ tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":8.313},{"key":"2","start":9.263,"lines":[{"start":9.263,"end":10.659,"text":"Wo ti gbe ara wa wo","marked":"Wo ti gbé ara wa wò"},{"start":11.109,"end":12.351,"text":"O si mo 'banuje wa","marked":"Ó sì mọ banújẹ́ wa"},{"start":12.801,"end":14.228,"text":"O ti sokun bi awa","marked":"Ó ti sọkún bí àwa"},{"start":14.678,"end":16.382,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":16.382},{"key":"3","start":17.332,"lines":[{"start":17.332,"end":18.761,"text":"Wo ti teriba fun ku","marked":"Wo ti tẹríba fún kú"},{"start":19.211,"end":20.59,"text":"Wo ti t'eje Re sile","marked":"Wo ti t'ẹ̀jẹ̀ Rẹ̀ sílẹ̀"},{"start":21.04,"end":22.943,"text":"A te O si posi ri","marked":"A tẹ́ Ó sì pósí rí"},{"start":23.393,"end":25.253,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":25.253},{"key":"4","start":26.203,"lines":[{"start":26.203,"end":27.525,"text":"Gba t'ọkan wa ba bajẹ,","marked":"Gba t'ọkàn wa bá bàjẹ́"},{"start":27.975,"end":29.21,"text":"Nitori ẹsẹ t'a da;","marked":"Nítorí ẹsẹ̀ t'á dá"},{"start":29.66,"end":31.104,"text":"Gba t'ẹru ba b'ọkan wa,","marked":"Gba t'ẹ̀rù bá b'ọkàn wá"},{"start":31.554,"end":33.239,"text":"Olugbala, gbọ tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":33.239},{"key":"5","start":34.189,"lines":[{"start":34.189,"end":35.609,"text":"Wo ti mo eru ese,","marked":"Wo ti mọ ẹrú ẹ̀ṣẹ̀"},{"start":36.059,"end":37.395,"text":"Ese ti ki se Tire","marked":"Ẹsẹ̀ tí kì ṣe Tire"},{"start":37.845,"end":39.187,"text":"Eru ese na l'O gbe","marked":"Ẹ̀rù ẹ̀ṣẹ̀ ná l'Ó gbé"},{"start":39.637,"end":41.322,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":41.322},{"key":"6","start":42.272,"lines":[{"start":42.272,"end":43.653,"text":"O ti silẹkun iku,","marked":"Ó ti sílẹ̀kùn ikú"},{"start":44.103,"end":45.511,"text":"O ti s'etutu f'ẹsẹ,","marked":"Ó ti s'ètùtù f'ẹsẹ̀"},{"start":45.961,"end":47.217,"text":"O wa lọw' ọtun Baba,","marked":"Ó wà lọw' ọ̀tún Baba"},{"start":47.667,"end":49.494,"text":"Olugbala, gbọ tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":49.494}]}