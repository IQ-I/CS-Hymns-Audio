{"v":3,"coll":"y","num":658,"id":"hymn_658","title":"JESU f'ara han nitoto","duration":38.917,"voices":{"male":{"file":"y-658-male-v3.m4a","bytes":257979,"sha256":"9768c7909fe71976a1e4cb57af604a13df4f00db1e46722bd34c2bb9c12f697f","duration":39.0},"female":{"file":"y-658-female-v3.m4a","bytes":276331,"sha256":"49743e6a3408944fb0ea506cd10b544e188e70fd378b4da0dac4ac1cd4915aae","duration":39.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.99,"text":"JESU f'ara han nitoto","marked":"Jésù f'ara hàn nítòtọ́"},{"start":2.44,"end":3.631,"text":"Nibi ase 'yawo","marked":"Níbi àṣẹ yàwó"},{"start":4.081,"end":5.709,"text":"Oluwa, awa be O, wa","marked":"Olúwa, àwa bẹ̀ Ọ́, wá"},{"start":6.159,"end":7.327,"text":"F'ara Re han nihin.","marked":"F'ara Rẹ̀ hàn níhìn."}],"end":7.327},{"key":"2","start":8.277,"lines":[{"start":8.277,"end":9.497,"text":"Fi ibukun Rẹ fun awọn","marked":"Fi ìbùkún Rẹ fún àwọn"},{"start":9.947,"end":11.034,"text":"Ti o dawọpọ yi;","marked":"Tí ó dáwọ́pọ̀ yí"},{"start":11.484,"end":12.925,"text":"F'ojurere wo 'dapọ wọn,","marked":"F'ojúrere wo 'dapọ wọn"},{"start":13.375,"end":14.686,"text":"Si bukun ẹgbẹ wọn.","marked":"Sì bùkún ẹgbẹ́ wọn."}],"end":14.686},{"key":"3","start":15.636,"lines":[{"start":15.636,"end":17.284,"text":"F'ẹbun ifẹ kun aya wọn,","marked":"F'ẹ̀bùn ìfẹ́ kún aya wọn"},{"start":17.734,"end":18.935,"text":"Fun wọn n'itẹlọrun,","marked":"Fún wọn n'ìtẹ́lọ́rùn"},{"start":19.385,"end":20.705,"text":"Fi alafia Rẹ kun wọn,","marked":"Fi àlàáfíà Rẹ kún wọn"},{"start":21.155,"end":22.345,"text":"Si busi ini wọn","marked":"Sì bùsi ìní wọn"}],"end":22.345},{"key":"4","start":23.295,"lines":[{"start":23.295,"end":24.832,"text":"F'ifẹ mimọ sọ wọn d'ọkan,","marked":"F'ìfẹ́ mímọ́ sọ wọ́n d'ọkàn"},{"start":25.282,"end":26.781,"text":"Ki wọn f'ifẹ Kristi,","marked":"Kí wọ́n f'ìfẹ́ Kristi"},{"start":27.231,"end":28.714,"text":"Mu aniyan ile fẹrẹ","marked":"Mú àníyàn ilẹ̀ fẹ́rẹ́"},{"start":29.164,"end":30.388,"text":"Nipa ajumose.","marked":"Nípa àjùmọ̀ṣe."}],"end":30.388},{"key":"5","start":31.338,"lines":[{"start":31.338,"end":32.504,"text":"Jẹ ki wọn ran 'ra wọn lọwọ,","marked":"Jẹ́ kí wọ́n rán ra wọn lọ́wọ́"},{"start":32.954,"end":33.856,"text":"Ninu ibugbe wọn;","marked":"Nínú ibùgbé wọn"},{"start":34.306,"end":35.708,"text":"Ki wọn si ni ọmọ rere,","marked":"Kí wọ́n sì ni ọmọ rere"},{"start":36.158,"end":37.368,"text":"Ti y'o gbe 'le wọn ro.","marked":"Tí y'ó gbé lé wọn ró."}],"end":37.368}]}