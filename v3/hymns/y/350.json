{"v":3,"coll":"y","num":350,"id":"hymn_350","title":"SALEM t'orun ilu 'bukun","duration":60.865,"voices":{"male":{"file":"y-350-male-v3.m4a","bytes":438988,"sha256":"7673b956e3d649efd840a9000b547707e7a86782f8c566cdbc81f38f24b01a82","duration":60.9},"female":{"file":"y-350-female-v3.m4a","bytes":451403,"sha256":"750c38fcf9e48893ef0c09370e7318b4eaa0e5099ebc7aae2eb09f27e8bdd33d","duration":60.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.919,"text":"SALEM t'ọrun Ilu 'bukun,","marked":"Salẹm t'ọ̀run Ìlú bùkún"},{"start":2.369,"end":4.165,"text":"T'o kun fun 'fẹ at'ayọ,","marked":"T'ó kún fún 'fẹ àt'ayọ̀"},{"start":4.615,"end":6.318,"text":"Ti a f'okuta aye kọ,","marked":"Tí a f'òkúta ayé kọ"},{"start":6.768,"end":8.066,"text":"Ni ọrun giga loke,","marked":"Ní ọ̀run gíga lókè"},{"start":8.516,"end":9.784,"text":"Pẹl' ogun angẹli yika,","marked":"Pẹl' ogun áńgẹ́lì yíká"},{"start":10.234,"end":11.712,"text":"To n sọkalẹ b'iyawo.","marked":"Tó ń sọ̀kalẹ̀ b'ìyàwó."}],"end":11.712},{"key":"2","start":12.662,"lines":[{"start":12.662,"end":13.88,"text":"Lat'ode ọrun lọhun wa,","marked":"Lát'ọdẹ ọ̀run lọ́hùn wà"},{"start":14.33,"end":15.892,"text":"L'o ti wọ asọ ogo,","marked":"L'ó ti wọ asọ̀ ògo"},{"start":16.342,"end":17.926,"text":"To yẹ ẹni ti o fẹ ọ,","marked":"Tó yẹ ẹni tí ó fẹ́ ọ"},{"start":18.376,"end":19.515,"text":"A o sin o f'ọkọ rẹ;","marked":"A ó sìn ọ́ f'ọkọ rẹ̀"},{"start":19.965,"end":21.627,"text":"Gbogbo ita at'odi rẹ,","marked":"Gbogbo ìta àt'odi rẹ̀"},{"start":22.077,"end":23.288,"text":"Jẹ kiki ọsọ wura","marked":"Jẹ́ kìkì ọ̀sọ́ wúrà"}],"end":23.288},{"key":"3","start":24.238,"lines":[{"start":24.238,"end":25.956,"text":"Ilẹkun rẹ n dan fun pearli,","marked":"Ìlẹ̀kùn rẹ̀ ń dán fún pearli"},{"start":26.406,"end":27.854,"text":"Wọn wa ni sisi titi;","marked":"Wọ́n wà ní ṣíṣí títí"},{"start":28.304,"end":29.296,"text":"Awọn olotọ wọ'nu re,","marked":"Àwọn olótọ̀ wọ̀'nù rẹ̀"},{"start":29.746,"end":30.954,"text":"Nip'ẹjẹ Olugbala,","marked":"Níp'ẹ̀jẹ̀ Olùgbàlà"},{"start":31.404,"end":32.865,"text":"Awọn to farada 'pọnju,","marked":"Àwọn tó faradà 'pọnju"},{"start":33.315,"end":34.48,"text":"'Tori orukọ Jesu.","marked":"torí orúkọ Jésù."}],"end":34.48},{"key":"4","start":35.43,"lines":[{"start":35.43,"end":36.923,"text":"Wahala at'ipọnju nla","marked":"Wàhálà àt'ìpọ́njú ńlá"},{"start":37.373,"end":39.03,"text":"L'o s'okuta rẹ lẹwa;","marked":"L'ó s'òkúta rẹ̀ lẹ́wà"},{"start":39.48,"end":41.085,"text":"Jesu papa l'Ẹni to wọn,","marked":"Jésù pápá l'Ẹni tó wọn"},{"start":41.535,"end":43.378,"text":"S'ipo ti o gbe dara;","marked":"S'ípò tí ó gbé dára"},{"start":43.828,"end":45.14,"text":"Ifẹ inu Rẹ sa ni pe,","marked":"Ìfẹ́ inú Rẹ̀ sá ni pé"},{"start":45.59,"end":47.08,"text":"K'a le s'afin Rẹ lọsọ.","marked":"K'á lè s'àfin Rẹ lọ́sọ́."}],"end":47.08},{"key":"5","start":48.03,"lines":[{"start":48.03,"end":49.552,"text":"Ogo at'ọla fun Baba,","marked":"Ògo àt'ọlá fún Baba"},{"start":50.002,"end":51.438,"text":"Ogo at'ọla fun Ọmọ,","marked":"Ògo àt'ọlá fún Ọmọ"},{"start":51.888,"end":53.645,"text":"Ogo at'ọla fun Ẹmi,","marked":"Ògo àt'ọlá fún Ẹ̀mí"},{"start":54.095,"end":55.456,"text":"Mẹtalọkan titi lai;","marked":"Mẹ́talọ́kan títí láì"},{"start":55.906,"end":57.263,"text":"At' ayérayé Ọkan naa,","marked":"Àt ayérayé Ọkàn náà"},{"start":57.713,"end":59.315,"text":"Bakan naa titi ayé.","marked":"Bákan náà títí ayé."}],"end":59.315}]}