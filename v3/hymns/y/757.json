{"v":3,"coll":"y","num":757,"id":"hymn_757","title":"A! won ti gun s'ebute","duration":78.142,"voices":{"male":{"file":"y-757-male-v3.m4a","bytes":561889,"sha256":"929f62f17911312ece817810049a985b25f34e57e8f4baacbdb62a6428638dbd","duration":78.2},"female":{"file":"y-757-female-v3.m4a","bytes":575905,"sha256":"c6cb9905f9a10888192906886dc45127bd1fd54ac488e15cf062d0b5f0cc7bf1","duration":78.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.679,"text":"A! wọn ti gun s'ebute,","marked":"A! wọ́n ti gun s'èbúté"},{"start":2.129,"end":4.196,"text":"Loke ọrun; Loke ọrun;","marked":"Lókè ọ̀run; Lókè ọ̀run"},{"start":4.646,"end":5.982,"text":"Ebi ko ni pa wọn mọ,","marked":"Ebi kò ní pa wọ́n mọ́"},{"start":6.432,"end":7.401,"text":"Wọn bọ lọwọ irora,","marked":"Wọ́n bọ́ lọ́wọ́ ìrora"},{"start":7.851,"end":9.977,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."}],"end":9.977},{"key":"2","start":10.927,"lines":[{"start":10.927,"end":12.616,"text":"A! wọn ko wa fitila,","marked":"A! wọn kò wá fìtílà"},{"start":13.066,"end":15.127,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."},{"start":15.577,"end":17.044,"text":"'Mọle ni l'ọjọ gbogbo,","marked":"'Mọle ni l'ọjọ́ gbogbo"},{"start":17.494,"end":18.974,"text":"Jesu si n'Imọlẹ wọn,","marked":"Jésù sì n'Ìmọ́lẹ̀ wọn"},{"start":19.424,"end":21.44,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."}],"end":21.44},{"key":"3","start":22.39,"lines":[{"start":22.39,"end":24.205,"text":"A! wura n'ita wọn jẹ,","marked":"A! wúrà n'ìta wọn jẹ́"},{"start":24.655,"end":26.695,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."},{"start":27.145,"end":28.54,"text":"Ogo 'bẹ si pọ pupọ,","marked":"Ògo 'bẹ sì pọ̀ púpọ̀"},{"start":28.99,"end":30.538,"text":"Agbo Jesu ni wọn jẹ,","marked":"Agbo Jésù ni wọ́n jẹ́"},{"start":30.988,"end":32.954,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."}],"end":32.954},{"key":"4","start":33.904,"lines":[{"start":33.904,"end":35.233,"text":"A! otutu ki mu wọn,","marked":"A! òtútù kì mú wọn"},{"start":35.683,"end":37.752,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."},{"start":38.202,"end":39.662,"text":"Owo rẹ wọn ti kọja,","marked":"Ọwọ́ rẹ̀ wọ́n ti kọjá"},{"start":40.112,"end":41.194,"text":"Gbogbo ọjọ l'o dara;","marked":"Gbogbo ọjọ́ l'ó dára"},{"start":41.644,"end":43.445,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."}],"end":43.445},{"key":"5","start":44.395,"lines":[{"start":44.395,"end":46.115,"text":"A! wọn dẹkun ija 'ja,","marked":"A! wọ́n dẹ́kun ìjà jà"},{"start":46.565,"end":48.456,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."},{"start":48.906,"end":50.403,"text":"Jesu l'o ti gba wọn la,","marked":"Jésù l'ó ti gbà wọ́n là"},{"start":50.853,"end":52.259,"text":"T'awọn Tirẹ l'o si n rin,","marked":"T'àwọn Tirẹ̀ l'ó sì ń rìn"},{"start":52.709,"end":54.359,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."}],"end":54.359},{"key":"6","start":55.309,"lines":[{"start":55.309,"end":56.967,"text":"A! wọn ko ni sọkun mọ,","marked":"A! wọn kò ní sọkún mọ́"},{"start":57.417,"end":59.247,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."},{"start":59.697,"end":61.19,"text":"Jesu sa wa lọdọ wọn,","marked":"Jésù sá wà lọ́dọ̀ wọn"},{"start":61.64,"end":63.278,"text":"Lọdọ Rẹ ni ayọ wa,","marked":"Lọ́dọ̀ Rẹ̀ ni ayọ̀ wà"},{"start":63.728,"end":65.75,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."}],"end":65.75},{"key":"7","start":66.7,"lines":[{"start":66.7,"end":68.355,"text":"A! a o dapọ mọ wọn,","marked":"A! a ò dàpọ̀ mọ́ wọn"},{"start":68.805,"end":70.585,"text":"Loke ọrun; Loke ọrun.","marked":"Lókè ọ̀run; Lókè ọ̀run."},{"start":71.035,"end":72.23,"text":"A n reti akoko wa,","marked":"À ń retí àkókò wa"},{"start":72.68,"end":74.062,"text":"'Gba Oluwa ba pe ni,","marked":"gba Olúwa bá pè ní"},{"start":74.512,"end":76.593,"text":"S'oke ọrun, S'oke ọrun.","marked":"S'òkè ọ̀run, S'òkè ọ̀run."}],"end":76.593}]}