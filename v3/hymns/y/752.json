{"v":3,"coll":"y","num":752,"id":"hymn_752","title":"ADORIN odun ni ye odun wa","duration":66.93,"voices":{"male":{"file":"y-752-male-v3.m4a","bytes":484148,"sha256":"de6d4596800c6bdf329002d5a1952f70fd6d202faa8d26323571108f507ad039","duration":67.0},"female":{"file":"y-752-female-v3.m4a","bytes":498234,"sha256":"40b2bdef2093ab01c5511e369da5a7e936952ca5cec20f470bac239d0e11063c","duration":67.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.523,"text":"ADORIN odun ni ye odun wa","marked":"Àdọ́rin ọdún ni yẹ ọdún wa"},{"start":2.973,"end":4.081,"text":"Bi ojo alagbase","marked":"Bí ọjọ́ alágbàṣe"},{"start":4.531,"end":7.06,"text":"A o ke wa lule bi itanna eweko","marked":"A ó ké wà lulẹ̀ bí ìtànná ewéko"},{"start":7.51,"end":8.804,"text":"Awa a si koja lo.","marked":"Àwa a sì kọjá lọ."}],"end":8.804},{"key":"CHORUS","start":9.754,"lines":[{"start":9.754,"end":12.489,"text":"Egbe: O digbose (arakunrin tabi arabinrin)","marked":"Ó dìgbòsẹ̀ arákùnrin tàbí arábìnrin"},{"start":12.939,"end":15.668,"text":"O digbose, (Arakunrin tabi arabinrin)","marked":"Ó dìgbòṣẹ́, Arákùnrin tàbí arábìnrin"},{"start":16.118,"end":17.439,"text":"O d'ojo ajinde.","marked":"Ó d'ọjọ́ àjíǹde."}],"end":17.439},{"key":"2","start":18.389,"lines":[{"start":18.389,"end":21.174,"text":"Koriko, b'o ku ko tun le ye mo","marked":"Koríko, b'ó kú kó tún lè yé mọ́"},{"start":21.624,"end":23.058,"text":"Iwo ku lati tun ye","marked":"Ìwọ kú láti tún yẹ"},{"start":23.508,"end":25.226,"text":"Ade ti ki sa yio je tire","marked":"Adé tí kì sá yóò jẹ́ tirẹ̀"},{"start":25.676,"end":26.805,"text":"Lodo Olugbala.","marked":"Lọ́dọ̀ Olùgbàlà."}],"end":26.805},{"key":"3","start":27.755,"lines":[{"start":27.755,"end":30.579,"text":"Losu to koja, t'awa tire ni","marked":"Lóṣù tó kọjá, t'àwa tirẹ̀ ni"},{"start":31.029,"end":32.265,"text":"Loni ipo re s'ofo","marked":"Lóní ipò rẹ̀ s'ọ̀fọ̀"},{"start":32.715,"end":34.351,"text":"(Arakunrin, Arabinrin)","marked":"Arákùnrin, Arábìnrin"},{"start":34.801,"end":36.082,"text":"wa ko lo s'idale.","marked":"wa kò lọ s'ìdálẹ̀."}],"end":36.082},{"key":"4","start":37.032,"lines":[{"start":37.032,"end":38.635,"text":"Je ki eyi je eko fun gbogbo wa,","marked":"Jẹ́ kí èyí jẹ́ ẹ̀kọ́ fún gbogbo wa"},{"start":39.085,"end":40.191,"text":"Lati tun wa wa se","marked":"Láti tún wá wa ṣe"},{"start":40.641,"end":42.616,"text":"lgi gbigbe le wa ni iduro","marked":"Igi gbígbẹ lè wà ní ìdúró"},{"start":43.066,"end":44.422,"text":"K'a ke tutu lule.","marked":"K'á ké tútù lulẹ̀."}],"end":44.422},{"key":"5","start":45.372,"lines":[{"start":45.372,"end":47.458,"text":"Iwa wa laiye yio jeri si wa","marked":"Ìwà wa láìyẹ yóò jẹ́rí sí wa"},{"start":47.908,"end":49.11,"text":"Bi 'gbehin y'o tori","marked":"Bí gbẹ̀hìn y'ó torí"},{"start":49.56,"end":51.75,"text":"Rere (Arakunrin, Arabinrin)","marked":"Rere Arákùnrin, Arábìnrin"},{"start":52.2,"end":53.023,"text":"ti nto lehin","marked":"tí ńtọ́ lẹ́hìn"},{"start":53.473,"end":54.801,"text":"O ti se won to le se.","marked":"Ó ti ṣe wọn tó lè ṣe."}],"end":54.801},{"key":"6","start":55.751,"lines":[{"start":55.751,"end":59.104,"text":"Egbe at'Ebi (Arakunrin, Arabinrin) wa","marked":"Ẹgbẹ́ àt'ẹ̀bi Arákùnrin, Arábìnrin wa"},{"start":59.554,"end":60.917,"text":"A ba nyin daro lokan","marked":"A bá yín dárò lọ́kàn"},{"start":61.367,"end":63.569,"text":"Ireti mbe a o pade loke","marked":"Ìrètí mbẹ́ a ó pàdé lókè"},{"start":64.019,"end":65.381,"text":"Ni ojo Ajinde wa.","marked":"Ní ọjọ́ Àjíǹde wà."}],"end":65.381}]}