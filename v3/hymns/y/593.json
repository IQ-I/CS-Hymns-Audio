{"v":3,"coll":"y","num":593,"id":"hymn_593","title":"JESU, mase je k'a sinmi","duration":32.555,"voices":{"male":{"file":"y-593-male-v3.m4a","bytes":223081,"sha256":"45cd91406218de491db6387c7b0d78ab3c0304ab88be07068088ef3aa9f820f0","duration":32.6},"female":{"file":"y-593-female-v3.m4a","bytes":237555,"sha256":"12baaf8dfd9f2e75b7728e005d41e1690119d687050fec4227a19c2050878179","duration":32.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.376,"text":"JESU, mase jẹ k'a sinmi,","marked":"Jésù, máṣe jẹ́ k'á sinmi"},{"start":2.826,"end":3.989,"text":"Ti t'O fi d'ọkan wa;","marked":"Tí t'Ó fi d'ọkàn wá"},{"start":4.439,"end":6.034,"text":"T'O fun wa ni 'balẹ aya,","marked":"T'Ó fún wa ní 'balẹ àyà"},{"start":6.484,"end":7.725,"text":"T'O wo itẹ ẹsẹ.","marked":"T'Ó wo ìtẹ́ ẹsẹ̀."}],"end":7.725},{"key":"2","start":8.675,"lines":[{"start":8.675,"end":10.311,"text":"A ba le wo agbelebu,","marked":"A bá lè wo àgbélébùú"},{"start":10.761,"end":11.734,"text":"Titi iran nla na,","marked":"Títí ìran ńlá nà"},{"start":12.184,"end":13.8,"text":"Yoo sọ ohun ayé d'ofo,","marked":"Yóò sọ ohun ayé d'òfo"},{"start":14.25,"end":15.694,"text":"T' y'o mu 'banujẹ tan.","marked":"T y'ó mú 'banujẹ tán."}],"end":15.694},{"key":"3","start":16.644,"lines":[{"start":16.644,"end":17.971,"text":"Tit' ọkan wa yoo goke,","marked":"Tít ọkàn wa yóò gòkè"},{"start":18.421,"end":19.559,"text":"T'a o bọ lọwọ ara,","marked":"T'a ó bọ́ lọ́wọ́ ara"},{"start":20.009,"end":21.452,"text":"T'a o fi r'alafia pipe,","marked":"T'a ó fi r'àlàáfíà pípẹ́"},{"start":21.902,"end":23.098,"text":"Ati ayọ ọrun.","marked":"Àti ayọ̀ ọ̀run."}],"end":23.098},{"key":"4","start":24.048,"lines":[{"start":24.048,"end":25.442,"text":"Bi a si ti n tẹjumọ Ọ,","marked":"Bí a sì ti ń tẹjúmọ́ Ọ"},{"start":25.892,"end":27.178,"text":"K'a d'ọkan pẹlu Rẹ;","marked":"K'á d'ọkàn pẹ̀lú Rẹ"},{"start":27.628,"end":29.235,"text":"K'a si ri pipe ẹwa Rẹ,","marked":"K'á sì rí pípé ẹwà Rẹ̀"},{"start":29.685,"end":31.006,"text":"N'ile ayọ loke.","marked":"N'ilé ayọ̀ lókè."}],"end":31.006}]}