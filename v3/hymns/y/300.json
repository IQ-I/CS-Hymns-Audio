{"v":3,"coll":"y","num":300,"id":"hymn_300","title":"AGBELEBU ni ere mi","duration":25.579,"voices":{"male":{"file":"y-300-male-v3.m4a","bytes":175742,"sha256":"351bbfec735daa571dba46367df4ea097c23d1de3d8b2bfc9d49be4781ecf1fa","duration":25.6},"female":{"file":"y-300-female-v3.m4a","bytes":176402,"sha256":"3b034307bb6054096249a30bf8f9dfde7cb15b4e3bf9b5c2d78d4af0a6d3e310","duration":25.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.954,"text":"AGBELEBU ni ere mi","marked":"Àgbélébùú ni èrè mi"},{"start":2.404,"end":3.653,"text":"Nibe ni a rubo fun mi","marked":"Níbẹ̀ ni a rúbọ fún mi"},{"start":4.103,"end":5.945,"text":"Nibe l'a kan Oluwa mo","marked":"Níbẹ̀ l'á kan Olúwa mọ́"},{"start":6.395,"end":7.73,"text":"Nibe l'Olugbala mi ku.","marked":"Níbẹ̀ l'Olùgbàlà mi kú."}],"end":7.73},{"key":"2","start":8.68,"lines":[{"start":8.68,"end":9.823,"text":"Kini o le fa ọkan Rẹ,","marked":"Kíni ó lè fa ọkàn Rẹ"},{"start":10.273,"end":11.695,"text":"Lati tẹri gba iya mi?","marked":"Láti tẹrí gba ìyá mi?"},{"start":12.145,"end":13.774,"text":"Aimohun naa daju l'o se,","marked":"Àìmọ̀hún náà dájú l'ó ṣe"},{"start":14.224,"end":15.495,"text":"T'ọkan mi tutu bẹ si Ọ.","marked":"T'ọkàn mi tútù bẹ̀ sí Ọ."}],"end":15.495},{"key":"3","start":16.445,"lines":[{"start":16.445,"end":17.887,"text":"Aifohun naa oju ti mi,","marked":"Àìfọ̀hún náà ojú tì mí"},{"start":18.337,"end":20.029,"text":"Niwaju Jesu mimọ mi,","marked":"Níwájú Jésù mímọ́ mi"},{"start":20.479,"end":21.809,"text":"T'o ta 'jẹ Rẹ silẹ fun mi,","marked":"T'ó ta 'jẹ Rẹ̀ sílẹ̀ fún mi"},{"start":22.259,"end":24.029,"text":"'Tori o fẹ mi l'afẹju.","marked":"torí ó fẹ́ mi l'afẹ́jú."}],"end":24.029}]}