{"v":3,"coll":"y","num":245,"id":"hymn_245","title":"ELESE; mo n fe bukun","duration":50.902,"voices":{"male":{"file":"y-245-male-v3.m4a","bytes":347721,"sha256":"9ca97057e37798f9ba167d1612a18ec2ed587a5666c7dcc7942171ed2b49b192","duration":51.0},"female":{"file":"y-245-female-v3.m4a","bytes":367153,"sha256":"2c8156d2c05bfa9f55bd3906168797db42299eb104e66475734d2c6ac93aedd9","duration":51.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.492,"text":"1 ẸLẸSẸ; mo n fẹ bukun;","marked":"1 Ẹlẹ́sẹ̀; mò ń fẹ́ bùkún"},{"start":2.942,"end":5.018,"text":"Onde: mo n fẹ d‘omnira;","marked":"Òǹdè: mò ń fẹ́ d'omnira"},{"start":5.468,"end":7.475,"text":"Alarẹ: mo n fẹ sinmi,","marked":"Alárẹ: mò ń fẹ́ sinmi"},{"start":7.925,"end":9.616,"text":"Ọlọrun, saanu fun mi.","marked":"Ọlọ́run, ṣàánú fún mi."}],"end":9.616},{"key":"2","start":10.566,"lines":[{"start":10.566,"end":12.12,"text":"Ire kan emi ko ni,","marked":"Ìrè kan èmi kò ní"},{"start":12.57,"end":13.856,"text":"Ẹsẹ sa l‘o yi mi ka,","marked":"Ẹsẹ̀ sá l'ó yí mi ká"},{"start":14.306,"end":15.767,"text":"Eyi nikan l‘ẹbẹ mi,","marked":"Èyí nìkan l'ẹ̀bẹ̀ mi"},{"start":16.217,"end":17.748,"text":"Ọlọrun, saanu fun mi.","marked":"Ọlọ́run, ṣàánú fún mi."}],"end":17.748},{"key":"3","start":18.698,"lines":[{"start":18.698,"end":19.808,"text":"Irobinujẹ ọkan!","marked":"Ìròbìnújẹ́ ọkàn!"},{"start":20.258,"end":21.56,"text":"Nko gbọdọ gboju s‘oke;","marked":"Nkò gbọdọ̀ gbójú s'òkè"},{"start":22.01,"end":23.181,"text":"Iwọ sa mọ ẹdun mi;","marked":"Ìwọ sá mọ́ ẹ̀dùn mi"},{"start":23.631,"end":25.358,"text":"Ọlọrun, saanu fun mi.","marked":"Ọlọ́run, ṣàánú fún mi."}],"end":25.358},{"key":"4","start":26.308,"lines":[{"start":26.308,"end":27.471,"text":"Ọkan ẹsẹ mi yi n fẹ,","marked":"Ọkàn ẹsẹ̀ mi yí ń fẹ́"},{"start":27.921,"end":29.114,"text":"Sa wa sinmi laya Rẹ;","marked":"Sá wá sinmi láyà Rẹ"},{"start":29.564,"end":31.735,"text":"Lat‘ oni, mo di Tirẹ,","marked":"Lát òní, mo di Tirẹ̀"},{"start":32.185,"end":33.806,"text":"Ọlọrun, saanu fun mi.","marked":"Ọlọ́run, ṣàánú fún mi."}],"end":33.806},{"key":"5","start":34.756,"lines":[{"start":34.756,"end":35.973,"text":"Ẹnikan mbẹ l‘or‘ itẹ,","marked":"Ẹnìkan mbẹ́ l'ọ́r ìtẹ́"},{"start":36.423,"end":37.599,"text":"Ninu Rẹ nikansoso,","marked":"Nínú Rẹ̀ nìkanṣoṣo"},{"start":38.049,"end":39.468,"text":"N‘ ireti at‘ẹbẹ mi;","marked":"Ń ìrètí àt'ẹ̀bẹ̀ mi"},{"start":39.918,"end":41.672,"text":"Ọlọrun, saanu fun mi.","marked":"Ọlọ́run, ṣàánú fún mi."}],"end":41.672},{"key":"6","start":42.622,"lines":[{"start":42.622,"end":43.922,"text":"Oun o gba ọran mi ro,","marked":"Òun ó gba ọ̀ràn mi rò"},{"start":44.372,"end":45.565,"text":"Oun ni Alagbawi mi;","marked":"Òun ni Alágbàwí mi"},{"start":46.015,"end":47.194,"text":"Nitori Tirẹ nikan;","marked":"Nítorí Tirẹ̀ nìkan"},{"start":47.644,"end":49.353,"text":"Ọlọrun, saanu fun mi.","marked":"Ọlọ́run, ṣàánú fún mi."}],"end":49.353}]}