{"v":3,"coll":"y","num":203,"id":"hymn_203","title":"AYO kun okan wa loni","duration":49.508,"voices":{"male":{"file":"y-203-male-v3.m4a","bytes":352271,"sha256":"09069628276f6fdb2b89bfc057bae9a54b4a1081885930f217a39b53dd738346","duration":49.6},"female":{"file":"y-203-female-v3.m4a","bytes":360412,"sha256":"38559841be70b3c272a12d238f7489c14bc799146a4b38a22bcaccb4e99ba026","duration":49.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.694,"text":"AYO kun okan wa loni,","marked":"Ayọ̀ kún ọkàn wa lónì"},{"start":2.144,"end":3.1,"text":"A bi Omo Oba!","marked":"A bí Ọmọ Ọba!"},{"start":3.55,"end":4.629,"text":"Ọpa awon ogun orun,","marked":"Ọ̀pá àwọn ogun ọ̀run"},{"start":5.079,"end":14.496,"text":"N sọ ibi Re loni. Ẹ yọ, Ọlọrun d'eniyan, O wa joko l'ayé, Orukọ wo l'o dun to yi - Emmanuel.","marked":"Ń sọ ibi Rẹ̀ lónì. Ẹ yọ̀, Ọlọ́run d'ènìyàn, Ó wá jókò l'ayé, Orúkọ wo l'ó dùn tó yí Emmanuel."}],"end":14.496},{"key":"CHORUS","start":15.446,"lines":[{"start":15.446,"end":18.082,"text":"E yo, Eyo, Olorun d' enia,","marked":"Ẹ yọ̀, Ẹyọ̀, Ọlọ́run d ènìà"},{"start":18.532,"end":19.788,"text":"O wa joko I'aiye,","marked":"Ó wá jókò l'ayé"},{"start":20.238,"end":22.145,"text":"Oruko wo l' o dun to yi","marked":"Orúkọ wo l ó dùn tó yí"},{"start":22.595,"end":23.561,"text":"Emmanuel.","marked":"Emmanuel."}],"end":23.561},{"key":"2","start":24.511,"lines":[{"start":24.511,"end":25.727,"text":"A wolẹ n' ibujẹ ẹran,","marked":"A wólẹ̀ ń ibùjẹ ẹran"},{"start":26.177,"end":27.615,"text":"N'iyanu l'a jọsin:","marked":"N'ìyanu l'á jọ́sìn"},{"start":28.065,"end":29.857,"text":"Ibukun kan ko ta 'yi yo,","marked":"Ìbùkún kan kò ta yí yọ"},{"start":30.307,"end":31.642,"text":"Ko s'ayọ bi eyi.","marked":"Kò s'ayọ̀ bí èyí."}],"end":31.642},{"key":"3","start":32.592,"lines":[{"start":32.592,"end":34.356,"text":"mf Ayé ko n'adun fun wa mọ,","marked":"mf Ayé kò n'adùn fún wa mọ́"},{"start":34.806,"end":36.027,"text":"'Gbati a ba ń wo Ọ:","marked":"gbátí a bá ń wò Ọ́"},{"start":36.477,"end":37.704,"text":"L'ọwọ Wundia Iya Rẹ,","marked":"L'ọ́wọ́ Wúńdíá Ìyá Rẹ̀"},{"start":38.154,"end":39.103,"text":"'Wọ ọmọ Iyanu.","marked":"'Wọ ọmọ Ìyanu."}],"end":39.103},{"key":"4","start":40.053,"lines":[{"start":40.053,"end":41.486,"text":"f Imole lat'inu “Mole,","marked":"f Ìmọ́lẹ̀ lát'inú Mọ́lẹ̀"},{"start":41.936,"end":43.264,"text":"Tan 'mole s'okun wa;","marked":"Tan mọ́lẹ̀ s'okùn wa"},{"start":43.714,"end":46.441,"text":"K'a le ma fi isin mimo, Se'","marked":"K'á lè má fi ìsìn mímọ́, Ṣé"},{"start":46.891,"end":47.959,"text":"ranti ojo Re. Ẹ yọ, Ọlọrun d'eniyan, O wa joko l'ayé, Orukọ wo l'o dun to yi - Emmanuel.","marked":"rántí ọjọ́ Rẹ̀. Ẹ yọ̀, Ọlọ́run d'ènìyàn, Ó wá jókò l'ayé, Orúkọ wo l'ó dùn tó yí Emmanuel."}],"end":47.959}]}