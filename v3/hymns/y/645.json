{"v":3,"coll":"y","num":645,"id":"hymn_645","title":"LEKUN kan mbe t'o sipaya","duration":63.143,"voices":{"male":{"file":"y-645-male-v3.m4a","bytes":448725,"sha256":"107533d8695545783d43e8094aa45a3c22919a71e82c595fcb6da85bb21a5b6d","duration":63.2},"female":{"file":"y-645-female-v3.m4a","bytes":463553,"sha256":"2dcadda5849610513917b8c65bcf3d41c3d73876a8921de6d6ab927e806ba6e7","duration":63.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.19,"text":"LEKUN kan mbe t'o sipaya","marked":"Lẹ́kùn kan mbẹ́ t'ó ṣípayà"},{"start":2.64,"end":3.781,"text":"lati inu ona re wa","marked":"láti inú ọ̀nà rẹ̀ wá"},{"start":4.231,"end":5.915,"text":"Mole lat' ori agbelebu","marked":"Mọ́lẹ̀ lát orí àgbélébùú"},{"start":6.365,"end":7.557,"text":"Nf'lfe Olugbala han.","marked":"Ǹf'lfẹ́ Olùgbàlà hàn."},{"start":8.007,"end":9.745,"text":"Egbe:  A Anu jinle o le je","marked":"A Àánú jinlẹ̀ ò lè jẹ́"},{"start":10.195,"end":11.964,"text":"Pe 'Iekun na si sile fun mi","marked":"Pé lẹ́kùn ná sí sílẹ̀ fún mi"},{"start":12.414,"end":13.716,"text":"Fun mi? - Fun mi?","marked":"Fún mi? Fún mi?"},{"start":14.166,"end":15.624,"text":"Pe o si sile fun mi.","marked":"Pé ó ṣí sílẹ̀ fún mi."}],"end":15.624},{"key":"CHORUS","start":16.574,"lines":[{"start":16.574,"end":18.26,"text":"A Anu jinle o le je","marked":"A Àánú jinlẹ̀ ò lè jẹ́"},{"start":18.71,"end":20.457,"text":"Pe 'Iekun na si sile fun mi","marked":"Pé lẹ́kùn ná sí sílẹ̀ fún mi"},{"start":20.907,"end":22.078,"text":"Fun mi? - Fun mi?","marked":"Fún mi? Fún mi?"},{"start":22.528,"end":23.897,"text":"Pe o si sile fun mi.","marked":"Pé ó ṣí sílẹ̀ fún mi."}],"end":23.897},{"key":"2","start":24.847,"lines":[{"start":24.847,"end":26.538,"text":"Lekun na si sile lofe","marked":"Lẹ́kùn ná sí sílẹ̀ lọ́fẹ́"},{"start":26.988,"end":28.449,"text":"Fun gbogbo eni nfe igbala","marked":"Fún gbogbo ẹni ńfẹ́ ìgbàlà"},{"start":28.899,"end":30.485,"text":"F;Oloro ati talaka","marked":"F;oloro àti tálákà"},{"start":30.935,"end":32.206,"text":"Fun gbogbo orile-ede","marked":"Fún gbogbo orile-ede"},{"start":32.656,"end":34.388,"text":"Egbe:  A Anu jinle o le je...","marked":"A Àánú jinlẹ̀ ò lè jẹ́"}],"end":34.388},{"key":"3","start":35.338,"lines":[{"start":35.338,"end":36.707,"text":"Te siwaju b'ota nrojo","marked":"Tẹ̀ síwájú b'ọ̀tá ńrọjọ́"},{"start":37.157,"end":38.643,"text":"Ghati lekun na si sile","marked":"Ghati lẹ́kun ná sì sílẹ̀"},{"start":39.093,"end":40.787,"text":"Gb'agbelebu jere ade","marked":"Gb'àgbélébù jèrè adé"},{"start":41.237,"end":42.463,"text":"Anu ife ailopin.","marked":"Àánú ìfẹ́ àìlópin."},{"start":42.913,"end":44.69,"text":"Egbe:  A Anu jinle o le je...","marked":"A Àánú jinlẹ̀ ò lè jẹ́"}],"end":44.69},{"key":"4","start":45.64,"lines":[{"start":45.64,"end":47.381,"text":"Gba ba d'oke odo lohun","marked":"Gba bá d'òkè odò lóhùn"},{"start":47.831,"end":49.26,"text":"Ao gb'agbelebu sile","marked":"Àó gb'àgbélébù sílẹ̀"},{"start":49.71,"end":50.892,"text":"Ao bere gb'ade iye","marked":"Àó bẹ̀rẹ̀ gb'adé ìyè"},{"start":51.342,"end":52.742,"text":"Ao fe Jesu si l'orun.","marked":"Àó fẹ́ Jésù sì l'ọ̀run."},{"start":53.192,"end":54.863,"text":"Egbe:  A Anu jinle o le je","marked":"A Àánú jinlẹ̀ ò lè jẹ́"},{"start":55.313,"end":56.875,"text":"Pe 'Iekun na si sile fun mi","marked":"Pé lẹ́kùn ná sí sílẹ̀ fún mi"},{"start":57.325,"end":58.673,"text":"Fun mi? - Fun mi?","marked":"Fún mi? Fún mi?"},{"start":59.123,"end":60.591,"text":"Pe o si sile fun mi.","marked":"Pé ó ṣí sílẹ̀ fún mi."},{"start":61.041,"end":61.594,"text":"Amin.","marked":"Àmín."}],"end":61.594}]}