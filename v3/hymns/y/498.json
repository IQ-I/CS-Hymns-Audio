{"v":3,"coll":"y","num":498,"id":"hymn_498","title":"ALA kan ti mo la loru yi","duration":46.117,"voices":{"male":{"file":"y-498-male-v3.m4a","bytes":326855,"sha256":"4877e4e5f888e631cc1cbc7103e312ff0b038e9f4fde899a5a17c21634f9ed51","duration":46.2},"female":{"file":"y-498-female-v3.m4a","bytes":335517,"sha256":"a35bb0da51226bd8a8d57cb5631747c9503f388f2b44a69aca3c550b6d7be60e","duration":46.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.244,"text":"ALA kan ti mo la loru yi","marked":"Àlá kan tí mo là lóru yí"},{"start":2.694,"end":4.132,"text":"Michael lo sokale wa","marked":"Michael lọ sọ̀kalẹ̀ wá"},{"start":4.582,"end":6.342,"text":"Mo ri pe o fo'tegun esu","marked":"Mo rí pé ó fọ́'tẹ́gùn èṣù"},{"start":6.792,"end":8.608,"text":"Ogo ni fun Jesu li orun.","marked":"Ògo ni fún Jésù lí ọ̀run."}],"end":8.608},{"key":"CHORUS","start":9.558,"lines":[{"start":9.558,"end":11.096,"text":"Ka ba gbogbo Angeli sokan","marked":"Ká bá gbogbo Áńgẹ́lì ṣọ̀kan"},{"start":11.546,"end":12.495,"text":"lati korin","marked":"láti kọrin"},{"start":12.945,"end":14.551,"text":"To fi segun goke re orun","marked":"Tó fi ṣẹ́gun gòkè rẹ ọ̀run"},{"start":15.001,"end":16.537,"text":"Lehin t'O ti bori esu","marked":"Lẹ́hìn t'Ó ti borí èṣù"},{"start":16.987,"end":18.58,"text":"Lehin t'O ti bori esu.","marked":"Lẹ́hìn t'Ó ti borí èṣù."}],"end":18.58},{"key":"2","start":19.53,"lines":[{"start":19.53,"end":20.973,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":21.423,"end":23.1,"text":"E mura ke damure nyin","marked":"Ẹ múra ké dàmúrè yín"},{"start":23.55,"end":25.126,"text":"lse Oluwa l'awa nje","marked":"Iṣẹ́ Olúwa l'àwa ǹjẹ́"},{"start":25.576,"end":27.201,"text":"Awa ki yio beru enikan.","marked":"Àwa kí yóò bẹ̀rù ẹnìkan."}],"end":27.201},{"key":"3","start":28.151,"lines":[{"start":28.151,"end":29.671,"text":"Aki gbogb' awon Leader wa","marked":"Àkí gbogb àwọn Leader wa"},{"start":30.121,"end":31.647,"text":"T'o wa ba wa se Ajodun","marked":"T'ó wá bá wa ṣe Àjọ̀dún"},{"start":32.097,"end":33.716,"text":"Ki Olorun ko mese nyin duro","marked":"Kí Ọlọ́run kò mẹ́sẹ̀ yín dúró"},{"start":34.166,"end":35.68,"text":"Lati gba 'de iye li orun.","marked":"Láti gbà dé iye lí ọ̀run."}],"end":35.68},{"key":"4","start":36.63,"lines":[{"start":36.63,"end":38.199,"text":"A ki Mose Orimolade","marked":"A kí Mósè Orímọ́ládé"},{"start":38.649,"end":40.704,"text":"Fun 'se nla t'o se l'arin wa","marked":"Fún ṣe ńlá t'ó ṣe l'árìn wa"},{"start":41.154,"end":42.583,"text":"K'Olorun ko busi ise re","marked":"K'Ọlọ́run kò bùsi iṣẹ́ rẹ̀"},{"start":43.033,"end":44.568,"text":"Ade Ogo yio je tire.","marked":"Adé Ògo yóò jẹ́ tirẹ̀."}],"end":44.568}]}