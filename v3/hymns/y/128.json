{"v":3,"coll":"y","num":128,"id":"hymn_128","title":"OMO Egbe Seraf' dide","duration":130.115,"voices":{"male":{"file":"y-128-male-v3.m4a","bytes":980066,"sha256":"c853ead6a39d7de9310e08ca2277f1b4132d64cd269b7c9a4a6be6c6891bd0aa","duration":130.2},"female":{"file":"y-128-female-v3.m4a","bytes":1017614,"sha256":"5e4a23f479880a1dc370b6ad93b14fcafb433358ceb2321ca027d6b910ca5ca3","duration":130.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.666,"text":"ỌMỌ ẹgbẹ Seraf' dide,","marked":"Ọmọ ẹgbẹ́ Seraf dìde"},{"start":2.116,"end":3.559,"text":"Dide lati b'esu jagun,","marked":"Dìde láti b'eṣú jagun"},{"start":4.009,"end":5.35,"text":"Jesu Olugbala sẹgun,","marked":"Jésù Olùgbàlà sẹ́gun"},{"start":5.8,"end":7.643,"text":"L'orukọ Rẹ a o 'sẹgun;","marked":"L'orúkọ Rẹ̀ a ó 'sẹgun"},{"start":8.093,"end":9.527,"text":"Sisẹ n'nu ọgba Oluwa rẹ,","marked":"Sísẹ n'nú ọgbà Olúwa rẹ̀"},{"start":9.977,"end":11.51,"text":"Sisẹ n'nu ọgba Oluwa rẹ,","marked":"Sísẹ n'nú ọgbà Olúwa rẹ̀"},{"start":11.96,"end":12.762,"text":"Sisẹ... Sisẹ....","marked":"Sísẹ Sisẹ́"},{"start":13.212,"end":14.839,"text":"Wa sisẹ ki 'kore to de.","marked":"Wá sisẹ́ kí kórè tó dé."}],"end":14.839},{"key":"CHORUS","start":15.789,"lines":[{"start":15.789,"end":17.228,"text":"Sise n'nu ogba Oluwa re,","marked":"Ṣíṣe n'nú ọgbà Olúwa rẹ̀"},{"start":17.678,"end":18.679,"text":"Sise... Sise... Wa,","marked":"Ṣíṣe Ṣiṣẹ́ Wá"},{"start":19.129,"end":20.695,"text":"Sise ki 'kore to de.","marked":"Ṣíṣe kí kórè tó dé."}],"end":20.695},{"key":"2","start":21.645,"lines":[{"start":21.645,"end":22.858,"text":"Omo Egbe Kerub dide","marked":"Ọmọ Ẹgbẹ́ Kerub dìde"},{"start":23.308,"end":24.993,"text":"Opo Okan lo ti daku","marked":"Ọ̀pọ̀ Ọkàn ló ti dákú"},{"start":25.443,"end":27.032,"text":"Opo lo si ti sako lo,","marked":"Ọ̀pọ̀ ló sì ti ṣáko lọ"},{"start":27.482,"end":29.462,"text":"Jesu ń pe yin, e bo wa","marked":"Jésù ń pè yín, ẹ bọ́ wa"},{"start":29.912,"end":35.603,"text":"'le. Sise n'nu ogba... Oluwa rẹ, Sisẹ n'nu ọgba Oluwa rẹ, Sisẹ... Sisẹ.... Wa sisẹ ki 'kore to de.","marked":"lé. Ṣiṣẹ́ n'nú ọgbà Olúwa rẹ̀, Sisẹ́ n'nú ọgbà Olúwa rẹ̀, Sisẹ́ Sísẹ Wá sisẹ́ kí kórè tó dé."}],"end":35.603},{"key":"3","start":36.553,"lines":[{"start":36.553,"end":38.182,"text":"Aladura ti mura tan","marked":"Aládúrà ti múra tán"},{"start":38.632,"end":40.449,"text":"Lati gbe ogo Jesu ga;","marked":"Láti gbé ògo Jésù ga"},{"start":40.899,"end":42.427,"text":"B'aje kan ta felefele","marked":"B'àjẹ́ kan ta fẹ́lẹ́fẹ́lẹ́"},{"start":42.877,"end":44.577,"text":"Maikẹl Balogun wa ti de.","marked":"Maikẹl Balógun wa ti dé."},{"start":45.027,"end":50.662,"text":"Sise n'nu ogba... Oluwa rẹ, Sisẹ n'nu ọgba Oluwa rẹ, Sisẹ... Sisẹ.... Wa sisẹ ki 'kore to de.","marked":"Ṣíṣe n'nú ọgbà Olúwa rẹ̀, Sísẹ n'nú ọgbà Olúwa rẹ̀, Sísẹ Sísẹ Wá sisẹ́ kí kórè tó dé."}],"end":50.662},{"key":"4","start":51.612,"lines":[{"start":51.612,"end":53.413,"text":"Joshua sise, o si ye","marked":"Joshua ṣiṣẹ́, ó sì yẹ"},{"start":53.863,"end":55.578,"text":"Serafu y'o sise re ye","marked":"Séráfù y'ó ṣiṣẹ́ rẹ̀ yẹ"},{"start":56.028,"end":57.919,"text":"Elijah sise, o si ye","marked":"Elijah ṣiṣẹ́, ó sì yẹ"},{"start":58.369,"end":60.132,"text":"Kerubu y'o sise re ye.","marked":"Kérúbù y'ó ṣiṣẹ́ rẹ̀ yẹ."},{"start":60.582,"end":66.338,"text":"Sise n'nu ogba... Oluwa rẹ, Sisẹ n'nu ọgba Oluwa rẹ, Sisẹ... Sisẹ.... Wa sisẹ ki 'kore to de.","marked":"Ṣíṣe n'nú ọgbà Olúwa rẹ̀, Sísẹ n'nú ọgbà Olúwa rẹ̀, Sísẹ Sísẹ Wá sisẹ́ kí kórè tó dé."}],"end":66.338},{"key":"5","start":67.288,"lines":[{"start":67.288,"end":69.242,"text":"Shedraki sise, o si ye,","marked":"Shedraki ṣiṣẹ́, ó sì yẹ"},{"start":69.692,"end":71.509,"text":"Mesaki sise o si ye,","marked":"Mẹ́ṣàkì ṣíṣe ó sì yẹ"},{"start":71.959,"end":73.366,"text":"Abednigo se o si ye","marked":"Abednigo ṣe ó sì yẹ"},{"start":73.816,"end":76.006,"text":"Serafu yoo se l'aseye.","marked":"Séráfù yóò ṣe l'àṣẹyẹ."},{"start":76.456,"end":82.038,"text":"Sise n'nu ogba... Oluwa rẹ, Sisẹ n'nu ọgba Oluwa rẹ, Sisẹ... Sisẹ.... Wa sisẹ ki 'kore to de.","marked":"Ṣíṣe n'nú ọgbà Olúwa rẹ̀, Sísẹ n'nú ọgbà Olúwa rẹ̀, Sísẹ Sísẹ Wá sisẹ́ kí kórè tó dé."}],"end":82.038},{"key":"6","start":82.988,"lines":[{"start":82.988,"end":84.965,"text":"Abraham sise, o si ye,","marked":"Abraham ṣiṣẹ́, ó sì yẹ"},{"start":85.415,"end":87.505,"text":"Isaaki sise, o si ye,","marked":"Isaaki ṣiṣẹ́, ó sì yẹ"},{"start":87.955,"end":89.414,"text":"Jakobu sise l'aseye","marked":"Jakọbu ṣiṣẹ́ l'àṣẹyẹ"},{"start":89.864,"end":91.726,"text":"T'ijọ Aladura yoo ye.","marked":"T'ìjọ Aládúrà yóò yẹ."},{"start":92.176,"end":98.219,"text":"Sise n'nu ogba... Oluwa rẹ, Sisẹ n'nu ọgba Oluwa rẹ, Sisẹ... Sisẹ.... Wa sisẹ ki 'kore to de.","marked":"Ṣíṣe n'nú ọgbà Olúwa rẹ̀, Sísẹ n'nú ọgbà Olúwa rẹ̀, Sísẹ Sísẹ Wá sisẹ́ kí kórè tó dé."}],"end":98.219},{"key":"7","start":99.169,"lines":[{"start":99.169,"end":100.58,"text":"Ope ni fun Olugbala","marked":"Ọpẹ́ ni fún Olùgbàlà"},{"start":101.03,"end":102.639,"text":"To wa s'aye aginju yi","marked":"Tó wá s'ayé aginjù yí"},{"start":103.089,"end":104.754,"text":"To bo ogo Re s'apa kan O","marked":"Tó bọ́ ògo Rẹ̀ s'apá kan Ọ"},{"start":105.204,"end":107.41,"text":"jiya ka le ri 'gbala. Sise","marked":"jìyà ká lè rí gbàlà. Ṣíṣe"},{"start":107.86,"end":113.218,"text":"n'nu ogba... Oluwa rẹ, Sisẹ n'nu ọgba Oluwa rẹ, Sisẹ... Sisẹ.... Wa sisẹ ki 'kore to de.","marked":"n'nú ọgbà Olúwa rẹ̀, Sisẹ́ n'nú ọgbà Olúwa rẹ̀, Sisẹ́ Sisẹ́ Wá sisẹ́ kí kórè tó dé."}],"end":113.218},{"key":"8","start":114.168,"lines":[{"start":114.168,"end":115.654,"text":"Kérúbù pẹlu Séráfù,","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":116.104,"end":117.603,"text":"Ẹ f'ogo fun Baba loke,","marked":"Ẹ f'ògo fún Baba lókè"},{"start":118.053,"end":119.25,"text":"Ẹ f'ogo fun Ọmọ Rẹ,","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":119.7,"end":121.194,"text":"Ẹ f'ogo fun Ẹmi Mimọ .","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́ ."},{"start":121.644,"end":123.152,"text":"Sisẹ n'nu ọgba Oluwa rẹ,","marked":"Sísẹ n'nú ọgbà Olúwa rẹ̀"},{"start":123.602,"end":125.084,"text":"Sisẹ n'nu ọgba Oluwa rẹ,","marked":"Sísẹ n'nú ọgbà Olúwa rẹ̀"},{"start":125.534,"end":126.439,"text":"Sisẹ... Sisẹ....","marked":"Sísẹ Sisẹ́"},{"start":126.889,"end":128.567,"text":"Wa sisẹ ki 'kore to de.","marked":"Wá sisẹ́ kí kórè tó dé."}],"end":128.567}]}