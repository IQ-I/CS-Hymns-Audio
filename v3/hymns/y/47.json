{"v":3,"coll":"y","num":47,"id":"hymn_47","title":"ELESE kan mbe to nf'anu","duration":62.965,"voices":{"male":{"file":"y-47-male-v3.m4a","bytes":455346,"sha256":"28951720d4d84938b7bd4b286814e69acd2c1b6f6b8400ccc5f0244e8d0b6f1c","duration":63.0},"female":{"file":"y-47-female-v3.m4a","bytes":475250,"sha256":"ea6edcda31c48c30a573f2a1dc9c60f76abb10b413c573066acea2db7b9bd1d2","duration":63.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.836,"text":"ELESE kan mbe to nf'anu,","marked":"Ẹlẹ́ṣẹ̀ kan mbẹ́ tó ńf'ànù"},{"start":2.286,"end":3.299,"text":"Ati 'dariji loni,","marked":"Àti dáríjì lónì"},{"start":3.749,"end":5.898,"text":"Fi ayo gba ihin t'a mu wa","marked":"Fi ayọ̀ gba ìhín t'á mú wá"},{"start":6.348,"end":7.601,"text":"Jesu n kọja lo","marked":"Jésù ń kọjá lọ"},{"start":8.051,"end":10.595,"text":"nihin; Mbo wa pin 'fe ati","marked":"níhìn; Mbo wá pín fẹ́ àti"},{"start":11.045,"end":12.278,"text":"anu 'Dariji oun","marked":"àánú dáríjì òun"},{"start":12.728,"end":14.508,"text":"alafia Mbo wa yo l'okan","marked":"àlàáfíà Mbo wá yọ l'ọkàn"},{"start":14.958,"end":16.616,"text":"elese Irora ati osi. Jesu n kọja lọ nihin, Loni………….. loni Gbagbọ gbat'o wa nitosi, S'ọkan rẹ paya lati gba, 'Tori Jesu n kọja nihin, O n kọja nihin loni.","marked":"ẹlẹ́ṣẹ̀ Ìrora àti òsì. Jésù ń kọjá lọ níhìn, Lóní………… lóní Gbàgbọ́ gbàt'ọ́ wà nítòsí, S'ọkàn rẹ̀ payá láti gbà, torí Jésù ń kọjá níhìn, Ó ń kọjá níhìn lóní."}],"end":16.616},{"key":"CHORUS","start":17.566,"lines":[{"start":17.566,"end":19.004,"text":"Jesu nkoja lo nihin,","marked":"Jésù ńkọjá lọ níhìn"},{"start":19.454,"end":20.309,"text":"Loni...loni","marked":"Lónì lónì"},{"start":20.759,"end":22.411,"text":"Gbagbo gbat'o wa nitosi","marked":"Gbàgbọ́ gbàt'ọ́ wà nítòsí"},{"start":22.861,"end":24.469,"text":"S'okan re paya lati gba.","marked":"S'ọkàn rẹ̀ payá láti gbà."},{"start":24.919,"end":26.363,"text":"'Tori Jesu nkoja nihin","marked":"torí Jésù ńkọjá níhìn"},{"start":26.813,"end":28.064,"text":"O nkoja nihin Ioni.","marked":"Ó ńkọjá níhìn lónì."}],"end":28.064},{"key":"2","start":29.014,"lines":[{"start":29.014,"end":30.718,"text":"Arakunrin, Jesu n duro,","marked":"Arákùnrin, Jésù ń dúró"},{"start":31.168,"end":32.71,"text":"Lati dariji l'ọfẹ","marked":"Láti dáríjì l'ọ̀fẹ́"},{"start":33.16,"end":35.215,"text":"Eese t'o ko gba nisisiyi,","marked":"Èéṣe t'ó kò gbà níṣísíyì"},{"start":35.665,"end":36.931,"text":"Gbẹkẹle or'ọfẹ Rẹ;","marked":"Gbẹ́kẹ̀lé or'ọ̀fẹ́ Rẹ"},{"start":37.381,"end":38.928,"text":"Anu ati 'fẹ Rẹ sọwọn,","marked":"Àánú àti 'fẹ Rẹ̀ sọ̀wọ́n"},{"start":39.378,"end":40.463,"text":"Ko jina si ọ loni;","marked":"Kò jìnà sí ọ lónì"},{"start":40.913,"end":42.624,"text":"A! silẹkun ọkan Rẹ fun,","marked":"A! sílẹ̀kùn ọkàn Rẹ̀ fún"},{"start":43.074,"end":44.675,"text":"B'O ti sunmọ tosi rẹ.","marked":"B'Ó ti súnmọ́ tòsí rẹ̀."}],"end":44.675},{"key":"3","start":45.625,"lines":[{"start":45.625,"end":47.825,"text":"A! O mbọ lati bukun ọ,","marked":"A! Ó mbọ̀ láti bùkún ọ"},{"start":48.275,"end":49.843,"text":"Gbọ, fi irẹlẹ tẹriba;","marked":"Gbọ́, fi ìrẹ̀lẹ̀ tẹríba"},{"start":50.293,"end":51.675,"text":"Mbọ wa ra ọ ninu ẹsẹ,","marked":"Mbọ wá rà ọ́ nínú ẹsẹ"},{"start":52.125,"end":53.95,"text":"O setan lati gba ọ;","marked":"Ó ṣetán láti gbà ọ́"},{"start":54.4,"end":55.809,"text":"Iwọ ha jẹ kọ 'gbala yi,","marked":"Ìwọ ha jẹ́ kọ́ gbàlà yí"},{"start":56.259,"end":57.505,"text":"Ti Jesu n fi rọ ọ,","marked":"Tí Jésù ń fi rọ̀ ọ"},{"start":57.955,"end":59.296,"text":"A! silẹkun ọkan rẹ fun,","marked":"A! sílẹ̀kùn ọkàn rẹ̀ fún"},{"start":59.746,"end":61.416,"text":"B'O ti n sunmọ 'tosi rẹ.","marked":"B'Ó ti ń súnmọ́ tòsí rẹ."}],"end":61.416}]}