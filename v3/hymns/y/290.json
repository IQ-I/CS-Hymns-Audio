{"v":3,"coll":"y","num":290,"id":"hymn_290","title":"TANI le so t'ayọ ti mbẹ","duration":26.158,"voices":{"male":{"file":"y-290-male-v3.m4a","bytes":185817,"sha256":"b01770c55c95f800592a3bd8e4f459df564eb19856fdf1a539e4157dc19a0f14","duration":26.2},"female":{"file":"y-290-female-v3.m4a","bytes":185162,"sha256":"078140f2153885b5780c7c36f52d9679807a2570ac70bc18fa56819fc7b601ee","duration":26.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.062,"text":"TANI le so t'ayọ ti mbẹ,","marked":"Tani lè sọ t'ayọ̀ ti mbẹ̀"},{"start":2.512,"end":3.935,"text":"Ni agbala Paradise;","marked":"Ní àgbàlá Paradise"},{"start":4.385,"end":5.657,"text":"Gba t'amusua ba pada,","marked":"Gba t'àmùṣùá bá padà"},{"start":6.107,"end":7.628,"text":"T'o si di arole ago?","marked":"T'ó sì di àrọ̀lẹ àgọ́?"}],"end":7.628},{"key":"2","start":8.578,"lines":[{"start":8.578,"end":10.202,"text":"Ni ayọ ni Baba fi wo,","marked":"Ní ayọ̀ ni Baba fi wò"},{"start":10.652,"end":12.252,"text":"Ẹ sọ ifẹ Rẹ ailopin;","marked":"Ẹ sọ ìfẹ́ Rẹ̀ àìlópin"},{"start":12.702,"end":14.38,"text":"L'ayọ l'ọmọ wolẹ t'O ri,","marked":"L'ayọ̀ l'ọmọ wólẹ̀ t'Ó rí"},{"start":14.83,"end":16.149,"text":"Ere iwaya-ija Rẹ.","marked":"Èrè iwaya-ija Rẹ."}],"end":16.149},{"key":"3","start":17.099,"lines":[{"start":17.099,"end":18.65,"text":"Tayọtayọ l'Emi sin ọ,","marked":"Tayọ̀tayọ̀ l'Èmi sìn ọ́"},{"start":19.1,"end":20.88,"text":"Ọkan mimọ t'o n sọ dọtun,","marked":"Ọkàn mímọ́ t'ó ń sọ dọ́tun"},{"start":21.33,"end":23.094,"text":"Awọn mimọ at'Angẹli n kọ,","marked":"Àwọn mímọ́ àt'Angẹli ń kọ"},{"start":23.544,"end":24.608,"text":"Orin igbala Ọba wọn.","marked":"Orin ìgbàlà Ọba wọn."}],"end":24.608}]}