{"v":3,"coll":"y","num":552,"id":"hymn_552","title":"BABA, jowo gb'adura wa","duration":36.12,"voices":{"male":{"file":"y-552-male-v3.m4a","bytes":255933,"sha256":"0ece76d2697cb453054c1a333f64d2c1ee76baadd7d98bc9789fd129b1742b7e","duration":36.2},"female":{"file":"y-552-female-v3.m4a","bytes":264325,"sha256":"950b95c4895cd74994f23c123e0033a09152dd01b1a3db8d6cb62e7615532c69","duration":36.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.011,"text":"BABA, jọwọ gb' adura wa,","marked":"Baba, jọ̀wọ́ gb àdúrà wa"},{"start":2.461,"end":4.029,"text":"Bi a ti n lọ loju omi,","marked":"Bí a ti ń lọ lójú omi"},{"start":4.479,"end":5.88,"text":"Iwọ ma jẹ ebute wa,","marked":"Ìwọ má jẹ́ èbúté wa"},{"start":6.33,"end":7.819,"text":"At' ile wa loju omi.","marked":"Àt ilẹ̀ wà lójú omi."}],"end":7.819},{"key":"2","start":8.769,"lines":[{"start":8.769,"end":11.221,"text":"Jesu Olugbala, 'Wọ ti","marked":"Jésù Olùgbàlà, 'Wọ ti"},{"start":11.671,"end":12.996,"text":"O ti mu 'ji dakẹ rọrọ;","marked":"Ó ti mú jì dákẹ́ rọ́rọ́"},{"start":13.446,"end":14.923,"text":"Ma jẹ ayọ fun asọfọ,","marked":"Má jẹ́ ayọ̀ fún asọ̀fọ̀"},{"start":15.373,"end":16.986,"text":"Fi 'sinmi 'fọkan aibalẹ.","marked":"Fi sinmi 'fọkan àìbalẹ̀."}],"end":16.986},{"key":"3","start":17.936,"lines":[{"start":17.936,"end":20.205,"text":"'Wọ, Ẹmi Mimọ, Ẹni ti","marked":"'Wọ, Ẹ̀mí Mímọ́, Ẹni tí"},{"start":20.655,"end":22.02,"text":"O rababa loju omi,","marked":"Ó rábàbà lójú omi"},{"start":22.47,"end":23.929,"text":"Pasẹ 'bukun lakoko yi,","marked":"Pasẹ̀ bùkún lákokò yí"},{"start":24.379,"end":25.755,"text":"Fi ipa Rẹ mu wa soji.","marked":"Fi ipá Rẹ̀ mú wa sóji."}],"end":25.755},{"key":"4","start":26.705,"lines":[{"start":26.705,"end":27.896,"text":"'Wo Ọlọrun Mẹtalọkan,","marked":"wo Ọlọ́run Mẹ́talọ́kan"},{"start":28.346,"end":30.631,"text":"Ti awa n sin, ti awa mbọ;","marked":"Tí àwa ń sìn, tí àwa mbọ̀"},{"start":31.081,"end":32.542,"text":"Ma se 'bi sadi wa l'ayé,","marked":"Má ṣe bí sádi wà l'ayé"},{"start":32.992,"end":34.571,"text":"Ati ayọ wa ni ọrun.","marked":"Àti ayọ̀ wà ní ọ̀run."}],"end":34.571}]}