{"v":3,"coll":"y","num":570,"id":"hymn_570","title":"JESU, Oba, ayo alarr","duration":41.304,"voices":{"male":{"file":"y-570-male-v3.m4a","bytes":297961,"sha256":"ee3b0352061d0b4baf69d880c3364c4f4172463bfcf8ac1bf3f1296ec37ada24","duration":41.4},"female":{"file":"y-570-female-v3.m4a","bytes":301361,"sha256":"b5b24fcedfb345f50fe4783c1102dbd346d381cad5c29852c92cfa694457c9e8","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.068,"text":"JESU, Oba, ayo alare","marked":"Jésù, Ọba, ayọ̀ aláre"},{"start":3.518,"end":5.34,"text":"Itunu onirobinuje","marked":"Ìtùnú oníròbìnújẹ́"},{"start":5.79,"end":7.834,"text":"Ile alejo, agbara lai","marked":"Ilẹ̀ àlejò, agbára láì"},{"start":8.284,"end":9.732,"text":"Ibi isadi, Olugbala.","marked":"Ibi ìsádi, Olùgbàlà."}],"end":9.732},{"key":"2","start":10.682,"lines":[{"start":10.682,"end":12.843,"text":"Onifẹ nla, Alafẹhinti,","marked":"Onífẹ́ ńlá, Aláfẹ̀hìntì"},{"start":13.293,"end":15.166,"text":"p Alafia l'akoko iku:","marked":"p Àlàáfíà l'àkókò ikú"},{"start":15.616,"end":17.315,"text":"Ọna at' ere onirẹlẹ,","marked":"Ọ̀nà àt ère onírẹ̀lẹ̀"},{"start":17.765,"end":19.137,"text":"Wọ ni ẹmi awọn eniyan Rẹ.","marked":"Wọ́ ni ẹ̀mí àwọn ènìyàn Rẹ."}],"end":19.137},{"key":"3","start":20.087,"lines":[{"start":20.087,"end":22.64,"text":"Bi mo kọsẹ, em'o ke pe Ọ,","marked":"Bí mo kọsẹ̀, èm'ó ké pe Ọ"},{"start":23.09,"end":24.518,"text":"Iwọ ti s'ade onirẹlẹ,","marked":"Ìwọ ti s'adé onírẹ̀lẹ̀"},{"start":24.968,"end":27.723,"text":"Bi mo sako, fi ọna han mi,","marked":"Bí mo ṣáko, fi ọ̀nà hàn mí"},{"start":28.173,"end":29.771,"text":"Olugbala at'Orẹ totọ.","marked":"Olùgbàlà àt'Orẹ tótọ̀."}],"end":29.771},{"key":"4","start":30.721,"lines":[{"start":30.721,"end":32.669,"text":"N ó jẹwọ ore Rẹ, n ó kọrin,","marked":"N ó jẹ́wọ́ ọrẹ Rẹ̀, n ó kọrin"},{"start":33.119,"end":35.094,"text":"Ibukun, ogo iyin si Ọ:","marked":"Ìbùkún, ògo ìyìn sí Ọ"},{"start":35.544,"end":37.422,"text":"Gbogbo 'pa mi titi ayé y'o jẹ","marked":"Gbogbo pa mí títí ayé y'ó jẹ́"},{"start":37.872,"end":39.754,"text":"Tirẹ Olugbala, Ọrẹ mi.","marked":"Tirẹ̀ Olùgbàlà, Ọ̀rẹ́ mi."}],"end":39.754}]}