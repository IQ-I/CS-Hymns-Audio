{"v":3,"coll":"y","num":27,"id":"hymn_27","title":"GBOGBO eyin araye","duration":80.872,"voices":{"male":{"file":"y-27-male-v3.m4a","bytes":574636,"sha256":"85b5f4d6e1811c9fbb78329f284b9cc0379f8a2079570969808563dc3e767b42","duration":80.9},"female":{"file":"y-27-female-v3.m4a","bytes":589367,"sha256":"0b6f3fc15e4f1910c8163553099fcf8c3d733309782bd1f0acbfb9f9f262e544","duration":80.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.869,"text":"GBOGBO ẹyin ar'ayé","marked":"Gbogbo ẹ̀yin ar'ayé"},{"start":2.319,"end":3.546,"text":"To mb'ọjọ 'sinmi jẹ","marked":"Tó mb'ọjọ́ sinmi jẹ́"},{"start":3.996,"end":5.343,"text":"At'ẹyin alaigbọran","marked":"Àt'ẹ̀yin aláìgbọ́ràn"},{"start":5.793,"end":7.035,"text":"Ti mb'ọjọ 'sinmi jẹ,","marked":"Tí mb'ọjọ́ sinmi jẹ́"},{"start":7.485,"end":8.648,"text":"Oluwa ran wa si yin","marked":"Olúwa rán wa sí yín"},{"start":9.098,"end":10.317,"text":"Gẹgẹ b'alore Rẹ,","marked":"Gẹ́gẹ́ b'alóre Rẹ"},{"start":10.767,"end":12.168,"text":"Lati kede fun arayé","marked":"Láti kéde fún arayé"},{"start":12.618,"end":13.911,"text":"P'Oluwa mbọ Kankan.","marked":"P'Olúwa mbọ́ Kankan."}],"end":13.911},{"key":"CHORUS","start":14.861,"lines":[{"start":14.861,"end":16.337,"text":"Ẹyin Ẹgbẹ Kérúbù","marked":"Ẹ̀yin Ẹgbẹ́ Kérúbù"},{"start":16.787,"end":17.906,"text":"Ẹ mase jafara","marked":"Ẹ máṣe jáfara"},{"start":18.356,"end":19.45,"text":"Ẹyin Ẹgbẹ Séráfù","marked":"Ẹ̀yin Ẹgbẹ́ Séráfù"},{"start":19.9,"end":21.134,"text":"Ẹ d'amure giri","marked":"Ẹ d'àmùrè gírí"}],"end":21.134},{"key":"2","start":22.084,"lines":[{"start":22.084,"end":23.399,"text":"Oluwa binu s'ayé","marked":"Olúwa bínú s'ayé"},{"start":23.849,"end":25.208,"text":"Ẹda ko kiyesi","marked":"Ẹ̀dà kò kíyèsi"},{"start":25.658,"end":26.798,"text":"Awọn t'o ti ni lọwọ,","marked":"Àwọn t'ó ti ní lọ́wọ́"},{"start":27.248,"end":28.854,"text":"Wọn dẹni ti ko ni","marked":"Wọ́n dẹni tí kò ní"},{"start":29.304,"end":30.467,"text":"Ọdẹ 'Badan wa kede","marked":"Ọdẹ bádán wá kéde"},{"start":30.917,"end":31.933,"text":"Ọrọ t'Angẹli sọ,","marked":"Ọ̀rọ̀ t'Áńgẹ́lì sọ"},{"start":32.383,"end":34.012,"text":"Sugbọn kaka k'a yi pada","marked":"Sùgbọ́n kàkà k'á yí padà"},{"start":34.462,"end":35.88,"text":"A ń ri sinu ẹsẹ.","marked":"A ń rí sínú ẹsẹ̀."}],"end":35.88},{"key":"3","start":36.83,"lines":[{"start":36.83,"end":37.97,"text":"Keferi ẹ yi pada","marked":"Kèfèrí ẹ yí padà"},{"start":38.42,"end":39.648,"text":"At'ẹyin Imale","marked":"Àt'ẹ̀yin Ìmàlẹ̀"},{"start":40.098,"end":41.315,"text":"At'awọn Onigbagbọ","marked":"Àt'àwọn Onígbàgbọ́"},{"start":41.765,"end":42.931,"text":"T'o jẹbi ọrọ naa,","marked":"T'ó jẹ̀bi ọ̀rọ̀ náà"},{"start":43.381,"end":44.813,"text":"Ẹ wa ka jọ gbadura,","marked":"Ẹ wá ká jọ gbàdúrà"},{"start":45.263,"end":46.518,"text":"K'a bẹ Baba Mimọ,","marked":"K'á bẹ Baba Mímọ́"},{"start":46.968,"end":48.537,"text":"K'a tẹriba niwaju Rẹ,","marked":"K'á tẹríba níwájú Rẹ"},{"start":48.987,"end":50.197,"text":"Yoo dariji wa.","marked":"Yóò dáríjì wá."}],"end":50.197},{"key":"4","start":51.147,"lines":[{"start":51.147,"end":52.535,"text":"Alanu ni Oluwa","marked":"Aláǹu ni Olúwa"},{"start":52.985,"end":54.161,"text":"Eleti gb'aroye,","marked":"Elétí gb'àròyé"},{"start":54.611,"end":55.902,"text":"Bi a ba yipada si","marked":"Bí a bá yípadà sí"},{"start":56.352,"end":57.66,"text":"Y'o yipada si wa,","marked":"Y'ó yípadà sí wa"},{"start":58.11,"end":59.236,"text":"Ka p'ọjọ Oluwa mọ,","marked":"Ká p'ọjọ́ Olúwa mọ́"},{"start":59.686,"end":60.758,"text":"Gẹgẹ bi asẹ Rẹ,","marked":"Gẹ́gẹ́ bí àsẹ Rẹ"},{"start":61.208,"end":62.946,"text":"Y'o si ferese Rẹ l'ọrun","marked":"Y'ó sì fèrèsé Rẹ̀ l'ọ̀run"},{"start":63.396,"end":64.502,"text":"Igba rere yoo de.","marked":"Ìgbà rere yóò dé."}],"end":64.502},{"key":"5","start":65.452,"lines":[{"start":65.452,"end":66.969,"text":"Njẹ t'a ba si pe wa","marked":"Ǹjẹ́ t'a bá sì pè wá"},{"start":67.419,"end":68.694,"text":"Lati f'ayé silẹ,","marked":"Láti f'ayé sílẹ̀"},{"start":69.144,"end":70.519,"text":"T'a rekọja odo naa,","marked":"T'á rékọjá odò náà"},{"start":70.969,"end":72.103,"text":"Odo tutu iku,","marked":"Odò tútù ikú"},{"start":72.553,"end":73.834,"text":"Ọlọrun Ẹlẹda wa","marked":"Ọlọ́run Ẹlẹda wa"},{"start":74.284,"end":75.572,"text":"Ma jẹ k'oju ti wa","marked":"Má jẹ́ k'ojú ti wá"},{"start":76.022,"end":77.476,"text":"Mu wa d'ọrun Alafia","marked":"Mú wa d'ọ̀run Àlàáfíà"},{"start":77.926,"end":79.324,"text":"K'a ba Ọ gbe titi","marked":"K'á bá Ọ gbé títí"}],"end":79.324}]}