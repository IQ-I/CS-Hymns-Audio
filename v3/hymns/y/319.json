{"v":3,"coll":"y","num":319,"id":"hymn_319","title":"ALLELUYA! Alleluya!! Aleluya!!!","duration":45.958,"voices":{"male":{"file":"y-319-male-v3.m4a","bytes":318295,"sha256":"319c35806bc82f0160c16ee5f37d5d02f49333ed2d5919daf8cabae918335d6e","duration":46.0},"female":{"file":"y-319-female-v3.m4a","bytes":326894,"sha256":"d16ef0d4c8347ff357792f6b2fb46714dd9dc1175f86818587a63173c6e2ac30","duration":46.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.858,"text":"ALLELUYA! Alleluya!! Aleluya!!!","marked":"Allelúyà! Allelúyà!! Alelúyà!!!"},{"start":3.308,"end":5.326,"text":"Ija d'opin, ogun si tan,","marked":"Ìjà d'òpin, ogun sì tán"},{"start":5.776,"end":7.022,"text":"Olugbala jagun 'molu,","marked":"Olùgbàlà jagun mọ́lú"},{"start":7.472,"end":8.938,"text":"Orin ayọ la o ma kọ-","marked":"Orin ayọ̀ la ó má kọ"},{"start":9.388,"end":10.357,"text":"Alleluya.","marked":"Allelúyà."}],"end":10.357},{"key":"CHORUS","start":11.307,"lines":[{"start":11.307,"end":12.308,"text":"Alleluya.","marked":"Allelúyà."}],"end":12.308},{"key":"2","start":13.258,"lines":[{"start":13.258,"end":14.872,"text":"Gbogbo ipa n'iku ti lo;","marked":"Gbogbo ipa n'ikú ti lọ"},{"start":15.322,"end":17.107,"text":"Sugbọn Kristi f'ogun rẹ ka;","marked":"Sùgbọ́n Kristi f'ogun rẹ̀ ká"},{"start":17.557,"end":19.43,"text":"Ayé! Ẹ ho iho ayọ-","marked":"Ayé! Ẹ hó ihò ayọ̀"},{"start":19.88,"end":20.834,"text":"Alleluya.","marked":"Allelúyà."}],"end":20.834},{"key":"3","start":21.784,"lines":[{"start":21.784,"end":23.491,"text":"Ọjọ mẹta naa ti kọja:","marked":"Ọjọ́ mẹ́ta náà ti kọjá"},{"start":23.941,"end":25.551,"text":"O jinde kuro n'nu oku:","marked":"Ó jíǹde kúrò n'nú òkú"},{"start":26.001,"end":27.574,"text":"Ẹ f'ogo fun Ọlọrun wa-","marked":"Ẹ f'ògo fún Ọlọ́run wa"},{"start":28.024,"end":28.957,"text":"Alleluya.","marked":"Allelúyà."}],"end":28.957},{"key":"4","start":29.907,"lines":[{"start":29.907,"end":31.112,"text":"O d'ewon orun apadi","marked":"Ó d'ẹ̀wọ̀n ọ̀run àpadì"},{"start":31.562,"end":32.763,"text":"O s'ilekun orun sile","marked":"Ó s'ìlẹ̀kùn ọ̀run sílẹ̀"},{"start":33.213,"end":34.445,"text":"E korin iyin 'segun Re","marked":"Ẹ kọrin ìyìn ṣẹ́gun Rẹ̀"},{"start":34.895,"end":35.871,"text":"Alleluya.","marked":"Allelúyà."}],"end":35.871},{"key":"5","start":36.821,"lines":[{"start":36.821,"end":38.435,"text":"Jesu nipa iya t'o je","marked":"Jésù nípa ìyá t'ó jẹ"},{"start":38.885,"end":40.205,"text":"Gba wa lowo oro iku","marked":"Gbà wá lọ́wọ́ ọ̀rọ̀ ikú"},{"start":40.655,"end":43.03,"text":"K'a le ye, k'a si ma yin O","marked":"K'á lè yẹ, k'á sì má yìn Ọ́"},{"start":43.48,"end":44.409,"text":"Alleluya.","marked":"Allelúyà."}],"end":44.409}]}