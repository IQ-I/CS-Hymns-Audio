{"v":3,"coll":"y","num":659,"id":"hymn_659","title":"SINMI le Oluwa e gbo","duration":49.142,"voices":{"male":{"file":"y-659-male-v3.m4a","bytes":339254,"sha256":"3442aad94046b9376e2ecfc1fe45040ee81ea81ff44adbfe486eb325f470af10","duration":49.2},"female":{"file":"y-659-female-v3.m4a","bytes":348961,"sha256":"4c0e4875a3cc0ec716bbc6f44cbed9d35019b9c1ff44a0556c24d3069b5e9e10","duration":49.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.9,"text":"SINMI le Oluwa ẹ gbọ,","marked":"Sinmi lé Olúwa ẹ gbọ́"},{"start":2.35,"end":3.36,"text":"Orin duru ọrun","marked":"Orin dùrù ọ̀run"},{"start":3.81,"end":5.654,"text":"Sinmi le 'fẹ Rẹ ailopin,","marked":"Sinmi lè 'fẹ Rẹ àìlópin"},{"start":6.104,"end":7.088,"text":"Si duro jẹ","marked":"Sì dúró jẹ"}],"end":7.088},{"key":"2","start":8.038,"lines":[{"start":8.038,"end":9.542,"text":"Sinmi, iwọ ọkọ to gba,","marked":"Sinmi, ìwọ ọkọ̀ tó gbà"},{"start":9.992,"end":11.015,"text":"Iyawo rẹ loni;","marked":"Ìyàwó rẹ lónì"},{"start":11.465,"end":13.567,"text":"Ninu Jesu, 'yawo rẹ ni","marked":"Nínú Jésù, yàwó rẹ̀ ni"},{"start":14.017,"end":14.915,"text":"Titi ayé.","marked":"Títí ayé."}],"end":14.915},{"key":"3","start":15.865,"lines":[{"start":15.865,"end":17.208,"text":"Iwọ ti a fa ọwọ rẹ,","marked":"Ìwọ tí a fa ọwọ́ rẹ"},{"start":17.658,"end":18.998,"text":"F'ọkọ n'nu ile yi,","marked":"F'ọkọ n'nú ilé yí"},{"start":19.448,"end":21.465,"text":"Sinmi; Baba f'edidi Rẹ,","marked":"Sinmi; Baba f'èdìdì Rẹ̀"},{"start":21.915,"end":22.836,"text":"S'ileri yin","marked":"S'ìlérí yín"}],"end":22.836},{"key":"4","start":23.786,"lines":[{"start":23.786,"end":25.41,"text":"Ẹ sinmi, ẹyin ọrẹ wọn,","marked":"Ẹ sinmi, ẹ̀yin ọrẹ wọn"},{"start":25.86,"end":27.095,"text":"T'ẹ wa ba wọn pejọ;","marked":"T'ẹ wá bá wọn péjọ"},{"start":27.545,"end":29.083,"text":"Ọlọrun wọn ati ti yin","marked":"Ọlọ́run wọn àti ti yín"},{"start":29.533,"end":30.317,"text":"Gba ohun wọn.","marked":"Gba ohùn wọn."}],"end":30.317},{"key":"5","start":31.267,"lines":[{"start":31.267,"end":33.776,"text":"Sinmi; Jesu Ọkọ Ijọ,","marked":"Sinmi; Jésù Ọkọ̀ Ìjọ"},{"start":34.226,"end":35.221,"text":"Duro ti yin nihin;","marked":"Dúró tì yín níhìn"},{"start":35.671,"end":37.747,"text":"Ninu idapọ yin, O n fa","marked":"Nínú ìdàpọ̀ yín, Ó ń fà"},{"start":38.197,"end":39.222,"text":"Ijọ mọra.","marked":"Ìjọ mọ́ra."}],"end":39.222},{"key":"6","start":40.172,"lines":[{"start":40.172,"end":41.943,"text":"Ẹ sinmi: Adaba Mimọ","marked":"Ẹ sinmi: Àdàbà Mímọ́"},{"start":42.393,"end":43.652,"text":"M'ọrọ Rẹ sẹ n'nu wa-","marked":"M'ọ̀rọ̀ Rẹ sẹ́ n'nù wá"},{"start":44.102,"end":46.036,"text":"Sinmi le 'fẹ Re ailopin,","marked":"Sinmi lè 'fẹ Rẹ àìlópin"},{"start":46.486,"end":47.593,"text":"Si duro jẹ.","marked":"Sì dúró jẹ."}],"end":47.593}]}