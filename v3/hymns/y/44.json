{"v":3,"coll":"y","num":44,"id":"hymn_44","title":"OJO isinmi Olorun","duration":41.753,"voices":{"male":{"file":"y-44-male-v3.m4a","bytes":284936,"sha256":"34494efc9dfee16955687dfdfada801e905ed82b176ce7f8c18a32c12af429e7","duration":41.8},"female":{"file":"y-44-female-v3.m4a","bytes":298448,"sha256":"398b544f49f736cc8ad9c40f8b4740d3b937be51ec368fd90adc95c89c06c4c4","duration":41.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.746,"text":"ỌJỌ isinmi Ọlọrun,","marked":"Ọjọ́ ìsinmi Ọlọ́run"},{"start":2.196,"end":3.477,"text":"Ọjọ ti o dara julọ;","marked":"Ọjọ́ tí ó dára jùlọ"},{"start":3.927,"end":5.219,"text":"Ti Ọlọrun ti fun wa,","marked":"Tí Ọlọ́run ti fún wa"},{"start":5.669,"end":7.243,"text":"K'awa ko sinmi ninu rẹ.","marked":"K'àwa kò sinmi nínú rẹ̀."}],"end":7.243},{"key":"2","start":8.193,"lines":[{"start":8.193,"end":9.499,"text":"Ọjọ mẹfa l'O fi fun wa,","marked":"Ọjọ́ mẹ́fà l'Ó fi fún wa"},{"start":9.949,"end":11.495,"text":"K'a fi se isẹ wa gbogbo;","marked":"K'á fi ṣe isẹ́ wa gbogbo"},{"start":11.945,"end":13.917,"text":"Sugbọn ọjọ keje yatọ,","marked":"Sùgbọ́n ọjọ́ keje yàtọ̀"},{"start":14.367,"end":15.785,"text":"Ọjọ 'sinmi Ọlọrun ni.","marked":"Ọjọ́ sinmi Ọlọ́run ni."}],"end":15.785},{"key":"3","start":16.735,"lines":[{"start":16.735,"end":18.863,"text":"K'a fi'sẹ asan wa, silẹ,","marked":"K'á fi'sẹ asán wá, sílẹ̀"},{"start":19.313,"end":20.714,"text":"Ti awa n se n'ijọ mẹfa;","marked":"Tí àwa ń ṣe n'ìjọ mẹ́fà"},{"start":21.164,"end":22.517,"text":"Mimọ ni isẹ ti oni,","marked":"Mímọ́ ni isẹ́ tí òní"},{"start":22.967,"end":24.057,"text":"Ti Ọlọrun Oluwa wa.","marked":"Ti Ọlọ́run Olúwa wà."}],"end":24.057},{"key":"4","start":25.007,"lines":[{"start":25.007,"end":26.733,"text":"A pada de nisinsin yii,","marked":"A padà dé nísinsin yìí"},{"start":27.183,"end":28.184,"text":"Ninu ile Ọlọrun wa;","marked":"Nínú ilé Ọlọ́run wa"},{"start":28.634,"end":30.19,"text":"Jẹ k'a kọrin didun si I,","marked":"Jẹ́ k'á kọrin dídùn sí I"},{"start":30.64,"end":31.97,"text":"Ni owurọ ọjọ oni.","marked":"Ní òwúrọ̀ ọjọ́ òní."}],"end":31.97},{"key":"5","start":32.92,"lines":[{"start":32.92,"end":34.437,"text":"Ni kutukutu 'jọ keje,","marked":"Ní kùtùkùtù 'jọ keje"},{"start":34.887,"end":36.186,"text":"Ni ọjọ isinmi mimọ;","marked":"Ní ọjọ́ ìsinmi mímọ́"},{"start":36.636,"end":38.131,"text":"Jẹ k'a jumọ kọrin didun,","marked":"Jẹ́ k'á jùmọ̀ kọrin dídùn"},{"start":38.581,"end":40.204,"text":"Jẹ k'a si jumọ gbadura.","marked":"Jẹ́ k'á sì jùmọ̀ gbàdúrà."}],"end":40.204}]}