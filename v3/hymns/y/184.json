{"v":3,"coll":"y","num":184,"id":"hymn_184","title":"SUNM'ODO wa, Emmanuel","duration":56.214,"voices":{"male":{"file":"y-184-male-v3.m4a","bytes":397330,"sha256":"d75233c6d2e3ba222db06dfd9cd19fa895b5613bd9c6aae0d0a4d0cf2c554315","duration":56.3},"female":{"file":"y-184-female-v3.m4a","bytes":410340,"sha256":"3177f1327de74b84fb757a662bbd354164e9a0f0eaeada4c581657a054fce862","duration":56.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.4,"text":"SUNM'ỌDỌ wa, Emmanuel,","marked":"Súnm'Ọ̀dọ̀ wa, Emmanuel"},{"start":2.85,"end":4.732,"text":"Wa, ra Israeli pada,","marked":"Wá, ra Ísírẹ́lì padà"},{"start":5.182,"end":6.684,"text":"T'o ń sọfọ ni oko ẹru,","marked":"T'ó ń sọ̀fọ̀ ní oko ẹrú"},{"start":7.134,"end":8.718,"text":"Titi Jesu y'o tun pada,","marked":"Títí Jésù y'ó tún padà"},{"start":9.168,"end":11.246,"text":"Ẹ yọ, Ẹ yọ! Emmanuel","marked":"Ẹ yọ̀, Ẹ yọ̀! Emmanuel"},{"start":11.696,"end":13.059,"text":"Y'o wa s'ọdọ wa Israel","marked":"Y'ó wá s'ọ́dọ̀ wa Israẹl"}],"end":13.059},{"key":"CHORUS","start":14.009,"lines":[{"start":14.009,"end":16.22,"text":"E yo eyo! Emmanuel","marked":"Ẹ yọ ẹyọ! Emmanuel"},{"start":16.67,"end":18.409,"text":"Y'o wa s'odo wa Israeli.","marked":"Y'ó wá s'ọ́dọ̀ wa Ísírẹ́lì."}],"end":18.409},{"key":"2","start":19.359,"lines":[{"start":19.359,"end":21.25,"text":"Wa, Ọpa alade Jesse,","marked":"Wá, Ọ̀pá aládé Jesse"},{"start":21.7,"end":23.282,"text":"K'o gba wa l'ọwọ ọta wa,","marked":"K'ó gbà wá l'ọwọ́ ọ̀tá wa"},{"start":23.732,"end":25.138,"text":"Gba wa lọw'ọrun apadi,","marked":"Gbà wá lọ́w'ọ̀run àpadì"},{"start":25.588,"end":27.334,"text":"Fun wa ni 'sẹgun l'ori 'ku,","marked":"Fún wa ní 'sẹgun l'orí kú"}],"end":27.334},{"key":"3","start":28.284,"lines":[{"start":28.284,"end":30.18,"text":"Sunmọ wa, 'Wọ Ila-orun,","marked":"Súnmọ́ wa, 'Wọ Ila-orun"},{"start":30.63,"end":32.088,"text":"Ki bibọ Rẹ se 'tunu wa,","marked":"Kí bíbọ̀ Rẹ̀ ṣe tùnú wá"},{"start":32.538,"end":33.989,"text":"Tu gbogbo isudẹdẹ ka,","marked":"Tú gbogbo ìsùdẹ̀dẹ̀ ká"},{"start":34.439,"end":36.135,"text":"M'ẹsẹ ati egbe kuro.","marked":"M'ẹsẹ̀ àti ẹgbẹ́ kúrò."}],"end":36.135},{"key":"4","start":37.085,"lines":[{"start":37.085,"end":38.749,"text":"mf Wa ọmọ 'lẹkun Dafidi,","marked":"mf Wá ọmọ 'lẹkun Dafidi"},{"start":39.199,"end":40.905,"text":"'Lẹkun ọrun y'o si fun Ọ,","marked":"'Lẹkun ọ̀run y'ó sì fún Ọ"},{"start":41.355,"end":42.642,"text":"Tun ọna ọrun se fun wa,","marked":"Tún ọ̀nà ọ̀run ṣe fún wa"},{"start":43.092,"end":44.524,"text":"Jọ se ọna osi fun wa.","marked":"Jọ ṣe ọ̀nà òsì fún wa."}],"end":44.524},{"key":"5","start":45.474,"lines":[{"start":45.474,"end":46.708,"text":"mf Sunmo wa Oluwa","marked":"mf Súnmọ́ wa Olúwa"},{"start":47.158,"end":49.316,"text":"ipa, T'o f'ofin fun eniyan","marked":"ipa, T'ó f'òfin fún ènìyàn"},{"start":49.766,"end":51.219,"text":"Re Nigbaani l'or' oke","marked":"Rẹ̀ Nígbàanì l'ọ́r òkè"},{"start":51.669,"end":53.117,"text":"Sinai, 'Nu eru at'","marked":"Sinai, nu ẹ̀rù àt"},{"start":53.567,"end":54.665,"text":"agbara nla.","marked":"agbára ńlá."}],"end":54.665}]}