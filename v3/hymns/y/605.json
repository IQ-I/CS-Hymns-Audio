{"v":3,"coll":"y","num":605,"id":"hymn_605","title":"GBATI 'danwo yi mi ka","duration":45.643,"voices":{"male":{"file":"y-605-male-v3.m4a","bytes":323104,"sha256":"6c978ad852e60aa7766b2c58e1597f73cecfc301c2c250a2e3e7dd038c0ba134","duration":45.7},"female":{"file":"y-605-female-v3.m4a","bytes":332688,"sha256":"06d28ecfac667ef3e173dabf9bf7c9696c525944cacb8e623d840a44e19e55bf","duration":45.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.572,"text":"GBATI 'danwo yi mi ka","marked":"Gbátí dánwò yí mi ká"},{"start":2.022,"end":3.53,"text":"Odo Krist' ni mo nlo","marked":"Ọ̀dọ̀ Krist ni mo ńlọ"},{"start":3.98,"end":5.272,"text":"Ni okan aya Re ni","marked":"Ní ọkàn àyà Rẹ ni"},{"start":5.722,"end":6.724,"text":"Ibi isadi mi","marked":"Ibi ìsádi mi"},{"start":7.174,"end":8.892,"text":"Mo s'okan mi paya fun","marked":"Mo s'ọkàn mi payá fún"},{"start":9.342,"end":10.353,"text":"Omo gbogb' edun mi","marked":"Ọmọ gbogb ẹ̀dùn mi"},{"start":10.803,"end":12.31,"text":"Bi mo ti nso nkan wonyi","marked":"Bí mo ti ńṣọ́ nǹkan wọ̀nyí"},{"start":12.76,"end":13.87,"text":"O m'edun mi kuro.","marked":"Ó m'ẹ̀dùn mi kúrò."}],"end":13.87},{"key":"2","start":14.82,"lines":[{"start":14.82,"end":16.095,"text":"Gbati mo kun fun eru","marked":"Gbátí mo kún fún ẹ̀rù"},{"start":16.545,"end":17.891,"text":"Ti mo nsunkun pere","marked":"Tí mo ńsunkún péré"},{"start":18.341,"end":19.507,"text":"O tan ibanuje mi","marked":"Ó tan ìbànújẹ́ mi"},{"start":19.957,"end":20.879,"text":"O le eru mi lo","marked":"Ó lé ẹ̀rù mi lọ"},{"start":21.329,"end":22.644,"text":"O r'ewu t'o yi mi ka","marked":"Ó r'ẹ̀wù t'ó yí mi ká"},{"start":23.094,"end":24.229,"text":"Ati ailera mi","marked":"Àti àìlera mi"},{"start":24.679,"end":25.911,"text":"O fun mi l'ohun ija","marked":"Ó fún mi l'ohun ìjà"},{"start":26.361,"end":27.598,"text":"Lati segun ese.","marked":"Láti ṣẹ́gun ẹ̀ṣẹ̀."}],"end":27.598},{"key":"3","start":28.548,"lines":[{"start":28.548,"end":30.18,"text":"L'odo Kristi ni un o lo","marked":"L'ọ́dọ̀ Kristi ni un ó lọ"},{"start":30.63,"end":31.857,"text":"Nibi t'o wu ko je","marked":"Níbi t'ó wù kò jẹ́"},{"start":32.307,"end":33.645,"text":"Un o sa ma wo oju Re","marked":"Un ó sá má wo ojú Rẹ"},{"start":34.095,"end":35.51,"text":"O daju pe un o ri","marked":"Ó dájú pé un ó rí"},{"start":35.96,"end":37.545,"text":"Gb'ayo tabi banuje","marked":"Gb'ayọ̀ tàbí banújẹ́"},{"start":37.995,"end":39.102,"text":"Ohun to wu ko je","marked":"Ohun tó wù kò jẹ́"},{"start":39.552,"end":41.12,"text":"Odo re sa ni un o lo","marked":"Ọ̀dọ̀ rẹ̀ sá ni un ó lọ"},{"start":41.57,"end":43.052,"text":"Oun y'o si to mi wa.","marked":"Òun y'ó sì tọ̀ mí wá."},{"start":43.502,"end":44.094,"text":"Amin.","marked":"Àmín."}],"end":44.094}]}