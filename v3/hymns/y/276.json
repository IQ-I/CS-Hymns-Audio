{"v":3,"coll":"y","num":276,"id":"hymn_276","title":"Jesu yoo jọba ni gbogbo","duration":53.527,"voices":{"male":{"file":"y-276-male-v3.m4a","bytes":379460,"sha256":"a92dd79e7e8440eba32485e597af58d4c5ef5c42ca54817c179b1e0db4d92efa","duration":53.6},"female":{"file":"y-276-female-v3.m4a","bytes":392593,"sha256":"90ba4736d82ee94228dfbb4431a05a2d128b87cb7c2b93dbf7702ad0f338d0bd","duration":53.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.983,"text":"Jesu yoo jọba ni gbogbo","marked":"Jésù yóò jọba ní gbogbo"},{"start":2.433,"end":3.708,"text":"Ibi t'a ba le ri orun;","marked":"Ibi t'á bá lè rí ọ̀run"},{"start":4.158,"end":6.06,"text":"'Jọba Rẹ yo tan kakiri,","marked":"'Jọba Rẹ̀ yó tán kákiri"},{"start":6.51,"end":8.202,"text":"'Jọba Rẹ ki y'o nipẹkun.","marked":"'Jọba Rẹ̀ kí y'ó nípẹ̀kun."}],"end":8.202},{"key":"2","start":9.152,"lines":[{"start":9.152,"end":11.349,"text":"Oun l'a o ma gbadura si,","marked":"Òun l'á ó má gbàdúrà sí"},{"start":11.799,"end":13.242,"text":"Awọn Ọba yoo pe l'Ọba;","marked":"Àwọn Ọba yóò pè l'Ọba"},{"start":13.692,"end":15.36,"text":"Orukọ Rẹ b'orun didun,","marked":"Orúkọ Rẹ̀ b'ọ̀run dídùn"},{"start":15.81,"end":17.6,"text":"Y'o ba ẹbọ oorọ goke.","marked":"Y'ó bá ẹbọ oorọ gòkè."}],"end":17.6},{"key":"3","start":18.55,"lines":[{"start":18.55,"end":19.61,"text":"Gbogbo oniruru ede,","marked":"Gbogbo onírúrú èdè"},{"start":20.06,"end":21.469,"text":"Y'o fi 'fẹ Rẹ kọrin didun,","marked":"Y'ó fi 'fẹ Rẹ̀ kọrin dídùn"},{"start":21.919,"end":23.248,"text":"p Awọn ọmọde o jẹwọ,","marked":"p Àwọn ọmọdé ò jẹ́wọ́"},{"start":23.698,"end":25.349,"text":"Pe, 'bukun wọn t'ọdọ Rẹ wa.","marked":"Pé, bùkún wọn t'ọ̀dọ̀ Rẹ wà."}],"end":25.349},{"key":"4","start":26.299,"lines":[{"start":26.299,"end":28.228,"text":"'Bukun pọ nibi t'Oun jọba;","marked":"bùkún pọ̀ níbi t'Òun jọba"},{"start":28.678,"end":30.322,"text":"A tu awọn onde silẹ,","marked":"A tú àwọn òǹdè sílẹ̀"},{"start":30.772,"end":32.089,"text":"Awọn alarẹ ri isinmi;","marked":"Àwọn alárẹ rí ìsinmi"},{"start":32.539,"end":34.042,"text":"Alaini si ri 'bukun gba.","marked":"Aláìní sì rí bùkún gbà."}],"end":34.042},{"key":"5","start":34.992,"lines":[{"start":34.992,"end":36.48,"text":"Ki gbogbo ẹda k'o dide,","marked":"Kí gbogbo ẹ̀dà k'ó dìde"},{"start":36.93,"end":38.267,"text":"Ki wọn f'ọla fun Ọba wa;","marked":"Kí wọ́n f'ọlá fún Ọba wa"},{"start":38.717,"end":40.625,"text":"K'Angel' tun wa t'awọn t'orin,","marked":"K'Angẹl tún wá t'àwọn t'orin"},{"start":41.075,"end":42.554,"text":"Ki gbogb' ayé jumọ gberin.","marked":"Kí gbogb ayé jùmọ̀ gbẹ́rin."}],"end":42.554},{"key":"6","start":43.504,"lines":[{"start":43.504,"end":44.758,"text":"O f'agbara iwosan han","marked":"Ó f'agbára ìwòsàn hàn"},{"start":45.208,"end":47.518,"text":"Iku, egun ko ni 'pa mo","marked":"Ikú, ègún kò ní pa mọ́"},{"start":47.968,"end":50.048,"text":"N'nu Re n'iran Adam nyangan","marked":"N'nú Rẹ̀ n'ìran Adam ńyàngàn"},{"start":50.498,"end":51.977,"text":"'Won ri opo ibukun gba.","marked":"wọ́n rí ọ̀pọ̀ ìbùkún gbà."}],"end":51.977}]}