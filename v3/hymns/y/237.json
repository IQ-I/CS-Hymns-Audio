{"v":3,"coll":"y","num":237,"id":"hymn_237","title":"JESU, l'ojo anu yi","duration":42.408,"voices":{"male":{"file":"y-237-male-v3.m4a","bytes":283950,"sha256":"6f9dceae740966be1a6a70f008f79ff7624dc884614aa5f61be10322bab5a823","duration":42.5},"female":{"file":"y-237-female-v3.m4a","bytes":293999,"sha256":"1aaf66a732a16497ab1d0117db7bae5f3d812ec76e4309be57db5686250897fd","duration":42.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.976,"text":"JESU, l'ojo anu yi","marked":"Jésù, l'ọjọ́ àánú yí"},{"start":2.426,"end":3.639,"text":"Ki akoko to koja","marked":"Kí àkókò tó kọjá"},{"start":4.089,"end":5.398,"text":"A wole ni ekun wa.","marked":"A wọlé ní ẹkún wa."}],"end":5.398},{"key":"2","start":6.348,"lines":[{"start":6.348,"end":7.488,"text":"Oluwa, m'ẹkun gbọn wa,","marked":"Olúwa, m'ẹ̀kún gbọ́n wá"},{"start":7.938,"end":9.35,"text":"Fi ẹru kun aya wa,","marked":"Fi ẹ̀rù kún aya wa"},{"start":9.8,"end":11.19,"text":"Ki ọjọ iku to de.","marked":"Kí ọjọ́ ikú tó dé."}],"end":11.19},{"key":"3","start":12.14,"lines":[{"start":12.14,"end":13.529,"text":"Tu Ẹmi Rẹ s'ọkan wa,","marked":"Tú Ẹ̀mí Rẹ s'ọkàn wá"},{"start":13.979,"end":15.356,"text":"L'ẹnu ọna Rẹ la n ke;","marked":"L'ẹnu ọ̀nà Rẹ̀ là ń ké"},{"start":15.806,"end":17.121,"text":"K'ilẹkun anu to se.","marked":"K'ìlẹ̀kùn àánú tó ṣe."}],"end":17.121},{"key":"4","start":18.071,"lines":[{"start":18.071,"end":19.337,"text":"Tori waya-ija Rẹ,","marked":"Torí waya-ija Rẹ"},{"start":19.787,"end":21.047,"text":"Tori ogun-ẹjẹ Rẹ,","marked":"Torí ogun-ẹjẹ Rẹ"},{"start":21.497,"end":22.699,"text":"Tori iku Rẹ fun wa.","marked":"Torí ikú Rẹ̀ fún wa."}],"end":22.699},{"key":"5","start":23.649,"lines":[{"start":23.649,"end":25.011,"text":"Tor'ekun kikoro Re","marked":"Tọr'ẹkún kíkorò Rẹ̀"},{"start":25.461,"end":26.673,"text":"Lori Jerusalemu","marked":"Lórí Jerúsálẹ́mù"},{"start":27.123,"end":28.557,"text":"Ma je ka gan ife Re.","marked":"Má jẹ́ ká gan ìfẹ́ Rẹ."}],"end":28.557},{"key":"6","start":29.507,"lines":[{"start":29.507,"end":30.557,"text":"Iwọ Onidajọ wa,","marked":"Ìwọ Onídájọ́ wa"},{"start":31.007,"end":32.252,"text":"'Gbat' oju wa ba ri Ọ,","marked":"gbàt ojú wa bá rí Ọ"},{"start":32.702,"end":34.113,"text":"Fun wa n'ipo lọdọ Rẹ.","marked":"Fún wa n'ipò lọ́dọ̀ Rẹ."}],"end":34.113},{"key":"7","start":35.063,"lines":[{"start":35.063,"end":36.262,"text":"Ifẹ Rẹ l'a sinmi le,","marked":"Ìfẹ́ Rẹ l'a sinmi lé"},{"start":36.712,"end":38.583,"text":"N'ile wa l'oke l'a o mọ,","marked":"N'ilé wa l'òkè l'a ò mọ́"},{"start":39.033,"end":40.859,"text":"B'ifẹ naa ti tobi to.","marked":"B'ìfẹ́ náà ti tóbi tó."}],"end":40.859}]}