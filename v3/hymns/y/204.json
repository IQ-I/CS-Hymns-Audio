{"v":3,"coll":"y","num":204,"id":"hymn_204","title":"AYO b'aye! Oluwa de","duration":33.397,"voices":{"male":{"file":"y-204-male-v3.m4a","bytes":233830,"sha256":"9feed25fe87f09790db2835869607e955a296ec5f3ac61e0ea7290f24a14c305","duration":33.4},"female":{"file":"y-204-female-v3.m4a","bytes":241325,"sha256":"3c8a4e2dc0f922562dbe4845e293e93011e4a5ce36a18559c019a6ae40ef12f9","duration":33.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.02,"text":"AYỌ b'ayé! Oluwa de;","marked":"Ayọ̀ b'ayé! Olúwa dé"},{"start":2.47,"end":3.879,"text":"K'ayé gba Ọba re;","marked":"K'ayé gba Ọba rẹ̀"},{"start":4.329,"end":5.525,"text":"Ki gbogbo ọkan mura de,","marked":"Kí gbogbo ọkàn múra dé"},{"start":5.975,"end":7.294,"text":"K'ayé kọrin soke.","marked":"K'ayé kọrin sókè."}],"end":7.294},{"key":"2","start":8.244,"lines":[{"start":8.244,"end":10.264,"text":"Ayọ b'ayé! Jesu jọba,","marked":"Ayọ̀ b'ayé! Jésù jọba"},{"start":10.714,"end":12.032,"text":"Ẹ jẹ k'a ho f'ayọ:","marked":"Ẹ jẹ́ k'á hó f'ayọ̀"},{"start":12.482,"end":14.124,"text":"Gbogbo igbe, omi, oke,","marked":"Gbogbo igbe, omi, òkè"},{"start":14.574,"end":15.901,"text":"Wọn ń gberin ayọ naa.","marked":"Wọ́n ń gbẹ̀rin ayọ̀ náà."}],"end":15.901},{"key":"3","start":16.851,"lines":[{"start":16.851,"end":18.905,"text":"K'ẹsẹ oun 'yọnu pin l'ayé,","marked":"K'ẹsẹ̀ òun 'yọnu pín l'ayé"},{"start":19.355,"end":20.557,"text":"K'ẹgun ye hu n'ilẹ;","marked":"K'ẹ́gun yẹ hù n'ilẹ̀"},{"start":21.007,"end":22.31,"text":"O de lati mu 'bukun san,","marked":"Ó dé láti mú bùkún sàn"},{"start":22.76,"end":24.22,"text":"De'bi t'ẹgun gbe de.","marked":"Dẹ̀'bí t'ẹ́gun gbé dé."}],"end":24.22},{"key":"4","start":25.17,"lines":[{"start":25.17,"end":27.077,"text":"O f'otọ at'ifẹ jỌba,","marked":"Ó f'òtọ̀ àt'ìfẹ́ jỌba"},{"start":27.527,"end":28.583,"text":"O jẹ k'oril' ede,","marked":"Ó jẹ́ k'oríl èdè"},{"start":29.033,"end":30.238,"text":"Mọ ododo ijọba Rẹ,","marked":"Mọ òdodo ìjọba Rẹ"},{"start":30.688,"end":31.848,"text":"At'ifẹ 'yọnu Rẹ.","marked":"Àt'ìfẹ́ 'yọnu Rẹ̀."}],"end":31.848}]}