{"v":3,"coll":"y","num":472,"id":"hymn_472","title":"Tire lailai l'awa se","duration":44.125,"voices":{"male":{"file":"y-472-male-v3.m4a","bytes":314007,"sha256":"352fe961d67755c54c0a0c40eefb3c380374307075b29cba20dd0856200832fa","duration":44.2},"female":{"file":"y-472-female-v3.m4a","bytes":328605,"sha256":"7104537851152bbb30dfd3d5c75fd9f8fe43dd42d3e131cc2f6f4b042e777e32","duration":44.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.029,"text":"Tirẹ lailai l'awa se,","marked":"Tirẹ̀ láéláé l'àwa ṣe"},{"start":2.479,"end":3.986,"text":"Baba, Ọlọrun ife;","marked":"Baba, Ọlọ́run ìfẹ́"},{"start":4.436,"end":6.12,"text":"Jẹ ka jẹ Tirẹ titi,","marked":"Jẹ́ ká jẹ́ Tirẹ̀ títí"},{"start":6.57,"end":8.636,"text":"Layé yi, ati lailai.","marked":"Layé yí, àti láéláé."}],"end":8.636},{"key":"2","start":9.586,"lines":[{"start":9.586,"end":11.143,"text":"Tirẹ lailai l'awa se,","marked":"Tirẹ̀ láéláé l'àwa ṣe"},{"start":11.593,"end":12.865,"text":"Ma toju wa l' ayé yi;","marked":"Má tọ́jú wá l ayé yí"},{"start":13.315,"end":15.014,"text":"'Wọ iye, ọna otọ,","marked":"'Wọ iye, ọ̀nà òtọ̀"},{"start":15.464,"end":16.767,"text":"To wa si ilu ọrun.","marked":"Tó wá sí ìlú ọ̀run."}],"end":16.767},{"key":"3","start":17.717,"lines":[{"start":17.717,"end":19.742,"text":"Tirẹ lailai:- Abukun","marked":"Tirẹ̀ láéláé: Àbùkún"},{"start":20.192,"end":21.776,"text":"L'awọn t'o se 'sinmi wọn!","marked":"L'àwọn t'ó ṣe sinmi wọn!"},{"start":22.226,"end":23.64,"text":"Olugbala, Ọrẹ wa,","marked":"Olùgbàlà, Ọ̀rẹ́ wa"},{"start":24.09,"end":25.783,"text":"Gba 'ja wa ja de opin.","marked":"Gbà jà wá jà dé òpin."}],"end":25.783},{"key":"4","start":26.733,"lines":[{"start":26.733,"end":29.111,"text":"Tirẹ lailai: - Jesu, pa","marked":"Tirẹ̀ láéláé: Jésù, pa"},{"start":29.561,"end":30.563,"text":"Awọn aguntan Rẹ mọ,","marked":"Àwọn àgùntàn Rẹ̀ mọ́"},{"start":31.013,"end":32.23,"text":"Labẹ isọ rere Rẹ,","marked":"Lábẹ́ ìsọ rere Rẹ"},{"start":32.68,"end":34.164,"text":"Ni k'o pa gbogbo wa mọ.","marked":"Ní k'ó pa gbogbo wa mọ́."}],"end":34.164},{"key":"5","start":35.114,"lines":[{"start":35.114,"end":37.065,"text":"Tire lailai-Aini wa","marked":"Tirẹ̀ lailai-aini wa"},{"start":37.515,"end":38.851,"text":"Ni o je aniyan Re","marked":"Ni ó jẹ́ àníyàn Rẹ"},{"start":39.301,"end":40.621,"text":"O ti f'ese wa ji wa","marked":"Ó ti f'ẹsẹ̀ wa jì wá"},{"start":41.071,"end":42.576,"text":"To wa si ibugbe Re.","marked":"Tó wá sí ibùgbé Rẹ."}],"end":42.576}]}