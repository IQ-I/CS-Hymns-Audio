{"v":3,"coll":"y","num":603,"id":"hymn_603","title":"E DIDE Om'ogun igbala","duration":45.321,"voices":{"male":{"file":"y-603-male-v3.m4a","bytes":317984,"sha256":"09d5f18f9cd8176642096f963aec2164689d322d81676fce562b424edf811c44","duration":45.4},"female":{"file":"y-603-female-v3.m4a","bytes":327900,"sha256":"87a6af413725ad620d6aff5a4a4b304b440b0ed67d619aaef6957d077c1343aa","duration":45.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.52,"text":"E DIDE omo igbala","marked":"Ẹ Dìde ọmọ ìgbàlà"},{"start":1.97,"end":3.093,"text":"To romo Olori wa","marked":"Tó rọmọ Olórí wa"},{"start":3.543,"end":4.641,"text":"E dide orile ede","marked":"Ẹ dìde orílẹ̀ èdè"},{"start":5.091,"end":6.651,"text":"Ki ota to de Sion.","marked":"Kí ọ̀tá tó dé Sion."}],"end":6.651},{"key":"CHORUS","start":7.601,"lines":[{"start":7.601,"end":9.498,"text":"E ko orin, to dun pupo","marked":"Ẹ kọ orin, tó dùn púpọ̀"},{"start":9.948,"end":11.299,"text":"E korin to dun pupo","marked":"Ẹ kọrin tó dùn púpọ̀"},{"start":11.749,"end":12.869,"text":"Bi hiho omi okun","marked":"Bí híhó omi òkun"},{"start":13.319,"end":14.726,"text":"Nipa eje Olugbala","marked":"Nípa ẹ̀jẹ̀ Olùgbàlà"},{"start":15.176,"end":17.023,"text":"Awa ju asegun Io- asegun lo","marked":"Àwa ju aṣẹ́gun lọ aṣẹ́gun lọ"},{"start":17.473,"end":19.369,"text":"Awa ju asegun lo- asegun.","marked":"Àwa ju aṣẹ́gun lọ aṣẹ́gun."}],"end":19.369},{"key":"2","start":20.319,"lines":[{"start":20.319,"end":21.59,"text":"E wa bu omi igbala","marked":"Ẹ wá bu omi ìgbàlà"},{"start":22.04,"end":23.132,"text":"Enyin omo araiye","marked":"Ẹ̀yin ọmọ aráìyè"},{"start":23.582,"end":24.986,"text":"E wa gba igbala lofe","marked":"Ẹ wá gba ìgbàlà lọ́fẹ́"},{"start":25.436,"end":26.647,"text":"T'Oluwa pese fun wa.","marked":"T'Olúwa pèsè fún wa."}],"end":26.647},{"key":"3","start":27.597,"lines":[{"start":27.597,"end":29.232,"text":"Jesu f'ogoj'odun bebe","marked":"Jésù f'ogój'ọdún bẹ̀bẹ̀"},{"start":29.682,"end":31.116,"text":"Fun Egbe Serafu yi","marked":"Fún Ẹgbẹ́ Séráfù yí"},{"start":31.566,"end":32.926,"text":"Lati fi ra aiye pada","marked":"Láti fi ra ayé padà"},{"start":33.376,"end":34.664,"text":"Ninu ese wa gbogbo.","marked":"Nínú ẹ̀ṣẹ̀ wa gbogbo."}],"end":34.664},{"key":"4","start":35.614,"lines":[{"start":35.614,"end":37.436,"text":"Ogo ni fun Baba, Omo","marked":"Ògo ni fún Baba, Ọmọ"},{"start":37.886,"end":39.08,"text":"Emi Mimo lo de yi","marked":"Ẹ̀mí Mímọ́ ló dé yí"},{"start":39.53,"end":40.868,"text":"Jowo fo gbogbo wa mo lau","marked":"Jọ̀wọ́ fọ gbogbo wa mọ́ láù"},{"start":41.318,"end":42.685,"text":"Nini ese wa gbogbo.","marked":"Níní ẹ̀ṣẹ̀ wa gbogbo."},{"start":43.135,"end":43.771,"text":"Amin.","marked":"Àmín."}],"end":43.771}]}