{"v":3,"coll":"y","num":91,"id":"hymn_91","title":"E DAMURE eyin Seraf","duration":58.98,"voices":{"male":{"file":"y-91-male-v3.m4a","bytes":425780,"sha256":"075c71a228a7a219ae8c67372e5249ca3197b492808502f4733d71117ec62e01","duration":59.0},"female":{"file":"y-91-female-v3.m4a","bytes":434029,"sha256":"14d87ca2ccc1fef4554158b66ab6123ba35e63534cd29d08daf8fa186ac931d8","duration":59.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.908,"text":"E DAMURE ẹyin Seraf'","marked":"Ẹ Damúrè ẹ̀yin Seraf"},{"start":2.358,"end":3.982,"text":"E mu harpu yin pelu","marked":"Ẹ mú harpu yín pẹ̀lú"},{"start":4.432,"end":6.01,"text":"E je ki Kimbali yin dun","marked":"Ẹ jẹ́ kí Kimbali yín dùn"},{"start":6.46,"end":15.385,"text":"Lati pade Oba wa. Loke odo ọna Eden Ibugbe mimọ to dara, Nibi Kérúbù, Séráfù, Yin Baba Mimọ logo.","marked":"Láti pàdé Ọba wá. Lókè ọ̀dọ̀ ọ̀nà Eden Ibùgbé mímọ́ tó dára, Níbi Kérúbù, Séráfù, Yin Baba Mímọ́ lógo."}],"end":15.385},{"key":"CHORUS","start":16.335,"lines":[{"start":16.335,"end":18.506,"text":"Loke odo ona Eden,","marked":"Lókè ọ̀dọ̀ ọ̀nà Eden"},{"start":18.956,"end":20.193,"text":"Ibugbe mimo to dara","marked":"Ibùgbé mímọ́ tó dára"},{"start":20.643,"end":22.215,"text":"Nibi Kerubu Serafu,","marked":"Níbi Kérúbù Séráfù"},{"start":22.665,"end":24.053,"text":"Nyin Baba Mimo Logo.","marked":"Yín Baba Mímọ́ Lógo."}],"end":24.053},{"key":"2","start":25.003,"lines":[{"start":25.003,"end":26.7,"text":"Fi 'lu ati 'jo yin Baba","marked":"Fi lu àti jọ yín Baba"},{"start":27.15,"end":28.605,"text":"Baba y'o f'ayo fun wa","marked":"Baba y'ó f'ayọ̀ fún wa"},{"start":29.055,"end":30.461,"text":"Bi awa ba je le gbagbo","marked":"Bí àwa bá jẹ́ lè gbàgbọ́"},{"start":30.911,"end":32.269,"text":"Ere pupo ni fun wa.","marked":"Èrè púpọ̀ ni fún wa."}],"end":32.269},{"key":"3","start":33.219,"lines":[{"start":33.219,"end":34.768,"text":"Baba masai fi 're fun wa,","marked":"Baba masai fi rẹ̀ fún wa"},{"start":35.218,"end":36.443,"text":"Awa Seraf' ayé yi;","marked":"Àwa Seraf ayé yí"},{"start":36.893,"end":38.676,"text":"Se wa yẹ fun isin gbogbo,","marked":"Ṣé wá yẹ fún ìsìn gbogbo"},{"start":39.126,"end":40.674,"text":"Ka gb' ade wa nikẹhin.","marked":"Ká gb adé wa níkẹhìn."}],"end":40.674},{"key":"4","start":41.624,"lines":[{"start":41.624,"end":43.317,"text":"Baba to gbo ti Elijah,","marked":"Baba tó gbọ́ ti Elijah"},{"start":43.767,"end":45.537,"text":"Masai gbo ti Serafu;","marked":"Masai gbọ́ tí Séráfù"},{"start":45.987,"end":47.706,"text":"Jehovah-Jire Oba wa,","marked":"Jehovah-jire Ọba wa"},{"start":48.156,"end":49.515,"text":"Se wa ye lojo 'kehin.","marked":"Ṣé wá yẹ lọ́jọ́ kẹhìn."}],"end":49.515},{"key":"5","start":50.465,"lines":[{"start":50.465,"end":51.819,"text":"A o f'ogo fun Baba wa,","marked":"A ó f'ògo fún Baba wa"},{"start":52.269,"end":53.527,"text":"Fun Ọmọ to da wa si;","marked":"Fún Ọmọ tó dá wa sí"},{"start":53.977,"end":55.62,"text":"Bi ọdun si ti n yipo lọ,","marked":"Bí ọdún sì ti ń yípo lọ"},{"start":56.07,"end":57.431,"text":"Mẹtalọkan la o yin.","marked":"Mẹ́talọ́kan la ó yín."}],"end":57.431}]}