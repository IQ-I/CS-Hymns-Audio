{"v":3,"coll":"y","num":64,"id":"hymn_64","title":"'BUKUN ni f'awon mimo","duration":59.921,"voices":{"male":{"file":"y-64-male-v3.m4a","bytes":422400,"sha256":"359a7c769417e71bfa3d5f333bc9f5478afcba27b6526d1ae50971bffe6011d9","duration":60.0},"female":{"file":"y-64-female-v3.m4a","bytes":433647,"sha256":"4df7bdc2aa9154c870265f65fa76e3b9b3ceb3a561b8844478920f5f41fe5703","duration":60.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.672,"text":"'BUKUN ni f'awon mimo","marked":"bùkún ni f'àwọn mímọ́"},{"start":2.122,"end":3.296,"text":"Won ti ko 'se angeli","marked":"Wọ́n tí kò ṣe áńgẹ́lì"},{"start":3.746,"end":4.879,"text":"Orun n'ife okan won","marked":"Ọ̀run n'ìfẹ́ ọkàn wọn"},{"start":5.329,"end":6.842,"text":"Won fe lati r'Olorun","marked":"Wọ́n fẹ́ láti r'Ọlọ́run"},{"start":7.292,"end":8.356,"text":"A we abawon won nu","marked":"A wẹ àbàwọ́n wọn nù"},{"start":8.806,"end":10.097,"text":"Won n'idapo pelu Re","marked":"Wọ́n n'ìdàpọ̀ pẹ̀lú Rẹ"},{"start":10.547,"end":11.588,"text":"Won dabi Oluwa won","marked":"Wọ́n dàbí Olúwa wọn"},{"start":12.038,"end":13.414,"text":"Ti ise ere nla fun won.","marked":"Tí iṣẹ́ ère ńlá fún wọn."}],"end":13.414},{"key":"2","start":14.364,"lines":[{"start":14.364,"end":15.806,"text":"Won n'josin ninu emi","marked":"Wọ́n n'jọ̀sìn nínú èmi"},{"start":16.256,"end":17.487,"text":"Won wole ni'bi'te Re","marked":"Wọ́n wọlé ní'bí'tẹ́ Rẹ"},{"start":17.937,"end":19.2,"text":"Won te ba nib'imole","marked":"Wọ́n tẹ̀ bá níb'ìmọ́lẹ̀"},{"start":19.65,"end":20.652,"text":"lmole Olorun tan","marked":"Ìmọ́lẹ̀ Ọlọ́run tán"},{"start":21.102,"end":22.028,"text":"Awon olokan-riro","marked":"Àwọn olokan-riro"},{"start":22.478,"end":24.028,"text":"Ti won fe lati kekoo","marked":"Tí wọ́n fẹ́ láti kẹ́kọ̀ọ́"},{"start":24.478,"end":25.996,"text":"Won wa inu Oro naa","marked":"Wọ́n wá inú Ọ̀rọ̀ náà"},{"start":26.446,"end":27.969,"text":"Titi won fi gb'ohun Re.","marked":"Títí wọ́n fi gb'ohùn Rẹ."}],"end":27.969},{"key":"3","start":28.919,"lines":[{"start":28.919,"end":30.149,"text":"Oun ni Eleda won","marked":"Òun ni Ẹlẹ́dàá wọn"},{"start":30.599,"end":32.095,"text":"Won ba Oun nikan soro","marked":"Wọ́n bá Òun nìkan sọ̀rọ̀"},{"start":32.545,"end":34.034,"text":"Lat'ooro di asale","marked":"Lát'ooro di aṣálẹ̀"},{"start":34.484,"end":36.064,"text":"Ni won nyin l'Ojo 'sinmi","marked":"Ni wọ́n yín l'Ọjọ́ sinmi"},{"start":36.514,"end":38.126,"text":"Won di Ii mu ninu laalaa","marked":"Wọ́n di Ìí mú nínú làálàá"},{"start":38.576,"end":40.01,"text":"Won gbekele e n'nu 'ponju","marked":"Wọ́n gbẹ́kẹ̀lé e n'nú pọ́njú"},{"start":40.46,"end":41.736,"text":"lmole Re n tan n'nu won","marked":"Ìmọ́lẹ̀ Rẹ̀ ń tàn n'nù wọn"},{"start":42.186,"end":43.502,"text":"Ayida ko bori re.","marked":"Àyídà kò borí rẹ̀."}],"end":43.502},{"key":"4","start":44.452,"lines":[{"start":44.452,"end":45.711,"text":"Oun ni won n yin l'aye won","marked":"Òun ni wọ́n ń yìn l'ayé wọn"},{"start":46.161,"end":47.301,"text":"Won ki yoo ri iku mo","marked":"Wọn kì yóò rí ikú mọ́"},{"start":47.751,"end":49.071,"text":"Won yoo maa b'Oluwa gbe","marked":"Wọn yóò máa b'Olúwa gbé"},{"start":49.521,"end":50.987,"text":"Titi won yoo fi jinde","marked":"Títí wọn yóò fi jíǹde"},{"start":51.437,"end":52.68,"text":"Won yoo sunmo Oluwa","marked":"Wọn yóò súnmọ́ Olúwa"},{"start":53.13,"end":54.404,"text":"Pelu ara ajinde","marked":"Pẹ̀lú ara àjíǹde"},{"start":54.854,"end":56.173,"text":"Pelu Baba n'nu Omo","marked":"Pẹ̀lú Baba n'nú Ọmọ"},{"start":56.623,"end":58.372,"text":"At'Emi, metalokan.","marked":"Àt'ẹ̀mí, Mẹ́talọ́kan."}],"end":58.372}]}