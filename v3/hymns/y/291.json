{"v":3,"coll":"y","num":291,"id":"hymn_291","title":"SI pepe Oluwa","duration":22.691,"voices":{"male":{"file":"y-291-male-v3.m4a","bytes":148202,"sha256":"bb906cb3e3e732a6fd9182c9df4bcd4a5adb7b2998402204f1bac490aaf11696","duration":22.7},"female":{"file":"y-291-female-v3.m4a","bytes":154284,"sha256":"fd396584195cd9838deed894be82d19e58e5f44453c48faae23ea1953314079d","duration":22.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.373,"text":"SI pẹpẹ Oluwa,","marked":"Sí pẹpẹ Olúwa"},{"start":1.823,"end":2.988,"text":"Mo mu 'banujẹ wa;","marked":"Mo mú 'banujẹ wá"},{"start":3.438,"end":4.793,"text":"'Wọ ki o f'anu tẹwọgba,","marked":"'Wọ kí ó f'àánú tẹ́wọ́gbà"},{"start":5.243,"end":6.164,"text":"Ohun alayé yi?","marked":"Ohun alayé yí?"}],"end":6.164},{"key":"2","start":7.114,"lines":[{"start":7.114,"end":8.442,"text":"Kristi Ọdaguntan,","marked":"Kristi Ọ̀dàgùntàn"},{"start":8.892,"end":9.978,"text":"Ni igbagbọ mi n wo;","marked":"Ní ìgbàgbọ́ mi ń wò"},{"start":10.428,"end":11.978,"text":"'Wọ le ko 'hun alayé yi?","marked":"'Wọ lè kó hun alayé yí?"},{"start":12.428,"end":13.674,"text":"Wọ o gba ẹbọ mi.","marked":"Wọ ó gba ẹbọ mi."}],"end":13.674},{"key":"3","start":14.624,"lines":[{"start":14.624,"end":16.046,"text":"'Gbati Jesu mi ku,","marked":"gbàtí Jésù mi kú"},{"start":16.496,"end":17.685,"text":"A tẹ ofin l'ọrun;","marked":"A tẹ òfin l'ọ̀run"},{"start":18.135,"end":19.455,"text":"Ofin ko ba mi l'ẹru mọ,","marked":"Òfin kò bá mi l'ẹ́rù mọ́"},{"start":19.905,"end":21.141,"text":"Tori pe Jesu ku.","marked":"Torí pé Jésù kú."}],"end":21.141}]}