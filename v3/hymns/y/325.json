{"v":3,"coll":"y","num":325,"id":"hymn_325","title":"KRISTI, Oluwa ji loni Halleluya","duration":69.287,"voices":{"male":{"file":"y-325-male.m4a","bytes":518602,"sha256":"0dc5e5030ece6c515e31431b4945a288993e8f91eba525507ed0510a98bf8148","duration":69.3},"female":{"file":"y-325-female.m4a","bytes":537902,"sha256":"59bf6fd0c456553005704d545f4dcb6e0a391c955815bbb7637952046377a923","duration":69.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.176,"text":"KRISTI, Oluwa ji loni Halleluya,","marked":"Kristi, Olúwa jí lónì Hallelúyà"},{"start":3.556,"end":5.712,"text":"Eda at'Angeli nwi-Hal","marked":"Ẹ̀dà àt'Áńgẹ́lì nwi-Hal"},{"start":6.092,"end":8.44,"text":"Gb'ayo at'isegun ga- Hal","marked":"Gb'ayo àt'ìṣègùn ga Hal"},{"start":8.82,"end":11.415,"text":"K'orun at'aiye gberin!-Hal.","marked":"K'ọrùn àt'áíyé gberin!-Hal."}],"end":11.415},{"key":"2","start":12.365,"lines":[{"start":12.365,"end":15.005,"text":"Ise ti idande tan, Hal","marked":"Iṣẹ́ tí ìdáǹdè tán, Hal"},{"start":15.385,"end":17.622,"text":"O jija, o ti segun-Hal","marked":"Ó jíjà, ó ti ṣẹ́gun-Hal"},{"start":18.002,"end":20.215,"text":"Wo, sisu orun koja-Hal","marked":"Wò, ṣíṣú ọ̀run kọjá-Hal"},{"start":20.595,"end":22.208,"text":"'Ko wo sinu eje mo-Hal.","marked":"'Kò wọ́ sínú ẹ̀jẹ̀ mo-Hal."}],"end":22.208},{"key":"3","start":23.158,"lines":[{"start":23.158,"end":25.449,"text":"Lasan n'iso at'ami, -Hal","marked":"Lásán n'ìṣó àt'àmì, Hal"},{"start":25.829,"end":28.586,"text":"Krist wo orun apadi,-Hal","marked":"Krist wọ ọ̀run apadi,-Hal"},{"start":28.966,"end":30.52,"text":"Lasan l'agbara iku-Hal","marked":"Lásán l'ágbára ikú-Hal"},{"start":30.9,"end":33.514,"text":"Kristi si Paradise,-Hal.","marked":"Kristi sí Párádísè,-Hal."}],"end":33.514},{"key":"4","start":34.464,"lines":[{"start":34.464,"end":36.776,"text":"O tun wa, Oba ogo;-Hal","marked":"Ó tún wá, Ọba ògo;-Hal"},{"start":37.156,"end":39.802,"text":"'Iku, itani re wa?-Hal","marked":"'Ikú, ìtani rẹ̀ wà?-Hal"},{"start":40.182,"end":43.633,"text":"Lekan l'o le, k'o gba wa,-Hal","marked":"Lẹ́kan l'ó le, k'ó gbà wá,-Hal"},{"start":44.013,"end":46.563,"text":"'Boji, isegun re wa?-Hal.","marked":"'Bòji, ìṣẹ́gun rẹ̀ wà?-Hal."}],"end":46.563},{"key":"5","start":47.513,"lines":[{"start":47.513,"end":49.13,"text":"E jek'awon goke lo-Hal","marked":"Ẹ jẹ́k'àwọn gòkè lọ-Hal"},{"start":49.51,"end":51.823,"text":"S'odo Kristi ori wa-Hal","marked":"S'ọ́dọ̀ Kristi orí wa-Hal"},{"start":52.203,"end":54.753,"text":"Asa jinde pelu Re, -Hal","marked":"Àṣà jíǹde pẹ̀lú Rẹ, Hal"},{"start":55.133,"end":56.699,"text":"Bi a ti ku pelu Re-Hal.","marked":"Bí a ti kú pẹ̀lú Re-Hal."}],"end":56.699},{"key":"6","start":57.649,"lines":[{"start":57.649,"end":59.889,"text":"Oluwa t'aiye t'orun, - Hal","marked":"Olúwa t'áiye t'ọrùn, Hal"},{"start":60.269,"end":62.813,"text":"Tire ni gbogbo iyin; - Hal","marked":"Tìrẹ ni gbogbo ìyìn; Hal"},{"start":63.193,"end":64.666,"text":"A wole niwaju Re - Hal","marked":"A wọlé níwájú Rẹ̀ Hal"},{"start":65.046,"end":66.717,"text":"'Wo Ajinde at'Iye - Hal.","marked":"'Wo Àjíǹde àt'Iye Hal."},{"start":67.097,"end":67.738,"text":"Amin.","marked":"Àmín."}],"end":67.738}]}