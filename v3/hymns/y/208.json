{"v":3,"coll":"y","num":208,"id":"hymn_208","title":"OJO ayo nlanla naa de","duration":50.651,"voices":{"male":{"file":"y-208-male-v3.m4a","bytes":351062,"sha256":"f7d30d43a8a2c66edaa5f5e89d80e29751c7becfd8175bc660de72b1c115925d","duration":50.7},"female":{"file":"y-208-female-v3.m4a","bytes":363654,"sha256":"522750bafa12b752b600be5e716dab5de5ce63a814f2f8f70847c5fa341be5c7","duration":50.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.925,"text":"ỌJỌ ayọ nlanla naa de,","marked":"Ọjọ́ ayọ̀ ńláńlá náà dé"},{"start":2.375,"end":4.113,"text":"Eyi t'arayé ti ń reti;","marked":"Èyí t'arayé ti ń retí"},{"start":4.563,"end":5.841,"text":"Nigba t'Olugbala w'ayé","marked":"Nígbà t'Olùgbàlà w'ayé"},{"start":6.291,"end":7.745,"text":"Nigba t'a bi ninu ara.","marked":"Nígbà t'á bí nínú ara."}],"end":7.745},{"key":"2","start":8.695,"lines":[{"start":8.695,"end":10.043,"text":"Olus' aguntan ni papa,","marked":"Olùṣ àgùntàn ni pápá"},{"start":10.493,"end":11.805,"text":"Bi wọn ti ń sọ aguntan wọn,","marked":"Bí wọ́n ti ń sọ àgùntàn wọn"},{"start":12.255,"end":13.824,"text":"Ni ihin ayọ naa ko ba,","marked":"Ní ìhín ayọ̀ náà kò bá"},{"start":14.274,"end":15.707,"text":"Ihin bibi Olugbala.","marked":"Ìhín bíbí Olùgbàlà."}],"end":15.707},{"key":"3","start":16.657,"lines":[{"start":16.657,"end":17.799,"text":"Angẹl iransẹ Oluwa,","marked":"Angẹl ìránsẹ́ Olúwa"},{"start":18.249,"end":20.657,"text":"L'a ran si wọn, alabukun,","marked":"L'á rán sí wọn, alábùkún"},{"start":21.107,"end":22.808,"text":"Pẹlu ogo t'o ń tan julọ,","marked":"Pẹ̀lú ògo t'ó ń tàn jùlọ"},{"start":23.258,"end":24.957,"text":"Lati sọ ihin ayọ yi.","marked":"Láti sọ ìhín ayọ̀ yí."}],"end":24.957},{"key":"4","start":25.907,"lines":[{"start":25.907,"end":27.396,"text":"mp Gidigidi l'ẹru ba wọn,","marked":"mp Gidigidi l'ẹ̀rù bà wọ́n"},{"start":27.846,"end":29.146,"text":"Fun ajeji iran nla yi;","marked":"Fún àjèjì ìran ńlá yí"},{"start":29.596,"end":30.807,"text":"Ma bẹru l'ọrọ iyanju,","marked":"Má bẹ̀rù l'ọ̀rọ̀ ìyànjú"},{"start":31.257,"end":32.499,"text":"T'o t'ẹnu Angẹli wa.","marked":"T'ó t'ẹnu Áńgẹ́lì wá."}],"end":32.499},{"key":"5","start":33.449,"lines":[{"start":33.449,"end":34.6,"text":"A bi Olugbala loni,","marked":"A bí Olùgbàlà lónì"},{"start":35.05,"end":36.443,"text":"Kristi Oluwa ayé ni;","marked":"Kristi Olúwa ayé ni"},{"start":36.893,"end":38.473,"text":"N'ilu nla Dafidi l'O wa,","marked":"N'ìlú ńlá Dafidi l'Ó wà"},{"start":38.923,"end":40.916,"text":"N'ibujẹ ẹran l'a tẹ si.","marked":"N'ìbùjẹ́ ẹran l'a tẹ̀ sí."}],"end":40.916},{"key":"6","start":41.866,"lines":[{"start":41.866,"end":43.28,"text":"Ogo fun Ọlọrun‖ l'orin,","marked":"Ògo fún Ọlọ́run‖ l'orin"},{"start":43.73,"end":45.216,"text":"Ti eniyan y'o kọ s'ọrun;","marked":"Tí ènìyàn y'ó kọ́ s'ọ̀run"},{"start":45.666,"end":47.127,"text":"Fun ifẹ Rẹ laini opin,","marked":"Fún ìfẹ́ Rẹ láìní òpin"},{"start":47.577,"end":49.101,"text":"T'o mu alafia w'ayé.","marked":"T'ó mú àlàáfíà w'ayé."}],"end":49.101}]}