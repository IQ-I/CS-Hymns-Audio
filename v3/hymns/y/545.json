{"v":3,"coll":"y","num":545,"id":"hymn_545","title":"BABA orun! emi fe wa","duration":61.21,"voices":{"male":{"file":"y-545-male-v3.m4a","bytes":435725,"sha256":"4e78d9200a65fdbfe08dcd7ba13e71ccfbc72bc7012301074d7b3cebe82ff655","duration":61.3},"female":{"file":"y-545-female-v3.m4a","bytes":440715,"sha256":"0614c4f45e96e41e9b6d34ba93b532b009d5b86d869dfc66398fa19cc664b76e","duration":61.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.23,"text":"m BABA ọrun! emi fẹ wa,","marked":"m Baba ọ̀run! èmi fẹ́ wà"},{"start":2.68,"end":4.137,"text":"N' iwa mimọ l' ododo:","marked":"N ìwà mímọ́ l òdodo"},{"start":4.587,"end":6.152,"text":"Sugbọn ifẹ ẹran-ara,","marked":"Sùgbọ́n ìfẹ́ ẹran-ara"},{"start":6.602,"end":7.987,"text":"Ntan mi jẹ nigba gbogbo.","marked":"Ǹtàn mi jẹ́ nígbà gbogbo."}],"end":7.987},{"key":"2","start":8.937,"lines":[{"start":8.937,"end":10.321,"text":"Alailera ni emi se,","marked":"Aláìlera ni èmi ṣe"},{"start":10.771,"end":12.125,"text":"Ẹmi mi at' ara mi,","marked":"Ẹ̀mí mi àt ara mi"},{"start":12.575,"end":14.372,"text":"Ẹsẹ gba gbogbo ti mo n da,","marked":"Ẹsẹ̀ gba gbogbo tí mò ń dá"},{"start":14.822,"end":16.571,"text":"Wọ mi l'ọrun bi ẹru nla.","marked":"Wọ mí l'ọ̀run bí ẹ̀rù ńlá."}],"end":16.571},{"key":"3","start":17.521,"lines":[{"start":17.521,"end":18.968,"text":"Ofin kan mbẹ ni ọkan mi,","marked":"Òfin kan mbẹ́ ní ọkàn mi"},{"start":19.418,"end":20.85,"text":"'Wọ papa l'o fi sibẹ;","marked":"'Wọ pápá l'ó fi síbẹ̀"},{"start":21.3,"end":22.803,"text":"'Tori eyi ni mo fi fẹ,","marked":"torí èyí ni mo fi fẹ́"},{"start":23.253,"end":24.865,"text":"Tẹle 'fẹ at' asẹ Rẹ.","marked":"Tẹ̀lé 'fẹ àt àsẹ Rẹ̀."}],"end":24.865},{"key":"4","start":25.815,"lines":[{"start":25.815,"end":28.294,"text":"Sibẹ, bi mo fẹ se rere,","marked":"Síbẹ̀, bí mo fẹ́ ṣe rere"},{"start":28.744,"end":30.408,"text":"Lojukan naa, mo sina;","marked":"Lójúkan náà, mo ṣìnà"},{"start":30.858,"end":31.996,"text":"Rere l'ọrọ Rẹ ma sọ,","marked":"Rere l'ọ̀rọ̀ Rẹ má sọ"},{"start":32.446,"end":33.869,"text":"Buburu l'emi si n se.","marked":"Búburú l'èmi sì ń ṣe."}],"end":33.869},{"key":"5","start":34.819,"lines":[{"start":34.819,"end":36.191,"text":"Nigba pupọ ni mo n jọwọ,","marked":"Nígbà púpọ̀ ni mo ń jọ̀wọ́"},{"start":36.641,"end":37.954,"text":"Ara mi fun idanwo:","marked":"Ara mi fún ìdánwò"},{"start":38.404,"end":40.135,"text":"Bi a tilẹ n kilọ fun mi,","marked":"Bí a tilẹ̀ ń kìlọ̀ fún mi"},{"start":40.585,"end":41.953,"text":"Lati gafara f'ẹsẹ.","marked":"Láti gafara f'ẹsẹ̀."}],"end":41.953},{"key":"6","start":42.903,"lines":[{"start":42.903,"end":44.771,"text":"Baba ọrun, Iwọ nikan,","marked":"Baba ọ̀run, Ìwọ nìkan"},{"start":45.221,"end":46.72,"text":"L'o to lati gba mi la;","marked":"L'ó tó láti gbà mí là"},{"start":47.17,"end":48.519,"text":"Olugbala ti o ti ran,","marked":"Olùgbàlà tí ó ti rán"},{"start":48.969,"end":50.624,"text":"Oun na ni n ó gba mọra.","marked":"Òun ná ní n ó gbà mọ́ra."}],"end":50.624},{"key":"7","start":51.574,"lines":[{"start":51.574,"end":52.782,"text":"Fi Emi Mimo Re to mi","marked":"Fi Ẹ̀mí Mímọ́ Rẹ tọ̀ mí"},{"start":53.232,"end":55.296,"text":"S'ona titun ti mba gba","marked":"S'ọ̀nà títún tí mbá gbà"},{"start":55.746,"end":57.873,"text":"Ko mi, so mi, k'O si to mi","marked":"Kò mi, sọ mi, k'Ó sì tọ̀ mi"},{"start":58.323,"end":59.661,"text":"Iwo Emi Olorun.","marked":"Ìwọ Ẹ̀mí Ọlọ́run."}],"end":59.661}]}