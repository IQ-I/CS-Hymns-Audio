{"v":3,"coll":"y","num":542,"id":"hymn_542","title":"N O sunm' O, Olorun","duration":62.642,"voices":{"male":{"file":"y-542-male-v3.m4a","bytes":436343,"sha256":"d98403dd947fc13f466221cf647ed3237c4267e884090840570c14a3f6c43873","duration":62.7},"female":{"file":"y-542-female-v3.m4a","bytes":445106,"sha256":"989e6b363b350d688c5a1c014ce9a0da403156c6890c05a49fccb21a561b589c","duration":62.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.214,"text":"N Ó sunm' Ọ, Ọlọrun,","marked":"N Ó súnm Ọ́, Ọlọ́run"},{"start":2.664,"end":3.573,"text":"N ó sunmọ Ọ;","marked":"N ó súnmọ́ Ọ"},{"start":4.023,"end":5.325,"text":"B' o tilẹ se 'pọnju,","marked":"B ó tilẹ̀ ṣe 'pọnju"},{"start":5.775,"end":6.542,"text":"L' o mu mi wa :","marked":"L ó mú mi wá"},{"start":6.992,"end":8.715,"text":"Sibẹ, orin mi jẹ,","marked":"Síbẹ̀, orin mi jẹ́"},{"start":9.165,"end":11.061,"text":"N ó sunm' Ọ, Ọlọrun,","marked":"N ó súnm Ọ́, Ọlọ́run"},{"start":11.511,"end":12.568,"text":"N ó sunmọ Ọ.","marked":"N ó súnmọ́ Ọ."}],"end":12.568},{"key":"2","start":13.518,"lines":[{"start":13.518,"end":14.546,"text":"Ni ọna ajo mi,","marked":"Ní ọ̀nà àjọ mi"},{"start":14.996,"end":15.862,"text":"B' ilẹ ba su,","marked":"B ilẹ̀ bá ṣú"},{"start":16.312,"end":17.521,"text":"Bi okuta si jẹ","marked":"Bí òkúta sì jẹ́"},{"start":17.971,"end":18.713,"text":"Irọri mi,","marked":"Ìrọ̀rí mi"},{"start":19.163,"end":20.851,"text":"Sibẹ, nin' ala mi,","marked":"Síbẹ̀, nín àlá mi"},{"start":21.301,"end":23.138,"text":"N ó sunm' Ọ, Ọlọrun,","marked":"N ó súnm Ọ́, Ọlọ́run"},{"start":23.588,"end":24.668,"text":"N ó sunmọ Ọ.","marked":"N ó súnmọ́ Ọ."}],"end":24.668},{"key":"3","start":25.618,"lines":[{"start":25.618,"end":26.729,"text":"Nibẹ jẹ ki n r'ọna","marked":"Níbẹ̀ jẹ́ kí n r'ọ̀nà"},{"start":27.179,"end":28.099,"text":"T'o lo s'ọrun,","marked":"T'ó lọ s'ọ̀run"},{"start":28.549,"end":29.868,"text":"Gbogb' ohun t'o fun mi","marked":"Gbogb ohun t'ó fún mi"},{"start":30.318,"end":31.079,"text":"Nin' anu Rẹ;","marked":"Nín àánú Rẹ"},{"start":31.529,"end":32.903,"text":"Angẹl lati pe mi,","marked":"Angẹl láti pè mí"},{"start":33.353,"end":35.518,"text":"N ó sunm' Ọ, Ọlọrun,","marked":"N ó súnm Ọ́, Ọlọ́run"},{"start":35.968,"end":37.036,"text":"N ó sunmọ Ọ.","marked":"N ó súnmọ́ Ọ."}],"end":37.036},{"key":"4","start":37.986,"lines":[{"start":37.986,"end":39.329,"text":"Njẹ gbati mo ba ji,","marked":"Ǹjẹ́ gbátí mo bá jí"},{"start":39.779,"end":40.588,"text":"Em' o yin Ọ:","marked":"Èm ó yìn Ọ"},{"start":41.038,"end":42.291,"text":"N ó f' akete mi se,","marked":"N ó f àkéte mi ṣe"},{"start":42.741,"end":43.665,"text":"Bẹtẹl fun Ọ,","marked":"Bẹ́tẹ́l fún Ọ"},{"start":44.115,"end":45.214,"text":"Bẹ ninu osi mi,","marked":"Bẹ nínú òsì mi"},{"start":45.664,"end":47.603,"text":"N ó sunm' Ọ, Ọlọrun,","marked":"N ó súnm Ọ́, Ọlọ́run"},{"start":48.053,"end":49.165,"text":"N ó sunmọ Ọ.","marked":"N ó súnmọ́ Ọ."}],"end":49.165},{"key":"5","start":50.115,"lines":[{"start":50.115,"end":51.4,"text":"'Gba mba fi ayọ lọ,","marked":"gbà mbá fi ayọ̀ lọ"},{"start":51.85,"end":52.681,"text":"S'oke ọrun,","marked":"S'ókè ọ̀run"},{"start":53.131,"end":54.319,"text":"T'o ga ju ọrun lọ,","marked":"T'ó ga ju ọ̀run lọ"},{"start":54.769,"end":55.695,"text":"Soke giga;","marked":"Sókè gíga"},{"start":56.145,"end":57.182,"text":"Orin mi yio jẹ,","marked":"Orin mi yóò jẹ́"},{"start":57.632,"end":59.555,"text":"di N ó sunm' Ọ, Ọlọrun,","marked":"di N ó súnm Ọ́, Ọlọ́run"},{"start":60.005,"end":61.093,"text":"N ó sunmọ Ọ.","marked":"N ó súnmọ́ Ọ."}],"end":61.093}]}