{"v":3,"coll":"y","num":65,"id":"hymn_65","title":"ELESE wa s'orisun na","duration":49.598,"voices":{"male":{"file":"y-65-male-v3.m4a","bytes":355320,"sha256":"d2a2ac47c1c90353bafdbbbd308e8daf7b37aa22e1d3ee5134d9e7207dac4b6c","duration":49.6},"female":{"file":"y-65-female-v3.m4a","bytes":366346,"sha256":"fb50f081e8949dc1c6e8d24799f2a7bf2a5e1b0ba97da30fa7b58860c03b486b","duration":49.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.738,"text":"ELESE wa s'orisun na,","marked":"Ẹlẹ́ṣẹ̀ wa s'orísun ná"},{"start":2.188,"end":3.37,"text":"Wa pelu 'banuje re,","marked":"Wá pẹ̀lú banújẹ́ rẹ"},{"start":3.82,"end":5.089,"text":"Ri won sinu omi jijin","marked":"Rí wọn sínú omi jíjìn"},{"start":5.539,"end":15.393,"text":"'Wo y'o r'irorun nibe. Yara kalọ, mase duro, Isẹju kan le sọ ẹmi rẹ nu, Jesu n duro lati gba ọ, Anu mbẹ fun ọ loni.","marked":"wò y'ó r'ìrọrùn níbẹ̀. Yára kálọ, máṣe dúró, Ìsẹ́jú kan lè sọ ẹ̀mí rẹ̀ nù, Jésù ń dúró láti gbà ọ́, Àánú mbẹ́ fún ọ lónì."}],"end":15.393},{"key":"CHORUS","start":16.343,"lines":[{"start":16.343,"end":18.359,"text":"Yara kalo, mase duro","marked":"Yára kálọ, máṣe dúró"},{"start":18.809,"end":20.658,"text":"lseju kan le so emi re nu","marked":"Ìṣẹ́jú kan lè sọ ẹ̀mí rẹ̀ nù"},{"start":21.108,"end":22.792,"text":"Jesu nduro Iati gba o,","marked":"Jésù ńdúró láti gbà ọ́"},{"start":23.242,"end":24.384,"text":"Anu mbe fun o loni.","marked":"Àánú mbẹ́ fún ọ lónì."}],"end":24.384},{"key":"2","start":25.334,"lines":[{"start":25.334,"end":26.804,"text":"Wa t'iwọ t'ẹru ẹsẹ rẹ,","marked":"Wá t'ìwọ t'ẹrú ẹsẹ̀ rẹ"},{"start":27.254,"end":28.723,"text":"Jesu ti n duro de ọ;","marked":"Jésù ti ń dúró dè ọ́"},{"start":29.173,"end":30.582,"text":"B'ẹsẹ rẹ pọn bi alari,","marked":"B'ẹsẹ̀ rẹ̀ pọ́n bí alárí"},{"start":31.032,"end":32.415,"text":"Wọn yoo funfun bi sino.","marked":"Wọn yóò funfun bí sínọ."}],"end":32.415},{"key":"3","start":33.365,"lines":[{"start":33.365,"end":34.767,"text":"Jesu Olugbala wi pé,","marked":"Jésù Olùgbàlà wí pé"},{"start":35.217,"end":36.411,"text":"Awọn ti o ba gbagbọ;","marked":"Àwọn tí ó bá gbàgbọ́"},{"start":36.861,"end":38.123,"text":"Ti wọn si ronupiwada,","marked":"Tí wọ́n sì ronúpìwàdà"},{"start":38.573,"end":40.226,"text":"Y'o r'iye gba lọdọ Rẹ.","marked":"Y'ó r'iye gbà lọ́dọ̀ Rẹ."}],"end":40.226},{"key":"4","start":41.176,"lines":[{"start":41.176,"end":42.648,"text":"Wa wẹ ninu orisun naa,","marked":"Wá wẹ̀ nínú orísun náà"},{"start":43.098,"end":44.436,"text":"F'eti si ohun ifẹ;","marked":"F'etí sí ohun ìfẹ́"},{"start":44.886,"end":46.015,"text":"Jẹ ki awọn Angẹli yọ,","marked":"Jẹ́ kí àwọn Áńgẹ́lì yọ̀"},{"start":46.465,"end":48.049,"text":"F'ẹlẹsẹ to yi pada","marked":"F'ẹlẹ́sẹ̀ tó yí padà"}],"end":48.049}]}