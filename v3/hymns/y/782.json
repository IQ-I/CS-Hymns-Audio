{"v":3,"coll":"y","num":782,"id":"hymn_782","title":"WA, Jesu fi ara han","duration":35.224,"voices":{"male":{"file":"y-782-male-v3.m4a","bytes":249422,"sha256":"f785cacba7bdc4d5f74a61e58657c68a851d30ce6e0b959b02e5722c50f60d2e","duration":35.3},"female":{"file":"y-782-female-v3.m4a","bytes":256908,"sha256":"ea4087f750fc1777b1350e09c95a394cd87528b41e20153d17ba5b0c882d86e2","duration":35.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.731,"text":"WA, Jesu fi ara han,","marked":"Wá, Jésù fi ara hàn"},{"start":2.181,"end":3.493,"text":"Wa, jẹ k'ọkan wa mọ Ọ,","marked":"Wá, jẹ́ k'ọkàn wa mọ́ Ọ"},{"start":3.943,"end":5.534,"text":"Wa, mu gbogb' ọkan gbona,","marked":"Wá, mú gbogb ọkàn gbóná"},{"start":5.984,"end":7.695,"text":"Wa, bukun wa k'a to lọ.","marked":"Wá, bùkún wa k'á tó lọ."}],"end":7.695},{"key":"2","start":8.645,"lines":[{"start":8.645,"end":10.429,"text":"Wa, f'aya wa n'isinmi,","marked":"Wá, f'àya wà n'ìsinmi"},{"start":10.879,"end":13.178,"text":"Wa, k'a d'alabukun fun,","marked":"Wá, k'á d'alábùkún fún"},{"start":13.628,"end":14.86,"text":"Wa, sọrọ alafia,","marked":"Wá, sọ̀rọ̀ àlàáfíà"},{"start":15.31,"end":16.721,"text":"Wa busi igbagbọ wa.","marked":"Wá bùsi ìgbàgbọ́ wa."}],"end":16.721},{"key":"3","start":17.671,"lines":[{"start":17.671,"end":19.124,"text":"Wa, le 'siyemeji lo","marked":"Wá, lè ṣiyèméjì lọ"},{"start":19.574,"end":21.398,"text":"Wa, ko wa b'a ti bebe","marked":"Wá, kò wá b'á ti bẹ̀bẹ̀"},{"start":21.848,"end":23.559,"text":"Wa, fun okan wa n'ife","marked":"Wá, fún ọkàn wa n'ìfẹ́"},{"start":24.009,"end":25.577,"text":"Wa, fa okan wa soke.","marked":"Wá, fa ọkàn wa sókè."}],"end":25.577},{"key":"4","start":26.527,"lines":[{"start":26.527,"end":28.037,"text":"Wa, sọ f'ọkan wa k'o yọ,","marked":"Wá, sọ f'ọkàn wa k'ó yọ"},{"start":28.487,"end":29.944,"text":"Wa, wi pé ―Wo ni mo yan,‖","marked":"Wá, wí pé ―Wò ni mo yàn,‖"},{"start":30.394,"end":31.903,"text":"Wa, p'awọn agbo Rẹ mọ,","marked":"Wá, p'àwọn agbo Rẹ mọ́"},{"start":32.353,"end":33.675,"text":"Wa sure f'aguntan Rẹ.","marked":"Wá súre f'àgùntàn Rẹ̀."}],"end":33.675}]}