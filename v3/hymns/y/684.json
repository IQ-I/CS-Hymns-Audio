{"v":3,"coll":"y","num":684,"id":"hymn_684","title":"OLORUN orin, eni ti","duration":24.294,"voices":{"male":{"file":"y-684-male-v3.m4a","bytes":163363,"sha256":"3c0faa1f510f07ebff4db2f8dc7f3572745e07729bdc017196136511ed128d21","duration":24.3},"female":{"file":"y-684-female-v3.m4a","bytes":171407,"sha256":"b1dd3111d3c79d429bac2576c9903e66e105367cc139aba84e1ede0eaf1fbe65","duration":24.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.924,"text":"ỌLỌRUN orin, ẹni ti","marked":"Ọlọ́run orin, ẹni tí"},{"start":2.374,"end":3.388,"text":"Awọn Angeli n kọ;","marked":"Àwọn Áńgẹ́lì ń kọ"},{"start":3.838,"end":5.273,"text":"Wo'lẹ lati 'bujoko Rẹ!","marked":"Wò'lẹ́ láti bùjókò Rẹ!"},{"start":5.723,"end":7.12,"text":"Kọ wa k'a bẹru Rẹ!","marked":"Kọ́ wá k'á bẹ̀rù Rẹ!"}],"end":7.12},{"key":"2","start":8.07,"lines":[{"start":8.07,"end":9.289,"text":"Ọrọ mimọ Rẹ la fẹ kọ,","marked":"Ọ̀rọ̀ mímọ́ Rẹ̀ la fẹ́ kọ"},{"start":9.739,"end":10.815,"text":"Lat' igba ewe wa;","marked":"Lát ìgbà èwe wá"},{"start":11.265,"end":12.833,"text":"K'a kọ t'Olugbala t'ise","marked":"K'á kọ́ t'Olùgbàlà t'iṣẹ́"},{"start":13.283,"end":14.446,"text":"Ọna, Iye, Otọ.","marked":"Ọ̀nà, Ìyè, Òtọ̀."}],"end":14.446},{"key":"3","start":15.396,"lines":[{"start":15.396,"end":17.082,"text":"Jesu, ogo at'ore Rẹ,","marked":"Jésù, ògo àt'ọrẹ Rẹ̀"},{"start":17.532,"end":19.026,"text":"L'a n sọ nisinsin yi!","marked":"L'à ń sọ nísinsin yí!"},{"start":19.476,"end":20.907,"text":"Se 'bujoko Rẹ s'ọkan wa,","marked":"Ṣe bùjókò Rẹ̀ s'ọkàn wá"},{"start":21.357,"end":22.744,"text":"Si jẹ k'a bẹru Rẹ.","marked":"Sì jẹ́ k'á bẹ̀rù Rẹ."}],"end":22.744}]}