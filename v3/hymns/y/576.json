{"v":3,"coll":"y","num":576,"id":"hymn_576","title":"OM-OGUN Krist, dide","duration":39.55,"voices":{"male":{"file":"y-576-male-v3.m4a","bytes":268189,"sha256":"7cbf7be2bc84aeb998c974546cfdf293c1b28b1ac1f889c00c63b2d846f19ca1","duration":39.6},"female":{"file":"y-576-female-v3.m4a","bytes":279577,"sha256":"e42925c547959164b3c0e561ab8db3d4f5caac7d8e774887ce3f269aaf6e59c9","duration":39.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.88,"text":"ỌM'-OGUN Krist, dide,","marked":"Ọm'-Ogun Krist, dìde"},{"start":2.33,"end":3.416,"text":"Mu hamọran yin wọ:","marked":"Mú hámọ̀ràn yín wọ"},{"start":3.866,"end":5.378,"text":"Mu 'pa t'Ọlọrun fi fun yin","marked":"Mú pa t'Ọlọ́run fi fún yín"},{"start":5.828,"end":7.029,"text":"Nipa ti ọmọ Rẹ.","marked":"Nípa ti ọmọ Rẹ."}],"end":7.029},{"key":"2","start":7.979,"lines":[{"start":7.979,"end":8.857,"text":"Gbe pa Ọlọrun wọ,","marked":"Gbé pa Ọlọ́run wọ"},{"start":9.307,"end":10.46,"text":"T'Oluwa ọm'-ogun,","marked":"T'Olúwa ọm'-ogun"},{"start":10.91,"end":12.497,"text":"Ẹni t'o gbẹkẹle Jesu,","marked":"Ẹni t'ó gbẹ́kẹ̀lé Jésù"},{"start":12.947,"end":14.456,"text":"O ju asẹgun lọ.","marked":"Ó ju asẹ́gun lọ."}],"end":14.456},{"key":"3","start":15.406,"lines":[{"start":15.406,"end":16.418,"text":"Ninu ipa Rẹ nla,","marked":"Nínú ipa Rẹ̀ ńlá"},{"start":16.868,"end":18.009,"text":"Oun ni ki ẹ duro,","marked":"Òun ni kí ẹ dúró"},{"start":18.459,"end":19.879,"text":"Tori k'ẹ ba le jija na,","marked":"Torí k'ẹ bá lè jíjà ná"},{"start":20.329,"end":21.628,"text":"Ẹ di hamọra yin.","marked":"Ẹ di hámọ́ra yín."}],"end":21.628},{"key":"4","start":22.578,"lines":[{"start":22.578,"end":24.056,"text":"Lo lat'ipa de'pa,","marked":"Lọ lát'ipa dé'pa"},{"start":24.506,"end":26.448,"text":"Ma ja, ma gbadura;","marked":"Má jà, má gbàdúrà"},{"start":26.898,"end":28.351,"text":"Tẹ agbara okunkun ba,","marked":"Tẹ agbára òkùnkùn bá"},{"start":28.801,"end":30.626,"text":"Ẹ ja, k'ẹ si sẹgun.","marked":"Ẹ jà, k'ẹ sì sẹ́gun."}],"end":30.626},{"key":"5","start":31.576,"lines":[{"start":31.576,"end":32.638,"text":"Lehin ohun gbogbo","marked":"Lẹ́hìn ohun gbogbo"},{"start":33.088,"end":34.144,"text":"Lehin gbogbo ija","marked":"Lẹ́hìn gbogbo ìjà"},{"start":34.594,"end":36.419,"text":"K'e le segun n'ipa Kristi","marked":"K'é lè ṣẹ́gun n'ipa Kristi"},{"start":36.869,"end":38.0,"text":"K'e si duro sinsin.","marked":"K'é sì dúró ṣinṣin."}],"end":38.0}]}