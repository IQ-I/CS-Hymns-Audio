{"v":3,"coll":"y","num":453,"id":"hymn_453","title":"Jesu, Olugbala, wo mi","duration":52.237,"voices":{"male":{"file":"y-453-male-v3.m4a","bytes":360686,"sha256":"a47ca40684eb6fcd2deccdcfb7b7dde3872b8677adf5a3c80eaeea966312e6ac","duration":52.3},"female":{"file":"y-453-female-v3.m4a","bytes":372580,"sha256":"cfc3d369042af02f77886dff9d9e8f626a3d49653a2d3293cba1f922f827fac1","duration":52.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.413,"text":"JESU, Olugbala, wo mi,","marked":"Jésù, Olùgbàlà, wò mí"},{"start":2.863,"end":4.386,"text":"Arẹ mu mi, ara n ni mi:","marked":"Àrẹ mú mi, ara ń ní mi"},{"start":4.836,"end":6.652,"text":"Mo de lati wa gb'ara le Ọ,","marked":"Mo dé láti wá gb'ara lé Ọ"},{"start":7.102,"end":8.038,"text":"'Wọ 'sinmi mi.","marked":"'Wọ sinmi mi."}],"end":8.038},{"key":"2","start":8.988,"lines":[{"start":8.988,"end":10.845,"text":"Boju wo mi, o rẹ mi tan;","marked":"Bojú wò mí, ó rẹ̀ mí tán"},{"start":11.295,"end":12.856,"text":"Irin ajo naa gun fun mi;","marked":"Irin àjò náà gùn fún mi"},{"start":13.306,"end":14.532,"text":"Mo n wa 'ranwọ agbara Rẹ,","marked":"Mo ń wá 'ranwọ agbára Rẹ̀"},{"start":14.982,"end":15.993,"text":"'Wọ Ipa mi.","marked":"'Wọ Ipá mi."}],"end":15.993},{"key":"3","start":16.943,"lines":[{"start":16.943,"end":18.133,"text":"Idamu ba mi lọna mi,","marked":"Ìdàmú bá mi lọ́nà mi"},{"start":18.583,"end":21.386,"text":"Oru sokun, iji si ń fẹ,","marked":"Òru sọkún, ìjì sì ń fẹ́"},{"start":21.836,"end":22.99,"text":"Tan imọlẹ si ọna mi,","marked":"Tan ìmọ́lẹ̀ sí ọ̀nà mi"},{"start":23.44,"end":24.369,"text":"'Wọ 'Mọlẹ mi.","marked":"'Wọ 'Mọlẹ mi."}],"end":24.369},{"key":"4","start":25.319,"lines":[{"start":25.319,"end":26.904,"text":"Gba Satani ba tafa rẹ,","marked":"Gba Sátánì bá tafà rẹ̀"},{"start":27.354,"end":29.535,"text":"'Wọ ni mo n wo; n ko bẹru mọ,","marked":"'Wọ ni mo ń wò; n kò bẹ̀rù mọ́"},{"start":29.985,"end":31.397,"text":"Agbelebu Rẹ l'abo mi,","marked":"Àgbélébùú Rẹ l'abo mi"},{"start":31.847,"end":32.872,"text":"'Wọ Alafia mi.","marked":"'Wọ Àlàáfíà mi."}],"end":32.872},{"key":"5","start":33.822,"lines":[{"start":33.822,"end":35.431,"text":"Mo nikan wa leti Jọrdan,","marked":"Mo nìkan wà létí Jọrdan"},{"start":35.881,"end":37.926,"text":"Ninu 'waya-'ja jelo ni:","marked":"Nínú waya-'ja jèlò ni"},{"start":38.376,"end":39.722,"text":"'Wọ ki yoo jẹ k'emi ri,","marked":"'Wọ kì yóò jẹ́ k'èmi rí"},{"start":40.172,"end":41.097,"text":"'Wọ Iye mi.","marked":"'Wọ Iye mi."}],"end":41.097},{"key":"6","start":42.047,"lines":[{"start":42.047,"end":43.607,"text":"Gbogbo aini, 'Wọ o fun mi,","marked":"Gbogbo àìní, 'Wọ ó fún mi"},{"start":44.057,"end":46.191,"text":"Titi d'opin; l'ọnakọna;","marked":"Títí d'òpin; l'ọ̀nàkọ́nà"},{"start":46.641,"end":49.358,"text":"Ni 'ye, ni 'ku, titi lailai,","marked":"Ní yẹ, ní kú, títí láéláé"},{"start":49.808,"end":50.688,"text":"'Wọ gbogbo mi.","marked":"'Wọ gbogbo mi."}],"end":50.688}]}