{"v":3,"coll":"y","num":141,"id":"hymn_141","title":"MO f'ope f'Oluwa","duration":61.745,"voices":{"male":{"file":"y-141-male-v3.m4a","bytes":413838,"sha256":"a512784ef805ff6c9923420d569da76cf348705aa956254f388eff83266bc5f3","duration":61.8},"female":{"file":"y-141-female-v3.m4a","bytes":431448,"sha256":"aa7864d66f631d9e0df63d07f15e4aae5310add218de7dfbf2effa655e52de6f","duration":61.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.502,"text":"MO f'ọpẹ f'Oluwa,","marked":"Mo f'ọpẹ́ f'Olúwa"},{"start":1.952,"end":2.989,"text":"Ahọn mi yin Jesu;","marked":"Ahọ́n mi yin Jésù"},{"start":3.439,"end":5.053,"text":"Ti a ko ni lat'ewe wa,","marked":"Tí a kò ní lát'èwe wá"},{"start":5.503,"end":6.826,"text":"Lati ka ọrọ Rẹ.","marked":"Láti ka ọ̀rọ̀ Rẹ."}],"end":6.826},{"key":"CHORUS","start":7.776,"lines":[{"start":7.776,"end":8.586,"text":"at'ewu nla,","marked":"àt'ewu ńlá"},{"start":9.036,"end":10.369,"text":"Ẹru s'ẹsẹ nipa ẹda-","marked":"Ẹ̀rù s'ẹsẹ̀ nípa ẹ̀dá"},{"start":10.819,"end":12.143,"text":"Ni Bibeli ń kọ mi.","marked":"Ní Bíbélì ń kọ́ mi."}],"end":12.143},{"key":"2","start":13.093,"lines":[{"start":13.093,"end":14.306,"text":"B'ese mi ti po to","marked":"B'ẹ̀ṣẹ̀ mi ti pọ̀ tó"}],"end":14.306},{"key":"3","start":15.256,"lines":[{"start":15.256,"end":16.5,"text":"Bibeli l'o ń kọni,","marked":"Bíbélì l'ó ń kọ́ni"},{"start":16.95,"end":18.438,"text":"B'a ko tilẹ se nkan;","marked":"B'á kò tilẹ̀ ṣe nǹkan"},{"start":18.888,"end":20.62,"text":"Njẹ nibo l'ẹlẹsẹ y'o wọ,","marked":"Ǹjẹ́ níbo l'ẹlẹ́sẹ̀ y'ó wọ̀"},{"start":21.07,"end":22.426,"text":"Lati bọ n'nu egbe?","marked":"Láti bọ́ n'nú ẹgbẹ́?"}],"end":22.426},{"key":"4","start":23.376,"lines":[{"start":23.376,"end":24.399,"text":"Iwe Mimọ Rẹ yi,","marked":"Ìwé Mímọ́ Rẹ yí"},{"start":24.849,"end":26.474,"text":"Jesu, Oluwa mi;","marked":"Jésù, Olúwa mi"},{"start":26.924,"end":28.552,"text":"L'o ń f'ọna igbala han ni,","marked":"L'ó ń f'ọ̀nà ìgbàlà hàn ni"},{"start":29.002,"end":30.352,"text":"L'o si ń ko-ni rere.","marked":"L'ó sì ń ko-ni rere."}],"end":30.352},{"key":"5","start":31.302,"lines":[{"start":31.302,"end":32.585,"text":"Ninu re ni mo ko","marked":"Nínú rẹ̀ ni mo kọ"},{"start":33.035,"end":34.295,"text":"Bi Krist'Om'Olorun","marked":"Bí Krist'ọm'ọlọ́run"},{"start":34.745,"end":36.16,"text":"Ti terigba iya nla wa,","marked":"Ti tẹrígbà ìyá ńlá wa"},{"start":36.61,"end":37.802,"text":"Ti O Si ku fun wa.","marked":"Tí Ó Sì kú fún wa."}],"end":37.802},{"key":"6","start":38.752,"lines":[{"start":38.752,"end":39.889,"text":"O gunwa ni ọrun -","marked":"Ó gúnwà ní ọ̀run"},{"start":40.339,"end":41.445,"text":"O ń ran Ẹmi Rẹ wa -","marked":"Ó ń rán Ẹ̀mí Rẹ̀ wá"},{"start":41.895,"end":43.478,"text":"Lati fi ifẹ nla Rẹ han,","marked":"Láti fi ìfẹ́ ńlá Rẹ hàn"},{"start":43.928,"end":44.927,"text":"At' Ilana rere.","marked":"Àt Ìlànà rere."}],"end":44.927},{"key":"7","start":45.877,"lines":[{"start":45.877,"end":47.4,"text":"Ẹmi Mimọ, kọ mi,","marked":"Ẹ̀mí Mímọ́, kọ́ mi"},{"start":47.85,"end":48.895,"text":"K'ọkan mi si le gba,","marked":"K'ọkàn mi sì lè gbà"},{"start":49.345,"end":50.817,"text":"Gbogbo 'wasu ọrọ Rẹ gbọ,","marked":"Gbogbo wàṣù ọ̀rọ̀ Rẹ̀ gbọ́"},{"start":51.267,"end":52.188,"text":"B'awọn eniyan Rẹ.","marked":"B'àwọn ènìyàn Rẹ."}],"end":52.188},{"key":"8","start":53.138,"lines":[{"start":53.138,"end":54.592,"text":"Nigba naa, Oluwa,","marked":"Nígbà náà, Olúwa"},{"start":55.042,"end":56.433,"text":"L'orin 'yin mi y'o ga;","marked":"L'orin yín mi y'ó ga"},{"start":56.883,"end":58.709,"text":"N'tori t'a kọ mi lati ka,","marked":"N'torí t'á kọ́ mi láti ká"},{"start":59.159,"end":60.196,"text":"Bibeli mimọ Rẹ.","marked":"Bíbélì mímọ́ Rẹ̀."}],"end":60.196}]}