{"v":3,"coll":"y","num":762,"id":"hymn_762","title":"IBUKUN ni f'oku","duration":54.756,"voices":{"male":{"file":"y-762-male-v3.m4a","bytes":370204,"sha256":"3715517438143e9a2ae5b0f836e032a89f0d33335e9aa78876512db299deb89b","duration":54.8},"female":{"file":"y-762-female-v3.m4a","bytes":383861,"sha256":"1db910e2d7932c64009a170e8843d983af9e1c00f0952c41027ef373e40055ff","duration":54.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.609,"text":"IBUKUN ni f'oku,","marked":"Ìbùkún ni f'òkú"},{"start":2.059,"end":3.364,"text":"T'o sinmi le Jesu;","marked":"T'ó sinmi lé Jésù"},{"start":3.814,"end":5.08,"text":"Awọn t'o gb'ori wọn,","marked":"Àwọn t'ó gb'orí wọn"},{"start":5.53,"end":6.807,"text":"Le okan aya Rẹ.","marked":"Lé ọkàn àyà Rẹ."}],"end":6.807},{"key":"2","start":7.757,"lines":[{"start":7.757,"end":9.047,"text":"Iran 'bukun l'eyi,","marked":"Ìran bùkún l'èyí"},{"start":9.497,"end":10.762,"text":"Ko si 'boju larin;","marked":"Kò sì bójú lárin"},{"start":11.212,"end":12.343,"text":"Wọn ri Ẹn'Imọlẹ,","marked":"Wọ́n rí Ẹn'Ìmọ́lẹ̀"},{"start":12.793,"end":14.463,"text":"Ti wọn ti fẹ lati ri.","marked":"Tí wọ́n ti fẹ́ láti rí."}],"end":14.463},{"key":"3","start":15.413,"lines":[{"start":15.413,"end":16.439,"text":"Wọn bọ lọwọ ayé,","marked":"Wọ́n bọ́ lọ́wọ́ ayé"},{"start":16.889,"end":18.082,"text":"Pẹlu aniyan rẹ;","marked":"Pẹ̀lú àníyàn rẹ̀"},{"start":18.532,"end":19.505,"text":"Wọn bọ lọwọ ewu,","marked":"Wọ́n bọ́ lọ́wọ́ ewu"},{"start":19.955,"end":21.907,"text":"T'o n rin l'ọsan, l'oru.","marked":"T'ó ń rìn l'ọ̀sán, l'òru."}],"end":21.907},{"key":"4","start":22.857,"lines":[{"start":22.857,"end":23.804,"text":"Lori iboji wọn,","marked":"Lórí ibojì wọn"},{"start":24.254,"end":25.615,"text":"L'awa n sọkun loni,","marked":"L'àwa ń sọkún lónì"},{"start":26.065,"end":27.274,"text":"Wọn j'ẹn' ire fun wa,","marked":"Wọ́n j'ẹn' ìre fún wa"},{"start":27.724,"end":29.322,"text":"T'a ki y'o gbagbe lai.","marked":"T'á kí y'ó gbàgbé láì."}],"end":29.322},{"key":"5","start":30.272,"lines":[{"start":30.272,"end":31.478,"text":"A k' y'o gbohun wọn mọ,","marked":"A k y'ó gbóhùn wọn mọ́"},{"start":31.928,"end":32.862,"text":"Ohun ifẹ didun;","marked":"Ohun ìfẹ́ dídùn"},{"start":33.312,"end":35.233,"text":"Lat‘ oni lọ, ayé","marked":"Lát òní lọ, ayé"},{"start":35.683,"end":36.71,"text":"Ki o tun mọ wọn mọ.","marked":"Kí o tún mọ̀ wọ́n mọ́."}],"end":36.71},{"key":"6","start":37.66,"lines":[{"start":37.66,"end":38.73,"text":"Ẹyin oninure,","marked":"Ẹ̀yin onínúre"},{"start":39.18,"end":40.477,"text":"Ẹ fi wa silẹ lọ;","marked":"Ẹ fi wá sílẹ̀ lọ"},{"start":40.927,"end":43.068,"text":"A o sọkun yin titi,","marked":"A ó sọkún yín títí"},{"start":43.518,"end":44.868,"text":"Jesu pa sọkun ri.","marked":"Jésù pa sọkún rí."}],"end":44.868},{"key":"7","start":45.818,"lines":[{"start":45.818,"end":46.948,"text":"Sugbọn a fẹ gbohun,","marked":"Sùgbọ́n a fẹ́ gbóhùn"},{"start":47.398,"end":48.54,"text":"Olodumare na;","marked":"Olódùmarè ná"},{"start":48.99,"end":51.231,"text":"Y'o ko, y'o si wi pé,","marked":"Y'ó kọ́, y'ó sì wí pé"},{"start":51.681,"end":53.207,"text":"Ẹ dide, ẹ si yọ.","marked":"Ẹ dìde, ẹ sì yọ̀."}],"end":53.207}]}