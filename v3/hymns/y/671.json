{"v":3,"coll":"y","num":671,"id":"hymn_671","title":"EMI ko le gbagbe ojo","duration":54.4,"voices":{"male":{"file":"y-671-male-v3.m4a","bytes":385557,"sha256":"273d8f80cd13353ef782e5c3a4f50efbeed18ff2ed7b01c797e0ee9a08064654","duration":54.4},"female":{"file":"y-671-female-v3.m4a","bytes":395207,"sha256":"c1ba008b1b59de262957eb76d0567532c4492dbd2e54f13acabda1702bbb9ed7","duration":54.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.582,"text":"EMI ko le gbagbe ojo","marked":"Èmi kò lè gbàgbé ọjọ́"},{"start":2.032,"end":3.676,"text":"T'iya so fun mi jeje, pe","marked":"T'ìyá sọ fún mi jẹ́jẹ́, pé"},{"start":4.126,"end":5.51,"text":"Bi o ba d'ominira tan","marked":"Bí ó bá d'òmìnira tán"},{"start":5.96,"end":7.481,"text":"Mase gbagbe ojo iya.","marked":"Máṣe gbàgbé ọjọ́ ìyá."}],"end":7.481},{"key":"CHORUS","start":8.431,"lines":[{"start":8.431,"end":9.867,"text":"Nigbati mo rohun gbogbo","marked":"Nígbàtí mo rohùn gbogbo"},{"start":10.317,"end":11.799,"text":"lfe ti iya ni si mi","marked":"Ìfẹ́ tí ìyá ni sí mi"},{"start":12.249,"end":13.442,"text":"Oro ife ran mi leti","marked":"Ọ̀rọ̀ ìfẹ́ rán mi létí"},{"start":13.892,"end":15.762,"text":"Pe ma gbagbe ojo iya.","marked":"Pé má gbàgbé ọjọ́ ìyá."}],"end":15.762},{"key":"2","start":16.712,"lines":[{"start":16.712,"end":18.323,"text":"Emi ko le sai ma ranti","marked":"Èmi kò lè ṣàì má rántí"},{"start":18.773,"end":20.16,"text":"Gbogbo wahala iya mi","marked":"Gbogbo wàhálà ìyá mi"},{"start":20.61,"end":22.075,"text":"To ntoju mi tosan toru","marked":"Tó ńtọ́jú mi tọ̀sán tòru"},{"start":22.525,"end":23.758,"text":"Ninu ebi ninu ayo.","marked":"Nínú ebi nínú ayọ̀."}],"end":23.758},{"key":"3","start":24.708,"lines":[{"start":24.708,"end":26.07,"text":"Iya wa ni onimoran","marked":"Ìyá wa ní onímọ̀ràn"},{"start":26.52,"end":27.939,"text":"Baba wa ni oniranwo","marked":"Baba wa ní onírànwọ́"},{"start":28.389,"end":29.975,"text":"Awon ti nse bi iya wa","marked":"Àwọn tí ńṣe bí ìyá wa"},{"start":30.425,"end":31.827,"text":"Se won ko le jo iya wa.","marked":"Ṣé wọn kò lè jọ ìyá wa."}],"end":31.827},{"key":"4","start":32.777,"lines":[{"start":32.777,"end":35.057,"text":"Ngo se baba, ki jo baba","marked":"Ngó ṣe Baba, kí jọ Baba"},{"start":35.507,"end":37.52,"text":"Gba 'po de mi, ki s'onipo","marked":"Gba pọ̀ dé mi, kí s'onípọ̀"},{"start":37.97,"end":40.794,"text":"Sole de mi, ki s'onile","marked":"Ṣọlẹ̀ dè mí, kí s'onílé"},{"start":41.244,"end":42.671,"text":"Alagbata s'oja d'owon.","marked":"Alàgbàtà s'ọjá d'ọ̀wọ́n."}],"end":42.671},{"key":"5","start":43.621,"lines":[{"start":43.621,"end":45.639,"text":"Enyin iya, e o jere omo","marked":"Ẹ̀yin ìyá, ẹ ó jèrè ọmọ"},{"start":46.089,"end":48.513,"text":"Enyin baba, e o jeun omo","marked":"Ẹ̀yin Baba, ẹ ò jẹun ọmọ"},{"start":48.963,"end":50.961,"text":"Enikan ki o gba 'se nyin se","marked":"Ẹnìkan kí ó gbà ṣe yín ṣe"},{"start":51.411,"end":52.85,"text":"Li agbara Edumare.","marked":"Lí agbára Èdùmarè."}],"end":52.85}]}