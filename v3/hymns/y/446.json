{"v":3,"coll":"y","num":446,"id":"hymn_446","title":"Alafia, ni aye ese yi","duration":41.314,"voices":{"male":{"file":"y-446-male-v3.m4a","bytes":283781,"sha256":"91a8cd6b9e488972cbf4fab9be9218bb164e5d483cd1ced8bbbcd8a5ba561645","duration":41.4},"female":{"file":"y-446-female-v3.m4a","bytes":301653,"sha256":"f6d9e7781567a639442dfe1741bf5d717f8e3a144cbc028ff7131094898b14af","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.717,"text":"ALAFIA, ni ayé ese yi?","marked":"Àlàáfíà, ní ayé ẹ̀ṣẹ̀ yí?"},{"start":3.167,"end":5.736,"text":"Eje Jesu n wi pé, Alafia”","marked":"Ẹ̀jẹ̀ Jésù ń wí pé, Àlàáfíà"}],"end":5.736},{"key":"2","start":6.686,"lines":[{"start":6.686,"end":8.287,"text":"Alafia ninu opo lala?","marked":"Àlàáfíà nínú ọ̀pọ̀ làlà?"},{"start":8.737,"end":10.916,"text":"Lati se ife Jesu, ni 'sinmi.","marked":"Láti ṣe ìfẹ́ Jésù, ní sinmi."}],"end":10.916},{"key":"3","start":11.866,"lines":[{"start":11.866,"end":14.15,"text":"Alafia, n'nu igbi 'banuje?","marked":"Àlàáfíà, n'nú ìgbì banújẹ́?"},{"start":14.6,"end":16.473,"text":"L'aya Jesu ni dake roro wa.","marked":"L'àyà Jésù ni dákẹ́ rọ́rọ́ wa."}],"end":16.473},{"key":"4","start":17.423,"lines":[{"start":17.423,"end":19.437,"text":"Alafia, gb'ara wa wa l'ajo?","marked":"Àlàáfíà, gb'ara wa wà l'àjọ?"},{"start":19.887,"end":22.54,"text":"Ni 'pamo Jesu, iberu ko si.","marked":"Ní pamọ́ Jésù, ìbẹ̀rù kò sí."}],"end":22.54},{"key":"5","start":23.49,"lines":[{"start":23.49,"end":26.272,"text":"Alafia, b'a ko tile m'ola?","marked":"Àlàáfíà, b'a kò tilẹ̀ m'ọ̀la?"},{"start":26.722,"end":29.001,"text":"Sugbon a mo pe Jesu wa lailai.","marked":"Ṣùgbọ́n a mọ̀ pé Jésù wà láéláé."}],"end":29.001},{"key":"6","start":29.951,"lines":[{"start":29.951,"end":31.854,"text":"Alafia, nigb'akoko iku?","marked":"Àlàáfíà, nígb'àkókò ikú?"},{"start":32.304,"end":34.156,"text":"Olugbala wa ti segun iku?","marked":"Olùgbàlà wa ti ṣẹ́gun ikú?"}],"end":34.156},{"key":"7","start":35.106,"lines":[{"start":35.106,"end":37.285,"text":"O to: jakadi ayé fere pin","marked":"Ó tó: jákadì ayé fèrè pín"},{"start":37.735,"end":39.765,"text":"Jesu y'o pe wa s'orun alafia.","marked":"Jésù y'ó pè wá s'ọ̀run àlàáfíà."}],"end":39.765}]}