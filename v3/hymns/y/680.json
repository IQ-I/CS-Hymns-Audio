{"v":3,"coll":"y","num":680,"id":"hymn_680","title":"MASE huwa ese","duration":47.965,"voices":{"male":{"file":"y-680-male-v3.m4a","bytes":322016,"sha256":"b3bf8dee6f3a13e6f772df6575c5cb6ecec629e29a2346e17586bd991f071707","duration":48.0},"female":{"file":"y-680-female-v3.m4a","bytes":331516,"sha256":"e6e6ffc5891a75d7c6024409bd097dd4a60d97314291c291e2b4aacc8c744309","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.463,"text":"MASE huwa ẹsẹ,","marked":"Mase hùwà ẹsẹ̀"},{"start":1.913,"end":2.876,"text":"Ma sọrọ 'binu,","marked":"Má sọ̀rọ̀ bínú"},{"start":3.326,"end":4.829,"text":"Ọmọ Jesu l'ẹ n se,","marked":"Ọmọ Jésù l'ẹ́ ń ṣe"},{"start":5.279,"end":6.125,"text":"Ọmọ Oluwa.","marked":"Ọmọ Olúwa."}],"end":6.125},{"key":"2","start":7.075,"lines":[{"start":7.075,"end":8.688,"text":"Krist jẹ oninure,","marked":"Krist jẹ́ onínúre"},{"start":9.138,"end":10.004,"text":"At'Ẹni mimọ;","marked":"Àt'Ẹni mímọ́"},{"start":10.454,"end":11.41,"text":"Bẹ l'awọn ọmọ Rẹ,","marked":"Bẹ l'àwọn ọmọ Rẹ"},{"start":11.86,"end":13.029,"text":"Yẹ k'o jẹ mimọ.","marked":"Yẹ k'ó jẹ́ mímọ́."}],"end":13.029},{"key":"3","start":13.979,"lines":[{"start":13.979,"end":15.375,"text":"Ẹmi ibi kan wa,","marked":"Ẹ̀mí ibi kan wà"},{"start":15.825,"end":16.795,"text":"T'o n sọ irin rẹ;","marked":"T'ó ń sọ irin rẹ̀"},{"start":17.245,"end":18.377,"text":"O si n fẹ dan ọ wo,","marked":"Ó sì ń fẹ́ dán ọ wò"},{"start":18.827,"end":20.143,"text":"Lati se ibi.","marked":"Láti ṣe ibi."}],"end":20.143},{"key":"4","start":21.093,"lines":[{"start":21.093,"end":22.207,"text":"E mase gbo tire","marked":"Ẹ máṣe gbọ́ tirẹ̀"},{"start":22.657,"end":23.719,"text":"B'o tile soro","marked":"B'ó tilẹ̀ sọ̀rọ̀"},{"start":24.169,"end":25.338,"text":"Lati ba Esu ja","marked":"Láti bá Èṣù jà"},{"start":25.788,"end":26.89,"text":"Lati se rere.","marked":"Láti ṣe rere."}],"end":26.89},{"key":"5","start":27.84,"lines":[{"start":27.84,"end":28.899,"text":"Ẹyin ti se'leri,","marked":"Ẹ̀yin ti ṣe'lérí"},{"start":29.349,"end":29.903,"text":"Ni ọmọ ọwọ,","marked":"Ní ọmọ ọwọ́"},{"start":30.353,"end":31.563,"text":"Lati k'Esu silẹ,","marked":"Láti k'Èṣù sílẹ̀"},{"start":32.013,"end":32.867,"text":"Ati ona rẹ.","marked":"Àti ọ̀nà rẹ."}],"end":32.867},{"key":"6","start":33.817,"lines":[{"start":33.817,"end":35.24,"text":"Om'ogun Krist ni yin,","marked":"Ọm'ogun Krist ni yín"},{"start":35.69,"end":36.789,"text":"Ẹ kọ lati ba,","marked":"Ẹ kọ̀ láti bá"},{"start":37.239,"end":38.314,"text":"Ẹsẹ inu yin ja;","marked":"Ẹsẹ̀ inú yín jà"},{"start":38.764,"end":39.893,"text":"Ẹ ma se rere.","marked":"Ẹ má ṣe rere."}],"end":39.893},{"key":"7","start":40.843,"lines":[{"start":40.843,"end":42.046,"text":"Jesu l'Oluwa yin,","marked":"Jésù l'Olúwa yín"},{"start":42.496,"end":43.366,"text":"O se ẹni 're,","marked":"Ó ṣe ẹni rẹ̀"},{"start":43.816,"end":44.808,"text":"Ki ẹyin ọmọ Rẹ,","marked":"Kí ẹ̀yin ọmọ Rẹ"},{"start":45.258,"end":46.416,"text":"Si ma se rere.","marked":"Sì má ṣe rere."}],"end":46.416}]}