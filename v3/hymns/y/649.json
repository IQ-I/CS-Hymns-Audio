{"v":3,"coll":"y","num":649,"id":"hymn_649","title":"GBOGBO eni t'oungbe n gbe wa","duration":35.839,"voices":{"male":{"file":"y-649-male-v3.m4a","bytes":250516,"sha256":"9c74f09798ee67c82289d828a49d1df484a9c354a148250db2e9ec0fef8d3736","duration":35.9},"female":{"file":"y-649-female-v3.m4a","bytes":259700,"sha256":"b39d211346f169fbd8685f5d7f239e0e664b4ef9c3a56b696e4226fd0d8e1b32","duration":35.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.798,"text":"GBOGBO ẹni t'oungbẹ n gbẹ wa!","marked":"Gbogbo ẹni t'òúngbẹ ń gbẹ wá!"},{"start":2.248,"end":3.559,"text":"Ọlọrun n pe gbogb' ẹlẹsẹ;","marked":"Ọlọ́run ń pe gbogb ẹlẹ́sẹ̀"},{"start":4.009,"end":5.458,"text":"Ran anu oun 'gbala lọfẹ;","marked":"Rán àánú òun gbàlà lọ́fẹ́"},{"start":5.908,"end":7.239,"text":"Ran or'-ọfẹ ihinrere.","marked":"Rán or'-ọfẹ ìhìnrere."}],"end":7.239},{"key":"2","start":8.189,"lines":[{"start":8.189,"end":10.279,"text":"Wa s'ibi omi iye, wa!","marked":"Wá s'ibi omi ìyè, wá!"},{"start":10.729,"end":12.513,"text":"Ẹlẹsẹ, jẹ 'pe Ẹlẹda-","marked":"Ẹlẹ́sẹ̀, jẹ́ pé Ẹlẹda"},{"start":12.963,"end":15.46,"text":"Pada, asako, bọ wa 'le,","marked":"Padà, aṣáko, bọ̀ wá lé"},{"start":15.91,"end":17.582,"text":"Ọfẹ ni ore mi fun yin!","marked":"Ọ̀fẹ́ ni ọ̀rẹ́ mi fún yín!"}],"end":17.582},{"key":"3","start":18.532,"lines":[{"start":18.532,"end":20.07,"text":"Wo apata ti n sun jade!","marked":"Wo àpáta tí ń sun jáde!"},{"start":20.52,"end":21.838,"text":"Isun marale n san fun ọ,","marked":"Ìsun máralé ń sàn fún ọ"},{"start":22.288,"end":23.781,"text":"Ẹyin ti ẹru ẹsẹ n pa,","marked":"Ẹ̀yin tí ẹ̀rù ẹsẹ̀ ń pa"},{"start":24.231,"end":25.751,"text":"Ẹ wa, laimu owo lọwọ.","marked":"Ẹ wá, láìmú owó lọ́wọ́."}],"end":25.751},{"key":"4","start":26.701,"lines":[{"start":26.701,"end":28.419,"text":"Ko s'iparọ t'ẹ le mu wa,","marked":"Kò s'íparọ́ t'ẹ lè mú wá"},{"start":28.869,"end":30.277,"text":"Ẹ f'ini yin gbogbo sẹhin,","marked":"Ẹ f'ìní yín gbogbo sẹ́hìn"},{"start":30.727,"end":32.258,"text":"F'igboya gb'ẹbun Ọlọrun,","marked":"F'ígboyà gb'ẹ̀bùn Ọlọ́run"},{"start":32.708,"end":34.29,"text":"Ni idariji n'nu Jesu.","marked":"Ní ìdáríjì n'nú Jésù."}],"end":34.29}]}