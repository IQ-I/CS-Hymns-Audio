{"v":3,"coll":"y","num":90,"id":"hymn_90","title":"AWA dupe, awa t'ope da,","duration":46.81,"voices":{"male":{"file":"y-90-male-v3.m4a","bytes":321016,"sha256":"8fe64bfa81fdffffa179d593d52d7339d5ae2040487cb218e708536ca7703440","duration":46.9},"female":{"file":"y-90-female-v3.m4a","bytes":323811,"sha256":"0bec71724c9bfc414f2004d2411058c4f0468d5a64a5f01bc8e8a93b55d1b7e2","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.345,"text":"AWA dupẹ, awa t'ọpẹ da,","marked":"Àwa dúpẹ́, àwa t'ọpẹ́ dá"},{"start":2.795,"end":4.91,"text":"T'o ti pa agbara ina ileru;","marked":"T'ó ti pa agbára iná ìléru"}],"end":4.91},{"key":"CHORUS","start":5.86,"lines":[{"start":5.86,"end":7.59,"text":"Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":8.04,"end":9.572,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."}],"end":9.572},{"key":"2","start":10.522,"lines":[{"start":10.522,"end":13.658,"text":"Aje, oso at'alawirin, sanpọnna,","marked":"Ajé, ọ̀ṣọ́ àt'aláwìrìn, sanpọ́nná"},{"start":14.108,"end":15.767,"text":"Irun-Mole ti di 'temole.","marked":"Irun-mole ti di tẹ̀mọ́lẹ̀."}],"end":15.767},{"key":"3","start":16.717,"lines":[{"start":16.717,"end":18.049,"text":"Awa omo Ijọ Serafu,","marked":"Àwa ọmọ Ìjọ Séráfù"},{"start":18.499,"end":20.566,"text":"E mura ka si le te esu mole.","marked":"Ẹ múra ká sì lè tẹ èṣù mọ́lẹ̀."}],"end":20.566},{"key":"4","start":21.516,"lines":[{"start":21.516,"end":22.94,"text":"Ẹni t'o ro p'oun ti duro","marked":"Ẹni t'ó rò p'òun ti dúró"},{"start":23.39,"end":25.579,"text":"K'o sora ki o ma ba subu lule.","marked":"K'ó ṣọ́ra kí ó má bá ṣubú lulẹ̀."}],"end":25.579},{"key":"5","start":26.529,"lines":[{"start":26.529,"end":28.655,"text":"Orin Halleluyah l'a o kọ,","marked":"Orin Hallelúyà l'a ó kọ"},{"start":29.105,"end":31.35,"text":"'Gbati gbogbo idanwo ba kọja lọ.","marked":"gbàtí gbogbo ìdánwò bá kọjá lọ."}],"end":31.35},{"key":"6","start":32.3,"lines":[{"start":32.3,"end":33.808,"text":"E f'ogo fun Baba wa l'oke","marked":"Ẹ f'ògo fún Baba wa l'òkè"},{"start":34.258,"end":36.057,"text":"Ka si f'ogo f'Omo Re l'orun.","marked":"Ká sì f'ògo f'Ọmọ Rẹ̀ l'ọ̀run."}],"end":36.057},{"key":"7","start":37.007,"lines":[{"start":37.007,"end":38.457,"text":"K'a f'ogo fun Emi Mimo","marked":"K'á f'ògo fún Ẹ̀mí Mímọ́"},{"start":38.907,"end":40.733,"text":"Metalokan si l'ope ye fun.","marked":"Mẹ́talọ́kan sì l'ọpẹ́ yẹ fún."}],"end":40.733},{"key":"8","start":41.683,"lines":[{"start":41.683,"end":43.347,"text":"Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":43.797,"end":45.261,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."}],"end":45.261}]}