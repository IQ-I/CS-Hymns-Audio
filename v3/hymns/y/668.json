{"v":3,"coll":"y","num":668,"id":"hymn_668","title":"B'OKIKI ija tile nkan","duration":46.314,"voices":{"male":{"file":"y-668-male-v3.m4a","bytes":316727,"sha256":"c8f037b9db6979370e374bb06afa11cc764b98f853340c268b520f6f87e58d33","duration":46.4},"female":{"file":"y-668-female-v3.m4a","bytes":333860,"sha256":"be1feef248c203a8a90ead815f528bc144c0c4267b50362a377dc6ae599a78cf","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.784,"text":"B'OKIKI ija tile nkan","marked":"B'Òkìkí ìjà tilẹ̀ nǹkan"},{"start":2.234,"end":3.594,"text":"T'ariwo gb'ode kan","marked":"T'ariwo gb'òde kan"},{"start":4.044,"end":5.433,"text":"K'irepo wa n'ile dara","marked":"K'ìrẹpọ̀ wá n'ilẹ̀ dára"},{"start":5.883,"end":6.932,"text":"Omo Iya ki ja.","marked":"Ọmọ Ìyá kí jà."}],"end":6.932},{"key":"2","start":7.882,"lines":[{"start":7.882,"end":9.134,"text":"Awọn ẹyẹ n'nu itẹ wọn,","marked":"Àwọn ẹyẹ n'nú ìtẹ́ wọn"},{"start":9.584,"end":10.892,"text":"Ki ba ara wọn ja,","marked":"Kí bá ara wọn jà"},{"start":11.342,"end":12.544,"text":"Ohun itiju nla ha kọ,","marked":"Ohun ìtìjú ńlá ha kọ"},{"start":12.994,"end":14.234,"text":"K'ọmọ-'ya ka rẹpọ.","marked":"K'ọmọ-'ya ká rẹ́pọ̀."}],"end":14.234},{"key":"3","start":15.184,"lines":[{"start":15.184,"end":16.956,"text":"Ihale-ako-apara","marked":"Ihale-ako-apara"},{"start":17.406,"end":18.507,"text":"Fari lasan lasan","marked":"Fari lásán lásán"},{"start":18.957,"end":20.994,"text":"Kumo ni da, a fa da yo","marked":"Kùmọ̀ ni dá, a fà dá yọ"},{"start":21.444,"end":22.315,"text":"A si bi 'ku l'omo.","marked":"A sì bí kú l'ọmọ."}],"end":22.315},{"key":"4","start":23.265,"lines":[{"start":23.265,"end":24.722,"text":"Ise bilisi n'ibinu,","marked":"Iṣẹ́ bilisi n'ìbínú"},{"start":25.172,"end":26.069,"text":"Larin ọmọ iya,","marked":"Lárin ọmọ ìyá"},{"start":26.519,"end":28.077,"text":"Ibinu ni Kaini fi lu,","marked":"Ìbínú ni Kaini fi lu"},{"start":28.527,"end":29.638,"text":"Arakunrin rẹ pa.","marked":"Arákùnrin rẹ̀ pa."}],"end":29.638},{"key":"5","start":30.588,"lines":[{"start":30.588,"end":31.818,"text":"Ibinu ologbon ki pe","marked":"Ìbínú ọlọ́gbọ́n kí pé"},{"start":32.268,"end":33.432,"text":"A tan k'orun to wo","marked":"A tan k'ọ̀run tó wó"},{"start":33.882,"end":35.349,"text":"Sugbon t'asiwere a wa","marked":"Ṣùgbọ́n t'aṣiwèrè a wà"},{"start":35.799,"end":37.026,"text":"Titi d'ojo ale.","marked":"Títí d'ọjọ́ alẹ́."}],"end":37.026},{"key":"6","start":37.976,"lines":[{"start":37.976,"end":39.305,"text":"Fi ese inu-bibi wa","marked":"Fi ẹsẹ̀ inu-bibi wa"},{"start":39.755,"end":41.228,"text":"Ji wa, Oluwa wa","marked":"Jí wá, Olúwa wa"},{"start":41.678,"end":42.982,"text":"Ka f'ibinu ewe sile","marked":"Ká f'ìbínú èwe sílẹ̀"},{"start":43.432,"end":44.765,"text":"Ka si dagba n'ife.","marked":"Ká sì dàgbà n'ìfẹ́."}],"end":44.765}]}