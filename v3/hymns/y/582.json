{"v":3,"coll":"y","num":582,"id":"hymn_582","title":"ORO Alafia","duration":45.754,"voices":{"male":{"file":"y-582-male-v3.m4a","bytes":310803,"sha256":"a4e0bb15c047ea7fa2b011b3452b0377b84bb06c3206d091ccd2ed370f231f37","duration":45.8},"female":{"file":"y-582-female-v3.m4a","bytes":320800,"sha256":"011d3a89adbb9fc11b147d480cdf5bc2bcd66790ee7e1d5834aee50499f7cf5b","duration":45.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.213,"text":"ỌRỌ Alafia,","marked":"Ọ̀rọ̀ Àlàáfíà"},{"start":1.663,"end":2.803,"text":"La fi sin yin ara,","marked":"La fi sin yín ara"},{"start":3.253,"end":4.989,"text":"K'alafia bi odo nla,","marked":"K'àlàáfíà bí odò ńlá"},{"start":5.439,"end":6.453,"text":"Ma ba yin gbe.","marked":"Má bá yín gbé."}],"end":6.453},{"key":"2","start":7.403,"lines":[{"start":7.403,"end":8.803,"text":"N'nu ọrọ adura,","marked":"N'nú ọ̀rọ̀ àdúrà"},{"start":9.253,"end":10.434,"text":"A f'awọn ara wa,","marked":"A f'àwọn ará wa"},{"start":10.884,"end":12.354,"text":"Ni isọ Oluwa lọwọ,","marked":"Ní ìsọ Olúwa lọ́wọ́"},{"start":12.804,"end":13.742,"text":"Ọrẹ totọ","marked":"Ọrẹ tòtọ́"}],"end":13.742},{"key":"3","start":14.692,"lines":[{"start":14.692,"end":15.507,"text":"Oro ife didun","marked":"Ọ̀rọ̀ ìfẹ́ dídùn"},{"start":15.957,"end":17.091,"text":"L'a fi p'odigbose","marked":"L'á fi p'òdìgbòṣe"},{"start":17.541,"end":19.38,"text":"Ife wa ati t'Olorun","marked":"Ìfẹ́ wa àti t'Ọlọ́run"},{"start":19.83,"end":21.022,"text":"Y'o ba won gbe.","marked":"Y'ó bá wọn gbé."}],"end":21.022},{"key":"4","start":21.972,"lines":[{"start":21.972,"end":23.062,"text":"Oro'gbagbo lile","marked":"Ọ̀rọ̀'gbàgbọ́ líle"},{"start":23.512,"end":24.523,"text":"Ni igbekele wa","marked":"Ní ìgbẹ́kẹ̀lé wa"},{"start":24.973,"end":26.98,"text":"Pe, Oluwa y'o se ranwo","marked":"Pé, Olúwa y'ó ṣe rànwọ́"},{"start":27.43,"end":28.396,"text":"Nigba gbogbo.","marked":"Nígbà gbogbo."}],"end":28.396},{"key":"5","start":29.346,"lines":[{"start":29.346,"end":30.285,"text":"Ọrọ 'reti didun,","marked":"Ọ̀rọ̀ retí dídùn"},{"start":30.735,"end":32.19,"text":"Y'o mu Ipinya wa dun,","marked":"Y'ó mú Ìpínyà wá dùn"},{"start":32.64,"end":34.12,"text":"Y'o sọ ayọ t'o le dun ju,","marked":"Y'ó sọ ayọ̀ t'ó lè dùn jù"},{"start":34.57,"end":35.478,"text":"Ayọ t'ayé.","marked":"Ayọ̀ t'ayé."}],"end":35.478},{"key":"6","start":36.428,"lines":[{"start":36.428,"end":38.132,"text":"Odigbose, ara,","marked":"Odigboṣẹ́, ara"},{"start":38.582,"end":40.0,"text":"N'ifẹ at' igbagbọ,","marked":"N'ìfẹ́ àt ìgbàgbọ́"},{"start":40.45,"end":42.666,"text":"Tit'a o fi tun pade loke,","marked":"Tít'à ó fi tún pàdé lókè"},{"start":43.116,"end":44.205,"text":"N'ile wa ọrun.","marked":"N'ilẹ̀ wá ọ̀run."}],"end":44.205}]}