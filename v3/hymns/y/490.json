{"v":3,"coll":"y","num":490,"id":"hymn_490","title":"WO orisun Ohun rere","duration":41.036,"voices":{"male":{"file":"y-490-male-v3.m4a","bytes":274977,"sha256":"903bd6f93210c6649cd20a77c6ac4f651c5830c5c48a6f992b305289460a6f3d","duration":41.1},"female":{"file":"y-490-female-v3.m4a","bytes":288458,"sha256":"8c7576c5afe7dda20ed2dbadf75ae55030e8f58eb57da83917986af806f409d8","duration":41.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.697,"text":"'WỌ orisun ohun rere,","marked":"'Wọ orísun ohun rere"},{"start":2.147,"end":3.305,"text":"Awa fẹ se'fẹ rẹ;","marked":"Àwa fẹ́ sè'fẹ́ rẹ̀"},{"start":3.755,"end":5.191,"text":"Ohun wo l'a le fifun Ọ","marked":"Ohun wo l'a lè fífún Ọ"},{"start":5.641,"end":6.614,"text":"Ọba gbogbo ayé?","marked":"Ọba gbogbo ayé?"}],"end":6.614},{"key":"2","start":7.564,"lines":[{"start":7.564,"end":9.935,"text":"L'ayé yi, 'Wọ ni otosi,","marked":"L'ayé yí, 'Wọ ni òtòṣì"},{"start":10.385,"end":11.472,"text":"T'o jẹ eniyan Rẹ;","marked":"T'ó jẹ́ ènìyàn Rẹ"},{"start":11.922,"end":13.284,"text":"Orukọ wọn n'Iwọ n jẹwọ,","marked":"Orúkọ wọn n'Ìwọ ń jẹ́wọ́"},{"start":13.734,"end":14.917,"text":"Niwaju Baba Rẹ.","marked":"Níwájú Baba Rẹ."}],"end":14.917},{"key":"3","start":15.867,"lines":[{"start":15.867,"end":17.323,"text":"'Gba wọn ba n ke n'inira wọn,","marked":"gbà wọ́n bá ń ké n'ìnira wọn"},{"start":17.773,"end":18.755,"text":"Ohun Rẹ l'awa n gbọ;","marked":"Ohun Rẹ l'àwa ń gbọ́"},{"start":19.205,"end":20.687,"text":"'Gba ba si n se itọju wọn,","marked":"gbà bá sì ń ṣe ìtọ́jú wọn"},{"start":21.137,"end":22.497,"text":"Awa n se 'tọju Rẹ.","marked":"Àwa ń ṣe 'tọju Rẹ̀."}],"end":22.497},{"key":"4","start":23.447,"lines":[{"start":23.447,"end":25.68,"text":"Jesu, ma sai gba ọrẹ wa,","marked":"Jésù, má ṣàì gba ọrẹ wa"},{"start":26.13,"end":27.495,"text":"Si f'ibukun Rẹ si;","marked":"Sì f'ìbùkún Rẹ̀ sí"},{"start":27.945,"end":29.337,"text":"Ma f'ibukun Rẹ s'ẹbun wa","marked":"Má f'ìbùkún Rẹ s'ẹ́bùn wá"},{"start":29.787,"end":31.228,"text":"Fun awọn t'a n fi fun.","marked":"Fún àwọn t'á ń fi fún."}],"end":31.228},{"key":"5","start":32.178,"lines":[{"start":32.178,"end":34.241,"text":"Fun Baba, Ọmọ at'Ẹmi,","marked":"Fún Baba, Ọmọ àt'Ẹ̀mi"},{"start":34.691,"end":35.783,"text":"Ọlọrun ti a n sin;","marked":"Ọlọ́run tí à ń sìn"},{"start":36.233,"end":37.944,"text":"f Ni ki a ma fi ogo fun,","marked":"f Ni kí a má fi ògo fún"},{"start":38.394,"end":39.486,"text":"Titi ayérayé.","marked":"Títí ayérayé."}],"end":39.486}]}