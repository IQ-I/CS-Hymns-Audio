{"v":3,"coll":"y","num":785,"id":"hymn_785","title":"lYlN f'Eni Mimo julo","duration":57.354,"voices":{"male":{"file":"y-785-male.m4a","bytes":407964,"sha256":"cd919d3867665bce82e3a909cfcf2489895f56b49e20ea42da479bc0f9110dea","duration":57.4},"female":{"file":"y-785-female.m4a","bytes":421809,"sha256":"e029806375d0b314e2cbd19aed622d6deb2bf56baa24824d9acdb9f469a0f674","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.038,"text":"lYlN f'Eni Mimo julo","marked":"lYlN f'Ẹni Mímọ́́ jùlọ"},{"start":2.418,"end":3.84,"text":"Loke ati n'ile","marked":"Lókè àti ń'ílé"},{"start":4.22,"end":5.417,"text":"Oro Re gbogbo je 'yanu","marked":"Ọ̀rọ̀ Rẹ gbogbo jẹ́ 'yanu"},{"start":5.797,"end":7.373,"text":"Gbogb' ona Re daju.","marked":"Gbogb' ọ̀nà Rẹ dájú."}],"end":7.373},{"key":"2","start":8.323,"lines":[{"start":8.323,"end":9.86,"text":"Ogbon Olorun ti po to!","marked":"Ọgbọ́n Ọlọ́run ti pọ̀ tó!"},{"start":10.24,"end":11.462,"text":"'Gbat'enia subu","marked":"'Gbat'enia ṣubú"},{"start":11.842,"end":13.502,"text":"Adam keji wa s'oju ja","marked":"Ádám kejì wá ṣ'ojú jà"},{"start":13.882,"end":15.077,"text":"Ati lati gbala.","marked":"Àti láti gbalá."}],"end":15.077},{"key":"3","start":16.027,"lines":[{"start":16.027,"end":18.322,"text":"Ogbon ife! p'eran ara","marked":"Ọgbọ́n ìfẹ́! p'ẹran ara"},{"start":18.702,"end":20.276,"text":"T'o gbe Adam subu","marked":"T'ó gbé Ádám ṣubú"},{"start":20.656,"end":22.338,"text":"Tun b'ota ja ija otun","marked":"Tún b'ọ̀tá ja ìjà ọ̀tún"},{"start":22.718,"end":24.071,"text":"K'o ja k'o si segun.","marked":"K'ó já k'ó sì ṣẹ́gun."}],"end":24.071},{"key":"4","start":25.021,"lines":[{"start":25.021,"end":26.941,"text":"Ati p'ebun t'o f'or-ofe","marked":"Àti p'ẹ̀bùn t'ó f'or-ọ̀fẹ́"},{"start":27.321,"end":28.746,"text":"So ara di otun","marked":"Sọ ara di ọ̀tún"},{"start":29.126,"end":30.239,"text":"Olorun papa Tikare","marked":"Ọlọ́run pápá Tìkàrẹ̀"},{"start":30.619,"end":31.682,"text":"J'Olorun ninu wa.","marked":"J'Ọlọ́run nínú wa."}],"end":31.682},{"key":"5","start":32.632,"lines":[{"start":32.632,"end":34.579,"text":"Ife 'yanu! ti Eniti","marked":"Ìfẹ́ 'yanu! ti Eniti"},{"start":34.959,"end":36.328,"text":"O pa ota enia","marked":"Ó pa ọ̀tá enia"},{"start":36.708,"end":38.534,"text":"Ninu awo awa enia","marked":"Nínú àwọ̀ àwa enia"},{"start":38.914,"end":40.312,"text":"Je irora f'enia.","marked":"Jẹ ìrora f'enia."}],"end":40.312},{"key":"6","start":41.262,"lines":[{"start":41.262,"end":42.86,"text":"Nikoko ninu ogba ni","marked":"Nikoko nínú ọgbà ni"},{"start":43.24,"end":44.489,"text":"Ati l'ori igi","marked":"Àti l'orí igi"},{"start":44.869,"end":46.519,"text":"T'o si ko wa lati jiya","marked":"T'ó sì kọ́ wa láti jìyà"},{"start":46.899,"end":48.391,"text":"To ko wa lati ku.","marked":"Tó kọ́ wa láti kú."}],"end":48.391},{"key":"7","start":49.341,"lines":[{"start":49.341,"end":50.706,"text":"Iyin f'Eni Mimo julo","marked":"Ìyìn f'Ẹni Mímọ́́ jùlọ"},{"start":51.086,"end":52.444,"text":"L'oke ati n'ife","marked":"L'òkè àti n'ife"},{"start":52.824,"end":54.13,"text":"Oro Re gbogbo je 'yanu","marked":"Ọ̀rọ̀ Rẹ gbogbo jẹ́ 'yanu"},{"start":54.51,"end":55.804,"text":"Gbogb' ona Re daju.","marked":"Gbogb' ọ̀nà Rẹ dájú."}],"end":55.804}]}