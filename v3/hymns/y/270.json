{"v":3,"coll":"y","num":270,"id":"hymn_270","title":"JESU Oluf'okan mi","duration":62.596,"voices":{"male":{"file":"y-270-male-v3.m4a","bytes":445281,"sha256":"6da581cca839088f285082874463b02a5ac30d6b08fe6b15214b878b28726955","duration":62.6},"female":{"file":"y-270-female-v3.m4a","bytes":466011,"sha256":"8a2c4ffd1b1c9d569cf0683c9443728fd00ce619a5766f0bc8c5321369b2c5cd","duration":62.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.465,"text":"JESU Oluf' ọkan mi,","marked":"Jésù Olúf ọkàn mi"},{"start":1.915,"end":3.382,"text":"Jẹ ki n sala s'aya Rẹ,","marked":"Jẹ́ kí n sálà s'àyà Rẹ"},{"start":3.832,"end":5.046,"text":"Sa t'irumi sunmọ mi,","marked":"Sá t'ìrumi súnmọ́ mi"},{"start":5.496,"end":7.097,"text":"Sa ti iji n fẹ s'oke;","marked":"Sá ti ìjì ń fẹ́ s'òkè"},{"start":7.547,"end":9.167,"text":"Pa mi mọ, Olugbala,","marked":"Pa mí mọ́, Olùgbàlà"},{"start":9.617,"end":11.27,"text":"Tit' iji aye y'o pin,","marked":"Tít ìjì ayé y'ó pín"},{"start":11.72,"end":12.943,"text":"Tọ mi lọ s'ebute Rẹ,","marked":"Tọ̀ mi lọ s'èbúté Rẹ"},{"start":13.393,"end":14.555,"text":"Nikẹhin gba ọkan mi.","marked":"Níkẹ̀hìn gba ọkàn mi."}],"end":14.555},{"key":"2","start":15.505,"lines":[{"start":15.505,"end":17.164,"text":"Abo mi, emi ko ni,","marked":"Abo mi, èmi kò ní"},{"start":17.614,"end":18.905,"text":"Iwọ lọkan mi rọ mọ;","marked":"Ìwọ lọ́kàn mi rọ̀ mọ́"},{"start":19.355,"end":20.805,"text":"Ma f'emi nikan silẹ,","marked":"Má f'èmi nìkan sílẹ̀"},{"start":21.255,"end":23.005,"text":"Gba mi, si tu mi ninu;","marked":"Gbà mí, sì tù mí nínú"},{"start":23.455,"end":24.807,"text":"Iwọ ni mo gbẹkẹle,","marked":"Ìwọ ni mo gbẹ́kẹ̀lé"},{"start":25.257,"end":26.277,"text":"Iwọ n'iranlọwọ mi;","marked":"Ìwọ n'ìrànlọ́wọ́ mi"},{"start":26.727,"end":28.054,"text":"Masai f'iyẹ apa Rẹ,","marked":"Masai f'ìyẹ́ apá Rẹ̀"},{"start":28.504,"end":30.255,"text":"D'abo b'ori aibo mi.","marked":"D'abo b'orí àìbò mi."}],"end":30.255},{"key":"3","start":31.205,"lines":[{"start":31.205,"end":32.92,"text":"Krist 'Wọ nikan ni mo fẹ,","marked":"Krist 'Wọ nìkan ni mo fẹ́"},{"start":33.37,"end":35.139,"text":"N'nu Rẹ, mo r'ohun gbogbo;","marked":"N'nú Rẹ̀, mo r'ohun gbogbo"},{"start":35.589,"end":37.016,"text":"Gb' ẹni t'o subu dide,","marked":"Gb ẹni t'ó ṣubú dìde"},{"start":37.466,"end":39.736,"text":"W'alaisan, at'afọju;","marked":"W'aláìsàn, àt'afọ́jú"},{"start":40.186,"end":41.369,"text":"Ododo l'oruko Rẹ,","marked":"Òdodo l'orúkọ Rẹ"},{"start":41.819,"end":42.941,"text":"Alaisododo l'emi,","marked":"Aláìṣòdodo l'èmi"},{"start":43.391,"end":44.843,"text":"Mo kun fun ẹsẹ pupọ,","marked":"Mo kún fún ẹsẹ̀ púpọ̀"},{"start":45.293,"end":46.734,"text":"Iwọ kun fun ododo.","marked":"Ìwọ kún fún òdodo."}],"end":46.734},{"key":"4","start":47.684,"lines":[{"start":47.684,"end":48.805,"text":"'Wọ l'ọpọ ore-ọfẹ,","marked":"'Wọ l'ọ̀pọ̀ ore-ọfẹ"},{"start":49.255,"end":50.493,"text":"Lati fi bor' ẹsẹ mi,","marked":"Láti fi bọ́r ẹsẹ̀ mi"},{"start":50.943,"end":52.099,"text":"Jẹ ki omi iwosan,","marked":"Jẹ́ kí omi ìwòsàn"},{"start":52.549,"end":53.77,"text":"Wẹ inu ọkan mi mọ;","marked":"Wẹ inú ọkàn mi mọ́"},{"start":54.22,"end":55.293,"text":"Iwọ l'orisun iye,","marked":"Ìwọ l'orísun iye"},{"start":55.743,"end":57.502,"text":"Jẹ ki n bu n'nu Rẹ l'ọfẹ;","marked":"Jẹ́ kí n bu n'nù Rẹ̀ l'ọ̀fẹ́"},{"start":57.952,"end":59.229,"text":"Ru jade n'nu ọkan mi,","marked":"Rú jáde n'nú ọkàn mi"},{"start":59.679,"end":61.047,"text":"Si iye ainipẹkun.","marked":"Sí ìyè àìnípẹ̀kun."}],"end":61.047}]}