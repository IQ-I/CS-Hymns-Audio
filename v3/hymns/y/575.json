{"v":3,"coll":"y","num":575,"id":"hymn_575","title":"DURO, Duro fun Jesu","duration":61.883,"voices":{"male":{"file":"y-575-male-v3.m4a","bytes":441026,"sha256":"c5fbada7499e2307025ef459b0e0c7eba11b2d37cf368de9d9a9c75a4ed33925","duration":61.9},"female":{"file":"y-575-female-v3.m4a","bytes":460657,"sha256":"de59af64eb8d5df225ad759c803d853ff42077350d099ca910f0e147abb4fbb7","duration":61.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.591,"text":"DURO, Duro fun Jesu,","marked":"Dúró, Dúró fún Jésù"},{"start":2.041,"end":3.359,"text":"Ẹyin ọm' ogun Kristi:","marked":"Ẹ̀yin ọm' ogun Kristi"},{"start":3.809,"end":5.136,"text":"Gbe asia Re soke,","marked":"Gbé àsíá Rẹ sókè"},{"start":5.586,"end":6.775,"text":"A ko gbọdọ fẹ ku;","marked":"A kò gbọdọ̀ fẹ́ kú"},{"start":7.225,"end":8.656,"text":"Lat' isẹgun de sẹgun,","marked":"Lát ìsẹ́gun dé sẹ́gun"},{"start":9.106,"end":10.149,"text":"Ni y'o tọ ogun Rẹ;","marked":"Ní y'ó tọ ogun Rẹ̀"},{"start":10.599,"end":12.338,"text":"Tit'a o sẹgun gbogb' ọta,","marked":"Tít'à ó sẹ́gun gbogb ọ̀tá"},{"start":12.788,"end":14.284,"text":"Ti Krist' y'o j'Oluwa.","marked":"Ti Krist y'ó j'Olúwa."}],"end":14.284},{"key":"2","start":15.234,"lines":[{"start":15.234,"end":16.728,"text":"Duro, duro fun Jesu;","marked":"Dúró, dúró fún Jésù"},{"start":17.178,"end":18.54,"text":"F'eti s'ohun ipe,","marked":"F'etí s'ohun ìpè"},{"start":18.99,"end":20.042,"text":"Jade lọ s'oju 'ja,","marked":"Jáde lọ s'ojú jà"},{"start":20.492,"end":21.657,"text":"L'oni ọjọ nla Rẹ;","marked":"L'óní ọjọ́ ńlá Rẹ"},{"start":22.107,"end":23.539,"text":"Ẹyin akin ti n ja fun,","marked":"Ẹ̀yin akin tí ń jà fún"},{"start":23.989,"end":25.195,"text":"Larin ainiye ọta ,","marked":"Lárin àìníye ọ̀tá"},{"start":25.645,"end":27.45,"text":"N'nu ewu, ẹ ni 'gboya;","marked":"N'nú ewu, ẹ ní gbóyá"},{"start":27.9,"end":29.218,"text":"Ẹ kọju 'ja s'ọta.","marked":"Ẹ kọjú jà s'ọ̀tá."}],"end":29.218},{"key":"3","start":30.168,"lines":[{"start":30.168,"end":31.449,"text":"Duro, duro fun Jesu;","marked":"Dúró, dúró fún Jésù"},{"start":31.899,"end":32.922,"text":"Duro l'agbara Rẹ,","marked":"Dúró l'agbára Rẹ"},{"start":33.372,"end":34.702,"text":"Ipa eniyan ko to,","marked":"Ipa ènìyàn kò tó"},{"start":35.152,"end":36.255,"text":"Ma gbẹkẹle tirẹ;","marked":"Má gbẹ́kẹ̀lé tirẹ̀"},{"start":36.705,"end":38.059,"text":"Di 'hamọra 'hinrere,","marked":"Di 'hamọra hínrere"},{"start":38.509,"end":40.377,"text":"Ma sọna, ma gbadura,","marked":"Má sọ́nà, má gbàdúrà"},{"start":40.827,"end":42.814,"text":"B'isẹ tab' ewu ba pe,","marked":"B'ìsẹ tàb ewu bá pé"},{"start":43.264,"end":44.85,"text":"Mase alai de 'bẹ.","marked":"Maṣe aláì dé 'bẹ."}],"end":44.85},{"key":"4","start":45.8,"lines":[{"start":45.8,"end":47.101,"text":"Duro, duro fun Jesu,","marked":"Dúró, dúró fún Jésù"},{"start":47.551,"end":49.357,"text":"di Ija naa ki y'o pẹ;","marked":"di Ìjà náà kí y'ó pẹ́"},{"start":49.807,"end":51.025,"text":"Oni, ariwo ogun;","marked":"Òní, ariwo ogun"},{"start":51.475,"end":53.179,"text":"Ọla, orin 'sẹgun,","marked":"Ọlá, orin 'sẹgun"},{"start":53.629,"end":54.912,"text":"Ẹni to ba si sẹgun","marked":"Ẹni tó bá sì sẹ́gun"},{"start":55.362,"end":56.658,"text":"Y'o gba ade iye:","marked":"Y'ó gba adé ìyè"},{"start":57.108,"end":58.623,"text":"Y'o ma ba Ọba Ogo.","marked":"Y'ó má bá Ọba Ògo."},{"start":59.073,"end":60.334,"text":"Jọba titi lailai.","marked":"Jọba títí láéláé."}],"end":60.334}]}