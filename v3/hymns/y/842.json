{"v":3,"coll":"y","num":842,"id":"hymn_842","title":"OJO oni lo tan","duration":54.511,"voices":{"male":{"file":"y-842-male-v3.m4a","bytes":357008,"sha256":"26fadc290b6356233fb6673ff261cf9db3cf0d0a891497e4303ea7b25d4a6277","duration":54.6},"female":{"file":"y-842-female-v3.m4a","bytes":379906,"sha256":"d86dff717033698c9e6a0002f14771d4406de9de5f08986b7d2ec4d65d42096d","duration":54.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.312,"text":"OJO oni lo tan","marked":"Ọjọ́ òní ló tán"},{"start":1.762,"end":2.838,"text":"Oru sunmole","marked":"Òru súnmọ́lẹ̀"},{"start":3.288,"end":4.516,"text":"Okunkun si de tan","marked":"Òkùnkùn sì dé tán"},{"start":4.966,"end":6.253,"text":"Ile si ti su.","marked":"Ilẹ̀ sì ti ṣú."}],"end":6.253},{"key":"2","start":7.203,"lines":[{"start":7.203,"end":8.178,"text":"Okunkun bo ilẹ,","marked":"Òkùnkùn bo ilẹ̀"},{"start":8.628,"end":9.243,"text":"Awọn 'rawọn yọ,","marked":"Àwọn 'rawọn yọ"},{"start":9.693,"end":11.374,"text":"Ẹranko at' ẹyẹ,","marked":"Ẹranko àt ẹyẹ"},{"start":11.824,"end":13.063,"text":"Lọ si 'busun wọn.","marked":"Lọ sí bùsùn wọn."}],"end":13.063},{"key":"3","start":14.013,"lines":[{"start":14.013,"end":15.288,"text":"Jesu, f'orun didun,","marked":"Jésù, f'ọ̀run dídùn"},{"start":15.738,"end":16.633,"text":"F'ẹni alarẹ,","marked":"F'ẹni alárẹ"},{"start":17.083,"end":18.103,"text":"Jẹ ki ibukun Rẹ,","marked":"Jẹ́ kí ìbùkún Rẹ"},{"start":18.553,"end":19.497,"text":"Pa oju mi de","marked":"Pa ojú mi dé"}],"end":19.497},{"key":"4","start":20.447,"lines":[{"start":20.447,"end":21.693,"text":"Jẹ k'ọmọ kekere,","marked":"Jẹ́ k'ọmọ kékeré"},{"start":22.143,"end":23.124,"text":"La ala rere;","marked":"La àlá rere"},{"start":23.574,"end":25.019,"text":"S'ọlọkọ t'ewu n wu,","marked":"S'ọlọ́kọ t'ewu ń wù"},{"start":25.469,"end":26.342,"text":"Ni oju omi.","marked":"Ní ojú omi."}],"end":26.342},{"key":"5","start":27.292,"lines":[{"start":27.292,"end":28.38,"text":"Ma tọju alaisan,","marked":"Má tọ́jú aláìsàn"},{"start":28.83,"end":29.838,"text":"Ti ko r'orun sun;","marked":"Tí kò r'ọ̀run sùn"},{"start":30.288,"end":31.375,"text":"Awọn ti n ro ibi;","marked":"Àwọn tí ń rọ ibi"},{"start":31.825,"end":33.017,"text":"Jọ da wọn l'ẹkun.","marked":"Jọ dá wọn l'ẹkún."}],"end":33.017},{"key":"6","start":33.967,"lines":[{"start":33.967,"end":34.811,"text":"Ninu gbogbo oru,","marked":"Nínú gbogbo òru"},{"start":35.261,"end":36.243,"text":"Jẹ k'Angeli Rẹ,","marked":"Jẹ́ k'Áńgẹ́lì Rẹ"},{"start":36.693,"end":37.706,"text":"Mase olusọ mi,","marked":"Máṣe olùsọ́ mi"},{"start":38.156,"end":39.203,"text":"L'ori ẹni mi.","marked":"L'orí ẹni mi."}],"end":39.203},{"key":"7","start":40.153,"lines":[{"start":40.153,"end":41.253,"text":"'Gba t'ilẹ ba si mọ,","marked":"gbà t'ilẹ̀ bá sì mọ́"},{"start":41.703,"end":42.658,"text":"Jẹ k'emi dide;","marked":"Jẹ́ k'èmi dìde"},{"start":43.108,"end":44.471,"text":"B'ọmọ ti ko l'ẹsẹ,","marked":"B'ọmọ tí kò l'ẹsẹ̀"},{"start":44.921,"end":45.895,"text":"Ni iwaju Rẹ.","marked":"Ní iwájú Rẹ."}],"end":45.895},{"key":"8","start":46.845,"lines":[{"start":46.845,"end":47.844,"text":"Ogo ni fun Baba,","marked":"Ògo ni fún Baba"},{"start":48.294,"end":49.321,"text":"Ati fun Ọmọ,","marked":"Àti fún Ọmọ"},{"start":49.771,"end":50.964,"text":"Ati f'Ẹmi Mimọ ,","marked":"Àti f'Ẹ̀mí Mímọ́"},{"start":51.414,"end":52.962,"text":"Lai ati lailai.","marked":"Láì àti láéláé."}],"end":52.962}]}