{"v":3,"coll":"y","num":41,"id":"hymn_41","title":"EMI Olorun alaye","duration":43.565,"voices":{"male":{"file":"y-41-male-v3.m4a","bytes":306378,"sha256":"acee6d62999ef28ba24f075f8c8d052d4da46233ab11766ac8c9b82127b4f525","duration":43.6},"female":{"file":"y-41-female-v3.m4a","bytes":315252,"sha256":"52fd115c42e3fabf8a8b500615c33c5f3df32af75aec6568373aab2778a9917f","duration":43.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.463,"text":"ẸMI Ọlọrun alaye,","marked":"Ẹ̀mí Ọlọ́run àlàyé"},{"start":1.913,"end":3.435,"text":"N'nu ẹkun ore-ọfẹ Rẹ,","marked":"N'nú ẹkún ore-ọfẹ Rẹ"},{"start":3.885,"end":5.427,"text":"Nibi t'ẹsẹ eniyan ti tẹ,","marked":"Níbi t'ẹsẹ̀ ènìyàn ti tẹ́"},{"start":5.877,"end":7.592,"text":"Sọkalẹ sori iran wa.","marked":"Sọ̀kalẹ̀ sórí ìran wa."}],"end":7.592},{"key":"2","start":8.542,"lines":[{"start":8.542,"end":10.614,"text":"F'ẹbun ahọn, ọkan ifẹ,","marked":"F'ẹ̀bùn ahọ́n, ọkàn ìfẹ́"},{"start":11.064,"end":12.432,"text":"Fun wa lati sọrọ 'fẹ Rẹ,","marked":"Fún wa láti sọ̀rọ̀ 'fẹ Rẹ"},{"start":12.882,"end":14.348,"text":"K'ibukun at'agbara Rẹ,","marked":"K'ìbùkún àt'agbára Rẹ̀"},{"start":14.798,"end":16.791,"text":"Ba l'awọn t'o n gbọ ọrọ naa.","marked":"Bá l'àwọn t'ó ń gbọ́ ọ̀rọ̀ náà."}],"end":16.791},{"key":"3","start":17.741,"lines":[{"start":17.741,"end":19.135,"text":"K'ookun kasẹ ni bibọ Rẹ;","marked":"K'òókùn kásẹ̀ ni bíbọ̀ Rẹ"},{"start":19.585,"end":21.131,"text":"Ki darudapọ di tito;","marked":"Kí dàrúdàpọ̀ di títọ́"},{"start":21.581,"end":23.172,"text":"F'ilera f'ọkan ailera;","marked":"F'ìlera f'ọkàn àìlera"},{"start":23.622,"end":24.939,"text":"Jẹ ki aanu bori ibinu.","marked":"Jẹ́ kí àánú borí ìbínú."}],"end":24.939},{"key":"4","start":25.889,"lines":[{"start":25.889,"end":27.672,"text":"Ẹmi Ọlọrun, jọ pese","marked":"Ẹ̀mí Ọlọ́run, jọ pèsè"},{"start":28.122,"end":29.428,"text":"Gbogbo ayé fun Oluwa;","marked":"Gbogbo ayé fún Olúwa"},{"start":29.878,"end":31.271,"text":"Mi si wọn b'afẹfẹ oorọ,","marked":"Mi sì wọn b'afẹ́fẹ́ oorọ"},{"start":31.721,"end":33.095,"text":"K'ọkan okuta le sọji.","marked":"K'ọkàn òkúta lè sọjí."}],"end":33.095},{"key":"5","start":34.045,"lines":[{"start":34.045,"end":35.468,"text":"Baptis' gbogb' orilẹ-ede,","marked":"Baptis gbogb orilẹ-ede"},{"start":35.918,"end":37.434,"text":"Royin 'sẹgun Jesu yika;","marked":"Ròyìn 'sẹgun Jésù yíká"},{"start":37.884,"end":39.484,"text":"Yin orukọ Jesu logo,","marked":"Yin orúkọ Jésù lógo"},{"start":39.934,"end":42.016,"text":"Tit' arayé yoo jẹwọ Rẹ.","marked":"Tít arayé yóò jẹ́wọ́ Rẹ."}],"end":42.016}]}