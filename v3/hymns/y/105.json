{"v":3,"coll":"y","num":105,"id":"hymn_105","title":"E JE ka f'inu didun","duration":39.64,"voices":{"male":{"file":"y-105-male-v3.m4a","bytes":270896,"sha256":"52dcda4f89d098861d9c56224daa25641f73c10358147689dff8504eb93211ae","duration":39.7},"female":{"file":"y-105-female-v3.m4a","bytes":276998,"sha256":"16904882c6c815831f123f36eca5ae28c1dacd210d840e7bebd150f83abff53a","duration":39.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.561,"text":"Ẹ JẸ ka f'inu didun,","marked":"Ẹ Jẹ́ ká f'inú dídùn"},{"start":2.011,"end":3.279,"text":"Yin Oluwa Olore;","marked":"Yín Olúwa Ọlọ́rẹ"},{"start":3.729,"end":5.227,"text":"Anu Rẹ o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":5.677,"end":6.934,"text":"L'ododo dajudaju","marked":"L'òdodo dájúdájú"}],"end":6.934},{"key":"2","start":7.884,"lines":[{"start":7.884,"end":9.543,"text":"Oun, nipa agbara Rẹ,","marked":"Òun, nípa agbára Rẹ"},{"start":9.993,"end":11.567,"text":"F'imọlẹ s'ayé titun;","marked":"F'ìmọ́lẹ̀ s'ayé titun"},{"start":12.017,"end":13.584,"text":"Anu Rẹ o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":14.034,"end":15.258,"text":"L'ododo dajudaju","marked":"L'òdodo dájúdájú"}],"end":15.258},{"key":"3","start":16.208,"lines":[{"start":16.208,"end":17.552,"text":"O mbo awon alaini","marked":"Ó mbọ̀ àwọn aláìní"},{"start":18.002,"end":19.28,"text":"Ati gbogbo alaye","marked":"Àti gbogbo àlàyé"},{"start":19.73,"end":21.23,"text":"Anu Re o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":21.68,"end":22.965,"text":"L'ododo dajudaju.","marked":"L'òdodo dájúdájú."}],"end":22.965},{"key":"4","start":23.915,"lines":[{"start":23.915,"end":25.221,"text":"O mbukun ayanfẹ Rẹ,","marked":"Ó mbùkún àyànfẹ́ Rẹ̀"},{"start":25.671,"end":27.068,"text":"Ni aginju ayé yi,","marked":"Ní aginjù ayé yí"},{"start":27.518,"end":28.945,"text":"Anu Rẹ o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":29.395,"end":30.606,"text":"L'ododo dajudaju","marked":"L'òdodo dájúdájú"}],"end":30.606},{"key":"5","start":31.556