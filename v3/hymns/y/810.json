{"v":3,"coll":"y","num":810,"id":"hymn_810","title":"WA, royin Re yika","duration":30.67,"voices":{"male":{"file":"y-810-male-v3.m4a","bytes":206081,"sha256":"e0c9038a8fba3211e94ae196ffd535afaef5a73a63a019a4792471f7d32d2ae2","duration":30.7},"female":{"file":"y-810-female-v3.m4a","bytes":214349,"sha256":"fb474e80c0511eb9220778df5cd60ad1fd4269a194ca66ab3cd10ef55376a1fb","duration":30.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.713,"text":"WA, royin Rẹ yika,","marked":"Wá, ròyìn Rẹ̀ yíká"},{"start":2.163,"end":3.639,"text":"K'a si kọrin ogo;","marked":"K'á sì kọrin ògo"},{"start":4.089,"end":5.308,"text":"Alagbara ni Oluwa,","marked":"Alágbára ni Olúwa"},{"start":5.758,"end":6.964,"text":"Ọba gbogbo ayé.","marked":"Ọba gbogbo ayé."}],"end":6.964},{"key":"2","start":7.914,"lines":[{"start":7.914,"end":9.077,"text":"Oun l'O da 'wọn ibu;","marked":"Òun l'Ó dá 'wọn ibú"},{"start":9.527,"end":10.605,"text":"O pala fun okun;","marked":"Ó palà fún òkun"},{"start":11.055,"end":12.429,"text":"Tirẹ ni gbogb' awọn odo,","marked":"Tirẹ̀ ni gbogb àwọn odò"},{"start":12.879,"end":14.012,"text":"At' iyangbẹ ilẹ.","marked":"Àt ìyàngbẹ ilẹ̀."}],"end":14.012},{"key":"3","start":14.962,"lines":[{"start":14.962,"end":16.546,"text":"Wa, wolẹ n'itẹ Rẹ,","marked":"Wá, wólẹ̀ n'ìtẹ́ Rẹ"},{"start":16.996,"end":18.15,"text":"Wa, juba Oluwa;","marked":"Wá, júbà Olúwa"},{"start":18.6,"end":19.94,"text":"Isẹ ọwọ Rẹ l'awa se,","marked":"Isẹ́ ọwọ́ Rẹ l'àwa ṣe"},{"start":20.39,"end":21.744,"text":"Ọrọ Rẹ l'o da wa.","marked":"Ọ̀rọ̀ Rẹ l'ó dá wa."}],"end":21.744},{"key":"4","start":22.694,"lines":[{"start":22.694,"end":23.762,"text":"Gbo ohun Re loni","marked":"Gbọ́ ohùn Rẹ lóní"},{"start":24.212,"end":25.268,"text":"Ma si se mu binu","marked":"Má sì ṣe mú bínú"},{"start":25.718,"end":27.612,"text":"Wa, bi eni ayanfe Re","marked":"Wá, bí ẹni àyànfẹ́ Rẹ̀"},{"start":28.062,"end":29.121,"text":"Jewo Olorun re.","marked":"Jẹ́wọ́ Ọlọ́run rẹ."}],"end":29.121}]}