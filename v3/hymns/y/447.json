{"v":3,"coll":"y","num":447,"id":"hymn_447","title":"BABA, b'ife Re ni, lati","duration":25.45,"voices":{"male":{"file":"y-447-male-v3.m4a","bytes":178086,"sha256":"2e48f1432bb74dfe3d6ce5ddc5fd0ea30a599380c1d6f097f9154137b5cc5fd6","duration":25.5},"female":{"file":"y-447-female-v3.m4a","bytes":182044,"sha256":"c5b40ac5a9a1637f5edbc31a4b31b9e9226f93a54b7573d616699b10d3c800b5","duration":25.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.839,"text":"BABA, b'ifẹ Rẹ ni, lati","marked":"Baba, b'ìfẹ́ Rẹ ni, láti"},{"start":3.289,"end":4.265,"text":"Du mi l'ohun ayé,","marked":"Dù mí l'ohun ayé"},{"start":4.715,"end":6.167,"text":"Sa jẹ ki adura mi yii,","marked":"Sá jẹ́ kí àdúrà mi yìí"},{"start":6.617,"end":7.968,"text":"Goke de itẹ rẹ.","marked":"Gòkè dé ìtẹ́ rẹ."}],"end":7.968},{"key":"2","start":8.918,"lines":[{"start":8.918,"end":10.896,"text":"F'ọkan tutu, t'ọpẹ fun mi;","marked":"F'ọkàn tútù, t'ọpẹ́ fún mi"},{"start":11.346,"end":12.591,"text":". Gba mi lọwọ kikun;","marked":". Gbà mí lọ́wọ́ kíkún"},{"start":13.041,"end":14.386,"text":"Fun mi n'ibukun or'-ọfẹ;","marked":"Fún mi n'ìbùkún or'-ọfẹ"},{"start":14.836,"end":16.215,"text":"Si jẹ ki n wa fun Ọ.","marked":"Sì jẹ́ kí n wà fún Ọ."}],"end":16.215},{"key":"3","start":17.165,"lines":[{"start":17.165,"end":18.996,"text":"K'ero yi pe, 'Wọ ni temi,","marked":"K'èrò yí pé, 'Wọ ni tèmi"},{"start":19.446,"end":20.622,"text":"Ma ba mi lọ layé;","marked":"Má bá mi lọ layé"},{"start":21.072,"end":22.201,"text":"Pẹlu mi lọna ajo mi,","marked":"Pẹ̀lú mi lọ́nà àjọ mi"},{"start":22.651,"end":23.9,"text":"Si ba mi d'opin rẹ.","marked":"Sì bá mi d'òpin rẹ̀."}],"end":23.9}]}