{"v":3,"coll":"y","num":194,"id":"hymn_194","title":"WA, Iwo Jesu t'a n reti","duration":34.189,"voices":{"male":{"file":"y-194-male-v3.m4a","bytes":239932,"sha256":"89cba7ab319799af52d596a1831bafdc0a54cf5edc67f8983b3434f96208e907","duration":34.2},"female":{"file":"y-194-female-v3.m4a","bytes":247979,"sha256":"128e4ce1c078e720eb68ecaab7449cd83fe8e9a0e04403f71d5945f3835fd075","duration":34.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.53,"text":"WA, Iwọ Jesu t'a n reti,","marked":"Wá, Ìwọ Jésù t'á ń retí"},{"start":2.98,"end":4.515,"text":"T'a bi lati da ni n'de,","marked":"T'á bí láti dá ní n'dé"},{"start":4.965,"end":6.359,"text":"Gba wa lọw'ẹru at'ẹsẹ,","marked":"Gbà wá lọ́w'ẹ̀rù àt'ẹsẹ̀"},{"start":6.809,"end":8.359,"text":"Jẹ k'a ri isinmi Rẹ.","marked":"Jẹ́ k'á rí ìsinmi Rẹ."}],"end":8.359},{"key":"2","start":9.309,"lines":[{"start":9.309,"end":10.589,"text":"Iwọ ni itunu Israel,","marked":"Ìwọ ni ìtùnú Israẹl"},{"start":11.039,"end":12.361,"text":"Ireti Onigbagbọ;","marked":"Ìrètí Onígbàgbọ́"},{"start":12.811,"end":13.871,"text":"Ifẹ gbogbo' orilẹ-de,","marked":"Ìfẹ́ gbogbo orilẹ-de"},{"start":14.321,"end":15.553,"text":"Ayọ ọkan ti n wọna.","marked":"Ayọ̀ ọkàn tí ń wọ́nà."}],"end":15.553},{"key":"3","start":16.503,"lines":[{"start":16.503,"end":18.204,"text":"'Wọ t'a bi lati gba wa la,","marked":"'Wọ t'á bí láti gbà wá là"},{"start":18.654,"end":19.83,"text":"Ọmọ ti a bi l'Ọba,","marked":"Ọmọ tí a bí l'Ọba"},{"start":20.28,"end":22.378,"text":"Ti a bi lati jọba lai,","marked":"Tí a bí láti jọba láì"},{"start":22.828,"end":24.198,"text":"Jẹ ki ijọba Rẹ de.","marked":"Jẹ́ kí ìjọba Rẹ dé."}],"end":24.198},{"key":"4","start":25.148,"lines":[{"start":25.148,"end":26.534,"text":"Fi Ẹmi Mimọ Rẹ nikan,","marked":"Fi Ẹ̀mí Mímọ́ Rẹ nìkan"},{"start":26.984,"end":28.397,"text":"Se akoso aya wa;","marked":"Ṣe àkóso aya wa"},{"start":28.847,"end":30.68,"text":"Nipa itoye, kikun Rẹ,","marked":"Nípa ìtòye, kíkún Rẹ̀"},{"start":31.13,"end":32.64,"text":"Gbe wa s'ori itẹ Rẹ.","marked":"Gbé wá s'orí ìtẹ́ Rẹ."}],"end":32.64}]}