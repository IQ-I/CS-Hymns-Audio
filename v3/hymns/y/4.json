{"v":3,"coll":"y","num":4,"id":"hymn_4","title":"WA s'odo mi, Oluwa mi","duration":44.715,"voices":{"male":{"file":"y-4-male.m4a","bytes":326838,"sha256":"eaf7758d85d07231173be33abc87095c42a27e0bb6f2edc24e675c7a19b88f08","duration":44.8},"female":{"file":"y-4-female.m4a","bytes":329998,"sha256":"460e8eca6fe161d46162dec61cca18d76e3e39721efa0aead771367ad09330a2","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.107,"text":"WA s'odo mi, Oluwa mi","marked":"Wá s'ọ́dọ̀ mi, Olúwa mi"},{"start":2.487,"end":3.542,"text":"Ni kutukutu owuro","marked":"Ní kùtùkùtù òwúrọ̀"},{"start":3.922,"end":5.339,"text":"Mu k'ero rere so jade,","marked":"Mú k'èrò rere sọ jáde"},{"start":5.719,"end":7.374,"text":"Lat' inu mi soke orun.","marked":"Lát' inú mi sókè ọ̀run."}],"end":7.374},{"key":"2","start":8.324,"lines":[{"start":8.324,"end":9.862,"text":"Wa soda mi, Oluwa mi,","marked":"Wá sọdá mi, Olúwa mi"},{"start":10.242,"end":11.948,"text":"Ni wakati osan gangan;","marked":"Ní wákàtí ọ̀sán gangan"},{"start":12.328,"end":13.575,"text":"Ki 'yonu ma ba se mi mo,","marked":"Kí 'yonu má bá ṣe mí mọ́"},{"start":13.955,"end":15.967,"text":"Nwon a si s'osan mi d'oru.","marked":"Nwọn a sì ṣ'ọ̀sán mi d'oru."}],"end":15.967},{"key":"3","start":16.917,"lines":[{"start":16.917,"end":18.959,"text":"Wa sodo mi, Oluwa mi,","marked":"Wá sọ́dọ̀ mi, Olúwa mi"},{"start":19.339,"end":20.594,"text":"Nigbati ale ba nle lo,","marked":"Nígbàtí alẹ́ bá ńlẹ́ lọ"},{"start":20.974,"end":22.365,"text":"Bi okan mi ba nsako lo,","marked":"Bí ọkàn mi bá ńṣáko lọ"},{"start":22.745,"end":24.378,"text":"Mu pada, f'oju 're wo mi.","marked":"Mú padà, f'ojú 'rẹ̀ wò mí."}],"end":24.378},{"key":"4","start":25.328,"lines":[{"start":25.328,"end":26.967,"text":"Wa sodo mi, Oluwa mi,","marked":"Wá sọ́dọ̀ mi, Olúwa mi"},{"start":27.347,"end":29.037,"text":"Li oru, nigbati orun","marked":"Lí òru, nígbàtí ọ̀run"},{"start":29.417,"end":31.702,"text":"Ko woju mi; je k'okan mi","marked":"Kò wojú mi; jẹ k'ọkàn mi"},{"start":32.082,"end":33.979,"text":"Ri simi je li aiya Re.","marked":"Rí simi jẹ li aiya Rẹ."}],"end":33.979},{"key":"5","start":34.929,"lines":[{"start":34.929,"end":36.578,"text":"Wa sodo mi, Oluwa mi,","marked":"Wá sọ́dọ̀ mi, Olúwa mi"},{"start":36.958,"end":38.312,"text":"Ni gbogbo ojo aiye mi,","marked":"Ní gbogbo ọjọ́ aiye mi"},{"start":38.692,"end":40.174,"text":"Nigbati emi mi ba pin,","marked":"Nígbàtí ẹ̀mí mi bá pín"},{"start":40.554,"end":42.243,"text":"Ki nle n'ibugbe lodo Re.","marked":"Kí ńlẹ̀ ń'ibùgbé lọ́dọ̀ Rẹ."},{"start":42.623,"end":43.165,"text":"Amin.","marked":"Àmín."}],"end":43.165}]}