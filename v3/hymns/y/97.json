{"v":3,"coll":"y","num":97,"id":"hymn_97","title":"OLORUN Eleda t'o da'jo Seraf","duration":79.331,"voices":{"male":{"file":"y-97-male-v3.m4a","bytes":580634,"sha256":"255a5c06e1600d2b7de54e14f607ee685f5f597852b645442ea33861c15b52fd","duration":79.4},"female":{"file":"y-97-female-v3.m4a","bytes":599152,"sha256":"5461cd0b6f34033e8104618fa428444de8afe966503804b67c1a48d7641eef91","duration":79.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.575,"text":"OLORUN Eleda t'o da'jọ Seraf,","marked":"Ọlọ́run Ẹlẹ́dàá t'ó dá'jọ Seraf"},{"start":3.025,"end":5.146,"text":"Ati Kerubu s'orile ede ayé,","marked":"Àti Kérúbù s'orílẹ̀ èdè ayé"},{"start":5.596,"end":7.466,"text":"Lat'owo Jesu Olugbala owon","marked":"Lát'ọwọ́ Jésù Olùgbàlà ọ̀wọ́n"},{"start":7.916,"end":17.768,"text":"Awa n yin oruko Re logo. A! ẹ ku ayọ, ẹ ku ayọ ) Ijọ Séráfù )2ce A! ẹ ku ayọ, ẹ ku ayọ ) Ijọ Kérúbù. )","marked":"Àwa ń yin orúkọ Rẹ̀ lógo. A! ẹ kú ayọ̀, ẹ kú ayọ̀ Ìjọ Séráfù A! ẹ kú ayọ̀, ẹ kú ayọ̀ Ìjọ Kérúbù."}],"end":17.768},{"key":"CHORUS","start":18.718,"lines":[{"start":18.718,"end":21.222,"text":"A! e ku ayo, eku ayo","marked":"A! ẹ kú ayọ̀, eku ayọ̀"},{"start":21.672,"end":22.653,"text":"egbe Serafu","marked":"ẹgbẹ́ Séráfù"},{"start":23.103,"end":25.704,"text":"A! e ku ayo, e ku ayo","marked":"A! ẹ kú ayọ̀, ẹ kú ayọ̀"},{"start":26.154,"end":27.148,"text":"egbe Kerubu.","marked":"ẹgbẹ́ Kérúbù."}],"end":27.148},{"key":"2","start":28.098,"lines":[{"start":28.098,"end":29.621,"text":"Nibo l'awọn ayanfẹ Ọlọrun wa?","marked":"Níbo l'àwọn àyànfẹ́ Ọlọ́run wa?"},{"start":30.071,"end":32.036,"text":"Ẹ wa gbọ ohun Olusọ-aguntan yi:","marked":"Ẹ wá gbọ́ ohùn Olusọ-aguntan yí"},{"start":32.486,"end":34.512,"text":"Ẹ ronupiwada, ẹ wa w'ọkọ naa;","marked":"Ẹ ronúpìwàdà, ẹ wá w'ọ̀kọ̀ náà"},{"start":34.962,"end":36.736,"text":"Igbala na ku si atẹlẹwọ.","marked":"Ìgbàlà ná kú sí àtẹ́lẹwọ́."}],"end":36.736},{"key":"3","start":37.686,"lines":[{"start":37.686,"end":39.712,"text":"Ẹgbẹ Kérúbù dupẹ lọwọ Ọlọrun,","marked":"Ẹgbẹ́ Kérúbù dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":40.162,"end":42.345,"text":"Tẹsiwaju ninu ogun ẹmi jija,","marked":"Tẹ̀síwájú nínú ogun ẹ̀mí jíjà"},{"start":42.795,"end":44.522,"text":"Ẹ fẹrẹ gbo'hun Oluwa Jesu,","marked":"Ẹ fẹ́rẹ̀ gbọ́'hùn Olúwa Jésù"},{"start":44.972,"end":46.796,"text":"Wi pé, o seun, ọmọ rere","marked":"Wí pé, ó ṣeun, ọmọ rere"}],"end":46.796},{"key":"4","start":47.746,"lines":[{"start":47.746,"end":50.251,"text":"Ẹyin ti n kọja lọ ya sọdọ Jesu,","marked":"Ẹ̀yin tí ń kọjá lọ yà sọ́dọ̀ Jésù"},{"start":50.701,"end":52.662,"text":"Lati gb'ore-ọfẹ n'nu Ijọ yi,","marked":"Láti gb'ore-ọfẹ n'nú Ìjọ yí"},{"start":53.112,"end":55.175,"text":"Mase kẹgan ọkọ igbala 'kẹhin,","marked":"Máṣe kẹ́gàn ọkọ̀ ìgbàlà 'kẹhin"},{"start":55.625,"end":57.006,"text":"T'Ọlọrun Mẹtalọkan fun wa.","marked":"T'Ọlọ́run Mẹ́talọ́kan fún wa."}],"end":57.006},{"key":"5","start":57.956,"lines":[{"start":57.956,"end":59.839,"text":"Jesu Oluwa mbọ wa j'Ọba layé,","marked":"Jésù Olúwa mbọ̀ wá j'Ọba layé"},{"start":60.289,"end":62.776,"text":"Larin Ẹgbẹ Kérúbù ati Séráfù,","marked":"Lárin Ẹgbẹ́ Kérúbù àti Séráfù"},{"start":63.226,"end":65.023,"text":"Ẹgbẹrun ọdun ni 'jỌba Rẹ ninu,","marked":"Ẹgbẹ̀rún ọdún ni 'jỌba Rẹ̀ nínú"},{"start":65.473,"end":67.337,"text":"Ijọ Mimọ at'oke wa yi.","marked":"Ìjọ Mímọ́ àt'òkè wá yí."}],"end":67.337},{"key":"6","start":68.287,"lines":[{"start":68.287,"end":70.588,"text":"Jesu Kristi Oluwa Ọba Ogo,","marked":"Jésù Kristi Olúwa Ọba Ògo"},{"start":71.038,"end":72.798,"text":"L'ọpa iye ainipẹkun wa lọwọ Rẹ;","marked":"L'ọ̀pá ìyè àìnípẹ̀kun wà lọ́wọ́ Rẹ"},{"start":73.248,"end":75.327,"text":"Yoo ko gbogbo awọn t'o gbagbọ lọ,","marked":"Yóò kó gbogbo àwọn t'ó gbàgbọ́ lọ"},{"start":75.777,"end":77.782,"text":"Siwaju itẹ Baba l'oke.","marked":"Síwájú ìtẹ́ Baba l'òkè."}],"end":77.782}]}