{"v":3,"coll":"y","num":861,"id":"hymn_861","title":"OMO Egbe Serafu dide","duration":54.149,"voices":{"male":{"file":"y-861-male.m4a","bytes":389739,"sha256":"92215a5332f559b75654126b385ee47bc9e3923deb1125570452011d3b531b0c","duration":54.2},"female":{"file":"y-861-female.m4a","bytes":400335,"sha256":"0a998a15d97369560349200c45247445bc8c1440d53208a035535de75def18f1","duration":54.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.711,"text":"OMO Egbe Serafu dide","marked":"Ọmọ Ẹgbẹ́ Séráfù dìde"},{"start":2.091,"end":3.709,"text":"F'ife at'aniyan dide","marked":"F'ife àt'àníyàn dìde"},{"start":4.089,"end":5.714,"text":"Jeki imole re tan roro","marked":"Jẹ́kí ìmọ́lẹ̀̀ rẹ̀ tàn rọ́rọ́"},{"start":6.094,"end":7.635,"text":"Dide lati gbe Jesu ga.","marked":"Dídé láti gbé Jésù ga."}],"end":7.635},{"key":"CHORUS","start":8.585,"lines":[{"start":8.585,"end":10.33,"text":"Ma yan nin'ola Olorun wa","marked":"Má yan nín'ọlá Ọlọ́run wa"},{"start":10.71,"end":12.521,"text":"Ma yan nin'oIa Olorun wa","marked":"Má yan nín'ọlá Ọlọ́run wa"},{"start":12.901,"end":14.809,"text":"Ma yan, ma yan","marked":"Má yan, má yan"},{"start":15.189,"end":17.463,"text":"Ma rin, ma yan n'nu 'fe Jesu.","marked":"Má rìn, má yan n'nú 'fẹ́ Jésù."}],"end":17.463},{"key":"2","start":18.413,"lines":[{"start":18.413,"end":20.039,"text":"Omo Egbe Serafu dide","marked":"Ọmọ Ẹgbẹ́ Séráfù dìde"},{"start":20.419,"end":22.047,"text":"F'ayo ru agbelebu re","marked":"F'àyò ru àgbélébùú rẹ̀"},{"start":22.427,"end":24.374,"text":"Ma binuje, ma b'ohun bo","marked":"Má bìnújẹ́, má b'óhun bò"},{"start":24.754,"end":26.654,"text":"Jesu y'o s'ekun re d'ayo.","marked":"Jésù y'ó s'èkùn rẹ̀ d'àyò."}],"end":26.654},{"key":"3","start":27.604,"lines":[{"start":27.604,"end":29.104,"text":"Omo Egbe Serafu dide","marked":"Ọmọ Ẹgbẹ́ Séráfù dìde"},{"start":29.484,"end":30.881,"text":"Ireti re ko ni saki","marked":"Ìrètí rẹ̀ kò ní ṣákí"},{"start":31.261,"end":32.902,"text":"Baba ko ni ko ohun re","marked":"Bàbá kò ní kọ ohùn rẹ̀"},{"start":33.282,"end":35.05,"text":"Mase je ko re 'gbagbo re.","marked":"Masẹ̀ jẹ́ kó rẹ 'gbàgbọ́ rẹ."}],"end":35.05},{"key":"4","start":36.0,"lines":[{"start":36.0,"end":37.448,"text":"Omo Egbe Serafu dide","marked":"Ọmọ Ẹgbẹ́ Séráfù dìde"},{"start":37.828,"end":39.453,"text":"Oke nla yio di petele","marked":"Òkè ńlá yìó di pẹ̀tẹ́lẹ̀"},{"start":39.833,"end":41.24,"text":"Bi Olorun ba nse tiwa","marked":"Bí Ọlọ́run bá ńṣe tiwa"},{"start":41.62,"end":43.296,"text":"Tani le doju 'jako wa.","marked":"Tani lè dojú 'jáko wa."}],"end":43.296},{"key":"5","start":44.246,"lines":[{"start":44.246,"end":45.826,"text":"Omo Egbe Serafu dide","marked":"Ọmọ Ẹgbẹ́ Séráfù dìde"},{"start":46.206,"end":47.61,"text":"Jesu Oluwa fere de","marked":"Jésù Olúwa fẹ́rẹ̀ dé"},{"start":47.99,"end":49.678,"text":"Ade 'rawo yio je tiwa","marked":"Adé 'rawò yio jẹ́ tiwa"},{"start":50.058,"end":51.451,"text":"Larin Egbe Mimo t'orun.","marked":"Lárin Ẹgbẹ́ Mímọ́́ t'ọrun."},{"start":51.831,"end":52.6,"text":"Amin.","marked":"Àmín."}],"end":52.6}]}