{"v":3,"coll":"y","num":192,"id":"hymn_192","title":"JESU t'o ga julo l'orun","duration":41.577,"voices":{"male":{"file":"y-192-male-v3.m4a","bytes":286198,"sha256":"9879bc5f9f5ab85d23b4f67b051535e13305758ac6d0ad4136971d3ec221b4ef","duration":41.6},"female":{"file":"y-192-female-v3.m4a","bytes":298285,"sha256":"407230fe3db44416f1b65e9a746a82e09f730a1e51a91e9e25dfd1c5c4cc124b","duration":41.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.662,"text":"JESU t'o ga julọ l'ọrun,","marked":"Jésù t'ó ga jùlọ l'ọ̀run"},{"start":3.112,"end":4.623,"text":"Ipa Rẹ l'o d'ayé;","marked":"Ipa Rẹ̀ l'ó d'ayé"},{"start":5.073,"end":6.589,"text":"'Wọ f'ogo nlanla Rẹ silẹ,","marked":"'Wọ f'ògo ńláńlá Rẹ̀ sílẹ̀"},{"start":7.039,"end":8.106,"text":"Lati gba ayé la.","marked":"Láti gba ayé là."}],"end":8.106},{"key":"2","start":9.056,"lines":[{"start":9.056,"end":10.629,"text":"O w'ayé ninu irẹlẹ,","marked":"Ó w'ayé nínú ìrẹ̀lẹ̀"},{"start":11.079,"end":12.31,"text":"Ni ara osi mi wa ;","marked":"Ní ara òsì mi wá"},{"start":12.76,"end":14.247,"text":"Nitori k'ọkan t'o rẹlẹ;","marked":"Nítorí k'ọkàn t'ó rẹlẹ̀"},{"start":14.697,"end":16.016,"text":"Le t'ipasẹ Rẹ la.","marked":"Lè t'ipasẹ̀ Rẹ̀ là."}],"end":16.016},{"key":"3","start":16.966,"lines":[{"start":16.966,"end":18.46,"text":"Wiwa Rẹ ya Angẹl l'ẹnu,","marked":"Wíwá Rẹ̀ ya Angẹl l'ẹnu"},{"start":18.91,"end":20.096,"text":"Ifẹ t'o tobi ni,","marked":"Ìfẹ́ t'ó tóbi ni"},{"start":20.546,"end":21.79,"text":"Eniyan l'anfani iye","marked":"Ènìyàn l'àǹfàní iye"},{"start":22.24,"end":23.979,"text":"Angẹli sẹ, ko ni.","marked":"Áńgẹ́lì sẹ́, kò ní."}],"end":23.979},{"key":"4","start":24.929,"lines":[{"start":24.929,"end":27.373,"text":"Njẹ arayé yọ, san yin de,","marked":"Ǹjẹ́ arayé yọ̀, sàn yín dé"},{"start":27.823,"end":28.901,"text":"Ẹ ho iho ayọ;","marked":"Ẹ hó ihò ayọ̀"},{"start":29.351,"end":30.607,"text":"Igbala mbọ fun ẹlẹsẹ;","marked":"Ìgbàlà mbọ́ fún ẹlẹ́sẹ̀"},{"start":31.057,"end":32.226,"text":"Jesu Ọlọrun ni.","marked":"Jésù Ọlọ́run ni."}],"end":32.226},{"key":"5","start":33.176,"lines":[{"start":33.176,"end":35.035,"text":"Oluwa, jọ ki bibọ Rẹ,","marked":"Olúwa, jọ kí bíbọ̀ Rẹ"},{"start":35.485,"end":36.53,"text":"Nigba ẹrinkeji,","marked":"Nígbà ẹrìnkejì"},{"start":36.98,"end":38.303,"text":"Jẹ ohun ti a ń duro de,","marked":"Jẹ́ ohun tí à ń dúró dé"},{"start":38.753,"end":40.028,"text":"K'o le ba wa l'ayọ.","marked":"K'ó lè bá wa l'ayọ̀."}],"end":40.028}]}