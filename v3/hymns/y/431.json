{"v":3,"coll":"y","num":431,"id":"hymn_431","title":"BA mi soro, Jesu","duration":34.827,"voices":{"male":{"file":"y-431-male-v3.m4a","bytes":226681,"sha256":"54f41188e256527e24fa22dad908c2ac3caa52dccabb9e05c2a3fdf7f2edae43","duration":34.9},"female":{"file":"y-431-female-v3.m4a","bytes":238896,"sha256":"86960fff14b67fd2e851c5234a06c657d619db7d90e7dc3e0fe1bc2583eb6584","duration":34.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.28,"text":"BA mi soro, Jesu","marked":"Bá mi sọ̀rọ̀, Jésù"},{"start":2.73,"end":3.878,"text":"Bi mo ti duro","marked":"Bí mo ti dúró"},{"start":4.328,"end":5.394,"text":"Fi okan mi le 'le","marked":"Fi ọkàn mi le lé"},{"start":5.844,"end":6.787,"text":"Ninu ireti.","marked":"Nínú ìrètí."}],"end":6.787},{"key":"2","start":7.737,"lines":[{"start":7.737,"end":8.755,"text":"Ba mi sọrọ Baba","marked":"Bá mi sọ̀rọ̀ Baba"},{"start":9.205,"end":10.405,"text":"Ni wakati yi,","marked":"Ní wákàtí yí"},{"start":10.855,"end":11.948,"text":"Jẹ ki n ri oju Rẹ,","marked":"Jẹ́ kí n rí ojú Rẹ"},{"start":12.398,"end":13.426,"text":"Nin' Ọlanla Rẹ.","marked":"Nín Ọláńlá Rẹ."}],"end":13.426},{"key":"3","start":14.376,"lines":[{"start":14.376,"end":15.397,"text":"Ọrọ ti O ba sọ,","marked":"Ọ̀rọ̀ tí Ó bá sọ"},{"start":15.847,"end":16.661,"text":"‘Ọrọ iye ni;","marked":"'Ọrọ ìyè ni"},{"start":17.111,"end":18.198,"text":"Ounjẹ iye ọrun;","marked":"Oúnjẹ iye ọ̀run"},{"start":18.648,"end":19.843,"text":"Maa bọ mi titi.","marked":"Máa bọ̀ mí títí."}],"end":19.843},{"key":"4","start":20.793,"lines":[{"start":20.793,"end":22.017,"text":"Tir ẹ l'ohun gbogbo,","marked":"Tir ẹ̀ l'ohun gbogbo"},{"start":22.467,"end":23.751,"text":"N ki si se t'emi,","marked":"N kí sì ṣe t'èmi"},{"start":24.201,"end":25.508,"text":"Ayọ ni mo fi wi,","marked":"Ayọ̀ ni mo fi wí"},{"start":25.958,"end":27.174,"text":"Pe, Tirẹ l'emi","marked":"Pé, Tirẹ̀ l'èmi"}],"end":27.174},{"key":"5","start":28.124,"lines":[{"start":28.124,"end":29.134,"text":"Fun mi ni imo na","marked":"Fún mi ní ìmọ̀ ná"},{"start":29.584,"end":30.492,"text":"T'ise ogo Re","marked":"T'iṣẹ́ ògo Rẹ"},{"start":30.942,"end":31.815,"text":"Mu gbogbo ileri","marked":"Mú gbogbo ìlérí"},{"start":32.265,"end":33.278,"text":"Re se s'ara mi.","marked":"Rẹ̀ ṣe s'ára mi."}],"end":33.278}]}