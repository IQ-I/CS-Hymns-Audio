{"v":3,"coll":"y","num":23,"id":"hymn_23","title":"K'AWA to pari eko wa","duration":25.856,"voices":{"male":{"file":"y-23-male-v3.m4a","bytes":176179,"sha256":"fb978a6603873c91fc1477b4d0bcfbdb787d7ef4a25adb829d2effdf4417b400","duration":25.9},"female":{"file":"y-23-female-v3.m4a","bytes":182646,"sha256":"ea7d913e9bcbbb42e38af89ed41c1fda1c1289483e3b16aa4d2719ddda2f0959","duration":25.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.645,"text":"K'AWA to pari eko wa,","marked":"K'Àwa tó parí ẹ̀kọ́ wa"},{"start":2.095,"end":3.239,"text":"Awa f' iyin fun O","marked":"Àwa f ìyìn fún Ọ"},{"start":3.689,"end":5.075,"text":"T'ori ojo Re mimo yi,","marked":"T'orí ọjọ́ Rẹ mímọ́ yí"},{"start":5.525,"end":7.298,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọrẹ èwe."}],"end":7.298},{"key":"2","start":8.248,"lines":[{"start":8.248,"end":9.492,"text":"Gbin ọrọ Rẹ si ọkan wa,","marked":"Gbin ọ̀rọ̀ Rẹ sí ọkàn wa"},{"start":9.942,"end":10.874,"text":"Gba wa lọwọ ẹsẹ;","marked":"Gbà wá lọ́wọ́ ẹsẹ̀"},{"start":11.324,"end":13.364,"text":"Ma jẹ ka pada lẹyin Rẹ,","marked":"Má jẹ́ ká padà lẹ́yìn Rẹ̀"},{"start":13.814,"end":15.408,"text":"Jesu, Ọrẹ ewe.","marked":"Jésù, Ọrẹ èwe."}],"end":15.408},{"key":"3","start":16.358,"lines":[{"start":16.358,"end":18.432,"text":"Jesu jo, bukun ile wa,","marked":"Jésù jọ, bùkún ilé wa"},{"start":18.882,"end":20.017,"text":"K'a lo ojo yi 're","marked":"K'á lo ọjọ́ yí rẹ̀"},{"start":20.467,"end":22.102,"text":"K'a le ri aye lodo Re,","marked":"K'á lè rí ayé lọ́dọ̀ Rẹ"},{"start":22.552,"end":24.306,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọrẹ èwe."}],"end":24.306}]}