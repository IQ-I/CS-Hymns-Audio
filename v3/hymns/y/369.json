{"v":3,"coll":"y","num":369,"id":"hymn_369","title":"JE ki n nipo mi lodo Re","duration":36.519,"voices":{"male":{"file":"y-369-male-v3.m4a","bytes":257985,"sha256":"804bda91c911007cd176992e76b31612701df2c1a7bffdcd8fe20c2a2f9e0030","duration":36.6},"female":{"file":"y-369-female-v3.m4a","bytes":268082,"sha256":"800461f7760a814c8be7edb8dd27446dd8f37e1321ad24db291ea759600513e8","duration":36.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.829,"text":"JẸ ki n nipo mi lọdọ Rẹ,","marked":"Jẹ́ kí n nípò mi lọ́dọ̀ Rẹ"},{"start":2.279,"end":4.917,"text":"Jesu, Iwọ isinmi mi;","marked":"Jésù, Ìwọ ìsinmi mi"},{"start":5.367,"end":6.761,"text":"'Gbana l'ọkan mi y'o sinmi,","marked":"gbáná l'ọkàn mi y'ó sinmi"},{"start":7.211,"end":8.877,"text":"Y'o si ri ẹkun 'bukun gba.","marked":"Y'ó sì rí ẹkún bùkún gbà."}],"end":8.877},{"key":"2","start":9.827,"lines":[{"start":9.827,"end":11.348,"text":"Jẹ ki n nipo mi lọdọ Rẹ,","marked":"Jẹ́ kí n nípò mi lọ́dọ̀ Rẹ"},{"start":11.798,"end":13.157,"text":"K'emi ko le ri ogo Rẹ,","marked":"K'èmi kò lè rí ògo Rẹ"},{"start":13.607,"end":15.275,"text":"'Gbana ni ọkan ẹtan mi,","marked":"gbàná ní ọkàn ẹ̀tàn mi"},{"start":15.725,"end":17.226,"text":"Yoo ri ẹni f'ara le.","marked":"Yóò rí ẹni f'ara le."}],"end":17.226},{"key":"3","start":18.176,"lines":[{"start":18.176,"end":19.728,"text":"Jẹ ki m' n'ipo mi lọdọ Rẹ,","marked":"Jẹ́ kí m n'ipò mi lọ́dọ̀ Rẹ"},{"start":20.178,"end":21.601,"text":"Nibi awọn mimọ n yin Ọ;","marked":"Níbi àwọn mímọ́ ń yìn Ọ"},{"start":22.051,"end":23.733,"text":"'Gbana ni ọkan ẹsẹ mi,","marked":"gbàná ni ọkàn ẹsẹ̀ mi"},{"start":24.183,"end":25.746,"text":"Y'o dẹkun ẹsẹ ni dida.","marked":"Y'ó dẹ́kun ẹsẹ̀ ni dídá."}],"end":25.746},{"key":"4","start":26.696,"lines":[{"start":26.696,"end":28.249,"text":"Jẹ ki n nipo mi lọdọ Rẹ,","marked":"Jẹ́ kí n nípò mi lọ́dọ̀ Rẹ"},{"start":28.699,"end":29.982,"text":"Nibi a ki yipo pada,","marked":"Níbi a kì yípo padà"},{"start":30.432,"end":32.643,"text":"Nib' a ko n pe, o digbose,","marked":"Níb a kò ń pè, ó dígbòṣẹ́"},{"start":33.093,"end":34.97,"text":"Titi ayé, titi ayé.","marked":"Títí ayé, títí ayé."}],"end":34.97}]}