{"v":3,"coll":"y","num":577,"id":"hymn_577","title":"OMO Olorun n lo s'ogun","duration":64.914,"voices":{"male":{"file":"y-577-male-v3.m4a","bytes":444041,"sha256":"19904110d516eaaffdec5b22f6ba1fd32c84018273ef0721e6e633c3f3badf18","duration":65.0},"female":{"file":"y-577-female-v3.m4a","bytes":462870,"sha256":"5fa30b9cbd39ec566b9be50827450ebe018afba00e0f5136d67b6e02f1cf7896","duration":65.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.688,"text":"ỌMỌ Ọlọrun n lọ s'ogun,","marked":"Ọmọ Ọlọ́run ń lọ s'ogun"},{"start":2.138,"end":3.218,"text":"Lati gbade Ọba:","marked":"Láti gbàdé Ọba"},{"start":3.668,"end":5.085,"text":"Ọpagun Rẹ si n fẹ lelẹ,","marked":"Ọ̀págun Rẹ̀ sì ń fẹ́ lélẹ̀"},{"start":5.535,"end":6.736,"text":"Ta l'o s'ọm'ogun Rẹ.","marked":"Ta l'ó s'ọm'ogun Rẹ̀."}],"end":6.736},{"key":"2","start":7.686,"lines":[{"start":7.686,"end":9.365,"text":"Ẹni ti o le mu ago na,","marked":"Ẹni tí ó lè mú àgọ́ ná"},{"start":9.815,"end":11.026,"text":"T'o le bori 'rora,","marked":"T'ó lè borí rora"},{"start":11.476,"end":13.291,"text":"T'o le gbe agbelebu Rẹ,","marked":"T'ó lè gbé àgbélébùú Rẹ"},{"start":13.741,"end":14.916,"text":"Oun ni Ọm' ogun Rẹ.","marked":"Òun ni Ọm' ogun Rẹ."}],"end":14.916},{"key":"3","start":15.866,"lines":[{"start":15.866,"end":17.584,"text":"Martyr ikini ti o kọ 'ku,","marked":"Martyr ìkíni tí ó kọ́ kú"},{"start":18.034,"end":19.043,"text":"T'o r'ọrun si silẹ;","marked":"T'ó r'ọ̀run sí sílẹ̀"},{"start":19.493,"end":20.718,"text":"T'o ri Oluwa rẹ loke,","marked":"T'ó rí Olúwa rẹ̀ lókè"},{"start":21.168,"end":23.016,"text":"T'o pe, k'o gba oun la.","marked":"T'ó pé, k'ó gba òun là."}],"end":23.016},{"key":"4","start":23.966,"lines":[{"start":23.966,"end":25.533,"text":"T'oun ti 'dariji l'ẹnu,","marked":"T'òun ti dáríjì l'ẹnu"},{"start":25.983,"end":27.17,"text":"Ninu 'rora iku,","marked":"Nínú rora ikú"},{"start":27.62,"end":29.577,"text":"O bẹbẹ f'awọn t'o n pa lọ;","marked":"Ó bẹ̀bẹ̀ f'àwọn t'ó ń pa lọ"},{"start":30.027,"end":30.986,"text":"Tani le se bi rẹ?","marked":"Tani lè ṣe bí rẹ̀?"}],"end":30.986},{"key":"5","start":31.936,"lines":[{"start":31.936,"end":33.927,"text":"Egbe mimo, awon wonni","marked":"Ẹgbẹ́ mímọ́, àwọn wọ̀nnì"},{"start":34.377,"end":35.411,"text":"T'Emi Mimo ba le","marked":"T'Ẹ̀mí Mímọ́ bá lé"},{"start":35.861,"end":37.058,"text":"Awon akoni mejila","marked":"Àwọn akọni méjìlá"},{"start":37.508,"end":38.826,"text":"Ti ko ka iku si.","marked":"Tí kò ka ikú sí."}],"end":38.826},{"key":"6","start":39.776,"lines":[{"start":39.776,"end":41.269,"text":"Wọn f'aya ran ida ọta,","marked":"Wọ́n f'àya rán idà ọ̀tá"},{"start":41.719,"end":42.924,"text":"Wọn ba ẹranko ja;","marked":"Wọ́n bá ẹranko jà"},{"start":43.374,"end":45.035,"text":"Wọn f'ọrun wọn lelẹ fun 'ku","marked":"Wọ́n f'ọ̀run wọn lélẹ̀ fún kú"},{"start":45.485,"end":46.456,"text":"Tani le se bi wọn?","marked":"Tani lè ṣe bí wọn?"}],"end":46.456},{"key":"7","start":47.406,"lines":[{"start":47.406,"end":49.962,"text":"Ẹgbẹ ogun, t'agba, t'ewe,","marked":"Ẹgbẹ́ ogun, t'àgbà, t'èwe"},{"start":50.412,"end":51.704,"text":"T'ọkunrin, t'obinrin;","marked":"T'ọkùnrin, t'obìnrin"},{"start":52.154,"end":53.421,"text":"Wọn y'itẹ Olugbala ka,","marked":"Wọ́n y'ìtẹ́ Olùgbàlà ká"},{"start":53.871,"end":55.107,"text":"Wọn wọ asọ funfun.","marked":"Wọ́n wọ asọ̀ funfun."}],"end":55.107},{"key":"8","start":56.057,"lines":[{"start":56.057,"end":57.259,"text":"Wọn de oke ọrun giga,","marked":"Wọ́n dé òkè ọ̀run gíga"},{"start":57.709,"end":59.601,"text":"di N'nu 'sẹ at'ipọnju,","marked":"di N'nú 'sẹ àt'ìpọ́njú"},{"start":60.051,"end":61.643,"text":"p Ọlọrun, fun wa l'agbara,","marked":"p Ọlọ́run, fún wa l'agbára"},{"start":62.093,"end":63.365,"text":"K'a le se bi wọn.","marked":"K'á lè ṣe bí wọn."}],"end":63.365}]}