{"v":3,"coll":"y","num":646,"id":"hymn_646","title":"WA, elese, s'ase rere","duration":66.486,"voices":{"male":{"file":"y-646-male-v3.m4a","bytes":475696,"sha256":"b8240e52dc4c05f9f305d6c4406a79bb6ef2d040d30680cd5d9d2182c40f7bcf","duration":66.5},"female":{"file":"y-646-female-v3.m4a","bytes":486118,"sha256":"f16a06bd5750c70d0fea605557683d97238dd75482c91a33008ab9005c22f703","duration":66.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.726,"text":"WA, elese, s'ase rere","marked":"Wá, ẹlẹ́ṣẹ̀, s'àṣẹ rere"},{"start":3.176,"end":4.758,"text":"K'a je alabaje Jesu","marked":"K'á jẹ́ alábàjẹ́ Jésù"},{"start":5.208,"end":6.75,"text":"K'enikeni ma ku sehin","marked":"K'ẹnikẹ́ni má kú sẹ́hìn"},{"start":7.2,"end":8.557,"text":"Olorun pe gbogbo eda.","marked":"Ọlọ́run pe gbogbo ẹ̀dá."}],"end":8.557},{"key":"2","start":9.507,"lines":[{"start":9.507,"end":10.84,"text":"Oluwa ran mi wa pe yin,","marked":"Olúwa rán mi wá pé yín"},{"start":11.29,"end":12.913,"text":"Fun gbogbo yin ni ipe na;","marked":"Fún gbogbo yín ní ìpè ná"},{"start":13.363,"end":15.966,"text":"Wa, gbogb' ayé, ẹlẹsẹ wa,","marked":"Wá, gbogb ayé, ẹlẹ́sẹ̀ wa"},{"start":16.416,"end":17.993,"text":"N'nu Krist' ohun gbogbo se tan.","marked":"N'nú Krist ohun gbogbo ṣe tán."}],"end":17.993},{"key":"3","start":18.943,"lines":[{"start":18.943,"end":20.998,"text":"Wa, ẹmi t'ẹsẹ n pọn loju,","marked":"Wá, ẹ̀mí t'ẹsẹ̀ ń pọ́n lójú"},{"start":21.448,"end":22.971,"text":"Ti n wa isinmi kakiri;","marked":"Tí ń wá ìsinmi kákiri"},{"start":23.421,"end":25.709,"text":"Arọ, afọju, otosi,","marked":"Arọ, afọ́jú, òtòṣì"},{"start":26.159,"end":27.815,"text":"N'nu Krist' ẹ o r'itẹwọgba.","marked":"N'nú Krist ẹ ò r'ìtẹ́wọ́gbà."}],"end":27.815},{"key":"4","start":28.765,"lines":[{"start":28.765,"end":30.552,"text":"Wa, s'alabajẹ ase na,","marked":"Wá, s'alábàjẹ́ àṣẹ ná"},{"start":31.002,"end":33.05,"text":"Kuro l'ẹsẹ, sinmi le Krist';","marked":"Kúrò l'ẹsẹ̀, sinmi lé Krist"},{"start":33.5,"end":34.729,"text":"Tọ ore Ọlọrun rẹ wo,","marked":"Tọ ọrẹ Ọlọ́run rẹ wò"},{"start":35.179,"end":37.58,"text":"Jẹ ara Rẹ, mu ẹjẹ Rẹ.","marked":"Jẹ́ ara Rẹ, mú ẹ̀jẹ̀ Rẹ."}],"end":37.58},{"key":"5","start":38.53,"lines":[{"start":38.53,"end":40.542,"text":"Asako emi, mo pe yin,","marked":"Aṣáko èmi, mo pè yín"},{"start":40.992,"end":42.566,"text":"Ohun mi 'ba jẹ le to yin!","marked":"Ohun mi bá jẹ́ lè tó yín!"},{"start":43.016,"end":44.357,"text":"Lọgan ẹ ba r'idalare,","marked":"Lọ́gán ẹ bá r'ìdáláre"},{"start":44.807,"end":47.018,"text":"Ẹ ba si ye, n'tori Krist' ku.","marked":"Ẹ bá sì yè, n'torí Krist kú."}],"end":47.018},{"key":"6","start":47.968,"lines":[{"start":47.968,"end":49.23,"text":"Gbọ ọrọ mi bi t'Ọlọrun,","marked":"Gbọ́ ọ̀rọ̀ mi bí t'Ọlọ́run"},{"start":49.68,"end":51.742,"text":"Wa sọdọ Krist', ki ẹ si ye;","marked":"Wá sọ́dọ̀ Krist, kí ẹ sì yè"},{"start":52.192,"end":53.646,"text":"Jẹ k'ifẹ Rẹ ro ọkan yin,","marked":"Jẹ́ k'ìfẹ́ Rẹ rọ ọkàn yín"},{"start":54.096,"end":55.839,"text":"Ẹ ma jẹ k'iku Rẹ j'asan.","marked":"Ẹ má jẹ́ k'ikú Rẹ̀ j'asán."}],"end":55.839},{"key":"7","start":56.789,"lines":[{"start":56.789,"end":58.724,"text":"Wa nisin yii, ma se duro,","marked":"Wá nísìn yìí, má ṣe dúró"},{"start":59.174,"end":60.522,"text":"Oni l'ọjọ itẹwọgba;","marked":"Òní l'ọjọ́ ìtẹ́wọ́gbà"},{"start":60.972,"end":62.942,"text":"Wọle, ma se kọ ipe Rẹ,","marked":"Wọlé, má ṣe kọ ìpè Rẹ"},{"start":63.392,"end":64.937,"text":"F'ara rẹ f'Ẹni ku fun ọ.","marked":"F'ara rẹ̀ f'Ẹni kú fún ọ."}],"end":64.937}]}