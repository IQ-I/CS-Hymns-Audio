{"v":3,"coll":"y","num":231,"id":"hymn_231","title":"AWA onigbagbo","duration":68.241,"voices":{"male":{"file":"y-231-male-v3.m4a","bytes":475429,"sha256":"1082e7925cce08036c05a432626f1d606e8257f2aeb5d3f941ab7e34efcef645","duration":68.3},"female":{"file":"y-231-female-v3.m4a","bytes":494619,"sha256":"46831c2ddc205bd860a6b0dcdb9336d3963907bf77c862b1640fb37558292da2","duration":68.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.429,"text":"AWA onigbagbọ,","marked":"Àwa onígbàgbọ́"},{"start":1.879,"end":3.027,"text":"T'o wa ninu ẹsẹ,","marked":"T'ó wà nínú ẹsẹ"},{"start":3.477,"end":4.72,"text":"K'a fọpẹ f'Ọlọrun,","marked":"K'á fọpẹ́ f'Ọlọ́run"},{"start":5.17,"end":6.487,"text":"To da wa si doni,","marked":"Tó dá wa sì doni"},{"start":6.937,"end":8.547,"text":"Arakunrin, arabinrin,","marked":"Arákùnrin, arábìnrin"},{"start":8.997,"end":11.364,"text":"Ẹ ku ọdun; ẹ ku 'yedun (2)","marked":"Ẹ kú ọdún; ẹ kú yẹ̀dùn"}],"end":11.364},{"key":"CHORUS","start":12.314,"lines":[{"start":12.314,"end":14.036,"text":"Arakunrin, arabinrin","marked":"Arákùnrin, arábìnrin"},{"start":14.486,"end":16.819,"text":"E ku odun; e ku 'yedun x2","marked":"Ẹ kú ọdún; ẹ kú yẹ̀dùn"}],"end":16.819},{"key":"2","start":17.769,"lines":[{"start":17.769,"end":19.553,"text":"Jesu, Oluwa wa,","marked":"Jésù, Olúwa wa"},{"start":20.003,"end":21.075,"text":"Ẹmi airi ń sọ wa,","marked":"Ẹ̀mí àìrí ń sọ wá"},{"start":21.525,"end":23.0,"text":"Ẹni ń ku lo yoo ye,","marked":"Ẹní ń kú lọ yóò yẹ"},{"start":23.45,"end":25.053,"text":"Alaisan yoo dide","marked":"Aláìsàn yóò dìde"}],"end":25.053},{"key":"3","start":26.003,"lines":[{"start":26.003,"end":27.126,"text":"Ọba Ologo mẹta,","marked":"Ọba Ológo mẹ́ta"},{"start":27.576,"end":28.518,"text":"Ẹni Mẹtalọkan,","marked":"Ẹni Mẹ́talọ́kan"},{"start":28.968,"end":30.177,"text":"Gbogb' ẹda ń juba Rẹ,","marked":"Gbogb ẹ̀dá ń júbà Rẹ̀"},{"start":30.627,"end":31.988,"text":"Loke ati 'sale.","marked":"Lókè àti ṣálẹ́."}],"end":31.988},{"key":"4","start":32.938,"lines":[{"start":32.938,"end":34.077,"text":"Ọdun to kọja lọ,","marked":"Ọdún tó kọjá lọ"},{"start":34.527,"end":35.784,"text":"Ko ni gbagbe l'o jẹ,","marked":"Kò ní gbàgbé l'ó jẹ́"},{"start":36.234,"end":37.199,"text":"Akopọ eniyan,","marked":"Àkópọ̀ ènìyàn"},{"start":37.649,"end":39.072,"text":"Arun ń ti wọn sọrun.","marked":"Àrùn ń tì wọ́n sọ́rùn."}],"end":39.072},{"key":"5","start":40.022,"lines":[{"start":40.022,"end":41.452,"text":"Isẹ ko si lode,","marked":"Isẹ́ kò sì lóde"},{"start":41.902,"end":43.088,"text":"Ọja ko tun ta mọ,","marked":"Ọjà kò tún ta mọ́"},{"start":43.538,"end":44.745,"text":"Ọpọ ti sa kuro,","marked":"Ọ̀pọ̀ ti sá kúrò"},{"start":45.195,"end":46.458,"text":"Fun 'gbese adako.","marked":"Fún gbèsè àdàkọ."}],"end":46.458},{"key":"6","start":47.408,"lines":[{"start":47.408,"end":48.701,"text":"Jehovah Jire wa,","marked":"Jehovah Jire wà"},{"start":49.151,"end":50.573,"text":"Yoo sọ wa lọdun yi,","marked":"Yóò sọ wá lọ́dún yí"},{"start":51.023,"end":52.2,"text":"Jehovah Nissi wa,","marked":"Jehovah Nissi wà"},{"start":52.65,"end":53.651,"text":"Ti tẹlẹ f'eniyan rẹ.","marked":"Ti tẹ́lẹ̀ f'ènìyàn rẹ̀."}],"end":53.651},{"key":"7","start":54.601,"lines":[{"start":54.601,"end":55.89,"text":"Ko seru mo lode","marked":"Kò ṣẹrú mọ́ lóde"},{"start":56.34,"end":57.527,"text":"B'Olorun je tiwa","marked":"B'Ọlọ́run jẹ́ tiwa"},{"start":57.977,"end":59.61,"text":"Amin, Amin, Ase","marked":"Àmín, Àmín, Àṣẹ"},{"start":60.06,"end":61.801,"text":"Dandan ko le sai se.","marked":"Dandan kò lè ṣàì ṣe."},{"start":62.251,"end":64.244,"text":"Arakunrin, arabinrin E","marked":"Arákùnrin, arábìnrin Ẹ"},{"start":64.694,"end":66.692,"text":"ku odun; e ku 'yedun (2)","marked":"kú ọdún; ẹ kú yẹ̀dùn"}],"end":66.692}]}