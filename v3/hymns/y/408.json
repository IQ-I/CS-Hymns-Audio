{"v":3,"coll":"y","num":408,"id":"hymn_408","title":"BABA orun, nin'oro Re","duration":38.935,"voices":{"male":{"file":"y-408-male-v3.m4a","bytes":267248,"sha256":"aa89e78652f8d473403a4e2ecd21521f5225b073f9e83bc620cba4857e27afe6","duration":39.0},"female":{"file":"y-408-female-v3.m4a","bytes":277365,"sha256":"e85183f277b738f4a3cc20d0f8d4297282aba3f108bd896a75e2caac4a781e2f","duration":39.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.152,"text":"BABA ọrun, nin' ọrọ Rẹ,","marked":"Baba ọ̀run, nín ọ̀rọ̀ Rẹ"},{"start":2.602,"end":3.767,"text":"Ni ogo ọrun n tan;","marked":"Ní ògo ọ̀run ń tàn"},{"start":4.217,"end":5.999,"text":"Titi lai l'a o ma yin Ọ,","marked":"Títí láì l'á ó má yín Ọ́"},{"start":6.449,"end":7.568,"text":"Fun Bibeli mimọ.","marked":"Fún Bíbélì mímọ́."}],"end":7.568},{"key":"2","start":8.518,"lines":[{"start":8.518,"end":9.752,"text":"Ọpọ 'tunu wa ninu rẹ,","marked":"Ọ̀pọ̀ túnú wà nínú rẹ̀"},{"start":10.202,"end":11.165,"text":"Fun ọkan alarẹ;","marked":"Fún ọkàn alárẹ"},{"start":11.615,"end":13.341,"text":"Gbogbo ọkan ti oungbẹ n gbẹ,","marked":"Gbogbo ọkàn tí òùngbẹ ń gbẹ"},{"start":13.791,"end":14.784,"text":"N ri omi iye mu.","marked":"Ń rí omi ìyè mú."}],"end":14.784},{"key":"3","start":15.734,"lines":[{"start":15.734,"end":16.944,"text":"Ninu rẹ l'alafia wa,","marked":"Nínú rẹ̀ l'àlàáfíà wà"},{"start":17.394,"end":18.645,"text":"Ti Jesu fi fun wa;","marked":"Tí Jésù fi fún wa"},{"start":19.095,"end":20.275,"text":"Iye ainipẹkun si wa,","marked":"Ìyè àìnípẹ̀kun sì wà"},{"start":20.725,"end":21.924,"text":"N'nu rẹ fun gbogbo wa.","marked":"N'nú rẹ̀ fún gbogbo wa."}],"end":21.924},{"key":"4","start":22.874,"lines":[{"start":22.874,"end":24.439,"text":"Iba le ma jẹ ayọ mi,","marked":"Ìbá lè má jẹ́ ayọ̀ mi"},{"start":24.889,"end":26.398,"text":"Lati ma ka titi;","marked":"Láti má ká títí"},{"start":26.848,"end":28.214,"text":"Ki n ma ri ọgbọn titun kọ,","marked":"Kí n má rí ọgbọ́n titun kọ"},{"start":28.664,"end":30.138,"text":"N'nu rẹ lojojumọ.","marked":"N'nú rẹ̀ lójojúmọ́."}],"end":30.138},{"key":"5","start":31.088,"lines":[{"start":31.088,"end":32.295,"text":"Oluwa Olukọ ọrun,","marked":"Olúwa Olùkọ́ ọ̀run"},{"start":32.745,"end":33.909,"text":"Mase jina si mi;","marked":"Máṣe jìnà sí mi"},{"start":34.359,"end":35.653,"text":"Kọ mi lati fẹ ọrọ Rẹ,","marked":"Kọ́ mi láti fẹ́ ọ̀rọ̀ Rẹ"},{"start":36.103,"end":37.385,"text":"Ki n ri Jesu nibẹ.","marked":"Kí n rí Jésù níbẹ̀."}],"end":37.385}]}