{"v":3,"coll":"y","num":437,"id":"hymn_437","title":"ISUN kan wa to kun f'eje","duration":40.589,"voices":{"male":{"file":"y-437-male-v3.m4a","bytes":276674,"sha256":"cbd1aa41f697c27360cd32150fb04ca515dda2fdbc925ce5d35934df88e8d529","duration":40.6},"female":{"file":"y-437-female-v3.m4a","bytes":291848,"sha256":"9ea9b2225f204e172a19b97034a95e4abd6d158a80cab94701625dc4c155f66c","duration":40.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.128,"text":"ISUN kan wa to kun f'ẹjẹ,","marked":"Ìsun kan wà tó kún f'ẹ̀jẹ̀"},{"start":2.578,"end":3.97,"text":"O yọ niha Jesu;","marked":"Ó yọ̀ níhà Jésù"},{"start":4.42,"end":6.041,"text":"Ẹlẹsẹ mokun ninu rẹ,","marked":"Ẹlẹ́sẹ̀ mókun nínú rẹ̀"},{"start":6.491,"end":7.74,"text":"O bọ ninu ẹbi.","marked":"Ó bọ́ nínú ẹ̀bi."}],"end":7.74},{"key":"2","start":8.69,"lines":[{"start":8.69,"end":10.316,"text":"'Gba mo f'igbagbọ r'isun naa,","marked":"gbà mo f'ìgbàgbọ́ r'isùn náà"},{"start":10.766,"end":11.931,"text":"Ti n san fun ọgbẹ Rẹ;","marked":"Tí ń sàn fún ọgbẹ́ Rẹ"},{"start":12.381,"end":13.687,"text":"Irapada d'orin fun mi,","marked":"Ìràpadà d'orin fún mi"},{"start":14.137,"end":15.498,"text":"Ti n ó ma kọ titi.","marked":"Tí n ó má kọ́ títí."}],"end":15.498},{"key":"3","start":16.448,"lines":[{"start":16.448,"end":18.13,"text":"Ninu orin to dun julọ,","marked":"Nínú orin tó dùn jùlọ"},{"start":18.58,"end":19.701,"text":"L'emi o kọrin Rẹ;","marked":"L'èmi ó kọrin Rẹ"},{"start":20.151,"end":21.533,"text":"Gba t'akololo ahọn yi,","marked":"Gba t'akọlọlọ ahọ́n yí"},{"start":21.983,"end":23.186,"text":"Ba dakẹ n'iboji.","marked":"Bá dákẹ́ n'ibojì."}],"end":23.186},{"key":"4","start":24.136,"lines":[{"start":24.136,"end":25.895,"text":"Mo gbagbo p'O pese fun mi","marked":"Mo gbàgbọ́ p'Ó pèsè fún mi"},{"start":26.345,"end":27.651,"text":"Bi mo tile saiye","marked":"Bí mo tilẹ̀ ṣàìyè"},{"start":28.101,"end":29.502,"text":"Ebun ofe ta f'eje ra","marked":"Ẹ̀bùn ọ̀fẹ́ ta f'ẹ̀jẹ̀ rà"},{"start":29.952,"end":31.183,"text":"Ati duru wura.","marked":"Àti dùrù wúrà."}],"end":31.183},{"key":"5","start":32.133,"lines":[{"start":32.133,"end":33.713,"text":"Duru t'a tọw' Ọlọrun se,","marked":"Dùrù t'á tọw' Ọlọ́run ṣe"},{"start":34.163,"end":35.355,"text":"Ti ko ni baje lai;","marked":"Tí kò ní bàjẹ́ láì"},{"start":35.805,"end":37.392,"text":"T'a o ma fi yin Baba wa,","marked":"T'a ó má fi yin Baba wa"},{"start":37.842,"end":39.039,"text":"Orukọ Rẹ nikan.","marked":"Orúkọ Rẹ nìkan."}],"end":39.039}]}