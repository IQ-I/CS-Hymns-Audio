{"v":3,"coll":"y","num":667,"id":"hymn_667","title":"AWON kekeke wo l'eyi","duration":34.516,"voices":{"male":{"file":"y-667-male-v3.m4a","bytes":241251,"sha256":"b676b1dbc9375a5a7f45cdd868d3886831e753f103c65e83c7975ae250a3b79b","duration":34.6},"female":{"file":"y-667-female-v3.m4a","bytes":253309,"sha256":"1a998705778e00fb9e6bcd24ac28b4d063dcdc1aa8979904df340a1826d14303","duration":34.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.644,"text":"AWỌN kekeke wo l'eyi,","marked":"Àwọn kèkèké wọ l'èyí"},{"start":2.094,"end":3.743,"text":"T' wọn tẹle l'ajo aye ja,","marked":"T wọ́n tẹ̀lé l'àjọ ayé jà"},{"start":4.193,"end":5.72,"text":"Ti wọn si de 'bugbe ogo,","marked":"Tí wọ́n sì dé bùgbé ògo"},{"start":6.17,"end":8.02,"text":"Eyi ti wọn ti n f'oju si?","marked":"Èyí tí wọ́n ti ń f'ojú sí?"}],"end":8.02},{"key":"2","start":8.97,"lines":[{"start":8.97,"end":10.229,"text":"Emi t'oke Sioni wa","marked":"Èmi t'òkè Síónì wá"},{"start":10.679,"end":12.239,"text":"Emi lati ile India","marked":"Èmi láti ilẹ̀ India"},{"start":12.689,"end":13.953,"text":"Emi t'ile Afrika wa","marked":"Èmi t'ilẹ̀ Afrika wà"},{"start":14.403,"end":15.982,"text":"Emi lat' erekusu ni.","marked":"Èmi lát erékùṣù ni."}],"end":15.982},{"key":"3","start":16.932,"lines":[{"start":16.932,"end":18.553,"text":"Irin ajo wa ti kọja,","marked":"Irin àjò wa ti kọjá"},{"start":19.003,"end":20.486,"text":"Ẹkun ati irora tan;","marked":"Ẹkún àti ìrora tán"},{"start":20.936,"end":22.372,"text":"A jumọ pade nikẹhin;","marked":"A jùmọ̀ pàdé níkẹ̀hìn"},{"start":22.822,"end":24.132,"text":"Ni ẹnu ibode ọrun.","marked":"Ní ẹnu ibodè ọ̀run."}],"end":24.132},{"key":"4","start":25.082,"lines":[{"start":25.082,"end":26.634,"text":"A n reti lati gbọ pe Wa,","marked":"À ń retí láti gbọ́ pé Wà"},{"start":27.084,"end":28.68,"text":"A sẹgun ẹsẹ oun iku;","marked":"A sẹ́gun ẹsẹ̀ òun ikú"},{"start":29.13,"end":31.275,"text":"Gb'ori yin soke, ilẹkun,","marked":"Gb'orí yín sókè, ìlẹ̀kùn"},{"start":31.725,"end":32.966,"text":"K'awọn ero ewe wọle.","marked":"K'àwọn èrò ewé wọlé."}],"end":32.966}]}