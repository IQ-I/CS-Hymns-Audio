{"v":3,"coll":"y","num":721,"id":"hymn_721","title":"OJO nla l'eyi je","duration":61.057,"voices":{"male":{"file":"y-721-male-v3.m4a","bytes":409358,"sha256":"a3a14a7de500b593712c257b40d0c8ccd5fa544ff26594e26cf42d2f7659dfed","duration":61.1},"female":{"file":"y-721-female-v3.m4a","bytes":426539,"sha256":"01b27cdce835ef8e032ad560ee6edd6879e1242f1c89e3b23f445f279e55a3d2","duration":61.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.498,"text":"OJO nla l'eyi je","marked":"Ọjọ́ ńlá l'èyí jẹ́"},{"start":1.948,"end":3.276,"text":"T'a nse Ajodun wa","marked":"T'á ńṣe Àjọ̀dún wa"},{"start":3.726,"end":5.447,"text":"Kerubu.., e ho ye","marked":"Kérúbù , ẹ hó yẹ"},{"start":5.897,"end":7.632,"text":"Serafu, e gberin.","marked":"Séráfù, ẹ gberin."}],"end":7.632},{"key":"CHORUS","start":8.582,"lines":[{"start":8.582,"end":10.41,"text":"Halleluyah, Halleluyah","marked":"Hallelúyà, Hallelúyà"},{"start":10.86,"end":11.788,"text":"S'Oba wa","marked":"S'Ọba wa"},{"start":12.238,"end":13.602,"text":"Eniti o da wa si","marked":"Ẹnití ó dá wa sí"},{"start":14.052,"end":15.427,"text":"LAti tun ri odun yi","marked":"Láti tún rí ọdún yí"},{"start":15.877,"end":17.231,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":17.231},{"key":"2","start":18.181,"lines":[{"start":18.181,"end":19.159,"text":"Orun pe l'Osupa","marked":"Ọ̀run pé l'Òṣùpá"},{"start":19.609,"end":20.913,"text":"E fi ayo nyin han","marked":"Ẹ fi ayọ̀ yín hàn"},{"start":21.363,"end":22.72,"text":"F'emi wa to d'oni","marked":"F'èmi wá tó d'óní"},{"start":23.17,"end":24.479,"text":"Larin Egbe Kerubu.","marked":"Lárin Ẹgbẹ́ Kérúbù."}],"end":24.479},{"key":"3","start":25.429,"lines":[{"start":25.429,"end":26.55,"text":"Sure fun wa loni","marked":"Súre fún wa lónì"},{"start":27.0,"end":28.104,"text":"Baba Mimo t'orun","marked":"Baba Mímọ́ t'ọ̀run"},{"start":28.554,"end":29.745,"text":"Ma je ki a rahun","marked":"Má jẹ́ kí a ráhùn"},{"start":30.195,"end":31.374,"text":"Nikehin aiye wa.","marked":"Níkẹ̀hìn ayé wà."}],"end":31.374},{"key":"4","start":32.324,"lines":[{"start":32.324,"end":33.37,"text":"lru Egbe Seraf'","marked":"Irú Ẹgbẹ́ Seraf"},{"start":33.82,"end":34.947,"text":"Larin Ilu Afrika","marked":"Lárin Ìlú Afrika"},{"start":35.397,"end":36.443,"text":"Igba wa sunmole","marked":"Ìgbà wá súnmọ́lẹ̀"},{"start":36.893,"end":38.194,"text":"T'ao bo l'oko eru.","marked":"T'àò bọ́ l'oko ẹrú."}],"end":38.194},{"key":"5","start":39.144,"lines":[{"start":39.144,"end":40.318,"text":"A dupe, Oluwa","marked":"A dúpẹ́, Olúwa"},{"start":40.768,"end":42.041,"text":"Fun Ajodun oni","marked":"Fún Àjọ̀dún òní"},{"start":42.491,"end":43.662,"text":"T'o s'oju emi wa","marked":"T'ó s'ojú èmi wá"},{"start":44.112,"end":45.377,"text":"Lori 'le alaye.","marked":"Lórí lé àlàyé."}],"end":45.377},{"key":"6","start":46.327,"lines":[{"start":46.327,"end":47.807,"text":"Ajodun nla kan mbe","marked":"Àjọ̀dún ńlá kan mbẹ́"},{"start":48.257,"end":49.452,"text":"T'a o se loke Orun","marked":"T'a ó ṣe lókè Ọ̀run"},{"start":49.902,"end":50.831,"text":"Pelu awon Mimo","marked":"Pẹ̀lú àwọn Mímọ́"},{"start":51.281,"end":52.252,"text":"Fun iyin Oluwa.","marked":"Fún ìyìn Olúwa."}],"end":52.252},{"key":"7","start":53.202,"lines":[{"start":53.202,"end":54.398,"text":"A dupe, Oluwa","marked":"A dúpẹ́, Olúwa"},{"start":54.848,"end":55.983,"text":"Pe O ti gbo tiwa","marked":"Pé Ó ti gbọ́ tiwa"},{"start":56.433,"end":57.684,"text":"Ma jek'a d'ese mo","marked":"Má jẹ́k'á d'ẹ̀ṣẹ̀ mọ́"},{"start":58.134,"end":59.508,"text":"K'a l'ayo nikehin.","marked":"K'á l'ayọ̀ níkẹ̀hìn."}],"end":59.508}]}