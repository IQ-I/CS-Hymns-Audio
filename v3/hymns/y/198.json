{"v":3,"coll":"y","num":198,"id":"hymn_198","title":"A YIN O, Baba orun","duration":73.706,"voices":{"male":{"file":"y-198-male-v3.m4a","bytes":518889,"sha256":"c9a33afe8df7cd615246d6933dd818ef5512b109ebbae70249b0ee263436200d","duration":73.8},"female":{"file":"y-198-female-v3.m4a","bytes":541543,"sha256":"661eec02616414cc89a9af93c44651611db49dd5f56ffd66aa2953a3c11bbf81","duration":73.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.238,"text":"1 A YIN Ọ, Baba ọrun;","marked":"1 A Yìn Ọ́, Baba ọ̀run"},{"start":2.688,"end":3.89,"text":"T'O ran 'mọlẹ w'ayé,","marked":"T'Ó rán 'mọlẹ w'ayé"},{"start":4.34,"end":5.561,"text":"Lati wa tan 'mọlẹ Rẹ;","marked":"Láti wá tan 'mọlẹ Rẹ"},{"start":6.011,"end":7.265,"text":"Si okunkun ayé;","marked":"Sí òkùnkùn ayé"},{"start":7.715,"end":9.031,"text":"Angẹli ń kọrin wi pé;","marked":"Áńgẹ́lì ń kọrin wí pé"},{"start":9.481,"end":10.641,"text":"Ogo f'Ọba t'a bi,","marked":"Ògo f'Ọba t'á bí"},{"start":11.091,"end":12.504,"text":"Ni ilu nla Dafidi;","marked":"Ní ìlú ńlá Dafidi"},{"start":12.954,"end":14.386,"text":"Ti ń se Krist' Oluwa.","marked":"Tí ń ṣe Krist Olúwa."}],"end":14.386},{"key":"2","start":15.336,"lines":[{"start":15.336,"end":16.581,"text":"K'ẹda ayé ko gberin,","marked":"K'ẹ̀dà ayé kò gbẹ̀rin"},{"start":17.031,"end":18.759,"text":"K'ẹda ọrun gberin,","marked":"K'ẹ̀dà ọ̀run gberin"},{"start":19.209,"end":20.538,"text":"S'ọmọ Mimọ Dafidi,","marked":"S'ọ́mọ Mímọ́ Dafidi"},{"start":20.988,"end":22.193,"text":"Ọmọ ti ileri,","marked":"Ọmọ ti ìlérí"},{"start":22.643,"end":23.756,"text":"Yin ọmọ Alade nla,","marked":"Yin ọmọ Aládé ńlá"},{"start":24.206,"end":25.278,"text":"Ade alafia,","marked":"Adé àlàáfíà"},{"start":25.728,"end":26.914,"text":"K'ibukun ọjọ oni,","marked":"K'ìbùkún ọjọ́ òní"},{"start":27.364,"end":28.687,"text":"Ko kari gbogbo wa.","marked":"Kò kárí gbogbo wa."}],"end":28.687},{"key":"3","start":29.637,"lines":[{"start":29.637,"end":30.59,"text":"O wa ninu irẹlẹ,","marked":"Ó wà nínú ìrẹ̀lẹ̀"},{"start":31.04,"end":32.388,"text":"Lati ko wa lẹkọ,","marked":"Láti kọ́ wá lẹ́kọ̀"},{"start":32.838,"end":34.249,"text":"K'a tẹle 'pa ẹsẹ Rẹ,","marked":"K'á tẹ̀lé pa ẹsẹ̀ Rẹ"},{"start":34.699,"end":35.844,"text":"Ka le gba 'leri Rẹ,","marked":"Ká lè gbà lérí Rẹ"},{"start":36.294,"end":38.45,"text":"Gbọ, ẹda ọrun ń kọrin,","marked":"Gbọ́, ẹ̀dá ọ̀run ń kọrin"},{"start":38.9,"end":39.879,"text":"Iyin f'Olugbala,","marked":"Ìyìn f'Olùgbàlà"},{"start":40.329,"end":41.784,"text":"Alafia l'ayé yi,","marked":"Àlàáfíà l'ayé yí"},{"start":42.234,"end":43.534,"text":"Baba ba wa laja.","marked":"Baba bá wà làjà."}],"end":43.534},{"key":"4","start":44.484,"lines":[{"start":44.484,"end":45.704,"text":"O tu igbekun silẹ,","marked":"Ó tú ìgbèkùn sílẹ̀"},{"start":46.154,"end":47.301,"text":"O sọ wa di Tirẹ,","marked":"Ó sọ wá di Tìrẹ"},{"start":47.751,"end":49.304,"text":"K'a ma d'ẹru ẹsẹ mọ,","marked":"K'á má d'ẹ̀rù ẹsẹ̀ mọ́"},{"start":49.754,"end":50.81,"text":"K'a d'ẹni igbala;","marked":"K'á d'ẹni ìgbàlà"},{"start":51.26,"end":53.103,"text":"Iyin, Ola, Agbara,","marked":"Ìyìn, Ọlá, Agbára"},{"start":53.553,"end":54.778,"text":"Ni fun Baba loke,","marked":"Ní fún Baba lókè"},{"start":55.228,"end":56.334,"text":"Ogo ni fun Ọmọ Rẹ,","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":56.784,"end":57.93,"text":"Ni fun Ẹmi Mimọ.","marked":"Ní fún Ẹ̀mí Mímọ́."}],"end":57.93},{"key":"5","start":58.88,"lines":[{"start":58.88,"end":60.573,"text":"Kérúbù oun Serafu","marked":"Kérúbù òun Séráfù"},{"start":61.023,"end":62.382,"text":"So fun arayé pe","marked":"Sọ fún arayé pé"},{"start":62.832,"end":64.425,"text":"Ijoba Olorun 'Gba Jesu","marked":"Ìjọba Ọlọ́run gba Jésù"},{"start":64.875,"end":65.671,"text":"y'o tun","marked":"y'ó tún"},{"start":66.121,"end":68.362,"text":"w'ayé, Bi Onidajo Nla K'a","marked":"w'ayé, Bí Onídájọ́ Ńlá K'á"},{"start":68.812,"end":70.022,"text":"le f'ayọ pade","marked":"lè f'ayọ̀ pàdé"},{"start":70.472,"end":72.157,"text":"Re Baba, gbo ebe wa.","marked":"Rẹ Baba, gbọ́ ẹ̀bẹ̀ wa."}],"end":72.157}]}