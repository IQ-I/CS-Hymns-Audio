{"v":3,"coll":"y","num":607,"id":"hymn_607","title":"LONI ni Jesu pe!","duration":27.582,"voices":{"male":{"file":"y-607-male-v3.m4a","bytes":179918,"sha256":"a014dcfce997a9a576ee3f4caf46d0e8d2ae32d4638825faff1f3b4c6cac2de3","duration":27.6},"female":{"file":"y-607-female-v3.m4a","bytes":187101,"sha256":"f8bd8f0fd9c263a2166a41a1cd9cd184546ce63fb7eca8a8aec0ceedd93f3401","duration":27.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.661,"text":"LONI ni Jesu pe!","marked":"Lónì ni Jésù pè!"},{"start":2.111,"end":3.01,"text":"Asako wa","marked":"Aṣáko wà"},{"start":3.46,"end":4.612,"text":"A! okan okunkun","marked":"A! ọkàn òkùnkùn"},{"start":5.062,"end":6.084,"text":"Ma kiri mo.","marked":"Má kiri mọ́."}],"end":6.084},{"key":"2","start":7.034,"lines":[{"start":7.034,"end":8.237,"text":"Loni Jesu pe?","marked":"Lónì Jésù pé?"},{"start":8.687,"end":9.524,"text":"Tẹti le'lẹ ;","marked":"Tẹ́tí lè'lẹ̀"},{"start":9.974,"end":11.433,"text":"Wolẹ fun Jesu, ni","marked":"Wólẹ̀ fún Jésù, ni"},{"start":11.883,"end":12.77,"text":"'Le ọwọ yi","marked":"lé ọwọ́ yí"}],"end":12.77},{"key":"3","start":13.72,"lines":[{"start":13.72,"end":15.111,"text":"Loni ni Jesu pe!","marked":"Lónì ni Jésù pè!"},{"start":15.561,"end":16.598,"text":"Sa asala;","marked":"Ṣá àsálà"},{"start":17.048,"end":18.271,"text":"Iji igbẹsan mbọ,","marked":"Ìjì ìgbẹ̀san mbọ́"},{"start":18.721,"end":19.529,"text":"Iparun mbọ","marked":"Ìparun mbọ́"}],"end":19.529},{"key":"4","start":20.479,"lines":[{"start":20.479,"end":21.604,"text":"Loni ni Emi pe!","marked":"Lónì ni Èmi pé!"},{"start":22.054,"end":22.864,"text":"Jowo 'ra re","marked":"Jọ̀wọ́ ra rẹ"},{"start":23.314,"end":24.555,"text":"Ma mu k'o binu lo","marked":"Má mú k'ó bínú lọ"},{"start":25.005,"end":26.033,"text":"Sa anu ni.","marked":"Sá àánú ni."}],"end":26.033}]}