{"v":3,"coll":"y","num":534,"id":"hymn_534","title":"KERUBU ati Serafu","duration":115.833,"voices":{"male":{"file":"y-534-male-v3.m4a","bytes":814999,"sha256":"bb00ee4ba70932b6fcc6ad200d2ed0432a19c9833933daac872b3cac624be3e6","duration":115.9},"female":{"file":"y-534-female-v3.m4a","bytes":835748,"sha256":"ab83c6faf7763dd833249b00b615d283f58247cbc7da0a4622bf5c18ea8bb960","duration":115.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.958,"text":"KERUBU ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":2.408,"end":3.532,"text":"E feran ara nyin","marked":"Ẹ fẹ́ràn ara yín"},{"start":3.982,"end":5.24,"text":"Gege bi awon ti orun","marked":"Gẹ́gẹ́ bí àwọn ti ọ̀run"},{"start":5.69,"end":6.857,"text":"Ti feran ara won.","marked":"Ti fẹ́ràn ara wọn."},{"start":7.307,"end":9.073,"text":"Egbe:  K'a gbekele Jesu Kristi","marked":"K'á gbẹ́kẹ̀lé Jésù Kristi"},{"start":9.523,"end":10.467,"text":"Oluwa Mima ni","marked":"Olúwa Mímá ni"},{"start":10.917,"end":12.448,"text":"Bi mo ti ni ife Jesus","marked":"Bí mo ti ní ìfẹ́ Jésù"},{"start":12.898,"end":14.153,"text":"Emi ko le segbe.","marked":"Èmi kò lè ṣègbé."}],"end":14.153},{"key":"CHORUS","start":15.103,"lines":[{"start":15.103,"end":16.86,"text":"K'a gbekele Jesu Kristi","marked":"K'á gbẹ́kẹ̀lé Jésù Kristi"},{"start":17.31,"end":18.308,"text":"Oluwa Mima ni","marked":"Olúwa Mímá ni"},{"start":18.758,"end":20.374,"text":"Bi mo ti ni ife Jesus","marked":"Bí mo ti ní ìfẹ́ Jésù"},{"start":20.824,"end":22.106,"text":"Emi ko le segbe.","marked":"Èmi kò lè ṣègbé."}],"end":22.106},{"key":"2","start":23.056,"lines":[{"start":23.056,"end":24.627,"text":"Ota po fun wa li laiye","marked":"Ọ̀tá pọ̀ fún wa lí láìyẹ"},{"start":25.077,"end":26.427,"text":"Ko si alabaro","marked":"Kò sí alábàrò"},{"start":26.877,"end":28.284,"text":"Jesu l'Olubanidaro","marked":"Jésù l'Olùbanidaró"},{"start":28.734,"end":29.956,"text":"On na lo le gba wa","marked":"Ọ̀n ná ló lè gbà wá"},{"start":30.406,"end":31.72,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":31.72},{"key":"3","start":32.67,"lines":[{"start":32.67,"end":34.022,"text":"Esu ti korira wa","marked":"Èṣù ti kóríra wa"},{"start":34.472,"end":35.573,"text":"O fe mu wa dani","marked":"Ó fẹ́ mú wa dáni"},{"start":36.023,"end":37.911,"text":"Sugbon ewo la o se","marked":"Ṣùgbọ́n èwo la ó ṣe"},{"start":38.361,"end":39.635,"text":"Jesu ti pelu wa.","marked":"Jésù ti pẹ̀lú wa."},{"start":40.085,"end":41.467,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":41.467},{"key":"4","start":42.417,"lines":[{"start":42.417,"end":43.892,"text":"Jesu ti segun esu","marked":"Jésù ti ṣẹ́gun èṣù"},{"start":44.342,"end":45.603,"text":"L'or'oke Kalfari","marked":"L'ór'òkè Kalfárì"},{"start":46.053,"end":47.258,"text":"Oluwa segun fun wa","marked":"Olúwa ṣẹ́gun fún wa"},{"start":47.708,"end":49.127,"text":"Ka le bori ota wa.","marked":"Ká lè borí ọ̀tá wa."},{"start":49.577,"end":50.979,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":50.979},{"key":"5","start":51.929,"lines":[{"start":51.929,"end":53.044,"text":"Olorun Orimolade","marked":"Ọlọ́run Orímọ́ládé"},{"start":53.494,"end":54.604,"text":"Jowo sanu fun wa","marked":"Jọ̀wọ́ ṣanú fún wa"},{"start":55.054,"end":56.58,"text":"K'O gba wa low'ota wa","marked":"K'Ó gbà wá lọ́w'ọ̀tá wa"},{"start":57.03,"end":58.023,"text":"Ni ona wa gbogbo.","marked":"Ní ọ̀nà wa gbogbo."},{"start":58.473,"end":59.862,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":59.862},{"key":"6","start":60.812,"lines":[{"start":60.812,"end":62.173,"text":"Li akoko iku wa","marked":"Lí àkókò ikú wá"},{"start":62.623,"end":63.71,"text":"Mu ki okan wa mo","marked":"Mú kí ọkàn wa mọ́"},{"start":64.16,"end":65.612,"text":"Ka ba le lo ri Jesu","marked":"Ká bá lè lọ rí Jésù"},{"start":66.062,"end":67.424,"text":"Lodo Baba loke.","marked":"Lọ́dọ̀ Baba lókè."},{"start":67.874,"end":69.23,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":69.23},{"key":"7","start":70.18,"lines":[{"start":70.18,"end":71.548,"text":"A ki Baba Aladura","marked":"A kí Baba Aládúrà"},{"start":71.998,"end":73.3,"text":"Ti baba gbe dide","marked":"Tí Baba gbé dìde"},{"start":73.75,"end":75.059,"text":"Ki Jesu ko ran lowo","marked":"Kí Jésù kò ràn lọ́wọ́"},{"start":75.509,"end":76.894,"text":"Ko gbe owo re soke.","marked":"Kò gbé ọwọ́ rẹ̀ sókè."},{"start":77.344,"end":78.685,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":78.685},{"key":"8","start":79.635,"lines":[{"start":79.635,"end":81.859,"text":"Jehovah Rufi, Baba","marked":"Jehovah Rufi, Baba"},{"start":82.309,"end":83.469,"text":"Gb'adura ljo yi","marked":"Gb'àdúrà Ìjọ yí"},{"start":83.919,"end":85.123,"text":"Jehovah Jire Mimo","marked":"Jehovah Jire Mímọ́"},{"start":85.573,"end":86.807,"text":"K'O mese wa duro.","marked":"K'Ó mẹ́sẹ̀ wa dúró."},{"start":87.257,"end":88.686,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":88.686},{"key":"9","start":89.636,"lines":[{"start":89.636,"end":90.879,"text":"Enyin egbe Aladura","marked":"Ẹ̀yin ẹgbẹ́ Aládúrà"},{"start":91.329,"end":92.568,"text":"E mura si ise nyin","marked":"Ẹ múra sí iṣẹ́ yín"},{"start":93.018,"end":94.393,"text":"K'e n'ife si ara nyin","marked":"K'é n'ìfẹ́ sí ara yín"},{"start":94.843,"end":96.228,"text":"Baba yio gbo ti nyin.","marked":"Baba yóò gbọ́ ti yín."},{"start":96.678,"end":98.024,"text":"Egbe:  K'a gbekele Jesu...","marked":"K'á gbẹ́kẹ̀lé Jésù"}],"end":98.024},{"key":"10","start":98.974,"lines":[{"start":98.974,"end":100.358,"text":"A f'ogo fun Baba loke","marked":"A f'ògo fún Baba lókè"},{"start":100.808,"end":101.965,"text":"A f'ogo f'Omo Re","marked":"A f'ògo f'Ọmọ Rẹ"},{"start":102.415,"end":103.791,"text":"A f'ogo F'Emi Mimo","marked":"A f'ògo F'Ẹ̀mí Mímọ́"},{"start":104.241,"end":105.603,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":106.053,"end":107.806,"text":"Egbe:  K'a gbekele Jesu Kristi","marked":"K'á gbẹ́kẹ̀lé Jésù Kristi"},{"start":108.256,"end":109.253,"text":"Oluwa Mima ni","marked":"Olúwa Mímá ni"},{"start":109.703,"end":111.222,"text":"Bi mo ti ni ife Jesus","marked":"Bí mo ti ní ìfẹ́ Jésù"},{"start":111.672,"end":114.284,"text":"Emi ko le segbe.  Amen","marked":"Èmi kò lè ṣègbé. Àmẹn"}],"end":114.284}]}