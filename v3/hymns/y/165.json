{"v":3,"coll":"y","num":165,"id":"hymn_165","title":"OLUWA Agbara f'ohun","duration":81.108,"voices":{"male":{"file":"y-165-male-v3.m4a","bytes":586070,"sha256":"1a215b3083cb56f4a203f5e05d32488c3db44169bf5c06417d35714ec50239e4","duration":81.2},"female":{"file":"y-165-female-v3.m4a","bytes":596565,"sha256":"2ec9949d30d406b45f3e80d6f09b1783fec210759aee1225f0d80daaa0e407dd","duration":81.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.501,"text":"OLUWA Agbara f'ọhun,","marked":"Olúwa Agbára f'ọ́hun"},{"start":1.951,"end":3.42,"text":"Bi ara loke Sinai","marked":"Bí ara lókè Sinai"},{"start":3.87,"end":5.124,"text":"Awon Angẹl gbohun Re,","marked":"Àwọn Angẹl gbóhùn Rẹ̀"},{"start":5.574,"end":15.311,"text":"Wọn si gbon fun iberu. Ipe ń dun, Angẹli ho, Halleluya! l'orin wọn; O ń pada bọ ninu ogo, Lati wa gba ijọba.","marked":"Wọ́n sì gbọ́n fún ìbẹ̀rù. Ìpè ń dùn, Áńgẹ́lì hó, Hallelúyà! l'orin wọn; Ó ń padà bọ̀ nínú ògo, Láti wá gba ìjọba."}],"end":15.311},{"key":"CHORUS","start":16.261,"lines":[{"start":16.261,"end":18.071,"text":"lpe ndun, Angeli ho","marked":"Ìpè ńdùn, Áńgẹ́lì hó"},{"start":18.521,"end":20.351,"text":"Halleluya! l'orin won","marked":"Hallelúyà! l'orin wọn"},{"start":20.801,"end":22.1,"text":"O npada bo ninu ogo","marked":"Ó ńpadà bọ̀ nínú ògo"},{"start":22.55,"end":23.951,"text":"Lati wa gba ijoba.","marked":"Láti wá gba ìjọba."}],"end":23.951},{"key":"2","start":24.901,"lines":[{"start":24.901,"end":26.256,"text":"Jesu Oluwa mbọ wa,","marked":"Jésù Olúwa mbọ̀ wá"},{"start":26.706,"end":27.815,"text":"Ẹ jade lọ pade Rẹ;","marked":"Ẹ jáde lọ pàdé Rẹ̀"},{"start":28.265,"end":29.688,"text":"Ọpọ yoo kun fun ayọ,","marked":"Ọ̀pọ̀ yóò kún fún ayọ̀"},{"start":30.138,"end":31.517,"text":"Ọpọ fun ibanujẹ.","marked":"Ọ̀pọ̀ fún ìbànújẹ́."}],"end":31.517},{"key":"3","start":32.467,"lines":[{"start":32.467,"end":34.383,"text":"Ọjọ 'binu, ọjọ ẹru,","marked":"Ọjọ́ bínú, ọjọ́ ẹrú"},{"start":34.833,"end":36.663,"text":"T'ayé t'ọrun yoo fo lọ;","marked":"T'ayé t'ọ̀run yóò fò lọ"},{"start":37.113,"end":38.63,"text":"Kini ẹlẹsẹ yoo se,","marked":"Kíni ẹlẹ́sẹ̀ yóò ṣe"},{"start":39.08,"end":40.444,"text":"Le yọju ni ọjọ naa?","marked":"Lè yọjú ní ọjọ́ náà?"}],"end":40.444},{"key":"4","start":41.394,"lines":[{"start":41.394,"end":42.676,"text":"Adun ayé ti buse,","marked":"Adùn ayé ti bùṣe"},{"start":43.126,"end":44.368,"text":"Mura Ijọ Séráfù,","marked":"Múra Ìjọ Séráfù"},{"start":44.818,"end":45.876,"text":"Olukore fẹrẹ de,","marked":"Olùkórè fẹ́rẹ̀ dé"},{"start":46.326,"end":47.545,"text":"Alikama ni tire.","marked":"Alikama ní tirẹ̀."}],"end":47.545},{"key":"5","start":48.495,"lines":[{"start":48.495,"end":49.849,"text":"Mase gbẹkẹle ayé,","marked":"Mase gbẹ́kẹ̀lé ayé"},{"start":50.299,"end":51.534,"text":"Ọrọ ayé a fo lọ;","marked":"Ọ̀rọ̀ ayé a fò lọ"},{"start":51.984,"end":53.321,"text":"Ẹni t'o gb'ayé m'aya,","marked":"Ẹni t'ó gb'ayé m'àyà"},{"start":53.771,"end":55.269,"text":"Y'o gun s'ebute ofo.","marked":"Y'ó gun s'èbúté ọ̀fọ̀."}],"end":55.269},{"key":"6","start":56.219,"lines":[{"start":56.219,"end":57.4,"text":"Oluwa m'awọn Tirẹ,","marked":"Olúwa m'àwọn Tìrẹ"},{"start":57.85,"end":59.053,"text":"O ti se wọn l'ayanfẹ;","marked":"Ó ti ṣe wọ́n l'àyànfẹ́"},{"start":59.503,"end":60.975,"text":"Awọn ti ko sin Jesu,","marked":"Àwọn tí kò sin Jésù"},{"start":61.425,"end":62.8,"text":"Ni yoo jẹbi nikẹhin.","marked":"Ni yóò jẹ̀bi níkẹ̀hìn."}],"end":62.8},{"key":"7","start":63.75,"lines":[{"start":63.75,"end":64.926,"text":"'Gba t'ipe 'kehin ba","marked":"gbà t'ìpè kẹ́hìn bá"},{"start":65.376,"end":66.521,"text":"dun Jewo wa Oba","marked":"dùn Jẹ́wọ́ wá Ọba"},{"start":66.971,"end":68.265,"text":"Ogo Nipa ore-ofe","marked":"Ògo Nípa oore-ọ̀fẹ́"},{"start":68.715,"end":79.56,"text":"Re Ki a le ba O gunwa. Ipe ń dun, Angẹli ho, Halleluya! l'orin wọn; O ń pada bọ ninu ogo, Lati wa gba ijọba.","marked":"Rẹ̀ Kí a lè bá Ó gúnwà. Ìpè ń dùn, Áńgẹ́lì hó, Hallelúyà! l'orin wọn; Ó ń padà bọ̀ nínú ògo, Láti wá gba ìjọba."}],"end":79.56}]}