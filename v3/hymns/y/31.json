{"v":3,"coll":"y","num":31,"id":"hymn_31","title":"Bi mo ti yo lati gb'oro","duration":48.012,"voices":{"male":{"file":"y-31-male-v3.m4a","bytes":335748,"sha256":"fbf467ac81ce74143dee9cb18bc1386e7b35610693d55c7f0ea2be6fa08c45fe","duration":48.1},"female":{"file":"y-31-female-v3.m4a","bytes":343736,"sha256":"fb11321cf04cc37d3ee3e6e7a569c9a3b10421c2397446c1cedffb9cbc7fe1f2","duration":48.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.935,"text":"Bi mo ti yo lati gb'oro","marked":"Bí mo ti yọ̀ láti gb'ọ̀rọ̀"},{"start":2.385,"end":3.325,"text":"Lenu awon ore,","marked":"Lẹ́nu àwọn ọ̀rẹ́"},{"start":3.775,"end":5.633,"text":"Pe, 'Ni Sion ni k'a pe si","marked":"Pé, ní Sion ni k'á pè sí"},{"start":6.083,"end":7.335,"text":"K'a p'ojo mimo mo.","marked":"K'á p'ọjọ́ mímọ́ mọ́."}],"end":7.335},{"key":"2","start":8.285,"lines":[{"start":8.285,"end":9.845,"text":"Mo f'ọna‘ta at'ẹkun rẹ,","marked":"Mo f'ọ̀nà'ta àt'ẹkùn rẹ̀"},{"start":10.295,"end":11.468,"text":"Ile t'a se lọsọ,","marked":"Ilẹ̀ t'á ṣe lọ́sọ́"},{"start":11.918,"end":13.426,"text":"Ile t'a kọ fun Ọlọrun","marked":"Ilẹ̀ t'a kọ́ fún Ọlọ́run"},{"start":13.876,"end":15.081,"text":"Lati fi anu han.","marked":"Láti fi àánú hàn."}],"end":15.081},{"key":"3","start":16.031,"lines":[{"start":16.031,"end":17.784,"text":"S'agbala ile ayọ naa","marked":"S'àgbàlá ilé ayọ̀ náà"},{"start":18.234,"end":19.409,"text":"Lẹya mimọ si lọ,","marked":"Lẹ́yà mímọ́ sì lọ"},{"start":19.859,"end":21.512,"text":"Ọmọ Dafid wa lor'itẹ","marked":"Ọmọ Dafid wà lór'ìtẹ́"},{"start":21.962,"end":23.299,"text":"O ń da ẹjọ nibẹ.","marked":"Ó ń dá ẹjọ́ níbẹ̀."}],"end":23.299},{"key":"4","start":24.249,"lines":[{"start":24.249,"end":25.679,"text":"O gbọ iyin at'igbe wa;","marked":"Ó gbọ́ ìyìn àt'ìgbẹ́ wa"},{"start":26.129,"end":27.078,"text":"Bi ohun ẹru rẹ,","marked":"Bí ohun ẹ̀rù rẹ"},{"start":27.528,"end":29.153,"text":"Ti n ya ẹlẹsẹ sib'egbe,","marked":"Tí ń ya ẹlẹ́sẹ̀ síb'ẹ̀gbẹ́"},{"start":29.603,"end":30.889,"text":"A ń yọ ni 'wariri.","marked":"A ń yọ̀ ní wárìrì."}],"end":30.889},{"key":"5","start":31.839,"lines":[{"start":31.839,"end":33.474,"text":"K'ibukun pẹlu ibẹ na,","marked":"K'ìbùkún pẹ̀lú ibẹ̀ ná"},{"start":33.924,"end":35.237,"text":"Ayọ nigbakugba;","marked":"Ayọ̀ nígbàkúgbà"},{"start":35.687,"end":37.303,"text":"K'a fi ọrẹ ati oore,","marked":"K'á fi ọrẹ àti oore"},{"start":37.753,"end":38.972,"text":"F'awọn ti n sin nibẹ.","marked":"F'àwọn tí ń sìn níbẹ̀."}],"end":38.972},{"key":"6","start":39.922,"lines":[{"start":39.922,"end":41.365,"text":"Ọkan mi bẹbẹ fun Sion","marked":"Ọkàn mi bẹ̀bẹ̀ fún Sion"},{"start":41.815,"end":42.868,"text":"Nigba ti emi wa;","marked":"Nígbà tí èmi wà"},{"start":43.318,"end":44.892,"text":"Nibẹ n'ibatan at'ọrẹ","marked":"Níbẹ̀ n'ìbátan àt'ọrẹ"},{"start":45.342,"end":46.463,"text":"At'Olugbala wa.","marked":"Àt'olùgbàlà wa."}],"end":46.463}]}