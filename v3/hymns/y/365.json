{"v":3,"coll":"y","num":365,"id":"hymn_365","title":"ILE ayo kan wa l'oke","duration":100.309,"voices":{"male":{"file":"y-365-male-v3.m4a","bytes":729043,"sha256":"09250ade5141034eba92b720de28086871c99c52a466983203f7faf08a04d5b3","duration":100.4},"female":{"file":"y-365-female-v3.m4a","bytes":748749,"sha256":"90ab978b055785e831058e94055129785a31add119428b870290e210ceaababd","duration":100.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.851,"text":"ILE ayọ kan wa l'oke,","marked":"Ilé ayọ̀ kan wà l'òkè"},{"start":2.301,"end":4.396,"text":"Ti o n dan ti o si l'ẹwa,","marked":"Tí ó ń dán tí ó sì l'ẹwà"},{"start":4.846,"end":6.359,"text":"Ayọ ibẹ ki si d'opin,","marked":"Ayọ̀ ibẹ̀ kí sì d'òpin"},{"start":6.809,"end":8.459,"text":"L'ọsan tabi l'oru;","marked":"L'ọ̀sán tàbí l'òru"},{"start":8.909,"end":10.044,"text":"Awọn Angẹli n kọrin,","marked":"Àwọn Áńgẹ́lì ń kọrin"},{"start":10.494,"end":11.768,"text":"Y'itẹ Mimọ na ka,","marked":"Y'ìtẹ́ Mímọ́ ná ká"},{"start":12.218,"end":13.46,"text":"Nigba wo la o ri Ọ,","marked":"Nígbà wo la ó rí Ọ"},{"start":13.91,"end":15.283,"text":"Ile to dara julọ.","marked":"Ilẹ̀ tó dára jùlọ."}],"end":15.283},{"key":"CHORUS","start":16.233,"lines":[{"start":16.233,"end":17.293,"text":"A! ile didan,","marked":"A! ilẹ̀ dídán"},{"start":17.743,"end":18.838,"text":"A! ile didan","marked":"A! ilẹ̀ dídán"},{"start":19.288,"end":20.119,"text":"Ile Olugbala,","marked":"Ilé Olùgbàlà"},{"start":20.569,"end":22.105,"text":"ile to l'ogo julo.","marked":"ilẹ̀ tó l'ògo jùlọ."}],"end":22.105},{"key":"2","start":23.055,"lines":[{"start":23.055,"end":24.8,"text":"Kérúbù ati Séráfù,","marked":"Kérúbù àti Séráfù"},{"start":25.25,"end":26.349,"text":"Ẹ jẹ k'a yin Oluwa,","marked":"Ẹ jẹ́ k'á yin Olúwa"},{"start":26.799,"end":28.318,"text":"Fun idasi wa lọjọ oni,","marked":"Fún ìdásí wa lọ́jọ́ òní"},{"start":28.768,"end":29.938,"text":"Iyin fun Mẹtalọkan;","marked":"Ìyìn fún Mẹ́talọ́kan"},{"start":30.388,"end":31.762,"text":"Se ranti p'Oluwa mbọ,","marked":"Ṣe rántí p'Olúwa mbọ́"},{"start":32.212,"end":33.66,"text":"Lati ko wa lọ sile,","marked":"Láti kó wá lọ sílẹ̀"},{"start":34.11,"end":35.314,"text":"Nigba wo la o ri Ọ,","marked":"Nígbà wo la ó rí Ọ"},{"start":35.764,"end":37.293,"text":"Ile t'o dara julọ.","marked":"Ilẹ̀ t'ó dára jùlọ."}],"end":37.293},{"key":"3","start":38.243,"lines":[{"start":38.243,"end":39.604,"text":"Kikankikan l'Oluwa n pe,","marked":"Kíkankíkan l'Olúwa ń pè"},{"start":40.054,"end":41.554,"text":"Ẹda ko si mira;","marked":"Ẹ̀dá kò sì mira"},{"start":42.004,"end":43.252,"text":"Ikore si n fẹ ka,","marked":"Ìkórè sì ń fẹ́ ká"},{"start":43.702,"end":45.081,"text":"Ẹ jẹ k'a sa fun ẹsẹ;","marked":"Ẹ jẹ́ k'á sá fún ẹsẹ̀"},{"start":45.531,"end":47.02,"text":"Ki Jesu le wẹ wa mọ,","marked":"Kí Jésù lè wẹ̀ wá mọ́"},{"start":47.47,"end":48.937,"text":"Yẹ fun 'le nla l'oke,","marked":"Yẹ fún lè ńlá l'òkè"},{"start":49.387,"end":50.545,"text":"Nigba wo la o ri Ọ,","marked":"Nígbà wo la ó rí Ọ"},{"start":50.995,"end":52.528,"text":"Ile t'o dara julọ.","marked":"Ilẹ̀ t'ó dára jùlọ."}],"end":52.528},{"key":"4","start":53.478,"lines":[{"start":53.478,"end":54.906,"text":"Awọn to ti jagun kọja,","marked":"Àwọn tó ti jagun kọjá"},{"start":55.356,"end":56.872,"text":"Wọn n wo wa bi a ti n ja,","marked":"Wọ́n ń wò wá bí a ti ń jà"},{"start":57.322,"end":59.223,"text":"Wọn mba Ọdaguntan k'ẹgbẹ,","marked":"Wọ́n mba Ọ̀dàgùntàn k'ẹ̀gbẹ́"},{"start":59.673,"end":60.941,"text":"Ọba lo si jẹ fun wọn;","marked":"Ọba ló sì jẹ́ fún wọn"},{"start":61.391,"end":62.853,"text":"Ibanujẹ ko si n'ibẹ,","marked":"Ìbànújẹ́ kò sì n'ibẹ̀"},{"start":63.303,"end":64.39,"text":"Ninu ile didan na;","marked":"Nínú ilé dídán ná"},{"start":64.84,"end":65.969,"text":"Nigba wo la o ri Ọ,","marked":"Nígbà wo la ó rí Ọ"},{"start":66.419,"end":67.865,"text":"Ile to dara julọ.","marked":"Ilẹ̀ tó dára jùlọ."}],"end":67.865},{"key":"5","start":68.815,"lines":[{"start":68.815,"end":70.161,"text":"Iwọ ki yoo jijakadi,","marked":"Ìwọ kì yóò jìjàkadì"},{"start":70.611,"end":72.003,"text":"K'o ba Olugbala jọba,","marked":"K'ó bá Olùgbàlà jọba"},{"start":72.453,"end":73.96,"text":"Nibi Kérúbù Séráfù,","marked":"Níbi Kérúbù Séráfù"},{"start":74.41,"end":75.716,"text":"Yi itẹ Olugbala ka,","marked":"Yí ìtẹ́ Olùgbàlà ká"},{"start":76.166,"end":77.167,"text":"Ibugbe Olugbala,","marked":"Ibùgbé Olùgbàlà"},{"start":77.617,"end":78.988,"text":"T'a o ma sin titi;","marked":"T'a ó má sin títí"},{"start":79.438,"end":80.557,"text":"Nigba wo la o ri Ọ,","marked":"Nígbà wo la ó rí Ọ"},{"start":81.007,"end":82.389,"text":"Ile to dara julọ","marked":"Ilẹ̀ tó dára jùlọ"}],"end":82.389},{"key":"6","start":83.339,"lines":[{"start":83.339,"end":84.802,"text":"Nigba t'o ba d'ọjọ 'kẹhin,","marked":"Nígbà t'ó bá d'ọjọ́ 'kẹhin"},{"start":85.252,"end":86.627,"text":"Ti a o si de 'jọba Rẹ,","marked":"Tí a ó sì dé 'jọba Rẹ"},{"start":87.077,"end":88.891,"text":"K'a gbọ ohun ayọ yi pe,","marked":"K'á gbọ́ ohùn ayọ̀ yí pé"},{"start":89.341,"end":90.44,"text":"Bo s'ayọ Oluwa rẹ,","marked":"Bó s'ayọ̀ Olúwa rẹ"},{"start":90.89,"end":93.715,"text":"Kérúbù, Séráfù, yọ","marked":"Kérúbù, Séráfù, yọ̀"},{"start":94.165,"end":95.213,"text":"Ẹ gb'ade iye yin;","marked":"Ẹ gb'adé iye yín"},{"start":95.663,"end":96.836,"text":"Nigba wo la o ri Ọ,","marked":"Nígbà wo la ó rí Ọ"},{"start":97.286,"end":98.761,"text":"Ile to dara julọ.","marked":"Ilẹ̀ tó dára jùlọ."}],"end":98.761}]}