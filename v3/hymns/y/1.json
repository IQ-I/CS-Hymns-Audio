{"v":3,"coll":"y","num":1,"id":"hymn_1","title":"Ji, okan mi, ba orun ji","duration":34.272,"voices":{"male":{"file":"y-1-male-v3.m4a","bytes":239122,"sha256":"cc3f52ed1a1d49ef6979737fac5f55fa9f8d90125551a8c3da14383e04115a2a","duration":34.3},"female":{"file":"y-1-female-v3.m4a","bytes":241933,"sha256":"bdc05bd281db3ecf1a9b102b16d245ebe17d78fc903bba481ec37979d0a11cc0","duration":34.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.429,"text":"JI, ọkan mi, ba orun ji","marked":"Jí, ọkàn mi, bá ọ̀run jí"},{"start":2.879,"end":4.214,"text":"Mura si isẹ oojọ rẹ;","marked":"Múra sí isẹ́ òòjọ́ rẹ"},{"start":4.664,"end":6.833,"text":"Mase ilọra, ji kutu,","marked":"Máṣe ìlọra, jí kùtù"},{"start":7.283,"end":8.638,"text":"K'o san gbese ẹbọ oorọ.","marked":"K'ó san gbèsè ẹbọ oorọ."}],"end":8.638},{"key":"2","start":9.588,"lines":[{"start":9.588,"end":11.248,"text":"Ro gbogb' ọjọ t'o fi sofo;","marked":"Rọ gbogb ọjọ́ t'ó fi ṣọ̀fọ̀"},{"start":11.698,"end":12.893,"text":"Bẹrẹ si rere 'se loni;","marked":"Bẹ̀rẹ̀ sí rere ṣe lónì"},{"start":13.343,"end":14.735,"text":"Kiyes' irin rẹ laye yi;","marked":"Kíyès irin rẹ̀ láyé yí"},{"start":15.185,"end":16.969,"text":"K'o si mura d'ọjọ nla ni.","marked":"K'ó sì múra d'ọjọ́ ńlá ni."}],"end":16.969},{"key":"3","start":17.919,"lines":[{"start":17.919,"end":19.064,"text":"Gba ninu imọlẹ ọrun,","marked":"Gbà nínú ìmọ́lẹ̀ ọ̀run"},{"start":19.514,"end":20.926,"text":"Si tan 'mọlẹ na f'ẹlomi,","marked":"Sì tan 'mọlẹ ná f'ẹlòmí"},{"start":21.376,"end":22.473,"text":"Jẹ ki ogo Ọlọrun rẹ,","marked":"Jẹ́ kí ògo Ọlọ́run rẹ"},{"start":22.923,"end":24.33,"text":"Han n'nu wa ati ise rẹ.","marked":"Hàn n'nù wá àti iṣẹ́ rẹ̀."}],"end":24.33},{"key":"4","start":25.28,"lines":[{"start":25.28,"end":26.927,"text":"Ji, gbọn 'ra nu 'wọ ọkan mi","marked":"Jí, gbọ́n rà nù 'wọ ọkàn mi"},{"start":27.377,"end":29.005,"text":"Yan ipo rẹ larin Angẹl,","marked":"Yan ipò rẹ̀ lárin Angẹl"},{"start":29.455,"end":30.718,"text":"Awọn ti wọn n kọrin iyin,","marked":"Àwọn tí wọ́n ń kọrin ìyìn"},{"start":31.168,"end":32.723,"text":"Ni gbogbo oru s'Ọba wa.","marked":"Ní gbogbo òru s'Ọba wa."}],"end":32.723}]}