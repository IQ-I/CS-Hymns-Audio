{"v":3,"coll":"y","num":87,"id":"hymn_87","title":"OPE lo ye f'Olugbala","duration":67.72,"voices":{"male":{"file":"y-87-male-v3.m4a","bytes":476058,"sha256":"abb28fe40f299e46a3c6c7ccb5b10e58543229a6f1b1dbc15fe325c7fbf03954","duration":67.8},"female":{"file":"y-87-female-v3.m4a","bytes":487538,"sha256":"708263eb145673d5a82b45a4967ab2d8c2d8f3325dbb66cb5779201df2a65f6d","duration":67.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.8,"text":"OPE lo ye f'Olugbala","marked":"Ọpẹ́ ló yẹ f'Olùgbàlà"},{"start":2.25,"end":3.404,"text":"Iyin fun Metalokan","marked":"Ìyìn fún Mẹ́talọ́kan"},{"start":3.854,"end":5.267,"text":"T'O da wa si d'ojo oni,","marked":"T'Ó dá wa sì d'ọjọ́ òní"},{"start":5.717,"end":7.044,"text":"A f'ogo f'oruko Re. Kọrin Ogo, Alleluya, Orin ogo la o kọ, Kọrin Ogo, Alleluya, Kọ Hossanah s'Ọba wa.","marked":"A f'ògo f'orúkọ Rẹ̀. Kọrin Ògo, Allelúyà, Orin ògo la ó kọ, Kọrin Ògo, Allelúyà, Kọ Hossanah s'Ọba wa."}],"end":7.044},{"key":"CHORUS","start":7.994,"lines":[{"start":7.994,"end":10.283,"text":"Korin Ogo, Alleluya,","marked":"Kọrin Ògo, Allelúyà"},{"start":10.733,"end":12.03,"text":"Orin ogo lao ko","marked":"Orin ògo láó kọ"},{"start":12.48,"end":14.834,"text":"Korin Ogo, Alleluyah,","marked":"Kọrin Ògo, Alleluyah"},{"start":15.284,"end":16.721,"text":"Ko Hosannah s'Oba wa.","marked":"Kò Hosannah s'Ọba wa."}],"end":16.721},{"key":"2","start":17.671,"lines":[{"start":17.671,"end":19.514,"text":"Mẹtalọkan Ọba Ogo,","marked":"Mẹ́talọ́kan Ọba Ògo"},{"start":19.964,"end":21.31,"text":"Baba fun wa l'agbara,","marked":"Baba fún wa l'agbára"},{"start":21.76,"end":23.114,"text":"F'awọn asaju n'isẹgun,","marked":"F'àwọn aṣájú n'ìsẹ̀gùn"},{"start":23.564,"end":25.167,"text":"Fun wọn l'ọgbọn at'oye.","marked":"Fún wọn l'ọgbọ́n àt'òye."}],"end":25.167},{"key":"3","start":26.117,"lines":[{"start":26.117,"end":27.483,"text":"Ọbangiji Ọba Ogo,","marked":"Ọbangijì Ọba Ògo"},{"start":27.933,"end":29.269,"text":"Ranti Ẹgbẹ Aladaura;","marked":"Rántí Ẹgbẹ́ Aládáúrà"},{"start":29.719,"end":31.334,"text":"Fun wọn l'agbara at'ifẹ","marked":"Fún wọn l'agbára àt'ìfẹ́"},{"start":31.784,"end":33.278,"text":"Ko wọn l'adura t'ọrun.","marked":"Kò wọn l'àdúrà t'ọ̀run."}],"end":33.278},{"key":"4","start":34.228,"lines":[{"start":34.228,"end":35.835,"text":"Jehovah-Nissi Ọba wa,","marked":"Jehovah-nissi Ọba wa"},{"start":36.285,"end":37.51,"text":"Saanu f'Ẹgbẹ Séráfù;","marked":"Ṣàánú f'Ẹgbẹ́ Séráfù"},{"start":37.96,"end":39.673,"text":"F'isẹgun f'Ẹgbẹ Kérúbù,","marked":"F'ìsẹ̀gùn f'Ẹgbẹ́ Kérúbù"},{"start":40.123,"end":41.552,"text":"Se wa gẹgẹ bi t'ọrun.","marked":"Ṣe wà gẹ́gẹ́ bí t'ọ̀run."}],"end":41.552},{"key":"5","start":42.502,"lines":[{"start":42.502,"end":43.888,"text":"Awọn ti ko ri'se yoo ri,","marked":"Àwọn tí kò rí'ṣe yóò rí"},{"start":44.338,"end":45.604,"text":"Agan a f'ọwọ s'osun;","marked":"Àgàn a f'ọwọ́ s'oṣùn"},{"start":46.054,"end":47.322,"text":"Ọlọmọ ko ni padanu","marked":"Ọlọ́mọ kò ní pàdánù"},{"start":47.772,"end":49.385,"text":"Alaisan yoo dide.","marked":"Aláìsàn yóò dìde."}],"end":49.385},{"key":"6","start":50.335,"lines":[{"start":50.335,"end":51.74,"text":"Gbọ tiwa Baba wa ọrun,","marked":"Gbọ́ tiwa Baba wa ọ̀run"},{"start":52.19,"end":53.356,"text":"Ranti Ẹgbẹ idalẹ;","marked":"Rántí Ẹgbẹ́ ìdálẹ̀"},{"start":53.806,"end":55.413,"text":"Fun wọn l'agbara at'ipa,","marked":"Fún wọn l'agbára àt'ipá"},{"start":55.863,"end":57.285,"text":"Fun gbogbo wa n'isẹgun.","marked":"Fún gbogbo wa n'ìsẹ̀gùn."}],"end":57.285},{"key":"7","start":58.235,"lines":[{"start":58.235,"end":59.655,"text":"Jehovah Shammah Oba wa,","marked":"Jehovah Ṣhammah Ọba wa"},{"start":60.105,"end":61.886,"text":"Gba t'o ba d'ojo ikẹyin;","marked":"Gba t'ó bá d'ọjọ́ ìkẹyìn"},{"start":62.336,"end":64.138,"text":"Mu wa d'agbala itura,","marked":"Mú wa d'àgbàlá ìtura"},{"start":64.588,"end":66.172,"text":"JAH mu wa de'tẹ Ogo.","marked":"Jah mú wa dé'tẹ̀ Ògo."}],"end":66.172}]}