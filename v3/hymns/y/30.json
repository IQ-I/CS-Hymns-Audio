":30.109,"text":"L'ọjọ Rẹ mimọ yi:","marked":"L'ọjọ́ Rẹ mímọ́ yí"},{"start":30.559,"end":32.012,"text":"Bukun ọrọ t'a gbọ,","marked":"Bùkún ọ̀rọ̀ t'á gbọ́"},{"start":32.462,"end":33.519,"text":"L'ọjọ Rẹ mimọ yi;","marked":"L'ọjọ́ Rẹ mímọ́ yí"},{"start":33.969,"end":35.414,"text":"Ba wa lọ gba t'a lọ,","marked":"Bá wa lọ gba t'á lọ"},{"start":35.864,"end":37.104,"text":"F'ore Igbala Rẹ,","marked":"F'ọrẹ Ìgbàlà Rẹ"},{"start":37.554,"end":39.096,"text":"Si aya wa gbogbo","marked":"Sí aya wá gbogbo"},{"start":39.546,"end":40.635,"text":"L'ọjọ Rẹ mimọ yii.","marked":"L'ọjọ́ Rẹ mímọ́ yìí."}],"end":40.635}]}