{"v":3,"coll":"y","num":410,"id":"hymn_410","title":"OJU kan mbe ti ki togbe","duration":50.93,"voices":{"male":{"file":"y-410-male-v3.m4a","bytes":356591,"sha256":"4914cbebbc78c3b21a5a85e29cc36cac46b2dc7d80ea902bd812f632bed7a726","duration":51.0},"female":{"file":"y-410-female-v3.m4a","bytes":373192,"sha256":"c579ff9f4b5096f6d5bd1a45d76ac4a1aa8812750517bf83aae392eca8fd4f0b","duration":51.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.036,"text":"OJU kan mbẹ ti ki togbe,","marked":"Ojú kan mbẹ́ tí kí tọ́gbẹ́"},{"start":2.486,"end":3.757,"text":"Nigba t'ilẹ ba su;","marked":"Nígbà t'ilẹ̀ bá ṣú"},{"start":4.207,"end":6.056,"text":"Eti kan mbẹ ti ki ise,","marked":"Etí kan mbẹ́ tí kí iṣẹ́"},{"start":6.506,"end":7.809,"text":"'Gbati orun ba wọ.","marked":"gbàtí ọ̀run bá wọ̀."}],"end":7.809},{"key":"2","start":8.759,"lines":[{"start":8.759,"end":10.314,"text":"Apa kan mbẹ ti ko le rẹ,","marked":"Apá kan mbẹ́ tí kò lè rẹ̀"},{"start":10.764,"end":12.137,"text":"'Gbat 'pa eniyan pin;","marked":"gbàt pa ènìyàn pín"},{"start":12.587,"end":14.293,"text":"Ifẹ kan mbẹ ti ko le ku,","marked":"Ìfẹ́ kan mbẹ́ tí kò lè kú"},{"start":14.743,"end":16.124,"text":"'Gba 'fẹ ayé ba ku.","marked":"gbà 'fẹ ayé bá kú."}],"end":16.124},{"key":"3","start":17.074,"lines":[{"start":17.074,"end":18.92,"text":"Oju na n wo awọn Séráfù,","marked":"Ojú ná ń wo àwọn Séráfù"},{"start":19.37,"end":20.569,"text":"Apa naa d'ọrun mu;","marked":"Apá náà d'ọ̀run mú"},{"start":21.019,"end":22.526,"text":"Eti na kun f'orin Angel,","marked":"Etí nà kún f'orin Angẹl"},{"start":22.976,"end":24.186,"text":"Ifẹ naa ga loke.","marked":"Ìfẹ́ náà ga lókè."}],"end":24.186},{"key":"4","start":25.136,"lines":[{"start":25.136,"end":26.522,"text":"Ipa kan l'eniyan lo,","marked":"Ipa kan l'ènìyàn lọ"},{"start":26.972,"end":28.27,"text":"'Gba t'ipa gbogbo pin;","marked":"gba t'ipa gbogbo pín"},{"start":28.72,"end":30.672,"text":"Lati ri oju at'apa,","marked":"Láti rí ojú àt'apá"},{"start":31.122,"end":32.402,"text":"Ati ifẹ nla na.","marked":"Àti ìfẹ́ ńlá ná."}],"end":32.402},{"key":"5","start":33.352,"lines":[{"start":33.352,"end":34.988,"text":"Ipa naa ni adura wa,","marked":"Ipa náà ni àdúrà wa"},{"start":35.438,"end":36.874,"text":"Ti n lo 'waju itẹ;","marked":"Tí ń lọ wájú ìtẹ́"},{"start":37.324,"end":39.222,"text":"f To n mi ọwọ t'o s'ayé ro,","marked":"f Tó ń mi ọwọ́ t'ó s'ayé rò"},{"start":39.672,"end":40.916,"text":"Lati mu 'gbala wa.","marked":"Láti mú gbàlà wá."}],"end":40.916},{"key":"6","start":41.866,"lines":[{"start":41.866,"end":43.455,"text":"Iwo t'anu re ko lopin","marked":"Ìwọ t'àánú rẹ̀ kò lópin"},{"start":43.905,"end":45.2,"text":"T'ife Re ko le ku","marked":"T'ìfẹ́ Rẹ kò lè kú"},{"start":45.65,"end":47.521,"text":"Je k'a n'igbagbo at'ife","marked":"Jẹ́ k'á n'ìgbàgbọ́ àt'ìfẹ́"},{"start":47.971,"end":49.381,"text":"K'a le ma gbadura.","marked":"K'á lè má gbàdúrà."}],"end":49.381}]}