{"v":3,"coll":"y","num":830,"id":"hymn_830","title":"MO fe ki n dabi Jesu","duration":47.511,"voices":{"male":{"file":"y-830-male-v3.m4a","bytes":328231,"sha256":"a790109c9a29cb9515e663790ee7317004ae408696e7cdcba2700a67db02689f","duration":47.6},"female":{"file":"y-830-female-v3.m4a","bytes":342568,"sha256":"27b3c8025e7f3dee5e974e5c4a5d8d5ef9200320259ee17937bf2854e58f2cca","duration":47.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.797,"text":"MO fẹ ki n dabi Jesu,","marked":"Mo fẹ́ kí n dàbí Jésù"},{"start":2.247,"end":3.401,"text":"Ninu iwa pẹlẹ;","marked":"Nínú ìwà pẹ̀lẹ́"},{"start":3.851,"end":5.329,"text":"Ko s'ẹni t'o gbọrọ 'binu,","marked":"Kò s'ẹni t'ó gbọ́rọ̀ bínú"},{"start":5.779,"end":6.822,"text":"Lẹnu Rẹ lẹkan ri.","marked":"Lẹ́nu Rẹ̀ lẹ́kàn rí."}],"end":6.822},{"key":"2","start":7.772,"lines":[{"start":7.772,"end":9.309,"text":"Mo fẹ ki n dabi Jesu,","marked":"Mo fẹ́ kí n dàbí Jésù"},{"start":9.759,"end":11.149,"text":"L'adura 'gba gbogbo,","marked":"L'àdúrà gba gbogbo"},{"start":11.599,"end":13.029,"text":"L'ori oke ni Oun nikan,","marked":"L'orí òkè ni Òun nìkan"},{"start":13.479,"end":14.623,"text":"Lọ pade Baba Rẹ","marked":"Lọ pàdé Baba Rẹ"}],"end":14.623},{"key":"3","start":15.573,"lines":[{"start":15.573,"end":17.091,"text":"Mo fẹ ki n dabi Jesu,","marked":"Mo fẹ́ kí n dàbí Jésù"},{"start":17.541,"end":18.69,"text":"Emi ko ri ka pe,","marked":"Èmi kò rí ká pé"},{"start":19.14,"end":20.379,"text":"Bi wọn ti korira Rẹ to,","marked":"Bí wọ́n ti kórìra Rẹ̀ tó"},{"start":20.829,"end":22.088,"text":"O s'ẹnikan n'ibi.","marked":"Ó s'ẹ́nìkan n'ibi."}],"end":22.088},{"key":"4","start":23.038,"lines":[{"start":23.038,"end":24.503,"text":"Mo fẹ ki n dabi Jesu,","marked":"Mo fẹ́ kí n dàbí Jésù"},{"start":24.953,"end":25.993,"text":"Ninu isẹ rere;","marked":"Nínú isẹ́ rere"},{"start":26.443,"end":28.115,"text":"K'a le wi nipa temi pe,","marked":"K'á lè wí nípa tèmi pé"},{"start":28.565,"end":29.723,"text":"O se 'wọn t'o le se.","marked":"Ó ṣe 'wọn t'ó lè ṣe."}],"end":29.723},{"key":"5","start":30.673,"lines":[{"start":30.673,"end":32.259,"text":"Mo fẹ ki n dabi Jesu,","marked":"Mo fẹ́ kí n dàbí Jésù"},{"start":32.709,"end":34.091,"text":"T'o f'iyọnu wi pé,","marked":"T'ó f'ìyọnu wí pé"},{"start":34.541,"end":36.156,"text":"Jẹ k'ọmọde wa sọdọ Mi‖,","marked":"Jẹ́ k'ọmọdé wá sọ́dọ̀ Mi‖"},{"start":36.606,"end":37.988,"text":"Mo fẹ jẹ ipe Rẹ.","marked":"Mo fẹ́ jẹ́ ìpè Rẹ."}],"end":37.988},{"key":"6","start":38.938,"lines":[{"start":38.938,"end":40.501,"text":"Sugbọn n ko dabi Jesu,","marked":"Sùgbọ́n n kò dàbí Jésù"},{"start":40.951,"end":42.165,"text":"O si han gbangba bẹ;","marked":"Ó sì hàn gbangba bẹ̀"},{"start":42.615,"end":44.187,"text":"Jesu fun mi l'ore-ọfẹ,","marked":"Jésù fún mi l'ore-ọfẹ"},{"start":44.637,"end":45.961,"text":"Se mi ki n dabi Rẹ.","marked":"Ṣé mi kí n dàbí Rẹ."}],"end":45.961}]}