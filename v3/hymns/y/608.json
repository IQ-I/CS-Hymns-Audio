{"v":3,"coll":"y","num":608,"id":"hymn_608","title":"NIGBAT' idanwo yi mi ka","duration":69.82,"voices":{"male":{"file":"y-608-male-v3.m4a","bytes":489379,"sha256":"c3147b1253c0a7bb7b179fcd3c3d2045a82a7a3788198c3a75be4f195af0e937","duration":69.9},"female":{"file":"y-608-female-v3.m4a","bytes":508416,"sha256":"73901a9488cdb0f1f9c9a03554556e487af6003d4435243901045305b698b196","duration":69.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.792,"text":"NlGBAT' idanwo yi mi ka","marked":"Nlgbat ìdánwò yí mi ká"},{"start":2.242,"end":3.395,"text":"Ti idamu aiye mu mi","marked":"Tí ìdàmú ayé mú mi"},{"start":3.845,"end":5.607,"text":"T'ota fara han bi ore","marked":"T'ọ̀tá fara hàn bí ọrẹ"},{"start":6.057,"end":7.513,"text":"Lati wa iparun fim mi.","marked":"Láti wá ìparun fím mi."}],"end":7.513},{"key":"CHORUS","start":8.463,"lines":[{"start":8.463,"end":10.255,"text":"OIuwa, jo ma sai pe mi","marked":"Olúwa, jọ má ṣàì pè mí"},{"start":10.705,"end":12.991,"text":"B'o ti pe Adam nin'ogba","marked":"B'ó ti pe Adam nín'ọgbà"},{"start":13.441,"end":14.859,"text":"Pe' Nibo I'o wa elese?","marked":"Pé Níbo l'ó wá ẹlẹ́ṣẹ̀?"},{"start":15.309,"end":16.909,"text":"Ki nIe bo ninu ebi na.","marked":"Kí ńlè bọ̀ nínú ebi ná."}],"end":16.909},{"key":"2","start":17.859,"lines":[{"start":17.859,"end":19.252,"text":"Nigbat'Esu n'nu 'tanje re","marked":"Nígbàt'èṣù n'nú tànjẹ rẹ̀"},{"start":19.702,"end":21.08,"text":"Gbe mi gori oke aiye","marked":"Gbé mi gorí òkè ayé"},{"start":21.53,"end":23.137,"text":"T'o ni ki nteriba fun on","marked":"T'ó ni kí ńtẹríba fún ọn"},{"start":23.587,"end":24.951,"text":"K'ohun aiye le je temi","marked":"K'ohun ayé lè jẹ́ tèmi"}],"end":24.951},{"key":"3","start":25.901,"lines":[{"start":25.901,"end":27.366,"text":"Gbat' ogo aiye ba fe fi","marked":"Gbàt ògo ayé bá fẹ́ fi"},{"start":27.816,"end":29.125,"text":"Tulasi mu mi rufin Re","marked":"Tulasi mú mi rufin Rẹ̀"},{"start":29.575,"end":31.0,"text":"To duro gangan lehin mi","marked":"Tó dúró gangan lẹ́hìn mi"},{"start":31.45,"end":33.086,"text":"Ni ileri pe'Ko si nkan.","marked":"Ní ìlérí pé'kò sí nǹkan."}],"end":33.086},{"key":"4","start":34.036,"lines":[{"start":34.036,"end":35.363,"text":"Nigbati igbekele mi","marked":"Nígbàtí ìgbẹ́kẹ̀lé mi"},{"start":35.813,"end":37.545,"text":"Di t'ogun ati t'orisa","marked":"Di t'ogun àti t'òrìṣà"},{"start":37.995,"end":39.539,"text":"T'ogede di adura mi","marked":"T'ọ̀gẹ̀dẹ̀ di àdúrà mi"},{"start":39.989,"end":41.56,"text":"Ti ofo di ajisa mi.","marked":"Tí ọ̀fọ̀ di àjíṣà mi."}],"end":41.56},{"key":"5","start":42.51,"lines":[{"start":42.51,"end":43.861,"text":"Nigbati mo fe lati rin","marked":"Nígbàtí mo fẹ́ láti rìn"},{"start":44.311,"end":46.276,"text":"L'adamo at'ife n'nu mi","marked":"L'adamọ́ àt'ìfẹ́ n'nú mi"},{"start":46.726,"end":48.328,"text":"T'okan mi nse hila-hilo","marked":"T'ọkàn mi ńṣe hila-hilo"},{"start":48.778,"end":51.271,"text":"Ti nko gbona, ti nko tutu.","marked":"Tí ńkọ́ gbóná, tí ńkọ́ tútù."}],"end":51.271},{"key":"6","start":52.221,"lines":[{"start":52.221,"end":53.461,"text":"Nigba mo sonu bi aja","marked":"Nígbà mo sọnù bí ajá"},{"start":53.911,"end":55.099,"text":"Laigbo ifere ode mo","marked":"Láìgbọ́ ìfẹ́rẹ́ òde mọ́"},{"start":55.549,"end":57.175,"text":"Ti nko nireti ipada","marked":"Tí ńkọ́ nírètí ìpadà"},{"start":57.625,"end":59.222,"text":"Ti mo npafo ninu ese.","marked":"Tí mo ńpafọ̀ nínú ẹ̀ṣẹ̀."}],"end":59.222},{"key":"7","start":60.172,"lines":[{"start":60.172,"end":61.752,"text":"Nigbati ko s'alabaro","marked":"Nígbàtí kò s'alábàrò"},{"start":62.202,"end":63.541,"text":"Ti Olutunu si jina","marked":"Tí Olùtùnú sì jìnà"},{"start":63.991,"end":65.351,"text":"T'ibanuje b'iji lile","marked":"T'ìbànújẹ́ b'ìjì líle"},{"start":65.801,"end":67.189,"text":"Te ori mi ba n'ironu.","marked":"Tẹ orí mi bá n'ìrònú."},{"start":67.639,"end":68.271,"text":"Amin.","marked":"Àmín."}],"end":68.271}]}