{"v":3,"coll":"y","num":107,"id":"hymn_107","title":"GBO orin 'yin dida aye","duration":94.797,"voices":{"male":{"file":"y-107-male-v3.m4a","bytes":681389,"sha256":"f8f7f5be3421f558fda6fcc119749d01980c270f672bcc9727d8cd67cdeda52d","duration":94.8},"female":{"file":"y-107-female-v3.m4a","bytes":701147,"sha256":"f83ddf0cc6b0468653f0969b411ff4da08959250e3a92c516d5521e1d60f4f76","duration":94.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.642,"text":"GBO orin 'yin dida aye","marked":"Gbọ́ orin yín dídá ayé"},{"start":2.092,"end":3.545,"text":"T'egberun orile nko","marked":"T'ẹgbẹ̀rún orílẹ̀ ńkọ́"},{"start":3.995,"end":5.566,"text":"Orin didun bi t'angeli","marked":"Orin dídùn bí t'áńgẹ́lì"},{"start":6.016,"end":7.211,"text":"O ndun bi omi pupo","marked":"Ó ńdùn bí omi púpọ̀"},{"start":7.661,"end":9.839,"text":"'Bukun, ogo, ipa gbala","marked":"bùkún, ògo, ipa gbàlà"},{"start":10.289,"end":11.642,"text":"Fun Olorun lor'ite","marked":"Fún Ọlọ́run lór'ìtẹ́"},{"start":12.092,"end":13.954,"text":"Baba, Omo, Emi Mimo","marked":"Baba, Ọmọ, Ẹ̀mí Mímọ́"},{"start":14.404,"end":15.993,"text":"Olola, lainipekun.","marked":"Ọlọ́lá, láìnípẹ̀kun."}],"end":15.993},{"key":"2","start":16.943,"lines":[{"start":16.943,"end":19.335,"text":"Titi lo, lat'oro d'ale","marked":"Títí lọ, lát'ọ̀rọ̀ d'alẹ́"},{"start":19.785,"end":21.12,"text":"Lor'olukuluku 'le","marked":"Lọ́r'olúkúlùkù lè"},{"start":21.57,"end":22.91,"text":"Lat' opolopo eniyan","marked":"Lát ọ̀pọ̀lọpọ̀ ènìyàn"},{"start":23.36,"end":24.488,"text":"llu alawo pupa","marked":"Ìlú aláwọ̀ pupa"},{"start":24.938,"end":26.727,"text":"'Lawo dudu t'a da n'ide","marked":"láwo dúdú t'á dà n'idẹ"},{"start":27.177,"end":29.226,"text":"Funfun ti o po niye","marked":"Funfun tí ó pọ̀ níye"},{"start":29.676,"end":31.093,"text":"Omnira alarinkiri","marked":"Omnira alárìnkiri"},{"start":31.543,"end":32.976,"text":"De 'le awon Arabu.","marked":"Dẹ lé àwọn Arabu."}],"end":32.976},{"key":"3","start":33.926,"lines":[{"start":33.926,"end":35.098,"text":"Lati ebute otutu","marked":"Láti èbúté òtútù"},{"start":35.548,"end":36.835,"text":"De ile ti o mooru","marked":"Dé ilẹ̀ tí ó móoru"},{"start":37.285,"end":38.44,"text":"Awon olokan gbigbona","marked":"Àwọn ọlọ́kàn gbígbóná"},{"start":38.89,"end":40.051,"text":"Leba okun Pasifik'","marked":"Lẹ́bà òkun Pasifik"},{"start":40.501,"end":42.018,"text":"Lat'opo aimoye okan","marked":"Lát'ọ̀pọ̀ àìmòye ọkàn"},{"start":42.468,"end":43.591,"text":"Onigbagbo alayo","marked":"Onígbàgbọ́ aláyọ̀"},{"start":44.041,"end":45.516,"text":"Awon to nsona bibo Re","marked":"Àwọn tó ńṣọ́nà bíbọ̀ Rẹ̀"},{"start":45.966,"end":47.474,"text":"Won fere de Sion na.","marked":"Wọ́n fẹ́rẹ̀ dé Sion ná."}],"end":47.474},{"key":"4","start":48.424,"lines":[{"start":48.424,"end":49.788,"text":"Akojo orile-ede","marked":"Àkójọ orile-ede"},{"start":50.238,"end":51.554,"text":"Lat'inu eya ahon","marked":"Lát'inú ẹ̀yà ahọ́n"},{"start":52.004,"end":54.056,"text":"Gbo, won nkorin iyin titi","marked":"Gbọ́, wọ́n ńkọrin ìyìn títí"},{"start":54.506,"end":55.608,"text":"Gbo orin ologo ni","marked":"Gbọ́ orin ológo ni"},{"start":56.058,"end":57.329,"text":"O b'afonifoji mole","marked":"Ó b'àfonífojì mọ́lẹ̀"},{"start":57.779,"end":59.346,"text":"O si ndun lori oke","marked":"Ó sì ńdùn lórí òkè"},{"start":59.796,"end":61.442,"text":"O ndun si waju tit'o fi","marked":"Ó ńdùn sí wájú tít'ó fi"},{"start":61.892,"end":63.005,"text":"Kun ibugbe Olorun.","marked":"Kún ibùgbé Ọlọ́run."}],"end":63.005},{"key":"5","start":63.955,"lines":[{"start":63.955,"end":65.297,"text":"Gbo, didun orin na dapo","marked":"Gbọ́, dídùn orin nà dàpọ̀"},{"start":65.747,"end":66.959,"text":"Mo orin awon t'orun,","marked":"Mo orin àwọn t'ọ̀run"},{"start":67.409,"end":69.274,"text":"Awon t'o koja n'nu danwo","marked":"Àwọn t'ó kọjá n'nú dánwò"},{"start":69.724,"end":71.041,"text":"Sinu isimi loke","marked":"Sínú ìṣímí lókè"},{"start":71.491,"end":72.966,"text":"Won wo aso ailabawon","marked":"Wọ́n wọ aṣọ àìlábàwọ́n"},{"start":73.416,"end":74.605,"text":"Imo 'segun lowo won","marked":"Ìmọ̀ ṣẹ́gun lọ́wọ́ wọn"},{"start":75.055,"end":76.612,"text":"Won nfi duru ko Hosana.","marked":"Wọ́n ńfi dùrù kọ Hosana."}],"end":76.612},{"key":"6","start":77.562,"lines":[{"start":77.562,"end":78.852,"text":"“Ogo fun Eni t'o fe wa","marked":"Ògo fún Ẹni t'ó fẹ́ wá"},{"start":79.302,"end":80.877,"text":"T'O we wa n'nu eje Re","marked":"T'Ó wẹ̀ wá n'nú ẹ̀jẹ̀ Rẹ̀"},{"start":81.327,"end":83.641,"text":"K'oba, alufa, ma korin","marked":"K'ọba, àlùfá, má kọrin"},{"start":84.091,"end":85.58,"text":"Si Baba, Olorun wa","marked":"Sí Baba, Ọlọ́run wa"},{"start":86.03,"end":87.223,"text":"K'eeyan mimo on Angeli","marked":"K'èèyàn mímọ́ ọn Áńgẹ́lì"},{"start":87.673,"end":89.002,"text":"Ko Aleluya titi:","marked":"Kọ Alelúyà títí"},{"start":89.452,"end":90.631,"text":"Asegun orun apadi:","marked":"Aṣẹ́gun ọ̀run àpadì"},{"start":91.081,"end":92.189,"text":"Olodumare joba.","marked":"Olódùmarè jọba."},{"start":92.639,"end":93.249,"text":"Amin.","marked":"Àmín."}],"end":93.249}]}