{"v":3,"coll":"y","num":663,"id":"hymn_663","title":"WA ba wa jeun, Oluwa","duration":18.475,"voices":{"male":{"file":"y-663-male-v3.m4a","bytes":131278,"sha256":"8f96f2fee88d647320f8da9279217185ab43686a3aa1f91b3e1ac944c2c778ee","duration":18.5},"female":{"file":"y-663-female-v3.m4a","bytes":131150,"sha256":"e60e16e598ef6f2e9ff2e6559749a49715a3b4196b286e3bcc22363379334458","duration":18.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.037,"text":"WA ba wa jeun, Oluwa","marked":"Wá bá wa jẹun, Olúwa"},{"start":2.487,"end":3.878,"text":"Je ka ma yin oruko Re","marked":"Jẹ́ ká má yin orúkọ Rẹ"},{"start":4.328,"end":6.427,"text":"Wa busi onje wa, si je","marked":"Wá bùsi oǹjẹ wá, sì jẹ́"},{"start":6.877,"end":8.127,"text":"Ka le ba O jeun l'orun.","marked":"Ká lè bá Ọ jẹun l'ọ̀run."}],"end":8.127},{"key":"2","start":9.077,"lines":[{"start":9.077,"end":10.517,"text":"A F'OPE fun O, Oluwa","marked":"A F'Ọpẹ́ fún Ọ, Olúwa"},{"start":10.967,"end":12.94,"text":"Fun onje wa at'ebun mi;","marked":"Fún oǹjẹ wa àt'ẹ̀bùn mi"},{"start":13.39,"end":14.939,"text":"Fi onje orun b'okan wa,","marked":"Fi oǹjẹ ọ̀run b'ọkàn wà"},{"start":15.389,"end":16.926,"text":"Onje iye lat'oke wa.","marked":"Oǹjẹ ìyè lát'òkè wá."}],"end":16.926}]}