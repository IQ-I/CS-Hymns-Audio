{"v":3,"coll":"y","num":783,"id":"hymn_783","title":"E WOLE f'Oba wa","duration":48.48,"voices":{"male":{"file":"y-783-male-v3.m4a","bytes":333554,"sha256":"d08c1e3268fb8e6fda89f3e37845ddaf5e6fd4a69127936df1690171d00788b8","duration":48.5},"female":{"file":"y-783-female-v3.m4a","bytes":339786,"sha256":"91163731325c16ef749b91bfbeef3f346a0443f138a2dbaafbbd7f61e2d03f29","duration":48.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.557,"text":"E WOLE f'Oba wa","marked":"Ẹ Wọlé f'Ọba wa"},{"start":2.007,"end":2.953,"text":"Omo Mimo Baba","marked":"Ọmọ Mímọ́ Baba"},{"start":3.403,"end":4.907,"text":"Eleda, Alabo","marked":"Ẹlẹ́dàá, Alábọ̀"},{"start":5.357,"end":6.891,"text":"Olugbala gbogbo araiye.","marked":"Olùgbàlà gbogbo aráìyè."}],"end":6.891},{"key":"CHORUS","start":7.841,"lines":[{"start":7.841,"end":9.828,"text":"Egbe: Gbogbo aiye, e fori bale","marked":"Gbogbo ayé, ẹ forí balẹ̀"},{"start":10.278,"end":11.152,"text":"f 'Olodumare","marked":"f Olódùmarè"},{"start":11.602,"end":12.803,"text":"Enit'o ra wa pada","marked":"Ẹnit'ó rà wá padà"},{"start":13.253,"end":14.866,"text":"Alleluya gb'orin segun na ga","marked":"Allelúyà gb'orin ṣẹ́gun ná ga"},{"start":15.316,"end":17.0,"text":"Metalokan wa l'Oba ogo.","marked":"Mẹ́talọ́kan wà l'Ọba ògo."}],"end":17.0},{"key":"2","start":17.95,"lines":[{"start":17.95,"end":19.243,"text":"Mi si wa, Oluwa","marked":"Mi sì wá, Olúwa"},{"start":19.693,"end":20.901,"text":"Ka pin 'nu ogo Re","marked":"Ká pín nu ògo Rẹ"},{"start":21.351,"end":22.346,"text":"Orisun iye wa","marked":"Orísun ìyè wa"},{"start":22.796,"end":24.49,"text":"Ato-bajaiye Oba ogo.","marked":"Ato-bajaiye Ọba ògo."}],"end":24.49},{"key":"3","start":25.44,"lines":[{"start":25.44,"end":26.487,"text":"Aiye pel'ekun re","marked":"Ayé pẹ̀l'ẹkún rẹ̀"},{"start":26.937,"end":28.014,"text":"Tire ni Oluwa","marked":"Tìrẹ ni Olúwa"},{"start":28.464,"end":29.495,"text":"Awon to gba O gbo","marked":"Àwọn tó gbà Ọ́ gbọ́"},{"start":29.945,"end":31.575,"text":"Ni yio jogun Re titi aiye.","marked":"Ní yóò jogún Rẹ̀ títí ayé."}],"end":31.575},{"key":"4","start":32.525,"lines":[{"start":32.525,"end":33.615,"text":"lkore aiye gbo","marked":"Ìkórè ayé gbọ́"},{"start":34.065,"end":35.858,"text":"E mura, araiye","marked":"Ẹ múra, aráìyè"},{"start":36.308,"end":37.392,"text":"Olukore fere de","marked":"Olùkórè fèrè dé"},{"start":37.842,"end":39.371,"text":"Alikama nikan ni Tire.","marked":"Alikama nìkan ní Tire."}],"end":39.371},{"key":"5","start":40.321,"lines":[{"start":40.321,"end":41.464,"text":"Lojo ifarahan","marked":"Lọ́jọ́ ìfarahàn"},{"start":41.914,"end":43.249,"text":"Jewo mi, Oluwa","marked":"Jẹ́wọ́ mi, Olúwa"},{"start":43.699,"end":44.909,"text":"Jek'ore-ofe Re","marked":"Jek'ore-ofe Rẹ"},{"start":45.359,"end":46.931,"text":"Mu wa ye lati ba O gunwa.","marked":"Mú wa yẹ láti bá Ọ gúnwà."}],"end":46.931}]}