{"v":3,"coll":"y","num":618,"id":"hymn_618","title":"EY l'ase nla Jehovah","duration":39.765,"voices":{"male":{"file":"y-618-male-v3.m4a","bytes":277491,"sha256":"474c901c44648cf995363842167da60d8a929e67f69eab95a32d8d1d53b4282e","duration":39.8},"female":{"file":"y-618-female-v3.m4a","bytes":289264,"sha256":"cd4bb11dc394bfa659d24ea904e9ea7054165363f6e0ac8892cc14cf5912b037","duration":39.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.711,"text":"EY l'ase nla Jehovah","marked":"Ẹ̀y l'àṣẹ ńlá Jehovah"},{"start":2.161,"end":3.536,"text":"Yio wa titi lai","marked":"Yóò wà títí láì"},{"start":3.986,"end":5.621,"text":"Elese b'lwo at'emi","marked":"Ẹlẹ́ṣẹ̀ b'lwọ́ àt'èmi"},{"start":6.071,"end":7.438,"text":"K'a tun gbogbo wa bi.","marked":"K'á tún gbogbo wa bí."}],"end":7.438},{"key":"2","start":8.388,"lines":[{"start":8.388,"end":9.947,"text":"Okunkun y'o je ipa wa","marked":"Òkùnkùn y'ó jẹ́ ipa wa"},{"start":10.397,"end":11.571,"text":"B'a wa ninu ese","marked":"B'á wà nínú ẹ̀ṣẹ̀"},{"start":12.021,"end":13.273,"text":"A ki o ri ijoba Re","marked":"A kí ó rí ìjọba Rẹ̀"},{"start":13.723,"end":15.125,"text":"Bi a ko d'atunbi.","marked":"Bí a kò d'àtúnbí."}],"end":15.125},{"key":"3","start":16.075,"lines":[{"start":16.075,"end":17.669,"text":"Bi baptisi wa je'gbarun","marked":"Bí baptisi wa jẹ́'gbárùn"},{"start":18.119,"end":19.147,"text":"Asan ni gbogbo re","marked":"Asán ni gbogbo rẹ̀"},{"start":19.597,"end":20.982,"text":"Eyi ko lew'ese wa nu","marked":"Èyí kò lẹ́w'ẹsẹ̀ wa nù"},{"start":21.432,"end":22.618,"text":"Bi a ko tun wa bi.","marked":"Bí a kò tún wá bí."}],"end":22.618},{"key":"4","start":23.568,"lines":[{"start":23.568,"end":25.383,"text":"Wo ise were ti a nse","marked":"Wo iṣẹ́ wèrè tí a ńṣe"},{"start":25.833,"end":26.781,"text":"Koni iranwo re","marked":"Kọ́ni ìrànwọ́ rẹ"},{"start":27.231,"end":28.662,"text":"Nwon ko s'okan wa di otun","marked":"Wọ́n kò s'ọkàn wá di ọ̀tún"},{"start":29.112,"end":30.521,"text":"B'awa ko d'atunbi.","marked":"B'àwa kò d'àtúnbí."}],"end":30.521},{"key":"5","start":31.471,"lines":[{"start":31.471,"end":32.764,"text":"Lo kuro ninu ese re","marked":"Lọ kúrò nínú ẹ̀ṣẹ̀ rẹ"},{"start":33.214,"end":34.389,"text":"Ja ewon Esu nu","marked":"Já ẹ̀wọ̀n Èṣù nù"},{"start":34.839,"end":36.487,"text":"Gba Kristi gbo tokantokan","marked":"Gba Kristi gbọ́ tọkàntọkàn"},{"start":36.937,"end":38.216,"text":"lwo o d'atunbi.","marked":"Ìwọ ó d'àtúnbí."}],"end":38.216}]}