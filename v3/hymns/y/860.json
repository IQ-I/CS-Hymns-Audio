{"v":3,"coll":"y","num":860,"id":"hymn_860","title":"B'O ti dun lati gba Jesu","duration":47.237,"voices":{"male":{"file":"y-860-male-v3.m4a","bytes":329208,"sha256":"2d31421e9b438873f5e882dd77cc99bc544c35063f0ae3a2232aadf0f5d04a53","duration":47.3},"female":{"file":"y-860-female-v3.m4a","bytes":341819,"sha256":"d71193568db2f93d225edafa4716e11eb7afd27a3209bf2541cf789ecd694154","duration":47.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.267,"text":"B'O ti dun lati gba Jesu","marked":"B'Ó ti dùn láti gba Jésù"},{"start":2.717,"end":3.926,"text":"Gbo gegebi oro Re","marked":"Gbọ́ gẹ́gẹ́bi ọ̀rọ̀ Rẹ"},{"start":4.376,"end":5.542,"text":"K'a simi lor'ileri Re","marked":"K'á ṣímí lór'ìlérí Rẹ̀"},{"start":5.992,"end":7.591,"text":"Sa gbagbo l'Oluwa wi.","marked":"Sá gbàgbọ́ l'Olúwa wí."}],"end":7.591},{"key":"CHORUS","start":8.541,"lines":[{"start":8.541,"end":10.66,"text":"Jesu, Jesu, emi gbagbo","marked":"Jésù, Jésù, èmi gbàgbọ́"},{"start":11.11,"end":12.761,"text":"Mo gbekele n'gbagbogbo","marked":"Mo gbẹ́kẹ̀lé n'gbàgbogbo"},{"start":13.211,"end":15.277,"text":"Jesu, Jesu, Alabukun","marked":"Jésù, Jésù, Alábùkún"},{"start":15.727,"end":17.267,"text":"Ki nle gbekele O si.","marked":"Kí ńlè gbẹ́kẹ̀lé Ó sí."}],"end":17.267},{"key":"2","start":18.217,"lines":[{"start":18.217,"end":20.13,"text":"B'o ti dun lati gba Jesu","marked":"B'ó ti dùn láti gba Jésù"},{"start":20.58,"end":21.861,"text":"K'a gb'eje wenumo Re","marked":"K'á gb'ẹ̀jẹ̀ wẹnumọ́ Rẹ"},{"start":22.311,"end":24.031,"text":"Igbagbo ni ki a fi bo","marked":"Ìgbàgbọ́ ni kí a fi bọ́"},{"start":24.481,"end":25.885,"text":"Sin'eje wenumo na.","marked":"Ṣìn'ẹ̀jẹ̀ wẹnumọ́ ná."}],"end":25.885},{"key":"3","start":26.835,"lines":[{"start":26.835,"end":28.954,"text":"B'o ti dun lati gba Jesu","marked":"B'ó ti dùn láti gba Jésù"},{"start":29.404,"end":30.879,"text":"Ki nk'ara ese sile","marked":"Kí ńk'ara ẹ̀ṣẹ̀ sílẹ̀"},{"start":31.329,"end":34.092,"text":"Ki ngb'ayo, iye, isimi","marked":"Kí ńgb'ayọ̀, iye, ìṣimi"},{"start":34.542,"end":36.091,"text":"Lati odo Jesu mi.","marked":"Láti ọ̀dọ̀ Jésù mi."}],"end":36.091},{"key":"4","start":37.041,"lines":[{"start":37.041,"end":38.493,"text":"Mo yo mo gbeke mi le O","marked":"Mo yọ̀ mo gbẹ́kẹ̀ mi lé Ọ"},{"start":38.943,"end":40.873,"text":"Jesu mi, Alabukun","marked":"Jésù mi, Alábùkún"},{"start":41.323,"end":42.679,"text":"Mo mo pe O wa pelu mi","marked":"Mo mọ̀ pé Ó wà pẹ̀lú mi"},{"start":43.129,"end":44.601,"text":"Ntoju mi titi dopin.","marked":"Ǹtọ́jú mi títí dópin."},{"start":45.051,"end":45.688,"text":"Amin.","marked":"Àmín."}],"end":45.688}]}