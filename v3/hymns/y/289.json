{"v":3,"coll":"y","num":289,"id":"hymn_289","title":"'WO t'o ku ni Kalfari","duration":46.533,"voices":{"male":{"file":"y-289-male-v3.m4a","bytes":314168,"sha256":"914a91ae78739aa6653a78bdfbb32e70ff80401b83cdc34aacbe31fabd3fae61","duration":46.6},"female":{"file":"y-289-female-v3.m4a","bytes":325877,"sha256":"291c360888e7d61a20b8f313ff6c8373a942de840a1b7c1ec723bd964c8599cc","duration":46.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.786,"text":"'WO t'o ku ni Kalfari","marked":"wò t'ó kú ní Kalfárì"},{"start":2.236,"end":3.58,"text":"Wo t'o mbebe f'elese","marked":"Wò t'ó mbẹ̀bẹ̀ f'ẹlẹ́ṣẹ̀"},{"start":4.03,"end":5.795,"text":"Ran mi lowo, nigb'aini","marked":"Ràn mí lọ́wọ́, nígb'àìní"},{"start":6.245,"end":7.662,"text":"Jesu, gbo 'gbe mi.","marked":"Jésù, gbọ́ gbé mi."}],"end":7.662},{"key":"2","start":8.612,"lines":[{"start":8.612,"end":9.7,"text":"Ninu ibanuje mi,","marked":"Nínú ìbànújẹ́ mi"},{"start":10.15,"end":11.327,"text":"At'okan aigbagbo mi","marked":"Àt'ọkàn àìgbàgbọ́ mi"},{"start":11.777,"end":13.037,"text":"Em'olori elese","marked":"Ẹ̀m'olórí ẹlẹ́ṣẹ̀"},{"start":13.487,"end":14.531,"text":"Gb'oju mi si O.","marked":"Gb'ojú mi sí Ọ."}],"end":14.531},{"key":"3","start":15.481,"lines":[{"start":15.481,"end":17.258,"text":"Ọta lode, ẹru n'nu,","marked":"Ọ̀tá lóde, ẹ̀rù n'nú"},{"start":17.708,"end":19.001,"text":"Ko s'ire kan lọwọ mi,","marked":"Kò s'ìre kan lọ́wọ́ mi"},{"start":19.451,"end":20.727,"text":"Iwọ l'o n gb'ẹlẹsẹ la,","marked":"Ìwọ l'ó ń gb'ẹ́lẹ́sẹ̀ là"},{"start":21.177,"end":22.134,"text":"Mo sa tọ Ọ wa.","marked":"Mo sá tọ̀ Ọ́ wá."}],"end":22.134},{"key":"4","start":23.084,"lines":[{"start":23.084,"end":24.437,"text":"Awọn miran dẹsẹ pẹ,","marked":"Àwọn míràn dẹ́sẹ̀ pẹ́"},{"start":24.887,"end":25.955,"text":"Wọn si ri igbala,","marked":"Wọ́n sì rí ìgbàlà"},{"start":26.405,"end":27.491,"text":"Wọn gbọ ohun anu Rẹ,","marked":"Wọ́n gbọ́ ohùn àánú Rẹ̀"},{"start":27.941,"end":28.931,"text":"Mu mi gbọ pẹlu.","marked":"Mú mi gbọ́ pẹ̀lú."}],"end":28.931},{"key":"5","start":29.881,"lines":[{"start":29.881,"end":31.064,"text":"Mo k'aniyan mi le Ọ,","marked":"Mo k'àníyàn mi lé Ọ"},{"start":31.514,"end":33.002,"text":"Mo si n gbadura si Ọ,","marked":"Mo sì ń gbàdúrà sí Ọ"},{"start":33.452,"end":35.719,"text":"Jesu, yo mi n'nu egbe,","marked":"Jésù, yọ̀ mi n'nú ẹgbẹ́"},{"start":36.169,"end":37.858,"text":"Gba mi, ki n ma ku.","marked":"Gbà mí, kí n má kú."}],"end":37.858},{"key":"6","start":38.808,"lines":[{"start":38.808,"end":39.997,"text":"'Gbati wahala ba de","marked":"gbàtí wàhálà bá dé"},{"start":40.447,"end":41.658,"text":"Nigb' agbara idanwo","marked":"Nígb agbára ìdánwò"},{"start":42.108,"end":43.252,"text":"Ati lojo ikehin","marked":"Àti lọ́jọ́ ìkẹhìn"},{"start":43.702,"end":44.983,"text":"Jesu, sunmo mi.","marked":"Jésù, súnmọ́ mi."}],"end":44.983}]}