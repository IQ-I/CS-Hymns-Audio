{"v":3,"coll":"y","num":621,"id":"hymn_621","title":"BABA, Apat' agbara wa","duration":37.16,"voices":{"male":{"file":"y-621-male-v3.m4a","bytes":265553,"sha256":"4c132b578d6a211971c9aa3a8bfe4ab0a74ed53c6ec75964cc115eb75b204bff","duration":37.2},"female":{"file":"y-621-female-v3.m4a","bytes":274375,"sha256":"6c90e3357ebbc9c08b331bb25dc9a6bdcf3876b1d74d35d7632185864da0478b","duration":37.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.568,"text":"BABA, Apat' agbara wa,","marked":"Baba, Àpát agbára wa"},{"start":3.018,"end":4.865,"text":"Ileri ẹni ti ki 'yẹ,","marked":"Ìlérí ẹni tí kí 'yẹ"},{"start":5.315,"end":6.512,"text":"Sinu agbo eniyan Rẹ,","marked":"Sínú agbo ènìyàn Rẹ̀"},{"start":6.962,"end":9.0,"text":"Jọ, gba ọmọ yi titi lai.","marked":"Jọ, gba ọmọ yí títí láì."}],"end":9.0},{"key":"2","start":9.95,"lines":[{"start":9.95,"end":11.529,"text":"A ti f'omi yi sami fun,","marked":"A ti f'omi yí sàmì fún"},{"start":11.979,"end":13.395,"text":"Ni Orukọ Mẹtalọkan;","marked":"Ní Orúkọ Mẹ́talọ́kan"},{"start":13.845,"end":15.384,"text":"A si n tọrọ ipo kan fun,","marked":"A sì ń tọrọ ipò kan fún"},{"start":15.834,"end":16.925,"text":"Larin awọn ọmọ Tirẹ.","marked":"Lárin àwọn ọmọ Tirẹ̀."}],"end":16.925},{"key":"3","start":17.875,"lines":[{"start":17.875,"end":19.244,"text":"A sa l'ami agbelebu,","marked":"A sá l'àmì àgbélébùú"},{"start":19.694,"end":21.241,"text":"Apẹrẹ iya ti O jẹ;","marked":"Apẹ̀rẹ̀ ìyá tí Ó jẹ́"},{"start":21.691,"end":24.169,"text":"Krist', k'ileri re owurọ,","marked":"Krist, k'ìlérí rẹ̀ òwúrọ̀"},{"start":24.619,"end":25.918,"text":"Jẹ 'jẹwọ ọjọ ayé rẹ.","marked":"Jẹ́ 'jẹwọ ọjọ́ ayé rẹ."}],"end":25.918},{"key":"4","start":26.868,"lines":[{"start":26.868,"end":29.109,"text":"Fifun ni, k'iku oun iye,","marked":"Fífún ni, k'ikú òun ìyè"},{"start":29.559,"end":30.992,"text":"Ma ya ọmọ Rẹ lọdọ Rẹ;","marked":"Má ya ọmọ Rẹ̀ lọ́dọ̀ Rẹ"},{"start":31.442,"end":33.437,"text":"K'oun jẹ om'-ogun Rẹ totọ,","marked":"K'òun jẹ́ om'-ogun Rẹ̀ tòtọ́"},{"start":33.887,"end":35.61,"text":"Ọm'ọdọ Rẹ, Tirẹ lailai.","marked":"Ọm'ọ̀dọ̀ Rẹ, Tirẹ̀ láéláé."}],"end":35.61}]}