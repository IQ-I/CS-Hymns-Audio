{"v":3,"coll":"y","num":259,"id":"hymn_259","title":"OTOSI elese, e wa","duration":71.069,"voices":{"male":{"file":"y-259-male-v3.m4a","bytes":512227,"sha256":"67422386d93d2de2b683238984755d1c6e8d1bb7a95acbd0e246e0b23202b5bd","duration":71.1},"female":{"file":"y-259-female-v3.m4a","bytes":531666,"sha256":"26766b84910dec82961e0db0c52c8d502aa63f6d1c0a4cb566ffce769446878c","duration":71.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.266,"text":"OTOSI ẹlẹsẹ, ẹ wa,","marked":"Òtòṣì ẹlẹ́sẹ̀, ẹ wá"},{"start":2.716,"end":3.945,"text":"Wa ni wakati anu;","marked":"Wà ní wákàtí àánú"},{"start":4.395,"end":6.418,"text":"Jesu setan lati gba yin,","marked":"Jésù ṣetán láti gbà yín"},{"start":6.868,"end":8.392,"text":"O kun f'anu at'ifẹ,","marked":"Ó kún f'àánú àt'ìfẹ́"},{"start":8.842,"end":11.92,"text":"O si le sẹ, O mura tan, ma foya.","marked":"Ó sì lè sẹ́, Ó múra tán, má fòyà."}],"end":11.92},{"key":"2","start":12.87,"lines":[{"start":12.87,"end":14.976,"text":"Ẹyin alaini, ẹ wa gba","marked":"Ẹ̀yin aláìní, ẹ wá gbà"},{"start":15.426,"end":16.666,"text":"Ogo Ọlọrun l'ofẹ,","marked":"Ògo Ọlọ́run l'òfẹ́"},{"start":17.116,"end":19.415,"text":"'Gbagbọ totọ, 'ronu totọ,","marked":"'Gbagbọ tòtọ́, ronú tòtọ́"},{"start":19.865,"end":21.483,"text":"Or' ọfẹ ti o n fa wa,","marked":"Ọ̀r ọ̀fẹ́ tí ó ń fà wá"},{"start":21.933,"end":25.071,"text":"Wa 'dọ Jesu, alaini owo sa wa ra.","marked":"Wá 'dọ Jésù, aláìní ọwọ́ sá wa rà."}],"end":25.071},{"key":"3","start":26.021,"lines":[{"start":26.021,"end":27.539,"text":"Ma jẹ k'ọkan yin da yin ro","marked":"Má jẹ́ k'ọkàn yín dá yín rò"},{"start":27.989,"end":29.578,"text":"Mase ro ti aiyẹ yin;","marked":"Máṣe rò ti aiyẹ yín"},{"start":30.028,"end":31.59,"text":"Gbogbo yiyẹ t'o mbere ni,","marked":"Gbogbo yíyẹ t'ó mbẹ̀rẹ̀ ni"},{"start":32.04,"end":33.795,"text":"'Yi l'O fun yin; 'tansan","marked":"yí l'Ó fún yín; tanṣán"},{"start":34.245,"end":35.206,"text":"Ẹmi l'ọkan.","marked":"Ẹ̀mí l'ọkàn."}],"end":35.206},{"key":"4","start":36.156,"lines":[{"start":36.156,"end":38.705,"text":"Ẹyin t'ẹru n pa, t'aarẹ mu,","marked":"Ẹ̀yin t'ẹrù ń pa, t'àárẹ̀ mú"},{"start":39.155,"end":41.088,"text":"T'ẹ sọnu t'ẹ si segbe,","marked":"T'ẹ̀ sọnù t'ẹ̀ sì ṣègbé"},{"start":41.538,"end":43.103,"text":"Bi ẹ duro tit' ẹ o fi san,","marked":"Bí ẹ dúró tít ẹ ó fi san"},{"start":43.553,"end":44.812,"text":"Ẹ ki yoo wa rara:","marked":"Ẹ kì yóò wá rárá"},{"start":45.262,"end":48.118,"text":"F'ẹlẹsẹ ni, Oun ko wa f'olododo.","marked":"F'ẹlẹ́sẹ̀ ni, Òun kò wá f'olódodo."}],"end":48.118},{"key":"5","start":49.068,"lines":[{"start":49.068,"end":50.462,"text":"Ọlọrun goke l'awọ wa,","marked":"Ọlọ́run gòkè l'àwọ̀ wá"},{"start":50.912,"end":52.341,"text":"O n fi ẹjẹ Rẹ bẹbẹ:","marked":"Ó ń fi ẹ̀jẹ̀ Rẹ̀ bẹ̀bẹ̀"},{"start":52.791,"end":54.234,"text":"Gbe ara le patapata:","marked":"Gbé ara le pátápátá"},{"start":54.684,"end":55.837,"text":"Ma gbẹkẹle ohun mi?","marked":"Má gbẹ́kẹ̀lé ohun mi?"},{"start":56.287,"end":58.223,"text":"Jesu nikan l'o le s'ẹlẹsẹ l'ore.","marked":"Jésù nìkan l'ó lè s'ẹlẹ́sẹ̀ l'ọ̀rẹ́."}],"end":58.223},{"key":"6","start":59.173,"lines":[{"start":59.173,"end":60.606,"text":"Angẹli at' awọn mimọ,","marked":"Áńgẹ́lì àt àwọn mímọ́"},{"start":61.056,"end":62.734,"text":"N kọrin 'yin Ọd'-agutan;","marked":"N kọrin yín Ọd'-agutan"},{"start":63.184,"end":64.265,"text":"Gbohungbohun Orukọ Rẹ,","marked":"Gbohùngbohùn Orúkọ Rẹ"},{"start":64.715,"end":66.303,"text":"Si gba gbogbo ọrun kan:","marked":"Sì gba gbogbo ọ̀run kan"},{"start":66.753,"end":69.52,"text":"Halleluya! ẹlẹsẹ le gberin na.","marked":"Hallelúyà! ẹlẹ́sẹ̀ lè gbẹ̀rin ná."}],"end":69.52}]}