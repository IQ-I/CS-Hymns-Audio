{"v":3,"coll":"y","num":524,"id":"hymn_524","title":"O FUN mi l'edidi","duration":40.794,"voices":{"male":{"file":"y-524-male-v3.m4a","bytes":282669,"sha256":"0da826d20f74a7bbc2525b99524d0425fec9a6ca30d101adba9110460f0f6fdb","duration":40.8},"female":{"file":"y-524-female-v3.m4a","bytes":293083,"sha256":"1a1885f939494331ecb1187001a5a693424c662f11bea506f27629dcb7402c22","duration":40.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.339,"text":"O FUN mi l'edidi","marked":"Ó Fún mi l'èdìdì"},{"start":1.789,"end":3.3,"text":"Gbese nla ti mo je","marked":"Gbèsè ńlá tí mo jẹ́"},{"start":3.75,"end":5.686,"text":"B'o ti fun mi, o si rerin","marked":"B'ó ti fún mi, ó sì rẹ́rìn"},{"start":6.136,"end":7.487,"text":"Pe, Mase gbagbe mi'.","marked":"Pé, Mase gbàgbé mi."}],"end":7.487},{"key":"2","start":8.437,"lines":[{"start":8.437,"end":9.444,"text":"O fun mi l'edidi,","marked":"Ó fún mi l'èdìdì"},{"start":9.894,"end":11.143,"text":"O san igbese na;","marked":"Ó san ìgbésẹ̀ ná"},{"start":11.593,"end":13.706,"text":"B'o ti fun mi, O si rẹrin,","marked":"B'ó ti fún mi, Ó sì rẹ́rìn"},{"start":14.156,"end":15.844,"text":"Wi pé, ―Ma ranti mi!","marked":"Wí pé, ―Má rántí mi!"}],"end":15.844},{"key":"3","start":16.794,"lines":[{"start":16.794,"end":17.898,"text":"N ó p'edidi na mọ,","marked":"N ó p'èdìdì ná mọ́"},{"start":18.348,"end":19.443,"text":"B'igbese tilẹ tan;","marked":"B'ìgbésẹ̀ tilẹ̀ tán"},{"start":19.893,"end":21.278,"text":"O n sọ ifẹ ẹni t'o san,","marked":"Ó ń sọ ìfẹ́ ẹni t'ó sàn"},{"start":21.728,"end":23.015,"text":"Igbese naa fun mi.","marked":"Ìgbésẹ̀ náà fún mi."}],"end":23.015},{"key":"4","start":23.965,"lines":[{"start":23.965,"end":25.804,"text":"Mo wo, mo si rẹrin","marked":"Mo wò, mo sì rẹ́rìn"},{"start":26.254,"end":28.038,"text":"Mo tun wo, mo sọkun;","marked":"Mo tún wò, mo sọkún"},{"start":28.488,"end":29.899,"text":"Ẹri ifẹ Rẹ si mi ni,","marked":"Ẹ̀rí ìfẹ́ Rẹ̀ sí mi ni"},{"start":30.349,"end":31.589,"text":"N ó tọju rẹ titi.","marked":"N ó tọ́jú rẹ̀ títí."}],"end":31.589},{"key":"5","start":32.539,"lines":[{"start":32.539,"end":33.774,"text":"Ki tun s'edidi mọ,","marked":"Kí tún s'èdìdì mọ́"},{"start":34.224,"end":35.644,"text":"Sugbọn iranti ni!","marked":"Sùgbọ́n ìrántí ni!"},{"start":36.094,"end":37.765,"text":"Pe gbogbo igbese mi ni,","marked":"Pé gbogbo ìgbésẹ̀ mi ni"},{"start":38.215,"end":39.244,"text":"Emmanueli san.","marked":"Emmanueli sàn."}],"end":39.244}]}