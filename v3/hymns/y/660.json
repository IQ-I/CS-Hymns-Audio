{"v":3,"coll":"y","num":660,"id":"hymn_660","title":"IYAWO ti Isaaki gbe","duration":58.121,"voices":{"male":{"file":"y-660-male-v3.m4a","bytes":405200,"sha256":"1f108ddd083994eb586e441fab940994f8cc1299bc532151845a45adc114b3cf","duration":58.2},"female":{"file":"y-660-female-v3.m4a","bytes":420823,"sha256":"c897be8fee7a7b27fff31434fbc5ef344b2bde4a7993ff6db4eb7ff7c026c7b2","duration":58.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.987,"text":"IYAWO ti Isaaki gbe","marked":"Ìyàwó tí Isaaki gbé"},{"start":2.437,"end":3.837,"text":"Pelu Rebeka aya re","marked":"Pẹ̀lú Rebeka aya rẹ̀"},{"start":4.287,"end":5.51,"text":"Olorun f'ibukun fun won","marked":"Ọlọ́run f'ìbùkún fún wọn"},{"start":5.96,"end":7.466,"text":"Gege b'igbeyawo Adam.","marked":"Gẹ́gẹ́ b'ìgbéyàwó Adam."}],"end":7.466},{"key":"CHORUS","start":8.416,"lines":[{"start":8.416,"end":10.497,"text":"E yo, mo si tun wi pé e yo (2)","marked":"Ẹ yọ̀, mo sì tún wí pé ẹ yọ̀"},{"start":10.947,"end":13.211,"text":"E yo, e yo, e yo nin'","marked":"Ẹ yọ, ẹ yọ, ẹ yọ nín"},{"start":13.661,"end":14.577,"text":"Oluwa e yo.","marked":"Olúwa ẹ yọ̀."}],"end":14.577},{"key":"2","start":15.527,"lines":[{"start":15.527,"end":16.936,"text":"Bẹni ko ri fun yin loni,","marked":"Bẹ́ni kò rí fún yín lónì"},{"start":17.386,"end":18.951,"text":"Arakunrin, Arabinrin,","marked":"Arákùnrin, Arábìnrin"},{"start":19.401,"end":20.797,"text":"K'ayọ ọrun kun ọkan yin,","marked":"K'ayọ̀ ọ̀run kún ọkàn yín"},{"start":21.247,"end":22.87,"text":"Pẹlu 'bukun atoke wa.","marked":"Pẹ̀lú bùkún àtòkè wà."}],"end":22.87},{"key":"3","start":23.82,"lines":[{"start":23.82,"end":25.295,"text":"Ninu idamu ayé yi,","marked":"Nínú ìdàmú ayé yí"},{"start":25.745,"end":27.114,"text":"Oluwa p'awọn tirẹ mọ;","marked":"Olúwa p'àwọn tirẹ̀ mọ́"},{"start":27.564,"end":29.19,"text":"Fi wọn si abẹ isọ Rẹ,","marked":"Fi wọ́n sí abẹ́ ìsọ Rẹ"},{"start":29.64,"end":30.985,"text":"Ki wọn le bọ lọwọ ewu.","marked":"Kí wọn lè bọ̀ lọ́wọ́ ewu."}],"end":30.985},{"key":"4","start":31.935,"lines":[{"start":31.935,"end":33.932,"text":"Ẹyin ọrẹ, at'ibatan,","marked":"Ẹ̀yin ọ̀rẹ́, àt'ìbátan"},{"start":34.382,"end":36.04,"text":"K'Oluwa gbọ adura yin,","marked":"K'Olúwa gbọ́ àdúrà yín"},{"start":36.49,"end":38.19,"text":"K'O f'ibukun fun yin pẹlu,","marked":"K'Ó f'ìbùkún fún yín pẹ̀lú"},{"start":38.64,"end":40.471,"text":"L'ọkunrin ati l'obinrin.","marked":"L'ọkùnrin àti l'obìnrin."}],"end":40.471},{"key":"5","start":41.421,"lines":[{"start":41.421,"end":42.65,"text":"Ẹyin ọm'Ẹgbẹ Séráfù,","marked":"Ẹ̀yin ọm'Ẹgbẹ́ Séráfù"},{"start":43.1,"end":44.414,"text":"Ati ọm'Ẹgbẹ Kérúbù,","marked":"Àti ọm'Ẹgbẹ́ Kérúbù"},{"start":44.864,"end":46.438,"text":"Ọjọ ayọ ni eyi jẹ,","marked":"Ọjọ́ ayọ̀ ni èyí jẹ́"},{"start":46.888,"end":48.33,"text":"K'Oluwa jẹ ki ire kari,","marked":"K'Olúwa jẹ́ kí ìre kárí"}],"end":48.33},{"key":"6","start":49.28,"lines":[{"start":49.28,"end":50.664,"text":"A f'Ogo f'Olorun baba","marked":"A f'Ògo f'Ọlọ́run Baba"},{"start":51.114,"end":52.505,"text":"A f'Ogo f'Olorun Omo","marked":"A f'Ògo f'Ọlọ́run Ọmọ"},{"start":52.955,"end":54.406,"text":"A f'Ogo fun Emi Mimo","marked":"A f'Ògo fún Ẹ̀mí Mímọ́"},{"start":54.856,"end":56.572,"text":"Metalokan Mimo lailai.","marked":"Mẹ́talọ́kan Mímọ́ láéláé."}],"end":56.572}]}