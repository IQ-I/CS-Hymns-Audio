{"v":3,"coll":"y","num":758,"id":"hymn_758","title":"IGBA asale ti dun to","duration":43.155,"voices":{"male":{"file":"y-758-male-v3.m4a","bytes":307655,"sha256":"ea88916ca1b3f88dbd5ce3fb9576d3d84566df2980267abef0c44226e74c6bef","duration":43.2},"female":{"file":"y-758-female-v3.m4a","bytes":312379,"sha256":"6cd690f17b27eeff1d6b77d7bdd8d62b06c2afcdcd64e7f4f923121b59eda280","duration":43.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.559,"text":"IGBA asalẹ ti dun to!","marked":"Ìgbà àsálẹ́ ti dùn tó!"},{"start":2.009,"end":3.506,"text":"Ti ara tu ohun gbogbo;","marked":"Tí ara tú ohun gbogbo"},{"start":3.956,"end":5.193,"text":"'Gbat' itansan orun alẹ,","marked":"gbàt ìtànṣán ọ̀run alẹ́"},{"start":5.643,"end":7.093,"text":"Ba n tan‘mọlẹ s'ohun gbogbo.","marked":"Bá ń tàn'mọ́lẹ̀ s'ohun gbogbo."}],"end":7.093},{"key":"2","start":8.043,"lines":[{"start":8.043,"end":9.251,"text":"Bẹni 'kẹhin onigbagbọ,","marked":"Bẹni 'kẹhin onígbàgbọ́"},{"start":9.701,"end":11.252,"text":"Oun a sinmi l'alafia;","marked":"Òun a sinmi l'àlàáfíà"},{"start":11.702,"end":13.821,"text":"Igbagbọ t'o gbona janjan,","marked":"Ìgbàgbọ́ t'ó gbóná janjan"},{"start":14.271,"end":15.644,"text":"A mọlẹ ninu ọkan rẹ.","marked":"A mọ́lẹ̀ nínú ọkàn rẹ̀."}],"end":15.644},{"key":"3","start":16.594,"lines":[{"start":16.594,"end":18.448,"text":"Imọlẹ kan mọ loju rẹ,","marked":"Ìmọ́lẹ̀ kan mọ́ lójú rẹ̀"},{"start":18.898,"end":20.231,"text":"Ẹrin si bọ ni ẹnu rẹ,","marked":"Ẹ̀rín sì bọ́ ní ẹnu rẹ̀"},{"start":20.681,"end":22.255,"text":"O n f'ede t'ahọn wa ko mọ,","marked":"Ó ń f'èdè t'ahọ́n wa kò mọ̀"},{"start":22.705,"end":24.385,"text":"Sọrọ ogo t'o sunmọle.","marked":"Sọ̀rọ̀ ògo t'ó súnmọ́lè."}],"end":24.385},{"key":"4","start":25.335,"lines":[{"start":25.335,"end":26.758,"text":"Itansan 'mọlẹ t'ọrun wa,","marked":"Ìtànṣán 'mọlẹ t'ọ̀run wà"},{"start":27.208,"end":28.597,"text":"Lati gba niyanju lọna;","marked":"Láti gba níyànjú lọ́nà"},{"start":29.047,"end":30.343,"text":"Awọn angel duro yika,","marked":"Àwọn angẹl dúró yíká"},{"start":30.793,"end":32.448,"text":"Lati gbe lọ s'ibugbe wọn.","marked":"Láti gbé lọ s'ibùgbé wọn."}],"end":32.448},{"key":"5","start":33.398,"lines":[{"start":33.398,"end":34.766,"text":"Oluwa, jẹ k'a lọ bayi,","marked":"Olúwa, jẹ́ k'á lọ báyì"},{"start":35.216,"end":37.55,"text":"K'a ba Ọ yọ, k'a r'oju Rẹ,","marked":"K'á bá Ọ yọ̀, k'á r'ojú Rẹ"},{"start":38.0,"end":39.376,"text":"Tẹ aworan Rẹ s'ọkan wa,","marked":"Tẹ àwòrán Rẹ̀ s'ọkàn wá"},{"start":39.826,"end":41.606,"text":"Si kọ wa b'a ti ba Ọ rin.","marked":"Sì kọ́ wá b'á ti bá Ọ rìn."}],"end":41.606}]}