{"v":3,"coll":"y","num":544,"id":"hymn_544","title":"JESU n pe wa, losan, loru","duration":43.646,"voices":{"male":{"file":"y-544-male-v3.m4a","bytes":303811,"sha256":"a1223cf61245025ef8fe71ccf2df06eced7b3dcb61c713b4083fbd1926d9e292","duration":43.7},"female":{"file":"y-544-female-v3.m4a","bytes":313312,"sha256":"cb9ce819d1c5bf26449b2abcdd5f3bbb82b2bbccab2f7902aae61a3c9555e842","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.947,"text":"JESU n pe wa, lọsan, loru,","marked":"Jésù ń pè wá, lọ́sàn, lóru"},{"start":2.397,"end":3.75,"text":"Larin irumi ayé;","marked":"Lárin ìrumi ayé"},{"start":4.2,"end":5.511,"text":"Lojojumọ l'a n gbohun Rẹ,","marked":"Lójojúmọ́ l'à ń gbóhùn Rẹ̀"},{"start":5.961,"end":8.019,"text":"Wi pé, Kristian, tẹle Mi.","marked":"Wí pé, Kristian, tẹ̀lé Mi."}],"end":8.019},{"key":"2","start":8.969,"lines":[{"start":8.969,"end":10.426,"text":"Awọn Aposteli gbani,","marked":"Àwọn Aposteli gbani"},{"start":10.876,"end":12.358,"text":"Ni odo Galili ni:","marked":"Ní ọ̀dọ̀ Galili ni"},{"start":12.808,"end":14.539,"text":"Wọn kọ ile, ọna, silẹ,","marked":"Wọ́n kọ́ ilé, ọ̀nà, sílẹ̀"},{"start":14.989,"end":16.32,"text":"Gbogbo wọn si n tọ lẹhin.","marked":"Gbogbo wọn sì ń tọ̀ lẹ́hìn."}],"end":16.32},{"key":"3","start":17.27,"lines":[{"start":17.27,"end":19.305,"text":"Jesu n pe wa, kuro ninu","marked":"Jésù ń pè wá, kúrò nínú"},{"start":19.755,"end":20.839,"text":"Ohun ayé asan yi;","marked":"Ohun ayé asán yí"},{"start":21.289,"end":23.367,"text":"Larin afẹ ayé, O n wi,","marked":"Lárin afẹ́ ayé, Ó ń wí"},{"start":23.817,"end":25.821,"text":"Pe, Kristian ẹ fẹran Mi.","marked":"Pé, Kristian ẹ fẹ́ràn Mi."}],"end":25.821},{"key":"4","start":26.771,"lines":[{"start":26.771,"end":28.449,"text":"Larin ayọ at' ẹkun wa,","marked":"Lárin ayọ̀ àt ẹkún wà"},{"start":28.899,"end":30.248,"text":"Larin lala oun 'rọrun;","marked":"Lárin làlá òun 'rọrun"},{"start":30.698,"end":32.18,"text":"Tantan l'o n pe l'ohun rara,","marked":"Tàǹtàn l'ó ń pè l'ohun rárá"},{"start":32.63,"end":34.206,"text":"Pe, Kristian ẹ fẹran Mi,","marked":"Pé, Kristian ẹ fẹ́ràn Mi"}],"end":34.206},{"key":"5","start":35.156,"lines":[{"start":35.156,"end":36.386,"text":"Olugbala nip' anu Rẹ,","marked":"Olùgbàlà níp àánú Rẹ̀"},{"start":36.836,"end":38.021,"text":"Jẹ ki a gbọ ipe Rẹ,","marked":"Jẹ́ kí a gbọ́ ìpè Rẹ"},{"start":38.471,"end":39.919,"text":"F' eti 'gbọran fun gbogbo wa,","marked":"F etí 'gbọran fún gbogbo wa"},{"start":40.369,"end":42.097,"text":"K'a fẹ Ọ ju ayé lọ.","marked":"K'á fẹ́ Ọ ju ayé lọ."}],"end":42.097}]}