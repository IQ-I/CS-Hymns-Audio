{"v":3,"coll":"y","num":613,"id":"hymn_613","title":"DURO, omo ogun","duration":45.779,"voices":{"male":{"file":"y-613-male-v3.m4a","bytes":306770,"sha256":"2c5e3447f7b65f06c6332001fe789002ceb8bbc685f799ff21ec18cd6b0921aa","duration":45.8},"female":{"file":"y-613-female-v3.m4a","bytes":316790,"sha256":"9ae8d4085609a19084daf0593236571707510e062169c5bacc3a1843ebbabac8","duration":45.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.635,"text":"DURO, ọmọ ogun,","marked":"Dúró, ọmọ ogun"},{"start":2.085,"end":3.24,"text":"F'ẹnu rẹ sọ f'ayé;","marked":"F'ẹnu rẹ̀ sọ f'ayé"},{"start":3.69,"end":5.428,"text":"Si jẹjẹ pe ofo l'ayé,","marked":"Sì jẹ́jẹ́ pé ọ̀fọ̀ l'ayé"},{"start":5.878,"end":6.946,"text":"Nitori Jesu re.","marked":"Nítorí Jésù rẹ̀."}],"end":6.946},{"key":"2","start":7.896,"lines":[{"start":7.896,"end":9.186,"text":"Dide k'a baptis' re","marked":"Dìde k'á baptis rẹ̀"},{"start":9.636,"end":10.751,"text":"K'a we ese re nu","marked":"K'á wẹ ẹsẹ̀ rẹ̀ nù"},{"start":11.201,"end":12.612,"text":"Wa b'Olorun da majemu","marked":"Wá b'Ọlọ́run dá májẹ̀mú"},{"start":13.062,"end":14.462,"text":"So 'gbagbo re loni.","marked":"Sọ gbàgbọ́ rẹ lónì."}],"end":14.462},{"key":"3","start":15.412,"lines":[{"start":15.412,"end":16.529,"text":"Tirẹ ni Oluwa,","marked":"Tìrẹ ni Olúwa"},{"start":16.979,"end":18.192,"text":"At' ijọba ọrun:","marked":"Àt ìjọba ọ̀run"},{"start":18.642,"end":20.042,"text":"Sa gb'ami yi siwaju rẹ,","marked":"Sá gb'àmì yí síwájú rẹ"},{"start":20.492,"end":21.383,"text":"Ami Oluwa rẹ.","marked":"Àmì Olúwa rẹ̀."}],"end":21.383},{"key":"4","start":22.333,"lines":[{"start":22.333,"end":23.726,"text":"Wo k'ise t'ara re","marked":"Wò k'iṣẹ́ t'ara rẹ"},{"start":24.176,"end":25.521,"text":"Bikose ti Kristi","marked":"Bíkọsẹ̀ ti Kristi"},{"start":25.971,"end":27.292,"text":"A ko oruko re po mo","marked":"A kó orúkọ rẹ̀ pọ̀ mọ́"},{"start":27.742,"end":28.9,"text":"Awon mimo gbani.","marked":"Àwọn mímọ́ gbani."}],"end":28.9},{"key":"5","start":29.85,"lines":[{"start":29.85,"end":31.046,"text":"Ni hamọra Jesu,","marked":"Ní hámọ́ra Jésù"},{"start":31.496,"end":32.67,"text":"Kọju‘ja si Esu;","marked":"Kọ́jú'jà sí Èṣù"},{"start":33.12,"end":34.694,"text":"B'o ti wu k'ogun na le to,","marked":"B'ó ti wù k'ogun ná le tó"},{"start":35.144,"end":36.252,"text":"Iwọ ni o sẹgun.","marked":"Ìwọ ni ó sẹ́gun."}],"end":36.252},{"key":"6","start":37.202,"lines":[{"start":37.202,"end":38.201,"text":"Ade didara ni,","marked":"Adé dídára ni"},{"start":38.651,"end":40.128,"text":"Orin na, didun ni,","marked":"Orin ná, dídùn ni"},{"start":40.578,"end":42.428,"text":"'Gba t'a ba ko ikogun jọ,","marked":"gbà t'á bá kọ ìkógun jọ"},{"start":42.878,"end":44.23,"text":"S'ẹsẹ Olugbala.","marked":"S'ẹsẹ̀ Olùgbàlà."}],"end":44.23}]}