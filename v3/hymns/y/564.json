{"v":3,"coll":"y","num":564,"id":"hymn_564","title":"OLUSAGUNTAN y'o pese","duration":52.125,"voices":{"male":{"file":"y-564-male-v3.m4a","bytes":372752,"sha256":"ba9dcaf8ee06ac130a6debdb013a6eef59046d1ea2cc08a88d5bb8e279d6b330","duration":52.2},"female":{"file":"y-564-female-v3.m4a","bytes":383671,"sha256":"033d526b4cb7dfa104c16ed2479b76f254d60efb3271f481572001cf1ded955e","duration":52.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.933,"text":"OLUSAGUNTAN y'o pese,","marked":"Olùṣàgùntàn y'ó pèsè"},{"start":2.383,"end":4.128,"text":"Y'O fi papa tutu bọ mi,","marked":"Y'Ó fi pápá tútù bọ̀ mí"},{"start":4.578,"end":6.39,"text":"Ọwọ rẹ y'o mu 'ranwọ wa,","marked":"Ọwọ́ rẹ̀ y'ó mú 'ranwọ wá"},{"start":6.84,"end":8.614,"text":"Oju rẹ y'o si ma sọ mi,","marked":"Ojú rẹ y'ó sì má sọ mí"},{"start":9.064,"end":10.724,"text":"Y'o ma ba mi kiri lọsan.","marked":"Y'ó má bá mi kiri lọ́sàn."},{"start":11.174,"end":12.961,"text":"Loru y'o ma dabobo mi.","marked":"Lóru y'ó má dàbòbò mi."}],"end":12.961},{"key":"2","start":13.911,"lines":[{"start":13.911,"end":15.399,"text":"Nigba ti mo n rare kiri,","marked":"Nígbà tí mo ń ráre kiri"},{"start":15.849,"end":17.513,"text":"Ninu isina l'aginju,","marked":"Nínú ìṣìnà l'aginjù"},{"start":17.963,"end":19.244,"text":"O mu mi wa si pẹtẹlẹ,","marked":"Ó mú mi wá sí pẹ̀tẹ́lẹ̀"},{"start":19.694,"end":21.142,"text":"O fi ẹsẹ mi le ọna;","marked":"Ó fi ẹsẹ̀ mi lé ọ̀nà"},{"start":21.592,"end":23.242,"text":"Nib' odo tutu n san pẹlẹ,","marked":"Níb odò tútù ń sàn pẹ̀lẹ́"},{"start":23.692,"end":25.446,"text":"Larin papa oko tutu.","marked":"Lárin pápá oko tútù."}],"end":25.446},{"key":"3","start":26.396,"lines":[{"start":26.396,"end":27.932,"text":"Bi mo tilẹ n rin kọja lọ,","marked":"Bí mo tilẹ̀ ń rìn kọjá lọ"},{"start":28.382,"end":29.544,"text":"Ni afonifoji iku,","marked":"Ní àfonífojì ikú"},{"start":29.994,"end":31.296,"text":"Emi ki o bẹru-kẹru,","marked":"Èmi kí ó bẹru-kẹru"},{"start":31.746,"end":32.861,"text":"'Tori Iwọ wa pẹlu mi,","marked":"torí Ìwọ wà pẹ̀lú mi"},{"start":33.311,"end":35.42,"text":"Ọgọ at'ọpa Rẹ y'o mu","marked":"Ọ̀gọ àt'ọ̀pá Rẹ y'ó mú"},{"start":35.87,"end":37.665,"text":"Mi la ojiji iku ja.","marked":"Mi la òjìji ikú jà."}],"end":37.665},{"key":"4","start":38.615,"lines":[{"start":38.615,"end":40.237,"text":"Lẹhin ara ija lile,","marked":"Lẹ́hìn ara ìjà líle"},{"start":40.687,"end":42.331,"text":"'Wọ tẹ tabili kan fun mi;","marked":"'Wọ tẹ́ tábìlì kan fún mi"},{"start":42.781,"end":44.682,"text":"Ire at'anu ni mo n ri,","marked":"Ire àt'anú ni mo ń rí"},{"start":45.132,"end":46.788,"text":"Ago mi si n kun wọ silẹ:","marked":"Àgọ́ mi sì ń kún wọ́ sílẹ̀"},{"start":47.238,"end":48.758,"text":"'Wọ fun mi n'ireti ọrun,","marked":"'Wọ fún mi n'ìrètí ọ̀run"},{"start":49.208,"end":50.575,"text":"Ibugbe ayérayé mi.","marked":"Ibùgbé ayérayé mi."}],"end":50.575}]}