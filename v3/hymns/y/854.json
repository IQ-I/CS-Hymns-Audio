{"v":3,"coll":"y","num":854,"id":"hymn_854","title":"ISEGUN wa li okan mi","duration":42.199,"voices":{"male":{"file":"y-854-male-v3.m4a","bytes":309691,"sha256":"314be4a1fa4145c023a392c6b0fc24dbd5044d1072622100366a5a10e4a93d46","duration":42.2},"female":{"file":"y-854-female-v3.m4a","bytes":316248,"sha256":"fa0f4c8ebff8dff16de0b304d704a9a15b9d5a52bcbce8dc0244d36da668768d","duration":42.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.687,"text":"ISEGUN wa li okan mi","marked":"Ìṣẹ́gun wà lí ọkàn mi"},{"start":2.137,"end":3.515,"text":"Nitori Emi ngbe 'nu mi","marked":"Nítorí Èmi ńgbé nù mi"},{"start":3.965,"end":5.25,"text":"Jeki igbi idanwo de","marked":"Jẹ́kí ìgbì ìdánwò dé"},{"start":5.7,"end":7.294,"text":"Jesu mura lati gba mi.","marked":"Jésù múra láti gbà mí."}],"end":7.294},{"key":"CHORUS","start":8.244,"lines":[{"start":8.244,"end":11.375,"text":"Isegun! Isegun! isegun l'okan mi","marked":"Ìṣẹ́gun! Ìṣẹ́gun! ìṣẹ́gun l'ọkàn mi"},{"start":11.825,"end":14.924,"text":"Mo ni isegun nla 'tori Jesu gb'okan mi","marked":"Mo ní ìṣẹ́gun ńlá torí Jésù gb'ọkàn mi"},{"start":15.374,"end":18.526,"text":"Isegun! lsegun! bi odo sisan","marked":"Ìṣẹ́gun! Ìṣẹ́gun! bí odò ṣíṣàn"},{"start":18.976,"end":20.908,"text":"Mo nsegun nla ninu eje Jesu.","marked":"Mo ńṣẹ́gun ńlá nínú ẹ̀jẹ̀ Jésù."}],"end":20.908},{"key":"2","start":21.858,"lines":[{"start":21.858,"end":23.463,"text":"Bi 'ja tile le to si pe","marked":"Bí jà tilẹ̀ le tó sì pé"},{"start":23.913,"end":25.44,"text":"Bi esu tile b'okan mi ja","marked":"Bí èṣù tilẹ̀ b'ọkàn mi jà"},{"start":25.89,"end":28.149,"text":"Sibe, mo je alagbara","marked":"Síbẹ̀, mo jẹ́ alágbára"},{"start":28.599,"end":30.971,"text":"L'agbara Jesu, ngo segun.","marked":"L'agbára Jésù, ńgò ṣẹ́gun."}],"end":30.971},{"key":"3","start":31.921,"lines":[{"start":31.921,"end":33.547,"text":"Mo ni 'segun lori ese","marked":"Mo ní ṣẹ́gun lórí ẹ̀ṣẹ̀"},{"start":33.997,"end":35.536,"text":"Mo ni segun lori 'boji","marked":"Mo ní ṣẹ́gun lórí bojì"},{"start":35.986,"end":37.476,"text":"Ani iku ko ni 'pa mo","marked":"Àní ikú kò ní pa mọ́"},{"start":37.926,"end":39.574,"text":"Aleluya! emi ti la.","marked":"Alelúyà! èmi ti là."},{"start":40.024,"end":40.649,"text":"Amin.","marked":"Àmín."}],"end":40.649}]}