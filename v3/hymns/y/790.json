{"v":3,"coll":"y","num":790,"id":"hymn_790","title":"GBOGBO talaka ti mo mo","duration":49.194,"voices":{"male":{"file":"y-790-male-v3.m4a","bytes":337612,"sha256":"d310c0384c6841d598510964bd4ac87aa16ae3c72b5aea75f53ce6b8b25ef7fc","duration":49.2},"female":{"file":"y-790-female-v3.m4a","bytes":356698,"sha256":"05dfc42a0c677ea5a0907c353e03beb0881e9b8abc572e799a99d78072721296","duration":49.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.816,"text":"GBOGBO talaka ti mo mọ;","marked":"Gbogbo tálákà tí mo mọ̀"},{"start":2.266,"end":3.485,"text":"Wọn ti pọ n'iye to;","marked":"Wọ́n ti pọ̀ n'ìyè tó"},{"start":3.935,"end":5.377,"text":"Kini mba se f'Ọlọrun mi,","marked":"Kíni mbá ṣe f'Ọlọ́run mi"},{"start":5.827,"end":6.854,"text":"Fun gbogbo ẹbun Rẹ?","marked":"Fún gbogbo ẹ̀bùn Rẹ?"}],"end":6.854},{"key":"2","start":7.804,"lines":[{"start":7.804,"end":9.206,"text":"Mo san j'awọn ẹlomi ni?","marked":"Mo sàn j'àwọn ẹlòmí ni?"},{"start":9.656,"end":10.803,"text":"T'Ọlọrun se n kẹ mi?","marked":"T'Ọlọ́run ṣe ń kẹ́ mi?"},{"start":11.253,"end":13.343,"text":"Awọn ti n kiri, ti n sagbe,","marked":"Àwọn tí ń kiri, tí ń ṣagbe"},{"start":13.793,"end":14.905,"text":"Lati ilé dé'lé?","marked":"Láti ilé dé'lé?"}],"end":14.905},{"key":"3","start":15.855,"lines":[{"start":15.855,"end":17.122,"text":"Alakisa ọmọ melo,","marked":"Alákísà ọmọ mélò"},{"start":17.572,"end":18.904,"text":"Ni mbẹ l'otutu yi?","marked":"Ní mbẹ́ l'òtútù yí?"},{"start":19.354,"end":20.983,"text":"'Gba t'a fi aso wo mi,","marked":"gbà t'á fi aṣọ wò mí"},{"start":21.433,"end":22.579,"text":"Lat' ori d'ẹsẹ mi.","marked":"Lát orí d'ẹsẹ̀ mi."}],"end":22.579},{"key":"4","start":23.529,"lines":[{"start":23.529,"end":25.072,"text":"'Gba awọn mi se alairi,","marked":"gba àwọn mi ṣe aláìrí"},{"start":25.522,"end":26.749,"text":"Ibi gb'ori won le!","marked":"Ibi gb'orí wọn le!"},{"start":27.199,"end":28.673,"text":"Emi ni ile lati gbe,","marked":"Èmi ni ilẹ̀ láti gbé"},{"start":29.123,"end":30.367,"text":"Ati 'bukun rere.","marked":"Àti bùkún rere."}],"end":30.367},{"key":"5","start":31.317,"lines":[{"start":31.317,"end":33.259,"text":"'Gbat' awọn mi, ti wọn n purọ,","marked":"gbàt àwọn mi, tí wọ́n ń purọ́"},{"start":33.709,"end":35.772,"text":"Ti n jale, ti n bura;","marked":"Tí ń jalè, tí ń búra"},{"start":36.222,"end":37.683,"text":"Ni mo ti kọ ibẹru Rẹ,","marked":"Ni mo ti kọ ìbẹ̀rù Rẹ"},{"start":38.133,"end":39.348,"text":"Lati igba ewe mi","marked":"Láti ìgbà èwe mi"}],"end":39.348},{"key":"6","start":40.298,"lines":[{"start":40.298,"end":42.104,"text":"Sa wo, bi oju rere Rẹ,","marked":"Sá wò, bí ojú rere Rẹ"},{"start":42.554,"end":43.836,"text":"S'emi nikan ti pọ;","marked":"S'èmi nìkan ti pọ̀"},{"start":44.286,"end":46.098,"text":"Njẹ o yẹ ki n fẹ Ọ pupọ,","marked":"Ǹjẹ́ ó yẹ kí n fẹ́ Ọ púpọ̀"},{"start":46.548,"end":47.645,"text":"Ki n ma sin Ọ rere?","marked":"Kí n má sìn Ọ rere?"}],"end":47.645}]}