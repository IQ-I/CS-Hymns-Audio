{"v":3,"coll":"y","num":793,"id":"hymn_793","title":"JESU nikan ni a nwasu","duration":58.913,"voices":{"male":{"file":"y-793-male.m4a","bytes":425538,"sha256":"a4d354250a397b0c527e1b73b4bdff92410fa1040e92d0b42a7d75735e976f8f","duration":59.0},"female":{"file":"y-793-female.m4a","bytes":442999,"sha256":"d47e55127bac21e2c01ffe7703529d86ee5c33121f62a1b160945d6aad2e70fd","duration":59.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.075,"text":"JESU nikan ni a nwasu","marked":"Jésù nìkan ni à ńwáṣu"},{"start":2.455,"end":3.886,"text":"Jesu nikan l'a n rohin","marked":"Jésù nìkan l'á ń ròhìn"},{"start":4.266,"end":5.925,"text":"Awa yoo gbe Jesu soke","marked":"Àwa yóò gbé Jésù sókè"},{"start":6.305,"end":8.225,"text":"Oun nikan l'awa n fe ri.","marked":"Òun nìkan l'áwá ń fẹ́ rí."}],"end":8.225},{"key":"CHORUS","start":9.175,"lines":[{"start":9.175,"end":10.685,"text":"Egbe: Jesu nikan Jesu nikan","marked":"Jésù nìkan Jésù nìkan"},{"start":11.065,"end":12.548,"text":"Jesu nikan l'orin wa","marked":"Jésù nìkan l'orin wa"},{"start":12.928,"end":14.359,"text":"Olugbala, Oluwosan","marked":"Olùgbàlà, Olùwòsàn"},{"start":14.739,"end":16.301,"text":"Oba ti n bo leekeji.","marked":"Ọba ti ń bọ̀ lẹ́ẹ̀kejì."}],"end":16.301},{"key":"2","start":17.251,"lines":[{"start":17.251,"end":18.777,"text":"Jesu ni Olugbala wa,","marked":"Jésù ni Olùgbàlà wa"},{"start":19.157,"end":20.385,"text":"O ru gbogbo ebi wa","marked":"Ó ru gbogbo ẹbí wa"},{"start":20.765,"end":22.087,"text":"Ododo Re l'O gbe wo wa","marked":"Òdodo Re l'Ó gbé wọ̀ wá"},{"start":22.467,"end":24.467,"text":"O n s' agbara wa d'otun.","marked":"Ó ń s' agbara wa d'ọ̀tun."}],"end":24.467},{"key":"3","start":25.417,"lines":[{"start":25.417,"end":27.287,"text":"Jesu l'o n so wa di mimo","marked":"Jésù l'ó ń sọ wá di mímọ́́"},{"start":27.667,"end":28.945,"text":"T'o n we abawon wa nu","marked":"T'ó ń wé àbàwọ́n wa nù"},{"start":29.325,"end":30.986,"text":"O n segun ese at'ara","marked":"Ó ń ṣẹ́gun ẹsẹ̀ àt'ara"},{"start":31.366,"end":32.483,"text":"Nipa iranwo Emi.","marked":"Nípa ìrànwọ́ Ẹ̀mí."}],"end":32.483},{"key":"4","start":33.433,"lines":[{"start":33.433,"end":34.955,"text":"Jesu ni Oluwosan wa","marked":"Jésù ni Olùwòsàn wa"},{"start":35.335,"end":36.81,"text":"O ti ru ailera wa","marked":"Ó ti ru àìlera wa"},{"start":37.19,"end":38.702,"text":"Nip'agbara ajinde Re","marked":"Nip'agbara àjíǹde Rẹ"},{"start":39.082,"end":40.24,"text":"A ni ilera pipe.","marked":"A ní ìlera pípé."}],"end":40.24},{"key":"5","start":41.19,"lines":[{"start":41.19,"end":42.846,"text":"Jesu nikan l'agbara wa","marked":"Jésù nìkan l'ágbára wa"},{"start":43.226,"end":44.635,"text":"Agbara Pentikosti","marked":"Agbára Pentikosti"},{"start":45.015,"end":47.398,"text":"Joo, da agbara yii iu wa","marked":"Jọ̀ọ́, dá agbára yìí iù wa"},{"start":47.778,"end":49.092,"text":"F'Emi Mimo Re kun wa.","marked":"F'Ẹ̀mí Mímọ́́ Rẹ kún wa."}],"end":49.092},{"key":"6","start":50.042,"lines":[{"start":50.042,"end":51.583,"text":"Jesu ni awa n duro de","marked":"Jésù ni àwa ń dúró dè"},{"start":51.963,"end":53.175,"text":"A n reti ohun ipe","marked":"À ń retí ohun ìpè"},{"start":53.555,"end":55.287,"text":"'Gba t'O ba de Jesu nikan","marked":"'Gbà t'Ó bá de Jésù nìkan"},{"start":55.667,"end":57.363,"text":"Yoo je orin wa titi.","marked":"Yóò jẹ́ orin wa títí."}],"end":57.363}]}