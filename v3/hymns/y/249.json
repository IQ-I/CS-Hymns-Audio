{"v":3,"coll":"y","num":249,"id":"hymn_249","title":"A F'AYO r'ore-ofe","duration":31.6,"voices":{"male":{"file":"y-249-male-v3.m4a","bytes":210802,"sha256":"77a3a639d87d722784e2afa20d59cf2bd76fd61bd997eb48ff37477f33000d4f","duration":31.7},"female":{"file":"y-249-female-v3.m4a","bytes":220310,"sha256":"1ce4e28de75eda866081e0cf00ba068c11327634ca6d18604e7bc60121f61fef","duration":31.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.571,"text":"A F'AYỌ r'ore-ọfẹ","marked":"A F'Ayọ̀ r'ore-ọfẹ"},{"start":2.021,"end":3.09,"text":"T' Alufa giga wa,","marked":"T Àlùfá gíga wa"},{"start":3.54,"end":4.894,"text":"Ọkan Rẹ kun fun iyọnu,","marked":"Ọkàn Rẹ̀ kún fún ìyọnu"},{"start":5.344,"end":6.53,"text":"Inu Rẹ n yọ fun 'fẹ.","marked":"Inú Rẹ̀ ń yọ̀ fún 'fẹ."}],"end":6.53},{"key":"2","start":7.48,"lines":[{"start":7.48,"end":9.048,"text":"Tinutinu l'o n daro wa,","marked":"Tinútinú l'ó ń dárò wa"},{"start":9.498,"end":10.882,"text":"p O mọ ailera wa;","marked":"p Ó mọ àìlera wa"},{"start":11.332,"end":13.069,"text":"O mọ bi idanwo ti ri,","marked":"Ó mọ̀ bí ìdánwò ti rí"},{"start":13.519,"end":14.647,"text":"Nitori O ti ri.","marked":"Nítorí Ó ti rí."}],"end":14.647},{"key":"3","start":15.597,"lines":[{"start":15.597,"end":17.428,"text":"Oun papa l'ọjọ aye Rẹ,","marked":"Òun pápá l'ọjọ́ ayé Rẹ"},{"start":17.878,"end":19.143,"text":"O sọkun kikoro;","marked":"Ó sọkún kíkorò"},{"start":19.593,"end":21.065,"text":"O mba olukuluku pin,","marked":"Ó mba olúkúlùkù pín"},{"start":21.515,"end":22.762,"text":"Ninu iya ti n jẹ.","marked":"Nínú ìyá tí ń jẹ."}],"end":22.762},{"key":"4","start":23.712,"lines":[{"start":23.712,"end":25.017,"text":"Je ki a f'igbagbo 'rele","marked":"Jẹ́ kí a f'ìgbàgbọ́ rẹlẹ̀"},{"start":25.467,"end":26.721,"text":"W'anu at'ipa Re","marked":"W'àánú àt'ipá Rẹ̀"},{"start":27.171,"end":28.314,"text":"Awa o si ri igbala","marked":"Àwa ó sì rí ìgbàlà"},{"start":28.764,"end":30.051,"text":"L'akoko iyonu.","marked":"L'àkókò ìyọnu."}],"end":30.051}]}