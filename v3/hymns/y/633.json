{"v":3,"coll":"y","num":633,"id":"hymn_633","title":"TIRE titi lai l'awa se","duration":53.676,"voices":{"male":{"file":"y-633-male-v3.m4a","bytes":379964,"sha256":"66899da5ceb69ef7a016eed3713340fac59271200599347337dfbaf4b0c6f41c","duration":53.7},"female":{"file":"y-633-female-v3.m4a","bytes":394751,"sha256":"0ea60057e7d5b2222cf1560b5c3d19de675687b0b8239718a61e58389a6d7464","duration":53.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.897,"text":"TIRẸ titi lai l'awa se,","marked":"Tìrẹ títí láì l'àwa ṣe"},{"start":2.347,"end":3.594,"text":"Oluwa wa ọrun;","marked":"Olúwa wa ọ̀run"},{"start":4.044,"end":5.441,"text":"K'ohun at'ọkan wa wi pé,","marked":"K'ohun àt'ọkàn wa wí pé"},{"start":5.891,"end":7.276,"text":"Amin, bẹni k'o ri.","marked":"Àmín, bẹ́ni k'ó rí."}],"end":7.276},{"key":"2","start":8.226,"lines":[{"start":8.226,"end":9.654,"text":"Gba ti ayé ba n dun mọ ni,","marked":"Gbà tí ayé bá ń dùn mọ́ ni"},{"start":10.104,"end":11.275,"text":"T'o si n fa ọkan wa;","marked":"T'ó sì ń fa ọkàn wa"},{"start":11.725,"end":14.18,"text":"K'iro yi pe, Tirẹ l'awa","marked":"K'irọ́ yí pé, Tirẹ̀ l'àwa"},{"start":14.63,"end":16.088,"text":"Le ma dun l'eti wa.","marked":"Lè má dùn l'etí wa."}],"end":16.088},{"key":"3","start":17.038,"lines":[{"start":17.038,"end":18.439,"text":"'Gba t'ẹsẹ pẹlu ẹtan rẹ,","marked":"gbà t'ẹsẹ̀ pẹ̀lú ẹ̀tàn rẹ"},{"start":18.889,"end":20.039,"text":"Ba fẹ se wa n'ibi;","marked":"Bá fẹ́ ṣe wá n'ibi"},{"start":20.489,"end":22.543,"text":"K'iro yi pe, Tirẹ l'awa.","marked":"K'irọ́ yí pé, Tirẹ̀ l'àwa."},{"start":22.993,"end":24.55,"text":"Tu ẹtan ẹsẹ ka.","marked":"Tú ẹ̀tàn ẹsẹ̀ ká."}],"end":24.55},{"key":"4","start":25.5,"lines":[{"start":25.5,"end":26.967,"text":"'Gba ti Esu ba n tafa rẹ,","marked":"gbà tí Èṣù bá ń tafà rẹ̀"},{"start":27.417,"end":28.764,"text":"S'ori ailera wa;","marked":"S'orí àìlera wa"},{"start":29.214,"end":31.817,"text":"K'iro yi pe, Tirẹ l'awa,","marked":"K'irọ́ yí pé, Tirẹ̀ l'àwa"},{"start":32.267,"end":33.311,"text":"Ma jẹ ki o rẹ wa.","marked":"Má jẹ́ kí ó rẹ̀ wá."}],"end":33.311},{"key":"5","start":34.261,"lines":[{"start":34.261,"end":36.608,"text":"Tirẹ, n' igb' a wa l'ọmọde,","marked":"Tirẹ̀, n igb á wà l'ọmọdé"},{"start":37.058,"end":38.807,"text":"Tirẹ, n' igb' a ndagba,","marked":"Tirẹ̀, ń igb á ńdàgbà"},{"start":39.257,"end":41.413,"text":"Tirẹ, n' igb'a ba darugbo,","marked":"Tirẹ̀, ń ìgb'à bá darúgbó"},{"start":41.863,"end":43.181,"text":"Ti ayé wa n buse.","marked":"Tí ayé wá ń bùṣe."}],"end":43.181},{"key":"6","start":44.131,"lines":[{"start":44.131,"end":46.56,"text":"Tirẹ, titi lai l'awa se,","marked":"Tirẹ̀, títí láì l'àwa ṣe"},{"start":47.01,"end":48.176,"text":"A f'ara wa fun Ọ:","marked":"A f'ara wa fún Ọ"},{"start":48.626,"end":50.347,"text":"Titi ayé ainipẹkun,","marked":"Títí ayé àìnípẹ̀kun"},{"start":50.797,"end":52.127,"text":"Amin, bẹni k'o ri.","marked":"Àmín, bẹ́ni k'ó rí."}],"end":52.127}]}