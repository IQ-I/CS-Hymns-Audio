{"v":3,"coll":"y","num":417,"id":"hymn_417","title":"OLUWA mo de'bi te Re","duration":24.286,"voices":{"male":{"file":"y-417-male-v3.m4a","bytes":163100,"sha256":"a6d66a5b9f3857e6ed8171ee1d5bd477861700ed3a7721a8abbe02cc659be4b7","duration":24.3},"female":{"file":"y-417-female-v3.m4a","bytes":169638,"sha256":"d8171139654c996a7819e1734a04014935baa76a82bc7d0a6dd5432b9e168306","duration":24.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.019,"text":"OLUWA, mo de'bi 'tẹ Rẹ,","marked":"Olúwa, mo dẹ̀'bi 'tẹ Rẹ"},{"start":2.469,"end":3.429,"text":"Nibi ti anu pọ!","marked":"Níbi tí àánú pọ̀!"},{"start":3.879,"end":5.243,"text":"Mo fẹ 'dariji ẹsẹ mi,","marked":"Mo fẹ́ dáríjì ẹsẹ̀ mi"},{"start":5.693,"end":7.105,"text":"K'o mu ọkan mi da.","marked":"K'ó mú ọkàn mi dá."}],"end":7.105},{"key":"2","start":8.055,"lines":[{"start":8.055,"end":9.627,"text":"Oluwa, ko ye k'emi so","marked":"Olúwa, kò yẹ k'èmi sọ"},{"start":10.077,"end":11.099,"text":"Ohun ti mba bere","marked":"Ohun tí mbá bẹ̀rẹ̀"},{"start":11.549,"end":12.861,"text":"O ti mo k'emi to bere","marked":"Ó ti mọ̀ k'èmi tó bẹ̀rẹ̀"},{"start":13.311,"end":14.341,"text":"Ohun ti emi fe.","marked":"Ohun tí èmi fẹ́."}],"end":14.341},{"key":"3","start":15.291,"lines":[{"start":15.291,"end":16.528,"text":"p Oluwa mo tọrọ anu,","marked":"p Olúwa mọ́ tọ́rọ̀ àánú"},{"start":16.978,"end":18.666,"text":"Eyi yii l'opin na;","marked":"Èyí yìí l'òpin ná"},{"start":19.116,"end":21.166,"text":"Oluwa, anu l'o yẹ mi.","marked":"Olúwa, àánú l'ó yẹ mi."},{"start":21.616,"end":22.736,"text":"Jẹ ki anu Rẹ wa.","marked":"Jẹ́ kí àánú Rẹ wà."}],"end":22.736}]}