{"v":3,"coll":"y","num":559,"id":"hymn_559","title":"KRISTIAN, ma ti wa 'sinmi","duration":45.594,"voices":{"male":{"file":"y-559-male-v3.m4a","bytes":308255,"sha256":"38ba2bdc63af9c747546d05607a216b5f7b54e56d1fb00995224cfffe1341c1b","duration":45.6},"female":{"file":"y-559-female-v3.m4a","bytes":322931,"sha256":"f1be15502cdfa5496c618a70f9c1ebd5b30598833e768d786d2ececab21252c0","duration":45.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.307,"text":"KRISTIAN, ma ti wa 'simi","marked":"Kristian, má ti wá ṣímí"},{"start":2.757,"end":4.074,"text":"Gbo b'Angeli re ti nwi","marked":"Gbọ́ b'Áńgẹ́lì rẹ̀ ti ńwí"},{"start":4.524,"end":5.671,"text":"Ni arin ota l'o wa","marked":"Ní arin ọ̀tá l'ó wà"},{"start":6.121,"end":7.094,"text":"Ma sora.","marked":"Má ṣọ́ra."}],"end":7.094},{"key":"2","start":8.044,"lines":[{"start":8.044,"end":9.171,"text":"Ogun orun-apadi","marked":"Ogun orun-apadi"},{"start":9.621,"end":11.07,"text":"T'a ko ri nko ra won jo","marked":"T'á kò rí ńkò rà wọ́n jọ"},{"start":11.52,"end":12.801,"text":"Nwon nso ijafara re","marked":"Wọ́n ńṣọ́ ìjáfara rẹ̀"},{"start":13.251,"end":14.236,"text":"Ma sora.","marked":"Má ṣọ́ra."}],"end":14.236},{"key":"3","start":15.186,"lines":[{"start":15.186,"end":16.287,"text":"Wo 'hamora ogun re","marked":"Wo hámọ́ra ogun rẹ"},{"start":16.737,"end":18.432,"text":"Wo l'osan ati l'oru","marked":"Wo l'ọ̀sán àti l'òru"},{"start":18.882,"end":20.833,"text":"Esu nba, O nd'ode re","marked":"Èṣù ńbá, Ó ńd'ọdẹ rẹ̀"},{"start":21.283,"end":22.214,"text":"Ma sora.","marked":"Má ṣọ́ra."}],"end":22.214},{"key":"4","start":23.164,"lines":[{"start":23.164,"end":24.638,"text":"Awon t'o segun saju","marked":"Àwọn t'ó ṣẹ́gun sájú"},{"start":25.088,"end":26.907,"text":"Nwon nwo wa b'awa ti nja","marked":"Wọ́n ńwọ wá b'àwa ti ǹjà"},{"start":27.357,"end":28.771,"text":"Nwon nfi ohun kan wipe","marked":"Wọ́n ńfi ohun kan wípé"},{"start":29.221,"end":30.1,"text":"Ma sora.","marked":"Má ṣọ́ra."}],"end":30.1},{"key":"5","start":31.05,"lines":[{"start":31.05,"end":32.467,"text":"Gbo b'Oluwa re ti wi","marked":"Gbọ́ b'Olúwa rẹ ti wí"},{"start":32.917,"end":33.988,"text":"Eniti iwo feran","marked":"Ẹnití ìwọ fẹ́ràn"},{"start":34.438,"end":35.672,"text":"F'oro Re si okan re","marked":"F'ọ̀rọ̀ Rẹ sí ọkàn rẹ"},{"start":36.122,"end":37.08,"text":"Ma sora.","marked":"Má ṣọ́ra."}],"end":37.08},{"key":"6","start":38.03,"lines":[{"start":38.03,"end":39.274,"text":"Ma sora bi enipe","marked":"Má ṣọ́ra bí ẹnìpẹ́"},{"start":39.724,"end":40.911,"text":"Nibe ni 'segun re wa","marked":"Níbẹ̀ ni ṣẹ́gun rẹ̀ wà"},{"start":41.361,"end":42.667,"text":"Gbadura fun 'ranlowo","marked":"Gbàdúrà fún rànlọ́wọ́"},{"start":43.117,"end":44.045,"text":"Ma sora.","marked":"Má ṣọ́ra."}],"end":44.045}]}