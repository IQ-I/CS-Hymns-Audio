{"v":3,"coll":"y","num":735,"id":"hymn_735","title":"ENYlN om'egbe Serafu","duration":49.136,"voices":{"male":{"file":"y-735-male-v3.m4a","bytes":336598,"sha256":"8d52f9a9d678f933e211ff5eccb6ab49870a48a6d3d40df66d81d0a1c7bafb8a","duration":49.2},"female":{"file":"y-735-female-v3.m4a","bytes":353229,"sha256":"e3ea88070e141acafc549102195c8709d41198a7f862a01edc6e24ac810417af","duration":49.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.681,"text":"ENYlN om'egbe Serafu","marked":"Enyln ọm'ẹgbẹ́ Séráfù"},{"start":2.131,"end":3.741,"text":"E ko le p'e o ko 'ya","marked":"Ẹ kò lè p'é o kò yá"},{"start":4.191,"end":5.57,"text":"Enyin om egbe Kerubu","marked":"Ẹ̀yin ọm ẹgbẹ́ Kérúbù"},{"start":6.02,"end":7.756,"text":"E ko le pe e o ko ya.","marked":"Ẹ kò lè pè é ó kò yà."}],"end":7.756},{"key":"2","start":8.706,"lines":[{"start":8.706,"end":9.96,"text":"Enyin om'ogun gbala yi","marked":"Ẹ̀yin ọm'ogun gbàlà yí"},{"start":10.41,"end":12.034,"text":"E ko le pe e o k'egan","marked":"Ẹ kò lè pè é ó k'ẹ̀gàn"},{"start":12.484,"end":13.724,"text":"E ko le ko 'nunibini","marked":"Ẹ kò lè kọ́ nunibíni"},{"start":14.174,"end":15.439,"text":"Ati keta gbogbo.","marked":"Àti kẹta gbogbo."}],"end":15.439},{"key":"3","start":16.389,"lines":[{"start":16.389,"end":17.532,"text":"E gb'ohun Olugbala wa","marked":"Ẹ gb'ohùn Olùgbàlà wa"},{"start":17.982,"end":19.22,"text":"B'o ti nwi jeje pe","marked":"B'ó ti ńwí jẹ́jẹ́ pé"},{"start":19.67,"end":20.977,"text":"Ranti mi lor'agbelebu","marked":"Rántí mi lọ́r'àgbélébù"},{"start":21.427,"end":22.973,"text":"At, owo at'ese.","marked":"Àt, ọwọ́ àt'ẹsẹ̀."}],"end":22.973},{"key":"4","start":23.923,"lines":[{"start":23.923,"end":25.427,"text":"Bi a ba foriti 'ponju","marked":"Bí a bá forítì pọ́njú"},{"start":25.877,"end":27.047,"text":"Ti a si ru 'tiju","marked":"Tí a sì rú tijú"},{"start":27.497,"end":29.177,"text":"Ade ogo 'rawo Owuro","marked":"Adé ògo ràwọ̀ Òwúrọ̀"},{"start":29.627,"end":31.023,"text":"Y'o je tiwa n'kehin.","marked":"Y'ó jẹ́ tiwa n'kẹhìn."}],"end":31.023},{"key":"5","start":31.973,"lines":[{"start":31.973,"end":33.114,"text":"Ao pelu awon t'orun","marked":"Àó pẹ̀lú àwọn t'ọ̀run"},{"start":33.564,"end":34.666,"text":"Lati ma juba Re","marked":"Láti má júbà Rẹ"},{"start":35.116,"end":36.781,"text":"A o si ma ko orin Mose","marked":"A ó sì má kọ orin Mósè"},{"start":37.231,"end":38.534,"text":"Ati t'Odagutan.","marked":"Àti t'Ọ̀dágùtàn."}],"end":38.534},{"key":"6","start":39.484,"lines":[{"start":39.484,"end":41.437,"text":"Orin Halle, Halleluya!","marked":"Orin Halle, Hallelúyà!"},{"start":41.887,"end":42.945,"text":"lyin si Oba wa","marked":"Ìyìn sí Ọba wa"},{"start":43.395,"end":44.985,"text":"Metalokan Aiyeraiye","marked":"Mẹ́talọ́kan Ayérayé"},{"start":45.435,"end":46.602,"text":"Baba, Omo, Emi.","marked":"Baba, Ọmọ, Èmi."},{"start":47.052,"end":47.587,"text":"Amin.","marked":"Àmín."}],"end":47.587}]}