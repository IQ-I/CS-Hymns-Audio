{"v":3,"coll":"y","num":775,"id":"hymn_775","title":"BABA mi gbo temi","duration":29.819,"voices":{"male":{"file":"y-775-male-v3.m4a","bytes":197213,"sha256":"7041bab1263e2fe522b2e11079d8dc4690694f9d0965b4ccda33283e2f662d9e","duration":29.9},"female":{"file":"y-775-female-v3.m4a","bytes":201879,"sha256":"216bf81bb1be8791b46f237b89f04dc07644fdf4069afd677229b45aae758ab6","duration":29.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.671,"text":"BABA mi gbọ temi!","marked":"Baba mi gbọ́ tèmi!"},{"start":2.121,"end":3.155,"text":"'Wọ ni Alabo mi,","marked":"'Wọ ni Alábọ́ mi"},{"start":3.605,"end":4.757,"text":"Ma sunmọ mi titi;","marked":"Má súnmọ́ mi títí"},{"start":5.207,"end":6.186,"text":"Oninure julọ!","marked":"Onínúre jùlọ!"}],"end":6.186},{"key":"2","start":7.136,"lines":[{"start":7.136,"end":8.148,"text":"Jesu Oluwa mi,","marked":"Jésù Olúwa mi"},{"start":8.598,"end":9.707,"text":"Iye at'ogo mi,","marked":"Iye àt'ògo mi"},{"start":10.157,"end":11.592,"text":"K'igba naa yara de,","marked":"K'ìgbà náà yára dé"},{"start":12.042,"end":13.335,"text":"Ti n ó de ọdọ Rẹ.","marked":"Tí n ó dé ọ̀dọ̀ Rẹ."}],"end":13.335},{"key":"3","start":14.285,"lines":[{"start":14.285,"end":15.44,"text":"Olutunu julọ,","marked":"Olùtùnú jùlọ"},{"start":15.89,"end":17.01,"text":"'Wọ ti n gbe inu mi,","marked":"'Wọ tí ń gbé inú mi"},{"start":17.46,"end":18.716,"text":"'Wọ to mọ aini mi,","marked":"'Wọ tó mọ àìní mi"},{"start":19.166,"end":21.081,"text":"Fa mi, k'o si gba mi.","marked":"Fà mí, k'ó sì gbà mí."}],"end":21.081},{"key":"4","start":22.031,"lines":[{"start":22.031,"end":23.267,"text":"Mimọ, mimọ, mimọ,","marked":"Mímọ́, mímọ́, mímọ́"},{"start":23.717,"end":24.979,"text":"Ma fi mi silẹ lai,","marked":"Má fi mí sílẹ̀ láì"},{"start":25.429,"end":26.5,"text":"Se mi n'ibugbe Rẹ,","marked":"Ṣe mí n'ibùgbé Rẹ"},{"start":26.95,"end":28.27,"text":"Tirẹ nikan lailai.","marked":"Tirẹ̀ nìkan láéláé."}],"end":28.27}]}