{"v":3,"coll":"y","num":285,"id":"hymn_285","title":"HOSANNA! e korin soke","duration":50.741,"voices":{"male":{"file":"y-285-male.m4a","bytes":364106,"sha256":"3f3ab0044e335199c7840b65bf01fbcff15c2f5f35e98b14645238d7c06f8103","duration":50.8},"female":{"file":"y-285-female.m4a","bytes":379498,"sha256":"289cdcddb19cf9ff758ddeef377bf0926cbc0383239c167b06fbb0e7c3d00e75","duration":50.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.638,"text":"HOSANNA! e korin soke","marked":"Hosanna! ẹ kọrin sókè"},{"start":3.018,"end":4.148,"text":"S'omo nla Dafidi,","marked":"S'ọ́mọ ńlá Dáfídì"},{"start":4.528,"end":6.049,"text":"Pelu Kerub ati Seraf","marked":"Pẹ̀lú Kerúb àti Séráf"},{"start":6.429,"end":7.443,"text":"K'a yin Om-Olorun.","marked":"K'á yin Om-Ọlọ́run."}],"end":7.443},{"key":"2","start":8.393,"lines":[{"start":8.393,"end":10.172,"text":"Hosanna! eyi na nikan","marked":"Hosanna! èyí ná nìkan"},{"start":10.552,"end":11.7,"text":"L'ahon wa le ma ko","marked":"L'ahọ́n wa lè má kó"},{"start":12.08,"end":13.32,"text":"Iwo ki okegan ewe","marked":"Ìwọ kí ọ̀kẹ́gàn ẹ̀wẹ́"},{"start":13.7,"end":14.675,"text":"Ti nkorin iyin Re.","marked":"Ti nkorin ìyìn Rẹ."}],"end":14.675},{"key":"3","start":15.625,"lines":[{"start":15.625,"end":17.242,"text":"Hosanna! Alufa Oba,","marked":"Hosanna! Àlùfá Ọba"},{"start":17.622,"end":19.103,"text":"Ebun Re ti po to!","marked":"Ẹ̀bùn Rẹ̀ ti pọ̀ tó!"},{"start":19.483,"end":20.992,"text":"Eje Re lo je iye wa,","marked":"Ẹ̀jẹ̀ Rẹ̀ ló jẹ́ iye wa"},{"start":21.372,"end":22.847,"text":"Ore Re ni onje wa.","marked":"Ọ̀rẹ́ Rẹ ni òǹjẹ wa."}],"end":22.847},{"key":"4","start":23.797,"lines":[{"start":23.797,"end":25.991,"text":"Hosanna! Baba, awa mu","marked":"Hosanna! Bàbá, àwa mú"},{"start":26.371,"end":27.398,"text":"Ore wa wa fun O,","marked":"Ọ̀rẹ́ wa wà fún Ọ"},{"start":27.778,"end":29.527,"text":"Ki se wura on ojia","marked":"Kí ṣe wúrà ọ́n òjíá"},{"start":29.907,"end":31.272,"text":"Bikose okan wa.","marked":"Bíkọ́ṣẹ́ ọkàn wa."}],"end":31.272},{"key":"5","start":32.222,"lines":[{"start":32.222,"end":34.333,"text":"Hosanna! Jesu, lekan ri,","marked":"Hosanna! Jésù, lẹ́kàn rí"},{"start":34.713,"end":35.795,"text":"O yin awon ewe","marked":"Ó yin àwọn èwe"},{"start":36.175,"end":37.924,"text":"Sanu fun wa si f'eti si,","marked":"Sanu fún wa sí f'etí sí"},{"start":38.304,"end":39.255,"text":"Orin awa ewe.","marked":"Orin àwa èwe."}],"end":39.255},{"key":"6","start":40.205,"lines":[{"start":40.205,"end":42.635,"text":"Jesu, b' O ba ra wa pada","marked":"Jésù, b' Ó bá rà wá padà"},{"start":43.015,"end":44.22,"text":"T'a si wo 'joba Re","marked":"T'á sì wọ 'jọba Rẹ̀"},{"start":44.6,"end":46.205,"text":"A o fi harpu wura ko","marked":"A ó fi harpu wúrà kọ́"},{"start":46.585,"end":48.297,"text":"Hosanna titi lai.","marked":"Hosanna títí láì."},{"start":48.677,"end":49.191,"text":"Amin.","marked":"Àmín."}],"end":49.191}]}