{"v":3,"coll":"y","num":525,"id":"hymn_525","title":"GBAT'AYE yi ba koja","duration":59.358,"voices":{"male":{"file":"y-525-male-v3.m4a","bytes":419870,"sha256":"ee2ef88c78df07fc5cdca323a1db51415509d9a7eabd4b506e0c9bacf11bc5ea","duration":59.4},"female":{"file":"y-525-female-v3.m4a","bytes":435358,"sha256":"699951df0653221eecaf9389253c3afc7bb4634f4fd771f290308df6e4964a41","duration":59.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.856,"text":"'GBAT' AYÉ yi ba kọja,","marked":"gbàt Ayé yí bá kọjá"},{"start":2.306,"end":3.624,"text":"T'orun re ba si wọ,","marked":"T'ọ̀run rẹ bá sì wọ́"},{"start":4.074,"end":5.371,"text":"Ti a ba wọ 'nu ogo,","marked":"Tí a bá wọ̀ nù ògo"},{"start":5.821,"end":7.22,"text":"T'a boju wo ẹhin wa,","marked":"T'á bojú wo ẹ̀hìn wa"},{"start":7.67,"end":9.199,"text":"'Gbana, Oluwa, n o mọ,","marked":"gbàná, Olúwa, n ó mọ̀"},{"start":9.649,"end":10.994,"text":"Bi gbese mi ti pọ to.","marked":"Bí gbèsè mi ti pọ̀ tó."}],"end":10.994},{"key":"2","start":11.944,"lines":[{"start":11.944,"end":13.498,"text":"'Gba mo ba de b'itẹ Rẹ,","marked":"gbà mo bá dé b'ìtẹ́ Rẹ"},{"start":13.948,"end":15.462,"text":"'Lẹwa ti ki se t'emi,","marked":"'Lẹwa tí kí ṣe t'èmi"},{"start":15.912,"end":17.492,"text":"'Gba mo ri Ọ b'O ti ri,","marked":"gbà mo rí Ọ b'Ó ti rí"},{"start":17.942,"end":19.056,"text":"Ti mo fẹ Ọ l'afẹtan;","marked":"Tí mo fẹ́ Ọ l'àfẹ̀tàn"},{"start":19.506,"end":21.264,"text":"'Gbana, Oluwa , n ó mọ,","marked":"gbàná, Olúwa , n ó mọ̀"},{"start":21.714,"end":22.944,"text":"Bi gbese mi ti pọ to.","marked":"Bí gbèsè mi ti pọ̀ tó."}],"end":22.944},{"key":"3","start":23.894,"lines":[{"start":23.894,"end":25.187,"text":"'Gba mba n gbọ orin ọrun,","marked":"gbà mbá ń gbọ́ orin ọ̀run"},{"start":25.637,"end":27.036,"text":"Ti n dun bi ohun ara,","marked":"Tí ń dùn bí ohun ara"},{"start":27.486,"end":28.666,"text":"Bi iro omi pupọ,","marked":"Bí ìró omi púpọ̀"},{"start":29.116,"end":30.34,"text":"T'o sin dun b'ohun duru,","marked":"T'ó sìn dùn b'ohun dùrù"},{"start":30.79,"end":32.722,"text":"'Gbana, Oluwa n ó mọ,","marked":"gbàná, Olúwa n ó mọ̀"},{"start":33.172,"end":34.525,"text":"Bi gbese mi ti pọ to.","marked":"Bí gbèsè mi ti pọ̀ tó."}],"end":34.525},{"key":"4","start":35.475,"lines":[{"start":35.475,"end":37.008,"text":"Oluwa, jọ, jẹ k'a ri","marked":"Olúwa, jọ, jẹ́ k'á rí"},{"start":37.458,"end":38.758,"text":"Ojiji Rẹ l'ayé yi;","marked":"Òjìji Rẹ̀ l'ayé yí"},{"start":39.208,"end":40.538,"text":"K'a mo adun 'dariji,","marked":"K'á mọ adùn dáríjì"},{"start":40.988,"end":41.952,"text":"Pẹlu iranwọ Ẹmi;","marked":"Pẹ̀lú ìrànwọ́ Ẹ̀mí"},{"start":42.402,"end":43.883,"text":"Ki n tilẹ mọ l'ayé yi,","marked":"Kí n tilẹ̀ mọ́ l'ayé yí"},{"start":44.333,"end":45.727,"text":"Diẹ ninu 'gbese mi.","marked":"Díẹ̀ nínú gbèsè mi."}],"end":45.727},{"key":"5","start":46.677,"lines":[{"start":46.677,"end":47.935,"text":"Ore-ọfẹ l'o yan mi,","marked":"Ore-ọfẹ l'ó yàn mí"},{"start":48.385,"end":49.786,"text":"L'o yọ mi ninu ewu;","marked":"L'ó yọ mí nínú ewu"},{"start":50.236,"end":51.682,"text":"Jesu l'Olugbala mi,","marked":"Jésù l'Olùgbàlà mi"},{"start":52.132,"end":53.254,"text":"Ẹmi sọ mi di mimọ,","marked":"Ẹ̀mí sọ mí di mímọ́"},{"start":53.704,"end":56.101,"text":"Kọ mi, ki n fihan l'ayé,","marked":"Kọ́ mi, kí n fihàn l'ayé"},{"start":56.551,"end":57.809,"text":"Bi gbese mi ti pọ to!","marked":"Bí gbèsè mi ti pọ̀ tó!"}],"end":57.809}]}