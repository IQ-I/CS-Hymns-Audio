{"v":3,"coll":"y","num":436,"id":"hymn_436","title":"MO fi gbogbo re fun Jesu","duration":70.404,"voices":{"male":{"file":"y-436-male-v3.m4a","bytes":498078,"sha256":"3aa8ed7d9e0dbf9eef83facdf55622857b8de87f22fbf5c0bc028bdc503530af","duration":70.5},"female":{"file":"y-436-female-v3.m4a","bytes":518118,"sha256":"2a2fe6bc999268a9c2e1e34285d5a7dbeb5f323c6d586a79341b38f90dad6df7","duration":70.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.866,"text":"MO fi gbogbo re fun Jesu,","marked":"Mo fi gbogbo rẹ̀ fún Jésù"},{"start":2.316,"end":3.741,"text":"Patapata l'aiku 'kan","marked":"Pátápátá l'àìkú kan"},{"start":4.191,"end":6.98,"text":"Ngo ma fe, ngo si gbekele","marked":"Ngo má fẹ́, ngo sì gbẹ́kẹ̀lé"},{"start":7.43,"end":9.08,"text":"Ngo si ma ba gbe titi.","marked":"Ngó sì má bá gbé títí."}],"end":9.08},{"key":"CHORUS","start":10.03,"lines":[{"start":10.03,"end":12.187,"text":"Mo fi gbogbo re, Mo fi gbogbo re","marked":"Mo fi gbogbo rẹ̀, Mo fi gbogbo rẹ̀"},{"start":12.637,"end":14.434,"text":"Fun O, Olugbala mi, ni","marked":"Fún Ọ, Olùgbàlà mi, ni"},{"start":14.884,"end":15.987,"text":"Mo fi won sile.","marked":"Mo fi wọ́n sílẹ̀."}],"end":15.987},{"key":"2","start":16.937,"lines":[{"start":16.937,"end":18.586,"text":"Mo fi gbogbo re fun Jesu,","marked":"Mo fi gbogbo rẹ̀ fún Jésù"},{"start":19.036,"end":20.403,"text":"Mo si wole lese Re,","marked":"Mo sì wọlé lẹ́sẹ̀ Rẹ"},{"start":20.853,"end":22.371,"text":"Mo fi afe aiye sile","marked":"Mo fi afẹ́ ayé sílẹ̀"},{"start":22.821,"end":25.117,"text":"Jesu, Jo gba mi wayi.","marked":"Jésù, Jó gbà mí wàyí."}],"end":25.117},{"key":"3","start":26.067,"lines":[{"start":26.067,"end":27.635,"text":"Mo fi gbogbo re fun Jesu,","marked":"Mo fi gbogbo rẹ̀ fún Jésù"},{"start":28.085,"end":29.752,"text":"Jesu se mi ni Tire","marked":"Jésù ṣe mí ní Tire"},{"start":30.202,"end":31.64,"text":"Jek' Emi Mimo s'eleri","marked":"Jẹ́k Ẹ̀mí Mímọ́ s'ẹlẹ́rí"},{"start":32.09,"end":33.783,"text":"Pe, O si je t'emi na.","marked":"Pé, Ó sì jẹ́ t'èmi ná."}],"end":33.783},{"key":"4","start":34.733,"lines":[{"start":34.733,"end":36.416,"text":"Mo fi gbogbo re fun Jesu,","marked":"Mo fi gbogbo rẹ̀ fún Jésù"},{"start":36.866,"end":38.204,"text":"Mo f'ara mi f'Oluwa","marked":"Mo f'ara mi f'Olúwa"},{"start":38.654,"end":40.353,"text":"F'ife at'agbara kun mi","marked":"F'ìfẹ́ àt'agbára kún mi"},{"start":40.803,"end":42.211,"text":"Si fun mi n'ibukun Re.","marked":"Sì fún mi n'ìbùkún Rẹ."}],"end":42.211},{"key":"5","start":43.161,"lines":[{"start":43.161,"end":44.805,"text":"Mo fi gbogbo re fun Jesu,","marked":"Mo fi gbogbo rẹ̀ fún Jésù"},{"start":45.255,"end":46.499,"text":"Okan mi ngbona wayi","marked":"Ọkàn mi ńgbóná wàyí"},{"start":46.949,"end":48.454,"text":"A! ayo igbala kikun","marked":"A! ayọ̀ ìgbàlà kíkún"},{"start":48.904,"end":50.345,"text":"Ogo ni f'oruko Re.","marked":"Ògo ni f'orúkọ Rẹ."}],"end":50.345},{"key":"6","start":51.295,"lines":[{"start":51.295,"end":52.924,"text":"Mo fi gbogbo re fun Jesu,","marked":"Mo fi gbogbo rẹ̀ fún Jésù"},{"start":53.374,"end":54.759,"text":"Mo f'ojo aiye mi fun","marked":"Mo f'ọjọ́ ayé mi fún"},{"start":55.209,"end":57.784,"text":"K'o ma so, k'o si ma to mi","marked":"K'ó má sọ, k'ó sì má tọ̀ mi"},{"start":58.234,"end":59.67,"text":"K'o fi 'nu mi se 'bugbe.","marked":"K'ó fi nù mi ṣe bùgbé."}],"end":59.67},{"key":"7","start":60.62,"lines":[{"start":60.62,"end":62.045,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":62.495,"end":63.927,"text":"Se Metalokan n'tire","marked":"Ṣe Mẹ́talọ́kan n'tirẹ̀"},{"start":64.377,"end":67.012,"text":"Fi Baba, Omo at'Emi","marked":"Fi Baba, Ọmọ àt'èmi"},{"start":67.462,"end":68.855,"text":"Se tire titi aiye.","marked":"Ṣe tirẹ̀ títí ayé."}],"end":68.855}]}