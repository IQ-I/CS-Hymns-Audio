{"v":3,"coll":"y","num":182,"id":"hymn_182","title":"GBO ohun alore","duration":67.052,"voices":{"male":{"file":"y-182-male-v3.m4a","bytes":453459,"sha256":"5409116e62ca8ad1fcb6809d662b1d82346fbfc95da186616eaa45448b4310f8","duration":67.1},"female":{"file":"y-182-female-v3.m4a","bytes":470597,"sha256":"e79ba6a2221ecf724ab1c78860c095de9c25496ed6132b2651dfa38cffd2fced","duration":67.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.327,"text":"GBỌ ohun alore,","marked":"Gbọ́ ohun alóre"},{"start":1.777,"end":2.732,"text":"Ji, ara, ji;","marked":"Jí, ara, jí"},{"start":3.182,"end":4.463,"text":"Jesu ma fẹrẹ de,","marked":"Jésù má fẹ́rẹ̀ dé"},{"start":4.913,"end":5.807,"text":"Ji, ara, ji:","marked":"Jí, ara, jí"},{"start":6.257,"end":7.397,"text":"Ọmọ oru ni n sun,","marked":"Ọmọ òru ní ń sùn"},{"start":7.847,"end":9.189,"text":"Ọmọ imọlẹ l'ẹyin,","marked":"Ọmọ ìmọ́lẹ̀ l'ẹ́yìn"},{"start":9.639,"end":10.965,"text":"Ti ń yin l'ogo didan,","marked":"Tí ń yín l'ògo dídán"},{"start":11.415,"end":12.238,"text":"Ji, ara ji.","marked":"Jí, ara jí."}],"end":12.238},{"key":"2","start":13.188,"lines":[{"start":13.188,"end":15.167,"text":"Sọ f'ẹgbẹ t'o ti ji,","marked":"Sọ f'ẹ̀gbẹ́ t'ó ti jí"},{"start":15.617,"end":17.083,"text":"Ara, sọra;","marked":"Ara, sọ́ra"},{"start":17.533,"end":18.856,"text":"Asẹ Jesu daju","marked":"Àsẹ Jésù dájú"},{"start":19.306,"end":20.504,"text":"Ara, sọra;","marked":"Ara, sọ́ra"},{"start":20.954,"end":22.037,"text":"Ẹ se b'olusọna,","marked":"Ẹ ṣe b'olùsọ́nà"},{"start":22.487,"end":24.038,"text":"N'ilẹkun Oluwa yin,","marked":"N'ìlẹ̀kùn Olúwa yín"},{"start":24.488,"end":25.518,"text":"Bi o tilẹ pẹ de,","marked":"Bí ó tilẹ̀ pẹ́ dé"},{"start":25.968,"end":26.815,"text":"Ara, sọra.","marked":"Ara, sọ́ra."}],"end":26.815},{"key":"3","start":27.765,"lines":[{"start":27.765,"end":28.798,"text":"Gbọ ohun iriju,","marked":"Gbọ́ ohun ìríjú"},{"start":29.248,"end":30.531,"text":"Ara, sisẹ;","marked":"Ara, sisẹ́"},{"start":30.981,"end":32.16,"text":"Isẹ naa kari wa,","marked":"Isẹ́ náà kárí wa"},{"start":32.61,"end":33.463,"text":"Ara sisẹ;","marked":"Ara sisẹ́"},{"start":33.913,"end":34.878,"text":"Ọgba Oluwa wa,","marked":"Ọgbà Olúwa wa"},{"start":35.328,"end":36.811,"text":"Kun fun 'sẹ nigba gbogbo,","marked":"Kún fún 'sẹ nígbà gbogbo"},{"start":37.261,"end":38.575,"text":"Y'O si fun wa lere,","marked":"Y'Ó sì fún wa lérè"},{"start":39.025,"end":40.066,"text":"Ara sisẹ.","marked":"Ara sisẹ́."}],"end":40.066},{"key":"4","start":41.016,"lines":[{"start":41.016,"end":41.924,"text":"Gb'ohun Oluwa wa,","marked":"Gb'ohùn Olúwa wa"},{"start":42.374,"end":43.228,"text":"Ẹ gbadura,","marked":"Ẹ gbàdúrà"},{"start":43.678,"end":45.099,"text":"B‘ẹ fẹ k‘inu rẹ dun","marked":"B'ẹ fẹ́ k'inú rẹ̀ dùn"},{"start":45.549,"end":46.476,"text":"Ẹ gbadura","marked":"Ẹ gbàdúrà"},{"start":46.926,"end":47.909,"text":"Ẹsẹ mu 'bẹru wa,","marked":"Ẹsẹ̀ mú 'bẹru wá"},{"start":48.359,"end":49.634,"text":"Alailera si ni wa;","marked":"Aláìlera sì ni wá"},{"start":50.084,"end":51.255,"text":"Ni ijakadi yin,","marked":"Ní ìjàkadì yín"},{"start":51.705,"end":52.713,"text":"Ẹ gbadura.","marked":"Ẹ gbàdúrà."}],"end":52.713},{"key":"5","start":53.663,"lines":[{"start":53.663,"end":54.96,"text":"Kọ orin ikẹhin,","marked":"Kọ orin ìkẹ́hìn"},{"start":55.41,"end":56.321,"text":"Yin, ara yin,","marked":"Yín, ara yín"},{"start":56.771,"end":57.824,"text":"Mimọ ni Oluwa,","marked":"Mímọ́ ni Olúwa"},{"start":58.274,"end":59.21,"text":"Yin, ara yin;","marked":"Yín, ara yín"},{"start":59.66,"end":60.75,"text":"Ki l'o tun yẹ ahọn,","marked":"Kí l'ó tún yẹ ahọ́n"},{"start":61.2,"end":62.513,"text":"T'o fẹrẹ b'angẹl kọrin,","marked":"T'ó fẹ́rẹ̀ b'angẹl kọrin"},{"start":62.963,"end":64.08,"text":"T' y'ọrọ lọrun titi,","marked":"T y'ọ̀rọ̀ lọ́rùn títí"},{"start":64.53,"end":65.503,"text":"Yin ara, yin.","marked":"Yín ara, yín."}],"end":65.503}]}