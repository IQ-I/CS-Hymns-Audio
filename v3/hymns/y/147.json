{"v":3,"coll":"y","num":147,"id":"hymn_147","title":"GBO orin eni irapada","duration":53.658,"voices":{"male":{"file":"y-147-male-v3.m4a","bytes":386364,"sha256":"ad4e7d8cd996fed6711a0489cef8ecf162a8407f15e0ad492fab6cdcf45aa499","duration":53.7},"female":{"file":"y-147-female-v3.m4a","bytes":397320,"sha256":"8f57653098554244303a0e22df408e8bb0382b83d8f7544cefc3aaedd13c2317","duration":53.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.848,"text":"GBO orin eni irapada","marked":"Gbọ́ orin ẹni ìràpadà"},{"start":2.298,"end":3.246,"text":"Orin iyin titun","marked":"Orin ìyìn titun"},{"start":3.696,"end":5.642,"text":"Wọn yin Ọdaguntan l'ogo","marked":"Wọ́n yin Ọ̀dàgùntàn l'ògo"},{"start":6.092,"end":14.778,"text":"Wọn ń kọrin naa bayi. Ogo f'Ẹni to fẹ wa, T'o fẹjẹ Rẹ wẹ wa, Ti o si sọ wa di mimọ, N'nu ibi iye ni.","marked":"Wọ́n ń kọrin náà báyì. Ògo f'Ẹni tó fẹ́ wá, T'ó fẹ́jẹ́ Rẹ̀ wẹ̀ wá, Tí ó sì sọ wá di mímọ́, N'nú ibi ìyè ni."}],"end":14.778},{"key":"CHORUS","start":15.728,"lines":[{"start":15.728,"end":16.965,"text":"Ogo f 'Eni to fe wa,","marked":"Ògo f ẹni tó fẹ́ wá"},{"start":17.415,"end":18.623,"text":"T'o f 'eje Re we wa,","marked":"T'ó f ẹ̀jẹ̀ Rẹ̀ wẹ̀ wá"},{"start":19.073,"end":20.512,"text":"Ti o si so wa di mimo","marked":"Tí ó sì sọ wá di mímọ́"},{"start":20.962,"end":22.206,"text":"N'nu ibi iye ni.","marked":"N'nú ibi ìyè ni."}],"end":22.206},{"key":"2","start":23.156,"lines":[{"start":23.156,"end":24.783,"text":"A f'ọsọ wa n'nu ẹjẹ Rẹ,","marked":"A f'ọ̀sọ́ wa n'nú ẹ̀jẹ̀ Rẹ"},{"start":25.233,"end":26.457,"text":"O si funfun laulau;","marked":"Ó sì funfun láùláù"},{"start":26.907,"end":28.216,"text":"'Mọlẹ t'o tan si ọkan,","marked":"'Mọlẹ t'ó tàn sí ọkàn"},{"start":28.666,"end":29.917,"text":"Nf'ipa ootọ Rẹ han.","marked":"Ńf'ipa òótọ́ Rẹ hàn."}],"end":29.917},{"key":"3","start":30.867,"lines":[{"start":30.867,"end":32.682,"text":"Nipa agbara Ẹjẹ Jesu,","marked":"Nípa agbára Ẹ̀jẹ̀ Jésù"},{"start":33.132,"end":34.465,"text":"L'a fọ 'tẹgun Esu;","marked":"L'á fọ́ 'tẹgun Èṣù"},{"start":34.915,"end":36.227,"text":"Nipa agbara Ootọ Rẹ,","marked":"Nípa agbára Òótọ́ Rẹ"},{"start":36.677,"end":37.808,"text":"La se bori ọta.","marked":"La ṣe borí ọ̀tá."}],"end":37.808},{"key":"4","start":38.758,"lines":[{"start":38.758,"end":40.094,"text":"Je ka juba Ọdaguntan,","marked":"Jẹ́ ká júbà Ọ̀dàgùntàn"},{"start":40.544,"end":41.724,"text":"T'o fun wa ni 'mọlẹ;","marked":"T'ó fún wa ní 'mọlẹ"},{"start":42.174,"end":43.921,"text":"Tire l'ogo at'agbara","marked":"Tirẹ̀ l'ògo àt'agbára"},{"start":44.371,"end":52.109,"text":"Olanla at'ipa. Ogo f'Ẹni to fẹ wa, T'o fẹjẹ Rẹ wẹ wa, Ti o si sọ wa di mimọ, N'nu ibi iye ni.","marked":"Ọláńlá àt'ipá. Ògo f'Ẹni tó fẹ́ wá, T'ó fẹ́jẹ́ Rẹ̀ wẹ̀ wá, Tí ó sì sọ wá di mímọ́, N'nú ibi ìyè ni."}],"end":52.109}]}