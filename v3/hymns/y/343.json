{"v":3,"coll":"y","num":343,"id":"hymn_343","title":"ALAFIA f'ojo naa, Alleluya","duration":74.569,"voices":{"male":{"file":"y-343-male-v3.m4a","bytes":556358,"sha256":"ce3cd25dae6b7cb2caf1d8470e9518592bec35acbe12ca0dc3596333b88cef68","duration":74.6},"female":{"file":"y-343-female-v3.m4a","bytes":560954,"sha256":"472710c0a6460f5e9e14c8333f722cd3be4441a0f85093185e2e5987fc34851d","duration":74.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.025,"text":"ALAFIA f'ọjọ naa, Alleluya!","marked":"Àlàáfíà f'ọjọ́ náà, Allelúyà!"},{"start":3.475,"end":4.813,"text":"T'o pada s'itẹ l'ọrun,","marked":"T'ó padà s'ìtẹ́ l'ọ̀run"},{"start":5.263,"end":6.136,"text":"Alleluia!","marked":"Alleluia!"},{"start":6.586,"end":8.876,"text":"Ọdaguntan ẹlẹsẹ, Alleluya!","marked":"Ọ̀dàgùntàn ẹlẹ́sẹ̀, Allelúyà!"},{"start":9.326,"end":11.309,"text":"Goke ọrun giga lọ, Alleluya!","marked":"Gòkè ọ̀run gíga lọ, Allelúyà!"}],"end":11.309},{"key":"2","start":12.259,"lines":[{"start":12.259,"end":14.688,"text":"Iyin n duro de nibẹ, Alleluya!","marked":"Ìyìn ń dúró dé níbẹ̀, Allelúyà!"},{"start":15.138,"end":18.243,"text":"Gb'ori yin ẹyin 'lẹkun, Alleluya","marked":"Gb'orí yín ẹ̀yin 'lẹkun, Allelúyà"},{"start":18.693,"end":20.687,"text":"Gba Ọba ogo sile, Alleluya!","marked":"Gba Ọba ògo sílẹ̀, Allelúyà!"},{"start":21.137,"end":23.528,"text":"Ẹni t'o sẹgun iku, Alleluya!","marked":"Ẹni t'ó sẹ́gun ikú, Allelúyà!"}],"end":23.528},{"key":"3","start":24.478,"lines":[{"start":24.478,"end":26.85,"text":"Ọrun gba Oluwa rẹ, Alleluya!","marked":"Ọ̀run gba Olúwa rẹ̀, Allelúyà!"},{"start":27.3,"end":30.131,"text":"Sibẹ, O fẹran ayé, Alleluya!","marked":"Síbẹ̀, Ó fẹ́ràn ayé, Allelúyà!"},{"start":30.581,"end":33.427,"text":"B'o ti pada s'oritẹ, Alleluya!","marked":"B'ó ti padà s'orítẹ̀, Allelúyà!"},{"start":33.877,"end":36.843,"text":"O ń p'ẹda ni t'Oun sibẹ, Alleluya!","marked":"Ó ń p'ẹ̀dà ní t'Òun síbẹ̀, Allelúyà!"}],"end":36.843},{"key":"4","start":37.793,"lines":[{"start":37.793,"end":40.194,"text":"Wo, O gbọwọ Rẹ soke, Alleluya!","marked":"Wò, Ó gbọwọ́ Rẹ̀ sókè, Allelúyà!"},{"start":40.644,"end":43.122,"text":"Wo, O f'apa ifẹ han, Alleluya!","marked":"Wò, Ó f'apá ìfẹ́ hàn, Allelúyà!"},{"start":43.572,"end":45.71,"text":"Gbọ, bi Oun ti ń sure fun, Alleluya!","marked":"Gbọ́, bí Òun ti ń súre fún, Allelúyà!"},{"start":46.16,"end":48.252,"text":"Ijọ Rẹ layé nihin, Alleluya!","marked":"Ìjọ Rẹ̀ layé níhìn, Allelúyà!"}],"end":48.252},{"key":"5","start":49.202,"lines":[{"start":49.202,"end":51.984,"text":"Sibẹ, O mbẹbẹ fun wa, Alleluya!","marked":"Síbẹ̀, Ó mbẹ̀bẹ̀ fún wa, Allelúyà!"},{"start":52.434,"end":55.163,"text":"Iku Rẹ l'o fi mbẹbẹ, Alleluya!","marked":"Ikú Rẹ̀ l'ó fi mbẹ̀bẹ̀, Allelúyà!"},{"start":55.613,"end":58.302,"text":"O ń pese aye fun wa, Alleluya!","marked":"Ó ń pèsè ayé fún wa, Allelúyà!"},{"start":58.752,"end":61.22,"text":"Oun l'akọbi iran wa, Alleluya!","marked":"Òun l'àkọ́bí ìran wa, Allelúyà!"}],"end":61.22},{"key":"6","start":62.17,"lines":[{"start":62.17,"end":64.438,"text":"Oluwa, b'a ti gba O, Alleluya!","marked":"Olúwa, b'á ti gbà Ọ́, Allelúyà!"},{"start":64.888,"end":67.202,"text":"Jina kuro lodo wa, Alleluya!","marked":"Jìnà kúrò lọ́dọ̀ wa, Allelúyà!"},{"start":67.652,"end":69.972,"text":"M'okan wa lo sibe na, Alleluya!","marked":"M'ọkàn wa lọ síbẹ̀ ná, Allelúyà!"},{"start":70.422,"end":73.02,"text":"K'a wa O loke orun, Alleluya!","marked":"K'á wá Ó lókè ọ̀run, Allelúyà!"}],"end":73.02}]}