{"v":3,"coll":"y","num":93,"id":"hymn_93","title":"A F'OPE f'Olorun.","duration":45.28,"voices":{"male":{"file":"y-93-male-v3.m4a","bytes":314758,"sha256":"a92c778376d8d7d2d54af70ae71601bb352c6bbed7dc2a59ce1f5d849fe147a1","duration":45.3},"female":{"file":"y-93-female-v3.m4a","bytes":328768,"sha256":"2be44e823487191e0c7285e84e0a42301b0be5160fabe5c4ffe8c4a00ea00fd7","duration":45.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.524,"text":"A F'ỌPẸ f'Ọlọrun,","marked":"A F'Ọpẹ́ f'Ọlọ́run"},{"start":1.974,"end":3.402,"text":"L'ọkan ati ohun wa;","marked":"L'ọkàn àti ohun wa"},{"start":3.852,"end":4.904,"text":"Ẹni n s'ohun 'yanu,","marked":"Ẹní ń s'ohun yanu"},{"start":5.354,"end":6.795,"text":"N'nu Ẹni t'arayé n yọ;","marked":"N'nú Ẹni t'arayé ń yọ̀"},{"start":7.245,"end":8.713,"text":"mp Gba t'a wa l'ọm'ọwọ,","marked":"mp Gbà t'á wá l'ọ́m'ọwọ́"},{"start":9.163,"end":10.358,"text":"Oun na l'o n tọju wa,","marked":"Òun ná l'ó ń tọ́jú wá"},{"start":10.808,"end":12.0,"text":"O si nf'ẹbun ifẹ,","marked":"Ó sì ńf'ẹ̀bùn ìfẹ́"},{"start":12.45,"end":13.798,"text":"Se 'tọju wa sibẹ.","marked":"Ṣe 'tọju wá síbẹ̀."}],"end":13.798},{"key":"2","start":14.748,"lines":[{"start":14.748,"end":15.705,"text":"Ọba Onib'ọrẹ,","marked":"Ọba Oníb'ọ̀rẹ́"},{"start":16.155,"end":17.509,"text":"Ma fi wa silẹ lailai;","marked":"Má fi wá sílẹ̀ láéláé"},{"start":17.959,"end":19.82,"text":"Ayọ ti ko l'opin,","marked":"Ayọ̀ tí kò l'òpin"},{"start":20.27,"end":21.976,"text":"Oun 'bukun y'o jẹ tiwa;","marked":"Òun bùkún y'ó jẹ́ tiwa"},{"start":22.426,"end":23.454,"text":"Pa wa mọ n'nu ore,","marked":"Pa wá mọ̀ n'nú ọ̀rẹ́"},{"start":23.904,"end":25.187,"text":"To wa gba 'ba damu,","marked":"Tó wá gba bá dàmú"},{"start":25.637,"end":26.709,"text":"Yọ wa ninu ibi,","marked":"Yọ wà nínú ibi"},{"start":27.159,"end":28.698,"text":"Layé ati l'ọrun.","marked":"Layé àti l'ọ̀run."}],"end":28.698},{"key":"3","start":29.648,"lines":[{"start":29.648,"end":30.826,"text":"K'a fi iyin oun ọpẹ,","marked":"K'á fi ìyìn òun ọpẹ́"},{"start":31.276,"end":33.142,"text":"F'Ọlọrun Baba, Ọmọ;","marked":"F'Ọlọ́run Baba, Ọmọ"},{"start":33.592,"end":34.646,"text":"At' Ẹmi Mimọ,","marked":"Àt Ẹ̀mí Mímọ́"},{"start":35.096,"end":36.469,"text":"Ti o ga julọ l'ọrun;","marked":"Tí ó ga jùlọ l'ọ̀run"},{"start":36.919,"end":38.022,"text":"Ọlọrun kan lailai,","marked":"Ọlọ́run kan láéláé"},{"start":38.472,"end":39.881,"text":"T'ayé at'ọrun mbọ,","marked":"T'ayé àt'ọ̀run mbọ̀"},{"start":40.331,"end":41.69,"text":"Bẹ lo wa d'isinyi,","marked":"Bẹ́ ló wá d'ìsìnyí"},{"start":42.14,"end":43.731,"text":"Bẹni y'o wa lailai.","marked":"Bẹni y'ó wà láéláé."}],"end":43.731}]}