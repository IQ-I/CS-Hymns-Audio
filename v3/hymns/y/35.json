{"v":3,"coll":"y","num":35,"id":"hymn_35","title":"OLUWA ojo isinmi","duration":38.084,"voices":{"male":{"file":"y-35-male-v3.m4a","bytes":268310,"sha256":"3e58620bb4ae47c2a0203cebfd653a4eb909bbf8725a6942937c0f2b76453a26","duration":38.1},"female":{"file":"y-35-female-v3.m4a","bytes":287409,"sha256":"5a3f590bcaf13e671104b8a478e494f57de16e289e7e70dba112ae13c6846a9e","duration":38.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.714,"text":"OLUWA ọjọ isinmi,","marked":"Olúwa ọjọ́ ìsinmi"},{"start":2.164,"end":4.05,"text":"Gbọ tiwa, pẹlu wa loni:","marked":"Gbọ́ tiwa, pẹ̀lú wa lónì"},{"start":4.5,"end":5.917,"text":"Awa pade fun adura,","marked":"Àwa pàdé fún àdúrà"},{"start":6.367,"end":8.022,"text":"A fẹ gb'ọrọ T'O fi fun wa.","marked":"A fẹ́ gb'ọ̀rọ̀ T'Ó fi fún wa."}],"end":8.022},{"key":"2","start":8.972,"lines":[{"start":8.972,"end":10.523,"text":"Isinmi t'ayé yi rọrun,","marked":"Ìsinmi t'ayé yí rọrùn"},{"start":10.973,"end":12.922,"text":"Sugbọn isinmi t'ọrun dun;","marked":"Sùgbọ́n ìsinmi t'ọ̀run dùn"},{"start":13.372,"end":14.839,"text":"Lala ọkan wa fẹ 'jo na,","marked":"Lálà ọkàn wa fẹ́ jọ ná"},{"start":15.289,"end":17.274,"text":"T'a o sinmi lailẹsẹ da.","marked":"T'a ó sinmi láìlẹ́sẹ̀ dá."}],"end":17.274},{"key":"3","start":18.224,"lines":[{"start":18.224,"end":20.246,"text":"mf Ko s'ija, ko si 'dagiri,","marked":"mf Kò s'ìjà, kò sì dàgìrì"},{"start":20.696,"end":22.655,"text":"Ko s'aniyan bi t'ayé yi","marked":"Kò s'àníyàn bí t'ayé yí"},{"start":23.105,"end":24.899,"text":"T' y'o dapọ mọ ikọrin wa","marked":"T y'ó dàpọ̀ mọ́ ìkọrin wa"},{"start":25.349,"end":26.872,"text":"T'o n t'ete aiku jade wa.","marked":"T'ó ń t'ètè àìkú jáde wá."}],"end":26.872},{"key":"4","start":27.822,"lines":[{"start":27.822,"end":29.856,"text":"Bẹbẹ, ọjọ t'a ti n reti,","marked":"Bẹ̀bẹ̀, ọjọ́ t'á ti ń retí"},{"start":30.306,"end":31.679,"text":"Afẹmọju rẹ l'a fẹ ri;","marked":"Àfẹ̀mọ́jú rẹ̀ l'a fẹ́ rí"},{"start":32.129,"end":33.592,"text":"A fẹ yọ lọna isẹ yi,","marked":"A fẹ́ yọ lọ́nà isẹ́ yí"},{"start":34.042,"end":36.534,"text":"K'a sun n'iku, k'a ji l'ayọ.","marked":"K'á sun n'ikú, k'á jí l'ayọ̀."}],"end":36.534}]}