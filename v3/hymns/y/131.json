{"v":3,"coll":"y","num":131,"id":"hymn_131","title":"A k'orin s'Omo Olorun","duration":32.663,"voices":{"male":{"file":"y-131-male-v3.m4a","bytes":221195,"sha256":"75d24e674084f1b8c6b0dc2595279149aafc19a9e81c6137185c9ef69454ec3f","duration":32.7},"female":{"file":"y-131-female-v3.m4a","bytes":227792,"sha256":"02c9a81ba5509b3dc5dd2f04fe37fb5c913e98298d8d651d6f7ddbec17126e62","duration":32.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.551,"text":"A k'orin s'Omo Olorun","marked":"A k'ọrin s'Ọmọ Ọlọ́run"},{"start":2.001,"end":3.236,"text":"Odagutan t'a pa","marked":"Ọ̀dàgùtàn t'á pa"},{"start":3.686,"end":5.195,"text":"Ti orun ati aye mbo","marked":"Ti ọ̀run àti ayé mbọ̀"},{"start":5.645,"end":6.954,"text":"T'O ye lati joba.","marked":"T'Ó yẹ láti jọba."}],"end":6.954},{"key":"2","start":7.904,"lines":[{"start":7.904,"end":9.269,"text":"Si O l'awon Angeli nke","marked":"Sí Ó l'àwọn Áńgẹ́lì ńké"},{"start":9.719,"end":11.002,"text":"L'ekun gbogbo orun","marked":"L'ẹkún gbogbo ọ̀run"},{"start":11.452,"end":13.254,"text":"Mimo mimo, mim'Olorun","marked":"Mímọ́ mímọ́, mím'ọlọ́run"},{"start":13.704,"end":15.303,"text":"T'ogo at'om'ogun.","marked":"T'ògo àt'ọm'ogun."}],"end":15.303},{"key":"3","start":16.253,"lines":[{"start":16.253,"end":17.463,"text":"ljo Re li aye dapo","marked":"Ìjọ Rẹ̀ lí ayé dàpọ̀"},{"start":17.913,"end":19.052,"text":"Lati ma kepe O","marked":"Láti má képe Ọ"},{"start":19.502,"end":20.613,"text":"Didan Olanlan Olorun","marked":"Dídán Ọláńlán Ọlọ́run"},{"start":21.063,"end":22.29,"text":"T'O l'agbara gbogbo.","marked":"T'Ó l'agbára gbogbo."}],"end":22.29},{"key":"4","start":23.24,"lines":[{"start":23.24,"end":24.622,"text":"Larin won ni gbogbo wa nfe","marked":"Lárin wọn ni gbogbo wa ńfẹ́"},{"start":25.072,"end":26.236,"text":"Lai yin eje re","marked":"Láì yin ẹ̀jẹ̀ rẹ̀"},{"start":26.686,"end":28.546,"text":"Joba l'aye ati l'orun","marked":"Jọba l'ayé àti l'ọ̀run"},{"start":28.996,"end":30.091,"text":"Wo Omo Olorun.","marked":"Wo Ọmọ Ọlọ́run."},{"start":30.541,"end":31.114,"text":"Amin.","marked":"Àmín."}],"end":31.114}]}