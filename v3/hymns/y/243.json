{"v":3,"coll":"y","num":243,"id":"hymn_243","title":"OLUWA, ma moju kuro","duration":41.777,"voices":{"male":{"file":"y-243-male-v3.m4a","bytes":286440,"sha256":"07817a728180561f2dfbc67d2d8e625e5424f91231ff7c855dd018c162825404","duration":41.8},"female":{"file":"y-243-female-v3.m4a","bytes":298546,"sha256":"87ea97ecac0c63cb0e50eaaa271e7ef367bb5ef06c36d48c59d770634f51593e","duration":41.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.135,"text":"OLUWA, ma moju kuro,","marked":"Olúwa, má mójú kúrò"},{"start":2.585,"end":4.097,"text":"L'ọdọ emi t'o n yilẹ;","marked":"L'ọ́dọ̀ èmi t'ó ń yílẹ̀"},{"start":4.547,"end":6.093,"text":"Ti n sọkun ẹsẹ ayé mi,","marked":"Tí ń sọkún ẹsẹ̀ ayé mi"},{"start":6.543,"end":7.719,"text":"N'itẹ anu ifẹ Rẹ.","marked":"N'ìtẹ́ àánú ìfẹ́ Rẹ̀."}],"end":7.719},{"key":"2","start":8.669,"lines":[{"start":8.669,"end":9.967,"text":"Ma ba mi lọ sinu 'dajọ,","marked":"Má bá mi lọ sínú 'dajọ"},{"start":10.417,"end":11.775,"text":"Bi ẹsẹ mi ti pọ to;","marked":"Bí ẹsẹ̀ mi ti pọ̀ tó"},{"start":12.225,"end":13.542,"text":"Nitori mo mọ daju pe,","marked":"Nítorí mo mọ̀ dájú pé"},{"start":13.992,"end":15.516,"text":"Emi ko wa lailẹbi.","marked":"Èmi kò wà láìlẹ́bi."}],"end":15.516},{"key":"3","start":16.466,"lines":[{"start":16.466,"end":18.292,"text":"Iwọ mọ, ki n to jẹwọ rẹ,","marked":"Ìwọ mọ́, kí n tó jẹ́wọ́ rẹ̀"},{"start":18.742,"end":19.988,"text":"Bi mo ti n se layé mi;","marked":"Bí mo ti ń ṣe layé mi"},{"start":20.438,"end":22.062,"text":"At' iwa isinsin yii mi,","marked":"Àt ìwà ìsinsin yìí mi"},{"start":22.512,"end":24.023,"text":"Gbogbo rẹ l'O kiyesi.","marked":"Gbogbo rẹ̀ l'Ó kíyèsi."}],"end":24.023},{"key":"4","start":24.973,"lines":[{"start":24.973,"end":26.62,"text":"Emi ko ni f‘ atunwi se,","marked":"Èmi kò ní f àtúnwí ṣe"},{"start":27.07,"end":28.293,"text":"Ohun ti mo fẹ tọrọ;","marked":"Ohun tí mo fẹ́ tọ́rọ̀"},{"start":28.743,"end":30.38,"text":"Ni iwọ mọ ki n to bere,","marked":"Ní ìwọ mọ́ kí n tó bẹ̀rẹ̀"},{"start":30.83,"end":32.244,"text":"Anu ni lọpọlọpọ.","marked":"Àánú ni lọ́pọ̀lọpọ̀."}],"end":32.244},{"key":"5","start":33.194,"lines":[{"start":33.194,"end":34.347,"text":"Anu Oluwa ni mo fẹ,","marked":"Àánú Olúwa ni mo fẹ́"},{"start":34.797,"end":36.097,"text":"Eyi l‘opin gbogbo rẹ;","marked":"Èyí l'òpin gbogbo rẹ̀"},{"start":36.547,"end":38.466,"text":"Tori anu ni mo n tọrọ,","marked":"Torí àánú ni mo ń tọrọ"},{"start":38.916,"end":40.228,"text":"Jẹ ki n ri anu gba.","marked":"Jẹ́ kí n rí àánú gbà."}],"end":40.228}]}