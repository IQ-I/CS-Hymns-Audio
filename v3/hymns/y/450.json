{"v":3,"coll":"y","num":450,"id":"hymn_450","title":"'Gba mo le ka oye mi re","duration":31.87,"voices":{"male":{"file":"y-450-male-v3.m4a","bytes":217789,"sha256":"383fb25d86d342b3411b536e5f1e589fa14e1d256cf27e70a483f39f599fa2ce","duration":31.9},"female":{"file":"y-450-female-v3.m4a","bytes":226745,"sha256":"8b62391e042e12fbec773414355dd31fd9f6642dc9c9b4bbfa74a605c393d684","duration":31.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.91,"text":"'Gba mo le ka oye mi re","marked":"gbà mo lè ka òye mi rẹ"},{"start":2.36,"end":3.322,"text":"Ni ibugbe l'oke","marked":"Ní ibùgbé l'òkè"},{"start":3.772,"end":5.155,"text":"Mo dagbere f 'eru gbogbo","marked":"Mo dágbére f ẹ̀rù gbogbo"},{"start":5.605,"end":6.661,"text":"Mo n'omije mi nu.","marked":"Mo n'omijé mi nù."}],"end":6.661},{"key":"2","start":7.611,"lines":[{"start":7.611,"end":9.132,"text":"B'ayé kọju ‘ja s'ọkan mi,","marked":"B'ayé kọjú jà s'ọkàn mi"},{"start":9.582,"end":10.796,"text":"T'a ń sọ oko si i;","marked":"T'á ń sọ oko sí i"},{"start":11.246,"end":12.534,"text":"'Gbana mo le rin Satani,","marked":"gbàná mo lè rin Sátánì"},{"start":12.984,"end":14.328,"text":"Ki ń si jẹju k'ayé.","marked":"Kí ń sì jẹ́jú k'ayé."}],"end":14.328},{"key":"3","start":15.278,"lines":[{"start":15.278,"end":16.654,"text":"K'aniyan de b'ikun omi,","marked":"K'àníyàn dé b'ikún omi"},{"start":17.104,"end":18.349,"text":"f K'iji banujẹ ja;","marked":"f K'ìjì banújẹ́ jà"},{"start":18.799,"end":20.325,"text":"Ki ń sa de'le alafia,","marked":"Kí ń sá dé'lé àlàáfíà"},{"start":20.775,"end":21.834,"text":"Ọlọrun, gbogbo mi,","marked":"Ọlọ́run, gbogbo mi"}],"end":21.834},{"key":"4","start":22.784,"lines":[{"start":22.784,"end":24.286,"text":"Nibẹ lọkan mi y'o luwẹ,","marked":"Níbẹ̀ lọ́kàn mi y'ó lúwẹ"},{"start":24.736,"end":26.201,"text":"N'nu okun isinmi;","marked":"N'nú okùn ìsinmi"},{"start":26.651,"end":28.389,"text":"Ko si wahala t'o le de;","marked":"Kò sí wàhálà t'ó lè dé"},{"start":28.839,"end":30.32,"text":"S'ibalẹ aya mi.","marked":"S'íbàlẹ̀ àyà mi."}],"end":30.32}]}