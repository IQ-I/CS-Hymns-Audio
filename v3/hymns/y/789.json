{"v":3,"coll":"y","num":789,"id":"hymn_789","title":"IBUKUN ni fun agbara","duration":64.014,"voices":{"male":{"file":"y-789-male-v3.m4a","bytes":439432,"sha256":"aa7494f7bd176014da2af6aa0b1b9c42b4172d5c0c7a0ad793f1d4e2d96d0e6c","duration":64.1},"female":{"file":"y-789-female-v3.m4a","bytes":461519,"sha256":"2b8e4647748e16b51ba4e755216f0d4dc9a8b8cf4b3dfbc1f9e38c4bd7fb1b79","duration":64.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.855,"text":"IBUKUN ni fun agbara,","marked":"Ìbùkún ni fún agbára"},{"start":2.305,"end":3.404,"text":"Ododo oun Ọgbọn,","marked":"Òdodo òun Ọgbọ́n"},{"start":3.854,"end":5.625,"text":"At' Ore-ọfẹ t'o papọ,","marked":"Àt Ore-ọfẹ t'ó papọ̀"},{"start":6.075,"end":7.381,"text":"S'Isẹ Igbala wa.","marked":"S'Ìsẹ Ìgbàlà wa."}],"end":7.381},{"key":"2","start":8.331,"lines":[{"start":8.331,"end":10.263,"text":"Baba wa j'eso-'gi aijẹ,","marked":"Baba wa j'eso-'gi àìjẹ"},{"start":10.713,"end":11.839,"text":"Ogo Rẹ si wọ ‘mi;","marked":"Ògo Rẹ sì wọ̀ mi"},{"start":12.289,"end":13.513,"text":"Awa ọmọ re d'ẹru,","marked":"Àwa ọmọ rẹ̀ d'ẹrù"},{"start":13.963,"end":15.193,"text":"Esu ati Iku.","marked":"Èṣù àti Ikú."}],"end":15.193},{"key":"3","start":16.143,"lines":[{"start":16.143,"end":17.789,"text":"Ọpẹ fun Baba t'O f'Ọmọ,","marked":"Ọpẹ́ fún Baba t'Ó f'Ọmọ"},{"start":18.239,"end":19.394,"text":"Rẹ kansoso fun wa","marked":"Rẹ̀ kanṣoṣo fún wa"},{"start":19.844,"end":21.881,"text":"Ẹni t'O ku, k'awa le ye,","marked":"Ẹni t'Ó kú, k'àwa lè yè"},{"start":22.331,"end":23.716,"text":"Ka le d'ọm' Ọlọrun.","marked":"Ká lè d'ọm' Ọlọ́run."}],"end":23.716},{"key":"4","start":24.666,"lines":[{"start":24.666,"end":26.184,"text":"Ofin Baba gbogbo t'a ru","marked":"Òfin Baba gbogbo t'a rú"},{"start":26.634,"end":27.822,"text":"L'Omo ti a pa mo","marked":"L'Ọmọ tí a pa mọ́"},{"start":28.272,"end":29.803,"text":"O ku lori agbelebu","marked":"Ó kú lórí àgbélébùú"},{"start":30.253,"end":31.434,"text":"Nitori ese wa.","marked":"Nítorí ẹ̀ṣẹ̀ wa."}],"end":31.434},{"key":"5","start":32.384,"lines":[{"start":32.384,"end":33.87,"text":"Wo! O ji dide n'iboji,","marked":"Wò! Ó jí dìde n'ibojì"},{"start":34.32,"end":35.622,"text":"O si goke r'ọrun,","marked":"Ó sì gòkè r'ọ̀run"},{"start":36.072,"end":37.574,"text":"Nibẹ ni O n f'Itoye Rẹ,","marked":"Níbẹ̀ ni Ó ń f'Ìtòye Rẹ"},{"start":38.024,"end":39.224,"text":"Gba gbogb' arufin la","marked":"Gba gbogb arúfin là"}],"end":39.224},{"key":"6","start":40.174,"lines":[{"start":40.174,"end":41.545,"text":"O gunwa lor'ite ogo","marked":"Ó gúnwà lọ́r'ìtẹ́ ògo"},{"start":41.995,"end":42.997,"text":"Pelu agbara nla","marked":"Pẹ̀lú agbára ńlá"},{"start":43.447,"end":44.895,"text":"O f'ewon ide ese ja","marked":"Ó f'ẹ̀wọ̀n idẹ ẹ̀ṣẹ̀ já"},{"start":45.345,"end":46.647,"text":"T'Esu ti fi de wa.","marked":"T'Èṣù ti fi dé wá."}],"end":46.647},{"key":"7","start":47.597,"lines":[{"start":47.597,"end":49.048,"text":"O si tun mbo wa se 'dajo","marked":"Ó sì tún mbọ̀ wá ṣe dájọ́"},{"start":49.498,"end":50.504,"text":"Pelu ola-nla Re","marked":"Pẹ̀lú ola-nla Rẹ"},{"start":50.954,"end":52.524,"text":"Y'o pe awon oku mimo","marked":"Y'ó pe àwọn òkú mímọ́"},{"start":52.974,"end":54.087,"text":"Jade pelu ayo.","marked":"Jáde pẹ̀lú ayọ̀."}],"end":54.087},{"key":"8","start":55.037,"lines":[{"start":55.037,"end":56.44,"text":"Mba le duro l'ayọ pẹlu,","marked":"Mbá lè dúró l'ayọ̀ pẹ̀lú"},{"start":56.89,"end":58.635,"text":"N'waju On'dajọ yi!","marked":"N'wájú Oń'dájọ́ yí!"},{"start":59.085,"end":60.556,"text":"Ki n si kọrin irapada,","marked":"Kí n sì kọrin ìràpadà"},{"start":61.006,"end":62.465,"text":"Pẹl' awọn t'a gbala.","marked":"Pẹl' àwọn t'á gbàlà."}],"end":62.465}]}