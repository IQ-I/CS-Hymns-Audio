{"v":3,"coll":"y","num":486,"id":"hymn_486","title":"OHUN t'a fi fun O","duration":46.323,"voices":{"male":{"file":"y-486-male-v3.m4a","bytes":318446,"sha256":"93da28146d43b14e9b89d02567d3e9aa8940f8f6a07382dfb4e21f6de95ab2f2","duration":46.4},"female":{"file":"y-486-female-v3.m4a","bytes":329306,"sha256":"20d94a2b9b2190e5a90aff241811b8c31a0ee77074722bcfcec6138d78ecf18e","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.465,"text":"OHUN t'a fi fun Ọ","marked":"Ohun t'a fi fún Ọ"},{"start":1.915,"end":3.028,"text":"Tirẹ ni Oluwa:","marked":"Tìrẹ ni Olúwa"},{"start":3.478,"end":4.92,"text":"Gbogbo ohun ti a si ni,","marked":"Gbogbo ohun tí a sì ní"},{"start":5.37,"end":6.732,"text":"Ọwọ Rẹ lo ti wa.","marked":"Ọwọ́ Rẹ̀ ló ti wá."}],"end":6.732},{"key":"2","start":7.682,"lines":[{"start":7.682,"end":9.18,"text":"Jẹ k'a gba ẹbun Rẹ,","marked":"Jẹ́ k'á gba ẹ̀bùn Rẹ"},{"start":9.63,"end":10.676,"text":"Bi iriju rere;","marked":"Bí ìríjú rere"},{"start":11.126,"end":12.706,"text":"Bi O si ti mbukun wa to,","marked":"Bí Ó sì ti mbùkún wa tó"},{"start":13.156,"end":14.458,"text":"Bẹ l'a o fi fun Ọ.","marked":"Bẹ́ l'á ó fi fún Ọ."}],"end":14.458},{"key":"3","start":15.408,"lines":[{"start":15.408,"end":16.603,"text":"Ọpọ ni isẹ n sẹ,","marked":"Ọ̀pọ̀ ni isẹ́ ń sẹ́"},{"start":17.053,"end":18.183,"text":"Ti wọn ko r'Ounjẹ jẹ;","marked":"Tí wọn kò r'Oúnjẹ jẹ"},{"start":18.633,"end":20.177,"text":"Ọpọ l'o si ti sako lọ,","marked":"Ọ̀pọ̀ l'ó sì ti ṣáko lọ"},{"start":20.627,"end":21.87,"text":"Kuro l'agbo Jesu.","marked":"Kúrò l'agbo Jésù."}],"end":21.87},{"key":"4","start":22.82,"lines":[{"start":22.82,"end":24.021,"text":"K'a ma tu ni ninu","marked":"K'á má tú ni nínú"},{"start":24.471,"end":25.689,"text":"K'a ma re ni l'ekun","marked":"K'á má rẹ̀ ní l'ẹkún"},{"start":26.139,"end":27.611,"text":"K'a ma bo alainibaba","marked":"K'á má bọ́ aláìníbaba"},{"start":28.061,"end":29.537,"text":"N'ise t'a ba ma se.","marked":"N'ìṣe t'á bá má ṣe."}],"end":29.537},{"key":"5","start":30.487,"lines":[{"start":30.487,"end":31.858,"text":"K'a tu onde silẹ,","marked":"K'á tú òǹdè sílẹ̀"},{"start":32.308,"end":33.387,"text":"K'a f'ọna iye han,","marked":"K'á f'ọ̀nà ìyè hàn"},{"start":33.837,"end":35.007,"text":"K'a kọ ni lọna Ọlọrun,","marked":"K'á kọ́ ní lọ́nà Ọlọ́run"},{"start":35.457,"end":36.906,"text":"B'iwa Kristi lo ri.","marked":"B'ìwà Kristi ló rí."}],"end":36.906},{"key":"6","start":37.856,"lines":[{"start":37.856,"end":39.062,"text":"A gba ọrọ Rẹ gbọ,","marked":"A gba ọ̀rọ̀ Rẹ̀ gbọ́"},{"start":39.512,"end":40.641,"text":"Busi igbagbọ wa;","marked":"Búsi ìgbàgbọ́ wa"},{"start":41.091,"end":42.756,"text":"f Ohun t'a se fun ẹni Rẹ,","marked":"f Ohun t'a ṣe fún ẹni Rẹ"},{"start":43.206,"end":44.774,"text":"Jesu, a se fun Ọ.","marked":"Jésù, a ṣe fún Ọ."}],"end":44.774}]}