{"v":3,"coll":"y","num":652,"id":"hymn_652","title":"ASE ife Orun","duration":47.293,"voices":{"male":{"file":"y-652-male-v3.m4a","bytes":324874,"sha256":"69bf88a07f461a98e8a041ae8239c2dc75dd2aec85633016b9c09148fd66a7c1","duration":47.3},"female":{"file":"y-652-female-v3.m4a","bytes":339293,"sha256":"c9d0d81dcc187c6453af11a62f4b86228a02b5694539528385a5424e4709bbc5","duration":47.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.302,"text":"ASE ife Orun","marked":"Àṣẹ ìfẹ́ Ọ̀run"},{"start":1.752,"end":2.88,"text":"Ore-Ofe l'o je","marked":"Oore-ọ̀fẹ́ l'ó jẹ́"},{"start":3.33,"end":5.747,"text":"K'a je akara, k'a mu wain","marked":"K'á jẹ́ àkàrà, k'á mú wáìn"},{"start":6.197,"end":7.398,"text":"Ni 'ranti Re Jesu.","marked":"Ní rántí Rẹ Jésù."}],"end":7.398},{"key":"2","start":8.348,"lines":[{"start":8.348,"end":9.529,"text":"Oluwa, a n duro,","marked":"Olúwa, à ń dúró"},{"start":9.979,"end":11.489,"text":"Lati kọ ẹkọ na;","marked":"Láti kọ ẹ̀kọ́ ná"},{"start":11.939,"end":13.287,"text":"T'ohun ti mbẹ l'aya Baba,","marked":"T'ohun tí mbẹ́ l'àyà Baba"},{"start":13.737,"end":15.076,"text":"At'ore-ọfẹ Rẹ.","marked":"At'ore-ọfẹ Rẹ."}],"end":15.076},{"key":"3","start":16.026,"lines":[{"start":16.026,"end":17.443,"text":"Ẹri-ọkan ko to,","marked":"Ẹri-ọkan kò tó"},{"start":17.893,"end":18.998,"text":"Igbagbọ l'o fi han;","marked":"Ìgbàgbọ́ l'ó fi hàn"},{"start":19.448,"end":21.062,"text":"Pe adun akara iye,","marked":"Pé adùn àkàrà iye"},{"start":21.512,"end":22.554,"text":"Ẹkun ifẹ Rẹ ni.","marked":"Ẹkún ìfẹ́ Rẹ̀ ni."}],"end":22.554},{"key":"4","start":23.504,"lines":[{"start":23.504,"end":24.759,"text":"Ẹjẹ ti n san f'ẹsẹ,","marked":"Ẹ̀jẹ̀ tí ń sàn f'ẹsẹ̀"},{"start":25.209,"end":26.471,"text":"L'a r'apẹrẹ rẹ yi;","marked":"L'á r'apẹrẹ rẹ̀ yí"},{"start":26.921,"end":28.147,"text":"Ẹri si ni ni ọkan wa,","marked":"Ẹ̀rí sì ni ní ọkàn wa"},{"start":28.597,"end":29.731,"text":"Pe Iwọ fẹran wa.","marked":"Pé Ìwọ fẹ́ràn wa."}],"end":29.731},{"key":"5","start":30.681,"lines":[{"start":30.681,"end":32.59,"text":"A! ẹri diẹ yi,","marked":"A! ẹ̀rí díẹ̀ yí"},{"start":33.04,"end":34.273,"text":"Bi o ba dun bayi;","marked":"Bí ó bá dùn báyì"},{"start":34.723,"end":36.701,"text":"Y'o ti dun to l'oke ọrun,","marked":"Y'ó ti dùn tó l'òkè ọ̀run"},{"start":37.151,"end":38.477,"text":"Gba t'a ba r'oju Rẹ?","marked":"Gba t'á bá r'ojú Rẹ̀?"}],"end":38.477},{"key":"6","start":39.427,"lines":[{"start":39.427,"end":40.544,"text":"Lati ri oju Rẹ,","marked":"Láti rí ojú Rẹ"},{"start":40.994,"end":42.332,"text":"Lati ri b'O ti ri,","marked":"Láti rí b'Ó ti rí"},{"start":42.782,"end":44.163,"text":"K'a si ma sọ ti ore Rẹ","marked":"K'á sì má sọ ti ọrẹ Rẹ"},{"start":44.613,"end":45.744,"text":"Titi ayérayé.","marked":"Títí ayérayé."}],"end":45.744}]}