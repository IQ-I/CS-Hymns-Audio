{"v":3,"coll":"y","num":255,"id":"hymn_255","title":"OLUWA, b'agbowode ni","duration":40.513,"voices":{"male":{"file":"y-255-male-v3.m4a","bytes":273126,"sha256":"b9b84f50024b13018c0ae5b2bfbc638d4a7f35c46d34df84b146e2a7880da300","duration":40.6},"female":{"file":"y-255-female-v3.m4a","bytes":288659,"sha256":"0f1ad9aa1992fe541ea111f71fadba05c6205b32af0803691ba994032e1b67cb","duration":40.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.008,"text":"OLUWA, b'agbowode ni","marked":"Olúwa, b'agbowódé ni"},{"start":2.458,"end":3.506,"text":"Mo gb'ọkan mi le Ọ;","marked":"Mo gb'ọkàn mi lé Ọ"},{"start":3.956,"end":5.929,"text":"Oluwa, f'ore-ọfẹ wi,","marked":"Olúwa, f'ore-ọfẹ wí"},{"start":6.379,"end":7.468,"text":"K'o se anu fun mi.","marked":"K'ó ṣe àánú fún mi."}],"end":7.468},{"key":"2","start":8.418,"lines":[{"start":8.418,"end":10.054,"text":"mf Mo lu aiduro aya mi,","marked":"mf Mo lu àìdúró àyà mi"},{"start":10.504,"end":11.823,"text":"Ẹkun at' irora;","marked":"Ẹkún àt ìrora"},{"start":12.273,"end":13.532,"text":"K'o gb'ọkan mi nu irora,","marked":"K'ò gb'ọkàn mi nu ìrora"},{"start":13.982,"end":15.067,"text":"K'o se anu fun mi.","marked":"K'ó ṣe àánú fún mi."}],"end":15.067},{"key":"3","start":16.017,"lines":[{"start":16.017,"end":18.31,"text":"N'itiju, mo jew' ese mi","marked":"N'ìtìjú, mo jẹ́w ẹsẹ̀ mi"},{"start":18.76,"end":19.974,"text":"Jo fun mi ni ireti","marked":"Jọ fún mi ní ìrètí"},{"start":20.424,"end":22.287,"text":"Mo be, 'tori eje Jesu","marked":"Mo bẹ, torí ẹ̀jẹ̀ Jésù"},{"start":22.737,"end":23.831,"text":"K'o se anu fun mi.","marked":"K'ó ṣe àánú fún mi."}],"end":23.831},{"key":"4","start":24.781,"lines":[{"start":24.781,"end":26.091,"text":"Olori elese ni mi","marked":"Olórí ẹlẹ́ṣẹ̀ ni mí"},{"start":26.541,"end":27.756,"text":"Ese mi p'apoju","marked":"Ẹ̀ṣẹ̀ mi p'àpọ̀jù"},{"start":28.206,"end":29.6,"text":"Nitori iku Jesu wa","marked":"Nítorí ikú Jésù wá"},{"start":30.05,"end":31.213,"text":"K'O se anu fun mi.","marked":"K'Ó ṣe àánú fún mi."}],"end":31.213},{"key":"5","start":32.163,"lines":[{"start":32.163,"end":33.588,"text":"Mo duro ti agbelebu","marked":"Mo dúró ti àgbélébùú"},{"start":34.038,"end":35.215,"text":"Nko sa f'ojiji re","marked":"Ǹkò sá f'òjìji rẹ̀"},{"start":35.665,"end":37.239,"text":"Ti Olorun to po l'anu","marked":"Tí Ọlọ́run tó pọ̀ l'àánú"},{"start":37.689,"end":38.964,"text":"O ti sanu fun mi.","marked":"Ó ti ṣanú fún mi."}],"end":38.964}]}