{"v":3,"coll":"y","num":811,"id":"hymn_811","title":"Tal' awon wonyi b'irawo","duration":58.683,"voices":{"male":{"file":"y-811-male-v3.m4a","bytes":417608,"sha256":"be04538ca6a523db5d2bbf2ebe6af0c0b4164d46348d90122e8c881b89f1d8f6","duration":58.7},"female":{"file":"y-811-female-v3.m4a","bytes":424687,"sha256":"63ea37cd070c8bb6118de1ac54426a3d63577574ec883ffe43f70ddf4d836e6a","duration":58.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.746,"text":"Tal' awọn wọnyi b'irawọ,","marked":"Tál àwọn wọ̀nyí b'ìràwọ̀"},{"start":2.196,"end":3.337,"text":"Niwaju itẹ Mimọ,","marked":"Níwájú ìtẹ́ Mímọ́"},{"start":3.787,"end":4.998,"text":"Ti wọn si de ade wura,","marked":"Tí wọ́n sì dé adé wúrà"},{"start":5.448,"end":6.8,"text":"Ẹgbẹ ogo wo l'eyi?","marked":"Ẹgbẹ́ ògo wo l'èyí?"},{"start":7.25,"end":8.935,"text":"Gbọ! Wọn n kọ Halleluyah,","marked":"Gbọ́! Wọ́n ń kọ́ Hallelúyà"},{"start":9.385,"end":10.552,"text":"Orin iyin Ọba wọn!","marked":"Orin ìyìn Ọba wọn!"}],"end":10.552},{"key":"2","start":11.502,"lines":[{"start":11.502,"end":12.788,"text":"Tani awọn ti n kọ mana,","marked":"Tani àwọn tí ń kọ mànà"},{"start":13.238,"end":14.405,"text":"T'a wọ l'asọ ododo?","marked":"T'á wọ l'asọ òdodo?"},{"start":14.855,"end":16.117,"text":"Awọn ti asọ funfun wọn,","marked":"Àwọn ti asọ̀ funfun wọn"},{"start":16.567,"end":18.502,"text":"Y'o ma funfun titi lai,","marked":"Y'ó má funfun títí láì"},{"start":18.952,"end":20.366,"text":"Bẹni ki y'o gbo lailai,","marked":"Bẹni kí y'ó gbọ́ láéláé"},{"start":20.816,"end":22.275,"text":"Nibo l'ẹgbẹ yi ti wa?","marked":"Níbo l'ẹ̀gbẹ́ yí ti wá?"}],"end":22.275},{"key":"3","start":23.225,"lines":[{"start":23.225,"end":24.554,"text":"Awọn wọnyi l'o ti jagun,","marked":"Àwọn wọ̀nyí l'ó ti jagun"},{"start":25.004,"end":26.082,"text":"F'ọla Olugbala wọn;","marked":"F'ọlá Olùgbàlà wọn"},{"start":26.532,"end":28.242,"text":"Wọn jijakadi tit' iku,","marked":"Wọ́n jìjàkadì tít ikú"},{"start":28.692,"end":30.008,"text":"Wọn ki b'ẹlẹsẹ k'ẹgbẹ;","marked":"Wọn kí b'ẹlẹ́sẹ̀ k'ẹ̀gbẹ́"},{"start":30.458,"end":32.045,"text":"Wọnyi ni ko s‘ sa f'ogun,","marked":"Wọ̀nyí ni kò s sá f'ogun"},{"start":32.495,"end":34.07,"text":"Wọn sẹgun nipa Kristi.","marked":"Wọ́n sẹ́gun nípa Kristi."}],"end":34.07},{"key":"4","start":35.02,"lines":[{"start":35.02,"end":36.598,"text":"Wọnyi l'ọkan wọn ti gbọgbẹ","marked":"Wọ̀nyí l'ọkàn wọn ti gbọgbẹ́"},{"start":37.048,"end":38.348,"text":"Ninu 'danwo kikoro;","marked":"Nínú dánwò kíkorò"},{"start":38.798,"end":40.346,"text":"Wọnyi ni o ti f'adura,","marked":"Wọ̀nyí ni ó ti f'àdúrà"},{"start":40.796,"end":41.914,"text":"Mu Ọlọrun gbọ ti wọn;","marked":"Mú Ọlọ́run gbọ́ tí wọ́n"},{"start":42.364,"end":43.612,"text":"Nisinsinyi wọn sẹgun,","marked":"Nísinsinyí wọ́n sẹ́gun"},{"start":44.062,"end":45.413,"text":"Ọlọrun re wọn lẹkun.","marked":"Ọlọ́run rẹ̀ wọ́n lẹ́kun."}],"end":45.413},{"key":"5","start":46.363,"lines":[{"start":46.363,"end":47.699,"text":"Awọn wọnyi l'o ti sọra,","marked":"Àwọn wọ̀nyí l'ó ti sọ́ra"},{"start":48.149,"end":49.437,"text":"Ti wọn fi 'fẹ wọn fun Krist'","marked":"Tí wọ́n fi 'fẹ wọn fún Krist"},{"start":49.887,"end":51.15,"text":"Wọn si y'ara wọn si mimọ,","marked":"Wọ́n sì y'ara wọn sí mímọ́"},{"start":51.6,"end":53.065,"text":"Lati sin nigba gbogbo,","marked":"Láti sin nígbà gbogbo"},{"start":53.515,"end":55.095,"text":"Nisinsin yii ni ọrun,","marked":"Nísinsin yìí ni ọ̀run"},{"start":55.545,"end":57.133,"text":"Wọn wa l'ayọ l'ọdọ Rẹ.","marked":"Wọ́n wá l'ayọ̀ l'ọ̀dọ̀ Rẹ."}],"end":57.133}]}