{"v":3,"coll":"y","num":126,"id":"hymn_126","title":"OLORUN ailopin, Iwo","duration":62.617,"voices":{"male":{"file":"y-126-male-v3.m4a","bytes":441102,"sha256":"ede851363613504dce93e4e38c85537945a5984d70f31f62e4d5357ba7204aa7","duration":62.7},"female":{"file":"y-126-female-v3.m4a","bytes":463287,"sha256":"8679320a8c729c742bca63532ee6a118afd602363c7156ff8b5129698fb1f105","duration":62.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.176,"text":"ỌLỌRUN ailopin, Iwọ,","marked":"Ọlọ́run àìlópin, Ìwọ"},{"start":2.626,"end":4.021,"text":"L'a f'iyin atọkan wa fun,","marked":"L'á f'ìyìn atọkàn wà fún"},{"start":4.471,"end":5.638,"text":"Gbogbo 'sẹ Rẹ l'ayé yin Ọ,","marked":"Gbogbo 'sẹ Rẹ̀ l'ayé yín Ọ"},{"start":6.088,"end":7.868,"text":"A juba Rẹ, Oluwa wa;","marked":"A júbà Rẹ, Olúwa wà"},{"start":8.318,"end":10.304,"text":"Baba ayérayé, jẹ ki,","marked":"Baba ayérayé, jẹ́ kí"},{"start":10.754,"end":12.107,"text":"Ọkan wa wolẹ n'itẹ Rẹ.","marked":"Ọkàn wa wólẹ̀ n'ìtẹ́ Rẹ̀."}],"end":12.107},{"key":"2","start":13.057,"lines":[{"start":13.057,"end":14.412,"text":"Awọn angẹl' n kọrin yin Ọ,","marked":"Àwọn angẹl' ń kọrin yín Ọ"},{"start":14.862,"end":16.725,"text":"Balogun, Ọba 'wọn Ọba,","marked":"Balógun, Ọba 'wọn Ọba"},{"start":17.175,"end":18.721,"text":"Kikan l'awọn Kérúbù n yin,","marked":"Kíkan l'àwọn Kérúbù ń yín"},{"start":19.171,"end":20.769,"text":"Seraf' si yin Mẹtalọkan;","marked":"Seraf sí yín Mẹ́talọ́kan"},{"start":21.219,"end":22.981,"text":"Wọn n kọ, Mimọ, mimọ, mimọ,","marked":"Wọ́n ń kọ́, Mímọ́, mímọ́, mímọ́"},{"start":23.431,"end":25.28,"text":"Ọrun, ayé, kun f'ogo Rẹ!","marked":"Ọ̀run, ayé, kún f'ògo Rẹ!"}],"end":25.28},{"key":"3","start":26.23,"lines":[{"start":26.23,"end":27.355,"text":"Ọlọrun awọn baba wa,","marked":"Ọlọ́run àwọn Baba wa"},{"start":27.805,"end":29.152,"text":"Awọn Woli ti royin Rẹ,","marked":"Àwọn Wòlí ti ròyìn Rẹ̀"},{"start":29.602,"end":31.064,"text":"Ẹgbẹ Aposteli rere,","marked":"Ẹgbẹ́ Aposteli rere"},{"start":31.514,"end":33.266,"text":"Wọn mbẹ l'ayọ ati ogo;","marked":"Wọ́n mbẹ́ l'ayọ̀ àti ògo"},{"start":33.716,"end":35.092,"text":"Woli ati awọn mimọ","marked":"Wòlí àti àwọn mímọ́"},{"start":35.542,"end":37.035,"text":"Dapọ lati gb'ọla Rẹ ga.","marked":"Dàpọ̀ láti gb'ọlá Rẹ̀ ga."}],"end":37.035},{"key":"4","start":37.985,"lines":[{"start":37.985,"end":39.191,"text":"Olor' awọn ajẹriku,","marked":"Ọlọ́r àwọn ajẹ́ríkù"},{"start":39.641,"end":41.262,"text":"Wọn n f'otọ sogo ninu Rẹ,","marked":"Wọ́n ń f'òtọ̀ ṣògo nínú Rẹ̀"},{"start":41.712,"end":42.971,"text":"Ijọ gbe ohun rẹ soke,","marked":"Ìjọ gbé ohùn rẹ̀ sókè"},{"start":43.421,"end":44.697,"text":"Yin Ẹlẹda gbogbo ayé;","marked":"Yin Ẹlẹda gbogbo ayé"},{"start":45.147,"end":46.96,"text":"Wọn si mba 'wọn t'o y'itẹ ka,","marked":"Wọ́n sì mbá 'wọn t'ó y'ìtẹ́ ká"},{"start":47.41,"end":48.928,"text":"Kọrin in 'jinlẹ Mẹtalọkan.","marked":"Kọrin ín 'jinlẹ Mẹ́talọ́kan."}],"end":48.928},{"key":"5","start":49.878,"lines":[{"start":49.878,"end":52.089,"text":"Baba, Ọlọla ailopin,","marked":"Baba, Ọlọ́lá àìlópin"},{"start":52.539,"end":54.192,"text":"Tirẹ l'agbara at' ifẹ,","marked":"Tirẹ̀ l'agbára àt ìfẹ́"},{"start":54.642,"end":56.124,"text":"A juba ọmọ Rẹ ọwọn,","marked":"A júbà ọmọ Rẹ̀ ọ̀wọ́n"},{"start":56.574,"end":57.821,"text":"T'O mbẹ n'nu ogo pẹlu;","marked":"T'Ó mbẹ́ n'nú ògo pẹ̀lú"},{"start":58.271,"end":59.441,"text":"At'Ọlọrun Ẹmi Mimọ ,","marked":"Àt'Ọlọ́run Ẹ̀mí Mímọ́"},{"start":59.891,"end":61.068,"text":"Olutunu ayérayé.","marked":"Olùtùnú ayérayé."}],"end":61.068}]}