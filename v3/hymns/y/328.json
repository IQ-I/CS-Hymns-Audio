{"v":3,"coll":"y","num":328,"id":"hymn_328","title":"Jesu t'o ku, k'o gb'aye la","duration":37.991,"voices":{"male":{"file":"y-328-male-v3.m4a","bytes":266609,"sha256":"dfcbc477aa7017a00df10eccbe98c723207533db764e9d81366a87ab0870c59b","duration":38.0},"female":{"file":"y-328-female-v3.m4a","bytes":275561,"sha256":"9ccb4e74977accf44d74a6a1875a177ea1292a11af17a5cf23ed337e72027712","duration":38.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.923,"text":"Jesu t'o ku, k'o gb'ayé la,","marked":"Jésù t'ó kú, k'ó gb'ayé là"},{"start":3.373,"end":4.743,"text":"Jinde kuro ninu oku,","marked":"Jíǹde kúrò nínú òkú"},{"start":5.193,"end":6.384,"text":"Nipa agbara Rẹ;","marked":"Nípa agbára Rẹ"},{"start":6.834,"end":8.473,"text":"A da silẹ lọwọ iku,","marked":"A dá sílẹ̀ lọ́wọ́ ikú"},{"start":8.923,"end":10.249,"text":"O d'igbekun n'igbekun lọ,","marked":"Ó d'ìgbèkùn n'ìgbèkùn lọ"},{"start":10.699,"end":12.359,"text":"O ye, k'o ma ku mọ.","marked":"Ó yẹ, k'ó má kú mọ́."}],"end":12.359},{"key":"2","start":13.309,"lines":[{"start":13.309,"end":15.218,"text":"Ẹyin ọm'Ọlọrun, ẹ wo","marked":"Ẹ̀yin ọm'Ọlọ́run, ẹ wò"},{"start":15.668,"end":17.059,"text":"Olugbala ninu ogo;","marked":"Olùgbàlà nínú ògo"},{"start":17.509,"end":18.615,"text":"O ti sẹgun iku;","marked":"Ó ti sẹ́gun ikú"},{"start":19.065,"end":20.813,"text":"Ma banujẹ, ma bẹru mọ,","marked":"Má banújẹ́, má bẹ̀rù mọ́"},{"start":21.263,"end":22.852,"text":"O n lọ pese ayé fun yin,","marked":"Ó ń lọ pèsè ayé fún yín"},{"start":23.302,"end":24.647,"text":"Yoo mu yin lọ 'le.","marked":"Yóò mú yín lọ lé."}],"end":24.647},{"key":"3","start":25.597,"lines":[{"start":25.597,"end":27.24,"text":"O f'oju anu at'ifẹ,","marked":"Ó f'ojú àánú àt'ìfẹ́"},{"start":27.69,"end":29.08,"text":"Wo awọn ti O ra pada;","marked":"Wo àwọn tí Ó rà padà"},{"start":29.53,"end":30.675,"text":"Awọn ni ayọ Rẹ;","marked":"Àwọn ni ayọ̀ Rẹ"},{"start":31.125,"end":32.587,"text":"O ri ayọ at'isẹ wọn,","marked":"Ó rí ayọ̀ àt'isẹ́ wọn"},{"start":33.037,"end":34.647,"text":"O bẹbẹ ki wọn le sẹgun,","marked":"Ó bẹ̀bẹ̀ kí wọ́n lè sẹ́gun"},{"start":35.097,"end":36.441,"text":"Ki wọn ba jọba lai.","marked":"Kí wọ́n bá jọba láì."}],"end":36.441}]}