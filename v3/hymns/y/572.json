{"v":3,"coll":"y","num":572,"id":"hymn_572","title":"ENYIN ero nibo l'e nlo","duration":67.401,"voices":{"male":{"file":"y-572-male-v3.m4a","bytes":477019,"sha256":"c65f807787357f4a3c73e52b6e1c749768a38027bb596960756f109f2cccf207","duration":67.5},"female":{"file":"y-572-female-v3.m4a","bytes":498174,"sha256":"75c1d5134dc35d7a4bccd9abe6ad974eb458f08bf7cafa9dc8b9332ff84cd1bb","duration":67.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.729,"text":"ENYIN ero nibo l'e nlo","marked":"Ẹ̀yin èrò níbo l'è ńlọ"},{"start":2.179,"end":3.516,"text":"T'enyin t'asia lowo?","marked":"T'ẹ̀yin t'asia lọ́wọ́?"},{"start":3.966,"end":5.279,"text":"Awa nlo s'orere aiye","marked":"Àwa ńlọ s'òréré ayé"},{"start":5.729,"end":7.116,"text":"Lati kede oro na.","marked":"Láti kéde ọ̀rọ̀ ná."},{"start":7.566,"end":8.734,"text":"Egbe: Awa Om'egbe Serafu","marked":"Àwa Ọm'ẹgbẹ́ Séráfù"},{"start":9.184,"end":10.496,"text":"Ti Olorun tun gbe dide","marked":"Tí Ọlọ́run tún gbé dìde"},{"start":10.946,"end":13.254,"text":"Awa si njo, awa si nyo)","marked":"Àwa sì ǹjọ, àwa sì ǹyọ"},{"start":13.704,"end":15.151,"text":"Fun ore t'a gba lofe). 2ce","marked":"Fún ọrẹ t'á gbà lọ́fẹ́."}],"end":15.151},{"key":"CHORUS","start":16.101,"lines":[{"start":16.101,"end":17.208,"text":"Awa Om'egbe Serafu","marked":"Àwa Ọm'ẹgbẹ́ Séráfù"},{"start":17.658,"end":18.978,"text":"Ti Olorun tun gbe dide","marked":"Tí Ọlọ́run tún gbé dìde"},{"start":19.428,"end":21.689,"text":"Awa si njo, awa si nyo","marked":"Àwa sì ǹjọ, àwa sì ǹyọ"},{"start":22.139,"end":23.549,"text":"Fun ore t'a gba lofe). 2ce","marked":"Fún ọrẹ t'á gbà lọ́fẹ́."}],"end":23.549},{"key":"2","start":24.499,"lines":[{"start":24.499,"end":26.897,"text":"Enyin agba, enyin ewe","marked":"Ẹ̀yin àgbà, ẹ̀yin èwe"},{"start":27.347,"end":28.686,"text":"E ba wa ko orin na","marked":"Ẹ bá wa kọ orin ná"},{"start":29.136,"end":30.525,"text":"At'okunrin at'obinrin","marked":"Àt'ọkùnrin àt'obìnrin"},{"start":30.975,"end":32.383,"text":"K'a jo jumo juba Re.","marked":"K'á jọ jùmọ̀ júbà Rẹ̀."},{"start":32.833,"end":34.014,"text":"Egbe: Awa Om'egbe Serafu...","marked":"Àwa Ọm'ẹgbẹ́ Séráfù"}],"end":34.014},{"key":"3","start":34.964,"lines":[{"start":34.964,"end":36.398,"text":"Enyin Egbe Onigbagbo","marked":"Ẹ̀yin Ẹgbẹ́ Onígbàgbọ́"},{"start":36.848,"end":37.995,"text":"T'o wa ni gbogbo aiye","marked":"T'ó wà ní gbogbo ayé"},{"start":38.445,"end":40.054,"text":"Ka fi keta gbogbo sile","marked":"Ká fi kẹta gbogbo sílẹ̀"},{"start":40.504,"end":41.827,"text":"K'a f'omonikeji wa.","marked":"K'á f'ọmọnìkejì wá."},{"start":42.277,"end":43.483,"text":"Egbe: Awa Om'egbe Serafu...","marked":"Àwa Ọm'ẹgbẹ́ Séráfù"}],"end":43.483},{"key":"4","start":44.433,"lines":[{"start":44.433,"end":45.929,"text":"E wa jumo k'egbe lo","marked":"Ẹ wá jùmọ̀ k'ẹ̀gbẹ́ lọ"},{"start":46.379,"end":47.637,"text":"Wa si egbe Serafu","marked":"Wá sí ẹgbẹ́ Séráfù"},{"start":48.087,"end":50.091,"text":"Wa ma kalo, wa ma kalo","marked":"Wá má kálọ, wá má kálọ"},{"start":50.541,"end":52.011,"text":"Gbogbo wa ni Jesu npe.","marked":"Gbogbo wa ni Jésù ńpè."},{"start":52.461,"end":53.679,"text":"Egbe: Awa Om'egbe Serafu","marked":"Àwa Ọm'ẹgbẹ́ Séráfù"},{"start":54.129,"end":55.487,"text":"Ti Olorun tun gbe dide","marked":"Tí Ọlọ́run tún gbé dìde"},{"start":55.937,"end":58.152,"text":"Awa si njo, awa si nyo","marked":"Àwa sì ǹjọ, àwa sì ǹyọ"},{"start":58.602,"end":60.089,"text":"Fun ore t'a gba lofe.","marked":"Fún ọrẹ t'á gbà lọ́fẹ́."},{"start":60.539,"end":62.739,"text":"Awa si njo, awa si nyo","marked":"Àwa sì ǹjọ, àwa sì ǹyọ"},{"start":63.189,"end":64.733,"text":"Fun ore t'a gba lofe.","marked":"Fún ọrẹ t'á gbà lọ́fẹ́."},{"start":65.183,"end":65.852,"text":"Amin.","marked":"Àmín."}],"end":65.852}]}