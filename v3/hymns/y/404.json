{"v":3,"coll":"y","num":404,"id":"hymn_404","title":"IWE kan wa ti kika re","duration":32.616,"voices":{"male":{"file":"y-404-male-v3.m4a","bytes":223072,"sha256":"222cf3b7058410449cf2c8ed14de9f622364b9dfa97eb0d022c3231a3d3badde","duration":32.7},"female":{"file":"y-404-female-v3.m4a","bytes":231201,"sha256":"47e8b64e45e098a3dfc566224db0f6e537c5ee93735523d7aa5b8923ef8f7ce9","duration":32.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.986,"text":"IWE kan wa ti kika rẹ,","marked":"Ìwé kan wà tí kíká rẹ̀"},{"start":2.436,"end":3.485,"text":"Ko soro fun eniyan,","marked":"Kò sọ̀rọ̀ fún ènìyàn"},{"start":3.935,"end":5.808,"text":"Ọgbọn ti awọn t'o ka n fẹ,","marked":"Ọgbọ́n tí àwọn t'ó kà ń fẹ́"},{"start":6.258,"end":7.469,"text":"Ni ọkan ti o mọ.","marked":"Ní ọkàn tí ó mọ́."}],"end":7.469},{"key":"2","start":8.419,"lines":[{"start":8.419,"end":9.992,"text":"Isẹ gbogbo t'Ọlọrun se,","marked":"Isẹ́ gbogbo t'Ọlọ́run ṣe"},{"start":10.442,"end":12.086,"text":"L'oke, n'ilẹ, n'nu wa;","marked":"L'òkè, n'ilẹ̀, n'nú wa"},{"start":12.536,"end":14.127,"text":"Wọn j'ọkan ninu iwe na,","marked":"Wọ́n j'ọkàn nínú ìwé ná"},{"start":14.577,"end":15.828,"text":"Lati f'Ọlọrun han.","marked":"Láti f'Ọlọ́run hàn."}],"end":15.828},{"key":"3","start":16.778,"lines":[{"start":16.778,"end":18.512,"text":"Imole osupa l'oke","marked":"Ìmọ́lẹ̀ òṣùpá l'òkè"},{"start":18.962,"end":20.191,"text":"Lat' odo orun ni","marked":"Lát ọ̀dọ̀ ọ̀run ni"},{"start":20.641,"end":21.81,"text":"Be l'ogo Ijo Olorun","marked":"Bẹ́ l'ògo Ìjọ Ọlọ́run"},{"start":22.26,"end":23.322,"text":"T'odo Olorun wa.","marked":"T'ọ̀dọ̀ Ọlọ́run wa."}],"end":23.322},{"key":"4","start":24.272,"lines":[{"start":24.272,"end":25.526,"text":"Iwọ ti O jẹ ki a ri,","marked":"Ìwọ tí Ó jẹ́ kí a rí"},{"start":25.976,"end":27.077,"text":"Ohun t'o dara yi,","marked":"Ohun t'ó dára yí"},{"start":27.527,"end":29.265,"text":"Fun wa l'ọkan lati wa Ọ.","marked":"Fún wa l'ọkàn láti wá Ọ."},{"start":29.715,"end":31.066,"text":"K'a ri Ọ nibi gbogbo.","marked":"K'á rí Ọ níbi gbogbo."}],"end":31.066}]}