{"v":3,"coll":"y","num":286,"id":"hymn_286","title":"MA gesin lo l'ola nla Re","duration":46.171,"voices":{"male":{"file":"y-286-male-v3.m4a","bytes":325075,"sha256":"e29909891fe5c52c8b01d168e5f68cccd26b3f0815d46d0375b6818c529d9938","duration":46.2},"female":{"file":"y-286-female-v3.m4a","bytes":332644,"sha256":"56b7b4a60c731714c93bfe86185a015825237572e04e5c757ef5d5a4c4031f32","duration":46.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.88,"text":"MA gẹsin lọ l'ọla nla Rẹ;","marked":"Má gẹ́sìn lọ l'ọ̀la ńlá Rẹ"},{"start":2.33,"end":4.991,"text":"Gbọ gbogb'ayé, ń ke Hosanna","marked":"Gbọ́ gbogb'ayé, ń ké Hosanna"},{"start":5.441,"end":7.159,"text":"Olugbala, ma lọ pẹlẹ,","marked":"Olùgbàlà, má lọ pẹ̀lẹ́"},{"start":7.609,"end":9.047,"text":"Lori im'ọpẹ at'asọ.","marked":"Lórí ìm'ọ̀pẹ àt'asọ."}],"end":9.047},{"key":"2","start":9.997,"lines":[{"start":9.997,"end":11.886,"text":"Ma gẹsin lo l'ọla nla Rẹ;","marked":"Má gẹ́sìn lọ l'ọ̀la ńlá Rẹ"},{"start":12.336,"end":14.046,"text":"Ma f'irẹlẹ gẹsin lo ku;","marked":"Má f'ìrẹ̀lẹ̀ gẹ́sìn ló kú"},{"start":14.496,"end":16.414,"text":"Kristi, sẹgun Rẹ bẹrẹ na;","marked":"Kristi, sẹ́gun Rẹ̀ bẹ̀rẹ̀ ná"},{"start":16.864,"end":18.449,"text":"Lori ẹsẹ ati iku.","marked":"Lórí ẹsẹ̀ àti ikú."}],"end":18.449},{"key":"3","start":19.399,"lines":[{"start":19.399,"end":21.015,"text":"Ma gẹsin lọ l'ọla nla Rẹ;","marked":"Má gẹ́sìn lọ l'ọ̀la ńlá Rẹ"},{"start":21.465,"end":22.648,"text":"Ogun Angẹli lat'ọrun;","marked":"Ogun Áńgẹ́lì lát'ọ̀run"},{"start":23.098,"end":24.639,"text":"N f'iyanu pẹlu ikanu,","marked":"Ń f'ìyanu pẹ̀lú ìkanu"},{"start":25.089,"end":26.681,"text":"Wo ẹbọ to sunmọle yi.","marked":"Wo ẹbọ tó súnmọ́lè yí."}],"end":26.681},{"key":"4","start":27.631,"lines":[{"start":27.631,"end":29.259,"text":"Ma gẹsin lọ l'ọlanla Rẹ;","marked":"Má gẹ́sìn lọ l'ọláńlá Rẹ"},{"start":29.709,"end":31.015,"text":"Ija ikẹhin na de tan;","marked":"Ìjà ìkẹ́hìn ná dé tán"},{"start":31.465,"end":33.641,"text":"Baba, lor'itẹ Rẹ l'ọrun,","marked":"Baba, lór'ìtẹ́ Rẹ l'ọ̀run"},{"start":34.091,"end":35.343,"text":"Ń reti ayanfẹ Ọmọ Rẹ.","marked":"Ń retí àyànfẹ́ Ọmọ Rẹ̀."}],"end":35.343},{"key":"5","start":36.293,"lines":[{"start":36.293,"end":38.047,"text":"Ma gẹsin lọ l'ọlanla Rẹ;","marked":"Má gẹ́sìn lọ l'ọláńlá Rẹ"},{"start":38.497,"end":40.013,"text":"Ma f'irẹlẹ gẹsin lọ ku;","marked":"Má f'ìrẹ̀lẹ̀ gẹ́sìn lọ kú"},{"start":40.463,"end":42.143,"text":"F'ara da irora f'ẹda;","marked":"F'ara da ìrora f'ẹ̀dà"},{"start":42.593,"end":44.622,"text":"Lẹhin na, n de k'O ma jọba.","marked":"Lẹ́hìn ná, ń dé k'Ó má jọba."}],"end":44.622}]}