{"v":3,"coll":"y","num":324,"id":"hymn_324","title":"JI, Ji okan ayo ji, ji","duration":66.161,"voices":{"male":{"file":"y-324-male-v3.m4a","bytes":477239,"sha256":"fc0bd2e063ceeba47e7cecf5d2723905c428a01e2dc51f40f4d3fab11a78fe51","duration":66.2},"female":{"file":"y-324-female-v3.m4a","bytes":492902,"sha256":"975d15877c5326ee3e1f32bca0e2c7ba6c8f2338bb0c007aad496a529b0d0516","duration":66.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.546,"text":"JI, ji, ọkan ayọ, ji, ji,","marked":"Jí, jí, ọkàn ayọ̀, jí, jí"},{"start":2.996,"end":4.059,"text":"Oluwa rẹ jinde;","marked":"Olúwa rẹ̀ jíǹde"},{"start":4.509,"end":6.612,"text":"Lọ 'boji Rẹ, k'o si mura,","marked":"Lọ bojì Rẹ, k'ó sì múra"},{"start":7.062,"end":8.455,"text":"Ọkan ati kọrin:","marked":"Ọkàn àti kọrin"},{"start":8.905,"end":10.3,"text":"Gbogbo ẹda l'o si ti ji,","marked":"Gbogbo ẹ̀dá l'ó sì ti jí"},{"start":10.75,"end":11.897,"text":"Ti wọn n kọrin didun,","marked":"Tí wọ́n ń kọrin dídùn"},{"start":12.347,"end":13.883,"text":"Itanna 'kini t'o ko tan,","marked":"Ìtànná kíni t'ó kò tán"},{"start":14.333,"end":15.429,"text":"Lẹba odo lo hu.","marked":"Lẹ́bà odò ló hù."}],"end":15.429},{"key":"2","start":16.379,"lines":[{"start":16.379,"end":17.881,"text":"Isudẹdẹ ayé y'o lọ,","marked":"Ìsùdẹ̀dẹ̀ ayé y'ó lọ"},{"start":18.331,"end":19.723,"text":"L'ọjọ ajinde yi,","marked":"L'ọjọ́ àjíǹde yí"},{"start":20.173,"end":21.751,"text":"Iku ko si mọ n'nu Kristi,","marked":"Ikú kò sì mọ̀ n'nú Kristi"},{"start":22.201,"end":23.319,"text":"Iboji ko n'ipa;","marked":"Ibojì kò n'ipa"},{"start":23.769,"end":26.76,"text":"Ninu Kristi l'a n wa, t'a n sun","marked":"Nínú Kristi l'à ń wá, t'à ń sùn"},{"start":27.21,"end":28.932,"text":"T'a n ji, t'a si n dide,","marked":"T'á ń jí, t'á sì ń dìde"},{"start":29.382,"end":30.849,"text":"Omije t'iku mu ba wa,","marked":"Omijé t'ikú mú bá wa"},{"start":31.299,"end":32.665,"text":"Ni Jesu y'o nu nu.","marked":"Ní Jésù y'ó nù nù."}],"end":32.665},{"key":"3","start":33.615,"lines":[{"start":33.615,"end":35.401,"text":"Ki gbogb' ẹyẹ ati igi,","marked":"Kí gbogb ẹyẹ àti igi"},{"start":35.851,"end":37.057,"text":"At' itanna ti n tan,","marked":"Àt ìtànná tí ń tàn"},{"start":37.507,"end":38.813,"text":"Ki wọn sọ ti isẹgun Rẹ,","marked":"Kí wọ́n sọ ti ìsẹ́gun Rẹ̀"},{"start":39.263,"end":40.505,"text":"Ati t'ajinde Rẹ,","marked":"Àti t'àjíǹde Rẹ"},{"start":40.955,"end":43.165,"text":"Papa, ẹ gbohun yin soke,","marked":"Pápá, ẹ gbóhùn yín sókè"},{"start":43.615,"end":44.64,"text":"Ẹ bu sorin ayọ!","marked":"Ẹ bú sórin ayọ̀!"},{"start":45.09,"end":46.295,"text":"Wi pé, 'Iku ti ku'.","marked":"Wí pé, ikú ti kú."}],"end":46.295},{"key":"4","start":47.245,"lines":[{"start":47.245,"end":50.323,"text":"Ọkan ayọ, ẹ ji, ẹ wa,","marked":"Ọkàn ayọ̀, ẹ jí, ẹ wá"},{"start":50.773,"end":52.126,"text":"Oluwa t'o jinde;","marked":"Olúwa t'ó jíǹde"},{"start":52.576,"end":54.04,"text":"Ẹ yọ ninu ajinde Rẹ,","marked":"Ẹ yọ̀ nínú àjíǹde Rẹ̀"},{"start":54.49,"end":55.877,"text":"K'ọrọ Rẹ tu yin n'nu,","marked":"K'ọ̀rọ̀ Rẹ̀ tù yín n'nú"},{"start":56.327,"end":58.889,"text":"Ẹ gbohun yin soke, k'ẹ yin,","marked":"Ẹ gbóhùn yín sókè, k'ẹ́ yín"},{"start":59.339,"end":60.56,"text":"Ẹni t'o ji dide;","marked":"Ẹni t'ó jí dìde"},{"start":61.01,"end":62.705,"text":"L'ohun kan ni ka gberin pe","marked":"L'ohùn kan ní ká gbẹ́rin pé"},{"start":63.155,"end":64.611,"text":"Jesu jinde fun mi.","marked":"Jésù jíǹde fún mi."}],"end":64.611}]}