{"v":3,"coll":"y","num":364,"id":"hymn_364","title":"F'AWON eniyan Re","duration":30.326,"voices":{"male":{"file":"y-364-male-v3.m4a","bytes":198698,"sha256":"856f9f7e05dcd6b2407ae17a4aa0a97a31e8244ac2f52b03942ae101475fc1b7","duration":30.4},"female":{"file":"y-364-female-v3.m4a","bytes":208844,"sha256":"afb1cc9e7139ee9e56a88ba3caef59a8d2e99ee860efe06a84443bc07b20490d","duration":30.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.203,"text":"F'AWỌN eniyan Rẹ,","marked":"F'Àwọn ènìyàn Rẹ"},{"start":1.653,"end":3.101,"text":"T'o ti fi ayé silẹ;","marked":"T'ó ti fi ayé sílẹ̀"},{"start":3.551,"end":5.544,"text":"Awọn to mo Ọ, t'o sin Ọ,","marked":"Àwọn tó mọ̀ Ọ́, t'ó sin Ọ"},{"start":5.994,"end":6.92,"text":"Gba orin iyin wa.","marked":"Gba orin ìyìn wá."}],"end":6.92},{"key":"2","start":7.87,"lines":[{"start":7.87,"end":8.806,"text":"F'awọn eniyan Rẹ,","marked":"F'àwọn ènìyàn Rẹ"},{"start":9.256,"end":10.292,"text":"Gba ohun ọpẹ wa;","marked":"Gba ohun ọpẹ́ wa"},{"start":10.742,"end":12.116,"text":"Awọn t'o fi Ọ s'ẹsan wọn,","marked":"Àwọn t'ó fi Ọ́ s'ẹ̀san wọn"},{"start":12.566,"end":13.743,"text":"Wọn ku n'igbagbọ Rẹ!","marked":"Wọ́n kú n'ìgbàgbọ́ Rẹ!"}],"end":13.743},{"key":"3","start":14.693,"lines":[{"start":14.693,"end":15.741,"text":"Ni gbogbo ayé wọn,","marked":"Ní gbogbo ayé wọn"},{"start":16.191,"end":17.228,"text":"'Wọ ni wọn n wo l'oju;","marked":"'Wọ ni wọ́n ń wò l'ojú"},{"start":17.678,"end":19.071,"text":"Ẹmi Mimọ Rẹ l'o n kọ wọn,","marked":"Ẹ̀mí Mímọ́ Rẹ l'ó ń kọ́ wọn"},{"start":19.521,"end":20.785,"text":"Lati s'ohun gbogbo.","marked":"Láti s'ohun gbogbo."}],"end":20.785},{"key":"4","start":21.735,"lines":[{"start":21.735,"end":23.064,"text":"Fun eyi, Oluwa,","marked":"Fún èyí, Olúwa"},{"start":23.514,"end":24.647,"text":"cr A n yin orukọ Rẹ;","marked":"cr À ń yin orúkọ Rẹ"},{"start":25.097,"end":26.525,"text":"Jẹ k'a ma tẹle iwa wọn,","marked":"Jẹ́ k'á má tẹ̀lé ìwà wọn"},{"start":26.975,"end":28.777,"text":"di Ki a le ku bi wọn.","marked":"di Kí a lè kú bí wọn."}],"end":28.777}]}