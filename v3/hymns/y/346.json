{"v":3,"coll":"y","num":346,"id":"hymn_346","title":"E GB'ori yin soke enu ona","duration":53.325,"voices":{"male":{"file":"y-346-male-v3.m4a","bytes":370283,"sha256":"76782b2e310675aefd148fc393d8cb988fc14827346bf95004527a853a01d8bc","duration":53.4},"female":{"file":"y-346-female-v3.m4a","bytes":378817,"sha256":"649173fc714e5547006dacfac749bd985ea292955c06661960cd2d8cc31bc4da","duration":53.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.744,"text":"E GB'ori nyin soke enu ona,","marked":"Ẹ Gb'orí yín sókè ẹnu ọ̀nà"},{"start":2.194,"end":3.384,"text":"K'Oluwa ogo wole","marked":"K'Olúwa ògo wọlé"},{"start":3.834,"end":5.698,"text":"Enit' O f'eje re r'aiye pada","marked":"Ẹnit Ó f'ẹ̀jẹ̀ rẹ̀ r'ayé padà"},{"start":6.148,"end":7.821,"text":"O mbo lati gba 'joba.","marked":"Ó mbọ̀ láti gba jọba."}],"end":7.821},{"key":"CHORUS","start":8.771,"lines":[{"start":8.771,"end":10.32,"text":"Hosannah, enyin Orun","marked":"Hosannah, ẹ̀yin Ọ̀run"},{"start":10.77,"end":12.501,"text":"Halleluyah, eyin Aiye,","marked":"Hallelúyà, ẹ̀yin Ayé"},{"start":12.951,"end":14.622,"text":"Orun, Osupa, e wole","marked":"Ọ̀run, Òṣùpá, ẹ wọlé"},{"start":15.072,"end":16.889,"text":"Kabiyesi, f 'Oba wa.","marked":"Kábíyèsí, f ọba wa."}],"end":16.889},{"key":"2","start":17.839,"lines":[{"start":17.839,"end":19.959,"text":"Awa Iran Israeli ni Afrika","marked":"Àwa Ìran Ísírẹ́lì ní Afrika"},{"start":20.409,"end":21.69,"text":"E gb'ola Oluwa ga","marked":"Ẹ gb'ọlá Olúwa ga"},{"start":22.14,"end":23.725,"text":"Ajagun -molu Wa ti goke lo","marked":"Ajagun mọ́lú Wa ti gòkè lọ"},{"start":24.175,"end":25.669,"text":"Lati lo pese aye.","marked":"Láti lọ pèsè ayé."}],"end":25.669},{"key":"3","start":26.619,"lines":[{"start":26.619,"end":28.409,"text":"Wo, Oba wa ninu Olanla Re,","marked":"Wò, Ọba wà nínú Ọláńlá Rẹ̀"},{"start":28.859,"end":30.284,"text":"Gun keke Ofurufu","marked":"Gun kẹ̀kẹ́ Òfúrufú"},{"start":30.734,"end":32.953,"text":"Agogo Orun pelu korin lyin","marked":"Agọ́gọ́ Ọ̀run pẹ̀lú kọrin Ìyìn"},{"start":33.403,"end":34.782,"text":"'Ghat'Oba Ogo wole.","marked":"ghat'ọba Ògo wọlé."}],"end":34.782},{"key":"4","start":35.732,"lines":[{"start":35.732,"end":38.135,"text":"Okan mi nfa s'Agbala ayo na","marked":"Ọkàn mi ńfà s'Àgbàlá ayọ̀ ná"},{"start":38.585,"end":40.02,"text":"Nibiti Kristi gunwa","marked":"Níbiti Kristi gúnwà"},{"start":40.47,"end":42.221,"text":"Odi yika ati Agbala Re","marked":"Odi yíká àti Àgbàlá Rẹ̀"},{"start":42.671,"end":44.171,"text":"Wura l'a fi se loso.","marked":"Wúrà l'a fi ṣe lọ́ṣọ́."}],"end":44.171},{"key":"5","start":45.121,"lines":[{"start":45.121,"end":46.587,"text":"Agbara Merinlelogun wole","marked":"Agbára Mẹ́rìnlélógún wọlé"},{"start":47.037,"end":48.032,"text":"Pelu ade wura won","marked":"Pẹ̀lú adé wúrà wọn"},{"start":48.482,"end":49.993,"text":"At'awon Eda Alaye merin","marked":"Àt'àwọn Ẹ̀dá Àlàyé mẹ́rin"},{"start":50.443,"end":51.776,"text":"Nwon nfi iye fo f 'ayo.","marked":"Wọ́n ńfi ìyè fò f ayọ̀."}],"end":51.776}]}