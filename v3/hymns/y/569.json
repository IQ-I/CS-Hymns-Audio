{"v":3,"coll":"y","num":569,"id":"hymn_569","title":"JESU mimo, Ore airi","duration":67.922,"voices":{"male":{"file":"y-569-male-v3.m4a","bytes":473387,"sha256":"dfcce04e5baeab611731f2c87df7d34cf6a83fe48c4e3aee66d89d05b04346be","duration":68.0},"female":{"file":"y-569-female-v3.m4a","bytes":488738,"sha256":"dee1aea2aa83733b8ef05dae3fdb9b6afaf37dbd24d3d7a874b880efb7ed74dc","duration":68.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.458,"text":"JESU mimọ, Ọrẹ airi,","marked":"Jésù mímọ́, Ọ̀rẹ́ àìrí"},{"start":2.908,"end":4.094,"text":"Oluranlọwọ alaini;","marked":"Olùrànlọ́wọ́ aláìní"},{"start":4.544,"end":6.719,"text":"N'nu ayida ayé, kọ mi,","marked":"N'nú àyídà ayé, kọ́ mi"},{"start":7.169,"end":8.246,"text":"K'emi le rọ mọ Ọ.","marked":"K'èmi lè rọ̀ mọ́ Ọ."}],"end":8.246},{"key":"2","start":9.196,"lines":[{"start":9.196,"end":10.791,"text":"Ki n sa n'idapọ mimọ yi,","marked":"Kí n sá n'ìdàpọ̀ mímọ́ yí"},{"start":11.241,"end":13.073,"text":"Gba ohun t'O fẹ n ó kun bi?","marked":"Gba ohun t'Ó fẹ́ n ó kún bí?"},{"start":13.523,"end":15.5,"text":"B'ọkan mi, b'ẹka ajara,","marked":"B'ọkàn mi, b'ẹ̀ka àjàrà"},{"start":15.95,"end":17.236,"text":"Ba sa le rọ mọ Ọ.","marked":"Bá sá lè rọ̀ mọ́ Ọ."}],"end":17.236},{"key":"3","start":18.186,"lines":[{"start":18.186,"end":19.447,"text":"Arẹ ti m'ọkan mi pupọ,","marked":"Àrẹ tí m'ọkàn mi púpọ̀"},{"start":19.897,"end":21.648,"text":"Sugbọn o wa r'ibi 'sinmi,","marked":"Sùgbọ́n ó wà r'ibi sinmi"},{"start":22.098,"end":23.419,"text":"Ibukun si de s'ọkan mi,","marked":"Ìbùkún sì dé s'ọkàn mi"},{"start":23.869,"end":25.054,"text":"'Tori t'o rọ mọ Ọ.","marked":"torí t'ó rọ̀ mọ́ Ọ."}],"end":25.054},{"key":"4","start":26.004,"lines":[{"start":26.004,"end":27.476,"text":"B'ayé d'ofo mọ mi loju,","marked":"B'ayé d'ọ̀fọ̀ mọ́ mi lójú"},{"start":27.926,"end":29.653,"text":"B' a gba ọrẹ at' ara lo,","marked":"B a gba ọrẹ àt ara lọ"},{"start":30.103,"end":32.3,"text":"di Ni suru ati laibohun,","marked":"di Ní surú àti láìbóhùn"},{"start":32.75,"end":33.83,"text":"L'emi o rọ mọ Ọ.","marked":"L'èmi ó rọ̀ mọ́ Ọ."}],"end":33.83},{"key":"5","start":34.78,"lines":[{"start":34.78,"end":36.345,"text":"Gba t'o k'emi nikansoso,","marked":"Gba t'ó k'èmi nìkanṣoṣo"},{"start":36.795,"end":38.007,"text":"L'arin idamu ayé yi,","marked":"L'árín ìdàmú ayé yí"},{"start":38.457,"end":39.775,"text":"Mo gb'ohun ifẹ jẹjẹ na,","marked":"Mo gb'ohun ìfẹ́ jẹ́jẹ́ ná"},{"start":40.225,"end":42.272,"text":"Wi pé, ―Sa rọ mọ Mi.","marked":"Wí pé, ―Sá rọ̀ mọ́ Mi."}],"end":42.272},{"key":"6","start":43.222,"lines":[{"start":43.222,"end":44.593,"text":"B'arẹ ba fẹ mu igbagbọ,","marked":"B'àrẹ bá fẹ́ mú ìgbàgbọ́"},{"start":45.043,"end":46.477,"text":"T'ireti ba si fẹ saki,","marked":"T'ìrètí bá sì fẹ́ ṣàkì"},{"start":46.927,"end":48.408,"text":"Ko si ewu fun ọkan na,","marked":"Kò sí ẹ̀wù fún ọkàn ná"},{"start":48.858,"end":50.071,"text":"T'o ba rọ mọ Ọ.","marked":"T'ó bá rọ̀ mọ́ Ọ."}],"end":50.071},{"key":"7","start":51.021,"lines":[{"start":51.021,"end":52.396,"text":"Ko bẹru irumi ayé,","marked":"Kò bẹ̀rù ìrumì ayé"},{"start":52.846,"end":54.348,"text":"Nitori 'Wọ wa nitosi;","marked":"Nítorí 'Wọ wà nítòsí"},{"start":54.798,"end":56.258,"text":"Ki O si gbọn b'iku ba de,","marked":"Kí Ó sì gbọ́n b'ikú bá dé"},{"start":56.708,"end":57.815,"text":"'Tori o rọ mọ Ọ.","marked":"torí ó rọ̀ mọ́ Ọ."}],"end":57.815},{"key":"8","start":58.765,"lines":[{"start":58.765,"end":60.027,"text":"Irẹ sa ni l'ohun gbogbo,","marked":"Ìrẹ́ sá ní l'ohun gbogbo"},{"start":60.477,"end":62.334,"text":"'Wọ agbara at'asa mi,","marked":"'Wọ agbára àt'àṣà mi"},{"start":62.784,"end":64.775,"text":"Olugbala, ki y'o si nkan,","marked":"Olùgbàlà, kí y'ó sí nǹkan"},{"start":65.225,"end":66.373,"text":"Bi mba ti rọ mọ Ọ.","marked":"Bí mbá ti rọ̀ mọ́ Ọ."}],"end":66.373}]}