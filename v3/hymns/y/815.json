{"v":3,"coll":"y","num":815,"id":"hymn_815","title":"OLORUN Alagbara nla","duration":40.644,"voices":{"male":{"file":"y-815-male-v3.m4a","bytes":285117,"sha256":"1cbf3db01750b6eef01a9a585e26949aea23c4d2f9ce8d5778441366cd9e75c6","duration":40.7},"female":{"file":"y-815-female-v3.m4a","bytes":300600,"sha256":"69932a431bab7c8889115bf05344f144890f75cda4d8bf258018609c920acec8","duration":40.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.506,"text":"OLORUN Alagbara nla","marked":"Ọlọ́run Alágbára ńlá"},{"start":1.956,"end":3.273,"text":"T'O p'ara Egypt run","marked":"T'Ó p'ara Egypt run"},{"start":3.723,"end":5.401,"text":"L'eti okun nijokini","marked":"L'etí òkun níjọkíni"},{"start":5.851,"end":6.996,"text":"P'agbara Ota mi run.","marked":"P'agbára Ọ̀tá mi run."}],"end":6.996},{"key":"CHORUS","start":7.946,"lines":[{"start":7.946,"end":9.022,"text":"Jowo gbe mi leke","marked":"Jọ̀wọ́ gbé mi lékè"},{"start":9.472,"end":10.831,"text":"Ma jek'ota bori mi","marked":"Má jẹ́k'ọ̀tá borí mi"},{"start":11.281,"end":13.747,"text":"Segun, gbogbo ota fun mi,","marked":"Ṣẹ́gun, gbogbo ọ̀tá fún mi"},{"start":14.197,"end":15.319,"text":"Gbe mi leke 'danwo.","marked":"Gbé mi lékè dánwò."}],"end":15.319},{"key":"2","start":16.269,"lines":[{"start":16.269,"end":18.611,"text":"Jesu, loni mo kepe O,","marked":"Jésù, lónì mo képe Ọ"},{"start":19.061,"end":20.385,"text":"Baba mi gbo temi","marked":"Baba mi gbọ́ tèmi"},{"start":20.835,"end":23.002,"text":"Segun gbogbo' ogun ti mo ri","marked":"Ṣẹ́gun gbogbo ogun tí mo rí"},{"start":23.452,"end":24.909,"text":"Mase jeki nseku","marked":"Mase jẹ́kí ńṣẹ́kù"},{"start":25.359,"end":26.711,"text":"Mu ki Ifoiya mi lo","marked":"Mú kí Ìfòìyà mi lọ"},{"start":27.161,"end":28.887,"text":"F'okan mi bale lat'oni","marked":"F'ọkàn mi balẹ̀ lát'òní"},{"start":29.337,"end":30.378,"text":"K'ota ma le mi mo.","marked":"K'ọ̀tá má lè mi mọ́."}],"end":30.378},{"key":"3","start":31.328,"lines":[{"start":31.328,"end":32.744,"text":"Jesu Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":33.194,"end":34.482,"text":"Wo ni mo gbekele","marked":"Wo ni mo gbẹ́kẹ̀lé"},{"start":34.932,"end":37.245,"text":"Lai, ma jeki oju ti mi","marked":"Láì, má jẹ́kí ojú tì mí"},{"start":37.695,"end":39.095,"text":"Pese fun aini mi.","marked":"Pèsè fún àìní mi."}],"end":39.095}]}