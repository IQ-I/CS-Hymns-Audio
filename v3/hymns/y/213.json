{"v":3,"coll":"y","num":213,"id":"hymn_213","title":"IGBA mi mbe ni owo Re","duration":40.248,"voices":{"male":{"file":"y-213-male-v3.m4a","bytes":275518,"sha256":"6ea9cb374889616ca096e53565cf4accd5f6065a328e549d48b68d6b321ab1eb","duration":40.3},"female":{"file":"y-213-female-v3.m4a","bytes":285743,"sha256":"42874eef0a0d71cc86adc302158b9ded9e15c2bbcd37c0ebc761ae08e086bf07","duration":40.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.567,"text":"IGBA mi mbẹ ni ọwọ Rẹ,","marked":"Ìgbà mi mbẹ́ ní ọwọ́ Rẹ"},{"start":2.017,"end":3.281,"text":"A fẹ ko wa nibẹ;","marked":"A fẹ́ kó wà níbẹ̀"},{"start":3.731,"end":5.761,"text":"A f'ara wa at'ore wa,","marked":"A f'ara wa àt'ọrẹ wa"},{"start":6.211,"end":7.685,"text":"Si abẹ isọ Rẹ.","marked":"Sí abẹ́ ìsọ Rẹ."}],"end":7.685},{"key":"2","start":8.635,"lines":[{"start":8.635,"end":9.974,"text":"Igba mi mbẹ ni ọwọ Rẹ,","marked":"Ìgbà mi mbẹ́ ní ọwọ́ Rẹ"},{"start":10.424,"end":11.347,"text":"Awa o se bẹru?","marked":"Àwa ó ṣe bẹ̀rù?"},{"start":11.797,"end":13.268,"text":"Baba ki o jẹ k'ọmọ Rẹ,","marked":"Baba kí ó jẹ́ k'ọmọ Rẹ"},{"start":13.718,"end":15.076,"text":"Sọkun ni ainidi.","marked":"Sọkún ni àìnídì."}],"end":15.076},{"key":"3","start":16.026,"lines":[{"start":16.026,"end":17.377,"text":"Igba mi mbẹ ni ọwọ Rẹ,","marked":"Ìgbà mi mbẹ́ ní ọwọ́ Rẹ"},{"start":17.827,"end":19.0,"text":"'Wọ l'a o gbẹkẹle,","marked":"'Wọ l'á ò gbẹ́kẹ̀lé"},{"start":19.45,"end":21.308,"text":"Tit' a o f'ayé osi silẹ,","marked":"Tít a ó f'ayé òsì sílẹ̀"},{"start":21.758,"end":23.097,"text":"T'a o si r'ogo Rẹ.","marked":"T'a ó sì r'ògo Rẹ̀."}],"end":23.097},{"key":"4","start":24.047,"lines":[{"start":24.047,"end":25.398,"text":"Igba mi mbẹ ni ọwọ Rẹ;","marked":"Ìgbà mi mbẹ́ ní ọwọ́ Rẹ"},{"start":25.848,"end":27.439,"text":"Jesu t'agbalebu;","marked":"Jésù t'agbalebu"},{"start":27.889,"end":29.474,"text":"Ọwọ na t'ẹsẹ mi dalu;","marked":"Ọwọ́ ná t'ẹsẹ̀ mi dàlú"},{"start":29.924,"end":31.245,"text":"Wa di alabo mi.","marked":"Wá di alábọ́ mi."}],"end":31.245},{"key":"5","start":32.195,"lines":[{"start":32.195,"end":33.5,"text":"Igba mi mbẹ ni ọwọ Rẹ;","marked":"Ìgbà mi mbẹ́ ní ọwọ́ Rẹ"},{"start":33.95,"end":35.091,"text":"N ó ma sinmi le Ọ,","marked":"N ó má sinmi lé Ọ"},{"start":35.541,"end":36.855,"text":"Lẹhin 'ku l'ọw'ọtun Rẹ;","marked":"Lẹ́hìn kú l'ọ̀w'ọ̀tún Rẹ"},{"start":37.305,"end":38.698,"text":"L'emi o wa titi lai.","marked":"L'èmi ó wà títí láì."}],"end":38.698}]}