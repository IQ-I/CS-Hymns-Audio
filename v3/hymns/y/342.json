{"v":3,"coll":"y","num":342,"id":"hymn_342","title":"WO Asegun b'o ti goke","duration":77.717,"voices":{"male":{"file":"y-342-male-v3.m4a","bytes":554859,"sha256":"5e421d4068c9d1795f298c0bddc09d80fb6ea129d9bfe16712ade66b822bdfba","duration":77.8},"female":{"file":"y-342-female-v3.m4a","bytes":573103,"sha256":"45ab0f1e8be9855956a57ead51e8c49e6e7af99a226a05ab0b06ee01e76d2dbc","duration":77.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.956,"text":"WO Asẹgun b'o ti goke,","marked":"Wo Asẹ́gun b'ó ti gòkè"},{"start":2.406,"end":3.666,"text":"Wo Ọba n'nu ọla Rẹ,","marked":"Wo Ọba n'nú ọlá Rẹ̀"},{"start":4.116,"end":5.506,"text":"Ogun kẹkẹ ofurufu,","marked":"Ogun kẹ̀kẹ́ òfúrufú"},{"start":5.956,"end":7.248,"text":"Lọ s'ọrun agbala Rẹ;","marked":"Lọ s'ọ̀run àgbàlá Rẹ"},{"start":7.698,"end":9.084,"text":"Gbọ orin awọn Angẹli,","marked":"Gbọ́ orin àwọn Áńgẹ́lì"},{"start":9.534,"end":10.683,"text":"Halleluya ni wọn n kọ,","marked":"Hallelúyà ni wọ́n ń kọ́"},{"start":11.133,"end":12.363,"text":"Awọn 'lẹkun si si silẹ,","marked":"Àwọn 'lẹkun sì ṣí sílẹ̀"},{"start":12.813,"end":14.178,"text":"Lati gba Ọba ọrun.","marked":"Láti gba Ọba ọ̀run."}],"end":14.178},{"key":"2","start":15.128,"lines":[{"start":15.128,"end":16.804,"text":"Tani Ologo ti mbọ yi,","marked":"Tani Ológo ti mbọ̀ yí"},{"start":17.254,"end":18.723,"text":"T'oun ti ipe jubeli?","marked":"T'òun ti ìpè jubeli?"},{"start":19.173,"end":20.693,"text":"Oluwa awọn 'mọ-ogun,","marked":"Olúwa àwọn 'mọ-ogun"},{"start":21.143,"end":22.648,"text":"Oun to ti sẹgun fun wa,","marked":"Òun tó ti sẹ́gun fún wa"},{"start":23.098,"end":24.454,"text":"O jiya lor'agbelebu,","marked":"Ó jìyà lọ́r'àgbélébù"},{"start":24.904,"end":26.252,"text":"O jinde ninu oku,","marked":"Ó jíǹde nínú òkú"},{"start":26.702,"end":28.257,"text":"O sẹgun Esu at'ẹsẹ,","marked":"Ó sẹ́gun Èṣù àt'ẹsẹ̀"},{"start":28.707,"end":30.008,"text":"Ati gbogbo ọta Rẹ.","marked":"Àti gbogbo ọ̀tá Rẹ."}],"end":30.008},{"key":"3","start":30.958,"lines":[{"start":30.958,"end":32.228,"text":"B'o ti n buk'awọn ọrẹ Rẹ,","marked":"B'ó ti ń bùk'àwọn ọ̀rẹ́ Rẹ"},{"start":32.678,"end":33.858,"text":"A gba kuro lọwọ wọn;","marked":"A gbà kúrò lọ́wọ́ wọn"},{"start":34.308,"end":35.856,"text":"Bi oju wọn si ti n wo lo,","marked":"Bí ojú wọn sì ti ń wò lọ"},{"start":36.306,"end":37.601,"text":"O nu nin'awọsanma;","marked":"Ó nù nín'àwọsánmà"},{"start":38.051,"end":39.413,"text":"Ẹni t'o ba Ọlọrun rin,","marked":"Ẹni t'ó bá Ọlọ́run rìn"},{"start":39.863,"end":41.416,"text":"T'o si n wasu otitọ,","marked":"T'ó sì ń wàṣù òtítọ́"},{"start":41.866,"end":43.68,"text":"Oun, Enọku wa, l'a gbe lọ","marked":"Òun, Énọ́kù wá, l'á gbé lọ"},{"start":44.13,"end":45.285,"text":"S'ile Rẹ loke ọrun.","marked":"S'ilé Rẹ lókè ọ̀run."}],"end":45.285},{"key":"4","start":46.235,"lines":[{"start":46.235,"end":48.051,"text":"Oun, Aaron wa, gbe ẹjẹ Rẹ,","marked":"Òun, Aaron wá, gbé ẹ̀jẹ̀ Rẹ̀"},{"start":48.501,"end":49.835,"text":"Wọ inu ikele lọ,","marked":"Wọ inú ìkélé lọ"},{"start":50.285,"end":51.865,"text":"Josua wa, ti wọ Kenaan,","marked":"Joṣua wá, ti wọ Kenaan"},{"start":52.315,"end":53.357,"text":"Awọn Ọba ń wariri,","marked":"Àwọn Ọba ń wárìrì"},{"start":53.807,"end":55.131,"text":"A fi 'di ẹya Israel,","marked":"A fi di ẹ̀yà Israẹl"},{"start":55.581,"end":56.73,"text":"Mulẹ nibi 'sinmi wọn;","marked":"Múlẹ̀ níbi sinmi wọn"},{"start":57.18,"end":58.549,"text":"Elija wa si fẹ fun wa,","marked":"Elija wa sì fẹ́ fún wa"},{"start":58.999,"end":60.363,"text":"N'ilọpo meji Ẹmi.","marked":"N'ìlọ́po méjì Ẹ̀mí."}],"end":60.363},{"key":"5","start":61.313,"lines":[{"start":61.313,"end":62.859,"text":"Iwọ ti gbe ara wa wọ,","marked":"Ìwọ ti gbé ara wa wọ̀"},{"start":63.309,"end":64.75,"text":"Lọ s'ọw' ọtun Ọlọrun,","marked":"Lọ s'ọw' ọ̀tún Ọlọ́run"},{"start":65.2,"end":66.566,"text":"A si joko nibi giga,","marked":"A sì jókò níbi gíga"},{"start":67.016,"end":68.293,"text":"Pẹlu Rẹ ninu ogo;","marked":"Pẹ̀lú Rẹ̀ nínú ògo"},{"start":68.743,"end":70.13,"text":"Awọn Angẹli mbọ Jesu,","marked":"Àwọn Áńgẹ́lì mbọ̀ Jésù"},{"start":70.58,"end":72.28,"text":"Eniyan joko lor' itẹ,","marked":"Ènìyàn jókò lór ìtẹ́"},{"start":72.73,"end":74.302,"text":"Oluwa, b'Iwọ ti goke,","marked":"Olúwa, b'Ìwọ ti gòkè"},{"start":74.752,"end":76.168,"text":"Jọ jẹ k'a le goke bẹ.","marked":"Jọ jẹ́ k'á lè gòkè bẹ̀."}],"end":76.168}]}