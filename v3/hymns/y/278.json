{"v":3,"coll":"y","num":278,"id":"hymn_278","title":"RO iponju mi, Oluwa","duration":31.486,"voices":{"male":{"file":"y-278-male-v3.m4a","bytes":215176,"sha256":"3d833aadbd63695366fa09e7fa772f401b8717cdc35589bb90a8d2f92d3f6caa","duration":31.5},"female":{"file":"y-278-female-v3.m4a","bytes":221119,"sha256":"eca551e921261cec1cd5af14c7498fd21c63e403a3d4d7dd21882413ab6a84f6","duration":31.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.806,"text":"RO iponju mi, Oluwa","marked":"Rọ ìpọ́njú mi, Olúwa"},{"start":2.256,"end":3.452,"text":"Ran iranlowo Re!","marked":"Rán ìrànlọ́wọ́ Rẹ!"},{"start":3.902,"end":5.271,"text":"Okan mi daku fun 'gbala","marked":"Ọkàn mi dákú fún gbàlà"},{"start":5.721,"end":7.281,"text":"Ise mi ki o pin?","marked":"Iṣẹ́ mi kí ó pín?"}],"end":7.281},{"key":"2","start":8.231,"lines":[{"start":8.231,"end":9.706,"text":"Mo ri pe o dara fun mi,","marked":"Mo rí pé ó dára fún mi"},{"start":10.156,"end":11.287,"text":"Bi baba mi na mi:","marked":"Bí Baba mi nà mí"},{"start":11.737,"end":13.061,"text":"Iya mu mi ko ofin Rẹ;","marked":"Ìyá mú mi kọ òfin Rẹ̀"},{"start":13.511,"end":14.607,"text":"Ki ń gbẹkẹ mi le Ọ.","marked":"Kí ń gbẹ́kẹ̀ mi lé Ọ."}],"end":14.607},{"key":"3","start":15.557,"lines":[{"start":15.557,"end":16.906,"text":"Mo mo pe idajo Re to","marked":"Mo mọ̀ pé ìdájọ́ Rẹ̀ tó"},{"start":17.356,"end":18.406,"text":"Bi o tile muna","marked":"Bí ó tilẹ̀ múná"},{"start":18.856,"end":20.763,"text":"Iponju ti mo f'ori ti","marked":"Ìpọ́njú tí mo f'orí tì"},{"start":21.213,"end":22.545,"text":"O ti odo Re wa.","marked":"Ó ti ọ̀dọ̀ Rẹ̀ wá."}],"end":22.545},{"key":"4","start":23.495,"lines":[{"start":23.495,"end":24.758,"text":"K'emi to m'owo ina Re","marked":"K'èmi tó m'ọwọ́ iná Rẹ"},{"start":25.208,"end":26.307,"text":"Emi a ma sina","marked":"Èmi a má ṣìnà"},{"start":26.757,"end":28.214,"text":"Sugbon bi mo ti k'oro Re","marked":"Ṣùgbọ́n bí mo ti k'ọ̀rọ̀ Rẹ"},{"start":28.664,"end":29.936,"text":"Emi ko sako mo.","marked":"Èmi kò ṣáko mọ́."}],"end":29.936}]}