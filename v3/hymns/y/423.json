{"v":3,"coll":"y","num":423,"id":"hymn_423","title":"IGBA aro ati ayo","duration":39.074,"voices":{"male":{"file":"y-423-male-v3.m4a","bytes":267864,"sha256":"c4d9842f59b298bf979410a6a05e8a4264638eaeb6842057088dd0fd0fb0f8ab","duration":39.1},"female":{"file":"y-423-female-v3.m4a","bytes":277639,"sha256":"79dd6c2d72cf2fb9dac3cded485b8320be18caf38e26acd85a8e2ef69aa63500","duration":39.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.834,"text":"IGBA aro ati ayọ,","marked":"Ìgbà arọ àti ayọ̀"},{"start":2.284,"end":3.446,"text":"Lọwọ Rẹ ni o wa,","marked":"Lọ́wọ́ Rẹ ni ó wà"},{"start":3.896,"end":5.248,"text":"Itunu mi t'ọwọ Rẹ wa,","marked":"Ìtùnú mi t'ọwọ́ Rẹ wà"},{"start":5.698,"end":7.189,"text":"O si lọ l'asẹ Rẹ.","marked":"Ó sì lọ l'àsẹ Rẹ̀."}],"end":7.189},{"key":"2","start":8.139,"lines":[{"start":8.139,"end":9.432,"text":"Bi O fẹ gba wọn l'ọwọ mi,","marked":"Bí Ó fẹ́ gbà wọ́n l'ọwọ́ mi"},{"start":9.882,"end":10.878,"text":"Emi ki o binu;","marked":"Èmi kí ó bínú"},{"start":11.328,"end":12.553,"text":"Ki emi ki o to ni wọn,","marked":"Kí èmi kí ó tó ni wọ́n"},{"start":13.003,"end":14.344,"text":"Tirẹ ni wọn ti se.","marked":"Tirẹ̀ ni wọ́n ti ṣe."}],"end":14.344},{"key":"3","start":15.294,"lines":[{"start":15.294,"end":16.641,"text":"Emi ki y'o so buburu,","marked":"Èmi kí y'ó sọ búburú"},{"start":17.091,"end":18.469,"text":"B'ayé tilẹ fo lọ;","marked":"B'ayé tilẹ̀ fò lọ"},{"start":18.919,"end":20.336,"text":"Emi o w'ayọ ailopin,","marked":"Èmi ó w'ayọ̀ àìlópin"},{"start":20.786,"end":22.119,"text":"Ni ọdọ Rẹ nikan.","marked":"Ní ọ̀dọ̀ Rẹ nìkan."}],"end":22.119},{"key":"4","start":23.069,"lines":[{"start":23.069,"end":24.466,"text":"Ki l'ayé ati ẹkun rẹ?","marked":"Kí l'ayé àti ẹkún rẹ̀?"},{"start":24.916,"end":26.229,"text":"Adun kikoro ni;","marked":"Adùn kíkorò ni"},{"start":26.679,"end":28.114,"text":"'Gbati mo fẹ ja itanna,","marked":"gbàtí mo fẹ́ já ìtànná"},{"start":28.564,"end":29.799,"text":"Mo b'ẹgun esusu.","marked":"Mo b'ẹ̀gún èṣùṣú."}],"end":29.799},{"key":"5","start":30.749,"lines":[{"start":30.749,"end":32.261,"text":"Pipe ayọ ko si nihin,","marked":"Pípẹ́ ayọ̀ kò sì níhìn"},{"start":32.711,"end":34.077,"text":"Òróòro da l'oyin;","marked":"Òróòro dá l'oyin"},{"start":34.527,"end":35.978,"text":"Larin gbogbo ayida yi;","marked":"Lárin gbogbo àyídà yí"},{"start":36.428,"end":37.525,"text":"'Wọ ma se gbogbo mi","marked":"'Wọ má ṣe gbogbo mi"}],"end":37.525}]}