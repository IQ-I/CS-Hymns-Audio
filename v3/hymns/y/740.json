{"v":3,"coll":"y","num":740,"id":"hymn_740","title":"IRAWO wo l'eyi?","duration":44.779,"voices":{"male":{"file":"y-740-male-v3.m4a","bytes":300378,"sha256":"3eb615c0cea63c4f9b1518058589ff62a3a54cb6e89d24b60d1d521cfd30a02b","duration":44.8},"female":{"file":"y-740-female-v3.m4a","bytes":307024,"sha256":"771957f8b7ab264a8d95da180f90883784e2d53cfa250ad184fd14834f6bf1dc","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.518,"text":"IRAWỌ wo l'eyi?","marked":"Ìràwọ̀ wo l'èyí?"},{"start":1.968,"end":3.119,"text":"Wo b'o ti dara to,","marked":"Wò b'ó ti dára tó"},{"start":3.569,"end":4.676,"text":"Amọna awọn Keferi,","marked":"Amọ̀nà àwọn Kèfèrí"},{"start":5.126,"end":6.307,"text":"S'ọdọ Ọba ogo.","marked":"S'ọ̀dọ̀ Ọba ògo."}],"end":6.307},{"key":"2","start":7.257,"lines":[{"start":7.257,"end":8.292,"text":"Wo awọn amoye,","marked":"Wo àwọn amòye"},{"start":8.742,"end":9.589,"text":"Ti ila orun wa,","marked":"Ti ìlà ọ̀run wá"},{"start":10.039,"end":11.582,"text":"Wọn wa fi ori balẹ fun,","marked":"Wọ́n wá fi orí balẹ̀ fún"},{"start":12.032,"end":13.248,"text":"Jesu Olubukun.","marked":"Jésù Olùbùkún."}],"end":13.248},{"key":"3","start":14.198,"lines":[{"start":14.198,"end":15.42,"text":"Imọlẹ ti Ẹmi,","marked":"Ìmọ́lẹ̀ ti Ẹ̀mí"},{"start":15.87,"end":16.996,"text":"Ma sai tan n'ilu wa;","marked":"Má ṣàì tán n'ìlú wa"},{"start":17.446,"end":19.401,"text":"Fi ọna han wa, ka le tọ,","marked":"Fi ọ̀nà hàn wá, ká lè tọ́"},{"start":19.851,"end":20.909,"text":"Emmanueli wa.","marked":"Emmanueli wà."}],"end":20.909},{"key":"4","start":21.859,"lines":[{"start":21.859,"end":22.925,"text":"Gbogbo iru-malẹ,","marked":"Gbogbo iru-malẹ"},{"start":23.375,"end":24.568,"text":"Ati igba-malẹ,","marked":"Àti igba-malẹ"},{"start":25.018,"end":26.547,"text":"Ti a mbọ n'ilẹ Keferi,","marked":"Tí a mbọ̀ n'ilẹ̀ Kèfèrí"},{"start":26.997,"end":28.382,"text":"K'o yago fun Jesu.","marked":"K'ó yàgò fún Jésù."}],"end":28.382},{"key":"5","start":29.332,"lines":[{"start":29.332,"end":30.564,"text":"Ki gbogbo abọrẹ,","marked":"Kí gbogbo abọ́rẹ́"},{"start":31.014,"end":32.448,"text":"Ti mbẹ ni Afrika,","marked":"Ti mbẹ̀ ní Afrika"},{"start":32.898,"end":34.211,"text":"Jẹ amoye ni otitọ,","marked":"Jẹ́ amòye ní òtítọ́"},{"start":34.661,"end":35.948,"text":"Ki wọn gb'ẹbọ Jesu.","marked":"Kí wọ́n gb'ẹbọ Jésù."}],"end":35.948},{"key":"6","start":36.898,"lines":[{"start":36.898,"end":37.948,"text":"Baba Eleda wa","marked":"Baba Ẹlẹ́dàá wa"},{"start":38.398,"end":39.665,"text":"Ti o fi Jesu han","marked":"Tí ó fi Jésù hàn"},{"start":40.115,"end":41.345,"text":"Awon Keferi igbani","marked":"Àwọn Kèfèrí ìgbáni"},{"start":41.795,"end":43.23,"text":"Fi han fun wa pelu.","marked":"Fi hàn fún wa pẹ̀lú."}],"end":43.23}]}