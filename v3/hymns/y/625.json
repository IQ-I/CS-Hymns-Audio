{"v":3,"coll":"y","num":625,"id":"hymn_625","title":"ORE aye ki lo jamo","duration":95.608,"voices":{"male":{"file":"y-625-male-v3.m4a","bytes":698947,"sha256":"bf76f1c00f24d34576f93d4c72818fdd80b5225e424e0be3d040444721d7554b","duration":95.7},"female":{"file":"y-625-female-v3.m4a","bytes":721433,"sha256":"91ca28cc1dfc37c4fbd299b72d10dc91d7f75f24299e4ad427ebc156c2c0abd6","duration":95.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.646,"text":"ỌRẸ ayé ki lo jamọ,","marked":"Ọrẹ ayé kí lọ jámọ́"},{"start":2.096,"end":3.441,"text":"Ohun asan ni mo mọ si,","marked":"Ohun asán ni mo mọ̀ sí"},{"start":3.891,"end":5.357,"text":"Ko si alanu bi Jesu,","marked":"Kò sí alánù bí Jésù"},{"start":5.807,"end":7.728,"text":"Alawo kọ, Ọlọrun ni,","marked":"Aláwọ̀ kọ́, Ọlọ́run ni"},{"start":8.178,"end":10.375,"text":"Adawunse kọ, Ọlọrun ni,","marked":"Adáwùnṣe kọ́, Ọlọ́run ni"},{"start":10.825,"end":12.823,"text":"Eniyan kọ, Ọlọrun ni.","marked":"Ènìyàn kọ́, Ọlọ́run ni."}],"end":12.823},{"key":"2","start":13.773,"lines":[{"start":13.773,"end":15.463,"text":"O yẹ ki n fi Jesu s'ọrẹ,","marked":"Ó yẹ kí n fi Jésù s'ọ̀rẹ́"},{"start":15.913,"end":17.761,"text":"Ko si ọrẹ kan bi Jesu,","marked":"Kò sí ọrẹ kan bí Jésù"},{"start":18.211,"end":20.323,"text":"Jesu to fẹ wa d'oju 'ku,","marked":"Jésù tó fẹ́ wá d'ojú kú"},{"start":20.773,"end":22.272,"text":"Babalawo kọ Ọlọrun ni,","marked":"Babalawo kọ Ọlọ́run ni"},{"start":22.722,"end":24.608,"text":"Awolẹ kọ, Ọlọrun ni,","marked":"Àwolẹ́ kọ́, Ọlọ́run ni"},{"start":25.058,"end":26.685,"text":"Eniyan kọ Ọlọrun ni.","marked":"Ènìyàn kọ Ọlọ́run ni."}],"end":26.685},{"key":"3","start":27.635,"lines":[{"start":27.635,"end":29.429,"text":"Nko ni ẹni ti mba ke pe,","marked":"Ǹkò ni ẹni tí mbá ké pè"},{"start":29.879,"end":31.667,"text":"Mo wo 'waju, mo wo ẹhin,","marked":"Mo wò wájú, mo wo ẹ̀hìn"},{"start":32.117,"end":33.602,"text":"Ko tilẹ si alabaro,","marked":"Kò tilẹ̀ sí alábàrò"},{"start":34.052,"end":36.299,"text":"Onisegun kọ, Ọlọrun ni,","marked":"Oníṣègùn kọ́, Ọlọ́run ni"},{"start":36.749,"end":38.6,"text":"Awolẹ kọ, Ọlọrun ni,","marked":"Àwolẹ́ kọ́, Ọlọ́run ni"},{"start":39.05,"end":40.937,"text":"Eniyan kọ, Ọlọrun ni.","marked":"Ènìyàn kọ́, Ọlọ́run ni."}],"end":40.937},{"key":"4","start":41.887,"lines":[{"start":41.887,"end":43.445,"text":"Sugbọn mo rọ mọ Ọ Jesu,","marked":"Sùgbọ́n mo rọ̀ mọ́ Ọ Jésù"},{"start":43.895,"end":45.586,"text":"Emi ki yo fi Ọ silẹ;","marked":"Èmi kí yó fi Ọ́ sílẹ̀"},{"start":46.036,"end":48.439,"text":"Jesu, ma sai ran mi lọwọ,","marked":"Jésù, má ṣàì ràn mí lọ́wọ́"},{"start":48.889,"end":50.939,"text":"Alawo kọ, Ọlọrun ni,","marked":"Aláwọ̀ kọ́, Ọlọ́run ni"},{"start":51.389,"end":52.772,"text":"Akunlẹyan lo mba mi ja.","marked":"Àkúnlẹ́yàn ló mbà mi jà."}],"end":52.772},{"key":"5","start":53.722,"lines":[{"start":53.722,"end":55.18,"text":"'Gbati mo joko n'ile mi,","marked":"gbàtí mo jókò n'ilé mi"},{"start":55.63,"end":57.56,"text":"Esu wa d'ẹru b'ọkan mi,","marked":"Èṣù wá d'ẹ̀rù b'ọkàn mi"},{"start":58.01,"end":59.833,"text":"Sugbọn Jesu gbe mi leke,","marked":"Sùgbọ́n Jésù gbé mi lékè"},{"start":60.283,"end":61.948,"text":"Wọn ni mo ku l'arayé sọ,","marked":"Wọ́n ni mo kú l'arayé sọ"},{"start":62.398,"end":63.991,"text":"Wọn l'o ti ku larayé sọ,","marked":"Wọ́n l'ó ti kú larayé sọ"},{"start":64.441,"end":66.135,"text":"Sugbọn Jesu da mi silẹ.","marked":"Sùgbọ́n Jésù dá mi sílẹ̀."}],"end":66.135},{"key":"6","start":67.085,"lines":[{"start":67.085,"end":68.867,"text":"Alairise, ko ma binu,","marked":"Aláìríṣẹ́, kò má bínú"},{"start":69.317,"end":70.697,"text":"Alaisan ma sọ 'reti nu,","marked":"Aláìsàn má sọ retí nù"},{"start":71.147,"end":72.88,"text":"Jesu yoo mu yin lara da,","marked":"Jésù yóò mú yín lára dá"},{"start":73.33,"end":75.387,"text":"Alawo kọ, Ọlọrun ni,","marked":"Aláwọ̀ kọ́, Ọlọ́run ni"},{"start":75.837,"end":78.427,"text":"Onisegun kọ, Ọlọrun ni,","marked":"Oníṣègùn kọ́, Ọlọ́run ni"},{"start":78.877,"end":80.772,"text":"Eniyan kọ, Ọlọrun ni.","marked":"Ènìyàn kọ́, Ọlọ́run ni."}],"end":80.772},{"key":"7","start":81.722,"lines":[{"start":81.722,"end":83.176,"text":"K'a f'ogo fun Baba l'oke,","marked":"K'á f'ògo fún Baba l'òkè"},{"start":83.626,"end":85.275,"text":"K'a f'ogo fun Ọmọ pẹlu,","marked":"K'á f'ògo fún Ọmọ pẹ̀lú"},{"start":85.725,"end":86.959,"text":"Ogo ni fun Mẹtalọkan.","marked":"Ògo ni fún Mẹ́talọ́kan."},{"start":87.409,"end":89.875,"text":"Ọlọsanyin kọ, Ọlọrun ni,","marked":"Ọlọ́sanyìn kọ́, Ọlọ́run ni"},{"start":90.325,"end":91.999,"text":"Aworawọ kọ, Ọlọrun ni,","marked":"Awòràwọ̀ kọ́, Ọlọ́run ni"},{"start":92.449,"end":94.059,"text":"Jesu nikan lo to ke pe.","marked":"Jésù nìkan lọ tó ké pè."}],"end":94.059}]}