{"v":3,"coll":"y","num":187,"id":"hymn_187","title":"GBO 'gbe ayo! Oluwa de","duration":40.624,"voices":{"male":{"file":"y-187-male-v3.m4a","bytes":282086,"sha256":"f2f63494ecc7b2f4e2bd76e58c8e26256d52c9f9354c87efcd4ee196664f0c7b","duration":40.7},"female":{"file":"y-187-female-v3.m4a","bytes":285643,"sha256":"e9cd3f4a231d6e26c7b1baf7ed3101cdf532eda26419c16a1ee0a4fc0fff69dc","duration":40.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.265,"text":"GBO 'gbe ayo! Oluwa de,","marked":"Gbọ́ gbé ayọ̀! Olúwa dé"},{"start":2.715,"end":4.136,"text":"Jesu t'a seleri","marked":"Jésù t'a ṣèlérí"},{"start":4.586,"end":5.854,"text":"Ki gbogbo okan mura de","marked":"Kí gbogbo ọkàn múra dé"},{"start":6.304,"end":7.468,"text":"K'ohun mura korin.","marked":"K'ohun múra kọrin."}],"end":7.468},{"key":"2","start":8.418,"lines":[{"start":8.418,"end":9.985,"text":"O de lati t'onde sile","marked":"Ó dé láti t'òǹdè sílẹ̀"},{"start":10.435,"end":11.606,"text":"L'oko eru esu","marked":"L'ọ̀kọ̀ ẹrú èṣù"},{"start":12.056,"end":13.812,"text":"Lekun 'de fo niwaju Re","marked":"Lẹ́kùn dé fọ́ níwájú Rẹ"},{"start":14.262,"end":15.315,"text":"Sekeseke rin da.","marked":"Ṣẹ́kẹ́ṣẹ́kẹ́ rìn dà."}],"end":15.315},{"key":"3","start":16.265,"lines":[{"start":16.265,"end":17.771,"text":"O de larin 'bajẹ ayé,","marked":"Ó dé lárin 'bajẹ ayé"},{"start":18.221,"end":19.239,"text":"Lati tan 'mọlẹ Rẹ,","marked":"Láti tan 'mọlẹ Rẹ"},{"start":19.689,"end":21.274,"text":"Lati mu k'awọn afọju,","marked":"Láti mú k'àwọn afọ́jú"},{"start":21.724,"end":22.803,"text":"Le f'oju wọn riran.","marked":"Lè f'ojú wọn ríran."}],"end":22.803},{"key":"4","start":23.753,"lines":[{"start":23.753,"end":26.035,"text":"O de, 'tunu f'ọkan 'rora,","marked":"Ó dé, tùnú f'ọkàn rora"},{"start":26.485,"end":27.67,"text":"Iwosan f'agbọgbẹ;","marked":"Ìwòsàn f'ágbọgbẹ́"},{"start":28.12,"end":29.438,"text":"Pẹlu 'sura or'-ọfẹ Rẹ,","marked":"Pẹ̀lú ṣúra or'-ọfẹ Rẹ"},{"start":29.888,"end":31.032,"text":"Fun awọn talaka.","marked":"Fún àwọn tálákà."}],"end":31.032},{"key":"5","start":31.982,"lines":[{"start":31.982,"end":33.64,"text":"Hosanna, Ob'Alafia","marked":"Hosanna, Ob'alafia"},{"start":34.09,"end":35.646,"text":"A o kede bibo Re;","marked":"A ó kéde bíbọ̀ Rẹ̀"},{"start":36.096,"end":37.391,"text":"Gbogbo orun y'o ma korin","marked":"Gbogbo ọ̀run y'ó má kọrin"},{"start":37.841,"end":39.074,"text":"oruko t'a feran.","marked":"orúkọ t'a fẹ́ràn."}],"end":39.074}]}