{"v":3,"coll":"y","num":589,"id":"hymn_589","title":"MO fara mi fun O","duration":62.134,"voices":{"male":{"file":"y-589-male-v3.m4a","bytes":425495,"sha256":"2aa198a00ff1a74a6856661b41326716367ea6a87775c945eca04c11eb114c22","duration":62.2},"female":{"file":"y-589-female-v3.m4a","bytes":449557,"sha256":"efb09efc5d35ed4b93da87cc1f9a1e3d07e18f526a8faf25948f06b5e7c4c54c","duration":62.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.514,"text":"MO fara mi fun ọ,","marked":"Mo fara mi fún ọ"},{"start":1.964,"end":3.065,"text":"Mo ku nitori rẹ,","marked":"Mo kú nítorí rẹ̀"},{"start":3.515,"end":4.589,"text":"Ki n le ra ọ pada,","marked":"Kí n lè rà ọ́ padà"},{"start":5.039,"end":6.386,"text":"K'o le jinde n n'oku;","marked":"K'ó lè jíǹde ń n'òkú"},{"start":6.836,"end":8.129,"text":"Mo f'ara mi fun ọ","marked":"Mo f'ara mi fún ọ"},{"start":8.579,"end":9.598,"text":"Kini 'wọ se fun MI?","marked":"Kíni 'wọ ṣe fún Mi?"}],"end":9.598},{"key":"2","start":10.548,"lines":[{"start":10.548,"end":11.633,"text":"Mo f'ọjọ ayé Mi,","marked":"Mo f'ọjọ́ ayé Mi"},{"start":12.083,"end":13.221,"text":"Se wahala fun ọ,","marked":"Ṣe wàhálà fún ọ"},{"start":13.671,"end":14.571,"text":"Ki iwọ ba le mọ,","marked":"Kí ìwọ bá le mọ́"},{"start":15.021,"end":16.014,"text":"Adun ayérayé;","marked":"Adùn ayérayé"},{"start":16.464,"end":17.702,"text":"Mo lọ p'ọdun fun ọ,","marked":"Mo lọ p'ọdún fún ọ"},{"start":18.152,"end":19.169,"text":"O lo kan fun Mi bi?","marked":"Ó lọ kàn fún Mi bí?"}],"end":19.169},{"key":"3","start":20.119,"lines":[{"start":20.119,"end":21.539,"text":"Ile ti Baba Mi,","marked":"Ilẹ̀ tí Baba Mi"},{"start":21.989,"end":23.233,"text":"At'itẹ ogo Mi,","marked":"Àt'ìtẹ́ ògo Mi"},{"start":23.683,"end":25.058,"text":"Mo fi silẹ w'ayé;","marked":"Mo fi sílẹ̀ w'ayé"},{"start":25.508,"end":26.624,"text":"Mo d'alarinkiri,","marked":"Mo d'alárìnkiri"},{"start":27.074,"end":28.141,"text":"Mo fi 'lẹ tori rẹ,","marked":"Mo fi 'lẹ torí rẹ̀"},{"start":28.591,"end":29.658,"text":"Kil'o f'ilẹ fun Mi?","marked":"Kíl'ó f'ilẹ̀ fún Mi?"}],"end":29.658},{"key":"4","start":30.608,"lines":[{"start":30.608,"end":31.844,"text":"Mo jiya po fun o","marked":"Mo jìyà pọ̀ fún ọ"},{"start":32.294,"end":33.326,"text":"Ti enu ko le so","marked":"Tí ẹnu kò lè sọ"},{"start":33.776,"end":35.076,"text":"Mo jijakadi nla","marked":"Mo jìjàkadì ńlá"},{"start":35.526,"end":36.38,"text":"Tori igbala re","marked":"Torí ìgbàlà rẹ"},{"start":36.83,"end":37.959,"text":"Mo jiya po fun o","marked":"Mo jìyà pọ̀ fún ọ"},{"start":38.409,"end":39.529,"text":"O le jiya fun mi?","marked":"Ó lè jìyà fún mi?"}],"end":39.529},{"key":"5","start":40.479,"lines":[{"start":40.479,"end":41.556,"text":"Mo mu igbala nla","marked":"Mo mú ìgbàlà ńlá"},{"start":42.006,"end":43.228,"text":"Lat'ile baba mi","marked":"Lát'ilẹ̀ Baba mi"},{"start":43.678,"end":45.377,"text":"Wa, lati fi fun o","marked":"Wá, láti fi fún ọ"},{"start":45.827,"end":46.848,"text":"Ati idariji","marked":"Àti ìdáríjì"},{"start":47.298,"end":48.277,"text":"Mo m'ebun wa fun o","marked":"Mo m'ẹ̀bùn wá fún ọ"},{"start":48.727,"end":49.852,"text":"Kil'o mu wa fun Mi?","marked":"Kíl'ó mú wa fún Mi?"}],"end":49.852},{"key":"6","start":50.802,"lines":[{"start":50.802,"end":51.801,"text":"Fi ara rẹ fun Mi,","marked":"Fi ara rẹ fún Mi"},{"start":52.251,"end":53.392,"text":"Fi ayé rẹ sin Mi;","marked":"Fi ayé rẹ sìn Mi"},{"start":53.842,"end":55.399,"text":"Di 'ju si nkan t'ayé,","marked":"Di ju sí nǹkan t'ayé"},{"start":55.849,"end":57.276,"text":"Si wo ohun t'ọrun;","marked":"Sì wo ohun t'ọ̀run"},{"start":57.726,"end":58.978,"text":"Mo f'ara Mi fun ọ,","marked":"Mo f'ara Mi fún ọ"},{"start":59.428,"end":60.585,"text":"Si f'ara rẹ fun Mi?","marked":"Sì f'ara rẹ fún Mi?"}],"end":60.585}]}