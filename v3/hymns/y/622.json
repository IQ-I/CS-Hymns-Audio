{"v":3,"coll":"y","num":622,"id":"hymn_622","title":"JESU Baba omode","duration":16.236,"voices":{"male":{"file":"y-622-male-v3.m4a","bytes":106264,"sha256":"35a0f6b5c5809c61bffa881dc8fb5ca41d0c0ee1127d5acd6e7cfa1c5e4eca84","duration":16.3},"female":{"file":"y-622-female-v3.m4a","bytes":110764,"sha256":"e61f38e0cce880d15463909e63a5f11505c177241d30d5e4682e87bc02a93af5","duration":16.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.732,"text":"JESU, Baba Ọmọde,","marked":"Jésù, Baba Ọmọdé"},{"start":2.182,"end":3.51,"text":"Asẹ Rẹ ni awa n se;","marked":"Àsẹ Rẹ̀ ni àwa ń ṣe"},{"start":3.96,"end":5.083,"text":"A m'ọmọ yi wa 'dọ Rẹ,","marked":"A m'ọmọ yí wá 'dọ Rẹ̀"},{"start":5.533,"end":7.035,"text":"Ki iwọ sọ di Tirẹ.","marked":"Kí ìwọ sọ di Tìrẹ."}],"end":7.035},{"key":"2","start":7.985,"lines":[{"start":7.985,"end":9.48,"text":"Ninu ẹsẹ ni a bi,","marked":"Nínú ẹsẹ̀ ni a bí"},{"start":9.93,"end":11.13,"text":"Wẹ kuro nin' ẹsẹ rẹ;","marked":"Wẹ̀ kúrò nín ẹsẹ̀ rẹ"},{"start":11.58,"end":12.901,"text":"Ẹjẹ Rẹ ni a fi ra,","marked":"Ẹ̀jẹ̀ Rẹ̀ ni a fi rà"},{"start":13.351,"end":14.686,"text":"K'o pin ninu Ẹbun Rẹ.","marked":"K'ó pín nínú Ẹ̀bùn Rẹ̀."}],"end":14.686}]}