{"v":3,"coll":"y","num":623,"id":"hymn_623","title":"OJO nla l'ojo ti mo yan","duration":54.528,"voices":{"male":{"file":"y-623-male-v3.m4a","bytes":378411,"sha256":"348cef17db32950d77489d06f9819b2e4cc3b4d4532af171bc088a4489b592dc","duration":54.6},"female":{"file":"y-623-female-v3.m4a","bytes":393599,"sha256":"e1dbcb28989d189b14e8b1c558ae22b0e49a39a7a01ddbd086af43bb953ca7be","duration":54.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.72,"text":"OJO nla l'ojo ti mo yan","marked":"Ọjọ́ ńlá l'ọjọ́ tí mo yàn"},{"start":2.17,"end":3.252,"text":"Olugbala l'olorun mi","marked":"Olùgbàlà l'Ọlọ́run mi"},{"start":3.702,"end":4.957,"text":"O ye ki okan mi ma yo","marked":"Ó yẹ kí ọkàn mi má yọ̀"},{"start":5.407,"end":6.765,"text":"Ko si ihin na kale.","marked":"Kò sí ìhín ná kalẹ̀."}],"end":6.765},{"key":"CHORUS","start":7.715,"lines":[{"start":7.715,"end":8.857,"text":"Ojo nla I'ojo na!","marked":"Ọjọ́ ńlá l'ọjọ́ ná!"},{"start":9.307,"end":10.957,"text":"Ti Jesu we ese mi nu","marked":"Tí Jésù wẹ ẹsẹ̀ mi nù"},{"start":11.407,"end":12.933,"text":"O ko mi ki nma gbadura","marked":"Ó kọ́ mi kí ńmá gbàdúrà"},{"start":13.383,"end":15.304,"text":"Ki nma sora, ki nsi ma yo","marked":"Kí ńmá ṣọ́ra, kí ńṣí má yọ̀"},{"start":15.754,"end":16.844,"text":"Ojo nla I'ojo na!","marked":"Ọjọ́ ńlá l'ọjọ́ ná!"},{"start":17.294,"end":18.964,"text":"Ti Jesu we ese mi nu.","marked":"Tí Jésù wẹ ẹsẹ̀ mi nù."}],"end":18.964},{"key":"2","start":19.914,"lines":[{"start":19.914,"end":21.361,"text":"Ise igbala pari na","marked":"Iṣẹ́ ìgbàlà parí ná"},{"start":21.811,"end":23.693,"text":"Mo di t'Oluwa mi loni","marked":"Mo di t'Olúwa mi lónì"},{"start":24.143,"end":25.596,"text":"On l'o pe mi ti mo si je","marked":"Òn l'ó pè mí tí mo sì jẹ́"},{"start":26.046,"end":27.59,"text":"Mo f'ayo j'ipe mimo na","marked":"Mo f'ayọ̀ j'ìpè mímọ́ ná"}],"end":27.59},{"key":"3","start":28.54,"lines":[{"start":28.54,"end":30.227,"text":"Eje mimo yi ni mo je","marked":"Ẹ̀jẹ̀ mímọ́ yí ni mo jẹ́"},{"start":30.677,"end":32.065,"text":"F'Eni to ye lati feran","marked":"F'Ẹni tó yẹ láti fẹ́ràn"},{"start":32.515,"end":33.913,"text":"Jek'orin didun kun 'le Re","marked":"Jẹ́k'orin dídùn kún lé Rẹ̀"},{"start":34.363,"end":36.013,"text":"Nigba mo ba nlo sin nibe.","marked":"Nígbà mo bá ńlọ sìn níbẹ̀."}],"end":36.013},{"key":"4","start":36.963,"lines":[{"start":36.963,"end":38.462,"text":"Simi aiduro okan mi","marked":"Ṣími àìdúró ọkàn mi"},{"start":38.912,"end":40.273,"text":"Simi le Jesu Oluwa","marked":"Ṣímí lé Jésù Olúwa"},{"start":40.723,"end":42.168,"text":"Tani je wipe aiye dun","marked":"Tani jẹ́ wípé ayé dùn"},{"start":42.618,"end":44.42,"text":"Ju odo awon Angeli.","marked":"Ju ọ̀dọ̀ àwọn Áńgẹ́lì."}],"end":44.42},{"key":"5","start":45.37,"lines":[{"start":45.37,"end":47.015,"text":"Enyin orun, gbo eje mi","marked":"Ẹ̀yin ọ̀run, gbọ́ ẹ̀jẹ̀ mi"},{"start":47.465,"end":48.678,"text":"Eje mi ni ojojumo","marked":"Ẹ̀jẹ̀ mi ní ojojúmọ́"},{"start":49.128,"end":50.952,"text":"Em'o ma so d'otun titi","marked":"Èm'ó má sọ d'ọ̀tún títí"},{"start":51.402,"end":52.979,"text":"Iku y'o fi mu mi re le.","marked":"Ikú y'ó fi mú mi rẹ̀ lé."}],"end":52.979}]}