{"v":3,"coll":"y","num":92,"id":"hymn_92","title":"OKAN mi yin Oba orun","duration":68.095,"voices":{"male":{"file":"y-92-male.m4a","bytes":484345,"sha256":"6a02103425465042d34e1bb625d41c38b496f147acccbb129ca3d6f9553700d8","duration":68.1},"female":{"file":"y-92-female.m4a","bytes":504008,"sha256":"26b92d511e7a99bae55b59f2f76ccee0a2e8e30e69b6c82e8283348758b754e5","duration":68.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.577,"text":"OKAN mi yin Oba orun","marked":"Ọkàn mi yin Ọba ọ̀run"},{"start":1.957,"end":3.301,"text":"Mu ore wa sodo Re,","marked":"Mú ọrẹ wá sọ́dọ̀ Rẹ"},{"start":3.681,"end":5.981,"text":"'Wo ta wosan, ta dariji","marked":"'Wò ta wọ̀sán, ta dáríjì"},{"start":6.361,"end":7.859,"text":"Tal'a ba ha yin bi Re?","marked":"Tal'a bá há yín bí Rẹ?"}],"end":7.859},{"key":"CHORUS","start":8.809,"lines":[{"start":8.809,"end":10.027,"text":"Yin Oluwa, Yin Oluwa","marked":"Yín Olúwa, Yin Olúwa"},{"start":10.407,"end":11.756,"text":"Yin Oba Ainipekun","marked":"Yín Ọba Àìnípẹ̀kun"},{"start":12.136,"end":13.304,"text":"Yin Oluwa, Yin Oluwa","marked":"Yín Olúwa, Yin Olúwa"},{"start":13.684,"end":15.167,"text":"Yin Oba Ainipekun","marked":"Yín Ọba Àìnípẹ̀kun"}],"end":15.167},{"key":"2","start":16.117,"lines":[{"start":16.117,"end":17.686,"text":"Yin fun Oko 'gbala kehin","marked":"Yín fún Ọkọ̀ 'gbàlà kẹ́hìn"},{"start":18.066,"end":19.478,"text":"To sokale f'araiye","marked":"Tó sọ̀kalẹ̀ f'araiye"},{"start":19.858,"end":21.28,"text":"O si yan Bab'Aladura","marked":"Ó sì yan Bab'Aládúrà"},{"start":21.66,"end":23.195,"text":"Lati je Alakoso.","marked":"Láti jẹ́ Alákòso."}],"end":23.195},{"key":"3","start":24.145,"lines":[{"start":24.145,"end":25.931,"text":"Yin fun anu to ti fihan","marked":"Yín fún ànú tó ti fìhàn"},{"start":26.311,"end":27.877,"text":"Lori Egbe Serafu;","marked":"Lórí Ẹgbẹ́ Séráfù"},{"start":28.257,"end":29.911,"text":"To pa wa mo titi d'oni","marked":"Tó pa wá mọ́ títí d'òní"},{"start":30.291,"end":31.803,"text":"To si fun wa n'isegun.","marked":"Tó sì fún wa ń'íṣègùn."}],"end":31.803},{"key":"4","start":32.753,"lines":[{"start":32.753,"end":34.478,"text":"Yin fun abo ti o daju","marked":"Yín fún abọ́ tí ó dájú"},{"start":34.858,"end":36.23,"text":"To nfun wa lojurere,","marked":"Tó ńfun wa lójúrẹrẹ"},{"start":36.61,"end":38.15,"text":"Ninu wahala on 'danwo","marked":"Nínú wàhálà on 'dánwò"},{"start":38.53,"end":39.819,"text":"Anu Re wa bakanna.","marked":"Ànú Rẹ̀ wá bákanná."}],"end":39.819},{"key":"5","start":40.769,"lines":[{"start":40.769,"end":42.622,"text":"Yin fun abo ti o daju","marked":"Yín fún abọ́ tí ó dájú"},{"start":43.002,"end":44.282,"text":"Ta nri l'Egbe Serafu","marked":"Ta ńrí l'Ègbè Séráfù"},{"start":44.662,"end":46.961,"text":"Aje, Oso, on Sonponnna","marked":"Ajé, Ọ̀ṣọ́, on Sonponnna"},{"start":47.341,"end":48.678,"text":"Won ko ri wa gbese mo.","marked":"Wọn kò rí wa gbéṣẹ́ mọ́."}],"end":48.678},{"key":"6","start":49.628,"lines":[{"start":49.628,"end":51.026,"text":"Bi baba ni o ntoju wa","marked":"Bí bàbá ni ó ńtọ́jú wa"},{"start":51.406,"end":52.999,"text":"O si mo ailera wa,","marked":"Ó sì mọ àìlera wa"},{"start":53.379,"end":54.937,"text":"Jeje lo ngbe wa I'apa Re,","marked":"Jẹ́jẹ́ ló ńgbé wa l'apá Rẹ̀"},{"start":55.317,"end":57.052,"text":"O nf' onje iye bo wa.","marked":"Ó ńf' ońjẹ ìyè bò wá."}],"end":57.052},{"key":"7","start":58.002,"lines":[{"start":58.002,"end":60.066,"text":"Ogun orun, e ba wa yin","marked":"Ogún ọ̀run, ẹ bá wá yín"},{"start":60.446,"end":62.633,"text":"Baba, Omo, on Emi","marked":"Bàbá, Ọmọ, on Ẹ̀mí"},{"start":63.013,"end":64.726,"text":"Orun, Osupa, e wole","marked":"Ọ̀run, Òṣùpá, ẹ wọ̀lẹ̀"},{"start":65.106,"end":66.545,"text":"Ati gbogbo agbaiye.","marked":"Àti gbogbo agbaiye."}],"end":66.545}]}