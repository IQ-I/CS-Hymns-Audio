{"v":3,"coll":"y","num":517,"id":"hymn_517","title":"FE orun, alailegbe","duration":49.277,"voices":{"male":{"file":"y-517-male-v3.m4a","bytes":356729,"sha256":"4074fd2d63b1908f9f9085fc9f46da9ee544bf75fd9877db492c2733060fef93","duration":49.3},"female":{"file":"y-517-female-v3.m4a","bytes":366915,"sha256":"05d9d286f9a3abb70862f5333332489268733bded4206e2c138be4a09c146acd","duration":49.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.369,"text":"IFE orun, alailegbe","marked":"Ìfẹ́ ọ̀run, aláìlẹ́gbẹ́"},{"start":2.819,"end":4.559,"text":"Ayo orun, sokale","marked":"Ayọ̀ ọ̀run, sọ̀kalẹ̀"},{"start":5.009,"end":6.439,"text":"Fi okan wa se 'bugbe Re","marked":"Fi ọkàn wa ṣe bùgbé Rẹ"},{"start":6.889,"end":8.019,"text":"Se asetan anu Re","marked":"Ṣe àṣẹ̀tàn àánú Rẹ"},{"start":8.469,"end":10.76,"text":"Jesu, iwo ni alanu","marked":"Jésù, ìwọ ni alánù"},{"start":11.21,"end":12.421,"text":"Iwo l'onibu ife","marked":"Ìwọ l'oníbú ìfẹ́"},{"start":12.871,"end":14.617,"text":"Fi gbala Re be wa wo","marked":"Fi gbàlà Rẹ bẹ̀ wá wò"},{"start":15.067,"end":16.47,"text":"M'okan eru wa duro.","marked":"M'ọkàn ẹ̀rù wa dúró."}],"end":16.47},{"key":"2","start":17.42,"lines":[{"start":17.42,"end":19.154,"text":"Wa, Olodumare, gba wa,","marked":"Wá, Olódùmarè, gbà wá"},{"start":19.604,"end":20.927,"text":"Fun wa l'ore-ọfẹ Rẹ;","marked":"Fún wa l'ore-ọfẹ Rẹ"},{"start":21.377,"end":23.056,"text":"Lojiji ni k'o pade wa,","marked":"Lójijì ni k'ó pàdé wa"},{"start":23.506,"end":24.773,"text":"Ma si fi wa silẹ mọ;","marked":"Má sì fi wá sílẹ̀ mọ́"},{"start":25.223,"end":26.664,"text":"Iwọ l'a o ma yin titi,","marked":"Ìwọ l'á ó má yín títí"},{"start":27.114,"end":28.41,"text":"Bi wọn ti ń se ni ọrun,","marked":"Bí wọ́n ti ń ṣe ní ọ̀run"},{"start":28.86,"end":30.512,"text":"Iyin wa ki yoo l'opin,","marked":"Ìyìn wa kì yóò l'òpin"},{"start":30.962,"end":32.497,"text":"A o sogo n'nu 'fẹ Rẹ.","marked":"A ò ṣògo n'nú 'fẹ Rẹ."}],"end":32.497},{"key":"3","start":33.447,"lines":[{"start":33.447,"end":35.191,"text":"Sasepe awa ẹda Rẹ,","marked":"Ṣàṣepé àwa ẹ̀dà Rẹ"},{"start":35.641,"end":37.146,"text":"Jẹ k'a wa lailabawọn;","marked":"Jẹ́ k'á wà láìlábàwọ́n"},{"start":37.596,"end":38.939,"text":"K'a ri titobi 'gbala Rẹ,","marked":"K'á rí títóbi gbàlà Rẹ"},{"start":39.389,"end":40.518,"text":"Ni aritan ninu Rẹ,","marked":"Ní àrítàn nínú Rẹ̀"},{"start":40.968,"end":42.49,"text":"Mu wa lat'ogo de ogo,","marked":"Mú wa lát'ògo dé ògo"},{"start":42.94,"end":44.362,"text":"Titi de ibugbe wa ;","marked":"Títí dé ibùgbé wa"},{"start":44.812,"end":46.069,"text":"Titi awa o fi wọle","marked":"Títí àwa ó fi wọlé"},{"start":46.519,"end":47.728,"text":"N' iyanu ifẹ, iyin.","marked":"Ń ìyanu ìfẹ́, ìyìn."}],"end":47.728}]}