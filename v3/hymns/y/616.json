{"v":3,"coll":"y","num":616,"id":"hymn_616","title":"JESU n lo sinu odo Jordan","duration":52.645,"voices":{"male":{"file":"y-616-male-v3.m4a","bytes":349893,"sha256":"0a7d9761d174bdc331f08d0c0187d996ad7a70b8b9732ac8b607d1e25637c056","duration":52.7},"female":{"file":"y-616-female-v3.m4a","bytes":363681,"sha256":"8e2d369618e4a3b0171dba957c000fcc7350f39f1d32382a34047eb67c4fe9f1","duration":52.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.054,"text":"JESU nlo sinu odo Jordan - 3ce","marked":"Jésù ńlọ sínú odò Jordan"},{"start":2.504,"end":3.638,"text":"Lodo Johanu Baptist.","marked":"Lọ́dọ̀ Johanu Baptist."}],"end":3.638},{"key":"CHORUS","start":4.588,"lines":[{"start":4.588,"end":5.875,"text":"A nlo sodo Jordan","marked":"A ńlọ sọ́dọ̀ Jordan"},{"start":6.325,"end":7.27,"text":"Pelu Olugbala wa","marked":"Pẹ̀lú Olùgbàlà wa"},{"start":7.72,"end":9.001,"text":"A nlo soda Jordan!","marked":"À ńlọ sọ́dá Jordan!"},{"start":9.451,"end":10.544,"text":"Odo iwenumo.","marked":"Ọ̀dọ̀ ìwẹ̀nùmọ́."}],"end":10.544},{"key":"2","start":11.494,"lines":[{"start":11.494,"end":14.218,"text":"Ka to le d'ade, a o ma korin - 3ce","marked":"Ká tó lè d'adé, a ò má kọrin"},{"start":14.668,"end":15.847,"text":"Orin ife mimo.","marked":"Orin ìfẹ́ mímọ́."}],"end":15.847},{"key":"3","start":16.797,"lines":[{"start":16.797,"end":18.45,"text":"Jesu yio gbade f'omo Re - 3ce","marked":"Jésù yóò gbàde f'ọmọ Rẹ"},{"start":18.9,"end":19.978,"text":"F'awon ayanfe Re.","marked":"F'àwọn àyànfẹ́ Rẹ."}],"end":19.978},{"key":"4","start":20.928,"lines":[{"start":20.928,"end":22.688,"text":"Adaba, mimo sokale - 3ce","marked":"Àdàbà, mímọ́ sọ̀kalẹ̀"},{"start":23.138,"end":24.403,"text":"S'or'Olugbala wa.","marked":"S'ọ́r'olùgbàlà wa."}],"end":24.403},{"key":"5","start":25.353,"lines":[{"start":25.353,"end":27.054,"text":"A gbohun kan lat'orun wa - 3ce","marked":"A gbóhùn kan lát'ọ̀run wá"},{"start":27.504,"end":28.764,"text":"Eyi l'ayanfe Mi.","marked":"Èyí l'àyànfẹ́ Mi."}],"end":28.764},{"key":"6","start":29.714,"lines":[{"start":29.714,"end":31.728,"text":"Ema gbo Tire titi aiye, - 3ce","marked":"Ẹ̀má gbọ́ Tire títí ayé"},{"start":32.178,"end":33.259,"text":"Odo Iwenumo.","marked":"Ọ̀dọ̀ Ìwẹ̀nùmọ́."}],"end":33.259},{"key":"7","start":34.209,"lines":[{"start":34.209,"end":35.733,"text":"Jesu Oluwa ti d'odo na - 3ce","marked":"Jésù Olúwa ti d'odò ná"},{"start":36.183,"end":37.286,"text":"Odo Iwenumo.","marked":"Ọ̀dọ̀ Ìwẹ̀nùmọ́."}],"end":37.286},{"key":"8","start":38.236,"lines":[{"start":38.236,"end":39.83,"text":"Gbogbo elese e wa kalo - 3ce","marked":"Gbogbo ẹlẹ́ṣẹ̀ ẹ wá kálọ"},{"start":40.28,"end":41.553,"text":"Sinu odo Jordan.","marked":"Sínú odò Jordan."}],"end":41.553},{"key":"9","start":42.503,"lines":[{"start":42.503,"end":44.315,"text":"Kerub' Serafu e wa kalo - 3ce","marked":"Kerub Séráfù ẹ̀ wá kálọ"},{"start":44.765,"end":46.054,"text":"Sod' Olugbala wa.","marked":"Sọd Olùgbàlà wa."}],"end":46.054},{"key":"10","start":47.004,"lines":[{"start":47.004,"end":49.136,"text":"Ade iye yio je ti wa - 3ce","marked":"Adé iye yóò jẹ́ ti wá"},{"start":49.586,"end":51.096,"text":"Bi a ba gba Jesu gbo.","marked":"Bí a bá gba Jésù gbọ́."}],"end":51.096}]}