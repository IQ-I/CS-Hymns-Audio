{"v":3,"coll":"y","num":296,"id":"hymn_296","title":"E gb'ohun ife at'anu","duration":53.242,"voices":{"male":{"file":"y-296-male-v3.m4a","bytes":385317,"sha256":"1371c27963393840c103d1e501936fce0e218b45646b197055a56e54df36a33f","duration":53.3},"female":{"file":"y-296-female-v3.m4a","bytes":394914,"sha256":"766e2ef81319eb3dfaff21231ce785614a3269f7194e92512bcd98b6adf4fd29","duration":53.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.116,"text":"Ẹ GB' OHUN ifẹ at'anu,","marked":"Ẹ Gb Ohun ìfẹ́ àt'anú"},{"start":2.566,"end":4.075,"text":"Ti n dun l'oke Kalfari!","marked":"Tí ń dùn l'òkè Kalfárì!"},{"start":4.525,"end":6.144,"text":"Wo! o san awọn apata!","marked":"Wò! ó san àwọn àpáta!"},{"start":6.594,"end":8.293,"text":"O mi 'lẹ, o m'ọrun su!","marked":"Ó mi 'lẹ, ó m'ọ̀run ṣú!"},{"start":8.743,"end":10.688,"text":"O ti pari,O ti pari,","marked":"Ó ti pari,o ti parí"},{"start":11.138,"end":12.622,"text":"Gbọ b'Olugbala ti ke.","marked":"Gbọ́ b'Olùgbàlà ti ké."}],"end":12.622},{"key":"2","start":13.572,"lines":[{"start":13.572,"end":15.915,"text":"O ti pari! b'o ti dun to,","marked":"Ó ti parí! b'ó ti dùn tó"},{"start":16.365,"end":17.605,"text":"Ohun t'ọrọ wọnyi wi,","marked":"Ohun t'ọ̀rọ̀ wọ̀nyí wí"},{"start":18.055,"end":19.32,"text":"Ibukun ọrun l'ainiye,","marked":"Ìbùkún ọ̀run l'àìníye"},{"start":19.77,"end":21.336,"text":"Ti ọdọ Kristi san si wa:","marked":"Tí ọ̀dọ̀ Kristi sàn sí wa"},{"start":21.786,"end":23.511,"text":"O ti pari,O ti pari,","marked":"Ó ti pari,o ti parí"},{"start":23.961,"end":25.569,"text":"Ẹ ranti ọrọ wọnyi.","marked":"Ẹ rántí ọ̀rọ̀ wọ̀nyí."}],"end":25.569},{"key":"3","start":26.519,"lines":[{"start":26.519,"end":27.832,"text":"Ise igbala wa pari,","marked":"Iṣẹ́ ìgbàlà wa parí"},{"start":28.282,"end":29.867,"text":"Jesu ti mu ofin se","marked":"Jésù ti mú òfin ṣe"},{"start":30.317,"end":32.394,"text":"O pari, nkan t'Olorun wi","marked":"Ó parí, nǹkan t'Ọlọ́run wí"},{"start":32.844,"end":34.327,"text":"Awa ki o ka 'ku si","marked":"Àwa kí ó ká kú sí"},{"start":34.777,"end":36.739,"text":"'O ti pari, 'O ti pari,","marked":"ó ti parí, ó ti parí"},{"start":37.189,"end":38.725,"text":"Elese ipe l'eyi.","marked":"Ẹlẹ́ṣẹ̀ ìpè l'èyí."}],"end":38.725},{"key":"4","start":39.675,"lines":[{"start":39.675,"end":42.065,"text":"Ẹ tun harpu yin se, Seraf,","marked":"Ẹ tún harpu yín ṣe, Seraf"},{"start":42.515,"end":43.79,"text":"Lati kọrin ogo Rẹ;","marked":"Láti kọrin ògo Rẹ"},{"start":44.24,"end":45.732,"text":"Ar'ayé at'ara ọrun,","marked":"Ar'ayé àt'ara ọ̀run"},{"start":46.182,"end":47.609,"text":"Yin 'rukọ Emmanuel,","marked":"Yín 'rukọ Emmanuel"},{"start":48.059,"end":49.913,"text":"O ti pari, O ti pari,","marked":"Ó ti parí, Ó ti parí"},{"start":50.363,"end":51.693,"text":"Ogo fun Ọd'aguntan.","marked":"Ògo fún Ọd'àgùntàn."}],"end":51.693}]}