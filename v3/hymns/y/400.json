{"v":3,"coll":"y","num":400,"id":"hymn_400","title":"OLORUN l'abo eni Re","duration":24.538,"voices":{"male":{"file":"y-400-male-v3.m4a","bytes":165433,"sha256":"51f88cee8f7961dd7d4add474231ace24445cbc870cc79ecd59c5984aaef476a","duration":24.6},"female":{"file":"y-400-female-v3.m4a","bytes":169662,"sha256":"768ead250df87bb19e284dc7ac28e84323c89cc8120da0a001ea4428c063caaf","duration":24.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.374,"text":"ỌLỌRUN l'abo ẹni Rẹ,","marked":"Ọlọ́run l'abo ẹni Rẹ̀"},{"start":1.824,"end":3.046,"text":"Nigba iji ipọnju de;","marked":"Nígbà ìjì ìpọ́njú dé"},{"start":3.496,"end":4.977,"text":"K'awa to se aroye wa,","marked":"K'àwa tó ṣe àròyé wa"},{"start":5.427,"end":7.237,"text":"A! sa wo t'oun t'iranwọ Rẹ.","marked":"A! sá wo t'òun t'ìrànwọ́ Rẹ̀."}],"end":7.237},{"key":"2","start":8.187,"lines":[{"start":8.187,"end":9.587,"text":"B'agbami riru mbu soke,","marked":"B'àgbàmí rírú mbú sókè"},{"start":10.037,"end":11.445,"text":"Ọkan wa mbẹ l'alafia;","marked":"Ọkàn wa mbẹ́ l'àlàáfíà"},{"start":11.895,"end":13.555,"text":"Nigb' orilẹ at' etido,","marked":"Nígb orílẹ̀ àt etídò"},{"start":14.005,"end":15.414,"text":"Ba n jaya riru omi na.","marked":"Bá ń jáyà rírú omi ná."}],"end":15.414},{"key":"3","start":16.364,"lines":[{"start":16.364,"end":17.799,"text":"Iwe ọwọ ni, ọrọ Rẹ;","marked":"Ìwé ọwọ́ ni, ọ̀rọ̀ Rẹ"},{"start":18.249,"end":19.515,"text":"Kawọ ibinu fufu wa;","marked":"Káwọ́ ìbínú fùfù wà"},{"start":19.965,"end":21.152,"text":"Ọrọ Rẹ m'alafia wa,","marked":"Ọ̀rọ̀ Rẹ̀ m'àlàáfíà wà"},{"start":21.602,"end":22.988,"text":"O f'ilera f'ọkan arẹ.","marked":"Ó f'ìlera f'ọkàn àrẹ."}],"end":22.988}]}