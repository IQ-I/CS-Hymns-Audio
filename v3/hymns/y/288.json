{"v":3,"coll":"y","num":288,"id":"hymn_288","title":"HOSANNA s'Omo Dafidi","duration":42.981,"voices":{"male":{"file":"y-288-male-v3.m4a","bytes":304890,"sha256":"435308bacb457181132b80c14e0fd0862ff7823bb50c3b59a771eb2e04d52240","duration":43.0},"female":{"file":"y-288-female-v3.m4a","bytes":313663,"sha256":"8069df65e1ee28e826c00f23ea9b4555fafa0b861d843370fe74ee3f6b061679","duration":43.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.875,"text":"HOSANNA s'ọmọ Dafidi,","marked":"Hosanna s'ọmọ Dafidi"},{"start":2.325,"end":4.061,"text":"Hosanna, ẹ kọrin","marked":"Hosanna, ẹ kọrin"},{"start":4.511,"end":5.754,"text":"Olubukun l'Ẹni ti mbọ,","marked":"Olùbùkún l'Ẹni tí mbọ̀"},{"start":6.204,"end":7.214,"text":"L'orukọ Oluwa.","marked":"L'orúkọ Olúwa."}],"end":7.214},{"key":"2","start":8.164,"lines":[{"start":8.164,"end":9.77,"text":"Hosanna s'ọmọ Dafidi',","marked":"Hosanna s'ọmọ Dafidi"},{"start":10.22,"end":11.38,"text":"L'Ẹgbẹ Angẹli n ke;","marked":"L'Ẹgbẹ́ Áńgẹ́lì ń ké"},{"start":11.83,"end":13.11,"text":"Gbogbo ẹda jumọ gberin,","marked":"Gbogbo ẹ̀dá jùmọ̀ gbẹ́rin"},{"start":13.56,"end":14.812,"text":"Hosanna s'Ọba wa.","marked":"Hosanna s'Ọba wa."}],"end":14.812},{"key":"3","start":15.762,"lines":[{"start":15.762,"end":17.874,"text":"Hosanna! awọn Heberu,","marked":"Hosanna! àwọn Heberu"},{"start":18.324,"end":19.474,"text":"Ja im'ọpẹ sọna,","marked":"Ja ìm'ọ̀pẹ sọ́nà"},{"start":19.924,"end":22.092,"text":"Hosanna a mu ẹbun wa,","marked":"Hosanna a mú ẹ̀bùn wá"},{"start":22.542,"end":23.585,"text":"Fi tun ọna Rẹ se.","marked":"Fi tún ọ̀nà Rẹ ṣe."}],"end":23.585},{"key":"4","start":24.535,"lines":[{"start":24.535,"end":26.711,"text":"T'agba t'ewe n ke Hosanna!","marked":"T'àgbà t'èwe ń ké Hosanna!"},{"start":27.161,"end":28.482,"text":"K'ijiya Rẹ to de;","marked":"K'ìjìyà Rẹ̀ tó dé"},{"start":28.932,"end":31.086,"text":"Loni, a si n kọ Hosanna!","marked":"Lónì, a sì ń kọ́ Hosanna!"},{"start":31.536,"end":32.947,"text":"B'o ti n jọba l'oke.","marked":"B'ó ti ń jọba l'òkè."}],"end":32.947},{"key":"5","start":33.897,"lines":[{"start":33.897,"end":35.405,"text":"B'O ti gba 'yin wọn nigba naa","marked":"B'Ó ti gba yìn wọ́n nígbà náà"},{"start":35.855,"end":37.284,"text":"Jọ gba ẹbẹ wa yi,","marked":"Jọ gba ẹ̀bẹ̀ wa yí"},{"start":37.734,"end":39.658,"text":"Lọrun ka le b'angẹl' kọrin,","marked":"Lọ́rùn ká lè b'angẹl' kọrin"},{"start":40.108,"end":41.432,"text":"Hosanna s'Ọba wa.","marked":"Hosanna s'Ọba wa."}],"end":41.432}]}