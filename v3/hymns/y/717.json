{"v":3,"coll":"y","num":717,"id":"hymn_717","title":"OLUSO-AGUTAN to wa","duration":51.82,"voices":{"male":{"file":"y-717-male-v3.m4a","bytes":371168,"sha256":"75b4d08de5bb4ab3313ebafcfa1b8e4f04acc6f237a2d3a54a9ae919822ff637","duration":51.9},"female":{"file":"y-717-female-v3.m4a","bytes":383007,"sha256":"02efb7cacb12b1a58229d34f0a4d3a37d182b318d9fee4b3bbaa8d2147126533","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.84,"text":"OLUSO-AGUTAN to wa","marked":"Oluso-agutan tó wà"},{"start":2.29,"end":3.867,"text":"Awa fe itoju Re","marked":"Àwa fẹ́ ìtọ́jú Rẹ"},{"start":4.317,"end":5.825,"text":"Fun wa ni ibukun t'a nfe","marked":"Fún wa ní ìbùkún t'á ńfẹ́"},{"start":6.275,"end":7.637,"text":"Si pese aye fun wa","marked":"Sì pèsè ayé fún wa"},{"start":8.087,"end":9.913,"text":"Jesu mimo, Jesu mimo)","marked":"Jésù mímọ́, Jésù mímọ́"},{"start":10.363,"end":12.459,"text":"O ra wa, Tire ni wa) - 2ce","marked":"Ó rà wá, Tire ni wá"}],"end":12.459},{"key":"2","start":13.409,"lines":[{"start":13.409,"end":14.921,"text":"Tire ni wa fi wa s'ore","marked":"Tirẹ̀ ni wá fi wá s'ọ́rẹ́"},{"start":15.371,"end":16.51,"text":"Ma se amona fun wa","marked":"Má ṣe amọ̀nà fún wa"},{"start":16.96,"end":18.734,"text":"Gba agbo Re lowo ese","marked":"Gba agbo Rẹ lọ́wọ́ ẹ̀ṣẹ̀"},{"start":19.184,"end":20.422,"text":"Wa wa gbat'a sina","marked":"Wá wá gbàt'á ṣìnà"},{"start":20.872,"end":22.389,"text":"Jesu mimo, Jesu mimo)","marked":"Jésù mímọ́, Jésù mímọ́"},{"start":22.839,"end":25.041,"text":"Gbo ti wa, gba t'a mbebe) - 2ce","marked":"Gbọ́ ti wá, gba t'á mbẹ̀bẹ̀"}],"end":25.041},{"key":"3","start":25.991,"lines":[{"start":25.991,"end":27.815,"text":"Wo ti leri lati gba wa","marked":"Wo ti lérí láti gbà wá"},{"start":28.265,"end":29.644,"text":"B'a tile je elese","marked":"B'á tilẹ̀ jẹ́ ẹlẹ́ṣẹ̀"},{"start":30.094,"end":32.051,"text":"Anu, ore agbara Re","marked":"Àánú, ọrẹ agbára Rẹ̀"},{"start":32.501,"end":33.799,"text":"To fun dande elese","marked":"Tó fún dàǹdè ẹlẹ́ṣẹ̀"},{"start":34.249,"end":35.687,"text":"Jesu mimo, Jesu mimo)","marked":"Jésù mímọ́, Jésù mímọ́"},{"start":36.137,"end":37.149,"text":"Je ka tete ro mo o) - 2ce","marked":"Jẹ́ ká tètè rò mọ́ ọ"}],"end":37.149},{"key":"4","start":38.099,"lines":[{"start":38.099,"end":39.54,"text":"Je k'a tete wa oju Re","marked":"Jẹ́ k'á tètè wá ojú Rẹ"},{"start":39.99,"end":41.17,"text":"Je k'a tete se 'fe Re","marked":"Jẹ́ k'á tètè ṣe fẹ́ Rẹ"},{"start":41.62,"end":42.922,"text":"Oluwa at'Olugbala","marked":"Olúwa àt'olùgbàlà"},{"start":43.372,"end":44.71,"text":"Fi 'fe Re kun ok okan wa","marked":"Fi fẹ́ Rẹ kún ọk ọkàn wa"},{"start":45.16,"end":46.689,"text":"Jesu mimo, Jesu mimo)","marked":"Jésù mímọ́, Jésù mímọ́"},{"start":47.139,"end":49.189,"text":"Olufe, ma fe wa si) - 2ce","marked":"Olùfẹ́, má fẹ́ wá sí"},{"start":49.639,"end":50.27,"text":"Amin.","marked":"Àmín."}],"end":50.27}]}