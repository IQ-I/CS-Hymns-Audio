{"v":3,"coll":"y","num":654,"id":"hymn_654","title":"NI'BI ase Igbeyawo","duration":46.293,"voices":{"male":{"file":"y-654-male-v3.m4a","bytes":312916,"sha256":"cfd9128e5aecbb40e2a89a24a80e1e1dd8da6191471082f92d9427b1483ac2db","duration":46.3},"female":{"file":"y-654-female-v3.m4a","bytes":328436,"sha256":"cce536497c59db9715dc738da00ace83169db6f486c7f6412a068e78aad00ed3","duration":46.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.708,"text":"NI'BI ase Igbeyawo","marked":"Ní'bí àṣẹ Ìgbéyàwó"},{"start":2.158,"end":3.241,"text":"Kana ti Galili","marked":"Kana ti Galili"},{"start":3.691,"end":5.029,"text":"Nibe Jesu sise yanu","marked":"Níbẹ̀ Jésù ṣiṣẹ́ yanu"},{"start":5.479,"end":6.977,"text":"O so omi di waini.","marked":"Ó sọ omi di wáìnì."}],"end":6.977},{"key":"2","start":7.927,"lines":[{"start":7.927,"end":9.352,"text":"Jesu wa fi ara re han","marked":"Jésù wá fi ara rẹ̀ hàn"},{"start":9.802,"end":10.855,"text":"Ni bi gbeyawo yi","marked":"Ní bí gbéyàwó yí"},{"start":11.305,"end":12.534,"text":"Ki o si fi ipese Re","marked":"Kí o sì fi ìpèsè Rẹ"},{"start":12.984,"end":14.168,"text":"Fun won lat' ihin lo.","marked":"Fún wọn lát ìhín lọ."}],"end":14.168},{"key":"3","start":15.118,"lines":[{"start":15.118,"end":17.055,"text":"Fun wọn n'ifẹ at'irẹpọ;","marked":"Fún wọn n'ìfẹ́ àt'ìrẹ́pọ̀"},{"start":17.505,"end":18.65,"text":"T'ayé ko le bajẹ;","marked":"T'ayé kò lè bàjẹ́"},{"start":19.1,"end":20.466,"text":"Si jẹ ki wọn fi ọkan wọn,","marked":"Sì jẹ́ kí wọ́n fi ọkàn wọn"},{"start":20.916,"end":22.286,"text":"Fun isẹ isin Rẹ.","marked":"Fún isẹ́ ìsìn Rẹ̀."}],"end":22.286},{"key":"4","start":23.236,"lines":[{"start":23.236,"end":24.504,"text":"Ki wọn ma ran 'ra wọn lọwọ,","marked":"Kí wọn má rán rà wọn lọ́wọ́"},{"start":24.954,"end":26.085,"text":"Nipa ajumọse,","marked":"Nípa àjùmọ̀se"},{"start":26.535,"end":27.926,"text":"Ki Ogo Rẹ si le ma han,","marked":"Kí Ògo Rẹ sì lè má hàn"},{"start":28.376,"end":29.481,"text":"Ni arin ile wọn.","marked":"Ní arin ilé wọn."}],"end":29.481},{"key":"5","start":30.431,"lines":[{"start":30.431,"end":32.244,"text":"A! fi wọn sabẹ isọ Rẹ,","marked":"A! fi wọ́n sábẹ́ ìsọ Rẹ"},{"start":32.694,"end":33.879,"text":"Olupamọ julọ;","marked":"Olùpamọ́ jùlọ"},{"start":34.329,"end":35.405,"text":"Ọlọrun Olodumare","marked":"Ọlọ́run Olódùmarè"},{"start":35.855,"end":37.059,"text":"Fi abo Rẹ bo wọn.","marked":"Fi abo Rẹ bọ̀ wọ́n."}],"end":37.059},{"key":"6","start":38.009,"lines":[{"start":38.009,"end":39.435,"text":"Ogo fun Baba at'Ọmọ,","marked":"Ògo fún Baba àt'Ọmọ"},{"start":39.885,"end":41.044,"text":"Ati f'Ẹmi Mimọ ;","marked":"Àti f'Ẹ̀mí Mímọ́"},{"start":41.494,"end":42.792,"text":"Ogo ni fun Mẹtalọkan,","marked":"Ògo ni fún Mẹ́talọ́kan"},{"start":43.242,"end":44.744,"text":"L'ayé ati l'ọrun.","marked":"L'ayé àti l'ọ̀run."}],"end":44.744}]}