{"v":3,"coll":"y","num":150,"id":"hymn_150","title":"OHUN t'Oluwa yio se","duration":33.502,"voices":{"male":{"file":"y-150-male-v3.m4a","bytes":217727,"sha256":"f0a1f8e26ffcbce4a0de1fb0dbd77b9368d61b089f232504028f10a414616aba","duration":33.6},"female":{"file":"y-150-female-v3.m4a","bytes":221056,"sha256":"62ab8bfb112165c9a091722ff46c45fa91f4d36718a05b2ee2834415f36f9f5c","duration":33.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.71,"text":"OHUN t'Oluwa yio se","marked":"Ohun t'Olúwa yóò ṣe"},{"start":2.16,"end":3.962,"text":"Oba mi ko fi y'enikan.","marked":"Ọba mi kò fi y'ẹnìkan."}],"end":3.962},{"key":"CHORUS","start":4.912,"lines":[{"start":4.912,"end":6.474,"text":"Awon enia pataki lo ti ku","marked":"Àwọn ẹnìà pàtàkì ló ti kú"},{"start":6.924,"end":8.986,"text":"Opo enia pataki lo ti Io o","marked":"Ọ̀pọ̀ ẹnìà pàtàkì ló ti lò ó"},{"start":9.436,"end":10.806,"text":"Eda to ba wa laye,","marked":"Ẹ̀dá tó bá wà láyé"},{"start":11.256,"end":12.734,"text":"Ko wa fi iyin f'onise Nla.","marked":"Kò wá fi ìyìn f'oníṣẹ́ Ńlá."}],"end":12.734},{"key":"2","start":13.684,"lines":[{"start":13.684,"end":14.837,"text":"Ore t'Oluwa ba se","marked":"Ọrẹ t'Olúwa bá ṣe"},{"start":15.287,"end":16.562,"text":"Ara mi jowo fi han o.","marked":"Ara mi jọ̀wọ́ fi hàn ọ́."}],"end":16.562},{"key":"3","start":17.512,"lines":[{"start":17.512,"end":18.714,"text":"Ore t'Oluwa ba se","marked":"Ọrẹ t'Olúwa bá ṣe"},{"start":19.164,"end":20.361,"text":"Ore mi jowo fi han o.","marked":"Ọrẹ mi jọ̀wọ́ fi hàn ọ́."}],"end":20.361},{"key":"4","start":21.311,"lines":[{"start":21.311,"end":22.374,"text":"Omo l'Olorun fun o","marked":"Ọmọ l'Ọlọ́run fún ọ"},{"start":22.824,"end":24.046,"text":"Ore mi jowo fi han o.","marked":"Ọrẹ mi jọ̀wọ́ fi hàn ọ́."}],"end":24.046},{"key":"5","start":24.996,"lines":[{"start":24.996,"end":26.28,"text":"lke l'Olorun fun o","marked":"Ìkẹ́ l'Ọlọ́run fún ọ"},{"start":26.73,"end":27.952,"text":"Ore mi jowo fi han o.","marked":"Ọrẹ mi jọ̀wọ́ fi hàn ọ́."}],"end":27.952},{"key":"6","start":28.902,"lines":[{"start":28.902,"end":29.926,"text":"Ohun t'Oluwa fun o","marked":"Ohun t'Olúwa fún ọ"},{"start":30.376,"end":31.953,"text":"Jowo fi yin Messiah o.","marked":"Jọ̀wọ́ fi yin Messiah ọ́."}],"end":31.953}]}