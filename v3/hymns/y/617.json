{"v":3,"coll":"y","num":617,"id":"hymn_617","title":"JESU, Iwo l'a gbohun si","duration":31.286,"voices":{"male":{"file":"y-617-male-v3.m4a","bytes":211236,"sha256":"47e1b418527f78ef59d1387a655dd917f0078f923167a168d893b3546e5b493d","duration":31.3},"female":{"file":"y-617-female-v3.m4a","bytes":222963,"sha256":"38d58ff989be973b608aaa9b1b395a37614d6ba87cbbcddcb3a65fa54da2abd3","duration":31.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.396,"text":"JESU, Iwọ l'a gbohun si,","marked":"Jésù, Ìwọ l'á gbóhùn sí"},{"start":2.846,"end":3.872,"text":"Mi Ẹmi Mimọ Rẹ,","marked":"Mi Ẹ̀mí Mímọ́ Rẹ"},{"start":4.322,"end":5.66,"text":"Si awọn eniyan wọnyi;","marked":"Sí àwọn ènìyàn wọ̀nyí"},{"start":6.11,"end":7.54,"text":"Baptisi wọn s'iku Rẹ.","marked":"Baptisi wọn s'ikú Rẹ̀."}],"end":7.54},{"key":"2","start":8.49,"lines":[{"start":8.49,"end":9.802,"text":"K'o fi agbara Rẹ fun wọn,","marked":"K'ó fi agbára Rẹ̀ fún wọn"},{"start":10.252,"end":11.563,"text":"Fun wọn l'ọkan titun!","marked":"Fún wọn l'ọkàn titun!"},{"start":12.013,"end":13.263,"text":"Ko'rukọ Rẹ si aya wọn,","marked":"Kò'rúkọ Rẹ̀ sí aya wọn"},{"start":13.713,"end":14.866,"text":"Fi ẹmi Rẹ kun wọn.","marked":"Fi ẹ̀mí Rẹ kún wọn."}],"end":14.866},{"key":"3","start":15.816,"lines":[{"start":15.816,"end":17.132,"text":"Jẹ ki wọn ja bi ajagun;","marked":"Jẹ́ kí wọ́n jà bí ajagun"},{"start":17.582,"end":18.601,"text":"Labẹ ọpagun Rẹ,","marked":"Lábẹ́ ọ̀págun Rẹ"},{"start":19.051,"end":20.457,"text":"Mu wọn f'otitọ d'amure,","marked":"Mú wọn f'òtítọ́ d'àmùrè"},{"start":20.907,"end":21.986,"text":"Ki wọn rin l'ọna Rẹ.","marked":"Kí wọ́n rìn l'ọ̀nà Rẹ."}],"end":21.986},{"key":"4","start":22.936,"lines":[{"start":22.936,"end":24.435,"text":"Oluwa, gbin wa s'iku Rẹ,","marked":"Olúwa, gbìn wá s'ikú Rẹ̀"},{"start":24.885,"end":25.954,"text":"K'a jogun iye Rẹ;","marked":"K'á jogún ìyè Rẹ̀"},{"start":26.404,"end":28.101,"text":"Layé k'a ru agbelebu,","marked":"Layé k'á ru àgbélébùú"},{"start":28.551,"end":29.736,"text":"K'a ni ade ọrun.","marked":"K'á ni adé ọ̀run."}],"end":29.736}]}