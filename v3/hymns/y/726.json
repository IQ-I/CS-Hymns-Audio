{"v":3,"coll":"y","num":726,"id":"hymn_726","title":"OLORUN Metalokan","duration":30.086,"voices":{"male":{"file":"y-726-male-v3.m4a","bytes":204810,"sha256":"d2d70e992ad90f68bc97c6acd4cbe6d291a3e5012f72a8ecbd6f24720c365e0d","duration":30.1},"female":{"file":"y-726-female-v3.m4a","bytes":208954,"sha256":"f1f7ebb1e42bdeacfbf88cc18897fd2beb2d5110cc8c530c1607c02211e5850d","duration":30.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.387,"text":"OLORUN Metalokan","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":1.837,"end":3.331,"text":"Oba ile at'okun","marked":"Ọba ilẹ̀ àt'òkun"},{"start":3.781,"end":5.174,"text":"Gbo ti wa bi a nko","marked":"Gbọ́ ti wá bí a ńkọ́"},{"start":5.624,"end":6.405,"text":"Orin iyin Re.","marked":"Orin ìyìn Rẹ̀."}],"end":6.405},{"key":"2","start":7.355,"lines":[{"start":7.355,"end":8.523,"text":"Wo imole l'owuro","marked":"Wo ìmọ́lẹ̀ l'òwúrọ̀"},{"start":8.973,"end":10.144,"text":"Tan 'mole Re yi wa ka","marked":"Tan mọ́lẹ̀ Rẹ̀ yí wa ká"},{"start":10.594,"end":11.724,"text":"Jeki ebun rere Re","marked":"Jẹ́kí ẹ̀bùn rere Rẹ"},{"start":12.174,"end":13.219,"text":"M'aya wa bale.","marked":"M'àyà wá balẹ̀."}],"end":13.219},{"key":"3","start":14.169,"lines":[{"start":14.169,"end":15.83,"text":"Wo 'mole nigb'orun wo","marked":"Wò mọ́lẹ̀ nígb'ọ̀run wo"},{"start":16.28,"end":17.74,"text":"K'a ri idariji gba","marked":"K'á rí ìdáríjì gbà"},{"start":18.19,"end":19.51,"text":"Ki alafia orun","marked":"Kí àlàáfíà ọ̀run"},{"start":19.96,"end":21.148,"text":"F'itura fun wa.","marked":"F'ìtura fún wa."}],"end":21.148},{"key":"4","start":22.098,"lines":[{"start":22.098,"end":23.203,"text":"Olorun Metalokan","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":23.653,"end":25.225,"text":"lsin wa l'aye ko to","marked":"Ìsìn wà l'ayé kò tó"},{"start":25.675,"end":26.977,"text":"A nreti lati dapo","marked":"A ńretí láti dàpọ̀"},{"start":27.427,"end":28.536,"text":"Mo awon t'orun.","marked":"Mọ àwọn t'ọ̀run."}],"end":28.536}]}