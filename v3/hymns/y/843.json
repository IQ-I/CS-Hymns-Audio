{"v":3,"coll":"y","num":843,"id":"hymn_843","title":"OLORUN Olodumare","duration":65.556,"voices":{"male":{"file":"y-843-male-v3.m4a","bytes":457447,"sha256":"b50c935f4f6fde5d88af1629c4774400901d1a8e06b4eb1b3928deba672d2fbe","duration":65.6},"female":{"file":"y-843-female-v3.m4a","bytes":472141,"sha256":"16b5143ac4cfbffdcbaf10ed32c37777c272fd9bb4d446da3d793295c5237c17","duration":65.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.351,"text":"ỌLỌRUN Olodumare,","marked":"Ọlọ́run Olódùmarè"},{"start":1.801,"end":3.696,"text":"'Wọ n'iyin oun ọpẹ yẹ fun;","marked":"'Wọ n'ìyìn òun ọpẹ́ yẹ fún"},{"start":4.146,"end":5.656,"text":"'Wọ ti n gbe arin Kérúbù;","marked":"'Wọ tí ń gbé arin Kérúbù"},{"start":6.106,"end":7.624,"text":"Ran 'tansan ifẹ Rẹ si wa,","marked":"Rán tànṣán ìfẹ́ Rẹ sí wa"}],"end":7.624},{"key":"CHORUS","start":8.574,"lines":[{"start":8.574,"end":10.208,"text":"Ogo, Ogo, f'Oba Olore","marked":"Ògo, Ògo, f'Ọba Ọlọ́rẹ́"},{"start":10.658,"end":11.836,"text":"Iyin Re duro lailai.","marked":"Ìyìn Rẹ̀ dúró láéláé."}],"end":11.836},{"key":"2","start":12.786,"lines":[{"start":12.786,"end":14.355,"text":"Ọlọrun Mose Orimọlade,","marked":"Ọlọ́run Mósè Orímọ́ládé"},{"start":14.805,"end":16.154,"text":"A dupẹ fun Iranlọwọ Rẹ;","marked":"A dúpẹ́ fún Ìrànlọ́wọ́ Rẹ"},{"start":16.604,"end":18.384,"text":"T'o f'idi Ẹgbẹ Séráfù sọlẹ,","marked":"T'ó f'ìdí Ẹgbẹ́ Séráfù sọlẹ̀"},{"start":18.834,"end":20.197,"text":"Lori apata l'ayé.","marked":"Lórí àpáta l'ayé."}],"end":20.197},{"key":"3","start":21.147,"lines":[{"start":21.147,"end":22.626,"text":"Gba 'yọnu de b'awọsanma,","marked":"Gba 'yọnu dé b'àwọsánmà"},{"start":23.076,"end":25.103,"text":"T'o su dudu t'o n san ara,","marked":"T'ó ṣú dúdú t'ó ń san ara"},{"start":25.553,"end":26.911,"text":"O duro ti wa larin rẹ,","marked":"Ó dúró ti wá lárin rẹ̀"},{"start":27.361,"end":28.949,"text":"O si mu wa bori dandan.","marked":"Ó sì mú wa borí dandan."}],"end":28.949},{"key":"4","start":29.899,"lines":[{"start":29.899,"end":31.205,"text":"Ogun ọta dide si wa,","marked":"Ogun ọ̀tá dìde sí wa"},{"start":31.655,"end":33.33,"text":"Ayé oun esu n dena wa,","marked":"Ayé òun èṣù ń dènà wá"},{"start":33.78,"end":35.236,"text":"O mu wa la gbogbo rẹ kọja,","marked":"Ó mú wa la gbogbo rẹ̀ kọjá"},{"start":35.686,"end":37.118,"text":"Ogo, iyin f'Orukọ Rẹ.","marked":"Ògo, ìyìn f'Orúkọ Rẹ."}],"end":37.118},{"key":"5","start":38.068,"lines":[{"start":38.068,"end":40.172,"text":"Ọbangiji, Alaranse Ẹda,","marked":"Ọbangijì, Aláránṣẹ́ Ẹ̀dá"},{"start":40.622,"end":42.243,"text":"Pa wa mọ ninu igbi ayé,","marked":"Pa wá mọ́ nínú ìgbì ayé"},{"start":42.693,"end":45.181,"text":"K'alafia, ipese, ibukun,","marked":"K'àlàáfíà, ìpèsè, ìbùkún"},{"start":45.631,"end":47.105,"text":"Jẹ tiwa l'ọjọ ayé wa.","marked":"Jẹ́ tiwa l'ọjọ́ ayé wa."}],"end":47.105},{"key":"6","start":48.055,"lines":[{"start":48.055,"end":49.856,"text":"JAH-JEHOFA NISSI Ọba wa,","marked":"Jah-jehofa Nissi Ọba wa"},{"start":50.306,"end":51.599,"text":"Iwọ ni Ọba Olusẹgun;","marked":"Ìwọ ni Ọba Olùsẹ̀gùn"},{"start":52.049,"end":53.802,"text":"Masai f'isegun fun Alagba wa,","marked":"Masai f'ìṣẹ́gun fún Alàgbà wa"},{"start":54.252,"end":55.663,"text":"Baba Aladura wa.","marked":"Baba Aládúrà wa."}],"end":55.663},{"key":"7","start":56.613,"lines":[{"start":56.613,"end":58.242,"text":"Ọlọrun Mose Orimolade,","marked":"Ọlọ́run Mósè Orímọ́ládé"},{"start":58.692,"end":60.236,"text":"Gba iyin oun ọpẹ wa;","marked":"Gba ìyìn òun ọpẹ́ wa"},{"start":60.686,"end":62.284,"text":"Ka le yọ titi niwaju Rẹ,","marked":"Ká lè yọ̀ títí níwájú Rẹ"},{"start":62.734,"end":64.007,"text":"L'oke orun nikẹhin.","marked":"L'òkè ọ̀run níkẹhìn."}],"end":64.007}]}