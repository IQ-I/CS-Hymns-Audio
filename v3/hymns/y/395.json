{"v":3,"coll":"y","num":395,"id":"hymn_395","title":"BABA orun jinle 'fe Re","duration":37.232,"voices":{"male":{"file":"y-395-male-v3.m4a","bytes":261748,"sha256":"d3d3d920e7fa9ff1591808187c3549caf25451b7bf766e317e16b8c7b39d5aa6","duration":37.3},"female":{"file":"y-395-female-v3.m4a","bytes":266500,"sha256":"e489f17fa3aee28813cfab299d0ebd2ddcd6342b250cdba582d9667ca39450cc","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.831,"text":"BABA ọrun 'jinlẹ 'fẹ Rẹ,","marked":"Baba ọ̀run 'jinlẹ 'fẹ Rẹ"},{"start":2.281,"end":3.919,"text":"L'o wa Oludande fun wa;","marked":"L'ó wá Olùdáǹdè fún wa"},{"start":4.369,"end":5.683,"text":"A wolẹ niwaju 'tẹ Rẹ,","marked":"A wólẹ̀ níwájú 'tẹ Rẹ"},{"start":6.133,"end":7.724,"text":"Na'wọ 'dariji Rẹ si wa.","marked":"Nà'wọ dáríjì Rẹ̀ sí wa."}],"end":7.724},{"key":"2","start":8.674,"lines":[{"start":8.674,"end":10.809,"text":"Ọmọ Baba, t'O d'Eniyan,","marked":"Ọmọ Baba, t'Ó d'Ènìyàn"},{"start":11.259,"end":12.583,"text":"Woli, Alufa, Oluwa,","marked":"Wòlí, Àlùfá, Olúwa"},{"start":13.033,"end":14.529,"text":"p A wolẹ niwaju 'tẹ Rẹ;","marked":"p A wólẹ̀ níwájú 'tẹ Rẹ"},{"start":14.979,"end":16.189,"text":"Na'wọ igbala Rẹ si wa.","marked":"Nà'wọ ìgbàlà Rẹ sì wà."}],"end":16.189},{"key":"3","start":17.139,"lines":[{"start":17.139,"end":19.28,"text":"Ẹmi at'ayérayé lai,","marked":"Ẹ̀mí at'ayérayé láì"},{"start":19.73,"end":21.613,"text":"Ẹmi ti n ji oku dide,","marked":"Ẹ̀mí ti ń jí òkú dìde"},{"start":22.063,"end":23.535,"text":"A wolẹ niwaju 'tẹ Rẹ,","marked":"A wólẹ̀ níwájú 'tẹ Rẹ"},{"start":23.985,"end":25.401,"text":"Na'wọ isọji Rẹ si wa.","marked":"Nà'wọ ìsọjí Rẹ sì wà."}],"end":25.401},{"key":"4","start":26.351,"lines":[{"start":26.351,"end":29.673,"text":"Jehovah, Baba, Ọmọ, Ẹmi,","marked":"Jehovah, Baba, Ọmọ, Ẹ̀mí"},{"start":30.123,"end":31.69,"text":"'Yanu 'jinlẹ Mẹtalọkan,","marked":"yanu 'jinlẹ Mẹ́talọ́kan"},{"start":32.14,"end":33.652,"text":"A wolẹ niwaju 'tẹ Rẹ,","marked":"A wólẹ̀ níwájú 'tẹ Rẹ"},{"start":34.102,"end":35.683,"text":"Nawo emi 'ye Rẹ si wa.","marked":"Náwó èmi yè Rẹ sí wa."}],"end":35.683}]}