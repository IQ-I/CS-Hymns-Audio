{"v":3,"coll":"y","num":374,"id":"hymn_374","title":"SO itan kan naa fun mi","duration":45.481,"voices":{"male":{"file":"y-374-male-v3.m4a","bytes":325871,"sha256":"d3254525987cd925eb871b161a9cd8bd172b14ce1b213dc47e36fd7c97ededf0","duration":45.5},"female":{"file":"y-374-female-v3.m4a","bytes":336869,"sha256":"640336f0e732da6e44156243be97d197a7f70878635d36814d15af7f8c0a63a9","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.696,"text":"SỌ itan kan naa fun mi,","marked":"Sọ ìtàn kan náà fún mi"},{"start":2.146,"end":3.136,"text":"T'ohun ti mbẹ lọrun;","marked":"T'ohun tí mbẹ lọ́rùn"},{"start":3.586,"end":5.18,"text":"Ti Jesu oun Ogo Rẹ,","marked":"Ti Jésù òun Ògo Rẹ̀"},{"start":5.63,"end":7.011,"text":"Ti Jesu oun 'Fẹ Rẹ.","marked":"Tí Jésù òun 'Fẹ Rẹ."},{"start":7.461,"end":8.847,"text":"Sọ 'tan naa ye mi daju,","marked":"Sọ tán náà yé mi dájú"},{"start":9.297,"end":10.626,"text":"B'o ba ti so f'ewe,","marked":"B'ó bá ti sọ f'èwe"},{"start":11.076,"end":12.56,"text":"Nitori emi ko l'okun,","marked":"Nítorí èmi kò l'okùn"},{"start":13.01,"end":14.289,"text":"Mo si jẹ ẹlẹsẹ.","marked":"Mo sì jẹ́ ẹlẹ́sẹ̀."}],"end":14.289},{"key":"2","start":15.239,"lines":[{"start":15.239,"end":16.556,"text":"Sọ 'tan naa fun mi pẹlẹ,","marked":"Sọ tán náà fún mi pẹ̀lẹ́"},{"start":17.006,"end":18.089,"text":"Ki o ba le ye mi;","marked":"Kí ó bá lè yé mi"},{"start":18.539,"end":19.95,"text":"Ti Iyanu Irapada;","marked":"Ti Ìyanu Ìràpadà"},{"start":20.4,"end":21.576,"text":"T'etutu fun ẹsẹ.","marked":"T'ètùtù fún ẹsẹ̀."},{"start":22.026,"end":23.216,"text":"Sọ fun mi nigba gbogbo,","marked":"Sọ fún mi nígbà gbogbo"},{"start":23.666,"end":25.211,"text":"Nitori n ko fẹ gbagbe,","marked":"Nítorí n kò fẹ́ gbàgbé"},{"start":25.661,"end":27.289,"text":"Ero mi si n fẹ la ti gbọ,","marked":"Èrò mi sì ń fẹ́ la ti gbọ́"},{"start":27.739,"end":28.853,"text":"Orin adidun na.","marked":"Orin àdídùn ná."}],"end":28.853},{"key":"3","start":29.803,"lines":[{"start":29.803,"end":31.342,"text":"Sọ itan kan naa fun mi,","marked":"Sọ ìtàn kan náà fún mi"},{"start":31.792,"end":32.945,"text":"N'igba t'O ba ri pe,","marked":"N'ìgbà t'Ó bá rí pé"},{"start":33.395,"end":34.441,"text":"Ogo asan ayé yi,","marked":"Ògo asán ayé yí"},{"start":34.891,"end":36.196,"text":"Fẹ gba mi ni ọkan.","marked":"Fẹ́ gbà mí ní ọkàn."},{"start":36.646,"end":38.229,"text":"Gba t'Ogo oke ọrun,","marked":"Gba t'Ògo òkè ọ̀run"},{"start":38.679,"end":40.227,"text":"Ba si ń fara han mi,","marked":"Bá sì ń fara hàn mí"},{"start":40.677,"end":42.257,"text":"Sọ 'tan kan naa fun mi pe,","marked":"Sọ tán kan náà fún mi pé"},{"start":42.707,"end":43.932,"text":"Krist' mu ọ larada.","marked":"Krist mú ọ láradá."}],"end":43.932}]}