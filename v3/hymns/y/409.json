{"v":3,"coll":"y","num":409,"id":"hymn_409","title":"NINU gbogbo iji ti ń ja","duration":42.638,"voices":{"male":{"file":"y-409-male-v3.m4a","bytes":301426,"sha256":"6d7197ab22ef9bf0a5a25aa27da7f63a94169f5b099bd0aab5f0ff5a36b17c11","duration":42.7},"female":{"file":"y-409-female-v3.m4a","bytes":312333,"sha256":"8bd4f3e273929e419950b438d1d4717339637f9033895557d959b8ea12465923","duration":42.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.968,"text":"NINU gbogbo iji ti ń ja","marked":"Nínú gbogbo ìjì tí ń jà"},{"start":2.418,"end":3.566,"text":"Ninu gbogbo igbi 'pọnju,","marked":"Nínú gbogbo ìgbì 'pọnju"},{"start":4.016,"end":5.522,"text":"Abo kan mbẹ ti o daju,","marked":"Abo kan mbẹ́ tí ó dájú"},{"start":5.972,"end":7.276,"text":"O wa labẹ itẹ-anu,","marked":"Ó wà lábẹ́ itẹ-anu"}],"end":7.276},{"key":"2","start":8.226,"lines":[{"start":8.226,"end":10.163,"text":"Ibi kan wa ti Jesu n da,","marked":"Ibi kan wà tí Jésù ń dá"},{"start":10.613,"end":11.707,"text":"Ororo ayọ sori wa,","marked":"Òróró ayọ̀ sórí wa"},{"start":12.157,"end":13.72,"text":"O dun ju ibi gbogbo lọ,","marked":"Ó dùn ju ibi gbogbo lọ"},{"start":14.17,"end":15.522,"text":"Itẹ anu t'a f'ẹjẹ wọn.","marked":"Ìtẹ́ àánú t'á f'ẹ̀jẹ̀ wọn."}],"end":15.522},{"key":"3","start":16.472,"lines":[{"start":16.472,"end":17.763,"text":"Ibi kan wa fun idapọ,","marked":"Ibi kan wà fún ìdàpọ̀"},{"start":18.213,"end":19.457,"text":"Nibi ọrẹ n pade ọrẹ,","marked":"Níbi ọ̀rẹ́ ń pàdé ọ̀rẹ́"},{"start":19.907,"end":21.422,"text":"Lairi 'ra nipa igbagbọ,","marked":"Láìrí rà nípa ìgbàgbọ́"},{"start":21.872,"end":23.642,"text":"Wọn y'itẹ-anu kan naa ka.","marked":"Wọ́n y'itẹ-anu kan náà ká."}],"end":23.642},{"key":"4","start":24.592,"lines":[{"start":24.592,"end":26.301,"text":"A! nibo ni a ba sa si","marked":"A! níbo ni a bá sá sí"},{"start":26.751,"end":28.222,"text":"Nigba 'danwo at'iponju?","marked":"Nígbà dánwò àt'ìpọ́njú?"},{"start":28.672,"end":30.085,"text":"A ba se le bori esu,","marked":"A bá ṣe lè borí èṣù"},{"start":30.535,"end":32.622,"text":"B'o se pe ko si 'te-anu.","marked":"B'ó ṣe pé kò sì te-anu."}],"end":32.622},{"key":"5","start":33.572,"lines":[{"start":33.572,"end":35.615,"text":"A! bi idi l'a fo sibẹ,","marked":"A! bí ìdí l'á fọ́ síbẹ̀"},{"start":36.065,"end":37.481,"text":"B'ẹni pe ayé ko si mọ;","marked":"B'ẹni pé ayé kò sì mọ́"},{"start":37.931,"end":39.25,"text":"Ọrun wa pade ọkan wa.","marked":"Ọ̀run wá pàdé ọkàn wa."},{"start":39.7,"end":41.088,"text":"Ogo si bo itẹ-anu.","marked":"Ògo sì bo itẹ-anu."}],"end":41.088}]}