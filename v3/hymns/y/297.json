{"v":3,"coll":"y","num":297,"id":"hymn_297","title":"Wo Ọdaguntan ti o ru","duration":33.85,"voices":{"male":{"file":"y-297-male-v3.m4a","bytes":232480,"sha256":"7c0e5b5b91ae34256f8a88947eb30bf8bed2cc6fef355835afb073dfdea2411f","duration":33.9},"female":{"file":"y-297-female-v3.m4a","bytes":242718,"sha256":"6196f8c706ad84c73f837c41de77e4a0bf4d304154abba205b609061d0aaebcb","duration":33.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.983,"text":"Wo Ọdaguntan ti o ru,","marked":"Wo Ọ̀dàgùntàn tí ó rú"},{"start":2.433,"end":3.825,"text":"Ẹru rẹ lor'igi;","marked":"Ẹ̀rù rẹ̀ lór'igi"},{"start":4.275,"end":5.661,"text":"O ku lati da igbekun,","marked":"Ó kú láti dá ìgbèkùn"},{"start":6.111,"end":7.352,"text":"O t'ẹjẹ Rẹ fun ọ.","marked":"Ó t'ẹ̀jẹ̀ Rẹ̀ fún ọ."}],"end":7.352},{"key":"2","start":8.302,"lines":[{"start":8.302,"end":10.081,"text":"W'Olugbala, tit' iran na,","marked":"W'Olùgbàlà, tít ìran ná"},{"start":10.531,"end":11.854,"text":"Y'o fi fa ọkan rẹ;","marked":"Y'ó fi fa ọkàn rẹ"},{"start":12.304,"end":13.896,"text":"Fi omije orin ẹsẹ Rẹ,","marked":"Fi omijé orin ẹsẹ̀ Rẹ"},{"start":14.346,"end":15.653,"text":"Ma kuro lọdọ Rẹ.","marked":"Má kúrò lọ́dọ̀ Rẹ."}],"end":15.653},{"key":"3","start":16.603,"lines":[{"start":16.603,"end":18.902,"text":"Wo, titi ifẹ yoo fi,","marked":"Wò, títí ìfẹ́ yóò fi"},{"start":19.352,"end":20.502,"text":"Jọba lor'ọkan rẹ;","marked":"Jọba lór'ọkàn rẹ"},{"start":20.952,"end":22.804,"text":"Tit' agbara Rẹ y'o fi han,","marked":"Tít agbára Rẹ y'ó fi hàn"},{"start":23.254,"end":24.622,"text":"Lor' ara oun emi.","marked":"Lọ́r ara òun ẹ̀mí."}],"end":24.622},{"key":"4","start":25.572,"lines":[{"start":25.572,"end":27.215,"text":"Wo, b'iwọ ti n sare ije,","marked":"Wò, b'ìwọ ti ń sáré ìje"},{"start":27.665,"end":28.483,"text":"Ọrẹ rẹ titi;","marked":"Ọrẹ rẹ̀ títí"},{"start":28.933,"end":30.388,"text":"Y'o pari 'sẹ Re t'O bere,","marked":"Y'ó parí 'sẹ Rẹ̀ t'Ó bẹ̀rẹ̀"},{"start":30.838,"end":32.3,"text":"Or'ọfẹ y'o j'ogo.","marked":"Or'ọ̀fẹ́ y'ó j'ògo."}],"end":32.3}]}