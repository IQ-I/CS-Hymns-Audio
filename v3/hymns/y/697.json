{"v":3,"coll":"y","num":697,"id":"hymn_697","title":"NIHIN l'oruko Re Oluwa","duration":52.051,"voices":{"male":{"file":"y-697-male-v3.m4a","bytes":367784,"sha256":"59812ab090cb546d7d51798033accc29c85535338701faa4f1785cbc49204082","duration":52.1},"female":{"file":"y-697-female-v3.m4a","bytes":380385,"sha256":"fcd6c126adc832bb358c727f53c6546bf8f2415ad689f99a7db41bae03e7457f","duration":52.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.839,"text":"NIHIN l'Orukọ Rẹ Oluwa,","marked":"Níhìn l'Orúkọ Rẹ Olúwa"},{"start":2.289,"end":3.977,"text":"A kọ ile 'rupẹ yi fun Ọ,","marked":"A kọ́ ilé 'rupẹ yí fún Ọ"},{"start":4.427,"end":5.935,"text":"Yan fun 'bugbe Rẹ Pataki,","marked":"Yàn fún bùgbé Rẹ Pàtàkì"},{"start":6.385,"end":7.902,"text":"K'o si sọ lọwọ 'ja esu.","marked":"K'ó sì sọ lọ́wọ́ já èṣù."}],"end":7.902},{"key":"2","start":8.852,"lines":[{"start":8.852,"end":10.569,"text":"Gba t'a ba n gbadura nihin,","marked":"Gba t'á bá ń gbàdúrà níhìn"},{"start":11.019,"end":12.541,"text":"T'ẹlẹsẹ n bẹbẹ fun IYE,","marked":"T'ẹ́lẹsẹ̀ ń bẹ̀bẹ̀ fún Ìyè"},{"start":12.991,"end":14.159,"text":"Gbọ lati 'bugbe Rẹ Ọrun,","marked":"Gbọ́ láti bùgbé Rẹ Ọ̀run"},{"start":14.609,"end":16.431,"text":"Gba t'o ba gbọ k'o dariji.","marked":"Gba t'ó bá gbọ́ k'ó dáríjì."}],"end":16.431},{"key":"3","start":17.381,"lines":[{"start":17.381,"end":18.882,"text":"Gba t'a n wasu Rẹ nihin,","marked":"Gba t'á ń wàṣù Rẹ níhìn"},{"start":19.332,"end":20.561,"text":"Ninu Ile Mimọ Rẹ yi,","marked":"Nínú Ilé Mímọ́ Rẹ yí"},{"start":21.011,"end":22.575,"text":"Nip' agbara Oke nla Rẹ,","marked":"Níp agbára Òkè ńlá Rẹ"},{"start":23.025,"end":24.401,"text":"K'isẹ 'yanu Rẹ farahan.","marked":"K'ísẹ yanu Rẹ̀ farahàn."}],"end":24.401},{"key":"4","start":25.351,"lines":[{"start":25.351,"end":26.93,"text":"Gba t'awọn ewe ba n kọrin,","marked":"Gba t'àwọn èwe bá ń kọrin"},{"start":27.38,"end":28.838,"text":"Hosanna si Ọba wa loke,","marked":"Hosanna sí Ọba wa lókè"},{"start":29.288,"end":31.164,"text":"Ki ogo Rẹ kun ile yi,","marked":"Kí ògo Rẹ kún ilẹ̀ yí"},{"start":31.614,"end":33.253,"text":"K'Angeli ba wọn kọrin na.","marked":"K'Áńgẹ́lì bá wọn kọrin ná."}],"end":33.253},{"key":"5","start":34.203,"lines":[{"start":34.203,"end":35.758,"text":"K'ogo Rẹ ma gbe ile yi,","marked":"K'ògo Rẹ má gbé ilẹ̀ yí"},{"start":36.208,"end":37.493,"text":"Yan ni ile patapata,","marked":"Yàn ní ilẹ̀ pátápátá"},{"start":37.943,"end":39.387,"text":"Tẹ itẹ Rẹ sinu 'le yi,","marked":"Tẹ ìtẹ́ Rẹ sínú lè yí"},{"start":39.837,"end":41.538,"text":"Ma jẹ ki esu le wo bẹ.","marked":"Má jẹ́ kí èṣù lè wò bẹ̀."}],"end":41.538},{"key":"6","start":42.488,"lines":[{"start":42.488,"end":44.615,"text":"Jah Jehofa, Oba Mimo","marked":"Jah Jèhófà, Ọba Mímọ́"},{"start":45.065,"end":46.526,"text":"Sokale sinu okan wa","marked":"Sọ̀kalẹ̀ sínú ọkàn wa"},{"start":46.976,"end":48.451,"text":"Ma ba wa gbe inu ile wa","marked":"Má bá wa gbé inú ilé wa"},{"start":48.901,"end":50.502,"text":"Mase fi wa sile lailai.","marked":"Máṣe fi wá sílẹ̀ láéláé."}],"end":50.502}]}