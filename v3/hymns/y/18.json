{"v":3,"coll":"y","num":18,"id":"hymn_18","title":"IWO imole okan mi","duration":50.675,"voices":{"male":{"file":"y-18-male.m4a","bytes":364312,"sha256":"2aa3e6909cfcbbd20fce64b91ce0991c34d865cc0cd5bd32fb3c863ab71b4d77","duration":50.7},"female":{"file":"y-18-female.m4a","bytes":373837,"sha256":"bada4a8b653092adc90b1f7644a9c37cad5da37b2dc05029b2475e68f8053ebd","duration":50.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.619,"text":"IWO imole okan mi,","marked":"Ìwọ ìmọ́lẹ̀̀ ọkàn mi"},{"start":1.999,"end":3.732,"text":"Li odo Re oru ko si","marked":"Lí ọ̀dọ̀ Rẹ òru kò sí"},{"start":4.112,"end":5.592,"text":"Ki kuku aiye ma bo o,","marked":"Kí kúkú aiye má bò ó"},{"start":5.972,"end":7.35,"text":"Kuro I'oju iranse Re.","marked":"Kúrò l'ojú ìránṣẹ́ Rẹ."}],"end":7.35},{"key":"2","start":8.3,"lines":[{"start":8.3,"end":9.696,"text":"Nigba t'orun ale didun","marked":"Nígbà t'ọrun alẹ́ dídùn"},{"start":10.076,"end":11.531,"text":"Ba npa ipenpeju mi de","marked":"Bá ńpa ìpéǹpéjú mi dé"},{"start":11.911,"end":13.356,"text":"K'ero mi je lati simi","marked":"K'èrò mi jẹ́ láti simi"},{"start":13.736,"end":15.241,"text":"Lai l'aiya Olugbala mi.","marked":"Lai l'áíyá Olùgbàlà mi."}],"end":15.241},{"key":"3","start":16.191,"lines":[{"start":16.191,"end":17.486,"text":"Ba mi gbe l'oro tit'ale","marked":"Bá mi gbé l'ọ̀rọ̀ tit'ale"},{"start":17.866,"end":19.467,"text":"Laisi Re emi ko le wa,","marked":"Láìsí Rẹ èmi kò lè wá"},{"start":19.847,"end":21.505,"text":"Ba mi gbe gbat'ile ba nsu","marked":"Bá mi gbé gbat'ilẹ̀ bá ńsú"},{"start":21.885,"end":23.891,"text":"Laisi Re, emi ko le ku","marked":"Láìsí Rẹ, èmi kò lè kú"}],"end":23.891},{"key":"4","start":24.841,"lines":[{"start":24.841,"end":26.235,"text":"Bi otosi omo Re kan,","marked":"Bí òtòṣì ọmọ Rẹ kan"},{"start":26.615,"end":27.894,"text":"Ba tapa s'oro Re loni","marked":"Bá tàpá s'ọ̀rọ̀ Rẹ lónì"},{"start":28.274,"end":30.021,"text":"Oluwa, sise oro Re","marked":"Olúwa, ṣíṣe ọ̀rọ̀ Rẹ"},{"start":30.401,"end":32.085,"text":"Ma jek'o sun ninu ese","marked":"Má jẹ́k'ó sùn nínú ẹsẹ̀"}],"end":32.085},{"key":"5","start":33.035,"lines":[{"start":33.035,"end":34.186,"text":"Bukun fun awon alaisan","marked":"Bùkún fún àwọn aláìsàn"},{"start":34.566,"end":35.708,"text":"Pese fun awon talaka","marked":"Pèsè fún àwọn tálákà"},{"start":36.088,"end":37.788,"text":"K'orun alawe l'ale yi","marked":"K'ọrùn aláwẹ́ l'álẹ̀ yí"},{"start":38.168,"end":39.665,"text":"Dabi orun omo titun.","marked":"Dábì ọrùn ọmọ titun."}],"end":39.665},{"key":"6","start":40.615,"lines":[{"start":40.615,"end":42.406,"text":"Sure fun wa nighat' aji,","marked":"Súre fún wa nighat' àjì"},{"start":42.786,"end":44.48,"text":"K'a to m'ohun aiye yi se,","marked":"K'á tó m'ohun aiye yí ṣe"},{"start":44.86,"end":46.164,"text":"Titi awa o de bite","marked":"Títí àwa ò dé bìtẹ̀"},{"start":46.544,"end":48.189,"text":"T'a o si de ijoba Re.","marked":"T'á ò sì dé ìjọba Rẹ̀."},{"start":48.569,"end":49.125,"text":"Amin.","marked":"Àmín."}],"end":49.125}]}