{"v":3,"coll":"y","num":624,"id":"hymn_624","title":"MO gb'ohun Re ninu ala mi","duration":50.178,"voices":{"male":{"file":"y-624-male-v3.m4a","bytes":357054,"sha256":"6e30a5e61c7350d39b42f6f8377e63f7f5e6f47e3b0d0f712bde11e2b0bd0153","duration":50.2},"female":{"file":"y-624-female-v3.m4a","bytes":368562,"sha256":"898cc98be97930658f9fa3ad98719365ca6488269306a52bc95918210751e1cb","duration":50.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.866,"text":"MO gb'ohun Re ninu ala mi","marked":"Mo gb'ohùn Rẹ nínú àlá mi"},{"start":2.316,"end":3.24,"text":"Ohun kelekele","marked":"Ohun kẹ́lẹ́kẹ́lẹ́"},{"start":3.69,"end":5.149,"text":"Ohun ti nso 'fe t'Oluwa","marked":"Ohun tí ńṣọ́ fẹ́ t'Olúwa"},{"start":5.599,"end":6.609,"text":"Ife irapada","marked":"Ìfẹ́ ìràpadà"},{"start":7.059,"end":9.352,"text":"Mo te'ti lele lati gbo","marked":"Mo tẹ̀'tí lélẹ̀ láti gbọ́"},{"start":9.802,"end":10.876,"text":"O si ya mi lenu.","marked":"Ó sì yà mí lẹ́nu."},{"start":11.326,"end":12.637,"text":"Jo jeki nroju Re.","marked":"Jọ jẹ́kí ńrọjú Rẹ."}],"end":12.637},{"key":"CHORUS","start":13.587,"lines":[{"start":13.587,"end":14.671,"text":"Jo jeki nroju Re - 2ce","marked":"Jọ jẹ́kí ńrojú Rẹ"},{"start":15.121,"end":17.066,"text":"Bi mo ti te 'ti le le to","marked":"Bí mo ti tẹ́ tí lè lè tó"},{"start":17.516,"end":18.822,"text":"Jo jeki nroju re.","marked":"Jọ jẹ́kí ńrọjú rẹ̀."}],"end":18.822},{"key":"2","start":19.772,"lines":[{"start":19.772,"end":20.908,"text":"Ninu wahala aiye mi","marked":"Nínú wàhálà ayé mi"},{"start":21.358,"end":22.747,"text":"Mo ba Jesu pade","marked":"Mo bá Jésù pàdé"},{"start":23.197,"end":24.583,"text":"Ti O si gba mi niyanju","marked":"Tí Ó sì gbà mí níyànjú"},{"start":25.033,"end":26.275,"text":"Lati ma gbadura","marked":"Láti má gbàdúrà"},{"start":26.725,"end":28.481,"text":"Mo te'ti le le lati gbo","marked":"Mo tẹ̀'tí lè lé láti gbọ́"},{"start":28.931,"end":30.084,"text":"O si mu 'nu mi dun","marked":"Ó sì mú nù mi dùn"},{"start":30.534,"end":32.168,"text":"O si tun ki mi l'aiya pe","marked":"Ó sì tún kí mi l'àìyá pé"},{"start":32.618,"end":34.033,"text":"Ki nsa ma gba adura.","marked":"Kí ńsá má gba àdúrà."}],"end":34.033},{"key":"3","start":34.983,"lines":[{"start":34.983,"end":36.27,"text":"Olodumare jo gba wa","marked":"Olódùmarè jọ gbà wá"},{"start":36.72,"end":37.9,"text":"Awa Egbe Serafu","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":38.35,"end":39.735,"text":"Nigbati wahala ba de","marked":"Nígbàtí wàhálà bá dé"},{"start":40.185,"end":41.333,"text":"Jo gbo adura wa","marked":"Jọ gbọ́ àdúrà wa"},{"start":41.783,"end":43.224,"text":"Ran awon Kerubu si wa","marked":"Rán àwọn Kérúbù sí wa"},{"start":43.674,"end":44.906,"text":"Lati ran wa lowo","marked":"Láti ràn wá lọ́wọ́"},{"start":45.356,"end":46.937,"text":"Ki O si te 'ti si igbe wa","marked":"Kí Ó sì tẹ́ ti sí igbe wa"},{"start":47.387,"end":48.629,"text":"K'O gbo adura wa.","marked":"K'Ó gbọ́ àdúrà wa."}],"end":48.629}]}