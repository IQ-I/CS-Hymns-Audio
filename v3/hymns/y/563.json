{"v":3,"coll":"y","num":563,"id":"hymn_563","title":"NGO se foiya ojo ibi?","duration":41.862,"voices":{"male":{"file":"y-563-male-v3.m4a","bytes":293475,"sha256":"73d0b31715aec9d7248706a27ad0e780ea8674c894eeb9e87e43e946bae795e6","duration":41.9},"female":{"file":"y-563-female-v3.m4a","bytes":303429,"sha256":"860fc857784eebeef57e01c0d65789d310a8331d1dffe38e69e7547c54b51516","duration":41.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.777,"text":"NGO se foiya ojo ibi?","marked":"Ngo ṣe fòìyà ọjọ́ ibi?"},{"start":2.227,"end":3.47,"text":"Tabi ki nma beru ota?","marked":"Tàbí kí ńmá bẹ̀rù ọ̀tá?"},{"start":3.92,"end":5.592,"text":"Jesu papa ni odi mi.","marked":"Jésù pápá ní odi mi."}],"end":5.592},{"key":"2","start":6.542,"lines":[{"start":6.542,"end":7.985,"text":"B'o ti wu k'ija gbona to!","marked":"B'ó ti wù k'ìjà gbóná tó!"},{"start":8.435,"end":10.038,"text":"K'a mase gbo pe emi nsa","marked":"K'á máṣe gbọ́ pé èmi ńṣà"},{"start":10.488,"end":12.16,"text":"Tori Jesu l'apata mi.","marked":"Torí Jésù l'àpáta mi."}],"end":12.16},{"key":"3","start":13.11,"lines":[{"start":13.11,"end":15.744,"text":"Nko mo 'hun t'o le de, nko mo","marked":"Ǹkò mọ hun t'ó lè dé, ǹkò mọ́"},{"start":16.194,"end":17.942,"text":"Bi nki y'o ti se wa l'aini","marked":"Bí ńkì y'ó ti ṣe wá l'àìní"},{"start":18.392,"end":20.518,"text":"Jesu l'o mo, y'o si pese.","marked":"Jésù l'ó mọ́, y'ó sì pèsè."}],"end":20.518},{"key":"4","start":21.468,"lines":[{"start":21.468,"end":23.345,"text":"Bi mo kun f'ese at'osi","marked":"Bí mo kún f'ẹsẹ̀ àt'òṣì"},{"start":23.795,"end":25.298,"text":"Mo le sunmo Ite-anu","marked":"Mo lè súnmọ́ Ite-anu"},{"start":25.748,"end":27.324,"text":"Tori jesu l'ododo mi.","marked":"Torí Jésù l'òdodo mi."}],"end":27.324},{"key":"5","start":28.274,"lines":[{"start":28.274,"end":29.734,"text":"B'adura mi ko ni lari","marked":"B'àdúrà mi kò ní lárí"},{"start":30.184,"end":31.974,"text":"Sibe'reti mi ki o ye","marked":"Síbẹ̀'retí mi kí ó yẹ"},{"start":32.424,"end":33.976,"text":"Tori Jesu mbebe loke.","marked":"Torí Jésù mbẹ̀bẹ̀ lókè."}],"end":33.976},{"key":"6","start":34.926,"lines":[{"start":34.926,"end":36.577,"text":"Aiye at'esu nde si mi","marked":"Ayé àt'èṣù ńdẹ sí mi"},{"start":37.027,"end":38.275,"text":"Sugbon Olorun wa fun mi","marked":"Ṣùgbọ́n Ọlọ́run wà fún mi"},{"start":38.725,"end":40.312,"text":"Jesu l'ohun gbogbo fun mi.","marked":"Jésù l'ohun gbogbo fún mi."}],"end":40.312}]}