{"v":3,"coll":"y","num":442,"id":"hymn_442","title":"A ba le n'igbagbo aye","duration":41.524,"voices":{"male":{"file":"y-442-male-v3.m4a","bytes":284998,"sha256":"fd67de62db07bad380c90f59b419ffea63b7c71e473985e38ac33430a1cb38a9","duration":41.6},"female":{"file":"y-442-female-v3.m4a","bytes":303290,"sha256":"332f228176372e7276aa4c24f72a8041807bf46baf4fc108ec683945cf1af96e","duration":41.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.666,"text":"A ba le n'igbagbo aye","marked":"A bá lè n'ìgbàgbọ́ ayé"},{"start":2.116,"end":3.438,"text":"B'o ti wu k'ota po","marked":"B'ó ti wù k'ọ̀tá pọ̀"},{"start":3.888,"end":5.337,"text":"Igbagbo ti ko je mira","marked":"Ìgbàgbọ́ tí kò jẹ́ mira"},{"start":5.787,"end":7.11,"text":"Fun aini at'osi.","marked":"Fún àìní àt'òṣì."}],"end":7.11},{"key":"2","start":8.06,"lines":[{"start":8.06,"end":9.658,"text":"Igbagbọ ti ko jẹ rahun ,","marked":"Ìgbàgbọ́ tí kò jẹ́ ráhùn"},{"start":10.108,"end":11.278,"text":"L'abẹ ibawi Rẹ,","marked":"L'abẹ́ ìbáwí Rẹ"},{"start":11.728,"end":13.655,"text":"Sugbọn ti n sinmi l'Ọlọrun,","marked":"Sùgbọ́n tí ń sinmi l'Ọlọ́run"},{"start":14.105,"end":15.433,"text":"Nigba ibanujẹ.","marked":"Nígbà ìbànújẹ́."}],"end":15.433},{"key":"3","start":16.383,"lines":[{"start":16.383,"end":17.882,"text":"Igbagbọ ti n tan siwaju,","marked":"Ìgbàgbọ́ tí ń tàn síwájú"},{"start":18.332,"end":19.692,"text":"Gbat' iji 'pọnju de;","marked":"Gbàt ìjì 'pọnju dé"},{"start":20.142,"end":21.719,"text":"Ti ko si jẹ siyemeji,","marked":"Tí kò sì jẹ́ ṣiyèméjì"},{"start":22.169,"end":23.506,"text":"N'nu wahala gbogbo.","marked":"N'nú wàhálà gbogbo."}],"end":23.506},{"key":"4","start":24.456,"lines":[{"start":24.456,"end":25.853,"text":"Igbagbọ ti n gb'ọna toro","marked":"Ìgbàgbọ́ tí ń gb'ọ̀nà tọ́rọ̀"},{"start":26.303,"end":27.344,"text":"Titi ẹmi o pin,","marked":"Títí ẹ̀mí ó pín"},{"start":27.794,"end":29.329,"text":"Ti y'o si f'imọlẹ ọrun,","marked":"Tí y'ó sì f'ìmọ́lẹ̀ ọ̀run"},{"start":29.779,"end":31.217,"text":"Tan akete iku.","marked":"Tan àkéte ikú."}],"end":31.217},{"key":"5","start":32.167,"lines":[{"start":32.167,"end":33.849,"text":"Jesu f'igbagbọ yi fun mi;","marked":"Jésù f'ìgbàgbọ́ yí fún mi"},{"start":34.299,"end":36.088,"text":"Njẹ b'o ti wu k'o ri,","marked":"Ǹjẹ́ b'ó ti wù k'ó rí"},{"start":36.538,"end":38.369,"text":"Lat' ayé yi lọ n ó l'ayọ,","marked":"Lát ayé yí lọ ń ó l'ayọ̀"},{"start":38.819,"end":39.975,"text":"Ilu ọrun rere.","marked":"Ìlú ọ̀run rere."}],"end":39.975}]}