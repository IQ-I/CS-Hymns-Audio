{"v":3,"coll":"y","num":307,"id":"hymn_307","title":"'WỌ t' bẹbẹ f'ọta Rẹ","duration":167.567,"voices":{"male":{"file":"y-307-male.m4a","bytes":1201738,"sha256":"7cca734cfa062da04151f06d58fc362a8551ffa6541a8ba819073ad49eb0e547","duration":167.6},"female":{"file":"y-307-female.m4a","bytes":1264598,"sha256":"57b8e38cd9227d79c1b9d94babecc6dafdaf39afbf3fb4891722dd359f6b1928","duration":167.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.87,"text":"IWO to bebe f'ota Re,","marked":"Ìwọ tó bẹ̀bẹ̀ f'ọ̀tá Rẹ"},{"start":2.25,"end":3.761,"text":"L'or'igi agbelebu:","marked":"L'or'igi àgbélébùú"},{"start":4.141,"end":5.544,"text":"Wipe, “fiji won Baba,\"","marked":"Wípé, fiji wọ́n Bàbá"},{"start":5.924,"end":7.236,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":7.236},{"key":"2","start":8.186,"lines":[{"start":8.186,"end":10.23,"text":"Jesu, jo bebe fun wa,","marked":"Jésù, jọ bẹ̀bẹ̀ fún wa"},{"start":10.61,"end":12.066,"text":"Fun ese wa 'gbagbogbo;","marked":"Fún ẹsẹ̀ wa 'gbàgbogbo"},{"start":12.446,"end":13.765,"text":"A ko mo ohun t'n se,","marked":"A kò mọ ohun t'ń ṣe"},{"start":14.145,"end":15.369,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":15.369},{"key":"3","start":16.319,"lines":[{"start":16.319,"end":17.838,"text":"Jek' awa ti nwa anu,","marked":"Jẹ́k' àwa ti ńwá ànú"},{"start":18.218,"end":19.735,"text":"Dabi Re l 'kan n' iwa,","marked":"Dábì Rẹ l 'kan n' ìwà"},{"start":20.115,"end":21.553,"text":"'Gbat'aba se wa n'ibi:","marked":"'Gbat'aba ṣe wà ń'íbí"},{"start":21.933,"end":23.191,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":23.191},{"key":"4","start":24.141,"lines":[{"start":24.141,"end":25.723,"text":"Jesu, 'Wo t'o gbo aro,","marked":"Jésù, 'Wò t'ó gbọ́ aró"},{"start":26.103,"end":27.465,"text":"Ole t' oku l' egbe Re,","marked":"Olè t' oku l' ẹgbẹ́ Rẹ̀"},{"start":27.845,"end":29.374,"text":"T' o si mu d' orun rere:","marked":"T' ó sì mú d' ọrùn rere"},{"start":29.754,"end":31.095,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":31.095},{"key":"5","start":32.045,"lines":[{"start":32.045,"end":33.885,"text":"Ninu ebi ese wa,","marked":"Nínú ẹ̀bi ẹ̀ṣẹ̀ wa"},{"start":34.265,"end":35.39,"text":"Jek' a toro anu Re,'","marked":"Jẹ́k' á tọrọ ãnú Rẹ̀,'"},{"start":35.77,"end":36.991,"text":"K' a ma pe oruko Re:","marked":"K' a má pe orúkọ Rẹ"},{"start":37.371,"end":38.718,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":38.718},{"key":"6","start":39.668,"lines":[{"start":39.668,"end":40.846,"text":"Ranti awa ti nrahun,","marked":"Rántí àwa ti ńráhùn"},{"start":41.226,"end":42.962,"text":"T' a nwo agbelebu Re;","marked":"T' a nwò àgbélébùú Rẹ"},{"start":43.342,"end":44.892,"text":"F' ireti mimo fun wa,","marked":"F' ìrètí mímọ́́ fún wa"},{"start":45.272,"end":46.557,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":46.557},{"key":"7","start":47.507,"lines":[{"start":47.507,"end":49.08,"text":"Wo t'o fe l'afe dopin","marked":"Wo t'ó fẹ́ l'áfẹ́ dópin"},{"start":49.46,"end":51.26,"text":"Iya Re t'o n kanu Re,","marked":"Ìyá Rẹ t'ó ń kánú Rẹ"},{"start":51.64,"end":52.696,"text":"Ati ore Re owon:","marked":"Àti ọ̀rẹ́ Rẹ ọ̀wọ́n"},{"start":53.076,"end":54.498,"text":"Jesu saanu fun wa.","marked":"Jésù ṣàánú fún wa."}],"end":54.498},{"key":"8","start":55.448,"lines":[{"start":55.448,"end":56.895,"text":"Jek'apin n'nu iya Re,","marked":"Jek'apin ń'nú ìyá Rẹ"},{"start":57.275,"end":58.81,"text":"K' a ma ko iku fun O,","marked":"K' a ma ko ikú fún Ọ"},{"start":59.19,"end":60.515,"text":"Jek' a ri 'toju Re gba:","marked":"Jẹ́k' á rí 'tọ́jú Rẹ gbà"},{"start":60.895,"end":62.32,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":62.32},{"key":"9","start":63.27,"lines":[{"start":63.27,"end":64.644,"text":"Ki gbogbo awa Tire,","marked":"Kí gbogbo àwa Tìrẹ"},{"start":65.024,"end":66.673,"text":"Je omo ile kanna;","marked":"Jẹ́ ọmọ ilé kanná"},{"start":67.053,"end":69.438,"text":"Tori Re, k'a fe 'ra wa:","marked":"Torí Rẹ̀, k'á fẹ́ 'ra wa"},{"start":69.818,"end":71.18,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":71.18},{"key":"10","start":72.13,"lines":[{"start":72.13,"end":73.784,"text":"Jesu, 'Wo ti eru mba,","marked":"Jésù, 'Wo ti èrú ḿbá"},{"start":74.164,"end":75.906,"text":"'Gbat' o si ku Wo nikan,","marked":"'Gbat' ò sì kù Wọ nìkan"},{"start":76.286,"end":77.431,"text":"Ti okunkun su bo O:","marked":"Ti òkùnkùn ṣù bò Ọ́"},{"start":77.811,"end":79.097,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":79.097},{"key":"11","start":80.047,"lines":[{"start":80.047,"end":81.385,"text":"'Gbati a ba npe lasan,","marked":"'Gbàtì a bá ńpẹ́ lásán"},{"start":81.765,"end":83.164,"text":"T' ireti wa si jina;","marked":"T' ìrètí wa sì jiná"},{"start":83.544,"end":84.992,"text":"N'nu okun na di wa mu;","marked":"N'nu okùn nà dì wá mú"},{"start":85.372,"end":86.689,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":86.689},{"key":"12","start":87.639,"lines":[{"start":87.639,"end":89.209,"text":"B'od dabi Baba kogbo,","marked":"B'od dàbí Bàbá kogbo"},{"start":89.589,"end":91.3,"text":"B' o dabi 'moleko si,","marked":"B' ó dàbí 'mọ̀lẹ́kọ sí"},{"start":91.68,"end":93.557,"text":"Jek' a f' igbagbo ri O,","marked":"Jek' a f' ìgbàgbọ́́ rí O"},{"start":93.937,"end":95.334,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":95.334},{"key":"13","start":96.284,"lines":[{"start":96.284,"end":98.108,"text":"Jesu, ninu ongbe Re,","marked":"Jésù, nínú òǹgbè Rẹ"},{"start":98.488,"end":99.815,"text":"Ni ori agbelebu,","marked":"Ní orí àgbélébùú"},{"start":100.195,"end":101.64,"text":"'Wo ti o fe wa sibe;","marked":"'Wò tí o fẹ́ wá síbẹ̀"},{"start":102.02,"end":103.284,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":103.284},{"key":"14","start":104.234,"lines":[{"start":104.234,"end":105.806,"text":"Ma kongbe fun wa sibe,","marked":"Má kòǹgbẹ fún wa síbẹ̀"},{"start":106.186,"end":107.731,"text":"Sise mimol' ara wa;","marked":"Ṣíṣe mímọ́l' ara wa"},{"start":108.111,"end":109.618,"text":"Te ife re na l'orun;","marked":"Tẹ́ ìfẹ́ rẹ ná l'ọ̀run"},{"start":109.998,"end":111.299,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":111.299},{"key":"15","start":112.249,"lines":[{"start":112.249,"end":113.819,"text":"Jek' a kongbe ife Re,","marked":"Jẹ́k' a kòńgbẹ́ ìfẹ́ Rẹ"},{"start":114.199,"end":115.518,"text":"Ma samona wa titi,","marked":"Má ṣamọ̀nà wa títí"},{"start":115.898,"end":117.126,"text":"Si'bi omi iye ni:","marked":"Sí'bí omi ìyè ni"},{"start":117.506,"end":118.716,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":118.716},{"key":"16","start":119.666,"lines":[{"start":119.666,"end":120.829,"text":"Jesu Olurapada,","marked":"Jésù Olùràpadà"},{"start":121.209,"end":122.409,"text":"'Wo t' o se 'fe Baba Re,","marked":"'Wò t' ò ṣe 'fẹ́ Bàbá Rẹ"},{"start":122.789,"end":124.556,"text":"T' o si jiya'tori wa;","marked":"T' ó sì jìyà'torí wa"},{"start":124.936,"end":126.189,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":126.189},{"key":"17","start":127.139,"lines":[{"start":127.139,"end":128.432,"text":"Gba wa I'ojo idamu,","marked":"Gbà wá l'ọjọ́ ìdàmú"},{"start":128.812,"end":129.966,"text":"Se oluranlowo wa,","marked":"Ṣe olùrànlọ́wọ́ wa"},{"start":130.346,"end":131.599,"text":"Lati ma t'ona mimo:","marked":"Láti má t'ọ́nà mímọ́́"},{"start":131.979,"end":133.277,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":133.277},{"key":"18","start":134.227,"lines":[{"start":134.227,"end":135.928,"text":"F' imole Re s' ona wa,","marked":"F' ìmọ́lẹ̀̀ Rẹ s' ona wa"},{"start":136.308,"end":138.111,"text":"Ti y'o ma tan titi lai,","marked":"Ti y'ó ma tán títí láí"},{"start":138.491,"end":140.231,"text":"Tit'ao fi de odo Re:","marked":"Tít'áò fi dé ọ̀dọ̀ Rẹ"},{"start":140.611,"end":141.985,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":141.985},{"key":"19","start":142.935,"lines":[{"start":142.935,"end":145.227,"text":"Jesu, gbogbo ise re,","marked":"Jésù, gbogbo iṣẹ́ rẹ̀"},{"start":145.607,"end":146.697,"text":"Gbogbo idamu Re pin;","marked":"Gbogbo ìdàmú Rẹ̀ pin"},{"start":147.077,"end":148.401,"text":"O jow' emi Re lowo:","marked":"Ó jọ̀w' ẹ̀mí Rẹ̀ lọ́wọ́"},{"start":148.781,"end":150.084,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":150.084},{"key":"20","start":151.034,"lines":[{"start":151.034,"end":152.613,"text":"'Gbat' iku ba de ba wa:","marked":"'Gbat' ikú bá dé bá wa"},{"start":152.993,"end":154.167,"text":"Gba wa lowo ota wa;","marked":"Gbà wá lọ́wọ́ ọ̀tá wa"},{"start":154.547,"end":155.836,"text":"Yo wa wakati na:","marked":"Yọ wá wákàtí ná"},{"start":156.216,"end":157.486,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."}],"end":157.486},{"key":"21","start":158.436,"lines":[{"start":158.436,"end":159.88,"text":"Ki iku at' iye Re,","marked":"Kí ikú àt' iye Rẹ"},{"start":160.26,"end":161.454,"text":"Mu Oore-ore ba wa,","marked":"Mú Ọ̀ọ̀rẹ́-ọ̀rẹ́ bá wa"},{"start":161.834,"end":163.355,"text":"Ti yio mu wa d'oke:","marked":"Tì yío mú wa d'òkè"},{"start":163.735,"end":165.07,"text":"Jesu, sanu fun wa.","marked":"Jésù, sanu fún wa."},{"start":165.45,"end":166.018,"text":"Amin.","marked":"Àmín."}],"end":166.018}]}