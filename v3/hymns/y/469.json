{"v":3,"coll":"y","num":469,"id":"hymn_469","title":"GBEKELE l'ojoojumo","duration":42.269,"voices":{"male":{"file":"y-469-male-v3.m4a","bytes":295597,"sha256":"583663691c374f24a218e7b5466697fe9fe38fbbbdf1535795c9dc7e908ccfdb","duration":42.3},"female":{"file":"y-469-female-v3.m4a","bytes":304045,"sha256":"6dabc5cb424a927f0fcc72856f61ddc4138f50ee165819ec9e2b4e6dd6ce0dfa","duration":42.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.641,"text":"GBEKELE l'ojoojumo","marked":"Gbẹ́kẹ̀lé l'ojoojúmọ́"},{"start":2.091,"end":3.434,"text":"Gbekele n'igba 'danwo","marked":"Gbẹ́kẹ̀lé n'ìgbà dánwò"},{"start":3.884,"end":5.145,"text":"B'igbagbo tile kere","marked":"B'ìgbàgbọ́ tilẹ̀ kéré"},{"start":5.595,"end":7.094,"text":"Gbekele Jesu nikan.","marked":"Gbẹ́kẹ̀lé Jésù nìkan."}],"end":7.094},{"key":"CHORUS","start":8.044,"lines":[{"start":8.044,"end":9.42,"text":"Gbekele nigba gbogbo","marked":"Gbẹ́kẹ̀lé nígbà gbogbo"},{"start":9.87,"end":11.254,"text":"Gbekele I'ojoojuma","marked":"Gbẹ́kẹ̀lé l'ojoojúma"},{"start":11.704,"end":12.976,"text":"Gbekele l'onakona","marked":"Gbẹ́kẹ̀lé l'ọ̀nàkọ́nà"},{"start":13.426,"end":14.959,"text":"Gbekele Jesu nikan.","marked":"Gbẹ́kẹ̀lé Jésù nìkan."}],"end":14.959},{"key":"2","start":15.909,"lines":[{"start":15.909,"end":17.09,"text":"Emi Re n tan imole","marked":"Ẹ̀mí Rẹ̀ ń tan ìmọ́lẹ̀"},{"start":17.54,"end":18.7,"text":"Si okan okunkun mi","marked":"Sí ọkàn òkùnkùn mi"},{"start":19.15,"end":20.504,"text":"Lowo Re n ko le subu","marked":"Lọ́wọ́ Rẹ̀ ń kò lè ṣubú"},{"start":20.954,"end":22.38,"text":"Gbekele Jesu nikan.","marked":"Gbẹ́kẹ̀lé Jésù nìkan."}],"end":22.38},{"key":"3","start":23.33,"lines":[{"start":23.33,"end":25.16,"text":"B'ona ba mo, no ko'rin","marked":"B'ọ̀nà bá mọ́, no kò'rìn"},{"start":25.61,"end":27.468,"text":"B'o ba di, n o gbadura","marked":"B'ó bá di, n ó gbàdúrà"},{"start":27.918,"end":29.496,"text":"Laarin ewu n o ke pe E","marked":"Láàrín ewu n ó ké pe Ẹ"},{"start":29.946,"end":31.489,"text":"Gbekele Jesu nikan.","marked":"Gbẹ́kẹ̀lé Jésù nìkan."}],"end":31.489},{"key":"4","start":32.439,"lines":[{"start":32.439,"end":34.418,"text":"Gbekele titi dopin","marked":"Gbẹ́kẹ̀lé títí dópin"},{"start":34.868,"end":36.775,"text":"Titi aye yoo koja","marked":"Títí ayé yóò kọjá"},{"start":37.225,"end":38.755,"text":"Ta o si de 'nu ogo","marked":"Ta ó sì dé nù ògo"},{"start":39.205,"end":40.72,"text":"Gbekele Jesu nikan.","marked":"Gbẹ́kẹ̀lé Jésù nìkan."}],"end":40.72}]}