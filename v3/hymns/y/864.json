{"v":3,"coll":"y","num":864,"id":"hymn_864","title":"EMI alagbara","duration":46.826,"voices":{"male":{"file":"y-864-male-v3.m4a","bytes":317154,"sha256":"16e7c6fb107216a3c43cdbd5cc759c7af050e084c661a869af55f8d579da2148","duration":46.9},"female":{"file":"y-864-female-v3.m4a","bytes":335465,"sha256":"3605d89408807680d4de398bf5933b9fa7ff4e8fe19193f37762a75c037dc18a","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.277,"text":"EMI alagbara","marked":"Èmi alágbára"},{"start":1.727,"end":2.945,"text":"Wa joko ninu mi","marked":"Wá jókò nínú mi"},{"start":3.395,"end":5.17,"text":"Ki o si fun wa n'idande","marked":"Kí o sì fún wa n'ìdáǹdè"},{"start":5.62,"end":6.78,"text":"Low' eru on ese.","marked":"Lọ́w ẹ̀rù ọn ẹ̀ṣẹ̀."}],"end":6.78},{"key":"2","start":7.73,"lines":[{"start":7.73,"end":8.654,"text":"Emi lmarale","marked":"Èmi Ìmáralé"},{"start":9.104,"end":10.251,"text":"Gbe arun ese lo","marked":"Gbé àrùn ẹ̀ṣẹ̀ lọ"},{"start":10.701,"end":11.898,"text":"Emi iwa-Mimo pipe","marked":"Ẹ̀mí iwa-mimo pípẹ́"},{"start":12.348,"end":13.571,"text":"Emi ife pipe.","marked":"Èmi ìfẹ́ pípẹ́."}],"end":13.571},{"key":"3","start":14.521,"lines":[{"start":14.521,"end":15.643,"text":"M'ojo na yara de","marked":"M'ọjọ́ na yára dé"},{"start":16.093,"end":17.175,"text":"Ti a run ese mi","marked":"Tí a run ẹ̀ṣẹ̀ mi"},{"start":17.625,"end":19.362,"text":"T'ohun atijo y'o koja","marked":"T'ohun àtijọ́ y'ó kọjá"},{"start":19.812,"end":21.118,"text":"T'ohun gbogbo d'otun.","marked":"T'ohun gbogbo d'ọ̀tún."}],"end":21.118},{"key":"4","start":22.068,"lines":[{"start":22.068,"end":23.407,"text":"Ese abinibi","marked":"Ẹ̀ṣẹ̀ abinibi"},{"start":23.857,"end":24.688,"text":"Pare li okan mi","marked":"Parẹ́ lí ọkàn mi"},{"start":25.138,"end":27.208,"text":"Wole, ki O si le jade","marked":"Wọlé, kí O sì lè jáde"},{"start":27.658,"end":28.819,"text":"Gba gbogbo okan mi kan.","marked":"Gba gbogbo ọkàn mi kan."}],"end":28.819},{"key":"5","start":29.769,"lines":[{"start":29.769,"end":30.971,"text":"Oluwa mo fe ni","marked":"Olúwa mo fẹ́ ni"},{"start":31.421,"end":32.714,"text":"Eri pe mo nse 're","marked":"Ẹ̀rí pé mo ńṣe rẹ̀"},{"start":33.164,"end":34.718,"text":"Gege bi 'fe at'oro Re","marked":"Gẹ́gẹ́ bí fẹ́ àt'ọ̀rọ̀ Rẹ"},{"start":35.168,"end":36.415,"text":"B'o ti to loju Re.","marked":"B'ó ti tó lójú Rẹ."}],"end":36.415},{"key":"6","start":37.365,"lines":[{"start":37.365,"end":38.602,"text":"Nko fe ipo giga","marked":"Ǹkò fẹ́ ipò gíga"},{"start":39.052,"end":40.501,"text":"Sa fi eyi ke mi","marked":"Sá fi èyí ké mi"},{"start":40.951,"end":42.655,"text":"Nigbakugba t'o ba si ya","marked":"Nígbàkúgbà t'ó bá sì ya"},{"start":43.105,"end":44.23,"text":"Gba mi s'orun rere.","marked":"Gbà mí s'ọ̀run rere."},{"start":44.68,"end":45.277,"text":"Amin.","marked":"Àmín."}],"end":45.277}]}