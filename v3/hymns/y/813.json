{"v":3,"coll":"y","num":813,"id":"hymn_813","title":"A! Onigbagbo damure, damure, damure","duration":42.644,"voices":{"male":{"file":"y-813-male.m4a","bytes":307308,"sha256":"8f16709ca13df42ca8a0a049918ebe9008a197feacb06830c72d12d33da3dd70","duration":42.7},"female":{"file":"y-813-female.m4a","bytes":314937,"sha256":"1e0a43ccd6d037696c94e58886f3a408c0665829dd503e3313dfb8cb7b2afaf0","duration":42.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.999,"text":"A! Onigbagbo damure, damure, damure,","marked":"A! Onígbàgbọ́ dàmùrè, dàmùrè, dàmùrè"},{"start":3.379,"end":6.102,"text":"Ninu idanwo damure, mase jafara.","marked":"Nínú ìdánwò dàmùrè, máṣe jáfara."}],"end":6.102},{"key":"CHORUS","start":7.052,"lines":[{"start":7.052,"end":8.376,"text":"Wo, Satani wa l'ona - 3ce","marked":"Wò, Sátánì wá l'ọ́nà"},{"start":8.756,"end":9.856,"text":"Mase jafara.","marked":"Masẹ̀ jáfara."}],"end":9.856},{"key":"2","start":10.806,"lines":[{"start":10.806,"end":14.021,"text":"Ninu wahala damure, damure, damure,","marked":"Nínú wàhálà dàmùrè, damure, dàmùrè"},{"start":14.401,"end":17.175,"text":"Ninu iponju damure, mase jafara.","marked":"Nínú ìpọ́njú dàmùrè, máṣe jáfara."}],"end":17.175},{"key":"3","start":18.125,"lines":[{"start":18.125,"end":22.094,"text":"L'akete aisan damure, damure, damure,","marked":"L'ákété àìsàn dámùrè, dámùrè, dámùrè"},{"start":22.474,"end":25.465,"text":"Ninu irora damure, mase jafara.","marked":"Nínú ìrora dàmùrè, máṣe jáfara."}],"end":25.465},{"key":"4","start":26.415,"lines":[{"start":26.415,"end":30.264,"text":"Wo esu ndode damure, damure, demure,","marked":"Wo èṣù ńdọdẹ dàmùrè, dàmùrè, dẹ́múrẹ́"},{"start":30.644,"end":33.167,"text":"A! bi kiniun damure, mase jafara.","marked":"A! bí kiniun dàmùrè, máṣe jáfara."}],"end":33.167},{"key":"5","start":34.117,"lines":[{"start":34.117,"end":37.74,"text":"Enia ko m'ojo damure, damure, damure,","marked":"Enia kó m'òjò dàmùrè, dàmùrè, dàmùrè"},{"start":38.12,"end":41.094,"text":"Ti Jesu yio de damure, mase jafara.","marked":"Tí Jésù yíọ́ dé dámùrè, máṣe jáfara."}],"end":41.094}]}