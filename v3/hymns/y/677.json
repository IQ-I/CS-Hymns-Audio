{"v":3,"coll":"y","num":677,"id":"hymn_677","title":"ORE kan mbe fun omode","duration":87.57,"voices":{"male":{"file":"y-677-male-v3.m4a","bytes":619851,"sha256":"7b2390cd881d7d22c3744ac01c2a536ffe2da3c5a1e64fba7a7a2906c8995e58","duration":87.6},"female":{"file":"y-677-female-v3.m4a","bytes":637614,"sha256":"6e60ab959abac9600f2aefc80294bf6c490101d7ae1e09ca5d0836e1f514da1c","duration":87.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.714,"text":"ỌRẸ kan mbẹ fun ọmọde,","marked":"Ọrẹ kan mbẹ́ fún ọmọdé"},{"start":2.164,"end":3.201,"text":"Loke ọrun lọhun,","marked":"Lókè ọ̀run lọ́hùn"},{"start":3.651,"end":4.951,"text":"Ọrẹ ti ki yipada,","marked":"Ọrẹ tí kì yípadà"},{"start":5.401,"end":6.656,"text":"T'ifẹ rẹ ko le ku;","marked":"T'ìfẹ́ rẹ̀ kò lè kú"},{"start":7.106,"end":8.33,"text":"Ko dabi ọrẹ ayé,","marked":"Kò dàbí ọrẹ ayé"},{"start":8.78,"end":10.206,"text":"Ti mbajẹ lọdọdun;","marked":"Ti mbàjẹ́ lọ́dọdún"},{"start":10.656,"end":11.997,"text":"Orukọ Rẹ bi ọrẹ,","marked":"Orúkọ Rẹ bí ọrẹ"},{"start":12.447,"end":13.76,"text":"Wo fun nigba gbogbo.","marked":"Wọ fún nígbà gbogbo."}],"end":13.76},{"key":"2","start":14.71,"lines":[{"start":14.71,"end":16.397,"text":"Isinmi kan mbẹ f'ọmọde,","marked":"Ìsinmi kan mbẹ́ f'ọmọdé"},{"start":16.847,"end":18.072,"text":"Loke ọrun lohun;","marked":"Lókè ọ̀run lóhùn"},{"start":18.522,"end":19.723,"text":"F'awọn t'o f'Olugbala,","marked":"F'àwọn t'ó f'Olùgbàlà"},{"start":20.173,"end":21.441,"text":"Ti n ke Abba Baba","marked":"Tí ń ké Abba Baba"},{"start":21.891,"end":23.352,"text":"di Isinmi lọwọ 'yọnu,","marked":"di Ìsinmi lọ́wọ́ 'yọnu"},{"start":23.802,"end":25.055,"text":"Lọw' ẹsẹ at'ewu;","marked":"Lọw' ẹsẹ̀ àt'ewu"},{"start":25.505,"end":26.787,"text":"Nibi t'awọn ọmọde,","marked":"Níbi t'àwọn ọmọdé"},{"start":27.237,"end":29.037,"text":"Y'o sinmi titi lai.","marked":"Y'ó sinmi títí láì."}],"end":29.037},{"key":"3","start":29.987,"lines":[{"start":29.987,"end":31.478,"text":"Ile kan mbẹ fun ọmọde,","marked":"Ilẹ̀ kan mbẹ́ fún ọmọdé"},{"start":31.928,"end":33.049,"text":"Loke ọrun lọhun;","marked":"Lókè ọ̀run lọ́hùn"},{"start":33.499,"end":34.967,"text":"Nibi ti Jesu n jọba,","marked":"Níbi tí Jésù ń jọba"},{"start":35.417,"end":36.396,"text":"Ile alafia!","marked":"Ilẹ̀ àlàáfíà!"},{"start":36.846,"end":38.468,"text":"di Ko s'ile t'o jọ layé,","marked":"di Kò s'ilẹ̀ t'ó jọ layé"},{"start":38.918,"end":40.032,"text":"T'a le fi sakawe;","marked":"T'á lè fi ṣàkàwé"},{"start":40.482,"end":41.698,"text":"Ara ro 'lukuluku;","marked":"Ara rọ̀ lukúlùkù"},{"start":42.148,"end":43.198,"text":"Irora na dopin.","marked":"Ìrora nà dópin."}],"end":43.198},{"key":"4","start":44.148,"lines":[{"start":44.148,"end":45.667,"text":"Ade kan mbẹ fun ọmọde,","marked":"Adé kan mbẹ́ fún ọmọdé"},{"start":46.117,"end":47.08,"text":"Loke ọrun lọhun;","marked":"Lókè ọ̀run lọ́hùn"},{"start":47.53,"end":49.06,"text":"Ẹni t'o ba n wo Jesu,","marked":"Ẹni t'ó bá ń wo Jésù"},{"start":49.51,"end":50.431,"text":"Y'o ri na de;","marked":"Y'ó rí na dé"},{"start":50.881,"end":52.056,"text":"Ade t'o logo julọ,","marked":"Adé t'ó lógo jùlọ"},{"start":52.506,"end":53.762,"text":"Ti y'o fi fun gbogbo","marked":"Tí y'ó fi fún gbogbo"},{"start":54.212,"end":55.188,"text":"Awọn ọrẹ rẹ layé;","marked":"Àwọn ọ̀rẹ́ rẹ̀ layé"},{"start":55.638,"end":56.884,"text":"Awọn t'o fe nihin.","marked":"Àwọn t'ó fẹ́ níhìn."}],"end":56.884},{"key":"5","start":57.834,"lines":[{"start":57.834,"end":59.446,"text":"Orin kan mbẹ fun ọmọde,","marked":"Orin kan mbẹ́ fún ọmọdé"},{"start":59.896,"end":61.029,"text":"Loke ọrun lọhun;","marked":"Lókè ọ̀run lọ́hùn"},{"start":61.479,"end":63.031,"text":"Orin ti ko le su ni,","marked":"Orin tí kò lè sú ni"},{"start":63.481,"end":64.85,"text":"B'o ti wu k'a ko to!","marked":"B'ó ti wù k'á kò tó!"},{"start":65.3,"end":66.483,"text":"Orin t'awọn angeli,","marked":"Orin t'àwọn áńgẹ́lì"},{"start":66.933,"end":68.134,"text":"Ko le ri ko titi;","marked":"Kò lè rí kó títí"},{"start":68.584,"end":70.176,"text":"Krist ki s'Olugbala wọn,","marked":"Krist kí s'Olùgbàlà wọn"},{"start":70.626,"end":71.869,"text":"Ọba l'o jẹ fun wọn.","marked":"Ọba l'ó jẹ́ fún wọn."}],"end":71.869},{"key":"6","start":72.819,"lines":[{"start":72.819,"end":74.42,"text":"Ẹwu kan mbẹ fun ọmọde,","marked":"Ẹ̀wù kan mbẹ́ fún ọmọdé"},{"start":74.87,"end":75.896,"text":"Loke ọrun lọhun;","marked":"Lókè ọ̀run lọ́hùn"},{"start":76.346,"end":77.605,"text":"Harpu olohun didan!","marked":"Harpu olóhùn dídán!"},{"start":78.055,"end":79.327,"text":"Imọpẹ isẹgun!","marked":"Ìmọ̀pẹ́ ìsẹ́gun!"},{"start":79.777,"end":80.754,"text":"Gbogbo ẹbun rere yi,","marked":"Gbogbo ẹ̀bùn rere yí"},{"start":81.204,"end":82.442,"text":"L'a ni ninu Jesu;","marked":"L'á ni nínú Jésù"},{"start":82.892,"end":84.333,"text":"Ẹ wa ẹyin ọmọde,","marked":"Ẹ wá ẹ̀yin ọmọdé"},{"start":84.783,"end":86.021,"text":"Ki wọn le jẹ tiyin.","marked":"Kí wọn lè jẹ́ tiyín."}],"end":86.021}]}