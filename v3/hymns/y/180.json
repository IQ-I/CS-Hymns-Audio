{"v":3,"coll":"y","num":180,"id":"hymn_180","title":"OLORUN, kini mo ri yi!","duration":56.936,"voices":{"male":{"file":"y-180-male-v3.m4a","bytes":409307,"sha256":"d9e2f80954a2816880a803a5454faa64fe08793403af86fd1d4b5ccb589a27f6","duration":57.0},"female":{"file":"y-180-female-v3.m4a","bytes":416359,"sha256":"d2a0ae1b6cec08ddf00ac209c16988218ae043c7d2fdc2a3a5725c3547267794","duration":57.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.149,"text":"ỌLỌRUN, kini mo ri yi!","marked":"Ọlọ́run, kíni mo rí yí!"},{"start":2.599,"end":3.731,"text":"Opin de f'ohun gbogbo!","marked":"Òpin dé f'ohun gbogbo!"},{"start":4.181,"end":5.38,"text":"Onidajọ arayé yọ,","marked":"Onídàjọ́ arayé yọ"},{"start":5.83,"end":7.128,"text":"O gunwa n'itẹ 'dajọ;","marked":"Ó gúnwà n'ìtẹ́ 'dajọ"},{"start":7.578,"end":9.145,"text":"Ipe dun iboji si tu,","marked":"Ìpè dùn ibojì sì tú"},{"start":9.595,"end":10.981,"text":"Gbogbo awọn oku silẹ,","marked":"Gbogbo àwọn òkú sílẹ̀"},{"start":11.431,"end":13.719,"text":"f Mura, lọ ko, ọkan mi.","marked":"f Mura, lọ kọ́, ọkàn mi."}],"end":13.719},{"key":"2","start":14.669,"lines":[{"start":14.669,"end":16.7,"text":"Oku n'nu Krist' y'o kọ jinde ,","marked":"Òkú n'nú Krist y'ó kọ́ jíǹde"},{"start":17.15,"end":18.406,"text":"Nigba 'pe 'kẹhin ba dun;","marked":"Nígbà pé 'kẹhin bá dùn"},{"start":18.856,"end":20.337,"text":"Wọn o lọ ko, l'awọsanma,","marked":"Wọn ó lọ kọ́, l'àwọsánmà"},{"start":20.787,"end":22.025,"text":"Wọn o fi ayọ yi ka;","marked":"Wọn ó fi ayọ̀ yí ká"},{"start":22.475,"end":24.445,"text":"Ko s'ẹru ti y'o b'ọkan wọn,","marked":"Kò s'ẹrú tí y'ó b'ọkàn wọn"},{"start":24.895,"end":26.313,"text":"Oju Rẹ da imọlẹ bo,","marked":"Ojú Rẹ̀ dá ìmọ́lẹ̀ bọ̀"},{"start":26.763,"end":28.098,"text":"Awọn ti o mura de.","marked":"Àwọn tí ó múra dé."}],"end":28.098},{"key":"3","start":29.048,"lines":[{"start":29.048,"end":31.007,"text":"Sugbọn ẹlẹsẹ t'oun t'ẹru!","marked":"Sùgbọ́n ẹlẹ́sẹ̀ t'òun t'ẹrú!"},{"start":31.457,"end":32.645,"text":"Ni gbigbona 'binu Rẹ,","marked":"Ní gbígbóná bínú Rẹ"},{"start":33.095,"end":34.875,"text":"Wọn o dide, wọn o si ri,","marked":"Wọn ó dìde, wọn ó sì rí"},{"start":35.325,"end":36.636,"text":"Pe o se wọn ko ba mọ;","marked":"Pé ó ṣe wọn kò bá mọ́"},{"start":37.086,"end":38.184,"text":"Ọjọ ore-ọfẹ kọja,","marked":"Ọjọ́ ore-ọfẹ kọjá"},{"start":38.634,"end":40.052,"text":"Wọn ń gbọn niwaju 'tẹ dajọ,","marked":"Wọ́n ń gbọ́n níwájú 'tẹ dájọ́"},{"start":40.502,"end":41.964,"text":"Awọn ti ko mura de.","marked":"Àwọn tí kò múra dé."}],"end":41.964},{"key":"4","start":42.914,"lines":[{"start":42.914,"end":44.75,"text":"Ọlọrun, ki ni mo ri yi?","marked":"Ọlọ́run, kí ni mo rí yí?"},{"start":45.2,"end":46.355,"text":"Opin de f'ohun gbogbo!","marked":"Òpin dé f'ohun gbogbo!"},{"start":46.805,"end":48.03,"text":"Onidajo arayé yọ,","marked":"Onídàjọ́ arayé yọ"},{"start":48.48,"end":49.793,"text":"O gunwa n'itẹ 'dajọ;","marked":"Ó gúnwà n'ìtẹ́ 'dajọ"},{"start":50.243,"end":51.58,"text":"L'ẹsẹ agbelebu mo ń wo,","marked":"L'ẹsẹ̀ àgbélébùú mò ń wò"},{"start":52.03,"end":53.542,"text":"Gba t'ohun gbogbo yoo kọja,","marked":"Gba t'ohun gbogbo yóò kọjá"},{"start":53.992,"end":55.387,"text":"Bayi ni n ó mura de.","marked":"Báyì ni n ó múra dé."}],"end":55.387}]}