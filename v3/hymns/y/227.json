{"v":3,"coll":"y","num":227,"id":"hymn_227","title":"OLORUN wa je k'iyin Re","duration":46.531,"voices":{"male":{"file":"y-227-male-v3.m4a","bytes":333355,"sha256":"68e2f459f7d775b160e39f032bb000f5fd7dbac8be30ec15824c62098804a32c","duration":46.6},"female":{"file":"y-227-female-v3.m4a","bytes":338582,"sha256":"7bc1088ce710ab012101e678b28c872e85f667c02d6bb0584c4d16d96b361f39","duration":46.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.61,"text":"OLORUN wa je k'iyin Re","marked":"Ọlọ́run wá jẹ́ k'ìyìn Rẹ̀"},{"start":2.06,"end":3.37,"text":"Gb'ohun gbogbo wa kan","marked":"Gb'ohùn gbogbo wa kan"},{"start":3.82,"end":5.229,"text":"Owo Re yi ojo wa po","marked":"Ọwọ́ Rẹ̀ yí ọjọ́ wa pọ̀"},{"start":5.679,"end":6.91,"text":"Odun miran si de.","marked":"Ọdún míràn sì dé."}],"end":6.91},{"key":"2","start":7.86,"lines":[{"start":7.86,"end":9.388,"text":"Ẹbọ wa n goke sọdọ Rẹ,","marked":"Ẹbọ wá ń gòkè sọ́dọ̀ Rẹ̀"},{"start":9.838,"end":11.167,"text":"Baba, Olore wa;","marked":"Baba, Ọlọ́rẹ́ wà"},{"start":11.617,"end":13.376,"text":"Fun anu ọdọdun ti n san,","marked":"Fún àánú ọdọdún tí ń sàn"},{"start":13.826,"end":15.13,"text":"Lati ọdọ Rẹ wa.","marked":"Láti ọ̀dọ̀ Rẹ wá."}],"end":15.13},{"key":"3","start":16.08,"lines":[{"start":16.08,"end":17.394,"text":"N'nu gbogbo ayida ayé,","marked":"N'nú gbogbo àyídà ayé"},{"start":17.844,"end":18.898,"text":"K'anu Re wa sibe","marked":"K'àánú Rẹ̀ wá síbẹ̀"},{"start":19.348,"end":20.878,"text":"B'ore Re si wa si ti po","marked":"B'ọ̀rẹ́ Rẹ sì wá sì ti pọ̀"},{"start":21.328,"end":29.104,"text":"Beni k'iyin wa po. 4 N'nu gbogbo ayida ayé, A n ri aniyan Rẹ: Jọwọ jẹ k'aanu Rẹ 'kanna Bukun ọdun titun.","marked":"Bẹni k'ìyìn wà pọ̀. 4 N'nú gbogbo àyídà ayé, A ń rí àníyàn Rẹ̀: Jọ̀wọ́ jẹ́ k'àánú Rẹ̀ kànnà Bùkún ọdún titun."}],"end":29.104},{"key":"4","start":30.054,"lines":[{"start":30.054,"end":32.061,"text":"B'ayọ ba si wa, k'ayọ naa","marked":"B'ayọ̀ bá sì wá, k'ayọ̀ náà"},{"start":32.511,"end":33.532,"text":"Fa wa si ọdọ Rẹ;","marked":"Fà wá sí ọ̀dọ̀ Rẹ"},{"start":33.982,"end":35.914,"text":"B'iya ni, awa o kọrin,","marked":"B'ìyà ni, àwa ó kọrin"},{"start":36.364,"end":37.609,"text":"B'ibukun Rẹ pẹlu.","marked":"B'ìbùkún Rẹ pẹ̀lú."}],"end":37.609},{"key":"5","start":38.559,"lines":[{"start":38.559,"end":39.885,"text":"N'nu gbogbo ayida aiye","marked":"N'nú gbogbo àyídà ayé"},{"start":40.335,"end":41.482,"text":"A nri aniyan Re","marked":"A ńrí àníyàn Rẹ"},{"start":41.932,"end":43.315,"text":"Jowo je k'anu Re 'kanna","marked":"Jọ̀wọ́ jẹ́ k'àánú Rẹ̀ kànnà"},{"start":43.765,"end":44.982,"text":"Bukun odun titun.","marked":"Bùkún ọdún titun."}],"end":44.982}]}