{"v":3,"coll":"y","num":351,"id":"hymn_351","title":"OKE kan mbe t'o n dan t'o ga","duration":48.909,"voices":{"male":{"file":"y-351-male-v3.m4a","bytes":337425,"sha256":"3ad503868d3c034ab18f542bdbf73498f504f864727dd27bd0eec2be92b5470b","duration":49.0},"female":{"file":"y-351-female-v3.m4a","bytes":350729,"sha256":"2cc509a4fe843bf5210facf9812de28d045a2243a92db9c2b00feb680838486e","duration":49.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.908,"text":"OKE kan mbẹ t'o n dan t'o ga,","marked":"Òkè kan mbẹ́ t'ó ń dán t'ó ga"},{"start":2.358,"end":3.417,"text":"Nibi t'a m'Ọlọrun,","marked":"Níbi t'á m'Ọlọ́run"},{"start":3.867,"end":5.148,"text":"O wa l'okere ni ọrun,","marked":"Ó wà l'òkèrè ní ọ̀run"},{"start":5.598,"end":6.768,"text":"Itẹ Ọlọrun ni.","marked":"Ìtẹ́ Ọlọ́run ni."}],"end":6.768},{"key":"2","start":7.718,"lines":[{"start":7.718,"end":9.523,"text":"Tal'awon t'o sunmo ibe","marked":"Tál'àwọn t'ó súnmọ́ ibẹ̀"},{"start":9.973,"end":11.18,"text":"Lati wo ite Re?","marked":"Láti wo ìtẹ́ Rẹ?"},{"start":11.63,"end":13.161,"text":"Egbarun 'won t'o wa nibe","marked":"Ẹgbàrún wọn t'ó wà níbẹ̀"},{"start":13.611,"end":14.749,"text":"Omode bi awa.","marked":"Ọmọdé bí àwa."}],"end":14.749},{"key":"3","start":15.699,"lines":[{"start":15.699,"end":16.959,"text":"Olugbala w'ẹsẹ wọn nu,","marked":"Olùgbàlà w'ẹsẹ̀ wọn nù"},{"start":17.409,"end":18.472,"text":"O sọ wọn di mimọ;","marked":"Ó sọ wọ́n di mímọ́"},{"start":18.922,"end":21.324,"text":"Wọn f'ọrọ Rẹ, wọn f'ọjọ Rẹ,","marked":"Wọ́n f'ọ̀rọ̀ Rẹ, wọ́n f'ọjọ́ Rẹ"},{"start":21.774,"end":23.424,"text":"Wọn fẹ, wọn si ri i.","marked":"Wọ́n fẹ́, wọ́n sì rí i."}],"end":23.424},{"key":"4","start":24.374,"lines":[{"start":24.374,"end":25.851,"text":"Labẹ ọpọ oku tutu,","marked":"Lábẹ́ ọ̀pọ̀ òkú tútù"},{"start":26.301,"end":27.744,"text":"L'ara wọn sinmi si;","marked":"L'ara wọn sinmi sí"},{"start":28.194,"end":29.438,"text":"Wọn ri 'gbala ọkan wọn he,","marked":"Wọ́n rí gbàlà ọkàn wọn he"},{"start":29.888,"end":30.867,"text":"Laya Olugbala.","marked":"Láyà Olùgbàlà."}],"end":30.867},{"key":"5","start":31.817,"lines":[{"start":31.817,"end":33.392,"text":"K'awa k'o rin bi wọn ti n rin;","marked":"K'àwa k'ó rìn bí wọ́n ti ń rìn"},{"start":33.842,"end":35.169,"text":"Ipa t'o lọ s'ọrun;","marked":"Ipa t'ó lọ s'ọ̀run"},{"start":35.619,"end":36.986,"text":"Wa idariji Ọlọrun,","marked":"Wá ìdáríjì Ọlọ́run"},{"start":37.436,"end":38.625,"text":"T'o ti dariji wọn.","marked":"T'ó ti dáríjì wọn."}],"end":38.625},{"key":"6","start":39.575,"lines":[{"start":39.575,"end":41.332,"text":"p Jesu n gbọ irẹlẹ ẹkun,","marked":"p Jésù ń gbọ́ ìrẹ̀lẹ̀ ẹkún"},{"start":41.782,"end":43.069,"text":"T'o mu ọkan d'ọtun,","marked":"T'ó mú ọkàn d'ọ̀tún"},{"start":43.519,"end":45.68,"text":"Lori oke t'o dan, t'o ga;","marked":"Lórí òkè t'ó dán, t'ó ga"},{"start":46.13,"end":47.359,"text":"L'awa o ma wo Ọ.","marked":"L'àwa ò má wò Ọ́."}],"end":47.359}]}