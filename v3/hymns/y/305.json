{"v":3,"coll":"y","num":305,"id":"hymn_305","title":"OGO ni fun Jesu","duration":51.692,"voices":{"male":{"file":"y-305-male-v3.m4a","bytes":347158,"sha256":"3955bfa2c4e54b1943eef55c8a5543e88612ad16416c9f90da974ec033658daf","duration":51.7},"female":{"file":"y-305-female-v3.m4a","bytes":359310,"sha256":"957175a6b9a8bb10632439c88a60c893fea1a852780feb23d182daa70008a635","duration":51.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.629,"text":"OGO ni fun Jesu,","marked":"Ògo ni fún Jésù"},{"start":2.079,"end":3.032,"text":"T'o f' irora nla,","marked":"T'ó f ìrora ńlá"},{"start":3.482,"end":4.465,"text":"Ta eje Re fun mi,","marked":"Ta ẹ̀jẹ̀ Rẹ fún mi"},{"start":4.915,"end":5.911,"text":"Lati iha Re.","marked":"Láti ìhà Rẹ."}],"end":5.911},{"key":"2","start":6.861,"lines":[{"start":6.861,"end":8.549,"text":"Mo r'iye ailopin,","marked":"Mo r'iye àìlópin"},{"start":8.999,"end":10.008,"text":"Ninu ẹjẹ na;","marked":"Nínú ẹ̀jẹ̀ ná"},{"start":10.458,"end":11.468,"text":"Iyọnu Rẹ sa pọ,","marked":"Ìyọnu Rẹ̀ sá pọ̀"},{"start":11.918,"end":13.058,"text":"Ore Rẹ ki tan.","marked":"Ọrẹ Rẹ̀ kí tán."}],"end":13.058},{"key":"3","start":14.008,"lines":[{"start":14.008,"end":15.144,"text":"Ọpẹ ni titi lai,","marked":"Ọpẹ́ ni títí láì"},{"start":15.594,"end":16.745,"text":"F'ẹjẹ 'yebiye,","marked":"F'ẹ̀jẹ̀ yẹbíyẹ"},{"start":17.195,"end":18.496,"text":"T'o ra ayé pada,","marked":"T'ó ra ayé padà"},{"start":18.946,"end":20.087,"text":"Kuro n'nu egbe.","marked":"Kúrò n'nú ẹgbẹ́."}],"end":20.087},{"key":"4","start":21.037,"lines":[{"start":21.037,"end":22.504,"text":"Ẹjẹ Abel' ń kigbe,","marked":"Ẹ̀jẹ̀ Abel ń kígbe"},{"start":22.954,"end":24.06,"text":"Si ọrun f'ẹsan;","marked":"Sí ọ̀run f'ẹ̀san"},{"start":24.51,"end":25.955,"text":"Sugb' ẹjẹ Jesu ń ke,","marked":"Ṣùgb ẹ̀jẹ̀ Jésù ń ké"},{"start":26.405,"end":27.568,"text":"Fun 'dariji wa.","marked":"Fún dáríjì wa."}],"end":27.568},{"key":"5","start":28.518,"lines":[{"start":28.518,"end":29.617,"text":"p Nigba ti a bu wọn,","marked":"p Nígbà tí a bú wọn"},{"start":30.067,"end":30.95,"text":"Ọkan ẹsẹ wa,","marked":"Ọkàn ẹsẹ̀ wa"},{"start":31.4,"end":33.599,"text":"Satan, n' idamu rẹ,","marked":"Ṣatan, ń ìdámú rẹ̀"},{"start":34.049,"end":35.401,"text":"F'ẹru sa jade.","marked":"F'ẹ́rù sá jáde."}],"end":35.401},{"key":"6","start":36.351,"lines":[{"start":36.351,"end":37.72,"text":"Nigba t'ayé ba ń yọ,","marked":"Nígbà t'ayé bá ń yọ̀"},{"start":38.17,"end":39.118,"text":"T'o ń gbe 'Yin Rẹ ga,","marked":"T'ó ń gbé yín Rẹ̀ ga"},{"start":39.568,"end":40.49,"text":"Awọn ogun Angel,","marked":"Àwọn ogun Angẹl"},{"start":40.94,"end":42.241,"text":"A ma f'ayọ gbe.","marked":"A má f'ayọ̀ gbé."}],"end":42.241},{"key":"7","start":43.191,"lines":[{"start":43.191,"end":45.053,"text":"Njẹ, ẹ gbohun yin ga,","marked":"Ǹjẹ́, ẹ gbóhùn yín ga"},{"start":45.503,"end":46.669,"text":"Ki iro naa dun!","marked":"Kí ìró náà dùn!"},{"start":47.119,"end":48.407,"text":"Kikan lohun gooro,","marked":"Kíkan lóhùn gooro"},{"start":48.857,"end":50.143,"text":"Yin Ọd'aguntan.","marked":"Yin Ọ̀d'àgùntàn."}],"end":50.143}]}