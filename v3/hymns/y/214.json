{"v":3,"coll":"y","num":214,"id":"hymn_214","title":"E funpe naa kikan","duration":44.696,"voices":{"male":{"file":"y-214-male-v3.m4a","bytes":307586,"sha256":"9adeb184239be9ca61fb82cdf9841193c5c4b3c881bb20eb5f037cddccc8f9b3","duration":44.7},"female":{"file":"y-214-female-v3.m4a","bytes":323855,"sha256":"38c7299f128b3cc0798a0f439d9b17dbd6af0c0cd34748b50fdf78df91fd8313","duration":44.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.668,"text":"E funpe naa kikan,","marked":"Ẹ fúnpẹ́ náà kíkan"},{"start":2.118,"end":3.052,"text":"Ipe ihinrere,","marked":"Ìpè ìhìnrere"},{"start":3.502,"end":4.887,"text":"K'o dun jake jado,","marked":"K'ó dùn jákè jado"},{"start":5.337,"end":9.651,"text":"L'eti gbogbo eda; Ọdun idasilẹ ti de; Pada ẹlẹsẹ pada.","marked":"L'etí gbogbo ẹ̀dá; Ọdún ìdásílẹ̀ ti dé; Padà ẹlẹ́sẹ̀ padà."}],"end":9.651},{"key":"CHORUS","start":10.601,"lines":[{"start":10.601,"end":11.951,"text":"Odun idasile ti de;","marked":"Ọdún ìdásílẹ̀ ti dé"},{"start":12.401,"end":13.868,"text":"Pada elese e pada.","marked":"Padà ẹlẹ́ṣẹ̀ ẹ padà."}],"end":13.868},{"key":"2","start":14.818,"lines":[{"start":14.818,"end":16.107,"text":"Fun 'pe t'Ọdaguntan;","marked":"Fún pè t'Ọ̀dàgùntàn"},{"start":16.557,"end":17.786,"text":"T'a ti pa s'etutu,","marked":"T'á ti pa s'ètùtù"},{"start":18.236,"end":19.322,"text":"Jẹ ki agbayé mọ,","marked":"Jẹ́ kí agbayé mọ́"},{"start":19.772,"end":20.983,"text":"Agbara ẹjẹ Rẹ,","marked":"Agbára ẹ̀jẹ̀ Rẹ"}],"end":20.983},{"key":"3","start":21.933,"lines":[{"start":21.933,"end":23.02,"text":"Ẹyin ẹru ẹsẹ,","marked":"Ẹ̀yin ẹrú ẹsẹ̀"},{"start":23.47,"end":24.622,"text":"Ẹ so'ra yin d'ọmọ,","marked":"Ẹ ṣo'ra yín d'ọmọ"},{"start":25.072,"end":26.492,"text":"Lọwọ Kristi Jesu,","marked":"Lọ́wọ́ Kristi Jésù"},{"start":26.942,"end":28.22,"text":"Ẹ gb'ominira yin.","marked":"Ẹ gb'òmìnira yín."}],"end":28.22},{"key":"4","start":29.17,"lines":[{"start":29.17,"end":30.094,"text":"Olori Alufa,","marked":"Olórí Àlùfá"},{"start":30.544,"end":31.704,"text":"L'Olugbala ise;","marked":"L'Olùgbàlà iṣẹ́"},{"start":32.154,"end":33.177,"text":"O fi 'ra Rẹ rubọ,","marked":"Ó fi ra Rẹ̀ rúbọ"},{"start":33.627,"end":34.991,"text":"Arukun, aruda.","marked":"Arúkún, arúdà."}],"end":34.991},{"key":"5","start":35.941,"lines":[{"start":35.941,"end":37.675,"text":"mf Ọkan alarẹ, wa,","marked":"mf Ọkàn alárẹ, wá"},{"start":38.125,"end":39.495,"text":"Sinmi laya Jesu,","marked":"Sinmi láyà Jésù"},{"start":39.945,"end":40.997,"text":"p Onirobinujẹ,","marked":"p Oníròbìnújẹ́"},{"start":41.447,"end":43.147,"text":"Tujuka, si ma yọ.","marked":"Tújúká, sì má yọ̀."}],"end":43.147}]}