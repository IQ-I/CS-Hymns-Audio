{"v":3,"coll":"y","num":8,"id":"hymn_8","title":"ORUN Ododo, jowo la","duration":19.406,"voices":{"male":{"file":"y-8-male.m4a","bytes":135138,"sha256":"5031cd23aaf94d68f85ff9e0b6fc02a8955ad54623d6f7f4ea39bdc576ea7e53","duration":19.5},"female":{"file":"y-8-female.m4a","bytes":139551,"sha256":"0b1bb256a6573af41f7b076a6cf2235d18a41bd5a581b0eb393b6a4c1bf54b2a","duration":19.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.913,"text":"ORUN Ododo, jowo la,","marked":"Ọ̀run Òdodo, jọ̀wọ́ là"},{"start":2.293,"end":3.868,"text":"Ma ran jeje lori Sioni","marked":"Má rán jẹ́jẹ́ lórí Síónì"},{"start":4.248,"end":5.498,"text":"Tu okunkun oju wa ka","marked":"Tú òkùnkùn ojú wa ká"},{"start":5.878,"end":8.045,"text":"Je k'okan wa ko ji si ye.","marked":"Jẹ́ k'ọkàn wa kò jí sí yẹ."}],"end":8.045},{"key":"2","start":8.995,"lines":[{"start":8.995,"end":10.322,"text":"Jek'ore ofe ba le wa,","marked":"Jẹ́k'ọ̀rẹ́ ọ̀fẹ́ bá lè wà"},{"start":10.702,"end":12.786,"text":"B'iri orun, b'opo ojo;","marked":"B'írí ọ̀run, b'ọ̀pọ̀ ọjọ́"},{"start":13.166,"end":14.619,"text":"K'a le mo p'On l'Ore wa san,","marked":"K'á lè mọ p'On l'Ọ̀rẹ́ wa sàn"},{"start":14.999,"end":16.941,"text":"Ka le pe 'gbala ni tiwa.","marked":"Ká lè pe 'gbàlà ní tiwa."},{"start":17.321,"end":17.856,"text":"Amin.","marked":"Àmín."}],"end":17.856}]}