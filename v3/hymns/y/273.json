{"v":3,"coll":"y","num":273,"id":"hymn_273","title":"Bi agbonrin ti n mi hele","duration":38.55,"voices":{"male":{"file":"y-273-male-v3.m4a","bytes":264428,"sha256":"aab377a823389020c51ba9d281f71d977d030bd9997b8ee2660588964fc8ad20","duration":38.6},"female":{"file":"y-273-female-v3.m4a","bytes":265078,"sha256":"81c6a5000ece7a0d81b669f9f126beec3f9dc100a2d4932f0771bc2496a2d741","duration":38.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.2,"text":"Bi agbọnrin ti n mi hẹlẹ,","marked":"Bí àgbọ̀nrín tí ń mí hẹlẹ"},{"start":2.65,"end":3.811,"text":"S'ipa odo omi;","marked":"S'ípa odò omi"},{"start":4.261,"end":5.573,"text":"Bẹni ọkan mi n mi si Ọ,","marked":"Bẹni ọkàn mi ń mí sí Ọ"},{"start":6.023,"end":7.085,"text":"Iwọ Ọlọrun mi.","marked":"Ìwọ Ọlọ́run mi."}],"end":7.085},{"key":"2","start":8.035,"lines":[{"start":8.035,"end":9.465,"text":"Orungbẹ Rẹ n gbẹ ọkan mi,","marked":"Òrùngbẹ Rẹ̀ ń gbẹ ọkàn mi"},{"start":9.915,"end":11.032,"text":"Ọlọrun alaye;","marked":"Ọlọ́run àlàyé"},{"start":11.482,"end":12.89,"text":"Nigbawo ni n o r'Oju Rẹ,","marked":"Nígbàwo ni n ó r'Ojú Rẹ"},{"start":13.34,"end":14.211,"text":"Ọlọrun Ọlanla?","marked":"Ọlọ́run Ọláńlá?"}],"end":14.211},{"key":"3","start":15.161,"lines":[{"start":15.161,"end":16.673,"text":"Ọkan mi o se rẹwẹsi?","marked":"Ọkàn mi ò ṣe rẹ̀wẹ̀sì?"},{"start":17.123,"end":18.077,"text":"Gbẹkẹle Ọlọrun;","marked":"Gbẹ́kẹ̀lé Ọlọ́run"},{"start":18.527,"end":19.807,"text":"Ẹni ti y'o sọ ẹkun rẹ,","marked":"Ẹni tí y'ó sọ ẹkún rẹ̀"},{"start":20.257,"end":21.429,"text":"D'orin ayọ fun ọ.","marked":"D'orin ayọ̀ fún ọ."}],"end":21.429},{"key":"4","start":22.379,"lines":[{"start":22.379,"end":24.137,"text":"Y'o ti pẹ to, Ọlọrun mi,","marked":"Y'ó ti pẹ́ tó, Ọlọ́run mi"},{"start":24.587,"end":25.793,"text":"Ti n o d'ẹni 'gbagbẹ?","marked":"Tí n ò d'ẹni 'gbagbẹ?"},{"start":26.243,"end":28.3,"text":"T'a o ma ti mi sihin, sọhun,","marked":"T'a ó má tì mí síhìn, sọ́hùn"},{"start":28.75,"end":30.023,"text":"B'ẹni ko ni 'bugbe?","marked":"B'ẹni kò ní bùgbé?"}],"end":30.023},{"key":"5","start":30.973,"lines":[{"start":30.973,"end":32.493,"text":"Ọkan mi o se rẹwẹsẹ?","marked":"Ọkàn mi ò ṣe rẹ̀wẹ̀sẹ̀?"},{"start":32.943,"end":34.004,"text":"Gbagbọ 'wọ o si kọ,","marked":"Gbàgbọ́ 'wọ ó sì kọ"},{"start":34.454,"end":35.599,"text":"Orin iyin s'Ọlọrun rẹ,","marked":"Orin ìyìn s'Ọlọ́run rẹ̀"},{"start":36.049,"end":37.0,"text":"Orisun ẹmi rẹ.","marked":"Orísun ẹ̀mí rẹ̀."}],"end":37.0}]}