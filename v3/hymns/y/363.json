{"v":3,"coll":"y","num":363,"id":"hymn_363","title":"EYIN wo ni tempili Re","duration":49.725,"voices":{"male":{"file":"y-363-male-v3.m4a","bytes":348646,"sha256":"f210174be70c6b1c1fed908774389b257c70316e272cf22de32ca0fe814469f4","duration":49.8},"female":{"file":"y-363-female-v3.m4a","bytes":359981,"sha256":"dc1f59feb2caffef4cd9d39d15895d7476914db8dab66add00d40f32d122c116","duration":49.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.568,"text":"ẸYIN wo ni tempili Rẹ,","marked":"Ẹ̀yin wo ni tẹmpili Rẹ̀"},{"start":2.018,"end":3.55,"text":"Oluwa t'a ti ń reti;","marked":"Olúwa t'a ti ń retí"},{"start":4.0,"end":5.448,"text":"Woli 'gbani ti sọ tẹlẹ;","marked":"Wòlí gbani ti sọ tẹ́lẹ̀"},{"start":5.898,"end":7.065,"text":"Ọlọrun m'ọrọ Rẹ sẹ;","marked":"Ọlọ́run m'ọ̀rọ̀ Rẹ sẹ́"},{"start":7.515,"end":8.898,"text":"Awọn ti a ti ra pada,","marked":"Àwọn tí a ti rà padà"},{"start":9.348,"end":10.474,"text":"Yoo fi ohun kan yin.","marked":"Yóò fi ohun kan yín."}],"end":10.474},{"key":"2","start":11.424,"lines":[{"start":11.424,"end":12.745,"text":"L'apa wundia iya Rẹ","marked":"L'apá wúńdíá ìyá Rẹ̀"},{"start":13.195,"end":14.655,"text":"Ẹ sa wo bi O ti sun,","marked":"Ẹ sá wo bí Ó ti sùn"},{"start":15.105,"end":16.709,"text":"Ti awọn alagba ni si ń sin,","marked":"Tí àwọn alàgbà ni sì ń sìn"},{"start":17.159,"end":18.445,"text":"Ki wọn to ku 'nu 'gbagbọ,","marked":"Kí wọn tó kú nù 'gbagbọ"},{"start":18.895,"end":20.65,"text":"Halleluya, Halleluya,","marked":"Hallelúyà, Hallelúyà"},{"start":21.1,"end":22.423,"text":"W'Ọlọrun Ọga Ogo.","marked":"W'Ọlọ́run Ọ̀gá Ògo."}],"end":22.423},{"key":"3","start":23.373,"lines":[{"start":23.373,"end":25.793,"text":"f Jesu, nipa ifihan Rẹ,","marked":"f Jésù, nípa ìfihàn Rẹ̀"},{"start":26.243,"end":27.528,"text":"O ti gba iya wa jẹ:","marked":"Ó ti gba ìyá wa jẹ́"},{"start":27.978,"end":29.847,"text":"Jọ, jẹ ka ri 'gbala nla Rẹ,","marked":"Jọ, jẹ́ ká rí gbàlà ńlá Rẹ"},{"start":30.297,"end":31.562,"text":"Mu 'leri Rẹ sẹ si wa,","marked":"Mú lérí Rẹ̀ sẹ̀ sí wa"},{"start":32.012,"end":33.348,"text":"Mu wa lọ sinu ogo Rẹ,","marked":"Mú wa lọ sínú ògo Rẹ"},{"start":33.798,"end":35.288,"text":"Sọdọ Baba Mimọ ni.","marked":"Sọ́dọ̀ Baba Mímọ́ ni."}],"end":35.288},{"key":"4","start":36.238,"lines":[{"start":36.238,"end":37.679,"text":"'Wọ Alade igbala wa,","marked":"'Wọ Aládé ìgbàlà wa"},{"start":38.129,"end":39.497,"text":"K'ifẹ Rẹ jẹ orin wa:","marked":"K'ìfẹ́ Rẹ jẹ́ orin wa"},{"start":39.947,"end":42.286,"text":"Jesu, Iwọ l'a fiyin fun,","marked":"Jésù, Ìwọ l'á fìyìn fún"},{"start":42.736,"end":44.187,"text":"Ni t'ayé t'O ra pada;","marked":"Ní t'ayé t'Ó rà padà"},{"start":44.637,"end":46.27,"text":"Pẹlu Baba ati Ẹmi,","marked":"Pẹ̀lú Baba àti Ẹ̀mí"},{"start":46.72,"end":48.175,"text":"Oluwa Ẹlẹda wa.","marked":"Olúwa Ẹlẹda wa."}],"end":48.175}]}