{"v":3,"coll":"y","num":470,"id":"hymn_470","title":"Om'Olorun a ko ri O","duration":68.119,"voices":{"male":{"file":"y-470-male-v3.m4a","bytes":505977,"sha256":"bbdba219c23b6d36b454243197e54463cbb3b2530a688cc413aad82f8119a515","duration":68.2},"female":{"file":"y-470-female-v3.m4a","bytes":515593,"sha256":"4d0676d486d5be49fe120f3daa8e575bdee3223181b13f3f62bdf9f1421b2bc2","duration":68.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.753,"text":"ỌM'ỌLỌRUN a ko ri Ọ,","marked":"Ọm'Ọlọ́run a kò rí Ọ"},{"start":2.203,"end":3.849,"text":"'Gba t'o wa s'ayé iku yi;","marked":"gbà t'ó wá s'ayé ikú yí"},{"start":4.299,"end":5.615,"text":"Awa ko ri ibugbe Rẹ,","marked":"Àwa kò rí ibùgbé Rẹ̀"},{"start":6.065,"end":7.865,"text":"Ni Nasareti ti a gan;","marked":"Ní Nasareti tí a gan"},{"start":8.315,"end":9.973,"text":"Sugbọn a gbagbọ p'esẹ Rẹ,","marked":"Sùgbọ́n a gbàgbọ́ p'esẹ̀ Rẹ"},{"start":10.423,"end":12.397,"text":"Ti tẹ ita rẹ kakiri.","marked":"Ti tẹ́ ìta rẹ̀ kákiri."}],"end":12.397},{"key":"2","start":13.347,"lines":[{"start":13.347,"end":14.863,"text":"A ko ri Ọ lori igi,","marked":"A kò rí Ọ lórí igi"},{"start":15.313,"end":16.429,"text":"T'eniyan buburu kan Ọ mọ,","marked":"T'ènìyàn búburú kan Ọ mọ̀"},{"start":16.879,"end":18.806,"text":"A ko gbọ igbe Rẹ, wi pé,","marked":"A kò gbọ́ igbe Rẹ̀, wí pé"},{"start":19.256,"end":21.197,"text":"Dariji won, tor' aimọ wọn","marked":"Dáríjì wọn, tọr àìmọ́ wọn"},{"start":21.647,"end":24.304,"text":"Sibẹ, a gbagbọ pe, 'ku Rẹ","marked":"Síbẹ̀, a gbàgbọ́ pé, kú Rẹ"},{"start":24.754,"end":26.755,"text":"Mi ayé, o si m'orun su.","marked":"Mi ayé, ó sì m'ọ̀run ṣú."}],"end":26.755},{"key":"3","start":27.705,"lines":[{"start":27.705,"end":28.912,"text":"A ko duro leti boji,","marked":"A kò dúró létí bojì"},{"start":29.362,"end":31.115,"text":"Nibi ti a gbe tẹ Ọ si;","marked":"Níbi tí a gbé tẹ́ Ọ sí"},{"start":31.565,"end":33.376,"text":"A ko joko 'nu yara ni,","marked":"A kò jókò nù yàrá ni"},{"start":33.826,"end":35.081,"text":"A ko ri Ọ loju ọna,","marked":"A kò rí Ọ lójú ọ̀nà"},{"start":35.531,"end":37.277,"text":"Sugbọn a gbagbọ p'angeli","marked":"Sùgbọ́n a gbàgbọ́ p'áńgẹ́lì"},{"start":37.727,"end":39.545,"text":"Wi pé, ―Iwọ ti ji dide.","marked":"Wí pé, ―Ìwọ ti jí dìde."}],"end":39.545},{"key":"4","start":40.495,"lines":[{"start":40.495,"end":42.163,"text":"A ko r'awọn wọnni t'o yan,","marked":"A kò r'àwọn wọ́nni t'ó yàn"},{"start":42.613,"end":44.1,"text":"Lati ri 'goke r'orun Rẹ;","marked":"Láti rí gòkè r'ọ̀run Rẹ"},{"start":44.55,"end":45.951,"text":"Wọn ko fi iyanu woke,","marked":"Wọn kò fi ìyanu wòkè"},{"start":46.401,"end":47.859,"text":"Wọn si f'ẹru dojubolẹ,","marked":"Wọ́n sì f'ẹ̀rù dojúbolẹ̀"},{"start":48.309,"end":50.327,"text":"Sugbọn a gbagbọ pe wọn ri Ọ,","marked":"Sùgbọ́n a gbàgbọ́ pé wọ́n rí Ọ"},{"start":50.777,"end":52.485,"text":"Bi O ti n goke lọ s'ọrun.","marked":"Bí Ó ti ń gòkè lọ s'ọ̀run."}],"end":52.485},{"key":"5","start":53.435,"lines":[{"start":53.435,"end":55.008,"text":"Iwọ n jọba l'oke loni,","marked":"Ìwọ ń jọba l'òkè lónì"},{"start":55.458,"end":56.87,"text":"'Wọ si n bukun awọn Tire,","marked":"'Wọ sì ń bùkún àwọn Tire"},{"start":57.32,"end":59.148,"text":"Imọlẹ ogo Rẹ ko tan,","marked":"Ìmọ́lẹ̀ ògo Rẹ̀ kò tán"},{"start":59.598,"end":61.233,"text":"Si aginju ayé wa yi,","marked":"Sí aginjù ayé wá yí"},{"start":61.683,"end":64.106,"text":"Sugbọn, a gba ọrọ Rẹ gbọ,","marked":"Sùgbọ́n, a gba ọ̀rọ̀ Rẹ̀ gbọ́"},{"start":64.556,"end":66.569,"text":"Jesu, Olurapada wa.","marked":"Jésù, Olùràpadà wa."}],"end":66.569}]}