{"v":3,"coll":"y","num":433,"id":"hymn_433","title":"OLUWA f'ise ran mi, Alleluya","duration":61.069,"voices":{"male":{"file":"y-433-male.m4a","bytes":450073,"sha256":"35374b98029c267c51a4134cce61a82ec3c1a6210c8ee40727f72346cd6141df","duration":61.1},"female":{"file":"y-433-female.m4a","bytes":464827,"sha256":"34618e92ff1f38336e11aa3533811c53b3b210270446d1983f1c930ac0df3f7b","duration":61.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.544,"text":"OLUWA f'ise ran mi, Alleluya","marked":"Olúwa f'iṣẹ́ rán mi, Allelúyà"},{"start":2.924,"end":4.337,"text":"Emi yio je 'se na fun O","marked":"Ẹ̀mí yío jẹ́ 'ṣe ná fún Ọ"},{"start":4.717,"end":7.308,"text":"O wa ninu oro Re, Alleluya","marked":"Ó wà nínú ọ̀rọ̀ Rẹ̀, Allelúyà"},{"start":7.688,"end":9.484,"text":"Wo Jesu nikansoso k'o ye.","marked":"Wo Jésù nìkanṣoṣo k'ó yé."}],"end":9.484},{"key":"CHORUS","start":10.434,"lines":[{"start":10.434,"end":11.912,"text":"Wo k'o ye ara mi ye","marked":"Wo k'ó yé ara mi yé"},{"start":12.292,"end":13.916,"text":"Bojuwo Jesu k'o ye,","marked":"Bọ́júwò Jésù k'ó yé"},{"start":14.296,"end":16.232,"text":"Ise l'a toke wa ni Alleluya","marked":"Iṣẹ́ l'á tòkè wà ní Allelúyà"},{"start":16.612,"end":18.645,"text":"E jek'a wo Jesu k'a si ye.","marked":"Ẹ jẹ́k'á wo Jésù k'á sì yé."}],"end":18.645},{"key":"2","start":19.595,"lines":[{"start":19.595,"end":22.362,"text":"Ise na kun fun ife, Alleluya","marked":"Iṣẹ́ nà kún fún ìfẹ́, Allelúyà"},{"start":22.742,"end":24.499,"text":"Fun enyin era ilu Eko,","marked":"Fún enyin ẹ̀rá ìlú Èkó"},{"start":24.879,"end":26.878,"text":"Ise lat'oke wa ni Alleluya","marked":"Iṣẹ́ lát'òkè wà ní Allelúyà"},{"start":27.258,"end":29.112,"text":"At'awon t'o wa n'ilu oke.","marked":"Àt'àwọn t'ó wà ń'ìlú òkè."}],"end":29.112},{"key":"3","start":30.062,"lines":[{"start":30.062,"end":32.851,"text":"Gbogbo Egbe agbaiye, Alleluya","marked":"Gbogbo Ẹgbẹ́ agbaiye, Allelúyà"},{"start":33.231,"end":34.879,"text":"Jesu nke tantan wipe ma bo","marked":"Jésù nke tantan wípé má bọ̀"},{"start":35.259,"end":37.77,"text":"Igbala l'ofe d'ode, Alleluya","marked":"Ìgbàlà l'ọ̀fẹ́ d'ọ̀dẹ̀, Allelúyà"},{"start":38.15,"end":39.813,"text":"Jek'ajuba Jesu k'a si ye.","marked":"Jẹ́k'ájúbà Jésù k'á sì yé."}],"end":39.813},{"key":"4","start":40.763,"lines":[{"start":40.763,"end":43.146,"text":"Jesu Olugbala wa, Alleluya","marked":"Jésù Olùgbàlà wa, Allelúyà"},{"start":43.526,"end":44.955,"text":"A f'ogo f'oruko Mimo Re","marked":"A f'ògo f'orúkọ Mímọ́́ Rẹ"},{"start":45.335,"end":47.049,"text":"Fun idasi wa loni, Alleluya","marked":"Fún ìdásí wa lónì, Allelúyà"},{"start":47.429,"end":48.991,"text":"Iyin fun Metalokan lailai.","marked":"Ìyìn fún Mẹ́talọ́kan láíláí."}],"end":48.991},{"key":"5","start":49.941,"lines":[{"start":49.941,"end":52.379,"text":"Kerubu on Serafu, Alleluya","marked":"Kérúbù on Séráfù, Allelúyà"},{"start":52.759,"end":54.671,"text":"E ja titi d'opin emi nyin;","marked":"Ẹ jà títí d'òpin èmi nyin"},{"start":55.051,"end":57.659,"text":"K'a le gba ade iye, Alleluya","marked":"K'á lè gba adé ìyè, Allelúyà"},{"start":58.039,"end":59.519,"text":"Lodo Baba loke lohun.","marked":"Lọ́dọ̀ Bàbá lókè lóhùn."}],"end":59.519}]}