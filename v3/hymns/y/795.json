{"v":3,"coll":"y","num":795,"id":"hymn_795","title":"AWA fe ohun aye yi","duration":41.893,"voices":{"male":{"file":"y-795-male-v3.m4a","bytes":289845,"sha256":"3a6e0e704d82fad5bce48e1be74e35dfc0bbc0513d77636984f75f04eb8d21dc","duration":41.9},"female":{"file":"y-795-female-v3.m4a","bytes":297414,"sha256":"c722ce383aa2779d2bced0738de7eaf7f958bb6c3b07eb32b7c893315fb865e6","duration":41.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.787,"text":"ÀWA fẹ ohun ayé yi,","marked":"Àwa fẹ́ ohun ayé yí"},{"start":2.237,"end":3.34,"text":"Wọn dara l'oju wa;","marked":"Wọ́n dára l'ojú wa"},{"start":3.79,"end":5.917,"text":"A fẹ k'a duro pẹ titi,","marked":"A fẹ́ k'á dúró pẹ́ títí"},{"start":6.367,"end":7.788,"text":"Laifi wọn silẹ lọ.","marked":"Láìfi wọn sílẹ̀ lọ."}],"end":7.788},{"key":"2","start":8.738,"lines":[{"start":8.738,"end":10.243,"text":"Nitori kini a n se bẹ?","marked":"Nítorí kíni à ń ṣe bẹ?"},{"start":10.693,"end":11.876,"text":"Ayé kan wa loke;","marked":"Ayé kan wà lókè"},{"start":12.326,"end":13.999,"text":"Nibẹ l'ẹsẹ oun buburu","marked":"Níbẹ̀ l'ẹsẹ̀ òun búburú"},{"start":14.449,"end":15.556,"text":"Ati ewu ko si.","marked":"Àti ewu kò sí."}],"end":15.556},{"key":"3","start":16.506,"lines":[{"start":16.506,"end":17.808,"text":"Ayé t'o wa loke ọrun,","marked":"Ayé t'ó wà lókè ọ̀run"},{"start":18.258,"end":19.361,"text":"Awa iba jẹ mọ!","marked":"Àwa ìbá jẹ́ mọ́!"},{"start":19.811,"end":21.818,"text":"Ayọ, ifẹ inu rere,","marked":"Ayọ̀, ìfẹ́ inú rere"},{"start":22.268,"end":23.544,"text":"Gbogbo rẹ wa n'bẹ.","marked":"Gbogbo rẹ̀ wà n'bẹ."}],"end":23.544},{"key":"4","start":24.494,"lines":[{"start":24.494,"end":26.444,"text":"Iku, o wa ni ayé yi;","marked":"Ikú, ó wà ní ayé yí"},{"start":26.894,"end":28.068,"text":"Ko si loke ọrun;","marked":"Kò sì lókè ọ̀run"},{"start":28.518,"end":29.626,"text":"Eniyan Ọlọrun wa mbẹ,","marked":"Ènìyàn Ọlọ́run wá mbẹ́"},{"start":30.076,"end":31.415,"text":"Ni aye, ni aiku.","marked":"Ní ayé, ní àìkú."}],"end":31.415},{"key":"5","start":32.365,"lines":[{"start":32.365,"end":34.214,"text":"K'a ba ọna ti Jesu lọ,","marked":"K'á bá ọ̀nà tí Jésù lọ"},{"start":34.664,"end":35.989,"text":"Eyi t'O la fun wa;","marked":"Èyí t'Ó là fún wa"},{"start":36.439,"end":38.652,"text":"Sibi rere, sibi 'sinmi,","marked":"Ṣíbí rere, síbi sinmi"},{"start":39.102,"end":40.344,"text":"S'ile Ọlọrun wa.","marked":"S'ilé Ọlọ́run wa."}],"end":40.344}]}