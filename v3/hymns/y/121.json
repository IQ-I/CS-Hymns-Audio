{"v":3,"coll":"y","num":121,"id":"hymn_121","title":"F'ORUK' Olorun loke","duration":34.429,"voices":{"male":{"file":"y-121-male-v3.m4a","bytes":233952,"sha256":"21573922a58f25dccae55544ead632ee85da46406a659f9493ba79581ad8ed7c","duration":34.5},"female":{"file":"y-121-female-v3.m4a","bytes":241678,"sha256":"50dc5dcdf6f547daadb28bee565a68aac4e7767dfa0164584dced49fe1cbc471","duration":34.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.824,"text":"F'ORUK' Olorun loke","marked":"F'Orúk Ọlọ́run lókè"},{"start":2.274,"end":3.808,"text":"T'O l'agbara at'ola","marked":"T'Ó l'agbára àt'ọlá"},{"start":4.258,"end":5.332,"text":"Olorun ibi gbogbo","marked":"Ọlọ́run ibi gbogbo"},{"start":5.782,"end":7.187,"text":"N'iyin ati ogo wa","marked":"N'ìyìn àti ògo wà"}],"end":7.187},{"key":"2","start":8.137,"lines":[{"start":8.137,"end":9.644,"text":"F'oruko Krist' Oluwa","marked":"F'orúkọ Krist Olúwa"},{"start":10.094,"end":11.496,"text":"Om' Olorun ti a bi","marked":"Ọm Ọlọ́run tí a bí"},{"start":11.946,"end":13.295,"text":"Krist' t'O da ohun gbogbo","marked":"Krist t'Ó dá ohun gbogbo"},{"start":13.745,"end":15.46,"text":"Ni k'a san 'yin ailopin.","marked":"Ní k'á san yín àìlópin."}],"end":15.46},{"key":"3","start":16.41,"lines":[{"start":16.41,"end":17.524,"text":"F'Olorun Emi Mimo","marked":"F'Ọlọ́run Ẹ̀mí Mímọ́"},{"start":17.974,"end":19.364,"text":"Ni k'iyin pipe wa lae","marked":"Ní k'ìyìn pípẹ́ wà láé"},{"start":19.814,"end":21.295,"text":"Pelu baba at'Omo","marked":"Pẹ̀lú Baba àt'ọmọ"},{"start":21.745,"end":23.282,"text":"Okan l'oruko, l'ogo.","marked":"Ọkàn l'orúkọ, l'ògo."}],"end":23.282},{"key":"4","start":24.232,"lines":[{"start":24.232,"end":25.781,"text":"Orin t'a ti ko koja","marked":"Orin t'á tí kò kọjá"},{"start":26.231,"end":28.06,"text":"T'ao si ma ko lae leyi","marked":"T'áò sì má kọ́ láé léyí"},{"start":28.51,"end":29.947,"text":"Ki awon iran ti mbo","marked":"Kí àwọn ìran ti mbọ̀"},{"start":30.397,"end":31.782,"text":"Dapo korin didun na.","marked":"Dàpọ̀ kọrin dídùn ná."},{"start":32.232,"end":32.88,"text":"Amin.","marked":"Àmín."}],"end":32.88}]}