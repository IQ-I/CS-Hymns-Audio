{"v":3,"coll":"y","num":702,"id":"hymn_702","title":"AJODUN wa l'a n se","duration":57.084,"voices":{"male":{"file":"y-702-male-v3.m4a","bytes":384456,"sha256":"b5aa0423b120647843fe4dd79513624de465d7d9667cbe6b19cb01ebe6e61a7f","duration":57.1},"female":{"file":"y-702-female-v3.m4a","bytes":408408,"sha256":"3644ca84a07783d9295e412fa25b2cac6f8cceac5da67e56ed9b6186f5cbbf80","duration":57.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.855,"text":"AJỌDUN wa l'a n se,","marked":"Àjọ̀dún wa l'á ń ṣe"},{"start":2.305,"end":3.37,"text":"Aw'Ẹgbẹ Séráfù,","marked":"Àw'Ẹgbẹ́ Séráfù"},{"start":3.82,"end":5.266,"text":"Ajọdun wa l'a n se,","marked":"Àjọ̀dún wa l'á ń ṣe"},{"start":5.716,"end":6.933,"text":"Aw' Ẹgbẹ Kérúbù.","marked":"Àw Ẹgbẹ́ Kérúbù."}],"end":6.933},{"key":"CHORUS","start":7.883,"lines":[{"start":7.883,"end":9.568,"text":"Arakunrin, Arabinrin","marked":"Arákùnrin, Arábìnrin"},{"start":10.018,"end":11.938,"text":"E ku odun, e ku 'yedun.","marked":"Ẹ kú ọdún, ẹ kú yẹ̀dùn."}],"end":11.938},{"key":"2","start":12.888,"lines":[{"start":12.888,"end":14.35,"text":"Kérúbù t'ayé yi,","marked":"Kérúbù t'ayé yí"},{"start":14.8,"end":15.929,"text":"O fẹrẹ d'igi nla,","marked":"Ó fẹ́rẹ̀ d'igi ńlá"},{"start":16.379,"end":17.955,"text":"Séráfù t'ayé yi,","marked":"Séráfù t'ayé yí"},{"start":18.405,"end":19.815,"text":"Ko le sai tan kiri.","marked":"Kò lè ṣàì tán kiri."}],"end":19.815},{"key":"3","start":20.765,"lines":[{"start":20.765,"end":21.857,"text":"K'Ọlọrun b'asiri,","marked":"K'Ọlọ́run b'àṣírí"},{"start":22.307,"end":23.265,"text":"Fun ọmọ Ẹgbẹ wa;","marked":"Fún ọmọ Ẹgbẹ́ wa"},{"start":23.715,"end":24.91,"text":"K'ẹnikan ma rahun,","marked":"K'ẹnìkan má ráhùn"},{"start":25.36,"end":26.665,"text":"Lati ri Ounjẹ jẹ.","marked":"Láti rí Oúnjẹ jẹ́."}],"end":26.665},{"key":"4","start":27.615,"lines":[{"start":27.615,"end":28.794,"text":"Ki esu ma ri wa,","marked":"Kí èṣù má rí wa"},{"start":29.244,"end":30.134,"text":"At'ẹni buburu,","marked":"Àt'ẹni búburú"},{"start":30.584,"end":32.424,"text":"Ajẹ, oso, n se lasan,","marked":"Àjẹ́, ọ̀ṣọ́, ń ṣe lásán"},{"start":32.874,"end":34.202,"text":"Lor' Ẹgbẹ Séráfù.","marked":"Lór Ẹgbẹ́ Séráfù."}],"end":34.202},{"key":"5","start":35.152,"lines":[{"start":35.152,"end":36.247,"text":"Ẹmi airi n sọ wa,","marked":"Ẹ̀mí àìrí ń sọ wá"},{"start":36.697,"end":37.715,"text":"K'a ma ri ijọgbọn,","marked":"K'á má rí ìjọgbọ́n"},{"start":38.165,"end":39.254,"text":"Mase f'aye silẹ,","marked":"Máṣe f'ayé sílẹ̀"},{"start":39.704,"end":40.993,"text":"Lati ma gbadura.","marked":"Láti má gbàdúrà."}],"end":40.993},{"key":"6","start":41.943,"lines":[{"start":41.943,"end":42.896,"text":"Ohun buburu kan,","marked":"Ohun búburú kan"},{"start":43.346,"end":44.446,"text":"Ko ri wa gbe se mọ,","marked":"Kò rí wa gbé ṣe mọ́"},{"start":44.896,"end":46.256,"text":"Gbogb' Ẹgbẹ agbayé,","marked":"Gbogb Ẹgbẹ́ agbayé"},{"start":46.706,"end":48.128,"text":"K'a s'otitọ d'opin.","marked":"K'á s'òtítọ́ d'òpin."}],"end":48.128},{"key":"7","start":49.078,"lines":[{"start":49.078,"end":50.354,"text":"K'a n'ife ara wa","marked":"K'á n'ìfẹ́ ara wa"},{"start":50.804,"end":52.102,"text":"K'okan wa k'o sokan","marked":"K'ọkàn wa k'ó ṣọ̀kan"},{"start":52.552,"end":53.907,"text":"K'a le ri 'bukun gba","marked":"K'á lè rí bùkún gbà"},{"start":54.357,"end":55.535,"text":"'Bukun lopolopo.","marked":"bùkún lọ́pọ̀lọpọ̀."}],"end":55.535}]}