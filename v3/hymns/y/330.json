{"v":3,"coll":"y","num":330,"id":"hymn_330","title":"A mu ileri se","duration":24.84,"voices":{"male":{"file":"y-330-male-v3.m4a","bytes":164240,"sha256":"7484dd6a0c4bfdba54b188ec64688b19aad466752f04b60b1cb8ed99b5683ce7","duration":24.9},"female":{"file":"y-330-female-v3.m4a","bytes":172529,"sha256":"c74f4857bd224494726bad7c5eeab3bc9aba8d9d47f2be581675304aa3fa1276","duration":24.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.547,"text":"A mu ileri se","marked":"A mú ìlérí ṣe"},{"start":1.997,"end":3.049,"text":"Ise 'gbala pari","marked":"Iṣẹ́ gbàlà parí"},{"start":3.499,"end":5.024,"text":"Oto at'anu di ore","marked":"Ọ̀tọ̀ àt'anú di ọrẹ"},{"start":5.474,"end":6.801,"text":"Om'Olorun jinde.","marked":"Ọm'ọlọ́run jíǹde."}],"end":6.801},{"key":"2","start":7.751,"lines":[{"start":7.751,"end":9.031,"text":"Ọkan mi yin Jesu.","marked":"Ọkàn mi yin Jésù."},{"start":9.481,"end":10.638,"text":"T'O ru gbogbo ẹsẹ rẹ,","marked":"T'Ó rú gbogbo ẹsẹ̀ rẹ̀"},{"start":11.088,"end":12.634,"text":"T'O ku f'ẹsẹ gbogbo ayé;","marked":"T'Ó kú f'ẹsẹ̀ gbogbo ayé"},{"start":13.084,"end":14.927,"text":"O wa, k'O ma ku mọ.","marked":"Ó wà, k'Ó má kú mọ́."}],"end":14.927},{"key":"3","start":15.877,"lines":[{"start":15.877,"end":16.986,"text":"Iku Rẹ ra 'sinmi:","marked":"Ikú Rẹ̀ rà sinmi"},{"start":17.436,"end":19.024,"text":"Fun ọ, l'O ji dide;","marked":"Fún ọ, l'Ó jí dìde"},{"start":19.474,"end":21.57,"text":"Gbagbọ, gba ẹkun 'dariji,","marked":"Gbàgbọ́, gba ẹkún dáríjì"},{"start":22.02,"end":23.29,"text":"T'a sa l'ami ẹjẹ.","marked":"T'á sá l'àmì ẹ̀jẹ̀."}],"end":23.29}]}