{"v":3,"coll":"y","num":492,"id":"hymn_492","title":"JESU, 'Wo n'ibi sadi mi","duration":62.811,"voices":{"male":{"file":"y-492-male-v3.m4a","bytes":450022,"sha256":"49eb3abeb9a39e9affef3e8c400fb0d89e38d7987d2106f11706a9d8a2655452","duration":62.9},"female":{"file":"y-492-female-v3.m4a","bytes":467838,"sha256":"ad07ad4a796d72570b4053ab9e4c6b2c665ec93bed428fc5c82b47d6d0f12432","duration":62.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.595,"text":"JESU, 'Wọ n'ibi sadi mi,","marked":"Jésù, 'Wọ n'ibi sádi mi"},{"start":3.045,"end":4.404,"text":"'Wọ ni mo gbẹkẹle;","marked":"'Wọ ni mo gbẹ́kẹ̀lé"},{"start":4.854,"end":6.088,"text":"Ọrọ Rẹ n'iranlọwọ mi;","marked":"Ọ̀rọ̀ Rẹ n'ìrànlọ́wọ́ mi"},{"start":6.538,"end":7.553,"text":"Emi alailera;","marked":"Èmi aláìlera"},{"start":8.003,"end":9.715,"text":"N ko ni ẹjọ kan lati ro,","marked":"N kò ní ẹjọ́ kan láti rò"},{"start":10.165,"end":11.507,"text":"Ko s'ohun ti n ó wi,","marked":"Kò s'ohun tí n ó wí"},{"start":11.957,"end":13.773,"text":"Eyi to, pe Jesu mi ku,","marked":"Èyí tó, pé Jésù mi kú"},{"start":14.223,"end":15.558,"text":"Jesu mi ku fun mi.","marked":"Jésù mi kú fún mi."}],"end":15.558},{"key":"2","start":16.508,"lines":[{"start":16.508,"end":17.729,"text":"Igba iji 'danwo ba n ja,","marked":"Ìgbà ìjì dánwò bá ń jà"},{"start":18.179,"end":19.312,"text":"T'ọta n dojukọ mi,","marked":"T'ọ̀tá ń dojúkọ mi"},{"start":19.762,"end":21.627,"text":"Itẹ anu n'isadi mi,","marked":"Ìtẹ́ àánú n'ìsádi mi"},{"start":22.077,"end":23.167,"text":"Nibẹ n'ireti mi,","marked":"Níbẹ̀ n'ìrètí mi"},{"start":23.617,"end":25.569,"text":"Ọkan mi yoo sa tọ Ọ wa,","marked":"Ọkàn mi yóò sá tọ̀ Ọ́ wá"},{"start":26.019,"end":27.109,"text":"'Gba 'banujẹ ba de;","marked":"gba 'banujẹ bá dé"},{"start":27.559,"end":28.848,"text":"Ayọ ọkan mi l'eyi pe,","marked":"Ayọ̀ ọkàn mi l'èyí pé"},{"start":29.298,"end":30.632,"text":"Jesu mi ku fun mi.","marked":"Jésù mi kú fún mi."}],"end":30.632},{"key":"3","start":31.582,"lines":[{"start":31.582,"end":32.855,"text":"Larin iyọnu t'o wuwo;","marked":"Lárin ìyọnu t'ó wúwo"},{"start":33.305,"end":34.484,"text":"T'eniyan ko le gba;","marked":"T'ènìyàn kò lè gbà"},{"start":34.934,"end":36.187,"text":"Larin ibanujẹ ọkan,","marked":"Lárin ìbànújẹ́ ọkàn"},{"start":36.637,"end":37.696,"text":"Ati 'rora ara ;","marked":"Àti rora ara"},{"start":38.146,"end":39.888,"text":"Kil'o le funni n'isinmi,","marked":"Kíl'ó lè fúnni n'ìsinmi"},{"start":40.338,"end":41.638,"text":"Ati suru b'eyi?","marked":"Àti sùrù b'èyí?"},{"start":42.088,"end":43.565,"text":"T'o n s'eleri l'ọkan mi pe,","marked":"T'ó ń s'ẹlẹ́rí l'ọkàn mi pé"},{"start":44.015,"end":45.403,"text":"Jesu mi ku fun mi.","marked":"Jésù mi kú fún mi."}],"end":45.403},{"key":"4","start":46.353,"lines":[{"start":46.353,"end":47.705,"text":"'Gba ohun Rẹ ba si pasẹ,","marked":"gba ohun Rẹ bá sì pàsẹ"},{"start":48.155,"end":49.458,"text":"K'ara yi dibajẹ,","marked":"K'ara yí díbàjẹ́"},{"start":49.908,"end":51.474,"text":"Ti ẹmi mi, b'isan omi,","marked":"Ti ẹ̀mí mi, b'ìṣàn omi"},{"start":51.924,"end":53.291,"text":"Ba si san kọja lọ,","marked":"Bá sì san kọjá lọ"},{"start":53.741,"end":55.082,"text":"B'ohun mi ko tilẹ jalẹ,","marked":"B'ohùn mi kò tilẹ̀ jálẹ̀"},{"start":55.532,"end":57.021,"text":"Nigba naa, Oluwa,","marked":"Nígbà náà, Olúwa"},{"start":57.471,"end":59.441,"text":"Fun mi n'ipa ki n le wi pé,","marked":"Fún mi n'ipa kí n lè wí pé"},{"start":59.891,"end":61.261,"text":"Jesu mi ku fun mi.","marked":"Jésù mi kú fún mi."}],"end":61.261}]}