{"v":3,"coll":"y","num":467,"id":"hymn_467","title":"OHUN ogo Re l'a n royin","duration":49.755,"voices":{"male":{"file":"y-467-male-v3.m4a","bytes":359495,"sha256":"425a1a8bdcd9bfa31ee1267ac6bb652064014e6f6519b904845235b58456d338","duration":49.8},"female":{"file":"y-467-female-v3.m4a","bytes":373246,"sha256":"43b78a2cefb06af2f6b85db23fa31f618c0df16b12dc557685d944083aa10648","duration":49.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.768,"text":"OHUN ogo Rẹ l'a ń royin,","marked":"Ohun ògo Rẹ̀ l'à ń ròyìn"},{"start":2.218,"end":3.882,"text":"Sion, ti Ọlọrun wa:","marked":"Sion, tí Ọlọ́run wà"},{"start":4.332,"end":6.328,"text":"Ọrọ ẹni t'a ko le yẹ,","marked":"Ọ̀rọ̀ ẹni t'á kò lè yẹ"},{"start":6.778,"end":8.476,"text":"Se o yẹ fun 'bugbe Rẹ,","marked":"Ṣé ó yẹ fún bùgbé Rẹ"},{"start":8.926,"end":10.454,"text":"L'ori apat' ayérayé,","marked":"L'orí àpát ayérayé"},{"start":10.904,"end":11.992,"text":"Kini le mi 'sinmi rẹ?","marked":"Kíni lè mi sinmi rẹ?"},{"start":12.442,"end":13.88,"text":"A f'odi 'gbala yi ọ ka,","marked":"A f'òdì gbàlà yí ọ ká"},{"start":14.33,"end":15.556,"text":"K'o le ma rin ọta rẹ.","marked":"K'ó lè má rin ọ̀tá rẹ̀."}],"end":15.556},{"key":"2","start":16.506,"lines":[{"start":16.506,"end":18.106,"text":"Wo! ipado omi iye,","marked":"Wò! ipadò omi ìyè"},{"start":18.556,"end":20.029,"text":"Nt' ifẹ Ọlọrun sun wa,","marked":"Ǹt ìfẹ́ Ọlọ́run sùn wá"},{"start":20.479,"end":22.071,"text":"O to fun gbogbo Ọmọ rẹ,","marked":"Ó tó fún gbogbo Ọmọ rẹ̀"},{"start":22.521,"end":23.884,"text":"Ẹru aini ko si mọ;","marked":"Ẹ̀rù àìní kò sì mọ̀"},{"start":24.334,"end":26.743,"text":"Tal'o le re, 'gba odo na,","marked":"Tál'ó lè rẹ̀, gba odò ná"},{"start":27.193,"end":28.692,"text":"Ba ń san t'o le poungbẹ rẹ?","marked":"Bá ń sàn t'ó lè pòùngbẹ rẹ̀?"},{"start":29.142,"end":30.257,"text":"Or'ọfẹ Olodumare,","marked":"Or'ọ̀fẹ́ Olódùmarè"},{"start":30.707,"end":32.302,"text":"Ki yẹ lat' irandiran.","marked":"Kí yẹ lát ìrandíran."}],"end":32.302},{"key":"3","start":33.252,"lines":[{"start":33.252,"end":34.511,"text":"Ara Sion alabukun,","marked":"Ara Sion alábùkún"},{"start":34.961,"end":36.03,"text":"T'o f'ẹjẹ Oluwa wẹ;","marked":"T'ó f'ẹ̀jẹ̀ Olúwa wẹ"},{"start":36.48,"end":38.679,"text":"Jesu ti wọn ti ń gbẹkẹle,","marked":"Jésù tí wọ́n ti ń gbẹ́kẹ̀lé"},{"start":39.129,"end":40.826,"text":"Sọ wọn d'Ọba, woli Rẹ,","marked":"Sọ wọ́n d'Ọba, wòlí Rẹ"},{"start":41.276,"end":42.829,"text":"Sisa l'ohun afẹ ayé,","marked":"Sísá l'ohun afẹ́ ayé"},{"start":43.279,"end":44.389,"text":"Pẹlu ogo asan rẹ","marked":"Pẹ̀lú ògo asán rẹ̀"},{"start":44.839,"end":46.456,"text":"Isura totọ at'ayọ,","marked":"Ìṣúra tótọ̀ àt'ayọ̀"},{"start":46.906,"end":48.205,"text":"Kik' ọmọ Sion l'o mọ.","marked":"Kík ọmọ Sion l'ó mọ́."}],"end":48.205}]}