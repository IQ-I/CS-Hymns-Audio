{"v":3,"coll":"y","num":415,"id":"hymn_415","title":"WAKATI adura didun!","duration":66.485,"voices":{"male":{"file":"y-415-male-v3.m4a","bytes":494418,"sha256":"c03b505de6ef7137f9bb1c6d3804e6e78438865a686bf1d47b5dd93262e93404","duration":66.5},"female":{"file":"y-415-female-v3.m4a","bytes":516040,"sha256":"e49487ff984fb5e9b1caf1b1e8f74a570a5d2042f7eb783b5cdb7c7cf7c59eab","duration":66.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.776,"text":"WAKATI adura didun!","marked":"Wákàtí àdúrà dídùn!"},{"start":2.226,"end":3.961,"text":"T'o gbe mi lo kuro l'aiye","marked":"T'ó gbé mi lọ kúrò l'ayé"},{"start":4.411,"end":5.644,"text":"Lo'waju ite Baba mi","marked":"Lọ́'wájú ìtẹ́ Baba mi"},{"start":6.094,"end":7.421,"text":"Ki nso gbogbo edun mi fun","marked":"Kí ńṣọ́ gbogbo ẹ̀dùn mi fún"},{"start":7.871,"end":9.39,"text":"Nigba 'banuje at'aro","marked":"Nígbà banújẹ́ àt'arọ"},{"start":9.84,"end":11.21,"text":"Adua l'abo fun okan mi","marked":"Àdùà l'abo fún ọkàn mi"},{"start":11.66,"end":13.005,"text":"Emi si bo lowo Esu","marked":"Èmi sì bọ́ lọ́wọ́ Èṣù"},{"start":13.455,"end":15.159,"text":"'Gbati mo ba gb'adua didun","marked":"gbàtí mo bá gb'àdùà dídùn"},{"start":15.609,"end":16.91,"text":"Emi si bo lowo Esu","marked":"Èmi sì bọ́ lọ́wọ́ Èṣù"},{"start":17.36,"end":19.049,"text":"'Gbati mo ba gb'adua didun.","marked":"gbàtí mo bá gb'àdùà dídùn."}],"end":19.049},{"key":"2","start":19.999,"lines":[{"start":19.999,"end":21.518,"text":"WAKATI adura didun!","marked":"Wákàtí àdúrà dídùn!"},{"start":21.968,"end":23.511,"text":"Iye re y'o gbe ebe mi","marked":"Iye rẹ̀ y'ó gbé ẹ̀bẹ̀ mi"},{"start":23.961,"end":26.073,"text":"Lo sod'Enit' o se 'leri","marked":"Lọ sọd'enit ó ṣe lérí"},{"start":26.523,"end":28.142,"text":"Lati bukun okan adua","marked":"Láti bùkún ọkàn àdúà"},{"start":28.592,"end":30.929,"text":"B'O ti ko mi, ki nwoju Re","marked":"B'Ó ti kọ̀ mi, kí nwọ́jú Rẹ"},{"start":31.379,"end":33.69,"text":"Ki ngbekele, ki nsi gbagbo","marked":"Kí ńgbẹ́kẹ̀lé, kí ńsì gbàgbọ́"},{"start":34.14,"end":35.493,"text":"Ngo ko gbogb'aniyan mi le","marked":"Ngọ́ kó gbogb'àníyàn mi lé"},{"start":35.943,"end":37.662,"text":"Ni akoko adua didun","marked":"Ní àkókò àdúà dídùn"},{"start":38.112,"end":39.523,"text":"Ngo ko gbogb'aniyan mi le","marked":"Ngọ́ kó gbogb'àníyàn mi lé"},{"start":39.973,"end":41.842,"text":"Ni akoko adua didun.","marked":"Ní àkókò àdúà dídùn."}],"end":41.842},{"key":"3","start":42.792,"lines":[{"start":42.792,"end":44.226,"text":"WAKATI adura didun!","marked":"Wákàtí àdúrà dídùn!"},{"start":44.676,"end":45.994,"text":"Jeki nma r'itunu re gba","marked":"Jẹ́kí ńmá r'ìtùnú rẹ̀ gbà"},{"start":46.444,"end":48.121,"text":"Titi ngo fi d'oke Pisga","marked":"Títí ńgò fi d'òkè Pisga"},{"start":48.571,"end":49.996,"text":"T ngo r'ile mi l'okere","marked":"T ńgọ́ r'ilẹ̀ mi l'òkèrè"},{"start":50.446,"end":52.087,"text":"Ngo bo ago ara sile","marked":"Ngo bo àgọ́ ara sílẹ̀"},{"start":52.537,"end":54.211,"text":"Ngo gba ere ainipekun","marked":"Ngo gba èrè àìnípẹ̀kun"},{"start":54.661,"end":56.664,"text":"Ngo korin bi mo ti nfo lo","marked":"Ǹgọ́ kọrin bí mo ti ńfọ̀ lọ"},{"start":57.114,"end":59.471,"text":"Odigbose! adua didun,","marked":"Odigbòṣẹ́! àdúà dídùn"},{"start":59.921,"end":62.22,"text":"Ngo korin bi mo ti nfo lo","marked":"Ǹgọ́ kọrin bí mo ti ńfọ̀ lọ"},{"start":62.67,"end":64.936,"text":"Odigbose! adua didun.","marked":"Odigboṣẹ́! àdúà dídùn."}],"end":64.936}]}