{"v":3,"coll":"y","num":235,"id":"hymn_235","title":"MO ri ayo n'nu banuje","duration":68.088,"voices":{"male":{"file":"y-235-male-v3.m4a","bytes":477656,"sha256":"62214442fc18dd19bc5f7702324125e0d85d57d59ffeb9438a16127c6812fc25","duration":68.1},"female":{"file":"y-235-female-v3.m4a","bytes":497279,"sha256":"7cb687699ec4bd63091430b2b695049d78a4e310ac58ef6715707be5c1135ab3","duration":68.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.839,"text":"MO ri ayọ n'nu 'banujẹ,","marked":"Mo rí ayọ̀ n'nú 'banujẹ"},{"start":2.289,"end":3.428,"text":"Ogun fun irora;","marked":"Ogun fún ìrora"},{"start":3.878,"end":5.472,"text":"Mo r'ọjọ nla t'o dara,","marked":"Mo r'ọjọ́ ńlá t'ó dára"},{"start":5.922,"end":6.981,"text":"T'o ran lẹhin ojo;","marked":"T'ó rán lẹ́hìn ọjọ́"},{"start":7.431,"end":8.589,"text":"Mo r'ẹka 'mularada,","marked":"Mo r'ẹ̀ka múláradá"},{"start":9.039,"end":10.443,"text":"Nibi isun ki ikoro.","marked":"Níbi ìsun kí ìkorò."},{"start":10.893,"end":12.841,"text":"Ileri jẹjẹ t' a se )","marked":"Ìlérí jẹ́jẹ́ t a ṣe"},{"start":13.291,"end":14.424,"text":"Fun ẹni ti n jaya )2ce","marked":"Fún ẹni tí ń jáyà"}],"end":14.424},{"key":"CHORUS","start":15.374,"lines":[{"start":15.374,"end":16.899,"text":"lleri jeje t'a se","marked":"Ìlérí jẹ́jẹ́ t'á ṣe"},{"start":17.349,"end":18.712,"text":"Fun eniti njaya,","marked":"Fún ẹnìtì ńjayà"},{"start":19.162,"end":20.773,"text":"lleri jeje t'a se","marked":"Ìlérí jẹ́jẹ́ t'á ṣe"},{"start":21.223,"end":22.431,"text":"Fun eniti njaya.","marked":"Fún ẹnìtì ńjayà."}],"end":22.431},{"key":"2","start":23.381,"lines":[{"start":23.381,"end":24.471,"text":"Ninu irin ajo mi,","marked":"Nínú irin àjọ mi"},{"start":24.921,"end":26.264,"text":"Mo ba Jesu pade;","marked":"Mo bá Jésù pàdé"},{"start":26.714,"end":27.759,"text":"Ti o f'ọkan mi balẹ,","marked":"Tí ó f'ọkàn mi balẹ̀"},{"start":28.209,"end":29.403,"text":"Lati ri anu gba;","marked":"Láti rí àánú gbà"},{"start":29.853,"end":31.217,"text":"Anu ti n ko le gbagbe,","marked":"Àánú tí n kò lè gbàgbé"},{"start":31.667,"end":32.99,"text":"If'aya balẹ nla.","marked":"Ìf'àyà balẹ̀ ńlá."},{"start":33.44,"end":35.483,"text":"Ileri jẹjẹ t' a se )","marked":"Ìlérí jẹ́jẹ́ t a ṣe"},{"start":35.933,"end":37.109,"text":"Fun ẹni ti n jaya )2ce","marked":"Fún ẹni tí ń jáyà"}],"end":37.109},{"key":"3","start":38.059,"lines":[{"start":38.059,"end":39.368,"text":"Mo ti ri sinu ẹsẹ;","marked":"Mo ti rí sínú ẹsẹ̀"},{"start":39.818,"end":40.896,"text":"Fitila mi ku tan;","marked":"Fìtílà mi kú tán"},{"start":41.346,"end":42.514,"text":"Nipa anu Ọlọrun,","marked":"Nípa àánú Ọlọ́run"},{"start":42.964,"end":44.444,"text":"Mo d'ẹni ti n sọji;","marked":"Mo d'ẹni tí ń sọjí"},{"start":44.894,"end":45.995,"text":"Anu rẹ ra mi pada,","marked":"Àánú rẹ̀ rà mí padà"},{"start":46.445,"end":47.733,"text":"O fi ireti fun mi","marked":"Ó fi ìrètí fún mi"},{"start":48.183,"end":49.831,"text":"Ileri jẹjẹ t' a se )","marked":"Ìlérí jẹ́jẹ́ t a ṣe"},{"start":50.281,"end":51.37,"text":"Fun ẹni ti n jaya )2ce","marked":"Fún ẹni tí ń jáyà"}],"end":51.37},{"key":"4","start":52.32,"lines":[{"start":52.32,"end":53.53,"text":"Ẹyin Ijọ Serafu","marked":"Ẹ̀yin Ìjọ Séráfù"},{"start":53.98,"end":54.678,"text":"Ẹ jọ ma","marked":"Ẹ jọ má"},{"start":55.128,"end":57.14,"text":"jafara E je ka damure","marked":"jáfara Ẹ jẹ́ ká dàmúrè"},{"start":57.59,"end":58.956,"text":"wa K'ina wa si ma","marked":"wá K'iná wa sì má"},{"start":59.406,"end":60.606,"text":"tan Amure ko gbodo","marked":"tan Àmùrè kò gbọdọ̀"},{"start":61.056,"end":62.176,"text":"tu Ina ko gbodo","marked":"tú Iná kò gbọdọ̀"},{"start":62.626,"end":64.211,"text":"ku Ileri jeje t'a se","marked":"kú Ìlérí jẹ́jẹ́ t'á ṣe"},{"start":64.661,"end":65.29,"text":") Fun ẹni","marked":"Fún ẹni"},{"start":65.74,"end":66.539,"text":"ti n jaya )2ce","marked":"tí ń jáyà"}],"end":66.539}]}