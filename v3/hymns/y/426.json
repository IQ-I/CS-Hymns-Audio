{"v":3,"coll":"y","num":426,"id":"hymn_426","title":"lWO lsun imole","duration":84.933,"voices":{"male":{"file":"y-426-male-v3.m4a","bytes":592516,"sha256":"7acc943ecade11a9e1fb5430ac79ff172ad4aba3d117240de7b9e9de343ecf92","duration":85.0},"female":{"file":"y-426-female-v3.m4a","bytes":605290,"sha256":"f0b4c454b2da1fe4ac2c1b416d59b2b34c3080582d9ff6c7d6b9b408774281c5","duration":85.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.538,"text":"lWO lsun imole","marked":"Ìwọ Ìsun ìmọ́lẹ̀"},{"start":1.988,"end":3.257,"text":"Ogo ti ko l'okunkun","marked":"Ògo tí kò l'òkùnkùn"},{"start":3.707,"end":5.384,"text":"Aiyeraiye, titi lai","marked":"Ayérayé, títí láì"},{"start":5.834,"end":7.668,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":7.668},{"key":"2","start":8.618,"lines":[{"start":8.618,"end":10.084,"text":"Kanga iye ti nsan lai","marked":"Kànga ìyè ti ńṣàn láì"},{"start":10.534,"end":11.709,"text":"Iye ti ko l'abawon","marked":"Iye tí kò l'àbàwọ́n"},{"start":12.159,"end":13.324,"text":"Iye to ni irora","marked":"Iye tó ní ìrora"},{"start":13.774,"end":15.677,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":15.677},{"key":"3","start":16.627,"lines":[{"start":16.627,"end":17.881,"text":"Olubukun Olufe","marked":"Olùbùkún Olùfẹ́"},{"start":18.331,"end":19.545,"text":"Omo Re mbe O loke","marked":"Ọmọ Rẹ̀ mbẹ́ Ọ lókè"},{"start":19.995,"end":21.187,"text":"Emi Re nrado bo wa","marked":"Ẹ̀mí Rẹ̀ ńradò bọ̀ wá"},{"start":21.637,"end":23.553,"text":"Baba Mimo. gbo tiwa.","marked":"Baba Mímọ́. gbọ́ tiwa."}],"end":23.553},{"key":"4","start":24.503,"lines":[{"start":24.503,"end":25.725,"text":"Y'ite safire Re ka","marked":"Y'ìtẹ́ ṣafire Rẹ̀ ká"},{"start":26.175,"end":27.509,"text":"L'osumare ogo ntan","marked":"L'òṣùmárè ògo ńtán"},{"start":27.959,"end":29.202,"text":"O kun fun alafia","marked":"Ó kún fún àlàáfíà"},{"start":29.652,"end":31.65,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":31.65},{"key":"5","start":32.6,"lines":[{"start":32.6,"end":33.85,"text":"Niwaju 'te anu Re","marked":"Níwájú tẹ́ àánú Rẹ"},{"start":34.3,"end":35.686,"text":"L'awon Angeli npade","marked":"L'àwọn Áńgẹ́lì ńpàdé"},{"start":36.136,"end":37.518,"text":"Sugbon wo wa lese Re","marked":"Ṣùgbọ́n wò wá lẹ́sẹ̀ Rẹ"},{"start":37.968,"end":39.941,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":39.941},{"key":"6","start":40.891,"lines":[{"start":40.891,"end":41.973,"text":"Iwo a okan Re nyo","marked":"Ìwọ a ọkàn Rẹ nyọ́"},{"start":42.423,"end":43.971,"text":"S'amusua t'o pada,","marked":"S'àmùṣúá t'ó padà"},{"start":44.421,"end":45.654,"text":"T'o mo 'rin re lokere","marked":"T'ó mọ rìn rẹ̀ lókèrè"},{"start":46.104,"end":48.004,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":48.004},{"key":"7","start":48.954,"lines":[{"start":48.954,"end":50.248,"text":"Okan ti nwa isimi","marked":"Ọkàn ti ńwá ìṣímí"},{"start":50.698,"end":51.734,"text":"Okan t'eru ese npa","marked":"Ọkàn t'ẹrú ẹ̀ṣẹ̀ ńpa"},{"start":52.184,"end":53.593,"text":"B'om' owo ti nke f 'omu","marked":"B'ọm ọwọ́ tí ńké f ọmú"},{"start":54.043,"end":55.925,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":55.925},{"key":"8","start":56.875,"lines":[{"start":56.875,"end":58.573,"text":"Gbogbo wa ni alaini","marked":"Gbogbo wa ni aláìní"},{"start":59.023,"end":61.488,"text":"L'ebi, l'ongbe at'are","marked":"L'ẹ̀bi, l'òǹgbẹ àt'àrẹ"},{"start":61.938,"end":63.237,"text":"Ko si ede f'aini wa","marked":"Kò sí èdè f'àìní wa"},{"start":63.687,"end":65.492,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":65.492},{"key":"9","start":66.442,"lines":[{"start":66.442,"end":67.731,"text":"Isura opolopo","marked":"Ìṣúra ọ̀pọ̀lọpọ̀"},{"start":68.181,"end":69.397,"text":"Ko lo kojo bi Oba?","marked":"Kò lọ kójọ bí Ọba?"},{"start":69.847,"end":71.923,"text":"Ainiye, aidiyele?","marked":"Àìníye, àìdíyelé?"},{"start":72.373,"end":74.188,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."}],"end":74.188},{"key":"10","start":75.138,"lines":[{"start":75.138,"end":76.467,"text":"'Wo ko da omo Re si","marked":"wo kò dá ọmọ Rẹ̀ sí"},{"start":76.917,"end":78.154,"text":"Omo Re kansoso na,","marked":"Ọmọ Rẹ̀ kanṣoṣo ná"},{"start":78.604,"end":79.942,"text":"Tit'O fi par'ise Re,","marked":"Tít'ó fi par'iṣẹ́ Rẹ"},{"start":80.392,"end":82.316,"text":"Baba Mimo, gbo tiwa.","marked":"Baba Mímọ́, gbọ́ tiwa."},{"start":82.766,"end":83.385,"text":"Amin.","marked":"Àmín."}],"end":83.385}]}