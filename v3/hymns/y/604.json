{"v":3,"coll":"y","num":604,"id":"hymn_604","title":"EYIN t'oungbe n gbe, e wa mu","duration":26.979,"voices":{"male":{"file":"y-604-male-v3.m4a","bytes":190531,"sha256":"8735ce1e7a183498b08a83aaf6c43355484ae795273bd525e8a796edc8f38f3f","duration":27.0},"female":{"file":"y-604-female-v3.m4a","bytes":192172,"sha256":"1548af6998a6d1e7f988a0a6d0c7aa2d6b802df687f50f12b560075a5ca8e265","duration":27.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.352,"text":"ẸYIN t'oungbẹ n gbẹ, ẹ wa mu,","marked":"Ẹ̀yin t'oúngbẹ ń gbẹ, ẹ wá mú"},{"start":2.802,"end":3.971,"text":"Omi iye ti n san;","marked":"Omi ìyè tí ń sàn"},{"start":4.421,"end":5.934,"text":"Lati orisun ti Jesu,","marked":"Láti orísun ti Jésù"},{"start":6.384,"end":7.862,"text":"Lai sanwo l'awa mbu.","marked":"Láì sanwó l'àwa mbú."}],"end":7.862},{"key":"2","start":8.812,"lines":[{"start":8.812,"end":10.711,"text":"Wo! b'o ti pẹ to t'ẹ ti n mu","marked":"Wò! b'ó ti pẹ́ tó t'ẹ ti ń mú"},{"start":11.161,"end":12.383,"text":"Ninu nkan eke,","marked":"Nínú nǹkan èké"},{"start":12.833,"end":14.441,"text":"T'ẹ n l'agbara at'ogun yin","marked":"T'ẹ̀ ń l'agbára àt'ogun yín"},{"start":14.891,"end":16.692,"text":"Ninu nkan t'o n segbe.","marked":"Nínú nǹkan t'ó ń ṣègbé."}],"end":16.692},{"key":"3","start":17.642,"lines":[{"start":17.642,"end":19.924,"text":"Jesu wi pé, isura mi,","marked":"Jésù wí pé, ìṣúra mi"},{"start":20.374,"end":21.727,"text":"Ko lopin titi lai;","marked":"Kò lópin títí láì"},{"start":22.177,"end":23.631,"text":"Yoo f'ilera lailai fun","marked":"Yóò f'ìlera láéláé fún"},{"start":24.081,"end":25.429,"text":"Awọn t'o gbọ Tirẹ.","marked":"Àwọn t'ó gbọ́ Tirẹ̀."}],"end":25.429}]}