{"v":3,"coll":"y","num":662,"id":"hymn_662","title":"OLUWA ngo ko nani wura","duration":50.728,"voices":{"male":{"file":"y-662-male-v3.m4a","bytes":358762,"sha256":"5b4bc97cba3a2eee5dc2594f6e00ffff69b8fe0461678792744d6c28d3755bf5","duration":50.8},"female":{"file":"y-662-female-v3.m4a","bytes":368438,"sha256":"cfebed5051527b2549ce83b688183f602ceeb6f24fe58dbf39fa8098820c5a17","duration":50.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.769,"text":"OLUWA ngo ko nani wura","marked":"Olúwa ńgọ́ kò nání wúrà"},{"start":2.219,"end":3.166,"text":"ati fadaka","marked":"àti fàdákà"},{"start":3.616,"end":5.178,"text":"Ngo mura lati d'orun lati","marked":"Ngọ́ múra láti d'ọ̀run láti"},{"start":5.628,"end":6.563,"text":"wo 'nu agbo","marked":"wo nu agbo"},{"start":7.013,"end":9.809,"text":"Ninu iwe ijoba Re ti ewe re l'ewa,","marked":"Nínú ìwé ìjọba Rẹ̀ tí èwe rẹ̀ l'ẹwà"},{"start":10.259,"end":12.346,"text":"So fun mi Olugbala, Oko","marked":"Sọ fún mi Olùgbàlà, Ọkọ"},{"start":12.796,"end":13.834,"text":"mi ha wa n'ibe?","marked":"mi ha wà n'ibẹ̀?"}],"end":13.834},{"key":"CHORUS","start":14.784,"lines":[{"start":14.784,"end":16.001,"text":"Oko mi ha wa n'be","marked":"Ọkọ mi ha wà n'bẹ"},{"start":16.451,"end":17.475,"text":"lara iwe funfun?","marked":"lára ìwé funfun?"},{"start":17.925,"end":19.094,"text":"So fun mi Olugbala","marked":"Sọ fún mi Olùgbàlà"},{"start":19.544,"end":20.885,"text":"Oko mi ha wa n'be?","marked":"Ọkọ mi ha wà n'bẹ?"}],"end":20.885},{"key":"2","start":21.835,"lines":[{"start":21.835,"end":23.825,"text":"Oluwa ese mi po bi yanrin","marked":"Olúwa ẹ̀ṣẹ̀ mi pọ̀ bí yanrìn"},{"start":24.275,"end":25.107,"text":"leti okun","marked":"létí òkun"},{"start":25.557,"end":27.294,"text":"Sugbon eje Olugbala o to","marked":"Ṣùgbọ́n ẹ̀jẹ̀ Olùgbàlà ó tó"},{"start":27.744,"end":28.646,"text":"lati we mi","marked":"láti wẹ̀ mí"},{"start":29.096,"end":31.776,"text":"Nitori ileri Re ki ye lai Oluwa,","marked":"Nítorí ìlérí Rẹ̀ kì yẹ láì Olúwa"},{"start":32.226,"end":33.801,"text":"B'ese nyin pon bi ododo","marked":"B'ẹ̀ṣẹ̀ yín pọ́n bí òdodo"},{"start":34.251,"end":35.52,"text":"Yio funfun bi sno.","marked":"Yóò funfun bí ṣnọ."}],"end":35.52},{"key":"3","start":36.47,"lines":[{"start":36.47,"end":38.517,"text":"Ilu daradara ni at'ile didan Re,","marked":"Ìlú dáradára ní àt'ilẹ̀ dídán Rẹ"},{"start":38.967,"end":40.658,"text":"Pel'awon t'a se logo to wo","marked":"Pẹ̀l'àwọn t'á ṣe lógo tó wó"},{"start":41.108,"end":41.984,"text":"aso funfun","marked":"aṣọ funfun"},{"start":42.434,"end":44.247,"text":"Ohun ibi ko si mbe lati","marked":"Ohun ibi kò sì mbẹ̀ láti"},{"start":44.697,"end":45.646,"text":"b'ewa re je","marked":"b'ẹwà rẹ̀ jẹ́"},{"start":46.096,"end":47.306,"text":"Ni'b awon Angeli nso,","marked":"Ní'b àwọn Áńgẹ́lì ńṣọ́"},{"start":47.756,"end":49.178,"text":"Oko mi ha wa n'be.","marked":"Ọkọ mi ha wà n'bẹ."}],"end":49.178}]}