{"v":3,"coll":"y","num":339,"id":"hymn_339","title":"MO gbo Jesu wi pe","duration":45.127,"voices":{"male":{"file":"y-339-male.m4a","bytes":329745,"sha256":"42a9cc0c5c343ace4fb37e1e20bf231a4194b7594ca4db6554a9cd7e742e9157","duration":45.2},"female":{"file":"y-339-female.m4a","bytes":344574,"sha256":"469624610b440f229698c5156f537b7c6eebdf977ce6f34ef5a2ad8383b61455","duration":45.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.71,"text":"MO gbo Jesu wipe","marked":"Mo gbọ́ Jésù wípé"},{"start":2.09,"end":3.127,"text":"'Agbara re kere,","marked":"'Agbára rẹ kéré"},{"start":3.507,"end":4.848,"text":"Alare, sora gbadura","marked":"Aláre, ṣọ́ra gbàdúrà"},{"start":5.228,"end":6.612,"text":"Pipe re mbe lodo mi.","marked":"Pípẹ́ rẹ̀ ḿbẹ lọ́dọ̀ mi."},{"start":6.992,"end":8.323,"text":"Egbe:  Jusu san gbogbo","marked":"Jusu san gbogbo"},{"start":8.703,"end":9.624,"text":"Gbese ti mo je","marked":"Gbèsè tí mo jẹ"},{"start":10.004,"end":11.348,"text":"Ese ti m'abawon wa","marked":"Ẹsẹ̀ tí m'ábàwọ́n wà"},{"start":11.728,"end":13.081,"text":"O fo mi fun bi nso.","marked":"Ó fọ́ mi fún bí ǹṣó."}],"end":13.081},{"key":"CHORUS","start":14.031,"lines":[{"start":14.031,"end":15.452,"text":"Jusu san gbogbo","marked":"Jusu san gbogbo"},{"start":15.832,"end":16.749,"text":"Gbese ti mo je","marked":"Gbèsè tí mo jẹ"},{"start":17.129,"end":18.476,"text":"Ese ti m'abawon wa","marked":"Ẹsẹ̀ tí m'ábàwọ́n wà"},{"start":18.856,"end":20.197,"text":"O fo mi fun bi nso.","marked":"Ó fọ́ mi fún bí ǹṣó."}],"end":20.197},{"key":"2","start":21.147,"lines":[{"start":21.147,"end":22.289,"text":"Oluwa toto mo mo","marked":"Olúwa tótó mọ́ mọ́"},{"start":22.669,"end":23.846,"text":"P'agbara Re nikan","marked":"P'agbára Rẹ nìkan"},{"start":24.226,"end":25.602,"text":"Le s'adete di mimo","marked":"Lè s'ádẹ̀tẹ̀ di mímọ́́"},{"start":25.982,"end":27.279,"text":"O le m'okan lile ro.","marked":"O lè m'ọ̀kan líle rò."},{"start":27.659,"end":28.87,"text":"Egbe:  Jusu san gbogbo...","marked":"Jusu san gbogbo"}],"end":28.87},{"key":"3","start":29.82,"lines":[{"start":29.82,"end":31.176,"text":"\"Gbati 'pe 'kehin ba dun","marked":"Gbatí 'pé 'kẹ́hìn bá dùn"},{"start":31.556,"end":32.605,"text":"T'o npe mi s'odo Re","marked":"T'ó ńpẹ́ mi s'ọ̀dọ̀ Rẹ"},{"start":32.985,"end":34.435,"text":"Jesu ti san gbogbo re,","marked":"Jésù ti san gbogbo rẹ̀"},{"start":34.815,"end":36.159,"text":"Em' o ba goke orun.","marked":"Em' ò bá gòkè ọ̀run."},{"start":36.539,"end":37.787,"text":"Egbe:  Jusu san gbogbo","marked":"Jusu san gbogbo"},{"start":38.167,"end":39.083,"text":"Gbese ti mo je","marked":"Gbèsè tí mo jẹ"},{"start":39.463,"end":40.898,"text":"Ese ti m'abawon wa","marked":"Ẹsẹ̀ tí m'ábàwọ́n wà"},{"start":41.278,"end":42.623,"text":"O fo mi fun bi nso.","marked":"Ó fọ́ mi fún bí ǹṣó."},{"start":43.003,"end":43.577,"text":"Amin.","marked":"Àmín."}],"end":43.577}]}