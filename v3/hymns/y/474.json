{"v":3,"coll":"y","num":474,"id":"hymn_474","title":"Labe oji Oga Ogo","duration":33.083,"voices":{"male":{"file":"y-474-male-v3.m4a","bytes":231667,"sha256":"2bdf4e188ba33d293ea90c8eb7d8ecb77732b909f0d7147d8e2464943a6c362a","duration":33.1},"female":{"file":"y-474-female-v3.m4a","bytes":239427,"sha256":"a4f211d97ec5af8546d159b219fcea73c8ea9b6238929bccb45770137ccce47b","duration":33.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.885,"text":"Labe oji Oga Ogo","marked":"Lábẹ́ òjì Ọ̀gá Ògo"},{"start":2.335,"end":4.314,"text":"L'abo mi yio ma wa lai","marked":"L'abo mi yóò má wà láì"},{"start":4.764,"end":6.156,"text":"Tor'oju Re ti ki to gbe","marked":"Tor'ojú Rẹ̀ tí kí tó gbé"},{"start":6.606,"end":8.227,"text":"Nso mi sibe nigbagbogbo.","marked":"Ǹṣọ́ mi síbẹ̀ nígbàgbogbo."}],"end":8.227},{"key":"CHORUS","start":9.177,"lines":[{"start":9.177,"end":10.448,"text":"Emi ngbe abe ojiji","marked":"Èmi ńgbé abẹ́ òjìji"},{"start":10.898,"end":12.207,"text":"Ti Oba awon oba","marked":"Ti Ọba àwọn ọba"},{"start":12.657,"end":13.812,"text":"On fi iye Re bo mi","marked":"Òn fi iye Rẹ̀ bọ̀ mí"},{"start":14.262,"end":15.592,"text":"Mo simi Iabe abo Re.","marked":"Mo ṣímí lábẹ́ abo Rẹ."}],"end":15.592},{"key":"2","start":16.542,"lines":[{"start":16.542,"end":18.05,"text":"Labe oji Oga Ogo","marked":"Lábẹ́ òjì Ọ̀gá Ògo"},{"start":18.5,"end":19.62,"text":"Mo bo low'eru gbogbo","marked":"Mo bọ́ lọ́w'ẹ̀rù gbogbo"},{"start":20.07,"end":21.3,"text":"Tori apa Re gba mi mu","marked":"Torí apá Rẹ gbà mi mú"},{"start":21.75,"end":23.063,"text":"Yi mi ka l'ona gbogbo.","marked":"Yí mi ká l'ọ̀nà gbogbo."}],"end":23.063},{"key":"3","start":24.013,"lines":[{"start":24.013,"end":25.498,"text":"Labe oji Oga Ogo","marked":"Lábẹ́ òjì Ọ̀gá Ògo"},{"start":25.948,"end":27.857,"text":"Ko s'ibi to le se mi","marked":"Kò s'ibi tó lè ṣe mí"},{"start":28.307,"end":29.848,"text":"On n'ireti at'asa mi","marked":"Òn n'ìrètí àt'àṣà mi"},{"start":30.298,"end":31.534,"text":"Igbala, on gbogbo mi.","marked":"Ìgbàlà, ọ́n gbogbo mi."}],"end":31.534}]}