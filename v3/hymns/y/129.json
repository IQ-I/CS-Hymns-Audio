{"v":3,"coll":"y","num":129,"id":"hymn_129","title":"YIN Olorun Abram","duration":42.152,"voices":{"male":{"file":"y-129-male-v3.m4a","bytes":290479,"sha256":"14c089aa8ced90be43fb67c5ffdc6f983fbe8b89f70f608a9bfbf4c3e8a3dfd3","duration":42.2},"female":{"file":"y-129-female-v3.m4a","bytes":298577,"sha256":"329c4e5cd3da80817a013d54b0a8a1dd4e7ad4fbafa18f47c7f086220895fb81","duration":42.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.452,"text":"YIN Ọlọrun Abram,","marked":"Yin Ọlọ́run Abram"},{"start":1.902,"end":3.006,"text":"To gunwa lok'ọrun,","marked":"Tó gúnwà lók'ọ̀run"},{"start":3.456,"end":4.635,"text":"Ẹni agba ayérayé,","marked":"Ẹni àgbà ayérayé"},{"start":5.085,"end":6.012,"text":"Ọlọrun 'fẹ;","marked":"Ọlọ́run 'fẹ"},{"start":6.462,"end":7.637,"text":"Ẹmi Jehofa nla,","marked":"Ẹ̀mí Jèhófà ńlá"},{"start":8.087,"end":9.426,"text":"T'ayé t'ọrun ń jẹwọ,","marked":"T'ayé t'ọ̀run ń jẹ́wọ́"},{"start":9.876,"end":11.117,"text":"Mo yin orukọ mimọ Rẹ,","marked":"Mo yin orúkọ mímọ́ Rẹ"},{"start":11.567,"end":12.47,"text":"Olubukun.","marked":"Olùbùkún."}],"end":12.47},{"key":"2","start":13.42,"lines":[{"start":13.42,"end":14.582,"text":"B'ipa ara bajẹ,","marked":"B'ipa ara bàjẹ́"},{"start":15.032,"end":16.477,"text":"T'ayé t'esu ń dena,","marked":"T'ayé t'èṣù ń dènà"},{"start":16.927,"end":18.531,"text":"N ó dojukọ ile Kenaan,","marked":"N ó dojúkọ ilẹ̀ Kenaan"},{"start":18.981,"end":19.949,"text":"Nip'asẹ Rẹ;","marked":"Níp'àsẹ Rẹ"},{"start":20.399,"end":21.471,"text":"N ó la ibu kọja,","marked":"N ó la ìbú kọjá"},{"start":21.921,"end":23.434,"text":"N ó tẹjumọ Jesu,","marked":"N ó tẹjúmọ́ Jésù"},{"start":23.884,"end":25.538,"text":"Larin aginju to lẹru,","marked":"Lárin aginjù tó lẹ́rù"},{"start":25.988,"end":27.103,"text":"N ó ma rin lọ.","marked":"N ó má rìn lọ."}],"end":27.103},{"key":"3","start":28.053,"lines":[{"start":28.053,"end":29.516,"text":"S'Ọlọrun Ọba l'oke,","marked":"S'Ọlọ́run Ọba l'òkè"},{"start":29.966,"end":31.154,"text":"L'olor' Angẹli ń ke,","marked":"L'ọlọ́r Áńgẹ́lì ń ké"},{"start":31.604,"end":32.76,"text":"Wi pé Mimọ, Mimọ,","marked":"Wí pé Mímọ́, Mímọ́"},{"start":33.21,"end":33.99,"text":"Olodumare;","marked":"Olódùmarè"},{"start":34.44,"end":35.386,"text":"Ẹni ti o ti wa,","marked":"Ẹni tí ó ti wá"},{"start":35.836,"end":37.051,"text":"Ti yoo si wa lailai,","marked":"Tí yóò sì wà láéláé"},{"start":37.501,"end":39.032,"text":"Ẹmi Jehofa Baba nla,","marked":"Ẹ̀mí Jèhófà Baba ńlá"},{"start":39.482,"end":40.603,"text":"Kabiyesi.","marked":"Kábíyèsí."}],"end":40.603}]}