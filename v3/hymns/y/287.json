{"v":3,"coll":"y","num":287,"id":"hymn_287","title":"GBOGB' ogo, iyin, ola","duration":54.276,"voices":{"male":{"file":"y-287-male-v3.m4a","bytes":377776,"sha256":"f50c8dc4a80e69532273b2056d35bdba4b24cbd888ed227cb79dcf2770374546","duration":54.3},"female":{"file":"y-287-female-v3.m4a","bytes":388686,"sha256":"3a3f6ac0b74f69abc3d245eda85e5da8261943b2857d1f6ab808a2779ad5c079","duration":54.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.674,"text":"GBOGB' ogo, iyin, ola","marked":"Gbogb ògo, ìyìn, ọlá"},{"start":2.124,"end":3.723,"text":"Fun O, Oludande","marked":"Fún Ọ, Olùdáǹdè"},{"start":4.173,"end":5.524,"text":"S'Eni t'awon omode","marked":"S'Ẹni t'àwọn ọmọdé"},{"start":5.974,"end":7.251,"text":"Ko Hosanna didun!","marked":"Kò Hosanna dídùn!"},{"start":7.701,"end":9.477,"text":"'Wo! l'Oba lsreali","marked":"wò! l'Ọba Isreali"},{"start":9.927,"end":11.051,"text":"Om'Alade Dafidi","marked":"Ọm'aládé Dafidi"},{"start":11.501,"end":12.772,"text":"T'o wa l'Oko Oluwa","marked":"T'ó wà l'Ọkọ Olúwa"},{"start":13.222,"end":14.311,"text":"Oba Olubukun.","marked":"Ọba Olùbùkún."}],"end":14.311},{"key":"CHORUS","start":15.261,"lines":[{"start":15.261,"end":16.734,"text":"Gbogb'ogo, iyin, ola","marked":"Gbogb'ògo, ìyìn, ọlá"},{"start":17.184,"end":18.935,"text":"Fun O, Oludande,","marked":"Fún Ọ, Olùdáǹdè"},{"start":19.385,"end":20.776,"text":"S'Eni t'awon omode","marked":"S'Ẹni t'àwọn ọmọdé"},{"start":21.226,"end":22.525,"text":"Ko Hosanna didun.","marked":"Kò Hosanna dídùn."}],"end":22.525},{"key":"2","start":23.475,"lines":[{"start":23.475,"end":24.944,"text":"Egbe awon Maleka","marked":"Ẹgbẹ́ àwọn Maleka"},{"start":25.394,"end":26.557,"text":"Nyin O Ioke giga","marked":"Yín Ó lókè gíga"},{"start":27.007,"end":28.443,"text":"Awa at'eda gbogbo","marked":"Àwa àt'ẹ̀dá gbogbo"},{"start":28.893,"end":30.287,"text":"Si dapo gberin na.","marked":"Sì dàpọ̀ gbẹ́rin ná."}],"end":30.287},{"key":"3","start":31.237,"lines":[{"start":31.237,"end":32.508,"text":"Awon Hebru lo saju","marked":"Àwọn Hebru lọ sájú"},{"start":32.958,"end":33.93,"text":"Pelu imo ope","marked":"Pẹ̀lú ìmọ̀ ọpẹ́"},{"start":34.38,"end":36.027,"text":"lyin, adua at'orin","marked":"Ìyìn, àdúà àt'orin"},{"start":36.477,"end":37.802,"text":"L'a mu wa 'waju Re.","marked":"L'á mú wa wájú Rẹ̀."}],"end":37.802},{"key":"4","start":38.752,"lines":[{"start":38.752,"end":40.066,"text":"Si O saju iya Re","marked":"Sí Ọ ṣájú ìyá Rẹ"},{"start":40.516,"end":41.468,"text":"Nwon korin iyin won","marked":"Wọ́n kọrin ìyìn wọn"},{"start":41.918,"end":43.523,"text":"Wo t'a gbe ga nisisyi","marked":"Wò t'á gbé ga níṣíṣyí"},{"start":43.973,"end":45.289,"text":"L'a nkorin iyin si.","marked":"L'á ńkọrin ìyìn sí."}],"end":45.289},{"key":"5","start":46.239,"lines":[{"start":46.239,"end":47.385,"text":"'Wo gba orin iyin won","marked":"wo gba orin ìyìn wọn"},{"start":47.835,"end":49.264,"text":"Gb'adura t'a mu wa","marked":"Gb'àdúrà t'a mú wá"},{"start":49.714,"end":51.246,"text":"Wo ti nyo s'ohun rere","marked":"Wo ti nyọ́ s'ohun rere"},{"start":51.696,"end":52.727,"text":"Oba wa Olore.","marked":"Ọba wá Ọlọ́rẹ."}],"end":52.727}]}