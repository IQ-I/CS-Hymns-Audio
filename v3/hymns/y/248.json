{"v":3,"coll":"y","num":248,"id":"hymn_248","title":"JESU mi, mu mi gb'ohun Re","duration":32.396,"voices":{"male":{"file":"y-248-male-v3.m4a","bytes":222242,"sha256":"bc313ffb92bc35700def0c7e504984c49ab502ae15575af26890178b323e45d3","duration":32.4},"female":{"file":"y-248-female-v3.m4a","bytes":227361,"sha256":"bfca5b59f969603ea8a2e01099d84b356f2d1889fd4a6127e3bb0f6d65a5a84e","duration":32.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.34,"text":"Jesu mi, mu mi gb' ohun Rẹ","marked":"Jésù mi, mú mi gb ohùn Rẹ̀"},{"start":2.79,"end":3.964,"text":"S'ọrọ alafia;","marked":"S'ọ̀rọ̀ àlàáfíà"},{"start":4.414,"end":5.922,"text":"Gbogbo ipa mi y'o dalu","marked":"Gbogbo ipá mi y'ó dàlú"},{"start":6.372,"end":7.74,"text":"Lati yin ore Rẹ.","marked":"Láti yin ọrẹ Rẹ."}],"end":7.74},{"key":"2","start":8.69,"lines":[{"start":8.69,"end":10.022,"text":"Fi iyọnu pe mi l'ọmọ,","marked":"Fi ìyọnu pè mí l'ọmọ"},{"start":10.472,"end":11.693,"text":"K'o si dariji mi;","marked":"K'ó sì dáríjì mi"},{"start":12.143,"end":13.361,"text":"Ohun na yoo dun mọ mi,","marked":"Ohun ná yóò dùn mọ́ mi"},{"start":13.811,"end":14.83,"text":"B'iro orin ọrun.","marked":"B'ìró orin ọ̀run."}],"end":14.83},{"key":"3","start":15.78,"lines":[{"start":15.78,"end":17.802,"text":"Ibikibi t'o to mi si,","marked":"Ibikíbi t'ó tọ̀ mi sí"},{"start":18.252,"end":19.438,"text":"L'emi o f' ayo lo","marked":"L'èmi ó f ayọ̀ lọ"},{"start":19.888,"end":21.319,"text":"Tayotayo l'emi o si","marked":"Tayọ̀tayọ̀ l'èmi ó sì"},{"start":21.769,"end":23.096,"text":"Dapo m'awon oku.","marked":"Dàpọ̀ m'àwọn òkú."}],"end":23.096},{"key":"4","start":24.046,"lines":[{"start":24.046,"end":25.568,"text":"Gba eru ebi ba koja","marked":"Gba ẹrú ebi bá kọjá"},{"start":26.018,"end":27.056,"text":"Eru mi ko si mo","marked":"Ẹ̀rù mi kò sí mọ́"},{"start":27.506,"end":29.062,"text":"Owo t'o fun 'dariji ka,","marked":"Owó t'ó fún dáríjì ká"},{"start":29.512,"end":30.847,"text":"Y'o pin ade iye.","marked":"Y'ó pín adé ìyè."}],"end":30.847}]}