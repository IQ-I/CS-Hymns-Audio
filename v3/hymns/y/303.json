{"v":3,"coll":"y","num":303,"id":"hymn_303","title":"OLUGBALA mi ha gbogbe!","duration":40.125,"voices":{"male":{"file":"y-303-male-v3.m4a","bytes":278135,"sha256":"d4948fc6faf786c2a92667afd2fab3bbdb0ce2de96e7e8557312516257130a4c","duration":40.2},"female":{"file":"y-303-female-v3.m4a","bytes":289133,"sha256":"1cd15a23d1261f396808c4d15977fc61e7c1724e27537fcd379f1f62e516109c","duration":40.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.725,"text":"OLUGBALA mi ha gbọgbẹ!","marked":"Olùgbàlà mi ha gbọgbẹ́!"},{"start":2.175,"end":3.302,"text":"Ọba ogo ha ku!","marked":"Ọba ògo ha kú!"},{"start":3.752,"end":5.345,"text":"Oun ha jẹ f'ara Rẹ rubọ,","marked":"Òun ha jẹ́ f'ara Rẹ̀ rúbọ"},{"start":5.795,"end":6.849,"text":"F'ẹni ilẹ b'emi?","marked":"F'ẹni ilẹ̀ b'èmi?"}],"end":6.849},{"key":"2","start":7.799,"lines":[{"start":7.799,"end":9.536,"text":"Ki ha se ẹsẹ ti mo da,","marked":"Kí ha ṣe ẹsẹ̀ tí mo dá"},{"start":9.986,"end":11.259,"text":"L'o gbe kọ s'ori igi?","marked":"L'ó gbé kọ́ s'orí igi?"},{"start":11.709,"end":13.292,"text":"Anu at' ore yi ma pọ,","marked":"Àánú àt ọ̀rẹ́ yí má pọ̀"},{"start":13.742,"end":15.158,"text":"Ifẹ yi rekoja!","marked":"Ìfẹ́ yí rékọjá!"}],"end":15.158},{"key":"3","start":16.108,"lines":[{"start":16.108,"end":17.754,"text":"O ye k'orun f'oju pamo","marked":"Ó yẹ k'ọ̀run f'ojú pamọ́"},{"start":18.204,"end":19.438,"text":"K'o b'ogo re mole","marked":"K'ò b'ògo rẹ̀ mọ́lẹ̀"},{"start":19.888,"end":21.586,"text":"'Gbati Kristi Eleda ku","marked":"gbàtí Kristi Ẹlẹ́dàá kú"},{"start":22.036,"end":23.199,"text":"Fun ese eda Re.","marked":"Fún ẹsẹ̀ ẹ̀dà Rẹ."}],"end":23.199},{"key":"4","start":24.149,"lines":[{"start":24.149,"end":25.664,"text":"Be l'o ye k'oju ba ti mi","marked":"Bẹ́ l'ó yẹ k'ojú bá tì mí"},{"start":26.114,"end":27.221,"text":"'Gba mo r'agbelebu","marked":"gbà mọ́ r'àgbélébùú"},{"start":27.671,"end":29.048,"text":"O ye k'okan mi kun f'ope","marked":"Ó yẹ k'ọkàn mi kún f'ọpẹ́"},{"start":29.498,"end":30.814,"text":"Oju mi f'omije.","marked":"Ojú mi f'omijé."}],"end":30.814},{"key":"5","start":31.764,"lines":[{"start":31.764,"end":33.192,"text":"Sugbon omije ko le san","marked":"Ṣùgbọ́n omijé kò lè sàn"},{"start":33.642,"end":35.027,"text":"Gbese 'fe ti mo je","marked":"Gbèsè fẹ́ tí mo jẹ́"},{"start":35.477,"end":36.799,"text":"Mo f'ara mi f'Oluwa mi","marked":"Mo f'ara mi f'Olúwa mi"},{"start":37.249,"end":38.576,"text":"Eyi ni mo le se.","marked":"Èyí ni mo lè ṣe."}],"end":38.576}]}