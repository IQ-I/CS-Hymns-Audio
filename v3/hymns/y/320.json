{"v":3,"coll":"y","num":320,"id":"hymn_320","title":"JESU ye; titi aye","duration":54.245,"voices":{"male":{"file":"y-320-male-v3.m4a","bytes":376191,"sha256":"4879a04eb47d4a04e3713d222ecc0f440ccfe4fb6ce3f4049c771983ceef77b6","duration":54.3},"female":{"file":"y-320-female-v3.m4a","bytes":394386,"sha256":"e79681c4cef8ec1eea736919d1076f1b690b53b999d0502093bc9a10a081a3d6","duration":54.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.087,"text":"JESU ye; titi ayé,","marked":"Jésù yẹ; títí ayé"},{"start":2.537,"end":4.043,"text":"Ẹru iku ko ba ni mọ;","marked":"Ẹ̀rù ikú kò bá ni mọ́"},{"start":4.493,"end":6.374,"text":"Jesu ye: nitori naa;","marked":"Jésù yẹ: nítorí náà"},{"start":6.824,"end":8.742,"text":"Isa oku ko n'ipa mọ,","marked":"Isà òkú kò n'ipa mọ́"},{"start":9.192,"end":9.98,"text":"Alleluya!","marked":"Allelúyà!"}],"end":9.98},{"key":"CHORUS","start":10.93,"lines":[{"start":10.93,"end":11.862,"text":"Alleluya.","marked":"Allelúyà."}],"end":11.862},{"key":"2","start":12.812,"lines":[{"start":12.812,"end":14.52,"text":"Jesu ye, lat' oni lo","marked":"Jésù yẹ, lát òní lọ"},{"start":14.97,"end":16.22,"text":"Iku je ona si iye","marked":"Ikú jẹ́ ọ̀nà sí ìyè"},{"start":16.67,"end":18.18,"text":"Eyi y'o je 'tunu wa","marked":"Èyí y'ó jẹ́ tùnú wa"},{"start":18.63,"end":20.129,"text":"'Gbat' akoko iku ba de","marked":"gbàt àkọ́kọ́ ikú bá dé"},{"start":20.579,"end":21.532,"text":"Alleluya.","marked":"Allelúyà."}],"end":21.532},{"key":"3","start":22.482,"lines":[{"start":22.482,"end":24.472,"text":"Jesu ye, fun wa l'O ku","marked":"Jésù yẹ, fún wa l'Ó kú"},{"start":24.922,"end":27.088,"text":"Nje Tire ni a o ma se","marked":"Ǹjẹ́ Tirẹ̀ ni a ó má ṣe"},{"start":27.538,"end":29.068,"text":"A o f'okan funfun sin","marked":"A ó f'ọkàn funfun sin"},{"start":29.518,"end":30.815,"text":"A o f'ogo f'Olugbala","marked":"A ó f'ògo f'Olùgbàlà"},{"start":31.265,"end":32.152,"text":"Alleluya.","marked":"Allelúyà."}],"end":32.152},{"key":"4","start":33.102,"lines":[{"start":33.102,"end":35.022,"text":"Jesu ye: eyi daju,","marked":"Jésù yẹ: èyí dájú"},{"start":35.472,"end":37.177,"text":"Iku at'ipa okunkun;","marked":"Ikú àt'ipá òkùnkùn"},{"start":37.627,"end":39.108,"text":"Ki y'o le ya ni kuro,","marked":"Kí y'ó lè yà ní kúrò"},{"start":39.558,"end":41.26,"text":"Ninu ifẹ nla ti Jesu,","marked":"Nínú ìfẹ́ ńlá ti Jésù"},{"start":41.71,"end":42.429,"text":"Alleluya!","marked":"Allelúyà!"}],"end":42.429},{"key":"5","start":43.379,"lines":[{"start":43.379,"end":45.358,"text":"Jesu ye; gbogbo 'jọba,","marked":"Jésù yẹ; gbogbo 'jọba"},{"start":45.808,"end":47.812,"text":"L'ọrun, ni ayé di Tirẹ,","marked":"L'ọ̀run, ní ayé di Tìrẹ"},{"start":48.262,"end":49.616,"text":"Ẹ jẹ ki a ma tẹle;","marked":"Ẹ jẹ́ kí a má tẹ̀lé"},{"start":50.066,"end":51.437,"text":"Ki a le jọba pẹlu Rẹ","marked":"Kí a lè jọba pẹ̀lú Rẹ"},{"start":51.887,"end":52.696,"text":"Alleluya!","marked":"Allelúyà!"}],"end":52.696}]}