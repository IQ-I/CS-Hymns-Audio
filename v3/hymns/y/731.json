{"v":3,"coll":"y","num":731,"id":"hymn_731","title":"BABA orun, 'wo lo mu wa","duration":67.642,"voices":{"male":{"file":"y-731-male-v3.m4a","bytes":488918,"sha256":"237987ca570a772f7add13d22cd46ce22d3e83462880b932830b96fa168d4824","duration":67.7},"female":{"file":"y-731-female-v3.m4a","bytes":503114,"sha256":"e89ec2c69c24bf933708b125e2e27fe51883664523e8f5a4869f72eab3efd7a6","duration":67.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.18,"text":"BABA orun, 'wo lo mu wa","marked":"Baba ọ̀run, wo ló mú wá"},{"start":2.63,"end":4.068,"text":"D'ojo oni l'alafia","marked":"D'ọjọ́ òní l'àlàáfíà"},{"start":4.518,"end":6.033,"text":"Pele I'O nto isise wa","marked":"Pẹ̀lẹ́ l'Ó ńtọ́ ìṣiṣẹ́ wa"},{"start":6.483,"end":7.785,"text":"T'O si nf'iso Re so wa","marked":"T'Ó sì ńf'ìṣọ́ Rẹ̀ sọ wá"},{"start":8.235,"end":9.965,"text":"'Wo Ore at'Amona wa","marked":"wo Ọ̀rẹ́ àt'amọ́ná wa"},{"start":10.415,"end":11.581,"text":"A fe fi ope fun O","marked":"A fẹ́ fi ọpẹ́ fún Ọ"},{"start":12.031,"end":14.101,"text":"Ao se le yin O b'o ti ye","marked":"Àó ṣe lè yín Ó b'ó ti yẹ"},{"start":14.551,"end":15.994,"text":"Fun 'fe Re ti ki pada?","marked":"Fún fẹ́ Rẹ tí kì padà?"}],"end":15.994},{"key":"2","start":16.944,"lines":[{"start":16.944,"end":18.317,"text":"Ni gbogbo igba t'o koja","marked":"Ní gbogbo ìgbà t'ó kọjá"},{"start":18.767,"end":20.02,"text":"L'a nri anu gba lotun","marked":"L'á ńrí àánú gbà lọ́tun"},{"start":20.47,"end":21.822,"text":"Itoju on iseun-ife","marked":"Ìtọ́jú ọn iseun-ife"},{"start":22.272,"end":23.736,"text":"Ko fi igba kan jin na","marked":"Kò fi ìgbà kan jìn ná"},{"start":24.186,"end":25.634,"text":"Ife ati aba orun","marked":"Ìfẹ́ àti àbà ọ̀run"},{"start":26.084,"end":27.687,"text":"Mba wa gbe tosan-toru","marked":"Mbá wá gbé tosan-toru"},{"start":28.137,"end":30.013,"text":"Ibukun t'a ko le siro","marked":"Ìbùkún t'á kò lè ṣírò"},{"start":30.463,"end":32.101,"text":"Ntan imole s'ona wa.","marked":"Ǹtàn ìmọ́lẹ̀ s'ọ̀nà wa."}],"end":32.101},{"key":"3","start":33.051,"lines":[{"start":33.051,"end":35.096,"text":"N'nu 'danwo nla l'a ti koja","marked":"N'nú dánwò ńlá l'á ti kọjá"},{"start":35.546,"end":36.678,"text":"Iji 'ponju ti lu wa","marked":"Ìjì pọ́njú ti lù wá"},{"start":37.128,"end":38.614,"text":"Idamu ti sokun bo wa","marked":"Ìdàmú ti sọkún bọ̀ wá"},{"start":39.064,"end":40.594,"text":"Tobe t'a ko fi ri O","marked":"Tóbẹ̀ t'á kò fi rí Ọ"},{"start":41.044,"end":42.567,"text":"Sibe ife Re ko ko wa","marked":"Síbẹ̀ ìfẹ́ Rẹ̀ kò kọ́ wá"},{"start":43.017,"end":44.35,"text":"Sibe n'nu banuje wa","marked":"Síbẹ̀ n'nú banújẹ́ wa"},{"start":44.8,"end":46.311,"text":"Iranwo t'a nse f'ara wa","marked":"Ìrànwọ́ t'a ńṣe f'ara wa"},{"start":46.761,"end":48.103,"text":"Nipa agbara Re ni.","marked":"Nípa agbára Rẹ̀ ni."}],"end":48.103},{"key":"4","start":49.053,"lines":[{"start":49.053,"end":50.17,"text":"Opo awon olufe wa","marked":"Ọ̀pọ̀ àwọn olùfẹ́ wa"},{"start":50.62,"end":52.083,"text":"Ti de opin ajo won","marked":"Ti dé òpin àjọ wọn"},{"start":52.533,"end":54.407,"text":"Ara, omo ati ore","marked":"Ara, ọmọ àti ọrẹ"},{"start":54.857,"end":56.302,"text":"Nwona lati pade wa","marked":"Nwọ̀nà láti pàdé wá"},{"start":56.752,"end":58.239,"text":"Nigbat' ajo wa ba pari","marked":"Nígbàt àjọ wa bá parí"},{"start":58.689,"end":60.188,"text":"Ti a si se alaisi","marked":"Tí a sì ṣe aláìsí"},{"start":60.638,"end":63.059,"text":"Baba, mu wa la okun ja","marked":"Baba, mú wa la okùn jà"},{"start":63.509,"end":65.039,"text":"Sinu mole ailopin.","marked":"Sínú mọ́lẹ̀ àìlópin."},{"start":65.489,"end":66.093,"text":"Amin.","marked":"Àmín."}],"end":66.093}]}