{"v":3,"coll":"y","num":428,"id":"hymn_428","title":"SA wo ite anu!","duration":29.96,"voices":{"male":{"file":"y-428-male-v3.m4a","bytes":200620,"sha256":"cade3f595c5891da68680f23511883e497f44765f24daa32d545d2f05b22181b","duration":30.0},"female":{"file":"y-428-female-v3.m4a","bytes":208785,"sha256":"3799771cd057898e3ebaf3f5a97d1ea561f9e26aec0e0918ede6584f1b7c8857","duration":30.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.435,"text":"SA wo ite anu!","marked":"Sá wọ ìtẹ́ àánú!"},{"start":1.885,"end":2.903,"text":"Oro Re pe mi wa,","marked":"Ọ̀rọ̀ Rẹ̀ pè mí wá"},{"start":3.353,"end":4.966,"text":"Nibe Jesu f'oju 're han","marked":"Níbẹ̀ Jésù f'ojú rẹ̀ hàn"},{"start":5.416,"end":6.674,"text":"Lati gbo adura.","marked":"Láti gbọ́ àdúrà."}],"end":6.674},{"key":"2","start":7.624,"lines":[{"start":7.624,"end":8.681,"text":"Ẹjẹ etutu ni,","marked":"Ẹ̀jẹ̀ ètùtù ni"},{"start":9.131,"end":10.28,"text":"Ti a ti ta silẹ;","marked":"Tí a ti ta sílẹ̀"},{"start":10.73,"end":12.097,"text":"Pese ẹbẹ t'o le bori,","marked":"Pèsè ẹ̀bẹ̀ t'ó lè borí"},{"start":12.547,"end":14.098,"text":"F'awọn t'o n t'Ọlọrun.","marked":"F'àwọn t'ó ń t'Ọlọ́run."}],"end":14.098},{"key":"3","start":15.048,"lines":[{"start":15.048,"end":16.092,"text":"Ifẹ Rẹ le fun mi,","marked":"Ìfẹ́ Rẹ lè fún mi"},{"start":16.542,"end":17.658,"text":"Ju bi mo ti fẹ lọ;","marked":"Ju bí mo ti fẹ́ lọ"},{"start":18.108,"end":19.302,"text":"A ma fun ẹni t'o bere,","marked":"A má fún ẹni t'ó bẹ̀rẹ̀"},{"start":19.752,"end":21.141,"text":"Ju bi wọn ti n fẹ lọ.","marked":"Ju bí wọ́n ti ń fẹ́ lọ."}],"end":21.141},{"key":"4","start":22.091,"lines":[{"start":22.091,"end":23.22,"text":"Fun wa l'aworan Rẹ,","marked":"Fún wa l'àwòrán Rẹ̀"},{"start":23.67,"end":24.726,"text":"At'oju rere Rẹ;","marked":"Àt'ojú rere Rẹ"},{"start":25.176,"end":26.646,"text":"Jẹ ki n le sin Ọ nihin yii","marked":"Jẹ́ kí n lè sin Ọ́ níhìn yìí"},{"start":27.096,"end":28.41,"text":"Ki mba le ba Ọ gbe.","marked":"Kí mbá lè bá Ọ gbé."}],"end":28.41}]}