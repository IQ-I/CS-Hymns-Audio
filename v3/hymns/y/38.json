{"v":3,"coll":"y","num":38,"id":"hymn_38","title":"DIDUN n'ise na, Oba mi","duration":42.181,"voices":{"male":{"file":"y-38-male-v3.m4a","bytes":297569,"sha256":"eb5a07b679c051117c4a1d7d2327baf5daa18117daba752e1ce64b3548ea3080","duration":42.2},"female":{"file":"y-38-female-v3.m4a","bytes":303185,"sha256":"2193cb88e92e3e0cc62ae5f7bb315c83cf5789e20767985c38e4a7dccc0f2295","duration":42.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.003,"text":"DIDUN n'isẹ na, Ọba mi,","marked":"Dídùn n'isẹ́ ná, Ọba mi"},{"start":2.453,"end":3.709,"text":"Lati ma yin Orukọ Rẹ;","marked":"Láti má yin Orúkọ Rẹ"},{"start":4.159,"end":5.989,"text":"Lati se'fẹ Rẹ l'owurọ,","marked":"Láti sè'fẹ́ Rẹ l'òwúrọ̀"},{"start":6.439,"end":8.09,"text":"Lati sọ ọrọ Rẹ l'alẹ.","marked":"Láti sọ ọ̀rọ̀ Rẹ̀ l'alẹ́."}],"end":8.09},{"key":"2","start":9.04,"lines":[{"start":9.04,"end":10.375,"text":"Didun l'ọjọ 'sinmi mimọ,","marked":"Dídùn l'ọjọ́ sinmi mímọ́"},{"start":10.825,"end":12.1,"text":"Lala ko si fun mi loni,","marked":"Lálà kò sì fún mi lónì"},{"start":12.55,"end":13.661,"text":"Ọkan mi ma kọrin iyin,","marked":"Ọkàn mi má kọrin ìyìn"},{"start":14.111,"end":15.512,"text":"Bi harpu Dafidi didun.","marked":"Bí harpu Dafidi dídùn."}],"end":15.512},{"key":"3","start":16.462,"lines":[{"start":16.462,"end":17.88,"text":"Ọkan mi o yọ n'Oluwa,","marked":"Ọkàn mi ò yọ n'Olúwa"},{"start":18.33,"end":19.993,"text":"Y'o yin isẹ at'ọrọ Rẹ;","marked":"Y'ó yin isẹ́ àt'ọ̀rọ̀ Rẹ̀"},{"start":20.443,"end":21.865,"text":"Isẹ oore Rẹ ti pọ to!","marked":"Isẹ́ oore Rẹ̀ ti pọ̀ tó!"},{"start":22.315,"end":23.836,"text":"Ijinlẹ si ni imọ Rẹ.","marked":"Ìjìnlẹ̀ sì ni ìmọ̀ Rẹ̀."}],"end":23.836},{"key":"4","start":24.786,"lines":[{"start":24.786,"end":26.0,"text":"Emi o yan ipo ola","marked":"Èmi ó yan ipò ọlá"},{"start":26.45,"end":27.982,"text":"Gb'ore-ofe ba we mi nu","marked":"Gb'ore-ofe bá wẹ̀ mi nù"},{"start":28.432,"end":29.98,"text":"Ti ayo pupo si ba mi,","marked":"Tí ayọ̀ púpọ̀ sì bá mi"},{"start":30.43,"end":31.752,"text":"Ayo mimo lat' oke wa.","marked":"Ayọ̀ mímọ́ lát òkè wá."}],"end":31.752},{"key":"5","start":32.702,"lines":[{"start":32.702,"end":34.496,"text":"'Gbana, n o ri, n o gbọ, n o mọ,","marked":"gbàná, n ó rí, n ó gbọ́, n ó mọ"},{"start":34.946,"end":36.719,"text":"Ohun gbogbo ti mo ti n fẹ,","marked":"Ohun gbogbo tí mo ti ń fẹ́"},{"start":37.169,"end":38.619,"text":"Gbogbo ipa mi y'o dalu,","marked":"Gbogbo ipá mi y'ó dàlú"},{"start":39.069,"end":40.632,"text":"Lati se'fẹ Rẹ titi lai.","marked":"Láti se'fẹ́ Rẹ títí láì."}],"end":40.632}]}