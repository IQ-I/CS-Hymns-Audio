{"v":3,"coll":"y","num":650,"id":"hymn_650","title":"KI L'O le w'ese mi nu","duration":62.547,"voices":{"male":{"file":"y-650-male-v3.m4a","bytes":445785,"sha256":"658c8e47a7e5ead59fdd794a5e2f743e341ca4c7812a27f6972d89858cc5c569","duration":62.6},"female":{"file":"y-650-female-v3.m4a","bytes":461792,"sha256":"b74637152e8951e9c94d4c79f034a9fb577ffcc3936b5bc0c446c88ae203de38","duration":62.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.702,"text":"KIL'o le w'ese mi nu","marked":"Kíl'ó lè w'ẹsẹ̀ mi nù"},{"start":2.152,"end":3.703,"text":"Ko si lehin eje Jesu","marked":"Kò sì lẹ́hìn ẹ̀jẹ̀ Jésù"},{"start":4.153,"end":5.379,"text":"Kil' o tun le wo mi san","marked":"Kíl ó tún lè wò mí sàn"},{"start":5.829,"end":7.823,"text":"Ko si, lehin eje Jesu.","marked":"Kò sí, lẹ́hìn ẹ̀jẹ̀ Jésù."},{"start":8.273,"end":9.733,"text":"Egbe: A! eje yebiye","marked":"A! ẹ̀jẹ̀ yẹ̀bíyẹ́"},{"start":10.183,"end":11.341,"text":"T'o mu mi fun bi sno","marked":"T'ó mú mi fún bí ṣnọ"},{"start":11.791,"end":12.759,"text":"Ko si sun miran mo","marked":"Kò sì sun míràn mọ́"},{"start":13.209,"end":15.122,"text":"Ko si, lehin eje Jesu.","marked":"Kò sí, lẹ́hìn ẹ̀jẹ̀ Jésù."}],"end":15.122},{"key":"CHORUS","start":16.072,"lines":[{"start":16.072,"end":17.783,"text":"A! eje yebiye","marked":"A! ẹ̀jẹ̀ yẹ̀bíyẹ́"},{"start":18.233,"end":19.352,"text":"T'o mu mi fun bi sno","marked":"T'ó mú mi fún bí ṣnọ"},{"start":19.802,"end":20.835,"text":"Ko si sun miran mo","marked":"Kò sì sun míràn mọ́"},{"start":21.285,"end":23.098,"text":"Ko si, lehin eje Jesu.","marked":"Kò sí, lẹ́hìn ẹ̀jẹ̀ Jésù."}],"end":23.098},{"key":"2","start":24.048,"lines":[{"start":24.048,"end":25.538,"text":"Fun wenumo mi,nko ri","marked":"Fún wẹ̀nùmọ́ mi,nko rí"},{"start":25.988,"end":28.275,"text":"Nkan mi, lehin eje Jesu","marked":"Nǹkan mi, lẹ́hìn ẹ̀jẹ̀ Jésù"},{"start":28.725,"end":29.756,"text":"Ohun ti mo gbekele","marked":"Ohun tí mo gbẹ́kẹ̀lé"},{"start":30.206,"end":31.864,"text":"Fun dariji l'eje Jesu.","marked":"Fún dáríjì l'ẹ̀jẹ̀ Jésù."},{"start":32.314,"end":33.95,"text":"Egbe: A! eje yebiye...","marked":"A! ẹ̀jẹ̀ yẹ̀bíyẹ́"}],"end":33.95},{"key":"3","start":34.9,"lines":[{"start":34.9,"end":36.246,"text":"Etutu f'ese ko si","marked":"Ètùtù f'ẹsẹ̀ kò sí"},{"start":36.696,"end":38.091,"text":"Ko si lehin eje Jesu","marked":"Kò sì lẹ́hìn ẹ̀jẹ̀ Jésù"},{"start":38.541,"end":40.09,"text":"lse rere kan ko si","marked":"Iṣẹ́ rere kan kò sí"},{"start":40.54,"end":42.326,"text":"Ko si, lehin eje Jesu.","marked":"Kò sí, lẹ́hìn ẹ̀jẹ̀ Jésù."},{"start":42.776,"end":44.483,"text":"Egbe: A! eje yebiye...","marked":"A! ẹ̀jẹ̀ yẹ̀bíyẹ́"}],"end":44.483},{"key":"4","start":45.433,"lines":[{"start":45.433,"end":46.581,"text":"Gbogbo igbekele mi","marked":"Gbogbo ìgbẹ́kẹ̀lé mi"},{"start":47.031,"end":48.644,"text":"lreti mi l'eje Jesu","marked":"Ìrètí mi l'ẹ̀jẹ̀ Jésù"},{"start":49.094,"end":50.235,"text":"Gbogbo ododo mi ni","marked":"Gbogbo òdodo mi ni"},{"start":50.685,"end":52.688,"text":"Eje, kiki eje Jesu.","marked":"Ẹ̀jẹ̀, kìkì ẹ̀jẹ̀ Jésù."},{"start":53.138,"end":54.681,"text":"Egbe: A! eje yebiye","marked":"A! ẹ̀jẹ̀ yẹ̀bíyẹ́"},{"start":55.131,"end":56.197,"text":"T'o mu mi fun bi sno","marked":"T'ó mú mi fún bí ṣnọ"},{"start":56.647,"end":57.65,"text":"Ko si sun miran mo","marked":"Kò sì sun míràn mọ́"},{"start":58.1,"end":60.005,"text":"Ko si, lehin eje Jesu.","marked":"Kò sí, lẹ́hìn ẹ̀jẹ̀ Jésù."},{"start":60.455,"end":60.998,"text":"Amin.","marked":"Àmín."}],"end":60.998}]}