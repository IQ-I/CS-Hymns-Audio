{"v":3,"coll":"y","num":329,"id":"hymn_329","title":"B'ELESE s'owo po","duration":39.173,"voices":{"male":{"file":"y-329-male-v3.m4a","bytes":263982,"sha256":"33b810236df9b6a314c628b7685eec564c624f1cd5c449814311bdc787b746b4","duration":39.2},"female":{"file":"y-329-female-v3.m4a","bytes":276292,"sha256":"4d71a38d5cc3d51f4ffe604f531a6d0e23ae79e607e7c5d7cb94138acd5bd814","duration":39.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.568,"text":"B'ẸLẸSẸ s'owọ pọ,","marked":"B'Ẹlẹ́sẹ s'owọ́ pọ̀"},{"start":2.018,"end":3.161,"text":"Ti wọn nde s'Oluwa,","marked":"Tí wọ́n ńdé s'Olúwa"},{"start":3.611,"end":5.001,"text":"Dimọ si Kristi Rẹ,","marked":"Dímọ́ sí Kristi Rẹ"},{"start":5.451,"end":6.954,"text":"Lati gan Ọba na,","marked":"Láti gan Ọba ná"},{"start":7.404,"end":8.469,"text":"B'ayé n sata,","marked":"B'ayé ń ṣátà"},{"start":8.919,"end":10.82,"text":"Pẹlu Esu, eke ni wọn,","marked":"Pẹ̀lú Èṣù, èké ni wọ́n"},{"start":11.27,"end":12.394,"text":"Wọn n se lasan.","marked":"Wọ́n ń ṣe lásán."}],"end":12.394},{"key":"2","start":13.344,"lines":[{"start":13.344,"end":14.388,"text":"Olugbala joba!","marked":"Olùgbàlà jọba!"},{"start":14.838,"end":15.836,"text":"Lori oke Sion","marked":"Lórí òkè Sion"},{"start":16.286,"end":17.229,"text":"Ase ti Oluwa","marked":"Àṣẹ ti Olúwa"},{"start":17.679,"end":18.709,"text":"Gbe Omo Tire ro","marked":"Gbé Ọmọ Tìrẹ rọ"},{"start":19.159,"end":20.106,"text":"Lati 'boji","marked":"Láti bojì"},{"start":20.556,"end":21.98,"text":"O ni, k' O nde","marked":"Ó ní, k Ó ńdẹ"},{"start":22.43,"end":23.315,"text":"K' O si goke","marked":"K Ó sì gòkè"},{"start":23.765,"end":24.787,"text":"K' O gba ni la.","marked":"K Ó gbà ní là."}],"end":24.787},{"key":"3","start":25.737,"lines":[{"start":25.737,"end":26.832,"text":"F'ẹru sin Oluwa,","marked":"F'ẹ́rù sin Olúwa"},{"start":27.282,"end":28.682,"text":"Si bọwọ f'asẹ Rẹ;","marked":"Sì bọ̀wọ̀ f'àsẹ Rẹ"},{"start":29.132,"end":30.398,"text":"F'ayọ wa sọdọ Rẹ,","marked":"F'ayọ̀ wá sọ́dọ̀ Rẹ"},{"start":30.848,"end":32.126,"text":"F'iwariri duro;","marked":"F'ìwárìrì dúró"},{"start":32.576,"end":33.679,"text":"p Ẹ kunlẹ fun,","marked":"p Ẹ kúnlẹ̀ fún"},{"start":34.129,"end":34.91,"text":"K'ẹ tẹriba:","marked":"K'ẹ́ tẹríba"},{"start":35.36,"end":36.331,"text":"Sọ t'ipa Rẹ,","marked":"Sọ t'ipa Rẹ"},{"start":36.781,"end":37.624,"text":"Ki ọmọ na.","marked":"Kí ọmọ ná."}],"end":37.624}]}