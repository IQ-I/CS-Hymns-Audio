{"v":3,"coll":"y","num":749,"id":"hymn_749","title":"IRANSE Olorun seun","duration":44.727,"voices":{"male":{"file":"y-749-male-v3.m4a","bytes":317229,"sha256":"7bd7b15a3e2803fc8d893be505e478bdea4c3bec4fe48a86708f4cc7de8aed33","duration":44.8},"female":{"file":"y-749-female-v3.m4a","bytes":326147,"sha256":"3ea8860bea23a0901ef61ac531e57ab6f5187ae95b377dee1e5da96eb2abb05f","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.395,"text":"'RANSẸ Ọlọrun seun;","marked":"'Ransẹ Ọlọ́run ṣeun"},{"start":1.845,"end":2.932,"text":"Sinmi n'nu lala rẹ;","marked":"Sinmi n'nú làlá rẹ̀"},{"start":3.382,"end":5.293,"text":"Iwọ ti ja, o si sẹgun;","marked":"Ìwọ ti jà, ó sì sẹ́gun"},{"start":5.743,"end":6.908,"text":"Bọ s'ayọ Baba rẹ","marked":"Bọ̀ s'ayọ̀ Baba rẹ"},{"start":7.358,"end":8.416,"text":"Ohun na de loru,","marked":"Ohun ná dé lóru"},{"start":8.866,"end":10.059,"text":"O dide lati gbọ;","marked":"Ó dìde láti gbọ́"},{"start":10.509,"end":11.792,"text":"Ọfa iku si wọ l'ara,","marked":"Ọfà ikú sì wọ l'ára"},{"start":12.242,"end":13.442,"text":"O subu ko bẹru.","marked":"Ó ṣubú kò bẹ̀rù."}],"end":13.442},{"key":"2","start":14.392,"lines":[{"start":14.392,"end":15.522,"text":"Igbe ta lọganjọ,","marked":"Igbe ta lọ́gànjọ́"},{"start":15.972,"end":16.923,"text":"Pade Ọlọrun rẹ","marked":"Pàdé Ọlọ́run rẹ"},{"start":17.373,"end":19.321,"text":"O ji, o ri Balogun rẹ,","marked":"Ó jí, ó rí Balógun rẹ̀"},{"start":19.771,"end":21.415,"text":"N'nu adura oun 'gbagbọ;","marked":"N'nú àdúrà òun 'gbagbọ"},{"start":21.865,"end":22.95,"text":"Ọkan rẹ n de wiri,","marked":"Ọkàn rẹ̀ ń dẹ wírì"},{"start":23.4,"end":24.453,"text":"O bọ amọ silẹ,","marked":"Ó bọ́ amọ̀ sílẹ̀"},{"start":24.903,"end":26.912,"text":"Gbat' ilẹ mọ, agọ ara","marked":"Gbàt ilẹ̀ mọ́, àgọ́ ara"},{"start":27.362,"end":28.831,"text":"Si sun silẹ l'oku.","marked":"Sì sùn sílẹ̀ l'òkú."}],"end":28.831},{"key":"3","start":29.781,"lines":[{"start":29.781,"end":30.876,"text":"'Rora iku kọja,","marked":"rọra ikú kọjá"},{"start":31.326,"end":32.552,"text":"Lala at'isẹ tan;","marked":"Lálà àt'isẹ́ tán"},{"start":33.002,"end":34.306,"text":"Ọjọ ogun jaja pari,","marked":"Ọjọ́ ogun jajá parí"},{"start":34.756,"end":35.773,"text":"Ọkan rẹ r'alafia,","marked":"Ọkàn rẹ̀ r'àlàáfíà"},{"start":36.223,"end":37.948,"text":"Ọmọ Ogun Krist' o seun!","marked":"Ọmọ Ogun Krist ó ṣeun!"},{"start":38.398,"end":39.548,"text":"Ma kọrin ayọ sa!","marked":"Má kọrin ayọ̀ sá!"},{"start":39.998,"end":41.442,"text":"Sinmi lọdọ Olugbala,","marked":"Sinmi lọ́dọ̀ Olùgbàlà"},{"start":41.892,"end":43.178,"text":"Sinmi titi ayé.","marked":"Sinmi títí ayé."}],"end":43.178}]}