{"v":3,"coll":"y","num":518,"id":"hymn_518","title":"ORUKO kan mbe ti mo fe","duration":49.067,"voices":{"male":{"file":"y-518-male-v3.m4a","bytes":338508,"sha256":"5b923ed10055ca1873c2a1c2e9b8521128425dd479fc7f03279014e2c46ae598","duration":49.1},"female":{"file":"y-518-female-v3.m4a","bytes":351935,"sha256":"34f3addfa4f82dcc2232cda0fa5d1ab59506dc372060525eb74701559f529504","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.856,"text":"ORUKO kan mbe ti mo fe","marked":"Orúkọ kan mbẹ́ tí mo fẹ́"},{"start":2.306,"end":3.322,"text":"Mo fe ma korin re","marked":"Mo fẹ́ má kọrin rẹ̀"},{"start":3.772,"end":5.141,"text":"Iro didun ni l'eti mi","marked":"Ìró dídùn ni l'etí mi"},{"start":5.591,"end":6.832,"text":"Oruko didun ni.","marked":"Orúkọ dídùn ni."}],"end":6.832},{"key":"2","start":7.782,"lines":[{"start":7.782,"end":9.34,"text":"O so ife Olugbala","marked":"Ó sọ ìfẹ́ Olùgbàlà"},{"start":9.79,"end":11.283,"text":"T'o ku lati ra mi","marked":"T'ó kú láti rà mí"},{"start":11.733,"end":13.33,"text":"O so t'eje re 'yebiye","marked":"Ó sọ t'ẹ̀jẹ̀ rẹ̀ yẹ̀bíyẹ́"},{"start":13.78,"end":15.014,"text":"Etutu f'elese.","marked":"Ètùtù f'ẹlẹ́ṣẹ̀."}],"end":15.014},{"key":"3","start":15.964,"lines":[{"start":15.964,"end":17.216,"text":"O sọ ti yọnu Baba,","marked":"Ó sọ ti yọ́nú Baba"},{"start":17.666,"end":18.756,"text":"T'O ni s'ọmọ Rẹ;","marked":"T'Ó ní s'ọmọ Rẹ"},{"start":19.206,"end":21.168,"text":"O m'ara mi ya, lati la","marked":"Ó m'ara mi yà, láti là"},{"start":21.618,"end":22.846,"text":"Aginju ayé ja.","marked":"Aginjù ayé jà."}],"end":22.846},{"key":"4","start":23.796,"lines":[{"start":23.796,"end":26.124,"text":"Jesu, Orukọ ti mo fẹ,","marked":"Jésù, Orúkọ tí mo fẹ́"},{"start":26.574,"end":28.045,"text":"T'o si dun l'eti mi;","marked":"T'ó sì dùn l'etí mi"},{"start":28.495,"end":30.002,"text":"Ko s'ẹni mimọ kan l'ayé,","marked":"Kò s'ẹni mímọ́ kan l'ayé"},{"start":30.452,"end":31.852,"text":"T'o mọ b'o ti pọ to.","marked":"T'ó mọ̀ b'ó ti pọ̀ tó."}],"end":31.852},{"key":"5","start":32.802,"lines":[{"start":32.802,"end":34.318,"text":"Orukọ yi j'orun didun,","marked":"Orúkọ yí j'ọ̀run dídùn"},{"start":34.768,"end":36.083,"text":"L'ọna ẹgun t'a ń rin,","marked":"L'ọ́nà ẹ̀gún t'á ń rìn"},{"start":36.533,"end":38.107,"text":"Yoo tun ọna yangi se,","marked":"Yóò tún ọ̀nà yangí ṣe"},{"start":38.557,"end":39.816,"text":"T'o lọ s'ọdọ Ọlọrun.","marked":"T'ó lọ s'ọ́dọ̀ Ọlọ́run."}],"end":39.816},{"key":"6","start":40.766,"lines":[{"start":40.766,"end":42.066,"text":"Nibẹ pẹlu awọn mimọ,","marked":"Níbẹ̀ pẹ̀lú àwọn mímọ́"},{"start":42.516,"end":43.628,"text":"Ti wọn 'bọ nin' ẹsẹ?","marked":"Tí wọ́n 'bọ nín ẹsẹ̀?"},{"start":44.078,"end":45.723,"text":"Emi o kọrin titun ni,","marked":"Èmi ó kọrin titun ni"},{"start":46.173,"end":47.518,"text":"T'ifẹ Jesu si mi.","marked":"T'ìfẹ́ Jésù sí mi."}],"end":47.518}]}