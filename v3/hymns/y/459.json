{"v":3,"coll":"y","num":459,"id":"hymn_459","title":"L'ona gbogbo t'Oluwa yan","duration":32.886,"voices":{"male":{"file":"y-459-male-v3.m4a","bytes":225074,"sha256":"d7bfbb96e8601e79c67eda63b207ba67478f8599be35593262fce334546e0fb1","duration":32.9},"female":{"file":"y-459-female-v3.m4a","bytes":232403,"sha256":"248f1c388597c9ceb888a1f09dbfde65267b683330159863f61f81867a8d1ee8","duration":32.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.777,"text":"L'ỌNA gbogbo t'Oluwa yan","marked":"L'Ọ̀nà gbogbo t'Olúwa yàn"},{"start":2.227,"end":3.54,"text":"Ajo mi l'em' o tọ;","marked":"Àjọ mi l'em ó tọ́"},{"start":3.99,"end":5.814,"text":"Ma da mi ro, ẹyin mimọ,","marked":"Má dá mi rò, ẹ̀yin mímọ́"},{"start":6.264,"end":7.486,"text":"Emi o ba yin lọ.","marked":"Èmi ó bá yín lọ."}],"end":7.486},{"key":"2","start":8.436,"lines":[{"start":8.436,"end":9.749,"text":"Bi Jesu ń lọ ninu ina;","marked":"Bí Jésù ń lọ nínú iná"},{"start":10.199,"end":11.293,"text":"Emi o tọ lẹhin:","marked":"Èmi ó tọ́ lẹ́hìn"},{"start":11.743,"end":13.601,"text":"Ma da mi ro, l'emi o ke,","marked":"Má dá mi rò, l'èmi ó ké"},{"start":14.051,"end":15.577,"text":"Bi ayé d'ojukọ mi.","marked":"Bí ayé d'ojúkọ mi."}],"end":15.577},{"key":"3","start":16.527,"lines":[{"start":16.527,"end":18.029,"text":"Ninu isin at'idanwo","marked":"Nínú ìsìn àt'ìdánwò"},{"start":18.479,"end":19.696,"text":"Em'o lo l'ase Re","marked":"Èm'ó lọ l'àṣẹ Rẹ̀"},{"start":20.146,"end":21.879,"text":"Ma da mi ro, emi o lo","marked":"Má dá mi rò, èmi ó lọ"},{"start":22.329,"end":23.427,"text":"S'ile Emmanuel.","marked":"S'ilé Emmanuel."}],"end":23.427},{"key":"4","start":24.377,"lines":[{"start":24.377,"end":25.614,"text":"'Gba Olugbala mi ba pe,","marked":"gba Olùgbàlà mi bá pé"},{"start":26.064,"end":27.275,"text":"Sibẹ k'igbe mi jẹ,","marked":"Síbẹ̀ k'igbe mi jẹ́"},{"start":27.725,"end":29.671,"text":"Ma da mi ro, iku ma bọ,","marked":"Má dá mi rò, ikú má bọ̀"},{"start":30.121,"end":31.336,"text":"N ó ba ọ lọ l'ayọ.","marked":"N ó bá ọ lọ l'ayọ̀."}],"end":31.336}]}