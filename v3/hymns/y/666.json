{"v":3,"coll":"y","num":666,"id":"hymn_666","title":"AWON asepe, abura","duration":39.062,"voices":{"male":{"file":"y-666-male-v3.m4a","bytes":267159,"sha256":"4e229f5bacbc8bc77ea9a42f365b43f8029bf521b284d021cc6439b805305e73","duration":39.1},"female":{"file":"y-666-female-v3.m4a","bytes":272912,"sha256":"ed36f4260d7b7682aba4762d114776d47a6c7dfbac40125ead6e1a16399859f2","duration":39.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.11,"text":"AWỌN asepe, abura","marked":"Àwọn àṣepé, àbúrà"},{"start":2.56,"end":3.534,"text":"At' awọn onija;","marked":"Àt àwọn oníjà"},{"start":3.984,"end":5.497,"text":"Ni ijọ kan pẹlu abọ,","marked":"Ní ìjọ kan pẹ̀lú abọ́"},{"start":5.947,"end":7.61,"text":"Ni ki y'o jẹ s'ọwọ wọn.","marked":"Ní kí y'ó jẹ́ s'ọwọ́ wọn."}],"end":7.61},{"key":"2","start":8.56,"lines":[{"start":8.56,"end":10.24,"text":"Orin buburu ti wọn n kọ,","marked":"Orin búburú tí wọ́n ń kọ́"},{"start":10.69,"end":11.757,"text":"Jẹ 'rira l'eti mi,","marked":"Jẹ́ ríra l'etí mi"},{"start":12.207,"end":13.551,"text":"K'iru ọrọ buburu wọn ,","marked":"K'irú ọ̀rọ̀ búburú wọn"},{"start":14.001,"end":15.201,"text":"Mase t' ẹnu mi bọ.","marked":"Máṣe t ẹnu mi bọ̀."}],"end":15.201},{"key":"3","start":16.151,"lines":[{"start":16.151,"end":17.297,"text":"Awon alailero omo","marked":"Àwọn aláìlérò ọmọ"},{"start":17.747,"end":18.684,"text":"Awon Omo-komo","marked":"Àwọn Omo-komo"},{"start":19.134,"end":21.17,"text":"Ki y'o f;'ijo kan j'egbe mi","marked":"Kí y'ó f;'ijo kan j'ègbé mi"},{"start":21.62,"end":22.553,"text":"A f'ologbon omo.","marked":"A f'ọlọ́gbọ́n ọmọ."}],"end":22.553},{"key":"4","start":23.503,"lines":[{"start":23.503,"end":25.149,"text":"Alailojuti omo kan","marked":"Aláìlójútì ọmọ kan"},{"start":25.599,"end":26.859,"text":"Ni b'awon t'o ku je","marked":"Ní b'àwọn t'ó kù jẹ́"},{"start":27.309,"end":28.549,"text":"Elekuru obuko kan","marked":"Elékurú òbúkọ kan"},{"start":28.999,"end":30.5,"text":"Ni ko orun w'agbo.","marked":"Ní kó ọ̀run w'àgbò."}],"end":30.5},{"key":"5","start":31.45,"lines":[{"start":31.45,"end":32.826,"text":"Ma jẹ ki n k'ẹgbẹ buburu,","marked":"Má jẹ́ kí n k'ẹ̀gbẹ́ búburú"},{"start":33.276,"end":34.31,"text":"Ọlọrun Oluwa;","marked":"Ọlọ́run Olúwa"},{"start":34.76,"end":35.893,"text":"Ki n ma si si ninu wọn,","marked":"Kí n má sì sí nínú wọn"},{"start":36.343,"end":37.513,"text":"Ti n lọ s'ọrun egbe!","marked":"Tí ń lọ s'ọ̀run ẹgbẹ́!"}],"end":37.513}]}