{"v":3,"coll":"y","num":221,"id":"hymn_221","title":"A ki gbogbo nyin ku odun","duration":70.625,"voices":{"male":{"file":"y-221-male-v3.m4a","bytes":502344,"sha256":"9fe7de2756a71390d03acb8bdd9941909bea5b8ea983637fb1f1cb46549fd75e","duration":70.7},"female":{"file":"y-221-female-v3.m4a","bytes":516189,"sha256":"5d6cdd3ba50706210507938e1945f3a2417785098338b763bdf3ea6de92ca30a","duration":70.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.841,"text":"A ki gbogbo nyin ku odun,","marked":"A kí gbogbo yín kú ọdún"},{"start":2.291,"end":3.907,"text":"E ku ajoy'odun titun","marked":"Ẹ kú àjọy'ọdún titun"},{"start":4.357,"end":5.849,"text":"E jek'a sope f'Oluwa","marked":"Ẹ jẹ́k'á ṣọpẹ́ f'Olúwa"},{"start":6.299,"end":8.439,"text":"T'o da Emi wa si d'oni.","marked":"T'ó dá Èmi wa sì d'óní."}],"end":8.439},{"key":"2","start":9.389,"lines":[{"start":9.389,"end":10.908,"text":"Opo omode at'agba","marked":"Ọ̀pọ̀ ọmọdé àt'àgbà"},{"start":11.358,"end":12.861,"text":"T'o ti ngbo 'mura ajodun yi,","marked":"T'ó ti ńgbọ́ múra àjọ̀dún yí"},{"start":13.311,"end":14.73,"text":"Opolopo ti koja lo","marked":"Ọ̀pọ̀lọpọ̀ ti kọjá lọ"},{"start":15.18,"end":16.696,"text":"Won ti file bora b'aso.","marked":"Wọ́n ti filẹ̀ bora b'aṣọ."}],"end":16.696},{"key":"3","start":17.646,"lines":[{"start":17.646,"end":19.3,"text":"Egbe agba alatunse","marked":"Ẹgbẹ́ àgbà alátúnṣe"},{"start":19.75,"end":21.214,"text":"E ku atunse egbe na","marked":"Ẹ kú àtúnṣe ẹgbẹ́ ná"},{"start":21.664,"end":23.125,"text":"Baba orun yio pelu nyin","marked":"Baba ọ̀run yóò pẹ̀lú yín"},{"start":23.575,"end":25.019,"text":"Yio fi nyin s'agba kale.","marked":"Yóò fi yín s'àgbà kalẹ̀."}],"end":25.019},{"key":"4","start":25.969,"lines":[{"start":25.969,"end":27.474,"text":"A ki Bale p'e ku odun","marked":"A kí Balẹ̀ p'é kú ọdún"},{"start":27.924,"end":29.406,"text":"Ati gbogb' awon ljoye","marked":"Àti gbogb àwọn Ìjòyè"},{"start":29.856,"end":31.466,"text":"E ku itoju ilu yi","marked":"Ẹ kú ìtọ́jú ìlú yí"},{"start":31.916,"end":33.363,"text":"Oluwa yio ran yin lowo.","marked":"Olúwa yóò ràn yín lọ́wọ́."}],"end":33.363},{"key":"5","start":34.313,"lines":[{"start":34.313,"end":35.989,"text":"Mase foiya onigbagbo","marked":"Mase fòìyà onígbàgbọ́"},{"start":36.439,"end":38.309,"text":"Jesu yio pese l'odun yi","marked":"Jésù yóò pèsè l'ọdún yí"},{"start":38.759,"end":40.576,"text":"Eni ko bi, iyen a bi","marked":"Ẹni kò bí, ìyẹn a bí"},{"start":41.026,"end":42.446,"text":"Eni bi tire a tunla.","marked":"Ẹni bí tirẹ̀ a túnlá."}],"end":42.446},{"key":"6","start":43.396,"lines":[{"start":43.396,"end":44.966,"text":"B'ina ku a feru b'oju","marked":"B'iná kú a fẹ́rù b'ojú"},{"start":45.416,"end":46.99,"text":"B'ogede ku a f'omo ropo","marked":"B'ọ̀gẹ̀dẹ̀ kú a f'ọmọ rọ́pò"},{"start":47.44,"end":49.109,"text":"O daju pe b'o tile pe","marked":"Ó dájú pé b'ó tilẹ̀ pé"},{"start":49.559,"end":50.734,"text":"Omo wa ni o ropo wa.","marked":"Ọmọ wa ni ó rọ́pò wa."}],"end":50.734},{"key":"7","start":51.684,"lines":[{"start":51.684,"end":53.538,"text":"Gbogbo alejo, a ki nyin","marked":"Gbogbo àlejò, a kí yín"},{"start":53.988,"end":55.166,"text":"At' awon olufe owon","marked":"Àt àwọn olùfẹ́ ọ̀wọ́n"},{"start":55.616,"end":57.331,"text":"Jesu yio toju ile nyin","marked":"Jésù yóò tọ́jú ilé yín"},{"start":57.781,"end":59.181,"text":"Yio si bukun gbogbo nyin.","marked":"Yóò sì bùkún gbogbo yín."}],"end":59.181},{"key":"8","start":60.131,"lines":[{"start":60.131,"end":62.048,"text":"A ki nyin pe E ku odun","marked":"A kí yín pé Ẹ kú ọdún"},{"start":62.498,"end":64.093,"text":"Odun titun t'a nse loni","marked":"Ọdún títún t'á ńṣe lónì"},{"start":64.543,"end":66.006,"text":"K'Olorun da emi wa si","marked":"K'Ọlọ́run dá èmi wá sí"},{"start":66.456,"end":68.021,"text":"Ki gbogbo wa se t' amodun.","marked":"Kí gbogbo wa ṣe t àmọ́dún."},{"start":68.471,"end":69.076,"text":"Amin.","marked":"Àmín."}],"end":69.076}]}