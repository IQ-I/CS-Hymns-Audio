{"v":3,"coll":"y","num":359,"id":"hymn_359","title":"E JUBA Olorun wa, Jah","duration":70.527,"voices":{"male":{"file":"y-359-male-v3.m4a","bytes":485983,"sha256":"07b4ee10faa890d7c5815165395c123ade49da5c1533f7bd7242b85b342d0742","duration":70.6},"female":{"file":"y-359-female-v3.m4a","bytes":508207,"sha256":"68bcafa7da8495e6f3f340146a7638f9f997988f83c9e9a63b87c0167e137b90","duration":70.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.228,"text":"Ẹ JUBA Ọlọrun wa, Jah,","marked":"Ẹ Júbà Ọlọ́run wa, Jah"},{"start":2.678,"end":3.795,"text":"Ọba onifẹ julọ,","marked":"Ọba onífẹ́ jùlọ"},{"start":4.245,"end":6.058,"text":"Olubori, Ajabori,","marked":"Olúborí, Ajabori"},{"start":6.508,"end":7.982,"text":"Ọba Ọrun oun Ayé.","marked":"Ọba Ọ̀run òun Ayé."}],"end":7.982},{"key":"CHORUS","start":8.932,"lines":[{"start":8.932,"end":10.181,"text":"Ijinle loro na,","marked":"Ìjìnlẹ̀ lọ́rọ̀ ná"},{"start":10.631,"end":11.902,"text":"Awamaridi si ni.","marked":"Àwamaridi sì ni."}],"end":11.902},{"key":"2","start":12.852,"lines":[{"start":12.852,"end":14.336,"text":"Bayi l'o dawon eda Re","marked":"Báyì l'ó dáwọn ẹ̀dà Rẹ"},{"start":14.786,"end":15.948,"text":"B'o ti wu O l'o da won","marked":"B'ó ti wù Ọ́ l'ó dá wọn"},{"start":16.398,"end":17.682,"text":"Awimayehun sa ni O","marked":"Àwímáyèhùn sá ni Ọ"},{"start":18.132,"end":19.206,"text":"Awamaridi ni O.","marked":"Àwamaridi ni Ọ."}],"end":19.206},{"key":"3","start":20.156,"lines":[{"start":20.156,"end":22.186,"text":"Nibi t'ọna ko ti si ri,","marked":"Níbi t'ọ̀nà kò ti sì rí"},{"start":22.636,"end":23.927,"text":"Nibẹ ni 'joko mi wa","marked":"Níbẹ̀ ni jókò mi wà"},{"start":24.377,"end":26.2,"text":"Nip'agbara at'asa mi,","marked":"Níp'agbára àt'àṣà mi"},{"start":26.65,"end":27.932,"text":"Larin awọn eniyan mi.","marked":"Lárin àwọn ènìyàn mi."}],"end":27.932},{"key":"4","start":28.882,"lines":[{"start":28.882,"end":30.166,"text":"A ha ri ẹni le pada,","marked":"A ha rí ẹni lè padà"},{"start":30.616,"end":31.956,"text":"Gba mba n sisẹ ogo mi,","marked":"Gba mbá ń sisẹ́ ògo mi"},{"start":32.406,"end":33.852,"text":"Awọn Angel' to l'agbara,","marked":"Àwọn Angẹl tó l'agbára"},{"start":34.302,"end":35.687,"text":"Wọn ko jẹ dan eyi wo.","marked":"Wọn kò jẹ́ dán èyí wò."}],"end":35.687},{"key":"5","start":36.637,"lines":[{"start":36.637,"end":38.718,"text":"Lusifa t'o l'agbara ju","marked":"Lusifa t'ó l'agbára jù"},{"start":39.168,"end":40.358,"text":"Gbogbo awon Angel' lo","marked":"Gbogbo àwọn Angẹl lọ"},{"start":40.808,"end":42.267,"text":"O f'owo pa 'da mi loju","marked":"Ó f'ọwọ́ pa dá mi lójú"},{"start":42.717,"end":44.06,"text":"O si d'eni ifibu.","marked":"Ó sì d'ẹni ìfibú."}],"end":44.06},{"key":"6","start":45.01,"lines":[{"start":45.01,"end":46.25,"text":"Ẹgbẹgbẹrun ogun ọrun,","marked":"Ẹgbẹgbẹ̀rún ogun ọ̀run"},{"start":46.7,"end":48.108,"text":"L'o n sọ ti agbara mi,","marked":"L'ó ń sọ ti agbára mi"},{"start":48.558,"end":50.043,"text":"Ogo, Ọla ati 'pa mi,","marked":"Ògo, Ọlá àti pa mí"},{"start":50.493,"end":51.78,"text":"Wọn n juba Agbara mi.","marked":"Wọ́n ń júbà Agbára mi."}],"end":51.78},{"key":"7","start":52.73,"lines":[{"start":52.73,"end":54.384,"text":"Sibẹ Emi ko yan eyi,","marked":"Síbẹ̀ Èmi kò yan èyí"},{"start":54.834,"end":56.215,"text":"T'o ga julọ ninu wọn,","marked":"T'ó ga jùlọ nínú wọn"},{"start":56.665,"end":58.547,"text":"Sugbọn Maikel t'o kere ju,","marked":"Sùgbọ́n Maikel t'ó kéré jù"},{"start":58.997,"end":60.172,"text":"Ni Mo gbega ninu wọn.","marked":"Ni Mo gbéga nínú wọn."}],"end":60.172},{"key":"8","start":61.122,"lines":[{"start":61.122,"end":62.7,"text":"Agbara ninu Agbara,","marked":"Agbára nínú Agbára"},{"start":63.15,"end":64.476,"text":"Ogo, Ọla at'ipa,","marked":"Ògo, Ọlá àt'ipá"},{"start":64.926,"end":67.156,"text":"Tẹru, tẹru, tifẹtifẹ,","marked":"Tẹrù, tẹrù, tìfẹ́tìfẹ́"},{"start":67.606,"end":68.978,"text":"Ifẹ si l'orukọ mi","marked":"Ìfẹ́ sì l'orúkọ mi"}],"end":68.978}]}