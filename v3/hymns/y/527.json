{"v":3,"coll":"y","num":527,"id":"hymn_527","title":"ARA, e je ka jumo rin","duration":53.231,"voices":{"male":{"file":"y-527-male-v3.m4a","bytes":383054,"sha256":"126fffd01831ee4f96688fb2c426b776ce78ccee12ab6c240f75248a967160f7","duration":53.3},"female":{"file":"y-527-female-v3.m4a","bytes":396735,"sha256":"b7694ed8f276dc7b303716d03da468098bd7990d7fa987156423c2473340ac1e","duration":53.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.268,"text":"ARA, ẹ jẹ ka jumọ rin,","marked":"Ara, ẹ jẹ́ ká jùmọ̀ rìn"},{"start":2.718,"end":3.948,"text":"N'ifẹ oun alafia;","marked":"N'ìfẹ́ òun àlàáfíà"},{"start":4.398,"end":5.652,"text":"A ha le ma tun bere pe,","marked":"A ha lè má tún bẹ̀rẹ̀ pé"},{"start":6.102,"end":7.423,"text":"O tọ k'a ba f'ija mọ?","marked":"Ó tọ́ k'á bá f'ìjà mọ́?"},{"start":7.873,"end":9.801,"text":"Ni irẹpọ, ni irẹpọ,","marked":"Ní ìrẹ́pọ̀, ní ìrẹ́pọ̀"},{"start":10.251,"end":12.096,"text":"L'ayọ, ifẹ y'o fi pọ.","marked":"L'ayọ̀, ìfẹ́ y'ó fi pọ̀."}],"end":12.096},{"key":"2","start":13.046,"lines":[{"start":13.046,"end":15.322,"text":"B'a ti n rin lọ sile, jẹ ka,","marked":"B'á ti ń rìn lọ sílẹ̀, jẹ́ ká"},{"start":15.772,"end":16.982,"text":"Ran 'ra wa lọwọ l'ọna;","marked":"Rán rà wá lọ́wọ́ l'ọ́nà"},{"start":17.432,"end":18.897,"text":"Ọta ka wa nibi gbogbo;","marked":"Ọ̀tá ká wà níbi gbogbo"},{"start":19.347,"end":20.708,"text":"S'ọna gbogbo l'a dẹkun,","marked":"S'ọ́nà gbogbo l'á dẹ́kun"},{"start":21.158,"end":23.288,"text":"Isẹ wa ni, isẹ wa ni,","marked":"Isẹ́ wa ni, isẹ́ wa ni"},{"start":23.738,"end":25.169,"text":"K'a ma ran 'ra wa l'ẹru.","marked":"K'á má rán rà wá l'ẹ́rù."}],"end":25.169},{"key":"3","start":26.119,"lines":[{"start":26.119,"end":27.773,"text":"Nigba t'a rohun Baba se,","marked":"Nígbà t'á rohùn Baba ṣe"},{"start":28.223,"end":30.649,"text":"T'o ti fi ji, t'o n fiji,","marked":"T'ó ti fi jí, t'ó ń fíjì"},{"start":31.099,"end":33.167,"text":"Ara, ko tọ k'awa k'o kọ","marked":"Ara, kò tọ́ k'àwa k'ó kọ"},{"start":33.617,"end":34.97,"text":"Lati ma f'ija silẹ?","marked":"Láti má f'ìjà sílẹ̀?"},{"start":35.42,"end":37.446,"text":"K'a mu kuro, k'a mu kuro,","marked":"K'á mú kúrò, k'á mú kúrò"},{"start":37.896,"end":39.093,"text":"Ohun 'ba mu 'binu wa.","marked":"Ohun bá mú bínú wá."}],"end":39.093},{"key":"4","start":40.043,"lines":[{"start":40.043,"end":41.536,"text":"K'a gb'ọmọnikeji wa ga,","marked":"K'á gb'ọmọnìkejì wa ga"},{"start":41.986,"end":43.259,"text":"Ju b'a ba ti gbe 'ra wa ,","marked":"Ju b'á bá ti gbé ra wa"},{"start":43.709,"end":45.403,"text":"K'a fi keta gbogbo silẹ,","marked":"K'á fi kẹta gbogbo sílẹ̀"},{"start":45.853,"end":47.22,"text":"K'ọkan wa si kun fun 'fẹ,","marked":"K'ọkàn wa sì kún fún 'fẹ"},{"start":47.67,"end":49.761,"text":"Yoo rọ wa, yoo rọ wa,","marked":"Yóò rọ̀ wá, yóò rọ̀ wá"},{"start":50.211,"end":51.682,"text":"B'a wa n'irẹpọ layé.","marked":"B'á wá n'ìrẹpọ̀ layé."}],"end":51.682}]}