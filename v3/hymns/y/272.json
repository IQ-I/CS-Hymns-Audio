{"v":3,"coll":"y","num":272,"id":"hymn_272","title":"SA dake okan mi","duration":29.777,"voices":{"male":{"file":"y-272-male-v3.m4a","bytes":198050,"sha256":"e0593ad9aa39512d5b2ebeb1ec733cc4aea5ecd2d697c99ea72e64c8ac4435e2","duration":29.8},"female":{"file":"y-272-female-v3.m4a","bytes":208293,"sha256":"50765f211ff0d1f727179a05cadfe924776f129e3f532b1cdd990d131c2c1d9b","duration":29.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.444,"text":"SA dakẹ ọkan mi,","marked":"Sá dákẹ́ ọkàn mi"},{"start":1.894,"end":2.97,"text":"Oluwa rẹ wa mbẹ;","marked":"Olúwa rẹ̀ wá mbẹ́"},{"start":3.42,"end":4.68,"text":"Eni t'o ti se ileri,","marked":"Ẹni t'ó ti ṣe ìlérí"},{"start":5.13,"end":6.246,"text":"Yoo fẹ mu u sẹ.","marked":"Yóò fẹ́ mú u sẹ́."}],"end":6.246},{"key":"2","start":7.196,"lines":[{"start":7.196,"end":8.262,"text":"Oun ti fa Ọ lọwọ,","marked":"Òun ti fà Ọ́ lọ́wọ́"},{"start":8.712,"end":9.746,"text":"O mu ọ de 'hin yi;","marked":"Ó mú ọ dé hín yí"},{"start":10.196,"end":12.026,"text":"Y'o pa ọ mọ la ewu ja,","marked":"Y'ó pa ọ́ mọ́ la ewu jà"},{"start":12.476,"end":13.567,"text":"Tit' opin aye rẹ.","marked":"Tít òpin ayé rẹ."}],"end":13.567},{"key":"3","start":14.517,"lines":[{"start":14.517,"end":15.791,"text":"Nigbat' iwọ ti bọ,","marked":"Nígbàt ìwọ ti bọ̀"},{"start":16.241,"end":17.341,"text":"Sinu wahala ri,","marked":"Sínú wàhálà rí"},{"start":17.791,"end":19.636,"text":"Igba rẹ naa ki Oun ha gbọ,","marked":"Ìgbà rẹ̀ náà kí Òun ha gbọ́"},{"start":20.086,"end":21.121,"text":"T'o si yọ ọ kuro?","marked":"T'ó sì yọ ọ́ kúrò?"}],"end":21.121},{"key":"4","start":22.071,"lines":[{"start":22.071,"end":23.458,"text":"B'ọna ko tilẹ dan,","marked":"B'ọ̀nà kò tilẹ̀ dán"},{"start":23.908,"end":24.939,"text":"Yoo mu ọ de 'le;","marked":"Yóò mú ọ dé lé"},{"start":25.389,"end":26.728,"text":"Sa ti wahala aye tan,","marked":"Sá ti wàhálà ayé tán"},{"start":27.178,"end":28.227,"text":"O san fun gbogbo rẹ.","marked":"Ó sàn fún gbogbo rẹ̀."}],"end":28.227}]}