{"v":3,"coll":"y","num":764,"id":"hymn_764","title":"ODUN n yipo, o n ji emi","duration":32.745,"voices":{"male":{"file":"y-764-male-v3.m4a","bytes":229804,"sha256":"9a62609a12f55200f0fa75eb966f9d02d8aa61d72b71209d61743511fc41b9fc","duration":32.8},"female":{"file":"y-764-female-v3.m4a","bytes":235523,"sha256":"378220702f82dcde423626ec569d24fb9185b10e899c79bf04b7728507bc5df1","duration":32.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.236,"text":"ỌDUN n yipo, o n ji emi,","marked":"Ọdún ń yípo, ó ń jí èmi"},{"start":2.686,"end":3.918,"text":"T'O ti fi fun wa ri,","marked":"T'Ó ti fi fún wa rí"},{"start":4.368,"end":5.846,"text":"Ibikibi to wu ka wa,","marked":"Ibikíbi tó wù ká wá"},{"start":6.296,"end":7.678,"text":"Isa-oku la n re.","marked":"Isa-oku là ń rẹ̀."}],"end":7.678},{"key":"2","start":8.628,"lines":[{"start":8.628,"end":10.048,"text":"Yi ile ka l'ewu duro","marked":"Yí ilẹ̀ ká l'ẹ̀wù dúró"},{"start":10.498,"end":11.761,"text":"Ko le ti wa s'isa","marked":"Kò lè ti wá s'isà"},{"start":12.211,"end":13.389,"text":"Arun buburu si duro","marked":"Àrùn búburú sì dúró"},{"start":13.839,"end":15.188,"text":"Lati le wa lo 'le.","marked":"Láti lè wá lọ lé."}],"end":15.188},{"key":"3","start":16.138,"lines":[{"start":16.138,"end":17.91,"text":"Ayọ tab' egbe ailopin,","marked":"Ayọ̀ tàb ẹgbẹ́ àìlópin"},{"start":18.36,"end":19.303,"text":"Duro de ẹmi wa:","marked":"Dúró de ẹ̀mí wa"},{"start":19.753,"end":21.588,"text":"Wo! ba ti n rin laibikita.","marked":"Wò! bá ti ń rìn láìbìkítà."},{"start":22.038,"end":23.397,"text":"Leti bebe iku.","marked":"Létí bẹ̀bẹ̀ ikú."}],"end":23.397},{"key":"4","start":24.347,"lines":[{"start":24.347,"end":25.668,"text":"Oluwa, ji wa l'ọrun wa,","marked":"Olúwa, jí wá l'ọ̀run wa"},{"start":26.118,"end":27.366,"text":"K'a r'ọna ewu yi:","marked":"K'á r'ọ̀nà ẹ̀wù yí"},{"start":27.816,"end":29.302,"text":"Nigba t'a ba pe ọkan wa,","marked":"Nígbà t'á bá pe ọkàn wa"},{"start":29.752,"end":31.196,"text":"K'a ba Ọ gbe titi.","marked":"K'á bá Ọ gbé títí."}],"end":31.196}]}