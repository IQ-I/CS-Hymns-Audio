{"v":3,"coll":"y","num":252,"id":"hymn_252","title":"OLUWA, gbo aroye mi","duration":41.605,"voices":{"male":{"file":"y-252-male-v3.m4a","bytes":287814,"sha256":"c32b615f9a83c9ba5a157dc5cc5261330081129e7bf0084339b1418dbd698d72","duration":41.7},"female":{"file":"y-252-female-v3.m4a","bytes":293922,"sha256":"03c0263fedc04a360ac406f541ef10e9daef8058e0a94487ca64b8714cf5a72a","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.631,"text":"OLUWA, gbo aroye mi","marked":"Olúwa, gbọ́ àròyé mi"},{"start":2.081,"end":3.515,"text":"Gbo adura ikoko mi","marked":"Gbọ́ àdúrà ìkọ̀kọ̀ mi"},{"start":3.965,"end":5.397,"text":"Lodo Re nikan Oba mi","marked":"Lọ́dọ̀ Rẹ nìkan Ọba mi"},{"start":5.847,"end":7.289,"text":"L'emi O ma wa iranwo.","marked":"L'èmi Ó má wá ìrànwọ́."}],"end":7.289},{"key":"2","start":8.239,"lines":[{"start":8.239,"end":9.55,"text":"L'oro Iwo o gbohun mi","marked":"L'ọ̀rọ̀ Ìwọ ó gbóhùn mi"},{"start":10.0,"end":11.481,"text":"L'afemojumo ojo na","marked":"L'àfẹ̀mọ́júmọ́ ọjọ́ ná"},{"start":11.931,"end":13.538,"text":"Ni odo Re l'emi o wo","marked":"Ní ọ̀dọ̀ Rẹ l'èmi ó wò"},{"start":13.988,"end":15.603,"text":"Si O l'emi o gbadura.","marked":"Sí Ọ l'èmi ó gbàdúrà."}],"end":15.603},{"key":"3","start":16.553,"lines":[{"start":16.553,"end":17.955,"text":"Sugbọn nigb' ore-ọfẹ Rẹ,","marked":"Sùgbọ́n nígb ore-ọfẹ Rẹ"},{"start":18.405,"end":19.749,"text":"Ba mu mi de agbala Rẹ;","marked":"Bá mú mi dé àgbàlá Rẹ"},{"start":20.199,"end":21.558,"text":"Ọdọ Rẹ l'emi o tẹju mọ,","marked":"Ọ̀dọ̀ Rẹ l'èmi ó tẹ́jú mọ́"},{"start":22.008,"end":23.992,"text":"Nibẹ, n o sin Ọ ni rẹlẹ.","marked":"Níbẹ̀, n ó sìn Ọ́ ní rẹ̀lẹ̀."}],"end":23.992},{"key":"4","start":24.942,"lines":[{"start":24.942,"end":26.375,"text":"Jẹ k'awọn t'o gbẹkẹlẹ Ọ,","marked":"Jẹ́ k'àwọn t'ó gbẹ́kẹ̀lẹ́ Ọ"},{"start":26.825,"end":28.212,"text":"L'ohun rara wi ayọ wọn;","marked":"L'ohun rara wí ayọ̀ wọn"},{"start":28.662,"end":30.084,"text":"Jẹ k'awọn t'Iwọ pamọ yọ,","marked":"Jẹ́ k'àwọn t'Ìwọ pamọ́ yọ"},{"start":30.534,"end":32.268,"text":"Awọn t'o fẹ orukọ Rẹ.","marked":"Àwọn t'ó fẹ́ orúkọ Rẹ̀."}],"end":32.268},{"key":"5","start":33.218,"lines":[{"start":33.218,"end":34.531,"text":"Si Olododo l'Oluwa,","marked":"Sí Olódodo l'Olúwa"},{"start":34.981,"end":36.189,"text":"O na ọwọ ibukun Rẹ;","marked":"Ó na ọwọ́ ìbùkún Rẹ̀"},{"start":36.639,"end":38.021,"text":"Oju rere Re l'eniyan Rẹ,","marked":"Ojú rere Rẹ l'ènìyàn Rẹ"},{"start":38.471,"end":40.056,"text":"Yoo si fi se asa wọn.","marked":"Yóò sì fi ṣe àṣà wọn."}],"end":40.056}]}