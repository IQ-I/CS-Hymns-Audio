{"v":3,"coll":"y","num":657,"id":"hymn_657","title":"IRE t' a su ni Eden'","duration":62.329,"voices":{"male":{"file":"y-657-male-v3.m4a","bytes":428447,"sha256":"fd86365846f017a5b3a47ecc2e1b71a183999aed1c9c5f3eda09797471a7f67c","duration":62.4},"female":{"file":"y-657-female-v3.m4a","bytes":452291,"sha256":"f35448a809c86167edc810ef7819ef7fa7f85dca9d5f64094c3de8d7863a0638","duration":62.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.876,"text":"IRE t' a su ni Eden',","marked":"Ìrè t a ṣú ní Eden"},{"start":2.326,"end":3.493,"text":"N' igbeyawo 'kini,","marked":"N ìgbéyàwó kíni"},{"start":3.943,"end":5.436,"text":"Ibukun t' a bukun won","marked":"Ìbùkún t a bùkún wọn"},{"start":5.886,"end":7.144,"text":"O wa sibesibe.","marked":"Ó wá síbẹ̀síbẹ̀."}],"end":7.144},{"key":"2","start":8.094,"lines":[{"start":8.094,"end":10.174,"text":"Sibe titi di oni","marked":"Síbẹ̀ títí di òní"},{"start":10.624,"end":11.986,"text":"N'igbeyawo Kristian","marked":"N'ìgbéyàwó Kristian"},{"start":12.436,"end":13.585,"text":"Olorun wa larin wa","marked":"Ọlọ́run wa lárin wa"},{"start":14.035,"end":15.312,"text":"Lati sure fun wa.","marked":"Láti súre fún wa."}],"end":15.312},{"key":"3","start":16.262,"lines":[{"start":16.262,"end":18.333,"text":"Ire, kin won le ma bi,","marked":"Ire, kín wọn lè má bí"},{"start":18.783,"end":19.934,"text":"Ki nwon si le ma re;","marked":"Kí wọ́n sì lè má rẹ̀"},{"start":20.384,"end":21.526,"text":"Ki nwon n' idapo mimo","marked":"Kí wọ́n ń ìdàpọ̀ mímọ́"},{"start":21.976,"end":23.7,"text":"T' enikan k'yo le tu.","marked":"T ẹnìkan k'yó lè tú."}],"end":23.7},{"key":"4","start":24.65,"lines":[{"start":24.65,"end":26.49,"text":"Ba ni pe, Baba, si fa","marked":"Bá ni pé, Baba, sì fà"},{"start":26.94,"end":28.115,"text":"Obirin yi f' oko;","marked":"Obìrìn yí f oko"},{"start":28.565,"end":29.876,"text":"Bi o ti Efa fun","marked":"Bí ó ti Efa fún"},{"start":30.326,"end":31.56,"text":"Adam l' ojo kini.","marked":"Adam l ọjọ́ kini."}],"end":31.56},{"key":"5","start":32.51,"lines":[{"start":32.51,"end":33.767,"text":"Ba ni pe Olugbala,","marked":"Bá ni pé Olùgbàlà"},{"start":34.217,"end":35.172,"text":"Si so owo won po,","marked":"Sì sọ ọwọ́ wọn pọ̀"},{"start":35.622,"end":36.873,"text":"B' O ti so ara Re po","marked":"B Ó ti sọ ara Rẹ̀ pọ̀"},{"start":37.323,"end":38.399,"text":"Pelu enia Re.","marked":"Pẹ̀lú ẹnìà Rẹ."}],"end":38.399},{"key":"6","start":39.349,"lines":[{"start":39.349,"end":40.954,"text":"Ba wa pe, Emi Mimo,","marked":"Bá wa pé, Ẹ̀mí Mímọ́"},{"start":41.404,"end":42.518,"text":"F' ibukun Re fun won;","marked":"F ìbùkún Rẹ fún wọn"},{"start":42.968,"end":44.228,"text":"Si se won ni asepe,","marked":"Sì ṣe wọ́n ní àṣepé"},{"start":44.678,"end":46.028,"text":"Gege b' o ti ma se.","marked":"Gẹ́gẹ́ b ó ti má ṣe."}],"end":46.028},{"key":"7","start":46.978,"lines":[{"start":46.978,"end":48.247,"text":"Fi nwon s' abe abo Re,","marked":"Fi wọ́n s abẹ́ abo Rẹ"},{"start":48.697,"end":49.944,"text":"K' ibi kan ma ba won;","marked":"K ibi kan má bá wọn"},{"start":50.394,"end":51.658,"text":"'Gba nwon npara ile Re,","marked":"gba wọ́n ńpara ilé Rẹ"},{"start":52.108,"end":53.283,"text":"Ma toju okan won.","marked":"Má tọ́jú ọkàn wọn."}],"end":53.283},{"key":"8","start":54.233,"lines":[{"start":54.233,"end":55.436,"text":"Pelu won l' oj' aiye won,","marked":"Pẹ̀lú wọn l ọj ayé wọn"},{"start":55.886,"end":57.268,"text":"At' oko at' aya;","marked":"Àt oko àt àyà"},{"start":57.718,"end":59.075,"text":"Titi nwon o d' odo Re","marked":"Títí wọ́n ó d ọ̀dọ̀ Rẹ"},{"start":59.525,"end":60.78,"text":"N' ile ayo l' orun.","marked":"N ilé ayọ̀ l ọ̀run."}],"end":60.78}]}