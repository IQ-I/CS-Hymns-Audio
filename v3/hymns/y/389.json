{"v":3,"coll":"y","num":389,"id":"hymn_389","title":"BABA oke orun","duration":47.872,"voices":{"male":{"file":"y-389-male-v3.m4a","bytes":328987,"sha256":"6fa5975f83990fc771fb29e0aedcd10cdff5c0d85b020a3e0b955b330f0396f9","duration":47.9},"female":{"file":"y-389-female-v3.m4a","bytes":345401,"sha256":"6af3cbea57887feb902fcae72350876f387ed472b1509d94112dbe5948dc6915","duration":47.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.521,"text":"BABA oke ọrun,","marked":"Baba òkè ọ̀run"},{"start":1.971,"end":3.193,"text":"T'imọlẹ at'ifẹ,","marked":"T'ìmọ́lẹ̀ àt'ìfẹ́"},{"start":3.643,"end":4.6,"text":"Ẹni 'gbani,","marked":"Ẹni gbani"},{"start":5.05,"end":6.402,"text":"'Mọlẹ t'a ko le wo,","marked":"'Mọlẹ t'á kò lè wò"},{"start":6.852,"end":8.108,"text":"Ifẹ t'a ko le wo,","marked":"Ìfẹ́ t'a kò lè wò"},{"start":8.558,"end":9.454,"text":"Iwọ Ọba airi,","marked":"Ìwọ Ọba àìrí"},{"start":9.904,"end":10.688,"text":"Awa yin Ọ.","marked":"Àwa yín Ọ́."}],"end":10.688},{"key":"2","start":11.638,"lines":[{"start":11.638,"end":13.047,"text":"Kristi Ọmọ lailai,","marked":"Kristi Ọmọ láéláé"},{"start":13.497,"end":14.507,"text":"'Wọ t'o di eniyan,","marked":"'Wọ t'ó di ènìyàn"},{"start":14.957,"end":15.658,"text":"Olugbala;","marked":"Olùgbàlà"},{"start":16.108,"end":17.128,"text":"Ẹni giga julọ,","marked":"Ẹni gíga jùlọ"},{"start":17.578,"end":19.162,"text":"Ọlọrun, Imọlẹ,","marked":"Ọlọ́run, Ìmọ́lẹ̀"},{"start":19.612,"end":21.263,"text":"Aida at'Ailopin,","marked":"Aida àt'àìlópin"},{"start":21.713,"end":22.646,"text":"A ke pe Ọ.","marked":"A ké pè Ọ́."}],"end":22.646},{"key":"3","start":23.596,"lines":[{"start":23.596,"end":24.458,"text":"Iwọ Ẹmi Mimọ,","marked":"Ìwọ Ẹ̀mí Mímọ́"},{"start":24.908,"end":26.346,"text":"T'ina Pentikost' Rẹ,","marked":"T'iná Pentikost Rẹ̀"},{"start":26.796,"end":27.98,"text":"N tan titi lai,","marked":"Ń tàn títí láì"},{"start":28.43,"end":29.727,"text":"Masai tu wa ninu,","marked":"Masai tú wá nínú"},{"start":30.177,"end":31.46,"text":"L'ayé aginju yi;","marked":"L'ayé aginjù yí"},{"start":31.91,"end":33.073,"text":"'Wọ l'a fẹ 'Wọ l'a yin,","marked":"'Wọ l'á fẹ́ 'Wọ l'á yín"},{"start":33.523,"end":34.466,"text":"A juba Rẹ.","marked":"A júbà Rẹ̀."}],"end":34.466},{"key":"4","start":35.416,"lines":[{"start":35.416,"end":36.553,"text":"Angel' ẹ lu duru,","marked":"Angẹl ẹ lù dùrù"},{"start":37.003,"end":38.512,"text":"K'ọrin t'awa ti ń yin","marked":"K'ọrin t'àwa ti ń yín"},{"start":38.962,"end":39.917,"text":"Jumọ dalu;","marked":"Jùmọ̀ dàlú"},{"start":40.367,"end":41.497,"text":"Ogo fun Ọlọrun,","marked":"Ògo fún Ọlọ́run"},{"start":41.947,"end":42.982,"text":"Mẹtalọkan soso;","marked":"Mẹ́talọ́kan ṣoṣo"},{"start":43.432,"end":44.807,"text":"A yin Ọ tit' ayé","marked":"A yìn Ọ́ tít ayé"},{"start":45.257,"end":46.323,"text":"Ainipẹkun.","marked":"Àìnípẹ̀kun."}],"end":46.323}]}