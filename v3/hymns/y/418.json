{"v":3,"coll":"y","num":418,"id":"hymn_418","title":"MURA ebe okan mi","duration":46.024,"voices":{"male":{"file":"y-418-male-v3.m4a","bytes":316879,"sha256":"87b3ba510c9842b98f8be6846e6efdeb0f2da358ec52e34d7f0d11c6f3010170","duration":46.1},"female":{"file":"y-418-female-v3.m4a","bytes":328393,"sha256":"3d44c8ae44d0b3dab737dabd8d1cd261d24b536896444cf276eec2b63a7f85fd","duration":46.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.369,"text":"MURA ẹbẹ ọkan mi,","marked":"Múra ẹ̀bẹ̀ ọkàn mi"},{"start":1.819,"end":3.129,"text":"Jesu n fẹ gb'adura rẹ;","marked":"Jésù ń fẹ́ gb'àdúrà rẹ̀"},{"start":3.579,"end":4.988,"text":"O ti pẹ k'o gbadura,","marked":"Ó ti pẹ́ k'ó gbàdúrà"},{"start":5.438,"end":6.737,"text":"Nitori na yoo gbọ.","marked":"Nítorí na yóò gbọ́."}],"end":6.737},{"key":"2","start":7.687,"lines":[{"start":7.687,"end":9.235,"text":"Lodo Oba n'iwo mbo","marked":"Lọ́dọ̀ Ọba n'ìwọ mbọ̀"},{"start":9.685,"end":10.974,"text":"Wa lopolopo ebe","marked":"Wà lọ́pọ̀lọpọ̀ ẹ̀bẹ̀"},{"start":11.424,"end":12.579,"text":"Be l'ore-ofe Re po","marked":"Bẹ l'oore-ọ̀fẹ́ Rẹ pọ̀"},{"start":13.029,"end":14.403,"text":"Ko s' eni ti bere ju.","marked":"Kò s ẹni tí bẹ̀rẹ̀ jù."}],"end":14.403},{"key":"3","start":15.353,"lines":[{"start":15.353,"end":16.608,"text":"Mo t'ibi ẹru bẹrẹ;","marked":"Mo t'ibi ẹ̀rù bẹ̀rẹ̀"},{"start":17.058,"end":18.662,"text":"Gba mi ni ẹru ẹsẹ!","marked":"Gbà mí ní ẹ̀rù ẹsẹ̀!"},{"start":19.112,"end":20.393,"text":"Ki ẹjẹ t'o ta silẹ,","marked":"Kí ẹ̀jẹ̀ t'ó ta sílẹ̀"},{"start":20.843,"end":22.184,"text":"Wẹ ẹbi ọkan mi nu.","marked":"Wẹ ẹ̀bi ọkàn mi nù."}],"end":22.184},{"key":"4","start":23.134,"lines":[{"start":23.134,"end":24.691,"text":"Sọdọ Rẹ mo wa sinmi,","marked":"Sọ́dọ̀ Rẹ̀ mo wá sinmi"},{"start":25.141,"end":26.395,"text":"Oluwa gba aya mi;","marked":"Olúwa gba àyà mi"},{"start":26.845,"end":28.03,"text":"Nibẹ ni ki O joko,","marked":"Níbẹ̀ ni kí Ó jókò"},{"start":28.48,"end":29.647,"text":"Ma jẹ Ọba ọkan mi,","marked":"Má jẹ́ Ọba ọkàn mi"}],"end":29.647},{"key":"5","start":30.597,"lines":[{"start":30.597,"end":31.935,"text":"N'irin ajo mi l'ayé,","marked":"N'ìrìn àjọ mi l'ayé"},{"start":32.385,"end":33.633,"text":"K'ifẹ Rẹ ma tu mi n'nu;","marked":"K'ìfẹ́ Rẹ má tú mi n'nú"},{"start":34.083,"end":35.602,"text":"Bi ore at'olusọ,","marked":"Bí ọrẹ àt'olùsọ́"},{"start":36.052,"end":37.264,"text":"Mu mi dopin irin mi.","marked":"Mú mi dópin irin mi."}],"end":37.264},{"key":"6","start":38.214,"lines":[{"start":38.214,"end":39.485,"text":"F'ohun mo ni se han mi,","marked":"F'ohun mo ní ṣe hàn mí"},{"start":39.935,"end":41.262,"text":"Fun mi l'ọtun ilera;","marked":"Fún mi l'ọ̀tún ìlera"},{"start":41.712,"end":42.927,"text":"Mu mi wa ninu 'gbagbọ,","marked":"Mú mi wà nínú 'gbagbọ"},{"start":43.377,"end":44.475,"text":"Mu mi ku b'eniyan Rẹ.","marked":"Mú mi kú b'ènìyàn Rẹ."}],"end":44.475}]}