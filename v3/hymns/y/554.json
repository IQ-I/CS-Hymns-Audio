{"v":3,"coll":"y","num":554,"id":"hymn_554","title":"JESU, ma to wa","duration":46.033,"voices":{"male":{"file":"y-554-male-v3.m4a","bytes":318696,"sha256":"f17bd3501d687b530b2fc308c7b7787608116e889613648cbe2b0be84777d7e0","duration":46.1},"female":{"file":"y-554-female-v3.m4a","bytes":334121,"sha256":"de12fb4894d635a957342f5f795efbe03590d87a617e1adb338e1cac409d259e","duration":46.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.653,"text":"JESU, ma tọ wa,","marked":"Jésù, má tọ̀ wá"},{"start":2.103,"end":3.478,"text":"Tit' a o fi sinmi,","marked":"Tít a ó fi sinmi"},{"start":3.928,"end":5.529,"text":"Bi ọna wa ko tilẹ dan,","marked":"Bí ọ̀nà wa kò tilẹ̀ dán"},{"start":5.979,"end":8.071,"text":"A o tẹle Ọ laifoya;","marked":"A ó tẹ̀lé Ọ láìfòyà"},{"start":8.521,"end":9.497,"text":"F'ọwọ Rẹ tọ wa,","marked":"F'ọwọ́ Rẹ tọ̀ wà"},{"start":9.947,"end":11.005,"text":"S' ilu Baba wa.","marked":"Ṣ ìlú Baba wa."}],"end":11.005},{"key":"2","start":11.955,"lines":[{"start":11.955,"end":13.007,"text":"B'ọna ba lewu,","marked":"B'ọ̀nà bá léwu"},{"start":13.457,"end":14.493,"text":"B'ọta sunmọ wa,","marked":"B'ọ̀tá súnmọ́ wa"},{"start":14.943,"end":16.483,"text":"Ma jẹ k'aigbagbọ m'ẹru wa,","marked":"Má jẹ́ k'àìgbàgbọ́ m'ẹ́rù wa"},{"start":16.933,"end":18.753,"text":"Ki 'gbagbọ oun 'reti yẹ;","marked":"Kí 'gbagbọ òun retí yẹ"},{"start":19.203,"end":20.107,"text":"Tor' arin ọta,","marked":"Tọ́r arin ọ̀tá"},{"start":20.557,"end":21.832,"text":"La n lọ s'ile wa.","marked":"Là ń lọ s'ilẹ̀ wa."}],"end":21.832},{"key":"3","start":22.782,"lines":[{"start":22.782,"end":23.98,"text":"Gba t'a fẹ 'tunu,","marked":"Gba t'á fẹ́ tùnú"},{"start":24.43,"end":25.402,"text":"Ninu 'banujẹ,","marked":"Nínú 'banujẹ"},{"start":25.852,"end":27.638,"text":"Gba t'idanwo titun ba de,","marked":"Gba t'ìdánwò títún bá dé"},{"start":28.088,"end":29.324,"text":"Oluwa, fun wa ni suru;","marked":"Olúwa, fún wa ní sùrù"},{"start":29.774,"end":30.908,"text":"F' ilu ni han wa,","marked":"F ìlú ni hàn wá"},{"start":31.358,"end":32.406,"text":"Ti ẹkun ko si.","marked":"Tí ẹkún kò sí."}],"end":32.406},{"key":"4","start":33.356,"lines":[{"start":33.356,"end":34.729,"text":"Jesu, ma tọ wa,","marked":"Jésù, má tọ̀ wá"},{"start":35.179,"end":36.728,"text":"Tit' a o fi ni sinmi:","marked":"Tít a ó fi ní sinmi"},{"start":37.178,"end":39.08,"text":"Amọna ọrun, tọju wa,","marked":"Amọ̀nà ọ̀run, tọ́jú wá"},{"start":39.53,"end":41.339,"text":"Dabobo wa, tọju wa,","marked":"Dàbòbò wa, tọ́jú wa"},{"start":41.789,"end":43.019,"text":"Titi a o fi de,","marked":"Títí a ó fi dé"},{"start":43.469,"end":44.484,"text":"Ilu Baba wa.","marked":"Ìlú Baba wa."}],"end":44.484}]}