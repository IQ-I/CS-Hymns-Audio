{"v":3,"coll":"y","num":78,"id":"hymn_78","title":"T'OLORUN Oluwa nile","duration":62.168,"voices":{"male":{"file":"y-78-male-v3.m4a","bytes":426745,"sha256":"446ee6903b8d4d4573ef43798c50d35f226eeae6f0003e355791223c01e27830","duration":62.2},"female":{"file":"y-78-female-v3.m4a","bytes":443242,"sha256":"4482bc65e7534ac23428f07eaabe088aa6acb39ef9f652d3c25908f638bf68ba","duration":62.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.539,"text":"T'OLORUN Oluwa nile","marked":"T'Ọlọ́run Olúwa nílẹ̀"},{"start":1.989,"end":3.17,"text":"Ati gbogbo ekun re,","marked":"Àti gbogbo ẹkún rẹ̀"},{"start":3.62,"end":5.231,"text":"Ayé at'awon eniyan,","marked":"Ayé àt'àwọn ènìyàn"},{"start":5.681,"end":6.846,"text":"Ti O tedo sinu re. Awamaridi ni'sẹ Rẹ, Oluwa ọmọ-ogun, Ogo ọla at'agbara Ni fun Ọ Mẹtalọkan.","marked":"Tí Ó tẹ̀dó sínú rẹ̀. Àwamaridi ni'sẹ Rẹ̀, Olúwa ọmọ-ogun, Ògo ọlá àt'agbára Ni fún Ọ Mẹ́talọ́kan."}],"end":6.846},{"key":"CHORUS","start":7.796,"lines":[{"start":7.796,"end":9.14,"text":"Awamaridi ni 'se Re,","marked":"Àwamaridi ni ṣe Rẹ̀"},{"start":9.59,"end":10.606,"text":"OLuwa omo-ogun","marked":"Olúwa omo-ogun"},{"start":11.056,"end":12.936,"text":"Ogo Ogo ola at'agbara,","marked":"Ògo Ògo ọlá àt'agbára"},{"start":13.386,"end":15.157,"text":"Ni fun O, Metalokan.","marked":"Ní fún Ọ, Mẹ́talọ́kan."}],"end":15.157},{"key":"2","start":16.107,"lines":[{"start":16.107,"end":17.459,"text":"Tani yoo goke Oluwa,","marked":"Tani yóò gòkè Olúwa"},{"start":17.909,"end":19.055,"text":"Ati ibi mimọ Rẹ,","marked":"Àti ibi mímọ́ Rẹ"},{"start":19.505,"end":20.76,"text":"Ẹni t'o ni ọwọ mimọ,","marked":"Ẹni t'ó ní ọwọ́ mímọ́"},{"start":21.21,"end":22.579,"text":"Ti aya rẹ si funfun.","marked":"Tí aya rẹ̀ sì funfun."}],"end":22.579},{"key":"3","start":23.529,"lines":[{"start":23.529,"end":24.914,"text":"Awọn ti ko gbọkan soke,","marked":"Àwọn tí kò gbọkàn sókè"},{"start":25.364,"end":26.645,"text":"S'ohun asan ayé yi,","marked":"S'ohun asán ayé yí"},{"start":27.095,"end":28.42,"text":"Ti ko si jẹ bura ẹtan,","marked":"Tí kò sì jẹ́ búra ẹ̀tàn"},{"start":28.87,"end":30.274,"text":"Yoo ri 'bukun Oluwa gba.","marked":"Yóò rí bùkún Olúwa gbà."}],"end":30.274},{"key":"4","start":31.224,"lines":[{"start":31.224,"end":32.845,"text":"Eyi l'awọn to n safẹri,","marked":"Èyí l'àwọn tó ń sàfẹ́rí"},{"start":33.295,"end":34.28,"text":"Oju Ọlọrun Jakob,","marked":"Ojú Ọlọ́run Jakọb"},{"start":34.73,"end":35.974,"text":"Awọn to duro d'Oluwa,","marked":"Àwọn tó dúró d'Olúwa"},{"start":36.424,"end":37.623,"text":"Ni yoo ri 'bukun gba.","marked":"Ni yóò rí bùkún gbà."}],"end":37.623},{"key":"5","start":38.573,"lines":[{"start":38.573,"end":39.681,"text":"Gbori soke ẹnu ọna,","marked":"Gborí sókè ẹnu ọ̀nà"},{"start":40.131,"end":41.572,"text":"Ka si tun gbe yin soke,","marked":"Ká sì tún gbé yín sókè"},{"start":42.022,"end":43.243,"text":"Ẹyin l'ẹkun ayérayé,","marked":"Ẹ̀yin l'ẹkún ayérayé"},{"start":43.693,"end":45.068,"text":"K'Ọba Ogo le wọle.","marked":"K'Ọba Ògo lè wọlé."}],"end":45.068},{"key":"6","start":46.018,"lines":[{"start":46.018,"end":47.539,"text":"Tani Ọba Ologo yi!","marked":"Tani Ọba Ológo yí!"},{"start":47.989,"end":49.068,"text":"Oluwa ọmọ ogun,","marked":"Olúwa ọmọ ogun"},{"start":49.518,"end":51.09,"text":"Ẹni to l'agbara l'ogun,","marked":"Ẹni tó l'agbára l'ogun"},{"start":51.54,"end":53.107,"text":"Oun ni Ọba Ogo yi.","marked":"Òun ni Ọba Ògo yí."}],"end":53.107},{"key":"7","start":54.057,"lines":[{"start":54.057,"end":55.323,"text":"Gbori soke enu ona,","marked":"Gborí sókè ẹnu ọ̀nà"},{"start":55.773,"end":57.289,"text":"K'Oba ogo le wole","marked":"K'Ọba ògo lè wọlé"},{"start":57.739,"end":59.038,"text":"Tani Oba Ogo yi?","marked":"Tani Ọba Ògo yí?"},{"start":59.488,"end":60.619,"text":"Oluwa ọmọ-ogun.","marked":"Olúwa ọmọ-ogun."}],"end":60.619}]}