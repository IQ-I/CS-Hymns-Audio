{"v":3,"coll":"y","num":634,"id":"hymn_634","title":"JI, okan mi, dide giri","duration":32.721,"voices":{"male":{"file":"y-634-male-v3.m4a","bytes":220430,"sha256":"7c690a8bee588baaee8497d190c67aca74227b1a6704add27b21e9a9c92e9071","duration":32.8},"female":{"file":"y-634-female-v3.m4a","bytes":234370,"sha256":"027d0df5f825d0df4be60fb302b93e7ec373193358088064b3c40c7d507d28cb","duration":32.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.078,"text":"JI, okan mi, dide giri","marked":"Jí, ọkàn mi, dìde gírí"},{"start":2.528,"end":4.012,"text":"Ma lepa nso kikan","marked":"Má lépa ńṣọ́ kíkan"},{"start":4.462,"end":5.933,"text":"F'itara sure ije yi","marked":"F'ìtara súre ìjẹ yí"},{"start":6.383,"end":7.692,"text":"Fun ade ti ki sa.","marked":"Fún adé tí kì sá."}],"end":7.692},{"key":"2","start":8.642,"lines":[{"start":8.642,"end":9.778,"text":"Awọsanma ẹlẹri wa,","marked":"Àwọsánmá ẹlẹ́rí wa"},{"start":10.228,"end":11.476,"text":"Ti wọn n f'oju sun Ọ;","marked":"Tí wọ́n ń f'ojú sùn Ọ"},{"start":11.926,"end":13.65,"text":"Gbagbe irin atẹhinwa,","marked":"Gbàgbé irin àtẹ̀hìnwá"},{"start":14.1,"end":15.491,"text":"Sa ma tẹ siwaju.","marked":"Sá má tẹ̀ síwájú."}],"end":15.491},{"key":"3","start":16.441,"lines":[{"start":16.441,"end":17.661,"text":"Ọlọrun n f'ohun igbera","marked":"Ọlọ́run ń f'ohun ìgbéra"},{"start":18.111,"end":19.275,"text":"Ke si o lat'oke;","marked":"Ké sí ọ lát'òkè"},{"start":19.725,"end":21.558,"text":"Tikarẹ l'O n pin ere na,","marked":"Tìkárẹ̀ l'Ó ń pín ère ná"},{"start":22.008,"end":23.491,"text":"T'o n nọga lati wo.","marked":"T'ó ń nọ̀gá láti wò."}],"end":23.491},{"key":"4","start":24.441,"lines":[{"start":24.441,"end":25.763,"text":"Olugbala 'Wọ l'o n mu mi","marked":"Olùgbàlà 'Wọ l'ó ń mú mi"},{"start":26.213,"end":27.306,"text":"Bere ije mi yi;","marked":"Bẹ̀rẹ̀ ìjẹ mi yí"},{"start":27.756,"end":29.159,"text":"Nigba t'a ba de mi l'ade,","marked":"Nígbà t'a bá dé mi l'adé"},{"start":29.609,"end":31.172,"text":"N ó wolẹ lẹsẹ Rẹ.","marked":"N ó wólẹ̀ lẹ́sẹ̀ Rẹ̀."}],"end":31.172}]}