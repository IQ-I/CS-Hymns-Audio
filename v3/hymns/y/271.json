{"v":3,"coll":"y","num":271,"id":"hymn_271","title":"APATA ayeraye","duration":47.11,"voices":{"male":{"file":"y-271-male-v3.m4a","bytes":331739,"sha256":"462a960dd70750d795a2278a0ec5db872c7be1cb4dbae765ab8659ca9034a96f","duration":47.2},"female":{"file":"y-271-female-v3.m4a","bytes":341547,"sha256":"286dbc60ad433ddd8d01f0c3db12dd09195a9167383a31aea57c46cf14e849f1","duration":47.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.648,"text":"APATA ayeraye","marked":"Àpáta ayérayé"},{"start":2.098,"end":3.287,"text":"Se ibi isadi mi;","marked":"Ṣe ibi ìsádi mi"},{"start":3.737,"end":4.948,"text":"Jẹ ki omi oun ẹjẹ,","marked":"Jẹ́ kí omi òun ẹ̀jẹ̀"},{"start":5.398,"end":6.78,"text":"T'o n san lati iha Rẹ,","marked":"T'ó ń sàn láti ìhà Rẹ"},{"start":7.23,"end":8.849,"text":"Se iwosan f'ẹsẹ mi,","marked":"Ṣe ìwòsàn f'ẹsẹ̀ mi"},{"start":9.299,"end":10.814,"text":"K'o si sọ mi di mimọ.","marked":"K'ó sì sọ mí di mímọ́."}],"end":10.814},{"key":"2","start":11.764,"lines":[{"start":11.764,"end":12.951,"text":"K' Ise isẹ ọwọ mi,","marked":"K Iṣẹ́ isẹ́ ọwọ́ mi"},{"start":13.401,"end":14.69,"text":"Lo le mu ofin Rẹ sẹ;","marked":"Lọ lè mú òfin Rẹ̀ sẹ́"},{"start":15.14,"end":16.691,"text":"B' itara mi ko l'arẹ,","marked":"B ìtara mi kò l'àrẹ"},{"start":17.141,"end":18.417,"text":"T' omije mi n san titi;","marked":"T omijé mi ń sàn títí"},{"start":18.867,"end":20.149,"text":"Wọn ko to fun etutu,","marked":"Wọn kò tó fún ètùtù"},{"start":20.599,"end":21.855,"text":"'Wọ nikan l'o le gbala.","marked":"'Wọ nìkan l'ó lè gbàlà."}],"end":21.855},{"key":"3","start":22.805,"lines":[{"start":22.805,"end":24.063,"text":"Ko s'ohun ti mo mu wa,","marked":"Kò s'ohun tí mo mú wá"},{"start":24.513,"end":25.777,"text":"Mo rọ mọ agbelebu;","marked":"Mo rọ̀ mọ́ àgbélébùú"},{"start":26.227,"end":28.395,"text":"Mo wa, k'o d'asọ bo mi,","marked":"Mo wá, k'ó d'asọ bò mí"},{"start":28.845,"end":30.066,"text":"Mo n wo Ọ fun iranwọ;","marked":"Mò ń wò Ọ fún ìrànwọ́"},{"start":30.516,"end":32.062,"text":"Mo wa sib' orisun ni,","marked":"Mo wá síb orísun ni"},{"start":32.512,"end":34.288,"text":"Wẹ mi, Olugbala mi.","marked":"Wẹ̀ mí, Olùgbàlà mi."}],"end":34.288},{"key":"4","start":35.238,"lines":[{"start":35.238,"end":36.426,"text":"'Gbati ẹmi mi ba n lọ,","marked":"gbàtí ẹ̀mí mi bá ń lọ"},{"start":36.876,"end":38.194,"text":"T'iku ba p'oju mi de,","marked":"T'ikú bá p'ojú mi dé"},{"start":38.644,"end":40.154,"text":"Ti mba n lọ s'aye aimọ,","marked":"Tí mbá ń lọ s'ayé àìmọ́"},{"start":40.604,"end":41.962,"text":"Ti n ri Ọ n'itẹ 'dajọ;","marked":"Tí ń rí Ọ n'ìtẹ́ 'dajọ"},{"start":42.412,"end":43.781,"text":"Apata ayeraye,","marked":"Àpáta ayérayé"},{"start":44.231,"end":45.561,"text":"Se ibi isadi mi.","marked":"Ṣe ibi ìsádi mi."}],"end":45.561}]}