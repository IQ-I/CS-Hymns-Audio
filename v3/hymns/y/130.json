{"v":3,"coll":"y","num":130,"id":"hymn_130","title":"ALLELUYAH! orin t'o dun","duration":51.156,"voices":{"male":{"file":"y-130-male-v3.m4a","bytes":368947,"sha256":"3d3fd7be5c04b1170df2f674a866f85efe89f03fc5714e21e2b08f06c0a3fc67","duration":51.2},"female":{"file":"y-130-female-v3.m4a","bytes":375991,"sha256":"46a71c034e73d6c7bc106db1cf80bd8385f114128a50994ed138232476897f32","duration":51.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.885,"text":"ALLELUYAH! orin t'o dun,","marked":"Alleluyah! orin t'ó dùn"},{"start":2.335,"end":3.682,"text":"Ohun ayọ ti ki ku;","marked":"Ohun ayọ̀ tí kì kú"},{"start":4.132,"end":5.927,"text":"Alleluyah! orin didun,","marked":"Alleluyah! orin dídùn"},{"start":6.377,"end":7.829,"text":"T'awọn t'o wa l'ọrun fẹ;","marked":"T'àwọn t'ó wà l'ọ̀run fẹ́"},{"start":8.279,"end":9.713,"text":"N'ile ti Ọlọrun mi ń gbe,","marked":"N'ilé tí Ọlọ́run mi ń gbé"},{"start":10.163,"end":11.642,"text":"Ni wọn n kọ tọsan-toru.","marked":"Ni wọ́n ń kọ́ tọsan-toru."}],"end":11.642},{"key":"2","start":12.592,"lines":[{"start":12.592,"end":14.442,"text":"Alleluyah! Ijọ ọrun,","marked":"Alleluyah! Ìjọ ọ̀run"},{"start":14.892,"end":16.143,"text":"Ẹ le kọrin ayọ na;","marked":"Ẹ lè kọrin ayọ̀ ná"},{"start":16.593,"end":18.276,"text":"Alleluyah! orin 'sẹgun,","marked":"Alleluyah! orin 'sẹgun"},{"start":18.726,"end":20.173,"text":"Yẹ awọn t'a rapada;","marked":"Yẹ àwọn t'á ràpadà"},{"start":20.623,"end":22.115,"text":"Awa ero at'alejo,","marked":"Àwa èrò àt'àlejò"},{"start":22.565,"end":24.076,"text":"di Iyin wa ko nilari.","marked":"di Ìyìn wa kò nílárí."}],"end":24.076},{"key":"3","start":25.026,"lines":[{"start":25.026,"end":26.717,"text":"Alleluyah! orin ayọ,","marked":"Alleluyah! orin ayọ̀"},{"start":27.167,"end":28.618,"text":"Lo yẹ wa nigba gbogbo;","marked":"Lọ yẹ̀ wá nígbà gbogbo"},{"start":29.068,"end":30.713,"text":"Alleluyah! ohun aro,","marked":"Alleluyah! ohun arọ"},{"start":31.163,"end":32.544,"text":"Da mọ orin ayọ wa;","marked":"Dá mọ́ orin ayọ̀ wá"},{"start":32.994,"end":34.557,"text":"Gbat'a wa layé osi yi,","marked":"Gbàt'á wà layé òsì yí"},{"start":35.007,"end":36.449,"text":"A ni gbawẹ f'ẹsẹ wa.","marked":"A ní gbàwẹ́ f'ẹsẹ̀ wa."}],"end":36.449},{"key":"4","start":37.399,"lines":[{"start":37.399,"end":38.714,"text":"Iyin dapọ m'adua wa,","marked":"Ìyìn dàpọ̀ m'àdúá wa"},{"start":39.164,"end":41.357,"text":"Gbọ tiwa, Mẹtalọkan;","marked":"Gbọ́ tiwa, Mẹ́talọ́kan"},{"start":41.807,"end":43.359,"text":"Mu wa de 'waju Rẹ l'ayọ,","marked":"Mú wa dé wájú Rẹ l'ayọ̀"},{"start":43.809,"end":45.218,"text":"K'a f'Ọdaguntan t'a pa;","marked":"K'á f'Ọ̀dàgùntàn t'á pa"},{"start":45.668,"end":47.365,"text":"K'a le ma kọ Alleluyah,","marked":"K'á lè má kọ Alleluyah"},{"start":47.815,"end":49.606,"text":"Nibẹ lai ati lailai.","marked":"Níbẹ̀ láì àti láéláé."}],"end":49.606}]}