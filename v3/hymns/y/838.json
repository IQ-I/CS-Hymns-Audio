{"v":3,"coll":"y","num":838,"id":"hymn_838","title":"JESU Onirele","duration":36.797,"voices":{"male":{"file":"y-838-male-v3.m4a","bytes":245416,"sha256":"e1c668f68f3eeb882b710a97fdda5a0ffadb139aa96edf36445774332858a536","duration":36.8},"female":{"file":"y-838-female-v3.m4a","bytes":258003,"sha256":"1823b14098ae6ccaa0b5ac9cb8f71a8900b9ac21c283ffd755a222cffaebb84b","duration":36.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.727,"text":"JESU Onirele,","marked":"Jésù Onírẹ̀lẹ̀"},{"start":2.177,"end":3.104,"text":"Omo Olorun","marked":"Ọmọ Ọlọ́run"},{"start":3.554,"end":4.83,"text":"Alanu, Olufe,","marked":"Alánù, Olùfẹ́"},{"start":5.28,"end":6.256,"text":"Gbo 'gbe omo Re.","marked":"Gbọ́ gbé ọmọ Rẹ."}],"end":6.256},{"key":"2","start":7.206,"lines":[{"start":7.206,"end":8.767,"text":"Fi ẹsẹ wa ji wa,","marked":"Fi ẹsẹ̀ wa jì wá"},{"start":9.217,"end":10.452,"text":"Si da wa n'ide;","marked":"Sì dá wa n'idẹ"},{"start":10.902,"end":11.926,"text":"Fọ gbogbo orisa,","marked":"Fọ́ gbogbo òrìṣà"},{"start":12.376,"end":13.683,"text":"Ti mbẹ l'ọkan wa.","marked":"Ti mbẹ̀ l'ọkàn wa."}],"end":13.683},{"key":"3","start":14.633,"lines":[{"start":14.633,"end":15.894,"text":"Fun wa ni omnira,","marked":"Fún wa ní omnira"},{"start":16.344,"end":17.44,"text":"F'ife s'okan wa'","marked":"F'ìfẹ́ s'ọkàn wa"},{"start":17.89,"end":19.559,"text":"Fa wa, Jesu mimo","marked":"Fà wá, Jésù mímọ́"},{"start":20.009,"end":21.244,"text":"S'ibugbe l'oke.","marked":"S'ibùgbé l'òkè."}],"end":21.244},{"key":"4","start":22.194,"lines":[{"start":22.194,"end":23.505,"text":"Tọ wa l'ọna ajo,","marked":"Tọ̀ wá l'ọ̀nà àjọ"},{"start":23.955,"end":24.98,"text":"Si jẹ ọna wa,","marked":"Sì jẹ́ ọ̀nà wa"},{"start":25.43,"end":26.608,"text":"La okun ayé ja,","marked":"La okùn ayé jà"},{"start":27.058,"end":28.256,"text":"S'imọlẹ ọrun.","marked":"S'ìmọ́lẹ̀ ọ̀run."}],"end":28.256},{"key":"5","start":29.206,"lines":[{"start":29.206,"end":30.6,"text":"Jesu Onirẹlẹ,","marked":"Jésù Onírẹ̀lẹ̀"},{"start":31.05,"end":32.031,"text":"Ọmọ Ọlọrun;","marked":"Ọmọ Ọlọ́run"},{"start":32.481,"end":33.849,"text":"Alanu, Olufẹ,","marked":"Alánù, Olùfẹ́"},{"start":34.299,"end":35.248,"text":"Gbọ 'gbe ọmọ Rẹ.","marked":"Gbọ́ gbé ọmọ Rẹ."}],"end":35.248}]}