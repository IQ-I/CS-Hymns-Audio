{"v":3,"coll":"y","num":844,"id":"hymn_844","title":"ONA kan l'o n toka s'orun","duration":56.705,"voices":{"male":{"file":"y-844-male-v3.m4a","bytes":397101,"sha256":"ce8cc34df192f96b4d5275882a891f5abb4b61f550c17480fcf8814e1a639637","duration":56.8},"female":{"file":"y-844-female-v3.m4a","bytes":409832,"sha256":"96f8307d5a1192dc41edf2746ffef19ce467ce135a797f2a6b0d9453f39dbe44","duration":56.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.77,"text":"ỌNA kan l'o n tọka s'ọrun,","marked":"Ọ̀nà kan l'ó ń tọ́ka s'ọ̀run"},{"start":2.22,"end":3.322,"text":"Isina ni 'yoku,","marked":"Ìṣìnà ni yókù"},{"start":3.772,"end":5.079,"text":"Hiha si l'oju ọna na,","marked":"Híhá sì l'ojú ọ̀nà ná"},{"start":5.529,"end":6.941,"text":"Awọn Kristian l'o fẹ.","marked":"Àwọn Kristian l'ó fẹ́."}],"end":6.941},{"key":"2","start":7.891,"lines":[{"start":7.891,"end":9.781,"text":"Lat' ayé, o lo tarata,","marked":"Lát ayé, ó lọ tarata"},{"start":10.231,"end":11.405,"text":"O si la ewu lọ;","marked":"Ó sì la ewu lọ"},{"start":11.855,"end":13.199,"text":"Awọn ti n f'igboya rin in,","marked":"Àwọn tí ń f'ìgboyà rìn ín"},{"start":13.649,"end":14.882,"text":"Y'o d'ọrun nikẹhin.","marked":"Y'ó d'ọ̀run níkẹ̀hìn."}],"end":14.882},{"key":"3","start":15.832,"lines":[{"start":15.832,"end":17.15,"text":"Awọn ewe y'o ha ti se,","marked":"Àwọn èwe y'ó ha ti ṣe"},{"start":17.6,"end":18.942,"text":"Le la ewu yi ja?","marked":"Lè la ẹ̀wù yí jà?"},{"start":19.392,"end":20.767,"text":"'Tori idẹkun pọ l'ọna,","marked":"torí ìdẹ̀kùn pọ̀ l'ọ̀nà"},{"start":21.217,"end":22.484,"text":"F'awọn ọdọmọde!","marked":"F'àwọn ọ̀dọ́mọdé!"}],"end":22.484},{"key":"4","start":23.434,"lines":[{"start":23.434,"end":25.01,"text":"Gbigboro l'ọna t'ọpọ n rin,","marked":"Gbígboro l'ọ̀nà t'ọ́pọ̀ ń rìn"},{"start":25.46,"end":26.724,"text":"O si tẹju pẹlu!","marked":"Ó sì tẹ́jú pẹ̀lú!"},{"start":27.174,"end":28.822,"text":"Mo si mo pe lati dẹsẹ,","marked":"Mo sì mọ̀ pé láti dẹ́sẹ̀"},{"start":29.272,"end":30.635,"text":"Ni wọn se n rin nibẹ.","marked":"Ni wọ́n ṣe ń rìn níbẹ̀."}],"end":30.635},{"key":"5","start":31.585,"lines":[{"start":31.585,"end":33.133,"text":"Sugbọn k'ẹsẹ mi ma ba ye,","marked":"Sùgbọ́n k'ẹsẹ̀ mi má bá yé"},{"start":33.583,"end":34.887,"text":"Ki n ma si sako lọ,","marked":"Kí n má sì ṣáko lọ"},{"start":35.337,"end":36.706,"text":"Oluwa, jọ s'Olutọ mi,","marked":"Olúwa, jọ s'Olùtọ́ mi"},{"start":37.156,"end":38.315,"text":"Emi ki o sina.","marked":"Èmi kí ó ṣìnà."}],"end":38.315},{"key":"6","start":39.265,"lines":[{"start":39.265,"end":41.657,"text":"Njẹ mo le lọ l'ai s'ifoya,","marked":"Ǹjẹ́ mo lè lọ l'àì s'ìfòyà"},{"start":42.107,"end":43.602,"text":"Ki n gbẹkẹl' ọrọ Rẹ;","marked":"Kí n gbẹkẹl' ọ̀rọ̀ Rẹ"},{"start":44.052,"end":45.666,"text":"Apa Rẹ y'o s'aguntan Rẹ,","marked":"Apá Rẹ y'ó s'àgùntàn Rẹ"},{"start":46.116,"end":47.486,"text":"Y'o si ko wọn de'le.","marked":"Y'ó sì kó wọn dé'lé."}],"end":47.486},{"key":"7","start":48.436,"lines":[{"start":48.436,"end":49.903,"text":"Bẹni n ó la ewu yi ja,","marked":"Bẹ́ni n ó la ẹ̀wù yí jà"},{"start":50.353,"end":51.499,"text":"Nipa itọju Rẹ?","marked":"Nípa ìtọ́jú Rẹ?"},{"start":51.949,"end":53.362,"text":"N ó tẹjumọ 'bode ọrun,","marked":"N ó tẹjúmọ́ bodè ọ̀run"},{"start":53.812,"end":55.156,"text":"Titi n ó fi wọle.","marked":"Títí n ó fi wọlé."}],"end":55.156}]}