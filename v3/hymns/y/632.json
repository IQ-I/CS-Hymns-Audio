{"v":3,"coll":"y","num":632,"id":"hymn_632","title":"EMI o lo sodo Jesu","duration":34.59,"voices":{"male":{"file":"y-632-male-v3.m4a","bytes":238582,"sha256":"d44a3582220a586f53be0cd72ba8bcb3e7d47921c3497fd515276599b41bb363","duration":34.6},"female":{"file":"y-632-female-v3.m4a","bytes":252953,"sha256":"0666a95aa4b2426e01543624592da646cb31611413ce49d0119c0054a62f3941","duration":34.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.862,"text":"EMI o lọ sọdọ Jesu,","marked":"Èmi ó lọ sọ́dọ̀ Jésù"},{"start":2.312,"end":4.137,"text":"Ẹni n pe mi pe ki n wa;","marked":"Ẹni ń pè mí pé kí n wá"},{"start":4.587,"end":5.795,"text":"Ẹni t'o se Olugbala,","marked":"Ẹni t'ó ṣe Olùgbàlà"},{"start":6.245,"end":7.652,"text":"Fun ẹlẹsẹ bi emi.","marked":"Fún ẹlẹ́sẹ̀ bí èmi."}],"end":7.652},{"key":"2","start":8.602,"lines":[{"start":8.602,"end":10.209,"text":"Emi o lọ sọdọ Jesu,","marked":"Èmi ó lọ sọ́dọ̀ Jésù"},{"start":10.659,"end":12.15,"text":"Irira at' ibinu;","marked":"Ìríra àt ìbínú"},{"start":12.6,"end":14.326,"text":"Ika at' isẹ t'o buru,","marked":"Ìkà àt isẹ́ t'ó burú"},{"start":14.776,"end":16.593,"text":"T'eniyan n se; Oun ko ni","marked":"T'ènìyàn ń ṣe; Òun kò ní"}],"end":16.593},{"key":"3","start":17.543,"lines":[{"start":17.543,"end":19.01,"text":"Emi o lo sọdọ Jesu,","marked":"Èmi ó lọ sọ́dọ̀ Jésù"},{"start":19.46,"end":21.227,"text":"O dun mọ mi ki n se bẹ;","marked":"Ó dùn mọ́ mi kí n ṣe bẹ̀"},{"start":21.677,"end":23.167,"text":"Tal'o fẹ mi bi ti Jesu,","marked":"Tál'ó fẹ́ mi bí ti Jésù"},{"start":23.617,"end":24.767,"text":"Ẹni ti o gba ni la?","marked":"Ẹni tí ó gbà ni là?"}],"end":24.767},{"key":"4","start":25.717,"lines":[{"start":25.717,"end":27.272,"text":"Emi o lo sodo Jesu","marked":"Èmi ó lọ sọ́dọ̀ Jésù"},{"start":27.722,"end":29.328,"text":"Jesu t'o se Ore wa","marked":"Jésù t'ó ṣe Ọ̀rẹ́ wa"},{"start":29.778,"end":31.086,"text":"Anu wa ninu Re pupo","marked":"Àánú wà nínú Rẹ̀ púpọ̀"},{"start":31.536,"end":33.04,"text":"Fun elese bi emi.","marked":"Fún ẹlẹ́ṣẹ̀ bí èmi."}],"end":33.04}]}