{"v":3,"coll":"y","num":140,"id":"hymn_140","title":"OMO egbe Serafu","duration":111.249,"voices":{"male":{"file":"y-140-male-v3.m4a","bytes":792128,"sha256":"5b7a42ba34a7722dfd8f1deceb63c7a1d834e6d8667b4f911a911281ff8a8672","duration":111.3},"female":{"file":"y-140-female-v3.m4a","bytes":826777,"sha256":"1a16bc9575e2815ef3e4e6a832d2ac33bb0e9d276b340f48e065ca8352432e01","duration":111.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.081,"text":"ỌMỌ ẹgbẹ","marked":"Ọmọ ẹgbẹ́"},{"start":1.531,"end":2.559,"text":"Serafu At'","marked":"Séráfù At"},{"start":3.009,"end":4.642,"text":"ẹgbẹ Kerubu E f'ope fun","marked":"ẹgbẹ́ Kérúbù Ẹ f'ọpẹ́ fún"},{"start":5.092,"end":7.416,"text":"Olorun wa, E f'ope fun","marked":"Ọlọ́run wa, Ẹ f'ọpẹ́ fún"},{"start":7.866,"end":9.011,"text":"Olorun wa T'iru","marked":"Ọlọ́run wa T'iru"},{"start":9.461,"end":18.488,"text":"ojo oni. Fi soju emi wa. Ẹ ba wa kọrin pọ, K'awa jumo k' Alleluyah, Ọpẹ lo yẹ fun Jehofa, Ọba Onibu-ọrẹ.","marked":"ọjọ́ òní. Fi ṣojú ẹ̀mí wa. Ẹ bá wa kọrin pọ̀, K'àwa jùmọ̀ k Alleluyah, Ọpẹ́ ló yẹ fún Jèhófà, Ọba Onibu-ọrẹ."}],"end":18.488},{"key":"CHORUS","start":19.438,"lines":[{"start":19.438,"end":20.59,"text":"E ba wa korin po,","marked":"Ẹ bá wa kọrin pọ̀"},{"start":21.04,"end":22.946,"text":"K'awa jumo k'AIleluya","marked":"K'àwa jùmọ̀ k'Allelúyà"},{"start":23.396,"end":24.79,"text":"Ope to ye fun Jehovah","marked":"Ọpẹ́ tó yẹ fún Jehovah"},{"start":25.24,"end":26.387,"text":"Oba Onibu-Ore.","marked":"Ọba Onibu-ore."}],"end":26.387},{"key":"2","start":27.337,"lines":[{"start":27.337,"end":28.334,"text":"Ọpọ Ẹlẹgbẹ wa,","marked":"Ọ̀pọ̀ Ẹlẹgbẹ́ wa"},{"start":28.784,"end":30.065,"text":"Ni ko r'ọjọ oni,","marked":"Ní kò r'ọjọ́ òní"},{"start":30.515,"end":32.044,"text":"Ọpọlọpọ ti sako lọ,","marked":"Ọ̀pọ̀lọpọ̀ ti ṣáko lọ"},{"start":32.494,"end":33.769,"text":"Idamu wa f'ẹlomiran,","marked":"Ìdàmú wa f'ẹlòmíràn"},{"start":34.219,"end":35.427,"text":"Ọpọ si ti kọja,","marked":"Ọ̀pọ̀ sì ti kọjá"},{"start":35.877,"end":37.156,"text":"Lọ si ayérayé.","marked":"Lọ sí ayérayé."}],"end":37.156},{"key":"3","start":38.106,"lines":[{"start":38.106,"end":39.235,"text":"Ẹgbẹ Aladura,","marked":"Ẹgbẹ́ Aládúrà"},{"start":39.685,"end":40.958,"text":"Ẹ mura si adura;","marked":"Ẹ múra sí àdúrà"},{"start":41.408,"end":43.345,"text":"Gbe ida 'sẹgun yin soke,","marked":"Gbé idà 'sẹgun yín sókè"},{"start":43.795,"end":45.23,"text":"Oluwa yoo ba wa sẹgun,","marked":"Olúwa yóò bá wa sẹ́gun"},{"start":45.68,"end":46.883,"text":"Otọ l'esu gbogun,","marked":"Òtọ̀ l'èṣù gbógun"},{"start":47.333,"end":48.575,"text":"Ko ni le bori wa.","marked":"Kò ní lè borí wa."}],"end":48.575},{"key":"4","start":49.525,"lines":[{"start":49.525,"end":50.8,"text":"Ninu ọdun ta wa yi,","marked":"Nínú ọdún ta wá yí"},{"start":51.25,"end":52.404,"text":"Agan yoo gb'ọmọ pọn;","marked":"Àgàn yóò gb'ọmọ pọ́n"},{"start":52.854,"end":54.457,"text":"Awa alaisan yo dide!","marked":"Àwa aláìsàn yọ̀ dìde!"},{"start":54.907,"end":56.397,"text":"Arun ko ni ya ile wa,","marked":"Àrùn kò ní ya ilé wa"},{"start":56.847,"end":57.795,"text":"Onirobinujẹ;","marked":"Oníròbìnújẹ́"},{"start":58.245,"end":59.33,"text":"Yio ri itunu gba.","marked":"Yóò rí ìtùnú gbà."}],"end":59.33},{"key":"5","start":60.28,"lines":[{"start":60.28,"end":61.767,"text":"F'awọn ti ko r'ise,","marked":"F'àwọn tí kò r'iṣẹ́"},{"start":62.217,"end":63.346,"text":"Baba yoo pese;","marked":"Baba yóò pèsè"},{"start":63.796,"end":65.566,"text":"Awọn t'ebi n pa yoo si yo,","marked":"Àwọn t'ebi ń pa yóò sì yọ̀"},{"start":66.016,"end":67.564,"text":"Awọn t'o jẹ 'gbese y'o san.","marked":"Àwọn t'ó jẹ́ gbèsè y'ó sàn."},{"start":68.014,"end":69.055,"text":"Aini ko ni si mọ,","marked":"Àìní kò ní sí mọ́"},{"start":69.505,"end":70.87,"text":"Ayọ yoo kari wa.","marked":"Ayọ̀ yóò kárí wa."}],"end":70.87},{"key":"6","start":71.82,"lines":[{"start":71.82,"end":72.99,"text":"Ifẹ l'akoja ofin,","marked":"Ìfẹ́ l'àkọjá òfin"},{"start":73.44,"end":74.826,"text":"Baba fun wa n'ifẹ;","marked":"Baba fún wa n'ìfẹ́"},{"start":75.276,"end":76.494,"text":"Ki agba fẹran ọmọde,","marked":"Kí àgbà fẹ́ràn ọmọdé"},{"start":76.944,"end":78.332,"text":"At'ọkunrin at'obinrin,","marked":"Àt'ọkùnrin àt'obìnrin"},{"start":78.782,"end":79.853,"text":"Ifẹ l'awọn Angẹli,","marked":"Ìfẹ́ l'àwọn Áńgẹ́lì"},{"start":80.303,"end":81.583,"text":"Fi yin Baba loke.","marked":"Fi yin Baba lókè."}],"end":81.583},{"key":"7","start":82.533,"lines":[{"start":82.533,"end":83.683,"text":"Iwe Woli Joel,","marked":"Ìwé Wòlí Joẹl"},{"start":84.133,"end":85.231,"text":"Ni ori ekeji,","marked":"Ní orí èkejì"},{"start":85.681,"end":86.937,"text":"Ẹsẹ ekejidinlọgbọn,","marked":"Ẹsẹ̀ èkejìdínlọ́gbọ̀n"},{"start":87.387,"end":88.843,"text":"Asẹ naa sẹ si Kérúbù,","marked":"Àsẹ náà sẹ̀ sí Kérúbù"},{"start":89.293,"end":90.511,"text":"Ati Séráfù loni,","marked":"Àti Séráfù lónì"},{"start":90.961,"end":92.108,"text":"Ni arin Ijọ wa.","marked":"Ní àrín Ìjọ wa."}],"end":92.108},{"key":"8","start":93.058,"lines":[{"start":93.058,"end":94.107,"text":"Ogo ni fun Baba","marked":"Ògo ni fún Baba"},{"start":94.557,"end":95.543,"text":"Ogo ni fun Omo","marked":"Ògo ni fún Ọmọ"},{"start":95.993,"end":97.29,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":97.74,"end":98.923,"text":", Ogo ni f'Olodumare,","marked":"Ògo ni f'Olódùmarè"},{"start":99.373,"end":100.426,"text":"'Wo ni Serafu n","marked":"wo ni Séráfù ń"},{"start":100.876,"end":109.7,"text":"wo, Ma je k'oju, ti wa. Ẹ ba wa kọrin pọ, K'awa jumọ k' Alleluyah, Ọpẹ lo yẹ fun Jehofa, Ọba Onibu-ọrẹ.","marked":"wò, Má jẹ́ k'ojú, tí wá. Ẹ bá wa kọrin pọ̀, K'àwa jùmọ̀ k Alleluyah, Ọpẹ́ ló yẹ fún Jèhófà, Ọba Onibu-ọrẹ."}],"end":109.7}]}