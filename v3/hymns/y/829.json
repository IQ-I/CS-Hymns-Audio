{"v":3,"coll":"y","num":829,"id":"hymn_829","title":"A JUBA RE, Haleluya","duration":75.642,"voices":{"male":{"file":"y-829-male-v3.m4a","bytes":527435,"sha256":"c5635f0306bf39717d0d89e2d341adb8bedd909bcc9d364b344c615fa84b0516","duration":75.7},"female":{"file":"y-829-female-v3.m4a","bytes":553638,"sha256":"6e1454d535b9ea5d59c3212234fdce81233cb33d67fa49440bc93637101b74c0","duration":75.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.123,"text":"A juba Re, Halleluyah","marked":"A júbà Rẹ̀, Hallelúyà"},{"start":2.573,"end":4.375,"text":"Halle, Halleluyah,","marked":"Halle, Hallelúyà"},{"start":4.825,"end":6.937,"text":"Olorun wa, enit' a nsin","marked":"Ọlọ́run wa, ẹnit a ńṣin"},{"start":7.387,"end":9.082,"text":"Yio s'ayo wa di kikun.","marked":"Yóò s'ayọ̀ wá di kíkún."}],"end":9.082},{"key":"CHORUS","start":10.032,"lines":[{"start":10.032,"end":11.03,"text":"Ibi rere kan wa","marked":"Ibi rere kan wà"},{"start":11.48,"end":12.673,"text":"Ayipada ko si","marked":"Àyípadà kò sí"},{"start":13.123,"end":15.483,"text":"Ko s'oru af'osan titi","marked":"Kò s'òru àf'ọ̀sán títí"},{"start":15.933,"end":17.728,"text":"Serafu yio I'ayo.","marked":"Séráfù yóò l'ayọ̀."}],"end":17.728},{"key":"2","start":18.678,"lines":[{"start":18.678,"end":20.288,"text":"Onigbagbo, e ji giri","marked":"Onígbàgbọ́, ẹ jí gírí"},{"start":20.738,"end":22.298,"text":"Serafu ma nkede,","marked":"Séráfù má ńkéde"},{"start":22.748,"end":23.979,"text":"Aborisa nsise 'yanu","marked":"Abọ̀rìṣà ńṣiṣẹ́ yanu"},{"start":24.429,"end":25.76,"text":"Onigbagbo nk' egan.","marked":"Onígbàgbọ́ ńk ẹ̀gàn."}],"end":25.76},{"key":"3","start":26.71,"lines":[{"start":26.71,"end":28.052,"text":"Opolopo ese l'o wa","marked":"Ọ̀pọ̀lọpọ̀ ẹ̀ṣẹ̀ l'ó wà"},{"start":28.502,"end":30.155,"text":"Sugbon eyi t'o buru","marked":"Ṣùgbọ́n èyí t'ó burú"},{"start":30.605,"end":32.767,"text":"Ese Ese, S'EMI MlMO","marked":"Ẹsẹ̀ Ẹ̀ṣẹ̀, S'Ẹ̀mí Mlmọ́"},{"start":33.217,"end":34.564,"text":"Eyi ko ni 'dariji.","marked":"Èyí kò ní dáríjì."}],"end":34.564},{"key":"4","start":35.514,"lines":[{"start":35.514,"end":36.922,"text":"Opo 'danwo l'o wa l'aiye","marked":"Ọ̀pọ̀ dánwò l'ó wà l'ayé"},{"start":37.372,"end":38.895,"text":"Sugbon eyi t'o buru","marked":"Ṣùgbọ́n èyí t'ó burú"},{"start":39.345,"end":41.416,"text":"K'a ma l'owo, k'aisan dani","marked":"K'á má l'ọ̀wọ̀, k'àìsàn dáni"},{"start":41.866,"end":43.164,"text":"Jesu gbe wa leke.","marked":"Jésù gbé wa lékè."}],"end":43.164},{"key":"5","start":44.114,"lines":[{"start":44.114,"end":45.505,"text":"Ko s'ere kan t'o wa l'aiye","marked":"Kò s'èrè kan t'ó wà l'ayé"},{"start":45.955,"end":47.046,"text":"Fun Egbe Serafu","marked":"Fún Ẹgbẹ́ Séráfù"},{"start":47.496,"end":48.808,"text":"Enit' o ba sise re ye","marked":"Ẹnit ó bá ṣiṣẹ́ rẹ̀ yẹ"},{"start":49.258,"end":50.4,"text":"Yio gb'ade nikehin.","marked":"Yóò gb'adé níkẹ̀hìn."}],"end":50.4},{"key":"6","start":51.35,"lines":[{"start":51.35,"end":52.627,"text":"Aladura ma jafara","marked":"Aládúrà má jáfara"},{"start":53.077,"end":54.16,"text":"Ariran so 'bode","marked":"Aríran sọ bodè"},{"start":54.61,"end":56.445,"text":"Larin ota le wa laiye","marked":"Lárin ọ̀tá lè wà láìyẹ"},{"start":56.895,"end":58.524,"text":"Baba yio segun fun nyin.","marked":"Baba yóò ṣẹ́gun fún yín."}],"end":58.524},{"key":"7","start":59.474,"lines":[{"start":59.474,"end":61.434,"text":"Alairise, alailera","marked":"Aláìríṣẹ́, aláìlera"},{"start":61.884,"end":62.937,"text":"E mase banuje","marked":"Ẹ máṣe banújẹ́"},{"start":63.387,"end":65.207,"text":"Olupese, Oluwosan","marked":"Olùpèsè, Olúwòsàn"},{"start":65.657,"end":66.858,"text":"Ko ni fi nyin sile.","marked":"Kò ní fi yín sílẹ̀."}],"end":66.858},{"key":"8","start":67.808,"lines":[{"start":67.808,"end":69.175,"text":"Ogo ni fun Baba l'oke","marked":"Ògo ni fún Baba l'òkè"},{"start":69.625,"end":70.686,"text":"Ogo ni fun Omo","marked":"Ògo ni fún Ọmọ"},{"start":71.136,"end":72.384,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":72.834,"end":74.093,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":74.093}]}