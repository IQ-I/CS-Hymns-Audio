{"v":3,"coll":"y","num":477,"id":"hymn_477","title":"OLUWA  jowo pa wa mo","duration":103.648,"voices":{"male":{"file":"y-477-male-v3.m4a","bytes":717172,"sha256":"d1b13e0e7a7fc55177f0f64cdd9b190414255eee62a7845faa7904ab15c142f8","duration":103.7},"female":{"file":"y-477-female-v3.m4a","bytes":742767,"sha256":"47b53e0be159c0ae6b8af29e6cd968ea9143cd7462f4ba9d522ccaed6818677d","duration":103.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.57,"text":"OLUWA  jowo pa wa mo","marked":"Olúwa jọ̀wọ́ pa wá mọ́"},{"start":2.02,"end":3.274,"text":"Iwo l'awa gbekele","marked":"Ìwọ l'àwa gbẹ́kẹ̀lé"},{"start":3.724,"end":5.159,"text":"Okan wa wi f 'Oluwa pe","marked":"Ọkàn wa wí f Olúwa pé"},{"start":5.609,"end":6.822,"text":"Iwo li Olorun wa.","marked":"Ìwọ li Ọlọ́run wa."}],"end":6.822},{"key":"CHORUS","start":7.772,"lines":[{"start":7.772,"end":9.32,"text":"A ko ni 're kan lehin Re Baba","marked":"A kò ní rẹ̀ kan lẹ́hìn Rẹ Baba"},{"start":9.77,"end":11.051,"text":"Iwo l'awa gbekele","marked":"Ìwọ l'àwa gbẹ́kẹ̀lé"},{"start":11.501,"end":12.906,"text":"Mase fi wa sile f'ota","marked":"Máṣe fi wá sílẹ̀ f'ọ̀tá"},{"start":13.356,"end":14.904,"text":"K'asegun n'ile l'ode.","marked":"K'aṣẹ́gun n'ilẹ̀ l'òde."}],"end":14.904},{"key":"2","start":15.854,"lines":[{"start":15.854,"end":17.057,"text":"S'awon enia mimo Re","marked":"S'àwọn ẹnìà mímọ́ Rẹ"},{"start":17.507,"end":18.495,"text":"Ani s'awon olola","marked":"Àní s'àwọn ọlọ́lá"},{"start":18.945,"end":20.101,"text":"Bi eniti didun 'nu wa","marked":"Bí ẹnìtì dídùn nù wá"},{"start":20.551,"end":22.616,"text":"Yio, ma wa titi lailai.","marked":"Yóò, má wà títí láéláé."}],"end":22.616},{"key":"3","start":23.566,"lines":[{"start":23.566,"end":24.952,"text":"Ibinuje awon ti nsa","marked":"Ìbìnújẹ́ àwọn ti ńṣà"},{"start":25.402,"end":26.697,"text":"T'Olorun miran yio po","marked":"T'Ọlọ́run míràn yóò pọ̀"},{"start":27.147,"end":28.289,"text":"Ebo ohun min'eje won","marked":"Ẹbọ ohun mín'ẹ̀jẹ̀ wọn"},{"start":28.739,"end":30.269,"text":"L'emi ki yio ta sile.","marked":"L'èmi kí yóò ta sílẹ̀."}],"end":30.269},{"key":"4","start":31.219,"lines":[{"start":31.219,"end":32.56,"text":"Oluwa n'ipin ini mi","marked":"Olúwa n'ìpín ìní mi"},{"start":33.01,"end":34.21,"text":"Ati ipin ago mi","marked":"Àti ìpín àgọ́ mi"},{"start":34.66,"end":35.908,"text":"Sewo lo mu la mi duro","marked":"Ṣèwọ́ ló mú là mí dúró"},{"start":36.358,"end":38.007,"text":"T'o ko je k'ota ba je.","marked":"T'ó kò jẹ́ k'ọ̀tá bà jẹ́."}],"end":38.007},{"key":"5","start":38.957,"lines":[{"start":38.957,"end":40.61,"text":"Okun tita bo s'odo mi","marked":"Okùn títa bọ́ s'ọ́dọ̀ mi"},{"start":41.06,"end":42.365,"text":"Nibi t'o dara julo","marked":"Níbi t'ó dára jùlọ"},{"start":42.815,"end":44.274,"text":"L'otito mo fowo soya","marked":"L'òtítọ́ mo fọwọ́ sọ́yà"},{"start":44.724,"end":45.831,"text":"Pe mo ni ogun rere.","marked":"Pé mo ní ogun rere."}],"end":45.831},{"key":"6","start":46.781,"lines":[{"start":46.781,"end":48.122,"text":"Emi o fi 'bukun f'Oluwa","marked":"Èmi ó fi bùkún f'Olúwa"},{"start":48.572,"end":49.583,"text":"To fun mi ni imoran","marked":"Tó fún mi ní ìmọ̀ràn"},{"start":50.033,"end":51.902,"text":"Okan mi pelu sa nko mi","marked":"Ọkàn mi pẹ̀lú sá ńkọ́ mi"},{"start":52.352,"end":53.713,"text":"L'arin wakati oru.","marked":"L'árín wákàtí òru."}],"end":53.713},{"key":"7","start":54.663,"lines":[{"start":54.663,"end":56.257,"text":"Mo gb'Oluwa ka 'waju mi","marked":"Mo gb'olúwa ka wájú mi"},{"start":56.707,"end":58.173,"text":"Nibi gbogbo l'aiye mi","marked":"Níbi gbogbo l'ayé mi"},{"start":58.623,"end":59.933,"text":"Tori o wa lowo 'tun mi","marked":"Torí ó wà lọ́wọ́ tún mi"},{"start":60.383,"end":61.613,"text":"A ki yio si mi nipo.","marked":"A kí yóò sí mi nípò."}],"end":61.613},{"key":"8","start":62.563,"lines":[{"start":62.563,"end":63.867,"text":"Torina n'nu mi se dun","marked":"Torina n'nú mi ṣe dùn"},{"start":64.317,"end":65.723,"text":"T'ogo mi si nyo jade","marked":"T'ògo mi sì nyọ̀ jáde"},{"start":66.173,"end":68.183,"text":"Ara mi pelu yio simi","marked":"Ara mi pẹ̀lú yóò ṣímí"},{"start":68.633,"end":70.263,"text":"Ni 're ti iye ailopin.","marked":"Ní rẹ ti iye àìlópin."}],"end":70.263},{"key":"9","start":71.213,"lines":[{"start":71.213,"end":72.623,"text":"O ki yio f'okan mi sile","marked":"O kí yóò f'ọkàn mi sílẹ̀"},{"start":73.073,"end":74.163,"text":"Li arin ipo oku","marked":"Lí arin ipò òkú"},{"start":74.613,"end":75.753,"text":"Beni eni mimo tire","marked":"Bẹ́ni ẹni mímọ́ tirẹ̀"},{"start":76.203,"end":77.656,"text":"Ki yipo idibaje.","marked":"Kí yípo ìdíbàjẹ́."}],"end":77.656},{"key":"10","start":78.606,"lines":[{"start":78.606,"end":80.316,"text":"Mo mo p'o f'ona 'ye han mi,","marked":"Mo mọ̀ p'ọ́ f'ọ̀nà yè hàn mí"},{"start":80.766,"end":82.229,"text":"Waju re l'ekun ayo wa","marked":"Wájú rẹ l'ẹkún ayọ̀ wá"},{"start":82.679,"end":83.917,"text":"Li owo otun Re sa ni","marked":"Lí ọwọ́ ọ̀tún Rẹ sá ni"},{"start":84.367,"end":85.708,"text":"Didun 'nu mi wa lailai.","marked":"Dídùn nù mi wà láéláé."}],"end":85.708},{"key":"11","start":86.658,"lines":[{"start":86.658,"end":88.224,"text":"S'alabo Egbe Serafu","marked":"S'alábọ̀ Ẹgbẹ́ Séráfù"},{"start":88.674,"end":89.982,"text":"Ati Egbe Kerubu","marked":"Àti Ẹgbẹ́ Kérúbù"},{"start":90.432,"end":91.848,"text":"Awon to nsin O nitoto","marked":"Àwọn tó ńṣin Ọ́ nítòtọ́"},{"start":92.298,"end":93.699,"text":"Nigun mererin aiye.","marked":"Nígún mẹ́rẹ̀rin ayé."}],"end":93.699},{"key":"12","start":94.649,"lines":[{"start":94.649,"end":96.191,"text":"Eje ka f 'ogo fun Baba","marked":"Ẹ̀jẹ̀ ká f ògo fún Baba"},{"start":96.641,"end":97.862,"text":"Ati fun Omo pelu","marked":"Àti fún Ọmọ pẹ̀lú"},{"start":98.312,"end":99.878,"text":"Je ka f'ogo f'Emi Mimo","marked":"Jẹ́ ká f'ògo f'Ẹ̀mí Mímọ́"},{"start":100.328,"end":102.099,"text":"Metalokan Aiyeraiye.","marked":"Mẹ́talọ́kan Ayérayé."}],"end":102.099}]}