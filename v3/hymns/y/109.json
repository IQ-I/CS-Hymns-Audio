{"v":3,"coll":"y","num":109,"id":"hymn_109","title":"K'A fi ope fun Oluwa","duration":96.596,"voices":{"male":{"file":"y-109-male-v3.m4a","bytes":695343,"sha256":"20fadbec07c41cffaf642a650a5c1b7435e2dee73578d84756f49ff04212836e","duration":96.6},"female":{"file":"y-109-female-v3.m4a","bytes":721955,"sha256":"6ed759dad2a9e0dff112f9dd3f85cf88aaf07fa94125b665a8262e462128194e","duration":96.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.54,"text":"K'A fi ọpẹ fun Oluwa,","marked":"K'A fi ọpẹ́ fún Olúwa"},{"start":1.99,"end":3.242,"text":"Fun gbogbo ọpọ anu Rẹ,","marked":"Fún gbogbo ọ̀pọ̀ àánú Rẹ"},{"start":3.692,"end":4.866,"text":"K'a wa di ihamọra wa,","marked":"K'á wá di ìhámọ́ra wa"},{"start":5.316,"end":6.742,"text":"Lati b'esu jagun.","marked":"Láti b'eṣú jagun."},{"start":7.192,"end":8.969,"text":"Esu n'ipa sugbọn a o sẹgun,","marked":"Èṣù n'ipa sùgbọ́n a ó sẹ́gun"},{"start":9.419,"end":10.736,"text":"Ni agbara Mẹtalọkan,","marked":"Ní agbára Mẹ́talọ́kan"},{"start":11.186,"end":12.646,"text":"Ileri ti Oluwa sẹ,","marked":"Ìlérí tí Olúwa sẹ́"},{"start":13.096,"end":14.621,"text":"Y'o wa sibẹ titi.","marked":"Y'ó wá síbẹ̀ títí."}],"end":14.621},{"key":"2","start":15.571,"lines":[{"start":15.571,"end":17.299,"text":"Gbogbo ayé ẹ ho f'ayọ,","marked":"Gbogbo ayé ẹ hó f'ayọ̀"},{"start":17.749,"end":19.282,"text":"Ki gbogbo wa si kun fun 'sẹ,","marked":"Kí gbogbo wa sì kún fún 'sẹ"},{"start":19.732,"end":21.178,"text":"Ki a ja titi de opin,","marked":"Kí a jà títí dé òpin"},{"start":21.628,"end":23.003,"text":"K'a si fi 'da le'lẹ.","marked":"K'á sì fi dá lé'lẹ̀."},{"start":23.453,"end":25.163,"text":"Lẹsẹ Kristi Ọmọ Baba,","marked":"Lẹ́sẹ̀ Kristi Ọmọ Baba"},{"start":25.613,"end":27.043,"text":"Ni ibi awọn Angeli n yọ,","marked":"Ní ibi àwọn Áńgẹ́lì ń yọ̀"},{"start":27.493,"end":29.106,"text":"K'a ba wọn yin Baba loke,","marked":"K'á bá wọn yin Baba lókè"},{"start":29.556,"end":31.063,"text":"Ọmọ, Ẹni lailai.","marked":"Ọmọ, Ẹni láéláé."}],"end":31.063},{"key":"3","start":32.013,"lines":[{"start":32.013,"end":33.449,"text":"Awa ọmọ Ijọ Séráfù,","marked":"Àwa ọmọ Ìjọ Séráfù"},{"start":33.899,"end":35.176,"text":"A fi ogo fun Oluwa,","marked":"A fi ògo fún Olúwa"},{"start":35.626,"end":37.112,"text":"T'o jẹ k'ẹmi tun ri ẹmi,","marked":"T'ó jẹ́ k'ẹ̀mí tún rí ẹ̀mí"},{"start":37.562,"end":38.877,"text":"Ogo f'orukọ Rẹ.","marked":"Ògo f'orúkọ Rẹ."},{"start":39.327,"end":41.246,"text":"Gb'oju s'oke wo asia,","marked":"Gb'ojú s'òkè wọ asia"},{"start":41.696,"end":43.168,"text":"Fun gbogbo awọn t'o segun,","marked":"Fún gbogbo àwọn t'ó ṣẹ́gun"},{"start":43.618,"end":45.087,"text":"Ẹyin ara ẹ ku abọ,","marked":"Ẹ̀yin ará ẹ̀ kú abọ́"},{"start":45.537,"end":46.777,"text":"Ki Baba pẹlu yin.","marked":"Kí Baba pẹ̀lú yín."}],"end":46.777},{"key":"4","start":47.727,"lines":[{"start":47.727,"end":49.729,"text":"Awọn t'o ti sẹgun saaju,","marked":"Àwọn t'ó ti sẹ́gun ṣáájú"},{"start":50.179,"end":51.679,"text":"Wọn n wo wa bi awa ti n ja,","marked":"Wọ́n ń wò wá bí àwa ti ń jà"},{"start":52.129,"end":53.739,"text":"Wọn si n fi ohun kan wi pé,","marked":"Wọ́n sì ń fi ohun kan wí pé"},{"start":54.189,"end":55.391,"text":"Ara ma jafara.","marked":"Ara má jáfara."},{"start":55.841,"end":57.84,"text":"Nitor' akoko diẹ lo ku,","marked":"Nítor àkókò díẹ̀ ló kú"},{"start":58.29,"end":59.937,"text":"Ti ayé yi yoo kọja lọ,","marked":"Tí ayé yí yóò kọjá lọ"},{"start":60.387,"end":61.915,"text":"Bi asẹgun a daju pe,","marked":"Bí asẹ́gun a dájú pé"},{"start":62.365,"end":63.676,"text":"A o gb'ade iye.","marked":"A ó gb'adé ìyè."}],"end":63.676},{"key":"5","start":64.626,"lines":[{"start":64.626,"end":66.227,"text":"Awa si tun ki asaju wa,","marked":"Àwa sì tún kí aṣájú wa"},{"start":66.677,"end":67.992,"text":"Ati awọn 'mọ ogun rẹ,","marked":"Àti àwọn 'mọ ogun rẹ̀"},{"start":68.442,"end":69.798,"text":"Ara ẹ ku isẹ ẹmi,","marked":"Ara ẹ kú isẹ́ ẹ̀mí"},{"start":70.248,"end":71.705,"text":"K'a gb'ọwọ lọwọ ara wa.","marked":"K'á gb'ọwọ́ lọ́wọ́ ara wa."},{"start":72.155,"end":73.795,"text":"Ẹ ku abọ ẹyin ku ile","marked":"Ẹ kú abọ́ ẹ̀yin kú ilé"},{"start":74.245,"end":75.578,"text":"K'Ọlọrun pẹlu gbogbo wa,","marked":"K'Ọlọ́run pẹ̀lú gbogbo wa"},{"start":76.028,"end":77.476,"text":"K'o si fi ade Ogo Rẹ,","marked":"K'ó sì fi adé Ògo Rẹ̀"},{"start":77.926,"end":79.181,"text":"De gbogbo wa lori.","marked":"Dé gbogbo wa lórí."}],"end":79.181},{"key":"6","start":80.131,"lines":[{"start":80.131,"end":81.463,"text":"Ọpẹ ni fun Mẹtalọkan,","marked":"Ọpẹ́ ni fún Mẹ́talọ́kan"},{"start":81.913,"end":83.608,"text":"T'o ba wa fọ 'tẹgun esu.","marked":"T'ó bá wá fọ́ 'tẹgun èṣù."},{"start":84.058,"end":85.385,"text":"Halleluyah s'Ọlọrun wa,","marked":"Hallelúyà s'Ọlọ́run wa"},{"start":85.835,"end":87.232,"text":"Oju ti Lusifa.","marked":"Ojú ti Lusifa."},{"start":87.682,"end":89.005,"text":"Ara ẹ jo pẹlu ayọ,","marked":"Ara ẹ̀ jọ pẹ̀lú ayọ̀"},{"start":89.455,"end":91.277,"text":"Ara ẹ gbe ohun s'oke,","marked":"Ara ẹ̀ gbé ohun s'òkè"},{"start":91.727,"end":93.195,"text":"Ki Baba fun wa ni 'fẹ Rẹ.","marked":"Kí Baba fún wa ní 'fẹ Rẹ̀."},{"start":93.645,"end":95.048,"text":"Eyi ti ko l'ẹgbẹ.","marked":"Èyí tí kò l'ẹgbẹ́."}],"end":95.048}]}