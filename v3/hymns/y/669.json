{"v":3,"coll":"y","num":669,"id":"hymn_669","title":"B'O ti dun to lat' ewe lol","duration":51.334,"voices":{"male":{"file":"y-669-male-v3.m4a","bytes":365721,"sha256":"25a2ffcce91839f12b2625b33be42a3936c03733153a7c993a324ea87ea960a5","duration":51.4},"female":{"file":"y-669-female-v3.m4a","bytes":381311,"sha256":"69e2c6fb4bac7dc32a4f8a00d967ef8bc433ed8100e43ca54ec07ebf6bc83093","duration":51.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.854,"text":"B'O ti dun to lat' ewe lọ!","marked":"B'Ó ti dùn tó lát èwe lọ!"},{"start":2.304,"end":3.833,"text":"K'a fi ipa ọgbọn s'ọna,","marked":"K'á fi ipa ọgbọ́n s'ọ́nà"},{"start":4.283,"end":5.889,"text":"K'a je olotitọ Ọmọ,","marked":"K'á jẹ́ olótítọ́ Ọmọ"},{"start":6.339,"end":7.973,"text":"K'arayé le f'ọkan tan wa.","marked":"K'arayé lè f'ọkàn tán wá."}],"end":7.973},{"key":"2","start":8.923,"lines":[{"start":8.923,"end":10.547,"text":"A ko le gbẹkẹl' opurọ,","marked":"A kò lè gbẹkẹl' òpùrọ́"},{"start":10.997,"end":12.533,"text":"B'o tilẹ pada s'otitọ;","marked":"B'ó tilẹ̀ padà s'òtítọ́"},{"start":12.983,"end":14.161,"text":"B'eniyan se buburu kan,","marked":"B'ènìyàn ṣe búburú kan"},{"start":14.611,"end":16.916,"text":"T'o si purọ: a di meji.","marked":"T'ó sì purọ́: a di méjì."}],"end":16.916},{"key":"3","start":17.866,"lines":[{"start":17.866,"end":19.37,"text":"B'iro ti j'ohun 'rira to,","marked":"B'írò ti j'ohun ríra tó"},{"start":19.82,"end":21.242,"text":"L'Ọlọrun fi han 'nu ọrọ Rẹ,","marked":"L'Ọlọ́run fi hàn nu ọ̀rọ̀ Rẹ"},{"start":21.692,"end":23.145,"text":"Iku-oro Anania,","marked":"Iku-oro Anania"},{"start":23.595,"end":25.102,"text":"Se n'tori 'rọ-pipa ni.","marked":"Ṣe n'torí 'rọ-pipa ni."}],"end":25.102},{"key":"4","start":26.052,"lines":[{"start":26.052,"end":27.665,"text":"Safira aya rẹ pẹlu,","marked":"Safira aya rẹ̀ pẹ̀lú"},{"start":28.115,"end":29.508,"text":"Bi o ti n jẹri ọkọ rẹ;","marked":"Bí ó ti ń jẹ́rí ọkọ rẹ"},{"start":29.958,"end":31.567,"text":"L'ogedengbe ko l'o lule?","marked":"L'ògèdèǹgbé kò l'ó lulẹ̀?"},{"start":32.017,"end":33.536,"text":"Bẹ ki t'ọkọ t'aya ku si?","marked":"Bẹ́ kí t'ọkọ t'àyà kú sí?"}],"end":33.536},{"key":"5","start":34.486,"lines":[{"start":34.486,"end":35.82,"text":"Oluwa y'o n' inu didun","marked":"Olúwa y'ó ń inú dídùn"},{"start":36.27,"end":37.753,"text":"S'ẹnikẹni ti n s'otitọ,","marked":"S'ẹ́nikẹ́ni tí ń s'òtítọ́"},{"start":38.203,"end":39.632,"text":"Y'o si l'awọn opurọ lọ,","marked":"Y'ó sì l'àwọn òpùrọ́ lọ"},{"start":40.082,"end":41.333,"text":"Sinu adagun ina.","marked":"Sínú adágún iná."}],"end":41.333},{"key":"6","start":42.283,"lines":[{"start":42.283,"end":43.984,"text":"Irọ gbogbo t'eniyan n pa,","marked":"Irọ́ gbogbo t'ènìyàn ń pa"},{"start":44.434,"end":45.896,"text":"L'Ọlọrun n kọ s'inu iwe;","marked":"L'Ọlọ́run ń kọ́ s'inú ìwé"},{"start":46.346,"end":47.689,"text":"N ó k'ahọn mi ni ijanu,","marked":"N ó k'ahọ́n mi ní ìjánu"},{"start":48.139,"end":49.785,"text":"Ki n ma ba ku s'ọrun egbe.","marked":"Kí n má bá kú s'ọ̀run ẹgbẹ́."}],"end":49.785}]}