{"v":3,"coll":"y","num":557,"id":"hymn_557","title":"Awa n'imole aye","duration":63.569,"voices":{"male":{"file":"y-557-male-v3.m4a","bytes":434711,"sha256":"66bdc4fceed49548c4187c5a003559be5576fa780d701e8ca72a439e9467ef95","duration":63.6},"female":{"file":"y-557-female-v3.m4a","bytes":465444,"sha256":"80489c9ba7b2cab86051c9aab844bc916a0db6f8f13d98ffd43f127648344f68","duration":63.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.445,"text":"Awa n'imọlẹ ayé,","marked":"Àwa n'ìmọ́lẹ̀ ayé"},{"start":1.895,"end":3.185,"text":"Kérúbù Séráfù,","marked":"Kérúbù Séráfù"},{"start":3.635,"end":4.969,"text":"Ilu ti a tẹ si oke,","marked":"Ìlú tí a tẹ́ sí òkè"},{"start":5.419,"end":7.104,"text":"Bawo ni yo ti se farasin,","marked":"Báwo ni yó ti ṣe farasin"}],"end":7.104},{"key":"CHORUS","start":8.054,"lines":[{"start":8.054,"end":8.967,"text":"Jẹ k'a sise","marked":"Jẹ́ k'á ṣiṣẹ́"},{"start":9.417,"end":10.697,"text":"Jẹ k'a sisẹ, Jẹ","marked":"Jẹ́ k'á sisẹ́, Jẹ́"},{"start":11.147,"end":13.218,"text":"k'a sisẹ- k'a le ri igbala n' ikẹhin.","marked":"k'á sisẹ́ k'á lè rí ìgbàlà ń ìkẹhìn."}],"end":13.218},{"key":"2","start":14.168,"lines":[{"start":14.168,"end":15.849,"text":"Tẹ 'ti lelẹ lati gbọ,","marked":"Tẹ́ ti lélẹ̀ láti gbọ́"},{"start":16.299,"end":17.425,"text":"Ọrọ ifẹ Jesu,","marked":"Ọ̀rọ̀ ìfẹ́ Jésù"},{"start":17.875,"end":19.141,"text":"Ti o n ke rara wi pé,","marked":"Tí ó ń ké rara wí pé"},{"start":19.591,"end":21.498,"text":"Ha! ọmọ 'wo ha fẹran mi bi?","marked":"Ha! ọmọ wọ ha fẹ́ràn mi bí?"}],"end":21.498},{"key":"3","start":22.448,"lines":[{"start":22.448,"end":24.064,"text":"Kérúbù oun Séráfù,","marked":"Kérúbù òun Séráfù"},{"start":24.514,"end":25.9,"text":"Lọ si gbogbo agbayé,","marked":"Lọ sí gbogbo agbayé"},{"start":26.35,"end":27.479,"text":"Mu ayé gbọ ọrọ mi,","marked":"Mú ayé gbọ́ ọ̀rọ̀ mi"},{"start":27.929,"end":29.461,"text":"Ẹni ba gbọ y'o ri igbala,","marked":"Ẹni bá gbọ́ y'ó rí ìgbàlà"}],"end":29.461},{"key":"4","start":30.411,"lines":[{"start":30.411,"end":31.807,"text":"Ẹyin ara ati ọrẹ,","marked":"Ẹ̀yin ará àti ọrẹ"},{"start":32.257,"end":33.702,"text":"Ẹ wa w'ọkọ 'gbala yi","marked":"Ẹ wá w'ọkọ gbàlà yí"},{"start":34.152,"end":35.203,"text":"Ti Ọlọrun gbe kalẹ,","marked":"Tí Ọlọ́run gbé kalẹ̀"},{"start":35.653,"end":37.527,"text":"Ara w'ọkọ k' ilẹkun to se.","marked":"Ara w'ọkọ̀ k ìlẹ̀kùn tó ṣe."}],"end":37.527},{"key":"5","start":38.477,"lines":[{"start":38.477,"end":39.579,"text":"Ẹ ranti ọjọ Nọa,","marked":"Ẹ rántí ọjọ́ Nọa"},{"start":40.029,"end":41.348,"text":"Ti ẹda n se dunia,","marked":"Tí ẹ̀dá ń ṣe dùníà"},{"start":41.798,"end":43.066,"text":"Ti ẹranko fi w'ọkọ,","marked":"Tí ẹranko fi w'ọkọ̀"},{"start":43.516,"end":45.288,"text":"Abamọ kọ ha fun wọn nikẹhin.","marked":"Àbámọ̀ kọ́ ha fún wọn níkẹ̀hìn."}],"end":45.288},{"key":"6","start":46.238,"lines":[{"start":46.238,"end":47.368,"text":"Ohun ayé mb' ayé lọ,","marked":"Ohun ayé mb ayé lọ"},{"start":47.818,"end":49.088,"text":"Ẹ lọ ranti aya Lot,","marked":"Ẹ lọ rántí aya Lọt"},{"start":49.538,"end":50.866,"text":"Sugbọn t'igbala lo ju,","marked":"Sùgbọ́n t'ìgbàlà ló ju"},{"start":51.316,"end":52.998,"text":"Ki a mase k'abamọ nikẹhin.","marked":"Kí a máṣe k'àbámọ̀ níkẹ̀hìn."}],"end":52.998},{"key":"7","start":53.948,"lines":[{"start":53.948,"end":55.189,"text":"Baba jo ran wa lowo","marked":"Baba jọ ràn wá lọ́wọ́"},{"start":55.639,"end":57.027,"text":"K'a le sise re d'opin","marked":"K'á lè ṣiṣẹ́ rẹ̀ d'òpin"},{"start":57.477,"end":58.971,"text":"Ki a gbo ohun na pe","marked":"Kí a gbọ́ ohùn ná pé"},{"start":59.421,"end":62.02,"text":"Kerubu, Serafu, gb'ere Re.","marked":"Kérúbù, Séráfù, gb'èrè Rẹ̀."}],"end":62.02}]}