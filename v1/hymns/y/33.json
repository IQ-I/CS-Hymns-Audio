{"v":1,"coll":"y","num":33,"id":"hymn_33","title":"OLUS'AGUTAN eni re","duration":24.792,"voices":{"male":{"file":"y-33-male.m4a","bytes":170371,"sha256":"635f78fc0d86856a4ea631613644aff3f3afc59672f8ce8fd480068f8b7b9dbf","duration":24.8},"female":{"file":"y-33-female.m4a","bytes":177807,"sha256":"dbe8a066911a87bb81d94194d25101593dc6c3ee294648a757ab7d1570f0d37e","duration":24.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.538,"text":"OLUS'AGUTAN eni re","marked":"Olùs'ágùtàn ẹni rẹ̀"},{"start":1.918,"end":3.064,"text":"Fi oju Re han wa,","marked":"Fi ojú Rẹ hàn wá"},{"start":3.444,"end":4.913,"text":"Wo fun wa n'ile adura","marked":"Wo fún wa ń'ílé àdúrà"},{"start":5.293,"end":6.675,"text":"M'okan wa gbadura.","marked":"M'ọkàn wa gbàdúrà."}],"end":6.675},{"key":"2","start":7.625,"lines":[{"start":7.625,"end":9.446,"text":"K'ife ati alafia","marked":"K'ífẹ́ àti àlàáfíà"},{"start":9.826,"end":11.43,"text":"K'o ma gbe ile yi!","marked":"K'ó má gbé ilé yí!"},{"start":11.81,"end":13.217,"text":"F'irora f'okan iponju","marked":"F'ìrora f'ọkàn ìpọ́njú"},{"start":13.597,"end":15.08,"text":"M'okan ailera le.","marked":"M'ọkàn àìlera le."}],"end":15.08},{"key":"3","start":16.03,"lines":[{"start":16.03,"end":17.462,"text":"K'a fi 'gbagbo gbo oro Re,","marked":"K'á fi 'gbàgbọ́ gbọ́ ọ̀rọ̀ Rẹ"},{"start":17.842,"end":19.018,"text":"K'a fi 'gbagbo bebe","marked":"K'á fi 'gbàgbọ́ bẹbẹ̀"},{"start":19.398,"end":20.425,"text":"Ati niwaju Oluwa,","marked":"Àti níwájú Olúwa"},{"start":20.805,"end":22.246,"text":"K'a se aroye wa.","marked":"K'á ṣe àròyé wa."},{"start":22.626,"end":23.243,"text":"Amin.","marked":"Àmín."}],"end":23.243}]}