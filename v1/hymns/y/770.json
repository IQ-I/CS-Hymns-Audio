{"v":1,"coll":"y","num":770,"id":"hymn_770","title":"ENYIN ranse Kristi","duration":29.799,"voices":{"male":{"file":"y-770-male.m4a","bytes":202892,"sha256":"a4c7a0a7850495c14f643bbc7e2baafb9137f6981e4867daa7ce7c77f8704b40","duration":29.8},"female":{"file":"y-770-female.m4a","bytes":210163,"sha256":"96a9d3b562513e8ca185222b008921bbd3ee8a5db8dacf23a90cc66c036adc57","duration":29.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.527,"text":"ENYIN 'ranse Kristi","marked":"Enyin 'ránṣẹ́ Kristi"},{"start":1.907,"end":2.998,"text":"Gbo ohun ipe Re","marked":"Gbọ́ ohùn ìpè Rẹ"},{"start":3.378,"end":4.685,"text":"E tele bi t'o fonahan","marked":"Ẹ tẹ́lẹ̀ bí t'ó fọ́nàhàn"},{"start":5.065,"end":6.331,"text":"A npe nyin s'ona Re.","marked":"A ńpẹ́ nyin s'ọ́nà Rẹ̀."}],"end":6.331},{"key":"2","start":7.281,"lines":[{"start":7.281,"end":8.344,"text":"Baba ti enyin nsin","marked":"Bàbá ti enyin ńsìn"},{"start":8.724,"end":10.471,"text":"O n'ipa to fun nyn","marked":"Ó ń'ipa tó fún nyn"},{"start":10.851,"end":12.526,"text":"N'igbekele ileri Re","marked":"N'ígbẹ́kẹ̀lé ìlérí Rẹ"},{"start":12.906,"end":14.093,"text":"E ja bi okunrin.","marked":"Ẹ já bí ọkùnrin."}],"end":14.093},{"key":"3","start":15.043,"lines":[{"start":15.043,"end":16.15,"text":"Lo f'Olugbala han","marked":"Lo f'Olùgbàlà hàn"},{"start":16.53,"end":17.521,"text":"Ati anu nla Re","marked":"Àti ànú ńlá Rẹ"},{"start":17.901,"end":19.131,"text":"F'awon otosi elese","marked":"F'àwọn òtòṣì ẹlẹ́ṣẹ̀"},{"start":19.511,"end":20.503,"text":"Ninu omo Adam.","marked":"Nínú ọmọ Ádám."}],"end":20.503},{"key":"4","start":21.453,"lines":[{"start":21.453,"end":22.83,"text":"L'oruko Jesu wa","marked":"L'orúkọ Jésù wa"},{"start":23.21,"end":24.558,"text":"A ki nyin, Ona re!","marked":"A kì nyin, Ọ̀nà rẹ̀!"},{"start":24.938,"end":26.408,"text":"A mbe Enit' o ran nyin lo","marked":"A ḿbẹ Enit' ò rán nyin lọ"},{"start":26.788,"end":28.249,"text":"K'O busi ise nyin.","marked":"K'ó bùṣí iṣẹ́ nyin."}],"end":28.249}]}