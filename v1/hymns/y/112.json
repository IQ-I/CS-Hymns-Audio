{"v":1,"coll":"y","num":112,"id":"hymn_112","title":"YIN Olurapada re","duration":65.978,"voices":{"male":{"file":"y-112-male.m4a","bytes":486907,"sha256":"f7e3cb8d4427b80e1b6e79ac1891df29e95822e3ded456b5788841890af7f7c4","duration":66.0},"female":{"file":"y-112-female.m4a","bytes":498979,"sha256":"b97e0f03840e1bdf8b58f625a4148679453481bfb026550a6e505ba179af19e9","duration":66.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.445,"text":"YIN Olurapada re","marked":"Yín Olùràpadà rẹ"},{"start":1.825,"end":3.942,"text":"F'Ogo f'oruko Re titi lae","marked":"F'Ògo f'orúkọ Rẹ títí láé"},{"start":4.322,"end":5.718,"text":"Oloto li on sa je.","marked":"Olótó li ọ́n sá jẹ́."},{"start":6.098,"end":8.211,"text":"Egbe:  F'ogo f'oruko Re titi lae","marked":"F'ògo f'orúkọ Rẹ títí láé"},{"start":8.591,"end":11.018,"text":"Gb 'oruko re ga! F'ogo f'oko Re","marked":"Gb 'orukọ rẹ̀ ga! F'ògò f'ọkọ Rẹ̀"},{"start":11.398,"end":12.9,"text":"Korin Aleluya titi lai","marked":"Kọrin Alelúyà títí láí"},{"start":13.28,"end":15.362,"text":"Gb'oruko re ga! Fogo f'oko Re!","marked":"Gb'oruko rẹ̀ ga! Fògo f'ọkọ Rẹ!"},{"start":15.742,"end":17.436,"text":"Korin 'yin s'Oluwa titi lae.","marked":"Kọrin 'yín s'Olúwa títí láé."}],"end":17.436},{"key":"CHORUS","start":18.386,"lines":[{"start":18.386,"end":20.136,"text":"F'ogo f'oruko Re titi lae","marked":"F'ògo f'orúkọ Rẹ títí láé"},{"start":20.516,"end":23.066,"text":"Gb 'oruko re ga! F'ogo f'oko Re","marked":"Gb 'orukọ rẹ̀ ga! F'ògò f'ọkọ Rẹ̀"},{"start":23.446,"end":25.053,"text":"Korin Aleluya titi lai","marked":"Kọrin Alelúyà títí láí"},{"start":25.433,"end":28.235,"text":"Gb'oruko re ga! Fogo f'oko Re!","marked":"Gb'oruko rẹ̀ ga! Fògo f'ọkọ Rẹ!"},{"start":28.615,"end":30.438,"text":"Korin 'yin s'Oluwa titi lae.","marked":"Kọrin 'yín s'Olúwa títí láé."}],"end":30.438},{"key":"2","start":31.388,"lines":[{"start":31.388,"end":32.771,"text":"Fun 'bukun to nfi fun wa","marked":"Fún 'bùkún tó ńfi fún wa"},{"start":33.151,"end":34.88,"text":"F'ogo f'oruko Re titi lae","marked":"F'ògo f'orúkọ Rẹ títí láé"},{"start":35.26,"end":36.846,"text":"B'or'ofe Re ti po to.","marked":"B'or'ọ̀fẹ́ Rẹ ti pọ̀ tó."},{"start":37.226,"end":38.847,"text":"Egbe:  F'ogo f'oruko Re titi lae...","marked":"F'ògo f'orúkọ Rẹ títí láé"}],"end":38.847},{"key":"3","start":39.797,"lines":[{"start":39.797,"end":41.447,"text":"KO ha se o l'ore bi!","marked":"Kò ha ṣe ọ́ l'ọ̀rẹ́ bí!"},{"start":41.827,"end":43.721,"text":"F'ogo f'oruko Re titi lae!","marked":"F'ògo f'orúkọ Rẹ títí láé!"},{"start":44.101,"end":45.671,"text":"Kil'o ku k'O se fun o?","marked":"Kíl'ó kù k'Ó ṣe fún ọ?"},{"start":46.051,"end":48.059,"text":"Egbe:  F'ogo f'oruko Re titi lae...","marked":"F'ògo f'orúkọ Rẹ títí láé"}],"end":48.059},{"key":"4","start":49.009,"lines":[{"start":49.009,"end":50.271,"text":"lfe wo lo po bayi","marked":"lfẹ́ wọ́ ló pọ̀ báyì"},{"start":50.651,"end":52.378,"text":"F'ogo f'oruko Re titi lae!","marked":"F'ògo f'orúkọ Rẹ títí láé!"},{"start":52.758,"end":54.337,"text":"Alafia bayi wa bi!","marked":"Àlàáfíà báyì wá bí!"},{"start":54.717,"end":55.686,"text":"Egbe:  Gb'oruko re ga!...","marked":"Gb'orúkọ rẹ̀ ga!"}],"end":55.686},{"key":"5","start":56.636,"lines":[{"start":56.636,"end":57.776,"text":"Ki ahon mi tu lati","marked":"Kí ahọ́n mi tú láti"},{"start":58.156,"end":60.011,"text":"F'ogo f'oruko Re titi lae","marked":"F'ògo f'orúkọ Rẹ títí láé"},{"start":60.391,"end":61.755,"text":"K'emi Iat'ayeraye.","marked":"K'èmi lát'ayérayé."},{"start":62.135,"end":63.161,"text":"Egbe:  Gb'oruko re ga!...","marked":"Gb'orúkọ rẹ̀ ga!"},{"start":63.541,"end":64.428,"text":"Amin.","marked":"Àmín."}],"end":64.428}]}