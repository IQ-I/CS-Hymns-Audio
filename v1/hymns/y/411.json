{"v":1,"coll":"y","num":411,"id":"hymn_411","title":"OLORUN Serafu","duration":51.206,"voices":{"male":{"file":"y-411-male.m4a","bytes":352178,"sha256":"f3591e4bcb472c36ef320f6d999ca5579db2383e9718592b8c1396dcf30261b7","duration":51.3},"female":{"file":"y-411-female.m4a","bytes":377530,"sha256":"52e042ca2df2958e19fad356e43e5e9d61bade69c413e4d8e82ab9cf1aee2e6e","duration":51.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.389,"text":"OLORUN Serafu","marked":"Ọlọ́run Séráfù"},{"start":1.769,"end":2.809,"text":"Ati ti Kerubu","marked":"Àti ti Kérúbù"},{"start":3.189,"end":5.061,"text":"Masai pelu awa t'aiye","marked":"Masai pẹ̀lú àwa t'áiye"},{"start":5.441,"end":6.533,"text":"Ko gbo adura.","marked":"Kò gbọ́ àdúrà."}],"end":6.533},{"key":"CHORUS","start":7.483,"lines":[{"start":7.483,"end":8.436,"text":"Alanu Olore","marked":"Alanu Ọlọ́rẹ́"},{"start":8.816,"end":9.951,"text":"Gbo tiwa Baba wa","marked":"Gbọ́ tiwa Bàbá wa"},{"start":10.331,"end":11.839,"text":"Iwo to gbo ti Elijah","marked":"Ìwọ tó gbọ́ tí Elijah"},{"start":12.219,"end":13.586,"text":"Gbo t'Egbe Serafu.","marked":"Gbọ́ t'Ẹgbẹ́ Séráfù."}],"end":13.586},{"key":"2","start":14.536,"lines":[{"start":14.536,"end":15.413,"text":"lwo Omo Baba","marked":"lwọ́ Ọmọ Bàbá"},{"start":15.793,"end":17.148,"text":"T'o ti gb'ara wa wo","marked":"T'ó ti gb'ara wa wò"},{"start":17.528,"end":19.325,"text":"lwo ti mo ailera wa","marked":"lwo ti mọ àìlera wa"},{"start":19.705,"end":21.125,"text":"Ma wa fun wa titi.","marked":"Má wà fún wa títí."}],"end":21.125},{"key":"3","start":22.075,"lines":[{"start":22.075,"end":23.161,"text":"Ise 'yanu Re yo","marked":"Iṣẹ́ 'yanu Rẹ̀ yọ"},{"start":23.541,"end":24.527,"text":"Larin Igbimo wa","marked":"Lárin Ìgbìmọ̀ wa"},{"start":24.907,"end":26.436,"text":"T'o gbe Alagba wa dide","marked":"T'ó gbé Alàgbà wa dìde"},{"start":26.816,"end":28.105,"text":"Fun igbala enia.","marked":"Fún ìgbàlà enia."}],"end":28.105},{"key":"4","start":29.055,"lines":[{"start":29.055,"end":30.324,"text":"Ope ni f 'Olorun","marked":"Ọpẹ́ ní f 'Ọlọ́run"},{"start":30.704,"end":31.767,"text":"Fun 'ru ore Re yi","marked":"Fún 'ru ọrẹ Rẹ yí"},{"start":32.147,"end":33.971,"text":"Ti ko ka wa s'alailera","marked":"Tí kò kà wá s'aláìlera"},{"start":34.351,"end":35.455,"text":"To nfi ran re han wa.","marked":"Tó ńfi rán rẹ hàn wá."}],"end":35.455},{"key":"5","start":36.405,"lines":[{"start":36.405,"end":37.662,"text":"Ebun rere re ni","marked":"Ẹ̀bùn rere rẹ̀ ni"},{"start":38.042,"end":39.409,"text":"To ti pese fun wa","marked":"Tó ti pèsè fún wa"},{"start":39.789,"end":41.093,"text":"A mbe O Baba wa orun","marked":"A ḿbẹ Ọ́ Bàbá wa ọ̀run"},{"start":41.473,"end":42.832,"text":"Mase je ko ya wa.","marked":"Masẹ̀ jẹ́ kó yà wá."}],"end":42.832},{"key":"6","start":43.782,"lines":[{"start":43.782,"end":44.877,"text":"E f'Ogo fun Baba","marked":"Ẹ f'Ògo fún Bàbá"},{"start":45.257,"end":46.323,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":46.703,"end":47.975,"text":"E f'Ogo fun Emi Mimo","marked":"Ẹ f'Ògo fún Ẹ̀mí Mímọ́́"},{"start":48.355,"end":49.656,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."}],"end":49.656}]}