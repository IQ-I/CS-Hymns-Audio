{"v":1,"coll":"y","num":415,"id":"hymn_415","title":"WAKATI adura didun!","duration":63.325,"voices":{"male":{"file":"y-415-male.m4a","bytes":490148,"sha256":"408e93ff5ac20180d7fe077e289dc48602cabed466c696696274995ad3047984","duration":63.4},"female":{"file":"y-415-female.m4a","bytes":503589,"sha256":"b3d945618084a8978c37cd2efa596283524b25b74860b4f684787254e4747f54","duration":63.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.741,"text":"WAKATI adura didun!","marked":"Wákàtí àdúrà dídùn!"},{"start":2.121,"end":4.377,"text":"T'o gbe mi lo kuro l'aiye","marked":"T'ó gbé mi lọ kúrò l'aiye"},{"start":4.757,"end":5.938,"text":"Lo'waju ite Baba mi","marked":"Lọ́'wájú ìtẹ́ Bàbá mi"},{"start":6.318,"end":7.673,"text":"Ki nso gbogbo edun mi fun","marked":"Kí nso gbogbo ẹ̀dùn mi fún"},{"start":8.053,"end":9.567,"text":"Nigba 'banuje at'aro","marked":"Nígbà 'banújẹ́ àt'árò"},{"start":9.947,"end":11.37,"text":"Adua l'abo fun okan mi","marked":"Àdùà l'ábò fún ọkàn mi"},{"start":11.75,"end":13.188,"text":"Emi si bo lowo Esu","marked":"Èmi sì bọ́ lọ́wọ́ Èṣù"},{"start":13.568,"end":15.255,"text":"'Gbati mo ba gb'adua didun","marked":"'Gbátí mo bá gb'àdùà dídùn"},{"start":15.635,"end":16.944,"text":"Emi si bo lowo Esu","marked":"Èmi sì bọ́ lọ́wọ́ Èṣù"},{"start":17.324,"end":19.206,"text":"'Gbati mo ba gb'adua didun.","marked":"'Gbátí mo bá gb'àdùà dídùn."}],"end":19.206},{"key":"2","start":20.156,"lines":[{"start":20.156,"end":21.679,"text":"WAKATI adura didun!","marked":"Wákàtí àdúrà dídùn!"},{"start":22.059,"end":23.437,"text":"Iye re y'o gbe ebe mi","marked":"Iye rẹ̀ y'ó gbé ẹbẹ̀ mì"},{"start":23.817,"end":25.571,"text":"Lo sod'Enit' o se 'leri","marked":"Lọ sod'Enit' ò ṣe 'lérí"},{"start":25.951,"end":27.469,"text":"Lati bukun okan adua","marked":"Láti bùkún ọkàn àdúa"},{"start":27.849,"end":30.216,"text":"B'O ti ko mi, ki nwoju Re","marked":"B'ó ti kọ́ mi, kí nwojú Rẹ̀"},{"start":30.596,"end":32.721,"text":"Ki ngbekele, ki nsi gbagbo","marked":"Kí ńgbẹ́kẹ̀lé, kí nsì gbàgbọ́"},{"start":33.101,"end":34.343,"text":"Ngo ko gbogb'aniyan mi le","marked":"Ngo kó gbogb'aniyan mi lé"},{"start":34.723,"end":36.268,"text":"Ni akoko adua didun","marked":"Ní àkókò àdùa dídùn"},{"start":36.648,"end":38.011,"text":"Ngo ko gbogb'aniyan mi le","marked":"Ngo kó gbogb'aniyan mi lé"},{"start":38.391,"end":39.965,"text":"Ni akoko adua didun.","marked":"Ní àkókò àdùa dídùn."}],"end":39.965},{"key":"3","start":40.915,"lines":[{"start":40.915,"end":42.27,"text":"WAKATI adura didun!","marked":"Wákàtí àdúrà dídùn!"},{"start":42.65,"end":43.965,"text":"Jeki nma r'itunu re gba","marked":"Jèkì ńmá r'ìtùnú rẹ gbà"},{"start":44.345,"end":45.924,"text":"Titi ngo fi d'oke Pisga","marked":"Títí ngo fi d'òkè Písga"},{"start":46.304,"end":47.785,"text":"T ngo r'ile mi l'okere","marked":"T ngo r'ilé mi l'òkèrè"},{"start":48.165,"end":49.757,"text":"Ngo bo ago ara sile","marked":"Ńgò bọ́ àgọ́ ara sílẹ̀"},{"start":50.137,"end":51.825,"text":"Ngo gba ere ainipekun","marked":"Ngo gba èrè àìnípẹ̀kun"},{"start":52.205,"end":54.25,"text":"Ngo korin bi mo ti nfo lo","marked":"Ngo kọrin bí mo ti ńfọ́ lọ"},{"start":54.63,"end":57.133,"text":"Odigbose! adua didun,","marked":"Òdìgbóṣe! àdúa dídùn"},{"start":57.513,"end":59.299,"text":"Ngo korin bi mo ti nfo lo","marked":"Ngo kọrin bí mo ti ńfọ́ lọ"},{"start":59.679,"end":61.775,"text":"Odigbose! adua didun.","marked":"Òdìgbóṣe! àdúa dídùn."}],"end":61.775}]}