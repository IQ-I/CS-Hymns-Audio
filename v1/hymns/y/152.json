{"v":1,"coll":"y","num":152,"id":"hymn_152","title":"'WO, owon Olurapada","duration":34.315,"voices":{"male":{"file":"y-152-male.m4a","bytes":245606,"sha256":"df81bdb60d33fa658126c781bf4ff7768d6f2d559232be0f9f5c7175320ede8b","duration":34.4},"female":{"file":"y-152-female.m4a","bytes":252877,"sha256":"b21ad820ee670da48dbf9ad332455b26a87f2455c8b1ae110f6d58a9d74f0a5c","duration":34.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.652,"text":"'WO, owon Olurapada","marked":"'Wò, ọwọ̀n Olùràpadà"},{"start":2.032,"end":3.17,"text":"A fe ma gburo Re","marked":"A fẹ́ má gbúrò Rẹ"},{"start":3.55,"end":5.4,"text":"Ko s'orin bi oruko Re,","marked":"Kò s'orin bí orúkọ Rẹ"},{"start":5.78,"end":7.09,"text":"T'o le dun t'abo re.","marked":"T'ó lè dun t'àbọ̀ rẹ."}],"end":7.09},{"key":"2","start":8.04,"lines":[{"start":8.04,"end":10.333,"text":"A! a ba le ma gbohun Re,","marked":"A! a bá lè má gbóhùn Rẹ̀"},{"start":10.713,"end":11.721,"text":"L'anu soro si wa,","marked":"L'ánú sọ̀rọ̀ sí wa"},{"start":12.101,"end":13.869,"text":"Nin' Alufa wa l'a o yo","marked":"Nín' Àlùfá wa l'á ò yọ"},{"start":14.249,"end":15.654,"text":"Melkisedek giga.","marked":"Melkisedek gíga."}],"end":15.654},{"key":"3","start":16.604,"lines":[{"start":16.604,"end":18.307,"text":"Jesu ni y'o se orin wa,","marked":"Jésù ni y'ó ṣe orin wa"},{"start":18.687,"end":19.997,"text":"Nigbat' a wa l'aiye","marked":"Nígbat' a wà l'aiye"},{"start":20.377,"end":21.718,"text":"A o korin ife Jesu","marked":"A ó kọrin ìfẹ́ Jésù"},{"start":22.098,"end":23.337,"text":"'Gba nkan gbogbo baje","marked":"'Gba nkan gbogbo bàjẹ́"}],"end":23.337},{"key":"4","start":24.287,"lines":[{"start":24.287,"end":25.744,"text":"Nigba 'ba yo soke lohun","marked":"Nígbà 'bá yọ sókè lọ́hùn"},{"start":26.124,"end":27.738,"text":"Pelu 'jo, eni Re","marked":"Pẹ̀lú 'jó, ẹni Rẹ"},{"start":28.118,"end":29.916,"text":"'Gbana a o korin kikan","marked":"'Gbaná a ò kọrin kíkan"},{"start":30.296,"end":31.799,"text":"Kristi'mi y'o j'orin wa.","marked":"Kristi'mi y'ó j'orin wa."},{"start":32.179,"end":32.765,"text":"Amin.","marked":"Àmín."}],"end":32.765}]}