{"v":1,"coll":"y","num":306,"id":"hymn_306","title":"OKE Kan mbe jina rere","duration":43.367,"voices":{"male":{"file":"y-306-male.m4a","bytes":310948,"sha256":"b75ded3b329e37d19482c3ca25a754907a6d22ab46719b5a7a02e533fdf14a82","duration":43.4},"female":{"file":"y-306-female.m4a","bytes":317230,"sha256":"fcffe40656d59d932fc429e98a782f62096293ea8923f784f86668d407d7c71c","duration":43.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.709,"text":"OKE Kan mbe jina rere,","marked":"Òkè Kan ḿbẹ jiná réré"},{"start":2.089,"end":3.271,"text":"Lehin odi ilu,","marked":"Lẹ́hìn odi ìlú"},{"start":3.651,"end":5.486,"text":"Nibit' a kan Oluwa mo,","marked":"Níbit' á kan Olúwa mọ́"},{"start":5.866,"end":7.339,"text":"Eniti' O ku fun wa.","marked":"Ẹniti' Ó kù fún wa."}],"end":7.339},{"key":"2","start":8.289,"lines":[{"start":8.289,"end":10.446,"text":"A ko lee mo, a ko le so,","marked":"A kò leè mọ̀, a kò lè sọ"},{"start":10.826,"end":11.737,"text":"B'irora Re tito;","marked":"B'ìrora Rẹ̀ títọ́"},{"start":12.117,"end":14.207,"text":"Sugbon a mo pe n' tori wa,","marked":"Ṣùgbọ́n a mọ̀ pé ń' torí wa"},{"start":14.587,"end":15.945,"text":"L'O se jiya nibe.","marked":"L'ó ṣe jìyà níbẹ̀."}],"end":15.945},{"key":"3","start":16.895,"lines":[{"start":16.895,"end":18.365,"text":"O ku kale huwa rere,","marked":"Ó kù kálẹ̀ hùwà rere"},{"start":18.745,"end":20.062,"text":"K' a le ri 'dariji;","marked":"K' a lè rí 'dáríjì"},{"start":20.442,"end":22.293,"text":"K' a si le d'orun nikehin","marked":"K' a sì lè d'ọrùn nikehin"},{"start":22.673,"end":24.326,"text":"N' itoye eje Re.","marked":"N' ìtóye ẹ̀jẹ̀ Rẹ."}],"end":24.326},{"key":"4","start":25.276,"lines":[{"start":25.276,"end":26.861,"text":"Ko tun s' eni 're miran mo","marked":"Kò tún s' ẹni 'rẹ̀ miran mọ́"},{"start":27.241,"end":28.56,"text":"To le sanwo ese,","marked":"Tó lè sanwó ẹ̀ṣẹ̀"},{"start":28.94,"end":30.244,"text":"On lo le silekun orun,","marked":"On lo lè ṣílẹ̀kùn ọ̀run"},{"start":30.624,"end":32.305,"text":"K' O si gba wa sile.","marked":"K' Ó sì gbà wá sílẹ̀."}],"end":32.305},{"key":"5","start":33.255,"lines":[{"start":33.255,"end":35.235,"text":"A! b' ife Re ti sowon to,","marked":"A! b' ìfẹ́ Rẹ ti ṣọ̀wọ́n tó"},{"start":35.615,"end":36.731,"text":"O ye ka feran Re;","marked":"Ó yẹ ká fẹ́ràn Rẹ̀"},{"start":37.111,"end":39.234,"text":"K' a si gbeekele eje Re,","marked":"K' a sì gbeekele ẹ̀jẹ̀ Rẹ̀"},{"start":39.614,"end":40.958,"text":"K' a si se ife Re.","marked":"K' a sì ṣe ìfẹ́ Rẹ̀."},{"start":41.338,"end":41.817,"text":"Amin.","marked":"Àmín."}],"end":41.817}]}