{"v":1,"coll":"y","num":326,"id":"hymn_326","title":"OLUWA ji l'oto","duration":32.222,"voices":{"male":{"file":"y-326-male.m4a","bytes":225156,"sha256":"eafbaf702deda1189d83ce601cc8882147b0c7cc29ca1a10da8a1f8911e1e301","duration":32.3},"female":{"file":"y-326-female.m4a","bytes":232149,"sha256":"501da41ebe21a89c250dacc31e03b77dd3f654fff37aadea8adae80840396467","duration":32.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.51,"text":"OLUWA ji l'oto","marked":"Olúwa jí l'ọ́tọ́"},{"start":1.89,"end":3.304,"text":"lhin na ha s'oto","marked":"lhin na ha ṣ'oto"},{"start":3.684,"end":5.257,"text":"Nwon ti ri p'Olugbala ku","marked":"Nwọ̀n ti rí p'Olùgbàlà kù"},{"start":5.637,"end":7.092,"text":"Nwon ri l'aye pelu.","marked":"Nwọ̀n rí l'áyé pẹ̀lú."}],"end":7.092},{"key":"2","start":8.042,"lines":[{"start":8.042,"end":9.333,"text":"Oluwa ji l'oto","marked":"Olúwa jí l'ọ́tọ́"},{"start":9.713,"end":11.146,"text":"Oto ko fe ju yi","marked":"Ọ̀tọ̀ kò fẹ́ jù yí"},{"start":11.526,"end":13.2,"text":"Anu at'otito pade","marked":"Ànú àt'òtítọ́́ pàdé"},{"start":13.58,"end":14.87,"text":"Ti nwon ti ns'ota ri.","marked":"Ti nwọn ti ns'ọ̀tá rí."}],"end":14.87},{"key":"3","start":15.82,"lines":[{"start":15.82,"end":17.229,"text":"Oluwa ji l'oto\"","marked":"Olúwa jí l'ọ́tọ́"},{"start":17.609,"end":18.674,"text":"Ise Re l'ose tan","marked":"Iṣẹ́ Rẹ l'ọ́sẹ̀ tán"},{"start":19.054,"end":20.322,"text":"A da ide onigbowo","marked":"A dá ìdè onígbọ̀wọ́"},{"start":20.702,"end":21.938,"text":"A se apa iku.","marked":"A ṣe apá ikú."}],"end":21.938},{"key":"4","start":22.888,"lines":[{"start":22.888,"end":24.181,"text":"'Oluwa ji l'oto","marked":"'Olúwa jí l'oto"},{"start":24.561,"end":26.143,"text":"Boji ko le se mo","marked":"Bọ́jì kò lè ṣe mọ́"},{"start":26.523,"end":27.938,"text":"Awon t'o ku si ji pelu","marked":"Àwọn t'ó kù sì jí pẹ̀lú"},{"start":28.318,"end":29.605,"text":"Nwon ki o si ku mo.","marked":"Nwọn kí ó sì kú mọ́."},{"start":29.985,"end":30.672,"text":"Amin.","marked":"Àmín."}],"end":30.672}]}