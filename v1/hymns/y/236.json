{"v":1,"coll":"y","num":236,"id":"hymn_236","title":"MOKANDILOGORUN dubule je","duration":67.709,"voices":{"male":{"file":"y-236-male.m4a","bytes":511196,"sha256":"2f1d47e3258b2496521a515ae8f86d632c2c714849e6fce967e230a24a4c13c0","duration":67.8},"female":{"file":"y-236-female.m4a","bytes":524261,"sha256":"0cd6eed948062b06dc8cab8ef09905ac3b0f65adb55a6e99489fcbbb28fcd41a","duration":67.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.101,"text":"MOKANDILOGORUN dubule je","marked":"Mokandilogorun dùbúlẹ̀ jẹ́"},{"start":2.481,"end":3.62,"text":"Labe oji nin'agbo","marked":"Lábẹ́ òjì níń'ágbò"},{"start":4.0,"end":5.76,"text":"Sugbon okan je lo or'oke","marked":"Ṣùgbọ́n ọkàn jẹ́ lo or'òkè"},{"start":6.14,"end":7.583,"text":"Jina s'ile ilekun wura","marked":"Jìnà s'ílẹ̀ ilẹ̀kùn wúrà"},{"start":7.963,"end":9.338,"text":"Jina rere l'or oke sisa","marked":"Jìnà réré l'or òkè sísá"},{"start":9.718,"end":11.248,"text":"Jina rere s'OIus'aguntan.","marked":"Jina rere s'Olùṣ'àgùntàn."}],"end":11.248},{"key":"2","start":12.198,"lines":[{"start":12.198,"end":14.051,"text":"'Mokandilogorun Tire leyi","marked":"'Mokandilogorun Tírè lèyí"},{"start":14.431,"end":16.927,"text":"Jesu, nwon ko ha to fun O?","marked":"Jésù, ǹwọ̀n kò ha tó fún Ọ?"},{"start":17.307,"end":19.758,"text":"Olus'agutan dahun, 'Temi yi,","marked":"Olùs'ágùtàn dáhùn, 'Tèmi yí"},{"start":20.138,"end":21.245,"text":"Ti sako lodo mi","marked":"Ti ṣàkó lọ́dọ̀ mi"},{"start":21.625,"end":22.944,"text":"B'ona tile ri palapala","marked":"B'ọ́nà tilẹ̀ rí pálapàla"},{"start":23.324,"end":25.063,"text":"Ngo w'aginju lo w'agutan mi.","marked":"Ngo w'aginju ló w'ágùtàn mi."}],"end":25.063},{"key":"3","start":26.013,"lines":[{"start":26.013,"end":27.699,"text":"Okan nin' awon t\"ara pada","marked":"Ọ̀kan nin' àwọn tara padà"},{"start":28.079,"end":29.282,"text":"Ko mo jinjin omi na","marked":"Kò mọ́ jínjìn omi ná"},{"start":29.662,"end":31.671,"text":"Ati duru oru ti Jesu koja","marked":"Àti dùrù òru tí Jésù kọjá"},{"start":32.051,"end":33.611,"text":"K'o to r'agutan re he","marked":"K'ó tó r'ágùtàn rẹ̀ he"},{"start":33.991,"end":35.531,"text":"L'aginju rere I'o gbo 'gbe re","marked":"L'aginjù rere l'ó gbọ́ 'gbé rẹ"},{"start":35.911,"end":38.206,"text":"O ti ri tan, o si t ku tan.","marked":"Ó ti rí tán, ó sì t kú tán."}],"end":38.206},{"key":"4","start":39.156,"lines":[{"start":39.156,"end":40.959,"text":"Nibo n'iro eje ni ti wa","marked":"Níbo ń'írò ẹ̀jẹ̀ ní ti wa"},{"start":41.339,"end":42.742,"text":"To fona or'oke han?","marked":"Tó fọ̀nà or'òkè hàn?"},{"start":43.122,"end":45.351,"text":"'A ta sile f'enikan t'o sako","marked":"'A ta sílẹ̀ f'enìkan t'ó ṣáko"},{"start":45.731,"end":47.242,"text":"K'Olusagutan to mu pada","marked":"K'Olùṣàgùtàn tó mú padà"},{"start":47.622,"end":50.182,"text":"Jesu, kil' o gun owo Re be?","marked":"Jésù, kil' ó gun ọwọ́ Rẹ̀ bẹ?"},{"start":50.562,"end":52.163,"text":"'Egun pupo l'o gun mi nibe.","marked":"'Ẹ̀gún púpọ̀ l'ó gún mi níbẹ̀."}],"end":52.163},{"key":"5","start":53.113,"lines":[{"start":53.113,"end":54.616,"text":"Sugbon ni gbogbo pori oke","marked":"Ṣùgbọ́n ní gbogbo porí òkè"},{"start":54.996,"end":56.122,"text":"At l'ori apata","marked":"Àt l'orí àpáta"},{"start":56.502,"end":58.35,"text":"lgbe ta l'ooke orun wipe","marked":"lgbẹ́ ta l'oòkè ọ̀run wípé"},{"start":58.73,"end":61.059,"text":"“Yo, mo r'agutan ni he\"","marked":"Yo, mo r'ágùtàn ni hẹ̀"},{"start":61.439,"end":62.988,"text":"Y'ite ka l'awon angel ngba","marked":"Y'ite ka l'àwọn angel ngba"},{"start":63.368,"end":65.237,"text":"'Yo, Jesu m'ohun Tire pada.","marked":"'Yo, Jésù m'óhun Tírè padà."},{"start":65.617,"end":66.159,"text":"Amin.","marked":"Àmín."}],"end":66.159}]}