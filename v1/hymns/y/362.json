{"v":1,"coll":"y","num":362,"id":"hymn_362","title":"E GBO b'awon Angeli ti","duration":43.059,"voices":{"male":{"file":"y-362-male.m4a","bytes":290590,"sha256":"26d4882ccfbda57c340ec063dafbea277c837c3da9adaf50e8e601f6df135814","duration":43.1},"female":{"file":"y-362-female.m4a","bytes":303011,"sha256":"70bee4da6445949ed39286421fed323ab7dcc5852d208ba8649507badee2b914","duration":43.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.948,"text":"E GBO b'awon Angeli ti","marked":"Ẹ Gbọ́ b'àwọn Áńgẹ́lì tí"},{"start":2.328,"end":3.511,"text":"Nfi Ogo f'Olorun","marked":"Nfi Ògo f'Ọlọ́run"},{"start":3.891,"end":5.226,"text":"Ati awon Olus'Agutan","marked":"Àti àwọn Olus'Agutan"},{"start":5.606,"end":6.564,"text":"Nfi 'yin fun U.","marked":"Nfì 'yìn fún U."}],"end":6.564},{"key":"2","start":7.514,"lines":[{"start":7.514,"end":8.882,"text":"Gbogbo ogun orun pelu","marked":"Gbogbo ogun ọ̀run pẹ̀lú"},{"start":9.262,"end":10.104,"text":"Agba mejila","marked":"Àgbà méjìlá"},{"start":10.484,"end":11.848,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":12.228,"end":13.139,"text":"Nfi 'yin fun U.","marked":"Nfì 'yìn fún U."}],"end":13.139},{"key":"3","start":14.089,"lines":[{"start":14.089,"end":15.795,"text":"Oke meje at'egbaji","marked":"Ọ̀kẹ́ méje àt'ẹgbàjí"},{"start":16.175,"end":17.112,"text":"Awon Agba woli","marked":"Àwọn Àgbà wòlí"},{"start":17.492,"end":18.925,"text":"Awon t'o nfe l'Olugbala","marked":"Àwọn t'ó ńfẹ́ l'Olùgbàlà"},{"start":19.305,"end":20.307,"text":"Nf 'yin fun U.","marked":"Nf 'yìn fún U."}],"end":20.307},{"key":"4","start":21.257,"lines":[{"start":21.257,"end":23.214,"text":"Gbogbo'Ogun orun, e ho ye","marked":"Gbogbo'Ogun ọ̀run, ẹ hó yé"},{"start":23.594,"end":24.946,"text":"Aiye gbo iro na,","marked":"Aiye gbọ́ ìró ná"},{"start":25.326,"end":26.75,"text":"Imisi Emi ba le wa","marked":"Ìmísí Èmi bá lè wà"},{"start":27.13,"end":28.073,"text":"Awa nyin I.","marked":"Àwa nyin I."}],"end":28.073},{"key":"5","start":29.023,"lines":[{"start":29.023,"end":30.654,"text":"N'torina awa Kerubu","marked":"N'torina àwa Kérúbù"},{"start":31.034,"end":31.956,"text":"Ati Serafu","marked":"Àti Séráfù"},{"start":32.336,"end":33.854,"text":"Ninu aginju aiye yi","marked":"Nínú aginjù aiye yi"},{"start":34.234,"end":35.059,"text":"Nyin Baba.","marked":"Nyin Bàbá."}],"end":35.059},{"key":"6","start":36.009,"lines":[{"start":36.009,"end":37.145,"text":"Ogo fun Baba Olore","marked":"Ògo fún Bàbá Ọlọ́rẹ̀"},{"start":37.525,"end":38.498,"text":"Ogo f'Omo Re","marked":"Ògo f'Ọmọ Rẹ"},{"start":38.878,"end":40.084,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":40.464,"end":41.509,"text":"Loke Orun.","marked":"Lókè Ọ̀run."}],"end":41.509}]}