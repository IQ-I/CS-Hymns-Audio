{"v":1,"coll":"y","num":794,"id":"hymn_794","title":"YIKA or'ite Olorun","duration":60.685,"voices":{"male":{"file":"y-794-male.m4a","bytes":438692,"sha256":"9978ec7d8e6ab9c4646bf9d4798e69333e860792687930b1975776f9537063a5","duration":60.7},"female":{"file":"y-794-female.m4a","bytes":456029,"sha256":"e8da4967b65ade982304f7fa01043e506338d6967376e5e00afff4a6b2b0e236","duration":60.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.363,"text":"YIKA or'ite Olorun","marked":"Yíká or'ìtẹ́ Ọlọ́run"},{"start":2.743,"end":3.729,"text":"Egberun ewe wa,","marked":"Ẹgbẹ̀rún èwe wa"},{"start":4.109,"end":5.741,"text":"Ewe t'a dari ese ji","marked":"Ewé t'á dárí ẹsẹ̀ jì"},{"start":6.121,"end":7.079,"text":"Awon egbe mimo","marked":"Àwọn ẹgbẹ́ mímọ́́"},{"start":7.459,"end":8.979,"text":"Nkorin Ogo, ogo, ogo.","marked":"Nkọrin Ògo, ògo, ògo."}],"end":8.979},{"key":"2","start":9.929,"lines":[{"start":9.929,"end":11.81,"text":"Wo! olukuluku won wo,","marked":"Wò! olúkúlùkù wọn wọ̀"},{"start":12.19,"end":13.204,"text":"Aso ala mimo","marked":"Àṣọ àlá mímọ́́"},{"start":13.584,"end":15.003,"text":"Ninu imole ailopin","marked":"Nínú ìmọ́lẹ̀̀ àìlópin"},{"start":15.383,"end":16.705,"text":"At'ayo ti ki sa,","marked":"Àt'àyò tí kì sá"},{"start":17.085,"end":18.639,"text":"Nkorin Ogo, ogo, ogo.","marked":"Nkọrin Ògo, ògo, ògo."}],"end":18.639},{"key":"3","start":19.589,"lines":[{"start":19.589,"end":21.378,"text":"Kil'o mu won de aiye na,","marked":"Kil'ó mú wọn dé aiye ná"},{"start":21.758,"end":22.829,"text":"Orun t'o se mimo","marked":"Ọrùn t'ó ṣe mímọ́́"},{"start":23.209,"end":24.789,"text":"Nib' alafia at'ayo","marked":"Níb' àlàáfíà àt'àyò"},{"start":25.169,"end":26.418,"text":"Bi nwon ti se de 'be?","marked":"Bí nwọn ti ṣe dé 'bẹ̀?"},{"start":26.798,"end":28.622,"text":"Nkorin Ogo, ogo, ogo.","marked":"Nkọrin Ògo, ògo, ògo."}],"end":28.622},{"key":"4","start":29.572,"lines":[{"start":29.572,"end":31.086,"text":"Nitori Jesu ta 'je Re,","marked":"Nítorí Jésù ta 'jẹ Rẹ"},{"start":31.466,"end":33.019,"text":"Lati k'ese won Io;","marked":"Láti k'ẹsẹ̀ wọn lọ"},{"start":33.399,"end":34.844,"text":"A ri won uinu eje na,","marked":"A rí wọn uinú ẹ̀jẹ̀ ná"},{"start":35.224,"end":36.829,"text":"Nwon di mimo laulau,","marked":"Nwọ̀n di mímọ́̀ laulau"},{"start":37.209,"end":38.819,"text":"Nkorin Ogo, ogo, ogo.","marked":"Nkọrin Ògo, ògo, ògo."}],"end":38.819},{"key":"5","start":39.769,"lines":[{"start":39.769,"end":42.097,"text":"L'aiye, nwon wa Olugbala","marked":"L'aiye, nwọn wa Olùgbàlà"},{"start":42.477,"end":43.719,"text":"Nwon fe oruko Re,","marked":"Nwọ̀n fẹ́ orúkọ Rẹ"},{"start":44.099,"end":45.58,"text":"Nisisiyi nwon r'oju Re,","marked":"Nisisiyi nwọn r'ojú Rẹ"},{"start":45.96,"end":47.168,"text":"Nwon wa niwaju Re,","marked":"Nwọ̀n wà níwájú Rẹ"},{"start":47.548,"end":49.035,"text":"Nkorin Ogo, ogo, ogo.","marked":"Nkọrin Ògo, ògo, ògo."}],"end":49.035},{"key":"6","start":49.985,"lines":[{"start":49.985,"end":51.881,"text":"Orisun na ha nsan loni?","marked":"Orísun ná ha nṣan lónì?"},{"start":52.261,"end":53.54,"text":"Jesu, mu wa de be","marked":"Jésù, mú wa dé bẹ̀"},{"start":53.92,"end":55.42,"text":"K'a le ri awon mimo na","marked":"K'á lè rí àwọn mímọ́́ ná"},{"start":55.8,"end":56.956,"text":"K'a si ba won yin O,","marked":"K'á sì bá wọn yín O"},{"start":57.336,"end":59.135,"text":"Nkorin Ogo, ogo, ogo.","marked":"Nkọrin Ògo, ògo, ògo."}],"end":59.135}]}