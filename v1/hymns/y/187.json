{"v":1,"coll":"y","num":187,"id":"hymn_187","title":"GBO 'gbe ayo! Oluwa de","duration":40.33,"voices":{"male":{"file":"y-187-male.m4a","bytes":284377,"sha256":"f41e798e3351e7b14af60c04efbb96347461379ae8885afe8e7d9098ca8fedc6","duration":40.4},"female":{"file":"y-187-female.m4a","bytes":300065,"sha256":"467483b1f069671e39ba21336fa7d26ff6e273f8ff6cd117c6bd4558613fe6d8","duration":40.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.313,"text":"GBO 'gbe ayo! Oluwa de,","marked":"Gbọ́ 'gbé ayọ̀! Olúwa dé"},{"start":2.693,"end":4.308,"text":"Jesu t'a seleri","marked":"Jésù t'á ṣèlérí"},{"start":4.688,"end":5.974,"text":"Ki gbogbo okan mura de","marked":"Kí gbogbo ọkàn múra dé"},{"start":6.354,"end":7.579,"text":"K'ohun mura korin.","marked":"K'óhun múra kọrin."}],"end":7.579},{"key":"2","start":8.529,"lines":[{"start":8.529,"end":10.097,"text":"O de lati t'onde sile","marked":"Ó dé láti t'óńdè sílẹ̀"},{"start":10.477,"end":11.633,"text":"L'oko eru esu","marked":"L'oko ẹrú èṣù"},{"start":12.013,"end":13.884,"text":"Lekun 'de fo niwaju Re","marked":"Lẹ́kùn 'dẹ̀ fọ́ níwájú Rẹ"},{"start":14.264,"end":15.368,"text":"Sekeseke rin da.","marked":"Ṣèkẹ́ṣẹkẹ̀ rìn dà."}],"end":15.368},{"key":"3","start":16.318,"lines":[{"start":16.318,"end":17.821,"text":"O de larin 'baje aiye","marked":"Ó dé lárin 'bàjẹ́ aiye"},{"start":18.201,"end":19.296,"text":"Lati tan 'mole Re","marked":"Láti tan 'mọ́lẹ̀ Rẹ"},{"start":19.676,"end":21.299,"text":"Lati mu k'awon afoju","marked":"Láti mú k'áwọn afọ́jú"},{"start":21.679,"end":22.782,"text":"Le f'oju won riran.","marked":"Lè f'ojú wọn ríran."}],"end":22.782},{"key":"4","start":23.732,"lines":[{"start":23.732,"end":25.18,"text":"O de 'tanu f'okan 'rora","marked":"Ó dé 'tanú f'ọkàn 'rora"},{"start":25.56,"end":26.736,"text":"Iwosan f'agbogbe","marked":"Ìwòsàn f'ágbọgbẹ́"},{"start":27.116,"end":28.444,"text":"Pelu 'sura or-ofe Re","marked":"Pẹ̀lú 'ṣúra or-ọ̀fẹ́ Rẹ"},{"start":28.824,"end":29.939,"text":"Fun awon talaka.","marked":"Fún àwọn tálákà."}],"end":29.939},{"key":"5","start":30.889,"lines":[{"start":30.889,"end":32.681,"text":"Hosanna, Ob'Alafia","marked":"Hosanna, Ob'Àlàáfíà"},{"start":33.061,"end":34.611,"text":"A o kede bibo Re;","marked":"A ó kéde bíbọ̀ Rẹ̀"},{"start":34.991,"end":36.287,"text":"Gbogbo orun y'o ma korin","marked":"Gbogbo ọrùn y'ó ma kọrin"},{"start":36.667,"end":37.833,"text":"oruko t'a feran.","marked":"orúkọ t'á fẹ́ràn."},{"start":38.213,"end":38.78,"text":"Amin.","marked":"Àmín."}],"end":38.78}]}