{"v":1,"coll":"y","num":119,"id":"hymn_119","title":"GBOGBO aiye, gbe Jesu ga","duration":49.406,"voices":{"male":{"file":"y-119-male.m4a","bytes":349329,"sha256":"1e2e0efdced0914f3b1c6358dba6f5abf042ef83f4770810b4212250ecaf74a0","duration":49.5},"female":{"file":"y-119-female.m4a","bytes":365879,"sha256":"61b90c3d8b9fe0c5806b760f15a80d6b680332038900823fae6c7c39d2d55165","duration":49.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.85,"text":"GBOGBO aiye, gbe Jesu ga,","marked":"Gbogbo aiye, gbé Jésù ga"},{"start":3.23,"end":4.98,"text":"Angeli, e wole fun","marked":"Áńgẹ́lì, ẹ wọlé fún"},{"start":5.36,"end":6.61,"text":"E mu ade Oba Re wa,","marked":"Ẹ mú adé Ọba Rẹ̀ wá"},{"start":6.99,"end":8.5,"text":"Se l'Oba awon Oba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":8.5},{"key":"2","start":9.45,"lines":[{"start":9.45,"end":11.212,"text":"E se l'Oba enyin Martyr","marked":"Ẹ ṣe l'Ọba ènyìn Martyr"},{"start":11.592,"end":12.852,"text":"Ti npe ni pepe Re","marked":"Ti ńpẹ́ ní pẹpẹ Rẹ"},{"start":13.232,"end":14.876,"text":"Gbe gbongbon-igi Jesse ga","marked":"Gbé gbọ̀ngbọ̀n-igi Jesse ga"},{"start":15.256,"end":16.845,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."}],"end":16.845},{"key":"3","start":17.795,"lines":[{"start":17.795,"end":19.228,"text":"Enyin iru-omo Israel","marked":"Enyin irú-ọmọ Israel"},{"start":19.608,"end":20.575,"text":"Ti a ti rapada","marked":"Tí a ti ràpadà"},{"start":20.955,"end":22.56,"text":"E ki enit'o gba nyin la,","marked":"Ẹ kí enít'ó gbà nyín lá"},{"start":22.94,"end":24.447,"text":"Se l'Oba awon Oba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":24.447},{"key":"4","start":25.397,"lines":[{"start":25.397,"end":26.653,"text":"Gbogbo enia elese","marked":"Gbogbo enia ẹlẹ́ṣẹ̀"},{"start":27.033,"end":28.351,"text":"Ranti 'banuje nyin","marked":"Ranti 'banújẹ́ nyin"},{"start":28.731,"end":30.165,"text":"E te 'kogun nyin s'ese Re","marked":"Ẹ tẹ 'kógun nyin s'èṣe Rẹ̀"},{"start":30.545,"end":32.017,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."}],"end":32.017},{"key":"5","start":32.967,"lines":[{"start":32.967,"end":33.953,"text":"Ki gbogbo orile-ede","marked":"Kí gbogbo orílẹ̀-èdè"},{"start":34.333,"end":35.537,"text":"Ni gbogbo agbaiye","marked":"Ní gbogbo agbaiye"},{"start":35.917,"end":37.585,"text":"Ki nwon ki, “Kabiyesile”","marked":"Kí nwọn kí, Kábíyèsílẹ̀"},{"start":37.965,"end":39.283,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."}],"end":39.283},{"key":"6","start":40.233,"lines":[{"start":40.233,"end":41.781,"text":"A ba le pel'awon t'orun","marked":"A bá lè pel'awon t'ọrun"},{"start":42.161,"end":43.215,"text":"Lati ma juba Re","marked":"Láti má júbà Rẹ"},{"start":43.595,"end":45.156,"text":"K'a ba le jo jumo Korin","marked":"K'á bá lè jọ jùmọ̀ Kọ́rìn"},{"start":45.536,"end":46.902,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."},{"start":47.282,"end":47.856,"text":"Amin.","marked":"Àmín."}],"end":47.856}]}