{"v":1,"coll":"y","num":38,"id":"hymn_38","title":"DlDUN n'ise na, Oba mi","duration":43.481,"voices":{"male":{"file":"y-38-male.m4a","bytes":314229,"sha256":"1b65530babf1fbef94f83951995f96d2cfff4605d558864f9362e9fce5cf1567","duration":43.5},"female":{"file":"y-38-female.m4a","bytes":321339,"sha256":"eead98e6ead90667542cee75b1e9640e508cbd81950ce87986cd088db42f1926","duration":43.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.047,"text":"DlDUN n'ise na, Oba mi","marked":"DlDUN n'iṣẹ́ ná, Ọba mi"},{"start":2.427,"end":3.623,"text":"Lati ma yin Oruko Re;","marked":"Láti má yin Orúkọ Rẹ"},{"start":4.003,"end":5.743,"text":"Lati se 'fe Re l'owuro","marked":"Láti ṣe 'fẹ́ Rẹ l'òwúrọ̀"},{"start":6.123,"end":7.778,"text":"Lati so oro Re l'ale.","marked":"Láti sọ ọ̀rọ̀ Rẹ l'álẹ̀."}],"end":7.778},{"key":"2","start":8.728,"lines":[{"start":8.728,"end":10.118,"text":"Didun l'ojo 'simi mimo","marked":"Dídùn l'ọjọ́ 'símí mímọ́́"},{"start":10.498,"end":11.783,"text":"Lala ko so fun mi loni","marked":"Làlà kò sọ fún mi lọ́ni"},{"start":12.163,"end":13.303,"text":"Okan mi ma korin iyin","marked":"Ọkàn mi mà kọrin ìyìn"},{"start":13.683,"end":15.095,"text":"Bi harpu Dafidi didun.","marked":"Bí harpu Dáfídì dídùn."}],"end":15.095},{"key":"3","start":16.045,"lines":[{"start":16.045,"end":17.513,"text":"Okan mi o yo n'Oluwa","marked":"Ọkàn mi ò yọ n'Olúwa"},{"start":17.893,"end":19.833,"text":"Y'o yin ise at'oro Re,","marked":"Y'ó yin iṣẹ́ àt'ọ̀rọ̀ Rẹ̀"},{"start":20.213,"end":21.696,"text":"lse ore Re ti po to!","marked":"lṣe ọ̀rẹ́ Rẹ ti pọ̀ tó!"},{"start":22.076,"end":23.691,"text":"ljinle si ni imo Re.","marked":"ljinlẹ̀ sì ni ìmọ̀ Rẹ̀."}],"end":23.691},{"key":"4","start":24.641,"lines":[{"start":24.641,"end":25.798,"text":"Emi o yan ipo ola","marked":"Èmi ò yan ipò ọlá"},{"start":26.178,"end":27.535,"text":"Gb'ore-ofe ba we mi nu","marked":"Gb'ọ̀rẹ́-ọ̀fẹ́ bá wé mi nù"},{"start":27.915,"end":29.447,"text":"Ti ayo pupo si ba mi,","marked":"Tí ayọ̀ púpọ̀ sì bá mi"},{"start":29.827,"end":31.172,"text":"Ayo mimo lat' oke wa.","marked":"Ayọ̀ mímọ́́ lat' oke wà."}],"end":31.172},{"key":"5","start":32.122,"lines":[{"start":32.122,"end":35.039,"text":"Ghana, ngo ri, ngo gbo ngo mo,","marked":"Ghana, ngo rí, ngo gbọ́ ngo mọ́"},{"start":35.419,"end":37.269,"text":"Ohun gbogbo ti mo ti nfe","marked":"Ohun gbogbo tí mo ti ńfẹ́"},{"start":37.649,"end":39.124,"text":"Gbogbo ipa mi y'o dalu","marked":"Gbogbo ipá mi y'ó dàlú"},{"start":39.504,"end":41.001,"text":"Lati se 'fe Re titi lai.","marked":"Láti ṣe 'fẹ́ Rẹ títí láì."},{"start":41.381,"end":41.931,"text":"Amin.","marked":"Àmín."}],"end":41.931}]}