{"v":1,"coll":"y","num":830,"id":"hymn_830","title":"MO fe ki ndabi Jesu","duration":47.64,"voices":{"male":{"file":"y-830-male.m4a","bytes":337822,"sha256":"cb9c9b3215f09873316bbceaf28cdbe7f0343263001192dab5213919e08363ab","duration":47.7},"female":{"file":"y-830-female.m4a","bytes":351917,"sha256":"78b518b6a2ca2e8ae3224684d7ec530915e65887d8edaf8c0bdacf0623cdc56e","duration":47.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.724,"text":"MO fe ki ndabi Jesu","marked":"Mo fẹ́ kí ndabi Jésù"},{"start":2.104,"end":3.274,"text":"Ninu iwa pele","marked":"Nínú ìwà pẹ̀lẹ́"},{"start":3.654,"end":5.211,"text":"Ko s'enit'o gboro binu","marked":"Kò s'enit'ó gbọ́rọ̀ bínú"},{"start":5.591,"end":6.733,"text":"Lenu Re lekan ri.","marked":"Lẹ́nu Rẹ lẹ́kàn rí."}],"end":6.733},{"key":"2","start":7.683,"lines":[{"start":7.683,"end":9.196,"text":"Mo fe ki ndabi Jesu","marked":"Mo fẹ́ kí ndabi Jésù"},{"start":9.576,"end":10.955,"text":"L'adura 'gbagbogbo","marked":"L'àdúrà 'gbàgbogbo"},{"start":11.335,"end":12.622,"text":"L'ori oke ni On nikan","marked":"L'orí òkè ní Ọ̀n nìkan"},{"start":13.002,"end":14.343,"text":"Lo pade Baba Re.","marked":"Ló pàdé Bàbá Rẹ."}],"end":14.343},{"key":"3","start":15.293,"lines":[{"start":15.293,"end":16.733,"text":"Mo fe ki ndabi Jesu","marked":"Mo fẹ́ kí ndabi Jésù"},{"start":17.113,"end":18.222,"text":"Emi ko ri ka pe","marked":"Èmi kò rí kà pé"},{"start":18.602,"end":20.0,"text":"Bi nwon ti korira Re to","marked":"Bí nwọn ti kóríra Rẹ̀ tó"},{"start":20.38,"end":21.67,"text":"O s'enikan n'ibi.","marked":"Ó s'ẹ́nìkan ń'íbí."}],"end":21.67},{"key":"4","start":22.62,"lines":[{"start":22.62,"end":23.968,"text":"Mo fe ki ndabi Jesu","marked":"Mo fẹ́ kí ndabi Jésù"},{"start":24.348,"end":25.416,"text":"Ninu ise rere","marked":"Nínú iṣẹ́ rere"},{"start":25.796,"end":27.498,"text":"K'a le wi nipa temi pe","marked":"K'á lè wí nípa tẹ̀mí pé"},{"start":27.878,"end":29.044,"text":"O se 'won t'o le se.","marked":"Ó ṣe 'wọ̀n t'ó lè ṣe."}],"end":29.044},{"key":"5","start":29.994,"lines":[{"start":29.994,"end":31.468,"text":"Mo fe ki ndabi Jesu","marked":"Mo fẹ́ kí ndabi Jésù"},{"start":31.848,"end":33.172,"text":"T'o f'iyonu wipe","marked":"T'ó f'ìyọnu wípé"},{"start":33.552,"end":35.206,"text":"Jeki omode wa sodo Mi","marked":"Jẹ́kí ọmọdé wá sọ́dọ̀ Mi"},{"start":35.586,"end":36.933,"text":"Mo fe je ipe Re.","marked":"Mo fẹ́ jẹ́ ìpè Rẹ."}],"end":36.933},{"key":"6","start":37.883,"lines":[{"start":37.883,"end":39.401,"text":"Sugbon nko dabi Jesu","marked":"Ṣùgbọ́n ńkọ́ dàbí Jésù"},{"start":39.781,"end":41.089,"text":"O si han gbangba be","marked":"Ó sì hàn gbangba bẹ́"},{"start":41.469,"end":43.101,"text":"Jesu fun mi l'ore-ofe","marked":"Jésù fún mi l'ọ̀rẹ́-ọ̀fẹ́"},{"start":43.481,"end":45.066,"text":"Se mi ki ndabi Re.","marked":"Ṣé mi kí ndabi Rẹ."},{"start":45.446,"end":46.09,"text":"Amin.","marked":"Àmín."}],"end":46.09}]}