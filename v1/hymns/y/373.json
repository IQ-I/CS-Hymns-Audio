{"v":1,"coll":"y","num":373,"id":"hymn_373","title":"PARADISE! Paradise!","duration":46.813,"voices":{"male":{"file":"y-373-male.m4a","bytes":329061,"sha256":"6c89d452fbd3cc818212d976b934aea22818946c1367956d853a32912231dc49","duration":46.9},"female":{"file":"y-373-female.m4a","bytes":341710,"sha256":"db862132407435cadfb1860786396e871103cec4f6fafc4c56f76d85e925be86","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.116,"text":"PARADISE! Paradise!","marked":"Párádísè! Párádísè!"},{"start":2.496,"end":3.812,"text":"Tani ko fe simi?","marked":"Tani kò fẹ́ sìmí?"},{"start":4.192,"end":5.738,"text":"Tani ko fe 'le ayo na","marked":"Tani kò fẹ́ 'lé ayọ̀ ná"},{"start":6.118,"end":7.171,"text":"lle alabukun.","marked":"llẹ alábùkún."}],"end":7.171},{"key":"CHORUS","start":8.121,"lines":[{"start":8.121,"end":9.278,"text":"Nib'awon oloto","marked":"Níb'àwọn ọlọ́tọ̀"},{"start":9.658,"end":10.758,"text":"Wa lai ninu 'mole","marked":"Wà láì nínú 'mọ́lẹ̀"},{"start":11.138,"end":12.471,"text":"Nwon nyo nigbagbogbo","marked":"Nwọ̀n nyo nígbàgbogbo"},{"start":12.851,"end":13.897,"text":"Niwaju Olorun.","marked":"Níwájú Ọlọ́run."}],"end":13.897},{"key":"2","start":14.847,"lines":[{"start":14.847,"end":16.414,"text":"Paradise! Paradise!","marked":"Párádísè! Párádísè!"},{"start":16.794,"end":18.182,"text":"Aiye ndarugbo lo","marked":"Àìyẹ́ ndarugbo lọ"},{"start":18.562,"end":20.046,"text":"Tani ko si fe lo simi","marked":"Tani kò sì fẹ́ lọ sími"},{"start":20.426,"end":21.601,"text":"Nib' ife tutu?","marked":"Níb' ìfẹ́ tutù?"}],"end":21.601},{"key":"3","start":22.551,"lines":[{"start":22.551,"end":24.495,"text":"Paradise! Paradise!","marked":"Párádísè! Párádísè!"},{"start":24.875,"end":26.442,"text":"Aiye yi ma su mi!","marked":"Aiye yí mà sú mi!"},{"start":26.822,"end":28.446,"text":"Okan mi nfa sodo Jesu","marked":"Ọkàn mi ńfà sọ́dọ̀ Jésù"},{"start":28.826,"end":30.004,"text":"Emi nfe r'oju Re.","marked":"Èmi ńfẹ́ r'ojú Rẹ."}],"end":30.004},{"key":"4","start":30.954,"lines":[{"start":30.954,"end":32.831,"text":"Paradise! Paradise!","marked":"Párádísè! Párádísè!"},{"start":33.211,"end":34.39,"text":"Mo fe ki nye dese","marked":"Mo fẹ́ kí nye dẹ́ṣẹ̀"},{"start":34.77,"end":36.592,"text":"Mo fe ki nwa lodo Jesu,","marked":"Mo fẹ́ kí ńwá lọ́dọ̀ Jésù"},{"start":36.972,"end":37.88,"text":"Li ebute mimo.","marked":"Lí èbúté mímọ́́."}],"end":37.88},{"key":"5","start":38.83,"lines":[{"start":38.83,"end":40.656,"text":"Paradise! Paradise!","marked":"Párádísè! Párádísè!"},{"start":41.036,"end":42.076,"text":"Nko ni duro pe mo","marked":"Nkò ní dúró pẹ́ mọ́"},{"start":42.456,"end":43.991,"text":"Nisiyi b'eni pe mo ngbo","marked":"Nísíyí b'ẹni pé mo ńgbó"},{"start":44.371,"end":45.263,"text":"Ohun orin orun.","marked":"Ohùn orin ọ̀run."}],"end":45.263}]}