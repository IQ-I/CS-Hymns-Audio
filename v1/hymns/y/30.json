{"v":1,"coll":"y","num":30,"id":"hymn_30","title":"JESU, afe pade","duration":42.155,"voices":{"male":{"file":"y-30-male.m4a","bytes":299732,"sha256":"509342e59b7c89d5ba3879b830e47c611c51c80691b0dd5b1ecdaffdcd4c16b8","duration":42.2},"female":{"file":"y-30-female.m4a","bytes":314340,"sha256":"f1c51aaa6d80f5e9067fa276ceb0b78587e9273c7ba3b8250f07c755f2c99e5f","duration":42.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.174,"text":"JESU, afe pade,","marked":"Jésù, afẹ́ pàdé"},{"start":2.554,"end":3.797,"text":"L'ojo Re Mimo yi","marked":"L'ọjọ́ Rẹ Mímọ́́ yí"},{"start":4.177,"end":5.376,"text":"A si y'ite Re ka","marked":"A sì y'ítẹ̀ Rẹ̀ ká"},{"start":5.756,"end":6.965,"text":"L'ojo Re mimo yi","marked":"L'ọjọ́ Rẹ mímọ́́ yí"},{"start":7.345,"end":8.291,"text":"'Wo Ore wa orun","marked":"'Wo Ọ̀rẹ́ wa ọ̀run"},{"start":8.671,"end":9.909,"text":"Adura wa mbo wa,","marked":"Àdúrà wa mbo wa"},{"start":10.289,"end":11.314,"text":"Bojuwo emi wa,","marked":"Bọ́júwò ẹ̀mí wa"},{"start":11.694,"end":12.82,"text":"L'ojo Re mimo yi.","marked":"L'ọjọ́ Rẹ mímọ́́ yí."}],"end":12.82},{"key":"2","start":13.77,"lines":[{"start":13.77,"end":15.077,"text":"A ko gbodo lora,","marked":"A kò gbọ́dọ̀ lọ́ra"},{"start":15.457,"end":16.596,"text":"L'ojo Re mimo yi;","marked":"L'ọjọ́ Rẹ mímọ́́ yí"},{"start":16.976,"end":18.054,"text":"Li eru a kunle,","marked":"Lí ẹrù a kúnlẹ̀"},{"start":18.434,"end":19.558,"text":"Lojo Re mimo yi","marked":"Lọ́jọ́ Rẹ̀ mímọ́́ yí"},{"start":19.938,"end":20.977,"text":"Ma taro ise wa,","marked":"Má tàró iṣẹ́ wa"},{"start":21.357,"end":22.415,"text":"K'Iwo ko si ko wa","marked":"K'Ìwọ kò sì kọ́ wa"},{"start":22.795,"end":24.509,"text":"K'a sin O b'o ti ye","marked":"K'á sin O b'ó ti yé"},{"start":24.889,"end":26.027,"text":"L'ojo Re mimo yi.","marked":"L'ọjọ́ Rẹ mímọ́́ yí."}],"end":26.027},{"key":"3","start":26.977,"lines":[{"start":26.977,"end":28.131,"text":"A teti s'oro Re","marked":"A tẹ́tí s'ọ̀rọ̀ Rẹ"},{"start":28.511,"end":29.649,"text":"L'ojo Re mimo yi,","marked":"L'ọjọ́ Rẹ mímọ́́ yí"},{"start":30.029,"end":31.326,"text":"Bukun oro t'a gbo","marked":"Bùkún oró t'á gbó"},{"start":31.706,"end":32.785,"text":"L'ojo Re mimo yi,","marked":"L'ọjọ́ Rẹ mímọ́́ yí"},{"start":33.165,"end":34.553,"text":"Ba wa lo gbat' a lo","marked":"Bá wa lọ gbat' a lọ"},{"start":34.933,"end":36.153,"text":"F'ore Igbala Re,","marked":"F'ọ̀rẹ́ Ìgbàlà Rẹ"},{"start":36.533,"end":38.068,"text":"Si aiya wa gbogbo,","marked":"Sí àìyá wa gbogbo"},{"start":38.448,"end":39.562,"text":"L'ojo Re mimo yi.","marked":"L'ọjọ́ Rẹ mímọ́́ yí."},{"start":39.942,"end":40.605,"text":"Amin.","marked":"Àmín."}],"end":40.605}]}