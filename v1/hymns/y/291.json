{"v":1,"coll":"y","num":291,"id":"hymn_291","title":"SI pepe Oluwa","duration":21.926,"voices":{"male":{"file":"y-291-male.m4a","bytes":147489,"sha256":"883fded650cb48ecd3d0e9d581b709635268f73c03f1277f933c689d186368d6","duration":22.0},"female":{"file":"y-291-female.m4a","bytes":151348,"sha256":"5a6a2bff62dc5369fb9adf42eccc69660a60b23e231dab1661d5e21c2b161a2c","duration":22.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.331,"text":"SI pepe Oluwa,","marked":"Sí pẹpẹ Olúwa"},{"start":1.711,"end":2.691,"text":"Mo mu 'banuje wa","marked":"Mo mú 'banújẹ́ wá"},{"start":3.071,"end":4.339,"text":"Wo ki o f'anu tewogba,","marked":"Wò kí o f'ánú tẹ́wọ́gbà"},{"start":4.719,"end":5.683,"text":"Ohun alaiye yi?","marked":"Ohun aláìyẹ yí?"}],"end":5.683},{"key":"2","start":6.633,"lines":[{"start":6.633,"end":7.979,"text":"Kristi Odagutan","marked":"Kristi Ọ̀dàgùtàn"},{"start":8.359,"end":9.49,"text":"Ni igbagbo mi nwo","marked":"Ní ìgbàgbọ́́ mi ńwò"},{"start":9.87,"end":11.586,"text":"Wo le ko hun alaiye yi?","marked":"Wò lẹ kò hun aláìyẹ yí?"},{"start":11.966,"end":13.264,"text":"Wo o gba ebo mi.","marked":"Wò ó gba ẹbọ mi."}],"end":13.264},{"key":"3","start":14.214,"lines":[{"start":14.214,"end":15.455,"text":"Gbati Jesu mi ku","marked":"Gbátí Jésù mi kù"},{"start":15.835,"end":17.121,"text":"A te ofin l'orun","marked":"A tẹ òfin l'ọrun"},{"start":17.501,"end":18.933,"text":"Ofin ko ba mi l'eru mo","marked":"Òfin kò bá mi l'ẹ̀rù mọ́"},{"start":19.313,"end":20.376,"text":"Toripe Jesu ku.","marked":"Torípé Jésù kú."}],"end":20.376}]}