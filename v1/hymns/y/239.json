{"v":1,"coll":"y","num":239,"id":"hymn_239","title":"JESU, agbara mi","duration":57.667,"voices":{"male":{"file":"y-239-male.m4a","bytes":409788,"sha256":"091507dda934939324ac1047a8133ce52805272c59340996cae2e92f8af6a796","duration":57.7},"female":{"file":"y-239-female.m4a","bytes":429577,"sha256":"889a3064c9126630ce0afef537747e0d89a087488f6f09be698d8fddcd9a5191","duration":57.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.784,"text":"JESU, gbara mi","marked":"Jésù, gbara mi"},{"start":2.164,"end":3.201,"text":"Iwo l'aniyan mi","marked":"Ìwọ l'àníyàn mi"},{"start":3.581,"end":4.948,"text":"Emi fi igbagbo woke","marked":"Èmi fi ìgbàgbọ́́ wọ́kẹ́"},{"start":5.328,"end":6.412,"text":"Iwo I'o ngbadura","marked":"Ìwọ l'ó ńgbàdúrà"},{"start":6.792,"end":7.804,"text":"Je ki nduro de O","marked":"Jẹ́ kí ńdúró dé O"},{"start":8.184,"end":9.331,"text":"Ki nle se ife Re","marked":"Kí ńlẹ̀ ṣe ìfẹ́ Rẹ"},{"start":9.711,"end":10.93,"text":"Ki iwo Olodumare","marked":"Kí ìwọ Olódùmarè"},{"start":11.31,"end":12.687,"text":"K'o so mi di otun.","marked":"K'ó sọ mí di ọ̀tún."}],"end":12.687},{"key":"2","start":13.637,"lines":[{"start":13.637,"end":14.794,"text":"Fun mi l'okan rele","marked":"Fún mi l'ọ̀kan rẹlẹ̀"},{"start":15.174,"end":16.547,"text":"Ti 'ma se ara re","marked":"Ti 'ma ṣe ara rẹ"},{"start":16.927,"end":18.978,"text":"Ti ntemole, ti ko nani","marked":"Ti ńtèmọ́lẹ̀, tí kò náni"},{"start":19.358,"end":20.372,"text":"lkekun Satani","marked":"lkẹkùn Sátánì"},{"start":20.752,"end":21.83,"text":"Okan t'ara re mo","marked":"Ọkàn t'ara rẹ mọ́"},{"start":22.21,"end":23.541,"text":"lrora at'ise","marked":"lrora àt'iṣẹ́"},{"start":23.921,"end":25.71,"text":"T'o nfi suru at'igboiya","marked":"T'ó ńfi ṣùrù at'igboiya"},{"start":26.09,"end":27.297,"text":"Ru agbelebu re.","marked":"Rú àgbélébùú rẹ."}],"end":27.297},{"key":"3","start":28.247,"lines":[{"start":28.247,"end":29.156,"text":"Funmi l'eru orun","marked":"Fúnmi l'ẹrú ọ̀run"},{"start":29.536,"end":30.632,"text":"Oju to mu hanhan","marked":"Ojú tó mú hánhán"},{"start":31.012,"end":32.636,"text":"T'yo wo O ngbe ese sunmole","marked":"T'yó wo Ó ńgbé ẹsẹ̀ sùnmọ́lẹ̀"},{"start":33.016,"end":34.492,"text":"K'ori b'Esu ti nsa","marked":"K'orí b'Èṣù ti ńsá"},{"start":34.872,"end":36.21,"text":"Fun mi ni emi ni","marked":"Fún mi ní èmi ni"},{"start":36.59,"end":37.744,"text":"T'O ti pese tele","marked":"T'ó ti pèsè tẹ́lẹ̀"},{"start":38.124,"end":39.637,"text":"Emi t'o nduro gangan lai","marked":"Èmi t'ó ńdúró gangan láí"},{"start":40.017,"end":41.607,"text":"T'o nf' adura sona.","marked":"T'ó ńf' àdúrà sọ́nà."}],"end":41.607},{"key":"4","start":42.557,"lines":[{"start":42.557,"end":43.775,"text":"Mo gbekele'oro Re,","marked":"Mo gbẹ́kẹ̀lé'ọ̀rọ̀ Rẹ"},{"start":44.155,"end":45.301,"text":"Wo l'o leri fun mi","marked":"Wò l'ó lérí fún mi"},{"start":45.681,"end":47.045,"text":"lranwo at'igbala mi","marked":"lrànwọ́ àt'ìgbàlà mi"},{"start":47.425,"end":48.651,"text":"Y'o t'odo Re wa Se","marked":"Y'ó t'ọ̀dọ̀ Rẹ̀ wá Ṣe"},{"start":49.031,"end":50.222,"text":"Sa je ki nle duro","marked":"Ṣá jẹ́ kí ńlẹ̀ dúró"},{"start":50.602,"end":51.691,"text":"K'ireti mi ma ye","marked":"K'ìrètí mi mà yé"},{"start":52.071,"end":53.402,"text":"Tit'lwo o fi mo'kan mi","marked":"Tít'lwọ ò fi mọ́'kàn mi"},{"start":53.782,"end":55.129,"text":"Wo 'nu isimi Re.","marked":"Wo 'nu isimi Rẹ."},{"start":55.509,"end":56.117,"text":"Amin.","marked":"Àmín."}],"end":56.117}]}