{"v":1,"coll":"y","num":842,"id":"hymn_842","title":"OJO oni lo tan","duration":54.321,"voices":{"male":{"file":"y-842-male.m4a","bytes":373880,"sha256":"4d4635d559564f607e8d918514945c17d23af392dba79850925655d3af24a98a","duration":54.4},"female":{"file":"y-842-female.m4a","bytes":387327,"sha256":"a21d37509029040132d31f4216ab3b80e29a3605f3001400752cab54751df0a8","duration":54.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.336,"text":"OJO oni lo tan","marked":"Ọjọ́ òní ló tán"},{"start":1.716,"end":2.836,"text":"Oru sunmole","marked":"Òru sùnmọ́lẹ̀"},{"start":3.216,"end":4.433,"text":"Okunkun si de tan","marked":"Òkùnkùn sì dé tán"},{"start":4.813,"end":6.133,"text":"Ile si ti su.","marked":"Ilẹ̀ sì ti ṣú."}],"end":6.133},{"key":"2","start":7.083,"lines":[{"start":7.083,"end":8.163,"text":"Okunkun bo ile","marked":"Òkùnkùn bo ilé"},{"start":8.543,"end":9.345,"text":"Awon 'rawo yo","marked":"Àwọn 'ràwọ̀ yó"},{"start":9.725,"end":10.969,"text":"Eranko at'eiye","marked":"Ẹranko at'eiye"},{"start":11.349,"end":12.544,"text":"Lo si 'busun won.","marked":"Lọ sí 'bùsùn wọn."}],"end":12.544},{"key":"3","start":13.494,"lines":[{"start":13.494,"end":14.69,"text":"Jesu, f'orun didun","marked":"Jésù, f'ọrun dídùn"},{"start":15.07,"end":15.919,"text":"F'eni alare","marked":"F'ẹni aláre"},{"start":16.299,"end":17.355,"text":"Jeki ibukun Re","marked":"Jẹ́kí ìbùkún Rẹ"},{"start":17.735,"end":18.583,"text":"Pa oju mi de.","marked":"Pa ojú mi dé."}],"end":18.583},{"key":"4","start":19.533,"lines":[{"start":19.533,"end":20.9,"text":"Jek' omo kekekre","marked":"Jek' ọmọ kekekre"},{"start":21.28,"end":22.258,"text":"La ala rere","marked":"La àlá rere"},{"start":22.638,"end":23.941,"text":"S'oloko t'ewu nwu","marked":"S'olóko t'ewu nwú"},{"start":24.321,"end":25.177,"text":"Ni oju omi.","marked":"Ní ojú omi."}],"end":25.177},{"key":"5","start":26.127,"lines":[{"start":26.127,"end":27.131,"text":"Ma toju alaisan","marked":"Má tọ́jú aláìsàn"},{"start":27.511,"end":28.482,"text":"Ti ko r'orun sun","marked":"Tí kò r'ọrùn sùn"},{"start":28.862,"end":30.185,"text":"Awon ti nro ibi","marked":"Àwọn ti ńro ibi"},{"start":30.565,"end":31.801,"text":"Jo da won l'ekun.","marked":"Jọ dà wọ́n l'èkùn."}],"end":31.801},{"key":"6","start":32.751,"lines":[{"start":32.751,"end":33.567,"text":"Ninu gbogbo oru","marked":"Nínú gbogbo òru"},{"start":33.947,"end":35.028,"text":"Jek' Angeli Re","marked":"Jẹ́k' Áńgẹ́lì Rẹ"},{"start":35.408,"end":36.451,"text":"Mase oluso mi","marked":"Masẹ́ olùṣọ́ mi"},{"start":36.831,"end":37.842,"text":"L'ori eni mi.","marked":"L'orí ẹni mi."}],"end":37.842},{"key":"7","start":38.792,"lines":[{"start":38.792,"end":40.31,"text":"Gbat' ile na si mo","marked":"Gbat' ilé ná sí mọ́"},{"start":40.69,"end":41.82,"text":"Jek'emi dide","marked":"Jẹ́k'ẹ̀mí dìde"},{"start":42.2,"end":43.703,"text":"B'omo ti ko l'ese","marked":"B'ọmọ tí kò l'ẹsẹ̀"},{"start":44.083,"end":45.02,"text":"Ni iwaju Re.","marked":"Ní iwájú Rẹ."}],"end":45.02},{"key":"8","start":45.97,"lines":[{"start":45.97,"end":46.956,"text":"Ogo ni fun Baba","marked":"Ògo ni fún Bàbá"},{"start":47.336,"end":48.351,"text":"Ati fun Omo","marked":"Àti fún Ọmọ"},{"start":48.731,"end":49.946,"text":"Ati f'Emi Mimo","marked":"Àti f'Ẹ̀mí Mímọ́́"},{"start":50.326,"end":51.799,"text":"Lai ati Iailai.","marked":"Láì àti láíláí."},{"start":52.179,"end":52.771,"text":"Amin.","marked":"Àmín."}],"end":52.771}]}