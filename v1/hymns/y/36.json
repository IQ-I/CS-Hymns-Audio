{"v":1,"coll":"y","num":36,"id":"hymn_36","title":"NlGBAWO Olugbala mi","duration":32.571,"voices":{"male":{"file":"y-36-male.m4a","bytes":225995,"sha256":"1c28e2d89b009787c5dc11eb99a4ba60f6ade2cd8cae1973914383e76364c977","duration":32.6},"female":{"file":"y-36-female.m4a","bytes":235342,"sha256":"ee8d92bb19b320ceedfef8567e613830e57a3fd7b13cc74ad2c014d2fbed7dd3","duration":32.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.438,"text":"NlGBAWO Olugbala mi,","marked":"NlGBÀWỌ́ Olùgbàlà mi"},{"start":1.818,"end":2.999,"text":"L'emi o ri O je?","marked":"L'èmi ò rí Ọ jẹ?"},{"start":3.379,"end":4.809,"text":"N'isimi t'o ni ibukun,","marked":"N'isimi t'ó ní ìbùkún"},{"start":5.189,"end":6.897,"text":"Laisi 'boju larin.","marked":"Láìsí 'bójú lárin."}],"end":6.897},{"key":"2","start":7.847,"lines":[{"start":7.847,"end":9.317,"text":"Ran mi lowo n'irinkiri","marked":"Ràn mí lọ́wọ́ n'irinkiri"},{"start":9.697,"end":10.884,"text":"L'aiye aniyan yi;","marked":"L'áiye àníyàn yí"},{"start":11.264,"end":12.893,"text":"Se mi ki nfi 'fe gbadura,","marked":"Ṣé mi kí nfì 'fẹ́ gbàdúrà"},{"start":13.273,"end":14.627,"text":"Si gha adura mi.","marked":"Sì gha àdúrà mi."}],"end":14.627},{"key":"3","start":15.577,"lines":[{"start":15.577,"end":17.378,"text":"Da mi si, Baba, da mi si","marked":"Dá mi sí, Bàbá, dá mi sí"},{"start":17.758,"end":18.935,"text":"Mo f'ara mi fun O","marked":"Mo f'ara mi fún Ọ"},{"start":19.315,"end":20.704,"text":"Gba ohun gbogbo ti mo ni,","marked":"Gba ohun gbogbo tí mo ní"},{"start":21.084,"end":22.384,"text":"Si f'ara Re fun mi.","marked":"Sì f'ara Rẹ fún mi."}],"end":22.384},{"key":"4","start":23.334,"lines":[{"start":23.334,"end":24.71,"text":"Emi re, Baba, fifun mi,","marked":"Èmi rẹ, Bàbá, fífún mi"},{"start":25.09,"end":26.434,"text":"K'o le ma pelu mi,","marked":"K'ó lè má pẹ̀lú mi"},{"start":26.814,"end":28.218,"text":"K'o se imole ese mi,","marked":"K'ó ṣe ìmọ́lẹ̀̀ ẹsẹ̀ mi"},{"start":28.598,"end":30.057,"text":"S'isimi ailopin.","marked":"S'isimi àìlópin."},{"start":30.437,"end":31.021,"text":"Amin.","marked":"Àmín."}],"end":31.021}]}