{"v":1,"coll":"y","num":46,"id":"hymn_46","title":"GB'ADURA wa, Oba aiye","duration":47.807,"voices":{"male":{"file":"y-46-male.m4a","bytes":348475,"sha256":"c3c0be196870955564e8b2e892e6b8a2e4b0b470378e585af57893f1c09742cd","duration":47.9},"female":{"file":"y-46-female.m4a","bytes":360844,"sha256":"ff615cf7f18c17c3658a403dcb80714bdf7ba7d5dbcc4e856c5c0a46431f236b","duration":47.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.932,"text":"GB'ADURA wa, Oba aiye,","marked":"Gb'àdúrà wa, Ọba aiye"},{"start":3.312,"end":4.286,"text":"'Gbat'a wole fun O","marked":"'Gbat'á wọlé fún Ọ"},{"start":4.666,"end":5.979,"text":"Gbogbo wa nkigbe n'irele","marked":"Gbogbo wa nkìgbẹ́ ń'ìrẹ̀lẹ̀"},{"start":6.359,"end":7.662,"text":"A mbebe fun anu","marked":"A ḿbẹ̀bẹ̀ fún ànú"},{"start":8.042,"end":9.994,"text":"T'iwa l'ebi, tire l'anu","marked":"T'iwa l'ebi, tirẹ̀ l'anu"},{"start":10.374,"end":11.768,"text":"Mase le wa pada,","marked":"Masẹ̀ lè wá padà"},{"start":12.148,"end":13.725,"text":"Sugbon gbo 'gbe wa n'ite Re,","marked":"Ṣùgbọ́n gbọ́ 'gbé wa n'ìtẹ́ Rẹ"},{"start":14.105,"end":15.549,"text":"Ran adura wa Iowa.","marked":"Ran àdúrà wa lọ́wà."}],"end":15.549},{"key":"2","start":16.499,"lines":[{"start":16.499,"end":18.19,"text":"Ese awon baba wa po","marked":"Ẹsẹ̀ àwọn bàbá wa pọ̀"},{"start":18.57,"end":19.643,"text":"Tiwa ko si kere,","marked":"Tiwa kò sì kéré"},{"start":20.023,"end":21.409,"text":"Sugbon lati irandiran","marked":"Ṣùgbọ́n láti ìrandíran"},{"start":21.789,"end":22.968,"text":"Lo ti f'ore Re han","marked":"Lo ti f'ọ̀rẹ́ Rẹ hàn"},{"start":23.348,"end":25.107,"text":"Nigba ewu, b'omi jija","marked":"Nígbà ewu, b'omi jíjà"},{"start":25.487,"end":26.834,"text":"Yi ilu wa yi ka","marked":"Yí ìlú wa yí ká"},{"start":27.214,"end":28.949,"text":"lwo la nwo ta si nkepe","marked":"lwo la ńwò ta sì nkepe"},{"start":29.329,"end":30.511,"text":"K'a ma r'iranwo Re.","marked":"K'á ma r'ìrànwọ́ Rẹ."}],"end":30.511},{"key":"3","start":31.461,"lines":[{"start":31.461,"end":32.902,"text":"L'ohun kan gbogbo wa wole","marked":"L'ohun kan gbogbo wa wọ́lẹ̀"},{"start":33.282,"end":34.236,"text":"L'abe iyonu Re,","marked":"L'abẹ́ ìyọnu Rẹ"},{"start":34.616,"end":36.462,"text":"Gbogbo wa njewo ese wa,","marked":"Gbogbo wa ǹjẹ́wọ́ ẹ̀ṣẹ̀ wa"},{"start":36.842,"end":38.133,"text":"A ngbawe fun 'Ie wa","marked":"A ńgbàwé fún 'lè wà"},{"start":38.513,"end":40.286,"text":"F'oju anu wo aini wa,","marked":"F'ojú ànú wo àìní wa"},{"start":40.666,"end":41.867,"text":"Bi a ti nkepe O!","marked":"Bí a ti ǹkẹpẹ̀ O!"},{"start":42.247,"end":43.548,"text":"Ma fi 'dajo Re ba wa wi,","marked":"Má fi 'dájọ́ Rẹ bá wa wí"},{"start":43.928,"end":45.187,"text":"Da wa si lanu Re.","marked":"Dá wa sí lanu Rẹ."},{"start":45.567,"end":46.257,"text":"Amin.","marked":"Àmín."}],"end":46.257}]}