{"v":1,"coll":"y","num":177,"id":"hymn_177","title":"IJO ti nduro pe","duration":66.408,"voices":{"male":{"file":"y-177-male.m4a","bytes":486494,"sha256":"8d583c2a81ed17507a579489e4b7570a176be9a77086548544bac668aea99ce4","duration":66.5},"female":{"file":"y-177-female.m4a","bytes":507172,"sha256":"401c7d9b250bb2f2804eab33e7b68f82ceb0402d4024a6ebb5ae21e72af00b58","duration":66.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.373,"text":"IJO ti nduro pe","marked":"Ìjọ ti ńdúró pé"},{"start":1.753,"end":2.802,"text":"Lati ri Oluwa","marked":"Láti rí Olúwa"},{"start":3.182,"end":4.633,"text":"O si wa bakan na sibe","marked":"Ó sì wá bákan ná síbẹ̀"},{"start":5.013,"end":6.268,"text":"Ko s'alabaro fun","marked":"Kò s'alabaro fún"},{"start":6.648,"end":8.069,"text":"Odun nyi lu odun","marked":"Ọdún nyi lu ọdún"},{"start":8.449,"end":9.595,"text":"Ojo ngori ojo","marked":"Ọjọ́ ngori ọjọ́"},{"start":9.975,"end":11.679,"text":"Sibe lairi Oluwa re","marked":"Síbẹ̀ láìrí Olúwa rẹ̀"},{"start":12.059,"end":13.167,"text":"O wa ninu ofo","marked":"Ó wà nínú ọ̀fọ̀"},{"start":13.547,"end":15.003,"text":"Ma bo, Jesu ma bo!","marked":"Má bọ̀, Jésù mà bó!"}],"end":15.003},{"key":"2","start":15.953,"lines":[{"start":15.953,"end":17.125,"text":"Awon mimo l'aiye","marked":"Àwọn mímọ́́ l'aiye"},{"start":17.505,"end":18.699,"text":"Opo won l'oti ku","marked":"Ọ̀pọ̀ wọn l'ótì kú"},{"start":19.079,"end":21.198,"text":"Bi won si ti nlo l'okankan","marked":"Bí wọ́n sì ti ńlọ l'ọ̀kankan"},{"start":21.578,"end":22.947,"text":"L'a te won gbe 'ra won","marked":"L'á tẹ̀ wọ́n gbé 'ra wọn"},{"start":23.327,"end":24.435,"text":"A te won lati sun","marked":"A tẹ̀ wọ́n láti sùn"},{"start":24.815,"end":25.853,"text":"Ki se ainireti","marked":"Kí ṣe àìnírètí"},{"start":26.233,"end":27.943,"text":"A te won lati r'eju ni","marked":"A tẹ̀ wọ́n láti r'ẹ́jù ni"},{"start":28.323,"end":29.362,"text":"K'ile ogo to mo","marked":"K'ílé ògo tó mọ́"},{"start":29.742,"end":31.378,"text":"Ma bo, Jesu mabo!","marked":"Má bọ̀, Jésù màbo!"}],"end":31.378},{"key":"3","start":32.328,"lines":[{"start":32.328,"end":33.365,"text":"Awon ola npo si","marked":"Àwọn ọlá ńpọ̀ sí"},{"start":33.745,"end":34.936,"text":"Abgara esu nga","marked":"Abgara èṣù nga"},{"start":35.316,"end":37.258,"text":"Ogun ngbona, igbagbo nku","marked":"Ogun ńgbóná, ìgbàgbọ́́ ńkú"},{"start":37.638,"end":39.215,"text":"lfe si di tutu","marked":"lfe sì di tútù"},{"start":39.595,"end":41.003,"text":"Y'o ti pe to Baba","marked":"Y'ó ti pẹ́ tó Bàbá"},{"start":41.383,"end":42.3,"text":"Oloto Olore","marked":"Olótó Ọlọ́rẹ́"},{"start":42.68,"end":44.163,"text":"Wo ki y'o koya omije","marked":"Wò kí y'ó kóyà omijé"},{"start":44.543,"end":45.652,"text":"At'eje Ijo Re","marked":"Àt'ẹ̀jẹ̀ Ìjọ Rẹ"},{"start":46.032,"end":47.544,"text":"Ma bo Jesu ma bo!","marked":"Má bo Jésù mà bọ́!"}],"end":47.544},{"key":"4","start":48.494,"lines":[{"start":48.494,"end":49.716,"text":"A nfe gbo ohun Re","marked":"A ńfẹ́ gbọ́ ohùn Rẹ̀"},{"start":50.096,"end":51.346,"text":"A nfe f'oju kan O","marked":"A ńfẹ́ f'ojú kan O"},{"start":51.726,"end":53.41,"text":"K'a le gba ade at' ogo","marked":"K'á lè gba adé àt' ògo"},{"start":53.79,"end":55.112,"text":"B'a ti ngha ore Re","marked":"B'á ti ngha ọ̀rẹ́ Rẹ"},{"start":55.492,"end":56.847,"text":"Jo, wa m'ese kuro","marked":"Jó, wá ḿ'ẹsẹ̀ kúrò"},{"start":57.227,"end":58.706,"text":"A t'egun at'eri","marked":"A t'ègùn àt'ẹ̀rí"},{"start":59.086,"end":60.588,"text":"K'o si so aye osi yi","marked":"K'ó sì sọ ayé òsì yí"},{"start":60.968,"end":62.011,"text":"D'aye rere Tire","marked":"D'áyé rere Tírè"},{"start":62.391,"end":63.865,"text":"Ma bo, Jesu ma bo.","marked":"Má bọ̀, Jésù má bọ̀."},{"start":64.245,"end":64.858,"text":"Amin.","marked":"Àmín."}],"end":64.858}]}