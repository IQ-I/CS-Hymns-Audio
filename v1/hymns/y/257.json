{"v":1,"coll":"y","num":257,"id":"hymn_257","title":"JESU, nigba 'danwo","duration":53.333,"voices":{"male":{"file":"y-257-male.m4a","bytes":378624,"sha256":"ac1bb337f9adc4f251c4d7149982d8e2e6ffeff17b34a23f4247dd296bdfcd84","duration":53.4},"female":{"file":"y-257-female.m4a","bytes":394466,"sha256":"3c0babd0661e30fa98e219d3830e8ee03b474aef86d39af2c4fdad253931fec6","duration":53.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.986,"text":"JESU, nigba 'danwo","marked":"Jésù, nígbà 'dánwò"},{"start":2.366,"end":3.321,"text":"Gbadura fun mi","marked":"Gbàdúrà fún mi"},{"start":3.701,"end":4.964,"text":"K'emi ma ba se O","marked":"K'ẹ̀mí má bá ṣe Ọ́"},{"start":5.344,"end":6.315,"text":"Ki nsi sako lo","marked":"Kí ńsì ṣáko lọ"},{"start":6.695,"end":8.115,"text":"Gba mba siyemeji","marked":"Gba ḿbá ṣiyèméjì"},{"start":8.495,"end":9.535,"text":"K'O bojuwo mi","marked":"K'ó bojúwò mi"},{"start":9.915,"end":11.13,"text":"K'eru tab'isaju","marked":"K'ẹ̀rù tab'ìṣájú"},{"start":11.51,"end":12.421,"text":"Ma mu mi subu.","marked":"Má mú mi ṣubú."}],"end":12.421},{"key":"2","start":13.371,"lines":[{"start":13.371,"end":14.668,"text":"B'aiye ba si nfa mi","marked":"B'aiye bá sì ńfà mi"},{"start":15.048,"end":15.97,"text":"Pelu adun re","marked":"Pẹ̀lú adùn rẹ̀"},{"start":16.35,"end":17.478,"text":"T'Ohun 'sura aiye","marked":"T'Ohun 'ṣúra aiye"},{"start":17.858,"end":18.979,"text":"Fe han mi l'emo","marked":"Fẹ́ hàn mí l'èmọ̀"},{"start":19.359,"end":20.657,"text":"Jo mu Getsemane","marked":"Jọ mú Getsemane"},{"start":21.037,"end":22.173,"text":"Wa s'iranti mi","marked":"Wá s'írántí mi"},{"start":22.553,"end":23.465,"text":"Tabi irora Re,","marked":"Tàbí ìrora Rẹ"},{"start":23.845,"end":25.085,"text":"loke Kalfari.","marked":"lókè Kalfárì."}],"end":25.085},{"key":"3","start":26.035,"lines":[{"start":26.035,"end":27.328,"text":"B'O ba pon mi loju","marked":"B'ó bá pọ́n mi lójú"},{"start":27.708,"end":28.606,"text":"Ninu ife Re","marked":"Nínú ìfẹ́ Rẹ"},{"start":28.986,"end":30.267,"text":"Da ibukun Re Ie","marked":"Dá ìbùkún Rẹ lé"},{"start":30.647,"end":31.484,"text":"Ori ebo na","marked":"Orí ẹbọ ná"},{"start":31.864,"end":33.054,"text":"Ki nf'ara mi fun O","marked":"Kí nf'ara mi fún Ọ"},{"start":33.434,"end":34.41,"text":"Lori pepe Re","marked":"Lórí pẹpẹ Rẹ"},{"start":34.79,"end":36.103,"text":"B'ara ko ago na","marked":"B'ara kọ́ àgọ́ ná"},{"start":36.483,"end":37.511,"text":"Igbagbo y'o mu.","marked":"Ìgbàgbọ́́ y'ó mú."}],"end":37.511},{"key":"4","start":38.461,"lines":[{"start":38.461,"end":39.929,"text":"'Gba mo ba nre 'boji","marked":"'Gbà mo bá ńrẹ́ 'bojì"},{"start":40.309,"end":41.423,"text":"Sinu ekuru","marked":"Sínú ekuru"},{"start":41.803,"end":43.088,"text":"T'ogo orun si nko","marked":"T'ògò ọ̀run sì ńkọ́"},{"start":43.468,"end":44.385,"text":"Leti bebe na","marked":"Létí bẹbẹ ná"},{"start":44.765,"end":45.966,"text":"Ngo gbekel'oto Re","marked":"Ngo gbekel'oto Rẹ"},{"start":46.346,"end":47.411,"text":"N'ijakadi 'ku","marked":"N'ìjàkadì 'kù"},{"start":47.791,"end":48.948,"text":"Oluwa, gb'emi mi","marked":"Olúwa, gb'èmi mi"},{"start":49.328,"end":50.781,"text":"S'iye ailopin.","marked":"S'iye àìlópin."},{"start":51.161,"end":51.783,"text":"Amin.","marked":"Àmín."}],"end":51.783}]}