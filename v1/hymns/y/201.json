{"v":1,"coll":"y","num":201,"id":"hymn_201","title":"WA, enyin oloto","duration":45.655,"voices":{"male":{"file":"y-201-male.m4a","bytes":322569,"sha256":"9ded9c5f1c52ce56cb4553f31d9749c896cfba76bd2ad54987ebd27abaca9303","duration":45.7},"female":{"file":"y-201-female.m4a","bytes":339648,"sha256":"cc56c493ea77de1352477926fde4bb76a5810a100ed1dff89455ded1c69f7c86","duration":45.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.403,"text":"WA, enyin oloto,","marked":"Wá, enyin ọlọ́tọ̀"},{"start":1.783,"end":3.449,"text":"L'a yo at'isegun,","marked":"L'á yọ àt'ìṣègùn"},{"start":3.829,"end":6.195,"text":"Wa k'a lo, wa ka lo si Betlehem,","marked":"Wá k'á lọ, wá ká lọ sí Betlehem"},{"start":6.575,"end":7.548,"text":"Wa ka lo wo O!","marked":"Wá ká lọ wò Ó!"},{"start":7.928,"end":9.321,"text":"Oba awon Angel.","marked":"Ọba àwọn Angel."}],"end":9.321},{"key":"CHORUS","start":10.271,"lines":[{"start":10.271,"end":11.54,"text":"E wa ka lo juba Re,","marked":"Ẹ wá ká lọ júbà Rẹ̀"},{"start":11.92,"end":13.179,"text":"E wa ka lo juba Re,","marked":"Ẹ wá ká lọ júbà Rẹ̀"},{"start":13.559,"end":14.854,"text":"E wa k' a lo juba","marked":"Ẹ wá k' á lọ júbà"},{"start":15.234,"end":16.324,"text":"Kristi Oluwa.","marked":"Kristi Olúwa."}],"end":16.324},{"key":"2","start":17.274,"lines":[{"start":17.274,"end":18.331,"text":"Olodumare ni,","marked":"Olódùmarè ni"},{"start":18.711,"end":19.706,"text":"Imole Ododo,","marked":"Ìmọ́lẹ̀̀ Òdodo"},{"start":20.086,"end":21.611,"text":"Ko si korira inu Wundia;","marked":"Kò sì kóríra inú Wúńdíá"},{"start":21.991,"end":23.057,"text":"Olorun papa ni,","marked":"Ọlọ́run pàpà ni"},{"start":23.437,"end":25.43,"text":"Ti a bi, t'a ko da.","marked":"Tí a bí, t'á kò dà."}],"end":25.43},{"key":"3","start":26.38,"lines":[{"start":26.38,"end":28.12,"text":"Angeli, e korin,","marked":"Áńgẹ́lì, ẹ kọrin"},{"start":28.5,"end":29.651,"text":"Korin itoye Re;","marked":"Kọrin ìtóye Rẹ"},{"start":30.031,"end":31.697,"text":"Ki gbogbo eda orun si gberin:","marked":"Kí gbogbo ẹ̀dá ọ̀run sì gbẹ̀rín"},{"start":32.077,"end":33.227,"text":"Ogo f' Olorun","marked":"Ògo f' Ọlọ́run"},{"start":33.607,"end":34.741,"text":"L'oke orun l'ohun:","marked":"L'òkè ọ̀run l'ọ́hun"}],"end":34.741},{"key":"4","start":35.691,"lines":[{"start":35.691,"end":37.135,"text":"Nitoto, a wole,","marked":"Nítoto, a wọlé"},{"start":37.515,"end":38.915,"text":"F'Oba t' a bi loni:","marked":"F'Ọba t' a bí lónì"},{"start":39.295,"end":41.378,"text":"Jesu iwo li awa nfi ogo fun,","marked":"Jésù ìwo li àwa nfi ògo fún"},{"start":41.758,"end":42.557,"text":"'Wo Omo baba,","marked":"'Wo Ọmọ bàbá"},{"start":42.937,"end":44.105,"text":"T'o gbe ara wa wo!","marked":"T'ó gbé ara wa wọ̀!"}],"end":44.105}]}