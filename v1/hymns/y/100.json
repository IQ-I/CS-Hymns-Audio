{"v":1,"coll":"y","num":100,"id":"hymn_100","title":"EMI Baba Alaye","duration":51.009,"voices":{"male":{"file":"y-100-male.m4a","bytes":361921,"sha256":"36256621e6298cb86e8b451f7a0b5575b043f548565ab54401195b8ddc3413a7","duration":51.1},"female":{"file":"y-100-female.m4a","bytes":382502,"sha256":"5c482fd07643e1cb6bb0e9f97abe97ba8b061a28b43e8fccf388a75a5070171d","duration":51.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.757,"text":"EMI Baba Alaye","marked":"Ẹ̀mí Bàbá Àlàyé"},{"start":2.137,"end":3.221,"text":"Sokale pelu","marked":"Sọ̀kalẹ̀ pẹ̀lú"},{"start":3.601,"end":5.035,"text":"Agbara Pentikosti","marked":"Agbára Pentikosti"},{"start":5.415,"end":6.443,"text":"So okan wa ji","marked":"Sọ ọkàn wa jì"},{"start":6.823,"end":7.884,"text":"Ki O si mu gbona","marked":"Kí Ó sì mú gbóná"},{"start":8.264,"end":9.37,"text":"B'ina orun nla","marked":"B'íná ọrùn ńlá"},{"start":9.75,"end":10.896,"text":"Pelu 'tunu nla","marked":"Pẹ̀lú 'tùnú ńlá"},{"start":11.276,"end":12.126,"text":"Tan 'mole re.","marked":"Tàn 'mọ́lẹ̀ rẹ."}],"end":12.126},{"key":"2","start":13.076,"lines":[{"start":13.076,"end":14.354,"text":"Aye ati emi wa","marked":"Ayé àti ẹ̀mí wa"},{"start":14.734,"end":15.924,"text":"Gba, fi se Tire","marked":"Gbà, fi ṣe Tìrẹ"},{"start":16.304,"end":17.58,"text":"Ninu isin wa fun O","marked":"Nínú ìsìn wa fún Ọ"},{"start":17.96,"end":18.881,"text":"Ka ni 'ranwo Re","marked":"Ká ní 'rànwọ́ Rẹ"},{"start":19.261,"end":20.572,"text":"Lati j'olotito","marked":"Láti j'ọlọ́tìtọ́"},{"start":20.952,"end":22.028,"text":"K'ebun at'orun","marked":"K'ẹ̀bùn àt'ọrun"},{"start":22.408,"end":23.543,"text":"Ti Pentikosti","marked":"Ti Pentikosti"},{"start":23.923,"end":25.002,"text":"Ba s'ori wa.","marked":"Bá s'orí wa."}],"end":25.002},{"key":"3","start":25.952,"lines":[{"start":25.952,"end":27.111,"text":"Fi eje 'yebiye Re","marked":"Fi ẹ̀jẹ̀ 'yebíye Rẹ"},{"start":27.491,"end":28.372,"text":"T'oke Kalfari","marked":"T'òkè Kalfárì"},{"start":28.752,"end":29.976,"text":"We okan ese wa nu","marked":"Wé ọkàn ẹsẹ̀ wa nù"},{"start":30.356,"end":31.395,"text":"Si ra wa pada","marked":"Sì rà wá padà"},{"start":31.775,"end":33.041,"text":"Fi 'fe kun aya wa","marked":"Fi 'fẹ́ kún aya wa"},{"start":33.421,"end":34.355,"text":"Ka rin 'na oto","marked":"Ká rìn 'ná ọ̀tọ̀"},{"start":34.735,"end":35.7,"text":"lfe Re lao se","marked":"lfẹ́ Rẹ̀ láó ṣe"},{"start":36.08,"end":37.066,"text":"Bi ti orun.","marked":"Bí ti ọ̀run."}],"end":37.066},{"key":"4","start":38.016,"lines":[{"start":38.016,"end":39.639,"text":"Baba, Omo on Emi","marked":"Bàbá, Ọmọ ọn Ẹ̀mí"},{"start":40.019,"end":40.985,"text":"Metalokan lae","marked":"Mẹ́talọ́kan láé"},{"start":41.365,"end":43.12,"text":"lyin, Ogo, agbara","marked":"lyin, Ògo, agbára"},{"start":43.5,"end":44.45,"text":"Je Tire nikan","marked":"Jẹ́ Tírè nìkan"},{"start":44.83,"end":45.852,"text":"Ewa Re l'aye yi","marked":"Ẹwà Rẹ l'áyé yí"},{"start":46.232,"end":47.305,"text":"Yo je ayo wa","marked":"Yọ́ jẹ́ ayọ̀ wa"},{"start":47.685,"end":48.433,"text":"Pelu idupe","marked":"Pẹ̀lú ìdúpẹ́"},{"start":48.813,"end":49.459,"text":"Aleluya!","marked":"Alelúyà!"}],"end":49.459}]}