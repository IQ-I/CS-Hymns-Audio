{"v":1,"coll":"y","num":169,"id":"hymn_169","title":"OLUWA awa omo Re tun de","duration":60.389,"voices":{"male":{"file":"y-169-male.m4a","bytes":435531,"sha256":"febfde4eff659b756fa285708cc1eee229e4743cd0f2e8a34988092e4ce7dcaf","duration":60.4},"female":{"file":"y-169-female.m4a","bytes":450277,"sha256":"e57f957ae22440947ed6e9f4153b48a7a0866b6e6d506eda55896c4bcbbd37b8","duration":60.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.839,"text":"OLUWA awa omo Re tun de","marked":"Olúwa àwa ọmọ Rẹ tún dé"},{"start":2.219,"end":3.506,"text":"Lati wa anu re.","marked":"Láti wá ànú rẹ."},{"start":3.886,"end":5.639,"text":"Ni ajodun isin Ikore wa,","marked":"Ní àjọ̀dún ìsìn Ìkórè wa"},{"start":6.019,"end":7.359,"text":"Masai senu fun wa.","marked":"Masai ṣẹnu fún wa."}],"end":7.359},{"key":"CHORUS","start":8.309,"lines":[{"start":8.309,"end":10.814,"text":"Anu! Anu! Anu la nfe","marked":"Ànú! Ànú! Ànú là ńfẹ́"},{"start":11.194,"end":11.876,"text":"Iowo Re","marked":"lọ́wọ́ Rẹ̀"},{"start":12.256,"end":13.12,"text":"Baba wa orun","marked":"Bàbá wa ọ̀run"},{"start":13.5,"end":15.273,"text":"Jo si ferese Orun Re loni","marked":"Jọ sí fèrèsé Ọ̀run Rẹ lónì"},{"start":15.653,"end":16.869,"text":"Rojo anu le wa.","marked":"Rọ́jọ́ anu lè wà."}],"end":16.869},{"key":"2","start":17.819,"lines":[{"start":17.819,"end":19.522,"text":"Jesu Oluwa l'ojo aiye Re","marked":"Jésù Olúwa l'ọjọ́ aiye Rẹ"},{"start":19.902,"end":21.122,"text":"Oba 'lanu ni O","marked":"Ọba 'lanu ni O"},{"start":21.502,"end":23.209,"text":"Awon adete ati afoju","marked":"Àwọn adẹ́tẹ̀ àti afọ́jú"},{"start":23.589,"end":24.741,"text":"R'anu gba lowo Re","marked":"R'ánú gbà lọ́wọ́ Rẹ"}],"end":24.741},{"key":"3","start":25.691,"lines":[{"start":25.691,"end":27.897,"text":"Lodun yi, Oluwa awa mbe o","marked":"Lọ́dún yí, Olúwa àwa ḿbẹ o"},{"start":28.277,"end":29.458,"text":"Ma jek' ise won wa","marked":"Má jẹ́k' iṣẹ́ wọn wa"},{"start":29.838,"end":32.085,"text":"K'O si je k'a s'owo b'ode p'ade","marked":"K'ó sì jẹ́ k'á ṣ'ọwọ́ b'ọdẹ p'áde"},{"start":32.465,"end":33.699,"text":"K'ara de gbogbo wa.","marked":"K'ára dé gbogbo wa."}],"end":33.699},{"key":"4","start":34.649,"lines":[{"start":34.649,"end":37.301,"text":"Mase je ki esu ri wa gbe se","marked":"Masẹ̀ jẹ́ kí èṣù rí wa gbé ṣe"},{"start":37.681,"end":39.16,"text":"Ni gbogb' ojo aiye wa;","marked":"Ní gbogb' ọjọ́ aiye wa"},{"start":39.54,"end":41.671,"text":"Ko si ti 'lekun iku at'arun","marked":"Kò sì ti 'lẹ́kùn ikú àt'àrùn"},{"start":42.051,"end":43.389,"text":"Mu wa di amodun.","marked":"Mú wa di àmọ̀dún."}],"end":43.389},{"key":"5","start":44.339,"lines":[{"start":44.339,"end":45.812,"text":"Oluwa, dari ese wa ji wa","marked":"Olúwa, dárí ẹ̀ṣẹ̀ wa jì wá"},{"start":46.192,"end":47.235,"text":"T'a fi bi O ninu","marked":"T'á fi bí Ọ nínú"},{"start":47.615,"end":49.039,"text":"Jo se ayipada rere fun wa","marked":"Jọ ṣe àyípadà rere fún wa"},{"start":49.419,"end":50.752,"text":"K'a le ma je Tire.","marked":"K'á lè má jẹ́ Tírè."}],"end":50.752},{"key":"6","start":51.702,"lines":[{"start":51.702,"end":53.81,"text":"Nigbat'ikore aiye ba pari","marked":"Nígbat'ìkórè aiye bá parí"},{"start":54.19,"end":55.367,"text":"T'a ko awa na jo","marked":"T'á kó àwa ná jọ"},{"start":55.747,"end":57.309,"text":"B'ikore sinu aba Re orun","marked":"B'íkórè sínú abà Rẹ ọ̀run"},{"start":57.689,"end":58.839,"text":"F' anu tewogba wa.","marked":"F' anu tẹ́wọ́gbà wà."}],"end":58.839}]}