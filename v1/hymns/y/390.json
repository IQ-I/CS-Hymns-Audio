{"v":1,"coll":"y","num":390,"id":"hymn_390","title":"E fi ogo fun baba","duration":31.028,"voices":{"male":{"file":"y-390-male.m4a","bytes":209373,"sha256":"e6f47c274b6fa4ffd1d2bc739a7b68e98affc91a8f3bb79cad060e53a16d7291","duration":31.1},"female":{"file":"y-390-female.m4a","bytes":220090,"sha256":"a8ecb09725354af5f348e97eafee493e0e1b33593b5831f1d9a7189ac87a1318","duration":31.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.154,"text":"E fi ogo fun baba","marked":"Ẹ fi ògo fún bàbá"},{"start":1.534,"end":2.735,"text":"Nipa Eniti a wa","marked":"Nípa Éniti á wá"},{"start":3.115,"end":4.161,"text":"O ngbo adura wa","marked":"Ó ńgbọ́ àdúrà wa"},{"start":4.541,"end":6.029,"text":"O nf'eti si orin won.","marked":"Ó ńf'etí sí orin wọn."}],"end":6.029},{"key":"2","start":6.979,"lines":[{"start":6.979,"end":8.135,"text":"E fi ego fun Omo","marked":"Ẹ fi ẹ̀gò fún Ọmọ"},{"start":8.515,"end":10.556,"text":"Kristi, 'Wo ni Oba wa","marked":"Kristi, 'Wò ni Ọba wa"},{"start":10.936,"end":12.263,"text":"E wa e korin s'oke","marked":"Ẹ wá ẹ kọrin s'oke"},{"start":12.643,"end":14.076,"text":"S'Odaguntan elese.","marked":"S'Ọ̀dàgùntàn ẹlẹ́ṣẹ̀."}],"end":14.076},{"key":"3","start":15.026,"lines":[{"start":15.026,"end":16.085,"text":"Ogo fun Emi Mimo","marked":"Ògo fún Ẹ̀mí Mímọ́́"},{"start":16.465,"end":17.951,"text":"Bi ojo Pentikosti","marked":"Bí ọjọ́ Pentikosti"},{"start":18.331,"end":19.55,"text":"Ru aiya awon ewe","marked":"Rú àìyá àwọn èwe"},{"start":19.93,"end":21.683,"text":"F'orin mimo s'ete won.","marked":"F'orin mímọ́́ s'eté wọn."}],"end":21.683},{"key":"4","start":22.633,"lines":[{"start":22.633,"end":23.924,"text":"Ogo ni l'oke orun","marked":"Ògo ni l'òkè ọ̀run"},{"start":24.304,"end":25.517,"text":"Fun Eni Metalokan","marked":"Fún Ẹni Mẹ́talọ́kan"},{"start":25.897,"end":26.924,"text":"Nitori ihin rere","marked":"Nítorí ìhìn rere"},{"start":27.304,"end":28.595,"text":"Ati ife Olorun.","marked":"Àti ìfẹ́ Ọlọ́run."},{"start":28.975,"end":29.478,"text":"Amin.","marked":"Àmín."}],"end":29.478}]}