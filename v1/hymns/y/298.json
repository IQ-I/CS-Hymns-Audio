{"v":1,"coll":"y","num":298,"id":"hymn_298","title":"WAKATI didun ni fun mi","duration":38.993,"voices":{"male":{"file":"y-298-male.m4a","bytes":274301,"sha256":"7746fad9ad450b513a4dff26a136dea53e0cd05a792cc991bfc19ccf49ae02fa","duration":39.0},"female":{"file":"y-298-female.m4a","bytes":284139,"sha256":"a302365a2a5d7090af1637ec1094994c3e4b3af05eddb338574ec8e48da62d31","duration":38.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.731,"text":"WAKATI didun ni fun mi","marked":"Wákàtí dídùn ni fún mi"},{"start":2.111,"end":3.379,"text":"Ni wiwo agbelebu","marked":"Ní wíwo àgbélébùú"},{"start":3.759,"end":5.23,"text":"Nibe Jesu fun mi n'iye","marked":"Níbẹ̀ Jésù fún mi n'ìyè"},{"start":5.61,"end":7.193,"text":"'Lera at'alafia.","marked":"'Léra at'àlàáfíà."}],"end":7.193},{"key":"2","start":8.143,"lines":[{"start":8.143,"end":9.313,"text":"Nihin l'emi o gbe joko","marked":"Nihin l'èmí ò gbé jóko"},{"start":9.693,"end":11.226,"text":"Lati wo isun eje","marked":"Láti wo ìsun ẹ̀jẹ̀"},{"start":11.606,"end":13.119,"text":"Eyiti y'o we okan mi","marked":"Èyítí y'ó wé ọkàn mi"},{"start":13.499,"end":14.763,"text":"K'Olorun ba le gba mi.","marked":"K'Ọlọ́run bá lè gbà mí."}],"end":14.763},{"key":"3","start":15.713,"lines":[{"start":15.713,"end":17.026,"text":"Niwaju agbelebu Re","marked":"Níwájú àgbélébùú Rẹ"},{"start":17.406,"end":18.677,"text":"L'emi o ba buruburu","marked":"L'èmi ò bá burúburú"},{"start":19.057,"end":20.559,"text":"'Gbati emi bari 'yonu nla","marked":"'Gbàtì èmi bárí 'yọnu ńlá"},{"start":20.939,"end":22.226,"text":"T'o farahan loju Re.","marked":"T'ó farahàn lójú Rẹ̀."}],"end":22.226},{"key":"4","start":23.176,"lines":[{"start":23.176,"end":24.526,"text":"lfe ati omije mi","marked":"lfe ati omije mi"},{"start":24.906,"end":26.27,"text":"Ni ngo fi we ese re","marked":"Ní ngo fi wé ẹsẹ̀ rẹ"},{"start":26.65,"end":27.871,"text":"Tori mo mo pe iku Re","marked":"Torí mo mọ̀ pé ikú Rẹ̀"},{"start":28.251,"end":29.505,"text":"Y'o mu iye wa fun mi.","marked":"Y'ó mú iye wá fún mi."}],"end":29.505},{"key":"5","start":30.455,"lines":[{"start":30.455,"end":31.955,"text":"Oluwa, jo gba ebe mi,","marked":"Olúwa, jọ gba ẹ̀bẹ̀ mi"},{"start":32.335,"end":33.648,"text":"Se okan mi ni Tire","marked":"Ṣe ọkàn mi ní Tìrẹ"},{"start":34.028,"end":35.668,"text":"Tit' emi o fi ri 'gbala","marked":"Tit' emi ò fi rí 'gbàlà"},{"start":36.048,"end":37.444,"text":"At'oju Re n'nu ogo.","marked":"Àt'ojú Rẹ̀ ń'nú ògo."}],"end":37.444}]}