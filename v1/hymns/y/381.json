{"v":1,"coll":"y","num":381,"id":"hymn_381","title":"ADABA orun sokale","duration":33.165,"voices":{"male":{"file":"y-381-male.m4a","bytes":234578,"sha256":"d1dca51f7ef5a120e9dcd93b6ec32b03ead1651e985b43a76d7fbde896d2dc48","duration":33.2},"female":{"file":"y-381-female.m4a","bytes":244122,"sha256":"b40105750c7cd84f27234d16496c2b258576e951a85c70e183244e8457db4273","duration":33.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.499,"text":"ADABA orun sokale","marked":"Àdàbà ọ̀run sọ̀kalẹ̀"},{"start":1.879,"end":3.527,"text":"Gbe wa lo l'apa iye Re","marked":"Gbé wa lọ l'apá iye Rẹ"},{"start":3.907,"end":5.29,"text":"Ki o si gbe a wa ga soke","marked":"Kí o sì gbé a wá ga sókè"},{"start":5.67,"end":7.211,"text":"Ju gbogbo ohun aiye lo.","marked":"Ju gbogbo ohun aiye lọ."}],"end":7.211},{"key":"2","start":8.161,"lines":[{"start":8.161,"end":9.324,"text":"Awa iba le ri ite","marked":"Àwa ibà lè rí ìtẹ́"},{"start":9.704,"end":11.079,"text":"Olodumare Baba wa","marked":"Olódùmarè Bàbá wa"},{"start":11.459,"end":12.933,"text":"Olugbala joko nibe","marked":"Olùgbàlà jókò níbẹ̀"},{"start":13.313,"end":15.04,"text":"O gunwa l'awo bi tiwa.","marked":"Ó gúnwà l'áwò bí tiwa."}],"end":15.04},{"key":"3","start":15.99,"lines":[{"start":15.99,"end":17.366,"text":"Egbe mimo duro yi ka","marked":"Ẹgbẹ́ mímọ́́ dúró yí ká"},{"start":17.746,"end":19.114,"text":"lte Agbara wole fun","marked":"lté Agbára wọlé fún"},{"start":19.494,"end":20.761,"text":"Olorun han ninu ara","marked":"Ọlọ́run hàn nínú ara"},{"start":21.141,"end":22.794,"text":"O si tan ogo yi won ka.","marked":"Ó sì tan ògo yí wọn ká."}],"end":22.794},{"key":"4","start":23.744,"lines":[{"start":23.744,"end":25.233,"text":"Oluwa, akoko wo ni","marked":"Olúwa, àkókò wo ni"},{"start":25.613,"end":27.032,"text":"Emi o de bugbe won wole","marked":"Èmi ò dẹ́ bùgbé wọn wọ́lẹ̀"},{"start":27.412,"end":28.613,"text":"T'emi o ma ba won wole","marked":"T'èmi ò má bá wọn wọ́lẹ̀"},{"start":28.993,"end":30.693,"text":"Ki nma sin O, ki nma korin?","marked":"Kí ńmá sin O, kí ńmá kọrin?"},{"start":31.073,"end":31.615,"text":"Amin.","marked":"Àmín."}],"end":31.615}]}