{"v":1,"coll":"y","num":80,"id":"hymn_80","title":"OLUWA, emi sa ti gbohun Re,","duration":51.679,"voices":{"male":{"file":"y-80-male.m4a","bytes":372907,"sha256":"3068c8356eb7be67e8c549d06c0508c23843916f1b0b421509e6f9f17445b90e","duration":51.7},"female":{"file":"y-80-female.m4a","bytes":392596,"sha256":"5211f593f7b3c93008e25aa7c5138df1dd21cb880d8173fa0f3d0479fa53f232","duration":51.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.477,"text":"OLUWA, emi sa ti gbohun Re,","marked":"Olúwa, èmi sá ti gbóhùn Rẹ̀"},{"start":2.857,"end":4.256,"text":"O nso ife Re si mi,","marked":"Ó nso ìfẹ́ Rẹ̀ sí mi"},{"start":4.636,"end":6.311,"text":"Sugbon mo fe nde l'apa igbagbo,","marked":"Ṣùgbọ́n mo fẹ́ ńde l'apá ìgbàgbọ́́"},{"start":6.691,"end":8.254,"text":"Ki nle tubo sunmo O.","marked":"Kí ńlẹ̀ túbọ̀ súnmọ́ O."}],"end":8.254},{"key":"CHORUS","start":9.204,"lines":[{"start":9.204,"end":11.169,"text":"Fa mi mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra Olúwa"},{"start":11.549,"end":13.291,"text":"Sib'agbelebu t'Oku,","marked":"Sib'àgbélébùú t'Òkú"},{"start":13.671,"end":16.792,"text":"Fa mi mora, mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra, mọ́ra Olúwa"},{"start":17.172,"end":19.335,"text":"Sib' eje Re t'o n'iye.","marked":"Síb' ẹ̀jẹ̀ Rẹ t'ó ń'ìyẹ́."}],"end":19.335},{"key":"2","start":20.285,"lines":[{"start":20.285,"end":21.977,"text":"Ya mi si mimo fun ise Tire,","marked":"Yà mí sí mímọ́́ fún iṣẹ́ Tírè"},{"start":22.357,"end":23.612,"text":"Nipa Ore-Ofe Re,","marked":"Nípa Ọrẹ-Ọ̀fẹ́ Rẹ"},{"start":23.992,"end":25.801,"text":"Je ki nfi okan igbagbo w'oke","marked":"Jẹ́ kí nfi ọkàn ìgbàgbọ́́ w'òkè"},{"start":26.181,"end":27.422,"text":"K'ife mi te si Tire.","marked":"K'ífẹ́ mi tẹ́ sí Tírè."},{"start":27.802,"end":28.649,"text":"Egbe:  Fa mi mora...","marked":"Fà mí mọ́ra"}],"end":28.649},{"key":"3","start":29.599,"lines":[{"start":29.599,"end":31.968,"text":"A! ayo mimo ti wakati kan,","marked":"A! ayọ̀ mímọ́́ ti wákàtí kan"},{"start":32.348,"end":33.605,"text":"Ti mo lo nib'ite Re","marked":"Tí mo lọ níb'ìtẹ́ Rẹ"},{"start":33.985,"end":35.726,"text":"'Gba mo gbadura si O, Olorun","marked":"'Gbà mo gbàdúrà sí Ọ, Ọlọ́run"},{"start":36.106,"end":37.447,"text":"Ti a soro bi ore.","marked":"Tí a sọ̀rọ̀ bí ọ̀rẹ́."},{"start":37.827,"end":38.531,"text":"Egbe:  Fa mi mora...","marked":"Fà mí mọ́ra"}],"end":38.531},{"key":"4","start":39.481,"lines":[{"start":39.481,"end":41.51,"text":"Ijinle ife mbe ti nko le mo","marked":"Ìjìnlẹ̀ ìfẹ́ ḿbẹ tí ńkọ́ lè mọ́"},{"start":41.89,"end":43.617,"text":"Titi ngo fi koja odo!","marked":"Títí ngo fi kọjá odò!"},{"start":43.997,"end":45.916,"text":"Ayo giga ti emi ko le so,","marked":"Ayọ̀ gíga tí èmi kò lè sọ"},{"start":46.296,"end":47.801,"text":"Titi ngo fi de 'simi.","marked":"Títí ngo fi dé 'simi."},{"start":48.181,"end":49.043,"text":"Egbe:  Fa mi mora...","marked":"Fà mí mọ́ra"},{"start":49.423,"end":50.129,"text":"Amin.","marked":"Àmín."}],"end":50.129}]}