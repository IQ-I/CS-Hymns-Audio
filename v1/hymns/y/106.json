{"v":1,"coll":"y","num":106,"id":"hymn_106","title":"YIN Oluwa, enyin mimo","duration":42.658,"voices":{"male":{"file":"y-106-male.m4a","bytes":301184,"sha256":"41e2ee2b268b4ba88431349c8697a9c1ecd9939847379d99816c975b76483aac","duration":42.7},"female":{"file":"y-106-female.m4a","bytes":309816,"sha256":"68e2f712257149aceb7c694f4014859b19234b4f421fabf4bd7b1c6088018835","duration":42.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.792,"text":"YIN Oluwa, enyin mimo","marked":"Yín Olúwa, ẹnyin mímọ́́"},{"start":2.172,"end":3.649,"text":"Awa ti je ni 'gbese to?","marked":"Àwa ti jẹ́ ní 'gbèsè tó?"},{"start":4.029,"end":5.367,"text":"Je k'a mu gbogbo ini wa","marked":"Jẹ k'á mú gbogbo ìní wá"},{"start":5.747,"end":6.714,"text":"Wa pelu ayo.","marked":"Wà pẹ̀lú ayọ̀."}],"end":6.714},{"key":"2","start":7.664,"lines":[{"start":7.664,"end":9.274,"text":"Jesus l'Oko t'o dara ju","marked":"Jésù l'Oko t'ó dára jù"},{"start":9.654,"end":11.468,"text":"O nfun wa l'okun l'oju 'ja","marked":"Ó ńfun wa l'òkun l'ojú 'jà"},{"start":11.848,"end":13.095,"text":"lbi kan ko le de ba wa","marked":"lbí kan kò lè dé bá wa"},{"start":13.475,"end":14.836,"text":"'Gbat' a gbekele.","marked":"'Gbat' á gbẹ́kẹ̀lé."}],"end":14.836},{"key":"3","start":15.786,"lines":[{"start":15.786,"end":17.736,"text":"Gbekele yin le, eyin mimo","marked":"Gbẹ́kẹ̀lé yín lé, ẹ̀yin mímọ́́"},{"start":18.116,"end":19.401,"text":"Olododo l'Olorun wa","marked":"Olódodo l'Ọlọ́run wa"},{"start":19.781,"end":22.074,"text":"Ko s'ohun to le, ya awon","marked":"Kò s'óhun tó le, ya àwọn"},{"start":22.454,"end":23.798,"text":"T'O fe l'odo Re.","marked":"T'ó fẹ́ l'ọ̀dọ̀ Rẹ."}],"end":23.798},{"key":"4","start":24.748,"lines":[{"start":24.748,"end":26.042,"text":"F'ore ofe Re pa wa mo","marked":"F'ọ̀rẹ́ ọ̀fẹ́ Rẹ pa wá mọ́"},{"start":26.422,"end":27.9,"text":"K'a le tubo faramo O","marked":"K'á lè túbọ̀ faramọ́ O"},{"start":28.28,"end":29.976,"text":"Titi ao fi de 'nu ogo","marked":"Títí aó fi dé 'nu ògo"},{"start":30.356,"end":31.541,"text":"At' ayo l'orun.","marked":"Àt' ayo l'ọrun."}],"end":31.541},{"key":"5","start":32.491,"lines":[{"start":32.491,"end":33.901,"text":"'Gbana l' ao de ibi mimo","marked":"'Gbaná l' àò dé ibi mímọ́́"},{"start":34.281,"end":36.118,"text":"'Gbana l'a o si di mimo","marked":"'Gbaná l'á ó sì di mímọ́́"},{"start":36.498,"end":38.291,"text":"Ayo nla ti a ko so","marked":"Ayọ̀ ńlá tí a kò sọ"},{"start":38.671,"end":40.088,"text":"Ni y'o je ti wa.","marked":"Ni y'ó jẹ́ ti wa."},{"start":40.468,"end":41.108,"text":"Amin.","marked":"Àmín."}],"end":41.108}]}