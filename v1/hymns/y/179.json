{"v":1,"coll":"y","num":179,"id":"hymn_179","title":"LEBA Odo Jordani ni","duration":43.454,"voices":{"male":{"file":"y-179-male.m4a","bytes":312657,"sha256":"847ed504d6ef86880238b07a67ae3390c9f103ab33d5b7bbf8ee0b2f4456936a","duration":43.5},"female":{"file":"y-179-female.m4a","bytes":330974,"sha256":"06d5794104dd9a36d89d17514c18a6f1dd3db3b8368038d6fb88ee67cfbeb6c4","duration":43.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.577,"text":"LEBA Odo Jordani ni,","marked":"Lẹ́bà Odò Jọ́dánì ni"},{"start":1.957,"end":3.697,"text":"Onibaptist nke wipe","marked":"Onibaptist ǹkè wípé"},{"start":4.077,"end":5.785,"text":"Oluwa mbo! Oluwa mbo!","marked":"Olúwa ḿbọ̀! Olúwa mbo!"},{"start":6.165,"end":8.145,"text":"E gbo 'hin ayo: Oba mbo.","marked":"Ẹ gbọ́ 'hin ayò: Ọba ḿbọ́."}],"end":8.145},{"key":"2","start":9.095,"lines":[{"start":9.095,"end":10.728,"text":"K'ese tan ni gbogbo okan","marked":"K'ẹsẹ̀ tán ní gbogbo ọkàn"},{"start":11.108,"end":12.391,"text":"K'olorun ba le ba wa gbe","marked":"K'Ọlọ́run bá lè bá wa gbé"},{"start":12.771,"end":14.208,"text":"K'a pa ile okan wa mo","marked":"K'á pa ilé ọkàn wa mọ́"},{"start":14.588,"end":16.32,"text":"Ki Alejo-nla yi to de.","marked":"Kí Àlejò-ńlá yí tó dé."}],"end":16.32},{"key":"3","start":17.27,"lines":[{"start":17.27,"end":19.415,"text":"Jesu. lwo ni igbala","marked":"Jésù. lwo ni ìgbàlà"},{"start":19.795,"end":21.406,"text":"Esan ati Alabo wa:","marked":"Ẹ̀san àti Àlàbò wa"},{"start":21.786,"end":23.074,"text":"B'itanna l'awa 'ba segbe","marked":"B'itanna l'áwá 'bá ṣègbé"},{"start":23.454,"end":24.849,"text":"Bikose l'ore-ofe Re.","marked":"Bíkọ́ṣẹ́ l'ọ̀rẹ́-ọ̀fẹ́ Rẹ."}],"end":24.849},{"key":"4","start":25.799,"lines":[{"start":25.799,"end":27.422,"text":"S'awotan awon alaisan","marked":"S'àwòtán àwọn aláìsàn"},{"start":27.802,"end":29.563,"text":"Gb'elese to subu dide","marked":"Gb'elese tó ṣubú dìde"},{"start":29.943,"end":31.214,"text":"Tanmole Re ka 'bi gbogbo","marked":"Tànmọ́lẹ̀ Rẹ̀ kà 'bí gbogbo"},{"start":31.594,"end":32.978,"text":"Mu ewa aiye bo s'ipo.","marked":"Mú ẹwà aiye bò s'ipò."}],"end":32.978},{"key":"5","start":33.928,"lines":[{"start":33.928,"end":35.313,"text":"K'a f'iyin f'Omo Olorun","marked":"K'á f'ìyìn f'Ọmọ Ọlọ́run"},{"start":35.693,"end":37.196,"text":"Bibo Eni mu 'dande wa;","marked":"Bíbọ Ẹni mú 'dáǹdè wá"},{"start":37.576,"end":39.418,"text":"Enit' a sin pelu Baba","marked":"Enit' á sìn pẹ̀lú Bàbá"},{"start":39.798,"end":41.073,"text":"At'Olorun Emi Mimo.","marked":"Àt'Ọlọ́run Ẹ̀mí Mímọ́́."},{"start":41.453,"end":41.904,"text":"Amin.","marked":"Àmín."}],"end":41.904}]}