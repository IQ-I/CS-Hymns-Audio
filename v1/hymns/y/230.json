{"v":1,"coll":"y","num":230,"id":"hymn_230","title":"ODUN miiran tun ti de","duration":88.842,"voices":{"male":{"file":"y-230-male.m4a","bytes":655357,"sha256":"baaf6d99375c84b5a03c92434939b91bb9148d444bc8b246d46ce5fc9c01b70e","duration":88.9},"female":{"file":"y-230-female.m4a","bytes":673931,"sha256":"b19311881c292d6ab5c87480bb56d7703a004f39992365ab242b5179227095c1","duration":88.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.908,"text":"ODUN miiran tun ti de","marked":"Ọdún mìíràn tún ti dé"},{"start":2.288,"end":3.506,"text":"Ona t'a ko rin ri","marked":"Ọ̀nà t'á kò rìn rí"},{"start":3.886,"end":5.161,"text":"Yoo fun mi ni ikilo","marked":"Yóò fún mi ní ìkìlọ̀"},{"start":5.541,"end":6.69,"text":"B'iranlowo ko si","marked":"B'ìrànlọ́wọ́ kò sí"},{"start":7.07,"end":8.754,"text":"Sugbon Eni t'O to mi","marked":"Ṣùgbọ́n Ẹni t'Ó tó mi"},{"start":9.134,"end":10.324,"text":"Ni odun t'o koja","marked":"Ní ọdún t'ó kọjá"},{"start":10.704,"end":12.3,"text":"Se 'leri p'Oun yoo duro","marked":"Ṣé 'lérí p'Òun yóò dúró"},{"start":12.68,"end":13.691,"text":"Ti mi nigba gbogbo.","marked":"Tì mí nígbà gbogbo."}],"end":13.691},{"key":"2","start":14.641,"lines":[{"start":14.641,"end":15.999,"text":"Odun mii pelu Jesu","marked":"Ọdún míì pẹ̀lú Jésù"},{"start":16.379,"end":17.491,"text":"Emi ko mo 'foya","marked":"Èmi kò mọ 'fòyà"},{"start":17.871,"end":19.01,"text":"Yebiye ni ife Re","marked":"Yebiye ní ìfẹ́ Rẹ"},{"start":19.39,"end":20.936,"text":"B'o ti wu k'iji le","marked":"B'ó ti wu k'íjì le"},{"start":21.316,"end":22.813,"text":"Gba t'iji ba tile le","marked":"Gba t'ìjì bá tilẹ̀ le"},{"start":23.193,"end":24.233,"text":"No sinmi ninu Re","marked":"No sinmi nínú Rẹ̀"},{"start":24.613,"end":25.941,"text":"No r'alaafia didun","marked":"Nò r'àlàáfíà dídùn"},{"start":26.321,"end":27.574,"text":"Ni ookan aya Re.","marked":"Ní oókan àyà Rẹ."}],"end":27.574},{"key":"3","start":28.524,"lines":[{"start":28.524,"end":29.931,"text":"Odun ti n o gbekele E","marked":"Ọdún tí n ò gbẹ́kẹ̀lé E"},{"start":30.311,"end":31.644,"text":"N o tun gbekele I'Eni","marked":"N ó tún gbẹ́kẹ̀lé l'Ẹ́ni"},{"start":32.024,"end":33.283,"text":"Ti koja mi kule ri","marked":"Ti kọjá mi kulẹ̀ rí"},{"start":33.663,"end":35.006,"text":"Gba ti mo n wo'oju Re","marked":"Gbà tí mò ń wo'ojú Rẹ"},{"start":35.386,"end":36.99,"text":"O f'ogo at'opa Re","marked":"Ó f'ògò àt'ọ̀pá Rẹ̀"},{"start":37.37,"end":38.521,"text":"Fun mi, fun okun mi","marked":"Fún mi, fún okun mi"},{"start":38.901,"end":40.918,"text":"Jeejee l'O si n to mi lo","marked":"Jẹ́ẹ́jẹ́ẹ́ l'Ó sì ń tọ̀ mí lọ"},{"start":41.298,"end":42.642,"text":"L'ona mi lo s'ile.","marked":"L'ọ́nà mi lọ s'ilẹ̀."}],"end":42.642},{"key":"4","start":43.592,"lines":[{"start":43.592,"end":45.037,"text":"Odun miiran lnti sin in","marked":"Ọdún mìíràn lǹtì sìn ín"},{"start":45.417,"end":47.136,"text":"Ki n s'ise fun un nihin","marked":"Kí n ṣ'iṣẹ́ fún un níhìn"},{"start":47.516,"end":48.87,"text":"Gba l'ojiji tile gun","marked":"Gba l'òjijì tilẹ̀ gùn"},{"start":49.25,"end":50.439,"text":"Orun tun n sunmo le","marked":"Ọ̀run tún ń súnmọ́ lé"},{"start":50.819,"end":52.433,"text":"N ko mo gba ti yoo pe mi","marked":"N kò mo gbà tí yóò pè mí"},{"start":52.813,"end":54.263,"text":"Lati f'ise sile","marked":"Láti f'iṣẹ́ sílẹ̀"},{"start":54.643,"end":56.194,"text":"je ki n le je olooto","marked":"jẹ́ kí n lè jẹ́ olooto"},{"start":56.574,"end":57.95,"text":"B'ojo ti n sure lo.","marked":"B'ọjọ́ ti ń súre lọ."}],"end":57.95},{"key":"5","start":58.9,"lines":[{"start":58.9,"end":60.217,"text":"Odun miiran lati fe E","marked":"Ọdún mìíràn láti fẹ́ E"},{"start":60.597,"end":61.857,"text":"Eni ti mo feran","marked":"Ẹni tí mo fẹ́ràn"},{"start":62.237,"end":63.739,"text":"Odun miiran lati yin in","marked":"Ọdún mìíràn láti yìn ín"},{"start":64.119,"end":65.136,"text":"Pelu orin segun","marked":"Pẹ̀lú orin ṣẹ́gun"},{"start":65.516,"end":66.601,"text":"Ohun t'ola le mu wa","marked":"Ohun t'ọ́lá lè mú wá"},{"start":66.981,"end":68.299,"text":"Banuje tab'iya","marked":"Banújẹ́ tàb'íyá"},{"start":68.679,"end":70.052,"text":"lfe Re duro laelae","marked":"lfẹ́ Rẹ dúró láéláé"},{"start":70.432,"end":71.846,"text":"Okan naa ni titi.","marked":"Ọ̀kan náà ni títí."}],"end":71.846},{"key":"6","start":72.796,"lines":[{"start":72.796,"end":74.269,"text":"Odun mii pelu Jesu","marked":"Ọdún míì pẹ̀lú Jésù"},{"start":74.649,"end":75.601,"text":"Oluwa mo dupe","marked":"Olúwa mọ dúpẹ́"},{"start":75.981,"end":77.845,"text":"F'oju Re ti ki i kuna","marked":"F'ojú Rẹ tí kì í kùnà"},{"start":78.225,"end":79.349,"text":"L'ona ajo aye","marked":"L'ọ́nà àjọ ayé"},{"start":79.729,"end":81.075,"text":"Joo maa to mi, Oluwa","marked":"Jọ̀ọ́ máa tọ́ mi, Olúwa"},{"start":81.455,"end":82.58,"text":"Ko mi ki n se 'fe Re","marked":"Kò mí kí n ṣe 'fẹ́ Rẹ"},{"start":82.96,"end":84.555,"text":"Si mu ete ti Re se","marked":"Sì mú ète tí Rẹ̀ ṣẹ"},{"start":84.935,"end":86.386,"text":"L'aye mi l'ojoojo.","marked":"L'áyé mi l'ọ́jọ́ọjọ́."},{"start":86.766,"end":87.292,"text":"Amin.","marked":"Àmín."}],"end":87.292}]}