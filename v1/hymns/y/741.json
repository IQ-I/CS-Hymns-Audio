{"v":1,"coll":"y","num":741,"id":"hymn_741","title":"lWO ti okunkun","duration":45.479,"voices":{"male":{"file":"y-741-male.m4a","bytes":319869,"sha256":"19e2c0f89983d7d6a3b78d3fa8ed996b3b427055740070b00168e896b9e7aa42","duration":45.5},"female":{"file":"y-741-female.m4a","bytes":330051,"sha256":"f0a6ef85a59410486403b64a125401260fda5a7cf08abd886648f65bb1f45b5a","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.241,"text":"lWO ti okunkun","marked":"Ìwọ ti òkùnkùn"},{"start":1.621,"end":2.586,"text":"Gb'oro agbara re","marked":"Gb'ọ̀rọ̀ agbára rẹ"},{"start":2.966,"end":4.176,"text":"T'o si fo lo","marked":"T'ó sì fò lọ"},{"start":4.556,"end":5.766,"text":"Gbo tiwa a mbe O","marked":"Gbọ́ tiwa á ḿbẹ O"},{"start":6.146,"end":7.196,"text":"Nibit' ihinrere","marked":"Níbit' ìhìnrere"},{"start":7.576,"end":8.771,"text":"Ko ti tan mole Re","marked":"Kò ti tan mọ́lẹ̀ Rẹ"},{"start":9.151,"end":10.272,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀̀ wa."}],"end":10.272},{"key":"2","start":11.222,"lines":[{"start":11.222,"end":12.556,"text":"'Wo t'iye apa Re","marked":"'Wo t'iye apá Rẹ"},{"start":12.936,"end":14.063,"text":"Mu iriran w'aiye","marked":"Mú ìríran w'aiye"},{"start":14.443,"end":15.223,"text":"At'ilera","marked":"Àt'ìlera"},{"start":15.603,"end":16.74,"text":"Ilera ti inu","marked":"Ìlera ti inú"},{"start":17.12,"end":18.556,"text":"Iriran gbogbo enia","marked":"Ìríran gbogbo enia"},{"start":18.936,"end":20.031,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀̀ wa."}],"end":20.031},{"key":"3","start":20.981,"lines":[{"start":20.981,"end":21.885,"text":"Iwo Emi oto","marked":"Ìwọ Ẹ̀mí ọ̀tọ̀"},{"start":22.265,"end":23.46,"text":"Ti o f'iye fun wa","marked":"Tí ó f'íye fún wa"},{"start":23.84,"end":24.915,"text":"Fo kakiri","marked":"Fò kákiri"},{"start":25.295,"end":26.498,"text":"Gbe fitila anu","marked":"Gbé fìtílà anu"},{"start":26.878,"end":28.153,"text":"Fo ka oju omi","marked":"Fò ka ojú omi"},{"start":28.533,"end":29.584,"text":"Nibi okunkun nla","marked":"Níbi òkùnkùn ńlá"},{"start":29.964,"end":30.976,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀̀ wa."}],"end":30.976},{"key":"4","start":31.926,"lines":[{"start":31.926,"end":33.229,"text":"Metalokan Mimo","marked":"Mẹ́talọ́kan Mímọ́́"},{"start":33.609,"end":35.002,"text":"Ogbon, lfe, Ipa","marked":"Ọgbọ́n, lfẹ́, Ipa"},{"start":35.382,"end":36.326,"text":"Alabukun!","marked":"Alábùkún!"},{"start":36.706,"end":37.901,"text":"B'igbi omi okun","marked":"B'igbí omi òkun"},{"start":38.281,"end":39.587,"text":"Ti nyi ni ipa re","marked":"Ti nyi ni ipa rẹ"},{"start":39.967,"end":41.495,"text":"Be ka gbogbo aiye","marked":"Bẹ́ ka gbogbo aiye"},{"start":41.875,"end":42.918,"text":"K'imole wa.","marked":"K'ìmọ́lẹ̀̀ wa."},{"start":43.298,"end":43.929,"text":"Amin.","marked":"Àmín."}],"end":43.929}]}