{"v":1,"coll":"y","num":1,"id":"hymn_1","title":"Ji, okan mi, ba orun ji","duration":33.721,"voices":{"male":{"file":"y-1-male.m4a","bytes":238428,"sha256":"295c32b8d23fcb965c2be6d7cedab9c7223944df957bf9fb247bf96afd2b844f","duration":33.8},"female":{"file":"y-1-female.m4a","bytes":244295,"sha256":"7edfef0ce3deb21b4dcca664af70b0ab47cbb7f079bbaca9caf04550fbedd5c2","duration":33.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.599,"text":"Ji, okan mi, ba orun ji","marked":"Jí, ọkàn mi, bá ọ̀run jì"},{"start":2.979,"end":4.293,"text":"Mura si ise ojo re;","marked":"Múra sí iṣẹ́ ọjọ́ rẹ"},{"start":4.673,"end":5.658,"text":"Mase ilora, ji kutu,","marked":"Masẹ̀ ilora, jí kùtù"},{"start":6.038,"end":7.51,"text":"K'o san gbese ebo oro.","marked":"K'ó san gbèsè ẹbọ ọ̀rọ̀."}],"end":7.51},{"key":"2","start":8.46,"lines":[{"start":8.46,"end":10.294,"text":"Ro gbogbo ojo t'o fi sofo","marked":"Ro gbogbo ọjọ́ t'ó fi ṣófo"},{"start":10.674,"end":11.918,"text":"Bere si rere 'se loni,","marked":"Bẹ̀rẹ̀ sí rere 'ṣe lọni"},{"start":12.298,"end":14.526,"text":"Kiyes' irin re laiye yi;","marked":"Kíyès' ìrìn rẹ̀ láìyé yí"},{"start":14.906,"end":16.668,"text":"K'o si mura d'ojo nla ni.","marked":"K'ó sì múra d'ọjọ́ ńlá ni."}],"end":16.668},{"key":"3","start":17.618,"lines":[{"start":17.618,"end":18.857,"text":"Gba ninu imole orun","marked":"Gbà nínú ìmọ́lẹ̀̀ ọ̀run"},{"start":19.237,"end":20.76,"text":"Si tan 'mole na f'elomi","marked":"Sì tán 'mọ́lẹ̀ ná f'ẹlomi"},{"start":21.14,"end":22.253,"text":"Jeki ogo Olorun re,","marked":"Jẹ́kí ògo Ọlọ́run rẹ"},{"start":22.633,"end":24.003,"text":"Han n'nu wa ati ise re.","marked":"Hàn ń'nú wa àti ìṣe rẹ̀."}],"end":24.003},{"key":"4","start":24.953,"lines":[{"start":24.953,"end":26.697,"text":"Ji, gbon'ra nu ' wo okan mi","marked":"Jí, gbọ́n'rá nù ' wọ ọkàn mi"},{"start":27.077,"end":28.587,"text":"Yan ipo re larin Angel","marked":"Yan ipò rẹ̀ lárin Ángel"},{"start":28.967,"end":30.187,"text":"Awon ti nwon nkorin iyin","marked":"Àwọn tí nwọn nkorin ìyìn"},{"start":30.567,"end":32.171,"text":"Ni gbogbo oru s'Oba wa.","marked":"Ní gbogbo òru s'Ọba wa."}],"end":32.171}]}