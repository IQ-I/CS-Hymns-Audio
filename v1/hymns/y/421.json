{"v":1,"coll":"y","num":421,"id":"hymn_421","title":"WO bi awa enia Re","duration":40.921,"voices":{"male":{"file":"y-421-male.m4a","bytes":291866,"sha256":"c1069f1080bb0280b16d0c9f5d3db1712e203ada829740353d11f556fb2db88d","duration":41.0},"female":{"file":"y-421-female.m4a","bytes":294817,"sha256":"f648e65a53e0e4d9006b554efb43a7b5d110a59bb6d8d163e7f135f40209ff41","duration":41.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.75,"text":"WO bi awa enia Re","marked":"Wo bí àwa enia Rẹ"},{"start":2.13,"end":3.216,"text":"Ti wole l'ese Re","marked":"Ti wọlé l'ẹsẹ̀ Rẹ"},{"start":3.596,"end":5.503,"text":"Olorun ! kiki anu Re","marked":"Ọlọ́run ! kìkì ànú Rẹ"},{"start":5.883,"end":6.963,"text":"Ni igbekele wa.","marked":"Ní ìgbẹ́kẹ̀lé wa."}],"end":6.963},{"key":"2","start":7.913,"lines":[{"start":7.913,"end":9.191,"text":"ldajo t'o ba ni leru","marked":"ldajo t'ó bá ní lẹ́rù"},{"start":9.571,"end":10.648,"text":"Nfi agbara Re han","marked":"Nfi agbára Rẹ hàn"},{"start":11.028,"end":12.579,"text":"Sibe anu da 'lu wa si","marked":"Síbẹ̀ ànu dà 'lù wá sí"},{"start":12.959,"end":14.328,"text":"Awa si ngbadura.","marked":"Àwa sì ńgbàdúrà."}],"end":14.328},{"key":"3","start":15.278,"lines":[{"start":15.278,"end":17.088,"text":"Olorun, o se da wa si","marked":"Ọlọ́run, ó ṣe dá wa sí"},{"start":17.468,"end":18.519,"text":"Awa alaimore?","marked":"Àwa alaimore?"},{"start":18.899,"end":21.066,"text":"Jo, je k'agbo ikilo Re","marked":"Jọ, jẹ k'ágbó ìkìlọ̀ Rẹ"},{"start":21.446,"end":23.049,"text":"Nigbati anu wa.","marked":"Nígbàtí ànú wa."}],"end":23.049},{"key":"4","start":23.999,"lines":[{"start":23.999,"end":25.539,"text":"lwa buburu ti po to","marked":"lwa búburú ti pọ̀ tó"},{"start":25.919,"end":27.137,"text":"Yika ile wa yi!","marked":"Yíká ilé wa yí!"},{"start":27.517,"end":29.078,"text":"Buburu ile wa lo to 'yi","marked":"Búburú ilé wa ló tó 'yí"},{"start":29.458,"end":30.784,"text":"Wo b'o ti buru to.","marked":"Wo b'ó ti burú tó."}],"end":30.784},{"key":"5","start":31.734,"lines":[{"start":31.734,"end":33.414,"text":"Oluwa, fi ore-ofe","marked":"Olúwa, fi ọrẹ-ọ̀fẹ́"},{"start":33.794,"end":34.815,"text":"Yi wa lokan pada!","marked":"Yí wa lọ́kàn padà!"},{"start":35.195,"end":36.642,"text":"Ki a le gba oro Re gbo","marked":"Kí a lè gba ọ̀rọ̀ Rẹ gbọ́"},{"start":37.022,"end":38.431,"text":"K'a si wa oju Re.","marked":"K'á sì wá ojú Rẹ."},{"start":38.811,"end":39.371,"text":"Amin.","marked":"Àmín."}],"end":39.371}]}