{"v":1,"coll":"y","num":783,"id":"hymn_783","title":"E WOLE f'Oba wa","duration":47.978,"voices":{"male":{"file":"y-783-male.m4a","bytes":334455,"sha256":"859bfb04d1864813427c0975835eedf6803f9d55a019890de3a8fdd78b8a1b0e","duration":48.0},"female":{"file":"y-783-female.m4a","bytes":347969,"sha256":"ee0967cf04eab486354b2eba75cf1cbf16be49f6ee1ed9dbdd035f449c0107dc","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.578,"text":"E WOLE f'Oba wa","marked":"Ẹ Wọlé f'Ọba wa"},{"start":1.958,"end":3.088,"text":"Omo Mimo Baba","marked":"Ọmọ Mímọ́́ Bàbá"},{"start":3.468,"end":5.004,"text":"Eleda, Alabo","marked":"Ẹlẹ́dàá, Alábò"},{"start":5.384,"end":6.721,"text":"Olugbala gbogbo araiye.","marked":"Olùgbàlà gbogbo aráiye."}],"end":6.721},{"key":"CHORUS","start":7.671,"lines":[{"start":7.671,"end":9.94,"text":"Egbe: Gbogbo aiye, e fori bale","marked":"Gbogbo aiye, ẹ forí balẹ̀"},{"start":10.32,"end":11.155,"text":"f 'Olodumare","marked":"f 'Olódùmarè"},{"start":11.535,"end":12.769,"text":"Enit'o ra wa pada","marked":"Enit'ó rà wá padà"},{"start":13.149,"end":14.813,"text":"Alleluya gb'orin segun na ga","marked":"Allelúyà gb'orin ṣẹ́gun ná ga"},{"start":15.193,"end":16.799,"text":"Metalokan wa l'Oba ogo.","marked":"Mẹ́talọ́kan wa l'Ọba ògo."}],"end":16.799},{"key":"2","start":17.749,"lines":[{"start":17.749,"end":19.035,"text":"Mi si wa, Oluwa","marked":"Mi sì wá, Olúwa"},{"start":19.415,"end":20.716,"text":"Ka pin 'nu ogo Re","marked":"Ká pín 'nu ògo Rẹ"},{"start":21.096,"end":22.111,"text":"Orisun iye wa","marked":"Orísun ìyè wa"},{"start":22.491,"end":24.118,"text":"Ato-bajaiye Oba ogo.","marked":"Ato-bajaiye Ọba ògo."}],"end":24.118},{"key":"3","start":25.068,"lines":[{"start":25.068,"end":26.278,"text":"Aiye pel'ekun re","marked":"Àìyẹ pel'ekun rẹ̀"},{"start":26.658,"end":27.74,"text":"Tire ni Oluwa","marked":"Tìrẹ ni Olúwa"},{"start":28.12,"end":29.187,"text":"Awon to gba O gbo","marked":"Àwọn tó gbà Ọ́ gbọ́"},{"start":29.567,"end":31.261,"text":"Ni yio jogun Re titi aiye.","marked":"Ní yìó jogún Rẹ̀ títí aiye."}],"end":31.261},{"key":"4","start":32.211,"lines":[{"start":32.211,"end":33.624,"text":"lkore aiye gbo","marked":"lkórè aiye gbọ́"},{"start":34.004,"end":35.657,"text":"E mura, araiye","marked":"Ẹ múra, araiye"},{"start":36.037,"end":37.225,"text":"Olukore fere de","marked":"Olùkórè fere dé"},{"start":37.605,"end":39.112,"text":"Alikama nikan ni Tire.","marked":"Àlìkámà nìkan ni Tírè."}],"end":39.112},{"key":"5","start":40.062,"lines":[{"start":40.062,"end":41.237,"text":"Lojo ifarahan","marked":"Lọ́jọ́ ìfarahàn"},{"start":41.617,"end":42.979,"text":"Jewo mi, Oluwa","marked":"Jẹ́wọ́ mi, Olúwa"},{"start":43.359,"end":44.464,"text":"Jek'ore-ofe Re","marked":"Jẹ́k'ọ̀rẹ́-ọ̀fẹ́ Rẹ"},{"start":44.844,"end":46.428,"text":"Mu wa ye lati ba O gunwa.","marked":"Mú wa yẹ láti bá Ọ gúnwà."}],"end":46.428}]}