{"v":1,"coll":"y","num":136,"id":"hymn_136","title":"F'IBUKUN f'Oluwa!","duration":39.377,"voices":{"male":{"file":"y-136-male.m4a","bytes":277297,"sha256":"e22986819579fda528a6e2e3fbec541cc649a7692c94753fb6e72eadd344ee46","duration":39.4},"female":{"file":"y-136-female.m4a","bytes":286423,"sha256":"c862b8a539f60c53d7909c09885f131bd391c72683e3014dfdcfa7bcf2b468d1","duration":39.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.686,"text":"F'IBUKUN f'Oluwa!","marked":"F'ìbùkún f'Olúwa!"},{"start":2.066,"end":3.707,"text":"K'okan at'inu mi,","marked":"K'ókan àt'inú mi"},{"start":4.087,"end":5.482,"text":"Pel'ahon mi yin Oko Re,","marked":"Pel'ahon mi yin Ọkọ Rẹ"},{"start":5.862,"end":7.066,"text":"Fun gbogbo ore Re.","marked":"Fún gbogbo ọ̀rẹ́ Rẹ."}],"end":7.066},{"key":"2","start":8.016,"lines":[{"start":8.016,"end":9.107,"text":"F'ibukun f'Oluwa","marked":"F'ìbùkún f'Olúwa"},{"start":9.487,"end":10.524,"text":"Okan mi ma gbagbe","marked":"Ọkàn mi mà gbàgbé"},{"start":10.904,"end":13.444,"text":"Lati s'ope, Iati f'iyin","marked":"Láti s'ọ̀pẹ, láti f'ìyìn"},{"start":13.824,"end":15.131,"text":"Fun opo anu Re.","marked":"Fún ọ̀pọ̀ ànú Rẹ."}],"end":15.131},{"key":"3","start":16.081,"lines":[{"start":16.081,"end":17.168,"text":"O f'ese re ji O","marked":"Ó f'ẹsẹ̀ rẹ̀ jì Ọ́"},{"start":17.548,"end":18.676,"text":"O mu 'rora re lo","marked":"Ó mú 'rora rẹ̀ lọ"},{"start":19.056,"end":20.378,"text":"O wo gbogbo arun re san,","marked":"Ó wo gbogbo àrùn rẹ̀ sàn"},{"start":20.758,"end":22.207,"text":"O so o d'atunbi.","marked":"Ó sọ ọ́ d'àtúnbí."}],"end":22.207},{"key":"4","start":23.157,"lines":[{"start":23.157,"end":24.458,"text":"O f' onje f 'alaini","marked":"Ó f' ońjẹ f 'aláìní"},{"start":24.838,"end":25.925,"text":"lsimi f'ojiya;","marked":"lsimi f'ojiyà"},{"start":26.305,"end":27.843,"text":"Y'o se 'dajo agberaga","marked":"Y'ó ṣe 'dájọ́ agbéraga"},{"start":28.223,"end":29.463,"text":"Y'o gbeja alaise.","marked":"Y'ó gbèjà aláìṣẹ̀."}],"end":29.463},{"key":"5","start":30.413,"lines":[{"start":30.413,"end":31.535,"text":"O f'ise 'yanu Re,","marked":"Ó f'iṣẹ́ 'yanu Rẹ̀"},{"start":31.915,"end":34.065,"text":"Han, lat' owo Mose","marked":"Hàn, lát' ọwọ́ Mósè"},{"start":34.445,"end":36.152,"text":"Sugbon oto at'ore Re","marked":"Ṣùgbọ́n ọ̀tọ̀ àt'ọ̀rẹ́ Rẹ"},{"start":36.532,"end":37.827,"text":"L'o fi ran Omo Re.","marked":"L'ó fi ran Ọmọ Rẹ."}],"end":37.827}]}