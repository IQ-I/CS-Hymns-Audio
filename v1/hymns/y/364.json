{"v":1,"coll":"y","num":364,"id":"hymn_364","title":"F'AWON enia Re","duration":29.549,"voices":{"male":{"file":"y-364-male.m4a","bytes":199926,"sha256":"c1629b0c40e58fc3d8cf024269afb7dda2395698714bc4d377b630523c2b5ea9","duration":29.6},"female":{"file":"y-364-female.m4a","bytes":211798,"sha256":"027a45a5b10ca91346efcdebc3e39b3c47dfa1f05e70a0a206dbf919c93c9bc9","duration":29.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.255,"text":"F'AWON enia Re,","marked":"F'àwọn enia Rẹ"},{"start":1.635,"end":3.414,"text":"T'o ti fi aiye sile","marked":"T'ó ti fi àìyẹ́ sílẹ̀"},{"start":3.794,"end":5.721,"text":"Awon to mo O, t'o sin O,","marked":"Àwọn tó mọ̀ Ọ́, t'ó sin Ọ́"},{"start":6.101,"end":7.03,"text":"Gba orin iyin wa.","marked":"Gba orin ìyìn wa."}],"end":7.03},{"key":"2","start":7.98,"lines":[{"start":7.98,"end":9.148,"text":"F'awon enia Re","marked":"F'àwọn enia Rẹ"},{"start":9.528,"end":10.619,"text":"Gba ohun ope wa","marked":"Gba ohùn ọpẹ́ wa"},{"start":10.999,"end":12.628,"text":"Awon t'o fi O s'esan won","marked":"Àwọn t'ó fi Ó s'ẹ̀san wọn"},{"start":13.008,"end":14.165,"text":"Nwon ku n'gbagbo Re!","marked":"Nwọn kù ń'gbàgbọ́ Rẹ!"}],"end":14.165},{"key":"3","start":15.115,"lines":[{"start":15.115,"end":16.151,"text":"Ni gbogbo aiye won","marked":"Ní gbogbo àìyẹ́ wọn"},{"start":16.531,"end":17.619,"text":"'Won ni nwon nwo l'oju","marked":"'Wọ́n ní nwọ̀n ńwò l'ojú"},{"start":17.999,"end":19.436,"text":"Emi Mimo Re l'onko won","marked":"Ẹ̀mí Mímọ́́ Rẹ l'óńkọ́ wọn"},{"start":19.816,"end":21.114,"text":"Lati s'ohun gbogbo.","marked":"Láti ṣ'ohun gbogbo."}],"end":21.114},{"key":"4","start":22.064,"lines":[{"start":22.064,"end":23.342,"text":"Fun eyi, Oluwa,","marked":"Fún èyí, Olúwa"},{"start":23.722,"end":24.593,"text":"A nyin oruko Re","marked":"A nyin orúkọ Rẹ̀"},{"start":24.973,"end":26.417,"text":"Je k'a ma tele iwa won","marked":"Jẹ k'á ma tẹ̀lé ìwà wọn"},{"start":26.797,"end":27.999,"text":"Ki a le ku bi won.","marked":"Kí a lè kú bí wọn."}],"end":27.999}]}