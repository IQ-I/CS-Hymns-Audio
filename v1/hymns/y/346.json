{"v":1,"coll":"y","num":346,"id":"hymn_346","title":"E GB'ori nyin soke enu ona","duration":53.091,"voices":{"male":{"file":"y-346-male.m4a","bytes":378121,"sha256":"3e70d11151da3c0fa9fb05616c93fa928877ad62318133c11128f5384606380a","duration":53.1},"female":{"file":"y-346-female.m4a","bytes":389150,"sha256":"fdf358feea66b1310a9148c4790e296e4195d577907b6f2579bf518ec6792879","duration":53.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.76,"text":"E GB'ori nyin soke enu ona,","marked":"Ẹ Gb'ori nyin sókè ẹnu ọ̀nà"},{"start":2.14,"end":3.422,"text":"K'Oluwa ogo wole","marked":"K'Olúwa ògo wọlé"},{"start":3.802,"end":5.936,"text":"Enit' O f'eje re r'aiye pada","marked":"Enit' Ó f'ẹ̀jẹ̀ rẹ̀ r'aiye padà"},{"start":6.316,"end":7.929,"text":"O mbo lati gba 'joba.","marked":"Ó ḿbọ́ láti gba 'jọba."}],"end":7.929},{"key":"CHORUS","start":8.879,"lines":[{"start":8.879,"end":10.598,"text":"Hosannah, enyin Orun","marked":"Hosannah, enyin Ọ̀run"},{"start":10.978,"end":12.786,"text":"Halleluyah, eyin Aiye,","marked":"Hallelúyà, ẹ̀yìn Aiye"},{"start":13.166,"end":14.972,"text":"Orun, Osupa, e wole","marked":"Ọ̀run, Òṣùpá, ẹ wọ̀lẹ̀"},{"start":15.352,"end":16.976,"text":"Kabiyesi, f 'Oba wa.","marked":"Kábíyèsí, f 'Ọba wa."}],"end":16.976},{"key":"2","start":17.926,"lines":[{"start":17.926,"end":19.989,"text":"Awa Iran Israeli ni Afrika","marked":"Àwa Iran Ísírẹ́lì ní Afrika"},{"start":20.369,"end":21.708,"text":"E gb'ola Oluwa ga","marked":"Ẹ gb'ọlá Olúwa ga"},{"start":22.088,"end":23.763,"text":"Ajagun -molu Wa ti goke lo","marked":"Ajagun mólú Wa ti gòkè lọ"},{"start":24.143,"end":25.604,"text":"Lati lo pese aye.","marked":"Láti lọ pèsè ayé."}],"end":25.604},{"key":"3","start":26.554,"lines":[{"start":26.554,"end":28.424,"text":"Wo, Oba wa ninu Olanla Re,","marked":"Wò, Ọba wà nínú Ọláńlá Rẹ̀"},{"start":28.804,"end":30.345,"text":"Gun keke Ofurufu","marked":"Gun kẹ̀kẹ́ Òfúrufú"},{"start":30.725,"end":32.583,"text":"Agogo Orun pelu korin lyin","marked":"Àgọ́gọ Ọ̀run pẹ̀lú kọrin lyin"},{"start":32.963,"end":34.307,"text":"'Ghat'Oba Ogo wole.","marked":"'GHAT'Ọba Ògo wọlé."}],"end":34.307},{"key":"4","start":35.257,"lines":[{"start":35.257,"end":37.966,"text":"Okan mi nfa s'Agbala ayo na","marked":"Ọkàn mi ńfa s'Agbala ayọ̀ ná"},{"start":38.346,"end":39.751,"text":"Nibiti Kristi gunwa","marked":"Níbitì Kristi gúnwà"},{"start":40.131,"end":41.805,"text":"Odi yika ati Agbala Re","marked":"Odi yíká àti Àgbàlá Rẹ̀"},{"start":42.185,"end":43.684,"text":"Wura l'a fi se loso.","marked":"Wúrà l'á fi ṣe lọ́ṣọ́."}],"end":43.684},{"key":"5","start":44.634,"lines":[{"start":44.634,"end":46.266,"text":"Agbara Merinlelogun wole","marked":"Agbára Mẹ́rìnlélógún wọ̀lé"},{"start":46.646,"end":47.647,"text":"Pelu ade wura won","marked":"Pẹ̀lú adé wúrà wọn"},{"start":48.027,"end":49.614,"text":"At'awon Eda Alaye merin","marked":"Àt'àwọn Ẹ̀dá Àlàyé mẹ́rin"},{"start":49.994,"end":51.541,"text":"Nwon nfi iye fo f 'ayo.","marked":"Nwọ̀n nfi ìyẹ́ fò f 'ayo."}],"end":51.541}]}