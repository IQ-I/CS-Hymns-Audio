{"v":1,"coll":"y","num":854,"id":"hymn_854","title":"ISEGUN wa li okan mi","duration":41.005,"voices":{"male":{"file":"y-854-male.m4a","bytes":304700,"sha256":"1a5cd8f91d2c18fdd78fcac547ae89a1e3a90fb700c115d881890bf2ff34f1d5","duration":41.1},"female":{"file":"y-854-female.m4a","bytes":314704,"sha256":"cb9673bceb4c39fd3479dbf955f6c92fd432e30ac1b7db420e94dc191f949dc0","duration":41.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.666,"text":"ISEGUN wa li okan mi","marked":"Ìṣègùn wa li ọkàn mi"},{"start":2.046,"end":3.455,"text":"Nitori Emi ngbe 'nu mi","marked":"Nítorí Èmi ńgbẹ 'nu mi"},{"start":3.835,"end":5.148,"text":"Jeki igbi idanwo de","marked":"Jẹ́kí ìgbì ìdánwò dé"},{"start":5.528,"end":7.126,"text":"Jesu mura lati gba mi.","marked":"Jésù múra láti gbà mí."}],"end":7.126},{"key":"CHORUS","start":8.076,"lines":[{"start":8.076,"end":10.924,"text":"Isegun! Isegun! isegun l'okan mi","marked":"Ìṣègùn! Ìṣègùn! ìṣègùn l'ọkàn mi"},{"start":11.304,"end":14.416,"text":"Mo ni isegun nla 'tori Jesu gb'okan mi","marked":"Mo ní ìṣẹ́gun ńlá 'torí Jésù gb'ọkàn mi"},{"start":14.796,"end":17.326,"text":"Isegun! lsegun! bi odo sisan","marked":"Ìṣègùn! lṣẹ́gun! bí odò sísan"},{"start":17.706,"end":19.749,"text":"Mo nsegun nla ninu eje Jesu.","marked":"Mo ńṣẹ́gun ńlá nínú ẹ̀jẹ̀ Jésù."}],"end":19.749},{"key":"2","start":20.699,"lines":[{"start":20.699,"end":22.331,"text":"Bi 'ja tile le to si pe","marked":"Bí 'jà tilẹ̀ le tó sì pé"},{"start":22.711,"end":24.158,"text":"Bi esu tile b'okan mi ja","marked":"Bí èṣù tilé b'ọkàn mi já"},{"start":24.538,"end":26.768,"text":"Sibe, mo je alagbara","marked":"Síbẹ̀, mo jẹ́ alágbára"},{"start":27.148,"end":29.491,"text":"L'agbara Jesu, ngo segun.","marked":"L'agbára Jésù, ngo ṣẹ́gun."}],"end":29.491},{"key":"3","start":30.441,"lines":[{"start":30.441,"end":32.088,"text":"Mo ni 'segun lori ese","marked":"Mo ní 'ṣẹ́gun lórí ẹsẹ̀"},{"start":32.468,"end":34.128,"text":"Mo ni segun lori 'boji","marked":"Mo ní ṣẹ́gun lórí 'bojì"},{"start":34.508,"end":36.203,"text":"Ani iku ko ni 'pa mo","marked":"Àní ikú kọ́ ni 'pa mọ́"},{"start":36.583,"end":38.48,"text":"Aleluya! emi ti la.","marked":"Alelúyà! èmi ti là."},{"start":38.86,"end":39.455,"text":"Amin.","marked":"Àmín."}],"end":39.455}]}