{"v":1,"coll":"y","num":123,"id":"hymn_123","title":"GBOGBO enyin ti ngbe aiye","duration":38.516,"voices":{"male":{"file":"y-123-male.m4a","bytes":271716,"sha256":"d486011f51a0abb06a664abf035778d245334b20cfc46936aa028a169714401a","duration":38.6},"female":{"file":"y-123-female.m4a","bytes":287747,"sha256":"d75a208a70ddb30d2a90de09c6d07c1a8381b2b710818ac5c9bea53cc5c41d67","duration":38.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.663,"text":"GBOGBO enyin ti ngbe aiye","marked":"Gbogbo ènyin ti ńgbé aiye"},{"start":3.043,"end":4.352,"text":"E f'ayo korin s'Oluwa","marked":"Ẹ f'àyò kọrin s'Olúwa"},{"start":4.732,"end":6.986,"text":"F'iberu sin, e yin logo","marked":"F'ìbẹ̀rù sìn, ẹ yin lógo"},{"start":7.366,"end":9.063,"text":"E f'ayo wa siwaju Re.","marked":"Ẹ f'ayò wá síwájú Rẹ̀."}],"end":9.063},{"key":"2","start":10.013,"lines":[{"start":10.013,"end":11.729,"text":"Oluwa, On li Olorun","marked":"Olúwa, On li Ọlọ́run"},{"start":12.109,"end":13.782,"text":"O da wa laisi 'ranwo wa","marked":"Ó dá wa láìsí 'rànwọ́ wa"},{"start":14.162,"end":16.558,"text":"Tire l'awa se, O mbo wa;","marked":"Tìrẹ l'áwá ṣe, Ó ḿbọ̀ wá"},{"start":16.938,"end":18.367,"text":"O ntoju wa b'agutan Re.","marked":"Ó ńtọ́jú wa b'ágùtàn Rẹ̀."}],"end":18.367},{"key":"3","start":19.317,"lines":[{"start":19.317,"end":20.75,"text":"E f'iyin wo ile Re wa","marked":"Ẹ f'ìyìn wọ ilé Rẹ̀ wá"},{"start":21.13,"end":22.731,"text":"E f'ayo sunm' agbala Re;","marked":"Ẹ f'àyò súnm' àgbàlá Rẹ̀"},{"start":23.111,"end":25.212,"text":"E yin, e bukun oko Re","marked":"Ẹ yìn, ẹ bùkún ọkọ Rẹ̀"},{"start":25.592,"end":27.315,"text":"N'tori be l'o ye k'a mase.","marked":"N'torí bẹ̀ l'ó yé k'á maṣe."}],"end":27.315},{"key":"4","start":28.265,"lines":[{"start":28.265,"end":29.744,"text":"N'tori rere l'Olorun wa","marked":"N'torí rere l'Ọlọ́run wa"},{"start":30.124,"end":31.72,"text":"Anu Re wa bakanna lai,","marked":"Ànú Rẹ̀ wá bákanná láì"},{"start":32.1,"end":34.211,"text":"Oto Re ko fi 'gba kan ye,","marked":"Ọ̀tọ̀ Rẹ̀ kò fi 'gbà kan yẹ"},{"start":34.591,"end":36.06,"text":"Oduro lat'iran de 'ran.","marked":"Òdúró lát'iran dé 'ran."},{"start":36.44,"end":36.966,"text":"Amin.","marked":"Àmín."}],"end":36.966}]}