{"v":1,"coll":"y","num":751,"id":"hymn_751","title":"A o pade leti odo","duration":41.613,"voices":{"male":{"file":"y-751-male.m4a","bytes":301475,"sha256":"09709d76da8c858c02cf765ef1653e378a96f6ac7d946277aecd34c945709a8a","duration":41.7},"female":{"file":"y-751-female.m4a","bytes":309399,"sha256":"0ccefb86b7da7df7e58177ece3709da6ce16117748f9534899cc830c452390b2","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.621,"text":"A o pade leti odo,","marked":"A ó pàdé létí odò"},{"start":2.001,"end":3.343,"text":"T'ese Angeli ti te","marked":"T'éṣe Áńgẹ́lì ti tẹ́"},{"start":3.723,"end":5.419,"text":"T'o mo gara bi Kristali","marked":"T'ó mọ gara bí Kristali"},{"start":5.799,"end":7.191,"text":"Leba ite Olorun.","marked":"Lẹ́bà ìtẹ́ Ọlọ́run."}],"end":7.191},{"key":"CHORUS","start":8.141,"lines":[{"start":8.141,"end":9.553,"text":"Egbe: A o pade leti odo,","marked":"A ó pàdé létí odò"},{"start":9.933,"end":11.842,"text":"Odo didan, Odo didan na,","marked":"Odò dídán, Odò dídán ná"},{"start":12.222,"end":13.856,"text":"Pelu awon Mimo Ieba odo,","marked":"Pẹ̀lú àwọn Mímọ́́ lẹ́bà odò"},{"start":14.236,"end":15.89,"text":"To san Ieba ite ni.","marked":"Tó sàn lẹ́bá ìtẹ́ ni."}],"end":15.89},{"key":"2","start":16.84,"lines":[{"start":16.84,"end":18.255,"text":"Leti bebe odo na yi","marked":"Létí bẹbẹ odò ná yí"},{"start":18.635,"end":19.934,"text":"Pel' Oluso-agutan wa,","marked":"Pel' Olùṣọ́-àgùtàn wa"},{"start":20.314,"end":21.492,"text":"A o ma rin ao ma sin,","marked":"A ò má rìn aó má sìn"},{"start":21.872,"end":23.385,"text":"B'a ti ntele 'pase Re.","marked":"B'á ti ńtẹ̀lé 'pasẹ̀ Rẹ̀."}],"end":23.385},{"key":"3","start":24.335,"lines":[{"start":24.335,"end":25.986,"text":"K'a to de odo didan na,","marked":"K'á tó dé odò dídán ná"},{"start":26.366,"end":27.728,"text":"A o s'eru wa kale","marked":"A ò s'ẹrù wa kalẹ̀"},{"start":28.108,"end":30.18,"text":"Jesu, y'o gba eru ese","marked":"Jésù, y'ó gba ẹrù ẹ̀ṣẹ̀"},{"start":30.56,"end":31.925,"text":"Awon ti o de l'ade.","marked":"Àwọn tí ó dé l'áde."}],"end":31.925},{"key":"4","start":32.875,"lines":[{"start":32.875,"end":34.636,"text":"Nje leba odo tutu na,","marked":"Ǹjẹ́ leba odò tutù ná"},{"start":35.016,"end":36.099,"text":"A o r'oju Olugbala","marked":"A ò r'ojú Olùgbàlà"},{"start":36.479,"end":38.275,"text":"Emi wa ki o pinyan mo,","marked":"Ẹ̀mí wa kí ó pinyan mọ́"},{"start":38.655,"end":40.063,"text":"Yio korin Ogo Re.","marked":"Yíó kọrin Ògo Rẹ̀."}],"end":40.063}]}