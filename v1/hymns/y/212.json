{"v":1,"coll":"y","num":212,"id":"hymn_212","title":"OJO ati akoko nlo","duration":77.092,"voices":{"male":{"file":"y-212-male.m4a","bytes":565037,"sha256":"e6359bc7c8f55412d8127a19a385c912288a1f54853181d5b0e12b415a7ab6ac","duration":77.1},"female":{"file":"y-212-female.m4a","bytes":591141,"sha256":"d367aefd19d49240f92211f851b52555d69a5854ca975bc74b3f267bf06fc622","duration":77.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.899,"text":"OJO ati akoko nlo,","marked":"Ọjọ́ àti àkókò ńlò"},{"start":2.279,"end":4.347,"text":"Nwon nsun wa s' eti, 'boji,","marked":"Nwọ̀n nsun wá s' etí, 'bojì"},{"start":4.727,"end":5.828,"text":"Awa fere dubule na,","marked":"Àwa fèrè dùbúlẹ̀ ná"},{"start":6.208,"end":7.341,"text":"Ninu iho 'busun wa.","marked":"Nínú ihò 'bùsùn wa."}],"end":7.341},{"key":"2","start":8.291,"lines":[{"start":8.291,"end":10.517,"text":"Jesu, 'Wo Olurapada,","marked":"Jésù, 'Wo Olùràpadà"},{"start":10.897,"end":12.864,"text":"Ji okan t' oku s' ese;","marked":"Jí ọ̀kan t' oku s' ese"},{"start":13.244,"end":14.658,"text":"Ji gbogbo okan ti ntogbe,","marked":"Jí gbogbo ọkàn tì ńtọ̀gbẹ"},{"start":15.038,"end":16.447,"text":"Lati yan ipa iye.","marked":"Láti yan ipa ìyè."}],"end":16.447},{"key":"3","start":17.397,"lines":[{"start":17.397,"end":18.966,"text":"Bi akoko ti nsunmole,","marked":"Bí àkókò ti ńsúnmọlẹ̀"},{"start":19.346,"end":20.829,"text":"Jek' a ro ' bi ti anlo;","marked":"Jek' á rò ' bí ti ànlò"},{"start":21.209,"end":22.906,"text":"Bi lati r'ayo ailopin,","marked":"Bí láti r'àyò àìlópin"},{"start":23.286,"end":24.814,"text":"Tabi egbe ailopin.","marked":"Tàbí ẹgbẹ́ àìlópin."}],"end":24.814},{"key":"4","start":25.764,"lines":[{"start":25.764,"end":26.763,"text":"Aiye wa nlo!","marked":"Àìyẹ́ wa ńlò!"},{"start":27.143,"end":28.18,"text":"Iku de tan,","marked":"Ikú dé tán"},{"start":28.56,"end":30.064,"text":"Jesu, so wa,","marked":"Jésù, ṣọ́ wa"},{"start":30.444,"end":31.831,"text":"Tit' O fi de,","marked":"Tít' Ó fi dé"},{"start":32.211,"end":33.706,"text":"K'a a ba O gbe,","marked":"K'á a bá Ò gbé"},{"start":34.086,"end":35.05,"text":"K' aba O ku,","marked":"K' aba Ò kú"},{"start":35.43,"end":37.731,"text":"K' a ba O joba titi lailai.","marked":"K' a bá Ó jọba títí láíláí."}],"end":37.731},{"key":"5","start":38.681,"lines":[{"start":38.681,"end":40.29,"text":"Aiye wa nkoja b' ojiji,","marked":"Aiye wa ńkọjá b' òjijì"},{"start":40.67,"end":42.273,"text":"O si nfo lo bi 'kuku;","marked":"Ó sì ńfọ́ lọ bí 'kúkú"},{"start":42.653,"end":43.972,"text":"Fun gbogbo odun t' o","marked":"Fún gbogbo ọdún t' o"},{"start":44.352,"end":45.043,"text":"K oja,","marked":"K ọjà"},{"start":45.423,"end":47.072,"text":"Dariji wa, mu wa gbon.","marked":"Dáríjì wa, mú wa gbọ́n."}],"end":47.072},{"key":"6","start":48.022,"lines":[{"start":48.022,"end":49.499,"text":"Ko wa lati ka ojo wa,","marked":"Kọ́ wa láti ka ọjọ́ wa"},{"start":49.879,"end":51.137,"text":"Lari ba ese wa ja,","marked":"Lárí bá ẹ̀ṣẹ̀ wa jà"},{"start":51.517,"end":53.963,"text":"K'a ma sure, k' a ma togbe,","marked":"K'á má súre, k' á má tògbé"},{"start":54.343,"end":56.041,"text":"Tit'a o fi ri 'sinmi.","marked":"Tít'á ò fi rí 'sinmi."}],"end":56.041},{"key":"7","start":56.991,"lines":[{"start":56.991,"end":58.364,"text":"Gbogbo wa fere duro na,","marked":"Gbogbo wa fèrè dúró ná"},{"start":58.744,"end":59.962,"text":"Niwaju ite ' dajo;","marked":"Níwájú ìtẹ́ ' dájọ́"},{"start":60.342,"end":62.783,"text":"Jesu, ' Wo t'o segun iku,","marked":"Jésù, ' Wo t'ó ṣẹ́gun ikú"},{"start":63.163,"end":64.706,"text":"Fi wa s' apa otun Re.","marked":"Fi wá s' apa ọ̀tún Rẹ."}],"end":64.706},{"key":"8","start":65.656,"lines":[{"start":65.656,"end":66.643,"text":"Aiye wa nlo!","marked":"Àìyẹ́ wa ńlò!"},{"start":67.023,"end":68.516,"text":"Iku de tan, Olugbala!","marked":"Ikú dé tán, Olùgbàlà!"},{"start":68.896,"end":71.329,"text":"Jo pa wa mo, K' a ba O gbe,","marked":"Jó pa wá mọ́, K' a bá O gbé"},{"start":71.709,"end":72.951,"text":"K'a ba O ku,","marked":"K'á bá Ò kú"},{"start":73.331,"end":75.542,"text":"K' a ba O joba titi lailai.","marked":"K' a bá Ó jọba títí láíláí."}],"end":75.542}]}