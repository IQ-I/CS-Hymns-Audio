{"v":1,"coll":"y","num":91,"id":"hymn_91","title":"E DAMURE enyin Seraf'","duration":50.356,"voices":{"male":{"file":"y-91-male.m4a","bytes":359664,"sha256":"fb01f249c76139247ce991fa12953b09d0e9c7043a3e00837b3c948b0f9309a1","duration":50.4},"female":{"file":"y-91-female.m4a","bytes":373506,"sha256":"44bf41d199b902bbdf9f0244bc27bca5ae7287307c9918e42b9738e7bb383ba1","duration":50.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.93,"text":"E DAMURE enyin Seraf'","marked":"Ẹ Dámùrè enyin Séráf'"},{"start":2.31,"end":4.002,"text":"E mu harpu nyin pelu","marked":"Ẹ mú harpu nyin pẹ̀lú"},{"start":4.382,"end":6.052,"text":"E je ki Kimbali nyin dun","marked":"Ẹ jẹ́ kí Kimbali nyin dùn"},{"start":6.432,"end":7.874,"text":"Lati pade Oba wa.","marked":"Láti pàdé Ọba wa."}],"end":7.874},{"key":"CHORUS","start":8.824,"lines":[{"start":8.824,"end":10.219,"text":"Loke odo ona Eden,","marked":"Lókè ọ̀dọ́ ọ̀nà Édẹ́n"},{"start":10.599,"end":11.884,"text":"Ibugbe mimo to dara","marked":"Ibùgbé mímọ́́ tó dára"},{"start":12.264,"end":13.835,"text":"Nibi Kerubu Serafu,","marked":"Níbi Kérúbù Séráfù"},{"start":14.215,"end":15.698,"text":"Nyin Baba Mimo Logo.","marked":"Nyin Bàbá Mímọ́́ Lógo."}],"end":15.698},{"key":"2","start":16.648,"lines":[{"start":16.648,"end":18.325,"text":"Fi 'lu ati 'jo yin Baba","marked":"Fi 'lu àti 'jó yin Bàbá"},{"start":18.705,"end":20.268,"text":"Baba y'o f'ayo fun wa","marked":"Bàbá y'ó f'ayò fún wa"},{"start":20.648,"end":22.03,"text":"Bi awa ba je le gbagbo","marked":"Bí àwa bá jẹ́ lè gbàgbọ́"},{"start":22.41,"end":23.736,"text":"Ere pupo ni fun wa.","marked":"Èrè púpọ̀ ni fún wa."}],"end":23.736},{"key":"3","start":24.686,"lines":[{"start":24.686,"end":26.217,"text":"Baba masai fi 're fun wa","marked":"Bàbá masai fi 'rẹ̀ fún wa"},{"start":26.597,"end":27.929,"text":"Awa Seraf' aiye yi;","marked":"Àwa Séráf' aiye yi"},{"start":28.309,"end":30.112,"text":"Se wa ye fun isin gbogbo","marked":"Ṣé wá yẹ fún ìsìn gbogbo"},{"start":30.492,"end":31.949,"text":"Ka gb'ade wa nikehin.","marked":"Ká gb'adé wa nikehin."}],"end":31.949},{"key":"4","start":32.899,"lines":[{"start":32.899,"end":34.517,"text":"Baba to gbo ti Elijah,","marked":"Bàbá tó gbọ́ ti Elijah"},{"start":34.897,"end":36.608,"text":"Masai gbo ti Serafu;","marked":"Masai gbọ́ tí Séráfù"},{"start":36.988,"end":38.701,"text":"Jehovah-Jire Oba wa,","marked":"Jehovah-Jire Ọba wa"},{"start":39.081,"end":40.489,"text":"Se wa ye lojo 'kehin.","marked":"Ṣé wá yé lọ́jọ́ 'kẹhin."}],"end":40.489},{"key":"5","start":41.439,"lines":[{"start":41.439,"end":42.761,"text":"Ao f'ogo fun Baba wa,","marked":"Aó f'ògo fún Bàbá wa"},{"start":43.141,"end":44.918,"text":"Fun Omo, to da wa si;","marked":"Fún Ọmọ, tó dá wa sí"},{"start":45.298,"end":47.048,"text":"Bi odun si ti nyipo lo,","marked":"Bí ọdún sì ti nyípo lọ"},{"start":47.428,"end":48.806,"text":"Metalokan la O yin.","marked":"Mẹ́talọ́kan la Ó yín."}],"end":48.806}]}