{"v":1,"coll":"y","num":297,"id":"hymn_297","title":"WO Odagutan ti o ru","duration":32.72,"voices":{"male":{"file":"y-297-male.m4a","bytes":232035,"sha256":"d382b7e73daab96ac13dde967401c8a1c15335bafcdc16635f70f3a9da33551e","duration":32.8},"female":{"file":"y-297-female.m4a","bytes":236560,"sha256":"8126eabd4ad02cb2e67d88040c37a8cc234cc76222ba0ef8976dec7480f91436","duration":32.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.735,"text":"WO Odagutan ti o ru","marked":"Wo Odagutan tí ó ru"},{"start":2.115,"end":3.294,"text":"E ru re Ior'igi","marked":"Ẹ rú rẹ̀ lór'igi"},{"start":3.674,"end":4.974,"text":"O ku lati da igbekun","marked":"Ó kù láti dá ìgbèkùn"},{"start":5.354,"end":6.595,"text":"O t'eje Re fun o.","marked":"Ó t'ẹ̀jẹ̀ Rẹ̀ fún ọ."}],"end":6.595},{"key":"2","start":7.545,"lines":[{"start":7.545,"end":9.465,"text":"W'Olugbala, tit' iran na","marked":"W'Olùgbàlà, tit' ìran ná"},{"start":9.845,"end":11.168,"text":"Y'o fi fa okan re","marked":"Y'ó fi fa ọkàn rẹ"},{"start":11.548,"end":12.956,"text":"Fi omije rin ese Re","marked":"Fi omijé rin ẹsẹ̀ Rẹ"},{"start":13.336,"end":14.646,"text":"Ma kuro lodo Re.","marked":"Má kúrò lọ́dọ̀ Rẹ."}],"end":14.646},{"key":"3","start":15.596,"lines":[{"start":15.596,"end":17.609,"text":"Wo, titi ife yio fi","marked":"Wò, títí ìfẹ́ yio fi"},{"start":17.989,"end":19.001,"text":"Joba lor'okan re","marked":"Jọba lọ́r'ọkàn rẹ"},{"start":19.381,"end":21.127,"text":"Tit'agbara Re y'o fi han","marked":"Tít'agbára Rẹ y'ó fi hàn"},{"start":21.507,"end":22.763,"text":"Lor'ara on emi.","marked":"Lọ́r'ara ọ́n ẹ̀mí."}],"end":22.763},{"key":"4","start":23.713,"lines":[{"start":23.713,"end":25.651,"text":"Wo, b'iwo ti nsare ije","marked":"Wò, b'íwò ti nsáré ìje"},{"start":26.031,"end":27.363,"text":"Ore re titi ni","marked":"Ọ̀rẹ́ rẹ̀ títí ni"},{"start":27.743,"end":29.317,"text":"Y'o pari 'se Re t' O bere","marked":"Y'ó parí 'ṣe Rẹ̀ t' Ó bẹ̀rẹ̀"},{"start":29.697,"end":31.17,"text":"Or'ofe y'o j'ogo.","marked":"Or'ọ̀fẹ́ y'ó j'ògo."}],"end":31.17}]}