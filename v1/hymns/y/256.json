{"v":1,"coll":"y","num":256,"id":"hymn_256","title":"BI mo ti ri laisawawi","duration":53.461,"voices":{"male":{"file":"y-256-male.m4a","bytes":389035,"sha256":"81a50a37f9ed76572b57dc47d81728e35fa6fc80f44a43268f353745a12aecc7","duration":53.5},"female":{"file":"y-256-female.m4a","bytes":395129,"sha256":"cbdec1460d35773c41d0130b02a7b466f48fb1b88a113350d723c736e088d244","duration":53.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.937,"text":"BI mo ti ri laisawawi","marked":"Bí mo ti rí láìṣàwáwí"},{"start":2.317,"end":3.819,"text":"Sugbon nitori eje eje Re","marked":"Ṣùgbọ́n nítorí ẹ̀jẹ̀ ẹ̀jẹ̀ Rẹ̀"},{"start":4.199,"end":6.02,"text":"B'O si ti pe mi pe ki nwa","marked":"B'ó sì ti pè mí pé kí ńwá"},{"start":6.4,"end":7.664,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":7.664},{"key":"2","start":8.614,"lines":[{"start":8.614,"end":10.814,"text":"Bi mo ti ri, laiduro pe","marked":"Bí mo ti rí, láìdúró pé"},{"start":11.194,"end":12.796,"text":"Mo fe k'okan mi mo toto","marked":"Mo fẹ́ k'ọkàn mi mọ́ toto"},{"start":13.176,"end":14.519,"text":"Sodo Re t'o le we mi mo","marked":"Sọ́dọ̀ Rẹ t'ó lè wẹ̀ mí mọ́"},{"start":14.899,"end":16.436,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":16.436},{"key":"3","start":17.386,"lines":[{"start":17.386,"end":19.789,"text":"Bi mo ti ri, b'o tile je","marked":"Bí mo ti rí, b'ó tilẹ̀ jẹ́"},{"start":20.169,"end":21.67,"text":"Ija lode, ija ninu","marked":"Ìjà lóde, ìjà nínú"},{"start":22.05,"end":23.805,"text":"Eru lode, eru ninu","marked":"Ẹrú lóde, èrú nínú"},{"start":24.185,"end":25.411,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":25.411},{"key":"4","start":26.361,"lines":[{"start":26.361,"end":28.429,"text":"Bi mo ti ri: osi, are","marked":"Bí mo ti rí: òṣì, àre"},{"start":28.809,"end":30.309,"text":"Mo si nwa imularada","marked":"Mo sì ńwá ìmúláradá"},{"start":30.689,"end":32.207,"text":"Iwo lo le s'awotan mi","marked":"Ìwọ lo lè ṣ'àwòtán mi"},{"start":32.587,"end":33.887,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":33.887},{"key":"5","start":34.837,"lines":[{"start":34.837,"end":36.793,"text":"Bi mo ti ri: 'Wo o gba mi","marked":"Bí mo ti rí: 'Wò ó gbà mí"},{"start":37.173,"end":38.648,"text":"'Wo o gba mi towo-tese","marked":"'Wò ó gbà mí tọwọ́-tẹsẹ̀"},{"start":39.028,"end":40.299,"text":"“Tori mo gba 'leri Re gbo","marked":"Torí mo gbà 'lérí Rẹ̀ gbọ́"},{"start":40.679,"end":42.011,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."}],"end":42.011},{"key":"6","start":42.961,"lines":[{"start":42.961,"end":44.991,"text":"Bi mo ti ri: Ife Tire","marked":"Bí mo ti rí: Ìfẹ́ Tírè"},{"start":45.371,"end":46.703,"text":"Lo sete mi patapata","marked":"Lọ ṣètè mí pátápátá"},{"start":47.083,"end":49.175,"text":"Mo di Tire, Tire nikan","marked":"Mo di Tírè, Tírè nìkan"},{"start":49.555,"end":50.84,"text":"Olugbala, mo de.","marked":"Olùgbàlà, mo dé."},{"start":51.22,"end":51.911,"text":"Amin.","marked":"Àmín."}],"end":51.911}]}