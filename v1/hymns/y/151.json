{"v":1,"coll":"y","num":151,"id":"hymn_151","title":"JI! ko orin Mose","duration":40.04,"voices":{"male":{"file":"y-151-male.m4a","bytes":283723,"sha256":"27b64b5059dd12123bd601564b5a391c4489bc5288d60386d2d1a111d6d605c3","duration":40.1},"female":{"file":"y-151-female.m4a","bytes":295002,"sha256":"9fd9528aaa25d2024e06bac56f8ed4f0c535657f3577cfcdc9ceed57cde573e8","duration":40.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.19,"text":"JI! ko orin Mose","marked":"Jí! kọ orin Mósè"},{"start":2.57,"end":3.498,"text":"At t'Odagutan","marked":"Àt t'Ọ̀dàgùtàn"},{"start":3.878,"end":5.543,"text":"Ji gbogbo okan at'ahon","marked":"Jí gbogbo ọkàn àt'ahọ́n"},{"start":5.923,"end":6.946,"text":"Ki nwon yin Oluwa.","marked":"Kí nwọn yin Olúwa."}],"end":6.946},{"key":"2","start":7.896,"lines":[{"start":7.896,"end":9.025,"text":"Korin ti iku re,","marked":"Kọrin tí ikú rẹ̀"},{"start":9.405,"end":10.615,"text":"Korin ajinde Re,","marked":"Kọrin àjíǹde Rẹ"},{"start":10.995,"end":12.616,"text":"Korin b'o ti mbebe loke","marked":"Kọrin b'ó ti mbẹbẹ lókè"},{"start":12.996,"end":14.271,"text":"F'ese awon t'O ru.","marked":"F'èsè àwọn t'Ó rú."}],"end":14.271},{"key":"3","start":15.221,"lines":[{"start":15.221,"end":16.421,"text":"Enyin ero l'ona","marked":"Enyin ẹ̀rọ l'ọ́nà"},{"start":16.801,"end":17.931,"text":"E korin b'e ti nlo","marked":"Ẹ kọrin b'ẹ́ ti ńlò"},{"start":18.311,"end":20.008,"text":"E yo ninu Od'agutan","marked":"Ẹ yọ̀ nínú Od'agutan"},{"start":20.388,"end":21.578,"text":"Ninu Kristi Oba.","marked":"Nínú Kristi Ọba."}],"end":21.578},{"key":"4","start":22.528,"lines":[{"start":22.528,"end":23.931,"text":"E fe gbo k'O wipe","marked":"Ẹ fẹ́ gbọ́ k'Ó wípé"},{"start":24.311,"end":25.264,"text":"'Alabukun, e wa\"","marked":"'Alábùkún, ẹ wà"},{"start":25.644,"end":27.282,"text":"On fere pe nyin lo kuro","marked":"Òǹ fẹ́rẹ̀ pé nyin lọ kúrò"},{"start":27.662,"end":29.175,"text":"K'O mu Tire lo 'le.","marked":"K'ó mú Tírè lọ 'lé."}],"end":29.175},{"key":"5","start":30.125,"lines":[{"start":30.125,"end":31.467,"text":"Nibe l'aokorin","marked":"Níbẹ̀ l'áokọrin"},{"start":31.847,"end":33.393,"text":"Iyin Re ailopin","marked":"Ìyìn Rẹ àìlópin"},{"start":33.773,"end":35.693,"text":"Orun y'o si gbe 'rin Mose","marked":"Ọ̀run y'ó sì gbé 'rin Mósè"},{"start":36.073,"end":37.465,"text":"Ati t'Od'agutan.","marked":"Àti t'Od'agutan."},{"start":37.845,"end":38.49,"text":"Amin.","marked":"Àmín."}],"end":38.49}]}