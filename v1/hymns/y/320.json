{"v":1,"coll":"y","num":320,"id":"hymn_320","title":"JESU ye, titi aiye","duration":54.585,"voices":{"male":{"file":"y-320-male.m4a","bytes":388213,"sha256":"1022eb8eddff69cdf832932ea51dd14a23d344d85abc03f74904e8eb40e5f339","duration":54.6},"female":{"file":"y-320-female.m4a","bytes":404961,"sha256":"c07913ac36bb6ccb11dcb461ebabe79fe1ed39ffe2b2ebff2fac22d659899818","duration":54.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.015,"text":"JESU ye, titi aiye","marked":"Jésù yè, títí aiye"},{"start":2.395,"end":3.903,"text":"Eru iku ko ba ni mo","marked":"Ẹ̀rù ikú kò bá ní mọ́"},{"start":4.283,"end":6.096,"text":"Jesu ye: nitorina","marked":"Jésù yẹ: nitorina"},{"start":6.476,"end":8.076,"text":"Isa oku ko n'ipa mo","marked":"Isà òkú kò ń'ípa mọ́"},{"start":8.456,"end":9.375,"text":"Alleluya.","marked":"Allelúyà."}],"end":9.375},{"key":"CHORUS","start":10.325,"lines":[{"start":10.325,"end":11.229,"text":"Alleluya.","marked":"Allelúyà."}],"end":11.229},{"key":"2","start":12.179,"lines":[{"start":12.179,"end":14.078,"text":"Jesu ye, lat' oni lo","marked":"Jésù yè, lat' oni lọ"},{"start":14.458,"end":15.716,"text":"Iku je ona si iye","marked":"Ikú jẹ́ ọ̀nà sí ìyè"},{"start":16.096,"end":17.589,"text":"Eyi y'o je 'tunu wa","marked":"Èyí y'ó jẹ́ 'tùnú wa"},{"start":17.969,"end":20.09,"text":"'Gbat' akoko iku ba de","marked":"'Gbat' àkọ́kọ́ ikú bá dé"},{"start":20.47,"end":21.444,"text":"Alleluya.","marked":"Allelúyà."}],"end":21.444},{"key":"3","start":22.394,"lines":[{"start":22.394,"end":24.402,"text":"Jesu ye, fun wa l'O ku","marked":"Jésù yè, fún wa l'Ó kú"},{"start":24.782,"end":26.694,"text":"Nje Tire ni a o ma se","marked":"Ǹjẹ́ Tírè ni a ó ma ṣe"},{"start":27.074,"end":28.6,"text":"A o f'okan funfun sin","marked":"A ò f'ọkàn funfun sin"},{"start":28.98,"end":30.238,"text":"A o f'ogo f'Olugbala","marked":"A ò f'ògo f'Olùgbàlà"},{"start":30.618,"end":31.471,"text":"Alleluya.","marked":"Allelúyà."}],"end":31.471},{"key":"4","start":32.421,"lines":[{"start":32.421,"end":34.311,"text":"Jesu ye, eyi daju","marked":"Jésù yè, èyí dájú"},{"start":34.691,"end":36.103,"text":"lku at'ipa okunkun","marked":"lkù àt'ipa òkùnkùn"},{"start":36.483,"end":37.982,"text":"Ki y'o le ya ni kuro","marked":"Kí y'ó lè ya ní kúrò"},{"start":38.362,"end":39.975,"text":"Ninu ife nla ti jesu","marked":"Nínú ìfẹ́ ńlá ti Jésù"},{"start":40.355,"end":41.199,"text":"Alleluya.","marked":"Allelúyà."}],"end":41.199},{"key":"5","start":42.149,"lines":[{"start":42.149,"end":44.303,"text":"Jesu ye, gbogbo 'joba","marked":"Jésù yè, gbogbo 'jọba"},{"start":44.683,"end":47.041,"text":"L'orun, li aiye di Tire","marked":"L'õrùn, li aiye di Tìrè"},{"start":47.421,"end":48.784,"text":"E je ki a ma tele","marked":"Ẹ jẹ́ kí a má tẹ̀lé"},{"start":49.164,"end":50.662,"text":"Ki a le joba pelu Re","marked":"Kí a lè jọba pẹ̀lú Rẹ"},{"start":51.042,"end":52.046,"text":"Alleluya.","marked":"Allelúyà."},{"start":52.426,"end":53.036,"text":"Amin.","marked":"Àmín."}],"end":53.036}]}