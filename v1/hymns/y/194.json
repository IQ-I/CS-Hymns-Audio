{"v":1,"coll":"y","num":194,"id":"hymn_194","title":"WA, Iwo Jesu t'a nreti","duration":34.953,"voices":{"male":{"file":"y-194-male.m4a","bytes":251833,"sha256":"444203466b5612f7e6c09e1a889cf71ec41e51cf5d234adbe1b2422130d85c12","duration":35.0},"female":{"file":"y-194-female.m4a","bytes":263927,"sha256":"da329ccc8b6a4c19e70383248bc97a94da9076d25ae1451267adeab304c608ee","duration":35.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.555,"text":"WA, Iwo Jesu t'a nreti","marked":"Wà, Ìwọ Jésù t'á ńrètí"},{"start":2.935,"end":4.678,"text":"T'a bi lati da ni n'de","marked":"T'á bi láti dà ní ń'de"},{"start":5.058,"end":6.511,"text":"Gba wa low' eru at'ese","marked":"Gbà wá lọ́w' ẹrú àt'ẹsẹ̀"},{"start":6.891,"end":8.468,"text":"Jek' ari isimi re.","marked":"Jẹ́k' àrí isimi rẹ."}],"end":8.468},{"key":"2","start":9.418,"lines":[{"start":9.418,"end":10.622,"text":"lwo ni itunu Israel","marked":"lwo ní ìtùnú Israel"},{"start":11.002,"end":12.324,"text":"Ireti Onigbagbo","marked":"Ìrètí Onígbàgbọ́"},{"start":12.704,"end":13.892,"text":"Ife gbogbo orile ede","marked":"Ìfẹ́ gbogbo orílẹ̀ èdè"},{"start":14.272,"end":15.586,"text":"Ayo okan ti nwona.","marked":"Ayọ̀ ọkàn ti ńwọ̀nà."}],"end":15.586},{"key":"3","start":16.536,"lines":[{"start":16.536,"end":18.555,"text":"Wo t'a bi lati gba wa la,","marked":"Wo t'á bí láti gbà wá là"},{"start":18.935,"end":20.1,"text":"Omo ti a bi l'Oba","marked":"Ọmọ tí a bí l'Ọba"},{"start":20.48,"end":22.694,"text":"Ti a bi lati joba lai,","marked":"Tí a bí láti jọba láì"},{"start":23.074,"end":24.294,"text":"Jeki ijoba re de.","marked":"Jẹ́kí ìjọba rẹ dé."}],"end":24.294},{"key":"4","start":25.244,"lines":[{"start":25.244,"end":26.719,"text":"Fi Emi Mimo Re nikan","marked":"Fi Ẹ̀mí Mímọ́́ Rẹ nìkan"},{"start":27.099,"end":28.486,"text":"Se akoso aiya wa","marked":"Ṣe àkóso àìyá wa"},{"start":28.866,"end":30.513,"text":"Nipa itoye, kikun Re","marked":"Nípa ìtóye, kíkún Rẹ̀"},{"start":30.893,"end":32.413,"text":"Gbe wa s'ori ite Re.","marked":"Gbé wa s'orí ìtẹ́ Rẹ."},{"start":32.793,"end":33.404,"text":"Amin.","marked":"Àmín."}],"end":33.404}]}