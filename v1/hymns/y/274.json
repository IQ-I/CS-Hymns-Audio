{"v":1,"coll":"y","num":274,"id":"hymn_274","title":"B'ERU ese re ba nwo o Iorun","duration":51.974,"voices":{"male":{"file":"y-274-male.m4a","bytes":369323,"sha256":"62e2c3d467279ea4c4773fbb95733648d4fc810d12a0cc224a4e6d0a3244ca92","duration":52.0},"female":{"file":"y-274-female.m4a","bytes":382220,"sha256":"80fcddbb8adb2b0eddfe0b92be6fc7d73cb3686fe111b2f992c09008cfce8c8e","duration":52.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.951,"text":"B'ERU ese re ba nwo o Iorun","marked":"B'ẹ̀rù ẹsẹ̀ rẹ bá ńwọ́ ọ lọ́rùn"},{"start":2.331,"end":3.826,"text":"Pe Jesu wole Okan re","marked":"Pé Jésù wọlé Ọkàn rẹ̀"},{"start":4.206,"end":5.924,"text":"B'o ndaniyan isoji Okan re","marked":"B'ó ndaniyan ìsọjí Ọkàn rẹ̀"},{"start":6.304,"end":7.775,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":7.775},{"key":"CHORUS","start":8.725,"lines":[{"start":8.725,"end":10.19,"text":"Le'yemeji re sonu","marked":"Le'yèméjì rẹ̀ sọnù"},{"start":10.57,"end":11.784,"text":"Ba Oluwa re laja","marked":"Bá Olúwa rẹ̀ lájà"},{"start":12.164,"end":13.441,"text":"Si okan re paya fun","marked":"Ṣí ọkàn rẹ payá fún"},{"start":13.821,"end":15.564,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":15.564},{"key":"2","start":16.514,"lines":[{"start":16.514,"end":18.551,"text":"Bi o ba nwa iwenumo kiri","marked":"Bí o bá ńwá ìwẹ̀nùmọ́ kiri"},{"start":18.931,"end":20.381,"text":"Pe Jesu wole okan re","marked":"Pé Jésù wọlé ọkàn rẹ̀"},{"start":20.761,"end":22.449,"text":"Oni 'wenumo ko jina si o","marked":"Òní 'wẹ̀nùmọ́ kò jiná sí o"},{"start":22.829,"end":24.238,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":24.238},{"key":"3","start":25.188,"lines":[{"start":25.188,"end":26.753,"text":"B'lgbi wahala ba ngba o kiri","marked":"B'lgbi wàhálà bá ńgbá o kiri"},{"start":27.133,"end":28.421,"text":"Pe Jesu wole okun re","marked":"Pé Jésù wọlé okun rẹ̀"},{"start":28.801,"end":31.198,"text":"B'afo ba wa ti aiye ko le di","marked":"B'áfọ̀ bá wà tí àìyẹ́ kó lè dí"},{"start":31.578,"end":33.15,"text":"Pe jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ."}],"end":33.15},{"key":"4","start":34.1,"lines":[{"start":34.1,"end":36.092,"text":"Bi ore t'o gbekele ba da o","marked":"Bí ọ̀rẹ́ t'ó gbẹ́kẹ̀lé bá dá ọ"},{"start":36.472,"end":38.023,"text":"Fe Jesu wole okan re","marked":"Fẹ́ Jésù wọlé ọkàn rẹ"},{"start":38.403,"end":39.956,"text":"On nikan ni Olubanidaro","marked":"Ọ̀n nìkan ni Olùbánidárò"},{"start":40.336,"end":41.784,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":41.784},{"key":"5","start":42.734,"lines":[{"start":42.734,"end":44.64,"text":"B'o nfe korin awon alabukun","marked":"B'ó ńfẹ́ kọrin àwọn alábùkún"},{"start":45.02,"end":46.463,"text":"Pe Jesu wole okan re","marked":"Pé Jésù wọlé ọkàn rẹ̀"},{"start":46.843,"end":48.481,"text":"Bi o nfe wo agbala isimi","marked":"Bí ò ńfẹ́ wọ àgbàlá isimi"},{"start":48.861,"end":50.424,"text":"Pe Jesu wole okan re.","marked":"Pé Jésù wọlé ọkàn rẹ̀."}],"end":50.424}]}