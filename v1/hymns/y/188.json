{"v":1,"coll":"y","num":188,"id":"hymn_188","title":"YO enyin onigbagbo","duration":72.083,"voices":{"male":{"file":"y-188-male.m4a","bytes":528899,"sha256":"2b29e2e5b0d383ad588a4f975d7ae7bdff47ce6cc3871277d5b38f90441c959d","duration":72.1},"female":{"file":"y-188-female.m4a","bytes":543317,"sha256":"65770d15ffb38afb4344499fdefdafe8e7d63b911adc7400d03226a78fe0d686","duration":72.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.62,"text":"YO enyin onigbagbo","marked":"Yọ ẹnyin onígbàgbọ́"},{"start":2.0,"end":3.321,"text":"Jeki 'mole nyin tan","marked":"Jẹkì 'mọ́lẹ̀ nyin tán"},{"start":3.701,"end":4.852,"text":"Igba ale mbo tete","marked":"Ìgbà alẹ́ ḿbò tẹ́tẹ́"},{"start":5.232,"end":6.282,"text":"Oru si fere de,","marked":"Òru sì feré dé"},{"start":6.662,"end":7.967,"text":"Oko lyawo dide","marked":"Ọkọ lyàwó dìde"},{"start":8.347,"end":9.558,"text":"O fere sunmole","marked":"Ó fẹ́rẹ̀ sùnmọ́lẹ̀"},{"start":9.938,"end":11.955,"text":"Dide, gbadura, sora","marked":"Dídé, gbàdúrà, ṣọ́ra"},{"start":12.335,"end":13.714,"text":"L'oru n'igbe y'o ta.","marked":"L'oru n'igbe y'ó ta."}],"end":13.714},{"key":"2","start":14.664,"lines":[{"start":14.664,"end":16.037,"text":"E be fitila nyin wo,","marked":"Ẹ bẹ fìtílà nyin wò"},{"start":16.417,"end":17.583,"text":"F'ororo sinu won","marked":"F'òróró sínú wọn"},{"start":17.963,"end":19.433,"text":"E duro de 'gbala nyin","marked":"Ẹ dúró de 'gbala nyin"},{"start":19.813,"end":20.954,"text":"Ipari 'se aiye","marked":"Ìparí 'ṣe aiye"},{"start":21.334,"end":22.354,"text":"Awon oluso nwipe","marked":"Àwọn olùṣọ́ ńwípé"},{"start":22.734,"end":23.995,"text":"Oko 'yawo de tan","marked":"Ọkọ 'yàwó dé tán"},{"start":24.375,"end":26.187,"text":"E pade re, b'O ti mbo","marked":"Ẹ pàdé rẹ̀, b'O ti mbo"},{"start":26.567,"end":27.355,"text":"Pelu orin iyin.","marked":"Pẹ̀lú orin ìyìn."}],"end":27.355},{"key":"3","start":28.305,"lines":[{"start":28.305,"end":29.32,"text":"Enyin wundia mimo","marked":"Enyin wúńdíá mímọ́́"},{"start":29.7,"end":30.961,"text":"Gbe ohun nyin soke","marked":"Gbé ohùn nyin sókè"},{"start":31.341,"end":32.554,"text":"Titi n'nu orin ayo","marked":"Títí ń'nú orin ayò"},{"start":32.934,"end":34.179,"text":"Pelu awon Angel","marked":"Pẹ̀lú àwọn Ángel"},{"start":34.559,"end":35.69,"text":"Onje iyawo se tan","marked":"Ońjẹ ìyàwó ṣe tán"},{"start":36.07,"end":37.219,"text":"'Lekun na si sile","marked":"'Lèkùn nà sí sílẹ̀"},{"start":37.599,"end":39.276,"text":"Dide, arole ogo","marked":"Dídé, àròlé ògo"},{"start":39.656,"end":40.726,"text":"Oko lyawo mbo.","marked":"Ọkọ lyawo ḿbọ̀."}],"end":40.726},{"key":"4","start":41.676,"lines":[{"start":41.676,"end":42.891,"text":"Enyin ti e fi suru","marked":"Enyin tí ẹ fi ṣùrù"},{"start":43.271,"end":44.607,"text":"Ru agbelebu nyin","marked":"Rú àgbélébùú nyin"},{"start":44.987,"end":46.44,"text":"E o si joha lailai","marked":"Ẹ ó sì joha láíláí"},{"start":46.82,"end":48.017,"text":"'Gbati 'ponju ba tan","marked":"'Gbàtì 'pọ́njú bá tán"},{"start":48.397,"end":49.849,"text":"Yi ite ogo Re ka","marked":"Yí ìtẹ́ ògo Rẹ ká"},{"start":50.229,"end":51.819,"text":"E o r' Od'agutan","marked":"Ẹ ò r' Od'agutan"},{"start":52.199,"end":53.467,"text":"E o r' ade ogo nyin","marked":"Ẹ ò r' adé ògo nyin"},{"start":53.847,"end":55.064,"text":"Lele niwaju Re.","marked":"Lélẹ̀ níwájú Rẹ."}],"end":55.064},{"key":"5","start":56.014,"lines":[{"start":56.014,"end":57.934,"text":"Jesu, 'Wo ireti wa,","marked":"Jésù, 'Wo ìrètí wa"},{"start":58.314,"end":59.718,"text":"F'ara Re han fun wa,","marked":"F'ara Rẹ hàn fún wa"},{"start":60.098,"end":61.54,"text":"'Wo Orun t'a ti nreti","marked":"'Wo Ọrùn t'á ti ńrètí"},{"start":61.92,"end":63.1,"text":"Ran s'ori ile wa","marked":"Rán s'orí ilé wa"},{"start":63.48,"end":64.668,"text":"A gbe owo wa s'oke","marked":"A gbé ọwọ́ wa s'òkè"},{"start":65.048,"end":66.17,"text":"Oluwa je k'a ri","marked":"Olúwa jẹ k'á rí"},{"start":66.55,"end":67.926,"text":"Ojo 'rapada aiye","marked":"Ọjọ́ 'ràpadà aiye"},{"start":68.306,"end":69.604,"text":"T'o mu wa d'odo Re.","marked":"T'ó mú wa d'ọ̀dọ̀ Rẹ."},{"start":69.984,"end":70.533,"text":"Amin.","marked":"Àmín."}],"end":70.533}]}