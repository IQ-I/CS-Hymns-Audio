{"v":1,"coll":"y","num":240,"id":"hymn_240","title":"JI se Re nde Jesu","duration":39.516,"voices":{"male":{"file":"y-240-male.m4a","bytes":282749,"sha256":"64365c98e6410e49364e5d0336f65fa9b7ff5616859b165c584545ed421ff86f","duration":39.6},"female":{"file":"y-240-female.m4a","bytes":288032,"sha256":"0ab7ceb7ce1b1ad2d545edae4ffd7013e1e71f5cbffbf341a2e912fa040bce02","duration":39.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.438,"text":"JI se Re nde Jesu","marked":"Jí ṣe Ré ńdẹ Jésù"},{"start":1.818,"end":3.048,"text":"Fi agbara Re han","marked":"Fi agbára Rẹ hàn"},{"start":3.428,"end":5.123,"text":"Fo'hun t'o le j'oku dide","marked":"Fọ'hun t'ó lè j'òkú dìde"},{"start":5.503,"end":6.654,"text":"Mu k'enia Re gbo.","marked":"Mu k'enia Rẹ gbọ́."}],"end":6.654},{"key":"2","start":7.604,"lines":[{"start":7.604,"end":9.343,"text":"Ji ise Re nde, Jesu","marked":"Jí iṣẹ́ Rẹ ńdẹ̀, Jésù"},{"start":9.723,"end":10.749,"text":"To orun iku yi","marked":"Tó ọ̀run ikú yí"},{"start":11.129,"end":12.581,"text":"Fi Emi agbara nla Re","marked":"Fi Ẹ̀mí agbára ńlá Rẹ"},{"start":12.961,"end":14.43,"text":"Ji okan ti ntogbe.","marked":"Jí ọ̀kan ti ńtògbé."}],"end":14.43},{"key":"3","start":15.38,"lines":[{"start":15.38,"end":16.666,"text":"Ji 'se Re nde, Jesu","marked":"Jí 'ṣe Rẹ̀ ńdẹ̀, Jésù"},{"start":17.046,"end":18.39,"text":"Mu k'ongbe Re gbe wa","marked":"Mú k'òǹgbè Rẹ gbé wá"},{"start":18.77,"end":20.611,"text":"Si mu k'ebi pa okan wa","marked":"Sì mú k'ebi pa ọkàn wa"},{"start":20.991,"end":22.367,"text":"Fun onje iye na.","marked":"Fún ońjẹ ìyè ná."}],"end":22.367},{"key":"4","start":23.317,"lines":[{"start":23.317,"end":24.927,"text":"Ji 'se Re nde, Jesu","marked":"Jí 'ṣe Rẹ̀ ńdẹ̀, Jésù"},{"start":25.307,"end":26.323,"text":"Gbe oruko Re ga","marked":"Gbé orúkọ Rẹ̀ ga"},{"start":26.703,"end":28.062,"text":"Mu k'ife Re kun okan wa","marked":"Mú k'ífẹ́ Rẹ kún ọkàn wa"},{"start":28.442,"end":29.447,"text":"Nipa Emi Mimo.","marked":"Nípa Ẹ̀mí Mímọ́́."}],"end":29.447},{"key":"5","start":30.397,"lines":[{"start":30.397,"end":31.732,"text":"Ji 'se Re nde, Jesu","marked":"Jí 'ṣe Rẹ̀ ńdẹ̀, Jésù"},{"start":32.112,"end":33.356,"text":"Ro 'jo itura Re","marked":"Rò 'jọ ìtura Rẹ"},{"start":33.736,"end":35.267,"text":"Ogo y'o je Tire nikan","marked":"Ògo y'ó jẹ́ Tírè nìkan"},{"start":35.647,"end":37.048,"text":"K'ibukun je tiwa.","marked":"K'ìbùkún jẹ́ tiwa."},{"start":37.428,"end":37.966,"text":"Amin.","marked":"Àmín."}],"end":37.966}]}