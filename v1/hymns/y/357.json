{"v":1,"coll":"y","num":357,"id":"hymn_357","title":"'LAI lodo Oluwa!","duration":59.347,"voices":{"male":{"file":"y-357-male.m4a","bytes":435804,"sha256":"ca6491d10c06560ec47f8f31ccbe98687954e965a572d28ec1ffd04bcaefe40b","duration":59.4},"female":{"file":"y-357-female.m4a","bytes":448361,"sha256":"0501a3dd726b543c524ee134c51d22c07c276183a35dd7ce15d2ad936c798eee","duration":59.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.602,"text":"'LAI lodo Oluwa!","marked":"'Láì lọ́dọ̀ Olúwa!"},{"start":1.982,"end":3.105,"text":"Amin, beni ko ri","marked":"Àmín, bẹ́ni kò rí"},{"start":3.485,"end":4.927,"text":"Iye wa ninu oro na","marked":"Iye wà nínú ọ̀rọ̀ ná"},{"start":5.307,"end":6.817,"text":"Aiku ni titi lai","marked":"Àìkú ni títí láí"},{"start":7.197,"end":8.296,"text":"Nihin ninu ara","marked":"Níhìn nínú ara"},{"start":8.676,"end":10.182,"text":"Mo sako jina si","marked":"Mo ṣáko jiná sí"},{"start":10.562,"end":12.84,"text":"Sibe, alale ni mo nfi","marked":"Síbẹ̀, alálẹ́ ni mò ńfì"},{"start":13.22,"end":14.469,"text":"Ojo kan sunmole.","marked":"Ọjọ́ kan súnmọ́lẹ̀."}],"end":14.469},{"key":"2","start":15.419,"lines":[{"start":15.419,"end":16.61,"text":"Ile Baba loke","marked":"Ilé Bàbá lókè"},{"start":16.99,"end":18.064,"text":"Ile okan mi ni","marked":"Ilé ọkàn mi ni"},{"start":18.444,"end":19.719,"text":"Emi nfi oju igbagbo","marked":"Ẹ̀mí ńfi ojú ìgbàgbọ́́"},{"start":20.099,"end":21.298,"text":"Wo 'bode wura re!","marked":"Wo 'bóde wúrà rẹ!"},{"start":21.678,"end":22.777,"text":"Okan mi nfa pupo","marked":"Ọkàn mi ńfà púpọ̀"},{"start":23.157,"end":24.528,"text":"S'ile na ti mo fe","marked":"S'ilé ná tí mo fẹ́"},{"start":24.908,"end":26.201,"text":"Ile didan t'awon mimo","marked":"Ilẹ̀ dídán t'àwọn mímọ́́"},{"start":26.581,"end":27.841,"text":"Jerusalem t'orun.","marked":"Jerusalem t'ọrun."}],"end":27.841},{"key":"3","start":28.791,"lines":[{"start":28.791,"end":29.668,"text":"Awosanma dide","marked":"Àwọsánmà dìde"},{"start":30.048,"end":31.044,"text":"Gbogbo ero mi pin","marked":"Gbogbo èrò mi pin"},{"start":31.424,"end":33.522,"text":"Bi adaba Noa, mo nfo,","marked":"Bí àdàbà Nóà, mo ńfọ́"},{"start":33.902,"end":34.94,"text":"Larin iji lile","marked":"Lárin ìjì líle"},{"start":35.32,"end":36.35,"text":"Sugbon sanma kuro","marked":"Ṣùgbọ́n sánmà kúrò"},{"start":36.73,"end":37.846,"text":"lji si rekoja","marked":"lji sì rékọjá"},{"start":38.226,"end":39.674,"text":"Ayo ati alafia","marked":"Ayọ̀ àti àlàáfíà"},{"start":40.054,"end":41.408,"text":"Si gba okan mi kan.","marked":"Sì gba ọkàn mi kan."}],"end":41.408},{"key":"4","start":42.358,"lines":[{"start":42.358,"end":43.722,"text":"Loro ati l'ale","marked":"Lọ́rọ̀ àti l'álẹ̀"},{"start":44.102,"end":45.627,"text":"Losan ati l'oru","marked":"Lọ́sàn àti l'oru"},{"start":46.007,"end":48.125,"text":"Mo ngbo orin orun, bori","marked":"Mo ńgbọ́ orin ọ̀run, borí"},{"start":48.505,"end":49.837,"text":"Rudurudu aiye","marked":"Rúdurùdu aiye"},{"start":50.217,"end":51.385,"text":"Oro ajinde ni","marked":"Ọ̀rọ̀ àjíǹde ni"},{"start":51.765,"end":52.816,"text":"Hiho isegun ni","marked":"Híhò ìṣègùn ni"},{"start":53.196,"end":54.907,"text":"Lekan si “Lai lod'Oluwa”","marked":"Lẹ́kàn sí Láì lod'Olúwa"},{"start":55.287,"end":56.842,"text":"Amin, beni k'o ri.","marked":"Àmín, bẹ́nì k'ó rí."},{"start":57.222,"end":57.797,"text":"Amin.","marked":"Àmín."}],"end":57.797}]}