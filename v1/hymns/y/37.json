{"v":1,"coll":"y","num":37,"id":"hymn_37","title":"OJO mefa t'ise koja","duration":45.414,"voices":{"male":{"file":"y-37-male.m4a","bytes":329441,"sha256":"f8f40d7318f0511f548459416d84b1367b771b94780e8bc6df519ad0dc83c772","duration":45.5},"female":{"file":"y-37-female.m4a","bytes":337661,"sha256":"fba79db8ff90c2bbce1c46d397569461d0d49b4908f3d3e7d04eefc3ce169500","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.301,"text":"OJO mefa t'ise koja","marked":"Ọjọ́ mẹ́fà t'iṣẹ́ kọjá"},{"start":2.681,"end":3.941,"text":"Okan t'isimi si bere","marked":"Ọkàn t'isimi sì bẹ̀rẹ̀"},{"start":4.321,"end":5.979,"text":"Wa, okan mi si 'simi re,","marked":"Wá, ọkàn mi sì 'simi rẹ̀"},{"start":6.359,"end":8.244,"text":"Y'o s'ojo t'Olorun busi.","marked":"Y'ó s'ọ́jọ́ t'Ọlọ́run bùsí."}],"end":8.244},{"key":"2","start":9.194,"lines":[{"start":9.194,"end":10.709,"text":"Ki 'ronu at'ope wa nde,","marked":"Kí 'ronú àt'ọpẹ́ wa ńde"},{"start":11.089,"end":12.366,"text":"Bi ebo turari s'orun","marked":"Bí ẹbọ tùràrí s'ọrun"},{"start":12.746,"end":14.268,"text":"K'o le fa inu didun wa;","marked":"K'ó lè fa inú dídùn wá"},{"start":14.648,"end":16.181,"text":"T'o je t'enit' O mo nikan.","marked":"T'ó jẹ́ t'enit' Ó mọ̀ nìkan."}],"end":16.181},{"key":"3","start":17.131,"lines":[{"start":17.131,"end":18.658,"text":"lbale aiya orun yi,","marked":"lbale àìyá ọ̀run yí"},{"start":19.038,"end":20.764,"text":"L'eri isimi t'o l'ogo","marked":"L'ẹ̀rí ìsimi t'ó l'ògo"},{"start":21.144,"end":22.633,"text":"T'o wa fun enia mimo","marked":"T'ó wà fún enia mímọ́́"},{"start":23.013,"end":24.529,"text":"Opin aniyan at'aisan.","marked":"Òpin àníyàn àt'àìsàn."}],"end":24.529},{"key":"4","start":25.479,"lines":[{"start":25.479,"end":27.718,"text":"Olorun, a yo si 'se Re,","marked":"Ọlọ́run, a yó sì 'ṣe Rẹ̀"},{"start":28.098,"end":30.01,"text":"L'oniruru t'ogbon t'otun","marked":"L'oniruru t'ọgbọ́n t'ótun"},{"start":30.39,"end":32.001,"text":"A fi 'yin ro anu t'o lo","marked":"A fi 'yín ro ãnu t'ó lọ"},{"start":32.381,"end":33.999,"text":"A ni 'reti s'eyi ti mbo.","marked":"A ní 'reti s'èyí ti ḿbọ́."}],"end":33.999},{"key":"5","start":34.949,"lines":[{"start":34.949,"end":36.395,"text":"F'oni sisin mimo jale","marked":"F'ọ́nì sísin mímọ́́ jálẹ̀"},{"start":36.775,"end":38.491,"text":"K'o si se inu didun si;","marked":"K'ó sì ṣe inú dídùn sí"},{"start":38.871,"end":41.051,"text":"B'o ti dun lati l'ojo yi,","marked":"B'ó ti dùn láti l'ọjọ́ yí"},{"start":41.431,"end":42.929,"text":"Nireti okan ailopin?","marked":"Nírètí ọkàn àìlópin?"},{"start":43.309,"end":43.864,"text":"Amin.","marked":"Àmín."}],"end":43.864}]}