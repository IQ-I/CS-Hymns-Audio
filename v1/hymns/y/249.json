{"v":1,"coll":"y","num":249,"id":"hymn_249","title":"A F'AYO ri ore-ofe","duration":31.213,"voices":{"male":{"file":"y-249-male.m4a","bytes":215038,"sha256":"4ba0cce04a9ba4df750bcdf2aef9692534bbf90fa3f68470c80094ed4f2d6aac","duration":31.3},"female":{"file":"y-249-female.m4a","bytes":220726,"sha256":"004babd7c399e26a2010f578147a85c4d94508af82712e366c4de003a7860954","duration":31.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.669,"text":"A F'AYO ri ore-ofe","marked":"A F'àyò rí ọ̀rẹ́-ọ̀fẹ́"},{"start":2.049,"end":3.086,"text":"T'Alufa giga wa,","marked":"T'Àlùfá gíga wa"},{"start":3.466,"end":4.876,"text":"Okan Re kun fun iyonu","marked":"Ọkàn Rẹ kún fún ìyọnu"},{"start":5.256,"end":6.558,"text":"lnu Re nyo fun 'fe.","marked":"lnu Rẹ̀ nyo fún 'fẹ́."}],"end":6.558},{"key":"2","start":7.508,"lines":[{"start":7.508,"end":8.922,"text":"Tinutinu l'o ndaro we","marked":"Tinútinú l'ó ńdàrọ́ wé"},{"start":9.302,"end":10.749,"text":"O mo ailera wa","marked":"Ó mọ àìlera wa"},{"start":11.129,"end":12.521,"text":"O mo bi idanwo ti ri","marked":"O mọ bí ìdánwò ti rí"},{"start":12.901,"end":13.957,"text":"Nitori O ti ri.","marked":"Nítorí Ó ti rí."}],"end":13.957},{"key":"3","start":14.907,"lines":[{"start":14.907,"end":16.499,"text":"On paapo l'ojo aiye Re","marked":"On páàpó l'ọjọ́ aiye Rẹ"},{"start":16.879,"end":18.235,"text":"O sokun kikoro","marked":"Ó ṣókùn kíkorò"},{"start":18.615,"end":20.004,"text":"O mba olukuluku pin","marked":"Ó ḿbá olúkúlùkù pín"},{"start":20.384,"end":21.561,"text":"Ninu iya ti nje.","marked":"Nínú ìyà ti ńjẹ."}],"end":21.561},{"key":"4","start":22.511,"lines":[{"start":22.511,"end":23.826,"text":"Je ki a f'igbagbo 'rele","marked":"Jẹ́ kí a f'ìgbàgbọ́́ 'rẹlẹ̀"},{"start":24.206,"end":25.313,"text":"W'anu at'ipa Re","marked":"W'ánú àt'ipá Rẹ"},{"start":25.693,"end":27.012,"text":"Awa o si ri igbala","marked":"Àwa ò sì rí ìgbàlà"},{"start":27.392,"end":28.736,"text":"L'akoko iyonu.","marked":"L'àkókò ìyọnu."},{"start":29.116,"end":29.663,"text":"Amin.","marked":"Àmín."}],"end":29.663}]}