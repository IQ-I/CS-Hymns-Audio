{"v":1,"coll":"y","num":337,"id":"hymn_337","title":"KINI 'Simi ayo ailopin ni","duration":78.222,"voices":{"male":{"file":"y-337-male.m4a","bytes":585999,"sha256":"e96cdc72951437434e87d9af84fd498806a4c4076a722212f6343c67b3460de6","duration":78.3},"female":{"file":"y-337-female.m4a","bytes":602975,"sha256":"0aa31ca0f5c20a8b33fbf636dd76b7aec27d600db3cdb539d9d3bc9c42445e06","duration":78.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.441,"text":"KINI 'Simi ayo ailopin ni","marked":"Kíni 'Ṣímí ayọ̀ àìlópin ni"},{"start":2.821,"end":4.662,"text":"T'awon Angeli at'awon mimo ni?","marked":"T'áwọn Áńgẹ́lì àtàwọn mímọ́́ ni?"},{"start":5.042,"end":7.678,"text":"Simi f'alare, f'awon asegun","marked":"Símì f'aláre, f'àwọn aṣẹ́gun"},{"start":8.058,"end":9.968,"text":"Nibe I'Olorun je ohun gbogbo.","marked":"Níbẹ̀ l'Ọlọ́run jẹ́ ohun gbogbo."}],"end":9.968},{"key":"2","start":10.918,"lines":[{"start":10.918,"end":13.143,"text":"Tal' Oba na? tani yi 'te re ka","marked":"Tal' Ọba ná? tani yí 'tẹ̀ rẹ́ ká"},{"start":13.523,"end":15.252,"text":"Irora itura Re na ti'ri?","marked":"Ìrora ìtura Rẹ ná ti'ri?"},{"start":15.632,"end":18.446,"text":"So funni, enyin ti njosin nibe","marked":"Sọ fúnni, ẹnyin ti ńjọsìn níbẹ̀"},{"start":18.826,"end":21.689,"text":"So funni, b' oro to t'ayo nyin so.","marked":"Sọ fúnni, b' ọ̀rọ̀ tó t'àyò nyin so."}],"end":21.689},{"key":"3","start":22.639,"lines":[{"start":22.639,"end":24.94,"text":"Jerusalem toto, ilu mimo","marked":"Jerusalem toto, ìlú mímọ́́"},{"start":25.32,"end":28.383,"text":"Alafia eyi t'o je kik'ayo","marked":"Àlàáfíà èyí t'ó jẹ́ kík'àyò"},{"start":28.763,"end":30.889,"text":"A r'ohun t'a nfe n'nu re k'a to wi","marked":"A r'ohun t'á ńfẹ́ ń'nú rẹ̀ k'á tó wí"},{"start":31.269,"end":33.577,"text":"A si ri gba ju eyi t'a nfe lo.","marked":"A sì rí gbà ju èyí t'á ńfẹ́ lọ."}],"end":33.577},{"key":"4","start":34.527,"lines":[{"start":34.527,"end":36.801,"text":"L'agbala Oba wa, wahala tan","marked":"L'ágbálà Ọba wa, wàhálà tán"},{"start":37.181,"end":39.255,"text":"Laiberu l'ao ma korin Sion","marked":"Láìbẹ̀rù l'áo má kọrin Sion"},{"start":39.635,"end":41.917,"text":"Oluwa, niwaju Re l'a o ma fi","marked":"Olúwa, níwájú Rẹ l'á ò má fi"},{"start":42.297,"end":44.012,"text":"Idahun 'fe han f 'ebun ife Re.","marked":"Ìdáhùn 'fẹ́ hàn f 'ẹ̀bùn ìfẹ́ Rẹ."}],"end":44.012},{"key":"5","start":44.962,"lines":[{"start":44.962,"end":46.935,"text":"Simi ko le tele 'simi nibe","marked":"Símì kò lè tẹ́lẹ̀ 'simi níbẹ̀"},{"start":47.315,"end":49.416,"text":"Enikan ni 'simi ti nwoju Re","marked":"Ẹnìkan ni 'simi ti ńwọ́jú Rẹ̀"},{"start":49.796,"end":51.568,"text":"Nibe orin jubeli ko le tan","marked":"Níbẹ̀ orin jùbẹ̀lì kò lè tán"},{"start":51.948,"end":53.63,"text":"T'awon mimo at'angeli y'o ko.","marked":"T'àwọn mímọ́ àt'áńgẹ́lì y'ó kọ́."}],"end":53.63},{"key":"6","start":54.58,"lines":[{"start":54.58,"end":57.439,"text":"Laiye yi, pelu 'gbagbo at'adua","marked":"Láìyé yí, pẹ̀lú 'gbàgbọ́ àt'àdùà"},{"start":57.819,"end":60.274,"text":"L'a o ma safer 'le Baba ohun","marked":"L'á ò má safer 'lé Bàbá ọ̀hún"},{"start":60.654,"end":63.066,"text":"Si Salem l'awon ti a si nipo","marked":"Sí Salem l'àwọn tí a ṣí nípò"},{"start":63.446,"end":65.8,"text":"Npada lo; lat' ilu Babiloni.","marked":"Npadà lọ; lát' ìlú Bábílónì."}],"end":65.8},{"key":"7","start":66.75,"lines":[{"start":66.75,"end":68.493,"text":"Nje awa teriba niwaju Re","marked":"Ǹjẹ́ àwa tẹríbà níwájú Rẹ"},{"start":68.873,"end":70.713,"text":"T'Eniti ohun gbogbo jasi","marked":"T'Eniti ohun gbogbo jásí"},{"start":71.093,"end":73.049,"text":"Ninu eniti Baba at'Omo","marked":"Nínú ẹniti Bàbá àt'Ọmọ"},{"start":73.429,"end":75.724,"text":"T'eniti Emi je Okansoso lai.","marked":"T'ẹniti Èmi jẹ́ Ọ̀kanṣoṣo láì."},{"start":76.104,"end":76.672,"text":"Amin.","marked":"Àmín."}],"end":76.672}]}