{"v":1,"coll":"y","num":864,"id":"hymn_864","title":"EMI alagbara","duration":45.041,"voices":{"male":{"file":"y-864-male.m4a","bytes":315669,"sha256":"b25e9d4c970d855df315118827645eba424ca198b853ebb97063ba923352028d","duration":45.1},"female":{"file":"y-864-female.m4a","bytes":331721,"sha256":"713e961c6c530ea317e02e561518d07ccef9abba97b4afbc18618f6c8d216c06","duration":45.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.218,"text":"EMI alagbara","marked":"Ẹ̀mí alágbára"},{"start":1.598,"end":2.791,"text":"Wa joko ninu mi","marked":"Wá jókò nínú mi"},{"start":3.171,"end":4.988,"text":"Ki o si fun wa n'idande","marked":"Kí o sì fún wa ń'ìdáǹdè"},{"start":5.368,"end":6.554,"text":"Low' eru on ese.","marked":"Lọ́w' ẹ̀rù ọ́n ẹ̀ṣẹ̀."}],"end":6.554},{"key":"2","start":7.504,"lines":[{"start":7.504,"end":8.654,"text":"Emi lmarale","marked":"Èmi lmarale"},{"start":9.034,"end":10.238,"text":"Gbe arun ese lo","marked":"Gbé àrùn ẹsẹ̀ lọ"},{"start":10.618,"end":11.76,"text":"Emi iwa-Mimo pipe","marked":"Ẹ̀mí ìwà-Mímọ́ pípé"},{"start":12.14,"end":13.451,"text":"Emi ife pipe.","marked":"Ẹ̀mí ìfẹ́ pípé."}],"end":13.451},{"key":"3","start":14.401,"lines":[{"start":14.401,"end":15.534,"text":"M'ojo na yara de","marked":"M'ọjọ́ ná yára dé"},{"start":15.914,"end":16.992,"text":"Ti a run ese mi","marked":"Tí a rún ẹsẹ̀ mi"},{"start":17.372,"end":19.231,"text":"T'ohun atijo y'o koja","marked":"T'ohun àtijọ́ y'ó kọjá"},{"start":19.611,"end":20.8,"text":"T'ohun gbogbo d'otun.","marked":"T'ohun gbogbo d'ótun."}],"end":20.8},{"key":"4","start":21.75,"lines":[{"start":21.75,"end":22.747,"text":"Ese abinibi","marked":"Ẹ̀ṣẹ̀ àbínibí"},{"start":23.127,"end":23.988,"text":"Pare li okan mi","marked":"Paré li ọkàn mi"},{"start":24.368,"end":26.467,"text":"Wole, ki O si le jade","marked":"Wọlé, kí O sì lè jáde"},{"start":26.847,"end":28.003,"text":"Gba gbogbo okan mi kan.","marked":"Gba gbogbo ọkàn mi kan."}],"end":28.003},{"key":"5","start":28.953,"lines":[{"start":28.953,"end":29.956,"text":"Oluwa mo fe ni","marked":"Olúwa mo fẹ́ ní"},{"start":30.336,"end":31.694,"text":"Eri pe mo nse 're","marked":"Ẹ̀rí pé mo ńṣe 're"},{"start":32.074,"end":33.788,"text":"Gege bi 'fe at'oro Re","marked":"Gẹ́gẹ́ bí 'fẹ́ àt'ọ̀rọ̀ Rẹ"},{"start":34.168,"end":35.348,"text":"B'o ti to loju Re.","marked":"B'ó ti tó lójú Rẹ."}],"end":35.348},{"key":"6","start":36.298,"lines":[{"start":36.298,"end":37.316,"text":"Nko fe ipo giga","marked":"Nkò fẹ́ ipò gíga"},{"start":37.696,"end":39.108,"text":"Sa fi eyi ke mi","marked":"Sá fi èyí kẹ́ mi"},{"start":39.488,"end":41.034,"text":"Nigbakugba t'o ba si ya","marked":"Nígbàkugbà t'ó bá sì yá"},{"start":41.414,"end":42.484,"text":"Gba mi s'orun rere.","marked":"Gbà mí s'ọrùn rere."},{"start":42.864,"end":43.491,"text":"Amin.","marked":"Àmín."}],"end":43.491}]}