{"v":1,"coll":"y","num":372,"id":"hymn_372","title":"OLORI Ijo t'orun","duration":62.056,"voices":{"male":{"file":"y-372-male.m4a","bytes":457380,"sha256":"9653b743985c1a1a267441c2eb479d4c69bd710d0626c60a0f370437b221a2b1","duration":62.1},"female":{"file":"y-372-female.m4a","bytes":468453,"sha256":"4c04131b0203a10f76284fa56a5c4558e44100e342c234a9390c56906ffc196e","duration":62.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.513,"text":"OLORI Ijo t'orun","marked":"Olórí Ìjọ t'ọrun"},{"start":1.893,"end":3.416,"text":"L'ayo l'a wole fun O","marked":"L'àyò l'á wọlé fún Ọ"},{"start":3.796,"end":5.987,"text":"K'O to de, Ijo t'aiye","marked":"K'ó tó dé, Ìjọ t'áiye"},{"start":6.367,"end":7.725,"text":"Y'o ma korin bi t'orun","marked":"Y'ó ma kọrin bí t'orun"},{"start":8.105,"end":9.5,"text":"A gbe okan wa s'oke","marked":"A gbé ọkàn wa s'òkè"},{"start":9.88,"end":11.395,"text":"Ni 'reti t'o ni 'bukun","marked":"Ní 'reti t'ó ní 'bùkún"},{"start":11.775,"end":13.806,"text":"Awa kigbe, awa f'iyin","marked":"Àwa kígbe, àwa f'ìyìn"},{"start":14.186,"end":15.353,"text":"F'Olorun igbala wa.","marked":"F'Ọlọ́run ìgbàlà wa."}],"end":15.353},{"key":"2","start":16.303,"lines":[{"start":16.303,"end":17.642,"text":"Gbat' a wa ninu iponju","marked":"Gbat' á wà nínú ìpọ́njú"},{"start":18.022,"end":19.23,"text":"T'a nkoja ninu ina","marked":"T'á ńkọjá nínú iná"},{"start":19.61,"end":20.957,"text":"Orin ife l'awa o ko","marked":"Orin ìfẹ́ l'áwá ò kò"},{"start":21.337,"end":22.503,"text":"Ti o nmu wa sunmoO","marked":"Tí ò ńmú wa sùnmọ̀Ọ́"},{"start":22.883,"end":24.761,"text":"Awa sope, a si yo","marked":"Àwa ṣọpẹ́, a sì yó"},{"start":25.141,"end":26.208,"text":"Ninu ojurere Re","marked":"Nínú ojúrere Rẹ"},{"start":26.588,"end":28.396,"text":"lfe t'o so wa di Tire","marked":"lfẹ́ t'ó sọ wá di Tìrẹ"},{"start":28.776,"end":30.492,"text":"Y'o se wa ni Tire lai.","marked":"Y'ó ṣe wà ní Tírè láì."}],"end":30.492},{"key":"3","start":31.442,"lines":[{"start":31.442,"end":32.816,"text":"lwo mu awon enia Re","marked":"lwo mú àwọn enia Rẹ"},{"start":33.196,"end":34.646,"text":"Koja isan idanwo","marked":"Kọjá iṣan ìdánwò"},{"start":35.026,"end":36.358,"text":"“Tori O wa nitosi","marked":"Torí Ó wà nítòsí"},{"start":36.738,"end":39.028,"text":"Aiye, ese, at'esu","marked":"Aiye, ẹsẹ̀, àt'èṣù"},{"start":39.408,"end":40.579,"text":"Kojuja si wa lasan","marked":"Kọ́jújà sì wá lásán"},{"start":40.959,"end":43.428,"text":"L' agbara Re, a o segun","marked":"L' agbára Rẹ, a ó ṣẹ́gun"},{"start":43.808,"end":45.122,"text":"A o si ko orin Mose.","marked":"A ò sì kọ orin Mósè."}],"end":45.122},{"key":"4","start":46.072,"lines":[{"start":46.072,"end":47.428,"text":"Awa f'igbagbo r'ogo","marked":"Àwa f'ìgbàgbọ́́ r'ògo"},{"start":47.808,"end":49.34,"text":"T'O tun nfe fi wa si","marked":"T'ó tún ńfẹ́ fi wá sí"},{"start":49.72,"end":51.09,"text":"A kegan aiye 'tori","marked":"A kẹ́gàn aiye 'torí"},{"start":51.47,"end":52.65,"text":"Ere nla iwaju wa","marked":"Èrè ńlá iwájú wa"},{"start":53.03,"end":54.353,"text":"Bi O ba si ka wa ye","marked":"Bí Ó bá sì kà wá yé"},{"start":54.733,"end":56.693,"text":"Awa pelu Stefen t'o ku","marked":"Àwa pelu Stefen t'ó kú"},{"start":57.073,"end":58.63,"text":"Y'o ri O bi O ti duro","marked":"Y'ó rí O bí O ti dúró"},{"start":59.01,"end":60.507,"text":"Lati pe wa lo s'orun.","marked":"Láti pè wá lọ s'ọrun."}],"end":60.507}]}