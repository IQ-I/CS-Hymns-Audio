{"v":1,"coll":"y","num":203,"id":"hymn_203","title":"AYO kun okan wa loni","duration":40.289,"voices":{"male":{"file":"y-203-male.m4a","bytes":285346,"sha256":"c1fc7a4ac38bd094a8c18b4e21e988cb317db649d77a4d49cf338c9dbb708976","duration":40.3},"female":{"file":"y-203-female.m4a","bytes":292983,"sha256":"80607e03bd60003a3e2359764b1c2862aca2e4e4a5440b75b0c3c1427e156b32","duration":40.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.694,"text":"AYO kun okan wa loni,","marked":"Ayọ̀ kún ọkàn wa lónì"},{"start":2.074,"end":3.006,"text":"A bi Omo Oba!","marked":"A bí Ọmọ Ọba!"},{"start":3.386,"end":4.507,"text":"Opo awon ogun orun,","marked":"Ọ̀pọ̀ àwọn ogun ọ̀run"},{"start":4.887,"end":6.128,"text":"Nso ibi Re loni.","marked":"Nsọ ibi Rẹ lónì."}],"end":6.128},{"key":"CHORUS","start":7.078,"lines":[{"start":7.078,"end":9.999,"text":"E yo, Eyo, Olorun d' enia,","marked":"Ẹ yọ̀, Ẹyọ̀, Ọlọ́run d' enia"},{"start":10.379,"end":11.471,"text":"O wa joko I'aiye,","marked":"Ó wá jókò l'aiye"},{"start":11.851,"end":13.762,"text":"Oruko wo l' o dun to yi","marked":"Orúkọ wo l' ó dùn tó yí"},{"start":14.142,"end":15.112,"text":"Emmanuel.","marked":"Emmanuel."}],"end":15.112},{"key":"2","start":16.062,"lines":[{"start":16.062,"end":17.511,"text":"A wole n' ibujee eran,","marked":"A wọlé ń' ibùjẹ̀ẹ́ ẹran"},{"start":17.891,"end":19.257,"text":"N'iyanu l' a josin:","marked":"N'ìyanu l' á jọ́sìn"},{"start":19.637,"end":21.539,"text":"lbukun kan to ta 'yi yo,","marked":"lbukun kan tó ta 'yí yọ"},{"start":21.919,"end":23.38,"text":"Ko s' ayo bi eyi.","marked":"Kò s' ayọ̀ bí èyí."}],"end":23.38},{"key":"3","start":24.33,"lines":[{"start":24.33,"end":25.878,"text":"Aiye ko n' adun fun wa mo,","marked":"Aiye kò ń' adùn fún wa mọ́"},{"start":26.258,"end":27.702,"text":"'Gbati a ba nwo O:","marked":"'Gbàtì a bá ńwò O"},{"start":28.082,"end":29.362,"text":"L'owo Wundia Iya Re,","marked":"L'ọ́wọ́ Wúńdíá Ìyá Rẹ"},{"start":29.742,"end":30.766,"text":"'Wo Omo Iyanu.","marked":"'Wo Ọmọ Ìyanu."}],"end":30.766},{"key":"4","start":31.716,"lines":[{"start":31.716,"end":33.383,"text":"Imole lat' inu “Mole,","marked":"Ìmọ́lẹ̀̀ lát' inú Mole"},{"start":33.763,"end":34.974,"text":"Tan 'mole s'okun wa;","marked":"Tan 'mole s'òkun wa"},{"start":35.354,"end":36.984,"text":"K' a le ma fi isin mimo,","marked":"K' á lè má fi ìsìn mímọ́́"},{"start":37.364,"end":38.739,"text":"Se' ranti ojo Re.","marked":"Ṣe' rántí ọjọ́ Rẹ."}],"end":38.739}]}