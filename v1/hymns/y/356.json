{"v":1,"coll":"y","num":356,"id":"hymn_356","title":"ALABUKUN n'nu Jesu","duration":35.018,"voices":{"male":{"file":"y-356-male.m4a","bytes":240576,"sha256":"eb933c383c2abf2298f22a354af71320cf6a699a541f905f4b3ad48771f61985","duration":35.1},"female":{"file":"y-356-female.m4a","bytes":249236,"sha256":"a5f59590078c5aa94eb525a0464899dba7beb9aa110ad515b9b105655df35236","duration":35.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.767,"text":"ALABUKUN n'nu Jesu","marked":"Alábùkún ń'nú Jésù"},{"start":2.147,"end":3.138,"text":"Ni awon om'Olorun","marked":"Ní àwọn om'Ọlọ́run"},{"start":3.518,"end":5.09,"text":"Ti a fi eje re ra","marked":"Tí a fi ẹ̀jẹ̀ rẹ̀ rà"},{"start":5.47,"end":6.985,"text":"Lat' inu iku s'iye.","marked":"Lát' inú ikú s'iye."}],"end":6.985},{"key":"CHORUS","start":7.935,"lines":[{"start":7.935,"end":9.165,"text":"A ba je ka wa mo won","marked":"Á bá jẹ́ ká wá mọ̀ wọ́n"},{"start":9.545,"end":11.273,"text":"L'aiye yi, ati I'orun.","marked":"L'áiye yí, àti l'ọrun."}],"end":11.273},{"key":"2","start":12.223,"lines":[{"start":12.223,"end":13.583,"text":"Awon ti a da l'are","marked":"Àwọn tí a da l'are"},{"start":13.963,"end":15.096,"text":"Nipa ore-ofe Re","marked":"Nípa ọrẹ-ọ̀fẹ́ Rẹ"},{"start":15.476,"end":16.827,"text":"A we gbogbo ese won","marked":"A wé gbogbo ẹ̀ṣẹ̀ wọn"},{"start":17.207,"end":18.823,"text":"Nwon o bo lojo 'dajo.","marked":"Nwọn ò bọ́ lọ́jọ́ 'dájọ́."}],"end":18.823},{"key":"3","start":19.773,"lines":[{"start":19.773,"end":21.233,"text":"Nwon s'eso ore-ofe","marked":"Nwọn s'èso ọrẹ-ọ̀fẹ́"},{"start":21.613,"end":22.836,"text":"Ninu ise ododo","marked":"Nínú iṣẹ́ òdodo"},{"start":23.216,"end":24.238,"text":"Irira l'ese si won","marked":"Ìríra l'ẹsẹ̀ sí wọn"},{"start":24.618,"end":25.993,"text":"Or'Olorun ngbe 'nu won.","marked":"Or'Ọlọ́run ńgbé 'nu wọn."}],"end":25.993},{"key":"4","start":26.943,"lines":[{"start":26.943,"end":28.171,"text":"Nipa Ej'Odagutan","marked":"Nípa Ẹ̀j'Ọ̀dàgùtàn"},{"start":28.551,"end":29.822,"text":"Nwon mba Olorun kegbe","marked":"Nwọ̀n ḿbá Ọlọ́run kẹ́gbẹ́"},{"start":30.202,"end":31.576,"text":"Pelu Ola-nla Jesus","marked":"Pẹ̀lú Ọlá-ńlá Jésù"},{"start":31.956,"end":33.468,"text":"A wo won l'aso ago.","marked":"A wò wọ́n l'aṣọ àgọ́."}],"end":33.468}]}