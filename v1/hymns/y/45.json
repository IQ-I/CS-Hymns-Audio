{"v":1,"coll":"y","num":45,"id":"hymn_45","title":"MO ntoro nkan lodo Kristi","duration":49.818,"voices":{"male":{"file":"y-45-male.m4a","bytes":362888,"sha256":"f80ea821b61dfdb0664a77d29a5857973aee52e028945504bd9cac6bd2ef963c","duration":49.9},"female":{"file":"y-45-female.m4a","bytes":371609,"sha256":"588f2886056a1fae98fb715fd96676ea3d7eccd3448b88ff014f6f8a57413651","duration":49.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.019,"text":"MO ntoro nkan lodo Kristi,","marked":"Mo ńtọrọ nkan lọ́dọ̀ Kristi"},{"start":2.399,"end":3.624,"text":"'Tori ere po lona mi,","marked":"'Torí eré pọ̀ lọ́nà mi"},{"start":4.004,"end":5.37,"text":"Yala pe lomi tab'ina","marked":"Yálà pé lomi tab'ina"},{"start":5.75,"end":7.444,"text":"Sa we mi mo, sa we mi mo.","marked":"Sá wẹ̀ mí mọ́, sá wẹ̀ mí mọ́."}],"end":7.444},{"key":"CHORUS","start":8.394,"lines":[{"start":8.394,"end":10.154,"text":"Jo, we mi mo-t'ara t'okan","marked":"Jó, wé mi mọ́-t'ara t'ọ̀kan"},{"start":10.534,"end":12.342,"text":"Ngo ko ina - bo ba gba be","marked":"Ngo kó iná bó bá gbà bẹ́"},{"start":12.722,"end":14.309,"text":"Ona-kona Io dun mo mi,","marked":"Ọ̀nà-kọ́nà ló dùn mọ́ mi"},{"start":14.689,"end":16.574,"text":"K 'ese sa ku 'nu okan mi.","marked":"K 'ẹ̀ṣẹ̀ sá kù 'nú ọkàn mi."}],"end":16.574},{"key":"2","start":17.524,"lines":[{"start":17.524,"end":19.06,"text":"B'o ba f'iran didan han mi","marked":"B'ó bá f'iran dídán hàn mí"},{"start":19.44,"end":21.0,"text":"Ngo dupe inu mi yio dun","marked":"Ngo dúpẹ́ inú mi yìó dùn"},{"start":21.38,"end":22.95,"text":"Sugbon okan t'o mo gara","marked":"Ṣùgbọ́n ọkàn t'ó mọ́ gara"},{"start":23.33,"end":25.094,"text":"Ni mo fe ju, ni mo fe ju.","marked":"Ni mo fẹ́ jù, ni mo fẹ́ jù."},{"start":25.474,"end":26.53,"text":"Egbe: Jo, we mi mo...","marked":"Jọ, wẹ̀ mí mọ́"}],"end":26.53},{"key":"3","start":27.48,"lines":[{"start":27.48,"end":28.921,"text":"Nigbati okan mi ba mo,","marked":"Nígbàtí ọkàn mi bá mọ́"},{"start":29.301,"end":30.729,"text":"Iran didan yio han si mi,","marked":"Ìran dídán yìò hàn sí mi"},{"start":31.109,"end":32.451,"text":"Nitori okukun su bo","marked":"Nítorí òkùkùn ṣù bo"},{"start":32.831,"end":34.951,"text":"Iran orun, Iran orun.","marked":"Ìran ọ̀run, Iran ọ̀run."},{"start":35.331,"end":36.319,"text":"Egbe: Jo, we mi mo...","marked":"Jọ, wẹ̀ mí mọ́"}],"end":36.319},{"key":"4","start":37.269,"lines":[{"start":37.269,"end":39.168,"text":"Mo ndu ki nsa f'ona ese","marked":"Mo ńdú kí ńṣá f'ọ́nà ẹsẹ̀"},{"start":39.548,"end":41.142,"text":"Ki nsi yago f'ero ese","marked":"Kí nsì yàgò f'èrò ẹ̀ṣẹ̀"},{"start":41.522,"end":43.221,"text":"B'ijakadi mi ti to yi,","marked":"B'ìjàkadì mi ti tó yí"},{"start":43.601,"end":45.805,"text":"Sibe nko mo, sibe nko mo.","marked":"Síbẹ̀ ńkọ́ mọ́, síbẹ̀ ńkọ́ mọ́."},{"start":46.185,"end":47.338,"text":"Egbe: Jo, we mi mo...","marked":"Jọ, wẹ̀ mí mọ́"},{"start":47.718,"end":48.268,"text":"Amin.","marked":"Àmín."}],"end":48.268}]}