{"v":1,"coll":"y","num":814,"id":"hymn_814","title":"JESU, Oto Ona","duration":60.096,"voices":{"male":{"file":"y-814-male.m4a","bytes":421529,"sha256":"075da8b639059ee0202530076fd7a297f333f0b0b6884e922a718fc691b9a994","duration":60.1},"female":{"file":"y-814-female.m4a","bytes":441623,"sha256":"3ed048510c4830213d42d0488537ba7600a6237dafcdb9b636b94619558c0c60","duration":60.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.544,"text":"JESU, Oto Ona","marked":"Jésù, Ọ̀tọ̀ Ọ̀nà"},{"start":1.924,"end":3.149,"text":"Mole ni t'o daju","marked":"Mọ́lẹ̀ ní t'ó dájú"},{"start":3.529,"end":4.892,"text":"Gbe ese mi ailokun ro,","marked":"Gbé ẹsẹ̀ mi àìlókun ró"},{"start":5.272,"end":6.351,"text":"To mi s'ona tito.","marked":"Tọ́ mi s'ọ́nà títọ́."}],"end":6.351},{"key":"2","start":7.301,"lines":[{"start":7.301,"end":8.518,"text":"Ogbon at' Amona","marked":"Ọgbọ́n àt' Amọ̀nà"},{"start":8.898,"end":9.84,"text":"Oludamoran mi","marked":"Olùdámọ̀ràn mi"},{"start":10.22,"end":11.848,"text":"Ma je ki nfi O sile lai","marked":"Má jẹ́ kí nfi Ọ́ sílẹ̀ láì"},{"start":12.228,"end":13.54,"text":"Tabi ki nsako lo.","marked":"Tàbí kí nṣáko lọ."}],"end":13.54},{"key":"3","start":14.49,"lines":[{"start":14.49,"end":15.618,"text":"Mo gb'oju mi soke","marked":"Mo gb'ojú mi sókè"},{"start":15.998,"end":17.687,"text":"Wo O, Od'agutan","marked":"Wò Ó, Od'agutan"},{"start":18.067,"end":19.605,"text":"Ki O ba le la mi l'oye","marked":"Kí O bá lè là mí l'òye"},{"start":19.985,"end":21.338,"text":"K'oju mase ti mi.","marked":"K'ojú máṣe tì mí."}],"end":21.338},{"key":"4","start":22.288,"lines":[{"start":22.288,"end":23.625,"text":"Nki o gba oran mi","marked":"Nkí ó gba ọ̀ràn mi"},{"start":24.005,"end":24.944,"text":"Kuro ii owo Re","marked":"Kúrò ìí ọwọ́ Rẹ"},{"start":25.324,"end":26.683,"text":"Ngo simi le 'fe rapada","marked":"Ngo simi le 'fẹ́ ràpadà"},{"start":27.063,"end":28.461,"text":"Ngo ro m'agbelebu.","marked":"Ngo ro m'àgbélébùú."}],"end":28.461},{"key":"5","start":29.411,"lines":[{"start":29.411,"end":30.688,"text":"Ko mi ki nmo adun","marked":"Kò mì kí nmọ adùn"},{"start":31.068,"end":32.12,"text":"Ati gbekele O","marked":"Àti gbẹ́kẹ̀lé O"},{"start":32.5,"end":34.449,"text":"Jo, Oluwa, mase ya mi","marked":"Jó, Olúwa, máṣe yá mi"},{"start":34.829,"end":36.25,"text":"Sugbon fe mi d'opin.","marked":"Ṣùgbọ́n fẹ́ mi d'òpin."}],"end":36.25},{"key":"6","start":37.2,"lines":[{"start":37.2,"end":38.278,"text":"Mu mi la 'danwo ja","marked":"Mú mi là 'dánwò já"},{"start":38.658,"end":39.669,"text":"De 'le alafia;","marked":"Dé 'lé àlàáfíà"},{"start":40.049,"end":41.737,"text":"Si ko mi li orin titun","marked":"Sì kọ́ mi li orin titun"},{"start":42.117,"end":43.394,"text":"Gba mo ba di pipe.","marked":"Gbà mo bá di pípé."}],"end":43.394},{"key":"7","start":44.344,"lines":[{"start":44.344,"end":45.384,"text":"Jeki nle dabi Re","marked":"Jèkì ńlẹ̀ dàbí Rẹ"},{"start":45.764,"end":46.981,"text":"Ki nto se alaisi","marked":"Kí ńtó ṣe aláìsí"},{"start":47.361,"end":48.895,"text":"Fi ese mi mule sinsin","marked":"Fi ẹsẹ̀ mi múlẹ̀ ṣinṣin"},{"start":49.275,"end":50.68,"text":"Ki ndagba n'nu ife.","marked":"Kí ndagba ń'nú ìfẹ́."}],"end":50.68},{"key":"8","start":51.63,"lines":[{"start":51.63,"end":52.867,"text":"Jeki nj'eleri Re","marked":"Jẹki nj'eleri Rẹ"},{"start":53.247,"end":54.519,"text":"Gbat'ese ba run tan","marked":"Gbat'ẹsẹ̀ bá rún tán"},{"start":54.899,"end":56.756,"text":"Gba okan mi ailabawon","marked":"Gba ọkàn mi ailabawon"},{"start":57.136,"end":58.546,"text":"K'O si mu mi d'orun.","marked":"K'ó sì mú mi d'ọ̀run."}],"end":58.546}]}