{"v":1,"coll":"y","num":246,"id":"hymn_246","title":"JlNA s'ile orun","duration":39.185,"voices":{"male":{"file":"y-246-male.m4a","bytes":274621,"sha256":"ec866bb6d5861b3e1c43826060ffcd42d66172acd71e3f20c56568765cc15b52","duration":39.2},"female":{"file":"y-246-female.m4a","bytes":285529,"sha256":"e749f3c31d5790904a7ae4f7ff4582783fa32740f248232748bd629b2e87c5f7","duration":39.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.373,"text":"JlNA s'ile orun","marked":"JlNA s'ílẹ̀ ọ̀run"},{"start":1.753,"end":3.378,"text":"S'okan aiya Baba","marked":"S'ọ́kan àìyá Bàbá"},{"start":3.758,"end":5.876,"text":"Emi 'bukun wa, mo ndaku","marked":"Èmi 'bùkún wa, mo ndaku"},{"start":6.256,"end":7.327,"text":"Mu mi re 'bi simi.","marked":"Mú mi rẹ 'bí sìmi."}],"end":7.327},{"key":"2","start":8.277,"lines":[{"start":8.277,"end":9.397,"text":"Mo fi duru mi ko","marked":"Mo fi dùrù mi kọ"},{"start":9.777,"end":10.847,"text":"S'Ori igi willo","marked":"S'Orí igi willo"},{"start":11.227,"end":13.337,"text":"Ngo se korin ayo, gbati","marked":"Ngo ṣe kọrin ayọ̀, gbatí"},{"start":13.717,"end":15.002,"text":"'Wo koi t'ahon mi se.","marked":"'Wò kòí t'ahọ́n mi ṣe."}],"end":15.002},{"key":"3","start":15.952,"lines":[{"start":15.952,"end":16.88,"text":"Emi mi lo sile","marked":"Ẹ̀mí mi lọ sílé"},{"start":17.26,"end":18.86,"text":"A! mba le fo de 'be","marked":"A! ḿbá lè fò dé 'bẹ̀"},{"start":19.24,"end":20.924,"text":"Ayun re nyun mi 'wo Sion","marked":"Ayùn rẹ̀ nyùn mi 'wò Sion"},{"start":21.304,"end":22.452,"text":"Gba mo ba ranti re.","marked":"Gbà mo bá rántí rẹ."}],"end":22.452},{"key":"4","start":23.402,"lines":[{"start":23.402,"end":24.61,"text":"Sodo re mo nt'ona","marked":"Ṣọ́dọ̀ rẹ mọ nt'ona"},{"start":24.99,"end":26.138,"text":"T'o kun fun isoro","marked":"T'ó kún fún ìṣòro"},{"start":26.518,"end":28.106,"text":"“Gbawo ni ngo koj' aginju","marked":"Gbawọ́ ní ngo kój' aginjù"},{"start":28.486,"end":29.485,"text":"De 'le awon mimo?","marked":"Dé 'lé àwọn mímọ́́?"}],"end":29.485},{"key":"5","start":30.435,"lines":[{"start":30.435,"end":31.642,"text":"Sunmo mi, Olorun","marked":"Súnmọ́ mi, Ọlọ́run"},{"start":32.022,"end":33.184,"text":"'Wo ni mo gbekele","marked":"'Wò ni mo gbẹ́kẹ̀lé"},{"start":33.564,"end":35.077,"text":"Sin mi la aginju aiye","marked":"Sin mí la aginjù aiye"},{"start":35.457,"end":36.748,"text":"Ki m'de 'le nikehin.","marked":"Kí m'de 'le níkẹhin."},{"start":37.128,"end":37.636,"text":"Amin.","marked":"Àmín."}],"end":37.636}]}