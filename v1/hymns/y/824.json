{"v":1,"coll":"y","num":824,"id":"hymn_824","title":"JEKA layo ninu Jesu","duration":71.715,"voices":{"male":{"file":"y-824-male.m4a","bytes":514189,"sha256":"8c6f7c640186051486a2f4acae4b1bd2dffc3b3ade45905b8a430462c383d013","duration":71.8},"female":{"file":"y-824-female.m4a","bytes":533028,"sha256":"223f850608bc693db781d4fadba466e1eccd6ecd59d3c1a60bb47d4633a1cd40","duration":71.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.438,"text":"JEK' A l'ayo ninu Jesu","marked":"Jẹ́k' A l'áyò nínú Jésù"},{"start":2.818,"end":4.207,"text":"Oba Alayo ni Jesu","marked":"Ọba Aláyọ̀ ni Jésù"},{"start":4.587,"end":6.168,"text":"Enikeni ti ba r'ayo Re gba","marked":"Ẹnikẹ́ni tí bá r'àyò Rẹ gbà"},{"start":6.548,"end":8.159,"text":"Banuje re y'o si fo lo.","marked":"Banújẹ́ rẹ y'ó sì fò lọ."}],"end":8.159},{"key":"2","start":9.109,"lines":[{"start":9.109,"end":10.594,"text":"Wo sa gba Oruko Re gbo","marked":"Wọ́ sá gba Orúkọ Rẹ̀ gbọ́"},{"start":10.974,"end":12.329,"text":"Ki o si tun gbekele","marked":"Kí o sì tún gbẹ́kẹ̀lé"},{"start":12.709,"end":15.156,"text":"Ko si m'adura to wa nin'eje Re","marked":"Kò sí m'àdúrà tó wà nín'ẹ̀jẹ̀ Rẹ"},{"start":15.536,"end":17.223,"text":"Banuje re y'o si fo lo.","marked":"Banújẹ́ rẹ y'ó sì fò lọ."}],"end":17.223},{"key":"3","start":18.173,"lines":[{"start":18.173,"end":19.732,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":20.112,"end":21.71,"text":"Wo ha tun nbanuje bi?","marked":"Wo ha tún ńbanújẹ́ bí?"},{"start":22.09,"end":25.093,"text":"Kristi nso fun o, ke Halleluyah","marked":"Kristi nso fún ọ, ké Hallelúyà"},{"start":25.473,"end":27.166,"text":"Banuje re y'o si fo lo.","marked":"Banújẹ́ rẹ y'ó sì fò lọ."}],"end":27.166},{"key":"4","start":28.116,"lines":[{"start":28.116,"end":29.775,"text":"Esu lo ha nderu ba o?","marked":"Èṣù ló ha ńdẹ́rù bà ọ́?"},{"start":30.155,"end":31.687,"text":"Oso tabi aje ni?","marked":"Ọ̀ṣọ́ tàbí àjẹ́ ni?"},{"start":32.067,"end":34.025,"text":"Pe Oruko Jesu nigbagbogbo","marked":"Pé Orúkọ Jésù nígbàgbogbo"},{"start":34.405,"end":36.007,"text":"Banuje re y'o si fo lo.","marked":"Banújẹ́ rẹ y'ó sì fò lọ."}],"end":36.007},{"key":"5","start":36.957,"lines":[{"start":36.957,"end":38.338,"text":"K'a ni ife gbogbo aiye","marked":"K'á ní ìfẹ́ gbogbo aiye"},{"start":38.718,"end":40.147,"text":"Ki se s'omo egbe nikan","marked":"Kí ṣe s'ọmọ ẹgbẹ́ nìkan"},{"start":40.527,"end":42.821,"text":"Gbana adura re y'o si goke","marked":"Gbaná àdúrà rẹ y'ó sì gòkè"},{"start":43.201,"end":44.867,"text":"Banuje re y'o si fo lo.","marked":"Banújẹ́ rẹ y'ó sì fò lọ."}],"end":44.867},{"key":"6","start":45.817,"lines":[{"start":45.817,"end":47.219,"text":"Gbogbo enyin eda aiye","marked":"Gbogbo enyin ẹ̀dá aiye"},{"start":47.599,"end":48.84,"text":"Juba oruko Jesu","marked":"Júbà orúkọ Jésù"},{"start":49.22,"end":51.07,"text":"Oruko yi to fun banuje re","marked":"Orúkọ yí tó fún bànújẹ́ rẹ̀"},{"start":51.45,"end":53.215,"text":"Banuje re y'o si fo lo.","marked":"Banújẹ́ rẹ y'ó sì fò lọ."}],"end":53.215},{"key":"7","start":54.165,"lines":[{"start":54.165,"end":55.722,"text":"Ranti pe On l'Eni Yanu","marked":"Rántí pé On l'Ẹ́ni Yanu"},{"start":56.102,"end":57.178,"text":"Oba Oludamoran","marked":"Ọba Olùdámọ̀ràn"},{"start":57.558,"end":59.567,"text":"Alagbara, Baba aiyeraiye","marked":"Alágbára, Bàbá aiyérayé"},{"start":59.947,"end":61.058,"text":"Alade Alafia.","marked":"Aládé Àlàáfíà."}],"end":61.058},{"key":"8","start":62.008,"lines":[{"start":62.008,"end":63.212,"text":"A f'ogo fun Baba l'oke","marked":"A f'ògo fún Bàbá l'òkè"},{"start":63.592,"end":64.764,"text":"A f'ogo fun Omo Re","marked":"A f'ògo fún Ọmọ Rẹ"},{"start":65.144,"end":67.257,"text":"Ogo ni fun Emi t'o ndari wa","marked":"Ògo ni fún Èmi t'ó ndari wa"},{"start":67.637,"end":69.284,"text":"Metalokan wa gb'ope wa.","marked":"Mẹ́talọ́kan wa gb'ọpẹ́ wa."},{"start":69.664,"end":70.165,"text":"Amin.","marked":"Àmín."}],"end":70.165}]}