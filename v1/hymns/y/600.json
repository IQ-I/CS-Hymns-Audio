{"v":1,"coll":"y","num":600,"id":"hymn_600","title":"ENYIN enia Olorun","duration":40.331,"voices":{"male":{"file":"y-600-male.m4a","bytes":287486,"sha256":"4ebdb5a64b85496e828f01c31607b76f7d0f7c087df56acceb1d341408cba9df","duration":40.4},"female":{"file":"y-600-female.m4a","bytes":294797,"sha256":"a008af3b64023f0c89fa4f6d73f1f17e864bdd0638574eb002629e3ded000b84","duration":40.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.613,"text":"ENYIN enia Olorun","marked":"Enyin enia Ọlọ́run"},{"start":1.993,"end":3.433,"text":"Okunkun yi aiye ka","marked":"Òkùnkùn yí àìyẹ ká"},{"start":3.813,"end":5.596,"text":"So hun ayo ti Jesu","marked":"Sọ hun ayọ̀ tí Jésù"},{"start":5.976,"end":7.495,"text":"Ni gbogb' orile ede.","marked":"Ní gbogb' orílẹ̀ èdè."}],"end":7.495},{"key":"CHORUS","start":8.445,"lines":[{"start":8.445,"end":10.584,"text":"Ihin ayo, Ihin ayo","marked":"Ìhìn ayò, Ìhìn ayò"},{"start":10.964,"end":12.299,"text":"Ti 'toye Olugbala.","marked":"Ti 'tóye Olùgbàlà."}],"end":12.299},{"key":"2","start":13.249,"lines":[{"start":13.249,"end":14.557,"text":"Ma tiju ihinrere Re,","marked":"Má tijú ìhìnrere Rẹ"},{"start":14.937,"end":16.164,"text":"Agbara Olorun ni","marked":"Agbára Ọlọ́run ni"},{"start":16.544,"end":18.443,"text":"N'ilu t'a ko wasu Jesu","marked":"N'ìlú t'á kò wáṣu Jésù"},{"start":18.823,"end":20.341,"text":"Kede dasile f'onde.","marked":"Kédé dasílẹ̀ f'òǹdè."}],"end":20.341},{"key":"3","start":21.291,"lines":[{"start":21.291,"end":23.201,"text":"B'aiye on Esu dimolu","marked":"B'aiye on Èṣù dìmọ̀lú"},{"start":23.581,"end":24.947,"text":"S'ise Olugbala wa,","marked":"S'iṣẹ́ Olùgbàlà wa"},{"start":25.327,"end":27.366,"text":"Ja fun ise Re, ma f'oiya","marked":"Jà fún iṣẹ́ Rẹ, má f'oíyá"},{"start":27.746,"end":28.935,"text":"Mase beru enia.","marked":"Masẹ̀ bẹ̀rù enia."}],"end":28.935},{"key":"4","start":29.885,"lines":[{"start":29.885,"end":31.51,"text":"Gbati ewu nla ba de si nyin","marked":"Gbátí ewu ńlá bá dé sí nyin"},{"start":31.89,"end":33.58,"text":"Jesu y'o dabobo nyin","marked":"Jésù y'ó dabobo nyin"},{"start":33.96,"end":35.622,"text":"Larin ota at'alejo","marked":"Lárin ọ̀tá àt'àlejò"},{"start":36.002,"end":37.75,"text":"Jesu y'o je Ore nyin.","marked":"Jésù y'ó jẹ́ Ọ̀rẹ́ nyin."},{"start":38.13,"end":38.781,"text":"Amin.","marked":"Àmín."}],"end":38.781}]}