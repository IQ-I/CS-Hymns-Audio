{"v":1,"coll":"y","num":139,"id":"hymn_139","title":"KERUBU e ho f'ayo","duration":57.449,"voices":{"male":{"file":"y-139-male.m4a","bytes":406214,"sha256":"7d89a301711c70d5e317bd3eb3c66026cd2665442a83460d9b88bda359f80c58","duration":57.5},"female":{"file":"y-139-female.m4a","bytes":424407,"sha256":"2deb57b039a05026883f2076dd0820f22c3026f33c51a344db9395895948e228","duration":57.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.83,"text":"KERUBU e ho f'ayo","marked":"Kérúbù ẹ̀ hó f'àyò"},{"start":2.21,"end":3.544,"text":"K'a f'ope f'Olorun wa,","marked":"K'á f'ọpẹ́ f'Ọlọ́run wa"},{"start":3.924,"end":5.181,"text":"Fun idasi wa oni,","marked":"Fún ìdásí wa ọ̀nì"},{"start":5.561,"end":6.998,"text":"Iyin fun Metalokan.","marked":"Ìyìn fún Mẹ́talọ́kan."}],"end":6.998},{"key":"CHORUS","start":7.948,"lines":[{"start":7.948,"end":10.724,"text":"E ho ye, Kerubu, e gbe 'rin","marked":"Ẹ họ́ yé, Kérúbù, ẹ gbé 'rin"},{"start":11.104,"end":14.033,"text":"E ho ye, Serafu, egbe 'rin","marked":"Ẹ họ́ yé, Séráfù, ẹgbẹ́ 'rin"},{"start":14.413,"end":16.097,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":16.477,"end":18.386,"text":"Halleluyah, s'Oba wa.","marked":"Hallelúyà, s'Ọba wa."}],"end":18.386},{"key":"2","start":19.336,"lines":[{"start":19.336,"end":20.646,"text":"Oluwa, gba ore wa","marked":"Olúwa, gba ọrẹ wa"},{"start":21.026,"end":22.439,"text":"Fun ajodun t'oni yi,","marked":"Fún àjọ̀dún t'ọ́ni yí"},{"start":22.819,"end":24.323,"text":"Ran 'bukun Re s'ori wa","marked":"Rán 'bùkún Rẹ s'orí wa"},{"start":24.703,"end":26.278,"text":"Fun wa ni ayo kikun.","marked":"Fún wa ní ayọ̀ kíkún."}],"end":26.278},{"key":"3","start":27.228,"lines":[{"start":27.228,"end":28.205,"text":"Yin Olorun Oba wa,","marked":"Yín Ọlọ́run Ọba wa"},{"start":28.585,"end":29.842,"text":"Egbe ohun iyin ga,","marked":"Ẹgbẹ́ ohun ìyìn ga"},{"start":30.222,"end":31.415,"text":"Fun ife ojojumo","marked":"Fún ìfẹ́ ojojumo"},{"start":31.795,"end":32.96,"text":"Orisun ayo gbogbo.","marked":"Orísun ayọ̀ gbogbo."}],"end":32.96},{"key":"4","start":33.91,"lines":[{"start":33.91,"end":35.211,"text":"Fun wa l'onje ojo wa,","marked":"Fún wa l'ọ́ńjẹ ọjọ́ wa"},{"start":35.591,"end":36.946,"text":"At'aso to ye fun wa","marked":"Àt'aṣọ tó yẹ fún wa"},{"start":37.326,"end":38.476,"text":"Ki omo Re ma rahun mo","marked":"Kí ọmọ Rẹ má ráhùn mọ́"},{"start":38.856,"end":40.521,"text":"Sure fun wa lojo aiye wa.","marked":"Súre fún wa lọ́jọ́ aiye wa."}],"end":40.521},{"key":"5","start":41.471,"lines":[{"start":41.471,"end":43.085,"text":"Enyin Egbe Aladura","marked":"Enyin Ẹgbẹ́ Alàdúrà"},{"start":43.465,"end":44.635,"text":"K'e mura si adura;","marked":"K'ẹ múra sí àdúrà"},{"start":45.015,"end":46.467,"text":"Orin isegun l'a o ko","marked":"Orin ìṣègùn l'á ò kò"},{"start":46.847,"end":48.051,"text":"Lagbara Metalokan,","marked":"Lágbára Mẹ́talọ́kan"}],"end":48.051},{"key":"6","start":49.001,"lines":[{"start":49.001,"end":50.277,"text":"Jowo Jehovah Mimo","marked":"Jọ̀wọ́ Jehovah Mímọ́́"},{"start":50.657,"end":52.008,"text":"M'ese Egbe wa duro","marked":"M'ẹsẹ̀ Ẹgbẹ́ wa dúró"},{"start":52.388,"end":54.121,"text":"Jehovah Nissi Baba","marked":"Jehovah Nissi Bàbá"},{"start":54.501,"end":55.899,"text":"K'a le sin O de opin.","marked":"K'á lè sìn Ó dé òpin."}],"end":55.899}]}