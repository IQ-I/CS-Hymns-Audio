{"v":1,"coll":"y","num":98,"id":"hymn_98","title":"ENYIN egbe Serafu,","duration":61.212,"voices":{"male":{"file":"y-98-male.m4a","bytes":443909,"sha256":"28159596505947352f9362b0ba326bf8cceb27ddb9159586a6f66a6e96e17e3a","duration":61.3},"female":{"file":"y-98-female.m4a","bytes":462944,"sha256":"016a1d456206246600824b958fb57a666b8f414ee41bd9fe4f8b1b87bcfa1adc","duration":61.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.641,"text":"ENYIN egbe Serafu,","marked":"Enyin ẹgbẹ́ Séráfù"},{"start":2.021,"end":3.318,"text":"Wa fi ayo nyin han,","marked":"Wá fi ayọ̀ nyin hàn"},{"start":3.698,"end":5.044,"text":"E jumo ko orin didun","marked":"Ẹ jùmọ̀ kọ orin dídùn"},{"start":5.424,"end":6.856,"text":"Fun se'yanu to se fun wa","marked":"Fún sẹ́'yanu tó ṣe fún wa"},{"start":7.236,"end":9.518,"text":"Ti ko je ka sonu kuro ni ona Re.","marked":"Tí kò jẹ́ ká sọnù kúrò ní ọ̀nà Rẹ̀."}],"end":9.518},{"key":"CHORUS","start":10.468,"lines":[{"start":10.468,"end":11.783,"text":"A nyan lo si Sion,","marked":"A nyan lọ sí Sion"},{"start":12.163,"end":13.598,"text":"Sion to dara julo","marked":"Ṣíọ̀n tó dára jùlọ"},{"start":13.978,"end":15.381,"text":"A nyan goke lo si Sion","marked":"A nyan gòkè lọ sí Sion"},{"start":15.761,"end":16.735,"text":"Ilu Olorun wa.","marked":"Ìlú Ọlọ́run wà."}],"end":16.735},{"key":"2","start":17.685,"lines":[{"start":17.685,"end":18.799,"text":"Baba Aladura","marked":"Bàbá Aládúrà"},{"start":19.179,"end":20.397,"text":"F'ope fun Olorun","marked":"F'ọpẹ́ fún Ọlọ́run"},{"start":20.777,"end":22.004,"text":"To mu O bori awon ota","marked":"Tó mú Ọ borí àwọn ọ̀tá"},{"start":22.384,"end":23.897,"text":"Ti ko je ki ota yo o","marked":"Tí kò jẹ́ kí ọ̀tá yọ ọ́"},{"start":24.277,"end":25.506,"text":"To fi o se ori","marked":"Tó fi ọ́ ṣe orí"},{"start":25.886,"end":27.313,"text":"Yio fi o se d'opin.","marked":"Yíó fi ó ṣe d'òpin."}],"end":27.313},{"key":"3","start":28.263,"lines":[{"start":28.263,"end":29.696,"text":"Enyin Egbe Akorin","marked":"Enyin Ẹgbẹ́ Akọrin"},{"start":30.076,"end":31.197,"text":"E fi ayo nyin han","marked":"Ẹ fi ayọ̀ nyin hàn"},{"start":31.577,"end":33.237,"text":"Fun Majemu Re ti ko ye,","marked":"Fún Májẹ̀mú Rẹ tí kò yẹ"},{"start":33.617,"end":34.916,"text":"Ni arin Egbe Serafu","marked":"Ní àrìn Ẹgbẹ́ Séráfù"},{"start":35.296,"end":36.523,"text":"To mu se di oni,","marked":"Tó mú ṣe di òní"},{"start":36.903,"end":38.365,"text":"Ati aiye ti mbo.","marked":"Àti aiye ti ḿbọ́."}],"end":38.365},{"key":"4","start":39.315,"lines":[{"start":39.315,"end":40.343,"text":"Enia Ie ma kegan","marked":"Ẹníà lè má kẹ́gàn"},{"start":40.723,"end":42.03,"text":"Nwon si le ma sata","marked":"Nwọ̀n sì lè má sata"},{"start":42.41,"end":43.622,"text":"Awon ti ko m'Olorun wa,","marked":"Àwọn tí kò m'Ọlọ́run wà"},{"start":44.002,"end":45.478,"text":"Sugbon awa Egbe Kerubu","marked":"Ṣùgbọ́n àwa Ẹgbẹ́ Kérúbù"},{"start":45.858,"end":47.217,"text":"A si m'eni t'a nsin","marked":"A sì m'ẹni t'á ńsìn"},{"start":47.597,"end":48.892,"text":"Yio si fun wa lere.","marked":"Yíó sì fún wa lérè."}],"end":48.892},{"key":"5","start":49.842,"lines":[{"start":49.842,"end":51.008,"text":"Kerubu Serafu","marked":"Kérúbù Séráfù"},{"start":51.388,"end":52.533,"text":"E mura sis'Emi","marked":"Ẹ múra sís'Èmi"},{"start":52.913,"end":54.627,"text":"Enyin yio sise na dopin","marked":"Enyin yíó ṣiṣẹ́ nà dópin"},{"start":55.007,"end":56.315,"text":"E o si ri Olugbala","marked":"Ẹ ó sì rí Olùgbàlà"},{"start":56.695,"end":57.911,"text":"L'aye mimo loke","marked":"L'áyé mímọ́́ lókè"},{"start":58.291,"end":59.662,"text":"Ati I'orun pelu.","marked":"Àti l'ọrun pẹ̀lú."}],"end":59.662}]}