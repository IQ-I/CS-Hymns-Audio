{"v":1,"coll":"y","num":818,"id":"hymn_818","title":"ALAFIA ni fun Egbe Mimo","duration":64.753,"voices":{"male":{"file":"y-818-male.m4a","bytes":447897,"sha256":"c0fe4ca43ee2d4d50619de341df17f6dcd8b1cc1579ab28d06c1e3af5998fb1c","duration":64.8},"female":{"file":"y-818-female.m4a","bytes":470336,"sha256":"0940d9d6ca5121503a96809cbb883608f930d70a3aacac985c16e0622169082d","duration":64.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.969,"text":"ALAFIA ni fun Egbe Mimo","marked":"Àlàáfíà ni fún Ẹgbẹ́ Mímọ́́"},{"start":2.349,"end":5.664,"text":"Ta da sile fun 'gbega, Krist'l'Eko.","marked":"Ta dá sílẹ̀ fún 'gbéga, Krist'l'Eko."}],"end":5.664},{"key":"2","start":6.614,"lines":[{"start":6.614,"end":8.173,"text":"Alafia ni fun enikeni","marked":"Àlàáfíà ni fún ẹnikẹ́ni"},{"start":8.553,"end":10.74,"text":"T'o n'oruko nin' Egbe mimo yi.","marked":"T'ó ń'orúkọ nín' Ẹgbẹ́ mímọ́́ yí."}],"end":10.74},{"key":"3","start":11.69,"lines":[{"start":11.69,"end":13.087,"text":"Alafia ni fun awon wonni","marked":"Àlàáfíà ni fún àwọn wọnnì"},{"start":13.467,"end":15.206,"text":"T'o jeri Kristi de oju iku.","marked":"T'ó jẹ́ri Kristi dé ojú ikú."}],"end":15.206},{"key":"4","start":16.156,"lines":[{"start":16.156,"end":17.799,"text":"Alafia ni fun awon","marked":"Àlàáfíà ni fún àwọn"},{"start":18.179,"end":20.376,"text":"T'o forit' iponju titi dopin.","marked":"T'ó forit' ìpọ́njú títí dópin."}],"end":20.376},{"key":"5","start":21.326,"lines":[{"start":21.326,"end":22.775,"text":"Alafia ni fun awon wonni","marked":"Àlàáfíà ni fún àwọn wọnnì"},{"start":23.155,"end":25.446,"text":"T'o sise Kristi laiberu egba.","marked":"T'ó ṣiṣẹ́ Kristi láìbẹ̀rù ẹ̀gbà."}],"end":25.446},{"key":"6","start":26.396,"lines":[{"start":26.396,"end":27.812,"text":"Alafia ni fun awon wonni","marked":"Àlàáfíà ni fún àwọn wọnnì"},{"start":28.192,"end":30.053,"text":"T'a sa l'ami Kristi ninu aiye.","marked":"T'á sá l'àmì Kristi nínú àìyẹ́."}],"end":30.053},{"key":"7","start":31.003,"lines":[{"start":31.003,"end":32.917,"text":"Alafia ni f'omo Egbe yi","marked":"Àlàáfíà ni f'ọmọ Ẹgbẹ́ yí"},{"start":33.297,"end":34.995,"text":"Ade ogo ni y'o je ere re.","marked":"Adé ògo ni y'ó jẹ́ èrè rẹ̀."}],"end":34.995},{"key":"8","start":35.945,"lines":[{"start":35.945,"end":38.339,"text":"Egbe na nkun, o si ntankale lo,","marked":"Ẹgbẹ́ na ńkùn, ó sì ńtànkalẹ̀ lọ"},{"start":38.719,"end":41.059,"text":"Lagbara Kristi yio kan ka aiye.","marked":"Lagbára Kristi yìó kan ka aiye."}],"end":41.059},{"key":"9","start":42.009,"lines":[{"start":42.009,"end":44.206,"text":"Agba nla Kristi mbe f'egbe yi,","marked":"Àgbà ńlá Kristi ḿbẹ f'ègbè yí"},{"start":44.586,"end":46.411,"text":"Ao le subu larin igbi aiye.","marked":"Aò lè ṣubú lárin ìgbì aiye."}],"end":46.411},{"key":"10","start":47.361,"lines":[{"start":47.361,"end":49.222,"text":"L'enit'o nwa isubu Egbe yi","marked":"L'enit'ó ńwá ìṣubú Ẹgbẹ́ yí"},{"start":49.602,"end":51.92,"text":"Mo p'o soro lati tapa segun.","marked":"Mo p'ó ṣòro láti tàpá ṣẹ́gun."}],"end":51.92},{"key":"11","start":52.87,"lines":[{"start":52.87,"end":55.203,"text":"Gbat'aiye at'ogo re ba dopin","marked":"Gbat'aiye at'ògo rẹ bá dópin"},{"start":55.583,"end":57.619,"text":"Egbe yi yio wa lai lodo Oluwa.","marked":"Ẹgbẹ́ yí yíó wà láì lọ́dọ̀ Olúwa."}],"end":57.619},{"key":"12","start":58.569,"lines":[{"start":58.569,"end":60.33,"text":"Ko Halleluya s'Oba Olore","marked":"Kò Hallelúyà s'Ọba Olórè"},{"start":60.71,"end":63.203,"text":"F'Egbe rere t'a gbe kale s'aiye.","marked":"F'Ẹgbẹ́ rere t'á gbé kalẹ̀ s'aiye."}],"end":63.203}]}