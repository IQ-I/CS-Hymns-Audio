{"v":1,"coll":"y","num":379,"id":"hymn_379","title":"WA mi si wa, Emi Mimo","duration":36.21,"voices":{"male":{"file":"y-379-male.m4a","bytes":259086,"sha256":"03d59c7ae2e8288fd85c2410e5b94455e64671a40fe97871ab47f056a0040d28","duration":36.3},"female":{"file":"y-379-female.m4a","bytes":270486,"sha256":"6aeb2e0ff8266fbbaa2ac4b5e6d066a5056468ca5b8f1636975602c0e4104ba6","duration":36.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.908,"text":"WA mi si wa, Emi Mimo","marked":"Wá mí sí wa, Ẹ̀mí Mímọ́́"},{"start":2.288,"end":4.081,"text":"Tan 'na orun si okan wa","marked":"Tan 'na ọrùn sí ọkàn wa"},{"start":4.461,"end":5.728,"text":"Emi af'ororo yan 'ni","marked":"Ẹ̀mí af'òróró yàn 'ni"},{"start":6.108,"end":7.583,"text":"Ti f'emi meje re funni.","marked":"Ti f'ẹ̀mí méje rẹ fúnni."}],"end":7.583},{"key":"2","start":8.533,"lines":[{"start":8.533,"end":10.231,"text":"lse nla Re at'oke wa","marked":"lse ńlá Rẹ àt'òkè wá"},{"start":10.611,"end":13.596,"text":"N'itunu, iye, ina ife","marked":"N'ìtùnú, ìyè, iná ìfẹ́"},{"start":13.976,"end":15.607,"text":"F'imole Re igbagbogbo","marked":"F'ìmọ́lẹ̀̀ Rẹ ìgbàgbogbo"},{"start":15.987,"end":17.502,"text":"Le okunkun okan wa lo.","marked":"Lé òkùnkùn ọkàn wa lọ."}],"end":17.502},{"key":"3","start":18.452,"lines":[{"start":18.452,"end":19.641,"text":"F'ororo ore-ofe Re","marked":"F'òròrò ọrẹ-ọ̀fẹ́ Rẹ"},{"start":20.021,"end":21.175,"text":"Pa oju eri wa ko dan","marked":"Pa ojú ẹ̀rí wa kó dán"},{"start":21.555,"end":23.08,"text":"L'ota jina s'ibugbe wa","marked":"L'ọ̀tá jiná s'ibùgbé wa"},{"start":23.46,"end":25.07,"text":"lre n'igbe 'biti 'Wo nso.","marked":"lrè n'ígbé 'biti 'Wò ǹṣó."}],"end":25.07},{"key":"4","start":26.02,"lines":[{"start":26.02,"end":28.323,"text":"Ko wa k'a mo Baba, Omo","marked":"Kò wá k'á mọ Bàbá, Ọmọ"},{"start":28.703,"end":30.113,"text":"Pelu Re l'okansoso","marked":"Pẹ̀lú Rẹ l'ọ̀kanṣoṣo"},{"start":30.493,"end":32.687,"text":"Titi aiye ainipekun","marked":"Títí aiye àìnípẹ̀kun"},{"start":33.067,"end":34.66,"text":"Ni k'eyi ma je orin wa.","marked":"Ní k'èyí mà jẹ́ orin wa."}],"end":34.66}]}