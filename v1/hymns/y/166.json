{"v":1,"coll":"y","num":166,"id":"hymn_166","title":"AGBARA kanna ti","duration":49.862,"voices":{"male":{"file":"y-166-male.m4a","bytes":337765,"sha256":"0eb394b96d14c7e973a43baa4a0a85db625cdb9b82c3886b61c19c2378197255","duration":49.9},"female":{"file":"y-166-female.m4a","bytes":348191,"sha256":"3373f33236423d12c4a5787493a83d9f088119be49f0007094f18845f8a9c807","duration":49.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.835,"text":"AGBARA kanna ti,","marked":"Agbára kanná ti"},{"start":2.215,"end":4.161,"text":"Nwon ni l'ojo Pentikost'.","marked":"Nwọ̀n ní l'ọjọ́ Pentikost'."}],"end":4.161},{"key":"CHORUS","start":5.111,"lines":[{"start":5.111,"end":7.314,"text":"Agbara yi, on kanna ti Jesu","marked":"Agbára yí, ọ́n kanná ti Jésù"},{"start":7.694,"end":8.912,"text":"Se ileri p'o mbo.","marked":"Ṣe ìlérí p'ó ḿbọ́."}],"end":8.912},{"key":"2","start":9.862,"lines":[{"start":9.862,"end":11.052,"text":"Awon enia ro pe,","marked":"Àwọn enia rò pé"},{"start":11.432,"end":12.967,"text":"Nwon f'esu l'esu jade.","marked":"Nwọn f'èṣù l'èṣù jáde."}],"end":12.967},{"key":"3","start":13.917,"lines":[{"start":13.917,"end":15.17,"text":"Emi buburu kan ko","marked":"Ẹ̀mí búburú kan kọ́"},{"start":15.55,"end":17.321,"text":"Tun le ri wa gbese mo.","marked":"Tún lè rí wa gbéṣẹ́ mọ́."}],"end":17.321},{"key":"4","start":18.271,"lines":[{"start":18.271,"end":19.514,"text":"Aje ko le ri wa mo,","marked":"Àjẹ́ kò lè rí wa mọ́"},{"start":19.894,"end":21.711,"text":"Oso ko ri wa gbese.","marked":"Ọ̀ṣọ́ kò rí wa gbéṣẹ́."}],"end":21.711},{"key":"5","start":22.661,"lines":[{"start":22.661,"end":23.946,"text":"Eni f 'okan fun Jesu","marked":"Ẹní f 'ọkàn fún Jésù"},{"start":24.326,"end":25.68,"text":"On ni yio ri igbala.","marked":"On ni yio rí ìgbàlà."}],"end":25.68},{"key":"6","start":26.63,"lines":[{"start":26.63,"end":27.848,"text":"Emi agbara otito","marked":"Ẹ̀mí agbára òtítọ́́"},{"start":28.228,"end":29.961,"text":"Nwon ti nse Metalokan.","marked":"Nwọ̀n ti ńṣe Mẹ́talọ́kan."}],"end":29.961},{"key":"7","start":30.911,"lines":[{"start":30.911,"end":32.508,"text":"B'a ba f'ori ti d'opin","marked":"B'á bá f'orí ti d'òpin"},{"start":32.888,"end":34.357,"text":"Ere nla yio je tiwa","marked":"Èrè ńlá yìó jẹ́ tiwa"}],"end":34.357},{"key":"8","start":35.307,"lines":[{"start":35.307,"end":36.893,"text":"Gbat' iku ara ba de","marked":"Gbat' ikú ara bá dé"},{"start":37.273,"end":38.547,"text":"Emi y'o je t'Olorun","marked":"Èmi y'ó jẹ́ t'Ọlọ́run"}],"end":38.547},{"key":"9","start":39.497,"lines":[{"start":39.497,"end":42.035,"text":"Ekun, ose, a koja","marked":"Ẹkùn, ọ̀sẹ̀, a kọjá"},{"start":42.415,"end":43.805,"text":"Gbat' a ba r'Olugbala","marked":"Gbat' a bá r'Olùgbàlà"}],"end":43.805},{"key":"10","start":44.755,"lines":[{"start":44.755,"end":46.159,"text":"Halle Halle Halleluya,","marked":"Halle Halle Hallelúyà"},{"start":46.539,"end":48.312,"text":"Yio j'orin wa lojo na.","marked":"Yío j'orin wa lọ́jọ́ ná."}],"end":48.312}]}