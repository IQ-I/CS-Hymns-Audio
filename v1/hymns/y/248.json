{"v":1,"coll":"y","num":248,"id":"hymn_248","title":"JESU mi, mu mi gb'ohun Re","duration":32.683,"voices":{"male":{"file":"y-248-male.m4a","bytes":226194,"sha256":"cf92f528761ab2acb07ac956119434f1b1a9bb8942801dfd5b6418f5fb118327","duration":32.7},"female":{"file":"y-248-female.m4a","bytes":236701,"sha256":"1f323a8740d1934d989a4bf7fcc79ba18ca57f4e1dcf2dddb6cc5cfb12c40760","duration":32.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.271,"text":"JESU mi, mu mi gb'ohun Re","marked":"Jésù mi, mú mi gb'óhùn Rẹ̀"},{"start":2.651,"end":3.704,"text":"S'oro alafia;","marked":"S'oro àlàáfíà"},{"start":4.084,"end":5.666,"text":"Ghogbo ipa mi y'o dalu","marked":"Ghogbo ipá mi y'ó dàlú"},{"start":6.046,"end":7.153,"text":"Lari yin Ore Re.","marked":"Lárí yín Ọ̀rẹ́ Rẹ."}],"end":7.153},{"key":"2","start":8.103,"lines":[{"start":8.103,"end":9.467,"text":"Fi iyonu pe mi l'omo","marked":"Fi ìyọnu pè mí l'ọmọ"},{"start":9.847,"end":11.381,"text":"K' o si dariji mi;","marked":"K' ó sì dariji mi"},{"start":11.761,"end":13.073,"text":"Ohun na yio dunmo mi","marked":"Ohun ná yìó dùnmọ́ mi"},{"start":13.453,"end":14.551,"text":"B'iro orin orun.","marked":"B'iro orin ọ̀run."}],"end":14.551},{"key":"3","start":15.501,"lines":[{"start":15.501,"end":17.485,"text":"Ibikibi t'o to mi si,","marked":"Ibikíbi t'ó tó mi sí"},{"start":17.865,"end":19.183,"text":"L'emi o f' ayo lo","marked":"L'èmi ò f' ayọ̀ lọ"},{"start":19.563,"end":21.014,"text":"Tayotayo l'emi o si","marked":"Tayọ̀tayọ̀ l'èmi ò sí"},{"start":21.394,"end":22.644,"text":"Dapo m'awon oku.","marked":"Dàpọ̀ ḿ'àwọn òkú."}],"end":22.644},{"key":"4","start":23.594,"lines":[{"start":23.594,"end":25.207,"text":"Gba eru ebi ba koja","marked":"Gba ẹrù ebi bá kọjá"},{"start":25.587,"end":26.574,"text":"Eru mi ko si mo","marked":"Ẹrú mi kò sí mọ́"},{"start":26.954,"end":28.519,"text":"Owo t'o fun 'dariji ka,","marked":"Owó t'ó fún 'dáríjì ká"},{"start":28.899,"end":30.197,"text":"Y'o pin ade iye.","marked":"Y'ó pín adé ìyè."},{"start":30.577,"end":31.133,"text":"Amin.","marked":"Àmín."}],"end":31.133}]}