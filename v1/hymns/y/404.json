{"v":1,"coll":"y","num":404,"id":"hymn_404","title":"IWE kan wa ti kika re","duration":32.623,"voices":{"male":{"file":"y-404-male.m4a","bytes":229794,"sha256":"6f2a6108bb215491b2caad552df50c6524092213d17e38bf9f411a3916c96383","duration":32.7},"female":{"file":"y-404-female.m4a","bytes":238193,"sha256":"b6d500b9fc08133d1d0c6c60a05322251e32cc4753a09b6e535b8efdc95cb0c4","duration":32.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.95,"text":"IWE kan wa ti kika re","marked":"Ìwé kan wà tí kíkà rẹ̀"},{"start":2.33,"end":3.517,"text":"Ko soro fun enia","marked":"Kò ṣòro fún enia"},{"start":3.897,"end":5.477,"text":"Ogbon ti awon t'o ka nfe","marked":"Ọgbọ́n ti àwọn t'ó ká ńfẹ́"},{"start":5.857,"end":7.081,"text":"Ni okan ti o mo.","marked":"Ní ọkàn tí o mọ́."}],"end":7.081},{"key":"2","start":8.031,"lines":[{"start":8.031,"end":9.522,"text":"lse gbogbo t'Olorun se","marked":"lse gbogbo t'Ọlọ́run ṣe"},{"start":9.902,"end":11.303,"text":"L'oke n'ile, n'nu wa","marked":"L'òkè ń'ilẹ̀, ń'nú wa"},{"start":11.683,"end":13.35,"text":"Nwon j'okan ninu iwe na","marked":"Nwọn j'ọ̀kan nínú ìwé ná"},{"start":13.73,"end":15.054,"text":"Lati f'Olorun han.","marked":"Láti f'Ọlọ́run hàn."}],"end":15.054},{"key":"3","start":16.004,"lines":[{"start":16.004,"end":17.555,"text":"Imole osupa l'oke","marked":"Ìmọ́lẹ̀̀ òṣùpá l'òkè"},{"start":17.935,"end":19.452,"text":"Lat' odo orun ni","marked":"Lát' odò ọ̀run ni"},{"start":19.832,"end":21.07,"text":"Be l'ogo Ijo Olorun","marked":"Bẹ́ l'ògo Ìjọ Ọlọ́run"},{"start":21.45,"end":22.537,"text":"T'odo Olorun wa.","marked":"T'ọ̀dọ̀ Ọlọ́run wà."}],"end":22.537},{"key":"4","start":23.487,"lines":[{"start":23.487,"end":24.975,"text":"lwo ti O jeki a ri","marked":"lwo tí Ò jẹ́kí á rí"},{"start":25.355,"end":26.456,"text":"Ohun t'o dara yi","marked":"Ohun t'ó dára yí"},{"start":26.836,"end":28.358,"text":"Fun wa l'okan lati wa O","marked":"Fún wa l'ọ́kan láti wá O"},{"start":28.738,"end":30.132,"text":"K'a ri O nibi gbogbo.","marked":"K'á rí O níbi gbogbo."},{"start":30.512,"end":31.073,"text":"Amin.","marked":"Àmín."}],"end":31.073}]}