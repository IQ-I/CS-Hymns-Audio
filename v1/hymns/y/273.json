{"v":1,"coll":"y","num":273,"id":"hymn_273","title":"BI agborin ti nmi hele","duration":39.675,"voices":{"male":{"file":"y-273-male.m4a","bytes":275624,"sha256":"a620d9960fab36d43bfede05b875a73f15ec88bab228c4f8fbac6d536c8c9484","duration":39.7},"female":{"file":"y-273-female.m4a","bytes":283435,"sha256":"523513076b2c860c92f871681d419ae534c09a16a6f700174c03c5ea865fd0b0","duration":39.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.926,"text":"BI agborin ti nmi hele","marked":"Bí àgbọ̀rín ti ńmi hẹ́lẹ́"},{"start":2.306,"end":3.458,"text":"S'ipa Odo omi","marked":"S'ípa Odò omi"},{"start":3.838,"end":5.154,"text":"Beni okan mi nmi si O","marked":"Bẹni ọkàn mi ńmí sí Ọ"},{"start":5.534,"end":6.567,"text":"Iwo Olorun mi.","marked":"Ìwọ Ọlọ́run mi."}],"end":6.567},{"key":"2","start":7.517,"lines":[{"start":7.517,"end":9.186,"text":"Orungbe Re ngbe Okan mi","marked":"Òrùngbẹ Rẹ̀ ngbe Ọkàn mi"},{"start":9.566,"end":10.706,"text":"Olorun alaye;","marked":"Ọlọ́run àlàyé"},{"start":11.086,"end":12.781,"text":"Nigbawo ni ngo r'Oju Re,","marked":"Nígbàwọ́ ni ngo r'Ojú Rẹ"},{"start":13.161,"end":14.084,"text":"Olorun Olanla?","marked":"Ọlọ́run Ọláǹlà?"}],"end":14.084},{"key":"3","start":15.034,"lines":[{"start":15.034,"end":16.573,"text":"Okan mi o se rewesi","marked":"Ọkàn mi ò ṣe rẹ̀wẹ̀sì"},{"start":16.953,"end":17.92,"text":"Gbekele Olorun","marked":"Gbẹ́kẹ̀lé Ọlọ́run"},{"start":18.3,"end":19.775,"text":"Eniti y'o so ekun re","marked":"Eniti y'ó so ẹkùn rẹ̀"},{"start":20.155,"end":21.228,"text":"D'orin ayo fun o.","marked":"D'orin ayọ̀ fún ọ."}],"end":21.228},{"key":"4","start":22.178,"lines":[{"start":22.178,"end":23.842,"text":"Y'o ti pe to, Olorun mi,","marked":"Y'ó ti pẹ́ tó, Ọlọ́run mi"},{"start":24.222,"end":25.445,"text":"Ti ngo d'eni gbagbe?","marked":"Tí ngo d'ẹni gbàgbé?"},{"start":25.825,"end":27.969,"text":"T'ao ma ti mi sihin, sohun","marked":"T'áo má tì mí síhìn, ṣohun"},{"start":28.349,"end":29.695,"text":"B'eni ko ni 'bugbe.","marked":"B'ẹni kọ́ ni 'bugbe."}],"end":29.695},{"key":"5","start":30.645,"lines":[{"start":30.645,"end":32.173,"text":"Okan mi o so rewesi?","marked":"Ọkàn mi ò sọ rẹ̀wẹ̀sì?"},{"start":32.553,"end":34.065,"text":"Gbagbo 'wo o si ko","marked":"Gbàgbọ́ 'wò ó sì kọ́"},{"start":34.445,"end":35.707,"text":"Orin iyin s'Olorun re","marked":"Orin ìyìn s'Ọlọ́run rẹ"},{"start":36.087,"end":37.041,"text":"Orisun emi re.","marked":"Orísun ẹ̀mí rẹ̀."},{"start":37.421,"end":38.125,"text":"Amin.","marked":"Àmín."}],"end":38.125}]}