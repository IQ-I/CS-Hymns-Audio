{"v":1,"coll":"y","num":58,"id":"hymn_58","title":"OBA TI ki ye Majemu","duration":52.425,"voices":{"male":{"file":"y-58-male.m4a","bytes":368237,"sha256":"d14b5ea3298f44860c207a6ec5414fb70fa3103a084d3fa56bbd022d4ad81ee3","duration":52.5},"female":{"file":"y-58-female.m4a","bytes":387493,"sha256":"d91d0b722713ecbd498b28b715aa9565e054e74435c5ebcdd07372599caffb24","duration":52.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.763,"text":"OBA TI ki ye Majemu","marked":"Ọba Tí kì yẹ Májẹ̀mú"},{"start":2.143,"end":3.51,"text":"F'ore ofe Re fun wa,","marked":"F'ọ̀rẹ́ ọ̀fẹ́ Rẹ fún wa"},{"start":3.89,"end":5.781,"text":"Majemu ti a ba O da,","marked":"Májẹ̀mú tí a bá Ó dá"},{"start":6.161,"end":7.632,"text":"Ki awa ko le mu se.","marked":"Kí àwa kò lè mú ṣẹ."}],"end":7.632},{"key":"CHORUS","start":8.582,"lines":[{"start":8.582,"end":9.987,"text":"Nitori iku Messaiah","marked":"Nítorí ikú Messaiah"},{"start":10.367,"end":11.93,"text":"Jowo ko sanu fun wa. 2ce","marked":"Jọ̀wọ́ kò sanu fún wa."}],"end":11.93},{"key":"2","start":12.88,"lines":[{"start":12.88,"end":14.222,"text":"Oba Mimo Oba Ogo,","marked":"Ọba Mímọ́ Ọba Ògo"},{"start":14.602,"end":15.934,"text":"Wo l'awa nfi iyin fun","marked":"Wo l'áwá ńfi ìyìn fún"},{"start":16.314,"end":17.813,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":18.193,"end":19.924,"text":"S'ope odun titun yi.","marked":"S'ọ́pẹ́ ọdún titun yí."}],"end":19.924},{"key":"3","start":20.874,"lines":[{"start":20.874,"end":22.254,"text":"Alaileso jek'o s'eso","marked":"Aláìléso jẹ́k'ó s'èso"},{"start":22.634,"end":23.994,"text":"Ninu odun t'awa yi","marked":"Nínú ọdún t'áwá yi"},{"start":24.374,"end":25.816,"text":"Alaigbagbo je ko gbagbo","marked":"Aláìgbàgbọ́ jẹ́ kó gbàgbọ́"},{"start":26.196,"end":27.496,"text":"Ki gbogbo wa di yiye.","marked":"Kí gbogbo wa di yíyẹ."}],"end":27.496},{"key":"4","start":28.446,"lines":[{"start":28.446,"end":29.983,"text":"Oba Mimo Jehofa NLA","marked":"Ọba Mímọ́́ Jèhófà Ńlá"},{"start":30.363,"end":31.892,"text":"Gb'ope Ajodun wa yi,","marked":"Gb'ope Àjọ̀dún wa yí"},{"start":32.272,"end":33.509,"text":"Seri Ibukun Re sori","marked":"Ṣẹ́rí Ìbùkún Rẹ sórí"},{"start":33.889,"end":35.372,"text":"Omode at'agba wa.","marked":"Ọmọdé àt'àgbà wà."}],"end":35.372},{"key":"5","start":36.322,"lines":[{"start":36.322,"end":37.66,"text":"Pese f'awon alairise,","marked":"Pèsè f'àwọn aláìríṣẹ́"},{"start":38.04,"end":39.238,"text":"Pese omo fun agan","marked":"Pèsè ọmọ fún àgàn"},{"start":39.618,"end":41.076,"text":"Fi ilera fun alaisan","marked":"Fi ìlera fún aláìsàn"},{"start":41.456,"end":42.648,"text":"K'omo Re mase rahun.","marked":"K'ọmọ Rẹ̀ máṣe ráhùn."}],"end":42.648},{"key":"6","start":43.598,"lines":[{"start":43.598,"end":45.284,"text":"F'agbara Re f 'Egbe Serafu,","marked":"F'agbára Rẹ f 'Ẹgbẹ́ Séráfù"},{"start":45.664,"end":47.052,"text":"Lati sin O de opin","marked":"Láti sìn Ó dé òpin"},{"start":47.432,"end":49.137,"text":"Mase je k'ise wa laiye","marked":"Masẹ̀ jẹ́ k'iṣẹ́ wa láìyẹ"},{"start":49.517,"end":50.876,"text":"Ja s'asan niwaju Re.","marked":"Já s'asán níwájú Rẹ."}],"end":50.876}]}