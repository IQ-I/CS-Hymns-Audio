{"v":1,"coll":"y","num":183,"id":"hymn_183","title":"OJO 'dajo on 'binu","duration":31.586,"voices":{"male":{"file":"y-183-male.m4a","bytes":220825,"sha256":"2362ca06afc0ffb2e778c2e39e1e8e8302417454a47be6d425381acbaba2a044","duration":31.6},"female":{"file":"y-183-female.m4a","bytes":227049,"sha256":"8d3c49c11819093f8d981bc2c97badee86750120dc8d348a00d97b4b0b59ebe0","duration":31.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.373,"text":"OJO 'dajo on 'binu","marked":"Ọjọ́ 'dájọ́ ọn 'bínú"},{"start":1.753,"end":3.291,"text":"Ojo ti Jesu pa ni","marked":"Ọjọ́ tí Jésù pa ni"},{"start":3.671,"end":5.01,"text":"Gbobgo a so n'jo na!","marked":"Gbobgo á sọ n'jo ná!"}],"end":5.01},{"key":"2","start":5.96,"lines":[{"start":5.96,"end":7.847,"text":"Kikan n'ipe o ma dun","marked":"Kíkàn ń'ìpè ó má dùn"},{"start":8.227,"end":9.53,"text":"Isa oku yio si,","marked":"Isà òkú yìọ sí"},{"start":9.91,"end":11.567,"text":"Gbogbo oku y'o dide.","marked":"Gbogbo òkú y'ó dìde."}],"end":11.567},{"key":"3","start":12.517,"lines":[{"start":12.517,"end":13.927,"text":"Iku papa y'o diji","marked":"Ikú pápá y'ó díjí"},{"start":14.307,"end":15.863,"text":"Eda gbogbo y'o dide","marked":"Ẹ̀dà gbogbo y'ó dìde"},{"start":16.243,"end":17.62,"text":"Lati jipe Olorun.","marked":"Láti jipe Ọlọ́run."}],"end":17.62},{"key":"4","start":18.57,"lines":[{"start":18.57,"end":19.855,"text":"A o si Iwe sile","marked":"A ò ṣí Ìwé sílẹ̀"},{"start":20.235,"end":21.456,"text":"A o si ka ninu re","marked":"A ò sì kà nínú rẹ̀"},{"start":21.836,"end":23.56,"text":"Fun 'dajo t'o ku t'aye.","marked":"Fún 'dájọ́ t'ó kù t'áyé."}],"end":23.56},{"key":"5","start":24.51,"lines":[{"start":24.51,"end":25.48,"text":"Onidajo Ododo","marked":"Onídàjọ́ Òdodo"},{"start":25.86,"end":27.118,"text":"Jo w'ese mi gbogbo nu","marked":"Jo w'ẹsẹ̀ mi gbogbo nù"},{"start":27.498,"end":29.0,"text":"K'ojo siro na to de.","marked":"K'ọjọ́ sírọ́ ná tó dé."},{"start":29.38,"end":30.037,"text":"Amin.","marked":"Àmín."}],"end":30.037}]}