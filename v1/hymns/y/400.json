{"v":1,"coll":"y","num":400,"id":"hymn_400","title":"OLORUN l'abo eni Re","duration":26.32,"voices":{"male":{"file":"y-400-male.m4a","bytes":184798,"sha256":"18772aa79fb44dfd9d1ec589c56c60a255e0e6cb9f29232f1a528156e2548f1f","duration":26.4},"female":{"file":"y-400-female.m4a","bytes":189085,"sha256":"506412512aa3b145e21ebd0ccc1fdaedcd0622bb9e198a367416d48bb71da0e6","duration":26.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.374,"text":"OLORUN l'abo eni Re","marked":"Ọlọ́run l'ábò ẹni Rẹ"},{"start":1.754,"end":3.016,"text":"Nigba iji iponju de","marked":"Nígbà ìjì ìpọ́njú dé"},{"start":3.396,"end":4.962,"text":"K'a wa to se aroye wa","marked":"K'á wà tó ṣe àròyé wa"},{"start":5.342,"end":7.184,"text":"A! sa wo t'on t'iranwo Re.","marked":"A! sá wo t'ọ́n t'ìrànwọ́ Rẹ̀."}],"end":7.184},{"key":"2","start":8.134,"lines":[{"start":8.134,"end":9.881,"text":"B'agbami riru mbu soke","marked":"B'ágbàmì ríru ḿbu sókè"},{"start":10.261,"end":12.022,"text":"Okan wa mbe l'alafia","marked":"Ọkàn wa ḿbẹ l'àlàáfíà"},{"start":12.402,"end":14.271,"text":"Nigb' orile at'etido","marked":"Nígb' orílẹ̀ àt'etídò"},{"start":14.651,"end":16.153,"text":"Ba njaya riru omi na.","marked":"Bá ńjayà rírú omi ná."}],"end":16.153},{"key":"3","start":17.103,"lines":[{"start":17.103,"end":18.668,"text":"lwe owo ni, oro re","marked":"lwe owó ni, ọ̀rọ̀ rẹ"},{"start":19.048,"end":20.307,"text":"Kawo ibinu fufu wa","marked":"Kàwọ̀ ìbínú fùfù wa"},{"start":20.687,"end":22.137,"text":"Oro Re m'alafia wa","marked":"Ọ̀rọ̀ Rẹ̀ m'àlàáfíà wa"},{"start":22.517,"end":23.838,"text":"O f'ilera f'okan are.","marked":"Ó f'ìlera f'ọkàn àrè."},{"start":24.218,"end":24.77,"text":"Amin.","marked":"Àmín."}],"end":24.77}]}