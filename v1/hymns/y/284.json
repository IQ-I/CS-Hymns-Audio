{"v":1,"coll":"y","num":284,"id":"hymn_284","title":"JESU, l'ara re l'awa nwo","duration":33.909,"voices":{"male":{"file":"y-284-male.m4a","bytes":239445,"sha256":"0efb28f9d8f5913d01a260dfe85e701a76c6aae2975da31e4b6e8de28d67eaa7","duration":34.0},"female":{"file":"y-284-female.m4a","bytes":247936,"sha256":"7b30e43ba4121726c11e88ad675ce60a2b76e2ee0f1ee9c3272356cd20646dbe","duration":34.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.443,"text":"JESU, l'ara re l'awa nwo","marked":"Jésù, l'ara rẹ l'áwá ńwò"},{"start":2.823,"end":3.841,"text":"Egbegberun ogo","marked":"Egbegberun ògo"},{"start":4.221,"end":5.621,"text":"Ju t'okuta iyebiye","marked":"Ju t'ókúta iyebíye"},{"start":6.001,"end":7.453,"text":"T'agbada Aaroni.","marked":"T'àgbàdà Áárónì."}],"end":7.453},{"key":"2","start":8.403,"lines":[{"start":8.403,"end":10.109,"text":"Nwon ko le sai ko rubo na,","marked":"Nwọn kò lè ṣàì kó rúbọ ná"},{"start":10.489,"end":11.8,"text":"Fun ese ara won","marked":"Fún ẹsẹ̀ ara wọn"},{"start":12.18,"end":14.451,"text":"lwa re pe, ko l'abawon","marked":"lwá rẹ̀ pé, kò l'àbàwọ́n"},{"start":14.831,"end":15.925,"text":"Mimo si l'eda re.","marked":"Mímọ́́ sí l'ẹ̀dà rẹ."}],"end":15.925},{"key":"3","start":16.875,"lines":[{"start":16.875,"end":18.759,"text":"Jesu oba ogo gunwa","marked":"Jésù ọba ògo gúnwà"},{"start":19.139,"end":20.326,"text":"L'oke Sion t'orun","marked":"L'òkè Sion t'ọrun"},{"start":20.706,"end":22.115,"text":"Bi odo-agutan t'a pa","marked":"Bí odò-àgùtàn t'á pa"},{"start":22.495,"end":23.689,"text":"Bi alufa nla wa.","marked":"Bí àlùfá ńlá wa."}],"end":23.689},{"key":"4","start":24.639,"lines":[{"start":24.639,"end":26.279,"text":"Alagbawi lodo Baba","marked":"Alágbàwí lọ́dọ̀ Bàbá"},{"start":26.659,"end":27.964,"text":"Ti y'o wa titi lai","marked":"Ti y'ó wà títí láí"},{"start":28.344,"end":29.827,"text":"Gb'ejo re fun 'wo okan mi","marked":"Gb'ẹjọ́ rẹ fún 'wò ọkàn mi"},{"start":30.207,"end":31.423,"text":"Gb'ore-ofe baba.","marked":"Gb'ọ̀rẹ́-ọ̀fẹ́ bàbá."},{"start":31.803,"end":32.359,"text":"Amin.","marked":"Àmín."}],"end":32.359}]}