{"v":1,"coll":"y","num":782,"id":"hymn_782","title":"WA, Jesu fi ara han","duration":35.462,"voices":{"male":{"file":"y-782-male.m4a","bytes":259377,"sha256":"7ae002c28a5e8f60931454d521d1e00899a33a8478ea6a3377a980223d2fb45d","duration":35.5},"female":{"file":"y-782-female.m4a","bytes":261768,"sha256":"51c507761d5aab6d9dc7e9728ce73a24015b480df8b059b2914b1c0be4c6eb4c","duration":35.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.692,"text":"WA, Jesu fi ara han,","marked":"Wá, Jésù fi ara hàn"},{"start":2.072,"end":4.145,"text":"Wa, jek'okan wa mo O","marked":"Wà, jẹ́k'ọkàn wa mọ́ O"},{"start":4.525,"end":6.085,"text":"Wa, mu gbogb'okan gbona","marked":"Wà, mú gbogb'okan gbóná"},{"start":6.465,"end":8.111,"text":"Wa, bukun wa k'a to lo.","marked":"Wà, bùkún wa k'á tó lò."}],"end":8.111},{"key":"2","start":9.061,"lines":[{"start":9.061,"end":10.939,"text":"Wa, f'aiya wa n'isimi","marked":"Wá, f'áíyá wa ń'isimi"},{"start":11.319,"end":13.469,"text":"Wa, k'a d'alabukunfun","marked":"Wà, k'á d'alábùkúnfún"},{"start":13.849,"end":15.077,"text":"Wa, soro alafia","marked":"Wá, sọ̀rọ̀ àlàáfíà"},{"start":15.457,"end":16.927,"text":"Wa, busi igbagbo wa.","marked":"Wá, bùsí ìgbàgbọ́́ wa."}],"end":16.927},{"key":"3","start":17.877,"lines":[{"start":17.877,"end":19.352,"text":"Wa, le 'siyemeji lo","marked":"Wá, lé 'ṣiyèméjì lọ"},{"start":19.732,"end":21.468,"text":"Wa, ko wa b'a ti bebe","marked":"Wá, kó wá b'á ti bẹ̀bẹ̀"},{"start":21.848,"end":23.432,"text":"Wa, fun okan wa n'ife","marked":"Wà, fún ọkàn wa ń'ìfẹ́"},{"start":23.812,"end":25.387,"text":"Wa, fa okan wa soke.","marked":"Wá, fa ọkàn wa sókè."}],"end":25.387},{"key":"4","start":26.337,"lines":[{"start":26.337,"end":27.977,"text":"Wa, so f'okan wa k'o yo","marked":"Wà, ṣó f'ọkàn wa k'ó yọ"},{"start":28.357,"end":29.582,"text":"Wa, wipe “Wo ni mo yan","marked":"Wà, wípé Wo ni mo yàn"},{"start":29.962,"end":31.681,"text":"Wa, p'awon agbo Re mo","marked":"Wà, p'àwọn agbo Rẹ mọ́"},{"start":32.061,"end":33.912,"text":"Wa, sure f'agutan Re.","marked":"Wá, súre f'ágùtàn Rẹ̀."}],"end":33.912}]}