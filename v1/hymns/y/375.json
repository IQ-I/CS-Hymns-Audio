{"v":1,"coll":"y","num":375,"id":"hymn_375","title":"EMI mimo, 'daba orun","duration":30.612,"voices":{"male":{"file":"y-375-male.m4a","bytes":210928,"sha256":"b4af7027f617ffe2972b5ed4b94926a4d5a023b8b748ed5a55b8ca884a8c7bc7","duration":30.7},"female":{"file":"y-375-female.m4a","bytes":219822,"sha256":"ddcd104ba9615e15e28c9ed33c776e3c7f9c8d14c6110d3c3f4d9890d54ef17e","duration":30.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.012,"text":"EMI mimo, 'daba orun","marked":"Ẹ̀mí mímọ́́, 'dábà ọ̀run"},{"start":2.392,"end":3.477,"text":"Wa li agbara Re","marked":"Wá li agbára Rẹ"},{"start":3.857,"end":5.289,"text":"K'o da ina ife mimo","marked":"K'ó dá iná ìfẹ́ mímọ́́"},{"start":5.669,"end":6.993,"text":"Ni okan tutu wa.","marked":"Ni ọkàn tútù wa."}],"end":6.993},{"key":"2","start":7.943,"lines":[{"start":7.943,"end":9.309,"text":"Wo b' a ti nrapala nihin","marked":"Wo b' a ti ńrápálá níhìn"},{"start":9.689,"end":10.749,"text":"T'a fe ohun asan","marked":"T'á fẹ́ ohun asán"},{"start":11.129,"end":12.684,"text":"Okan wa ko le fo k'o lo","marked":"Ọkàn wa kò lè fọ́ k'ó lọ"},{"start":13.064,"end":14.341,"text":"K'o de 'bayo titi.","marked":"K'ó dé 'báyọ títí."}],"end":14.341},{"key":"3","start":15.291,"lines":[{"start":15.291,"end":17.215,"text":"Oluwa, ao ha wa titi","marked":"Olúwa, aó ha wà títí"},{"start":17.595,"end":18.815,"text":"Ni kiku osi yi?","marked":"Ní kíkú òṣì yí?"},{"start":19.195,"end":20.487,"text":"lfe wa tutu be si O","marked":"lfẹ́ wá tutù bẹ̀ sí Ọ"},{"start":20.867,"end":21.986,"text":"Tire tobi si wa.","marked":"Tìrẹ tóbi ṣì wà."}],"end":21.986},{"key":"4","start":22.936,"lines":[{"start":22.936,"end":24.159,"text":"Emi Mimo 'daba orun","marked":"Ẹ̀mí Mímọ́́ 'dábà ọ̀run"},{"start":24.539,"end":25.8,"text":"Wa ni agbara Re","marked":"Wà ní agbára Rẹ"},{"start":26.18,"end":27.434,"text":"Wa dana 'fe Olugbala","marked":"Wá dáná 'fẹ́ Olùgbàlà"},{"start":27.814,"end":29.062,"text":"Tiwa o si gbina.","marked":"Tiwa ò sì gbiná."}],"end":29.062}]}