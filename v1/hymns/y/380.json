{"v":1,"coll":"y","num":380,"id":"hymn_380","title":"EMl Mimo sokale","duration":33.321,"voices":{"male":{"file":"y-380-male.m4a","bytes":232090,"sha256":"8cab5b828f5bd2b75a40f935b43b9de4b1fbab70d1542b8d5f746f20c4738c1e","duration":33.4},"female":{"file":"y-380-female.m4a","bytes":239690,"sha256":"035d96db7e7bee059d0b861b6aa18534b6b3024e855abc0a72b3d1bd14686b7f","duration":33.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.347,"text":"EMl Mimo sokale","marked":"EMl Mímọ́́ sọ̀kalẹ̀"},{"start":1.727,"end":3.137,"text":"Ba wa gbe ni aiye yi","marked":"Bá wa gbé ní àìyé yí"},{"start":3.517,"end":4.756,"text":"Fi ohun orun han ni","marked":"Fi ohùn ọ̀run hàn ni"},{"start":5.136,"end":6.662,"text":"Si ba ni sin Olorun.","marked":"Ṣì bá ní sin Ọlọ́run."}],"end":6.662},{"key":"2","start":7.612,"lines":[{"start":7.612,"end":9.161,"text":"Ese wa ni okan wa","marked":"Ẹ̀ṣẹ̀ wa ni ọkàn wa"},{"start":9.541,"end":10.875,"text":"Ti a ko le fi sile","marked":"Tí a kò lè fi sílẹ̀"},{"start":11.255,"end":12.716,"text":"Agbara wa ko to se","marked":"Agbára wa kó tó ṣe"},{"start":13.096,"end":14.752,"text":"Bi “Wo ko ba pelu wa\".","marked":"Bí Wò kò bá pẹ̀lú wa."}],"end":14.752},{"key":"3","start":15.702,"lines":[{"start":15.702,"end":16.983,"text":"Awa nfe k'ese parun","marked":"Àwá ńfẹ́ k'èsè parun"},{"start":17.363,"end":19.166,"text":"L'okan ati l'ara wa","marked":"L'ọkàn àti l'ara wa"},{"start":19.546,"end":21.46,"text":"Wa, Emi Mimo, jo wa","marked":"Wà, Ẹ̀mí Mímọ́́, jọ wà"},{"start":21.84,"end":23.353,"text":"Ko we gbogbo ese nu.","marked":"Kò wé gbogbo ẹ̀ṣẹ̀ nù."}],"end":23.353},{"key":"4","start":24.303,"lines":[{"start":24.303,"end":26.289,"text":"Olorun, 'Wo l'awa nfe","marked":"Ọlọ́run, 'Wò l'áwà ńfẹ́"},{"start":26.669,"end":28.14,"text":"Fi Emi Re na fun wa","marked":"Fi Ẹ̀mí Rẹ ná fún wa"},{"start":28.52,"end":29.796,"text":"K'a le pa ofin Re mo","marked":"K'á lè pa òfin Rẹ̀ mọ́"},{"start":30.176,"end":31.771,"text":"K'a si rin ni one Re.","marked":"K'á sì rìn ní one Rẹ̀."}],"end":31.771}]}