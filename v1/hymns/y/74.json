{"v":1,"coll":"y","num":74,"id":"hymn_74","title":"BABA niwaju ite Re","duration":46.174,"voices":{"male":{"file":"y-74-male.m4a","bytes":336967,"sha256":"bf91c2856ce5e7f579fdb6bca0feef966cf66e70452b3b1e3bb8620db59a2be6","duration":46.2},"female":{"file":"y-74-female.m4a","bytes":352339,"sha256":"5c3381c4ac7ae8937277f186519f51224b8bccf252d0f2ce2d68fdbb038724d0","duration":46.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.522,"text":"BABA niwaju ite Re,","marked":"Bàbá níwájú ìtẹ́ Rẹ"},{"start":1.902,"end":3.328,"text":"L'Angeli nteriba,","marked":"L'Áńgẹ́lì ntẹríba"},{"start":3.708,"end":4.952,"text":"Nigbagbo niwaju Re,","marked":"Nígbàgbọ́ níwájú Rẹ"},{"start":5.332,"end":6.403,"text":"Ni nwon nkorin iyin,","marked":"Ní nwọn nkorin ìyìn"},{"start":6.783,"end":8.532,"text":"Nwon si nfi ade wura won,","marked":"Nwọ̀n sí ńfi adé wúrà wọn"},{"start":8.912,"end":10.153,"text":"Lele y'ite na ka","marked":"Lele y'ite ná ká"},{"start":10.533,"end":12.193,"text":"Nwon nfi ohun pelu duru,","marked":"Nwọ̀n ńfi ohùn pẹ̀lú dùrù"},{"start":12.573,"end":13.655,"text":"Korin si Oluwa.","marked":"Kọrin sí Olúwa."}],"end":13.655},{"key":"2","start":14.605,"lines":[{"start":14.605,"end":16.362,"text":"Didan osumare si ntan","marked":"Dídán òṣùmàrè sí ńtàn"},{"start":16.742,"end":17.892,"text":"Si ara iye won,","marked":"Sí ara ìyè wọn"},{"start":18.272,"end":20.086,"text":"Bi Seraf ti nke si Seraf'","marked":"Bí Séráf ti ǹkẹ́ sí Séráf'"},{"start":20.466,"end":21.63,"text":"Ti nwon korin 'yin Re.","marked":"Ti nwọn kọrin 'yìn Rẹ."},{"start":22.01,"end":23.299,"text":"Bi a ti kunle nihinyi,","marked":"Bí a ti kúnlẹ̀ nihinyi"},{"start":23.679,"end":24.897,"text":"Ran ore Re si wa,","marked":"Rán ọ̀rẹ́ Rẹ sí wa"},{"start":25.277,"end":26.987,"text":"Ka mo pe 'Wo wa nitosi","marked":"Ká mọ̀ pé 'Wò wà nítòsí"},{"start":27.367,"end":28.803,"text":"Lati da wa l'ohun.","marked":"Láti dá wa l'óhùn."}],"end":28.803},{"key":"3","start":29.753,"lines":[{"start":29.753,"end":30.997,"text":"Nihin nibit'awon Angeli","marked":"Níhìn níbít'àwọn Áńgẹ́lì"},{"start":31.377,"end":33.436,"text":"Nwo wa, ba ti nsin O,","marked":"Nwọ wa, bá ti ńsìn O"},{"start":33.816,"end":35.567,"text":"Ko wa k'a wa ile orun,","marked":"Kò wá k'á wa ilé ọ̀run"},{"start":35.947,"end":37.341,"text":"K'a sin O bi ti won","marked":"K'á sin Ọ́ bí ti wọn"},{"start":37.721,"end":39.146,"text":"K'a ba won ko orin iyin,","marked":"K'á bá wọn kọ orin ìyìn"},{"start":39.526,"end":40.703,"text":"K'a ba won mo 'fe Re,","marked":"K'á bá wọn mọ́ 'fẹ́ Rẹ"},{"start":41.083,"end":42.525,"text":"Titi agbara y'o fi di","marked":"Títí agbára y'ó fi dí"},{"start":42.905,"end":44.624,"text":"Tire, Tire nikan.","marked":"Tírè, Tírè nìkan."}],"end":44.624}]}