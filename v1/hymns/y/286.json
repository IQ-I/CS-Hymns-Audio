{"v":1,"coll":"y","num":286,"id":"hymn_286","title":"MA gesin lo I'olanla Re,","duration":45.779,"voices":{"male":{"file":"y-286-male.m4a","bytes":329237,"sha256":"37bbaeb34ff7a89d61d169dc7ce453e8a0e94e61c4fab30f37f17a453060ce48","duration":45.8},"female":{"file":"y-286-female.m4a","bytes":333393,"sha256":"cd5399648339bf0dddcb06f6cf88e9163f1118a4235204c24f9fb6b897e1748a","duration":45.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.742,"text":"MA gesin lo I'olanla Re,","marked":"Má gẹṣin lọ l'olanla Rẹ"},{"start":2.122,"end":4.387,"text":"Gbo! gbogb'aiye nke “Hosanna”","marked":"Gbọ́! gbogb'aiye nkè Hosanna"},{"start":4.767,"end":6.569,"text":"Olugbala, ma lo pele","marked":"Olùgbàlà, má lọ pẹ̀lẹ́"},{"start":6.949,"end":8.334,"text":"Lori im'ope at'aso.","marked":"Lórí im'ọ̀pẹ àt'aso."}],"end":8.334},{"key":"2","start":9.284,"lines":[{"start":9.284,"end":10.768,"text":"Ma gesin lo l'olanla Re,","marked":"Má gẹṣin lọ l'olanla Rẹ"},{"start":11.148,"end":12.785,"text":"Ma f 'irele gesin lo ku","marked":"Má f 'ìrẹ̀lẹ̀ gẹṣin ló kù"},{"start":13.165,"end":15.561,"text":"Kristi, 'segun Re bere na","marked":"Kristi, 'ṣẹ́gun Rẹ̀ bẹ̀rẹ̀ ná"},{"start":15.941,"end":17.517,"text":"Lori ese ati iku.","marked":"Lórí ẹ̀ṣẹ̀ àti ikú."}],"end":17.517},{"key":"3","start":18.467,"lines":[{"start":18.467,"end":19.976,"text":"Ma gesin lo l'olanla Re,","marked":"Má gẹṣin lọ l'olanla Rẹ"},{"start":20.356,"end":21.588,"text":"Ogun Angeli lat'orun","marked":"Ogun Áńgẹ́lì lát'ọ̀run"},{"start":21.968,"end":23.521,"text":"Nf'iyanu pelu ikanu","marked":"Nf'ìyanu pẹ̀lú ìkanu"},{"start":23.901,"end":25.589,"text":"Wo ebo to sunmole yi.","marked":"Wo ẹbọ tó sùnmọ́lẹ̀ yí."}],"end":25.589},{"key":"4","start":26.539,"lines":[{"start":26.539,"end":28.054,"text":"Ma gesin lo l'olanla Re,","marked":"Má gẹṣin lọ l'olanla Rẹ"},{"start":28.434,"end":29.949,"text":"lja ikehin na de tan","marked":"lja ìkẹhìn ná dé tán"},{"start":30.329,"end":32.626,"text":"Baba, lor'ite Re l'orun","marked":"Bàbá, lor'ite Rẹ l'ọ̀run"},{"start":33.006,"end":34.205,"text":"Nreti ayanfe Omo Re.","marked":"Nrètí àyànfẹ́ Ọmọ Rẹ."}],"end":34.205},{"key":"5","start":35.155,"lines":[{"start":35.155,"end":36.929,"text":"Ma gesin lo l'olanla Re,","marked":"Má gẹṣin lọ l'olanla Rẹ"},{"start":37.309,"end":38.832,"text":"Ma f'irele gesin lo ku","marked":"Má f'ìrẹ̀lẹ̀ gẹṣin ló kù"},{"start":39.212,"end":40.961,"text":"F'ara da irora f'eda","marked":"F'ara da ìrora f'ẹ̀dà"},{"start":41.341,"end":43.332,"text":"Lehin na, nde k'O ma joba.","marked":"Lẹ́hìn ná, ńdẹ k'Ó má jọba."},{"start":43.712,"end":44.229,"text":"Amin.","marked":"Àmín."}],"end":44.229}]}