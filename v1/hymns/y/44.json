{"v":1,"coll":"y","num":44,"id":"hymn_44","title":"OJO isimi Olorun","duration":41.361,"voices":{"male":{"file":"y-44-male.m4a","bytes":291775,"sha256":"6eb9f1561d6b000ceacee81ab4078fd31a24430ddcaf3b6e6dde857d03cde039","duration":41.4},"female":{"file":"y-44-female.m4a","bytes":306869,"sha256":"76a9babb7c63cfe4c455b98c506a644898ba709b33db8ae08841c5842b281a9d","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.345,"text":"OJO isimi Olorun","marked":"Ọjọ́ ìṣímí Ọlọ́run"},{"start":1.725,"end":3.012,"text":"Ojo ti o dara julo","marked":"Ọjọ́ tí ó dára jùlọ"},{"start":3.392,"end":4.75,"text":"Ti Olorun ti fun wa","marked":"Tí Ọlọ́run ti fún wa"},{"start":5.13,"end":6.65,"text":"K'awa ko simi ninu re.","marked":"K'àwa kò sìmí nínú rẹ̀."}],"end":6.65},{"key":"2","start":7.6,"lines":[{"start":7.6,"end":9.047,"text":"Ijo mefa l'O fi fun wa","marked":"Ìjọ mẹ́fà l'Ó fi fún wa"},{"start":9.427,"end":11.069,"text":"K'a fi se ise wa gbogbo","marked":"K'á fi ṣe iṣẹ́ wa gbogbo"},{"start":11.449,"end":13.256,"text":"Sugbon ojo keje yato","marked":"Ṣùgbọ́n ọjọ́ keje yàtọ̀"},{"start":13.636,"end":15.072,"text":"Ojo 'simi Olorun ni.","marked":"Ọjọ́ 'sími Ọlọ́run ni."}],"end":15.072},{"key":"3","start":16.022,"lines":[{"start":16.022,"end":17.691,"text":"K'a fi 'se asan wa,sile","marked":"K'á fi 'ṣe asán wa,sílẹ̀"},{"start":18.071,"end":19.486,"text":"Ti awa nse n'ijo mefa","marked":"Ti àwa ńṣe ń'ijó mẹ́fà"},{"start":19.866,"end":21.604,"text":"Mimo ni ise ti oni","marked":"Mímọ́́ ní iṣẹ́ ti ọ̀nì"},{"start":21.984,"end":23.097,"text":"Ti Olorun Oluwa wa.","marked":"Ti Ọlọ́run Olúwa wa."}],"end":23.097},{"key":"4","start":24.047,"lines":[{"start":24.047,"end":25.715,"text":"A pada de nisisyi","marked":"A padà dé nísìsyí"},{"start":26.095,"end":27.088,"text":"Ninu ile Olorun wa","marked":"Nínú ilé Ọlọ́run wa"},{"start":27.468,"end":29.135,"text":"Je k'a korin didun si i","marked":"Jẹ k'á kọrin dídùn sí i"},{"start":29.515,"end":30.903,"text":"Li owuro ojo oni.","marked":"Li òwúrọ̀ ọjọ́ òní."}],"end":30.903},{"key":"5","start":31.853,"lines":[{"start":31.853,"end":33.312,"text":"Ni kutukutu 'jo keje","marked":"Ní kùtùkùtù 'jọ keje"},{"start":33.692,"end":34.875,"text":"Ni ojo isimi mimo","marked":"Ní ọjọ́ isimi mímọ́́"},{"start":35.255,"end":36.807,"text":"Je k'a jumo korin didun","marked":"Jẹ k'á jùmọ̀ kọrin dídùn"},{"start":37.187,"end":38.788,"text":"Je k'a si jumo gbadura.","marked":"Jẹ k'á sì jùmọ̀ gbàdúrà."},{"start":39.168,"end":39.811,"text":"Amin.","marked":"Àmín."}],"end":39.811}]}