{"v":1,"coll":"y","num":328,"id":"hymn_328","title":"JESU t'o ku, k'o gb'aiye la","duration":37.683,"voices":{"male":{"file":"y-328-male.m4a","bytes":269716,"sha256":"1f807c74f1b4a6c5921b5d15de9026937b166a4014608ea735009ede8c6dbb02","duration":37.7},"female":{"file":"y-328-female.m4a","bytes":280412,"sha256":"1f4dcc12b0846d0fea2d12c06fa2024f92a751e890d57061ab737ecfb8a9fedc","duration":37.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.187,"text":"JESU t'o ku, k'o gb'aiye la","marked":"Jésù t'ó kú, k'ó gb'áíyé là"},{"start":3.567,"end":4.895,"text":"Jinde kuro ninu oku","marked":"Jíǹde kúrò nínú òkú"},{"start":5.275,"end":6.345,"text":"Nipa agbara re","marked":"Nípa agbára rẹ"},{"start":6.725,"end":8.435,"text":"A da sile lowo iku","marked":"A dá sílẹ̀ lọ́wọ́ ikú"},{"start":8.815,"end":10.144,"text":"O d'igbekun n'igbekun Io","marked":"Ó d'ígbèkùn n'ígbèkùn lọ"},{"start":10.524,"end":12.123,"text":"O ye, k'o ma ku mo.","marked":"Ó yẹ, k'ó má kú mọ́."}],"end":12.123},{"key":"2","start":13.073,"lines":[{"start":13.073,"end":14.999,"text":"Enyin om'OIorun, e wo","marked":"Enyin om'Ọlọ́run, ẹ wo"},{"start":15.379,"end":16.854,"text":"Olugbala ninu ogo","marked":"Olùgbàlà nínú ògo"},{"start":17.234,"end":18.341,"text":"O ti segun iku","marked":"Ó ti ṣẹ́gun ikú"},{"start":18.721,"end":20.009,"text":"Ma banuje maberu mo","marked":"Má bànújẹ́ mábẹ̀rù mọ́"},{"start":20.389,"end":22.069,"text":"O nlo pese aiye fun nyin","marked":"Ó ńlò pẹ̀sẹ̀ aiye fún nyin"},{"start":22.449,"end":23.726,"text":"Yio mu yin lo 'Ie.","marked":"Yíó mú yín lọ 'lé."}],"end":23.726},{"key":"3","start":24.676,"lines":[{"start":24.676,"end":26.413,"text":"O f'oju anu at'ife","marked":"Ó f'ojú ànú àt'ife"},{"start":26.793,"end":28.259,"text":"Wo awon ti O ra pada","marked":"Wo àwọn tí Ó rà padà"},{"start":28.639,"end":29.78,"text":"Awon ni ayo Re","marked":"Àwọn ni ayọ̀ Rẹ"},{"start":30.16,"end":31.537,"text":"O ri ayo at'ise won","marked":"Ó rí ayọ̀ àt'iṣẹ́ wọn"},{"start":31.917,"end":33.467,"text":"O bebe ki nwon le segun","marked":"Ó bẹ̀bẹ̀ kí nwọn lè ṣẹ́gun"},{"start":33.847,"end":35.202,"text":"Ki nwon ba joba lai.","marked":"Kí nwọn bá jọba láì."},{"start":35.582,"end":36.133,"text":"Amin.","marked":"Àmín."}],"end":36.133}]}