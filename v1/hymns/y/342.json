{"v":1,"coll":"y","num":342,"id":"hymn_342","title":"WO Asegun b'o ti goke","duration":76.372,"voices":{"male":{"file":"y-342-male.m4a","bytes":561768,"sha256":"1bd97f2bea4d72a68f17c62af95926187d65dcec4b16fc4f076aec7cb1314154","duration":76.4},"female":{"file":"y-342-female.m4a","bytes":584619,"sha256":"d9e09ee64ec21de29b20ec4a93111d9e5130242c1cf46ddb93a98186c5371033","duration":76.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.245,"text":"WO Asegun b'o ti goke","marked":"Wo Aṣẹ́gun b'ó ti gòkè"},{"start":2.625,"end":3.84,"text":"Wo Oba n'nu ola Re","marked":"Wo Ọba ń'nú ọlá Rẹ̀"},{"start":4.22,"end":5.63,"text":"Ogun keke ofurufu","marked":"Ogun kẹ̀kẹ́ òfúrufú"},{"start":6.01,"end":7.36,"text":"Lo s' orun agbala Re","marked":"Lọ s' ọrùn àgbàlá Rẹ"},{"start":7.74,"end":9.044,"text":"Gbo orin awon Angeli","marked":"Gbọ́ orin àwọn Áńgẹ́lì"},{"start":9.424,"end":10.654,"text":"Halleluya ni nwon nko","marked":"Hallelúyà ní nwọn ńkọ́"},{"start":11.034,"end":12.276,"text":"Awon 'lekun si si sile","marked":"Àwọn 'lẹkùn sì ṣí sílẹ̀"},{"start":12.656,"end":14.026,"text":"Lati gba Oba Orun.","marked":"Láti gba Ọba Ọ̀run."}],"end":14.026},{"key":"2","start":14.976,"lines":[{"start":14.976,"end":16.75,"text":"Tani Ologo ti mbo yi","marked":"Tani Ológo ti ḿbò yí"},{"start":17.13,"end":18.218,"text":"T'on ti ipe jubeli","marked":"T'ọ́n ti ìpè jùbẹ̀lì"},{"start":18.598,"end":20.146,"text":"Oluwa awon 'mo-ogun","marked":"Olúwa àwọn 'mo-ogun"},{"start":20.526,"end":21.805,"text":"On to ti segun fun wa","marked":"Ọ̀n tó ti ṣẹ́gun fún wa"},{"start":22.185,"end":23.501,"text":"O jiya lor'agbeleu","marked":"Ó jìyà lór'àgbéléu"},{"start":23.881,"end":25.17,"text":"O jinde ninu oku","marked":"Ó jíǹde nínú òkú"},{"start":25.55,"end":27.051,"text":"O segun Esu at'ese","marked":"Ó ṣẹ́gun Èṣù àt'ẹsẹ̀"},{"start":27.431,"end":28.71,"text":"Ati gbogbo ota Re.","marked":"Àti gbogbo ọ̀tá Rẹ."}],"end":28.71},{"key":"3","start":29.66,"lines":[{"start":29.66,"end":30.877,"text":"B'o ti nbuk'awon ore Re","marked":"B'ó ti ńbúk'àwọn ọ̀rẹ́ Rẹ̀"},{"start":31.257,"end":32.478,"text":"A gba kuro lowo won","marked":"A gbà kúrò lọ́wọ́ wọn"},{"start":32.858,"end":34.532,"text":"Bi oju nwon si ti nwo lo","marked":"Bí ojú ńwọ̀n sì ti ńwọ́ lọ"},{"start":34.912,"end":36.173,"text":"O nu nin' awosanmo","marked":"Ó nu nín' àwòsànmọ́"},{"start":36.553,"end":37.975,"text":"Enit' o ba Olorun rin","marked":"Enit' ò bá Ọlọ́run rìn"},{"start":38.355,"end":39.882,"text":"T'o si nwasu otito","marked":"T'ó sì ńwáṣu òtítọ́́"},{"start":40.262,"end":42.23,"text":"On, Enoku wa, l'a gbe lo","marked":"On, Énọ́kù wà, l'á gbé lọ"},{"start":42.61,"end":43.722,"text":"S'ile Re loke orun.","marked":"S'ilé Rẹ lókè ọ̀run."}],"end":43.722},{"key":"4","start":44.672,"lines":[{"start":44.672,"end":46.979,"text":"On, Aaron wa, gbe eje Re,","marked":"On, Aaron wá, gbé ẹ̀jẹ̀ Rẹ̀"},{"start":47.359,"end":48.803,"text":"Wo inu ikele lo","marked":"Wo inú ìkélé lọ"},{"start":49.183,"end":50.912,"text":"Josua wa, ti wo Kenaan","marked":"Jóṣúà wá, ti wọ Kénáán"},{"start":51.292,"end":52.635,"text":"Awon oba nwariri","marked":"Àwọn ọba nwariri"},{"start":53.015,"end":54.274,"text":"A fi 'di eya Israel","marked":"A fi 'di ẹ̀yà Israel"},{"start":54.654,"end":55.863,"text":"Mule nibi 'simi won","marked":"Múlé níbi 'simi wọn"},{"start":56.243,"end":57.573,"text":"Elija wa si fe fun wa","marked":"Èlíjà wa sì fẹ́ fún wa"},{"start":57.953,"end":59.272,"text":"N'ilopo meji Emi.","marked":"N'ílòpọ̀ méjì Èmi."}],"end":59.272},{"key":"5","start":60.222,"lines":[{"start":60.222,"end":61.933,"text":"lwo ti gbe ara wa wo","marked":"lwo ti gbé ara wa wọ̀"},{"start":62.313,"end":63.775,"text":"Lo s'ow' otun Olorun","marked":"Lọ s'ów' ọ̀tún Ọlọ́run"},{"start":64.155,"end":65.528,"text":"A si joko nibi giga","marked":"A sì jókò níbi gíga"},{"start":65.908,"end":67.223,"text":"Pelu Re ninu ogo","marked":"Pẹ̀lú Rẹ̀ nínú ògo"},{"start":67.603,"end":68.846,"text":"Awon Angeli mbo Jesu","marked":"Àwọn Áńgẹ́lì ḿbọ Jésù"},{"start":69.226,"end":70.928,"text":"Enia Joko Ior'ite","marked":"Éníà Jókò lór'ìtẹ́"},{"start":71.308,"end":72.933,"text":"Oluwa, b'lwo ti goke","marked":"Olúwa, b'lwọ ti gòkè"},{"start":73.313,"end":74.822,"text":"Jo je k'a le goke be.","marked":"Jọ jẹ́ k'á lè gòkè bẹ́."}],"end":74.822}]}