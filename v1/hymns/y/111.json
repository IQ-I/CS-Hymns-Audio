{"v":1,"coll":"y","num":111,"id":"hymn_111","title":"EJE k'a yin Olorun wa","duration":42.928,"voices":{"male":{"file":"y-111-male.m4a","bytes":307270,"sha256":"a2ed23c697a925ea42caf2ad0c5431f9240d83eb6110788663902a2fd950f71f","duration":43.0},"female":{"file":"y-111-female.m4a","bytes":324338,"sha256":"4c6534f7183ed1091f3b61c9a5bf0bad60df8b29ec48b5c1b2c7f9d255af823b","duration":43.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.626,"text":"EJE k'a yin Olorun wa,","marked":"Ẹ̀jẹ̀ k'á yin Ọlọ́run wa"},{"start":2.006,"end":3.466,"text":"Enit' O wa l'oke orun","marked":"Enit' Ó wà l'òkè ọ̀run"},{"start":3.846,"end":5.23,"text":"T'O fi onje fun enia","marked":"T'ó fi ońjẹ fún enia"},{"start":5.61,"end":6.97,"text":"Ti O si fi fun eranko.","marked":"Tí Ó sì fi fún ẹranko."}],"end":6.97},{"key":"2","start":7.92,"lines":[{"start":7.92,"end":9.31,"text":"O si te oju orun lo","marked":"Ó sì tẹ ojú ọ̀run lọ"},{"start":9.69,"end":11.16,"text":"O da orun on osupa,","marked":"Ó dá ọrùn ọ́n òṣùpá"},{"start":11.54,"end":12.736,"text":"Ise owo Re n'irawo","marked":"Iṣẹ́ ọwọ́ Rẹ ń'ìràwọ̀"},{"start":13.116,"end":14.603,"text":"Iye won awa ko le ka.","marked":"Iye wọn àwa kò lè kà."}],"end":14.603},{"key":"3","start":15.553,"lines":[{"start":15.553,"end":17.261,"text":"O si da ara enia,","marked":"Ó sì dá ara enia"},{"start":17.641,"end":19.037,"text":"O si fun won lemi pelu","marked":"Ó sì fún wọn lémi pẹ̀lú"},{"start":19.417,"end":20.675,"text":"O si da ni daradara,","marked":"Ó sì dá ní dáradára"},{"start":21.055,"end":23.114,"text":"Bi o ti ye, bi ba ti wa.","marked":"Bí ó ti yẹ, bí bá ti wà."}],"end":23.114},{"key":"4","start":24.064,"lines":[{"start":24.064,"end":25.485,"text":"Sugbon enia dibaje","marked":"Ṣùgbọ́n enia dibàjẹ́"},{"start":25.865,"end":27.51,"text":"Nwon si bo sinu buburu","marked":"Nwọ̀n sì bọ́ sínú búburú"},{"start":27.89,"end":29.352,"text":"Ere ese ni nwon si nje","marked":"Èrè ẹ̀ṣẹ̀ ni nwọ̀n sì ńjẹ́"},{"start":29.732,"end":31.476,"text":"Ni wahala ati n'iku.","marked":"Ní wàhálà àti n'ikú."}],"end":31.476},{"key":"5","start":32.426,"lines":[{"start":32.426,"end":33.973,"text":"Sugbon je ka yin Olorun","marked":"Ṣùgbọ́n jẹ́ ká yin Ọlọ́run"},{"start":34.353,"end":36.089,"text":"On fun wa ni Kristi Jesu","marked":"Ón fún wa ní Kristi Jésù"},{"start":36.469,"end":38.25,"text":"Lati wa awon t'o ti nu","marked":"Láti wá àwọn t'ó ti nù"},{"start":38.63,"end":40.276,"text":"Ninu ese ti nwon ti nrin.","marked":"Nínú ẹsẹ̀ tí nwọn ti ńrìn."},{"start":40.656,"end":41.378,"text":"Amin.","marked":"Àmín."}],"end":41.378}]}