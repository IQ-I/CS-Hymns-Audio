{"v":1,"coll":"y","num":396,"id":"hymn_396","title":"BIBELI mimo t'orun","duration":33.11,"voices":{"male":{"file":"y-396-male.m4a","bytes":235779,"sha256":"6362f7d1ee0622ffe9c28a4c33e55fee63aaad973dccd83e8064cb06a95f2540","duration":33.2},"female":{"file":"y-396-female.m4a","bytes":242652,"sha256":"30931875f43fca671f219209b0ba00b8de0b1e4861830c6dc895f17737c924ec","duration":33.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.547,"text":"BIBELI mimo t'orun","marked":"Bíbélì mímọ́́ t'ọrun"},{"start":1.927,"end":3.17,"text":"Owon isura t'emi","marked":"Ọwọ̀n ìṣúra t'èmi"},{"start":3.55,"end":5.005,"text":"Wo ti nwi bi mo ti ri","marked":"Wo ti ńwí bí mo ti rí"},{"start":5.385,"end":6.874,"text":"Wo ti nso bi mo ti wa.","marked":"Wọ́ ti ǹṣó bí mo ti wá."}],"end":6.874},{"key":"2","start":7.824,"lines":[{"start":7.824,"end":9.576,"text":"Wo nko mi, bi mo sina","marked":"Wò ńkọ́ mi, bí mo ṣìnà"},{"start":9.956,"end":11.094,"text":"Wo nf'ife Oluwa han","marked":"Wo nf'ìfẹ́ Olúwa hàn"},{"start":11.474,"end":13.093,"text":"Wo ti nwi bi mo ti ri","marked":"Wo ti ńwí bí mo ti rí"},{"start":13.473,"end":14.948,"text":"Wo ti nso bi mo ti wa.","marked":"Wọ́ ti ǹṣó bí mo ti wá."}],"end":14.948},{"key":"3","start":15.898,"lines":[{"start":15.898,"end":17.231,"text":"'Wo n'ima tu wa ninu","marked":"'Wò ń'imá tù wá nínú"},{"start":17.611,"end":18.761,"text":"Ninu wahala aiye","marked":"Nínú wàhálà aiye"},{"start":19.141,"end":21.065,"text":"Wo nko ni, nipa gbagbo","marked":"Wò ńkọ́ ni, nípa gbàgbọ́"},{"start":21.445,"end":22.909,"text":"Pe, a le segun iku.","marked":"Pé, a lè ṣẹ́gun ikú."}],"end":22.909},{"key":"4","start":23.859,"lines":[{"start":23.859,"end":25.596,"text":"Wo l'o nso t'ayo ti mbo","marked":"Wò l'ó ńṣó t'áyò ti ḿbọ"},{"start":25.976,"end":27.183,"text":"At' iparun elese","marked":"Àt' ìparun ẹlẹ́sẹ̀"},{"start":27.563,"end":28.896,"text":"Bibeli mimo t'orun","marked":"Bíbélì mímọ́́ t'ọrun"},{"start":29.276,"end":30.641,"text":"OwoN isura t'emi.","marked":"Ọ̀wọ́N ìṣúra t'èmi."},{"start":31.021,"end":31.56,"text":"Amin.","marked":"Àmín."}],"end":31.56}]}