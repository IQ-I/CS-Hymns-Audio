{"v":1,"coll":"y","num":324,"id":"hymn_324","title":"JI, Ji okan ayo ji, ji","duration":67.614,"voices":{"male":{"file":"y-324-male.m4a","bytes":509253,"sha256":"42c543bdcd051a2b7074228ddccbca08c474639506cb6614b9e0a3d89b4050fb","duration":67.7},"female":{"file":"y-324-female.m4a","bytes":521111,"sha256":"7622b258f583a034408af245c3d5f32a27164948cfab6febc10ceea834cc09b1","duration":67.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.887,"text":"JI, Ji okan ayo ji, ji","marked":"Jí, Jí ọkàn ayọ̀ jí, jí"},{"start":3.267,"end":4.309,"text":"Oluwa re jinde","marked":"Olúwa rẹ̀ jíǹde"},{"start":4.689,"end":6.75,"text":"Lo 'boji Re, k'o si mura","marked":"Lo 'bojì Rẹ, k'ó sì múra"},{"start":7.13,"end":8.52,"text":"Okan ati korin","marked":"Ọkàn àti kọrin"},{"start":8.9,"end":10.299,"text":"Gbogbo eda l'o si ti ji","marked":"Gbogbo ẹ̀dá l'ó sì ti jí"},{"start":10.679,"end":11.765,"text":"Ti nwon nkorin didun","marked":"Ti nwọn nkorin dídùn"},{"start":12.145,"end":13.636,"text":"Itanna 'kini t'o ko tan","marked":"Ìtànná 'kíní t'ó kò tán"},{"start":14.016,"end":15.297,"text":"Leba odo lo hu.","marked":"Lẹ́bà ọ̀dọ́ ló hù."}],"end":15.297},{"key":"2","start":16.247,"lines":[{"start":16.247,"end":18.001,"text":"Isu dede aiye y'o lo","marked":"Iṣu dédé aiye y'ó lọ"},{"start":18.381,"end":19.831,"text":"L'ojo ajinde yi","marked":"L'ọjọ́ àjíǹde yí"},{"start":20.211,"end":21.782,"text":"Iku ko si mo n'nu Kristi","marked":"Ikú kò sí mò ń'nú Kristi"},{"start":22.162,"end":23.421,"text":"Iboji ko n'ipa","marked":"Ibojì kò ń'ípá"},{"start":23.801,"end":26.087,"text":"Ninu Kristi l'a nwa, t'a nsun","marked":"Nínú Kristi l'á ńwá, t'á ńsùn"},{"start":26.467,"end":28.193,"text":"T'a nji, t'a si ndide","marked":"T'á ńjí, t'á sì ńdìde"},{"start":28.573,"end":30.015,"text":"Omije t'iku mu ba wa","marked":"Omijé t'ikú mú bá wa"},{"start":30.395,"end":31.815,"text":"Ni Jesu y'o nu nu.","marked":"Ni Jésù y'ó nù nù."}],"end":31.815},{"key":"3","start":32.765,"lines":[{"start":32.765,"end":34.706,"text":"Ki gbogbo 'eiye ati igi","marked":"Kí gbogbo 'eiye àti igi"},{"start":35.086,"end":36.422,"text":"At' itana ti ntan,","marked":"Àt' ìtàná ti ńtán"},{"start":36.802,"end":38.142,"text":"Ki nwon so ti isegun Re","marked":"Kí nwọn sọ ti ìṣẹ́gun Rẹ̀"},{"start":38.522,"end":39.764,"text":"Ati t'ajinde Re","marked":"Àti t'àjíǹde Rẹ"},{"start":40.144,"end":42.543,"text":"Papa, e gbohun nyin soke","marked":"Pápá, ẹ gbóhùn nyin sókè"},{"start":42.923,"end":43.985,"text":"E bu s'orin ayo!","marked":"Ẹ bú s'orin ayọ̀!"},{"start":44.365,"end":46.077,"text":"Enyin oke, e si gberin","marked":"Enyin òkè, ẹ sì gbẹ̀rín"},{"start":46.457,"end":47.697,"text":"Wipe, Iku ti ku.","marked":"Wípé, Ikú ti kú."}],"end":47.697},{"key":"4","start":48.647,"lines":[{"start":48.647,"end":51.703,"text":"Okan ayo, e ji, e wa","marked":"Ọkàn ayọ̀, ẹ jí, ẹ wá"},{"start":52.083,"end":53.394,"text":"Oluwa t'o jinde","marked":"Olúwa t'ó jíǹde"},{"start":53.774,"end":55.229,"text":"E yo ninu ajinde Re","marked":"Ẹ yọ̀ nínú àjíǹde Rẹ̀"},{"start":55.609,"end":56.953,"text":"K'oro Re tu nyin n'nu","marked":"K'ọ́rọ́ Rẹ̀ tu nyin ń'nú"},{"start":57.333,"end":59.673,"text":"E gbohun nyin soke, ke yin","marked":"Ẹ gbóhùn nyin sókè, kẹ́ yín"},{"start":60.053,"end":61.275,"text":"Enit' o ji dide","marked":"Enit' ò jí dìde"},{"start":61.655,"end":63.311,"text":"L'ohun kan ni ka gberin pe","marked":"L'ohun kan ní ká gbẹ̀rín pé"},{"start":63.691,"end":65.142,"text":"\"Jesu jinde fun mi.\"","marked":"Jésù jíǹde fún mi."},{"start":65.522,"end":66.064,"text":"Amin.","marked":"Àmín."}],"end":66.064}]}