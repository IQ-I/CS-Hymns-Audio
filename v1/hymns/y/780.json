{"v":1,"coll":"y","num":780,"id":"hymn_780","title":"OLORUN wa mbe larin wa","duration":46.335,"voices":{"male":{"file":"y-780-male.m4a","bytes":325756,"sha256":"c8f1cf522d9d6c3bddad05d0aeac59b569ec5338dd850320f4e423b9c5ff8aca","duration":46.4},"female":{"file":"y-780-female.m4a","bytes":335957,"sha256":"079c32ee74d201e16083f2f05c45b3653f114a68c6c171197c957963cc6719ef","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.835,"text":"OLORUN wa mbe larin wa,","marked":"Ọlọ́run wa ḿbẹ lárin wa"},{"start":2.215,"end":3.754,"text":"Y'o si bukun gbogbo wa,","marked":"Y'ó sì bùkún gbogbo wa"},{"start":4.134,"end":5.693,"text":"Wo oju orun b'o ti su","marked":"Wo ojú ọ̀run b'ó ti ṣú"},{"start":6.073,"end":7.433,"text":"Yio rojo ibukun.","marked":"Yíó rojọ́ ìbùkún."}],"end":7.433},{"key":"CHORUS","start":8.383,"lines":[{"start":8.383,"end":10.403,"text":"Egbe: K'o de, Oluwa, a be O","marked":"K'ó dé, Olúwa, a bẹ̀ Ọ́"},{"start":10.783,"end":12.208,"text":"Je k'ojo ibukun de,","marked":"Jẹ k'ọjọ́ ìbùkún dé"},{"start":12.588,"end":14.523,"text":"Awa nduro, awa nduro,","marked":"Àwa ńdúró, àwa ńdúró"},{"start":14.903,"end":16.405,"text":"M'okan gbogbo wa soji.","marked":"M'ọ̀kan gbogbo wá sọjí."}],"end":16.405},{"key":"2","start":17.355,"lines":[{"start":17.355,"end":18.637,"text":"Olorun wa mbe larin wa,","marked":"Ọlọ́run wa ḿbẹ lárin wa"},{"start":19.017,"end":20.204,"text":"Ninu ile mimo yi;","marked":"Nínú ilé mímọ́́ yí"},{"start":20.584,"end":22.156,"text":"Sugbon a nfe 'tura okan","marked":"Ṣùgbọ́n a ńfẹ́ 'tura ọkàn"},{"start":22.536,"end":23.83,"text":"Ati opo ore-ofe.","marked":"Àti ọ̀pọ̀ ọ̀rẹ́-ọ̀fẹ́."},{"start":24.21,"end":25.217,"text":"Egbe: K'o de, Oluwa...","marked":"K'ó dé, Olúwa"}],"end":25.217},{"key":"3","start":26.167,"lines":[{"start":26.167,"end":27.448,"text":"Olorun wa mbe larin wa;","marked":"Ọlọ́run wa ḿbẹ lárin wa"},{"start":27.828,"end":29.044,"text":"K'a f'okan 'gbagbo bere","marked":"K'á f'ọkàn 'gbàgbọ́ bẹ̀rẹ̀"},{"start":29.424,"end":31.413,"text":"Ohun t'a fe lowo Re, ki","marked":"Ohun t'á fẹ́ lọ́wọ́ Rẹ, kí"},{"start":31.793,"end":33.092,"text":"'Fe Re m'okan wa gbona.","marked":"'Fẹ́ Rẹ̀ m'ọkàn wa gbóná."},{"start":33.472,"end":34.626,"text":"Egbe: K'o de, Oluwa...","marked":"K'ó dé, Olúwa"}],"end":34.626},{"key":"4","start":35.576,"lines":[{"start":35.576,"end":36.855,"text":"Olugbala gb'adura wa,","marked":"Olùgbàlà gb'àdúrà wa"},{"start":37.235,"end":38.625,"text":"B'a ti f'igbagbo kunle","marked":"B'á ti f'ìgbàgbọ́́ kúnlẹ̀"},{"start":39.005,"end":40.463,"text":"Jo si ferese anu Re","marked":"Jọ sí fèrèsé ãnu Rẹ"},{"start":40.843,"end":42.499,"text":"K'o da 'bukun sori wa.","marked":"K'ó da 'bùkún sórí wa."},{"start":42.879,"end":43.942,"text":"Egbe: K'o de, Oluwa...","marked":"K'ó dé, Olúwa"},{"start":44.322,"end":44.785,"text":"Amin.","marked":"Àmín."}],"end":44.785}]}