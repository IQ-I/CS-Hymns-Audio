{"v":1,"coll":"y","num":791,"id":"hymn_791","title":"OLORUN lat'oro d'ale","duration":54.283,"voices":{"male":{"file":"y-791-male.m4a","bytes":385553,"sha256":"017fa3a5e283eaa5cbed3e4bff599c1a806ebea99f2602b90a860f837c5c0b04","duration":54.3},"female":{"file":"y-791-female.m4a","bytes":396983,"sha256":"78cfad6046303da99a812d48c958e3b8552402a2e4b39d91435865b93a45bb67","duration":54.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.851,"text":"OLORUN lat'oro d'ale","marked":"Ọlọ́run lát'ọ̀rọ̀ d'álẹ̀"},{"start":2.231,"end":3.747,"text":"Wakati wo lo dun pupo","marked":"Wákàtí wo ló dún púpọ̀"},{"start":4.127,"end":5.378,"text":"B'eyi to pe mi wa do Re","marked":"B'èyí tó pè mí wá do Rẹ"},{"start":5.758,"end":6.606,"text":"Fun Adura?","marked":"Fún Àdúrà?"}],"end":6.606},{"key":"2","start":7.556,"lines":[{"start":7.556,"end":8.973,"text":"lbukun n'itura oro","marked":"lbukun n'ítura ọrọ̀"},{"start":9.353,"end":11.052,"text":"lbukun si l'oju ale","marked":"lbùkún sì l'ojú alẹ́"},{"start":11.432,"end":13.103,"text":"Gbati mo f'adura goke","marked":"Gbati mo f'àdúrà gòkè"},{"start":13.483,"end":14.409,"text":"Kuro l'aiye.","marked":"Kúrò l'aiye."}],"end":14.409},{"key":"3","start":15.359,"lines":[{"start":15.359,"end":17.523,"text":"Gbana mole kan mo si mi","marked":"Gbaná mọ́lẹ̀ kan mo sì mí"},{"start":17.903,"end":19.457,"text":"O dan ju mole orun lo","marked":"Ó dán jù mọ́lẹ̀ ọ̀run lọ"},{"start":19.837,"end":21.331,"text":"Iri bukun t'aiye ko mo","marked":"Ìrì bùkún t'áiye kò mọ́"},{"start":21.711,"end":22.69,"text":"T'odo Re wa.","marked":"T'ọ̀dọ̀ Rẹ wà."}],"end":22.69},{"key":"4","start":23.64,"lines":[{"start":23.64,"end":25.104,"text":"Gbana l'agbara mi d'otun","marked":"Gbaná l'ágbára mi d'ọ̀tun"},{"start":25.484,"end":26.73,"text":"Gbana l'a f'ese ji mi","marked":"Gbaná l'á f'ẹsẹ̀ jí mi"},{"start":27.11,"end":28.792,"text":"Gbana l'o f'ireti orun","marked":"Gbaná l'ó f'iretí orun"},{"start":29.172,"end":30.146,"text":"M'ara mi ya.","marked":"M'ara mi yá."}],"end":30.146},{"key":"5","start":31.096,"lines":[{"start":31.096,"end":32.237,"text":"Enu ko Ie so ibukun","marked":"Ẹnu kò lè sọ ìbùkún"},{"start":32.617,"end":34.032,"text":"Ti mo nri f'aini mi gbogbo","marked":"Tí mo ńrí f'áìnì mi gbogbo"},{"start":34.412,"end":36.781,"text":"Agbara, itunu, ati Alafla.","marked":"Agbára, ìtùnú, àti Alafla."}],"end":36.781},{"key":"6","start":37.731,"lines":[{"start":37.731,"end":39.576,"text":"Eru ati iyemeji tan","marked":"Ẹrú àti iyèméjì tán"},{"start":39.956,"end":41.344,"text":"Okan mi f'orun se ile","marked":"Ọkàn mi f'ọrùn ṣe ilé"},{"start":41.724,"end":42.96,"text":"Omije 'ronupiwada","marked":"Omijé 'ronúpìwàdà"},{"start":43.34,"end":44.311,"text":"L'a nu kuro.","marked":"L'á nù kúrò."}],"end":44.311},{"key":"7","start":45.261,"lines":[{"start":45.261,"end":46.82,"text":"Titi ngo de 'le bukun na","marked":"Títí ngo dé 'lè bùkún ná"},{"start":47.2,"end":49.66,"text":"Ko s'anfani t'o le dun, bi","marked":"Kò s'áńfàní t'ó lè dùn, bí"},{"start":50.04,"end":51.449,"text":"Ki nma tu okan mi fun O","marked":"Kí ńmà tu ọkàn mi fún Ọ"},{"start":51.829,"end":52.733,"text":"Nin'adura.","marked":"Nín'àdúrà."}],"end":52.733}]}