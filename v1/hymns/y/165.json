{"v":1,"coll":"y","num":165,"id":"hymn_165","title":"OLUWA Agbara fohun","duration":62.865,"voices":{"male":{"file":"y-165-male.m4a","bytes":446371,"sha256":"21ccbe4a942c8101f6dee21c7b8a4e6332cb7eb301018250093dcab39d84b60a","duration":62.9},"female":{"file":"y-165-female.m4a","bytes":460919,"sha256":"20813ec6feb7f1c326099fc1d2aa98bbe2225b9869be45e6a80ef47570c2338f","duration":62.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.564,"text":"OLUWA Agbara fohun","marked":"Olúwa Agbára fóhun"},{"start":1.944,"end":3.389,"text":"Bi ara loke Sinai","marked":"Bí ara lókè Sínáì"},{"start":3.769,"end":5.517,"text":"Awon Angeli gbohun Re,","marked":"Àwọn Áńgẹ́lì gbóhùn Rẹ̀"},{"start":5.897,"end":7.505,"text":"Nwon si gbon fun iberu.","marked":"Nwọ̀n sì gbọ́n fún ìbẹ̀rù."}],"end":7.505},{"key":"CHORUS","start":8.455,"lines":[{"start":8.455,"end":10.123,"text":"lpe ndun, Angeli ho","marked":"lpè ńdún, Áńgẹ́lì hó"},{"start":10.503,"end":12.49,"text":"Halleluya! l'orin won","marked":"Hallelúyà! l'orin wọn"},{"start":12.87,"end":14.147,"text":"O npada bo ninu ogo","marked":"Ó ńpadà bọ̀ nínú ògo"},{"start":14.527,"end":15.889,"text":"Lati wa gba ijoba.","marked":"Láti wá gba ìjọba."}],"end":15.889},{"key":"2","start":16.839,"lines":[{"start":16.839,"end":18.179,"text":"Jesu Oluwa mbo wa,","marked":"Jésù Olúwa ḿbọ́ wa"},{"start":18.559,"end":19.679,"text":"E jade lo pade Re","marked":"Ẹ jáde lọ pàdé Rẹ̀"},{"start":20.059,"end":21.582,"text":"Opo yio kun fun ayo","marked":"Opó yio kún fún ayọ̀"},{"start":21.962,"end":23.302,"text":"Opo fun ibanuje.","marked":"Ọ̀pọ̀ fún ìbànújẹ́."}],"end":23.302},{"key":"3","start":24.252,"lines":[{"start":24.252,"end":26.227,"text":"OJO 'binu, ojo eru","marked":"Ọjọ́ 'bínú, ọjọ́ ẹrú"},{"start":26.607,"end":28.345,"text":"T'aiye t'orun yio fo-lo","marked":"T'áiye t'ọrùn yíó fọ́-lọ"},{"start":28.725,"end":30.057,"text":"Kini elese yio se","marked":"Kíni ẹlẹ́sẹ̀ yío ṣe"},{"start":30.437,"end":31.752,"text":"Le yoju ni ojo na?","marked":"Lè yọjú ní ọjọ́ ná?"}],"end":31.752},{"key":"4","start":32.702,"lines":[{"start":32.702,"end":34.205,"text":"Adun aiye ti buse","marked":"Adùn aiye ti bùṣe"},{"start":34.585,"end":36.339,"text":"Mura, Egbe Serafu;","marked":"Múra, Ẹgbẹ́ Séráfù"},{"start":36.719,"end":37.74,"text":"Olukore fere de,","marked":"Olùkórè fere dé"},{"start":38.12,"end":39.371,"text":"Alikama ni tire.","marked":"Àlìkámà ni tirẹ̀."}],"end":39.371},{"key":"5","start":40.321,"lines":[{"start":40.321,"end":41.711,"text":"Mase gbekele aiye","marked":"Masẹ̀ gbẹ́kẹ̀lé aiye"},{"start":42.091,"end":43.256,"text":"Ore aiye a fo lo","marked":"Ọ̀rẹ́ aiye á fò lọ"},{"start":43.636,"end":44.801,"text":"Enit'o gb'aiye m'aiya","marked":"Enit'ó gb'áíyé ḿ'áíyá"},{"start":45.181,"end":46.71,"text":"Y'o gun s'ebute ofo.","marked":"Y'ó gun s'èbúté ọ̀fọ̀."}],"end":46.71},{"key":"6","start":47.66,"lines":[{"start":47.66,"end":48.863,"text":"Oluwa m'awon Tire","marked":"Olúwa m'àwọn Tìrẹ"},{"start":49.243,"end":50.426,"text":"O ti se won l'ayanfe","marked":"Ó ti ṣe wọ́n l'àyànfẹ́"},{"start":50.806,"end":52.227,"text":"Awon ti ko sin Jesu","marked":"Àwọn tí kò sin Jésù"},{"start":52.607,"end":54.032,"text":"Ni yio jebi nikehin.","marked":"Ní yíó jẹ̀bi níkẹhin."}],"end":54.032},{"key":"7","start":54.982,"lines":[{"start":54.982,"end":56.279,"text":"'Gbat'ipe 'kehin ba dun","marked":"'Gbat'ìpè 'kẹ́hìn bá dùn"},{"start":56.659,"end":57.843,"text":"Jewo wa Oba Ogo","marked":"Jẹ́wọ́ wá Ọba Ògo"},{"start":58.223,"end":59.338,"text":"Nipa ore-ofe Re","marked":"Nípa ọrẹ-ọ̀fẹ́ Rẹ"},{"start":59.718,"end":61.315,"text":"Ki a le ba O gunwa.","marked":"Kí á lè bá Ọ gúnwà."}],"end":61.315}]}