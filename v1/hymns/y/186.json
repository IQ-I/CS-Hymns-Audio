{"v":1,"coll":"y","num":186,"id":"hymn_186","title":"OLUWA mbo; aiye o mi","duration":45.484,"voices":{"male":{"file":"y-186-male.m4a","bytes":328233,"sha256":"e8235abb064e6ad3dfd23f67c1e3af78f02254dcf277222ef7834f545e2817d6","duration":45.5},"female":{"file":"y-186-female.m4a","bytes":336662,"sha256":"1968bc2acf2ec965b1e7586f3e12a059a62fba9ebc6dcd43444907634a8ad323","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.079,"text":"OLUWA mbo; aiye o mi","marked":"Olúwa mbo; aiye ò mí"},{"start":2.459,"end":4.09,"text":"Oke y'o si di n'ipo won","marked":"Òkè y'ó sì di n'ípò wọn"},{"start":4.47,"end":5.963,"text":"At'irawo oju orun","marked":"Àt'ìràwọ̀ ojú ọ̀run"},{"start":6.343,"end":7.873,"text":"Y'o mu imole won kuro.","marked":"Y'ó mú ìmọ́lẹ̀̀ wọn kúrò."}],"end":7.873},{"key":"2","start":8.823,"lines":[{"start":8.823,"end":10.534,"text":"Oluwa mbo, bakanna ko","marked":"Olúwa ḿbọ̀, bákanná kọ́"},{"start":10.914,"end":12.063,"text":"Bi oti wa n'irele ri","marked":"Bí ọtí wá ń'ìrẹ̀lẹ̀ rí"},{"start":12.443,"end":14.095,"text":"Odo-agutan ti a pa","marked":"Ọ̀dọ́-àgùtàn tí a pa"},{"start":14.475,"end":16.132,"text":"Eni-iya ti o si ku.","marked":"Ẹni-ìyà tí ó sì kú."}],"end":16.132},{"key":"3","start":17.082,"lines":[{"start":17.082,"end":18.766,"text":"Oluwa mbo. li eru nla","marked":"Olúwa ḿbò. li ẹrù ńlá"},{"start":19.146,"end":20.537,"text":"L'owo ina pelu Ija","marked":"L'ọwọ́ iná pẹ̀lú Ìjà"},{"start":20.917,"end":22.306,"text":"L'or'iye apa Kerubu","marked":"L'or'iye apá Kérúbù"},{"start":22.686,"end":24.371,"text":"Mbo, Onidajo araiye.","marked":"Mbọ́, Onídàjọ́ araiye."}],"end":24.371},{"key":"4","start":25.321,"lines":[{"start":25.321,"end":26.892,"text":"Eyi ha li eniti nrin","marked":"Èyí ha li eniti nrìn"},{"start":27.272,"end":28.69,"text":"Bi ero l'opolopo aiye?","marked":"Bí èrò l'ọ́pọlọpọ aiye?"},{"start":29.07,"end":30.36,"text":"'Ti a se 'nunibini si?","marked":"'Tí a ṣe 'nunibini sí?"},{"start":30.74,"end":32.987,"text":"A! Eniti a pa l'eyi?","marked":"A! Eniti a pa l'èyí?"}],"end":32.987},{"key":"5","start":33.937,"lines":[{"start":33.937,"end":35.744,"text":"Ika: b'e wo 'nu apata","marked":"Ìkà: b'ẹ́ wó 'nú àpáta"},{"start":36.124,"end":38.288,"text":"B'e wo n'nu iho, lasan ni","marked":"B'ẹ wo n'nú ihò, lásán ni"},{"start":38.668,"end":40.753,"text":"Sugbon igbagbo t'osegun","marked":"Ṣùgbọ́n ìgbàgbọ́́ t'ọ̀sẹ̀gùn"},{"start":41.133,"end":43.084,"text":"Y'o korin pe, Oluwa de.","marked":"Y'ó kọrin pé, Olúwa dé."},{"start":43.464,"end":43.934,"text":"Amin.","marked":"Àmín."}],"end":43.934}]}