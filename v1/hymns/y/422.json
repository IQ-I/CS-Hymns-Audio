{"v":1,"coll":"y","num":422,"id":"hymn_422","title":"TERUTERU t'iyanu ni","duration":31.251,"voices":{"male":{"file":"y-422-male.m4a","bytes":218327,"sha256":"2eb2c1d122e8cffca616fea6cfb9eda0618a4d68aee41066133221198b4073cc","duration":31.3},"female":{"file":"y-422-female.m4a","bytes":222746,"sha256":"1a3a5d68ce26e781b988ef14ad4870cde714394b1cdae23bda2fd2546a7db02a","duration":31.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.799,"text":"TERUTERU t'iyanu ni","marked":"Tèrútẹrú t'ìyanu ni"},{"start":2.179,"end":3.243,"text":"Olorun mi da mi","marked":"Ọlọ́run mi dá mi"},{"start":3.623,"end":5.059,"text":"Gbogbo awon eya ara mi","marked":"Gbogbo àwọn ẹ̀yà ara mi"},{"start":5.439,"end":6.692,"text":"Ise iyanu ni.","marked":"Iṣẹ́ ìyanu ni."}],"end":6.692},{"key":"2","start":7.642,"lines":[{"start":7.642,"end":9.495,"text":"Nigbat' a da mi n'ikoko","marked":"Nígbat' a dá mi n'ìkọ̀kọ̀"},{"start":9.875,"end":11.004,"text":"O ti mo ara mi","marked":"Ó ti mọ ara mi"},{"start":11.384,"end":12.649,"text":"Eya ara mi l'O si mo","marked":"Ẹ̀yà ara mi l'Ó sì mọ́"},{"start":13.029,"end":14.481,"text":"Sa t'okan won ko si.","marked":"Sa t'ọkàn wọn kò sí."}],"end":14.481},{"key":"3","start":15.431,"lines":[{"start":15.431,"end":16.886,"text":"Olorun, iro inu Re","marked":"Ọlọ́run, irọ́ inú Rẹ"},{"start":17.266,"end":18.327,"text":"Se 'yebiye fun mi","marked":"Ṣe 'yebíye fún mi"},{"start":18.707,"end":19.942,"text":"Iye won poju iyanrin","marked":"Iye wọn pọ̀jù iyanrìn"},{"start":20.322,"end":21.531,"text":"Ti ko seni le ka.","marked":"Tí kò sẹ́ni lè kà."}],"end":21.531},{"key":"4","start":22.481,"lines":[{"start":22.481,"end":23.813,"text":"B'o ti mo eda mi bayi","marked":"B'o ti mọ ẹ̀dà mi báyì"},{"start":24.193,"end":25.406,"text":"Wadi okan temi","marked":"Wádì ọkàn tẹ̀mí"},{"start":25.786,"end":27.087,"text":"Mu mi mo ona Re lailai","marked":"Mú mi mọ ọ̀nà Rẹ̀ láíláí"},{"start":27.467,"end":28.772,"text":"Si ma to ese mi.","marked":"Sì má tọ́ ẹsẹ̀ mi."},{"start":29.152,"end":29.701,"text":"Amin.","marked":"Àmín."}],"end":29.701}]}