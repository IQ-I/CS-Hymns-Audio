{"v":1,"coll":"y","num":786,"id":"hymn_786","title":"A DUPE lowo Olorun","duration":119.84,"voices":{"male":{"file":"y-786-male.m4a","bytes":886560,"sha256":"9ba099fa519215f9a4b5dfa397d00681e74c40458e28540e3d8cb9ae9098d516","duration":119.9},"female":{"file":"y-786-female.m4a","bytes":912626,"sha256":"f2a481d2c181f3a45f752295cfd896aa05fa4923ed354f93440ed61c34406012","duration":119.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.498,"text":"A DUPE lowo Olorun","marked":"A Dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":1.878,"end":3.406,"text":"T'O fi Jesu kristi fun wa,","marked":"T'ó fi Jésù Kristi fún wa"},{"start":3.786,"end":5.08,"text":"Lati ra raiye pada","marked":"Láti ra raiye padà"},{"start":5.46,"end":7.368,"text":"Lowo ese ati esu.","marked":"Lọ́wọ́ ẹ̀ṣẹ̀ àti èṣù."}],"end":7.368},{"key":"CHORUS","start":8.318,"lines":[{"start":8.318,"end":10.132,"text":"Egbe: E yin logo, e f'ope fun","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"},{"start":10.512,"end":11.57,"text":"Olorun Metalokan","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":11.95,"end":13.156,"text":"Fun anu at'ore Re","marked":"Fún ãnú àt'ọ̀rẹ́ Rẹ"},{"start":13.536,"end":15.019,"text":"Lori gbogbo Egbe Serafu.","marked":"Lórí gbogbo Ẹgbẹ́ Séráfù."}],"end":15.019},{"key":"2","start":15.969,"lines":[{"start":15.969,"end":17.218,"text":"Agbara Olorun ndagba","marked":"Agbára Ọlọ́run ńdàgbà"},{"start":17.598,"end":19.398,"text":"Ogo Jesu nhan si wa","marked":"Ògo Jésù nhan sí wa"},{"start":19.778,"end":21.125,"text":"Agbara Emi Mimo wa,","marked":"Agbára Ẹ̀mí Mímọ́́ wa"},{"start":21.505,"end":22.903,"text":"Larin Egbe Serafu.","marked":"Lárin Ẹgbẹ́ Séráfù."},{"start":23.283,"end":25.344,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":25.344},{"key":"3","start":26.294,"lines":[{"start":26.294,"end":28.47,"text":"Gbogbo enia at'orile-ede","marked":"Gbogbo enia àt'orílẹ̀-èdè"},{"start":28.85,"end":30.222,"text":"Dorikodo s'adura","marked":"Dorikodo s'àdúrà"},{"start":30.602,"end":32.221,"text":"E yipada l'emi oto","marked":"Ẹ yípadà l'èmí ọ̀tọ̀"},{"start":32.601,"end":33.98,"text":"Ki Baba orun gba wa.","marked":"Kí Bàbá ọ̀run gbà wá."},{"start":34.36,"end":36.076,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":36.076},{"key":"4","start":37.026,"lines":[{"start":37.026,"end":39.599,"text":"Ese po, aiye yi daru","marked":"Ẹ̀ṣẹ̀ pọ̀, àìyẹ́ yí dàrú"},{"start":39.979,"end":42.141,"text":"Esu njale, o si nyo","marked":"Èṣù ńjálẹ̀, ó sì nyo"},{"start":42.521,"end":44.206,"text":"K'onigbagbo pe adura po","marked":"K'onígbàgbọ́ pé àdúrà pọ̀"},{"start":44.586,"end":46.616,"text":"K'a Ie segun ese at'esu.","marked":"K'á lè ṣẹ́gun ẹsẹ̀ àt'èṣù."},{"start":46.996,"end":48.989,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":48.989},{"key":"5","start":49.939,"lines":[{"start":49.939,"end":51.923,"text":"Olufokansin onigbagbo","marked":"Olùfọkànsìn onígbàgbọ́"},{"start":52.303,"end":53.849,"text":"Jesu mo ise ikoko re","marked":"Jésù mọ iṣẹ́ ìkọ̀kọ̀ rẹ̀"},{"start":54.229,"end":56.651,"text":"Mase lo, l'ohun Oluwa nwi","marked":"Masẹ̀ lọ, l'óhun Olúwa nwí"},{"start":57.031,"end":58.265,"text":"Oluko re nsunmole.","marked":"Olùkọ́ rẹ̀ ńsúnmọlẹ̀."},{"start":58.645,"end":60.573,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":60.573},{"key":"6","start":61.523,"lines":[{"start":61.523,"end":63.601,"text":"Kerubu, Serafu, mura","marked":"Kérúbù, Séráfù, múra"},{"start":63.981,"end":66.235,"text":"Alufa, Bishop, mura","marked":"Àlùfá, Bishop, múra"},{"start":66.615,"end":68.788,"text":"Enyin to mo Jesu, e mura","marked":"Enyin tó mọ Jésù, ẹ múra"},{"start":69.168,"end":70.726,"text":"Lojo kehin ojo dajo.","marked":"Lọ́jọ́ kẹ́hìn ọjọ́ dájọ́."},{"start":71.106,"end":73.079,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":73.079},{"key":"7","start":74.029,"lines":[{"start":74.029,"end":75.488,"text":"Ajodun miran l'awa nse","marked":"Àjọ̀dún miran l'áwá ńṣe"},{"start":75.868,"end":76.901,"text":"T'Olorun ran Moses","marked":"T'Ọlọ́run ran Moses"},{"start":77.281,"end":78.934,"text":"Lati s'egbe yi loruko","marked":"Láti s'ègbè yí lórúkọ"},{"start":79.314,"end":80.633,"text":"Ogun orun Serafu.","marked":"Ogun ọ̀run Séráfù."},{"start":81.013,"end":82.869,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":82.869},{"key":"8","start":83.819,"lines":[{"start":83.819,"end":85.886,"text":"Egbe Mose, e mura dide","marked":"Ẹgbẹ́ Mósè, ẹ múra dìde"},{"start":86.266,"end":88.642,"text":"Larin egbe Kerubu, Serafu","marked":"Lárin ẹgbẹ́ Kérúbù, Séráfù"},{"start":89.022,"end":90.492,"text":"Olorun Baba lo fun wa","marked":"Ọlọ́run Bàbá ló fún wa"},{"start":90.872,"end":92.215,"text":"Gbe asia re soke.","marked":"Gbé àsíá rẹ sókè."},{"start":92.595,"end":94.298,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":94.298},{"key":"9","start":95.248,"lines":[{"start":95.248,"end":97.653,"text":"Keferi, Imale, ewa","marked":"Kèfèrí, Ìmàlẹ̀, ẹwà"},{"start":98.033,"end":99.978,"text":"Onigbagbo, e ma kalo","marked":"Onígbàgbọ́, ẹ má kàlọ̀"},{"start":100.358,"end":101.737,"text":"Ka jo yin Olorun logo","marked":"Ká jọ yin Ọlọ́run lógo"},{"start":102.117,"end":103.548,"text":"Ka le gba ade iye.","marked":"Ká lè gba adé ìyè."},{"start":103.928,"end":105.978,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"}],"end":105.978},{"key":"10","start":106.928,"lines":[{"start":106.928,"end":108.088,"text":"Olorun Baba sanu wa","marked":"Ọlọ́run Bàbá sanu wa"},{"start":108.468,"end":110.762,"text":"Dariji wa, pa wa mo","marked":"Dáríjì wa, pa wá mọ́"},{"start":111.142,"end":113.028,"text":"Ran wa lowo, gbadura wa","marked":"Ràn wá lọ́wọ́, gbàdúrà wa"},{"start":113.408,"end":115.036,"text":"Titi aiye ainipekun.","marked":"Títí aiye àìnípẹ̀kun."},{"start":115.416,"end":117.417,"text":"Egbe: E yin logo, e f'ope fun...","marked":"Ẹ yin lógo, ẹ f'ọpẹ́ fún"},{"start":117.797,"end":118.29,"text":"Amin.","marked":"Àmín."}],"end":118.29}]}