{"v":1,"coll":"y","num":262,"id":"hymn_262","title":"OLORUN, Baba mi, Wo npe","duration":38.378,"voices":{"male":{"file":"y-262-male.m4a","bytes":277097,"sha256":"f60a3906c537dd21109fbb4531740ce183a454e748c125b569545ff14eaaeff1","duration":38.4},"female":{"file":"y-262-female.m4a","bytes":283407,"sha256":"fe4a441febbad9c87a5ec7b66b2d53e58c6a689549963e27e567a63188f75617","duration":38.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.733,"text":"OLORUN, Baba mi, Wo npe","marked":"Ọlọ́run, Bàbá mi, Wò ńpẹ́"},{"start":2.113,"end":3.316,"text":"Asako omo Re mora?","marked":"Àṣàkò ọmọ Rẹ mọ́ra?"},{"start":3.696,"end":5.159,"text":"Iwo o ha dariji mi?","marked":"Ìwọ ò ha dariji mi?"},{"start":5.539,"end":7.6,"text":"Mo de, mo de, jo gba mi la.","marked":"Mo dé, mo dé, jọ gbà mí là."}],"end":7.6},{"key":"2","start":8.55,"lines":[{"start":8.55,"end":10.239,"text":"A! Jesu, Iwo nrekoja","marked":"A! Jésù, Ìwọ ńrékọjá"},{"start":10.619,"end":12.048,"text":"Pelu ore at'agbara?","marked":"Pẹ̀lú ọ̀rẹ́ àt'ágbára?"},{"start":12.428,"end":13.826,"text":"'Wo ko ha ngbo igbe mi?","marked":"'Wò kò ha ńgbọ́ igbe mi?"},{"start":14.206,"end":16.245,"text":"Mo de, mo de, sanu fun mi.","marked":"Mo dé, mo dé, sànù fún mi."}],"end":16.245},{"key":"3","start":17.195,"lines":[{"start":17.195,"end":18.685,"text":"A! Emi Mimo Iwo ni?","marked":"A! Ẹ̀mí Mímọ́́ Ìwọ ni?"},{"start":19.065,"end":20.62,"text":"Ore ti mo ti sati pe!","marked":"Ọ̀rẹ́ tí mo ti ṣàtì pé!"},{"start":21.0,"end":22.386,"text":"Wo ha mbebe fun mi sibe?","marked":"Wò ha ḿbẹ̀bẹ̀ fún mi síbẹ̀?"},{"start":22.766,"end":25.656,"text":"Mo de, mo de, m'ailera le.","marked":"Mo dé, mo dé, m'ailera lé."}],"end":25.656},{"key":"4","start":26.606,"lines":[{"start":26.606,"end":28.728,"text":"Mo de, Oluwa, ife Re","marked":"Mo dé, Olúwa, ìfẹ́ Rẹ"},{"start":29.108,"end":31.14,"text":"Ni o nro mi t'o si nfa mi","marked":"Ní ó ńrọ́ mi t'ó sì ńfà mi"},{"start":31.52,"end":33.755,"text":"Mo wole lese re, ki nmo","marked":"Mo wọlé lẹ́sẹ̀ rẹ, kí nmọ"},{"start":34.135,"end":35.816,"text":"B'o ti dun lati je Tire.","marked":"B'ó ti dùn láti jẹ́ Tírè."},{"start":36.196,"end":36.828,"text":"Amin.","marked":"Àmín."}],"end":36.828}]}