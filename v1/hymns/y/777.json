{"v":1,"coll":"y","num":777,"id":"hymn_777","title":"JESU Olori Egbe wa","duration":53.977,"voices":{"male":{"file":"y-777-male.m4a","bytes":382149,"sha256":"5e814f1f0ae52b98dbc68a10e0ba778e8d0c4befed4ee777f5ab221d91007b62","duration":54.0},"female":{"file":"y-777-female.m4a","bytes":396974,"sha256":"6abb57a8f5c6f65dbe5d31ee4d82f9351ea23e3621944ddb3b42258e91d74e2f","duration":54.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.67,"text":"JESU Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":2.05,"end":3.671,"text":"Bukun wa k'awa to lo","marked":"Bùkún wa k'áwà tó lọ"},{"start":4.051,"end":5.198,"text":"Baba Olorisun gbogbo","marked":"Bàbá Olórísun gbogbo"},{"start":5.578,"end":6.96,"text":"Je ka ri O larin wa.","marked":"Jẹ́ ká rí Ó lárin wa."}],"end":6.96},{"key":"CHORUS","start":7.91,"lines":[{"start":7.91,"end":9.662,"text":"Egbe: Jah Jehovah! Jah Jehovah!","marked":"Jah Jehovah! Jah Jehovah!"},{"start":10.042,"end":11.131,"text":"Kabiyesi Oba wa - 6x","marked":"Kábíyèsí Ọba wa"}],"end":11.131},{"key":"2","start":12.081,"lines":[{"start":12.081,"end":13.513,"text":"Jowo Jesu awa mbe O,","marked":"Jọ̀wọ́ Jésù àwa ḿbẹ O"},{"start":13.893,"end":15.537,"text":"K'a ma ri agbako aiye","marked":"K'á má rí àgbákò aiye"},{"start":15.917,"end":18.598,"text":"K ari 'se se, k'oja k'o ta,","marked":"K àrí 'ṣe ṣe, k'ọ́jà k'ó ta"},{"start":18.978,"end":20.244,"text":"K'omo Re ma rahun mo.","marked":"K'ọmọ Rẹ mà ráhùn mọ́."}],"end":20.244},{"key":"3","start":21.194,"lines":[{"start":21.194,"end":22.849,"text":"Sure fun wa l'ojo aiye wa,","marked":"Súre fún wa l'ọjọ́ aiye wa"},{"start":23.229,"end":24.96,"text":"K'ebi ale ma pa wa,","marked":"K'ebi alẹ́ má pa wá"},{"start":25.34,"end":26.565,"text":"K'enikeni mase rahun","marked":"K'ẹ́nikẹ́ni máṣe ráhùn"},{"start":26.945,"end":28.263,"text":"M'ese Egbe wa duro.","marked":"M'ẹsẹ̀ Ẹgbẹ́ wa dúró."}],"end":28.263},{"key":"4","start":29.213,"lines":[{"start":29.213,"end":30.65,"text":"Ma je ki fitila re ku,","marked":"Má jẹ́ kí fìtílà rẹ kù"},{"start":31.03,"end":32.165,"text":"Larin Egbe Serafu","marked":"Lárin Ẹgbẹ́ Séráfù"},{"start":32.545,"end":33.95,"text":"Gege bi Serafu t'orun","marked":"Gẹ́gẹ́ bí Séráfù t'ọrun"},{"start":34.33,"end":35.559,"text":"Ki gbogbo wa jo yin O.","marked":"Kí gbogbo wa jọ yín O."}],"end":35.559},{"key":"5","start":36.509,"lines":[{"start":36.509,"end":38.192,"text":"Rant' egbe t'o wa l'okere","marked":"Rant' ẹgbẹ́ t'ó wà l'òkèrè"},{"start":38.572,"end":40.113,"text":"Fun won l'okun ilera","marked":"Fún wọn l'òkun ìlera"},{"start":40.493,"end":42.545,"text":"Aje, oso ko ma ri won,","marked":"Àjẹ́, ọ̀ṣọ́ kọ́ má rí wọn"},{"start":42.925,"end":44.434,"text":"Iwo lo ns'Alabo won.","marked":"Ìwọ lo ńs'Alábò wọn."}],"end":44.434},{"key":"6","start":45.384,"lines":[{"start":45.384,"end":47.188,"text":"Jehovah Jireh Oba wa,","marked":"Jehovah Jireh Ọba wa"},{"start":47.568,"end":49.182,"text":"Jehovah Nissi Baba","marked":"Jehovah Nissi Bàbá"},{"start":49.562,"end":50.631,"text":"Johovah Shalom,","marked":"Jóhóvah Shalom"},{"start":51.011,"end":52.428,"text":"S'amona wa lojo 'ku.","marked":"S'amọ̀nà wa lọ́jọ́ 'kú."}],"end":52.428}]}