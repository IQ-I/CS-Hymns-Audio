{"v":1,"coll":"y","num":336,"id":"hymn_336","title":"MO mo p'Oludande mi mbe'","duration":47.084,"voices":{"male":{"file":"y-336-male.m4a","bytes":345805,"sha256":"788349c42951dc022a345c6fdbf7490b9710e10c435f2f52c16231a19ca0062c","duration":47.1},"female":{"file":"y-336-female.m4a","bytes":353885,"sha256":"74cc99a14ee9c9a962c7c6638a57f49c1cb8350f07a4d9bd1353ad9cbbc796fc","duration":47.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.692,"text":"MO mo p'Oludande mi mbe'","marked":"Mo mọ p'Olùdáǹdè mi mbẹ́'"},{"start":2.072,"end":3.618,"text":"Itunu nla l'eyi fun mi","marked":"Ìtùnú ńlá l'èyí fún mi"},{"start":3.998,"end":6.573,"text":"O mbe, Enit'o ku lekan","marked":"Ó ḿbẹ, Ẹnít'ó kú lẹ́kàn"},{"start":6.953,"end":8.434,"text":"O mbe, Ori iye mi lai.","marked":"Ó ḿbẹ, Orí ìyé mi láì."}],"end":8.434},{"key":"2","start":9.384,"lines":[{"start":9.384,"end":11.299,"text":"O mbe, lati ma bukun mi","marked":"Ó ḿbẹ, láti má bùkún mi"},{"start":11.679,"end":13.079,"text":"O Si mbebe fun mi l'oke","marked":"Ó Ṣì ḿbẹ̀bẹ̀ fún mi l'òkè"},{"start":13.459,"end":15.463,"text":"O mbe, lati ji mi n'iboji","marked":"Ó ḿbẹ, láti jí mi n'íbòji"},{"start":15.843,"end":17.346,"text":"Lati gba mi la titi lai.","marked":"Láti gbà mí là títí láì."}],"end":17.346},{"key":"3","start":18.296,"lines":[{"start":18.296,"end":20.286,"text":"O mbe, Ore korikosun","marked":"Ó ḿbẹ, Ọ̀rẹ́ kòríkòsùn"},{"start":20.666,"end":22.028,"text":"Ti y'o pa mi mo de opin","marked":"Ti y'ó pa mí mọ́ dé òpin"},{"start":22.408,"end":23.966,"text":"O mbe, emi o ma korin","marked":"Ó ḿbẹ, èmi ò mà kọrin"},{"start":24.346,"end":26.226,"text":"Woli, Alufa, Oba mi.","marked":"Wòlí, Àlùfà, Ọba mi."}],"end":26.226},{"key":"4","start":27.176,"lines":[{"start":27.176,"end":28.734,"text":"O mbe, lati pese aye","marked":"Ó ḿbẹ, láti pèsè ayé"},{"start":29.114,"end":30.611,"text":"Y'o si mu mi de 'be l'ayo","marked":"Y'ó sì mú mi dé 'be l'àyò"},{"start":30.991,"end":33.164,"text":"O mbe, ogo l'oruko Re","marked":"Ó ḿbẹ, ògo l'orúkọ Rẹ̀"},{"start":33.544,"end":36.055,"text":"Jesu, okan na titi lai.","marked":"Jésù, ọ̀kan ná títí láì."}],"end":36.055},{"key":"5","start":37.005,"lines":[{"start":37.005,"end":38.729,"text":"O mbe, mo bo low'aniyan","marked":"Ó ḿbẹ, mo bọ́ lọ́w'àníyàn"},{"start":39.109,"end":40.917,"text":"O mbe, mo bo lowo ewu","marked":"Ó mbe, mo bọ́ lọ́wọ́ ewu"},{"start":41.297,"end":42.933,"text":"A! ayo l'oro yi fun mi,","marked":"A! ayọ̀ l'ọ̀rọ̀ yí fún mi"},{"start":43.313,"end":44.661,"text":"'Mo mo p'Oludande mi mbe.","marked":"'Mo mọ p'Olùdáǹdè mi ḿbẹ."},{"start":45.041,"end":45.534,"text":"Amin.","marked":"Àmín."}],"end":45.534}]}