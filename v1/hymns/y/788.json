{"v":1,"coll":"y","num":788,"id":"hymn_788","title":"OGO OBA wa ti po to","duration":41.471,"voices":{"male":{"file":"y-788-male.m4a","bytes":292481,"sha256":"ff5d6530d94e5c160252e8fd49cd78b31c2d9f791bd48b152f21d9ffebd44356","duration":41.5},"female":{"file":"y-788-female.m4a","bytes":308669,"sha256":"d9332d742de1f54131b5c7c6df92a047af11e322706d186abdbe7a6b021c26f2","duration":41.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.993,"text":"OGO OBA wa ti po to","marked":"Ògo Ọba wa ti pọ̀ tó"},{"start":2.373,"end":4.233,"text":"Ti mbe l'oke orun,","marked":"Ti mbẹ l'òkè ọ̀run"},{"start":4.613,"end":6.07,"text":"Omo-kekere wo l'o le,","marked":"Ọmọ-kékeré wo l'ó le"},{"start":6.45,"end":7.531,"text":"Korin ola 'nla Re.","marked":"Kọrin ọlá 'ńlá Rẹ."}],"end":7.531},{"key":"2","start":8.481,"lines":[{"start":8.481,"end":10.228,"text":"Ta l'o le rohin ipa Re","marked":"Ta l'ó lè ròhìn ipa Rẹ"},{"start":10.608,"end":11.65,"text":"At'ore-ofe Re","marked":"Àt'ọ̀rẹ́-ọ̀fẹ́ Rẹ"},{"start":12.03,"end":14.021,"text":"Ko s'enikan l'aiye l'orun","marked":"Kò s'enikan l'áiye l'orun"},{"start":14.401,"end":15.563,"text":"To mo titobi won.","marked":"Tó mọ títóbi wọn."}],"end":15.563},{"key":"3","start":16.513,"lines":[{"start":16.513,"end":18.366,"text":"Angeli t'o yi Oluwa ka","marked":"Áńgẹ́lì t'ó yí Olúwa ká"},{"start":18.746,"end":19.892,"text":"Ko je so 'tumo re","marked":"Kò jẹ́ sọ 'túmọ̀ rẹ̀"},{"start":20.272,"end":21.792,"text":"Sugbon nwon npa ase re mo","marked":"Ṣùgbọ́n nwọn ńpa àṣẹ rẹ̀ mọ́"},{"start":22.172,"end":23.497,"text":"Nwon si nkorin 'yin Re.","marked":"Nwọ̀n sì nkọrin 'yìn Rẹ̀."}],"end":23.497},{"key":"4","start":24.447,"lines":[{"start":24.447,"end":26.515,"text":"Nje mo fe ma ba won korin","marked":"Ǹjẹ́ mo fẹ́ má bá wọn kọrin"},{"start":26.895,"end":28.012,"text":"Ki nm'ore temi wa","marked":"Kí nm'ọ̀rẹ́ tèmi wà"},{"start":28.392,"end":30.006,"text":"Oga-Ogo ki y'o kegan","marked":"Ọ̀gá-Ògò kí y'ó kẹ́gàn"},{"start":30.386,"end":31.404,"text":"Ohun orin ewe.","marked":"Ohùn orin èwe."}],"end":31.404},{"key":"5","start":32.354,"lines":[{"start":32.354,"end":34.845,"text":"Mura, okan at'o ahno mi,","marked":"Múra, ọ̀kan àt'ó ahno mi"},{"start":35.225,"end":36.301,"text":"Lati korin iyin","marked":"Láti kọrin ìyìn"},{"start":36.681,"end":38.069,"text":"S'Olodumare Eleda","marked":"S'Olódùmarè Ẹlẹ́dàá"},{"start":38.449,"end":39.921,"text":"Ayo aw'Angeli.","marked":"Ayò àw'Áńgẹ́lì."}],"end":39.921}]}