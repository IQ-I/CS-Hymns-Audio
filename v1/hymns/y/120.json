{"v":1,"coll":"y","num":120,"id":"hymn_120","title":"JI, Okan mi, dide layo","duration":61.738,"voices":{"male":{"file":"y-120-male.m4a","bytes":449580,"sha256":"63a1b2008fee2613ba90fa524a10b7ab903e2e0dfed26c62c5fd4ab8d859c5d3","duration":61.8},"female":{"file":"y-120-female.m4a","bytes":463134,"sha256":"673297bba98afaaaec8acc4081b67200bd234c2b2f5a7fc80f0fc14f459ad453","duration":61.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.494,"text":"JI, Okan mi, dide layo","marked":"Jí, Ọkàn mi, dìde láyọ̀"},{"start":2.874,"end":3.946,"text":"Korin iyin Olugbala","marked":"Kọrin ìyìn Olùgbàlà"},{"start":4.326,"end":5.53,"text":"Ola Re bere orin mi","marked":"Ọlá Rẹ bẹ̀rẹ̀ orin mi"},{"start":5.91,"end":7.528,"text":"Seun ife Re ti po to!","marked":"Ṣéun ìfẹ́ Rẹ̀ ti pọ̀ tó!"}],"end":7.528},{"key":"2","start":8.478,"lines":[{"start":8.478,"end":9.806,"text":"O ri mo segbe n'isubu","marked":"Ó rí mo ṣègbè ń'iṣubú"},{"start":10.186,"end":12.319,"text":"Sibe, O fe mi l'afetan","marked":"Síbẹ̀, Ó fẹ́ mi l'afẹ́tàn"},{"start":12.699,"end":13.98,"text":"O yo mi ninu osi mi,","marked":"Ó yọ mí nínú òsì mi"},{"start":14.36,"end":15.787,"text":"Seun 'fe Re ti tobi to!","marked":"Ṣéun 'fẹ́ Rẹ̀ ti tóbi tó!"}],"end":15.787},{"key":"3","start":16.737,"lines":[{"start":16.737,"end":18.066,"text":"Ogun ota dide si mi","marked":"Ogun ọ̀tá dìde sí mi"},{"start":18.446,"end":20.376,"text":"Aiye at'Esu ndena mi","marked":"Àìyẹ àt'Èṣù ndena mi"},{"start":20.756,"end":22.197,"text":"On nmu mi la gbogbo re ja","marked":"Òǹ ńmú mi la gbogbo rẹ̀ já"},{"start":22.577,"end":24.525,"text":"'Seun 'fe Re to n' ipa to!","marked":"'Ṣéun 'fẹ́ Rẹ̀ tó ń' ipa tó!"}],"end":24.525},{"key":"4","start":25.475,"lines":[{"start":25.475,"end":27.455,"text":"Gba 'yonu de, ba'awosanma,","marked":"Gba 'yonu dé, bá'àwọsánmà"},{"start":27.835,"end":30.19,"text":"T'o su dudu t'o nsa ara","marked":"T'ó ṣú dùdù t'ó ńṣa ara"},{"start":30.57,"end":31.82,"text":"O duro ti mi larin re:","marked":"Ó dúró tì mí lárin rẹ̀"},{"start":32.2,"end":33.667,"text":"'Seun 'fe Re to dara to!","marked":"'Ṣéun 'fẹ́ Rẹ̀ tó dára tó!"}],"end":33.667},{"key":"5","start":34.617,"lines":[{"start":34.617,"end":35.805,"text":"'Gpọlọ l'okan ese mi","marked":"'Gpọlọ l'okan èse mi"},{"start":36.185,"end":37.472,"text":"Nfe ya Iehin Oluwa mi;","marked":"Nfẹ́ yà lẹ́hìn Olúwa mi"},{"start":37.852,"end":39.174,"text":"Sugbon bi mo ti ngbagbe Re,","marked":"Ṣùgbọ́n bí mo ti ńgbàgbé Rẹ̀"},{"start":39.554,"end":41.343,"text":"lseun ife Re ki ye.","marked":"lṣeun ìfẹ́ Rẹ̀ kì yẹ̀."}],"end":41.343},{"key":"6","start":42.293,"lines":[{"start":42.293,"end":44.026,"text":"Mo fere f'aiye sile na,","marked":"Mo fẹ́rẹ̀ f'aiye sílẹ̀ ná"},{"start":44.406,"end":45.998,"text":"Mo fe bo low'ara iku;","marked":"Mo fẹ́ bọ́ lọ́w'ara ikú"},{"start":46.378,"end":48.085,"text":"A! k'emi 'kehin mi korin","marked":"A! k'èmi 'kẹhin mi kọrin"},{"start":48.465,"end":49.896,"text":"lseun lfe Re n'iku.","marked":"lṣeun lfe Rẹ̀ n'ìkú."}],"end":49.896},{"key":"7","start":50.846,"lines":[{"start":50.846,"end":53.307,"text":"Nje ki nfo lo, ki nsi goke","marked":"Ǹjẹ́ kí nfọ́ lọ, kí nsì gòkè"},{"start":53.687,"end":55.693,"text":"S'aiye imole titi lai;","marked":"S'aiye ìmọ́lẹ̀̀ títí láí"},{"start":56.073,"end":57.656,"text":"Ki nf'ayo iyanu korin","marked":"Kí nf'àyò ìyanu kọrin"},{"start":58.036,"end":59.173,"text":"lseun ife Re lorun.","marked":"lṣeun ìfẹ́ Rẹ̀ lọ́run."},{"start":59.553,"end":60.188,"text":"Amin.","marked":"Àmín."}],"end":60.188}]}