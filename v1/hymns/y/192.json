{"v":1,"coll":"y","num":192,"id":"hymn_192","title":"JESU t'o ga julo lorun","duration":41.636,"voices":{"male":{"file":"y-192-male.m4a","bytes":293360,"sha256":"942e26cca54fa4cef5a13bfe387e458c72bd30082b514b470e37cb3c89c94108","duration":41.7},"female":{"file":"y-192-female.m4a","bytes":305629,"sha256":"a5ba4d27ecb323d35991b2893d40e4750e3031761c62e6d910c1001d3525310f","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.233,"text":"JESU t'o ga julo lorun","marked":"Jésù t'ó ga jùlọ lọ́run"},{"start":2.613,"end":3.878,"text":"lpa Re l'od'aiye","marked":"lpa Rẹ l'od'aiye"},{"start":4.258,"end":5.88,"text":"'Wo f'ogo nlanla Re sile","marked":"'Wo f'ògo ńláńlá Rẹ sílẹ̀"},{"start":6.26,"end":7.425,"text":"Lati gba aiye la.","marked":"Láti gba àìyẹ́ là."}],"end":7.425},{"key":"2","start":8.375,"lines":[{"start":8.375,"end":10.138,"text":"O w' aiye airo irele","marked":"Ó w' aiye àìro ìrẹ̀lẹ̀"},{"start":10.518,"end":11.677,"text":"Ni ara osi mi wa","marked":"Ní ara òsì mi wá"},{"start":12.057,"end":14.206,"text":"Nitori k'okan t'o sile","marked":"Nítorí k'ókan t'ó silé"},{"start":14.586,"end":15.689,"text":"Be t'ipase Re la.","marked":"Bẹ́ t'ipasẹ̀ Rẹ̀ là."}],"end":15.689},{"key":"3","start":16.639,"lines":[{"start":16.639,"end":17.952,"text":"Wiwa Re ya Angeli l'enu","marked":"Wíwá Rẹ̀ ya Áńgẹ́lì l'ẹnu"},{"start":18.332,"end":19.497,"text":"Ife t'o tobi ni","marked":"Ìfẹ́ t'ó tóbi ni"},{"start":19.877,"end":21.277,"text":"Enia l'anfani iye","marked":"Enia l'áńfàní iye"},{"start":21.657,"end":23.285,"text":"Angeli se, ko ni.","marked":"Áńgẹ́lì ṣẹ̀, kò ní."}],"end":23.285},{"key":"4","start":24.235,"lines":[{"start":24.235,"end":26.61,"text":"Nje araiye yo, sa nyin de,","marked":"Ǹjẹ́ araiye yó, sá nyín dé"},{"start":26.99,"end":27.99,"text":"E ho iho ayo","marked":"Ẹ hó ihò ayò"},{"start":28.37,"end":29.752,"text":"lgbala mbo fun elese","marked":"lgbala ḿbò fún ẹlẹ́ṣẹ̀"},{"start":30.132,"end":31.324,"text":"Jesu Olorun ni.","marked":"Jésù Ọlọ́run ni."}],"end":31.324},{"key":"5","start":32.274,"lines":[{"start":32.274,"end":34.16,"text":"Oluwa, jo ki bibo Re","marked":"Olúwa, jọ kí bíbọ̀ Rẹ"},{"start":34.54,"end":35.748,"text":"Nigba erinkeji","marked":"Nígbà ẹ̀rínkejì"},{"start":36.128,"end":37.386,"text":"Je ohun ti a nduro de,","marked":"Jẹ́ ohun tí à ńdúró dè"},{"start":37.766,"end":39.117,"text":"K' o le ba wa Layo.","marked":"K' ó lè bá wa Láyọ̀."},{"start":39.497,"end":40.086,"text":"Amin.","marked":"Àmín."}],"end":40.086}]}