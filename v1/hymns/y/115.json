{"v":1,"coll":"y","num":115,"id":"hymn_115","title":"FUN anu to po b'iyanrin","duration":40.459,"voices":{"male":{"file":"y-115-male.m4a","bytes":286879,"sha256":"19f934eeb2ed9a42c5c3e7f84202734bfd2b8189b7cd6ca43da106ee654d9301","duration":40.5},"female":{"file":"y-115-female.m4a","bytes":296400,"sha256":"52e522235063878b2e7f5d6d2c6a805dde7cfe5a568b7233935cd47098ec55ed","duration":40.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.008,"text":"FUN anu to po b'iyanrin","marked":"Fún ànú tó pọ̀ b'iyanrìn"},{"start":2.388,"end":3.491,"text":"Ti mo ngba l'ojumo","marked":"Tí mo ńgbá l'ojúmọ́"},{"start":3.871,"end":5.562,"text":"Lat' odo Jesu Oluwa","marked":"Lát' ọ̀dọ̀ Jésù Olúwa"},{"start":5.942,"end":6.934,"text":"Ki emi o fi fun?","marked":"Kí èmi ò fi fún?"}],"end":6.934},{"key":"2","start":7.884,"lines":[{"start":7.884,"end":9.25,"text":"Kini ngo fi fun Oluwa","marked":"Kíni ngo fi fún Olúwa"},{"start":9.63,"end":10.73,"text":"Lat' inu okan mi","marked":"Lát' inú ọkàn mi"},{"start":11.11,"end":12.797,"text":"Ese ti ba gbogbo re je","marked":"Ẹ̀ṣẹ̀ ti ba gbogbo rẹ̀ jẹ́"},{"start":13.177,"end":14.528,"text":"Ko tile ja mo nkan.","marked":"Kò tilẹ̀ já mọ́ nkan."}],"end":14.528},{"key":"3","start":15.478,"lines":[{"start":15.478,"end":17.009,"text":"Eyi l'ohun t'emi o se","marked":"Èyí l'ohun t'èmí ò ṣe"},{"start":17.389,"end":18.809,"text":"F'ohun to se fun mi","marked":"F'ohun tó ṣe fún mi"},{"start":19.189,"end":20.833,"text":"Em' o mu ago igbala","marked":"Em' ò mú àgọ́ ìgbàlà"},{"start":21.213,"end":22.348,"text":"Ngo kepe Olorun.","marked":"Ńgò kepe Ọlọ́run."}],"end":22.348},{"key":"4","start":23.298,"lines":[{"start":23.298,"end":24.702,"text":"Eyi l'ope ti mo le da","marked":"Èyí l'ọ̀pẹ tí mo lè dá"},{"start":25.082,"end":26.892,"text":"Emi osi, are","marked":"Ẹ̀mí òṣì, àre"},{"start":27.272,"end":28.637,"text":"Em' o ma soro ebun Re,","marked":"Em' ò mà sọ̀rọ̀ ẹ̀bùn Rẹ"},{"start":29.017,"end":30.362,"text":"Ngo si ma bere si.","marked":"Ngo sì má bẹ̀rẹ̀ sí."}],"end":30.362},{"key":"5","start":31.312,"lines":[{"start":31.312,"end":33.172,"text":"Emi ko le sin b'o ti to","marked":"Èmi kò lè sin b'ó ti tó"},{"start":33.552,"end":34.872,"text":"N ko n'ise kan to pe;","marked":"N kò ń'iṣẹ́ kan tó pé"},{"start":35.252,"end":36.526,"text":"Sugbon em'o sogo yi pe,","marked":"Ṣùgbọ́n em'o ṣògo yí pé"},{"start":36.906,"end":37.987,"text":"'Gbese ope mi po.","marked":"'Gbèsè ọpẹ́ mi pọ̀."},{"start":38.367,"end":38.909,"text":"Amin.","marked":"Àmín."}],"end":38.909}]}