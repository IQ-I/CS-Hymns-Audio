{"v":1,"coll":"y","num":345,"id":"hymn_345","title":"OLORUN goke lo","duration":40.667,"voices":{"male":{"file":"y-345-male.m4a","bytes":277130,"sha256":"aa4fe83e1c5b51b385344775c484ac5de4bf4a1b0ac7d14d56051559b533fd4a","duration":40.7},"female":{"file":"y-345-female.m4a","bytes":292892,"sha256":"65055ecc2a130dbc6a21b29e25d826f72b777ce55fa07b21267f468cfca950b3","duration":40.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.339,"text":"OLORUN goke lo","marked":"Ọlọ́run gòkè lọ"},{"start":1.719,"end":2.767,"text":"Pelu ariwo nla","marked":"Pẹ̀lú ariwo ńlá"},{"start":3.147,"end":4.004,"text":"Awon ipe orun","marked":"Àwọn ìpè ọ̀run"},{"start":4.384,"end":5.694,"text":"Nfi ayo Angeli han.","marked":"Nfi ayọ̀ Áńgẹ́lì hàn."}],"end":5.694},{"key":"CHORUS","start":6.644,"lines":[{"start":6.644,"end":8.721,"text":"Gbogbo aiye yo, k'e gberin","marked":"Gbogbo aiye yó, k'é gberin"},{"start":9.101,"end":10.695,"text":"E f'ogo fun Oba Ogo.","marked":"Ẹ f'ògo fún Ọba Ògo."}],"end":10.695},{"key":"2","start":11.645,"lines":[{"start":11.645,"end":12.908,"text":"O j'enia laiye","marked":"Ó j'enia láìyẹ"},{"start":13.288,"end":14.258,"text":"Oba wa ni loke","marked":"Ọba wà ní lókè"},{"start":14.638,"end":15.586,"text":"Ki gbogbo ile mo","marked":"Kí gbogbo ilé mọ́"},{"start":15.966,"end":17.357,"text":"lfe nla Jesu wa.","marked":"lfẹ́ ńlá Jésù wa."}],"end":17.357},{"key":"3","start":18.307,"lines":[{"start":18.307,"end":19.637,"text":"Baba fi agbara,","marked":"Bàbá fi agbára"},{"start":20.017,"end":21.049,"text":"Fun Jesu Oluwa","marked":"Fún Jésù Olúwa"},{"start":21.429,"end":22.444,"text":"Ogun Angeli mbo O","marked":"Ogun Áńgẹ́lì ḿbọ́ O"},{"start":22.824,"end":24.149,"text":"On l'Oba nla Orun.","marked":"Òǹ l'Ọba ńlá Ọ̀run."}],"end":24.149},{"key":"4","start":25.099,"lines":[{"start":25.099,"end":26.106,"text":"L'or'ite re mimo","marked":"L'or'ìtẹ́ rẹ mímọ́́"},{"start":26.486,"end":27.817,"text":"O gb'opa ododo","marked":"Ó gb'ọ̀pá òdodo"},{"start":28.197,"end":29.172,"text":"Gbogbo ota Re ni","marked":"Gbogbo ọ̀tá Rẹ ni"},{"start":29.552,"end":30.617,"text":"Yio ka lo bere.","marked":"Yío ká lọ bẹ̀rẹ̀."}],"end":30.617},{"key":"5","start":31.567,"lines":[{"start":31.567,"end":32.665,"text":"Ola Re l'ota wa","marked":"Ọlá Rẹ l'ọ̀tá wa"},{"start":33.045,"end":35.637,"text":"Esu, aiye, ese","marked":"Èṣù, aiye, ẹ̀ṣẹ̀"},{"start":36.017,"end":37.399,"text":"Sugbon y'o r'ehin won","marked":"Ṣùgbọ́n y'ó r'ehin wọn"},{"start":37.779,"end":39.117,"text":"Ijoba Re y'o de.","marked":"Ìjọba Rẹ̀ y'ó dé."}],"end":39.117}]}