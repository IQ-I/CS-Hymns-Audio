{"v":1,"coll":"y","num":455,"id":"hymn_455","title":"Ko to k'awon mimo beru","duration":43.821,"voices":{"male":{"file":"y-455-male.m4a","bytes":301716,"sha256":"f5e06b98cf2042e00ce81792062a5583af86a8fc3989f9ec38ad41a8347def21","duration":43.9},"female":{"file":"y-455-female.m4a","bytes":314111,"sha256":"1b53fbaa1c6e2d66ab406b2c42fea47d84d78c4c573f2c602ad8c61c27121dc2","duration":43.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.851,"text":"Ko to k'awon mimo beru","marked":"Kò tó k'àwọn mímọ́́ bẹ̀rù"},{"start":2.231,"end":3.281,"text":"Ki nwon so 'reti nu","marked":"Kí nwọ̀n sọ 'rètí nù"},{"start":3.661,"end":5.064,"text":"'Gba nwon ko reti 'ranwo Re,","marked":"'Gbà nwọn kò retí 'rànwọ́ Rẹ"},{"start":5.444,"end":6.794,"text":"Olugbala y'o de.","marked":"Olùgbàlà y'ó dé."}],"end":6.794},{"key":"CHORUS","start":7.744,"lines":[{"start":7.744,"end":8.699,"text":"Jesu mbo (3)","marked":"Jésù ḿbọ̀"},{"start":9.079,"end":10.02,"text":"Enyin Omo ogun,","marked":"Enyin Ọmọ ogun"},{"start":10.4,"end":11.537,"text":"E damure giri.","marked":"Ẹ damure gírí."}],"end":11.537},{"key":"2","start":12.487,"lines":[{"start":12.487,"end":14.098,"text":"Nigbati Abram mu obe","marked":"Nígbàtí Abram mú ọbẹ̀"},{"start":14.478,"end":15.419,"text":"Olorun ni \"Duro”","marked":"Ọlọ́run ní Dúró"},{"start":15.799,"end":17.433,"text":"Agbo ti o wa lohun ni","marked":"Àgbo tí ò wà lóhùn ni"},{"start":17.813,"end":18.938,"text":"Y'o dipo omo na.","marked":"Y'ó dipò ọmọ ná."}],"end":18.938},{"key":"3","start":19.888,"lines":[{"start":19.888,"end":21.145,"text":"'Gba Jona ri sinu omi","marked":"'Gba Jónà rì sínú omi"},{"start":21.525,"end":22.876,"text":"Ko ro lati yo mo","marked":"Kò rò láti yọ̀ mọ́"},{"start":23.256,"end":24.58,"text":"Sugbon Olorun ran eje","marked":"Ṣùgbọ́n Ọlọ́run rán ẹ̀jẹ́"},{"start":24.96,"end":26.127,"text":"To gbe lo s'ebute.","marked":"Tó gbé lọ s'èbúté."}],"end":26.127},{"key":"4","start":27.077,"lines":[{"start":27.077,"end":28.954,"text":"B'iru ipa at'ife yi","marked":"B'irú ipa àt'ife yi"},{"start":29.334,"end":30.528,"text":"Ti po l'oro Re to","marked":"Ti pọ̀ l'ọ̀rọ̀ Rẹ̀ tó"},{"start":30.908,"end":32.254,"text":"Emi ba ma k'aniyan mi","marked":"Èmi bá ma k'àníyàn mi"},{"start":32.634,"end":33.766,"text":"Le Oluwa lowo.","marked":"Lé Olúwa lọ́wọ́."}],"end":33.766},{"key":"5","start":34.716,"lines":[{"start":34.716,"end":36.156,"text":"E duro de iranwo Re","marked":"Ẹ dúró de ìrànwọ́ Rẹ̀"},{"start":36.536,"end":38.542,"text":"B'o tile pe, duro","marked":"B'ó tilẹ̀ pẹ́, dúró"},{"start":38.922,"end":40.438,"text":"B'ileri na tile fa 'le","marked":"B'ìlérí ná tilẹ̀ fà 'le"},{"start":40.818,"end":42.271,"text":"Sugbon ko le pe de.","marked":"Ṣùgbọ́n kò lè pẹ́ dé."}],"end":42.271}]}