{"v":1,"coll":"y","num":94,"id":"hymn_94","title":"JESU mo wa sodo Re,","duration":83.894,"voices":{"male":{"file":"y-94-male.m4a","bytes":609524,"sha256":"d3b6e0094a9f694318f799949c7b8e408bc8978bf01dafc6456f74285aa4ce05","duration":83.9},"female":{"file":"y-94-female.m4a","bytes":629130,"sha256":"92e6ce3d9f7eac1494b4f23f48916b082b556f7ea6c0855fed583f12c4d07a1b","duration":83.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.497,"text":"JESU mo wa sodo Re,","marked":"Jésù mọ̀ wá sọ́dọ̀ Rẹ̀"},{"start":1.877,"end":3.643,"text":"Je ki nle ma to O lehin","marked":"Jẹ́ kí ńlẹ̀ má tọ̀ Ọ́ lẹ́hìn"},{"start":4.023,"end":5.322,"text":"Bi 'ni mi gbogbo po si","marked":"Bí 'ni mi gbogbo pọ̀ sí"},{"start":5.702,"end":7.116,"text":"Ti ero mi gbogbo soji.","marked":"Ti èrò mi gbogbo sóji."}],"end":7.116},{"key":"CHORUS","start":8.066,"lines":[{"start":8.066,"end":9.907,"text":"E yin logo, enyin Mimo","marked":"Ẹ yin lógo, ẹnyin Mímọ́́"},{"start":10.287,"end":11.76,"text":"E f'ope fun Baba loke","marked":"Ẹ f'ọpẹ́ fún Bàbá lókè"},{"start":12.14,"end":13.756,"text":"Da wa si I'egbe Serafu,","marked":"Dá wa sí l'ègbè Séráfù"},{"start":14.136,"end":15.655,"text":"Ni kehin gba okan wa la.","marked":"Ní kẹ́hìn gba ọkàn wa là."}],"end":15.655},{"key":"2","start":16.605,"lines":[{"start":16.605,"end":18.681,"text":"Keferi, lmale, e wa","marked":"Kèfèrí, lmale, ẹ wà"},{"start":19.061,"end":20.586,"text":"Onigbagbo, ma kalo","marked":"Onígbàgbọ́, má kàlọ̀"},{"start":20.966,"end":22.168,"text":"K'a jo yin Olorun wa,","marked":"K'á jọ yin Ọlọ́run wa"},{"start":22.548,"end":23.879,"text":"K'a le d'ade ni 'kehin.","marked":"K'á lè d'áde ní 'kẹhin."}],"end":23.879},{"key":"3","start":24.829,"lines":[{"start":24.829,"end":26.02,"text":"A dupe lowo Olorun","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":26.4,"end":28.166,"text":"T'o fi Jesu Kristi fun wa","marked":"T'ó fi Jésù Kristi fún wa"},{"start":28.546,"end":30.312,"text":"Lati ra araiye pada,","marked":"Láti ra araiye padà"},{"start":30.692,"end":32.278,"text":"Lowo ese at'Esu.","marked":"Lọ́wọ́ ẹsẹ̀ àt'Èṣù."}],"end":32.278},{"key":"4","start":33.228,"lines":[{"start":33.228,"end":34.49,"text":"Egbe Serafu damure","marked":"Ẹgbẹ́ Séráfù dámùrè"},{"start":34.87,"end":36.528,"text":"Egbe Kerubu kun f 'adura","marked":"Ẹgbẹ́ Kérúbù kún f 'àdúrà"},{"start":36.908,"end":38.202,"text":"Olugbala yio gba wa la","marked":"Olùgbàlà yio gbà wá là"},{"start":38.582,"end":40.261,"text":"Oluwosan yio wo wa san.","marked":"Olùwòsàn yio wò wá sàn."}],"end":40.261},{"key":"5","start":41.211,"lines":[{"start":41.211,"end":42.791,"text":"Ojo mbo t'aiye yio pin","marked":"Ọjọ́ ḿbọ́ t'áiye yío pín"},{"start":43.171,"end":44.351,"text":"E sora enyin Mimo","marked":"Ẹ ṣọ́ra ẹnyin Mímọ́́"},{"start":44.731,"end":46.144,"text":"K'eni waju te siwaju","marked":"K'ẹni wájú tẹ̀ síwájú"},{"start":46.524,"end":48.056,"text":"K'eni ehin ma jafara.","marked":"K'ẹni ẹ̀hìn má jáfara."}],"end":48.056},{"key":"6","start":49.006,"lines":[{"start":49.006,"end":50.391,"text":"Awon to segun saju","marked":"Àwọn tó ṣẹ́gun ṣajú"},{"start":50.771,"end":52.523,"text":"Nwon nwo wa b'a ti nyo loni,","marked":"Nwọ̀n ńwọ́ wa b'á ti nyo lónì"},{"start":52.903,"end":54.613,"text":"Nwon nkan sara si wa wipe","marked":"Nwọ̀n nkan sára sí wa wípé"},{"start":54.993,"end":57.469,"text":"Te siwaju, ma fa s'ehin.","marked":"Tẹ̀ síwájú, má fa s'ehin."}],"end":57.469},{"key":"7","start":58.419,"lines":[{"start":58.419,"end":59.882,"text":"Ma siyemeji lona yi,","marked":"Má ṣiyèméjì lọ́nà yí"},{"start":60.262,"end":61.936,"text":"B'o ti wu k'o le fun o to;","marked":"B'ó ti wù k'ó lè fún ọ tó"},{"start":62.316,"end":63.94,"text":"Serafu mase foiya","marked":"Séráfù máṣe foiya"},{"start":64.32,"end":65.986,"text":"Adun y'o kehin aiye re.","marked":"Adùn y'ó kẹ́hìn aiye rẹ̀."}],"end":65.986},{"key":"8","start":66.936,"lines":[{"start":66.936,"end":68.513,"text":"Nigbati 'pe kehin ba dun","marked":"Nígbàtí 'pé kẹ́hìn bá dùn"},{"start":68.893,"end":70.62,"text":"Jesu y'o ko wa de Kenaani,","marked":"Jésù y'ó kó wa dé Kénáánì"},{"start":71.0,"end":72.355,"text":"Je ka l'ayo lodo Re","marked":"Jẹ́ ká l'àyò lọ́dọ̀ Rẹ"},{"start":72.735,"end":74.161,"text":"Fi wa s'agbala itura.","marked":"Fi wá s'ágbálà ìtura."}],"end":74.161},{"key":"9","start":75.111,"lines":[{"start":75.111,"end":76.609,"text":"E f'ogo fun Baba Ioke","marked":"Ẹ f'ògo fún Bàbá lókè"},{"start":76.989,"end":78.528,"text":"E f'ogo fun Omo pelu","marked":"Ẹ f'ògo fún Ọmọ pẹ̀lú"},{"start":78.908,"end":80.335,"text":"E f'ogo fun Emi Mimo","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́́"},{"start":80.715,"end":82.344,"text":"Metalokan lope ye fun.","marked":"Mẹ́talọ́kan lọpẹ́ yẹ fún."}],"end":82.344}]}