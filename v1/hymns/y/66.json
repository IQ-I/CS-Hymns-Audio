{"v":1,"coll":"y","num":66,"id":"hymn_66","title":"IGBALA ni, igbala ni","duration":49.646,"voices":{"male":{"file":"y-66-male.m4a","bytes":348445,"sha256":"59f5570b812613700073f581aec717adfb1b340aa62a1d8e12d6be852fc3ff37","duration":49.7},"female":{"file":"y-66-female.m4a","bytes":360103,"sha256":"f13d31db11eb9117f1c73620e0878715c5f9993b879e09442817a0bc778a4143","duration":49.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.877,"text":"IGBALA ni, igbala ni","marked":"Ìgbàlà ni, ìgbàlà ni"},{"start":2.257,"end":3.329,"text":"Awa elese nfe","marked":"Àwa ẹlẹ́sẹ̀ ńfẹ́"},{"start":3.709,"end":5.029,"text":"Nitori ninu buburu","marked":"Nítorí nínú búburú"},{"start":5.409,"end":6.849,"text":"T'a se l'awa nsegbe.","marked":"T'á ṣe l'áwá ńṣegbè."}],"end":6.849},{"key":"2","start":7.799,"lines":[{"start":7.799,"end":9.673,"text":"lse owo wa ti a nse","marked":"lse ọwọ́ wa tí a ńṣe"},{"start":10.053,"end":11.08,"text":"O nwi nigbagbogbo","marked":"Ó ńwí nígbàgbogbo"},{"start":11.46,"end":13.323,"text":"Pe, igbala ko si nibe","marked":"Pé, ìgbàlà kò sí níbẹ̀"},{"start":13.703,"end":15.69,"text":"Ise ko le gba ni.","marked":"Iṣẹ́ kò lè gbà ni."}],"end":15.69},{"key":"3","start":16.64,"lines":[{"start":16.64,"end":18.764,"text":"Awa nsebo, awa nrubo","marked":"Àwa ńṣebò, àwa ńrúbọ"},{"start":19.144,"end":20.582,"text":"A nkorin, a si njo","marked":"A nkorin, a sì njo"},{"start":20.962,"end":22.679,"text":"Sugbon a ko ri igbala","marked":"Ṣùgbọ́n a kò rí ìgbàlà"},{"start":23.059,"end":24.226,"text":"Ninu gbogbo wonyi.","marked":"Nínú gbogbo wọ̀nyí."}],"end":24.226},{"key":"4","start":25.176,"lines":[{"start":25.176,"end":26.467,"text":"Nibo ni igbala gbe wa?","marked":"Níbo ni ìgbàlà gbé wa?"},{"start":26.847,"end":28.327,"text":"Fi han ni, fi han ni","marked":"Fi hàn ni, fi hàn ni"},{"start":28.707,"end":31.112,"text":"B'o wa loke, bi isale","marked":"B'ó wà lókè, bí ìsàlẹ̀"},{"start":31.492,"end":33.014,"text":"B'o ba mo, wi fun wa.","marked":"B'ó bá mọ́, wí fún wa."}],"end":33.014},{"key":"5","start":33.964,"lines":[{"start":33.964,"end":35.532,"text":"Jesu ni se Olugbala","marked":"Jésù ní ṣe Olùgbàlà"},{"start":35.912,"end":36.979,"text":"Jesu I'Oluwa wa;","marked":"Jésù l'Olúwa wa"},{"start":37.359,"end":38.78,"text":"lgbala wa li owo Re","marked":"lgbala wa li ọwọ́ Rẹ̀"},{"start":39.16,"end":40.28,"text":"Fun awa elese.","marked":"Fún àwa ẹlẹ́ṣẹ̀."}],"end":40.28},{"key":"6","start":41.23,"lines":[{"start":41.23,"end":42.866,"text":"Wa nisisyi, wa loro","marked":"Wà nísìsyí, wa lọ̀rọ̀"},{"start":43.246,"end":44.074,"text":"lfe wa ninu Re,","marked":"lfẹ́ wà nínú Rẹ̀"},{"start":44.454,"end":46.465,"text":"Enyin ti o buru l' O npe","marked":"Enyin tí ó burú l' Ó ńpẹ́"},{"start":46.845,"end":48.097,"text":"E wa gba igbala.","marked":"Ẹ wá gba ìgbàlà."}],"end":48.097}]}