{"v":1,"coll":"y","num":267,"id":"hymn_267","title":"ISE gbogbo ti awa nse","duration":31.582,"voices":{"male":{"file":"y-267-male.m4a","bytes":221771,"sha256":"ea4ad670b527cc10957b18dcbd1e07b1783dd5650ceb50c00d351be0b7466937","duration":31.6},"female":{"file":"y-267-female.m4a","bytes":229936,"sha256":"de25e46912d2deee23146a126b69c199218f074356a3aa0bca1f3e5c98e3b3ca","duration":31.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.732,"text":"ISE gbogbo ti awa nse","marked":"Iṣẹ́ gbogbo ti àwa ńṣe"},{"start":2.112,"end":3.35,"text":"Ni Olorun ti ri","marked":"Ni Ọlọ́run ti rí"},{"start":3.73,"end":5.216,"text":"Ero gbogbo t'o wa ninu","marked":"Èrò gbogbo t'ó wà nínú"},{"start":5.596,"end":6.595,"text":"Ni Olorun si mo.","marked":"Ni Ọlọ́run sì mọ̀."}],"end":6.595},{"key":"2","start":7.545,"lines":[{"start":7.545,"end":8.968,"text":"A ko le f'ese wa pamo","marked":"A kò lè f'ẹsẹ̀ wa pamọ́"},{"start":9.348,"end":10.529,"text":"Gbogbo won l'O ti mo","marked":"Gbogbo wọn l'Ó ti mọ́"},{"start":10.909,"end":13.037,"text":"A npuro, a ntan 'ra wa je","marked":"A npuro, à ntàn 'ra wa jẹ́"},{"start":13.417,"end":14.809,"text":"B'a ro pe ko mo won.","marked":"B'á rò pé kò mọ̀ wọ́n."}],"end":14.809},{"key":"3","start":15.759,"lines":[{"start":15.759,"end":17.063,"text":"Ohun gbogbo han ni gbangba","marked":"Ohun gbogbo hàn ní gbangba"},{"start":17.443,"end":18.267,"text":"Ni oju Olorun","marked":"Ní ojú Ọlọ́run"},{"start":18.647,"end":19.905,"text":"Okunkun ati imole","marked":"Òkùnkùn àti ìmọ́lẹ̀̀"},{"start":20.285,"end":21.752,"text":"Si ri bakanna fun.","marked":"Sì rí bákanná fún."}],"end":21.752},{"key":"4","start":22.702,"lines":[{"start":22.702,"end":24.061,"text":"Olorun, je k'a ranti pe","marked":"Ọlọ́run, jẹ k'á rántí pé"},{"start":24.441,"end":25.398,"text":"Oju re si ri wa","marked":"Ojú rẹ̀ sì rí wa"},{"start":25.778,"end":27.249,"text":"Si jeki awa k'o beru","marked":"Sì jẹ́kí àwa k'ó bẹ̀rù"},{"start":27.629,"end":29.006,"text":"Lati dese si O.","marked":"Láti dẹ́ṣẹ̀ sí Ọ."},{"start":29.386,"end":30.033,"text":"Amin.","marked":"Àmín."}],"end":30.033}]}