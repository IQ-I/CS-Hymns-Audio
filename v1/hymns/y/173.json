{"v":1,"coll":"y","num":173,"id":"hymn_173","title":"Wa, enyin olope wa","duration":60.849,"voices":{"male":{"file":"y-173-male.m4a","bytes":450737,"sha256":"fc2f9a7d3a0660d868abf3a710264511bc581d52005eca1a56ae1e4298fb97cf","duration":60.9},"female":{"file":"y-173-female.m4a","bytes":460557,"sha256":"4379b244d085c39b3459003d77afad1239f6067cdb706831f095606149c8e6be","duration":60.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.061,"text":"Wa, enyin olope wa,","marked":"Wá, enyin ọlọ́pẹ́ wa"},{"start":2.441,"end":3.643,"text":"Gbe orin ikore ga","marked":"Gbé orin ìkórè ga"},{"start":4.023,"end":5.359,"text":"Ire gbogbo ti wole","marked":"Irè gbogbo ti wọlé"},{"start":5.739,"end":6.958,"text":"K'otutu oye to de","marked":"K'òtútù oyè tó dé"},{"start":7.338,"end":8.57,"text":"Olorun Eleda wa","marked":"Ọlọ́run Ẹlẹ́dàá wa"},{"start":8.95,"end":10.326,"text":"L'o ti pese f'aini wa","marked":"L'ó ti pèsè f'áìnì wa"},{"start":10.706,"end":11.973,"text":"Wa k'a re 'le Olorun","marked":"Wá k'á rẹ̀ 'lé Ọlọ́run"},{"start":12.353,"end":13.756,"text":"Gbe orin ikore ga.","marked":"Gbé orin ìkórè ga."}],"end":13.756},{"key":"2","start":14.706,"lines":[{"start":14.706,"end":15.937,"text":"Oko, Olorun l'aiye","marked":"Ọkọ, Ọlọ́run l'aiye"},{"start":16.317,"end":17.503,"text":"Lati s'eso iyin Re","marked":"Láti s'èso ìyìn Rẹ"},{"start":17.883,"end":19.243,"text":"Alikama at'epo","marked":"Àlìkámà àt'èpò"},{"start":19.623,"end":21.256,"text":"Ndagba f'aro tab'ayo","marked":"Ndagba f'aró tab'àyò"},{"start":21.636,"end":23.465,"text":"Ehu na. ipe tele","marked":"Èhu ná. ìpè tẹ́lẹ̀"},{"start":23.845,"end":24.964,"text":"Siri oka nikehin","marked":"Sírí ọkà nikehin"},{"start":25.344,"end":26.812,"text":"Oluwa 'kore, mu wa","marked":"Olúwa 'kórè, mú wa"},{"start":27.192,"end":28.619,"text":"Je eso rere fun O.","marked":"Jẹ èso rere fún Ọ."}],"end":28.619},{"key":"3","start":29.569,"lines":[{"start":29.569,"end":30.898,"text":"N'tori Olorun wa mbo","marked":"N'torí Ọlọ́run wà ḿbọ́"},{"start":31.278,"end":32.649,"text":"Y'o si kore Re s'ile","marked":"Y'ó sì kórè Rẹ̀ s'ilẹ̀"},{"start":33.029,"end":34.294,"text":"On o gbon gbogbo panti","marked":"On ò gbọ́n gbogbo pàǹtí"},{"start":34.674,"end":36.103,"text":"Kuro l'oko Re n'jo na","marked":"Kúrò l'ọkọ Rẹ ń'jọ ná"},{"start":36.483,"end":37.766,"text":"Y'o f'ase f'awon Angeli","marked":"Y'ó f'àṣẹ f'àwọn Áńgẹ́lì"},{"start":38.146,"end":39.845,"text":"Lati gba epo s'ina","marked":"Láti gba epo s'íná"},{"start":40.225,"end":41.712,"text":"Lati ko alikama","marked":"Láti kọ àlìkámà"},{"start":42.092,"end":43.606,"text":"Si aba Re titi lai.","marked":"Sí àbá Rẹ títí láì."}],"end":43.606},{"key":"4","start":44.556,"lines":[{"start":44.556,"end":45.927,"text":"Beni, ma wa, Oluwa","marked":"Bẹni, má wá, Olúwa"},{"start":46.307,"end":47.594,"text":"Si ikore ikehin","marked":"Sí ìkórè ìkẹhìn"},{"start":47.974,"end":49.364,"text":"Ko awon enia Re jo","marked":"Kó àwọn enia Rẹ jọ"},{"start":49.744,"end":51.259,"text":"Kuro l'ese at' aro","marked":"Kúrò l'ẹsẹ̀ àt' àrò"},{"start":51.639,"end":53.202,"text":"So won di mimo lailai","marked":"Sọ wọ́n di mímọ́́ láíláí"},{"start":53.582,"end":54.806,"text":"Ki nwon le ma ba O gbe;","marked":"Kí nwọn lè má bá Ọ gbé"},{"start":55.186,"end":56.563,"text":"Wa t'iwo t'Angeli Re,","marked":"Wá t'ìwo t'Áńgẹ́lì Rẹ"},{"start":56.943,"end":58.343,"text":"Gbe orin ikore ga.","marked":"Gbé orin ìkórè ga."},{"start":58.723,"end":59.299,"text":"Amin.","marked":"Àmín."}],"end":59.299}]}