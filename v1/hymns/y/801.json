{"v":1,"coll":"y","num":801,"id":"hymn_801","title":"MO n fe O n'gha gbogbo","duration":43.509,"voices":{"male":{"file":"y-801-male.m4a","bytes":293878,"sha256":"ecb5d583d781decef5dfbf3f82a903cf202742edcd11164f0491c176c1efc21b","duration":43.6},"female":{"file":"y-801-female.m4a","bytes":307531,"sha256":"f358860f964ba71c4cd9bde973c57d6e81eb1d70859530800b695841e874c7f4","duration":43.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.66,"text":"MO n fe O n'gha gbogbo","marked":"Mò ń fẹ́ Ò n'gha gbogbo"},{"start":2.04,"end":3.107,"text":"Oluwa Oloore","marked":"Olúwa Olóore"},{"start":3.487,"end":5.057,"text":"Ko s'ohun ti n fun ni","marked":"Kò s'óhun tí ń fún ni"},{"start":5.437,"end":6.568,"text":"N'sinmi bii Re.","marked":"N'sinmi bíi Rẹ."}],"end":6.568},{"key":"CHORUS","start":7.518,"lines":[{"start":7.518,"end":10.685,"text":"Mo n fe, o aah! mo n fe O","marked":"Mò ń fẹ́, o aah! mò ń fẹ́ O"},{"start":11.065,"end":12.42,"text":"Ni wakati gbogbo","marked":"Ní wákàtí gbogbo"},{"start":12.8,"end":13.694,"text":"Bukun mi Olugbala","marked":"Bùkún mi Olùgbàlà"},{"start":14.074,"end":15.087,"text":"Mo wa do Re.","marked":"Mo wá do Rẹ."}],"end":15.087},{"key":"2","start":16.037,"lines":[{"start":16.037,"end":17.567,"text":"Mo n fe O n'gba gbogbo","marked":"Mò ń fẹ́ Ò ń'gba gbogbo"},{"start":17.947,"end":18.989,"text":"Duro ti mi","marked":"Dúró tì mí"},{"start":19.369,"end":20.443,"text":"Idanwo ko nipa","marked":"Ìdánwò kò nípa"},{"start":20.823,"end":21.942,"text":"B'o wa n'tosi.","marked":"B'ó wá ń'tòsí."}],"end":21.942},{"key":"3","start":22.892,"lines":[{"start":22.892,"end":24.323,"text":"Mo n fe O n'gba gbogbo","marked":"Mò ń fẹ́ Ò ń'gba gbogbo"},{"start":24.703,"end":25.486,"text":"N'ipokipo","marked":"N'ipòkípò"},{"start":25.866,"end":27.014,"text":"Yara wa ba mi gbe","marked":"Yàrá wá bá mi gbé"},{"start":27.394,"end":28.565,"text":"Ki n ma p'ofo","marked":"Kí n má p'ófo"}],"end":28.565},{"key":"4","start":29.515,"lines":[{"start":29.515,"end":30.927,"text":"Mo n fe O n'gba gbogbo","marked":"Mò ń fẹ́ Ò ń'gba gbogbo"},{"start":31.307,"end":32.217,"text":"F'ife Re han","marked":"F'ìfẹ́ Rẹ hàn"},{"start":32.597,"end":33.74,"text":"K'O je k'ileri Re","marked":"K'ó jẹ́ k'ìlérí Rẹ̀"},{"start":34.12,"end":35.021,"text":"Le se si mi","marked":"Lè ṣe sí mi"}],"end":35.021},{"key":"5","start":35.971,"lines":[{"start":35.971,"end":37.247,"text":"Mo nfe O n'gba gbogbo","marked":"Mo nfe O ń'gba gbogbo"},{"start":37.627,"end":38.618,"text":"Eni Mimo julo","marked":"Ẹni Mímọ́́ jùlọ"},{"start":38.998,"end":40.748,"text":"Se mi n' ti Re tooto","marked":"Ṣe mí n' tí Re tòótọ́"},{"start":41.128,"end":41.959,"text":"Omo Olorun.","marked":"Ọmọ Ọlọ́run."}],"end":41.959}]}