{"v":1,"coll":"y","num":388,"id":"hymn_388","title":"OLORUN Metalokan","duration":32.022,"voices":{"male":{"file":"y-388-male.m4a","bytes":221340,"sha256":"93fdca970fe14d7db7423f02a24e86cd7a2e5456ed74c4842ab085c361423ab7","duration":32.1},"female":{"file":"y-388-female.m4a","bytes":229228,"sha256":"a3dc408bfe793f0f3fde0ff1df3b59252e40c2dabd67a0a195147ba536db5865","duration":32.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.395,"text":"OLORUN Metalokan","marked":"Ọlọ́run Mẹ́talọ́kan"},{"start":1.775,"end":3.094,"text":"Oba ile at'okun","marked":"Ọba ilé àt'ókùn"},{"start":3.474,"end":5.102,"text":"Gbo ti wa bi a ti nko","marked":"Gbọ́ ti wá bí a ti ńkọ́"},{"start":5.482,"end":6.293,"text":"Orin iyin Re.","marked":"Orin ìyìn Rẹ̀."}],"end":6.293},{"key":"2","start":7.243,"lines":[{"start":7.243,"end":8.909,"text":"'Wo imole, l'owuro","marked":"'Wo ìmọ́lẹ̀̀, l'òwúrọ̀"},{"start":9.289,"end":10.473,"text":"Tan mole Re yi wa ka","marked":"Tàn mọ́lẹ̀ Rẹ̀ yí wa ká"},{"start":10.853,"end":12.161,"text":"Je ki ebun rere Re","marked":"Jẹ́ kí ẹ̀bùn rere Rẹ"},{"start":12.541,"end":13.723,"text":"M'aiya wa bale.","marked":"M'áíyá wa balẹ̀."}],"end":13.723},{"key":"3","start":14.673,"lines":[{"start":14.673,"end":16.888,"text":"Wo 'mole, nigb'orun wo,","marked":"Wò 'mọ́lẹ̀, nigb'orun wo"},{"start":17.268,"end":18.61,"text":"K'a ri idariji gba;","marked":"K'á rí ìdáríjì gbà"},{"start":18.99,"end":20.376,"text":"Ki alafia orun","marked":"Kí àlàáfíà ọ̀run"},{"start":20.756,"end":21.995,"text":"F'itura fun wa.","marked":"F'ìtura fún wa."}],"end":21.995},{"key":"4","start":22.945,"lines":[{"start":22.945,"end":24.055,"text":"Olorun Metalokan!","marked":"Ọlọ́run Mẹ́talọ́kan!"},{"start":24.435,"end":26.15,"text":"Isin wa laiye ko to!","marked":"Ìsìn wa láìyẹ kó tó!"},{"start":26.53,"end":27.938,"text":"A nreti lati dapo","marked":"A ńrètí láti dàpọ̀"},{"start":28.318,"end":29.493,"text":"Mo awon t'orun.","marked":"Mọ àwọn t'ọrun."},{"start":29.873,"end":30.472,"text":"Amin.","marked":"Àmín."}],"end":30.472}]}