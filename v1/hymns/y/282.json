{"v":1,"coll":"y","num":282,"id":"hymn_282","title":"IFE l'Olorun, anu Re","duration":32.978,"voices":{"male":{"file":"y-282-male.m4a","bytes":226845,"sha256":"9c71c0dd0de7417a4de7baeb3080e6e2580154044f5efb93f3436bc9b2c4de35","duration":33.0},"female":{"file":"y-282-female.m4a","bytes":238451,"sha256":"587cd4fa30da902ff06962557abdada6b73a20d91d3a91f910235ce8d50d5704","duration":33.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.948,"text":"IFE l'Olorun, anu Re","marked":"Ìfẹ́ l'Ọlọ́run, ãnú Rẹ̀"},{"start":2.328,"end":3.334,"text":"Tan si ona wa gbogbo","marked":"Tàn sí ọ̀nà wa gbogbo"},{"start":3.714,"end":5.173,"text":"O fun wa ni alafia","marked":"Ó fún wa ní àlàáfíà"},{"start":5.553,"end":7.053,"text":"Ife ni Olorun wa.","marked":"Ìfẹ́ ni Ọlọ́run wa."}],"end":7.053},{"key":"2","start":8.003,"lines":[{"start":8.003,"end":9.343,"text":"Iku ndoro pupopupo","marked":"Ikú ńdọ̀rọ̀ púpọ̀púpọ̀"},{"start":9.723,"end":10.906,"text":"Enia si ndibaje","marked":"Éníà sì ndibaje"},{"start":11.286,"end":12.715,"text":"Sugbon anu Re wa titi","marked":"Ṣùgbọ́n ãnú Rẹ̀ wà títí"},{"start":13.095,"end":14.247,"text":"Ife ni Olorun wa.","marked":"Ìfẹ́ ni Ọlọ́run wa."}],"end":14.247},{"key":"3","start":15.197,"lines":[{"start":15.197,"end":16.896,"text":"Lakoko t'o dab'o sokun","marked":"Lákòkò t'ó dab'o sókun"},{"start":17.276,"end":18.419,"text":"A nri Ore Re daju","marked":"A ńrí Ọ̀rẹ́ Rẹ̀ dájú"},{"start":18.799,"end":20.422,"text":"O tan imole Re fun wa","marked":"Ó tan ìmọ́lẹ̀̀ Rẹ̀ fún wa"},{"start":20.802,"end":22.078,"text":"Ife ni Olorun wa.","marked":"Ìfẹ́ ni Ọlọ́run wa."}],"end":22.078},{"key":"4","start":23.028,"lines":[{"start":23.028,"end":24.987,"text":"O so 'reti, at'itunu","marked":"Ó sọ 'reti, àt'ìtùnú"},{"start":25.367,"end":26.868,"text":"Mo aniyan aiye wa,","marked":"Mọ àníyàn aiye wa"},{"start":27.248,"end":28.672,"text":"Ogo Re ntan nibi gbogbo","marked":"Ògò Rẹ̀ ńtàn níbi gbogbo"},{"start":29.052,"end":30.412,"text":"Ife ni Olorun wa.","marked":"Ìfẹ́ ni Ọlọ́run wa."},{"start":30.792,"end":31.428,"text":"Amin.","marked":"Àmín."}],"end":31.428}]}