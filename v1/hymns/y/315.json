{"v":1,"coll":"y","num":315,"id":"hymn_315","title":"ISIMI awon mimo","duration":56.068,"voices":{"male":{"file":"y-315-male.m4a","bytes":400219,"sha256":"2668321fda2bab5eaf3cbe858f5cfb4f2caa475663562f2e5cceff9d479477d3","duration":56.1},"female":{"file":"y-315-female.m4a","bytes":425139,"sha256":"78e1d7b926e8fc059a8eae123e84a0bdf47f85d0c15cf63098f1fe7910238439","duration":56.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.315,"text":"ISIMI awon mimo,","marked":"Isimi àwọn mímọ́́"},{"start":1.695,"end":2.687,"text":"Ojo ohun ijinle,","marked":"Ọjọ́ ohun ìjìnlẹ̀"},{"start":3.067,"end":4.201,"text":"Apere isimi Re,","marked":"Apẹ̀rẹ̀ isimi Rẹ"},{"start":4.581,"end":5.879,"text":"Oluwa simi 'se Re,","marked":"Olúwa simi 'se Rẹ"},{"start":6.259,"end":7.627,"text":"O ya 'jo na si mimo.","marked":"Ó ya 'jọ ná sí mímọ́́."}],"end":7.627},{"key":"2","start":8.577,"lines":[{"start":8.577,"end":9.737,"text":"Loni oku Oluwa,","marked":"Lóní òkú Olúwa"},{"start":10.117,"end":11.334,"text":"Nsimi ninu iboji;","marked":"Nsimi nínú ibojì"},{"start":11.714,"end":13.138,"text":"A ti we l' aso oku,","marked":"A ti wẹ̀ l' aso òkú"},{"start":13.518,"end":14.875,"text":"Lat' ori titi d'ese,","marked":"Lát' orí títí d'ẹsẹ̀"},{"start":15.255,"end":16.55,"text":"A si fi okuta se,","marked":"A sì fi òkúta ṣe"},{"start":16.93,"end":18.433,"text":"A si ti edidi di.","marked":"A sì ti èdìdì dì."}],"end":18.433},{"key":"3","start":19.383,"lines":[{"start":19.383,"end":21.241,"text":"Oluwa, titi aiye,","marked":"Olúwa, títí aiye"},{"start":21.621,"end":22.862,"text":"L' a o ma pa eyi mo,","marked":"L' a ò má pa èyí mọ́"},{"start":23.242,"end":25.145,"text":"A' o t' ilekun pinpin,","marked":"A' ò t' ilekun pinpin"},{"start":25.525,"end":26.713,"text":"K' ariwo ma ba wole,","marked":"K' ariwo má bá wọ́lẹ̀"},{"start":27.093,"end":28.572,"text":"A o fi suru duro,","marked":"A ó fi ṣùrù dúró"},{"start":28.952,"end":30.308,"text":"Tit' lwo o tun pada.","marked":"Tít' lwo ò tún padà."}],"end":30.308},{"key":"4","start":31.258,"lines":[{"start":31.258,"end":32.731,"text":"Gbogbo awon t' o ti sun,","marked":"Gbogbo àwọn t' ò ti sùn"},{"start":33.111,"end":34.428,"text":"Nwon o wa ba O simi;","marked":"Nwọn ò wá bá Ọ ṣímí"},{"start":34.808,"end":35.952,"text":"Nwon o bo lowo lala,","marked":"Nwọn ò bọ́ lọ́wọ́ lálá"},{"start":36.332,"end":37.581,"text":"Nwon nreti ipe 'kehin,","marked":"Nwọn nrètí ìpè 'kẹ́hìn"},{"start":37.961,"end":39.527,"text":"T' a o di eda titun,","marked":"T' a ó di ẹ̀dà titun"},{"start":39.907,"end":42.089,"text":"T' ayo wa ki y'o l' opin.","marked":"T' ayo wa kí y'ó l' opin."}],"end":42.089},{"key":"5","start":43.039,"lines":[{"start":43.039,"end":44.619,"text":"Jesu yo wa nin' ese","marked":"Jésù yọ wá nín' ẹ̀ṣẹ̀"},{"start":44.999,"end":46.584,"text":"K' a ba le ba won wole,","marked":"K' a bá lè bá wọn wọ́lé"},{"start":46.964,"end":48.304,"text":"Ewu ati 'se y' o tan,","marked":"Ewu àti 'ṣe y' ò tán"},{"start":48.684,"end":50.26,"text":"A o f' ayo goke Io,","marked":"A ò f' ayọ̀ gòkè lọ"},{"start":50.64,"end":51.723,"text":"A o ri Olorun wa,","marked":"A ò rí Ọlọ́run wa"},{"start":52.103,"end":53.639,"text":"A o si ma sin lailai.","marked":"A ò sì má sìn láíláí."},{"start":54.019,"end":54.518,"text":"Amin.","marked":"Àmín."}],"end":54.518}]}