{"v":1,"coll":"y","num":423,"id":"hymn_423","title":"lGBA aro ati ayo","duration":39.305,"voices":{"male":{"file":"y-423-male.m4a","bytes":278163,"sha256":"f46bba05ec1e0b30ef778f37bd30a6e39e9f9557110fee2081c2123de517758d","duration":39.4},"female":{"file":"y-423-female.m4a","bytes":290630,"sha256":"947f90b4db12cb37a963afd5cd251ad88b95751a7144572bade79edcf6a6364c","duration":39.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.776,"text":"lGBA aro ati ayo","marked":"Ìgbà arò àti ayò"},{"start":2.156,"end":3.284,"text":"Lowo re ni o wa","marked":"Lọ́wọ́ rẹ ni ó wà"},{"start":3.664,"end":5.158,"text":"Itunu mi t'owo re wa","marked":"Ìtùnú mi t'ọwọ́ rẹ wà"},{"start":5.538,"end":6.989,"text":"O si lo l'ase Re.","marked":"Ó sì lọ l'àsè Rẹ̀."}],"end":6.989},{"key":"2","start":7.939,"lines":[{"start":7.939,"end":9.33,"text":"Bi O fe gba won l'owo mi","marked":"Bí O fẹ́ gbà wọ́n l'ọwọ́ mi"},{"start":9.71,"end":10.662,"text":"Emi ki o binu","marked":"Èmi kí ó bínú"},{"start":11.042,"end":12.255,"text":"Ki emi ki o to ni won","marked":"Kí èmi kí ó tó ni wọ́n"},{"start":12.635,"end":13.72,"text":"Tire sa ni nwon nse.","marked":"Tìrẹ sá ní nwọn ńṣe."}],"end":13.72},{"key":"3","start":14.67,"lines":[{"start":14.67,"end":16.047,"text":"Emi ki y'o so buburu","marked":"Èmi kí y'ó sọ búburú"},{"start":16.427,"end":17.678,"text":"B'aiye tile fo lo","marked":"B'aiye tilẹ̀ fò lọ"},{"start":18.058,"end":19.546,"text":"Emi o w'ayo ailopin","marked":"Èmi ò w'ayo àìlópin"},{"start":19.926,"end":21.366,"text":"Ni odo Re nikan.","marked":"Ní ọ̀dọ̀ Rẹ nìkan."}],"end":21.366},{"key":"4","start":22.316,"lines":[{"start":22.316,"end":23.723,"text":"Kil'aiye ati ekun re?","marked":"Kil'aiye àti ẹkún rẹ̀?"},{"start":24.103,"end":25.388,"text":"Adun kikoro ni","marked":"Adùn kíkorò ni"},{"start":25.768,"end":27.267,"text":"'Gbati mo fe ja itanna","marked":"'Gbàtì mo fẹ́ já ìtànná"},{"start":27.647,"end":29.038,"text":"Mo b'egun esusu.","marked":"Mo b'egun esùsú."}],"end":29.038},{"key":"5","start":29.988,"lines":[{"start":29.988,"end":31.589,"text":"Pipe ayo ko si nihin","marked":"Pípẹ́ ayọ̀ kò sì níhìn"},{"start":31.969,"end":33.167,"text":"Oroo da l'oyin","marked":"Ọ̀rọ̀ọ́ da l'oyin"},{"start":33.547,"end":34.936,"text":"Latin gbogbo ayida yi","marked":"Látìn gbogbo àyídà yí"},{"start":35.316,"end":36.809,"text":"'Wo ma se gbogbo mi.","marked":"'Wo ma ṣe gbogbo mi."},{"start":37.189,"end":37.756,"text":"Amin.","marked":"Àmín."}],"end":37.756}]}