{"v":1,"coll":"y","num":383,"id":"hymn_383","title":"EMI Eleda nipa Re","duration":50.394,"voices":{"male":{"file":"y-383-male.m4a","bytes":367699,"sha256":"1414edd38acb49da2422c977a91831a2c71b443231eb2b3c89290c77a6f443a8","duration":50.4},"female":{"file":"y-383-female.m4a","bytes":384491,"sha256":"650d92802a15488feb911e7b1a6693dbfb51b9b21665dc7c209185e511b7c165","duration":50.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.621,"text":"EMI Eleda nipa Re","marked":"Ẹ̀mí Ẹlẹ́dàá nípa Rẹ"},{"start":2.001,"end":3.62,"text":"L'a f'ipile aiye sole","marked":"L'á f'ìpilẹ̀ aiye sọlẹ̀"},{"start":4.0,"end":5.969,"text":"Masai be gbogbo okan wo,","marked":"Masai bẹ gbogbo ọkàn wò"},{"start":6.349,"end":7.927,"text":"Fi ayo re si okan wa","marked":"Fi ayọ̀ rẹ sí ọkàn wa"},{"start":8.307,"end":10.037,"text":"Yo wa nin'ese at'egbe","marked":"Yọ wà nín'ẹsẹ̀ àt'ẹgbẹ́"},{"start":10.417,"end":11.735,"text":"K'o fi wa se ibugbe Re.","marked":"K'ó fi wá ṣe ibùgbé Rẹ̀."}],"end":11.735},{"key":"2","start":12.685,"lines":[{"start":12.685,"end":14.152,"text":"Orisun imole ni O","marked":"Orísun ìmọ́lẹ̀̀ ni O"},{"start":14.532,"end":16.09,"text":"Ti Baba ti se ileri","marked":"Tí Bàbá ti ṣe ìlérí"},{"start":16.47,"end":17.484,"text":"lwo Ina mimo orun","marked":"lwọ́ Iná mímọ́́ ọ̀run"},{"start":17.864,"end":19.41,"text":"Fi 'fe orun kun okan wa","marked":"Fi 'fẹ́ ọrùn kún ọkàn wa"},{"start":19.79,"end":21.073,"text":"Jo tu ororo mimo Re","marked":"Jọ tu òróró mímọ́́ Rẹ"},{"start":21.453,"end":23.166,"text":"Sori wa bi a ti nkorin.","marked":"Ṣọ́rí wa bí a ti ńkọrin."}],"end":23.166},{"key":"3","start":24.116,"lines":[{"start":24.116,"end":25.333,"text":"Da opo ore-ofe Re","marked":"Dá ọ̀pọ̀ ọ̀rẹ́-ọ̀fẹ́ Rẹ"},{"start":25.713,"end":27.273,"text":"Lat'orun sori gbogbo wa","marked":"Lát'ọrun sorí gbogbo wa"},{"start":27.653,"end":29.285,"text":"Je k'a gba otito Re gbo","marked":"Jẹ́ k'á gba òtítọ́́ Rẹ gbọ́"},{"start":29.665,"end":31.574,"text":"K'a si ma sa ro l'okan wa","marked":"K'á sì má sá rò l'ọkàn wa"},{"start":31.954,"end":33.526,"text":"F'ara Re han wa k'a le ri","marked":"F'ara Rẹ hàn wá k'á lè rí"},{"start":33.906,"end":35.269,"text":"Baba at'Omo ninu Re.","marked":"Bàbá àt'Ọmọ nínú Rẹ̀."}],"end":35.269},{"key":"4","start":36.219,"lines":[{"start":36.219,"end":38.094,"text":"K'a fi ola ati iyin","marked":"K'á fi ọlá àti ìyìn"},{"start":38.474,"end":39.66,"text":"Fun baba Olodumare","marked":"Fún bàbá Olódùmarè"},{"start":40.04,"end":41.886,"text":"K'a yin oko Jesu logo","marked":"K'á yin ọkọ Jésù lógo"},{"start":42.266,"end":43.94,"text":"Enit'o ku lati gba wa","marked":"Ẹnit'ó kù láti gbà wá"},{"start":44.32,"end":45.636,"text":"Iyin bakanna ni fun O","marked":"Ìyìn bákanná ni fún Ọ"},{"start":46.016,"end":47.821,"text":"Parakliti Aiyeraiye.","marked":"Parakliti Aiyérayé."},{"start":48.201,"end":48.844,"text":"Amin.","marked":"Àmín."}],"end":48.844}]}