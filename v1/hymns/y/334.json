{"v":1,"coll":"y","num":334,"id":"hymn_334","title":"ALLELUYAH! O ti jinde","duration":47.238,"voices":{"male":{"file":"y-334-male.m4a","bytes":346882,"sha256":"591f346ac65568a7a678b10b82dab5ce89734b21bd31aa9746b31ffecd273447","duration":47.3},"female":{"file":"y-334-female.m4a","bytes":359931,"sha256":"a3de12a14bdfe7a8573f382ff9de68ea204eb2ed7a5f7c18ec9623de06a47f5a","duration":47.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.364,"text":"ALLELUYAH! O ti jinde","marked":"Allelúyàh! Ó ti jíǹde"},{"start":2.744,"end":4.225,"text":"Jesu goke lo s'orun","marked":"Jésù gòkè lọ s'ọrun"},{"start":4.605,"end":6.077,"text":"O si fo itegun esu","marked":"Ó sì fọ́ ìtẹ́gun èṣù"},{"start":6.457,"end":8.365,"text":"Angeli ho, enia dahun.","marked":"Áńgẹ́lì hó, enia dáhùn."},{"start":8.745,"end":11.049,"text":"Egbe:  O ti jinde, O ti jinde","marked":"Ó ti jíǹde, Ó ti jíǹde"},{"start":11.429,"end":13.12,"text":"O Wa laye, ko ku mo.","marked":"Ó Wà láyé, kò kú mọ́."}],"end":13.12},{"key":"CHORUS","start":14.07,"lines":[{"start":14.07,"end":16.004,"text":"O ti jinde, O ti jinde","marked":"Ó ti jíǹde, Ó ti jíǹde"},{"start":16.384,"end":18.255,"text":"O Wa laye, ko ku mo.","marked":"Ó Wà láyé, kò kú mọ́."}],"end":18.255},{"key":"2","start":19.205,"lines":[{"start":19.205,"end":21.2,"text":"Alleluyah! O ti jinde","marked":"Allelúyàh! Ó ti jíǹde"},{"start":21.58,"end":22.984,"text":"Eniti o ga julo","marked":"Ẹniti ò ga jùlọ"},{"start":23.364,"end":24.932,"text":"Jeri si Emi na wipe","marked":"Jerí sí Èmi ná wípé"},{"start":25.312,"end":26.712,"text":"On ni alagbawi wa,","marked":"Ón ni alágbàwí wa"},{"start":27.092,"end":29.577,"text":"Egbe:  O ti jinde, O ti jinde fun","marked":"Ó ti jíǹde, Ó ti jíǹde fún"},{"start":29.957,"end":31.146,"text":"Awa t'a da lare.","marked":"Àwa t'á dá láre."}],"end":31.146},{"key":"3","start":32.096,"lines":[{"start":32.096,"end":34.412,"text":"Alleluyah! O ti jinde","marked":"Allelúyàh! Ó ti jíǹde"},{"start":34.792,"end":36.391,"text":"lku ko tun n'ipa mo","marked":"lkú kò tún ń'ípa mọ́"},{"start":36.771,"end":38.52,"text":"Kristi papa ni Ajinde","marked":"Kristi pàpà ní Àjíǹde"},{"start":38.9,"end":40.398,"text":"Yio si m'awon Tire wa.","marked":"Yío sì m'àwọn Tírè wà."},{"start":40.778,"end":43.199,"text":"Egbe:  O ti jinde, O ti jinde fun","marked":"Ó ti jíǹde, Ó ti jíǹde fún"},{"start":43.579,"end":44.688,"text":"Oluwa Oba Iye.","marked":"Olúwa Ọba Ìyè."},{"start":45.068,"end":45.688,"text":"Amin.","marked":"Àmín."}],"end":45.688}]}