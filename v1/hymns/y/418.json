{"v":1,"coll":"y","num":418,"id":"hymn_418","title":"MURA ebe okan mi","duration":45.861,"voices":{"male":{"file":"y-418-male.m4a","bytes":320730,"sha256":"63c2e6cd7901c14c971378de6b554be139515edcda0ad68a2bc3e8e6deee8b35","duration":45.9},"female":{"file":"y-418-female.m4a","bytes":338657,"sha256":"da2cc20ef199863afd5e5a1ed2d7b8b7e57698e6a89f9950e31eab4d788584bd","duration":45.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.352,"text":"MURA ebe okan mi","marked":"Múra ẹ̀bẹ̀ ọkàn mi"},{"start":1.732,"end":2.987,"text":"Jesu nfe gb'adura re","marked":"Jésù ńfẹ́ gb'àdúrà rẹ̀"},{"start":3.367,"end":4.746,"text":"O tipe k'o gbadura","marked":"Ó tipẹ́ k'ó gbàdúrà"},{"start":5.126,"end":6.423,"text":"Nitorina yio gbo.","marked":"Nítorina yìo gbọ́."}],"end":6.423},{"key":"2","start":7.373,"lines":[{"start":7.373,"end":8.84,"text":"Lodo Oba n'iwo mbo","marked":"Lọ́dọ̀ Ọba n'íwò ḿbọ̀"},{"start":9.22,"end":10.551,"text":"Wa lopolopo ebe","marked":"Wà lọ́pọ̀lọpọ̀ ẹ̀bẹ̀"},{"start":10.931,"end":12.051,"text":"Be l'ore-ofe Re po","marked":"Bẹ l'ọ̀rẹ́-ọ̀fẹ́ Rẹ pọ̀"},{"start":12.431,"end":13.801,"text":"Ko s' eni ti bere ju.","marked":"Kò s' ẹni ti bẹ̀rẹ̀ jù."}],"end":13.801},{"key":"3","start":14.751,"lines":[{"start":14.751,"end":16.059,"text":"Mo t'ibi eru bere","marked":"Mo t'ibi èrú bẹ̀rẹ̀"},{"start":16.439,"end":18.057,"text":"Gba mi ni eru ese","marked":"Gbà mí ní ẹ̀rù ẹ̀ṣẹ̀"},{"start":18.437,"end":19.641,"text":"Ki eje t'o ta sile","marked":"Kí ẹ̀jẹ̀ t'ó ta sílẹ̀"},{"start":20.021,"end":21.376,"text":"We ebi okan miu nu.","marked":"Wé ẹ̀bi ọkàn míú nù."}],"end":21.376},{"key":"4","start":22.326,"lines":[{"start":22.326,"end":23.822,"text":"Sodo re mo wa simi","marked":"Sọ́dọ̀ rẹ̀ mo wá sìmí"},{"start":24.202,"end":25.544,"text":"Oluwa gba aiya mi","marked":"Olúwa gba àìyá mi"},{"start":25.924,"end":27.139,"text":"Nibe ni ki O joko","marked":"Níbẹ̀ ni kí Ó jókò"},{"start":27.519,"end":28.946,"text":"Ma je Oba okan mi.","marked":"Má jẹ́ Ọba ọkàn mi."}],"end":28.946},{"key":"5","start":29.896,"lines":[{"start":29.896,"end":31.502,"text":"N'irin ajo mi l'aiye","marked":"N'ìrìn àjò mi l'aiye"},{"start":31.882,"end":33.173,"text":"K'ife Re ma tu mi n'nu","marked":"K'ífẹ́ Rẹ má tù mí ń'nú"},{"start":33.553,"end":35.007,"text":"Bi ore at'oluso","marked":"Bí ọ̀rẹ́ at'olùṣọ́"},{"start":35.387,"end":36.782,"text":"Mu mi dopin irin mi.","marked":"Mú mi dópin ìrìn mi."}],"end":36.782},{"key":"6","start":37.732,"lines":[{"start":37.732,"end":39.089,"text":"F'ohun mo ni se han mi","marked":"F'ohun mo ní ṣe hàn mí"},{"start":39.469,"end":40.589,"text":"Funmi l'otun ilera","marked":"Fúnmi l'ótun ìlera"},{"start":40.969,"end":42.643,"text":"Mu mi wa ninu 'gbagbo","marked":"Mú mi wà nínú 'gbàgbọ́"},{"start":43.023,"end":44.312,"text":"Mu mi ku b'enia Re.","marked":"Mú mi kù b'enia Rẹ."}],"end":44.312}]}