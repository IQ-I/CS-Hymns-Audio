{"v":1,"coll":"y","num":452,"id":"hymn_452","title":"Jesu l'Olusagutan mi","duration":49.361,"voices":{"male":{"file":"y-452-male.m4a","bytes":355247,"sha256":"87b67aaa9ff83db18f7390c8bb877c1a9872b7747aec879803a34336be2ec516","duration":49.4},"female":{"file":"y-452-female.m4a","bytes":367529,"sha256":"e3bd29d7e716451206d49ea52239c001d20bf8637eb95bb46d11d562c9ee2aed","duration":49.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.73,"text":"Jesu l'Olusagutan mi,","marked":"Jésù l'Olùṣàgùtàn mi"},{"start":2.11,"end":3.26,"text":"Ore eniti ki ye","marked":"Ọ̀rẹ́ ẹniti kí yé"},{"start":3.64,"end":6.001,"text":"Ko s'ewu bi mo je Tire","marked":"Kò s'ewu bí mo jẹ́ Tírè"},{"start":6.381,"end":7.871,"text":"T'O si je temi titi.","marked":"T'ó sì jẹ́ tèmi títí."}],"end":7.871},{"key":"2","start":8.821,"lines":[{"start":8.821,"end":10.272,"text":"Nib'odo omi iye nsan","marked":"Níb'odò omi ìyẹ́ ńsán"},{"start":10.652,"end":12.065,"text":"Nibe I'onm'okan mi lo","marked":"Níbẹ̀ l'óńm'ọkàn mi lọ"},{"start":12.445,"end":14.209,"text":"Nibiti oko tutu nhu","marked":"Níbitì ọkọ̀ tutù nhu"},{"start":14.589,"end":16.076,"text":"L'o nf'onje orun bo mi.","marked":"L'ó ńf'ọ́ńjẹ ọrùn bò mí."}],"end":16.076},{"key":"3","start":17.026,"lines":[{"start":17.026,"end":18.662,"text":"Mo ti fi were sako lo","marked":"Mo ti fi wẹ́rẹ́ ṣáko lọ"},{"start":19.042,"end":20.844,"text":"N'ife O si wa mi ri","marked":"N'ìfẹ́ Ó sì wá mi rí"},{"start":21.224,"end":22.668,"text":"L'ejika Re l'o gbe mi si","marked":"L'èjìká Rẹ l'ó gbé mi sí"},{"start":23.048,"end":24.513,"text":"O f'ayo mu mu wa le.","marked":"Ó f'áyò mú mú wa le."}],"end":24.513},{"key":"4","start":25.463,"lines":[{"start":25.463,"end":26.87,"text":"Nko beru ojiji iku","marked":"Nkò bẹ̀rù òjijì ikú"},{"start":27.25,"end":28.686,"text":"B'Iwo ba wa lodo mi","marked":"B'Ìwọ bá wà lọ́dọ̀ mi"},{"start":29.066,"end":30.702,"text":"Ogo Re ati Opa Re","marked":"Ògo Rẹ àti Ọ̀pá Rẹ"},{"start":31.082,"end":32.622,"text":"Awon l'o ntu mi ninu.","marked":"Àwọn l'ó ńtù mí nínú."}],"end":32.622},{"key":"5","start":33.572,"lines":[{"start":33.572,"end":35.013,"text":"Iwo te tabili fun mi","marked":"Ìwọ tẹ́ tábìlì fún mi"},{"start":35.393,"end":36.693,"text":"Wo d'ororo sori mi","marked":"Wo d'òròrò sórí mi"},{"start":37.073,"end":38.894,"text":"A! ayo na ha ti po to!","marked":"A! ayọ̀ ná ha ti pọ̀ tó!"},{"start":39.274,"end":40.668,"text":"Ti nt'odo Re wa ba mi.","marked":"Tí nt'odo Rẹ wá bá mi."}],"end":40.668},{"key":"6","start":41.618,"lines":[{"start":41.618,"end":42.984,"text":"Be lojo aiye mi gbogbo","marked":"Bẹ lọ́jọ́ àìyé mi gbogbo"},{"start":43.364,"end":44.61,"text":"Ore Re ki o ye lai","marked":"Ọ̀rẹ́ Rẹ kí ó yẹ láì"},{"start":44.99,"end":46.426,"text":"Olusagutan, ngo yin O","marked":"Olusagutan, ngo yín O"},{"start":46.806,"end":47.811,"text":"Ninu ile Re titi.","marked":"Nínú ilé Rẹ títí."}],"end":47.811}]}