{"v":1,"coll":"y","num":776,"id":"hymn_776","title":"E TUN won ko fun mi ki ngbo","duration":47.167,"voices":{"male":{"file":"y-776-male.m4a","bytes":345587,"sha256":"4e4b97a86cf51dae94dcfe2df646dde58ac765f29273cf8ed850f4b7e9c8039d","duration":47.2},"female":{"file":"y-776-female.m4a","bytes":355003,"sha256":"8e443033ded4888a920d9eaaea373c2f9756b50e0dfb4228e0d09d03371fd189","duration":47.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.92,"text":"E TUN won ko fun mi ki ngbo,","marked":"Ẹ Tún wọn kò fún mi kí ńgbọ́"},{"start":2.3,"end":3.507,"text":"Oro 'yanu t'Iye","marked":"Ọ̀rọ̀ 'yanu t'Iye"},{"start":3.887,"end":5.245,"text":"Je ki nsi tun ewa won ri","marked":"Jẹ́ kí nsì tún ẹwà wọn rí"},{"start":5.625,"end":6.863,"text":"Oro 'yanu t'lye","marked":"Ọ̀rọ̀ 'yanu t'lye"},{"start":7.243,"end":9.67,"text":"Oro lye at'ewa ti nko mi n'igbagbo","marked":"Ọ̀rọ̀ lyé àt'ẹwà tí ńkọ́ mi ń'ìgbàgbọ́́"},{"start":10.05,"end":11.602,"text":"Oro didun! Oro 'yanu","marked":"Ọ̀rọ̀ dídùn! Ọ̀rọ̀ 'yanu"},{"start":11.982,"end":13.298,"text":"Oro 'yanu t'lye.","marked":"Ọ̀rọ̀ 'yanu t'lye."}],"end":13.298},{"key":"2","start":14.248,"lines":[{"start":14.248,"end":15.968,"text":"Kristi nikan l'o nfi funni","marked":"Kristi nìkan l'ó ńfi fúnni"},{"start":16.348,"end":17.823,"text":"Oro 'yanu at'lye","marked":"Ọ̀rọ̀ 'yanu at'lye"},{"start":18.203,"end":19.807,"text":"Elese gbo 'pe ife na","marked":"Ẹlẹ́sẹ̀ gbọ́ 'pe ife ná"},{"start":20.187,"end":21.932,"text":"Oro 'yanu at'Iye","marked":"Ọ̀rọ̀ 'yanu àt'Iye"},{"start":22.312,"end":25.56,"text":"L'ofe l'a fifun wa, ko le to wa sorun!","marked":"L'ọ̀fẹ́ l'á fífún wa, kó lè tọ́ wa sọ́rùn!"},{"start":25.94,"end":27.712,"text":"Oro didun! Oro 'yanu","marked":"Ọ̀rọ̀ dídùn! Ọ̀rọ̀ 'yanu"},{"start":28.092,"end":29.295,"text":"Oro 'yanu t'lye.","marked":"Ọ̀rọ̀ 'yanu t'lye."}],"end":29.295},{"key":"3","start":30.245,"lines":[{"start":30.245,"end":31.381,"text":"Gbe ohun ihinrere na","marked":"Gbé ohun ìhìnrere ná"},{"start":31.761,"end":33.487,"text":"Oro 'yanu at'lye","marked":"Ọ̀rọ̀ 'yanu at'lye"},{"start":33.867,"end":35.696,"text":"F'lgbala lo gbogbo enia","marked":"F'lgbala lo gbogbo enia"},{"start":36.076,"end":37.544,"text":"Oro 'yanu at'lye","marked":"Ọ̀rọ̀ 'yanu at'lye"},{"start":37.924,"end":40.814,"text":"Jesu Olugbala, we wa mo titi lai!","marked":"Jésù Olùgbàlà, wẹ̀ wá mọ́ títí láì!"},{"start":41.194,"end":43.027,"text":"Oro didun! Oro 'yanu!","marked":"Ọ̀rọ̀ dídùn! Ọ̀rọ̀ 'yanu!"},{"start":43.407,"end":44.675,"text":"Oro 'yanu at'lye.","marked":"Ọ̀rọ̀ 'yanu àt'lye."},{"start":45.055,"end":45.618,"text":"Amin.","marked":"Àmín."}],"end":45.618}]}