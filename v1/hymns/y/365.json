{"v":1,"coll":"y","num":365,"id":"hymn_365","title":"ILE ayo kan wa l'oke","duration":98.295,"voices":{"male":{"file":"y-365-male.m4a","bytes":728234,"sha256":"51ebb1a9b0b822dd1bed3004f04c99d095da49d8a1c916f97ef61f058b09d68b","duration":98.3},"female":{"file":"y-365-female.m4a","bytes":749489,"sha256":"0f9e85df2da44bff07caa7c8c9b8c37149c8774e9681fe1657a903eea7b431ee","duration":98.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.015,"text":"ILE ayo kan wa l'oke","marked":"Ilé ayò kan wà l'òkè"},{"start":2.395,"end":4.283,"text":"Ti o ndan ti o si l'ewa","marked":"Tí ó ńdán tí ó sì l'ẹwà"},{"start":4.663,"end":6.084,"text":"Ayo ibe ki si d'opin","marked":"Ayọ̀ ibẹ̀ kí sì d'òpin"},{"start":6.464,"end":7.964,"text":"L'osan tabi l'oru","marked":"L'ọ́sàn tàbí l'oru"},{"start":8.344,"end":9.811,"text":"Awon Angeli nkorin","marked":"Àwọn Áńgẹ́lì nkorin"},{"start":10.191,"end":11.529,"text":"Y'ite Mimo na ka","marked":"Y'ite Mímọ́́ ná ká"},{"start":11.909,"end":13.361,"text":"Nigbawo lao ri O","marked":"Nígbàwọ́ laó rí O"},{"start":13.741,"end":14.97,"text":"lle to dara julo.","marked":"llé tó dára jùlọ."}],"end":14.97},{"key":"CHORUS","start":15.92,"lines":[{"start":15.92,"end":16.922,"text":"A! ile didan,","marked":"A! ilé dídán"},{"start":17.302,"end":18.387,"text":"A! ile didan","marked":"A! ilé dídán"},{"start":18.767,"end":19.579,"text":"Ile Olugbala,","marked":"Ilé Olùgbàlà"},{"start":19.959,"end":21.641,"text":"ile to l'ogo julo.","marked":"ilé tó l'ògo jùlọ."}],"end":21.641},{"key":"2","start":22.591,"lines":[{"start":22.591,"end":24.232,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":24.612,"end":25.755,"text":"E je k'a yin Oluwa","marked":"Ẹ jẹ k'á yin Olúwa"},{"start":26.135,"end":27.687,"text":"Fun idasi wa lojo oni","marked":"Fún ìdásí wa lọ́jọ́ òní"},{"start":28.067,"end":29.255,"text":"Iyin fun Metalokan","marked":"Ìyìn fún Mẹ́talọ́kan"},{"start":29.635,"end":30.923,"text":"Se ranti p'Oluwa mbo","marked":"Ṣe rántí p'Olúwa ḿbọ́"},{"start":31.303,"end":32.738,"text":"Lati ko wa lo sile","marked":"Láti kó wa lọ sílé"},{"start":33.118,"end":34.529,"text":"Nigbawo lao ri O","marked":"Nígbàwọ́ laó rí O"},{"start":34.909,"end":36.32,"text":"Ile t'o dara julo.","marked":"Ilé t'ó dára jùlọ."}],"end":36.32},{"key":"3","start":37.27,"lines":[{"start":37.27,"end":38.617,"text":"Kikankikan l'Oluwa npe","marked":"Kíkànkíkan l'Olúwa ńpẹ́"},{"start":38.997,"end":40.481,"text":"Eda ko si mira","marked":"Ẹ̀dá kò sì mira"},{"start":40.861,"end":42.129,"text":"Ikore si nfe ka","marked":"Ìkórè sì ńfẹ́ ká"},{"start":42.509,"end":43.853,"text":"E je k'a sa fun ese","marked":"Ẹ jẹ́ k'á sá fún ẹsẹ̀"},{"start":44.233,"end":45.73,"text":"Ki Jesu le we wa mo","marked":"Kí Jésù lè wẹ̀ wá mọ́"},{"start":46.11,"end":47.765,"text":"Ye fun 'le nla l'oke","marked":"Yẹ fún 'lé ńlá l'òkè"},{"start":48.145,"end":49.441,"text":"Nigbawo lao ri O","marked":"Nígbàwọ́ laó rí O"},{"start":49.821,"end":51.215,"text":"Ile t'o dara julo.","marked":"Ilé t'ó dára jùlọ."}],"end":51.215},{"key":"4","start":52.165,"lines":[{"start":52.165,"end":53.585,"text":"Awon to ti jagun koja","marked":"Àwọn tó ti jagun kọjá"},{"start":53.965,"end":55.461,"text":"Nwon nwo wa bi a ti nja","marked":"Nwọ̀n nwọ́ wa bí a ti ńjà"},{"start":55.841,"end":57.548,"text":"Nwon mha O agutan k'egbe","marked":"Nwọn mha O àgùtàn k'ẹ́gbẹ́"},{"start":57.928,"end":59.224,"text":"Oba lo si je fun won","marked":"Ọba ló sì jẹ́ fún wọn"},{"start":59.604,"end":61.085,"text":"lbanuje ko si n'ibe","marked":"lbanújẹ́ kò sì ń'ibẹ̀"},{"start":61.465,"end":62.555,"text":"Ninu ile didan na","marked":"Nínú ilé dídán ná"},{"start":62.935,"end":64.197,"text":"Nigbawo lao ri O","marked":"Nígbàwọ́ laó rí O"},{"start":64.577,"end":66.038,"text":"Ile to dara julo.","marked":"Ilé tó dára jùlọ."}],"end":66.038},{"key":"5","start":66.988,"lines":[{"start":66.988,"end":68.625,"text":"lwo ki yio jijakudi","marked":"lwo kí yíó jijakudi"},{"start":69.005,"end":70.47,"text":"K'o ba Olugbala joba","marked":"K'ó bá Olùgbàlà jọba"},{"start":70.85,"end":72.379,"text":"Nibi Kerubu Serafu","marked":"Níbi Kérúbù Séráfù"},{"start":72.759,"end":74.032,"text":"Yi ite Olugbala ka","marked":"Yí ìtẹ́ Olùgbàlà ká"},{"start":74.412,"end":75.406,"text":"lbugbe Olugbala","marked":"lbugbe Olùgbàlà"},{"start":75.786,"end":77.04,"text":"T'ao ma sin titi","marked":"T'áò má sìn títí"},{"start":77.42,"end":78.612,"text":"Nigbawo lao ri O","marked":"Nígbàwọ́ laó rí O"},{"start":78.992,"end":80.269,"text":"Ile to dara julo.","marked":"Ilé tó dára jùlọ."}],"end":80.269},{"key":"6","start":81.219,"lines":[{"start":81.219,"end":82.823,"text":"Nigbat'o ba d'ojo kehin","marked":"Nígbàt'ó bá d'ọjọ́ kẹ́hìn"},{"start":83.203,"end":84.625,"text":"Ti a o si de 'joba Re","marked":"Tí a ò sì dé 'jọba Rẹ"},{"start":85.005,"end":86.818,"text":"K'a gbo ohun ayo yi pe","marked":"K'á gbọ́ ohùn ayọ̀ yí pé"},{"start":87.198,"end":88.342,"text":"Bo s'ayo Oluwa re","marked":"Bó s'àyò Olúwa rẹ"},{"start":88.722,"end":91.368,"text":"Kerubu, Serafu, yo","marked":"Kérúbù, Séráfù, yó"},{"start":91.748,"end":92.928,"text":"E gb'ade iye nyin","marked":"Ẹ gb'adé ìyé nyin"},{"start":93.308,"end":94.73,"text":"Nigbana lao ri O","marked":"Nígbàná laó rí O"},{"start":95.11,"end":96.745,"text":"Ile to dara julo.","marked":"Ilé tó dára jùlọ."}],"end":96.745}]}