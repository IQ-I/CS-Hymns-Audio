{"v":1,"coll":"y","num":731,"id":"hymn_731","title":"BABA orun, 'wo lo mu wa","duration":65.71,"voices":{"male":{"file":"y-731-male.m4a","bytes":491551,"sha256":"8a9a2b0026b7e032153d5a332781c7f05c651ab30cbdfad2dffefbbf56136b56","duration":65.8},"female":{"file":"y-731-female.m4a","bytes":504937,"sha256":"1fed8fb5078395fc2495a2ab1e46e6c06cddb34b2332a3313954932b8f5d97a2","duration":65.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.018,"text":"BABA orun, 'wo lo mu wa","marked":"Bàbá ọ̀run, 'wo ló mú wá"},{"start":2.398,"end":3.796,"text":"D'ojo oni l'alafia","marked":"D'ọjọ́ òní l'àlàáfíà"},{"start":4.176,"end":5.838,"text":"Pele I'O nto isise wa","marked":"Pẹ̀lẹ́ l'Ó ńtọ́ ìṣiṣẹ́ wa"},{"start":6.218,"end":7.714,"text":"T'O si nf'iso Re so wa","marked":"T'ó sì ńf'isọ Rẹ̀ ṣọ́ wa"},{"start":8.094,"end":9.809,"text":"'Wo Ore at'Amona wa","marked":"'Wo Ọ̀rẹ́ at'Amọ̀nà wa"},{"start":10.189,"end":11.404,"text":"A fe fi ope fun O","marked":"A fẹ́ fi ọpẹ́ fún Ọ"},{"start":11.784,"end":13.555,"text":"Ao se le yin O b'o ti ye","marked":"Àó ṣe lè yìn Ọ́ b'ó ti yẹ"},{"start":13.935,"end":15.251,"text":"Fun 'fe Re ti ki pada?","marked":"Fún 'fẹ́ Rẹ ti ki padà?"}],"end":15.251},{"key":"2","start":16.201,"lines":[{"start":16.201,"end":17.606,"text":"Ni gbogbo igba t'o koja","marked":"Ní gbogbo ìgbà t'ó kọjá"},{"start":17.986,"end":19.501,"text":"L'a nri anu gba lotun","marked":"L'á ńrí ànú gbà lọ́tun"},{"start":19.881,"end":21.26,"text":"Itoju on iseun-ife","marked":"Ìtọ́jú ọ́n ìṣeun-ìfẹ́"},{"start":21.64,"end":23.15,"text":"Ko fi igba kan jin na","marked":"Kò fi ìgbà kan jìn ná"},{"start":23.53,"end":24.955,"text":"Ife ati aba orun","marked":"Ìfẹ́ àti àbá ọ̀run"},{"start":25.335,"end":26.821,"text":"Mba wa gbe tosan-toru","marked":"Mba wá gbé tọ̀sán-tòru"},{"start":27.201,"end":29.037,"text":"Ibukun t'a ko le siro","marked":"Ìbùkún t'á kò lè ṣírò"},{"start":29.417,"end":31.09,"text":"Ntan imole s'ona wa.","marked":"Ntan ìmọ́lẹ̀̀ s'ọ́nà wa."}],"end":31.09},{"key":"3","start":32.04,"lines":[{"start":32.04,"end":34.238,"text":"N'nu 'danwo nla l'a ti koja","marked":"N'nú 'dánwò ńlá l'á ti kọjá"},{"start":34.618,"end":35.825,"text":"Iji 'ponju ti lu wa","marked":"Ìjì 'pọ́njú ti lù wá"},{"start":36.205,"end":37.65,"text":"Idamu ti sokun bo wa","marked":"Ìdàmú ti ṣókùn bò wá"},{"start":38.03,"end":39.721,"text":"Tobe t'a ko fi ri O","marked":"Tobẹ t'á kò fi rí O"},{"start":40.101,"end":41.615,"text":"Sibe ife Re ko ko wa","marked":"Síbẹ̀ ìfẹ́ Rẹ̀ kò kọ́ wa"},{"start":41.995,"end":43.249,"text":"Sibe n'nu banuje wa","marked":"Síbẹ̀ ń'nú bànújẹ́ wa"},{"start":43.629,"end":45.12,"text":"Iranwo t'a nse f'ara wa","marked":"Ìrànwọ́ t'á ńṣe f'ara wa"},{"start":45.5,"end":46.865,"text":"Nipa agbara Re ni.","marked":"Nípa agbára Rẹ̀ ni."}],"end":46.865},{"key":"4","start":47.815,"lines":[{"start":47.815,"end":48.913,"text":"Opo awon olufe wa","marked":"Ọ̀pọ̀ àwọn olùfẹ́ wa"},{"start":49.293,"end":50.783,"text":"Ti de opin ajo won","marked":"Ti dé òpin àjọ wọn"},{"start":51.163,"end":52.846,"text":"Ara, omo ati ore","marked":"Ara, ọmọ àti ọ̀rẹ́"},{"start":53.226,"end":54.806,"text":"Nwona lati pade wa","marked":"Nwọ̀nà láti pàdé wa"},{"start":55.186,"end":56.722,"text":"Nigbat' ajo wa ba pari","marked":"Nígbàt' àjọ wa bá parí"},{"start":57.102,"end":58.507,"text":"Ti a si se alaisi","marked":"Tí a sì ṣe aláìsí"},{"start":58.887,"end":61.313,"text":"Baba, mu wa la okun ja","marked":"Bàbá, mú wa la okun já"},{"start":61.693,"end":63.213,"text":"Sinu mole ailopin.","marked":"Sínú mọ́lẹ̀ àìlópin."},{"start":63.593,"end":64.16,"text":"Amin.","marked":"Àmín."}],"end":64.16}]}