{"v":1,"coll":"y","num":6,"id":"hymn_6","title":"OLUWA mi, mo njade lo","duration":51.314,"voices":{"male":{"file":"y-6-male.m4a","bytes":363320,"sha256":"69f7261f6503e85f85878a868083c81fe15de066a43fa7c6087644fec3e92f7e","duration":51.4},"female":{"file":"y-6-female.m4a","bytes":376853,"sha256":"a188d4e06096416c0c1f9d1dbd66c134b294518560f09ab46cf9bdb49cc6cba6","duration":51.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.004,"text":"OLUWA mi, mo njade lo,","marked":"Olúwa mi, mo ńjáde lọ"},{"start":2.384,"end":3.67,"text":"Lati seise ojo mi,","marked":"Láti ṣèiṣẹ́ ọjọ́ mi"},{"start":4.05,"end":5.46,"text":"lwo nikan l'emi o mo,","marked":"lwo nìkan l'èmi ò mọ̀"},{"start":5.84,"end":7.969,"text":"L'oro l'ero, ati n'ise.","marked":"L'ọrọ̀ l'èrò, àti n'iṣẹ́."}],"end":7.969},{"key":"2","start":8.919,"lines":[{"start":8.919,"end":10.341,"text":"Ise t'o yan mi l'anu Re","marked":"Iṣẹ́ t'ó yàn mí l'ánú Rẹ̀"},{"start":10.721,"end":12.346,"text":"Jeki nle se tayo tayo","marked":"Jèkì ńlẹ̀ ṣe tayọ tayọ"},{"start":12.726,"end":14.151,"text":"Ki nroju Re ni ise mi","marked":"Kí ńrọ́jú Rẹ ní iṣẹ́ mi"},{"start":14.531,"end":15.979,"text":"K'emi si le f'ife Re han.","marked":"K'èmi sì lè f'ìfẹ́ Rẹ hàn."}],"end":15.979},{"key":"3","start":16.929,"lines":[{"start":16.929,"end":18.479,"text":"Dabobo mi mi lowo 'danwo","marked":"Dábòbò mi mí lọ́wọ́ 'dánwò"},{"start":18.859,"end":20.254,"text":"K ' o pa okan mi mo kuro,","marked":"K '' ó pa ọkàn mi mọ́ kúrò"},{"start":20.634,"end":22.31,"text":"L'owo aniyan aiye yi,","marked":"L'ọwọ́ àníyàn aiye yi"},{"start":22.69,"end":24.115,"text":"Ati gbogbo ifekufe.","marked":"Àti gbogbo ìfẹ́kúfẹ́."}],"end":24.115},{"key":"4","start":25.065,"lines":[{"start":25.065,"end":26.318,"text":"lwo t'oju Re r'okan mi,","marked":"lwo t'ojú Rẹ r'ọkàn mi"},{"start":26.698,"end":28.179,"text":"Ma wa low'otun mi titi","marked":"Má wà lọ́wọ̀tún mi títí"},{"start":28.559,"end":30.13,"text":"Ki mma sise lo lase Re,","marked":"Kí mma ṣiṣẹ́ lọ láṣẹ Rẹ"},{"start":30.51,"end":32.011,"text":"Ki nf'ise mi gbogbo fun O.","marked":"Kí nf'iṣẹ́ mi gbogbo fún O."}],"end":32.011},{"key":"5","start":32.961,"lines":[{"start":32.961,"end":34.669,"text":"Je ki nr'eru Re t'o fuye","marked":"Jẹ́ kí nr'ẹrù Rẹ t'ó fúyẹ́"},{"start":35.049,"end":36.563,"text":"Ki mma sora nigbagbogbo;","marked":"Kí mma ṣọ́ra nígbàgbọ́gbò"},{"start":36.943,"end":38.708,"text":"Ki mma f'oju si nkan t'orun","marked":"Kí mma f'ojú sí nkan t'ọrun"},{"start":39.088,"end":40.902,"text":"Ki nsi mura d'ojo ogo.","marked":"Kí nsì múra d'ọjọ́ ògo."}],"end":40.902},{"key":"6","start":41.852,"lines":[{"start":41.852,"end":43.101,"text":"Ohunkohun t'o fi fun mi,","marked":"Ohunkóhun t'ó fi fún mi"},{"start":43.481,"end":44.963,"text":"Jeki nle lo fun ago Re,","marked":"Jẹki ńlẹ̀ lọ fún àgọ́ Rẹ"},{"start":45.343,"end":46.887,"text":"Ki nf'ayo sure ije mi,","marked":"Kí nf'àyò súre ìjẹ mi"},{"start":47.267,"end":48.839,"text":"Ki mba O rin titi d'orun.","marked":"Kí ḿbá O rìn títí d'ọrùn."},{"start":49.219,"end":49.764,"text":"Amin.","marked":"Àmín."}],"end":49.764}]}