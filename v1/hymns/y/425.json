{"v":1,"coll":"y","num":425,"id":"hymn_425","title":"JESU, nib'eni Re pade","duration":45.002,"voices":{"male":{"file":"y-425-male.m4a","bytes":325858,"sha256":"c179d55879c69ef783ef581a11478d90b39cf7ec7a2764108fe64c6646c6d929","duration":45.1},"female":{"file":"y-425-female.m4a","bytes":336769,"sha256":"71b78bca8bf5db9c31b2fdc88bdd4e4b4d48fdcc3c5b86552066484de10a8456","duration":45.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.041,"text":"JESU, nib'eni Re pade","marked":"Jésù, níb'ẹni Rẹ̀ pàdé"},{"start":2.421,"end":3.917,"text":"Nibe, nwon r'ite anu Re","marked":"Níbẹ̀, nwọn r'ìtẹ ãnú Rẹ̀"},{"start":4.297,"end":6.288,"text":"Nibe, nwon wa O, nwon ri O","marked":"Níbẹ̀, nwọn wa O, nwọn rí O"},{"start":6.668,"end":8.009,"text":"lbikibi n'ile owo.","marked":"lbikíbi ń'ílé owó."}],"end":8.009},{"key":"2","start":8.959,"lines":[{"start":8.959,"end":10.802,"text":"Ko s'ogiri t'o se O mo","marked":"Kò s'ògiri t'ó ṣe Ó mọ́"},{"start":11.182,"end":12.335,"text":"O gbe inu onirele","marked":"Ó gbé inú onírẹ̀lẹ̀"},{"start":12.715,"end":14.459,"text":"Nwon mu O wa 'bi nwon ba wa","marked":"Nwọ̀n mú O wá 'bí nwọ̀n bá wà"},{"start":14.839,"end":16.226,"text":"Gba nwon nlo le won mu O lo.","marked":"Gba nwọ̀n ńlò lé wọn mú Ọ lọ."}],"end":16.226},{"key":"3","start":17.176,"lines":[{"start":17.176,"end":18.465,"text":"Olus'agutan eni Re","marked":"Olùs'ágùtàn ẹni Rẹ̀"},{"start":18.845,"end":20.299,"text":"So anu Re 'gbani d'otun","marked":"Sọ ãnú Rẹ 'gbani d'ọ̀tun"},{"start":20.679,"end":22.259,"text":"So adun oruko nla Re","marked":"Sọ adùn orúkọ ńlá Rẹ"},{"start":22.639,"end":24.255,"text":"Fun okan ti nwa oju Re.","marked":"Fún ọkàn ti ńwá ojú Rẹ."}],"end":24.255},{"key":"4","start":25.205,"lines":[{"start":25.205,"end":27.082,"text":"Je k'a r'ipa adua nihin","marked":"Jẹ k'á r'ipa adua níhìn"},{"start":27.462,"end":29.216,"text":"Lati so 'gbagbo di lile","marked":"Láti sọ 'gbàgbọ́ di líle"},{"start":29.596,"end":31.362,"text":"Lati gbe ife wa soke","marked":"Láti gbé ìfẹ́ wa sókè"},{"start":31.742,"end":33.415,"text":"Lati gb'orun ka 'waju wa.","marked":"Láti gb'ọrun ká 'wájú wa."}],"end":33.415},{"key":"5","start":34.365,"lines":[{"start":34.365,"end":36.199,"text":"Oluwa,'Wo wa nitosi","marked":"Olúwa,'Wo wà nítòsí"},{"start":36.579,"end":38.571,"text":"N'apa Re de 'ti Re sile","marked":"N'apá Rẹ dé 'ti Rẹ sílẹ̀"},{"start":38.951,"end":40.761,"text":"Si orun sokale kankan","marked":"Ṣí ọ̀run sọ̀kalẹ̀ kankan"},{"start":41.141,"end":42.542,"text":"Se gbogbo okan ni Tire.","marked":"Ṣe gbogbo ọkàn ní Tìrẹ."},{"start":42.922,"end":43.453,"text":"Amin.","marked":"Àmín."}],"end":43.453}]}