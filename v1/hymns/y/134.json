{"v":1,"coll":"y","num":134,"id":"hymn_134","title":"B'ORUKO Jesu ti dun to","duration":42.269,"voices":{"male":{"file":"y-134-male.m4a","bytes":302295,"sha256":"414587f16f0ee0457f5a1f1c7362559a737fa058ca3dab5ae60f265f4ce3d583","duration":42.3},"female":{"file":"y-134-female.m4a","bytes":303529,"sha256":"e9aa41fb8f777772998396fb04df1f422c9267301af697e821e84968c5616be7","duration":42.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.94,"text":"B'ORUKO Jesu ti dun to","marked":"B'orúkọ Jésù ti dùn tó"},{"start":2.32,"end":3.614,"text":"Ogo ni fun Oruko re","marked":"Ògo ni fún Orúkọ rẹ"},{"start":3.994,"end":5.603,"text":"O tan banuje at'ogbe","marked":"Ó tan bànújẹ́ àt'ọgbẹ́"},{"start":5.983,"end":7.446,"text":"Ogo ni fun Oruko Re.","marked":"Ògo ni fún Orúkọ Rẹ."}],"end":7.446},{"key":"CHORUS","start":8.396,"lines":[{"start":8.396,"end":10.592,"text":"Ogo f'oko Re, Ogo f'oko Re","marked":"Ògo f'ọkọ Rẹ, Ògo f'ọkọ Rẹ"},{"start":10.972,"end":12.196,"text":"Ogo f'oruko Oluwa","marked":"Ògo f'orukọ Olúwa"},{"start":12.576,"end":14.938,"text":"Ogo f'oko Re, Ogo f'oko Re","marked":"Ògo f'ọkọ Rẹ, Ògo f'ọkọ Rẹ"},{"start":15.318,"end":16.737,"text":"Ogo f'oruko Oluwa.","marked":"Ògo f'orukọ Olúwa."}],"end":16.737},{"key":"2","start":17.687,"lines":[{"start":17.687,"end":19.285,"text":"O wo okan to gb'ogbe san","marked":"Ó wo ọ̀kan tó gb'ògbé sàn"},{"start":19.665,"end":20.981,"text":"Ogo ni fun oruko Re","marked":"Ògo ni fún orúkọ Rẹ"},{"start":21.361,"end":22.861,"text":"Onje ni f 'okan t'ebi npa","marked":"Onje ní f 'ọkàn t'ebi ńpa"},{"start":23.241,"end":24.632,"text":"Ogo ni fun oruko Re.","marked":"Ògo ni fún orúkọ Rẹ."}],"end":24.632},{"key":"3","start":25.582,"lines":[{"start":25.582,"end":27.251,"text":"O tan aniyan elese","marked":"Ó tán àníyàn ẹlẹ́ṣẹ̀"},{"start":27.631,"end":28.981,"text":"Ogo ni fun Oruko re","marked":"Ògo ni fún Orúkọ rẹ"},{"start":29.361,"end":30.778,"text":"O fun alare ni simi","marked":"Ó fún aláre ní ṣímí"},{"start":31.158,"end":32.716,"text":"Ogo ni fun oruko re.","marked":"Ògo ni fún orúkọ rẹ."}],"end":32.716},{"key":"4","start":33.666,"lines":[{"start":33.666,"end":35.476,"text":"Nje un o royin na f'elese","marked":"Ǹjẹ́ ùn ò ròyìn ná f'ẹ́lẹ́sẹ̀"},{"start":35.856,"end":37.189,"text":"Ogo ni fun oruko Re","marked":"Ògo ni fún orúkọ Rẹ"},{"start":37.569,"end":38.833,"text":"Pe mo ti ri Olugbala","marked":"Pé mo ti rí Olùgbàlà"},{"start":39.213,"end":40.719,"text":"Ogo ni fun oruko Re.","marked":"Ògo ni fún orúkọ Rẹ."}],"end":40.719}]}