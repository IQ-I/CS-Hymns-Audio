{"v":1,"coll":"y","num":752,"id":"hymn_752","title":"ADORIN odun ni ye odun wa","duration":65.327,"voices":{"male":{"file":"y-752-male.m4a","bytes":479819,"sha256":"c9fdebd95840c4560cc09a1d50bac9548beb84681e5138970eb22297c0b4923a","duration":65.4},"female":{"file":"y-752-female.m4a","bytes":499400,"sha256":"15a2a82c78bbe36322123adc4ed06bbf2e65cee580c7d50536b8a35114fad310","duration":65.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.503,"text":"ADORIN odun ni ye odun wa","marked":"Àdọ́rin ọdún ni yé ọdún wa"},{"start":2.883,"end":3.953,"text":"Bi ojo alagbase","marked":"Bí ọjọ́ alágbàṣe"},{"start":4.333,"end":6.753,"text":"A o ke wa lule bi itanna eweko","marked":"A ò ké wa lulẹ̀ bí ìtànná ewéko"},{"start":7.133,"end":8.371,"text":"Awa a si koja lo.","marked":"Àwa á sì kọjá lọ."}],"end":8.371},{"key":"CHORUS","start":9.321,"lines":[{"start":9.321,"end":12.281,"text":"Egbe: O digbose (arakunrin tabi arabinrin)","marked":"Ó dìgbóṣe arákùnrin tàbí arábìnrin"},{"start":12.661,"end":15.261,"text":"O digbose, (Arakunrin tabi arabinrin)","marked":"Ó dìgbóṣe, Arákùnrin tàbí arábìnrin"},{"start":15.641,"end":16.956,"text":"O d'ojo ajinde.","marked":"Ó d'ọjọ́ àjíǹde."}],"end":16.956},{"key":"2","start":17.906,"lines":[{"start":17.906,"end":20.642,"text":"Koriko, b'o ku ko tun le ye mo","marked":"Koríko, b'ó kù kó tún lè yé mọ́"},{"start":21.022,"end":22.517,"text":"Iwo ku lati tun ye","marked":"Ìwọ kù láti tún yé"},{"start":22.897,"end":24.656,"text":"Ade ti ki sa yio je tire","marked":"Adé tí kì sá yìó jẹ́ tirẹ̀"},{"start":25.036,"end":26.111,"text":"Lodo Olugbala.","marked":"Lọ́dọ̀ Olùgbàlà."}],"end":26.111},{"key":"3","start":27.061,"lines":[{"start":27.061,"end":29.761,"text":"Losu to koja, t'awa tire ni","marked":"Lóṣù tó kọjá, t'áwà tirẹ̀ ni"},{"start":30.141,"end":31.923,"text":"Loni ipo re s'ofo","marked":"Lọ́ni ipò rẹ s'ọ́fọ́"},{"start":32.303,"end":33.991,"text":"(Arakunrin, Arabinrin)","marked":"Arákùnrin, Arábìnrin"},{"start":34.371,"end":35.751,"text":"wa ko lo s'idale.","marked":"wa kó lọ s'ídálẹ̀."}],"end":35.751},{"key":"4","start":36.701,"lines":[{"start":36.701,"end":38.436,"text":"Je ki eyi je eko fun gbogbo wa,","marked":"Jẹ́ kí èyí jẹ́ ẹ̀kọ́ fún gbogbo wa"},{"start":38.816,"end":39.874,"text":"Lati tun wa wa se","marked":"Láti tún wá wa ṣe"},{"start":40.254,"end":42.185,"text":"lgi gbigbe le wa ni iduro","marked":"lgi gbígbẹ lè wà ní ìdúró"},{"start":42.565,"end":43.985,"text":"K'a ke tutu lule.","marked":"K'á ké tútù lulẹ̀."}],"end":43.985},{"key":"5","start":44.935,"lines":[{"start":44.935,"end":46.607,"text":"Iwa wa laiye yio jeri si wa","marked":"Ìwà wa láìyẹ yio jẹ́rí sí wa"},{"start":46.987,"end":48.267,"text":"Bi 'gbehin y'o tori","marked":"Bí 'gbẹ̀hìn y'ó torí"},{"start":48.647,"end":51.008,"text":"Rere (Arakunrin, Arabinrin)","marked":"Rèrè Arákùnrin, Arábìnrin"},{"start":51.388,"end":52.259,"text":"ti nto lehin","marked":"ti nto lẹ́hìn"},{"start":52.639,"end":53.924,"text":"O ti se won to le se.","marked":"Ó ti ṣe wọ́n tó lè ṣe."}],"end":53.924},{"key":"6","start":54.874,"lines":[{"start":54.874,"end":58.158,"text":"Egbe at'Ebi (Arakunrin, Arabinrin) wa","marked":"Ẹgbẹ́ àt'Ẹbí Arákùnrin, Arábìnrin wa"},{"start":58.538,"end":60.05,"text":"A ba nyin daro lokan","marked":"A bá nyín dárò lọ́kàn"},{"start":60.43,"end":62.045,"text":"Ireti mbe a o pade loke","marked":"Ìrètí ḿbẹ a ó pàdé lókè"},{"start":62.425,"end":63.777,"text":"Ni ojo Ajinde wa.","marked":"Ní ọjọ́ Àjíǹde wa."}],"end":63.777}]}