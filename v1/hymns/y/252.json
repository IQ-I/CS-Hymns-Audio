{"v":1,"coll":"y","num":252,"id":"hymn_252","title":"OLUWA, gbo aroye mi","duration":42.377,"voices":{"male":{"file":"y-252-male.m4a","bytes":300338,"sha256":"e4d15dad81657e626572ea0cf2c59f90c708f9dd327c231e7ee0f080bfbf5c50","duration":42.4},"female":{"file":"y-252-female.m4a","bytes":308440,"sha256":"0bc835f6a4d4b0ab8c49de4f46620776732b31746a54f44545e43bfaef1ae420","duration":42.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.62,"text":"OLUWA, gbo aroye mi","marked":"Olúwa, gbọ́ àròyé mi"},{"start":2.0,"end":3.415,"text":"Gbo adura ikoko mi","marked":"Gbọ́ àdúrà ìkọ̀kọ̀ mi"},{"start":3.795,"end":5.263,"text":"Lodo Re nikan Oba mi","marked":"Lọ́dọ̀ Rẹ nìkan Ọba mi"},{"start":5.643,"end":7.017,"text":"L'emi O ma wa iranwo.","marked":"L'èmi Ò mà wá ìrànwọ́."}],"end":7.017},{"key":"2","start":7.967,"lines":[{"start":7.967,"end":9.281,"text":"L'oro Iwo o gbohun mi","marked":"L'ọ̀rọ̀ Ìwọ ò gbóhùn mi"},{"start":9.661,"end":11.106,"text":"L'afemojumo ojo na","marked":"L'àfẹ̀mọ́júmọ́ ọjọ́ ná"},{"start":11.486,"end":13.351,"text":"Ni odo Re l'emi o wo","marked":"Ní ọ̀dọ̀ Rẹ l'èmi ò wọ̀"},{"start":13.731,"end":15.257,"text":"Si O l'emi o gbadura.","marked":"Sí Ò l'èmí ò gbàdúrà."}],"end":15.257},{"key":"3","start":16.207,"lines":[{"start":16.207,"end":17.483,"text":"Sugbon nigb'ore-ofe Re","marked":"Ṣùgbọ́n nígb'ọ̀rẹ́-ọ̀fẹ́ Rẹ"},{"start":17.863,"end":19.232,"text":"Ba mu mi de agbala Re","marked":"Bá mú mi dé àgbàlá Rẹ"},{"start":19.612,"end":20.991,"text":"Odo Re I'em'o teju mo","marked":"Ọ̀dọ̀ Rẹ l'em'o tẹjú mọ́"},{"start":21.371,"end":23.755,"text":"Nibe, ngo sin O ni rele.","marked":"Níbẹ̀, ngo sin Ò ní rẹlẹ̀."}],"end":23.755},{"key":"4","start":24.705,"lines":[{"start":24.705,"end":26.194,"text":"Je k'awon t'o gbekele O,","marked":"Jẹ k'àwọn t'ó gbẹ́kẹ̀lé O"},{"start":26.574,"end":27.814,"text":"L'ohun rara wi ayo won","marked":"L'ọ́hun rárá wí ayọ̀ wọn"},{"start":28.194,"end":29.873,"text":"Jek' awon t'lwo pamo yo","marked":"Jek' àwọn t'lwò pamọ́ yọ"},{"start":30.253,"end":31.889,"text":"Awon t'o fe oruko Re.","marked":"Àwọn t'ó fẹ́ orúkọ Rẹ̀."}],"end":31.889},{"key":"5","start":32.839,"lines":[{"start":32.839,"end":34.067,"text":"Si Olododo l'Oluwa","marked":"Sí Olódodo l'Olúwa"},{"start":34.447,"end":35.74,"text":"O na owo ibukun Re","marked":"Ó ná owó ìbùkún Rẹ̀"},{"start":36.12,"end":37.679,"text":"Oju rere Re l'enia Re","marked":"Ojú rere Rẹ l'enia Rẹ"},{"start":38.059,"end":39.837,"text":"Yio si fi se asa won.","marked":"Yíó sì fi ṣe àṣà wọn."},{"start":40.217,"end":40.827,"text":"Amin.","marked":"Àmín."}],"end":40.827}]}