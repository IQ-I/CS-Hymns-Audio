{"v":1,"coll":"y","num":308,"id":"hymn_308","title":"EKUN ko le gba mi","duration":67.264,"voices":{"male":{"file":"y-308-male.m4a","bytes":496624,"sha256":"979cc5d0b98e7bdbcd859078969052fcc4ccce3281eacc4666c74d8af7270dcf","duration":67.3},"female":{"file":"y-308-female.m4a","bytes":518273,"sha256":"73bb6c07446f6fb2b35674bcfc431fa94b9ef2e5baf8b6452bcf8dd23d3d62d8","duration":67.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.905,"text":"EKUN ko le gba mi,","marked":"Ẹkùn kò lè gbà mí"},{"start":2.285,"end":3.88,"text":"Bi mo le f'ekun we 'ju;","marked":"Bí mo lè f'ẹkùn wé 'ju"},{"start":4.26,"end":5.417,"text":"Ko le mu eru mi tan,","marked":"Kò lè mú ẹrù mi tán"},{"start":5.797,"end":7.251,"text":"Ko le we ese mi nu;","marked":"Kò lè wẹ ẹsẹ̀ mi nù"},{"start":7.631,"end":8.893,"text":"Ekin ko le gba mi.","marked":"Ekin kò lè gbà mí."},{"start":9.273,"end":11.491,"text":"Egbe: Jesu sun, O ku fun mi,","marked":"Jésù sùn, Ó kù fún mi"},{"start":11.871,"end":13.259,"text":"O jiya lori igi","marked":"Ó jìyà lórí igi"},{"start":13.639,"end":15.133,"text":"Lati so mi d'ominira","marked":"Láti sọ mí d'òmìnira"},{"start":15.513,"end":17.2,"text":"On na l'O le gba mi.","marked":"On ná l'O lè gbà mí."}],"end":17.2},{"key":"CHORUS","start":18.15,"lines":[{"start":18.15,"end":20.047,"text":"Jesu sun, O ku fun mi,","marked":"Jésù sùn, Ó kù fún mi"},{"start":20.427,"end":21.67,"text":"O jiya lori igi","marked":"Ó jìyà lórí igi"},{"start":22.05,"end":23.604,"text":"Lati so mi d'ominira","marked":"Láti sọ mí d'òmìnira"},{"start":23.984,"end":25.319,"text":"On na l'O le gba mi.","marked":"On ná l'O lè gbà mí."}],"end":25.319},{"key":"2","start":26.269,"lines":[{"start":26.269,"end":27.545,"text":"lse ko le gba mi","marked":"lse kò lè gbà mí"},{"start":27.925,"end":29.098,"text":"lse mi t'o dara ju","marked":"lse mi t'ó dára jù"},{"start":29.478,"end":30.701,"text":"Ero mi t'o mo julo","marked":"Èrò mi t'ó mọ́ jùlọ"},{"start":31.081,"end":32.395,"text":"Ko le s'okan mi d'otun","marked":"Kò lè s'ọkàn mi d'ọ̀tun"},{"start":32.775,"end":34.141,"text":"Ise ko le gba mi.","marked":"Iṣẹ́ kò lè gbà mí."},{"start":34.521,"end":36.515,"text":"Egbe: Jesu sun, O ku fun mi...","marked":"Jésù sùn, Ó kù fún mi"}],"end":36.515},{"key":"3","start":37.465,"lines":[{"start":37.465,"end":38.51,"text":"'Duro ko le gba mi","marked":"'Dúró kó lè gbà mí"},{"start":38.89,"end":40.28,"text":"Enit'o junu ni mi","marked":"Enít'ó junu ni mí"},{"start":40.66,"end":42.195,"text":"L'eti mi l'anu nke pe","marked":"L'etí mi l'ánú ńkẹ́ pé"},{"start":42.575,"end":43.991,"text":"Bi mo ba duro ngo ku","marked":"Bí mo bá dúró ngo kú"},{"start":44.371,"end":45.459,"text":"'Duro ko le gba mi.","marked":"'Dúró kò lè gbà mí."},{"start":45.839,"end":47.781,"text":"Egbe: Jesu sun, O ku fun mi...","marked":"Jésù sùn, Ó kù fún mi"}],"end":47.781},{"key":"4","start":48.731,"lines":[{"start":48.731,"end":49.855,"text":"Igbagbo le gba mi","marked":"Ìgbàgbọ́́ lè gbà mí"},{"start":50.235,"end":51.695,"text":"Jeki ngbekel'Omo Re","marked":"Jẹki ngbekel'Ọmọ Rẹ"},{"start":52.075,"end":53.615,"text":"Jeki ngbekele s'ise Re","marked":"Jèkì ńgbẹ́kẹ̀lé s'iṣẹ́ Rẹ"},{"start":53.995,"end":55.369,"text":"Jeki nsa si apa Re","marked":"Jẹki ńsà sí apá Rẹ"},{"start":55.749,"end":56.83,"text":"Igbagbo le gba mi.","marked":"Ìgbàgbọ́́ lè gbà mí."},{"start":57.21,"end":59.138,"text":"Egbe: Jesu sun, O ku fun mi,","marked":"Jésù sùn, Ó kù fún mi"},{"start":59.518,"end":60.972,"text":"O jiya lori igi","marked":"Ó jìyà lórí igi"},{"start":61.352,"end":62.959,"text":"Lati so mi d'ominira","marked":"Láti sọ mí d'òmìnira"},{"start":63.339,"end":64.778,"text":"On na l'O le gba mi.","marked":"On ná l'O lè gbà mí."},{"start":65.158,"end":65.714,"text":"Amin.","marked":"Àmín."}],"end":65.714}]}