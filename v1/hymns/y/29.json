{"v":1,"coll":"y","num":29,"id":"hymn_29","title":"OLORUN wa orun","duration":44.723,"voices":{"male":{"file":"y-29-male.m4a","bytes":307567,"sha256":"61423ff82b7c23b482de00fb5696c033663a87cb0ff4eb49835483731693fef5","duration":44.8},"female":{"file":"y-29-female.m4a","bytes":321184,"sha256":"29db3dd227a021b880f912cd2f75384a6e81d62553ef4833c67e6f866bed0e47","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.094,"text":"OLORUN wa orun,","marked":"Ọlọ́run wa ọ̀run"},{"start":1.474,"end":2.53,"text":"T'o fi ojo mefa","marked":"T'ó fi ọjọ́ mẹ́fà"},{"start":2.91,"end":4.559,"text":"Da nkan gbogbo ti mbe laiye,","marked":"Dá nkan gbogbo ti ḿbẹ láìyẹ"},{"start":4.939,"end":6.278,"text":"Simi nijo keje.","marked":"Símí níjọ́ keje."}],"end":6.278},{"key":"2","start":7.228,"lines":[{"start":7.228,"end":8.664,"text":"O pase k'a bowo","marked":"Ó pàṣẹ k'á bọwọ́"},{"start":9.044,"end":10.137,"text":"Fun ojo isimi,","marked":"Fún ọjọ́ isimi"},{"start":10.517,"end":11.753,"text":"lbunu Re tobi pupo","marked":"lbunu Rẹ̀ tóbi púpọ̀"},{"start":12.133,"end":13.815,"text":"S'awon t'o o rufin yi.","marked":"S'àwọn t'ó ò rúfin yí."}],"end":13.815},{"key":"3","start":14.765,"lines":[{"start":14.765,"end":15.844,"text":"Awon baba nla wa","marked":"Àwọn bàbá ńlá wa"},{"start":16.224,"end":17.335,"text":"Ti ku nin'okunkun;","marked":"Ti kú nín'òkùnkùn"},{"start":17.715,"end":19.267,"text":"Nwon je ogbo aborisa","marked":"Nwọ̀n jẹ́ ọ̀gbọ̀ abọ̀rìṣà"},{"start":19.647,"end":20.836,"text":"Nwon ko mo ofin Re.","marked":"Nwọn kò mọ òfin Rẹ̀."}],"end":20.836},{"key":"4","start":21.786,"lines":[{"start":21.786,"end":22.896,"text":"Awa de, Oluwa","marked":"Àwa dé, Olúwa"},{"start":23.276,"end":24.34,"text":"Gege bi ase Re,","marked":"Gẹ́gẹ́ bí àṣẹ Rẹ"},{"start":24.72,"end":26.225,"text":"Lehin ise ijo mefa,","marked":"Lẹ́hìn iṣẹ́ ìjọ mẹ́fà"},{"start":26.605,"end":27.963,"text":"Lati se ife Re.","marked":"Láti ṣe ìfẹ́ Rẹ."}],"end":27.963},{"key":"5","start":28.913,"lines":[{"start":28.913,"end":29.894,"text":"Mimo l'ojo oni,","marked":"Mímọ́ l'ọ́jọ́ òní"},{"start":30.274,"end":31.364,"text":"O ye ki a simi","marked":"Ó yẹ kí á sìmí"},{"start":31.744,"end":32.945,"text":"K'a pejo ninu ile Re","marked":"K'á péjọ nínú ilé Rẹ"},{"start":33.325,"end":34.418,"text":"K'a gbo 'ro mimo Re.","marked":"K'á gbọ́ 'ro mímọ́́ Rẹ̀."}],"end":34.418},{"key":"6","start":35.368,"lines":[{"start":35.368,"end":36.921,"text":"Isimi nla kan ku","marked":"Ìsìmi ńlá kan kù"},{"start":37.301,"end":38.55,"text":"F'awon enia Re,","marked":"F'àwọn enia Rẹ"},{"start":38.93,"end":40.736,"text":"Om'Olorun, Alabukun","marked":"Om'Ọlọ́run, Alábùkún"},{"start":41.116,"end":42.192,"text":"Mu wa de 'simi re!","marked":"Mú wa dé 'sími rẹ!"},{"start":42.572,"end":43.173,"text":"Amin.","marked":"Àmín."}],"end":43.173}]}