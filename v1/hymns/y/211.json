{"v":1,"coll":"y","num":211,"id":"hymn_211","title":"LEHIN odun die","duration":52.771,"voices":{"male":{"file":"y-211-male.m4a","bytes":373697,"sha256":"85d6e4a9f8e5188567354e1b2a3fc0560a21dbb121c20fc7e4811f783917bbc7","duration":52.8},"female":{"file":"y-211-female.m4a","bytes":384753,"sha256":"749747a43bf61c0daf71b352e3fd7ac08afbc0b8050e51d794715a994dc0e771","duration":52.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.47,"text":"LEHIN odun die,","marked":"Lẹ́hìn ọdún díẹ̀"},{"start":1.85,"end":2.782,"text":"Lehin igba die,","marked":"Lẹ́hìn ìgbà díẹ̀"},{"start":3.162,"end":4.747,"text":"A o kowa jo pel' awon","marked":"A ò kọwà jọ pẹ̀L' àwọn"},{"start":5.127,"end":6.439,"text":"Ti o sun n'iboji.","marked":"Tí ó sùn ń'íbòji."}],"end":6.439},{"key":"CHORUS","start":7.389,"lines":[{"start":7.389,"end":8.428,"text":"Oluwa, mu mi ye,","marked":"Olúwa, mú mi yé"},{"start":8.808,"end":10.096,"text":"Fun ojo nlanla na!","marked":"Fún ọjọ́ ńláǹlà ná!"},{"start":10.476,"end":11.838,"text":"Jo, we mi ninu eje Re,","marked":"Jọ, wé mi nínú ẹ̀jẹ̀ Rẹ"},{"start":12.218,"end":13.687,"text":"Si ko ese mi lo.","marked":"Sì kó ẹsẹ̀ mi lọ."}],"end":13.687},{"key":"2","start":14.637,"lines":[{"start":14.637,"end":15.802,"text":"Lehin ojo die,","marked":"Lẹ́hìn ọjọ́ díẹ̀"},{"start":16.182,"end":17.336,"text":"Laiye buburu yi,","marked":"Láìyẹ búburú yí"},{"start":17.716,"end":19.53,"text":"A o de b' orun ko si mo,","marked":"A ò dé b' ọrùn kò sí mọ́"},{"start":19.91,"end":20.835,"text":"Ile daradara.","marked":"Ilẹ̀ dáradára."}],"end":20.835},{"key":"3","start":21.785,"lines":[{"start":21.785,"end":23.008,"text":"Lehin igbi die;","marked":"Lẹ́hìn ìgbì díẹ̀"},{"start":23.388,"end":24.469,"text":"L'ebute lile yi,","marked":"L'èbúté líle yi"},{"start":24.849,"end":27.015,"text":"A o de b' iji ko simo,","marked":"A ò dé b' ìjì kò simo"},{"start":27.395,"end":29.178,"text":"T' okun ki bu soke.","marked":"T' okun kì bù sókè."}],"end":29.178},{"key":"4","start":30.128,"lines":[{"start":30.128,"end":31.151,"text":"Lehin 'yonu die;","marked":"Lẹ́hìn 'yọnu díẹ̀"},{"start":31.531,"end":32.783,"text":"Lehin 'pinya die;","marked":"Lẹ́hìn 'pínyà díẹ̀"},{"start":33.163,"end":34.945,"text":"Lehin ekun ati aro,","marked":"Lẹ́hìn ẹkùn àti aró"},{"start":35.325,"end":36.442,"text":"A ki sokun mo.","marked":"A kì sókun mọ́."}],"end":36.442},{"key":"5","start":37.392,"lines":[{"start":37.392,"end":38.432,"text":"Ojo'simi die,","marked":"Ọjọ́'simi díẹ̀"},{"start":38.812,"end":40.004,"text":"La ni tun ri laiye;","marked":"La ní tún rí láìyẹ"},{"start":40.384,"end":41.634,"text":"A o de ibi isimi,","marked":"A ó dé ibi ìsimi"},{"start":42.014,"end":43.404,"text":"Ti ki o pin lailai.","marked":"Ti kí o pín láíláí."}],"end":43.404},{"key":"6","start":44.354,"lines":[{"start":44.354,"end":45.809,"text":"Ojo die l'o ku,","marked":"Ọjọ́ díẹ̀ l'ó kú"},{"start":46.189,"end":47.413,"text":"On o tun pada wa,","marked":"Ọ̀n ò tún padà wá"},{"start":47.793,"end":49.377,"text":"Eniti o ku k'awa le ye,","marked":"Eniti ò kú k'awa lè yé"},{"start":49.757,"end":51.221,"text":"K' a ba le ba joba.","marked":"K' a bá lè bá jọba."}],"end":51.221}]}