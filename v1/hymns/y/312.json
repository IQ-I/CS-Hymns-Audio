{"v":1,"coll":"y","num":312,"id":"hymn_312","title":"OLORUN fe araye","duration":46.868,"voices":{"male":{"file":"y-312-male.m4a","bytes":344344,"sha256":"849e8fa45434f81517edaf58bed04638f219c47312c7836627bedc382721057a","duration":46.9},"female":{"file":"y-312-female.m4a","bytes":354446,"sha256":"da7f5ca0c4aeb6a6245c891f4a2064a3fe1c63ba43dbabcedbc2c5974a634bb5","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.845,"text":"OLORUN fe araye,","marked":"Ọlọ́run fẹ́ aráyé"},{"start":2.225,"end":3.266,"text":"O fe tobe ge:","marked":"Ó fẹ́ tóbẹ gé"},{"start":3.646,"end":5.023,"text":"T' O ran omo Re w' aiye","marked":"T' Ó ran ọmọ Rẹ̀ w' aiye"},{"start":5.403,"end":6.742,"text":"T' Oku fun elese,","marked":"T' Oku fún ẹlẹ́ṣẹ̀"},{"start":7.122,"end":8.297,"text":"Olorun ti mo tele,","marked":"Ọlọ́run ti mọ̀ tẹ́lẹ̀"},{"start":8.677,"end":10.072,"text":"Pe, emi o se si","marked":"Pé, èmi ò ṣe sí"},{"start":10.452,"end":11.96,"text":"Ofin ati Ife Re,","marked":"Òfin àti Ìfẹ́ Rẹ"},{"start":12.34,"end":13.332,"text":"lwo ha fe mi bi?","marked":"lwo ha fẹ́ mi bí?"}],"end":13.332},{"key":"2","start":14.282,"lines":[{"start":14.282,"end":16.099,"text":"Loto, Olorun fe mi,","marked":"Lọ́tọ̀, Ọlọ́run fẹ́ mi"},{"start":16.479,"end":17.793,"text":"Ani ani ko si,","marked":"Àní àní kò sí"},{"start":18.173,"end":19.706,"text":"Awon t' o yipada si,","marked":"Àwọn t' ò yípadà sí"},{"start":20.086,"end":21.364,"text":"Igbala ni nwon ri","marked":"Ìgbàlà ní ǹwọ̀n rí"},{"start":21.744,"end":23.156,"text":"Wo! Jesu Kristi jiya,","marked":"Wò! Jésù Kristi jìyà"},{"start":23.536,"end":24.872,"text":"Igi I'a kan A mo,","marked":"Igi l'á kan Á mọ́"},{"start":25.252,"end":27.795,"text":"Wo ! eje Re ti o san,","marked":"Wò ! ẹ̀jẹ̀ Rẹ tí ó sàn"},{"start":28.175,"end":30.084,"text":"Wo! ro! ma dese mo.","marked":"Wò! rò! má dẹ́ṣẹ̀ mọ́."}],"end":30.084},{"key":"3","start":31.034,"lines":[{"start":31.034,"end":33.156,"text":"Jesu, agbelebu Re ni,","marked":"Jésù, àgbélébùú Rẹ̀ ni"},{"start":33.536,"end":34.704,"text":"Ngo kan ese mi Mo;","marked":"Ngo kan ẹsẹ̀ mi Mọ́"},{"start":35.084,"end":36.212,"text":"Labe agbelebu Re,","marked":"Lábẹ́ àgbélébùú Rẹ"},{"start":36.592,"end":37.52,"text":"Ngo we ese mi nu,","marked":"Ngo wẹ ẹsẹ̀ mi nù"},{"start":37.9,"end":39.169,"text":"Nigbati emi o ri O,","marked":"Nígbàtí èmi ò rí O"},{"start":39.549,"end":40.483,"text":"Ni orun rere Re:","marked":"Ní ọ̀run rere Rẹ"},{"start":40.863,"end":42.083,"text":"Nki yio dekun yin O,","marked":"Nkí yíó dẹkùn yín O"},{"start":42.463,"end":44.334,"text":"F' ogo at'ola Re.","marked":"F' ògo àt'ọ́lá Rẹ."},{"start":44.714,"end":45.318,"text":"Amin.","marked":"Àmín."}],"end":45.318}]}