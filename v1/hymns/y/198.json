{"v":1,"coll":"y","num":198,"id":"hymn_198","title":"A YIN O, Baba orun","duration":73.335,"voices":{"male":{"file":"y-198-male.m4a","bytes":532926,"sha256":"aca16c76e5c6493d59664920cd73b9e09d7b5136030b8a9044ed7bdaf95fcb85","duration":73.4},"female":{"file":"y-198-female.m4a","bytes":554916,"sha256":"f04687f7265636a92c9cb6ecb86c28788f144b5a7bcf749866be527b93a4e635","duration":73.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.104,"text":"A YIN O, Baba orun","marked":"A Yìn Ọ́, Bàbá ọ̀run"},{"start":2.484,"end":3.844,"text":"T'O ran 'mole w'aiye","marked":"T'ó ran 'mọ́lẹ̀ w'aiye"},{"start":4.224,"end":5.456,"text":"Lati wa tan 'mole Re;","marked":"Láti wá tan 'mọ́lẹ̀ Rẹ"},{"start":5.836,"end":7.412,"text":"Si okunkun aiye","marked":"Ṣí òkùnkùn aiye"},{"start":7.792,"end":9.4,"text":"Angeli nkorin wipe","marked":"Áńgẹ́lì nkorin wípé"},{"start":9.78,"end":10.901,"text":"Ogo f'Oba t'a bi","marked":"Ògo f'Ọba t'á bí"},{"start":11.281,"end":12.501,"text":"Ni ilu nla Dafidi","marked":"Ní ìlú ńlá Dáfídì"},{"start":12.881,"end":14.296,"text":"Ti nse Krist' Oluwa.","marked":"Ti ńṣe Krist' Olúwa."}],"end":14.296},{"key":"2","start":15.246,"lines":[{"start":15.246,"end":16.863,"text":"K'eda aiye ko gberin","marked":"K'édá aiye kò gberin"},{"start":17.243,"end":18.778,"text":"K'eda orun gberin","marked":"K'ẹ̀dà ọrùn gberin"},{"start":19.158,"end":20.328,"text":"S'Omo Mimo Dafidi","marked":"S'Ọmọ Mímọ́́ Dáfídì"},{"start":20.708,"end":21.872,"text":"Omo ti Ileri","marked":"Ọmọ ti Ìlérí"},{"start":22.252,"end":23.338,"text":"Yin Omo Alade nla","marked":"Yín Ọmọ Aládé ńlá"},{"start":23.718,"end":24.767,"text":"Ade alafia","marked":"Adé àlàáfíà"},{"start":25.147,"end":26.332,"text":"K'ibukun ojo oni","marked":"K'ìbùkún ọjọ́ òní"},{"start":26.712,"end":27.986,"text":"Ko kari gbogbo wa.","marked":"Kò kárí gbogbo wa."}],"end":27.986},{"key":"3","start":28.936,"lines":[{"start":28.936,"end":29.879,"text":"O wa ninu irele","marked":"Ó wà nínú ìrẹ̀lẹ̀"},{"start":30.259,"end":31.571,"text":"Lati ko wa leko","marked":"Láti kọ́ wa lẹ́kọ́"},{"start":31.951,"end":33.367,"text":"K'a tele 'pa ese Re","marked":"K'á tẹ̀lé 'pa ẹsẹ̀ Rẹ"},{"start":33.747,"end":34.898,"text":"Ka le gba 'leri Re","marked":"Ká lè gbà 'lérí Rẹ"},{"start":35.278,"end":37.408,"text":"Gbo, eda orun nkorin","marked":"Gbọ́, ẹ̀dá ọ̀run nkorin"},{"start":37.788,"end":38.794,"text":"Iyin f'OIugbala","marked":"Ìyìn f'Olùgbàlà"},{"start":39.174,"end":40.528,"text":"Alafia l'aiye yi","marked":"Àlàáfíà l'áiye yi"},{"start":40.908,"end":42.037,"text":"Baba ba wa laja.","marked":"Bàbá bá wa lájà."}],"end":42.037},{"key":"4","start":42.987,"lines":[{"start":42.987,"end":44.186,"text":"O to igbekun sile","marked":"Ó tó ìgbèkùn sílẹ̀"},{"start":44.566,"end":45.675,"text":"O so wa di Tire","marked":"Ó sọ wá di Tìrẹ"},{"start":46.055,"end":47.845,"text":"K'a ma d'eru ese mo","marked":"K'á má d'ẹrù ẹsẹ̀ mọ́"},{"start":48.225,"end":49.276,"text":"K'a d'eni igbala","marked":"K'á d'ẹni ìgbàlà"},{"start":49.656,"end":51.507,"text":"lyin, Ola, Agbara,","marked":"lyin, Ọlá, Agbára"},{"start":51.887,"end":53.126,"text":"Ni fun baba loke","marked":"Ní fún bàbá lókè"},{"start":53.506,"end":54.613,"text":"Ogo ni fun Omo Re","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":54.993,"end":56.146,"text":"Ni fun Emi Mimo.","marked":"Ní fún Ẹ̀mí Mímọ́́."}],"end":56.146},{"key":"5","start":57.096,"lines":[{"start":57.096,"end":58.448,"text":"Kembu on Serafu","marked":"Kembu on Séráfù"},{"start":58.828,"end":60.235,"text":"So fun araiye pe","marked":"Sọ fún araiye pé"},{"start":60.615,"end":62.107,"text":"Ijoba ku si dede","marked":"Ìjọba kù sí dẹ̀dẹ̀"},{"start":62.487,"end":63.615,"text":"Ijoba Olorun","marked":"Ìjọba Ọlọ́run"},{"start":63.995,"end":65.842,"text":"'Gba Jesu y'o tun w'aiye","marked":"'Gba Jésù y'ó tún w'aiye"},{"start":66.222,"end":67.27,"text":"Bi Onidajo Nla","marked":"Bí Onídàjọ́ Ńlá"},{"start":67.65,"end":69.187,"text":"K'a le fi ayo pade Re","marked":"K'á lè fi ayọ̀ pàdé Rẹ"},{"start":69.567,"end":70.886,"text":"Baba, gbo ebe wa.","marked":"Bàbá, gbọ́ ẹ̀bẹ̀ wa."},{"start":71.266,"end":71.785,"text":"Amin.","marked":"Àmín."}],"end":71.785}]}