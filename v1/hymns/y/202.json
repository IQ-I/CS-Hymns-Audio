{"v":1,"coll":"y","num":202,"id":"hymn_202","title":"NIGBA kan ni Betlehemu","duration":69.137,"voices":{"male":{"file":"y-202-male.m4a","bytes":501046,"sha256":"1e70c8f9fb3478a1a91b35a2e59982ab01188aaa43f0d98abffbedbaa5dfdb74","duration":69.2},"female":{"file":"y-202-female.m4a","bytes":520123,"sha256":"4c701357dee621dbcb7425abd7f8a396408b30a625f8902f6d9d82ba7f661225","duration":69.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.875,"text":"NIGBA kan ni Betlehemu,","marked":"Nígbà kan ní Bẹ́tílẹ́hẹ́mù"},{"start":2.255,"end":3.703,"text":"lle kekere kan wa;","marked":"lle kékeré kan wà"},{"start":4.083,"end":5.812,"text":"Nib'iya kan te 'mo re si,","marked":"Nìb'ìyá kan tẹ́ 'mọ́ rẹ̀ sí"},{"start":6.192,"end":7.317,"text":"Lori ibuje eran;","marked":"Lórí ibùjẹ ẹran"},{"start":7.697,"end":8.962,"text":"Maria n'iya omo na,","marked":"Màríà ń'ìyá ọmọ ná"},{"start":9.342,"end":10.708,"text":"Jesu Kristi l'omo na.","marked":"Jésù Kristi l'ọ́mọ ná."}],"end":10.708},{"key":"2","start":11.658,"lines":[{"start":11.658,"end":13.531,"text":"O t'orun wa sode aiye,","marked":"Ó t'ọrun wá sóde aiye"},{"start":13.911,"end":15.168,"text":"On li Olorun Oluwa,","marked":"On li Ọlọ́run Olúwa"},{"start":15.548,"end":17.417,"text":"O f' ile eran se ile,","marked":"Ó f' ilé ẹran ṣe ilé"},{"start":17.797,"end":19.18,"text":"'Buje eran fun 'busun;","marked":"'Bújẹ́ ẹran fún 'bùsùn"},{"start":19.56,"end":20.597,"text":"L'odo awon otosi,","marked":"L'odò àwọn òtòṣì"},{"start":20.977,"end":22.601,"text":"Ni Jesu gbe li aiye.","marked":"Ni Jésù gbé li aiye."}],"end":22.601},{"key":"3","start":23.551,"lines":[{"start":23.551,"end":24.944,"text":"Ni gbogbo igba ewe Re,","marked":"Ní gbogbo ìgbà èwe Rẹ"},{"start":25.324,"end":26.967,"text":"O gboran o si mb'ola;","marked":"Ó gbọ́ràn ó sì mb'ola"},{"start":27.347,"end":29.026,"text":"O feran o si nteriba,","marked":"Ó fẹ́ràn ó sì ńtẹríba"},{"start":29.406,"end":30.758,"text":"Fun iya ti ntoju Re;","marked":"Fún ìyá tí ńtọ́jú Rẹ̀"},{"start":31.138,"end":32.299,"text":"O ye ki gbogb' omode,","marked":"Ó yẹ kí gbogb' ọmọdé"},{"start":32.679,"end":34.153,"text":"Ko se olugboran be.","marked":"Kò ṣe olùgbọràn bẹ́."}],"end":34.153},{"key":"4","start":35.103,"lines":[{"start":35.103,"end":36.579,"text":"'Tori On je awose wa,","marked":"'Torí On jẹ́ àwòṣe wa"},{"start":36.959,"end":38.016,"text":"A ma dagba bi awa;","marked":"A mà dàgbà bí àwa"},{"start":38.396,"end":40.2,"text":"O kere kole dankan se,","marked":"Ó kéré kọ́lẹ̀ dánkan ṣe"},{"start":40.58,"end":41.771,"text":"A ma sokun bi awa;","marked":"A mà sọkún bí àwa"},{"start":42.151,"end":43.382,"text":"O si le ba wa daro,","marked":"Ó sì lè bá wa dárò"},{"start":43.762,"end":45.226,"text":"O le ba wa yo pelu.","marked":"Ó lè bá wa yọ̀ pẹ̀lú."}],"end":45.226},{"key":"5","start":46.176,"lines":[{"start":46.176,"end":47.982,"text":"A o f'oju wa ri nikehin","marked":"A ò f'ojú wa rí níkẹhin"},{"start":48.362,"end":49.716,"text":"Ni agbara ife Re;","marked":"Ní agbára ìfẹ́ Rẹ"},{"start":50.096,"end":51.48,"text":"Nitori Omo rere yi,","marked":"Nítorí Ọmọ rere yí"},{"start":51.86,"end":53.248,"text":"Ni Oluwa wa l'orun:","marked":"Ni Olúwa wa l'ọrun"},{"start":53.628,"end":54.839,"text":"O nto awa omo Re;","marked":"Ó ńtọ́ àwa ọmọ Rẹ̀"},{"start":55.219,"end":56.58,"text":"S'ona ibiti On lo.","marked":"S'ọ́nà ìbítì On lọ."}],"end":56.58},{"key":"6","start":57.53,"lines":[{"start":57.53,"end":58.747,"text":"Ki se ni ibuje eran,","marked":"Kí ṣe ni ibùjẹ ẹran"},{"start":59.127,"end":60.328,"text":"Nibiti malu njeun;","marked":"Níbitì màlú njeun"},{"start":60.708,"end":62.202,"text":"L'awa ori l sugbon l'orun,","marked":"L'áwa orí l sugbon l'ọ̀run"},{"start":62.582,"end":63.857,"text":"L'owo otun Olorun,","marked":"L'ọwọ́ ọ̀tún Ọlọ́run"},{"start":64.237,"end":65.628,"text":"'Gba won 'mo Re B'irawo,","marked":"'Gbà wọ́n 'mọ́ Rẹ B'irawo"},{"start":66.008,"end":67.588,"text":"Ba ntan nin'aso ala.","marked":"Bá ńtán nin'aso àlà."}],"end":67.588}]}