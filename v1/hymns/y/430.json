{"v":1,"coll":"y","num":430,"id":"hymn_430","title":"OLORUN, a so oro Re","duration":24.644,"voices":{"male":{"file":"y-430-male.m4a","bytes":167363,"sha256":"c7402e783a0c320bd2d89504fb4939c51ed457ab10d9b6af5f3f2f3aff6d3caf","duration":24.7},"female":{"file":"y-430-female.m4a","bytes":174872,"sha256":"496f44b21f7c3add1c50cec65bdfe6bafb521b12d32d0c2549da17ef8b9b52b4","duration":24.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.488,"text":"OLORUN, a so oro Re","marked":"Ọlọ́run, a sọ ọ̀rọ̀ Rẹ̀"},{"start":1.868,"end":3.056,"text":"Bi 'rugbin l'or'ile","marked":"Bí 'rúgbìn l'or'ilẹ̀"},{"start":3.436,"end":4.681,"text":"Je k'iri orun se sile","marked":"Jẹ k'írí ọ̀run ṣe sílẹ̀"},{"start":5.061,"end":6.272,"text":"K'o mu ipa re wa.","marked":"K'ó mú ipa rẹ̀ wá."}],"end":6.272},{"key":"2","start":7.222,"lines":[{"start":7.222,"end":8.917,"text":"K'ota Kristi on enia","marked":"K'ọ̀tá Kristi on enia"},{"start":9.297,"end":10.608,"text":"Muse se sa 'rugbin na","marked":"Muse ṣe sá 'rúgbìn ná"},{"start":10.988,"end":12.512,"text":"K'o f'irin mule l'okan wa","marked":"K'ó f'irin múlẹ̀ l'ọkàn wa"},{"start":12.892,"end":14.386,"text":"K'o dagba ni ife.","marked":"K'ó dàgbà ní ìfẹ́."}],"end":14.386},{"key":"3","start":15.336,"lines":[{"start":15.336,"end":16.875,"text":"Ma je ki aniyan aiye","marked":"Má jẹ́ kí àníyàn aiye"},{"start":17.255,"end":18.36,"text":"Bi oro on ayo","marked":"Bí ọ̀rọ̀ ọ́n ayọ̀"},{"start":18.74,"end":20.602,"text":"Tabi ijona, on iji","marked":"Tàbí ìjọná, on ìjì"},{"start":20.982,"end":22.143,"text":"Run lrugbin orun.","marked":"Rùn lrúgbìn ọ̀run."},{"start":22.523,"end":23.094,"text":"Amin.","marked":"Àmín."}],"end":23.094}]}