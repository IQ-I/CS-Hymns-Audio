{"v":1,"coll":"y","num":857,"id":"hymn_857","title":"MASE beru 'wo okan mi","duration":87.844,"voices":{"male":{"file":"y-857-male.m4a","bytes":654980,"sha256":"a53ea7490bd2d01e2a04496c361abf57fae0194eb45a644cd8a95c73c8cec7f3","duration":87.9},"female":{"file":"y-857-female.m4a","bytes":671999,"sha256":"951b741a6c0cfe80a7fc8d8f9f1b380955237336450c21575095fd2f743a57dd","duration":87.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.195,"text":"MASE beru 'wo okan mi","marked":"Masẹ̀ bẹ̀rù 'wò ọkàn mi"},{"start":2.575,"end":3.869,"text":"Eleda mi ni nma foya","marked":"Ẹlẹ́dàá mi ní ńmá fòyà"},{"start":4.249,"end":5.472,"text":"Oluwa pe mi l'oruko","marked":"Olúwa pè mí l'orúkọ"},{"start":5.852,"end":7.575,"text":"O ndabobo, ko si jinna","marked":"Ó ndabobo, kò sì jinná"},{"start":7.955,"end":9.595,"text":"Eje Re ti s'etu fun mi","marked":"Ẹ̀jẹ̀ Rẹ ti s'etù fún mi"},{"start":9.975,"end":11.997,"text":"O nfe, O si nto mi sibe.","marked":"Ó ńfẹ́, Ó sì ńtọ́ mi síbẹ̀."}],"end":11.997},{"key":"2","start":12.947,"lines":[{"start":12.947,"end":14.328,"text":"'Gba mo nkoja larin ibu","marked":"'Gbà mo ńkọjá lárin ìbú"},{"start":14.708,"end":16.276,"text":"Mo f'igbagbo toro 'ranwo","marked":"Mo f'ìgbàgbọ́́ tọ́rọ́ 'ránwọ́"},{"start":16.656,"end":18.12,"text":"Igbi si duro l'okere","marked":"Ìgbì sì dúró l'òkèrè"},{"start":18.5,"end":19.895,"text":"Won bi kuro Ii ori mi","marked":"Wọ́n bí kúrò Ii orí mi"},{"start":20.275,"end":21.585,"text":"Emi ko beru ipa won","marked":"Èmi kò bẹ̀rù ipa wọn"},{"start":21.965,"end":23.515,"text":"Ko si ewu, Olorun mbe.","marked":"Kò sí ewu, Ọlọ́run ḿbẹ."}],"end":23.515},{"key":"3","start":24.465,"lines":[{"start":24.465,"end":25.986,"text":"Mo yi oju igbagbo s'i","marked":"Mo yí ojú ìgbàgbọ́́ s'i"},{"start":26.366,"end":27.935,"text":"Mo ntesiwaju larin 'na","marked":"Mo ntesiwaju lárin 'na"},{"start":28.315,"end":30.035,"text":"Ina gbagbe lati jo mi","marked":"Iná gbàgbé láti jó mi"},{"start":30.415,"end":31.779,"text":"Owo ina njo yi mi ka","marked":"Owó iná njo yí mi ká"},{"start":32.159,"end":33.564,"text":"Mo jewo agbar'ami na","marked":"Mo jẹ́wọ́ agbár'àmì ná"},{"start":33.944,"end":35.402,"text":"Mo ke pe\" Temi ni Jesu.","marked":"Mo ké pe Tèmi ni Jésù."}],"end":35.402},{"key":"4","start":36.352,"lines":[{"start":36.352,"end":37.866,"text":"Olugbala, duro ti mi","marked":"Olùgbàlà, dúró tì mí"},{"start":38.246,"end":39.54,"text":"Dabobo mi nigba 'danwo","marked":"Dábòbò mi nígbà 'dánwò"},{"start":39.92,"end":41.407,"text":"Pa mi mo ni ikawo Re","marked":"Pa mí mọ́ ní ìkáwọ́ Rẹ"},{"start":41.787,"end":43.212,"text":"F'agbara 'gbala han n'nu mi","marked":"F'agbára 'gbàlà hàn ń'nú mi"},{"start":43.592,"end":45.075,"text":"Ki apa Re je abo mi","marked":"Kí apá Rẹ jẹ́ àbọ̀ mi"},{"start":45.455,"end":46.794,"text":"Ko s'ohun le ja mi kuro.","marked":"Kò s'óhun lè já mi kúrò."}],"end":46.794},{"key":"5","start":47.744,"lines":[{"start":47.744,"end":50.084,"text":"B'O si ti pe mi pe ki nwa","marked":"B'ó sì ti pè mí pé kí ńwá"},{"start":50.464,"end":52.166,"text":"Wo Olore ti ngba ni la","marked":"Wo Ọlọ́rẹ́ ti ńgbá ni là"},{"start":52.546,"end":54.496,"text":"Un o rin lori okun ti nja","marked":"Un ò rìn lórí òkun ti ńjà"},{"start":54.876,"end":56.375,"text":"Igbi yo gbe ese mi ro","marked":"Ìgbì yó gbé ẹsẹ̀ mi ró"},{"start":56.755,"end":58.102,"text":"Nki yo beru isan na","marked":"Nkì yó bẹ̀rù iṣan ná"},{"start":58.482,"end":59.992,"text":"Bi o ti wu ki o le to.","marked":"Bí ó ti wù kí ó le tó."}],"end":59.992},{"key":"6","start":60.942,"lines":[{"start":60.942,"end":62.587,"text":"Gbat'okunkun b'oju orun","marked":"Gbat'òkùnkùn b'ojú ọ̀run"},{"start":62.967,"end":64.318,"text":"T'igbi 'banuje yi mi ka","marked":"T'igbì 'banújẹ́ yí mi ká"},{"start":64.698,"end":66.288,"text":"T'iji ibinu ru soke","marked":"T'íjí ìbínú ru sókè"},{"start":66.668,"end":67.946,"text":"To fere bori okan mi","marked":"Tó fẹ́rẹ̀ borí ọkàn mi"},{"start":68.326,"end":69.955,"text":"Emi mi yo ri dake je","marked":"Ẹ̀mí mi yó rí dákẹ́ jẹ́"},{"start":70.335,"end":72.489,"text":"Y'o gb'ohun jeje pe, 'simi.","marked":"Y'ó gb'óhùn jẹ́jẹ́ pé, 'simi."}],"end":72.489},{"key":"7","start":73.439,"lines":[{"start":73.439,"end":74.719,"text":"Bi mo wa n'nu eru 'ponju","marked":"Bí mo wá ń'nú ẹrù 'pọ́njú"},{"start":75.099,"end":76.962,"text":"Laisewu un o sete iku","marked":"Láìséwu ún ó ṣètẹ ikú"},{"start":77.342,"end":78.734,"text":"B'ese doju ija ko mi","marked":"B'ẹsẹ̀ dojú ìjà kọ mí"},{"start":79.114,"end":80.679,"text":"Ti esu gbe ogun ti mi","marked":"Ti èṣù gbé ogún tì mí"},{"start":81.059,"end":83.601,"text":"B'igbo Mose, un o ma gberu","marked":"B'ígbọ́ Mósè, un ó ma gbèrú"},{"start":83.981,"end":85.371,"text":"Ina ki o pa mi lara.","marked":"Iná kí ó pa mí lára."},{"start":85.751,"end":86.294,"text":"Amin.","marked":"Àmín."}],"end":86.294}]}