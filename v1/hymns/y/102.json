{"v":1,"coll":"y","num":102,"id":"hymn_102","title":"E YO loni pe l'ohun kan","duration":51.3,"voices":{"male":{"file":"y-102-male.m4a","bytes":379061,"sha256":"f72793a68d1c4dbd15265ccfd6bc31607c31e8967b9f08a6d80899b7be36aedb","duration":51.4},"female":{"file":"y-102-female.m4a","bytes":392086,"sha256":"6fe139e031c762dc1f022e35e4b78a183573cfdddd33aca9e754df33b786ae46","duration":51.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.835,"text":"E YO loni pe l'ohun kan","marked":"Ẹ Yọ̀ lọ́ni pé l'ohun kan"},{"start":2.215,"end":3.524,"text":"E korin igbega soke","marked":"Ẹ kọrin ìgbéga sókè"},{"start":3.904,"end":5.653,"text":"E yo, eyin Oluwa wa","marked":"Ẹ yọ̀, ẹ̀yin Olúwa wa"},{"start":6.033,"end":7.264,"text":"T'apa Re mu igbala wa","marked":"T'apá Rẹ mú ìgbàlà wá"},{"start":7.644,"end":8.813,"text":"Ise Ife npokiki","marked":"Iṣẹ́ Ìfẹ́ ńpòkìkí"},{"start":9.193,"end":10.547,"text":"Titobi oruko Re","marked":"Títóbi orúkọ Rẹ"},{"start":10.927,"end":12.055,"text":"Olorun kan laelae","marked":"Ọlọ́run kan láéláé"},{"start":12.435,"end":13.564,"text":"To ti f'anu Re han","marked":"Tó ti f'ánú Rẹ hàn"},{"start":13.944,"end":15.297,"text":"K'eniyan mimo Re juba Re.","marked":"K'ènìyàn mímọ́́ Rẹ júbà Rẹ."}],"end":15.297},{"key":"2","start":16.247,"lines":[{"start":16.247,"end":18.674,"text":"Gba banuje de, a kepe","marked":"Gba bànújẹ́ dé, a kepe"},{"start":19.054,"end":20.581,"text":"O si gbo gbogbo 'aroye wa","marked":"Ó sì gbọ́ gbogbo 'àròyé wa"},{"start":20.961,"end":22.44,"text":"Gbekele boti wu kori","marked":"Gbẹ́kẹ̀lé bọtí wú kórí"},{"start":22.82,"end":24.287,"text":"Agbeniro ni ife Re","marked":"Agbẹnirò ni ìfẹ́ Rẹ"},{"start":24.667,"end":25.695,"text":"Orin iyin 'segun","marked":"Orin ìyìn 'ṣẹ́gun"},{"start":26.075,"end":27.442,"text":"Lokan wa y'o ko si","marked":"Lọ́kàn wa y'ó kò sí"},{"start":27.822,"end":29.186,"text":"Gbogb'ohun y'o ko pe","marked":"Gbogb'ohun y'ó kọ̀ pé"},{"start":29.566,"end":30.638,"text":"'E yin Olorun wa","marked":"'Ẹ yin Ọlọ́run wa"},{"start":31.018,"end":32.53,"text":"K'eniyan mimo re juba Re.","marked":"K'ènìyàn mímọ́́ rẹ̀ júbà Rẹ̀."}],"end":32.53},{"key":"3","start":33.48,"lines":[{"start":33.48,"end":35.393,"text":"E yo, loni pe l'ohun kan","marked":"Ẹ yọ̀, lọ́ni pé l'ohun kan"},{"start":35.773,"end":37.026,"text":"E korin igbega soke","marked":"Ẹ kọrin ìgbéga sókè"},{"start":37.406,"end":39.093,"text":"E yo, eyin Oluwa wa","marked":"Ẹ yọ̀, ẹ̀yin Olúwa wa"},{"start":39.473,"end":40.855,"text":"T'apa Re mu igbala wa","marked":"T'apá Rẹ mú ìgbàlà wá"},{"start":41.235,"end":42.51,"text":"Ise Ife npokiki","marked":"Iṣẹ́ Ìfẹ́ ńpòkìkí"},{"start":42.89,"end":44.066,"text":"Totibi oruko Re","marked":"Totibi orúkọ Rẹ"},{"start":44.446,"end":45.634,"text":"Olorun kan laelae","marked":"Ọlọ́run kan láéláé"},{"start":46.014,"end":47.05,"text":"To ti f'anu Re han","marked":"Tó ti f'ánú Rẹ hàn"},{"start":47.43,"end":48.777,"text":"K'eniyan mimo Re juba re.","marked":"K'ènìyàn mímọ́́ Rẹ júbà rẹ."},{"start":49.157,"end":49.751,"text":"Amin.","marked":"Àmín."}],"end":49.751}]}