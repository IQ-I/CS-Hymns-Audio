{"v":1,"coll":"y","num":859,"id":"hymn_859","title":"OLORUN, 'ranwo eni Re","duration":31.875,"voices":{"male":{"file":"y-859-male.m4a","bytes":224400,"sha256":"1e7fe2d6fc45cead95a4f93f1f88f316f0401d59d58cb23a30ebca3520d8f1b2","duration":31.9},"female":{"file":"y-859-female.m4a","bytes":232816,"sha256":"b42950455c0d981b36092dde214edd4d6111b1bba4ec0a83d5b81c45ab7039b7","duration":31.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.819,"text":"OLORUN, 'ranwo eni Re","marked":"Ọlọ́run, 'ránwọ́ ẹni Rẹ"},{"start":2.199,"end":3.4,"text":"Reti wa n'igba bi","marked":"Retí wà n'ígbà bí"},{"start":3.78,"end":5.363,"text":"A gba 'Wo Eni Airi gbo","marked":"A gba 'Wo Ẹni Àìrí gbọ́"},{"start":5.743,"end":6.883,"text":"Awa nwa O sibe.","marked":"Àwa ńwá Ó síbẹ̀."}],"end":6.883},{"key":"2","start":7.833,"lines":[{"start":7.833,"end":9.3,"text":"Ese ti awon elese","marked":"Ẹ̀ṣẹ̀ ti àwọn ẹlẹ́ṣẹ̀"},{"start":9.68,"end":10.671,"text":"Nfojudi ipa Re","marked":"Nfojúdi ipa Rẹ"},{"start":11.051,"end":12.425,"text":"Ti won si nhale b'enipe","marked":"Tí wọ́n sì ńhàlẹ̀ b'ẹnipè"},{"start":12.805,"end":14.299,"text":"'Wo ko ri ese won.","marked":"'Wo kò rí ẹsẹ̀ wọn."}],"end":14.299},{"key":"3","start":15.249,"lines":[{"start":15.249,"end":16.571,"text":"Oluwa, dide k'o gba wa","marked":"Olúwa, dídé k'ó gbà wá"},{"start":16.951,"end":18.22,"text":"A m'oran wa t'O wa","marked":"A m'ọ̀ràn wa t'Ó wà"},{"start":18.6,"end":20.289,"text":"F'ododo at'ipa joba","marked":"F'òdodo àt'ipá jọba"},{"start":20.669,"end":21.83,"text":"Wo nikan Ii Oba.","marked":"Wo nìkan Ii Ọba."}],"end":21.83},{"key":"4","start":22.78,"lines":[{"start":22.78,"end":24.079,"text":"Iwo mo gbogbo ife wa","marked":"Ìwọ mọ gbogbo ìfẹ́ wa"},{"start":24.459,"end":25.685,"text":"'Ranwo Re wa n'tosi","marked":"'Ráńwọ́ Rẹ wá ń'tòsí"},{"start":26.065,"end":27.425,"text":"Pese okan wa f'adura","marked":"Pèsè ọkàn wa f'àdúrà"},{"start":27.805,"end":29.269,"text":"Si gba adura wa.","marked":"Sì gba àdúrà wa."},{"start":29.649,"end":30.325,"text":"Amin.","marked":"Àmín."}],"end":30.325}]}