{"v":1,"coll":"y","num":401,"id":"hymn_401","title":"EMI Mimo, mi s'okan wa","duration":31.432,"voices":{"male":{"file":"y-401-male.m4a","bytes":212145,"sha256":"b8018aaa384d10826d034ba10e163ce97109ce03a56401b6a71773cf64f2587c","duration":31.5},"female":{"file":"y-401-female.m4a","bytes":223987,"sha256":"7531020d666860bcd06939619c69ba7d9b895cc82c2a85897f3a57545a7cd147","duration":31.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.133,"text":"EMI Mimo, mi s'okan wa,","marked":"Ẹ̀mí Mímọ́́, mí s'ọkàn wa"},{"start":2.513,"end":3.581,"text":"K'a mo agbara Re","marked":"K'á mọ agbára Rẹ"},{"start":3.961,"end":5.36,"text":"Orisun emi 'sotele","marked":"Orísun ẹ̀mí 'sòtẹ́lẹ̀"},{"start":5.74,"end":6.949,"text":"T'imole at'ife.","marked":"T'ìmọ́lẹ̀̀ àt'ìfẹ́."}],"end":6.949},{"key":"2","start":7.899,"lines":[{"start":7.899,"end":9.464,"text":"Emi Mimo, l'agbara Re","marked":"Ẹ̀mí Mímọ́́, l'ágbára Rẹ"},{"start":9.844,"end":10.967,"text":"L'awon woli sise","marked":"L'áwọn wòlí ṣiṣẹ́"},{"start":11.347,"end":12.779,"text":"lwo l'o nfi oto han wa","marked":"lwo l'ó ńfi ọ̀tọ̀ hàn wá"},{"start":13.159,"end":14.293,"text":"Ninu iwe mimo.","marked":"Nínú ìwé mímọ́́."}],"end":14.293},{"key":"3","start":15.243,"lines":[{"start":15.243,"end":17.549,"text":"Adaba orun, na 'ye Re","marked":"Àdàbà ọ̀run, na 'yé Rẹ"},{"start":17.929,"end":19.144,"text":"Bo okun eda wa","marked":"Bó okùn ẹ̀dá wá"},{"start":19.524,"end":20.829,"text":"Jeki mole Re tan sori","marked":"Jẹki mọ́lẹ̀ Rẹ̀ tán sórí"},{"start":21.209,"end":22.307,"text":"Emi aisoto wa.","marked":"Ẹ̀mí àìṣòtò wa."}],"end":22.307},{"key":"4","start":23.257,"lines":[{"start":23.257,"end":24.353,"text":"A o mo Olorun daju","marked":"A ò mọ Ọlọ́run dájú"},{"start":24.733,"end":26.01,"text":"B'lwo ba mbe n'nu wa","marked":"B'lwọ bá ḿbẹ ń'nú wa"},{"start":26.39,"end":27.622,"text":"A o mo 'jinle ife mimo","marked":"A ò mọ 'jinlẹ̀ ìfẹ́ mímọ́́"},{"start":28.002,"end":29.058,"text":"Pelu awon Tire.","marked":"Pẹ̀lú àwọn Tírè."},{"start":29.438,"end":29.882,"text":"Amin.","marked":"Àmín."}],"end":29.882}]}