{"v":1,"coll":"y","num":225,"id":"hymn_225","title":"ODUN miran ti koja","duration":47.174,"voices":{"male":{"file":"y-225-male.m4a","bytes":345020,"sha256":"f9d2e95bb2ca0de8e8d86aaac0ed49f8080afeb9fa919467467063eb7274ede6","duration":47.2},"female":{"file":"y-225-female.m4a","bytes":357743,"sha256":"31eb8eeadbffe09e45a8dfdb58f3e7959d7c9fb6c46cd104d62f883043896394","duration":47.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.497,"text":"ODUN miran ti koja","marked":"Ọdún miran ti kọjá"},{"start":1.877,"end":3.179,"text":"Wawa l'akoko na lo","marked":"Wàwá l'àkókò ná lọ"},{"start":3.559,"end":4.798,"text":"Nini eyit'a wa yi","marked":"Níní èyít'á wá yí"},{"start":5.178,"end":6.579,"text":"Yio s'arimo opo","marked":"Yío s'àrímọ ọ̀pọ̀"},{"start":6.959,"end":8.197,"text":"Anu l'o fi da wa si","marked":"Ànú l'ó fi dá wa sí"},{"start":8.577,"end":9.91,"text":"A ha lo anu na bi?","marked":"A ha lo ànú ná bí?"},{"start":10.29,"end":11.564,"text":"K'a bi 'ra wa ba se tan?","marked":"K'á bí 'ra wa bá ṣe tán?"},{"start":11.944,"end":13.474,"text":"B'a o pe wa l'odun yi.","marked":"B'á ò pè wá l'ọdún yí."}],"end":13.474},{"key":"2","start":14.424,"lines":[{"start":14.424,"end":15.586,"text":"Aiye bi ibi ija","marked":"Aiye bí ibi ìjà"},{"start":15.966,"end":17.232,"text":"Egbegberun l'o nsubu","marked":"Ẹgbẹgbẹ̀rún l'ó ńṣubú"},{"start":17.612,"end":19.354,"text":"Ofa iku t'o si nfo","marked":"Ọfà ikú t'ó sì ńfọ́"},{"start":19.734,"end":20.965,"text":"A le ran s'emi b'iwo","marked":"A lè ran s'èmí b'íwò"},{"start":21.345,"end":23.406,"text":"Nigb' a nwasu t'a si ngbo","marked":"Nígb' a ńwàsù t'á sì ńgbọ́"},{"start":23.786,"end":25.596,"text":"Oluwa, jek'a saro","marked":"Olúwa, jẹ́k'á ṣàrò"},{"start":25.976,"end":27.248,"text":"P'aiyeraiye sunmole","marked":"P'aiyérayé súnmọ́lẹ̀"},{"start":27.628,"end":29.034,"text":"A nduro l'eti bebe.","marked":"A ńdúró l'etí bèbè."}],"end":29.034},{"key":"3","start":29.984,"lines":[{"start":29.984,"end":31.307,"text":"B'a gba wa lowo ese","marked":"B'á gbà wá lọ́wọ́ ẹsẹ̀"},{"start":31.687,"end":32.931,"text":"Nipa ore-ofe Re","marked":"Nípa ọrẹ-ọ̀fẹ́ Rẹ"},{"start":33.311,"end":35.321,"text":"Nje 'ma bo' n' ipe o je","marked":"Ǹjẹ́ 'má bó' n' ìpè ò jẹ́"},{"start":35.701,"end":37.548,"text":"K'a le lo, k'a r'oju Re","marked":"K'á lè lọ, k'á r'ojú Rẹ̀"},{"start":37.928,"end":39.172,"text":"F'enia Re l'aiye yi","marked":"F'enia Rẹ l'áiye yi"},{"start":39.552,"end":40.937,"text":"K'anu wa l'odun titun","marked":"K'ánu wa l'ọdún titun"},{"start":41.317,"end":42.891,"text":"Odun t'o l'ayo ju yi","marked":"Ọdún t'ó l'áyò jù yí"},{"start":43.271,"end":44.709,"text":"L'eyi t'o mu won de 'le.","marked":"L'èyí t'ó mú wọn dé 'lé."},{"start":45.089,"end":45.624,"text":"Amin.","marked":"Àmín."}],"end":45.624}]}