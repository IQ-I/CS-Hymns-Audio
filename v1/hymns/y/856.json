{"v":1,"coll":"y","num":856,"id":"hymn_856","title":"'GBATI 'danwo yi mi ka","duration":44.226,"voices":{"male":{"file":"y-856-male.m4a","bytes":316579,"sha256":"63a927815ff33029d3c80fdcdc0e0765a9cb15f3f285a15be30a64995f7a623a","duration":44.3},"female":{"file":"y-856-female.m4a","bytes":334882,"sha256":"8f492c81c0aa146f533509f3b5e8c7332b06dfefdf39eea094dcdac2cd2319a0","duration":44.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.574,"text":"'GBATI 'danwo yi mi ka","marked":"'Gbàtì 'dánwò yí mi ká"},{"start":1.954,"end":3.37,"text":"Odo Krist' ni mo nlo","marked":"Ọ̀dọ́ Krist' ni mò ńlò"},{"start":3.75,"end":5.006,"text":"Ni okan aya Re ni","marked":"Ní ọkàn àyà Rẹ ni"},{"start":5.386,"end":6.325,"text":"Ibi isadi mi","marked":"Ibi ìsádi mi"},{"start":6.705,"end":8.109,"text":"Mo s'okan mi paya fun","marked":"Mo ṣ'ọkàn mi payá fún"},{"start":8.489,"end":9.542,"text":"O mo gbogb' edun mi","marked":"O mo gbogb' ẹ̀dùn mi"},{"start":9.922,"end":11.557,"text":"Bi mo ti nso nkan wonyi","marked":"Bí mo ti nso nkan wọ̀nyí"},{"start":11.937,"end":12.988,"text":"O m'edun mi kuro.","marked":"Ó m'ẹ̀dùn mi kúrò."}],"end":12.988},{"key":"2","start":13.938,"lines":[{"start":13.938,"end":15.192,"text":"'Gbati mo kun fun eru","marked":"'Gbàtì mo kún fún ẹ̀rù"},{"start":15.572,"end":16.819,"text":"Ti mo nsukun pere","marked":"Tí mo nsukun péré"},{"start":17.199,"end":18.422,"text":"O tan ibanuje mi","marked":"Ó tán ìbànújẹ́ mi"},{"start":18.802,"end":19.869,"text":"O le eru mi lo","marked":"Ó lé ẹrù mi lọ"},{"start":20.249,"end":22.142,"text":"O r'ewu t'o yi mi ka","marked":"Ó r'ewu t'ó yí mi ká"},{"start":22.522,"end":23.599,"text":"Ati ailera mi","marked":"Àti àìlera mi"},{"start":23.979,"end":25.196,"text":"O fun mi l'ohun ija","marked":"Ó fún mi l'óhun ìjà"},{"start":25.576,"end":26.717,"text":"Lati segun ese.","marked":"Láti ṣẹ́gun ẹ̀ṣẹ̀."}],"end":26.717},{"key":"3","start":27.667,"lines":[{"start":27.667,"end":29.367,"text":"L'odo Kristi ni un o lo","marked":"L'ọ́dọ̀ Kristi ni un ó lọ"},{"start":29.747,"end":31.085,"text":"Nibi t'o wu ko je","marked":"Níbi t'ó wù kó jẹ́"},{"start":31.465,"end":32.853,"text":"Un o sa ma wo oju Re","marked":"Un ò sá ma wo ojú Rẹ"},{"start":33.233,"end":34.459,"text":"O daju pe un o ri","marked":"Ó dájú pé un ò rí"},{"start":34.839,"end":36.369,"text":"'Gb'ayo tabi 'banuje","marked":"'Gb'ayo tàbí 'banújẹ́"},{"start":36.749,"end":37.959,"text":"Ohun to wu ko je","marked":"Ohun tó wù kó jẹ́"},{"start":38.339,"end":39.688,"text":"Odo Re sa ni un o lo","marked":"Ọ̀dọ̀ Rẹ̀ sà ni un ó lọ"},{"start":40.068,"end":41.804,"text":"Oun y'o o si to mi wa.","marked":"Òun y'ó ò sì tọ̀ mí wá."},{"start":42.184,"end":42.676,"text":"Amin.","marked":"Àmín."}],"end":42.676}]}