{"v":1,"coll":"y","num":12,"id":"hymn_12","title":"JESU, bukun wa k'a to lo","duration":65.768,"voices":{"male":{"file":"y-12-male.m4a","bytes":475919,"sha256":"54d94033d254caa1c862a57cff295bfd130553d49c27efffa5ce91aefe8ed622","duration":65.8},"female":{"file":"y-12-female.m4a","bytes":499287,"sha256":"53cb57318ddafa2279ac839f61940e660bb62d8ed4c1168523f9ff428a28c937","duration":65.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.361,"text":"JESU, bukun wa k'a to lo","marked":"Jésù, bùkún wa k'á tó lò"},{"start":2.741,"end":4.114,"text":"Gbin oro Re si okan wa;","marked":"Gbin ọ̀rọ̀ Rẹ sí ọkàn wa"},{"start":4.494,"end":6.208,"text":"K'o si mu k'ife gbigbona","marked":"K'ó sì mú k'ífẹ́ gbígbóná"},{"start":6.588,"end":7.801,"text":"Kun okan ilowowo wa,","marked":"Kún ọkàn ilowowo wa"},{"start":8.181,"end":9.756,"text":"Egbe:  Nigba iye at'iku wa","marked":"Nígbà iye àt'ikú wa"},{"start":10.136,"end":12.543,"text":"Jesu, jare se' mole wa.","marked":"Jésù, jàre sẹ́' mọ́lẹ̀ wa."}],"end":12.543},{"key":"2","start":13.493,"lines":[{"start":13.493,"end":15.793,"text":"Ile ti su, orunti wo,","marked":"Ilẹ̀ ti ṣú, ọ̀rúntì wọ̀"},{"start":16.173,"end":17.549,"text":"'Wo si ti siro iwa wa","marked":"'Wo sì ti ṣírò ìwà wa"},{"start":17.929,"end":19.6,"text":"Die n'isegun wa loni","marked":"Díẹ̀ ń'íṣègùn wa lónì"},{"start":19.98,"end":21.203,"text":"Isubu wa lo papoju","marked":"Ìṣubú wa ló pàpọ̀jù"},{"start":21.583,"end":23.122,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":23.122},{"key":"3","start":24.072,"lines":[{"start":24.072,"end":25.94,"text":"Jesu dariji wa: fun wa","marked":"Jésù dariji wa: fún wa"},{"start":26.32,"end":27.862,"text":"L'ayo ati eru mimo","marked":"L'ayo àti ẹrù mímọ́́"},{"start":28.242,"end":29.934,"text":"At'okan ti ko l'abawon","marked":"Àt'ọkàn tí kò l'àbàwọ́n"},{"start":30.314,"end":31.85,"text":"K'a ba le jo O l'ajotan:","marked":"K'á bá lè jó O l'ájọ̀tán"},{"start":32.23,"end":33.377,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":33.377},{"key":"4","start":34.327,"lines":[{"start":34.327,"end":35.75,"text":"Lala dun 'tor Iwo se ri","marked":"Lalá dùn 'tor Ìwọ ṣe rí"},{"start":36.13,"end":38.075,"text":"Aniyan fere, O se ri:","marked":"Àníyàn fèrè, Ó ṣe rí"},{"start":38.455,"end":40.089,"text":"Ma je k'a gbo t'ara nikan","marked":"Má jẹ k'á gbọ́ t'ára nìkan"},{"start":40.469,"end":41.931,"text":"K'a ma bo sinu idanwo,","marked":"K'á má bọ́ sínú ìdánwò"},{"start":42.311,"end":43.268,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":43.268},{"key":"5","start":44.218,"lines":[{"start":44.218,"end":45.531,"text":"A mbe O f'awon alaini,","marked":"A ḿbẹ̀ Ọ́ f'àwọn aláìní"},{"start":45.911,"end":47.821,"text":"F'elese at' awon t'a fe,","marked":"F'ẹ́lẹ́sẹ̀ àt' àwọn t'á fẹ́"},{"start":48.201,"end":49.449,"text":"Je ki anu Re mu wa yo,","marked":"Jẹ́ kí ãnú Rẹ mú wa yọ̀"},{"start":49.829,"end":51.924,"text":"'Wo Jesu, l'ohun gbogbo wa,","marked":"'Wò Jésù, l'ohun gbogbo wa"},{"start":52.304,"end":53.542,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":53.542},{"key":"6","start":54.492,"lines":[{"start":54.492,"end":56.215,"text":"Jesu, bukun wa, - ile su;","marked":"Jésù, bùkún wa, ilé ṣú"},{"start":56.595,"end":58.024,"text":"Tikalare wa ba wa gbe","marked":"Tikalare wa bá wa gbé"},{"start":58.404,"end":59.789,"text":"Angeli rere nso ile wa;","marked":"Áńgẹ́lì rere nso ilé wa"},{"start":60.169,"end":61.921,"text":"A tun f'ojo kan sunmo O","marked":"A tún f'ọjọ́ kan súnmọ́ O"},{"start":62.301,"end":63.333,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"},{"start":63.713,"end":64.219,"text":"Amin.","marked":"Àmín."}],"end":64.219}]}