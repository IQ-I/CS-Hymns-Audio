{"v":1,"coll":"y","num":217,"id":"hymn_217","title":"JESU loruko to gaju","duration":64.812,"voices":{"male":{"file":"y-217-male.m4a","bytes":465054,"sha256":"f66656138436fe601605543496b4cce9db69cfab23f2ab69dbddffb36ee7d0b2","duration":64.9},"female":{"file":"y-217-female.m4a","bytes":483504,"sha256":"4335fc9693f7f86bf7042a27060b021b0f16a558f6e617725bb9656a39458c27","duration":64.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.81,"text":"JESU loruko to gaju,","marked":"Jésù lorúkọ tó gajú"},{"start":2.19,"end":3.66,"text":"Laiye ati lorun;","marked":"Láìyẹ àti lọ́run"},{"start":4.04,"end":5.417,"text":"Awon Angeli wole fun,","marked":"Àwọn Áńgẹ́lì wọlé fún"},{"start":5.797,"end":6.806,"text":"Esu, beru o sa.","marked":"Èṣù, bẹ̀rù ò ṣá."}],"end":6.806},{"key":"CHORUS","start":7.756,"lines":[{"start":7.756,"end":10.218,"text":"Ha! ko s' ariyanjiyan mo,","marked":"Ha! kò s' àríyànjiyàn mọ́"},{"start":10.598,"end":11.966,"text":"Ipe miran ko si,","marked":"Ìpẹ́ miran kò sí"},{"start":12.346,"end":13.988,"text":"O daju wipe Jesu ku,","marked":"Ó dájú wípé Jésù kú"},{"start":14.368,"end":15.54,"text":"A ni f' emi elese.","marked":"A ní f' emi ẹlẹ́ṣẹ̀."}],"end":15.54},{"key":"2","start":16.49,"lines":[{"start":16.49,"end":18.176,"text":"Kerubu ati Serafu,","marked":"Kérúbù àti Séráfù"},{"start":18.556,"end":19.889,"text":"Nwon yi 'te Baba ka,","marked":"Nwọ̀n yí 'te Bàbá ká"},{"start":20.269,"end":21.646,"text":"Nigba gbogbo niwaju Re","marked":"Nígbà gbogbo níwájú Rẹ̀"},{"start":22.026,"end":23.056,"text":"Nwon nko orin iyin.","marked":"Nwọ̀n ńkọ orin ìyìn."}],"end":23.056},{"key":"3","start":24.006,"lines":[{"start":24.006,"end":25.204,"text":"Olugbala segun iku,","marked":"Olùgbàlà ṣẹ́gun ikú"},{"start":25.584,"end":26.649,"text":"ljoba Satan fo;","marked":"ljọba Sátán fò"},{"start":27.029,"end":28.711,"text":"Gbogho eda e bu sayo,","marked":"Gbọ̀ghọ̀ ẹ̀dá ẹ̀ bù sáyọ̀"},{"start":29.091,"end":30.352,"text":"Ka yin Baba logo.","marked":"Ká yin Bàbá lógo."}],"end":30.352},{"key":"4","start":31.302,"lines":[{"start":31.302,"end":32.837,"text":"Kerubu ati Serafu,","marked":"Kérúbù àti Séráfù"},{"start":33.217,"end":34.478,"text":"E feran ara yin;","marked":"Ẹ fẹ́ràn ara yín"},{"start":34.858,"end":36.552,"text":"lfe ni awon Angeli,","marked":"lfẹ́ ní àwọn Áńgẹ́lì"},{"start":36.932,"end":38.518,"text":"Fi nsin Baba loke.","marked":"Fi ńsin Bàbá lókè."}],"end":38.518},{"key":"5","start":39.468,"lines":[{"start":39.468,"end":41.498,"text":"Jesu, Olori Egbe wa,","marked":"Jésù, Olórí Ẹgbẹ́ wa"},{"start":41.878,"end":43.012,"text":"Bukun wa laiye wa;","marked":"Bùkún wa láìyé wa"},{"start":43.392,"end":44.661,"text":"Jowo pese fun aini wa,","marked":"Jọ̀wọ́ pèsè fún àìní wa"},{"start":45.041,"end":46.497,"text":"K' ebi ale ma pa wa.","marked":"K' ebi alẹ́ má pa wá."}],"end":46.497},{"key":"6","start":47.447,"lines":[{"start":47.447,"end":49.205,"text":"Jehovah-Jire Oba wa,","marked":"Jehovah-Jire Ọba wa"},{"start":49.585,"end":50.712,"text":"Iyin f' oruko Re;","marked":"Ìyìn f' orúkọ Rẹ"},{"start":51.092,"end":53.328,"text":"Ma jeki oso at'aje,","marked":"Má jẹkì ọ̀ṣọ́ àt'àjẹ́"},{"start":53.708,"end":55.042,"text":"Ri wa lojo aiye wa.","marked":"Rí wa lọ́jọ́ àìyé wa."}],"end":55.042},{"key":"7","start":55.992,"lines":[{"start":55.992,"end":58.4,"text":"Jesu, fo itegun esu,","marked":"Jésù, fọ ìtẹ́gun èṣù"},{"start":58.78,"end":59.88,"text":"Iwo l'Oba Ogo;","marked":"Ìwo l'Ọba Ògo"},{"start":60.26,"end":61.749,"text":"lyin ope ni fun Baba,","marked":"lyin ọpẹ́ ni fún Bàbá"},{"start":62.129,"end":63.262,"text":"Ni fun Metalokan.","marked":"Ní fún Mẹ́talọ́kan."}],"end":63.262}]}