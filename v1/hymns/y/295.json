{"v":1,"coll":"y","num":295,"id":"hymn_295","title":"ARA, ewa ba mi sofo","duration":62.352,"voices":{"male":{"file":"y-295-male.m4a","bytes":449913,"sha256":"dbc5b16691a2d395b83e82f53924bcade158082056cff8cc76299a75e2b76f66","duration":62.4},"female":{"file":"y-295-female.m4a","bytes":463405,"sha256":"116d0b71291554c59795d65fb906d871d405abe6261185b83c6c885a48d0df0f","duration":62.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.513,"text":"ARA, ewa ba mi sofo","marked":"Ara, ẹwà bá mi ṣòfò"},{"start":2.893,"end":4.225,"text":"E wa sodo Olugbala","marked":"Ẹ wá sọ́dọ̀ Olùgbàlà"},{"start":4.605,"end":7.09,"text":"Wa, e je k'a jumo sofo","marked":"Wà, ẹ jẹ́ k'á jùmọ̀ ṣòfò"},{"start":7.47,"end":8.989,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù ḿ'àgbélébùú."}],"end":8.989},{"key":"2","start":9.939,"lines":[{"start":9.939,"end":11.149,"text":"Ko ha s'omije loju wa","marked":"Kò ha s'omijé lójú wa"},{"start":11.529,"end":13.087,"text":"Bi awon Ju ti nfi sefe?","marked":"Bí àwọn Jù ti ńfi ṣẹ̀fẹ̀?"},{"start":13.467,"end":15.372,"text":"A! e wo, b'O ti teriba","marked":"A! ẹ wo, b'O ti tẹríbá"},{"start":15.752,"end":17.696,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù ḿ'àgbélébùú."}],"end":17.696},{"key":"3","start":18.646,"lines":[{"start":18.646,"end":20.536,"text":"Emeje l' Osoro ife","marked":"Ẹ̀méje l' Òṣòro ìfẹ́"},{"start":20.916,"end":22.389,"text":"Idake wakati meta","marked":"Ìdákẹ́ wákàtí mẹ́ta"},{"start":22.769,"end":24.385,"text":"L'o fi ntoro anu f'enia","marked":"L'ó fi ńtọrọ ãnu f'enia"},{"start":24.765,"end":26.37,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù ḿ'àgbélébùú."}],"end":26.37},{"key":"4","start":27.32,"lines":[{"start":27.32,"end":29.768,"text":"Bu s'ekun, okan lile mi!","marked":"Bù s'èkùn, ọ̀kan líle mi!"},{"start":30.148,"end":31.728,"text":"Ese at'igberaga re","marked":"Ẹsẹ̀ àt'ìgbéraga rẹ̀"},{"start":32.108,"end":33.746,"text":"L'o da Oluwa re l'ebi","marked":"L'ó dá Olúwa rẹ̀ l'ebi"},{"start":34.126,"end":35.877,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù ḿ'àgbélébùú."}],"end":35.877},{"key":"5","start":36.827,"lines":[{"start":36.827,"end":38.294,"text":"Wa duro ti agbelebu","marked":"Wá dúró ti àgbélébùú"},{"start":38.674,"end":40.236,"text":"K'eje ti njade niha Re","marked":"K'ẹ̀jẹ̀ ti ńjáde níhà Rẹ̀"},{"start":40.616,"end":42.051,"text":"Ba le ma san le o lori;","marked":"Bá lè má ṣàn lé ọ lórí"},{"start":42.431,"end":44.279,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù ḿ'àgbélébùú."}],"end":44.279},{"key":"6","start":45.229,"lines":[{"start":45.229,"end":46.754,"text":"lbanuje at'omije","marked":"lbanújẹ́ àt'omijé"},{"start":47.134,"end":48.485,"text":"Bere a ki o fi du o","marked":"Bẹ̀rẹ̀ á kí o fi dù ọ́"},{"start":48.865,"end":50.177,"text":"'Banuje l'o nf'ife re han","marked":"'Bànújẹ́ l'ó ńf'ìfẹ́ rẹ hàn"},{"start":50.557,"end":52.083,"text":"A kan Jesu m'agbelebu.","marked":"A kan Jésù ḿ'àgbélébùú."}],"end":52.083},{"key":"7","start":53.033,"lines":[{"start":53.033,"end":54.665,"text":"lfe Baba, ese eda,","marked":"lfẹ́ Bàbá, ẹsẹ̀ ẹ̀dá"},{"start":55.045,"end":56.419,"text":"Nihin l'a ri agabra re","marked":"Nihin l'á rí agabra rẹ"},{"start":56.799,"end":58.849,"text":"lfe l'o si di Asegun","marked":"lfẹ́ l'ó sì di Aṣẹ́gun"},{"start":59.229,"end":60.802,"text":"A kan Olufe wa mo 'gi.","marked":"A kan Olùfẹ́ wa mọ́ 'gi."}],"end":60.802}]}