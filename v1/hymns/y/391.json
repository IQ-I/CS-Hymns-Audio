{"v":1,"coll":"y","num":391,"id":"hymn_391","title":"BABA, Eleda wa,","duration":48.805,"voices":{"male":{"file":"y-391-male.m4a","bytes":360056,"sha256":"ea9e1a530041174e38ee72a76f65047e8a3611f3998069f96083a9997e54db0c","duration":48.9},"female":{"file":"y-391-female.m4a","bytes":367464,"sha256":"f8f54b4a0704ee70abeb7d16eacc1b147297ededee53d41d95a28ce37d31ed2b","duration":48.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.186,"text":"BABA, Eleda wa,","marked":"Bàbá, Ẹlẹ́dàá wa"},{"start":2.566,"end":3.525,"text":"Gbo orin iyin wa","marked":"Gbọ́ orin ìyìn wa"},{"start":3.905,"end":5.608,"text":"L'aiye ati l'orun","marked":"L'aiye àti l'orun"},{"start":5.988,"end":7.003,"text":"Baba Olubukun","marked":"Bàbá Olùbùkún"},{"start":7.383,"end":9.2,"text":"lwo l'ogo ati iyin","marked":"lwo l'ògo àti ìyìn"},{"start":9.58,"end":11.36,"text":"Ope, ati ola ye fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":11.36},{"key":"2","start":12.31,"lines":[{"start":12.31,"end":13.308,"text":"Wo Olorun Omo","marked":"Wo Ọlọ́run Ọmọ"},{"start":13.688,"end":15.002,"text":"T'O ku lati gba wa","marked":"T'ó kù láti gbà wá"},{"start":15.382,"end":16.687,"text":"Enit'O ji dide","marked":"Enit'Ó jí dìde"},{"start":17.067,"end":18.366,"text":"Ti O si goke lo","marked":"Tí Ó sì gòkè lọ"},{"start":18.746,"end":20.427,"text":"Iwo l'ogo, ati iyin","marked":"Ìwo l'ògo, àti ìyìn"},{"start":20.807,"end":22.605,"text":"Ope, ati ola ye fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":22.605},{"key":"3","start":23.555,"lines":[{"start":23.555,"end":24.582,"text":"Si O Emi Mimo","marked":"Sí Ọ Ẹ̀mí Mímọ́́"},{"start":24.962,"end":25.922,"text":"Ni a korin iyin","marked":"Ní a kọrin ìyìn"},{"start":26.302,"end":27.46,"text":"Iwo t'o f'imole","marked":"Ìwo t'ó f'ìmọ́lẹ̀̀"},{"start":27.84,"end":28.934,"text":"lye si okan wa","marked":"lye sí ọkàn wa"},{"start":29.314,"end":31.291,"text":"Iwo l'ogo, ati iyin","marked":"Ìwo l'ògo, àti ìyìn"},{"start":31.671,"end":33.555,"text":"Ope, ati ola ye fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."}],"end":33.555},{"key":"4","start":34.505,"lines":[{"start":34.505,"end":36.016,"text":"Mimo, Mimo, Mimo","marked":"Mímọ́́, Mímọ́́, Mímọ́́"},{"start":36.396,"end":37.566,"text":"N'iyin Metalokan","marked":"N'ìyìn Mẹ́talọ́kan"},{"start":37.946,"end":39.623,"text":"L'aiye ati l'orun","marked":"L'aiye àti l'orun"},{"start":40.003,"end":41.311,"text":"L'a o ma korin pe","marked":"L'á ò má kọrin pé"},{"start":41.691,"end":43.609,"text":"lwo l'ogo, ati iyin","marked":"lwo l'ògo, àti ìyìn"},{"start":43.989,"end":46.167,"text":"Ope, ati ola ye fun.","marked":"Ọpẹ́, àti ọlá yẹ fún."},{"start":46.547,"end":47.255,"text":"Amin.","marked":"Àmín."}],"end":47.255}]}