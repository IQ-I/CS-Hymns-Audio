{"v":1,"coll":"y","num":250,"id":"hymn_250","title":"JESU, jo ranti mi","duration":42.935,"voices":{"male":{"file":"y-250-male.m4a","bytes":306283,"sha256":"66ba11e8865082fae862d7da8ac4bdeb59b6a0bd22015d5ca75186cad4a877c2","duration":43.0},"female":{"file":"y-250-female.m4a","bytes":316046,"sha256":"2081d9d4cb62632cd4b213e63dbf723afeac847c939a50fe727f1c9d73ec7b14","duration":43.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.366,"text":"JESU, jo ranti mi","marked":"Jésù, jọ rántí mi"},{"start":2.746,"end":4.078,"text":"K'O si w'ese mi nu","marked":"K'ó sì w'ẹsẹ̀ mi nù"},{"start":4.458,"end":5.938,"text":"Gba mi low'ese 'binibi","marked":"Gbà mí lọ́w'ẹsẹ̀ 'bínibí"},{"start":6.318,"end":7.577,"text":"Si we okan mi mo.","marked":"Sì wé ọkàn mi mọ́."}],"end":7.577},{"key":"2","start":8.527,"lines":[{"start":8.527,"end":10.106,"text":"Jesu, jo ranti mi","marked":"Jésù, jọ rántí mi"},{"start":10.486,"end":12.078,"text":"Em' eni nilara","marked":"Em' ẹni nílara"},{"start":12.458,"end":14.122,"text":"Ki mse 'ranse t'o n'ife Re","marked":"Kí mse 'ránṣẹ́ t'ó ń'ìfẹ́ Rẹ"},{"start":14.502,"end":15.772,"text":"Ki m'to 'simi Re wo.","marked":"Kí m'tó 'simi Rẹ̀ wò."}],"end":15.772},{"key":"3","start":16.722,"lines":[{"start":16.722,"end":18.406,"text":"Jesu, jo ranti mi","marked":"Jésù, jọ rántí mi"},{"start":18.786,"end":20.083,"text":"Muse je ki nsako","marked":"Muse jẹ́ kí ńṣáko"},{"start":20.463,"end":22.162,"text":"N'nu damu on okun aiye","marked":"N'nu dámú ọ́n okùn aiye"},{"start":22.542,"end":23.769,"text":"F'ona orun han mi.","marked":"F'ọ̀nà ọ̀run hàn mí."}],"end":23.769},{"key":"4","start":24.719,"lines":[{"start":24.719,"end":26.648,"text":"Jesu, jo ranti mi,","marked":"Jésù, jọ rántí mi"},{"start":27.028,"end":28.305,"text":"Gba gbogbo re koja","marked":"Gba gbogbo ré kọjá"},{"start":28.685,"end":30.746,"text":"Ki nle r'ogo ainipekun","marked":"Kí ńlẹ̀ r'ògo àìnípẹ̀kun"},{"start":31.126,"end":32.292,"text":"Ki nsi le ba O yo.","marked":"Kí ńsì lè bá Ọ yọ̀."}],"end":32.292},{"key":"5","start":33.242,"lines":[{"start":33.242,"end":34.791,"text":"Jesu, jo ranti mi","marked":"Jésù, jọ rántí mi"},{"start":35.171,"end":36.383,"text":"Ki nle korin loke","marked":"Kí ńlẹ̀ kọrin lókè"},{"start":36.763,"end":38.482,"text":"Si baba, Emi ati Re","marked":"Sí bàbá, Èmi àti Rẹ̀"},{"start":38.862,"end":40.365,"text":"Orin 'yin at' ife.","marked":"Orin 'yín àt' ìfẹ́."},{"start":40.745,"end":41.385,"text":"Amin.","marked":"Àmín."}],"end":41.385}]}