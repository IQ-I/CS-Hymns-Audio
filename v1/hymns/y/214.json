{"v":1,"coll":"y","num":214,"id":"hymn_214","title":"E funpe na kikan","duration":40.85,"voices":{"male":{"file":"y-214-male.m4a","bytes":283999,"sha256":"198d909301045c08fbc6ebaadf7d40b04268317d9f3c5aabb16a2c11ac5deece","duration":40.9},"female":{"file":"y-214-female.m4a","bytes":295431,"sha256":"55087966d2f6411b25ff3ae2a4541dd8867b48dd2f6a40fa8bf1930513ad7c90","duration":40.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.686,"text":"E funpe na kikan,","marked":"Ẹ fúńpẹ́ ná kíkan"},{"start":2.066,"end":3.044,"text":"lpe ihinrere,","marked":"lpe ìhìnrere"},{"start":3.424,"end":4.701,"text":"K' odun jake jado,","marked":"K' ọdún jákè jado"},{"start":5.081,"end":6.286,"text":"L' eti gbogbo eda;","marked":"L' etí gbogbo ẹ̀dá"}],"end":6.286},{"key":"CHORUS","start":7.236,"lines":[{"start":7.236,"end":8.582,"text":"Odun idasile ti de;","marked":"Ọdún ìdásílẹ̀ ti dé"},{"start":8.962,"end":10.457,"text":"Pada elese e pada.","marked":"Padà ẹlẹ́ṣẹ̀ ẹ padà."}],"end":10.457},{"key":"2","start":11.407,"lines":[{"start":11.407,"end":12.868,"text":"Fun 'Pe t' Odagutan;","marked":"Fún 'Pe t' Odagutan"},{"start":13.248,"end":14.491,"text":"T' a ti pa s'etutu,","marked":"T' a ti pa s'etùtù"},{"start":14.871,"end":16.178,"text":"Jeki agbaiye mo,","marked":"Jẹki agbaiye mọ́"},{"start":16.558,"end":17.91,"text":"Agbara eje Re.","marked":"Agbára ẹ̀jẹ̀ Rẹ."}],"end":17.91},{"key":"3","start":18.86,"lines":[{"start":18.86,"end":20.096,"text":"Enyin eru ese,","marked":"Enyin ẹrú ẹ̀ṣẹ̀"},{"start":20.476,"end":21.702,"text":"E so 'ra nyin d' omo,","marked":"Ẹ sọ 'ra nyin d' omo"},{"start":22.082,"end":23.505,"text":"Lowo Kristi Jesu,","marked":"Lọ́wọ́ Kristi Jésù"},{"start":23.885,"end":25.197,"text":"Egb'Ominira nyin.","marked":"Egb'Òmìnira nyin."}],"end":25.197},{"key":"4","start":26.147,"lines":[{"start":26.147,"end":27.015,"text":"Olori Alufa,","marked":"Olórí Àlùfà"},{"start":27.395,"end":28.609,"text":"L'Olugbala ise;","marked":"L'Olùgbàlà iṣẹ́"},{"start":28.989,"end":30.001,"text":"O fi 'ra Re rubo","marked":"Ó fi 'ra Rẹ̀ rúbọ"},{"start":30.381,"end":31.644,"text":"Arunkun, aruda.","marked":"Àrùnkún, aruda."}],"end":31.644},{"key":"5","start":32.594,"lines":[{"start":32.594,"end":34.302,"text":"Okan alare, wa,","marked":"Ọkàn aláre, wa"},{"start":34.682,"end":36.013,"text":"Simi l'aya Jesu,","marked":"Sími l'áyà Jésù"},{"start":36.393,"end":37.241,"text":"Onirobinuje,","marked":"Oníròbìnújẹ́"},{"start":37.621,"end":39.3,"text":"Tujuka, si ma yo.","marked":"Tújúká, sì má yọ̀."}],"end":39.3}]}