{"v":1,"coll":"y","num":405,"id":"hymn_405","title":"BIBELI iwe aiyeraiye","duration":38.081,"voices":{"male":{"file":"y-405-male.m4a","bytes":261510,"sha256":"dfa72aa0319f85a893fa21fed4875c47ccd1b00c367a41b76cca0efb1b0a99a7","duration":38.1},"female":{"file":"y-405-female.m4a","bytes":267116,"sha256":"e68026c5af1d36a45efe1f1321b727dfa5d06cf2a8b4e34081431b1ef3c8496b","duration":38.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.525,"text":"BIBELI iwe aiyeraiye","marked":"Bíbélì ìwé aiyérayé"},{"start":1.905,"end":2.927,"text":"Tani le r'idi re?","marked":"Tani lẹ r'ìdì rẹ?"},{"start":3.307,"end":4.4,"text":"Tani Ie so idide re?","marked":"Tani lè sọ ìdìde rẹ?"},{"start":4.78,"end":5.817,"text":"Tani le m'opin re?","marked":"Tani lè m'òpin rẹ?"}],"end":5.817},{"key":"2","start":6.767,"lines":[{"start":6.767,"end":7.808,"text":"Asiri Olodumare","marked":"Àṣírí Olódùmarè"},{"start":8.188,"end":9.111,"text":"Iko Oba orun","marked":"Ìkọ́ Ọba ọ̀run"},{"start":9.491,"end":11.35,"text":"Ida t'o pa oro iku","marked":"Idà t'ó pa oró ikú"},{"start":11.73,"end":12.722,"text":"Aworan Olorun.","marked":"Àwòrán Ọlọ́run."}],"end":12.722},{"key":"3","start":13.672,"lines":[{"start":13.672,"end":15.473,"text":"Okan ni O larin opo","marked":"Ọ̀kan ni Ó lárin ọ̀pọ̀"},{"start":15.853,"end":16.908,"text":"Iwe aiye 'gbani","marked":"Ìwé aiye 'gbani"},{"start":17.288,"end":18.545,"text":"lwo l'o s'ona igbala","marked":"lwo l'ó s'ọ́nà ìgbàlà"},{"start":18.925,"end":20.212,"text":"Di mimo f'araiye.","marked":"Di mímọ́́ f'araiye."}],"end":20.212},{"key":"4","start":21.162,"lines":[{"start":21.162,"end":22.483,"text":"Isura ti Metalokan","marked":"Ìṣúra ti Mẹ́talọ́kan"},{"start":22.863,"end":24.184,"text":"Oba nla t'o gunwa","marked":"Ọba ńlá t'ó gúnwà"},{"start":24.564,"end":26.194,"text":"Jo, tumo ara Re fun mi","marked":"Jọ, túmọ̀ ara Rẹ fún mi"},{"start":26.574,"end":27.885,"text":"Ki m'ye siyemeji.","marked":"Kí m'ye ṣiyèméjì."}],"end":27.885},{"key":"5","start":28.835,"lines":[{"start":28.835,"end":30.453,"text":"Ki m'si o p pelu adura","marked":"Kí ḿ'sí ó p pẹ̀lú àdúrà"},{"start":30.833,"end":32.128,"text":"Ki 'm'k' eko ninu re","marked":"Kí 'm'k' ẹ̀kọ́ nínú rẹ̀"},{"start":32.508,"end":33.813,"text":"Iwo lwe Aiyeraiye,","marked":"Ìwọ lwe Aiyérayé"},{"start":34.193,"end":35.523,"text":"F'ife Jesu han mi.","marked":"F'ìfẹ́ Jésù hàn mí."},{"start":35.903,"end":36.532,"text":"Amin.","marked":"Àmín."}],"end":36.532}]}