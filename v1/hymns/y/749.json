{"v":1,"coll":"y","num":749,"id":"hymn_749","title":"'RANSE Olorun seun","duration":43.646,"voices":{"male":{"file":"y-749-male.m4a","bytes":323128,"sha256":"e1fc9297235517b221d5ce5c1969874e7e1e492df0eaefc318e37a2c1c9d3086","duration":43.7},"female":{"file":"y-749-female.m4a","bytes":330484,"sha256":"14a9a8e7a9c9272d1699def6708c0510c252f466017b7328c908c97d2311985c","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.343,"text":"'RANSE Olorun seun","marked":"'Ránṣẹ́ Ọlọ́run ṣeun"},{"start":1.723,"end":2.757,"text":"Simi n'nu lala re","marked":"Símì ń'nú lálà rẹ̀"},{"start":3.137,"end":4.985,"text":"Iwo ti ja, o si segun","marked":"Ìwọ ti jà, o sì ṣẹ́gun"},{"start":5.365,"end":6.61,"text":"Bo s'ayo Baba re","marked":"Bó s'àyò Bàbá rẹ"},{"start":6.99,"end":8.036,"text":"Ohun na de loru","marked":"Ohun ná dé lóru"},{"start":8.416,"end":9.589,"text":"O dide lati gbo","marked":"Ó dìde láti gbọ́"},{"start":9.969,"end":11.21,"text":"Ofa iku si wo l'ara","marked":"Ọfà ikú sì wọ l'ára"},{"start":11.59,"end":12.848,"text":"O subu ko beru.","marked":"Ó ṣubú kó bẹ̀rù."}],"end":12.848},{"key":"2","start":13.798,"lines":[{"start":13.798,"end":14.986,"text":"Igbe ta loganjo","marked":"Ìgbẹ́ ta lọ́gànjọ́"},{"start":15.366,"end":16.317,"text":"Pade Olorun re","marked":"Pàdé Ọlọ́run rẹ"},{"start":16.697,"end":18.328,"text":"O ji,o ri Balogun re","marked":"Ó jí,ó rí Balógun rẹ̀"},{"start":18.708,"end":20.368,"text":"N'nu adura on 'gbagbo","marked":"N'nu àdúrà on 'gbàgbọ́"},{"start":20.748,"end":21.791,"text":"Okan re nde wiri","marked":"Ọkàn rẹ̀ ńdẹ̀ wírí"},{"start":22.171,"end":23.216,"text":"O bo amo sile","marked":"Ó bọ́ amọ̀ sílẹ̀"},{"start":23.596,"end":25.373,"text":"Gbat'ile mo ago ara","marked":"Gbat'ilẹ̀ mọ́ àgọ́ ara"},{"start":25.753,"end":27.242,"text":"Si sun sile l'oku.","marked":"Sì sùn sílẹ̀ l'òkú."}],"end":27.242},{"key":"3","start":28.192,"lines":[{"start":28.192,"end":29.263,"text":"Rora iku koja","marked":"Rọra ikú kọjá"},{"start":29.643,"end":30.663,"text":"Lala at'ise tan","marked":"Lalá àt'iṣẹ́ tán"},{"start":31.043,"end":32.404,"text":"Ojo ogun jaja pari","marked":"Ọjọ́ ogun jàjà parí"},{"start":32.784,"end":33.819,"text":"Okan re r'alafia","marked":"Ọkàn rẹ r'àlàáfíà"},{"start":34.199,"end":36.118,"text":"Omo-ogun Krist' o seun!","marked":"Ọmọ-ogun Krist' ò ṣeun!"},{"start":36.498,"end":37.614,"text":"Ma korin ayo sa!","marked":"Má kọrin ayọ̀ ṣá!"},{"start":37.994,"end":39.346,"text":"Simi lodo Olugbala","marked":"Sími lọ́dọ̀ Olùgbàlà"},{"start":39.726,"end":41.155,"text":"Simi titi aiye.","marked":"Sími títí aiye."},{"start":41.535,"end":42.096,"text":"Amin.","marked":"Àmín."}],"end":42.096}]}