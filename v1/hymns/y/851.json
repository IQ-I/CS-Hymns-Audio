{"v":1,"coll":"y","num":851,"id":"hymn_851","title":"A dupe lowo Oluwa","duration":103.792,"voices":{"male":{"file":"y-851-male.m4a","bytes":770291,"sha256":"8ce44da7cf2bbf6ab72ebbb73dcdcc906056a2d82ba12986831dfbf5ca5af43a","duration":103.8},"female":{"file":"y-851-female.m4a","bytes":797170,"sha256":"35ac83e9974a67fec014ab3159f97d189169de2d3e089c838cc2ee8852009b7b","duration":103.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.679,"text":"A dupe lowo Oluwa","marked":"A dúpẹ́ lọ́wọ́ Olúwa"},{"start":2.059,"end":3.373,"text":"To da wa si d'oni","marked":"Tó dá wa sí d'òní"},{"start":3.753,"end":5.143,"text":"Ti ko f'okan adaba Re","marked":"Tí kò f'ọkàn àdàbà Rẹ"},{"start":5.523,"end":6.616,"text":"Le eranko lowo","marked":"Lé ẹranko lọ́wọ́"},{"start":6.996,"end":8.616,"text":"Iku ati Esu gbogun,","marked":"Ikú àti Èṣù gbógun"},{"start":8.996,"end":10.36,"text":"Sibe ko ta wa nu","marked":"Síbẹ̀ kò ta wá nù"},{"start":10.74,"end":12.115,"text":"Ogo f'Oba Mimo julo","marked":"Ògo f'Ọba Mímọ́́ jùlọ"},{"start":12.495,"end":13.551,"text":"Kabiyesi Oba.","marked":"Kàbìyèsí Ọba."}],"end":13.551},{"key":"2","start":14.501,"lines":[{"start":14.501,"end":15.64,"text":"Melomelo lore, Re","marked":"Mélòmélò lọ̀rẹ́, Rẹ"},{"start":16.02,"end":16.99,"text":"Oba awon Oba","marked":"Ọba àwọn Ọba"},{"start":17.37,"end":18.983,"text":"Ti pamo ati iso Re,","marked":"Ti pamọ́ àti ìsọ̀ Rẹ"},{"start":19.363,"end":20.494,"text":"Tabi lsegun ota","marked":"Tàbí lṣẹ́gun ọ̀tá"},{"start":20.874,"end":22.528,"text":"Loju ala, loju aiye,","marked":"Lójú àlá, lójú aiye"},{"start":22.908,"end":23.97,"text":"Tabi ti pese Re","marked":"Tàbí ti pèsè Rẹ̀"},{"start":24.35,"end":25.702,"text":"Iwosan lona iyanu,","marked":"Ìwòsàn lọ́nà ìyanu"},{"start":26.082,"end":27.191,"text":"A dupe Oluwa.","marked":"A dúpẹ́ Olúwa."}],"end":27.191},{"key":"3","start":28.141,"lines":[{"start":28.141,"end":29.331,"text":"Owo wa ko to dupe,","marked":"Ọwọ́ wa kò tó dúpẹ́"},{"start":29.711,"end":30.84,"text":"Aso ko to dupe","marked":"Aṣọ kó tó dúpẹ́"},{"start":31.22,"end":33.003,"text":"Ko s'ohun ta le fi dupe","marked":"Kò s'óhun ta lè fi dúpẹ́"},{"start":33.383,"end":34.615,"text":"Bikose ohun wa","marked":"Bíkọ́ṣẹ́ ọ̀hún wà"},{"start":34.995,"end":36.534,"text":"Ka f'okan wa fun Kristi","marked":"Ká f'ọkàn wa fún Kristi"},{"start":36.914,"end":38.314,"text":"Lati aiye yi lo","marked":"Láti aiye yí lọ"},{"start":38.694,"end":40.29,"text":"Ka yo orun le je ti wa,","marked":"Ká yọ ọ̀run lè jẹ́ tì wá"},{"start":40.67,"end":42.06,"text":"Ti Kristi ti seleri.","marked":"Tí Kristi ti ṣèlérí."}],"end":42.06},{"key":"4","start":43.01,"lines":[{"start":43.01,"end":44.358,"text":"Bani owo lainiye,","marked":"Báni owó láìníye"},{"start":44.738,"end":46.007,"text":"B'a ni 'le lainiye","marked":"B'á ní 'lè láìníye"},{"start":46.387,"end":48.171,"text":"Ba so wa po bi ti Lilly","marked":"Bá so wá pọ̀ bí ti Lilly"},{"start":48.551,"end":49.972,"text":"B'omo po lo titi","marked":"B'ọ́mọ pọ̀ lọ títí"},{"start":50.352,"end":52.311,"text":"Ba rope ayo wa tikun,","marked":"Bá rọ́pẹ́ ayọ̀ wa tíkun"},{"start":52.691,"end":54.015,"text":"Rara ko iti kun","marked":"Rárá kó ìtì kún"},{"start":54.395,"end":55.88,"text":"Oku bako ti seleri","marked":"Òkú bákọ̀ ti ṣèlérí"},{"start":56.26,"end":57.483,"text":"Eru ni n'eru wa.","marked":"Ẹrú ni n'ẹrú wà."}],"end":57.483},{"key":"5","start":58.433,"lines":[{"start":58.433,"end":59.89,"text":"Kilo tun ba o leru,","marked":"Kìlọ̀ tún bà ọ́ lẹ́rù"},{"start":60.27,"end":61.575,"text":"Ti Jesu ko le se","marked":"Tí Jésù kò lè ṣe"},{"start":61.955,"end":63.425,"text":"Damuso lo wa niwaju re,","marked":"Damuso ló wà níwájú rẹ̀"},{"start":63.805,"end":65.16,"text":"Pe Jesu fun ran 'wo","marked":"Pé Jésù fún ran 'wo"},{"start":65.54,"end":66.893,"text":"Peteru pe fun ranlowo,","marked":"Pétérù pẹ́ fún rànlọ́wọ́"},{"start":67.273,"end":68.536,"text":"Ko je ko ri somi","marked":"Kò jẹ́ kó rì sómi"},{"start":68.916,"end":70.484,"text":"Hezekiah Oba tun pe,","marked":"Hezekiah Ọba tún pe"},{"start":70.864,"end":72.224,"text":"O segun Keferi.","marked":"Ó ṣẹ́gun Kèfèrí."}],"end":72.224},{"key":"6","start":73.174,"lines":[{"start":73.174,"end":74.844,"text":"Won to feje ti Kristi,","marked":"Wọ́n tó fẹ̀jẹ̀ ti Kristi"},{"start":75.224,"end":76.502,"text":"Yio pinu lokan won","marked":"Yíó pinu lọ́kàn wọn"},{"start":76.882,"end":78.174,"text":"Lati yago fun Lusifa","marked":"Láti yàgò fún Lúsífà"},{"start":78.554,"end":79.579,"text":"A t'omo ogun re","marked":"A t'ọmọ ogun rẹ̀"},{"start":79.959,"end":82.277,"text":"Ija, Ibinu, Arakan","marked":"Ìjà, Ìbínú, Arákàn"},{"start":82.657,"end":83.718,"text":"Ati iwa Eri","marked":"Àti ìwà Ẹ̀rí"},{"start":84.098,"end":85.723,"text":"Ainife ati ailanu,","marked":"Àìnífẹ́ àti àìlanu"},{"start":86.103,"end":87.495,"text":"Ko won sile loni.","marked":"Kọ wọ́n sílẹ̀ lónì."}],"end":87.495},{"key":"7","start":88.445,"lines":[{"start":88.445,"end":89.642,"text":"A dupe lowo Oluwa","marked":"A dúpẹ́ lọ́wọ́ Olúwa"},{"start":90.022,"end":90.951,"text":"Oba awon Oba","marked":"Ọba àwọn Ọba"},{"start":91.331,"end":93.248,"text":"Atobiju, Eni 'yanu","marked":"Atóbijù, Ẹni 'yanu"},{"start":93.628,"end":94.528,"text":"Olugbala Eda","marked":"Olùgbàlà Ẹ̀dá"},{"start":94.908,"end":96.856,"text":"Eleda, Olojo oni,","marked":"Ẹlẹ́dàá, Ọlọ́jọ́ òní"},{"start":97.236,"end":98.2,"text":"A juba Oko Re","marked":"A júbà Ọkọ Rẹ̀"},{"start":98.58,"end":99.836,"text":"Ore Re poju kika lo,","marked":"Ọ̀rẹ́ Rẹ̀ pójú kíkà lọ"},{"start":100.216,"end":101.345,"text":"A dupe Oluwa.","marked":"A dúpẹ́ Olúwa."},{"start":101.725,"end":102.242,"text":"Amin.","marked":"Àmín."}],"end":102.242}]}