{"v":1,"coll":"y","num":83,"id":"hymn_83","title":"A DUPE lowo Olorun","duration":53.349,"voices":{"male":{"file":"y-83-male.m4a","bytes":378220,"sha256":"e99f23bda9eda691a98b6402805a624dbb45e4816c4902e020b847e58675a38f","duration":53.4},"female":{"file":"y-83-female.m4a","bytes":393997,"sha256":"417ad05ef5c3c03a928634c4dd620650bca16663daaceaf37551d1c43b50fea1","duration":53.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.547,"text":"A DUPE lowo Olorun","marked":"A Dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":1.927,"end":3.185,"text":"T'o da wa si d'oni","marked":"T'ó dá wa sí d'òní"},{"start":3.565,"end":5.139,"text":"T'o je k'emi tun emi ri,","marked":"T'ó jẹ́ k'ẹ̀mí tún ẹ̀mí rí"},{"start":5.519,"end":6.782,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":6.782},{"key":"CHORUS","start":7.732,"lines":[{"start":7.732,"end":8.833,"text":"A dupe lowo Olorun","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":9.213,"end":10.703,"text":"T'o da emi wa si d'oni","marked":"T'ó da ẹ̀mí wa sí d'òní"},{"start":11.083,"end":12.569,"text":"T'o je k'emi tun emi ri","marked":"T'ó jẹ́ k'ẹ̀mí tún ẹ̀mí rí"},{"start":12.949,"end":14.171,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":14.171},{"key":"2","start":15.121,"lines":[{"start":15.121,"end":16.571,"text":"Ise po n'ilu Osogbo","marked":"Iṣẹ́ pọ̀ ń'ìlú Ọ̀ṣọ́gbó"},{"start":16.951,"end":18.283,"text":"T'ilesa ko ni so;","marked":"T'ilesa kò ní sọ"},{"start":18.663,"end":20.165,"text":"Egbe Ondo ti mura tan","marked":"Ẹgbẹ́ Ondo ti múra tán"},{"start":20.545,"end":21.866,"text":"Lati gbe Jesu ga.","marked":"Láti gbé Jésù ga."},{"start":22.246,"end":23.338,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"}],"end":23.338},{"key":"3","start":24.288,"lines":[{"start":24.288,"end":25.821,"text":"Egbe Eko damure nyin,","marked":"Ẹgbẹ́ Èkó dámùrè nyin"},{"start":26.201,"end":27.413,"text":"Lati besu jagun;","marked":"Láti bẹ́sù jagun"},{"start":27.793,"end":29.268,"text":"Oko pon pupo n'ilu Oke,","marked":"Ọkọ̀ pọ́n púpọ̀ ń'ìlú Òkè"},{"start":29.648,"end":30.547,"text":"Tani yio lo ka?","marked":"Tani yío ló kà?"},{"start":30.927,"end":32.033,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"}],"end":32.033},{"key":"4","start":32.983,"lines":[{"start":32.983,"end":34.352,"text":"A ki Baba Aladura","marked":"A kí Bàbá Aládúrà"},{"start":34.732,"end":35.794,"text":"O ku afojuba","marked":"Ó kú afọ́júbà"},{"start":36.174,"end":37.839,"text":"Olori ti jagun fun Jesu,","marked":"Olórí ti jagun fún Jésù"},{"start":38.219,"end":39.372,"text":"O si segun Esu.","marked":"Ó sì ṣẹ́gun Èṣù."},{"start":39.752,"end":40.974,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"}],"end":40.974},{"key":"5","start":41.924,"lines":[{"start":41.924,"end":43.883,"text":"Orin Halle, Halleluya","marked":"Orin Halle, Hallelúyà"},{"start":44.263,"end":45.557,"text":"L'awa y'o ko l'orun","marked":"L'áwá y'ó kò l'ọrun"},{"start":45.937,"end":47.432,"text":"Nigbat' a ba r'Olugbala,","marked":"Nígbàt' a bá r'Olùgbàlà"},{"start":47.812,"end":48.908,"text":"Ni ori ite Re.","marked":"Ní orí ìtẹ́ Rẹ."},{"start":49.288,"end":50.759,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":51.139,"end":51.799,"text":"Amin.","marked":"Àmín."}],"end":51.799}]}