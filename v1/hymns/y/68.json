{"v":1,"coll":"y","num":68,"id":"hymn_68","title":"NGO korin ti Oludande mi","duration":41.158,"voices":{"male":{"file":"y-68-male.m4a","bytes":297983,"sha256":"4dea13be8dfe21a16a931739fc4aa71bc888761e0e00ffcd6193b279421e7060","duration":41.2},"female":{"file":"y-68-female.m4a","bytes":306342,"sha256":"8ab5f8c7dd69bd2618f40333938816ce7297c6c77739695dd462b10dd61792bb","duration":41.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.028,"text":"NGO korin ti Oludande mi","marked":"Ngo kọrin ti Olùdáǹdè mi"},{"start":2.408,"end":3.643,"text":"Ati ife iyanu Re,","marked":"Àti ìfẹ́ ìyanu Rẹ"},{"start":4.023,"end":5.354,"text":"O jiya lori 'gi oro","marked":"Ó jìyà lórí 'gi oró"},{"start":5.734,"end":7.301,"text":"Lati so mi dom'nira.","marked":"Láti sọ mí dom'nira."}],"end":7.301},{"key":"CHORUS","start":8.251,"lines":[{"start":8.251,"end":9.788,"text":"Korin ti Oludande mi,","marked":"Kọrin ti Olùdáǹdè mi"},{"start":10.168,"end":11.467,"text":"Eje Re l'o fi ra mi","marked":"Ẹ̀jẹ̀ Rẹ l'ó fi rà mí"},{"start":11.847,"end":13.289,"text":"O f'ote re-dariji mi","marked":"Ó f'ọ̀tẹ̀ rẹ̀-dáríjì mi"},{"start":13.669,"end":15.21,"text":"O sanwo-mo dom'nira.","marked":"Ó sanwó-mo dom'nira."}],"end":15.21},{"key":"2","start":16.16,"lines":[{"start":16.16,"end":17.616,"text":"Emi o so'tan Iyanu Re,","marked":"Èmi ò sọ'tán Ìyanu Rẹ̀"},{"start":17.996,"end":19.395,"text":"B'o ti gbogun mi to ni","marked":"B'ó ti gbógun mi tó ni"},{"start":19.775,"end":21.299,"text":"Nu 'fe at'anu ailopin","marked":"Nu 'fẹ́ àt'ánú àìlópin"},{"start":21.679,"end":23.109,"text":"Fi 'dande fun mi lofe.","marked":"Fi 'dáǹdè fún mi lọ́fẹ́."}],"end":23.109},{"key":"3","start":24.059,"lines":[{"start":24.059,"end":25.555,"text":"Ngo y'Oludande mi owon","marked":"Ngo y'Olùdáǹdè mi ọ̀wọ́n"},{"start":25.935,"end":27.21,"text":"Ngo r'agbara segun Re","marked":"Ngo r'ágbára ṣẹ́gun Rẹ"},{"start":27.59,"end":29.395,"text":"B'o ti fun mi ni isegun","marked":"B'ó ti fún mi ní ìṣẹ́gun"},{"start":29.775,"end":31.474,"text":"Lor'ese at'iparun.","marked":"Lọ́r'ẹsẹ̀ àt'ìparun."}],"end":31.474},{"key":"4","start":32.424,"lines":[{"start":32.424,"end":33.878,"text":"Ngo korin t'Oludande mi,","marked":"Ngo kọrin t'Olùdáǹdè mi"},{"start":34.258,"end":35.905,"text":"T'ife at'orun wa Re,","marked":"T'ìfẹ́ àt'ọ̀run wa Rẹ"},{"start":36.285,"end":37.504,"text":"O mu mi la'ku si ye","marked":"Ó mú mi lá'kù sì yé"},{"start":37.884,"end":39.609,"text":"Lati ba om'Olorun gbe.","marked":"Láti bá om'Ọlọ́run gbé."}],"end":39.609}]}