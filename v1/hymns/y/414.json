{"v":1,"coll":"y","num":414,"id":"hymn_414","title":"JESU lo ngbebi aboyun","duration":79.008,"voices":{"male":{"file":"y-414-male.m4a","bytes":579199,"sha256":"ad508d38fc5405637b6c10146b2c30248b8ab5b0e3679f1b01bc4f93efd6b486","duration":79.1},"female":{"file":"y-414-female.m4a","bytes":587335,"sha256":"e491ced920ebf6ff959137cac9fe4cf47fba5cc46dbe51afba24a3d3a79fd459","duration":79.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.92,"text":"JESU lo ngbebi aboyun","marked":"Jésù ló ńgbẹ̀bí aboyún"},{"start":2.3,"end":4.18,"text":"E mase jek' a foiya","marked":"Ẹ máṣe jẹ́k' a fòiya"},{"start":4.56,"end":6.037,"text":"Olugbala wa ni Jesu","marked":"Olùgbàlà wa ni Jésù"},{"start":6.417,"end":7.854,"text":"E mase je k'a foiya.","marked":"Ẹ máṣe jẹ k'á fòiya."}],"end":7.854},{"key":"CHORUS","start":8.804,"lines":[{"start":8.804,"end":9.664,"text":"E mase beru","marked":"Ẹ máṣe bẹ̀rù"},{"start":10.044,"end":11.044,"text":"E kun fun ayo","marked":"Ẹ kún fún ayọ̀"},{"start":11.424,"end":13.1,"text":"Nitori Jesu ni Oba wa","marked":"Nítorí Jésù ni Ọba wa"},{"start":13.48,"end":15.161,"text":"B'o ti wu k'iji na leto","marked":"B'ó ti wu k'íjì ná lẹ́tọ́"},{"start":15.541,"end":16.993,"text":"Y'o da wa sile Iayo.","marked":"Y'ó dá wa sílẹ̀ láyọ̀."}],"end":16.993},{"key":"2","start":17.943,"lines":[{"start":17.943,"end":19.325,"text":"Enyin aboyun Serafu","marked":"Enyin aboyún Séráfù"},{"start":19.705,"end":21.145,"text":"E kepe Jesu nikan","marked":"Ẹ kẹ̀pẹ̀ Jésù nìkan"},{"start":21.525,"end":23.159,"text":"K'e si gbeke nyin le pelu","marked":"K'ẹ sì gbẹ́kẹ̀ nyin lé pẹ̀lú"},{"start":23.539,"end":25.217,"text":"Y'o da nyin sile l'ayo","marked":"Y'ó da nyin sílẹ̀ l'àyò"}],"end":25.217},{"key":"3","start":26.167,"lines":[{"start":26.167,"end":28.246,"text":"Olugbala, 'Wo ti 'ya re","marked":"Olùgbàlà, 'Wo ti 'yá rẹ"},{"start":28.626,"end":30.025,"text":"Ru O gba osu mesan","marked":"Rú Ó gba oṣù mẹ́sàn"},{"start":30.405,"end":31.99,"text":"Ni bethlehem Judea","marked":"Ní bethlehem Judea"},{"start":32.37,"end":33.774,"text":"Layo ibi sokale.","marked":"Láyọ̀ ibi sọ̀kalẹ̀."}],"end":33.774},{"key":"4","start":34.724,"lines":[{"start":34.724,"end":36.438,"text":"Ki l'ohun ti mba nyin l'eru","marked":"Kí l'óhun tí ḿbá nyín l'ẹ̀rù"},{"start":36.818,"end":38.262,"text":"Enyin Omo ogun Kristi","marked":"Enyin Ọmọ ogun Kristi"},{"start":38.642,"end":40.548,"text":"Gbati Jesu ti je tiwa","marked":"Gbátí Jésù ti jẹ́ tiwa"},{"start":40.928,"end":42.381,"text":"Ayo ni yio je tiwa.","marked":"Ayọ̀ ni yio jẹ́ tiwa."}],"end":42.381},{"key":"5","start":43.331,"lines":[{"start":43.331,"end":45.826,"text":"Lowo, aje ati oso","marked":"Lọ́wọ́, ajé àti ọ̀ṣọ́"},{"start":46.206,"end":47.473,"text":"Lowo ajakale arun","marked":"Lọ́wọ́ àjàkálẹ̀ àrùn"},{"start":47.853,"end":50.31,"text":"Lowo lku, ekun, ose","marked":"Lọ́wọ́ lkù, ẹkùn, ọ̀sẹ̀"},{"start":50.69,"end":52.337,"text":"Jesu yio pa Tire mo.","marked":"Jésù yìó pa Tírè mọ́."}],"end":52.337},{"key":"6","start":53.287,"lines":[{"start":53.287,"end":54.852,"text":"Metalokan Alagbara","marked":"Mẹ́talọ́kan Alágbára"},{"start":55.232,"end":56.413,"text":"Dabobo awon omo Re","marked":"Dábòbò àwọn ọmọ Rẹ"},{"start":56.793,"end":58.521,"text":"Lowo ota ati esu","marked":"Lọ́wọ́ ọ̀tá àti èṣù"},{"start":58.901,"end":60.707,"text":"Jek' awa k'Alleluyah.","marked":"Jek' àwa k'Allelúyàh."}],"end":60.707},{"key":"7","start":61.657,"lines":[{"start":61.657,"end":63.113,"text":"Olorun to l'agan ninu","marked":"Ọlọ́run tó l'ágàn nínú"},{"start":63.493,"end":65.351,"text":"Y'o gbo t'enyin ti ntoro","marked":"Y'ó gbọ́ t'ẹnyin ti ńtòrò"},{"start":65.731,"end":68.141,"text":"B'O ti s'ekun Hannah d'erin","marked":"B'ó ti s'èkùn Hannah d'erin"},{"start":68.521,"end":69.982,"text":"Yo f'omo pa nyin l'erin.","marked":"Yọ f'ọmọ pa nyin l'erin."}],"end":69.982},{"key":"8","start":70.932,"lines":[{"start":70.932,"end":72.302,"text":"Ogo ni fun Baba l'oke","marked":"Ògo ni fún Bàbá l'òkè"},{"start":72.682,"end":73.867,"text":"Ogo ni fun Omo Re","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":74.247,"end":75.521,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":75.901,"end":77.459,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọpẹ́ yẹ."}],"end":77.459}]}