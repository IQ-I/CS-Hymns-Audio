{"v":1,"coll":"y","num":108,"id":"hymn_108","title":"KERUBU ati Serafu","duration":80.861,"voices":{"male":{"file":"y-108-male.m4a","bytes":590318,"sha256":"4d8f62f5406374071ff094e6936f8f2caacc515e0b879689ffbdd4ef8c488eb0","duration":80.9},"female":{"file":"y-108-female.m4a","bytes":611665,"sha256":"14c1f9266ff85e316249218f296e21aa94c14d77d1c9beace5c8d6fb6ed9170d","duration":80.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.047,"text":"KERUBU ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":2.427,"end":4.002,"text":"E fun irugbin rere s'aiye","marked":"Ẹ fún irúgbìn rere s'aiye"},{"start":4.382,"end":6.167,"text":"Enyin l'a pe Iati s' awon","marked":"Ẹnyín l'á pẹ́ láti s' àwọn"},{"start":6.547,"end":8.157,"text":"Ti yio pade Oluwa l'oke.","marked":"Ti yíó pàdé Olúwa l'òkè."},{"start":8.537,"end":9.91,"text":"Egbe:  Gbo, gbo, gba b'awon","marked":"Gbọ́, gbó, gba b'àwọn"},{"start":10.29,"end":12.068,"text":"Serafu ti nke","marked":"Séráfù ti ńkẹ́"},{"start":12.448,"end":13.653,"text":"Gbo, gbo, gbo b'awon","marked":"Gbọ́, gbọ́, gbọ́ b'àwọn"},{"start":14.033,"end":15.155,"text":"Kerubu ti nke","marked":"Kérúbù ti ńkẹ́"},{"start":15.535,"end":17.403,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":17.783,"end":19.176,"text":"Halleluyah, f'Oba wa.","marked":"Hallelúyà, f'Ọba wa."}],"end":19.176},{"key":"2","start":20.126,"lines":[{"start":20.126,"end":21.845,"text":"Onigbagbo, e ji giri,","marked":"Onígbàgbọ́, ẹ jí gìrì"},{"start":22.225,"end":23.653,"text":"K'a fi iwa ese s'ile","marked":"K'á fi ìwà ẹ̀ṣẹ̀ s'ílẹ̀"},{"start":24.033,"end":25.513,"text":"K'a se ife Oluwa wa,","marked":"K'á ṣe ìfẹ́ Olúwa wa"},{"start":25.893,"end":27.324,"text":"K'a Ie r'oju rere Olorun.","marked":"K'á lè r'ojú rere Ọlọ́run."},{"start":27.704,"end":28.496,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":28.496},{"key":"3","start":29.446,"lines":[{"start":29.446,"end":31.428,"text":"Onigbngbo, e gb'adura","marked":"Onigbngbo, ẹ gb'àdúrà"},{"start":31.808,"end":33.484,"text":"E fi okan funfun sise","marked":"Ẹ fi ọkàn funfun ṣiṣẹ́"},{"start":33.864,"end":35.62,"text":"E gb' awe pelu iwa mimo","marked":"Ẹ gb' awe pẹ̀lú ìwà mímọ́́"},{"start":36.0,"end":36.861,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":36.861},{"key":"4","start":37.811,"lines":[{"start":37.811,"end":40.279,"text":"Enyin araiye, e tun aiye se","marked":"Enyin aráiye, ẹ tún aiye ṣe"},{"start":40.659,"end":42.062,"text":"Fun bibo Jesu Oluwa","marked":"Fún bíbọ̀ Jésù Olúwa"},{"start":42.442,"end":44.775,"text":"K'ese dinku, k'ajakale aron","marked":"K'èsè dínkù, k'àjàkálẹ̀ aron"},{"start":45.155,"end":46.783,"text":"Ma ti wa lo s'orun apadi.","marked":"Má ti wá lọ s'ọrun àpádì."},{"start":47.163,"end":47.962,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":47.962},{"key":"5","start":48.912,"lines":[{"start":48.912,"end":50.279,"text":"Onigbagbo beru Olorun","marked":"Onígbàgbọ́ bẹ̀rù Ọlọ́run"},{"start":50.659,"end":51.956,"text":"Feran Omonikeji re","marked":"Fẹ́ràn Ọmọnìkejì rẹ"},{"start":52.336,"end":54.113,"text":"Mase pegan mase binu","marked":"Masẹ̀ pẹ̀gàn máṣe bínú"},{"start":54.493,"end":56.297,"text":"Olorun yio gbo adura re.","marked":"Ọlọ́run yìó gbọ́ àdúrà rẹ̀."},{"start":56.677,"end":57.437,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":57.437},{"key":"6","start":58.387,"lines":[{"start":58.387,"end":60.184,"text":"Opo idanwo l'o wa l'aiye","marked":"Ọ̀pọ̀ ìdánwò l'ó wà l'aiye"},{"start":60.564,"end":62.358,"text":"Sugbon eyi t'o buruju","marked":"Ṣùgbọ́n èyí t'ó burúju"},{"start":62.738,"end":65.222,"text":"K'a ma r'owo, k'aisan de ni","marked":"K'á má r'ówó, k'àìsàn dé ni"},{"start":65.602,"end":67.33,"text":"JAH jowo ma fi eyi se wa.","marked":"Jah jọ̀wọ́ má fi èyí ṣe wá."},{"start":67.71,"end":69.27,"text":"Egbe:  Gbo, gbo, gba b'awon","marked":"Gbọ́, gbó, gba b'àwọn"},{"start":69.65,"end":70.899,"text":"Serafu ti nke","marked":"Séráfù ti ńkẹ́"},{"start":71.279,"end":72.528,"text":"Gbo, gbo, gbo b'awon","marked":"Gbọ́, gbọ́, gbọ́ b'àwọn"},{"start":72.908,"end":74.218,"text":"Kerubu ti nke","marked":"Kérúbù ti ńkẹ́"},{"start":74.598,"end":76.305,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":76.685,"end":78.273,"text":"Halleluyah, f'Oba wa.","marked":"Hallelúyà, f'Ọba wa."},{"start":78.653,"end":79.311,"text":"Amin.","marked":"Àmín."}],"end":79.311}]}