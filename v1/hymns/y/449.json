{"v":1,"coll":"y","num":449,"id":"hymn_449","title":"F'ERU re f'afefe","duration":33.428,"voices":{"male":{"file":"y-449-male.m4a","bytes":231145,"sha256":"f51c46dd4a14e2a58569c6d8f8deda298f8f2c810baef99b7e2bf571112cab3f","duration":33.5},"female":{"file":"y-449-female.m4a","bytes":239911,"sha256":"b9cad3d52f2d03704fcc6a7e2ecab702b33318ac2cca827571bfd244735d66f5","duration":33.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.389,"text":"F'ERU re f'afefe","marked":"F'ẹrù rẹ f'afẹ́fẹ́"},{"start":1.769,"end":3.116,"text":"N'ireti ma foiya","marked":"N'írètí má fòiya"},{"start":3.496,"end":4.718,"text":"Olorun gbo 'mikanle re","marked":"Ọlọ́run gbọ́ 'mikànle rẹ̀"},{"start":5.098,"end":6.385,"text":"Yio gb'ori re ga.","marked":"Yíó gb'orí rẹ̀ ga."}],"end":6.385},{"key":"2","start":7.335,"lines":[{"start":7.335,"end":8.801,"text":"N'irumi at'iji","marked":"N'irumi àt'ìjì"},{"start":9.181,"end":10.308,"text":"Y'o s'ona re fefe","marked":"Y'ó s'ọ́nà rẹ̀ fẹ́fẹ́"},{"start":10.688,"end":12.603,"text":"Duro de igba Re, oru","marked":"Dúró de ìgbà Rẹ, òru"},{"start":12.983,"end":14.418,"text":"Y'o pin s'ojo ayo.","marked":"Y'ó pín s'ọ́jọ́ ayọ̀."}],"end":14.418},{"key":"3","start":15.368,"lines":[{"start":15.368,"end":16.416,"text":"Iwo r'ailera wa","marked":"Ìwọ r'àìlera wa"},{"start":16.796,"end":17.898,"text":"Inu wa n'iwo mo","marked":"Inú wa ń'íwò mọ́"},{"start":18.278,"end":19.838,"text":"Gbe owo t'o re si oke","marked":"Gbé owó t'ó rẹ sí òkè"},{"start":20.218,"end":21.951,"text":"M'ekun ailera le.","marked":"M'ẹkún àìlera le."}],"end":21.951},{"key":"4","start":22.901,"lines":[{"start":22.901,"end":25.162,"text":"K'awa, n'iyen n'iku","marked":"K'awa, n'ìyẹn n'ìkú"},{"start":25.542,"end":27.333,"text":"So, oro Re tantan","marked":"Sọ, ọ̀rọ̀ Rẹ tantan"},{"start":27.713,"end":29.312,"text":"K'a so tit' opin emi wa","marked":"K'á sọ tit' òpin ẹ̀mí wa"},{"start":29.692,"end":30.886,"text":"Ife, itoju Re.","marked":"Ìfẹ́, ìtọ́jú Rẹ."},{"start":31.266,"end":31.879,"text":"Amin.","marked":"Àmín."}],"end":31.879}]}