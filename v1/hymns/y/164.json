{"v":1,"coll":"y","num":164,"id":"hymn_164","title":"BABA wa orun, awa de","duration":48.717,"voices":{"male":{"file":"y-164-male.m4a","bytes":360939,"sha256":"858bc5d859686b06314bd1f33a9a1fb645378fcda04f246c925c908424a1792d","duration":48.8},"female":{"file":"y-164-female.m4a","bytes":372904,"sha256":"ea07048a8ab7000b1e596e2d721e8d5415cbc77dcfc28924d34be32bbdabf0c7","duration":48.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.016,"text":"BABA wa orun, awa de,","marked":"Bàbá wa ọ̀run, àwa dé"},{"start":2.396,"end":3.556,"text":"Awa alailagbara","marked":"Àwa aláìlágbára"},{"start":3.936,"end":5.549,"text":"Fi Emi Mimo Re kun wa,","marked":"Fi Ẹ̀mí Mímọ́́ Rẹ kún wa"},{"start":5.929,"end":7.404,"text":"K'o so gbogbo wa d'otun","marked":"K'ó sọ gbogbo wa d'ọ̀tun"},{"start":7.784,"end":10.006,"text":"Wa! Emi Mimo, jare wa!","marked":"Wá! Ẹ̀mí Mímọ́́, jàre wá!"},{"start":10.386,"end":11.846,"text":"F'ede titun s'okan wa","marked":"F'èdè titun s'ọkàn wa"},{"start":12.226,"end":13.634,"text":"Ebun nla Re ni la ntoro","marked":"Ẹ̀bùn ńlá Rẹ̀ ni là ńtọrọ"},{"start":14.014,"end":15.57,"text":"T'ojo nla Pentikosti.","marked":"T'ọjọ́ ńlá Pentikosti."}],"end":15.57},{"key":"2","start":16.52,"lines":[{"start":16.52,"end":18.057,"text":"Ranti ileri Re, Jesu","marked":"Rántí ìlérí Rẹ, Jésù"},{"start":18.437,"end":19.978,"text":"Tu Emi Re s'ara wa,","marked":"Tú Ẹ̀mí Rẹ s'ara wa"},{"start":20.358,"end":21.637,"text":"Fi alafia Re fun wa,","marked":"Fi àlàáfíà Rẹ fún wa"},{"start":22.017,"end":23.44,"text":"T'aye ko Ie fifun ni","marked":"T'áyé kò lè fífún ni"},{"start":23.82,"end":25.968,"text":"Wa! Emi Mimo, jare wa!","marked":"Wá! Ẹ̀mí Mímọ́́, jàre wá!"},{"start":26.348,"end":27.796,"text":"Pa ese run l'okan wa,","marked":"Pa ẹsẹ̀ rún l'ọkàn wa"},{"start":28.176,"end":29.657,"text":"Ebun nla Re ni l'a ntoro","marked":"Ẹ̀bùn ńlá Rẹ̀ ni l'á ńtòrò"},{"start":30.037,"end":31.669,"text":"T'ojo nla Pentikosti.","marked":"T'ọjọ́ ńlá Pentikosti."}],"end":31.669},{"key":"3","start":32.619,"lines":[{"start":32.619,"end":34.447,"text":"Adaba orun! ba le wa,","marked":"Àdàbà ọ̀run! bá lè wà"},{"start":34.827,"end":35.991,"text":"Fi agbara Re fun wa;","marked":"Fi agbára Rẹ fún wa"},{"start":36.371,"end":37.476,"text":"Ki gbogbo orile ede","marked":"Kí gbogbo orílẹ̀ èdè"},{"start":37.856,"end":38.933,"text":"Teriba f'Olugbala,","marked":"Tẹríba f'Olùgbàlà"},{"start":39.313,"end":40.856,"text":"K'a gburo Re jakejado","marked":"K'á gbúrò Rẹ̀ jákèjádò"},{"start":41.236,"end":42.391,"text":"ILe okunkun wa yi","marked":"ILẸ̀ òkùnkùn wa yi"},{"start":42.771,"end":44.29,"text":"Ebun nla Re ni l'a ntoro","marked":"Ẹ̀bùn ńlá Rẹ̀ ni l'á ńtòrò"},{"start":44.67,"end":46.16,"text":"T'ojo nla Pentikosti.","marked":"T'ọjọ́ ńlá Pentikosti."},{"start":46.54,"end":47.167,"text":"Amin.","marked":"Àmín."}],"end":47.167}]}