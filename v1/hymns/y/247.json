{"v":1,"coll":"y","num":247,"id":"hymn_247","title":"NIGBA nwon kehin si Sion","duration":47.483,"voices":{"male":{"file":"y-247-male.m4a","bytes":335673,"sha256":"744a05f97ad0c012aaf8495bd9bd6345234546f4e956e7b6c9bacaa1aba2243a","duration":47.5},"female":{"file":"y-247-female.m4a","bytes":348502,"sha256":"bfda6a760a6bcf63b51dc92d6ba75f41f14dd225119f5a0943f3e957040742c9","duration":47.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.712,"text":"NIGBA nwon kehin si Sion,","marked":"Nígbà nwọn kehin sí Sion"},{"start":2.092,"end":3.639,"text":"A! opo n'iye nwon","marked":"A! ọ̀pọ̀ n'íye nwọn"},{"start":4.019,"end":5.63,"text":"Mo se b'Olugbala wipe","marked":"Mo ṣe b'Olùgbàlà wípé"},{"start":6.01,"end":7.424,"text":"Wo fe ko mi pelu?","marked":"Wọ́ fẹ́ kọ́ mi pẹ̀lú?"}],"end":7.424},{"key":"2","start":8.374,"lines":[{"start":8.374,"end":10.02,"text":"T'emi t'okan b'iru eyi","marked":"T'èmí t'ọkàn b'irú èyí"},{"start":10.4,"end":11.48,"text":"A fi b'O di mi mu","marked":"A fi b'Ó dì mí mú"},{"start":11.86,"end":13.433,"text":"Nko le se ki nma fa s'ehin","marked":"Nkò lè ṣe kí nmá fa s'ehin"},{"start":13.813,"end":14.968,"text":"K'emi si dabi won.","marked":"K'emí sì dàbí wọn."}],"end":14.968},{"key":"3","start":15.918,"lines":[{"start":15.918,"end":18.011,"text":"Mo mo, lwo I'o l'agbara","marked":"Mo mọ̀, lwo l'ó l'ágbára"},{"start":18.391,"end":19.665,"text":"Lati gba otosi","marked":"Láti gba òtòṣì"},{"start":20.045,"end":21.734,"text":"Odo tani emi opo lo","marked":"Ọ̀dọ́ tani ẹ̀mí ọ̀pọ̀ lọ"},{"start":22.114,"end":23.327,"text":"Bi mo kehin si O?","marked":"Bí mo kẹ̀hìn sí Ọ?"}],"end":23.327},{"key":"4","start":24.277,"lines":[{"start":24.277,"end":25.719,"text":"O da mi loju papa pe","marked":"Ó dá mi lójú pápá pé"},{"start":26.099,"end":27.362,"text":"lwo ni Kristi na!","marked":"lwo ni Kristi ná!"},{"start":27.742,"end":29.225,"text":"Enit' o ni emi iye","marked":"Enit' ò ní ẹ̀mí ìyè"},{"start":29.605,"end":30.712,"text":"Nipa ti eje Re.","marked":"Nípa ti ẹ̀jẹ̀ Rẹ."}],"end":30.712},{"key":"5","start":31.662,"lines":[{"start":31.662,"end":32.937,"text":"Ohun Re f 'isimi fun mi","marked":"Ohùn Rẹ f 'isimi fún mi"},{"start":33.317,"end":34.595,"text":"O si l'eru mi lo","marked":"Ó sì l'ẹrù mi lọ"},{"start":34.975,"end":36.069,"text":"lfe Re lo le mu mi yo","marked":"lfẹ́ Rẹ ló lè mú mi yọ̀"},{"start":36.449,"end":37.808,"text":"O si to f'okan mi.","marked":"Ó sì tó f'ọkàn mi."}],"end":37.808},{"key":"6","start":38.758,"lines":[{"start":38.758,"end":40.186,"text":"Bi 'bere yi ti dun mi to","marked":"Bí 'bẹ̀rẹ̀ yí ti dùn mí tó"},{"start":40.566,"end":41.474,"text":"'Pe emi o lo bi?","marked":"'Pé èmi ò lọ bí?"},{"start":41.854,"end":43.176,"text":"Oluwa, ni 'gbekele Re","marked":"Olúwa, ní 'gbẹ́kẹ̀lé Rẹ"},{"start":43.556,"end":44.965,"text":"Mo dahun pe “Beko.”","marked":"Mo dáhùn pé Bẹ́kọ."},{"start":45.345,"end":45.933,"text":"Amin.","marked":"Àmín."}],"end":45.933}]}