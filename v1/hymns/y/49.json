{"v":1,"coll":"y","num":49,"id":"hymn_49","title":"OLUGBALA gbohun mi","duration":53.082,"voices":{"male":{"file":"y-49-male.m4a","bytes":376095,"sha256":"6ebc5e65d034f538d9f26333585157167b70b15c84bbb8d343d0a1dfb543244d","duration":53.1},"female":{"file":"y-49-female.m4a","bytes":390179,"sha256":"033bfe9c5cf27340df7bbcb98ff450387dc58f0c9d9d2a9b64e4ea3ff2959c60","duration":53.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.352,"text":"OLUGBALA gbohun mi,","marked":"Olùgbàlà gbohùn mi"},{"start":1.732,"end":3.013,"text":"Gbohun mi, gbohun mi,","marked":"Gbóhùn mi, gbohùn mi"},{"start":3.393,"end":4.625,"text":"Mo wa sodo Re gba mi","marked":"Mo wá sọ́dọ̀ Rẹ gbà mí"},{"start":5.005,"end":6.086,"text":"Nibi agbelebu,","marked":"Níbi àgbélébùú"},{"start":6.466,"end":8.272,"text":"Emi se, sugbon O ku","marked":"Èmi ṣẹ̀, ṣùgbọ́n Ó kú"},{"start":8.652,"end":9.819,"text":"lwo ku, lwo ku,","marked":"lwo kú, lwo kú"},{"start":10.199,"end":11.299,"text":"Fi anu Re pa mi mo,","marked":"Fi ãnú Rẹ pa mí mọ́"},{"start":11.679,"end":12.938,"text":"Nibi agbelebu.","marked":"Níbi àgbélébùú."}],"end":12.938},{"key":"CHORUS","start":13.888,"lines":[{"start":13.888,"end":14.973,"text":"Oluwa jo gba mi","marked":"Olúwa jọ gbà mí"},{"start":15.353,"end":16.644,"text":"Nk'y'o bi O ninu mo!","marked":"Nk'y'ó bí Ọ nínú mọ́!"},{"start":17.024,"end":18.181,"text":"Alabukun gba mi","marked":"Alábùkún gbà mí"},{"start":18.561,"end":19.749,"text":"Nibi Agbelebu.","marked":"Níbi Àgbélébùú."}],"end":19.749},{"key":"2","start":20.699,"lines":[{"start":20.699,"end":22.156,"text":"Tori ki n' ma ba segbe","marked":"Torí kí n' má bá ṣègbè"},{"start":22.536,"end":24.494,"text":"Ngo bebe! ngo bebe!","marked":"Ngo bẹbẹ! ngo bẹbẹ!"},{"start":24.874,"end":25.984,"text":"iwo li ona iye","marked":"ìwo li ọ̀nà ìyè"},{"start":26.364,"end":27.581,"text":"Nibi agbelebu","marked":"Níbi àgbélébùú"},{"start":27.961,"end":29.059,"text":"Ore-Ofe Re t'a gba","marked":"Ọrẹ-Ọ̀fẹ́ Rẹ t'á gbà"},{"start":29.439,"end":31.001,"text":"Lofe ni! Lofe ni!","marked":"Lọ́fẹ́ ni! Lọ́fẹ́ ni!"},{"start":31.381,"end":32.818,"text":"F'oju anu Re wo mi,","marked":"F'ojú ànú Rẹ̀ wò mí"},{"start":33.198,"end":34.399,"text":"Nibi agbelebu.","marked":"Níbi àgbélébùú."},{"start":34.779,"end":35.798,"text":"Egbe: Oluwa jo gba mi...","marked":"Olúwa jọ gbà mí"}],"end":35.798},{"key":"3","start":36.748,"lines":[{"start":36.748,"end":38.067,"text":"F'eje mimo re we mi","marked":"F'ẹ̀jẹ̀ mímọ́́ rẹ̀ wé mi"},{"start":38.447,"end":40.471,"text":"Fi we mi,! Fi we me!","marked":"Fi wé mi,! Fi wé me!"},{"start":40.851,"end":41.945,"text":"Ri mi sinu ibu Re,","marked":"Rì mí sínú ibú Rẹ"},{"start":42.325,"end":43.571,"text":"Nibi agbelebu,","marked":"Níbi àgbélébùú"},{"start":43.951,"end":45.208,"text":"Gbagbo l'o le fun wa ni,","marked":"Gbàgbọ́ l'ó lè fún wa ni"},{"start":45.588,"end":47.145,"text":"'Dariji !, Dariji !","marked":"'Dáríjì !, Dáríjì !"},{"start":47.525,"end":48.991,"text":"Mo fi f'igbagbo ro mo O.","marked":"Mo fi f'ìgbàgbọ́́ rọ̀ mọ́ O."},{"start":49.371,"end":50.51,"text":"Egbe: Oluwa jo gba mi...","marked":"Olúwa jọ gbà mí"},{"start":50.89,"end":51.532,"text":"Amin.","marked":"Àmín."}],"end":51.532}]}