{"v":1,"coll":"y","num":77,"id":"hymn_77","title":"T'OLUWA n'ile at'ekun re,","duration":54.238,"voices":{"male":{"file":"y-77-male.m4a","bytes":385811,"sha256":"f90d9c9ea8a2c5f88651f042cabcc25cca4c2b9e7b4bc9d165800308f3b9eb37","duration":54.3},"female":{"file":"y-77-female.m4a","bytes":397601,"sha256":"46af1bc3deac5d4a90ca23c2c9c900f2d1134526940b8907d60960b3a8198be8","duration":54.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.926,"text":"T'OLUWA n'ile at'ekun re,","marked":"T'Olúwa n'ilẹ̀ àt'ẹkùn rẹ̀"},{"start":2.306,"end":3.706,"text":"Aiye at'ekun 'nu re,","marked":"Àìyẹ àt'èkùn 'nú rẹ̀"},{"start":4.086,"end":5.999,"text":"O fi 'di re sole lor'okun","marked":"Ó fi 'di rẹ̀ sọlẹ̀ lór'òkun"},{"start":6.379,"end":7.774,"text":"Ati lori 'san omi.","marked":"Àti lórí 'san omi."}],"end":7.774},{"key":"CHORUS","start":8.724,"lines":[{"start":8.724,"end":9.731,"text":"Gb'ori soke","marked":"Gb'ori sókè"},{"start":10.111,"end":10.916,"text":"Enyin 'Iekun","marked":"Enyin 'lẹkùn"},{"start":11.296,"end":12.686,"text":"K'a gbe nyin soke","marked":"K'á gbé nyin sókè"},{"start":13.066,"end":14.395,"text":"K'Oba Ogo wole wa.","marked":"K'Ọba Ògo wọlé wá."}],"end":14.395},{"key":"2","start":15.345,"lines":[{"start":15.345,"end":17.168,"text":"Tani yio g'ori oke yi lo","marked":"Tani yio g'orí òkè yí lọ"},{"start":17.548,"end":18.541,"text":"Ori oke Oluwa","marked":"Orí òkè Olúwa"},{"start":18.921,"end":20.418,"text":"Tani yio duro niwaju Re,","marked":"Tani yio duro níwájú Rẹ"},{"start":20.798,"end":21.953,"text":"Niwaju Oluwa wa.","marked":"Níwájú Olúwa wa."},{"start":22.333,"end":23.437,"text":"Egbe:  Gb'ori soke...","marked":"Gb'ori sókè"}],"end":23.437},{"key":"3","start":24.387,"lines":[{"start":24.387,"end":25.71,"text":"Enit'o ni owo mimo","marked":"Enit'ó ní ọwọ́ mímọ́́"},{"start":26.09,"end":27.543,"text":"T'o si ni aiya funfun,","marked":"T'ó sì ní àìyá funfun"},{"start":27.923,"end":29.908,"text":"Ti ko gb'okan re s'oke s'asan","marked":"Tí kò gb'ọkàn rẹ s'òkè s'ásán"},{"start":30.288,"end":31.697,"text":"Ti ko si bura etan.","marked":"Tí kò sì búra ẹ̀tàn."},{"start":32.077,"end":33.063,"text":"Egbe:  Gb'ori soke...","marked":"Gb'ori sókè"}],"end":33.063},{"key":"4","start":34.013,"lines":[{"start":34.013,"end":35.81,"text":"Awa n'iran ti ns'aferi Re,","marked":"Àwa ń'íràn tí ns'áfẹ́rí Rẹ̀"},{"start":36.19,"end":37.297,"text":"Saferi Re Oluwa,","marked":"Ṣàfẹ́rí Rẹ Olúwa"},{"start":37.677,"end":39.465,"text":"Awa yio si ri ibukun gba,","marked":"Àwa yio sì rí ìbùkún gbà"},{"start":39.845,"end":40.971,"text":"Lowo Olorun Jakob.","marked":"Lọ́wọ́ Ọlọ́run Jakob."},{"start":41.351,"end":42.343,"text":"Egbe:  Gb'ori soke...","marked":"Gb'ori sókè"}],"end":42.343},{"key":"5","start":43.293,"lines":[{"start":43.293,"end":45.295,"text":"A! Tani Oba Ogo yi?","marked":"A! Tani Ọba Ògo yí?"},{"start":45.675,"end":46.932,"text":"Ti 'se Oba Ogo yi?","marked":"Ti 'ṣe Ọba Ògo yí?"},{"start":47.312,"end":48.652,"text":"Oluwa awon omo-ogun,","marked":"Olúwa àwọn ọmọ-ogun"},{"start":49.032,"end":50.352,"text":"On na ni Oba Ogo.","marked":"Ón ná ni Ọba Ògo."},{"start":50.732,"end":51.788,"text":"Egbe:  Gb'ori soke...","marked":"Gb'ori sókè"},{"start":52.168,"end":52.688,"text":"Amin.","marked":"Àmín."}],"end":52.688}]}