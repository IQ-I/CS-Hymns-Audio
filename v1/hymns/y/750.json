{"v":1,"coll":"y","num":750,"id":"hymn_750","title":"O sun, ni Jesu wi","duration":55.917,"voices":{"male":{"file":"y-750-male.m4a","bytes":403207,"sha256":"5acb5a867799ebd2c301237c4e0f42cb8c155995e24907063dde7113ca069f46","duration":56.0},"female":{"file":"y-750-female.m4a","bytes":410053,"sha256":"fc41bb4652192335e085cb1b154eeb36f65722f3a18994b10e3d951ae48e905e","duration":56.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.841,"text":"O sun, ni Jesu wi","marked":"Ó sùn, ni Jésù wí"},{"start":2.221,"end":3.371,"text":"Nigbati Lasaru","marked":"Nígbàtí Lásárù"},{"start":3.751,"end":5.752,"text":"Enit'o ku, ti a ti sin","marked":"Enít'ó kú, tí a ti sìn"},{"start":6.132,"end":7.363,"text":"T'a ti te s' iboji.","marked":"T'á ti tẹ̀ s' ibojì."}],"end":7.363},{"key":"2","start":8.313,"lines":[{"start":8.313,"end":9.227,"text":"Oku ojo merin","marked":"Òkú ọjọ́ mẹ́rin"},{"start":9.607,"end":11.013,"text":"Sun ni, loju Jesu","marked":"Sùn ni, lójú Jésù"},{"start":11.393,"end":12.879,"text":"On l'Ajinde ati lye","marked":"On l'Àjíǹde àti lyé"},{"start":13.259,"end":15.099,"text":"Fun awon t'o gba gbo.","marked":"Fún àwọn t'ó gbà gbọ́."}],"end":15.099},{"key":"3","start":16.049,"lines":[{"start":16.049,"end":17.331,"text":"Ore Jesu ki ku","marked":"Ọ̀rẹ́ Jésù kì kú"},{"start":17.711,"end":18.826,"text":"Nwon a ma parada","marked":"Nwọ̀n á má paradà"},{"start":19.206,"end":20.833,"text":"Kuro ni kokoro ile","marked":"Kúrò ní kọ́kọ́rọ́ ilé"},{"start":21.213,"end":22.747,"text":"S'ohun ti nfo l'oke.","marked":"S'ohun tí nfọ́ l'òkè."}],"end":22.747},{"key":"4","start":23.697,"lines":[{"start":23.697,"end":25.414,"text":"Sun, ara, olufe","marked":"Sùn, ará, olùfẹ́"},{"start":25.794,"end":27.09,"text":"Jesu duro ti o","marked":"Jésù dúró tì ọ́"},{"start":27.47,"end":29.486,"text":"Ma foiya, o ti seleri","marked":"Má fòiya, ó ti ṣèlérí"},{"start":29.866,"end":31.222,"text":"Ajinde f'eni Re.","marked":"Àjíǹde f'ẹni Rẹ."}],"end":31.222},{"key":"5","start":32.172,"lines":[{"start":32.172,"end":33.353,"text":"O fere gb'ohun na","marked":"Ó fẹ̀rẹ̀ gb'ọ́hùn ná"},{"start":33.733,"end":34.904,"text":"Lat'oju orun re","marked":"Lát'ojú ọ̀run rẹ"},{"start":35.284,"end":36.873,"text":"Ohun didun Jesu ti y'o","marked":"Ohun dídùn Jésù ti y'o"},{"start":37.253,"end":38.536,"text":"Pe o si ajinde.","marked":"Pé ó sí àjíǹde."}],"end":38.536},{"key":"6","start":39.486,"lines":[{"start":39.486,"end":40.625,"text":"A ko ni baraje","marked":"A kò ní barajẹ́"},{"start":41.005,"end":42.35,"text":"Bi alanireti","marked":"Bí alanireti"},{"start":42.73,"end":44.327,"text":"O d'owuro l'a o ki o","marked":"O d'òwúrọ̀ l'á ò kí o"},{"start":44.707,"end":45.916,"text":"Pe o si ajinde.","marked":"Pé ó sí àjíǹde."}],"end":45.916},{"key":"7","start":46.866,"lines":[{"start":46.866,"end":48.061,"text":"Awa pelu y'o sun","marked":"Àwa pẹ̀lú y'ó sùn"},{"start":48.441,"end":49.691,"text":"Li akoko tiwa","marked":"Lí àkókò tiwa"},{"start":50.071,"end":52.129,"text":"A! k'ile mo ba gbogbo wa","marked":"A! k'ilẹ̀ mo bá gbogbo wa"},{"start":52.509,"end":54.367,"text":"L'ese Olugbala.  Amin.","marked":"L'ẹsẹ̀ Olùgbàlà. Àmín."}],"end":54.367}]}