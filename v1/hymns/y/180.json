{"v":1,"coll":"y","num":180,"id":"hymn_180","title":"OLORUN, kini mo ri yi!","duration":58.209,"voices":{"male":{"file":"y-180-male.m4a","bytes":432036,"sha256":"a5fc5ae4c84f0e05760cea093d8629a47f0fafa8f4a7129910d00b28985ac5be","duration":58.3},"female":{"file":"y-180-female.m4a","bytes":444153,"sha256":"24ebce49d7fa232549d63e5bd0905d54bd84d8385f48d6569aebc74bea9dfabc","duration":58.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.335,"text":"OLORUN, kini mo ri yi!","marked":"Ọlọ́run, kíni mo rí yí!"},{"start":2.715,"end":3.939,"text":"Opin de f'ohun gbogbo","marked":"Òpin dé f'ohun gbogbo"},{"start":4.319,"end":5.625,"text":"Onidajo araiye yo,","marked":"Onídàjọ́ araiye yọ"},{"start":6.005,"end":7.457,"text":"O gunwa n'ite 'dajo","marked":"Ó gúnwà n'ìtẹ́ 'dájọ́"},{"start":7.837,"end":9.501,"text":"Ipe dun iboji si tu","marked":"Ìpẹ́ dùn ibojì sì tú"},{"start":9.881,"end":11.264,"text":"Gbogbo awon oku sile","marked":"Gbogbo àwọn òkú sílẹ̀"},{"start":11.644,"end":13.367,"text":"Mura, lo ko, okan mi.","marked":"Múra, ló kọ̀, ọkàn mi."}],"end":13.367},{"key":"2","start":14.317,"lines":[{"start":14.317,"end":16.335,"text":"Oku n'nu Krist' y'o ko jinde","marked":"Òkú ń'nú Krist' y'o kò jíǹde"},{"start":16.715,"end":18.107,"text":"Nigba 'pe 'kehin ba dun","marked":"Nígbà 'pé 'kẹ́hìn bá dùn"},{"start":18.487,"end":20.192,"text":"Nwon o lo ko, l'awosanma,","marked":"Nwọn ò lọ kọ́, l'àwọsánmà"},{"start":20.572,"end":21.946,"text":"Nwon o fi ayo yi ka","marked":"Nwọn ò fi ayọ̀ yí ká"},{"start":22.326,"end":24.231,"text":"Ko s' eru ti y'o b'okan won","marked":"Kò s' eru tí y'ó b'ọkàn wọn"},{"start":24.611,"end":26.079,"text":"Oju Re da imole bo","marked":"Ojú Rẹ̀ da ìmọ́lẹ̀̀ bọ̀"},{"start":26.459,"end":27.796,"text":"Awon ti o mura de.","marked":"Àwọn tí ó múra dé."}],"end":27.796},{"key":"3","start":28.746,"lines":[{"start":28.746,"end":30.487,"text":"Sugbon elese t'on t'eru!","marked":"Ṣùgbọ́n ẹlẹ́sẹ̀ t'óń t'ẹ̀rù!"},{"start":30.867,"end":32.103,"text":"Ni gbigbona 'binu Re","marked":"Ní gbígbóná 'bínú Rẹ"},{"start":32.483,"end":34.57,"text":"Nwon o dide, nwon o si ri,","marked":"Nwọn ò dìde, nwọn ò sì rí"},{"start":34.95,"end":36.45,"text":"Pe, o se, nwon ko ba mo","marked":"Pé, ó ṣe, nwọn kò bá mọ̀"},{"start":36.83,"end":38.211,"text":"Ojo Ore-Ofe koja","marked":"Ọjọ́ Ọ̀rẹ́-Ọ̀fẹ́ kọjá"},{"start":38.591,"end":40.35,"text":"Nwon ngbon niwaju 'te 'dajo'","marked":"Nwọ̀n ńgbọ̀n níwájú 'tẹ̀ 'dájọ́'"},{"start":40.73,"end":42.179,"text":"Awon ti ko mura de.","marked":"Àwọn tí kò múra dé."}],"end":42.179},{"key":"4","start":43.129,"lines":[{"start":43.129,"end":44.746,"text":"Olorun, kini mo ri yi","marked":"Ọlọ́run, kíni mo rí yí"},{"start":45.126,"end":46.412,"text":"Opin de f'ohun gbobgo!","marked":"Òpin dé f'ohun gbòbgò!"},{"start":46.792,"end":48.143,"text":"Onidajo araiye yo","marked":"Onídàjọ́ araiye yọ"},{"start":48.523,"end":49.692,"text":"O gunwa n'ile 'dajo","marked":"Ó gúnwà ń'ilẹ̀ 'dájọ́"},{"start":50.072,"end":51.416,"text":"L'ese agbelebu mo nwo","marked":"L'ẹsẹ̀ àgbélébùú mọ́ ńwò"},{"start":51.796,"end":53.555,"text":"Gbat' ohun gbogbo y'o koja","marked":"Gbat' ohun gbogbo y'ó kọjá"},{"start":53.935,"end":55.537,"text":"Bayi ni ngo mura de.","marked":"Báyì ni ngo múra de."},{"start":55.917,"end":56.659,"text":"Amin.","marked":"Àmín."}],"end":56.659}]}