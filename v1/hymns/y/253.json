{"v":1,"coll":"y","num":253,"id":"hymn_253","title":"BABA, ma yi oju kuro","duration":48.908,"voices":{"male":{"file":"y-253-male.m4a","bytes":346179,"sha256":"7dbceec9525ead157c67a87206199d2ac12f00738e2c29cdadb54a19ef4cc881","duration":49.0},"female":{"file":"y-253-female.m4a","bytes":357377,"sha256":"00afe10d40bf2b84e677e10c7abd9278e2a8f7a619df8ede4a1941e5859b3d8b","duration":49.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.09,"text":"BABA, ma yi oju kuro","marked":"Bàbá, má yí ojú kúrò"},{"start":2.47,"end":3.37,"text":"Fun emi otosi","marked":"Fún ẹ̀mí òtòṣì"},{"start":3.75,"end":5.2,"text":"Ti npohunrere ese rni","marked":"Ti ńpohùnréré ẹsẹ̀ rni"},{"start":5.58,"end":7.049,"text":"N'iwaju ite Re.","marked":"N'iwájú ìtẹ́ Rẹ."}],"end":7.049},{"key":"2","start":7.999,"lines":[{"start":7.999,"end":9.485,"text":"'Lekun anu to si sile","marked":"'Lẹ́kùn ànú tó ṣí sílẹ̀"},{"start":9.865,"end":11.089,"text":"F' akerora ese","marked":"F' akèrora ẹ̀ṣẹ̀"},{"start":11.469,"end":13.178,"text":"Mase ti mo mi, Oluwa","marked":"Masẹ́ ti mọ́ mi, Olúwa"},{"start":13.558,"end":14.684,"text":"Je ki emi wole.","marked":"Jẹ́ kí èmi wọ́lẹ̀."}],"end":14.684},{"key":"3","start":15.634,"lines":[{"start":15.634,"end":17.398,"text":"Emi ko nipe mo njewo","marked":"Èmi kò nípẹ́ mọ́ ǹjẹ́wọ́"},{"start":17.778,"end":19.049,"text":"B'aiye mi ti ri ri","marked":"B'aiye mi ti rí rí"},{"start":19.429,"end":21.783,"text":"Gbogbo re lat'ehin wa, ni","marked":"Gbogbo rẹ̀ lát'ẹ̀hìn wa, ni"},{"start":22.163,"end":23.391,"text":"'Wo mo dajudaju.","marked":"'Wò mọ̀ dájúdájú."}],"end":23.391},{"key":"4","start":24.341,"lines":[{"start":24.341,"end":25.851,"text":"Mo wa si 'lekun anu Re","marked":"Mo wá sí 'lẹ́kùn ãnú Rẹ"},{"start":26.231,"end":27.198,"text":"Nibiti anu po","marked":"Níbitì ãnu pọ̀"},{"start":27.578,"end":28.982,"text":"Mo fe 'dariji ese mi","marked":"Mo fẹ́ 'dáríji ẹsẹ̀ mi"},{"start":29.362,"end":30.717,"text":"K'O mu okan mi da.","marked":"K'ó mú ọkàn mi dá."}],"end":30.717},{"key":"5","start":31.667,"lines":[{"start":31.667,"end":32.91,"text":"Emi ko ni ma tenumo","marked":"Èmi kò ní má tẹnumọ́"},{"start":33.29,"end":34.354,"text":"ltunu ti mo nfe","marked":"ltunu tí mo ńfẹ́"},{"start":34.734,"end":36.746,"text":"'Wo mo, Baba, ki nto bere","marked":"'Wò mọ́, Bàbá, kí ńtó bẹ̀rẹ̀"},{"start":37.126,"end":38.49,"text":"lbukun t'emi nwa.","marked":"lbukun t'èmí ńwá."}],"end":38.49},{"key":"6","start":39.44,"lines":[{"start":39.44,"end":41.142,"text":"Anu, Oluwa, ni mo fe","marked":"Ànú, Olúwa, ni mo fẹ́"},{"start":41.522,"end":42.898,"text":"Eyiyi l'opin na","marked":"Èyíyí l'òpin ná"},{"start":43.278,"end":44.891,"text":"Oluwa, anu l'o ye mi","marked":"Olúwa, ànú l'ó yé mi"},{"start":45.271,"end":46.431,"text":"Je ki anu Re wa.","marked":"Jẹ́ kí ãnú Rẹ wà."},{"start":46.811,"end":47.358,"text":"Amin.","marked":"Àmín."}],"end":47.358}]}