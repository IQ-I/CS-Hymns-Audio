{"v":1,"coll":"y","num":742,"id":"hymn_742","title":"KERUBU ati/Serafu","duration":57.383,"voices":{"male":{"file":"y-742-male.m4a","bytes":406184,"sha256":"2dbee86cd5110fc62c1b095aea7ab8936791f7b0f3bc3d19fad423f8ca69e170","duration":57.4},"female":{"file":"y-742-female.m4a","bytes":421905,"sha256":"44bfb91ff177cb4318b00d22cc25f4e0a43408374dfe773f12006958a3207982","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.888,"text":"KERUBU ati/Serafu","marked":"Kérúbù àti Séráfù"},{"start":2.268,"end":3.95,"text":"Nwon nyin Baba/wa loke","marked":"Nwọ̀n nyin Bàbá wa lókè"},{"start":4.33,"end":6.055,"text":"Baba Mimo, Baba/ogo","marked":"Bàbá Mímọ́́, Bàbá ògo"},{"start":6.435,"end":7.303,"text":"ko so wa.","marked":"kò sọ wá."}],"end":7.303},{"key":"2","start":8.253,"lines":[{"start":8.253,"end":9.761,"text":"Jesu Olori/Egbe wa","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":10.141,"end":11.381,"text":"O ti ji di/de loni","marked":"Ó ti jí di dé lónì"},{"start":11.761,"end":13.52,"text":"Kerubu ati Se/rafu","marked":"Kérúbù àti Ṣé ráfù"},{"start":13.9,"end":14.858,"text":"Kun fun ayo.","marked":"Kún fún ayọ̀."}],"end":14.858},{"key":"3","start":15.808,"lines":[{"start":15.808,"end":17.191,"text":"Jehovah Ji/reh Oba","marked":"Jehovah Jí rẹh Ọba"},{"start":17.571,"end":18.918,"text":"Jehovah Nis/si Baba","marked":"Jehovah Nis sí Bàbá"},{"start":19.298,"end":21.06,"text":"Jehovah-Rufi/yio so wa","marked":"Jehovah-Rufi yìó sọ wá"},{"start":21.44,"end":22.508,"text":"Titi lailai.","marked":"Títí láíláí."}],"end":22.508},{"key":"4","start":23.458,"lines":[{"start":23.458,"end":25.09,"text":"Enyin omo egbe/Kerubu","marked":"Enyin ọmọ ẹgbẹ́ Kérúbù"},{"start":25.47,"end":26.896,"text":"To wa lori/'le aiye","marked":"Tó wà lórí 'lé aiye"},{"start":27.276,"end":28.597,"text":"Jesu Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":28.977,"end":30.047,"text":"Jinde loni.","marked":"Jíǹde lónì."}],"end":30.047},{"key":"5","start":30.997,"lines":[{"start":30.997,"end":33.097,"text":"Egbe to ndamu/nisiyi","marked":"Ẹgbẹ́ tó ńdàmú nìsìyí"},{"start":33.477,"end":35.022,"text":"To si ngbadu/ra kikan","marked":"Tó sì ńgbàdù ra kíkan"},{"start":35.402,"end":37.112,"text":"Yio bu s'orin a/yo lojo","marked":"Yío bú s'orin a yọ lọ́jọ́"},{"start":37.492,"end":38.331,"text":"Ajinde.","marked":"Àjíǹde."}],"end":38.331},{"key":"6","start":39.281,"lines":[{"start":39.281,"end":40.778,"text":"Egbe Mimo to/wa l'oke","marked":"Ẹgbẹ́ Mímọ́́ tó wà l'òkè"},{"start":41.158,"end":42.624,"text":"Nwon nyin Baba/wa logo","marked":"Nwọ̀n nyin Bàbá wa lógo"},{"start":43.004,"end":44.733,"text":"E je k'awa ta/wa laiye","marked":"Ẹ jẹ́ k'àwa ta wà láìyẹ"},{"start":45.113,"end":46.035,"text":"Ka si mura.","marked":"Ká sì múra."}],"end":46.035},{"key":"7","start":46.985,"lines":[{"start":46.985,"end":49.436,"text":"Aje, Oso ko ni/ipa kan","marked":"Àjẹ́, Ọ̀ṣọ́ kò ní ipa kan"},{"start":49.816,"end":51.849,"text":"Lori Egbe/Kerubu, Seraf","marked":"Lórí Ẹgbẹ́ Kérúbù, Séráf"},{"start":52.229,"end":53.538,"text":"Jesu Olori/Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":53.918,"end":54.91,"text":"O ti segun.","marked":"Ó ti ṣẹ́gun."},{"start":55.29,"end":55.834,"text":"Amin.","marked":"Àmín."}],"end":55.834}]}