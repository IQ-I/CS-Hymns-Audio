{"v":1,"coll":"y","num":304,"id":"hymn_304","title":"E JE k' a to Jesu wa lo","duration":33.733,"voices":{"male":{"file":"y-304-male.m4a","bytes":238221,"sha256":"fed567b0884c0856af729cbf1eac68ed5e8491557f962549412d4ca3fcccb0b8","duration":33.8},"female":{"file":"y-304-female.m4a","bytes":249284,"sha256":"b9edd533b952bd47cf5e641498427c16a89b1841beb093ce62ac8721d14d780b","duration":33.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.103,"text":"E JE k' a to Jesu wa lo,","marked":"Ẹ Jẹ́ k' á tọ Jésù wa lọ"},{"start":2.483,"end":3.693,"text":"Ni agbala nla ni;","marked":"Ní àgbàlá ńlá ni"},{"start":4.073,"end":5.644,"text":"Nibiti O nlo gbadura,","marked":"Níbitì Ó ńlọ gbàdúrà"},{"start":6.024,"end":7.673,"text":"Nibit' O nlo kanu.","marked":"Níbit' Ó ńlọ kánú."}],"end":7.673},{"key":"2","start":8.623,"lines":[{"start":8.623,"end":10.602,"text":"K' a wo b' O ti dojubole","marked":"K' á wo b' Ó ti dojúbolẹ̀"},{"start":10.982,"end":12.441,"text":"T' o nmi imi edun;","marked":"T' ò ńmí ìmí ẹ̀dùn"},{"start":12.821,"end":14.817,"text":"Eru ese wa l' O gberu,","marked":"Ẹrù ẹsẹ̀ wa l' Ó gbèrú"},{"start":15.197,"end":16.414,"text":"Ese gbogbo aiye.","marked":"Ẹ̀ṣẹ̀ gbogbo aiye."}],"end":16.414},{"key":"3","start":17.364,"lines":[{"start":17.364,"end":18.945,"text":"Elsese, wo Oluwa re,","marked":"Elṣẹ̀ṣẹ̀, wo Olúwa rẹ"},{"start":19.325,"end":20.42,"text":"Eni mimo julo;","marked":"Ẹni mímọ́́ jùlọ"},{"start":20.8,"end":22.18,"text":"Nitori re ni Baba ko,","marked":"Nítorí rẹ̀ ni Bàbá kọ́"},{"start":22.56,"end":23.838,"text":"Aiye si d' ota Re.","marked":"Àìyẹ́ sì d' ọ̀tá Rẹ."}],"end":23.838},{"key":"4","start":24.788,"lines":[{"start":24.788,"end":26.267,"text":"Iwo O ha wo laironu,","marked":"Ìwọ Ò ha wò láìronú"},{"start":26.647,"end":28.042,"text":"Lai k' ese re silse?","marked":"Láì k' ẹsẹ̀ rẹ silse?"},{"start":28.422,"end":29.627,"text":"Ojo idariji nkoja,","marked":"Ọjọ́ ìdáríjì ńkọjá"},{"start":30.007,"end":31.255,"text":"Ojo igbala nlo.","marked":"Ọjọ́ ìgbàlà ńlò."},{"start":31.635,"end":32.183,"text":"Amin.","marked":"Àmín."}],"end":32.183}]}