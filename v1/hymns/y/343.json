{"v":1,"coll":"y","num":343,"id":"hymn_343","title":"ALAFIA f'ojo na, Alleluya!","duration":73.608,"voices":{"male":{"file":"y-343-male.m4a","bytes":557227,"sha256":"55e466d20bf70f3a160c53eec74c9fb927e4fbaf2e77c3ff86be4e9965a916dd","duration":73.7},"female":{"file":"y-343-female.m4a","bytes":565773,"sha256":"fbed697d901ac6d5d1f82a18e0ca1ba010208c2816960526b39970d705b84681","duration":73.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.07,"text":"ALAFIA f'ojo na, Alleluya!","marked":"Àlàáfíà f'ọjọ́ ná, Allelúyà!"},{"start":3.45,"end":5.555,"text":"T'o pada s'ite l'orun, Alleluya!","marked":"T'ó padà s'ìtẹ́ l'ọrun, Allelúyà!"},{"start":5.935,"end":8.032,"text":"Odagutan elese, Alleluya!","marked":"Ọ̀dàgùtàn ẹlẹ́ṣẹ̀, Allelúyà!"},{"start":8.412,"end":10.412,"text":"Goke orun giga lo, Alleluya!","marked":"Gòkè ọ̀run gíga lọ, Allelúyà!"}],"end":10.412},{"key":"2","start":11.362,"lines":[{"start":11.362,"end":13.659,"text":"lyin nduro de nibe, Alleluya!","marked":"lyin ńdúró dé níbẹ̀, Allelúyà!"},{"start":14.039,"end":16.35,"text":"Gb'ori nyin enyin 'lekun, Alleluya!","marked":"Gb'ori nyin enyín 'lẹkùn, Allelúyà!"},{"start":16.73,"end":18.838,"text":"Gba Oba ogo sile, Alleluya!","marked":"Gba Ọba ògo sílẹ̀, Allelúyà!"},{"start":19.218,"end":21.785,"text":"Enit' o segun iku, Alleluya!","marked":"Enit' ò ṣẹ́gun ikú, Allelúyà!"}],"end":21.785},{"key":"3","start":22.735,"lines":[{"start":22.735,"end":25.009,"text":"Orun gba Oluwa re, Alleluya!","marked":"Ọ̀run gba Olúwa rẹ̀, Allelúyà!"},{"start":25.389,"end":27.919,"text":"Sibe, O feran aiye, Alleluya!","marked":"Síbẹ̀, Ó fẹ́ràn aiye, Allelúyà!"},{"start":28.299,"end":30.794,"text":"B'o ti pada s'orite, Alleluya!","marked":"B'ó ti padà s'orite, Allelúyà!"},{"start":31.174,"end":33.97,"text":"O np'eda ni t'On sibe, Alleluya!","marked":"Ó ńp'ẹ̀dà ní t'Ọ́n síbẹ̀, Allelúyà!"}],"end":33.97},{"key":"4","start":34.92,"lines":[{"start":34.92,"end":37.514,"text":"Wo, O gbowo Re sake, Alleluya!","marked":"Wò, Ó gbowó Rẹ̀ sàké, Allelúyà!"},{"start":37.894,"end":40.342,"text":"Wo, O f'apa ife han, Alleluya!","marked":"Wò, Ó f'apá ìfẹ́ hàn, Allelúyà!"},{"start":40.722,"end":43.563,"text":"Gbo, bi On ti nsure fun, Alleluya!","marked":"Gbọ́, bí On ti nsure fún, Allelúyà!"},{"start":43.943,"end":46.274,"text":"Ijo Re laiye nihin, Alleluya!","marked":"Ìjọ Rẹ̀ láìyẹ níhìn, Allelúyà!"}],"end":46.274},{"key":"5","start":47.224,"lines":[{"start":47.224,"end":49.927,"text":"Sibe, O mbebe fun wa, Alleluya!","marked":"Síbẹ̀, Ó ḿbẹ̀bẹ̀ fún wa, Allelúyà!"},{"start":50.307,"end":52.648,"text":"lku Re l'o fi mbebe, Alleluya!","marked":"lkù Rẹ̀ l'ó fi mbẹbẹ, Allelúyà!"},{"start":53.028,"end":55.64,"text":"O npese aye fun wa, Alleluya!","marked":"Ó ńpèsè ayé fún wa, Allelúyà!"},{"start":56.02,"end":58.393,"text":"On l'akobi iran wa, Alleluya!","marked":"On l'àkọ́bí ìran wa, Allelúyà!"}],"end":58.393},{"key":"6","start":59.343,"lines":[{"start":59.343,"end":62.234,"text":"Oluwa, b'a ti gba O, Alleluya!","marked":"Olúwa, b'á ti gba O, Allelúyà!"},{"start":62.614,"end":65.116,"text":"Jina kuro lodo wa, Alleluya!","marked":"Jìnà kúrò lọ́dọ̀ wa, Allelúyà!"},{"start":65.496,"end":68.093,"text":"M'okan wa lo sibe na, Alleluya!","marked":"M'ọkàn wa lọ síbẹ̀ ná, Allelúyà!"},{"start":68.473,"end":71.056,"text":"K'a wa O loke orun, Alleluya!","marked":"K'á wá O lókè ọ̀run, Allelúyà!"},{"start":71.436,"end":72.058,"text":"Amin.","marked":"Àmín."}],"end":72.058}]}