{"v":1,"coll":"y","num":318,"id":"hymn_318","title":"L'OWURO ojo Ajinde","duration":65.564,"voices":{"male":{"file":"y-318-male.m4a","bytes":463219,"sha256":"fb44c50ee0a711789e7019f7357025648ab1525b94d3191d8cdd350cb5700340","duration":65.6},"female":{"file":"y-318-female.m4a","bytes":483174,"sha256":"ce036acdc09602bdb115bcbce68a4bdc78ee6813b775727b7cd4d463944ec0e7","duration":65.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.902,"text":"L'OWURO ojo Ajinde","marked":"L'òwúrọ̀ ọjọ́ Àjíǹde"},{"start":2.282,"end":3.677,"text":"T'ara t'okan yio pade","marked":"T'ara t'ọkàn yíó pàdé"},{"start":4.057,"end":5.655,"text":"Ekun, kanu on irora","marked":"Ẹkùn, kánú ọ́n ìrora"},{"start":6.035,"end":6.931,"text":"Y'o dopin.","marked":"Y'ó dópin."}],"end":6.931},{"key":"2","start":7.881,"lines":[{"start":7.881,"end":9.28,"text":"Nihin nwon ko le sai pin ya,","marked":"Níhìn nwọn kò lè ṣàì pín yá"},{"start":9.66,"end":11.271,"text":"Ki ara ba le simi","marked":"Kí ara bà lè sìmí"},{"start":11.651,"end":13.097,"text":"K'o si fi idakeroro","marked":"K'ó sì fi idakeroro"},{"start":13.477,"end":14.565,"text":"Sun fonfon.","marked":"Sùn fọnfọn."}],"end":14.565},{"key":"3","start":15.515,"lines":[{"start":15.515,"end":17.202,"text":"Fun 'gba die era are yi","marked":"Fún 'gba díẹ̀ era àre yí"},{"start":17.582,"end":18.981,"text":"L'a gbe s'ibi 'simi re","marked":"L'á gbé s'íbí 'simi rẹ̀"},{"start":19.361,"end":20.852,"text":"Titi di imole oro","marked":"Títí di ìmọ́lẹ̀̀ ọrọ̀"},{"start":21.232,"end":22.052,"text":"Ajinde.","marked":"Àjíǹde."}],"end":22.052},{"key":"4","start":23.002,"lines":[{"start":23.002,"end":25.234,"text":"Okan t'o kanu nisiyi","marked":"Ọ̀kan t'ó kánú nísìyí"},{"start":25.614,"end":27.229,"text":"T'o si ngbadura kikan","marked":"T'ó sì ńgbàdúrà kíkan"},{"start":27.609,"end":29.653,"text":"Y'o bu s'orin ayo l'ojo Ajinde.","marked":"Y'ó bú s'orin ayò l'ọjọ́ Àjíǹde."}],"end":29.653},{"key":"5","start":30.603,"lines":[{"start":30.603,"end":32.366,"text":"Ara at'okan y'o dapo","marked":"Ara àt'ọkàn y'ó dàpọ̀"},{"start":32.746,"end":34.03,"text":"Ipinya ko ni si mo","marked":"Ìpínyà kò ní sí mọ́"},{"start":34.41,"end":36.274,"text":"Nwon o ji l'aworan Krist' ni","marked":"Nwọn ò jí l'àwòrán Krist' ni"},{"start":36.654,"end":37.275,"text":"'Telorun.","marked":"'Tẹlọrùn."}],"end":37.275},{"key":"6","start":38.225,"lines":[{"start":38.225,"end":40.536,"text":"A! ewa na at'ayo na","marked":"A! ẹwà na àt'àyò ná"},{"start":40.916,"end":42.485,"text":"Y'o ti po to Ajinde!","marked":"Y'ó ti pọ̀ tó Àjíǹde!"},{"start":42.865,"end":44.638,"text":"Y'o duro b'orun at'aiye","marked":"Y'ó dúró b'ọrun àt'áiye"},{"start":45.018,"end":45.899,"text":"Ba fo lo.","marked":"Bá fò lọ."}],"end":45.899},{"key":"7","start":46.849,"lines":[{"start":46.849,"end":48.493,"text":"L'oro ojo Ajinde wa,","marked":"L'ọ̀rọ̀ ọjọ́ Àjíǹde wa"},{"start":48.873,"end":50.283,"text":"'Boji y'o m'oku re wa","marked":"'Bòji y'ó m'òkú rẹ̀ wà"},{"start":50.663,"end":52.729,"text":"Baba, iya, omo, ara","marked":"Bàbá, ìyá, ọmọ, ará"},{"start":53.109,"end":54.016,"text":"Y'o pade.","marked":"Y'ó pàdé."}],"end":54.016},{"key":"8","start":54.966,"lines":[{"start":54.966,"end":56.609,"text":"Si dapo ti o dun bayi","marked":"Sì dàpọ̀ tí ó dún báyì"},{"start":56.989,"end":59.262,"text":"Di Jesu, masai ka wa ye","marked":"Di Jésù, masai ká wá yé"},{"start":59.642,"end":61.73,"text":"N'nu 'ku dajo, k'a le ro","marked":"N'nú 'kú dájọ́, k'á lè rò"},{"start":62.11,"end":63.11,"text":"M'a Gbelebu.","marked":"M'á Gbelebu."},{"start":63.49,"end":64.014,"text":"Amin.","marked":"Àmín."}],"end":64.014}]}