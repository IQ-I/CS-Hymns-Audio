{"v":1,"coll":"y","num":838,"id":"hymn_838","title":"JESU Onirele","duration":36.741,"voices":{"male":{"file":"y-838-male.m4a","bytes":249821,"sha256":"ed7d15a3569c66182ed9eb9afe8bd539e13f83488f58359e2ab6d89047a87e5f","duration":36.8},"female":{"file":"y-838-female.m4a","bytes":259795,"sha256":"55d469beb214438c1343e88296af6c2d987479bf5bbac4c3baeaf583228cbf58","duration":36.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.695,"text":"JESU Onirele,","marked":"Jésù Onírẹ̀lẹ̀"},{"start":2.075,"end":2.957,"text":"Omo Olorun","marked":"Ọmọ Ọlọ́run"},{"start":3.337,"end":4.857,"text":"Alanu, Olufe,","marked":"Alanu, Olùfẹ́"},{"start":5.237,"end":6.269,"text":"Gbo 'gbe omo Re.","marked":"Gbọ́ 'gbé ọmọ Rẹ."}],"end":6.269},{"key":"2","start":7.219,"lines":[{"start":7.219,"end":8.753,"text":"Fi ese wa ji wa,","marked":"Fi ẹsẹ̀ wa jì wá"},{"start":9.133,"end":10.281,"text":"Si da wa n'ide,","marked":"Sì dá wa ń'ìdè"},{"start":10.661,"end":11.849,"text":"Fo gbogbo orisa,","marked":"Fọ gbogbo òrìṣà"},{"start":12.229,"end":13.335,"text":"Ti mbe l'okan.","marked":"Ti ḿbẹ l'ọ́kan."}],"end":13.335},{"key":"3","start":14.285,"lines":[{"start":14.285,"end":15.633,"text":"Fun wa ni omnira,","marked":"Fún wa ní omnira"},{"start":16.013,"end":17.16,"text":"F'ife s'okan wa'","marked":"F'ìfẹ́ s'ọkàn wa'"},{"start":17.54,"end":18.78,"text":"Fa wa, Jesu mimo","marked":"Fà wá, Jésù mímọ́́"},{"start":19.16,"end":20.394,"text":"S'ibugbe l'oke.","marked":"S'ibùgbé l'òkè."}],"end":20.394},{"key":"4","start":21.344,"lines":[{"start":21.344,"end":22.498,"text":"To wa l'ona ajo,","marked":"Tó wá l'ọ́nà àjọ"},{"start":22.878,"end":23.913,"text":"Si je ona wa,","marked":"Sì jẹ́ ọ̀nà wa"},{"start":24.293,"end":25.646,"text":"La okun aiye ja,","marked":"La okùn aiye já"},{"start":26.026,"end":27.198,"text":"S'imole orun.","marked":"S'ìmọ́lẹ̀̀ ọ̀run."}],"end":27.198},{"key":"5","start":28.148,"lines":[{"start":28.148,"end":29.317,"text":"Jesu Onilere,","marked":"Jésù Onílérè"},{"start":29.697,"end":30.734,"text":"Omo Olorun;","marked":"Ọmọ Ọlọ́run"},{"start":31.114,"end":32.843,"text":"Alanu, Olufe","marked":"Alanu, Olùfẹ́"},{"start":33.223,"end":34.175,"text":"Gbo 'gbe omo Re.","marked":"Gbọ́ 'gbé ọmọ Rẹ."},{"start":34.555,"end":35.192,"text":"Amin.","marked":"Àmín."}],"end":35.192}]}