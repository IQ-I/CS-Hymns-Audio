{"v":1,"coll":"y","num":39,"id":"hymn_39","title":"K'OJO 'simi yi to tan","duration":40.709,"voices":{"male":{"file":"y-39-male.m4a","bytes":280425,"sha256":"25af87ff95f443283001dc5a44fd94ff7603f2dbd3f268639f3355e74d4e1c04","duration":40.8},"female":{"file":"y-39-female.m4a","bytes":291577,"sha256":"6d1bb82eb6739f09ce3c1964309aa03de17fe6b5c22d004d46aaf1db9bfe43e9","duration":40.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.908,"text":"K'OJO 'simi yi to tan","marked":"K'ọjọ́ 'simi yi tó tán"},{"start":2.288,"end":3.838,"text":"K' a to lo f'ara le 'le,","marked":"K' á tó lọ f'ara lé 'le"},{"start":4.218,"end":5.402,"text":"Awa wole l'ese Re,","marked":"Àwa wọlé l'ẹsẹ̀ Rẹ"},{"start":5.782,"end":7.04,"text":"A nkorin iyin si O.","marked":"A ńkọrin ìyìn sí O."}],"end":7.04},{"key":"2","start":7.99,"lines":[{"start":7.99,"end":9.17,"text":"Fun anu ojo oni,","marked":"Fún ànú ọjọ́ òní"},{"start":9.55,"end":10.708,"text":"Fun isimi Iona wa,","marked":"Fún isimi lọ́nà wa"},{"start":11.088,"end":12.491,"text":"'Wo nikan l'a f'ope fun","marked":"'Wò nìkan l'á f'ọpẹ́ fún"},{"start":12.871,"end":14.263,"text":"Oluwa at'oba wa.","marked":"Olúwa àt'ọba wa."}],"end":14.263},{"key":"3","start":15.213,"lines":[{"start":15.213,"end":16.837,"text":"lsin wa ko nilari","marked":"lsin wa kò nílárí"},{"start":17.217,"end":18.485,"text":"Adura wa lu m'ese","marked":"Àdúrà wa lu m'ese"},{"start":18.865,"end":20.534,"text":"Sugbon 'Wo l'o nf'ese ji,","marked":"Ṣùgbọ́n 'Wò l'ó ńf'ẹsẹ̀ jí"},{"start":20.914,"end":22.413,"text":"Or'ofe Re to fun wa.","marked":"Or'ọ̀fẹ́ Rẹ̀ tó fún wa."}],"end":22.413},{"key":"4","start":23.363,"lines":[{"start":23.363,"end":24.54,"text":"Je k'ife Re ma to wa","marked":"Jẹ́ k'ífẹ́ Rẹ má tó wà"},{"start":24.92,"end":26.57,"text":"B'a ti nrin 'na aiye yi:'","marked":"B'a ti nrìn 'ná aiye yi:'"},{"start":26.95,"end":28.46,"text":"Nigbat'ajo wa ba pin","marked":"Nígbàt'àjọ wa bá pín"},{"start":28.84,"end":30.286,"text":"K'a le simi lodo Re.","marked":"K'á lè simi lọ́dọ̀ Rẹ."}],"end":30.286},{"key":"5","start":31.236,"lines":[{"start":31.236,"end":32.732,"text":"K'ojo 'simi wonyi je","marked":"K'ọjọ́ 'simi wọ̀nyí jẹ́"},{"start":33.112,"end":34.248,"text":"lbere ayo orun;","marked":"lbere ayọ̀ ọ̀run"},{"start":34.628,"end":35.977,"text":"B'a ti nrin ajo wa lo,","marked":"B'a ti ńrìn àjò wa lọ"},{"start":36.357,"end":38.226,"text":"S'isimi ti ko l'opin.","marked":"S'isimi tí kò l'òpin."},{"start":38.606,"end":39.159,"text":"Amin.","marked":"Àmín."}],"end":39.159}]}