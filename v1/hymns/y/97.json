{"v":1,"coll":"y","num":97,"id":"hymn_97","title":"OLORUN Eleda t'o d'egbe Seraf,","duration":71.93,"voices":{"male":{"file":"y-97-male.m4a","bytes":527575,"sha256":"5c4a5ed9d120eed6f2a56a84901c8958c35a8f1e789b8699ca606934bfc57a7c","duration":72.0},"female":{"file":"y-97-female.m4a","bytes":545607,"sha256":"a68949a3e0552a6cd95c9c0eeef75c7ed542a6deae8c9c3c3a17d729be8277f7","duration":72.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.809,"text":"OLORUN Eleda t'o d'egbe Seraf,","marked":"Ọlọ́run Ẹlẹ́dàá t'ó d'ẹgbẹ́ Séráf"},{"start":3.189,"end":5.388,"text":"Ati Kerubu s'orile ede aiye","marked":"Àti Kérúbù s'orílẹ̀ èdè aiye"},{"start":5.768,"end":7.684,"text":"Lat'owo Jesu Olugbala owon","marked":"Lát'ọwọ́ Jésù Olùgbàlà ọ̀wọ́n"},{"start":8.064,"end":9.785,"text":"Awa nyin oruko Re logo.","marked":"Àwa nyin orúkọ Rẹ̀ lógo."}],"end":9.785},{"key":"CHORUS","start":10.735,"lines":[{"start":10.735,"end":13.608,"text":"A! e ku ayo, eku ayo","marked":"A! ẹ kú ayò, eku ayò"},{"start":13.988,"end":14.956,"text":"egbe Serafu","marked":"ẹgbẹ́ Séráfù"},{"start":15.336,"end":18.065,"text":"A! e ku ayo, e ku ayo","marked":"A! ẹ kú ayò, ẹ kú ayò"},{"start":18.445,"end":19.397,"text":"egbe Kerubu.","marked":"ẹgbẹ́ Kérúbù."}],"end":19.397},{"key":"2","start":20.347,"lines":[{"start":20.347,"end":21.968,"text":"Nibo l'awon ayanfe Olorun wa?","marked":"Níbo l'àwọn àyànfẹ́ Ọlọ́run wa?"},{"start":22.348,"end":24.401,"text":"E wa gbo ohun Oluso-agutan yi","marked":"Ẹ wá gbọ́ ohùn Oluso-agutan yí"},{"start":24.781,"end":26.727,"text":"E ronu piwada, e wa w'oko na;","marked":"Ẹ ronú pìwàdà, ẹ wá w'ọkọ̀ ná"},{"start":27.107,"end":28.887,"text":"Igbala na ku si atel'owo.","marked":"Ìgbàlà ná kù sí atel'owo."}],"end":28.887},{"key":"3","start":29.837,"lines":[{"start":29.837,"end":32.65,"text":"Egbe Kerubu, dupe lowo Olorun","marked":"Ẹgbẹ́ Kérúbù, dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":33.03,"end":35.293,"text":"Tesiwaju ninu ogun emi jija","marked":"Tẹ̀síwájú nínú ogun ẹ̀mí jíjà"},{"start":35.673,"end":37.648,"text":"E fere gbo 'hun Oluwa wa Jesu,","marked":"Ẹ fẹ́re gbọ́ 'hun Olúwa wa Jésù"},{"start":38.028,"end":39.926,"text":"Wipe, o seun, omo rere.","marked":"Wípé, ó ṣeun, ọmọ rere."}],"end":39.926},{"key":"4","start":40.876,"lines":[{"start":40.876,"end":42.907,"text":"Enyin ti nkoja lo ya sodo Jesu","marked":"Enyin tí ńkọjá ló yà sọ́dọ̀ Jésù"},{"start":43.287,"end":45.188,"text":"Lati gb'ore-ofe n'nu egbe yi,","marked":"Láti gb'ọrẹ-ọ̀fẹ́ ń'nú ẹgbẹ́ yí"},{"start":45.568,"end":48.02,"text":"Mase kegan oko igbala 'kehin","marked":"Mase kẹ́gàn oko ìgbàlà 'kẹ́hìn"},{"start":48.4,"end":49.759,"text":"T'Olorun Metalokan fun wa.","marked":"T'Ọlọ́run Mẹ́talọ́kan fún wa."}],"end":49.759},{"key":"5","start":50.709,"lines":[{"start":50.709,"end":52.664,"text":"Jesu Oluwa mbowa joba laiye","marked":"Jésù Olúwa ḿbọ̀wá jọba láìyẹ"},{"start":53.044,"end":55.502,"text":"Larin Egbe Kerubu ati Serafu","marked":"Lárin Ẹgbẹ́ Kérúbù àti Séráfù"},{"start":55.882,"end":57.723,"text":"Egberun Odun ni 'joba re ninu","marked":"Ẹgbẹ̀rún Ọdún ní 'jọba rẹ̀ nínú"},{"start":58.103,"end":59.946,"text":"Egbe Mimo at'oke wa yi.","marked":"Ẹgbẹ́ Mímọ́́ àt'òkè wá yi."}],"end":59.946},{"key":"6","start":60.896,"lines":[{"start":60.896,"end":63.364,"text":"Jesu Kristi Oluwa Oba Ogo","marked":"Jésù Kristi Olúwa Ọba Ògo"},{"start":63.744,"end":65.531,"text":"L'opa iye ainipekun wa lowo re","marked":"L'ọ́pá ìyè àìnípẹ̀kun wà lọ́wọ́ rẹ̀"},{"start":65.911,"end":68.103,"text":"Yio ko gbogbo awon t'o gbagbo Io,","marked":"Yíó kó gbogbo àwọn t'ó gbàgbọ́ lọ"},{"start":68.483,"end":70.38,"text":"Siwaju ite baba l'oke.","marked":"Síwájú ìtẹ́ bàbá l'òkè."}],"end":70.38}]}