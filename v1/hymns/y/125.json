{"v":1,"coll":"y","num":125,"id":"hymn_125","title":"GBOGBO eda abe orun","duration":17.841,"voices":{"male":{"file":"y-125-male.m4a","bytes":122825,"sha256":"73394fc6f4507db9447e75c2f98bb49086205b4a64a8b6fa20e4ef891045fe37","duration":17.9},"female":{"file":"y-125-female.m4a","bytes":124699,"sha256":"ec5e64748de20b7ee6d93c568b315602c6954fa1b4c88fd6596a2b5d2499143b","duration":17.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.75,"text":"GBOGBO eda abe orun","marked":"Gbogbo ẹ̀dá abẹ́ ọ̀run"},{"start":2.13,"end":3.49,"text":"E f'iyin fun Eleda wa,","marked":"Ẹ f'ìyìn fún Ẹlẹ́dàá wa"},{"start":3.87,"end":4.904,"text":"Ki gbogbo orile-ede","marked":"Kí gbogbo orílẹ̀-èdè"},{"start":5.284,"end":6.264,"text":"Korin iyin Olugbala.","marked":"Kọrin ìyìn Olùgbàlà."}],"end":6.264},{"key":"2","start":7.214,"lines":[{"start":7.214,"end":8.83,"text":"Oluwa, anu Re ki ti,","marked":"Olúwa, ãnú Rẹ̀ kí ti"},{"start":9.21,"end":10.539,"text":"Oto Re si duro lailai","marked":"Ọ̀tọ̀ Rẹ̀ sì dúró láíláí"},{"start":10.919,"end":12.637,"text":"Iyin Re y'o tan kakiri","marked":"Ìyìn Rẹ̀ y'ó tàn kákiri"},{"start":13.017,"end":15.298,"text":"Tit'orun y'o la laiwo mo.","marked":"Tít'ọ̀run y'ó là láìwo mọ́."},{"start":15.678,"end":16.291,"text":"Amin.","marked":"Àmín."}],"end":16.291}]}