{"v":1,"coll":"y","num":853,"id":"hymn_853","title":"OLORUN aiye mi","duration":56.374,"voices":{"male":{"file":"y-853-male.m4a","bytes":401210,"sha256":"764498d6a0261efb3e723d0a485b1eadec7c31ef6959890bed6c527a49cbab81","duration":56.4},"female":{"file":"y-853-female.m4a","bytes":412615,"sha256":"4342d181f20663252234b37aebbb66ec388ba43497901581ed8c1cc7e569fb0c","duration":56.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.463,"text":"OLORUN aiye mi","marked":"Ọlọ́run aiye mi"},{"start":1.843,"end":3.029,"text":"Emi ni yo si O","marked":"Èmi ni yó sí O"},{"start":3.409,"end":4.654,"text":"Ore Re l'o da mi","marked":"Ọ̀rẹ́ Rẹ l'ó dá mi"},{"start":5.034,"end":6.269,"text":"L'o da mi si sibe","marked":"L'ó dá mi sí síbẹ̀"},{"start":6.649,"end":7.899,"text":"Ayajo ibi mi tun de","marked":"Àyájọ́ ìbí mi tún dé"},{"start":8.279,"end":9.915,"text":"Ngo sure f'ojo t'a bi mi.","marked":"Ngo súre f'ọjọ́ t'á bí mi."}],"end":9.915},{"key":"2","start":10.865,"lines":[{"start":10.865,"end":11.921,"text":"Ni gbogbo ojo mi","marked":"Ní gbogbo ọjọ́ mi"},{"start":12.301,"end":13.424,"text":"Ki nwa laye fun O","marked":"Kí ńwà láyè fún Ọ"},{"start":13.804,"end":14.869,"text":"Ki gbogbo emi mi","marked":"Kí gbogbo ẹ̀mí mi"},{"start":15.249,"end":16.544,"text":"F'ope, iyin fun O","marked":"F'ọpẹ́, ìyìn fún Ọ"},{"start":16.924,"end":18.103,"text":"Gbogbo ini at'iwa mi","marked":"Gbogbo ìní àt'ìwà mi"},{"start":18.483,"end":20.066,"text":"Y'o yin Eleda mi logo.","marked":"Y'ó yin Ẹlẹ́dàá mi lógo."}],"end":20.066},{"key":"3","start":21.016,"lines":[{"start":21.016,"end":22.097,"text":"Gbogbo pa emi mi","marked":"Gbogbo pa ẹ̀mí mi"},{"start":22.477,"end":23.812,"text":"Y'o je Tire nikan","marked":"Y'ó jẹ́ Tírè nìkan"},{"start":24.192,"end":25.24,"text":"Gbogbo akoko mi","marked":"Gbogbo àkókò mi"},{"start":25.62,"end":26.986,"text":"Mo ya soto fun O","marked":"Mo yà sọ́tọ̀ fún Ọ"},{"start":27.366,"end":28.621,"text":"Jo tun mi bi l'aworan Re","marked":"Jo tún mi bí l'àwòrán Rẹ"},{"start":29.001,"end":30.89,"text":"Ngo si ma yin O titi aiye.","marked":"Ngo sì má yìn Ọ́ títí aiye."}],"end":30.89},{"key":"4","start":31.84,"lines":[{"start":31.84,"end":33.073,"text":"Mo nfe se ife Re","marked":"Mo ńfẹ́ ṣe ìfẹ́ Rẹ"},{"start":33.453,"end":35.639,"text":"B'angel' ti nse l'orun","marked":"B'angel' ti ńṣe l'ọ́run"},{"start":36.019,"end":37.468,"text":"Ki ndatunbi n'nu Krist'","marked":"Kí ndatunbí ń'nú Krist'"},{"start":37.848,"end":39.209,"text":"Ki nri 'dariji gba","marked":"Kí ńrí 'dáríjì gbà"},{"start":39.589,"end":41.152,"text":"Mo nfe mu 'fe pipe Re se","marked":"Mo ńfẹ́ mú 'fẹ́ pípẹ́ Rẹ ṣẹ"},{"start":41.532,"end":42.862,"text":"K'ife Re ya mi si Mimo.","marked":"K'ífẹ́ Rẹ̀ yà mí sí Mímọ́́."}],"end":42.862},{"key":"5","start":43.812,"lines":[{"start":43.812,"end":45.108,"text":"Gba 'se na ba pari","marked":"Gba 'ṣe ná bá parí"},{"start":45.488,"end":46.724,"text":"L'agbara igbagbo","marked":"L'agbára ìgbàgbọ́́"},{"start":47.104,"end":48.277,"text":"Tewogb' ayanfe Re","marked":"Tẹ́wọ́gb' àyànfẹ́ Rẹ"},{"start":48.657,"end":49.858,"text":"Li akoko iku","marked":"Lí àkókò ikú"},{"start":50.238,"end":51.82,"text":"Pe mi sodo bi ti Mose","marked":"Pè mí sọ́dọ̀ bí ti Mósè"},{"start":52.2,"end":53.875,"text":"Gbe emi mi s'afefe 're.","marked":"Gbé ẹ̀mí mi s'áfẹ́fẹ́ 'rẹ."},{"start":54.255,"end":54.824,"text":"Amin.","marked":"Àmín."}],"end":54.824}]}