{"v":1,"coll":"y","num":11,"id":"hymn_11","title":"K'A to sun, Olugbala wa","duration":51.153,"voices":{"male":{"file":"y-11-male.m4a","bytes":370672,"sha256":"3abd866d9c30999c263e17d819d0950ba5c66b5f10e1f9b265d316e2758a40cb","duration":51.2},"female":{"file":"y-11-female.m4a","bytes":383892,"sha256":"e3b324a93c4b1367f712ee853750df3e0321fedf6ba297e3e4c5238f6e7593dd","duration":51.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.572,"text":"K'A to sun, Olugbala wa,","marked":"K'á tó sùn, Olùgbàlà wa"},{"start":2.952,"end":4.672,"text":"Fun wa n'ibukun ale,","marked":"Fún wa n'ìbùkún alẹ́"},{"start":5.052,"end":6.293,"text":"A jewo ese fun O,","marked":"A jẹ́wọ́ ẹ̀ṣẹ̀ fún Ọ"},{"start":6.673,"end":8.027,"text":"Iwo lo le gba wa la.","marked":"Ìwọ ló lè gbà wá là."}],"end":8.027},{"key":"2","start":8.977,"lines":[{"start":8.977,"end":10.489,"text":"B'ile tile ti su dudu","marked":"B'ilẹ̀ tilẹ̀ ti ṣú dùdù"},{"start":10.869,"end":12.179,"text":"Okun ko le se wa mo","marked":"Okun kò lè ṣe wá mọ́"},{"start":12.559,"end":13.807,"text":"Iwo eniti ki sare,","marked":"Ìwọ ẹniti kí sáré"},{"start":14.187,"end":15.524,"text":"Nso awon enia Re.","marked":"Nsọ àwọn enia Rẹ."}],"end":15.524},{"key":"3","start":16.474,"lines":[{"start":16.474,"end":17.951,"text":"B'iparun tile yi wa ka,","marked":"B'ìparun tilẹ̀ yí wa ká"},{"start":18.331,"end":19.619,"text":"Ti ofa nfo wa koja","marked":"Tí ọfà ńfọ́ wa kọjá"},{"start":19.999,"end":21.287,"text":"Awon Angeli yi wa ka,","marked":"Àwọn Áńgẹ́lì yí wa ká"},{"start":21.667,"end":23.047,"text":"Awa o wa l'ailewu.","marked":"Àwa ò wá l'àìléwu."}],"end":23.047},{"key":"4","start":23.997,"lines":[{"start":23.997,"end":25.644,"text":"Sugbon b'iku ba ji wa pa,","marked":"Ṣùgbọ́n b'ikú bá jí wa pa"},{"start":26.024,"end":27.339,"text":"Ti busun wa d'iboji","marked":"Ti bùsùn wa d'íbojì"},{"start":27.719,"end":29.462,"text":"Je k' ile mo wa sodo Re,","marked":"Jẹ́ k' ilé mo wá sọ́dọ̀ Rẹ"},{"start":29.842,"end":31.368,"text":"L' ayo at' alafia.","marked":"L' ayọ̀ àt' àlàáfíà."}],"end":31.368},{"key":"5","start":32.318,"lines":[{"start":32.318,"end":34.28,"text":"N'irele awa f'ara wa,","marked":"N'ìrẹ̀lẹ̀ àwa f'ara wa"},{"start":34.66,"end":36.371,"text":"Sabe abo Re, Baba","marked":"Ṣabẹ́ abo Rẹ, Bàbá"},{"start":36.751,"end":39.082,"text":"Jesu, 'Wo t'osun bi awa","marked":"Jésù, 'Wo t'osùn bí àwa"},{"start":39.462,"end":40.692,"text":"Se orun wa bi Tire.","marked":"Ṣe ọrùn wa bí Tírè."}],"end":40.692},{"key":"6","start":41.642,"lines":[{"start":41.642,"end":43.28,"text":"Emi Mimo rado bo wa,","marked":"Ẹ̀mí Mímọ́́ ràdọ̀ bò wá"},{"start":43.66,"end":44.851,"text":"Tan 'mole s'okunkun wa,","marked":"Tan 'mole s'òkùnkùn wa"},{"start":45.231,"end":46.87,"text":"Tit'awa o fi ri ojo","marked":"Tít'áwá ò fi rí ọjọ́"},{"start":47.25,"end":48.574,"text":"Imole aiyeraiye.","marked":"Ìmọ́lẹ̀̀ aiyérayé."},{"start":48.954,"end":49.604,"text":"Amin.","marked":"Àmín."}],"end":49.604}]}