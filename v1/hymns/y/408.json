{"v":1,"coll":"y","num":408,"id":"hymn_408","title":"BABA orun, nin'oro Re","duration":39.226,"voices":{"male":{"file":"y-408-male.m4a","bytes":266254,"sha256":"07c2e53ca47c9a4430e3c98ae89f8eb1f804287e4e623a6495105a1fbb3bada6","duration":39.3},"female":{"file":"y-408-female.m4a","bytes":279502,"sha256":"893974cee42c55898eb907859f7edc10d964a994c5e8b997c72c8e2bf6c0a934","duration":39.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.052,"text":"BABA orun, nin'oro Re","marked":"Bàbá ọ̀run, nín'ọ̀rọ̀ Rẹ̀"},{"start":2.432,"end":3.527,"text":"Ni ogo orun ntan","marked":"Ní ògo ọ̀run ńtàn"},{"start":3.907,"end":5.595,"text":"Titi lai l'a o ma yin O","marked":"Títí láí l'á ò mà yín O"},{"start":5.975,"end":7.038,"text":"Fun Bibeli mimo.","marked":"Fún Bíbélì mímọ́́."}],"end":7.038},{"key":"2","start":7.988,"lines":[{"start":7.988,"end":9.333,"text":"Opo 'tunu wa ninu re","marked":"Ọ̀pọ̀ 'tùnú wà nínú rẹ̀"},{"start":9.713,"end":10.64,"text":"Fun okan alare","marked":"Fún ọkàn aláre"},{"start":11.02,"end":13.222,"text":"Gbogbo okan ti ongbe ngbe","marked":"Gbogbo ọkàn tí òǹgbẹ ńgbé"},{"start":13.602,"end":14.678,"text":"Nri omi iye mu.","marked":"Nri omi ìyè mu."}],"end":14.678},{"key":"3","start":15.628,"lines":[{"start":15.628,"end":16.847,"text":"Ninu re l'alafia wa","marked":"Nínú rẹ̀ l'àlàáfíà wà"},{"start":17.227,"end":18.433,"text":"Ti Jesu ti fun wa","marked":"Tí Jésù ti fún wa"},{"start":18.813,"end":20.072,"text":"Iye ainipekun si wa","marked":"Ìyè àìnípẹ̀kun ṣì wà"},{"start":20.452,"end":21.619,"text":"N'nu re fun gbogbo wa.","marked":"N'nu rẹ̀ fún gbogbo wa."}],"end":21.619},{"key":"4","start":22.569,"lines":[{"start":22.569,"end":24.184,"text":"Iba le ma je ayo mi","marked":"Ibà lè má jẹ́ ayọ̀ mi"},{"start":24.564,"end":25.872,"text":"Lati ma ka titi","marked":"Láti má ka títí"},{"start":26.252,"end":27.683,"text":"Ki nma ri ogbon titun ko","marked":"Kí ńmá rí ọgbọ́n titun kọ́"},{"start":28.063,"end":29.305,"text":"N'nu re lojojumo.","marked":"N'nú rẹ̀ lojojumo."}],"end":29.305},{"key":"5","start":30.255,"lines":[{"start":30.255,"end":31.469,"text":"Oluwa Oluko orun","marked":"Olúwa Olùkọ́ ọ̀run"},{"start":31.849,"end":33.287,"text":"Mase jina si mi","marked":"Masẹ̀ jina sí mi"},{"start":33.667,"end":35.104,"text":"Ko mi lati fe oro re","marked":"Kò mí láti fẹ́ ọ̀rọ̀ rẹ"},{"start":35.484,"end":36.757,"text":"Ki nri Jesu nibe.","marked":"Kí ńrí Jésù níbẹ̀."},{"start":37.137,"end":37.676,"text":"Amin.","marked":"Àmín."}],"end":37.676}]}