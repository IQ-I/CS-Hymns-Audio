{"v":1,"coll":"y","num":86,"id":"hymn_86","title":"OLUWA orun on aiye","duration":71.415,"voices":{"male":{"file":"y-86-male.m4a","bytes":505840,"sha256":"20384aeec58557613b20442730f0220fa35ba033161dd1fb0039970f943088d0","duration":71.5},"female":{"file":"y-86-female.m4a","bytes":520609,"sha256":"f42fddbfa011a6cf23825dfde7190618f2b7de5fd2ff9f9ab02a5220180ff57f","duration":71.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.599,"text":"OLUWA orun on aiye","marked":"Olúwa ọ̀run ọ́n aiye"},{"start":1.979,"end":3.912,"text":"Wo n'iyin at'ope ye fun","marked":"Wo n'ìyìn àt'ọpẹ́ yẹ fún"},{"start":4.292,"end":6.178,"text":"Bawo l'a ba ti fe O to?","marked":"Báwo l'á bá ti fẹ́ Ó tó?"},{"start":6.558,"end":7.585,"text":"Onibu‐Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":7.585},{"key":"2","start":8.535,"lines":[{"start":8.535,"end":9.983,"text":"Orun ti nran at'afefe","marked":"Ọrùn tí nràn àt'afẹ́fẹ́"},{"start":10.363,"end":11.878,"text":"Gbogbo eweko nso 'fe Re;","marked":"Gbogbo ewéko ǹṣó 'fẹ́ Rẹ"},{"start":12.258,"end":13.774,"text":"'Wo l'O nmu irugbin dara,","marked":"'Wò l'Ó nmu irúgbìn dára"},{"start":14.154,"end":15.14,"text":"Onibu-Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":15.14},{"key":"3","start":16.09,"lines":[{"start":16.09,"end":17.389,"text":"Fun ara lile wa gbogbo","marked":"Fún ara líle wa gbogbo"},{"start":17.769,"end":19.223,"text":"Fun gbogbo ibukun aiye,","marked":"Fún gbogbo ìbùkún aiye"},{"start":19.603,"end":21.833,"text":"Awa yin O, a si dupe,","marked":"Àwa yìn Ọ́, a sì dúpẹ́"},{"start":22.213,"end":23.162,"text":"Onibu-Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":23.162},{"key":"4","start":24.112,"lines":[{"start":24.112,"end":25.817,"text":"O ko du wa li Omo Re,","marked":"O kò dù wá li Ọmọ Rẹ"},{"start":26.197,"end":28.001,"text":"O fi fun aiye ese wa,","marked":"Ó fi fún àìyẹ ẹ̀ṣẹ̀ wa"},{"start":28.381,"end":29.849,"text":"O si f'ebun gbogbo pelu;","marked":"Ó sì f'ẹ̀bùn gbogbo pẹ̀lú"},{"start":30.229,"end":31.158,"text":"Onibu‐Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":31.158},{"key":"5","start":32.108,"lines":[{"start":32.108,"end":33.402,"text":"O fun wa l'Emi Mimo Re,","marked":"Ó fún wa l'Ẹ̀mí Mímọ́́ Rẹ̀"},{"start":33.782,"end":35.294,"text":"Emi iye at'agbara","marked":"Ẹ̀mí ìyè àt'ágbára"},{"start":35.674,"end":36.881,"text":"O rojo ekun 'bukun Re,","marked":"Ó rọ̀jò ẹkùn 'bùkún Rẹ̀"},{"start":37.261,"end":38.206,"text":"Le wa lori.","marked":"Lè wà lórí."}],"end":38.206},{"key":"6","start":39.156,"lines":[{"start":39.156,"end":40.565,"text":"Fun idariji ese wa,","marked":"Fún ìdáríjì ẹ̀ṣẹ̀ wa"},{"start":40.945,"end":42.218,"text":"Ati fun ireti orun,","marked":"Àti fún ìrètí ọ̀run"},{"start":42.598,"end":44.05,"text":"Kil'ohun t'a ba fi fun O?","marked":"Kil'ohun t'á bá fi fún Ọ?"},{"start":44.43,"end":45.423,"text":"Onibu-Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":45.423},{"key":"7","start":46.373,"lines":[{"start":46.373,"end":48.182,"text":"Owo, ti a nna, ofo ni,","marked":"Owó, tí a ńná, ọ̀fọ̀ ni"},{"start":48.562,"end":49.985,"text":"Sugbon eyit'a fi fun O,","marked":"Ṣùgbọ́n èyít'á fi fún Ọ"},{"start":50.365,"end":51.936,"text":"O je isura tit' aiye","marked":"Ó jẹ́ ìṣúra tít' aiye"},{"start":52.316,"end":53.205,"text":"Onibu-Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":53.205},{"key":"8","start":54.155,"lines":[{"start":54.155,"end":55.699,"text":"Ohun t'a bun O, Oluwa,","marked":"Ohun t'á bùn Ọ́, Olúwa"},{"start":56.079,"end":57.593,"text":"'Wo o san le a pade fun wa","marked":"'Wò ó sàn lé a pàdé fún wa"},{"start":57.973,"end":59.629,"text":"Layo l'a o ta O lore","marked":"Láyọ̀ l'á ò ta Ọ́ lọ́rẹ́"},{"start":60.009,"end":61.118,"text":"Onibu-Ore.","marked":"Oníbú-Ọ̀rẹ́."}],"end":61.118},{"key":"9","start":62.068,"lines":[{"start":62.068,"end":63.946,"text":"Ni odo Re l'a ti san wa,","marked":"Ní ọ̀dọ̀ Rẹ l'á ti ṣàn wá"},{"start":64.326,"end":65.461,"text":"Olorun Olodumare;","marked":"Ọlọ́run Olódùmarè"},{"start":65.841,"end":67.56,"text":"Jek' a le ba O gbe titi","marked":"Jek' á lè bá Ọ gbé títí"},{"start":67.94,"end":68.863,"text":"Onibu-Ore.","marked":"Oníbú-Ọ̀rẹ́."},{"start":69.243,"end":69.865,"text":"Amin.","marked":"Àmín."}],"end":69.865}]}