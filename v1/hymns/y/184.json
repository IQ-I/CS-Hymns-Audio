{"v":1,"coll":"y","num":184,"id":"hymn_184","title":"SUNMO odo wa, Emmanuel","duration":67.024,"voices":{"male":{"file":"y-184-male.m4a","bytes":490230,"sha256":"d962aae5db2b7bef9133e723d62e68389edd10ccedfe3ad9f09adb0208f19c36","duration":67.1},"female":{"file":"y-184-female.m4a","bytes":505482,"sha256":"1b7c31c9168339ec6fa140006691a5aab29c4722a26be1bfb261e4e943bbff4f","duration":67.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.323,"text":"SUNMO odo wa, Emmanuel","marked":"Súnmọ́ ọ̀dọ̀ wa, Emmanuel"},{"start":2.703,"end":4.571,"text":"Wa, ra Israeli pada","marked":"Wá, ra Ísírẹ́lì padà"},{"start":4.951,"end":6.513,"text":"T'o nsofo li oko eru","marked":"T'ó ńsòfò li oko ẹrú"},{"start":6.893,"end":8.437,"text":"Titi Jesu y'o tun pada.","marked":"Títí Jésù y'ó tún padà."},{"start":8.817,"end":10.779,"text":"Egbe:  E yo eyo! Emmanuel","marked":"Ẹ yọ ẹyọ! Emmanuel"},{"start":11.159,"end":12.98,"text":"Y'o wa s'odo wa Israeli.","marked":"Y'ó wá s'odo wa Ísírẹ́lì."}],"end":12.98},{"key":"CHORUS","start":13.93,"lines":[{"start":13.93,"end":16.166,"text":"E yo eyo! Emmanuel","marked":"Ẹ yọ ẹyọ! Emmanuel"},{"start":16.546,"end":18.222,"text":"Y'o wa s'odo wa Israeli.","marked":"Y'ó wá s'odo wa Ísírẹ́lì."}],"end":18.222},{"key":"2","start":19.172,"lines":[{"start":19.172,"end":21.096,"text":"Wa, Opa alade Jesse","marked":"Wá, Ópà aládé Jesse"},{"start":21.476,"end":23.068,"text":"K'o gba wa I'owo ota wa","marked":"K'ó gbà wá l'ọwọ́ ọ̀tá wa"},{"start":23.448,"end":24.908,"text":"Gba wa low'orun apadi","marked":"Gbà wá lów'ọ̀run àpádì"},{"start":25.288,"end":27.063,"text":"Fun wa ni 'segun l'ori 'ku.","marked":"Fún wa ní 'ṣẹ́gun l'orí 'kú."},{"start":27.443,"end":29.531,"text":"Egbe:  E yo eyo! Emmanuel...","marked":"Ẹ yọ ẹyọ! Emmanuel"}],"end":29.531},{"key":"3","start":30.481,"lines":[{"start":30.481,"end":32.176,"text":"Sunmo wa, Wo ila‐orun","marked":"Súnmọ́ wa, Wọ ìlà-ọ̀run"},{"start":32.556,"end":34.072,"text":"Ki bibo Re se 'tunu wa","marked":"Kí bíbọ̀ Rẹ̀ ṣe 'tùnú wá"},{"start":34.452,"end":35.828,"text":"Tu gbogbo isudede ka","marked":"Tu gbogbo ìṣùdédé ká"},{"start":36.208,"end":37.842,"text":"M'ese ati egbe kuro.","marked":"M'ẹsẹ̀ àti ẹgbẹ́ kúrò."},{"start":38.222,"end":40.287,"text":"Egbe:  E yo eyo! Emmanuel...","marked":"Ẹ yọ ẹyọ! Emmanuel"}],"end":40.287},{"key":"4","start":41.237,"lines":[{"start":41.237,"end":42.693,"text":"Wa Omo 'lekun Dafidi","marked":"Wá Ọmọ 'lẹ́kùn Dáfídì"},{"start":43.073,"end":45.296,"text":"'Lekun orun y'o si fun O:","marked":"'Lẹ́kùn ọ̀run y'ó sì fún Ọ"},{"start":45.676,"end":47.015,"text":"Tun ona orun se fun wa","marked":"Tún ọ̀nà ọ̀run ṣe fún wa"},{"start":47.395,"end":48.756,"text":"Jo se ona osi fun wa.","marked":"Jọ ṣe ọ̀nà òṣì fún wa."},{"start":49.136,"end":51.422,"text":"Egbe:  E yo eyo! Emmanuel...","marked":"Ẹ yọ ẹyọ! Emmanuel"}],"end":51.422},{"key":"5","start":52.372,"lines":[{"start":52.372,"end":53.889,"text":"Sunmo wa Oluwa ipa,","marked":"Súnmọ́ wá Olúwa ipa"},{"start":54.269,"end":55.944,"text":"T'o f'ofin fun enia Re","marked":"T'ó f'òfin fún enia Rẹ"},{"start":56.324,"end":57.974,"text":"Nigbani l'ori oke Sinai,","marked":"Nígbani l'orí òkè Sínáì"},{"start":58.354,"end":59.752,"text":"'Nu eru at'agbara nla.","marked":"'Nu ẹrù àt'ágbára ńlá."},{"start":60.132,"end":62.39,"text":"Egbe:  E yo eyo! Emmanuel","marked":"Ẹ yọ ẹyọ! Emmanuel"},{"start":62.77,"end":64.477,"text":"Y'o wa s'odo wa Israeli.","marked":"Y'ó wá s'odo wa Ísírẹ́lì."},{"start":64.857,"end":65.474,"text":"Amin.","marked":"Àmín."}],"end":65.474}]}