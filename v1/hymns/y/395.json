{"v":1,"coll":"y","num":395,"id":"hymn_395","title":"BABA orun jinle 'fe Re","duration":37.13,"voices":{"male":{"file":"y-395-male.m4a","bytes":264633,"sha256":"87776f65031c70c0f1a9ba3c1289000622781b6a88cb74e927e7dbb25e0115f1","duration":37.2},"female":{"file":"y-395-female.m4a","bytes":270697,"sha256":"4abf10f29080ae2edbecd336a3be38a093e97582f367de24a10fd531a9f6b335","duration":37.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.609,"text":"BABA orun jinle 'fe Re","marked":"Bàbá ọ̀run jinlẹ̀ 'fẹ́ Rẹ"},{"start":1.989,"end":3.625,"text":"L'o wa Oludande fun wa","marked":"L'ó wá Olùdáǹdè fún wa"},{"start":4.005,"end":5.492,"text":"A wole niwaju 'te Re","marked":"A wọlé níwájú 'tẹ̀ Rẹ"},{"start":5.872,"end":7.75,"text":"Nawo dariji Re si wa.","marked":"Náwó dariji Rẹ̀ sí wa."}],"end":7.75},{"key":"2","start":8.7,"lines":[{"start":8.7,"end":10.767,"text":"Omo Baba, t'O d'Enia","marked":"Ọmọ Bàbá, t'Ó d'Enia"},{"start":11.147,"end":12.485,"text":"Woli, Alufa, Oluwa","marked":"Wòlí, Àlùfà, Olúwa"},{"start":12.865,"end":14.525,"text":"A wole niwaju 'te Re","marked":"A wọlé níwájú 'tẹ̀ Rẹ"},{"start":14.905,"end":16.19,"text":"Nawo igbala Re si wa","marked":"Náwó ìgbàlà Rẹ ṣì wà"}],"end":16.19},{"key":"3","start":17.14,"lines":[{"start":17.14,"end":18.786,"text":"Emi at'aiyeraiye lai","marked":"Èmi àt'aiyérayé láì"},{"start":19.166,"end":21.017,"text":"Emi ti nji oku dide","marked":"Èmi ti ńjí òkú dìde"},{"start":21.397,"end":23.102,"text":"A wole niwaju 'te Re","marked":"A wọlé níwájú 'tẹ̀ Rẹ"},{"start":23.482,"end":24.971,"text":"Nawo isoji Re si wa.","marked":"Náwó ìsọjí Rẹ sì wà."}],"end":24.971},{"key":"4","start":25.921,"lines":[{"start":25.921,"end":29.044,"text":"Jehovah, Baba, Omo, Emi","marked":"Jehovah, Bàbá, Ọmọ, Èmi"},{"start":29.424,"end":30.948,"text":"'Yanu 'jinle Metalokun","marked":"'Yanu 'jinlẹ̀ Mẹ́talọ́kùn"},{"start":31.328,"end":32.818,"text":"A wole niwaju 'te Re","marked":"A wọlé níwájú 'tẹ̀ Rẹ"},{"start":33.198,"end":34.583,"text":"Nawo emi ye re si wa.","marked":"Náwó ẹ̀mí yé rẹ sí wa."},{"start":34.963,"end":35.58,"text":"Amin.","marked":"Àmín."}],"end":35.58}]}