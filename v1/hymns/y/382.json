{"v":1,"coll":"y","num":382,"id":"hymn_382","title":"EMI anu, oto, ife","duration":27.481,"voices":{"male":{"file":"y-382-male.m4a","bytes":194685,"sha256":"d4408ec90b9841cc5bc538c32548d815265e07029eda8adc1e56188520d9b2b1","duration":27.5},"female":{"file":"y-382-female.m4a","bytes":199937,"sha256":"be7e221051b1c278e4c85cec4df50341e16671585473eacc48468ee930da452f","duration":27.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.689,"text":"EMI anu, oto, ife","marked":"Ẹ̀mí ànú, ọ̀tọ̀, ìfẹ́"},{"start":3.069,"end":5.069,"text":"Ran aghara Re t'oke wa","marked":"Ran aghara Rẹ t'òkè wá"},{"start":5.449,"end":6.712,"text":"Mu iyanu ojo oni","marked":"Mú ìyanu ọjọ́ òní"},{"start":7.092,"end":8.401,"text":"De opin akoko gbogbo.","marked":"Dé òpin àkókò gbogbo."}],"end":8.401},{"key":"2","start":9.351,"lines":[{"start":9.351,"end":10.591,"text":"Ki gbogbo orile ede","marked":"Kí gbogbo orílẹ̀ èdè"},{"start":10.971,"end":12.536,"text":"Ko orin ogo Olorun","marked":"Kọ orin ògo Ọlọ́run"},{"start":12.916,"end":14.569,"text":"Ki a si ko gbogbo aiye","marked":"Kí a sì kó gbogbo aiye"},{"start":14.949,"end":16.448,"text":"N'ise Olurapada wa.","marked":"N'iṣẹ́ Olùràpadà wa."}],"end":16.448},{"key":"3","start":17.398,"lines":[{"start":17.398,"end":18.97,"text":"Olutunu at'Amona","marked":"Olùtùnú at'Amọ̀nà"},{"start":19.35,"end":20.866,"text":"Joha ijo enia Re","marked":"Jòhà ìjọ enia Rẹ"},{"start":21.246,"end":22.826,"text":"K'araiye mo ibukun Re","marked":"K'araiye mọ́ ìbùkún Rẹ"},{"start":23.206,"end":25.014,"text":"Emi anu, oto, ife.","marked":"Ẹ̀mí ànú, ọ̀tọ̀, ìfẹ́."},{"start":25.394,"end":25.931,"text":"Amin.","marked":"Àmín."}],"end":25.931}]}