{"v":1,"coll":"y","num":178,"id":"hymn_178","title":"lWO mbo wa, Oluwa","duration":61.829,"voices":{"male":{"file":"y-178-male.m4a","bytes":440693,"sha256":"f06145175e479124ff0325284f3c6281b557ad05da33a7273a7c26fd4d3704ba","duration":61.9},"female":{"file":"y-178-female.m4a","bytes":447022,"sha256":"3b223199692ed4d065b0942f1ad2623f43d84582b0cce7df7cc25bfe49627992","duration":61.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.711,"text":"lWO mbo wa, Oluwa","marked":"Ìwọ ḿbọ́ wa, Olúwa"},{"start":2.091,"end":3.466,"text":"lwo mbo wa, Oba mi","marked":"lwo ḿbọ̀ wá, Ọba mi"},{"start":3.846,"end":4.939,"text":"Ninu 'tansan ewa Re","marked":"Nínú 'tànṣán ẹwà Rẹ"},{"start":5.319,"end":6.576,"text":"Ni titayo Ogo re","marked":"Ní títayọ Ògo rẹ"},{"start":6.956,"end":8.547,"text":"Mura de, mura de.","marked":"Múra de, múra de."}],"end":8.547},{"key":"CHORUS","start":9.497,"lines":[{"start":9.497,"end":10.862,"text":"Oko 'yawo f'ere de;","marked":"Ọkọ 'yàwó f'ère dé"},{"start":11.242,"end":12.847,"text":"L'oru ni igbe yio ta,","marked":"L'oru ni igbe yio ta"},{"start":13.227,"end":14.816,"text":"Mura l'o ko okan mi.","marked":"Múra l'ó kọ́ ọkàn mi."}],"end":14.816},{"key":"2","start":15.766,"lines":[{"start":15.766,"end":17.305,"text":"Wundia to s'oloto","marked":"Wúńdíá tó s'oloto"},{"start":17.685,"end":19.167,"text":"Ti mura nigbagbogbo","marked":"Ti múra nígbàgbogbo"},{"start":19.547,"end":20.814,"text":"Igba ayo sunmole","marked":"Ìgbà ayọ̀ sùnmọ́lẹ̀"},{"start":21.194,"end":22.589,"text":"lgba awe y'odopin.","marked":"lgba awẹ́ y'odòpin."}],"end":22.589},{"key":"3","start":23.539,"lines":[{"start":23.539,"end":25.105,"text":"lwo mbo wa nitoto","marked":"lwo ḿbọ̀ wà nítòtó"},{"start":25.485,"end":26.684,"text":"A o pade Re lona","marked":"A ó pàdé Rẹ̀ lọ́nà"},{"start":27.064,"end":29.012,"text":"A o ri O, a mo O,","marked":"A ò rí O, a mọ̀ Ọ́"},{"start":29.392,"end":30.912,"text":"Ni 'dapo mimo julo.","marked":"Ní 'dàpọ̀ mímọ́́ jùlọ."}],"end":30.912},{"key":"4","start":31.862,"lines":[{"start":31.862,"end":33.266,"text":"Wura ko ni le gba O,","marked":"Wúrà kò ní lè gbà Ọ́"},{"start":33.646,"end":34.873,"text":"Ohun asan l'oro je","marked":"Ohun asán l'ọrọ́ jẹ́"},{"start":35.253,"end":36.637,"text":"lgbagbo ti ko mira","marked":"lgbagbo tí kò mira"},{"start":37.017,"end":38.428,"text":"Ni y'o gb'ade nikehin.","marked":"Ní y'ó gb'adé níkẹhin."}],"end":38.428},{"key":"5","start":39.378,"lines":[{"start":39.378,"end":40.528,"text":"Wundia mewa l'a yan","marked":"Wúńdíá mẹ́wà l'á yan"},{"start":40.908,"end":42.135,"text":"Marun pere lo yege","marked":"Márùn péré ló yege"},{"start":42.515,"end":43.987,"text":"Marun ko ni ororo","marked":"Márùn kò ní òróró"},{"start":44.367,"end":45.491,"text":"lna emi won ti ku.","marked":"lnà ẹ̀mí wọn ti kú."}],"end":45.491},{"key":"6","start":46.441,"lines":[{"start":46.441,"end":47.582,"text":"'Binu Re tobi pupo","marked":"'Bínú Rẹ̀ tóbi púpọ̀"},{"start":47.962,"end":49.35,"text":"Si awon t'o gbagbe Re","marked":"Sí àwọn t'ó gbàgbé Rẹ"},{"start":49.73,"end":50.839,"text":"Ewure apa osi","marked":"Ewúrẹ́ apá òsì"},{"start":51.219,"end":52.571,"text":"L'ao se won nikehin","marked":"L'áo ṣe wọ́n nikehin"}],"end":52.571},{"key":"7","start":53.521,"lines":[{"start":53.521,"end":55.09,"text":"Jowo se wa l'ayanfe,","marked":"Jọ̀wọ́ ṣe wá l'àyànfẹ́"},{"start":55.47,"end":56.726,"text":"Ki a le ba O joba","marked":"Kí á lè bá Ọ jọba"},{"start":57.106,"end":58.384,"text":"Angeli l'ao ba kegbe","marked":"Áńgẹ́lì l'áò bá kẹ́gbẹ́"},{"start":58.764,"end":60.28,"text":"Ti a o gbe aiku wo.","marked":"Tí a ó gbé àìkú wọ̀."}],"end":60.28}]}