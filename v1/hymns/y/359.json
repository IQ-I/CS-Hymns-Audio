{"v":1,"coll":"y","num":359,"id":"hymn_359","title":"Ejuba Olorun, wa, Jah","duration":69.633,"voices":{"male":{"file":"y-359-male.m4a","bytes":498126,"sha256":"b793ca087cb373edc1e07df5790147415b8d7f5082b40996df333989aad4c4e8","duration":69.7},"female":{"file":"y-359-female.m4a","bytes":512843,"sha256":"5366a106f220d894715653ca792cebe7a7c99df59d003e33c170a2ce373b4a8f","duration":69.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.06,"text":"Ejuba Olorun, wa, Jah","marked":"Ẹjúbà Ọlọ́run, wa, Jah"},{"start":2.44,"end":3.59,"text":"Oba onife julo","marked":"Ọba onífẹ́ jùlọ"},{"start":3.97,"end":5.506,"text":"Olubori, Ajabori,","marked":"Olúborí, Àjàborí"},{"start":5.886,"end":7.294,"text":"Oba Orun on Aiye.","marked":"Ọba Ọ̀run on Aiye."}],"end":7.294},{"key":"CHORUS","start":8.244,"lines":[{"start":8.244,"end":9.662,"text":"Ijinle loro na,","marked":"Ìjìnlẹ̀ lọ̀rọ̀ ná"},{"start":10.042,"end":11.284,"text":"Awamaridi si ni.","marked":"Àwámáridì sì ni."}],"end":11.284},{"key":"2","start":12.234,"lines":[{"start":12.234,"end":13.74,"text":"Bayi l'o dawon eda Re","marked":"Báyì l'ó dáwọn ẹ̀dà Rẹ"},{"start":14.12,"end":15.33,"text":"B'o ti wu O l'o da won","marked":"B'ó ti wù Ọ́ l'ó dá wọn"},{"start":15.71,"end":16.98,"text":"Awimayehun sa ni O","marked":"Awímáyẹhùn sà ni O"},{"start":17.36,"end":18.668,"text":"Awamaridi ni O.","marked":"Àwámáridì ni O."}],"end":18.668},{"key":"3","start":19.618,"lines":[{"start":19.618,"end":21.839,"text":"Nibit'ona ko ti si ri","marked":"Níbit'ọ́nà kò ti ṣì rí"},{"start":22.219,"end":23.465,"text":"Nibe ni 'joko mi wa","marked":"Níbẹ̀ ni 'jókò mi wà"},{"start":23.845,"end":25.708,"text":"Nip'agbara at'asa mi","marked":"Nip'agbara àt'àṣà mi"},{"start":26.088,"end":28.013,"text":"Larin awon enia mi.","marked":"Lárin àwọn enia mi."}],"end":28.013},{"key":"4","start":28.963,"lines":[{"start":28.963,"end":30.255,"text":"A ha ri eni le pada","marked":"A ha rí ẹni lé padà"},{"start":30.635,"end":31.825,"text":"Gba mba nsise ogo mi","marked":"Gba ḿbá ńṣiṣẹ́ ògo mi"},{"start":32.205,"end":33.616,"text":"Awon Angel' to l'agbara","marked":"Àwọn Angel' tó l'ágbára"},{"start":33.996,"end":35.681,"text":"Nwon ko je dan eyi wo.","marked":"Nwọn kò jẹ́ dán èyí wò."}],"end":35.681},{"key":"5","start":36.631,"lines":[{"start":36.631,"end":38.731,"text":"Lusifa t'o l'agbara ju","marked":"Lúsífà t'ó l'ágbára jù"},{"start":39.111,"end":40.216,"text":"Gbogbo awon Angel' lo","marked":"Gbogbo àwọn Angel' lọ"},{"start":40.596,"end":41.978,"text":"O f'owo pa 'da mi loju","marked":"Ó f'ọwọ́ pa 'dá mi lójú"},{"start":42.358,"end":43.608,"text":"O si d'eni ifibu.","marked":"Ó sì d'ẹni ìfibú."}],"end":43.608},{"key":"6","start":44.558,"lines":[{"start":44.558,"end":45.884,"text":"Egbegberun ogun orun","marked":"Egbegberun ogún ọ̀run"},{"start":46.264,"end":47.684,"text":"L'o nso ti agbara mi,","marked":"L'ó ńṣó ti agbára mi"},{"start":48.064,"end":49.456,"text":"Ogo, Ola ati 'pa mi","marked":"Ògo, Ọlá àti 'pa mí"},{"start":49.836,"end":51.534,"text":"Nwon njuba Agbara mi.","marked":"Nwọ̀n njuba Agbára mi."}],"end":51.534},{"key":"7","start":52.484,"lines":[{"start":52.484,"end":54.092,"text":"Sibe Emi ko yan eyi","marked":"Síbẹ̀ Èmi kò yan èyí"},{"start":54.472,"end":55.835,"text":"T'o ga julo ninu won","marked":"T'ó ga jùlọ nínú wọn"},{"start":56.215,"end":58.031,"text":"Sugbon Maikel t'o kereju","marked":"Ṣùgbọ́n Maikel t'ó kéréjú"},{"start":58.411,"end":59.709,"text":"Ni mo gbega ninu won.","marked":"Ni mo gbega nínú wọn."}],"end":59.709},{"key":"8","start":60.659,"lines":[{"start":60.659,"end":62.162,"text":"Agbara ninu Agbara","marked":"Agbára nínú Agbára"},{"start":62.542,"end":63.969,"text":"Ogo, Ola at'ipa","marked":"Ògo, Ọlá àt'ipa"},{"start":64.349,"end":66.408,"text":"Teru, teru, tifetife,","marked":"Tẹ́rù, tẹrú, tìfẹ́tìfẹ́"},{"start":66.788,"end":68.083,"text":"lfe si l'oruko mi.","marked":"lfe si l'oruko mi."}],"end":68.083}]}