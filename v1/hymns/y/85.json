{"v":1,"coll":"y","num":85,"id":"hymn_85","title":"O DA mi loju, Jesu n' temi","duration":42.063,"voices":{"male":{"file":"y-85-male.m4a","bytes":309229,"sha256":"1a32074e85ead996ed15f8d97638afd5e3d24a932fabd1f4470213ab188f1080","duration":42.1},"female":{"file":"y-85-female.m4a","bytes":321548,"sha256":"7d9c5578dff1a437df0230c2d5190a0e9c96e5c5553c941c566ce63c381b453e","duration":42.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.974,"text":"O DA mi loju, Jesu n' temi","marked":"Ó Dá mi lójú, Jésù ń' tẹ̀mí"},{"start":3.354,"end":5.113,"text":"Itowo adun orun l'eyi je","marked":"Ìtọwọ́ adùn ọ̀run l'èyí jẹ́"},{"start":5.493,"end":7.077,"text":"Mo di ajogun igbala nla","marked":"Mo di ajogún ìgbàlà ńlá"},{"start":7.457,"end":9.393,"text":"Eje Re we mi, a tun mi bi.","marked":"Ẹ̀jẹ̀ Rẹ̀ wé mi, a tún mi bí."}],"end":9.393},{"key":"CHORUS","start":10.343,"lines":[{"start":10.343,"end":11.824,"text":"Eyi ni 'tan mi at 'orin mi","marked":"Èyí ni 'tàn mí àt 'orin mi"},{"start":12.204,"end":14.207,"text":"Ngo yin Olugbala mi titi","marked":"Ngo yín Olùgbàlà mi títí"},{"start":14.587,"end":16.337,"text":"Eyi ni 'tan mi at' orin mi","marked":"Èyí ni 'tàn mí àt' orin mi"},{"start":16.717,"end":18.048,"text":"Ngo yin Olugbala mi titi.","marked":"Ngo yin Olùgbàlà mi títí."}],"end":18.048},{"key":"2","start":18.998,"lines":[{"start":18.998,"end":20.779,"text":"'Teriba pipe, ayo pipe","marked":"'Tèríbà pípé, ayọ̀ pípé"},{"start":21.159,"end":22.723,"text":"Mo n ri iran ogo bibo Re","marked":"Mo ń rí ìran ògo bíbọ̀ Rẹ"},{"start":23.103,"end":24.627,"text":"Angeli n mu ihin didun wa","marked":"Áńgẹ́lì ń mú ìhìn dídùn wá"},{"start":25.007,"end":26.606,"text":"Ti ife at'aanu Re si mi","marked":"Ti ife àt'àánú Rẹ sí mi"},{"start":26.986,"end":28.178,"text":"Egbe:  Eyi ni 'tan mi...","marked":"Èyí ni 'tán mi"}],"end":28.178},{"key":"3","start":29.128,"lines":[{"start":29.128,"end":31.441,"text":"“Teriba pipe, isin mi ni","marked":"Tẹríbà pípẹ́, ìsìn mi ni"},{"start":31.821,"end":33.666,"text":"Ninu Kristi mo d'eni 'bukun","marked":"Nínú Kristi mo d'ẹni 'bùkún"},{"start":34.046,"end":35.882,"text":"N'igba gbogbo mo n w'oke orun","marked":"N'ígbà gbogbo mò ń w'òkè ọ̀run"},{"start":36.262,"end":38.086,"text":"Mo si kun f'oore at'ife Re.","marked":"Mo sì kún f'oore àt'ìfẹ́ Rẹ̀."},{"start":38.466,"end":39.555,"text":"Egbe:  Eyi ni 'tan mi...","marked":"Èyí ni 'tán mi"},{"start":39.935,"end":40.513,"text":"Amin.","marked":"Àmín."}],"end":40.513}]}