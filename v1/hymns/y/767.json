{"v":1,"coll":"y","num":767,"id":"hymn_767","title":"EGBEGBERUN aimoye","duration":58.837,"voices":{"male":{"file":"y-767-male.m4a","bytes":433472,"sha256":"2318e8d1c5b76cbe691d73e8300933490a92db4e3f67beced615e0da19433a8a","duration":58.9},"female":{"file":"y-767-female.m4a","bytes":447133,"sha256":"723d87bbe38112f2d47a09cbad764828f245edc71788c3b3952c8af90221af9c","duration":58.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.32,"text":"EGBEGBERUN aimoye","marked":"Egbegberun àìmọye"},{"start":1.7,"end":2.637,"text":"Nwon wo aso ala","marked":"Nwọ̀n wọ aṣọ àlà"},{"start":3.017,"end":4.349,"text":"Ogun awon t'a rapada","marked":"Ogun àwọn t'á ràpadà"},{"start":4.729,"end":6.216,"text":"Nwon kun 'bi mole na","marked":"Nwọ̀n kún 'bí mọ́lẹ̀ ná"},{"start":6.596,"end":7.68,"text":"Ija won pelu ese","marked":"Ìjà wọn pẹ̀lú ẹ̀ṣẹ̀"},{"start":8.06,"end":9.189,"text":"At'iku ti pari","marked":"Àt'ikú ti parí"},{"start":9.569,"end":11.033,"text":"E si 'lekun wura sile","marked":"Ẹ ṣí 'lẹ́kùn wúrà sílẹ̀"},{"start":11.413,"end":12.789,"text":"Fun awon asegun.","marked":"Fún àwọn aṣẹ́gun."}],"end":12.789},{"key":"2","start":13.739,"lines":[{"start":13.739,"end":14.754,"text":"Iro Halleluya won","marked":"Irọ́ Hallelúyà wọn"},{"start":15.134,"end":16.577,"text":"L'o gb'aiye orun kan","marked":"L'ó gb'aiye ọrùn kan"},{"start":16.957,"end":18.669,"text":"Iro egbegberun Harpu","marked":"Irọ́ ẹgbẹgbẹ̀rún Harpu"},{"start":19.049,"end":20.358,"text":"Ndun pe 'segun de tan","marked":"Ndún pé 'ṣẹ́gun dé tán"},{"start":20.738,"end":22.042,"text":"Ojo t'a s'eda aiye","marked":"Ọjọ́ t'á s'édá aiye"},{"start":22.422,"end":23.797,"text":"T'a da oril'ede","marked":"T'á da oril'ede"},{"start":24.177,"end":25.633,"text":"Ayo nla pa 'banuje re","marked":"Ayọ̀ ńlá pa 'banújẹ́ rẹ́"},{"start":26.013,"end":27.316,"text":"Ti a fun ni kikun.","marked":"Tí a fún ní kíkún."}],"end":27.316},{"key":"3","start":28.266,"lines":[{"start":28.266,"end":30.155,"text":"A! ayo t'a ko le so","marked":"A! ayò t'á kò lè so"},{"start":30.535,"end":31.724,"text":"L'eti bebe Kenaan","marked":"L'etí bẹbẹ Kénáán"},{"start":32.104,"end":33.901,"text":"Idapo nla wo lo to yi","marked":"Ìdàpọ̀ ńlá wo ló tó yí"},{"start":34.281,"end":35.513,"text":"Ibi t'a ki pinya","marked":"Ibi t'á ki pínyà"},{"start":35.893,"end":37.339,"text":"Oju t'o kun f'ekun ri","marked":"Ojú t'ó kún f'ẹkùn rí"},{"start":37.719,"end":39.108,"text":"Y'o tu mo'le ayo","marked":"Y'ó tú mo'lé ayọ̀"},{"start":39.488,"end":40.946,"text":"Ki yio si alaini baba","marked":"Kí yio si aláìní bàbá"},{"start":41.326,"end":42.685,"text":"Opo ki yio si mo.","marked":"Ọ̀pọ̀ ki yio si mọ́."}],"end":42.685},{"key":"4","start":43.635,"lines":[{"start":43.635,"end":44.986,"text":"Mu igbala nla Re wa","marked":"Mú ìgbàlà ńlá Rẹ wá"},{"start":45.366,"end":46.731,"text":"Od'agutan t'a pa","marked":"Od'ágùtàn t'á pa"},{"start":47.111,"end":48.767,"text":"So 'ye awon ayanfe Re","marked":"Ṣó 'yẹ àwọn àyànfẹ́ Rẹ"},{"start":49.147,"end":50.389,"text":"Mu 'pa Re k'o joba","marked":"Mu 'pa Rẹ k'ó jọba"},{"start":50.769,"end":52.268,"text":"Wa, ife oril'ede","marked":"Wà, ìfẹ́ oril'ede"},{"start":52.648,"end":53.916,"text":"Da onde Re sile","marked":"Dá òǹdè Rẹ sílẹ̀"},{"start":54.296,"end":55.706,"text":"Wa fi ami' leri Re han","marked":"Wá fi àmì' lérí Rẹ̀ hàn"},{"start":56.086,"end":57.287,"text":"Wa, Olugbala wa.","marked":"Wá, Olùgbàlà wa."}],"end":57.287}]}