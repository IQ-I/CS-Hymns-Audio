{"v":1,"coll":"y","num":70,"id":"hymn_70","title":"ELESE wa sodo Jesu","duration":71.934,"voices":{"male":{"file":"y-70-male.m4a","bytes":513227,"sha256":"6b0b2aca73b5251500ce6e65d8aaee0a878c35ec4f2a4d77369fd79d14ce7f4b","duration":72.0},"female":{"file":"y-70-female.m4a","bytes":538208,"sha256":"f37888ad59313e43e954df714bf1354393a0027261934126cf2066b21b65a15c","duration":72.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.83,"text":"ELESE wa sodo Jesu","marked":"Ẹlẹ́ṣẹ̀ wá sọ́dọ̀ Jésù"},{"start":2.21,"end":3.456,"text":"Fun igbala re lofe","marked":"Fún ìgbàlà rẹ lọ́fẹ́"},{"start":3.836,"end":5.508,"text":"On pe o ni ohun kele","marked":"Ọ̀n pé ó ní ohun kẹ́lẹ́"},{"start":5.888,"end":7.196,"text":"Pe omo ma sako mo.","marked":"Pé ọmọ má ṣáko mọ́."}],"end":7.196},{"key":"CHORUS","start":8.146,"lines":[{"start":8.146,"end":10.108,"text":"Kil' ao ro! Kil' ao so?","marked":"Kil' aó rò! Kil' aó sọ?"},{"start":10.488,"end":11.792,"text":"'Gbati Baba ba npe wa,","marked":"'Gbàtì Bàbá bá ńpẹ́ wa"},{"start":12.172,"end":14.152,"text":"Pe omo, siwo ko ma bo","marked":"Pé ọmọ, ṣíwọ́ kó má bọ́"},{"start":14.532,"end":15.853,"text":"Wa jihin ise re o.","marked":"Wá jíhìn iṣẹ́ rẹ o."}],"end":15.853},{"key":"2","start":16.803,"lines":[{"start":16.803,"end":18.368,"text":"Elese wa sodo Jesu,","marked":"Ẹlẹ́ṣẹ̀ wá sọ́dọ̀ Jésù"},{"start":18.748,"end":19.867,"text":"Loni lojo igbala","marked":"Lọ́ni lọ́jọ́ ìgbàlà"},{"start":20.247,"end":21.627,"text":"Yara ma si je ko pe ju","marked":"Yàrá má sì jẹ́ kó pẹ́ jù"},{"start":22.007,"end":23.204,"text":"lye mbe fun o loni.","marked":"lye ḿbẹ fún ọ lónì."}],"end":23.204},{"key":"3","start":24.154,"lines":[{"start":24.154,"end":25.81,"text":"Serafu damure giri","marked":"Séráfù dámùrè gírí"},{"start":26.19,"end":27.943,"text":"Kerubu ma jafara,","marked":"Kérúbù má jáfara"},{"start":28.323,"end":29.553,"text":"Opo okan ti se gbe lo,","marked":"Ọ̀pọ̀ ọkàn ti ṣe gbé lọ"},{"start":29.933,"end":31.45,"text":"Wa, e wa s'agbo Jesu.","marked":"Wá, ẹ wá s'ágbó Jésù."}],"end":31.45},{"key":"4","start":32.4,"lines":[{"start":32.4,"end":33.699,"text":"Jesu Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":34.079,"end":35.247,"text":"lfe Re ti sowon to,","marked":"lfẹ́ Rẹ ti ṣọ̀wọ́n tó"},{"start":35.627,"end":37.08,"text":"Ti O da Egbe yi sile","marked":"Tí Ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":37.46,"end":38.973,"text":"Pe k'a le ri igbala.","marked":"Pé k'á lè rí ìgbàlà."}],"end":38.973},{"key":"5","start":39.923,"lines":[{"start":39.923,"end":41.621,"text":"Aje nyonu, oso nyonu","marked":"Ajé nyonu, ọ̀ṣọ́ nyonu"},{"start":42.001,"end":43.393,"text":"Wa sabe abo Jesu","marked":"Wá sábẹ́ abo Jésù"},{"start":43.773,"end":45.172,"text":"Ohun ibi t'o wuk'o je","marked":"Ohun ibi t'ó wúk'ó jẹ́"},{"start":45.552,"end":46.835,"text":"Wa si egbe Serafu.","marked":"Wá sí ẹgbẹ́ Séráfù."}],"end":46.835},{"key":"6","start":47.785,"lines":[{"start":47.785,"end":49.155,"text":"Elese ronu piwada","marked":"Ẹlẹ́ṣẹ̀ ronú pìwàdà"},{"start":49.535,"end":50.74,"text":"Ki akoko to koja","marked":"Kí àkókò tó kọjá"},{"start":51.12,"end":52.653,"text":"Ki metalokan to pe o,","marked":"Kí Mẹ́talọ́kan tó pé o"},{"start":53.033,"end":54.353,"text":"Pe wa siro ise re.","marked":"Pẹ́ wa ṣírò iṣẹ́ rẹ."}],"end":54.353},{"key":"7","start":55.303,"lines":[{"start":55.303,"end":57.105,"text":"Ka le gbo nikehin ojo","marked":"Ká lè gbọ́ nikehin ọjọ́"},{"start":57.485,"end":58.553,"text":"Pe o se omo rere","marked":"Pé o ṣe ọmọ rere"},{"start":58.933,"end":60.446,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":60.826,"end":62.265,"text":"Bo s'ayo Oluwa re.","marked":"Bó s'àyò Olúwa rẹ."}],"end":62.265},{"key":"8","start":63.215,"lines":[{"start":63.215,"end":64.45,"text":"Orin Halle Halleluya,","marked":"Orin Halle Hallelúyà"},{"start":64.83,"end":66.207,"text":"L'a o ko ni'te baba","marked":"L'á ò kò ní'tẹ bàbá"},{"start":66.587,"end":68.111,"text":"'Wo n'iyin at'ope ye fun","marked":"'Wò ń'ìyìn àt'ọpẹ́ yẹ fún"},{"start":68.491,"end":70.384,"text":"Ti t' aiye ainipekun.","marked":"Ti t' aiye àìnípẹ̀kun."}],"end":70.384}]}