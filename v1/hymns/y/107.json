{"v":1,"coll":"y","num":107,"id":"hymn_107","title":"GBO orin 'yin dida aye","duration":93.169,"voices":{"male":{"file":"y-107-male.m4a","bytes":693177,"sha256":"3f7e8df73bb7665621d70f62c7fe221ac0299c31cb6ea2223895dc7b794115cb","duration":93.2},"female":{"file":"y-107-female.m4a","bytes":709269,"sha256":"8f2a9234f16d84f9c80015a2fb75f4d8d245601da0f6484a6be0a8d96ef23474","duration":93.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.721,"text":"GBO orin 'yin dida aye","marked":"Gbọ́ orin 'yín dídá ayé"},{"start":2.101,"end":3.589,"text":"T'egberun orile nko","marked":"T'ẹgbẹ̀rún orílẹ̀ ńkọ́"},{"start":3.969,"end":5.627,"text":"Orin didun bi t'angeli","marked":"Orin dídùn bí t'áńgẹ́lì"},{"start":6.007,"end":7.088,"text":"O ndun bi omi pupo","marked":"Ó ńdún bí omi púpọ̀"},{"start":7.468,"end":9.708,"text":"'Bukun, ogo, ipa gbala","marked":"'Bùkún, ògo, ipa gbala"},{"start":10.088,"end":11.602,"text":"Fun Olorun lor'ite","marked":"Fún Ọlọ́run lór'ìtẹ́"},{"start":11.982,"end":13.6,"text":"Baba, Omo, Emi Mimo","marked":"Bàbá, Ọmọ, Ẹ̀mí Mímọ́́"},{"start":13.98,"end":15.505,"text":"Olola, lainipekun.","marked":"Ọlọ́lá, láìnípẹ̀kun."}],"end":15.505},{"key":"2","start":16.455,"lines":[{"start":16.455,"end":18.735,"text":"Titi lo, lat'oro d'ale","marked":"Títí lọ, lát'ọ̀rọ̀ d'álẹ̀"},{"start":19.115,"end":20.403,"text":"Lor'olukuluku 'le","marked":"Lór'olúkúlùkù 'lè"},{"start":20.783,"end":22.166,"text":"Lat' opolopo eniyan","marked":"Lát' ọ̀pọ̀lọpọ̀ ènìyàn"},{"start":22.546,"end":23.967,"text":"llu alawo pupa","marked":"llu aláwọ̀ pupa"},{"start":24.347,"end":26.282,"text":"'Lawo dudu t'a da n'ide","marked":"'Láwọ̀ dúdú t'á da n'ìde"},{"start":26.662,"end":28.643,"text":"Funfun ti o po niye","marked":"Funfun tí ó pọ̀ níye"},{"start":29.023,"end":30.476,"text":"Omnira alarinkiri","marked":"Omnira alárìnkiri"},{"start":30.856,"end":32.254,"text":"De 'le awon Arabu.","marked":"De 'lé àwọn Árábù."}],"end":32.254},{"key":"3","start":33.204,"lines":[{"start":33.204,"end":34.355,"text":"Lati ebute otutu","marked":"Láti èbúté òtútù"},{"start":34.735,"end":36.041,"text":"De ile ti o mooru","marked":"Dé ilé tí ó móoru"},{"start":36.421,"end":37.709,"text":"Awon olokan gbigbona","marked":"Àwọn ọlọ́kàn gbígbóná"},{"start":38.089,"end":39.561,"text":"Leba okun Pasifik'","marked":"Lẹ́bà òkun Pasifik'"},{"start":39.941,"end":41.437,"text":"Lat'opo aimoye okan","marked":"Lát'ọ̀pọ̀ àìmọye ọkàn"},{"start":41.817,"end":42.918,"text":"Onigbagbo alayo","marked":"Onígbàgbọ́ aláyọ̀"},{"start":43.298,"end":44.848,"text":"Awon to nsona bibo Re","marked":"Àwọn tó ńṣọ́nà bíbọ̀ Rẹ̀"},{"start":45.228,"end":46.883,"text":"Won fere de Sion na.","marked":"Wọ́n fẹ́rẹ̀ dé Sion ná."}],"end":46.883},{"key":"4","start":47.833,"lines":[{"start":47.833,"end":49.021,"text":"Akojo orile-ede","marked":"Àkójọ orílẹ̀-èdè"},{"start":49.401,"end":50.793,"text":"Lat'inu eya ahon","marked":"Lát'ínú ẹ̀yà ahọ́n"},{"start":51.173,"end":53.449,"text":"Gbo, won nkorin iyin titi","marked":"Gbọ́, wọ́n ńkọrin ìyìn títí"},{"start":53.829,"end":54.981,"text":"Gbo orin ologo ni","marked":"Gbọ́ orin ológo ni"},{"start":55.361,"end":56.697,"text":"O b'afonifoji mole","marked":"Ó b'áfonífojì mọ́lẹ̀"},{"start":57.077,"end":58.532,"text":"O si ndun lori oke","marked":"Ó sì ńdún lórí òkè"},{"start":58.912,"end":60.671,"text":"O ndun si waju tit'o fi","marked":"Ó ńdún si waju tit'o fi"},{"start":61.051,"end":62.223,"text":"Kun ibugbe Olorun.","marked":"Kún ibùgbé Ọlọ́run."}],"end":62.223},{"key":"5","start":63.173,"lines":[{"start":63.173,"end":64.521,"text":"Gbo, didun orin na dapo","marked":"Gbọ́, dídùn orin nà dàpọ̀"},{"start":64.901,"end":66.291,"text":"Mo orin awon t'orun,","marked":"Mo orin àwọn t'ọrun"},{"start":66.671,"end":68.457,"text":"Awon t'o koja n'nu danwo","marked":"Àwọn t'ó kọjá ń'nú dánwò"},{"start":68.837,"end":70.118,"text":"Sinu isimi loke","marked":"Sínú ìṣímí lókè"},{"start":70.498,"end":72.031,"text":"Won wo aso ailabawon","marked":"Wọ́n wọ aṣọ ailabawon"},{"start":72.411,"end":73.846,"text":"Imo 'segun lowo won","marked":"Ìmọ̀ 'ṣègùn lọ́wọ́ wọn"},{"start":74.226,"end":75.697,"text":"Won nfi duru ko Hosana.","marked":"Wọ́n ńfi dùrù kọ Hósánà."}],"end":75.697},{"key":"6","start":76.647,"lines":[{"start":76.647,"end":77.882,"text":"“Ogo fun Eni t'o fe wa","marked":"Ògo fún Ẹni t'ó fẹ́ wá"},{"start":78.262,"end":79.433,"text":"T'O we wa n'nu eje Re","marked":"T'ó wé wa ń'nú ẹ̀jẹ̀ Rẹ̀"},{"start":79.813,"end":82.313,"text":"K'oba, alufa, ma korin","marked":"K'ọba, àlùfá, má kọrin"},{"start":82.693,"end":84.218,"text":"Si Baba, Olorun wa","marked":"Sí Bàbá, Ọlọ́run wa"},{"start":84.598,"end":85.869,"text":"K'eeyan mimo on Angeli","marked":"K'èèyàn mímọ́́ ọn Áńgẹ́lì"},{"start":86.249,"end":87.575,"text":"Ko Aleluya titi:","marked":"Kọ Alelúyà títí"},{"start":87.955,"end":89.194,"text":"Asegun orun apadi:","marked":"Aṣẹ́gun ọ̀run àpádì"},{"start":89.574,"end":90.684,"text":"Olodumare joba.","marked":"Olódùmarè jọba."},{"start":91.064,"end":91.619,"text":"Amin.","marked":"Àmín."}],"end":91.619}]}