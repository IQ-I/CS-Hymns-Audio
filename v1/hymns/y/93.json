{"v":1,"coll":"y","num":93,"id":"hymn_93","title":"A F'OPE f'Olorun.","duration":42.52,"voices":{"male":{"file":"y-93-male.m4a","bytes":305991,"sha256":"77c372af29421780fa245add9499e29b1a9c414455601ec47dccfa7987db3aea","duration":42.6},"female":{"file":"y-93-female.m4a","bytes":318754,"sha256":"9d8c9c5fbab0b0e3d8c37b72543d671ceba9fd516bb853e171a313e6a117b6db","duration":42.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.492,"text":"A F'OPE f'Olorun.","marked":"A F'ọpẹ́ f'Ọlọ́run."},{"start":1.872,"end":3.611,"text":"L'Okan ati Ohun wa,","marked":"L'Ọkàn àti Ohùn wa"},{"start":3.991,"end":5.053,"text":"Eni ns'ohun 'yanu,","marked":"Ẹni ns'ọ̀hún 'yanu"},{"start":5.433,"end":7.301,"text":"N'nu Eniti araiye nyo","marked":"N'nu Eniti araiye nyo"},{"start":7.681,"end":9.103,"text":"Gbat' a wa l'om'owo","marked":"Gbat' á wá l'om'ọwọ́"},{"start":9.483,"end":10.591,"text":"On na l'o ntoju wa,","marked":"On ná l'ó ńtọ́jú wa"},{"start":10.971,"end":12.202,"text":"O si nf'ebun ife","marked":"Ó sì ńf'ẹ̀bùn ìfẹ́"},{"start":12.582,"end":13.825,"text":"Se 'toju wa sibe.","marked":"Ṣe 'tọ́jú wa síbẹ̀."}],"end":13.825},{"key":"2","start":14.775,"lines":[{"start":14.775,"end":15.715,"text":"Oba Onib'ore","marked":"Ọba Oníb'ọ̀rẹ́"},{"start":16.095,"end":17.48,"text":"Ma fi wa sile lailai","marked":"Má fi wá sílẹ̀ láíláí"},{"start":17.86,"end":19.362,"text":"Ayo ti ko l'opin","marked":"Ayò tí kò l'òpin"},{"start":19.742,"end":21.348,"text":"On bukun y'o je tiwa","marked":"On bùkún y'ó jẹ́ tiwa"},{"start":21.728,"end":22.696,"text":"Pa wa mo n'nu ore","marked":"Pa wá mò ń'nú ọ̀rẹ́"},{"start":23.076,"end":24.394,"text":"To wa gba ba damu","marked":"Tó wá gbà bá dàmú"},{"start":24.774,"end":25.855,"text":"Yo wa ninu ibi","marked":"Yọ wà nínú ibi"},{"start":26.235,"end":27.68,"text":"Laiye ati l'orun.","marked":"Láìyẹ àti l'ọrun."}],"end":27.68},{"key":"3","start":28.63,"lines":[{"start":28.63,"end":29.76,"text":"K'a f'iyin on ope","marked":"K'á f'ìyìn ọ̀n ọ̀pẹ"},{"start":30.14,"end":31.371,"text":"F'Olorun Baba Omo,","marked":"F'Ọlọ́run Bàbá Ọmọ"},{"start":31.751,"end":32.602,"text":"At'Emi Mimo","marked":"Àt'Ẹ̀mí Mímọ́́"},{"start":32.982,"end":34.171,"text":"Ti o ga julo I'Orun","marked":"Tí ó ga jùlọ l'Ọrun"},{"start":34.551,"end":35.633,"text":"Olorun kan lailai","marked":"Ọlọ́run kan láíláí"},{"start":36.013,"end":37.288,"text":"T'aiye at'orun mbo","marked":"T'aiye àt'ọrùn ḿbọ̀"},{"start":37.668,"end":39.014,"text":"Be l'o wa d'isiyi","marked":"Bẹ́ l'ó wá d'ìsíyí"},{"start":39.394,"end":40.97,"text":"Beni y'o wa lailai.","marked":"Bẹni y'ó wà láíláí."}],"end":40.97}]}