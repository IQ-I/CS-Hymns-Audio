{"v":1,"coll":"y","num":829,"id":"hymn_829","title":"A juba Re, Halleluyah","duration":75.19,"voices":{"male":{"file":"y-829-male.m4a","bytes":535222,"sha256":"75797495111477b3cdd8fcfe7cc2041be349eaff7198c403c68a7317a1eb215b","duration":75.2},"female":{"file":"y-829-female.m4a","bytes":553801,"sha256":"ee1b02a64683cc36fb623774be3292985a0282eaff62ae252cc16b0cbcbfbd6b","duration":75.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.078,"text":"A juba Re, Halleluyah","marked":"A júbà Rẹ̀, Hallelúyà"},{"start":2.458,"end":4.159,"text":"Halle, Halleluyah,","marked":"Halle, Hallelúyà"},{"start":4.539,"end":6.818,"text":"Olorun wa, enit' a nsin","marked":"Ọlọ́run wa, enít' á ńsìn"},{"start":7.198,"end":8.855,"text":"Yio s'ayo wa di kikun.","marked":"Yíó s'áyò wá di kíkún."}],"end":8.855},{"key":"CHORUS","start":9.805,"lines":[{"start":9.805,"end":10.775,"text":"Ibi rere kan wa","marked":"Ibi rere kan wà"},{"start":11.155,"end":12.307,"text":"Ayipada ko si","marked":"Àyípadà kò sí"},{"start":12.687,"end":15.01,"text":"Ko s'oru af'osan titi","marked":"Kò s'oru àf'ọ̀sán títí"},{"start":15.39,"end":17.055,"text":"Serafu yio I'ayo.","marked":"Séráfù yíó l'àyò."}],"end":17.055},{"key":"2","start":18.005,"lines":[{"start":18.005,"end":19.845,"text":"Onigbagbo, e ji giri","marked":"Onígbàgbọ́, ẹ jí gìrì"},{"start":20.225,"end":21.844,"text":"Serafu ma nkede,","marked":"Séráfù má ńkéde"},{"start":22.224,"end":23.482,"text":"Aborisa nsise 'yanu","marked":"Aboríṣà ńṣiṣẹ́ 'yanu"},{"start":23.862,"end":25.573,"text":"Onigbagbo nk' egan.","marked":"Onígbàgbọ́ nk' ẹgàn."}],"end":25.573},{"key":"3","start":26.523,"lines":[{"start":26.523,"end":27.963,"text":"Opolopo ese l'o wa","marked":"Ọ̀pọ̀lọpọ̀ ẹsẹ̀ l'ó wà"},{"start":28.343,"end":30.027,"text":"Sugbon eyi t'o buru","marked":"Ṣùgbọ́n èyí t'ó burú"},{"start":30.407,"end":32.868,"text":"Ese Ese, S'EMI MlMO","marked":"Ẹsẹ̀ Ẹsẹ̀, S'emí MlMỌ́"},{"start":33.248,"end":34.543,"text":"Eyi ko ni 'dariji.","marked":"Èyí kò ní 'dáríjì."}],"end":34.543},{"key":"4","start":35.493,"lines":[{"start":35.493,"end":37.089,"text":"Opo 'danwo l'o wa l'aiye","marked":"Ọ̀pọ̀ 'dánwò l'ó wà l'aiye"},{"start":37.469,"end":38.871,"text":"Sugbon eyi t'o buru","marked":"Ṣùgbọ́n èyí t'ó burú"},{"start":39.251,"end":41.601,"text":"K'a ma l'owo, k'aisan dani","marked":"K'á má l'ówó, k'àìsàn dání"},{"start":41.981,"end":43.245,"text":"Jesu gbe wa leke.","marked":"Jésù gbé wa lékè."}],"end":43.245},{"key":"5","start":44.195,"lines":[{"start":44.195,"end":45.859,"text":"Ko s'ere kan t'o wa l'aiye","marked":"Kò s'ère kan t'ó wà l'aiye"},{"start":46.239,"end":47.271,"text":"Fun Egbe Serafu","marked":"Fún Ẹgbẹ́ Séráfù"},{"start":47.651,"end":49.136,"text":"Enit' o ba sise re ye","marked":"Enit' ò bá ṣiṣẹ́ rẹ̀ yé"},{"start":49.516,"end":50.619,"text":"Yio gb'ade nikehin.","marked":"Yío gb'adé níkẹhin."}],"end":50.619},{"key":"6","start":51.569,"lines":[{"start":51.569,"end":52.806,"text":"Aladura ma jafara","marked":"Aládúrà má jáfara"},{"start":53.186,"end":54.294,"text":"Ariran so 'bode","marked":"Aríran sọ 'bọdẹ"},{"start":54.674,"end":56.502,"text":"Larin ota le wa laiye","marked":"Larin ọ̀tá lè wà láìyẹ"},{"start":56.882,"end":58.605,"text":"Baba yio segun fun nyin.","marked":"Bàbá yìó ṣẹ́gun fún nyin."}],"end":58.605},{"key":"7","start":59.555,"lines":[{"start":59.555,"end":61.435,"text":"Alairise, alailera","marked":"Aláìríṣẹ́, aláìlera"},{"start":61.815,"end":62.833,"text":"E mase banuje","marked":"Ẹ máṣe bànújẹ́"},{"start":63.213,"end":64.902,"text":"Olupese, Oluwosan","marked":"Olùpèsè, Olùwòsàn"},{"start":65.282,"end":66.627,"text":"Ko ni fi nyin sile.","marked":"Kò ní fi nyin sílẹ̀."}],"end":66.627},{"key":"8","start":67.577,"lines":[{"start":67.577,"end":69.006,"text":"Ogo ni fun Baba l'oke","marked":"Ògo ni fún Bàbá l'òkè"},{"start":69.386,"end":70.436,"text":"Ogo ni fun Omo","marked":"Ògo ni fún Ọmọ"},{"start":70.816,"end":72.002,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":72.382,"end":73.64,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."}],"end":73.64}]}