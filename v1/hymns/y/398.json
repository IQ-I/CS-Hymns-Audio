{"v":1,"coll":"y","num":398,"id":"hymn_398","title":"JESU, oro Re ye","duration":43.628,"voices":{"male":{"file":"y-398-male.m4a","bytes":302239,"sha256":"b3a429de128edb8d2960bbe4b0d1099622997bf8d15058fff09dc5dcd1fa5e9b","duration":43.7},"female":{"file":"y-398-female.m4a","bytes":310846,"sha256":"55c530d4cd165c04a5cf7758cf9aeb57b53aa0824fdcccdee919a345909ae4e2","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.99,"text":"JESU, oro Re ye","marked":"Jésù, ọ̀rọ̀ Rẹ̀ yé"},{"start":2.37,"end":3.71,"text":"O si nto sise wa","marked":"Ó sì ńtọ́ ṣiṣẹ́ wa"},{"start":4.09,"end":5.655,"text":"Enit' o ba gbagbo","marked":"Enit' ò bá gbàgbọ́"},{"start":6.035,"end":7.464,"text":"Y'o l'ayo on 'mole.","marked":"Y'ó l'àyò ọ́n 'mọ́lẹ̀."}],"end":7.464},{"key":"2","start":8.414,"lines":[{"start":8.414,"end":9.676,"text":"Nigba' ota sunmo wa","marked":"Nígbà' ọ̀tá súnmọ́ wa"},{"start":10.056,"end":11.14,"text":"Oro Re l'odi wa","marked":"Ọ̀rọ̀ Rẹ l'ódì wa"},{"start":11.52,"end":12.583,"text":"Oro itunu ni","marked":"Ọ̀rọ̀ ìtùnú ni"},{"start":12.963,"end":14.09,"text":"lko igbala ni.","marked":"lkọ ìgbàlà ni."}],"end":14.09},{"key":"3","start":15.04,"lines":[{"start":15.04,"end":16.052,"text":"B'igbi at'okunkun","marked":"B'igbí àt'òkùnkùn"},{"start":16.432,"end":17.502,"text":"Tile bo wa mole","marked":"Tilẹ̀ bò wá mọ́lẹ̀"},{"start":17.882,"end":19.166,"text":"Mole re y'o to wa","marked":"Mọ́lẹ̀ rẹ̀ y'ó tó wà"},{"start":19.546,"end":20.913,"text":"Y'o si dabobo wa.","marked":"Y'ó sì dábòbò wa."}],"end":20.913},{"key":"4","start":21.863,"lines":[{"start":21.863,"end":23.215,"text":"Tani le so ayo","marked":"Tani lè sọ ayọ̀"},{"start":23.595,"end":24.721,"text":"T'o le ka isura","marked":"T'ó lè ka ìṣúra"},{"start":25.101,"end":26.188,"text":"Ti oro Re nfi fun","marked":"Ti ọ̀rọ̀ Rẹ ńfí fún"},{"start":26.568,"end":27.483,"text":"Okan onirele?","marked":"Ọkàn onírẹ̀lẹ̀?"}],"end":27.483},{"key":"5","start":28.433,"lines":[{"start":28.433,"end":29.876,"text":"Oro anu, o nfi","marked":"Ọ̀rọ̀ ànú, ó ńfi"},{"start":30.256,"end":31.376,"text":"Lera fun alaye","marked":"Lera fún àlàyé"},{"start":31.756,"end":33.173,"text":"Oro iye, o nfi","marked":"Ọ̀rọ̀ ìyè, ó ńfi"},{"start":33.553,"end":34.627,"text":"ltunu f'eni nku.","marked":"ltùnú f'ẹni ńkú."}],"end":34.627},{"key":"6","start":35.577,"lines":[{"start":35.577,"end":36.502,"text":"Awa iba le mo","marked":"Àwa ibà lè mọ̀"},{"start":36.882,"end":38.007,"text":"Eko ti o nkoni","marked":"Ẹ̀kọ́ tí ó ńkọ́ni"},{"start":38.387,"end":39.399,"text":"Ki a ba le fe O","marked":"Kí a bá lè fẹ́ O"},{"start":39.779,"end":41.049,"text":"K'a si le sunmo O.","marked":"K'á sì lè súnmọ́ O."},{"start":41.429,"end":42.078,"text":"Amin.","marked":"Àmín."}],"end":42.078}]}