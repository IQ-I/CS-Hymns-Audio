{"v":1,"coll":"y","num":361,"id":"hymn_361","title":"JERUSALEM t'orun","duration":49.045,"voices":{"male":{"file":"y-361-male.m4a","bytes":339394,"sha256":"4e2c173f2527dd5133986e19dfbca5dce3d6f4930b1fb942842143c53793adf9","duration":49.1},"female":{"file":"y-361-female.m4a","bytes":344535,"sha256":"fe3b974025d5438d190f963e43087809ed261ec06f7594266516bb1b9f0bdd30","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.792,"text":"JERUSALEM t'orun","marked":"Jerusalem t'ọrun"},{"start":2.172,"end":3.394,"text":"Orin mi, ilu mi","marked":"Orin mi, ìlú mi"},{"start":3.774,"end":4.789,"text":"Ile mi bi mba ku","marked":"Ilé mi bí ḿbá kú"},{"start":5.169,"end":6.234,"text":"Ekun ibukun mi.","marked":"Ẹkún ìbùkún mi."}],"end":6.234},{"key":"CHORUS","start":7.184,"lines":[{"start":7.184,"end":7.976,"text":"Ibi ayo!","marked":"Ibi ayọ̀!"},{"start":8.356,"end":9.194,"text":"Nigbawo ni","marked":"Nígbàwọ́ ni"},{"start":9.574,"end":10.41,"text":"Ngo r'oju re","marked":"Ngo r'ojú rẹ"},{"start":10.79,"end":11.62,"text":"Olorun mi?","marked":"Ọlọ́run mi?"}],"end":11.62},{"key":"2","start":12.57,"lines":[{"start":12.57,"end":13.792,"text":"Odi re, ilu mi","marked":"Odi rẹ, ìlú mi"},{"start":14.172,"end":16.113,"text":"L'a fi pearl se l'oso","marked":"L'á fi pearl ṣe l'ọ́so"},{"start":16.493,"end":17.804,"text":"'Lekun re ndan fun 'yin","marked":"'Lèkùn rẹ ńdán fún 'yín"},{"start":18.184,"end":19.548,"text":"Wura ni ita re!","marked":"Wúrà ni ìta rẹ!"}],"end":19.548},{"key":"3","start":20.498,"lines":[{"start":20.498,"end":21.604,"text":"Orun ki ran nibe","marked":"Ọ̀run kí ran níbẹ̀"},{"start":21.984,"end":23.067,"text":"Beni ko s'osupa","marked":"Bẹni kò s'òṣùpá"},{"start":23.447,"end":24.57,"text":"A ko wa iwonyi","marked":"A kò wá ìwọ̀nyí"},{"start":24.95,"end":26.448,"text":"Kristi n'imole ibe.","marked":"Kristi ń'ìmọ́lẹ̀̀ ibẹ̀."}],"end":26.448},{"key":"4","start":27.398,"lines":[{"start":27.398,"end":28.798,"text":"Nibe ni mo le ri","marked":"Níbẹ̀ ni mo lè rí"},{"start":29.178,"end":30.282,"text":"Awon Aposteli","marked":"Àwọn Apostélì"},{"start":30.662,"end":31.819,"text":"At'awon akorin","marked":"Àt'àwọn akọrin"},{"start":32.199,"end":33.512,"text":"Ti nlu harpu wura.","marked":"Ti ńlù harpu wúrà."}],"end":33.512},{"key":"5","start":34.462,"lines":[{"start":34.462,"end":35.468,"text":"Ni agbala wonni","marked":"Ní àgbàlá wọnnì"},{"start":35.848,"end":37.147,"text":"Ni awon Martyr wa","marked":"Ni àwọn Martyr wà"},{"start":37.527,"end":38.482,"text":"Nwon wo aso ala","marked":"Nwọ̀n wọ aṣọ àlà"},{"start":38.862,"end":39.912,"text":"Ogo bo ogbe won.","marked":"Ògo bo ọgbẹ́ wọn."}],"end":39.912},{"key":"6","start":40.862,"lines":[{"start":40.862,"end":42.235,"text":"T'emi yi sa su mi","marked":"T'èmi yí sá sú mi"},{"start":42.615,"end":44.043,"text":"Ti mo ngb'ago kedar!","marked":"Ti mo ngb'ago kedar!"},{"start":44.423,"end":45.725,"text":"Ko si 'ru yi loke","marked":"Kò sì 'rù yí lókè"},{"start":46.105,"end":47.496,"text":"Nibe ni mo fe lo.","marked":"Níbẹ̀ ni mo fẹ́ lọ."}],"end":47.496}]}