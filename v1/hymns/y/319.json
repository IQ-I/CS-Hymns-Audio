{"v":1,"coll":"y","num":319,"id":"hymn_319","title":"ALLELUYA! Allelua!! Allelua!!!","duration":44.862,"voices":{"male":{"file":"y-319-male.m4a","bytes":311099,"sha256":"0dc17cdcfc0fb40c8b600617e78afc26721bf0e3138bc70fb29f911322f65025","duration":44.9},"female":{"file":"y-319-female.m4a","bytes":321833,"sha256":"4d8c9a4646ea65c25d50a449a520246e78ade6ca869b253a054427506a6b766e","duration":44.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.955,"text":"ALLELUYA! Allelua!! Allelua!!!","marked":"Allelúyà! Allelua!! Allelua!!!"},{"start":3.335,"end":5.229,"text":"Ija d'opin, ogun si tan","marked":"Ìjà d'òpin, ogun sì tán"},{"start":5.609,"end":6.769,"text":"Olugbala jagun 'molu","marked":"Olùgbàlà jagun 'mólú"},{"start":7.149,"end":8.692,"text":"Orin ayo la o ma ko","marked":"Orin ayọ̀ la ó ma kọ"},{"start":9.072,"end":10.093,"text":"Alleluya.","marked":"Allelúyà."}],"end":10.093},{"key":"CHORUS","start":11.043,"lines":[{"start":11.043,"end":11.98,"text":"Alleluya.","marked":"Allelúyà."}],"end":11.98},{"key":"2","start":12.93,"lines":[{"start":12.93,"end":14.544,"text":"Gbogbo ipa n'iku ti lo","marked":"Gbogbo ipa n'ikú ti lọ"},{"start":14.924,"end":16.622,"text":"Sughon Kristi f'ogun re ka","marked":"Sughon Kristi f'ogun rẹ̀ ká"},{"start":17.002,"end":18.502,"text":"Aiye' E ho iho ayo","marked":"Aiye' E hó ihò ayò"},{"start":18.882,"end":19.776,"text":"Alleluya.","marked":"Allelúyà."}],"end":19.776},{"key":"3","start":20.726,"lines":[{"start":20.726,"end":22.236,"text":"Ojo meta na ti koja","marked":"Ọjọ́ mẹ́ta ná ti kọjá"},{"start":22.616,"end":24.231,"text":"O jinde kuro n'nu oku","marked":"Ó jíǹde kúrò ń'nú òkú"},{"start":24.611,"end":26.305,"text":"E Fogo fun Olorun wa","marked":"Ẹ Fògo fún Ọlọ́run wa"},{"start":26.685,"end":27.523,"text":"Alleluya.","marked":"Allelúyà."}],"end":27.523},{"key":"4","start":28.473,"lines":[{"start":28.473,"end":29.743,"text":"O d'ewon orun apadi","marked":"Ó d'ẹ̀wọ̀n ọ̀run àpádì"},{"start":30.123,"end":31.318,"text":"O s'ilekun orun sile","marked":"Ó s'ílẹ̀kùn ọ̀run sílẹ̀"},{"start":31.698,"end":32.957,"text":"E korin iyin 'segun Re","marked":"Ẹ kọrin ìyìn 'ṣẹ́gun Rẹ̀"},{"start":33.337,"end":34.303,"text":"Alleluya.","marked":"Allelúyà."}],"end":34.303},{"key":"5","start":35.253,"lines":[{"start":35.253,"end":36.858,"text":"Jesu nipa iya t'o je","marked":"Jésù nípa ìyà t'ó jẹ"},{"start":37.238,"end":38.514,"text":"Gba wa lowo oro iku","marked":"Gbà wá lọ́wọ́ ọ̀rọ̀ ikú"},{"start":38.894,"end":41.209,"text":"K'a le ye, k'a si ma yin O","marked":"K'á lè yé, k'á sì má yìn Ọ́"},{"start":41.589,"end":42.448,"text":"Alleluya.","marked":"Allelúyà."},{"start":42.828,"end":43.312,"text":"Amin.","marked":"Àmín."}],"end":43.312}]}