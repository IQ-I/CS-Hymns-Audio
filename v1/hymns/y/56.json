{"v":1,"coll":"y","num":56,"id":"hymn_56","title":"KRIST' Jesu l'agbara","duration":75.928,"voices":{"male":{"file":"y-56-male.m4a","bytes":555870,"sha256":"cf591f1a44e3f868ac872c268e1a2db6e54530c8270e7a075074845143a3edb8","duration":76.0},"female":{"file":"y-56-female.m4a","bytes":587616,"sha256":"9d36d166d4fad0120f691214abb11471b050f9da4cfc52b42c6c9395832d4c7e","duration":76.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.816,"text":"KRIST' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":2.196,"end":3.429,"text":"Agbara 'dariji","marked":"Agbára 'dáríjì"},{"start":3.809,"end":5.696,"text":"Agbara ti n so ni d'aaye","marked":"Agbára tí ń sọ ní d'ààyè"},{"start":6.076,"end":7.142,"text":"T'o f'iye f'elese","marked":"T'ó f'iye f'ẹ́lẹ́sẹ̀"},{"start":7.522,"end":8.927,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":9.307,"end":10.501,"text":"Rohin re n'bi gbogbo!","marked":"Rọ́hìn rẹ̀ ń'bí gbogbo!"},{"start":10.881,"end":12.516,"text":"Gbe okan ebi re to O wa","marked":"Gbé ọkàn ẹbí rẹ tó O wà"},{"start":12.896,"end":14.471,"text":"Yoo f'oor'ofe gba O.","marked":"Yóò f'oòr'ọ̀fẹ́ gbà Ọ́."}],"end":14.471},{"key":"CHORUS","start":15.421,"lines":[{"start":15.421,"end":16.783,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":17.163,"end":18.309,"text":"Agbura Olorun","marked":"Àgbúra Ọlọ́run"},{"start":18.689,"end":20.265,"text":"Krist' Jesu I'agbara","marked":"Krist' Jésù l'ágbára"},{"start":20.645,"end":21.832,"text":"Mo jo w'okan mi fun Un","marked":"Mo jọ w'ọkàn mi fún Un"},{"start":22.212,"end":23.64,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":24.02,"end":25.438,"text":"Ngo gbekele E titi","marked":"Ngo gbẹ́kẹ̀lé E títí"},{"start":25.818,"end":27.237,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":27.617,"end":29.566,"text":"Mo ju ba, wole fun Un.","marked":"Mo jù bá, wọlé fún Un."}],"end":29.566},{"key":"2","start":30.516,"lines":[{"start":30.516,"end":31.886,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":32.266,"end":33.688,"text":"Lati so ni d'otun","marked":"Láti sọ ní d'ọ̀tun"},{"start":34.068,"end":35.873,"text":"Lati w'ese kuro l'okan","marked":"Láti w'ẹsẹ̀ kúrò l'ọ́kan"},{"start":36.253,"end":37.659,"text":"Lati so di pipe","marked":"Láti sọ di pípé"},{"start":38.039,"end":39.527,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":39.907,"end":41.256,"text":"Lati pamo d'opin","marked":"Láti pamọ d'òpin"},{"start":41.636,"end":43.302,"text":"Ko s'eni't'o le ja awon","marked":"Kò s'ẹ́ni't'ó lè já àwọn"},{"start":43.682,"end":44.678,"text":"Agutan low Re.","marked":"Àgùtàn low Re."}],"end":44.678},{"key":"3","start":45.628,"lines":[{"start":45.628,"end":46.992,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":47.372,"end":48.547,"text":"Lati tu ni ninu","marked":"Láti tù ní nínú"},{"start":48.927,"end":50.733,"text":"Agbara lati ru gbogbo","marked":"Agbára láti ru gbogbo"},{"start":51.113,"end":52.062,"text":"Aniyan okan re","marked":"Àníyàn ọkàn rẹ"},{"start":52.442,"end":53.92,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":54.3,"end":55.79,"text":"Lati n'o' omije nu","marked":"Láti n'o' omijé nù"},{"start":56.17,"end":57.857,"text":"Saa f'igboya ro m'Oluwa","marked":"Sáà f'ìgboyà ro m'Olúwa"},{"start":58.237,"end":60.0,"text":"Gboran, si gbekele E.","marked":"Gbọ́ràn, sí gbẹ́kẹ̀lé E."}],"end":60.0},{"key":"4","start":60.95,"lines":[{"start":60.95,"end":62.415,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":62.795,"end":63.877,"text":"'Gbara lati parun","marked":"'Gbára láti parun"},{"start":64.257,"end":66.222,"text":"Lati bori ota t'o n fe","marked":"Láti borí ọ̀tá t'ó ń fẹ́"},{"start":66.602,"end":67.709,"text":"Gb'ogun ti okan re","marked":"Gb'ogun ti ọkàn rẹ"},{"start":68.089,"end":69.534,"text":"Krist' Jesu l'agbara","marked":"Krist' Jésù l'ágbára"},{"start":69.914,"end":71.028,"text":"Lor'akete iku","marked":"Lor'akete ikú"},{"start":71.408,"end":72.748,"text":"Lati f'okan re ni 'segun","marked":"Láti f'ọkàn rẹ ní 'ṣẹ́gun"},{"start":73.128,"end":74.378,"text":"Lati ji o dide","marked":"Láti jí ọ dìde"}],"end":74.378}]}