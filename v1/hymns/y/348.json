{"v":1,"coll":"y","num":348,"id":"hymn_348","title":"lwo ti goke lo","duration":43.975,"voices":{"male":{"file":"y-348-male.m4a","bytes":320273,"sha256":"e18c77e179ea37bd425c64fa34f96b0ecb8c928f43766683f0bee85951e38010","duration":44.0},"female":{"file":"y-348-female.m4a","bytes":330339,"sha256":"3931206963c160d7f7350f3f09831423b3efe06b10fd6e6f4c9aabdb0676daa4","duration":44.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.592,"text":"lwo ti goke lo,","marked":"lwọ ti gòkè lọ"},{"start":1.972,"end":3.252,"text":"S'ile ayo orun","marked":"S'ilẹ̀ ayọ̀ ọ̀run"},{"start":3.632,"end":5.287,"text":"Lojojumo yite re ka","marked":"Lojojumo yítẹ̀ rẹ́ ká"},{"start":5.667,"end":6.917,"text":"L'a ngbo orin iyin","marked":"L'á ńgbọ́ orin ìyìn"},{"start":7.297,"end":8.804,"text":"Sugbon awa nduro","marked":"Ṣùgbọ́n àwa ńdúró"},{"start":9.184,"end":10.424,"text":"Labe eru ese","marked":"Lábẹ́ ẹrú ẹ̀ṣẹ̀"},{"start":10.804,"end":12.085,"text":"Jo ran Olutunu Re wa","marked":"Jọ rán Olùtùnú Rẹ wá"},{"start":12.465,"end":14.136,"text":"K'o si mu wa lo 'le.","marked":"K'ó sì mú wa lọ 'lé."}],"end":14.136},{"key":"2","start":15.086,"lines":[{"start":15.086,"end":16.356,"text":"lwo ti goke lo","marked":"lwọ ti gòkè lọ"},{"start":16.736,"end":18.043,"text":"Sugbon saju eyi,","marked":"Ṣùgbọ́n ṣájú èyí"},{"start":18.423,"end":19.804,"text":"O koja 'rora kikoro","marked":"Ó kọjá 'rora kíkorò"},{"start":20.184,"end":21.403,"text":"K'o to le de ade","marked":"K'ó tó lè dé adé"},{"start":21.783,"end":22.691,"text":"Larin ibanuje","marked":"Lárin ìbànújẹ́"},{"start":23.071,"end":24.458,"text":"L'a o ma te siwaju","marked":"L'á ò má tẹ̀ síwájú"},{"start":24.838,"end":26.937,"text":"K'ona wa t'o kun f'omije","marked":"K'ọ́nà wa t'ó kún f'omijé"},{"start":27.317,"end":28.679,"text":"To wa si odo Re.","marked":"Tó wá sí ọ̀dọ̀ Rẹ."}],"end":28.679},{"key":"3","start":29.629,"lines":[{"start":29.629,"end":30.679,"text":"Iwo ti goke lo","marked":"Ìwọ ti gòkè lọ"},{"start":31.059,"end":32.067,"text":"Iwo o tun pada","marked":"Ìwọ ò tún padà"},{"start":32.447,"end":33.804,"text":"Awon egbe mimo l'oke","marked":"Àwọn ẹgbẹ́ mímọ́́ l'òkè"},{"start":34.184,"end":35.359,"text":"Ni y'o ba O pada","marked":"Ni y'ó bá O padà"},{"start":35.739,"end":37.074,"text":"Nipa agbara Re","marked":"Nípa agbára Rẹ"},{"start":37.454,"end":38.834,"text":"K'awa k'a ku n'nu Re","marked":"K'áwa k'á kú ń'nú Rẹ̀"},{"start":39.214,"end":40.84,"text":"Gbat'a ba ji l'ojo'dajo","marked":"Gbat'á bá jí l'ọjọ́'dájọ́"},{"start":41.22,"end":42.425,"text":"Fi wa si otun Re.","marked":"Fi wá sí ọ̀tún Rẹ."}],"end":42.425}]}