{"v":1,"coll":"y","num":816,"id":"hymn_816","title":"JESU Iwo Oba mi","duration":90.14,"voices":{"male":{"file":"y-816-male.m4a","bytes":670821,"sha256":"2434cfeab7eb39ac4bf7ef466b46aaa6f4d4a9b4547401e2780725a8703e692d","duration":90.2},"female":{"file":"y-816-female.m4a","bytes":684504,"sha256":"ce39a8f66c28eda2b682387cfab971c395a4f7209477e4ba56546a31d08b0707","duration":90.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.548,"text":"JESU Iwo Oba mi","marked":"Jésù Ìwọ Ọba mi"},{"start":1.928,"end":3.271,"text":"Iwo ni mo gbekele","marked":"Ìwọ ni mo gbẹ́kẹ̀lé"},{"start":3.651,"end":5.313,"text":"L'aiye yi nko l'enikan","marked":"L'áiye yí ńkọ́ l'ẹnìkan"},{"start":5.693,"end":6.875,"text":"Lehin Re 'Wo Oba mi","marked":"Lẹ́hìn Rẹ 'Wo Ọba mi"},{"start":7.255,"end":8.589,"text":"Torina gbe mi leke","marked":"Torina gbé mi lékè"},{"start":8.969,"end":10.301,"text":"Gbe mi bori ota mi","marked":"Gbé mi borí ọ̀tá mi"},{"start":10.681,"end":12.231,"text":"Ki nlayo ki nni segun","marked":"Kí ńláyọ̀ kí ńní ṣẹ́gun"},{"start":12.611,"end":13.828,"text":"L'ojo aiye mi gbogbo.","marked":"L'ọjọ́ aiye mi gbogbo."}],"end":13.828},{"key":"2","start":14.778,"lines":[{"start":14.778,"end":15.916,"text":"Fun mi ni ore-ofe","marked":"Fún mi ní ọ̀rẹ́-ọ̀fẹ́"},{"start":16.296,"end":17.768,"text":"Se mi ye l'eni tire","marked":"Ṣé mi yé l'ẹni tire"},{"start":18.148,"end":19.446,"text":"K'ota mase le mi ba","marked":"K'ọ̀tá máṣe lé mi bá"},{"start":19.826,"end":21.208,"text":"S'aiye mi d'ire fun mi","marked":"S'aiye mi d'ire fún mi"},{"start":21.588,"end":23.234,"text":"Wo t'o so aiye Esther","marked":"Wo t'ó sọ aiye Esther"},{"start":23.614,"end":24.859,"text":"Di rere fun nigbani","marked":"Di rere fún nígbàní"},{"start":25.239,"end":26.597,"text":"Wa s'aiye mi di rere","marked":"Wá s'aiye mi di rere"},{"start":26.977,"end":28.656,"text":"Jeki im'ota le d'ofo.","marked":"Jẹ́kí ìm'ọ̀tá lè d'ọ́fọ́."}],"end":28.656},{"key":"3","start":29.606,"lines":[{"start":29.606,"end":31.363,"text":"Gbe mi leke, mo fe be","marked":"Gbé mi lékè, mo fẹ́ bẹ́"},{"start":31.743,"end":33.413,"text":"We Oba agbara gbogbo","marked":"Wé Ọba agbára gbogbo"},{"start":33.793,"end":35.377,"text":"Ipa ota ko to nkan","marked":"Ipa ọ̀tá kò tó nkan"},{"start":35.757,"end":37.017,"text":"Niwaju agbara Re","marked":"Níwájú agbára Rẹ"},{"start":37.397,"end":38.989,"text":"Torina, Eleda mi","marked":"Torina, Ẹlẹ́dàá mi"},{"start":39.369,"end":40.573,"text":"Pa agbara ota run","marked":"Pa agbára ọ̀tá run"},{"start":40.953,"end":42.167,"text":"K'ota ma yo mi lenu","marked":"K'ọ̀tá má yọ mí lẹ́nu"},{"start":42.547,"end":43.69,"text":"Gbe mi leke isoro.","marked":"Gbé mi lékè ìṣòro."}],"end":43.69},{"key":"4","start":44.64,"lines":[{"start":44.64,"end":46.283,"text":"Wo ti wa k'aiye to wa","marked":"Wo ti wá k'áiye tó wà"},{"start":46.663,"end":48.249,"text":"Wo ti wa k'orun to wa","marked":"Wo ti wá k'ọrun tó wà"},{"start":48.629,"end":49.968,"text":"Torina Jesu temi","marked":"Toríná Jésù tẹ̀mí"},{"start":50.348,"end":51.618,"text":"Jek'ola Re han fun mi","marked":"Jẹ́k'ọ́lá Rẹ hàn fún mi"},{"start":51.998,"end":53.334,"text":"Tobe t'emi na yio ri","marked":"Tobẹ t'èmí ná yío rí"},{"start":53.714,"end":55.518,"text":"Ogo Re, agbara Re","marked":"Ògo Rẹ, agbára Rẹ"},{"start":55.898,"end":57.481,"text":"T'aiye yio si ri pelu","marked":"T'aiye yío sì rí pẹ̀lú"},{"start":57.861,"end":59.329,"text":"Pe 'Wo l'agbara gbogbo.","marked":"Pé 'Wò l'ágbára gbogbo."}],"end":59.329},{"key":"5","start":60.279,"lines":[{"start":60.279,"end":61.465,"text":"Fi Ola Re yi mi ka","marked":"Fi Ọlá Rẹ yí mi ká"},{"start":61.845,"end":63.439,"text":"Fi Ogo Re yio mi ka","marked":"Fi Ògo Rẹ yio mí kà"},{"start":63.819,"end":65.023,"text":"K'agbara Re s'abo mi","marked":"K'agbára Rẹ s'àbọ̀ mi"},{"start":65.403,"end":66.648,"text":"K'oruko Re s'abo mi","marked":"K'òrukọ Rẹ s'àbọ̀ mi"},{"start":67.028,"end":68.634,"text":"Tobe ti ngo di ti Re","marked":"Tóbẹ ti ńgò di ti Rẹ"},{"start":69.014,"end":70.428,"text":"K'aiye ma le ri di mi","marked":"K'aiye má lè rí dì mí"},{"start":70.808,"end":72.233,"text":"K'owo esu ma te mi","marked":"K'ọwọ́ èṣù má tẹ̀ mí"},{"start":72.613,"end":73.884,"text":"Tobe k'aiye mi I'aiyo.","marked":"Tobẹ̀ k'áíyé mi l'áiyọ̀."}],"end":73.884},{"key":"6","start":74.834,"lines":[{"start":74.834,"end":76.091,"text":"Gba mo ba si de orun","marked":"Gbà mo bá sì dé ọ̀run"},{"start":76.471,"end":77.841,"text":"Fun mi ni ipo lodo Re","marked":"Fún mi ní ipò lọ́dọ̀ Rẹ"},{"start":78.221,"end":79.473,"text":"Ki nj'eni owo 'tun Re","marked":"Kí ńj'ẹni ọ̀wọ̀ 'tún Rẹ"},{"start":79.853,"end":81.07,"text":"Ki nye ni ori ite Re","marked":"Kí nye ní orí ìtẹ́ Rẹ"},{"start":81.45,"end":83.056,"text":"Gbana l'ayo ni y'o kun","marked":"Gbaná l'àyò ni y'ó kún"},{"start":83.436,"end":84.88,"text":"Nin' ogo ti ko l'opin","marked":"Nín' ògo tí kò l'òpin"},{"start":85.26,"end":86.803,"text":"Ninu ayo ti ki tan","marked":"Nínú ayọ̀ tí kì tán"},{"start":87.183,"end":88.59,"text":"Ninu ola ti ki sa.","marked":"Nínú ọlá tí kì sá."}],"end":88.59}]}