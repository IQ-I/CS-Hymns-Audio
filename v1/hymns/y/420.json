{"v":1,"coll":"y","num":420,"id":"hymn_420","title":"PASE 'bukun Re t'oke wa","duration":27.567,"voices":{"male":{"file":"y-420-male.m4a","bytes":199232,"sha256":"abf04d93d7c7b471b58648160f6766a7bbc04b2273918cecd92b5e100381094f","duration":27.6},"female":{"file":"y-420-female.m4a","bytes":206291,"sha256":"df97e7f49615e7fd93de8b4a87febfe262d3c196479d877ef93830d35dddc47f","duration":27.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.91,"text":"PASE 'bukun Re t'oke wa","marked":"Pasẹ̀ 'bùkún Re t'òkè wà"},{"start":2.29,"end":3.933,"text":"Olorun, s'ara ljo yi","marked":"Ọlọ́run, s'ára ljọ yí"},{"start":4.313,"end":6.05,"text":"Fi ife ti Baba wo wa","marked":"Fi ìfẹ́ tí Bàbá wò wá"},{"start":6.43,"end":8.412,"text":"Ghat' a f'eru gboju s'oke.","marked":"Ghat' a f'ẹrù gbójú s'òkè."}],"end":8.412},{"key":"2","start":9.362,"lines":[{"start":9.362,"end":11.164,"text":"Pase ibukun Re, Jesu","marked":"Pàṣẹ ìbùkún Rẹ̀, Jésù"},{"start":11.544,"end":12.962,"text":"K'a le se omo ehin Re","marked":"K'á lè ṣe ọmọ ẹ̀hìn Rẹ̀"},{"start":13.342,"end":15.045,"text":"Soro ipa s'okan gbogbo","marked":"Sọ̀rọ̀ ipa s'ókan gbogbo"},{"start":15.425,"end":17.827,"text":"So f 'alailera, tele mi.","marked":"Sọ f 'aláìlera, tẹ̀lé mi."}],"end":17.827},{"key":"3","start":18.777,"lines":[{"start":18.777,"end":20.418,"text":"PASE 'bukun l'akoko yi","marked":"Pasẹ̀ 'bùkún l'àkókò yí"},{"start":20.798,"end":22.146,"text":"Emi oto, kun ibi yi","marked":"Èmi ọ̀tọ̀, kún ibí yí"},{"start":22.526,"end":24.148,"text":"F'agbara iwosan Re kun","marked":"F'agbára ìwòsàn Rẹ kún"},{"start":24.528,"end":26.017,"text":"At'ore-ofe isoji.","marked":"Àt'ọ̀rẹ́-ọ̀fẹ́ ìsọjí."}],"end":26.017}]}