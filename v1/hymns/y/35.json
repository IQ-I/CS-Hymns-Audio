{"v":1,"coll":"y","num":35,"id":"hymn_35","title":"OLUWA ojo isimi","duration":38.411,"voices":{"male":{"file":"y-35-male.m4a","bytes":282293,"sha256":"7fc82777797b2a69e283084f6aeed1e507de0054f08423e675576462b1afa650","duration":38.5},"female":{"file":"y-35-female.m4a","bytes":285546,"sha256":"d9ff29f6e1d26343b85b63ca8e5a62ae6e53137acaa50ac20bbf8e89cf533a7b","duration":38.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.487,"text":"OLUWA ojo isimi,","marked":"Olúwa ọjọ́ ìsimi"},{"start":1.867,"end":3.758,"text":"Gbo tiwa, pelu wa loni","marked":"Gbọ́ tiwa, pẹ̀lú wa lónì"},{"start":4.138,"end":5.494,"text":"Awa pade fun adura","marked":"Àwa pàdé fún àdúrà"},{"start":5.874,"end":7.537,"text":"A fe gb'oro T'o fi fun wa.","marked":"A fẹ́ gb'ọ̀rọ̀ T'ó fi fún wa."}],"end":7.537},{"key":"2","start":8.487,"lines":[{"start":8.487,"end":10.254,"text":"Isimi t'aiye yi rorun","marked":"Ìsìmi t'áìyé yí rọrùn"},{"start":10.634,"end":12.388,"text":"Sugbon isimi t'orun dun","marked":"Ṣùgbọ́n ìsimi t'ọrun dùn"},{"start":12.768,"end":14.373,"text":"Lala okan wa fe 'jo na","marked":"Lalá ọkàn wa fẹ́ 'jọ ná"},{"start":14.753,"end":16.311,"text":"T'a o simi lailese da.","marked":"T'á ò sìmí láìlèṣe dà."}],"end":16.311},{"key":"3","start":17.261,"lines":[{"start":17.261,"end":19.048,"text":"Ko s'ija, ko si 'dagiri","marked":"Kò s'íjà, kò sì 'dagiri"},{"start":19.428,"end":21.669,"text":"Ko s'aniyan bi t'aiye yi","marked":"Kò s'àníyàn bí t'áiye yi"},{"start":22.049,"end":23.927,"text":"T'y'o dapo mo ikorin wa,","marked":"T'y'ó dàpọ̀ mọ́ ìkọrin wa"},{"start":24.307,"end":26.212,"text":"T'o nt'ete aiku jade wa.","marked":"T'ó nt'ete àìkú jáde wá."}],"end":26.212},{"key":"4","start":27.162,"lines":[{"start":27.162,"end":29.183,"text":"Bebe, ojo t'a ti nreti","marked":"Bèbè, ọjọ́ t'á ti ńrètí"},{"start":29.563,"end":30.996,"text":"Afemoju re l'a fe ri","marked":"Àfẹ̀mọ́jú rẹ l'á fẹ́ rí"},{"start":31.376,"end":32.945,"text":"A fe yo Iona ise yi,","marked":"A fẹ́ yọ̀ lọ́nà iṣẹ́ yí"},{"start":33.325,"end":35.894,"text":"K'a sun n'iku, k'a ji l'ayo.","marked":"K'á sun n'ìkú, k'á jí l'àyò."},{"start":36.274,"end":36.861,"text":"Amin.","marked":"Àmín."}],"end":36.861}]}