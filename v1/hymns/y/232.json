{"v":1,"coll":"y","num":232,"id":"hymn_232","title":"OLORUN Betel, eniti","duration":38.699,"voices":{"male":{"file":"y-232-male.m4a","bytes":267726,"sha256":"9df7a790352541266db0c37a89cb5f2ef75f511f55648aa261375e7472204cda","duration":38.7},"female":{"file":"y-232-female.m4a","bytes":278103,"sha256":"8a80f45457dac0815f90325ef0e43c5e522385e31321e38cbbf5575ca325ce34","duration":38.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.202,"text":"OLORUN Betel, eniti","marked":"Ọlọ́run Betel, ẹniti"},{"start":2.582,"end":3.667,"text":"O mbo awon Tire","marked":"Ó ḿbọ́ àwọn Tírè"},{"start":4.047,"end":5.386,"text":"Enit'o mu baba wa la","marked":"Enit'ó mú bàbá wa là"},{"start":5.766,"end":6.898,"text":"Ojo aiye won ja.","marked":"Ọjọ́ aiye wọn já."}],"end":6.898},{"key":"2","start":7.848,"lines":[{"start":7.848,"end":9.694,"text":"A mu eje, at'ebe wa","marked":"A mú ẹ̀jẹ̀, àt'èbẹ̀ wá"},{"start":10.074,"end":11.15,"text":"Wa iwaju 'te Re","marked":"Wá iwájú 'tẹ̀ Rẹ"},{"start":11.53,"end":12.72,"text":"Olorun awon Baba wa","marked":"Ọlọ́run àwọn Bàbá wa"},{"start":13.1,"end":14.221,"text":"Ma je Olorun wa.","marked":"Má jẹ́ Ọlọ́run wa."}],"end":14.221},{"key":"3","start":15.171,"lines":[{"start":15.171,"end":16.709,"text":"Ninu idamu aiye yi","marked":"Nínú ìdàmú aiye yi"},{"start":17.089,"end":18.131,"text":"Ma toju ipa wa","marked":"Má tọ́jú ipa wa"},{"start":18.511,"end":20.087,"text":"Fun wa ni onje ojo wa","marked":"Fún wa ní òǹjẹ ọjọ́ wa"},{"start":20.467,"end":21.764,"text":"At'aso t'o ye wa.","marked":"Àt'aṣọ t'ó yé wa."}],"end":21.764},{"key":"4","start":22.714,"lines":[{"start":22.714,"end":24.089,"text":"Na ojiji 'ye Re bo wa","marked":"Na òjijì 'yé Rẹ̀ bò wá"},{"start":24.469,"end":25.774,"text":"Tit'ajo wa o pin","marked":"Tít'àjọ wa ò pín"},{"start":26.154,"end":27.301,"text":"Ati ni 'bugbe Baba wa","marked":"Àti ní 'búgbé Bàbá wa"},{"start":27.681,"end":29.03,"text":"Okan wa o simi.","marked":"Ọkàn wa ò sìmí."}],"end":29.03},{"key":"5","start":29.98,"lines":[{"start":29.98,"end":31.345,"text":"Iru ibukun bi eyi","marked":"Irú ìbùkún bí èyí"},{"start":31.725,"end":32.833,"text":"L'a mbere lowo Re","marked":"L'á mbere lọ́wọ́ Rẹ"},{"start":33.213,"end":34.581,"text":"Iwo o je Olorun wa,","marked":"Ìwọ ò jẹ́ Ọlọ́run wa"},{"start":34.961,"end":36.198,"text":"At'ipin wa lailai.","marked":"Àt'ìpín wa láíláí."},{"start":36.578,"end":37.149,"text":"Amin.","marked":"Àmín."}],"end":37.149}]}