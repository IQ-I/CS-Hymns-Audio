{"v":1,"coll":"y","num":754,"id":"hymn_754","title":"ALABUKUN l'awon oku","duration":54.369,"voices":{"male":{"file":"y-754-male.m4a","bytes":384194,"sha256":"3755023688339054a485c744cb20dae516ecd32cd542f56a86448ba74d8627a7","duration":54.4},"female":{"file":"y-754-female.m4a","bytes":398194,"sha256":"850b9ed1d1722ebdba96a67ce1077f79e007d31834894e7bff39c370875ef1a6","duration":54.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.767,"text":"ALABUKUN l'awon oku","marked":"Alábùkún l'áwọn òkú"},{"start":2.147,"end":3.289,"text":"Nipa ti Oluwa","marked":"Nípa ti Olúwa"},{"start":3.669,"end":5.591,"text":"Kowe re be ni Emi wi","marked":"Kọ̀wé rẹ̀ bẹ́ ní Èmi wí"},{"start":5.971,"end":7.198,"text":"Se won nto won lehin.","marked":"Ṣé wọ́n ńtọ́ wọn lẹ́hìn."}],"end":7.198},{"key":"2","start":8.148,"lines":[{"start":8.148,"end":9.429,"text":"Nwon simi ninu lala won","marked":"Nwọ̀n sìmí nínú lálá wọn"},{"start":9.809,"end":11.021,"text":"Kuro l'aginju yi","marked":"Kúrò l'aginjù yí"},{"start":11.401,"end":12.844,"text":"Nwon nyo larin Egbe Mimo","marked":"Nwọ̀n nyo lárin Ẹgbẹ́ Mímọ́́"},{"start":13.224,"end":14.22,"text":"Loke orun lohun.","marked":"Lókè ọ̀run lọ́hùn."}],"end":14.22},{"key":"3","start":15.17,"lines":[{"start":15.17,"end":16.538,"text":"Ayo won ko se f'enu so","marked":"Ayò wọn kò ṣe f'ẹnu sọ"},{"start":16.918,"end":18.203,"text":"Larin Egbe Ogo","marked":"Lárin Ẹgbẹ́ Ògo"},{"start":18.583,"end":20.887,"text":"Jesu ti nwon ti gbekele","marked":"Jésù tí nwọn ti gbẹ́kẹ̀lé"},{"start":21.267,"end":22.697,"text":"Si ti re won lekun.","marked":"Sì ti rẹ̀ wọ́n lẹ́kún."}],"end":22.697},{"key":"4","start":23.647,"lines":[{"start":23.647,"end":24.812,"text":"Ainiye l'awon Kerubu","marked":"Àìníye l'àwọn Kérúbù"},{"start":25.192,"end":26.295,"text":"To y'ite Baba ka","marked":"Tó y'ítẹ Bàbá ká"},{"start":26.675,"end":28.839,"text":"Seraf' t'enikan ko le ka","marked":"Séráf' t'ẹnìkan kò lè kà"},{"start":29.219,"end":30.382,"text":"Nwon nko Halleluyah!","marked":"Nwọ̀n ńkọ Hallelúyà!"}],"end":30.382},{"key":"5","start":31.332,"lines":[{"start":31.332,"end":32.471,"text":"Agbagba Merinlelogun","marked":"Àgbàgbà Mẹ́rìnlélógún"},{"start":32.851,"end":33.94,"text":"Eda 'alaye Merin","marked":"Ẹ̀dà 'àlàyé Mẹ́rin"},{"start":34.32,"end":35.815,"text":"Nwon y'ite Olugbala ka","marked":"Nwọn y'ítẹ́ Olùgbàlà ká"},{"start":36.195,"end":37.315,"text":"Nwon nko Mimo Mimo.","marked":"Nwọ̀n ńkọ́ Mímọ́́ Mímọ́́."}],"end":37.315},{"key":"6","start":38.265,"lines":[{"start":38.265,"end":39.618,"text":"Ewa ogo 'be ti po to","marked":"Ẹwà ògo 'bẹ̀ ti pọ̀ tó"},{"start":39.998,"end":41.075,"text":"A ko le fenu so","marked":"A kò lè fẹnu sọ"},{"start":41.455,"end":43.142,"text":"Didan l'awon ta se logo","marked":"Dídán l'àwọn ta ṣe lógo"},{"start":43.522,"end":45.121,"text":"Nwon nko orin Mose.","marked":"Nwọ̀n ńkọ orin Mósè."}],"end":45.121},{"key":"7","start":46.071,"lines":[{"start":46.071,"end":47.665,"text":"A f'ogo fun Baba l'oke","marked":"A f'ògo fún Bàbá l'òkè"},{"start":48.045,"end":49.067,"text":"A f'ogo fun Omo","marked":"A f'ògo fún Ọmọ"},{"start":49.447,"end":50.942,"text":"A f'ogo fun Emi Mimo","marked":"A f'ògo fún Ẹ̀mí Mímọ́́"},{"start":51.322,"end":52.819,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."}],"end":52.819}]}