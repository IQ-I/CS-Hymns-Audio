{"v":1,"coll":"y","num":370,"id":"hymn_370","title":"LEHIN aiye buburu yi","duration":35.607,"voices":{"male":{"file":"y-370-male.m4a","bytes":259152,"sha256":"ac174e41a5d3e61905055841d1fbc65df22c89b02c75021cb36fa4d60132dca2","duration":35.7},"female":{"file":"y-370-female.m4a","bytes":266374,"sha256":"73f8bd93d2ecf7e6a024edb61e687f6648d21dba30d218c2114efc97ebc6d38a","duration":35.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.632,"text":"LEHIN aiye buburu yi","marked":"Lẹ́hìn aiye búburú yí"},{"start":2.012,"end":3.443,"text":"Aiye ekun on osi yi","marked":"Àìyẹ ẹkùn ọ́n òṣì yí"},{"start":3.823,"end":4.773,"text":"Ibi rere kan wa","marked":"Ibi rere kan wà"},{"start":5.153,"end":6.546,"text":"Ayipada ko si nibe","marked":"Àyípadà kò sí níbẹ̀"},{"start":6.926,"end":9.255,"text":"Ko s'oru af'osan titi","marked":"Kò s'oru àf'ọ̀sán títí"},{"start":9.635,"end":11.089,"text":"Wi mi, 'wo o wa nibe?","marked":"Wí mi, 'wò ó wà níbẹ̀?"}],"end":11.089},{"key":"2","start":12.039,"lines":[{"start":12.039,"end":13.58,"text":"“Lekun ogo re ti m'ese\"","marked":"Lẹ́kùn ògo rẹ ti ḿ'ẹsẹ̀"},{"start":13.96,"end":15.696,"text":"Ohun eri ko le we 'be","marked":"Ohun ẹ̀rí kò lè wé 'be"},{"start":16.076,"end":17.24,"text":"Lati b'ewu re je","marked":"Láti b'ẹ̀wù rẹ jẹ́"},{"start":17.62,"end":18.848,"text":"L'ebute daradara ni,","marked":"L'èbúté dáradára ni"},{"start":19.228,"end":20.578,"text":"A ko ni gburo egun mo","marked":"A kò ní gbúrò ẹ̀gún mọ́"},{"start":20.958,"end":22.051,"text":"Wi mi, 'wo o wa nibe?","marked":"Wí mi, 'wò ó wà níbẹ̀?"}],"end":22.051},{"key":"3","start":23.001,"lines":[{"start":23.001,"end":25.023,"text":"Tani o de 'be? Onirele","marked":"Tani ó dé 'bẹ? Onírẹ̀lẹ̀"},{"start":25.403,"end":26.62,"text":"To f'iberu sin Oluwa","marked":"Tó f'ìbẹ̀rù sin Olúwa"},{"start":27.0,"end":28.484,"text":"T'won ko nani aiye","marked":"T'wọn kò náni aiye"},{"start":28.864,"end":30.751,"text":"Awon t'a f'Emi Mimo to","marked":"Àwọn t'á f'Ẹ̀mí Mímọ́́ tó"},{"start":31.131,"end":32.594,"text":"Awon t'o nrin l'ona toro","marked":"Àwọn t'ó ńrín l'ọ́nà tọ́rọ́"},{"start":32.974,"end":34.057,"text":"Awon ni o wa nibe?","marked":"Àwọn ni ó wà níbẹ̀?"}],"end":34.057}]}