{"v":1,"coll":"y","num":413,"id":"hymn_413","title":"MA koja mi, Olugbala","duration":35.657,"voices":{"male":{"file":"y-413-male.m4a","bytes":243757,"sha256":"73a0b79c2f5d8ddf56bb4add3b59a73b24ed73b392067e314bd88cb532365fbf","duration":35.7},"female":{"file":"y-413-female.m4a","bytes":258855,"sha256":"78a545de98ec38b1768c9a62e7fd9a3291ba994081f2b7e0add1e08b4b8ef2aa","duration":35.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.14,"text":"MA koja mi, Olugbala","marked":"Má kọjá mi, Olùgbàlà"},{"start":2.52,"end":3.572,"text":"Gbo adura mi","marked":"Gbọ́ àdúrà mi"},{"start":3.952,"end":5.756,"text":"Gbati lwo ba np'elomiran","marked":"Gbátí lwò bá ńp'ẹlòmíràn"},{"start":6.136,"end":7.229,"text":"Mase koja mi!","marked":"Masẹ̀ kọjá mi!"}],"end":7.229},{"key":"CHORUS","start":8.179,"lines":[{"start":8.179,"end":10.318,"text":"Jesu! Jesu! Gbo adura mi!","marked":"Jésù! Jésù! Gbọ́ àdúrà mi!"},{"start":10.698,"end":12.162,"text":"Gbat'lwo ba np'elomiran","marked":"Gbat'lwọ bá ńp'ẹlòmíràn"},{"start":12.542,"end":13.661,"text":"Mase koja mi.","marked":"Masẹ̀ kọjá mi."}],"end":13.661},{"key":"2","start":14.611,"lines":[{"start":14.611,"end":15.985,"text":"N'ite anu je k'emi ri,","marked":"N'ìtẹ́ ànú jẹ́ k'ẹ̀mí rí"},{"start":16.365,"end":17.081,"text":"ltura didun","marked":"ltura dídùn"},{"start":17.461,"end":18.851,"text":"Teduntedun ni mo wole","marked":"Tẹ̀dùntẹ̀dùn ni mo wọlé"},{"start":19.231,"end":20.338,"text":"Jo ran mi lowo.","marked":"Jọ ràn mí lọ́wọ́."}],"end":20.338},{"key":"3","start":21.288,"lines":[{"start":21.288,"end":22.628,"text":"N'igbekele itoye Re","marked":"N'ígbẹ́kẹ̀lé ìtóye Rẹ"},{"start":23.008,"end":24.041,"text":"L'em'o w'oju Re","marked":"L'em'ó w'ojú Rẹ̀"},{"start":24.421,"end":25.647,"text":"Wo 'banuje okan mi san","marked":"Wo 'banújẹ́ ọkàn mi sàn"},{"start":26.027,"end":27.13,"text":"F'ife re gba mi.","marked":"F'ìfẹ́ rẹ gbà mí."}],"end":27.13},{"key":"4","start":28.08,"lines":[{"start":28.08,"end":29.388,"text":"'Wo orisun itunu mi","marked":"'Wo orísun ìtùnú mi"},{"start":29.768,"end":30.641,"text":"Ju ye fun mi lo","marked":"Jù yẹ fún mi lọ"},{"start":31.021,"end":32.73,"text":"Tani mo ni l'aiye l'orun","marked":"Tani mo ní l'aiye l'orun"},{"start":33.11,"end":34.107,"text":"Bikose lwo?","marked":"Bíkọ́ṣẹ́ lwo?"}],"end":34.107}]}