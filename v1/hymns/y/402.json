{"v":1,"coll":"y","num":402,"id":"hymn_402","title":"'Tori Mi at'lhinrere","duration":64.532,"voices":{"male":{"file":"y-402-male.m4a","bytes":477745,"sha256":"6d14df05a25bc1c8ad46761d8f153cf1886bfaa26960a11386f4ac01f92012b1","duration":64.6},"female":{"file":"y-402-female.m4a","bytes":490517,"sha256":"83f5f4d40569e23795171deff70754693d1b531e4a6cc7da5297e66d9e5319e1","duration":64.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.933,"text":"'Tori Mi at'lhinrere","marked":"'Torí Mi at'lhìnrere"},{"start":2.313,"end":3.507,"text":"E lo so t'irapada","marked":"Ẹ ló sọ t'ìràpadà"},{"start":3.887,"end":5.204,"text":"Awon onse Re nke Amin!","marked":"Àwọn ońṣẹ́ Rẹ̀ ńkẹ́ Àmín!"},{"start":5.584,"end":6.733,"text":"Tire ni gbogbo ogo","marked":"Tìrẹ ni gbogbo ògo"},{"start":7.113,"end":10.09,"text":"Nwon nso t'ibi, t'iya, t'iku","marked":"Nwọ̀n ńṣó t'ibi, t'íyà, t'ìkú"},{"start":10.47,"end":11.707,"text":"Ife etutu nla Re","marked":"Ìfẹ́ ètùtù ńlá Rẹ"},{"start":12.087,"end":13.984,"text":"Nwon ka ohun aiye s'ofo","marked":"Nwọ̀n ka ohun aiye s'ọ̀fọ̀"},{"start":14.364,"end":16.039,"text":"T' ajinde on 'joba Re.","marked":"T' àjíǹde on 'jọba Rẹ."}],"end":16.039},{"key":"2","start":16.989,"lines":[{"start":16.989,"end":18.909,"text":"Gbo, gbo ipe ti Jubili","marked":"Gbọ́, gbọ́ ìpè ti Júbílì"},{"start":19.289,"end":20.698,"text":"O ndun yi gbogbo aiye ka","marked":"Ó ńdún yí gbogbo àìyẹ ká"},{"start":21.078,"end":22.711,"text":"N'ile ati l'oju okun","marked":"N'ilẹ̀ àti l'ojú òkun"},{"start":23.091,"end":24.234,"text":"A ntan ihin igbala","marked":"A ntan ìhìn ìgbàlà"},{"start":24.614,"end":26.439,"text":"Bi ojo na ti nsumole","marked":"Bí ọjọ́ ná ti ńṣúmọ́lẹ̀"},{"start":26.819,"end":28.417,"text":"T'ogun si ngbona janjan","marked":"T'ogun sì ńgbóná janjan"},{"start":28.797,"end":30.029,"text":"Imole ila-orun na","marked":"Ìmọ́lẹ̀̀ ìlà-ọ̀run ná"},{"start":30.409,"end":31.566,"text":"Y'o mo Iarin okunkun.","marked":"Y'ó mọ́ lárin òkùnkùn."}],"end":31.566},{"key":"3","start":32.516,"lines":[{"start":32.516,"end":34.035,"text":"Siwaju ati siwaju","marked":"Síwájú àti síwájú"},{"start":34.415,"end":35.799,"text":"Lao ma gbo Halleluya","marked":"Láó má gbọ́ Hallelúyà"},{"start":36.179,"end":37.547,"text":"Ijo ajagun y'o ma yo","marked":"Ìjọ ajagun y'ó ma yọ̀"},{"start":37.927,"end":39.021,"text":"Pe l'awon oku mimo","marked":"Pé l'áwọn òkú mímọ́́"},{"start":39.401,"end":40.821,"text":"A fo aso won n'nu eje","marked":"A fọ aṣọ wọn ń'nú ẹ̀jẹ̀"},{"start":41.201,"end":42.527,"text":"Duru wura won si ndun","marked":"Dùrù wúrà wọ́n sì ńdùn"},{"start":42.907,"end":44.438,"text":"Aiye at'orun d'ohun po","marked":"Àìyẹ àt'ọrùn d'óhun pọ̀"},{"start":44.818,"end":46.068,"text":"Nwon nko orin isegun.","marked":"Nwọ̀n ńkọ orin ìṣègùn."}],"end":46.068},{"key":"4","start":47.018,"lines":[{"start":47.018,"end":48.997,"text":"O de, Enit' a nw'ona Re","marked":"Ó dé, Enit' á ńw'ọ́nà Rẹ̀"},{"start":49.377,"end":50.443,"text":"Eni ikehin na de,","marked":"Ẹni ìkẹhìn nà dé"},{"start":50.823,"end":52.77,"text":"Immanueli t'o d'ade","marked":"Immanueli t'ó d'adé"},{"start":53.15,"end":54.165,"text":"Oluwa awon mimo","marked":"Olúwa àwọn mímọ́́"},{"start":54.545,"end":56.827,"text":"Iye, Imole at'Ife","marked":"Iye, Ìmọ́lẹ̀̀ àt'Ìfẹ́"},{"start":57.207,"end":58.492,"text":"Metalokan titi lai","marked":"Mẹ́talọ́kan títí láì"},{"start":58.872,"end":60.145,"text":"Tire ni ite Olorun","marked":"Tìrẹ ni ìtẹ́ Ọlọ́run"},{"start":60.525,"end":61.979,"text":"Ati t'Odo-aguntan.","marked":"Àti t'Odò-àgùntàn."},{"start":62.359,"end":62.982,"text":"Amin.","marked":"Àmín."}],"end":62.982}]}