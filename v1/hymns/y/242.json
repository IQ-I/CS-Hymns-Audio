{"v":1,"coll":"y","num":242,"id":"hymn_242","title":"KRISTI sun f'elese","duration":24.506,"voices":{"male":{"file":"y-242-male.m4a","bytes":164185,"sha256":"cd01ff92e63f61893d8a5b7649b81eb3745a349107296e00dc3d643f24ef15a9","duration":24.6},"female":{"file":"y-242-female.m4a","bytes":174521,"sha256":"288672ad1734d855ca3f5112e1d1cab9a0f229ec277a19012fa526597ddf6ff7","duration":24.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.714,"text":"KRISTI sun f'elese","marked":"Kristi sùn f'ẹ́lẹ́sẹ̀"},{"start":2.094,"end":3.365,"text":"Oju wa o gbe bi?","marked":"Ojú wa ò gbé bí?"},{"start":3.745,"end":5.537,"text":"K'omi ronu at'ikanu","marked":"K'omi ronú àt'ìkanu"},{"start":5.917,"end":7.243,"text":"Tu jade l'oju wa.","marked":"Tú jáde l'ojú wa."}],"end":7.243},{"key":"2","start":8.193,"lines":[{"start":8.193,"end":9.324,"text":"Omo Olorun nsun","marked":"Ọmọ Ọlọ́run ńsùn"},{"start":9.704,"end":10.712,"text":"Angeli siju wo!","marked":"Áńgẹ́lì ṣíjú wo!"},{"start":11.092,"end":12.883,"text":"K'o damu, iwo okan mi","marked":"K'ó dàmú, ìwọ ọkàn mi"},{"start":13.263,"end":14.534,"text":"O d'omi ni fun o.","marked":"Ó d'omi ni fún ọ."}],"end":14.534},{"key":"3","start":15.484,"lines":[{"start":15.484,"end":16.837,"text":"O sun k'awa k'o sun","marked":"Ó sún k'áwá k'ó sùn"},{"start":17.217,"end":18.278,"text":"Ese bere ekun","marked":"Ẹsẹ̀ bẹ̀rẹ̀ ẹkùn"},{"start":18.658,"end":20.098,"text":"Orun nikan ni ko s'ese","marked":"Ọ̀run nìkan ni kò s'éṣe"},{"start":20.478,"end":22.029,"text":"Nibe ni ko s'ekun.","marked":"Níbẹ̀ ni kò s'èkùn."},{"start":22.409,"end":22.956,"text":"Amin.","marked":"Àmín."}],"end":22.956}]}