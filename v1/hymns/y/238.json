{"v":1,"coll":"y","num":238,"id":"hymn_238","title":"ALAIMO ni emi","duration":36.665,"voices":{"male":{"file":"y-238-male.m4a","bytes":249420,"sha256":"4cda14ec80c68660517b7b2db441d0179d7db7db13662e7d1a81d46bae6da591","duration":36.7},"female":{"file":"y-238-female.m4a","bytes":259515,"sha256":"542ed0276f97d257a6c4722ff8d119456c4b0d03a4ff6dd47ced8dd2b63928c7","duration":36.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.421,"text":"ALAIMO ni emi","marked":"Aláìmọ́ ni èmi"},{"start":1.801,"end":2.764,"text":"Olorun Oluwa!","marked":"Ọlọ́run Olúwa!"},{"start":3.144,"end":4.364,"text":"Emi ha gbodo sunmo O,","marked":"Èmi ha gbọ́dọ̀ súnmọ́ O"},{"start":4.744,"end":5.929,"text":"T'emi t'eru ese?","marked":"T'èmi t'erù ẹsẹ̀?"}],"end":5.929},{"key":"2","start":6.879,"lines":[{"start":6.879,"end":8.093,"text":"Eru ese yi npa","marked":"Ẹrù ẹsẹ̀ yí ńpa"},{"start":8.473,"end":9.341,"text":"Okan buburu mi","marked":"Ọ̀kan búburú mi"},{"start":9.721,"end":11.275,"text":"Yio ha si ti buru to","marked":"Yíó ha sì ti burú tó"},{"start":11.655,"end":12.776,"text":"L'oju Re mimo ni!","marked":"L'ojú Rẹ mímọ́́ ni!"}],"end":12.776},{"key":"3","start":13.726,"lines":[{"start":13.726,"end":14.793,"text":"Emi o ha si ku","marked":"Èmi ò ha sì kú"},{"start":15.173,"end":16.229,"text":"Ni alainireti?","marked":"Ní aláìnírètí?"},{"start":16.609,"end":17.938,"text":"Mo r'ayo ninu iku Re","marked":"Mo r'àyò nínú ikú Rẹ"},{"start":18.318,"end":19.621,"text":"Fun otosi b'emi.","marked":"Fún òtòsí b'èmi."}],"end":19.621},{"key":"4","start":20.571,"lines":[{"start":20.571,"end":21.754,"text":"Eje ni ti o ta","marked":"Ẹ̀jẹ̀ ni tí ó ta"},{"start":22.134,"end":23.175,"text":"T'ise or'ofe Re","marked":"T'iṣẹ́ or'ọ̀fẹ́ Rẹ"},{"start":23.555,"end":25.531,"text":"Le w'elese, t'o buru ju","marked":"Le w'ẹ́lẹ́sẹ̀, t'ó burú jù"},{"start":25.911,"end":27.065,"text":"Le m'okan lile ro.","marked":"Le m'ọkàn líle rò."}],"end":27.065},{"key":"5","start":28.015,"lines":[{"start":28.015,"end":29.182,"text":"Mo wole l'ese Re","marked":"Mo wọlé l'ẹsẹ̀ Rẹ"},{"start":29.562,"end":30.954,"text":"Jo k' O dariji mi","marked":"Jo k' Ó dariji mi"},{"start":31.334,"end":32.791,"text":"Nihin l'emi o wa titi","marked":"Níhìn l'èmi ò wà títí"},{"start":33.171,"end":34.061,"text":"Wo o wipe \"Dide.\"","marked":"Wò ó wípé Dídé."},{"start":34.441,"end":35.115,"text":"Amin.","marked":"Àmín."}],"end":35.115}]}