{"v":1,"coll":"y","num":740,"id":"hymn_740","title":"IRAWO wo l'eyi?","duration":44.138,"voices":{"male":{"file":"y-740-male.m4a","bytes":297368,"sha256":"a8b6a86b549883d4420e2b3509c1f26029bd4e3e703f99da6850f63d06e7623c","duration":44.2},"female":{"file":"y-740-female.m4a","bytes":315626,"sha256":"17ddf796b4159007e41bf6d500f6884133504bfa467423cda46f74465d85b68b","duration":44.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.591,"text":"IRAWO wo l'eyi?","marked":"Ìràwọ̀ wo l'èyí?"},{"start":1.971,"end":3.104,"text":"Wo b'o ti daa to","marked":"Wo b'ó ti dáa tó"},{"start":3.484,"end":4.629,"text":"Amona awon keferi","marked":"Amọ̀nà àwọn kèfèrí"},{"start":5.009,"end":6.298,"text":"S'odo Oba ogo.","marked":"S'odò Ọba ògo."}],"end":6.298},{"key":"2","start":7.248,"lines":[{"start":7.248,"end":8.347,"text":"Wo awon amoye","marked":"Wo àwọn amòye"},{"start":8.727,"end":9.544,"text":"Ti ila orun wa","marked":"Ti ìlà ọ̀run wá"},{"start":9.924,"end":11.571,"text":"Nwon wa fi ori bale fun","marked":"Nwọ̀n wá fi orí balẹ̀ fún"},{"start":11.951,"end":13.122,"text":"Jesu Olubukun.","marked":"Jésù Olùbùkún."}],"end":13.122},{"key":"3","start":14.072,"lines":[{"start":14.072,"end":15.282,"text":"Imole ti Emi","marked":"Ìmọ́lẹ̀̀ ti Ẹ̀mí"},{"start":15.662,"end":16.735,"text":"Ma sai tan n'ilu wa","marked":"Má ṣàì tán ń'ìlú wa"},{"start":17.115,"end":18.983,"text":"Fi ona han wa, ka le to","marked":"Fi ọ̀nà hàn wá, ká lè tọ́"},{"start":19.363,"end":20.372,"text":"Emmaueli wa.","marked":"Emmauélì wá."}],"end":20.372},{"key":"4","start":21.322,"lines":[{"start":21.322,"end":22.326,"text":"Gbogbo irun-male","marked":"Gbogbo irun-málè"},{"start":22.706,"end":23.769,"text":"Ati igba-male","marked":"Àti igba-mále"},{"start":24.149,"end":25.631,"text":"Ti ambo n'ile keferi","marked":"Ti ambo ń'ilẹ̀ kèfèrí"},{"start":26.011,"end":27.326,"text":"K'o yago fun Jesu.","marked":"K'ó yàgò fún Jésù."}],"end":27.326},{"key":"5","start":28.276,"lines":[{"start":28.276,"end":29.473,"text":"Ki gbogbo abore,","marked":"Kí gbogbo abọ́rẹ́"},{"start":29.853,"end":31.083,"text":"Ti mbe ni Afrika","marked":"Ti ḿbẹ ní Afrika"},{"start":31.463,"end":32.889,"text":"Je amoye li otito","marked":"Jẹ́ amòye li òtítọ́"},{"start":33.269,"end":34.527,"text":"Ki nwon gb'ebo Jesu.","marked":"Kí nwọn gb'ẹbọ Jésù."}],"end":34.527},{"key":"6","start":35.477,"lines":[{"start":35.477,"end":36.564,"text":"Baba Eleda wa","marked":"Bàbá Ẹlẹ́dàá wa"},{"start":36.944,"end":38.239,"text":"Ti o fi Jesu han","marked":"Tí ó fi Jésù hàn"},{"start":38.619,"end":39.794,"text":"Awon Keferi igbani","marked":"Àwọn Kèfèrí ìgbani"},{"start":40.174,"end":41.636,"text":"Fi han fun wa pelu.","marked":"Fi hàn fún wa pẹ̀lú."},{"start":42.016,"end":42.588,"text":"Amin.","marked":"Àmín."}],"end":42.588}]}