{"v":1,"coll":"y","num":223,"id":"hymn_223","title":"OLORUN t'odun t'o koja","duration":50.014,"voices":{"male":{"file":"y-223-male.m4a","bytes":359061,"sha256":"d5f526941434d43dde622e60b6547fa51a7b1416f2f3279b0d661414498216f4","duration":50.1},"female":{"file":"y-223-female.m4a","bytes":379642,"sha256":"b0cd4dce9938a226c9c9fcf8b1202458a92da581e58f32e55df85a0f488b312d","duration":50.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.975,"text":"OLORUN t'odun t'o koja","marked":"Ọlọ́run t'ọdún t'ó kọjá"},{"start":2.355,"end":3.474,"text":"Iret'eyi ti mbo","marked":"Iret'eyi ti ḿbọ"},{"start":3.854,"end":5.142,"text":"Ib'isadi wa ni iji","marked":"Ìb'ìsádi wà ní ìjì"},{"start":5.522,"end":6.802,"text":"At'ile wa lailai.","marked":"Àt'ilẹ̀ wà láíláí."}],"end":6.802},{"key":"2","start":7.752,"lines":[{"start":7.752,"end":9.016,"text":"Labe ojiji ite Re,","marked":"Lábẹ́ òjìji ìtẹ́ Rẹ"},{"start":9.396,"end":10.89,"text":"L' awon enia Re ngbe!","marked":"L' àwọn enia Rẹ̀ ngbẹ!"},{"start":11.27,"end":13.044,"text":"Tito l'apa Re nikansoso","marked":"Títò l'apá Rẹ nìkanṣoṣo"},{"start":13.424,"end":14.685,"text":"Abo wa si daju.","marked":"Àbó wa sì dájú."}],"end":14.685},{"key":"3","start":15.635,"lines":[{"start":15.635,"end":16.898,"text":"K'awon oke k'o to duro","marked":"K'àwọn òkè k'ó tó dúró"},{"start":17.278,"end":18.804,"text":"Tabi k'a to d'aiye","marked":"Tàbí k'á tó d'áíyé"},{"start":19.184,"end":20.61,"text":"Lailai Iwo ni Olorun","marked":"Láíláí Ìwọ ni Ọlọ́run"},{"start":20.99,"end":22.813,"text":"Bakanna, ailopin.","marked":"Bákanná, àìlópin."}],"end":22.813},{"key":"4","start":23.763,"lines":[{"start":23.763,"end":25.035,"text":"Egbegberu odun l'oju Re,","marked":"Egbègbèrú ọdún l'ojú Rẹ"},{"start":25.415,"end":26.739,"text":"Bi ale kan l'ori","marked":"Bí alẹ́ kan l'orí"},{"start":27.119,"end":28.731,"text":"B'iso kan l'afemojumo","marked":"B'íṣọ́ kan l'àfẹ̀mọ́júmọ́"},{"start":29.111,"end":30.503,"text":"Ki orun k'o to la.","marked":"Kí ọrùn k'ó tó là."}],"end":30.503},{"key":"5","start":31.453,"lines":[{"start":31.453,"end":32.869,"text":"Ojo wa bi odo sisan","marked":"Ọjọ́ wa bí odò sísan"},{"start":33.249,"end":34.457,"text":"Opo l'o si ngbe lo","marked":"Ọ̀pọ̀ l'ó sì ngbe lọ"},{"start":34.837,"end":37.457,"text":"Nwon nlo, nwon di eni'gbagbe","marked":"Nwọ̀n ńlò, nwọ̀n di ẹni'gbàgbé"},{"start":37.837,"end":39.178,"text":"Bi ala ti a nro.","marked":"Bí àlá tí a ńrọ́."}],"end":39.178},{"key":"6","start":40.128,"lines":[{"start":40.128,"end":41.728,"text":"Olorun t'odun t'o koja","marked":"Ọlọ́run t'ọdún t'ó kọjá"},{"start":42.108,"end":43.254,"text":"Iret'eyi ti mbo","marked":"Iret'eyi ti ḿbọ"},{"start":43.634,"end":45.691,"text":"Mas'abo wa 'gba 'yonu de,","marked":"Mas'abo wá 'gbá 'yọnu dé"},{"start":46.071,"end":47.408,"text":"At'ile wa lailai.","marked":"Àt'ilẹ̀ wà láíláí."},{"start":47.788,"end":48.464,"text":"Amin.","marked":"Àmín."}],"end":48.464}]}