{"v":1,"coll":"y","num":63,"id":"hymn_63","title":"BABA jo gbo temi","duration":44.186,"voices":{"male":{"file":"y-63-male.m4a","bytes":307113,"sha256":"e4e3f6bf58db266dcc52c0fdffc0699f4ce681df9c6b4d9ccdfa522b70072cd9","duration":44.2},"female":{"file":"y-63-female.m4a","bytes":311899,"sha256":"5bdd49d20fb3be9538326d88432330815a7e42d3578705344fa94770582baafa","duration":44.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.565,"text":"BABA jo gbo temi","marked":"Bàbá jọ gbọ́ tèmi"},{"start":1.945,"end":2.938,"text":"Mo wole lese Re","marked":"Mo wọlé lẹ́sẹ̀ Rẹ"},{"start":3.318,"end":5.57,"text":"'Wo to nwosan to ndariji,","marked":"'Wò tó nwosan tó ńdáríjì"},{"start":5.95,"end":7.248,"text":"Jowo gbadura wa.","marked":"Jọ̀wọ́ gbàdúrà wa."}],"end":7.248},{"key":"2","start":8.198,"lines":[{"start":8.198,"end":9.217,"text":"Olorun Oluwa,","marked":"Ọlọ́run Olúwa"},{"start":9.597,"end":10.59,"text":"Jehofa Oba mi,","marked":"Jèhófà Ọba mi"},{"start":10.97,"end":12.269,"text":"'Wo to tedo sinu 'mole","marked":"'Wo tó tẹ̀dó sínú 'mọ́lẹ̀"},{"start":12.649,"end":13.848,"text":"Ajuba O'ko Re.","marked":"Àjúbà O'kọ Rẹ."}],"end":13.848},{"key":"3","start":14.798,"lines":[{"start":14.798,"end":16.002,"text":"Tali oba ti aiye?","marked":"Tàlì ọba ti aiye?"},{"start":16.382,"end":17.948,"text":"Jesu Emmanuel,","marked":"Jésù Emmanuel"},{"start":18.328,"end":20.121,"text":"Gbongbo Jesse Eni 'Yanu","marked":"Gbọ̀ngbò Jesse Eni 'Yanu"},{"start":20.501,"end":21.674,"text":"Ran 'ranwo Re si mi.","marked":"Rán 'ránwọ́ Rẹ̀ sí mi."}],"end":21.674},{"key":"4","start":22.624,"lines":[{"start":22.624,"end":23.77,"text":"Mimo Mimo julo","marked":"Mímọ́ Mímọ́́ jùlọ"},{"start":24.15,"end":25.038,"text":"Oba Olugbala","marked":"Ọba Olùgbàlà"},{"start":25.418,"end":26.978,"text":"Alagbara ninu orun","marked":"Alágbára nínú ọ̀run"},{"start":27.358,"end":28.49,"text":"Ranti majemu Re.","marked":"Rántí májẹ̀mú Rẹ."}],"end":28.49},{"key":"5","start":29.44,"lines":[{"start":29.44,"end":30.465,"text":"Lowuro gbo temi,","marked":"Lówùrọ́ gbọ́ tèmi"},{"start":30.845,"end":31.988,"text":"Losan gbo ebe mi,","marked":"Lọ́sàn gbọ́ ẹ̀bẹ̀ mi"},{"start":32.368,"end":33.842,"text":"Loju ale gbat'orun wo","marked":"Lójú alẹ́ gbat'ọrùn wo"},{"start":34.222,"end":35.739,"text":"Jowo gbo ebe mi.","marked":"Jọ̀wọ́ gbọ́ ẹ̀bẹ̀ mi."}],"end":35.739},{"key":"6","start":36.689,"lines":[{"start":36.689,"end":37.781,"text":"Ogo fun Baba wa,","marked":"Ògo fún Bàbá wa"},{"start":38.161,"end":39.305,"text":"Ogo ni fun Omo Re","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":39.685,"end":40.84,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":41.22,"end":42.636,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."}],"end":42.636}]}