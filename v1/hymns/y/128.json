{"v":1,"coll":"y","num":128,"id":"hymn_128","title":"OMO Egbe Seraf' dide","duration":96.921,"voices":{"male":{"file":"y-128-male.m4a","bytes":720239,"sha256":"eaee47a3d47c2a1ce5cea315d888e7896b7f94a711474ccb07588f93f18255aa","duration":97.0},"female":{"file":"y-128-female.m4a","bytes":765987,"sha256":"28fb3496a6d19ddce2c2253345fcce8ba82187709810a481e2cc1787642729dd","duration":97.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.864,"text":"OMO Egbe Seraf' dide","marked":"Ọmọ Ẹgbẹ́ Séráf' dìde"},{"start":2.244,"end":3.618,"text":"Dide lati b'esu jagun","marked":"Dídé láti b'èṣù jagun"},{"start":3.998,"end":5.354,"text":"Jesu Olugbala segun","marked":"Jésù Olùgbàlà ṣẹ́gun"},{"start":5.734,"end":7.188,"text":"Sise n'nu ogba Oluwa re.","marked":"Ṣíṣe ń'nú ọgbà Olúwa rẹ."},{"start":7.568,"end":8.863,"text":"Egbe:  Sise n'nu ogba Oluwa re,","marked":"Ṣíṣe ń'nú ọgbà Olúwa rẹ"},{"start":9.243,"end":10.261,"text":"Sise... Sise... Wa,","marked":"Ṣíṣe Ṣiṣẹ́ Wa"},{"start":10.641,"end":11.958,"text":"Sise ki 'kore to de.","marked":"Ṣíṣe kí 'kórè tó dé."}],"end":11.958},{"key":"CHORUS","start":12.908,"lines":[{"start":12.908,"end":14.399,"text":"Sise n'nu ogba Oluwa re,","marked":"Ṣíṣe ń'nú ọgbà Olúwa rẹ"},{"start":14.779,"end":15.763,"text":"Sise... Sise... Wa,","marked":"Ṣíṣe Ṣiṣẹ́ Wa"},{"start":16.143,"end":17.866,"text":"Sise ki 'kore to de.","marked":"Ṣíṣe kí 'kórè tó dé."}],"end":17.866},{"key":"2","start":18.816,"lines":[{"start":18.816,"end":20.08,"text":"Omo Egbe Kerub dide","marked":"Ọmọ Ẹgbẹ́ Kerub dìde"},{"start":20.46,"end":22.145,"text":"Opo Okan lo ti daku","marked":"Ọ̀pọ̀ Ọkàn ló ti dákú"},{"start":22.525,"end":24.096,"text":"Opo lo si ti sako lo,","marked":"Ọ̀pọ̀ ló sì ti ṣáko lọ"},{"start":24.476,"end":26.572,"text":"Jesu npe nyin, e bo wa 'le.","marked":"Jésù ńpẹ́ nyin, ẹ bọ̀ wá 'le."},{"start":26.952,"end":27.857,"text":"Egbe:  Sise n'nu ogba...","marked":"Ṣíṣe ń'nú ọgbà"}],"end":27.857},{"key":"3","start":28.807,"lines":[{"start":28.807,"end":30.704,"text":"Aladura ti mura tan","marked":"Alàdúrà ti múra tán"},{"start":31.084,"end":32.841,"text":"Lati gbe ogo Jesu ga;","marked":"Láti gbé ògo Jésù ga"},{"start":33.221,"end":34.785,"text":"B'aje kan ta felefele","marked":"B'aje kan ta fẹ́lẹ́fẹ́lẹ́"},{"start":35.165,"end":36.795,"text":"Maikeli Balogun wa ti de.","marked":"Máíkẹ́lì Balógun wa ti dé."},{"start":37.175,"end":38.217,"text":"Egbe:  Sise n'nu ogba...","marked":"Ṣíṣe ń'nú ọgbà"}],"end":38.217},{"key":"4","start":39.167,"lines":[{"start":39.167,"end":41.048,"text":"Joshua sise, o si ye","marked":"Joshua ṣiṣẹ́, ó sì yẹ"},{"start":41.428,"end":43.156,"text":"Serafu y'o sise re ye","marked":"Séráfù y'ó ṣiṣẹ́ rẹ̀ yé"},{"start":43.536,"end":45.45,"text":"Elijah sise, o si ye","marked":"Elijah ṣiṣẹ́, ó sì yẹ"},{"start":45.83,"end":47.575,"text":"Kerubu y'o sise re ye.","marked":"Kérúbù y'ó ṣiṣẹ́ rẹ̀ yé."},{"start":47.955,"end":49.011,"text":"Egbe:  Sise n'nu ogba...","marked":"Ṣíṣe ń'nú ọgbà"}],"end":49.011},{"key":"5","start":49.961,"lines":[{"start":49.961,"end":51.861,"text":"Shedrak sise, o si ye,","marked":"Shedrak ṣiṣẹ́, ó sì yẹ"},{"start":52.241,"end":54.143,"text":"Mesaki sise o si ye,","marked":"Mèsákì ṣíṣe ó sì yẹ"},{"start":54.523,"end":56.387,"text":"Abednigo se o si ye","marked":"Àbẹ̀dnìgò ṣe ó sì yẹ"},{"start":56.767,"end":58.735,"text":"Serafu yio se l'aseye.","marked":"Séráfù yíó ṣe l'àṣeyẹ."},{"start":59.115,"end":60.12,"text":"Egbe:  Sise n'nu ogba...","marked":"Ṣíṣe ń'nú ọgbà"}],"end":60.12},{"key":"6","start":61.07,"lines":[{"start":61.07,"end":63.128,"text":"Abraham sise, o si ye,","marked":"Abraham ṣiṣẹ́, ó sì yé"},{"start":63.508,"end":65.835,"text":"Isaaki sise, o si ye,","marked":"Ísáákì ṣiṣẹ́, ó sì yẹ"},{"start":66.215,"end":67.786,"text":"Jakobu sise l'aseye","marked":"Jákọ́bù ṣiṣẹ́ l'àṣeyẹ"},{"start":68.166,"end":69.786,"text":"T'Egbe Aladura yio ye.","marked":"T'Ẹgbẹ́ Aladura yìó yé."},{"start":70.166,"end":71.173,"text":"Egbe:  Sise n'nu ogba...","marked":"Ṣíṣe ń'nú ọgbà"}],"end":71.173},{"key":"7","start":72.123,"lines":[{"start":72.123,"end":73.57,"text":"Ope ni fun Olugbala","marked":"Ọpẹ́ ni fún Olùgbàlà"},{"start":73.95,"end":75.618,"text":"To wa s'aye aginju yi","marked":"Tó wá s'áyé aginjù yí"},{"start":75.998,"end":77.752,"text":"To bo ogo Re s' apa kan","marked":"Tó bọ́ ògo Rẹ̀ s' apá kan"},{"start":78.132,"end":79.651,"text":"O jiya ka le ri 'gbala.","marked":"Ó jìyà ká lè rí 'gbàlà."},{"start":80.031,"end":81.112,"text":"Egbe:  Sise n'nu ogba...","marked":"Ṣíṣe ń'nú ọgbà"}],"end":81.112},{"key":"8","start":82.062,"lines":[{"start":82.062,"end":83.564,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":83.944,"end":85.247,"text":"E f'ogo fun baba loke","marked":"Ẹ f'ògò fún bàbá lókè"},{"start":85.627,"end":86.873,"text":"E f'ogo fun Omo Re","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":87.253,"end":88.787,"text":"E f'ogo fun Emi Mimo.","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́́."},{"start":89.167,"end":90.576,"text":"Egbe:  Sise n'nu ogba Oluwa re,","marked":"Ṣíṣe ń'nú ọgbà Olúwa rẹ"},{"start":90.956,"end":91.935,"text":"Sise... Sise... Wa,","marked":"Ṣíṣe Ṣiṣẹ́ Wa"},{"start":92.315,"end":94.401,"text":"Sise ki 'kore to de.","marked":"Ṣíṣe kí 'kórè tó dé."},{"start":94.781,"end":95.371,"text":"Amin.","marked":"Àmín."}],"end":95.371}]}