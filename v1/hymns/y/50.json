{"v":1,"coll":"y","num":50,"id":"hymn_50","title":"BABA Oludariji, Dariji","duration":44.738,"voices":{"male":{"file":"y-50-male.m4a","bytes":331679,"sha256":"83072e322f6968aa1a9f7e9aaa3fb2739a70bcfa3d39339d8c6a0b83ecd699d0","duration":44.8},"female":{"file":"y-50-female.m4a","bytes":340779,"sha256":"4e401594bdf4edd4925034244c610923e3e73a485338c263b67f17ed25490f54","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.686,"text":"BABA Oludariji, Dariji","marked":"Bàbá Olùdáríjì, Dáríjì"},{"start":3.066,"end":5.111,"text":"Gbogbo awa omo Re, Dariji,","marked":"Gbogbo àwa ọmọ Rẹ, Dáríjì"},{"start":5.491,"end":6.601,"text":"Awa Egbe Serafu,","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":6.981,"end":8.225,"text":"Ati Egbe Kerubu","marked":"Àti Ẹgbẹ́ Kérúbù"},{"start":8.605,"end":10.77,"text":"Ati npafo ninu ese, Dariji.","marked":"Àti ńpafọ́ nínú ẹ̀ṣẹ̀, Dáríjì."}],"end":10.77},{"key":"2","start":11.72,"lines":[{"start":11.72,"end":13.578,"text":"JESU OLUGBALA WA Dariji","marked":"Jésù Olùgbàlà Wa Dáríjì"},{"start":13.958,"end":15.297,"text":"OLURADAPA Eda Dariji,","marked":"Olùràdàpà Ẹ̀dá Dáríjì"},{"start":15.677,"end":17.002,"text":"Wo to mbebe f'ota Re","marked":"Wò tó ḿbẹ̀bẹ̀ f'ọ̀tá Rẹ"},{"start":17.382,"end":18.565,"text":"L'origi Agbelebu","marked":"L'origi Àgbélébùú"},{"start":18.945,"end":20.876,"text":"Wipe fiji won BABA Dariji.","marked":"Wípé fíjì wọ́n Bàbá Dáríjì."}],"end":20.876},{"key":"3","start":21.826,"lines":[{"start":21.826,"end":23.512,"text":"EMI OLUTUNU wa, Daniji","marked":"Èmi Olùtùnú wa, Dáníjí"},{"start":23.892,"end":26.243,"text":"Gbogbo ebi ese wa, Dariji","marked":"Gbogbo ẹ̀bi ẹ̀ṣẹ̀ wa, Dáríjì"},{"start":26.623,"end":27.921,"text":"Gba wa lojo idamu","marked":"Gbà wá lọ́jọ́ ìdàmú"},{"start":28.301,"end":29.47,"text":"Se Oluranlowo wa,","marked":"Ṣé Olùrànlọ́wọ́ wa"},{"start":29.85,"end":31.666,"text":"Mase jeki a bohun Dariji.","marked":"Masẹ̀ jẹkì á bọ́hùn Dáríjì."}],"end":31.666},{"key":"4","start":32.616,"lines":[{"start":32.616,"end":34.422,"text":"METALOKAN jowo wa Dariji","marked":"Mẹ́talọ́kan jọ̀wọ́ wa Dáríjì"},{"start":34.802,"end":36.715,"text":"Omode ati Agba Dariji,","marked":"Ọmọdé àti Àgbà Dáríjì"},{"start":37.095,"end":38.351,"text":"JAH JEHOVAH RAMMAH","marked":"Jah Jehovah Rammah"},{"start":38.731,"end":40.024,"text":"'Wo l'Oba Oniyonu,","marked":"'Wò l'Ọba Oníyọnu"},{"start":40.404,"end":42.17,"text":"Dariji 'se owo Re Dariji.","marked":"Dáríjì 'ṣe ọwọ́ Rẹ̀ Dáríjì."},{"start":42.55,"end":43.188,"text":"Amin.","marked":"Àmín."}],"end":43.188}]}