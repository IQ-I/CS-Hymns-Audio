{"v":1,"coll":"y","num":193,"id":"hymn_193","title":"ONIDAJO na de, O de!","duration":37.232,"voices":{"male":{"file":"y-193-male.m4a","bytes":271152,"sha256":"ea63417f2759de84c0d7a392b16e3dd36f5f9599e58c0e55557fc456cefac7f4","duration":37.3},"female":{"file":"y-193-female.m4a","bytes":274243,"sha256":"c16ce291c9bc637c4894d6813b278e1fcadf8d35192438d9682970a4f24d47a4","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.946,"text":"ONIDAJO na de, O de!","marked":"Onídàjọ́ ná dé, Ó dé!"},{"start":2.326,"end":4.011,"text":"Beni 'pe keje ti ndun nwi","marked":"Bẹni 'pe keje ti ndun ńwí"},{"start":4.391,"end":6.815,"text":"Manamana nko, ara nsan","marked":"Mànàmáná ńkọ́, ara ńsán"},{"start":7.195,"end":8.66,"text":"Onigbagbo y'o ti yo to!","marked":"Onígbàgbọ́ y'ó ti yọ́ tó!"}],"end":8.66},{"key":"2","start":9.61,"lines":[{"start":9.61,"end":11.526,"text":"A ngbo, Angel orun nwipe","marked":"A ńgbọ́, Angel ọ̀run ńwipe"},{"start":11.906,"end":13.31,"text":"Jesu Oluwa wa d'ade","marked":"Jésù Olúwa wa d'adé"},{"start":13.69,"end":15.193,"text":"Ore'Ofe l'On fi damure","marked":"Ọ̀rẹ́'Ọ̀fẹ́ l'Òn fi dámùrè"},{"start":15.573,"end":17.387,"text":"Ogo l'On fi s'oso boju.","marked":"Ògo l'Òn fi ṣ'ọ́ṣọ́ bojú."}],"end":17.387},{"key":"3","start":18.337,"lines":[{"start":18.337,"end":20.044,"text":"'Wo sokale l'or'ite Re","marked":"'Wo sọ̀kalẹ̀ l'or'ite Rẹ"},{"start":20.424,"end":21.854,"text":"O gba ijoba fun 'ra Re","marked":"Ó gba ìjọba fún 'ra Rẹ̀"},{"start":22.234,"end":23.916,"text":"Ijoba gbogbo gba Tire","marked":"Ìjọba gbogbo gba Tìrẹ"},{"start":24.296,"end":26.003,"text":"Nwon gba b'Oluwa t'o segun.","marked":"Nwọn gba b'Olúwa t'ó ṣẹ́gun."}],"end":26.003},{"key":"4","start":26.953,"lines":[{"start":26.953,"end":28.935,"text":"Gbogbo ara orun, e ho","marked":"Gbogbo ará ọ̀run, ẹ hó"},{"start":29.315,"end":30.778,"text":"At' enia Oluwa wa,","marked":"Àt' enia Olúwa wa"},{"start":31.158,"end":32.719,"text":"Oga ogo t'o gba ola","marked":"Ọ̀gá ògo t'ó gba ọlá"},{"start":33.099,"end":34.819,"text":"Yio joba lai ati lai.","marked":"Yíó jọba láì àti láì."},{"start":35.199,"end":35.682,"text":"Amin.","marked":"Àmín."}],"end":35.682}]}