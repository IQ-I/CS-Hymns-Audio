{"v":1,"coll":"y","num":368,"id":"hymn_368","title":"JERUSALEMU ibi ayo","duration":47.91,"voices":{"male":{"file":"y-368-male.m4a","bytes":346276,"sha256":"7fe05e86beedf81bfa035beaf29cf4bca4fe62f33c3e4f579c205cd35f029819","duration":48.0},"female":{"file":"y-368-female.m4a","bytes":354364,"sha256":"4c07c7895cf099f082f2e18b5845910b9324f1b994dad146f281a82977a6cf4f","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.003,"text":"JERUSALEMU ibi ayo","marked":"Jerúsálẹ́mù ibi ayọ̀"},{"start":2.383,"end":3.474,"text":"T'o se owon fun mi","marked":"T'ó ṣe ọwọ̀n fún mi"},{"start":3.854,"end":5.137,"text":"'Gbawo n'ise mi o pari","marked":"'Gbáwọ́ n'iṣẹ́ mi ò parí"},{"start":5.517,"end":6.718,"text":"L'ayo l'alafia.","marked":"L'ayo l'àlàáfíà."}],"end":6.718},{"key":"2","start":7.668,"lines":[{"start":7.668,"end":9.216,"text":"Gbawo ni oju mi y'o ri","marked":"Gbàwọ́ ní ojú mi y'ó rí"},{"start":9.596,"end":10.88,"text":"Enu bode pearl Re?","marked":"Ẹnu bodè pearl Re?"},{"start":11.26,"end":12.965,"text":"Odi re t'o le fun 'gbala","marked":"Odi rẹ t'ó le fún 'gbàlà"},{"start":13.345,"end":14.613,"text":"Ita wura didan.","marked":"Ìta wúrà dídán."}],"end":14.613},{"key":"3","start":15.563,"lines":[{"start":15.563,"end":16.972,"text":"Gbawo, ilu Olorun mi","marked":"Gbàwọ̀, ìlú Ọlọ́run mi"},{"start":17.352,"end":18.512,"text":"L'emi o d'afin Re?","marked":"L'èmi ò d'áfín Rẹ?"},{"start":18.892,"end":20.484,"text":"Nibiti Ijo ki 'tuka","marked":"Níbitì Ìjọ kí 'túká"},{"start":20.864,"end":22.47,"text":"N'ib'ayo ailopin.","marked":"N'ib'ayo àìlópin."}],"end":22.47},{"key":"4","start":23.42,"lines":[{"start":23.42,"end":24.763,"text":"Ese t'emi o ko iya","marked":"Ẹṣẹ́ t'èmí ò kó ìyá"},{"start":25.143,"end":26.322,"text":"lku at'iponju","marked":"lku àt'ìpọ́njú"},{"start":26.702,"end":28.314,"text":"Mo nwo ile rere Kenaan","marked":"Mo ńwọ́ ilẹ̀ rere Kénáán"},{"start":28.694,"end":29.915,"text":"Ile 'mole titi.","marked":"Ilẹ̀ 'mọ́lẹ̀ títí."}],"end":29.915},{"key":"5","start":30.865,"lines":[{"start":30.865,"end":33.357,"text":"Aposteli, Martyr, Woli","marked":"Aposteli, Martyr, Wòlí"},{"start":33.737,"end":34.804,"text":"Nwon y'Olugbala ka","marked":"Nwọn y'Olùgbàlà kà"},{"start":35.184,"end":37.203,"text":"Awa tikara wa, fere","marked":"Àwa tìkára wa, fèrè"},{"start":37.583,"end":38.833,"text":"Dapo mo ogun na.","marked":"Dàpọ̀ mọ́ ogun ná."}],"end":38.833},{"key":"6","start":39.783,"lines":[{"start":39.783,"end":41.309,"text":"Jerusalem ilu ayo","marked":"Jerusalem ilu ayọ̀"},{"start":41.689,"end":42.827,"text":"Okan mi nfa si O","marked":"Ọkàn mi ńfà sí Ọ"},{"start":43.207,"end":44.696,"text":"'Gbati mo ba ri ayo re","marked":"'Gbàtì mo bá rí ayọ̀ rẹ"},{"start":45.076,"end":46.36,"text":"lse mi y'o pari.","marked":"lse mi y'ó parí."}],"end":46.36}]}