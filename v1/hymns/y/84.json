{"v":1,"coll":"y","num":84,"id":"hymn_84","title":"ENYIN Angeli to wa l'orun","duration":97.103,"voices":{"male":{"file":"y-84-male.m4a","bytes":725580,"sha256":"a0b17e31a5e8ab2820fa8fc28f8dbd57407ab4030c3928350099973e89a96ffa","duration":97.2},"female":{"file":"y-84-female.m4a","bytes":749183,"sha256":"917ca583c454545eb2d4817e121f483412505b79f035c5e008a6be07b1c85f31","duration":97.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.931,"text":"ENYIN Angeli to wa l'orun","marked":"Enyin Áńgẹ́lì tó wà l'ọ̀run"},{"start":2.311,"end":3.531,"text":"E fi iyin fun Baba,","marked":"Ẹ fi ìyìn fún Bàbá"},{"start":3.911,"end":5.721,"text":"F'Egbe to da sile laiye","marked":"F'Ègbé tó dá sílẹ̀ láìyẹ"},{"start":6.101,"end":7.16,"text":"Fun igbala emi,","marked":"Fún ìgbàlà ẹ̀mí"},{"start":7.54,"end":8.856,"text":"O ye ki inu wa ko dun","marked":"Ó yẹ kí inú wa kó dùn"},{"start":9.236,"end":10.913,"text":"Ki awa ki o si ma yo!","marked":"Kí àwa kí ó sì má yọ̀!"},{"start":11.293,"end":12.762,"text":"Fun iranti lku Jesu","marked":"Fún ìrántí lku Jésù"},{"start":13.142,"end":14.238,"text":"Lori Agbelebu.","marked":"Lórí Àgbélébùú."}],"end":14.238},{"key":"CHORUS","start":15.188,"lines":[{"start":15.188,"end":17.082,"text":"A pa lase I'agbala orun","marked":"A pa láṣẹ l'ágbálà ọ̀run"},{"start":17.462,"end":19.156,"text":"Pe k'Egbe yi ma bi si","marked":"Pé k'Ẹgbẹ́ yí mà bí sí"},{"start":19.536,"end":20.999,"text":"A pa lase I'agbala orun","marked":"A pa láṣẹ l'ágbálà ọ̀run"},{"start":21.379,"end":23.076,"text":"Pe O si ma re si;","marked":"Pé Ó ṣì má rẹ̀ sí"},{"start":23.456,"end":24.907,"text":"Titi gbogbo ifoju okan","marked":"Títí gbogbo ìfọ́jú ọkàn"},{"start":25.287,"end":26.62,"text":"Yio fi tan laiye","marked":"Yíó fi tán láìyẹ"},{"start":27.0,"end":28.189,"text":"T'iku Jesu Oluwa wa,","marked":"T'ikú Jésù Olúwa wa"},{"start":28.569,"end":29.861,"text":"Ko ni je asan mo.","marked":"Kò ní jẹ́ asán mọ́."}],"end":29.861},{"key":"2","start":30.811,"lines":[{"start":30.811,"end":32.537,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":32.917,"end":34.207,"text":"E fi iyin fun Baba","marked":"Ẹ fi ìyìn fún Bàbá"},{"start":34.587,"end":35.956,"text":"Ti o da Egbe yi sile,","marked":"Tí ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":36.336,"end":37.557,"text":"Pe k'a le ri igbala,","marked":"Pé k'á lè rí ìgbàlà"},{"start":37.937,"end":39.793,"text":"“Torina, e je k'a mura","marked":"Torina, ẹ jẹ k'á múra"},{"start":40.173,"end":41.356,"text":"Lati sare ije yi,","marked":"Láti sáré ìje yí"},{"start":41.736,"end":43.278,"text":"Bi a ba foriti d'opin","marked":"Bí a bá forítì d'òpin"},{"start":43.658,"end":45.087,"text":"Iye y'o je ti wa.","marked":"Iye y'ó jẹ́ ti wa."},{"start":45.467,"end":46.299,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"}],"end":46.299},{"key":"3","start":47.249,"lines":[{"start":47.249,"end":49.387,"text":"Gbogbo ise wa ti a nse,","marked":"Gbogbo iṣẹ́ wa tí a ńṣe"},{"start":49.767,"end":50.958,"text":"Gbogbo iwa ti a nhu,","marked":"Gbogbo ìwà tí a nhu"},{"start":51.338,"end":53.36,"text":"Gbogbo oro wa ti a nso,","marked":"Gbogbo ọ̀rọ̀ wa tí a ǹṣó"},{"start":53.74,"end":54.881,"text":"E je k'a ma sora;","marked":"Ẹ jẹ́ k'á má ṣọ́ra"},{"start":55.261,"end":56.372,"text":"Nitori Oluwa yio mu,","marked":"Nítorí Olúwa yio mú"},{"start":56.752,"end":58.07,"text":"Gbogbo 'se wa si 'dajo","marked":"Gbogbo 'ṣe wá sí 'dájọ́"},{"start":58.45,"end":59.909,"text":"Ati gbogbo ohun 'koko","marked":"Àti gbogbo ohun 'koko"},{"start":60.289,"end":61.512,"text":"Ire tabi ibi.","marked":"Ìre tàbí ibi."},{"start":61.892,"end":62.715,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"}],"end":62.715},{"key":"4","start":63.665,"lines":[{"start":63.665,"end":64.994,"text":"Awa ni imole aiye","marked":"Àwa ní ìmọ́lẹ̀̀ aiye"},{"start":65.374,"end":66.777,"text":"Lati le okunkun lo,","marked":"Láti lé òkùnkùn lọ"},{"start":67.157,"end":68.349,"text":"Ilu ta te sori oke","marked":"Ìlú ta tẹ́ sórí òkè"},{"start":68.729,"end":70.051,"text":"A ko le fara sin;","marked":"A kò lè fara sin"},{"start":70.431,"end":71.943,"text":"Awa si ni iyo aiye","marked":"Àwa sì ni iyọ̀ aiye"},{"start":72.323,"end":73.642,"text":"Ti a o mu aiye dun","marked":"Tí a ó mú aiye dùn"},{"start":74.022,"end":75.555,"text":"Sugbon b'iyo ba di obu,","marked":"Ṣùgbọ́n b'iyọ̀ bá di òbù"},{"start":75.935,"end":77.03,"text":"Bawo ni yio se dun?","marked":"Báwo ni yío ṣe dùn?"},{"start":77.41,"end":78.149,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"}],"end":78.149},{"key":"5","start":79.099,"lines":[{"start":79.099,"end":80.479,"text":"Ope lo ye Olugbala,","marked":"Ọpẹ́ ló yẹ Olùgbàlà"},{"start":80.859,"end":82.309,"text":"Fun ife to ni si wa,","marked":"Fún ìfẹ́ tó ní sí wa"},{"start":82.689,"end":84.005,"text":"Ti o pe wa si Egbe yi,","marked":"Tí ó pè wá sí Ẹgbẹ́ yí"},{"start":84.385,"end":85.452,"text":"Oko 'gbala 'kehin","marked":"Ọkọ̀ 'gbàlà 'kẹ́hìn"},{"start":85.832,"end":87.553,"text":"Ogo, ola at'agbara","marked":"Ògo, ọlá àt'ágbára"},{"start":87.933,"end":89.198,"text":"Ola nla at'ipa","marked":"Ọlá ńlá àt'ipa"},{"start":89.578,"end":91.645,"text":"Ni fun Baba, Omo, Emi","marked":"Ní fún Bàbá, Ọmọ, Èmi"},{"start":92.025,"end":93.461,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."},{"start":93.841,"end":94.604,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"},{"start":94.984,"end":95.553,"text":"Amin.","marked":"Àmín."}],"end":95.553}]}