{"v":1,"coll":"y","num":65,"id":"hymn_65","title":"ELESE wa s'orisun na","duration":41.005,"voices":{"male":{"file":"y-65-male.m4a","bytes":289568,"sha256":"a948248e27bbc2cb652aa6bd6e9819a00e16ce0da958050347d2eee943dffab9","duration":41.1},"female":{"file":"y-65-female.m4a","bytes":298839,"sha256":"7191c4809d524e6b29c2370a44fbc50d37da3828bd8a1e8988b7b37c8d53b0a1","duration":41.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.79,"text":"ELESE wa s'orisun na,","marked":"Ẹlẹ́sẹ̀ wa s'orísun ná"},{"start":2.17,"end":3.337,"text":"Wa pelu 'banuje re,","marked":"Wà pẹ̀lú 'banújẹ́ rẹ"},{"start":3.717,"end":4.975,"text":"Ri won sinu omi jijin","marked":"Rì wọ́n sínú omi jíjìn"},{"start":5.355,"end":6.612,"text":"'Wo y'o r'irorun nibe.","marked":"'Wò y'ó r'irọ̀rùn níbẹ̀."}],"end":6.612},{"key":"CHORUS","start":7.562,"lines":[{"start":7.562,"end":9.901,"text":"Yara kalo, mase duro","marked":"Yàrá kalo, máṣe dúró"},{"start":10.281,"end":12.216,"text":"lseju kan le so emi re nu","marked":"lṣẹ́jú kan lè sọ ẹ̀mí rẹ̀ nù"},{"start":12.596,"end":14.262,"text":"Jesu nduro Iati gba o,","marked":"Jésù ńdúró láti gbà ọ́"},{"start":14.642,"end":16.029,"text":"Anu mbe fun o loni.","marked":"Ànú ḿbẹ fún ọ lónì."}],"end":16.029},{"key":"2","start":16.979,"lines":[{"start":16.979,"end":18.649,"text":"Wa t'iwo t'eru ese re","marked":"Wá t'ìwo t'ẹ̀rù ẹsẹ̀ rẹ"},{"start":19.029,"end":20.545,"text":"Jesu ti nduro de o,","marked":"Jésù ti ńdúró dè ọ́"},{"start":20.925,"end":22.386,"text":"B'ese re pon bi alari,","marked":"B'ẹsẹ̀ rẹ̀ pọ́n bí alári"},{"start":22.766,"end":24.163,"text":"Nwon yio funfun bi sno.","marked":"Nwọ̀n yíó funfun bí sno."}],"end":24.163},{"key":"3","start":25.113,"lines":[{"start":25.113,"end":26.492,"text":"Jesu olugbala wipe,","marked":"Jésù Olùgbàlà wípé"},{"start":26.872,"end":28.141,"text":"Awon ti o ba gbagbo","marked":"Àwọn tí ò bá gbàgbọ́"},{"start":28.521,"end":29.831,"text":"Ti nwon si ronupiwada","marked":"Ti nwọn sì ronúpìwàdà"},{"start":30.211,"end":31.614,"text":"Y'o r'iye gba lodo re.","marked":"Y'ó r'iye gbà lọ́dọ̀ rẹ̀."}],"end":31.614},{"key":"4","start":32.564,"lines":[{"start":32.564,"end":34.024,"text":"Wa we ninu orisun na,","marked":"Wá wé nínú orísun ná"},{"start":34.404,"end":35.722,"text":"F'eti si ohun ife","marked":"F'etí sí ohun ìfẹ́"},{"start":36.102,"end":37.548,"text":"Jeki awon Angeli yio","marked":"Jẹki àwọn Áńgẹ́lì yìọ"},{"start":37.928,"end":39.455,"text":"F'elese to yi pada.","marked":"F'ẹlẹ́sẹ̀ tó yí padà."}],"end":39.455}]}