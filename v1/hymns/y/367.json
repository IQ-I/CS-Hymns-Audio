{"v":1,"coll":"y","num":367,"id":"hymn_367","title":"WA k'a da m'awon ore wa","duration":48.091,"voices":{"male":{"file":"y-367-male.m4a","bytes":344688,"sha256":"03fbb15046da6845d0ad7c68eccce344800978f9e3720a4a05de3d0215188e2a","duration":48.1},"female":{"file":"y-367-female.m4a","bytes":357935,"sha256":"c92dba13498effc834ffdd0334a2e22ad02ece966608cc1b0e89b978ce5dc43e","duration":48.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.914,"text":"WA k'a da m'awon ore wa","marked":"Wá k'á da ḿ'àwọn ọ̀rẹ́ wa"},{"start":2.294,"end":3.63,"text":"Ti nwon ti jere na","marked":"Ti nwọn ti jèrè ná"},{"start":4.01,"end":5.667,"text":"N'ife k'a okan ba won lo","marked":"N'ife k'á ọkàn bá wọn lò"},{"start":6.047,"end":7.096,"text":"S'ode orun lohun.","marked":"S'ọdẹ ọ̀run lọ́hùn."}],"end":7.096},{"key":"2","start":8.046,"lines":[{"start":8.046,"end":9.5,"text":"K'awon t'aiye dorin won mo","marked":"K'àwọn t'áíyé dorin wọn mọ́"},{"start":9.88,"end":11.226,"text":"T'awon to lo s'ogo","marked":"T'àwọn tó lọ s'ògo"},{"start":11.606,"end":13.643,"text":"Awa l'aiye, awon l'orun","marked":"Àwa l'aiye, àwọn l'orun"},{"start":14.023,"end":15.2,"text":"Okan ni gbogbo wa.","marked":"Ọ̀kan ni gbogbo wa."}],"end":15.2},{"key":"3","start":16.15,"lines":[{"start":16.15,"end":17.816,"text":"ldile kan n'nu Krist' ni wa","marked":"ldile kan ń'nú Krist' ni wá"},{"start":18.196,"end":19.384,"text":"Ajo kan l'a si je","marked":"Àjọ kan l'á sì jẹ́"},{"start":19.764,"end":21.273,"text":"lsan omi kan lo ya wa","marked":"lsan omi kan ló yá wa"},{"start":21.653,"end":22.839,"text":"lsan omi iku.","marked":"lsan omi ikú."}],"end":22.839},{"key":"4","start":23.789,"lines":[{"start":23.789,"end":25.28,"text":"Egbe ogun kan t'Olorun","marked":"Ẹgbẹ́ ogun kan t'Ọlọ́run"},{"start":25.66,"end":26.722,"text":"Ase Re l'a si nse","marked":"Àṣé Rẹ l'á sì ńṣe"},{"start":27.102,"end":28.689,"text":"Apakan ti wo'do na ja","marked":"Apákan tí wo'do nà já"},{"start":29.069,"end":30.2,"text":"Apakan nwo lowo!","marked":"Apàkàn ńwọ́ lọ́wọ́!"}],"end":30.2},{"key":"5","start":31.15,"lines":[{"start":31.15,"end":32.538,"text":"Emi wa fere dapo na","marked":"Èmi wá fẹ́rẹ̀ dàpọ̀ ná"},{"start":32.918,"end":34.103,"text":"Y'o gb'Ade bi tiwon","marked":"Y'ó gb'Adé bí tiwọn"},{"start":34.483,"end":36.04,"text":"A o yo s'ami Balogun wa","marked":"A ò yó s'àmì Balógun wa"},{"start":36.42,"end":37.89,"text":"Lati gbo ipe Re.","marked":"Láti gbọ́ ìpè Rẹ."}],"end":37.89},{"key":"6","start":38.84,"lines":[{"start":38.84,"end":41.215,"text":"Jesu, so wa, s'amona wa","marked":"Jésù, sọ wá, s'amọ̀nà wa"},{"start":41.595,"end":43.136,"text":"Gba' oniko ba de","marked":"Gba' oníkọ́ bá dé"},{"start":43.516,"end":44.707,"text":"Oluwa pin omi meji","marked":"Olúwa pín omi méjì"},{"start":45.087,"end":46.541,"text":"Mu wa gunle I'ayo.","marked":"Mú wa gúnlẹ̀ l'àyò."}],"end":46.541}]}