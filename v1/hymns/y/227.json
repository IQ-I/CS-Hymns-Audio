{"v":1,"coll":"y","num":227,"id":"hymn_227","title":"OLORUN wa je k'iyin Re","duration":40.042,"voices":{"male":{"file":"y-227-male.m4a","bytes":281538,"sha256":"a8db8f765d7efff09b95e7c15fbb84c559b58511857815c223491fc562c5c01c","duration":40.1},"female":{"file":"y-227-female.m4a","bytes":286265,"sha256":"47a3393dec3ed1bcffe8b3fd11ca94bcc5b4dabc2e8963ad1145e8cafae3a7ae","duration":40.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.672,"text":"OLORUN wa je k'iyin Re","marked":"Ọlọ́run wá jẹ k'ìyìn Rẹ"},{"start":2.052,"end":3.189,"text":"Gb'ohun gbogbo wa kan","marked":"Gb'ohun gbogbo wa kan"},{"start":3.569,"end":4.994,"text":"Owo Re yi ojo wa po","marked":"Ọwọ́ Rẹ̀ yí ọjọ́ wa po"},{"start":5.374,"end":6.579,"text":"Odun miran si de.","marked":"Ọdún miran sì dé."}],"end":6.579},{"key":"2","start":7.529,"lines":[{"start":7.529,"end":9.192,"text":"Ebo wa ngoke sodo Re","marked":"Ẹbọ wá ngoke sọ́dọ̀ Rẹ"},{"start":9.572,"end":10.554,"text":"Baba, Olore wa","marked":"Bàbá, Olórè wà"},{"start":10.934,"end":12.77,"text":"Fun anu ododun ti nsan","marked":"Fún ànú ọdọdún ti ńsan"},{"start":13.15,"end":14.371,"text":"Lati odo Rewa.","marked":"Láti ọ̀dọ̀ Rẹwà."}],"end":14.371},{"key":"3","start":15.321,"lines":[{"start":15.321,"end":16.907,"text":"N'nu gbogbo ayida aiye","marked":"N'nu gbogbo àyídà aiye"},{"start":17.287,"end":18.299,"text":"K'anu Re wa sibe","marked":"K'ánú Rẹ̀ wá síbẹ̀"},{"start":18.679,"end":20.303,"text":"B'ore Re si wa si ti po","marked":"B'ọ̀rẹ́ Rẹ sì wá sì ti pọ̀"},{"start":20.683,"end":21.837,"text":"Beni k'iyin wa po.","marked":"Bẹni k'ìyìn wá pọ̀."}],"end":21.837},{"key":"4","start":22.787,"lines":[{"start":22.787,"end":24.357,"text":"N'nu gbogbo ayida aiye","marked":"N'nu gbogbo àyídà aiye"},{"start":24.737,"end":25.738,"text":"A nri aniyan Re","marked":"A nri àníyàn Rẹ"},{"start":26.118,"end":27.521,"text":"Jowo je k'anu Re 'kanna","marked":"Jọ̀wọ́ jẹ́ k'ánú Rẹ 'kànnà"},{"start":27.901,"end":29.119,"text":"Bukun odun titun.","marked":"Bùkún ọdún titun."}],"end":29.119},{"key":"5","start":30.069,"lines":[{"start":30.069,"end":32.473,"text":"B'ayo ba si wa, k'ayo na","marked":"B'ayo bá sì wà, k'àyò ná"},{"start":32.853,"end":33.91,"text":"Fa wa si odo Re","marked":"Fà wá sí ọ̀dọ̀ Rẹ"},{"start":34.29,"end":35.909,"text":"B'iya ni awa o korin","marked":"B'íyá ni àwa ó kọrin"},{"start":36.289,"end":37.518,"text":"B'ibukun Re pelu.","marked":"B'ìbùkún Rẹ pẹ̀lú."},{"start":37.898,"end":38.492,"text":"Amin.","marked":"Àmín."}],"end":38.492}]}