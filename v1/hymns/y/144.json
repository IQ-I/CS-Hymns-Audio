{"v":1,"coll":"y","num":144,"id":"hymn_144","title":"E Fi Ope fun Olorun wa","duration":68.067,"voices":{"male":{"file":"y-144-male.m4a","bytes":494495,"sha256":"1076063eb4637b8cc8144441a7aab7dd9a62688559e0750d9fa5c24d5f008fda","duration":68.1},"female":{"file":"y-144-female.m4a","bytes":512962,"sha256":"3bacfbaa05badb7f44fbd5d9e72caf71736f0eca413027d9f77dc9292817b4c0","duration":68.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.859,"text":"E Fi Ope fun Olorun wa,","marked":"Ẹ Fi Ọpẹ́ fún Ọlọ́run wa"},{"start":2.239,"end":3.677,"text":"Enyin Egbe Serafu","marked":"Enyin Ẹgbẹ́ Séráfù"},{"start":4.057,"end":5.945,"text":"Fun ore Re ti o yi wa ka","marked":"Fún ọ̀rẹ́ Rẹ tí ó yí wa ká"},{"start":6.325,"end":7.568,"text":"O ngbe wa leke ota.","marked":"Ó ńgbé wa lékè ọ̀tá."}],"end":7.568},{"key":"CHORUS","start":8.518,"lines":[{"start":8.518,"end":10.478,"text":"Isoji aiyeraiye mbo wa","marked":"Ìsọjí aiyérayé ḿbọ̀ wá"},{"start":10.858,"end":12.594,"text":"Jesu se wa ye f 'ojo na","marked":"Jésù ṣe wá yé f 'ọjọ́ ná"},{"start":12.974,"end":14.57,"text":"K'a le jo korin Halleluyah","marked":"K'á lè jọ kọrin Hallelúyà"},{"start":14.95,"end":16.285,"text":"S'Olorun metalokan.","marked":"S'Ọlọ́run Mẹ́talọ́kan."}],"end":16.285},{"key":"2","start":17.235,"lines":[{"start":17.235,"end":19.034,"text":"Larin ota, larin elegan","marked":"Lárin ọ̀tá, lárin ẹlẹ́gàn"},{"start":19.414,"end":20.663,"text":"L' awa nrin lojojumo","marked":"L' àwa ńrìn lojojumo"},{"start":21.043,"end":23.203,"text":"Sugbon Jesu, ko je ka subu","marked":"Ṣùgbọ́n Jésù, kò jẹ́ ká ṣubú"},{"start":23.583,"end":25.285,"text":"Ko si je k'ota yo wa.","marked":"Kò sì jẹ́ k'ọ̀tá yọ wá."}],"end":25.285},{"key":"3","start":26.235,"lines":[{"start":26.235,"end":27.962,"text":"Opolopo ti f 'ile bora","marked":"Ọ̀pọ̀lọpọ̀ ti f 'ilẹ̀ bora"},{"start":28.342,"end":29.778,"text":"Nwon ti di eni 'gbagbe","marked":"Nwọ̀n ti di ẹni 'gbàgbé"},{"start":30.158,"end":31.995,"text":"Nitorina Egbe Serafu","marked":"Nítorina Ẹgbẹ́ Séráfù"},{"start":32.375,"end":33.649,"text":"E f'ope f'Olorun wa.","marked":"Ẹ f'ọpẹ́ f'Ọlọ́run wa."}],"end":33.649},{"key":"4","start":34.599,"lines":[{"start":34.599,"end":36.138,"text":"Gbogbo enyin egbe Serafu","marked":"Gbogbo enyin ẹgbẹ́ Séráfù"},{"start":36.518,"end":38.106,"text":"Lati ilu gbogbo wa;","marked":"Láti ìlú gbogbo wa"},{"start":38.486,"end":40.221,"text":"A si ki nyin e ku iyedun","marked":"A sì ki nyin ẹ̀ kù ìyẹ̀dùn"},{"start":40.601,"end":42.332,"text":"Jesu yio s' amona wa.","marked":"Jésù yio s' amọ̀nà wa."}],"end":42.332},{"key":"5","start":43.282,"lines":[{"start":43.282,"end":45.278,"text":"Egbe Seraf' j'egbe Kekere,","marked":"Ẹgbẹ́ Séráf' j'ẹgbẹ́ Kékeré"},{"start":45.658,"end":46.793,"text":"Gegebi Nasareti","marked":"Gegebi Násárétì"},{"start":47.173,"end":48.839,"text":"Ola si nwi fun won bayi pe,","marked":"Ọlá sì ńwí fún wọn báyì pé"},{"start":49.219,"end":50.682,"text":"Egbe Serafu ha da?","marked":"Ẹgbẹ́ Séráfù ha dá?"}],"end":50.682},{"key":"6","start":51.632,"lines":[{"start":51.632,"end":52.892,"text":"Ohun rere kan ha le jade","marked":"Ohun rere kan ha lè jáde"},{"start":53.272,"end":54.657,"text":"Lati Nasareti wa?","marked":"Láti Násárétì wá?"},{"start":55.037,"end":56.724,"text":"Sugbon Jesu nwi fun O loni","marked":"Ṣùgbọ́n Jésù nwi fún Ọ lónì"},{"start":57.104,"end":58.52,"text":"Wipe jade ko wa wo.","marked":"Wípẹ́ jáde kó wá wò."}],"end":58.52},{"key":"7","start":59.47,"lines":[{"start":59.47,"end":60.97,"text":"E f'ogo fun Baba wa l'oke","marked":"Ẹ f'ògo fún Bàbá wa l'òkè"},{"start":61.35,"end":62.775,"text":"E tun f'ogo fun Omo","marked":"Ẹ tún f'ògo fún Ọmọ"},{"start":63.155,"end":64.85,"text":"E si f'ogo fun Emi Mimo","marked":"Ẹ sì f'ògo fún Ẹ̀mí Mímọ́́"},{"start":65.23,"end":66.517,"text":"Ologo Metalokan.","marked":"Ológo Mẹ́talọ́kan."}],"end":66.517}]}