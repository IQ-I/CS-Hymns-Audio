{"v":1,"coll":"y","num":75,"id":"hymn_75","title":"EMI Orun gb'adura wa","duration":45.788,"voices":{"male":{"file":"y-75-male.m4a","bytes":320824,"sha256":"500056699188db5c3cc24a0d8f3c7fc40caaa851faf03076caa0bc127b2dfb69","duration":45.8},"female":{"file":"y-75-female.m4a","bytes":335128,"sha256":"ce03c28cf12871c9d746daa9b5de29a68c235a97dea32f5a8cd2d249fc770c87","duration":45.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.684,"text":"EMI Orun gb'adura wa,","marked":"Ẹ̀mí Ọ̀run gb'àdúrà wa"},{"start":2.064,"end":3.259,"text":"Wa gbe 'nu ile yi,","marked":"Wá gbé 'nu ilé yí"},{"start":3.639,"end":5.419,"text":"Sokale pel'agbara Re,","marked":"Sọ̀kalẹ̀ pel'agbara Rẹ"},{"start":5.799,"end":6.9,"text":"Wa Emi Mimo wa.","marked":"Wá Ẹ̀mí Mímọ́́ wa."}],"end":6.9},{"key":"2","start":7.85,"lines":[{"start":7.85,"end":9.387,"text":"Wa bi 'imole si fi han wa,","marked":"Wá bí 'ìmọ́lẹ̀̀ sì fi hàn wá"},{"start":9.767,"end":11.02,"text":"B'aini wa ti po to,","marked":"B'áìnì wa ti pọ̀ tó"},{"start":11.4,"end":12.762,"text":"Wa to wa si ona lye,","marked":"Wà tó wá sí ọ̀nà lyé"},{"start":13.142,"end":14.167,"text":"Ti Olododo nrin.","marked":"Ti Olódodo ńrìn."}],"end":14.167},{"key":"3","start":15.117,"lines":[{"start":15.117,"end":16.282,"text":"Wa bi ina ebo Mimo","marked":"Wá bí iná ẹbọ Mímọ́́"},{"start":16.662,"end":17.805,"text":"S'okan wa di mimo,","marked":"S'ọkàn wa di mímọ́́"},{"start":18.185,"end":19.478,"text":"Je ki okan wa je ore","marked":"Jẹ́ kí ọkàn wa jẹ́ ọ̀rẹ́"},{"start":19.858,"end":20.925,"text":"F'oruko Oluwa.","marked":"F'orúkọ Olúwa."}],"end":20.925},{"key":"4","start":21.875,"lines":[{"start":21.875,"end":23.355,"text":"Wa bi iri si wa bukun","marked":"Wá bí ìrì sí wa bùkún"},{"start":23.735,"end":24.764,"text":"Akoko mimo yi,","marked":"Àkókò mímọ́́ yí"},{"start":25.144,"end":26.423,"text":"Ki okan alaileso wa,","marked":"Kí ọkàn aláìléso wà"},{"start":26.803,"end":27.92,"text":"Le yo l'agbara Re.","marked":"Lè yọ l'ágbára Rẹ."}],"end":27.92},{"key":"5","start":28.87,"lines":[{"start":28.87,"end":30.22,"text":"Wa bi adaba n'apa Re,","marked":"Wá bí àdàbà ń'apá Rẹ"},{"start":30.6,"end":31.61,"text":"Apa ife Mimo,","marked":"Apá ìfẹ́ Mímọ́́"},{"start":31.99,"end":33.585,"text":"Wa je ki Egbe yi l'aiye,","marked":"Wá jẹ́ kí Ẹgbẹ́ yí l'aiye"},{"start":33.965,"end":35.386,"text":"Dabi Egbe t'orun.","marked":"Dábì Ẹgbẹ́ t'ọrun."}],"end":35.386},{"key":"6","start":36.336,"lines":[{"start":36.336,"end":37.814,"text":"Emi orun gb'adura wa,","marked":"Ẹ̀mí ọ̀run gb'àdúrà wa"},{"start":38.194,"end":39.58,"text":"S'aiye yi d'ile Re,","marked":"S'aiye yi d'ilẹ̀ Rẹ"},{"start":39.96,"end":41.967,"text":"Sokale pel'agbara e,","marked":"Sọ̀kalẹ̀ pel'agbara ẹ̀"},{"start":42.347,"end":44.238,"text":"Wa, Emi Mimo wa.","marked":"Wà, Ẹ̀mí Mímọ́́ wà."}],"end":44.238}]}