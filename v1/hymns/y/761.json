{"v":1,"coll":"y","num":761,"id":"hymn_761","title":"ITANNA tio bo gbe laso","duration":51.783,"voices":{"male":{"file":"y-761-male.m4a","bytes":376864,"sha256":"e3ebfd8af0f6189d709ce82bdeb5a9649029ff9e9bba60bce9f13a1303164ddc","duration":51.8},"female":{"file":"y-761-female.m4a","bytes":385989,"sha256":"a308486721248e9b998c333a7320fed4b63b2de804e3c1b388919f73c3ae5857","duration":51.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.538,"text":"ITANNA t'o bo gbe l'aso","marked":"Ìtànná t'ó bó gbé l'aso"},{"start":2.918,"end":4.372,"text":"T'o tutu yoyo be","marked":"T'ó tutù yọ̀yọ̀ bẹ́"},{"start":4.752,"end":6.873,"text":"Gba 'doje ba kan, a si ku","marked":"Gba 'dòjé bá kan, á sì kú"},{"start":7.253,"end":8.973,"text":"A subu, a si ro.","marked":"A ṣubú, a sì rò."}],"end":8.973},{"key":"2","start":9.923,"lines":[{"start":9.923,"end":11.449,"text":"Apere yi ye f'ara wa","marked":"Apẹ̀rẹ̀ yí yé f'ara wa"},{"start":11.829,"end":12.906,"text":"B'or' Olorun ti wi","marked":"B'or' Ọlọ́run ti wí"},{"start":13.286,"end":14.82,"text":"K'omode at'agbalagba","marked":"K'ọmọdé àt'àgbàlagbà"},{"start":15.2,"end":16.529,"text":"Mo ra won l'eweko.","marked":"Mo rà wọ́n l'ewéko."}],"end":16.529},{"key":"3","start":17.479,"lines":[{"start":17.479,"end":19.131,"text":"A! ma gbekele emi re,","marked":"A! má gbẹ́kẹ̀lé ẹ̀mí rẹ"},{"start":19.511,"end":20.773,"text":"Ma pe gba re n'tire","marked":"Má pẹ́ gbá rẹ n'tire"},{"start":21.153,"end":22.678,"text":"Yika l'a nri doje iku","marked":"Yíká l'á ńrí dòjé ikú"},{"start":23.058,"end":24.345,"text":"O mbe 'gberun lule.","marked":"Ó ḿbẹ́ 'gbẹ̀rún lulẹ̀."}],"end":24.345},{"key":"4","start":25.295,"lines":[{"start":25.295,"end":26.669,"text":"Enyin t'a dasi di oni","marked":"Enyin t'á daṣí di òní"},{"start":27.049,"end":29.249,"text":"Laipe, emi y'o pin","marked":"Láìpẹ́, èmi y'ó pín"},{"start":29.629,"end":31.091,"text":"Mura k'e si gbon akoko","marked":"Múra k'é sì gbọ̀n àkókò"},{"start":31.471,"end":32.904,"text":"Kiko iku to de.","marked":"Kíkọ ikú tó dé."}],"end":32.904},{"key":"5","start":33.854,"lines":[{"start":33.854,"end":36.381,"text":"Koriko, b'o ku, ki ji mo","marked":"Koríko, b'ó kú, kí jí mọ́"},{"start":36.761,"end":38.084,"text":"E ku lati tun ye","marked":"Ẹ kú láti tún yé"},{"start":38.464,"end":40.544,"text":"A! b'iku lo je lekun nko","marked":"A! b'ikú ló jẹ́ lẹ́kùn ńkọ́"},{"start":40.924,"end":42.388,"text":"S'irora ailopin.","marked":"S'ìrora àìlópin."}],"end":42.388},{"key":"6","start":43.338,"lines":[{"start":43.338,"end":44.767,"text":"Oluwa, jek' a jipe Re","marked":"Olúwa, jẹk' a jípẹ́ Rẹ"},{"start":45.147,"end":46.333,"text":"K'a kuro n'nu ese","marked":"K'á kúrò ń'nú ẹsẹ̀"},{"start":46.713,"end":48.483,"text":"Gbat' a lule bi koriko","marked":"Gbat' á lulẹ̀ bí koríko"},{"start":48.863,"end":50.233,"text":"K'okan wa yo si O.","marked":"K'ọkàn wa yọ̀ sí O."}],"end":50.233}]}