{"v":1,"coll":"y","num":387,"id":"hymn_387","title":"OLURAPADA wa k'On to","duration":44.906,"voices":{"male":{"file":"y-387-male.m4a","bytes":310977,"sha256":"88847cc114f5c70af4b840db7b12e8a2a978de2753be082cee6b8452aefa14de","duration":45.0},"female":{"file":"y-387-female.m4a","bytes":317556,"sha256":"e4b2b00b0c1947e6c746f95531d9e3a5df1cf3aeac20445c5bda415095c1d42d","duration":45.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.032,"text":"OLURAPADA wa k'On to","marked":"Olùràpadà wa k'On tó"},{"start":2.412,"end":3.4,"text":"Dagbere ikehin","marked":"Dágbére ìkẹhìn"},{"start":3.78,"end":5.016,"text":"O fi Olutunu fun ni","marked":"Ó fi Olùtùnú fún ni"},{"start":5.396,"end":6.457,"text":"Ti mba wa gbe.","marked":"Ti ḿbá wa gbé."}],"end":6.457},{"key":"2","start":7.407,"lines":[{"start":7.407,"end":8.581,"text":"O wa ni awo adaba","marked":"Ó wà ní àwọ̀ àdàbà"},{"start":8.961,"end":10.007,"text":"O na iye bo wa","marked":"Ó na iye bò wá"},{"start":10.387,"end":11.737,"text":"O tan 'fe on alafia","marked":"Ó tan 'fẹ́ ọn àlàáfíà"},{"start":12.117,"end":13.277,"text":"Sori aiye.","marked":"Ṣọ́rí aiye."}],"end":13.277},{"key":"3","start":14.227,"lines":[{"start":14.227,"end":15.917,"text":"O de, o mu 'wa-rere wa,","marked":"Ó dé, ó mú 'wá-rere wá"},{"start":16.297,"end":17.201,"text":"Alejo Olore,","marked":"Àlejò Olọ́rẹ́"},{"start":17.581,"end":18.915,"text":"Gbat' o ba r'okan irele","marked":"Gbat' ò bá r'ọkàn ìrẹ̀lẹ̀"},{"start":19.295,"end":20.383,"text":"Lati ma gbe.","marked":"Láti má gbé."}],"end":20.383},{"key":"4","start":21.333,"lines":[{"start":21.333,"end":22.816,"text":"Tire l'ohun jeje t'a ngbo","marked":"Tìrẹ l'óhun jẹ́jẹ́ t'á ńgbó"},{"start":23.196,"end":24.164,"text":"Ohun kelekele","marked":"Ohun kẹ́lẹ́kẹ́lẹ́"},{"start":24.544,"end":26.677,"text":"Ti ngbaniwi, ti nl'eru lo","marked":"Ti ńgbaniwí, tí ńl'ẹrù lọ"},{"start":27.057,"end":28.104,"text":"Ti nso t'orun.","marked":"Ti nso t'ọrun."}],"end":28.104},{"key":"5","start":29.054,"lines":[{"start":29.054,"end":30.404,"text":"Gbogho iwa‐rere t'a nhu","marked":"Gbogho ìwà-rere t'á nhu"},{"start":30.784,"end":31.987,"text":"Gbogbo isegun wa","marked":"Gbogbo ìṣègùn wa"},{"start":32.367,"end":33.509,"text":"Gbogbo ero iwa-mimo","marked":"Gbogbo èrò ìwà-mímọ́"},{"start":33.889,"end":34.934,"text":"Tire ni won.","marked":"Tìrẹ ni wọ́n."}],"end":34.934},{"key":"6","start":35.884,"lines":[{"start":35.884,"end":37.158,"text":"Emi Mimo Olutunu","marked":"Ẹ̀mí Mímọ́́ Olùtùnú"},{"start":37.538,"end":38.728,"text":"F'iyonu be wa wo","marked":"F'ìyọnu bẹ̀ wá wò"},{"start":39.108,"end":40.941,"text":"Jo, s'okan wa n'ibugbe Re","marked":"Jó, s'ókan wà ń'ibùgbé Rẹ"},{"start":41.321,"end":42.353,"text":"K'o ye fun O.","marked":"K'ó yẹ fún O."},{"start":42.733,"end":43.356,"text":"Amin.","marked":"Àmín."}],"end":43.356}]}