{"v":1,"coll":"y","num":461,"id":"hymn_461","title":"MO fi gbagbo ba Olorun mi rin","duration":64.423,"voices":{"male":{"file":"y-461-male.m4a","bytes":463657,"sha256":"d0c61c3e70dcef23870cfb1e74361257b3bde11c260ea873a36ddbd1d5527d3f","duration":64.5},"female":{"file":"y-461-female.m4a","bytes":478004,"sha256":"fd40b6bd2c7fa5ddd6012826031e762576c49e197d001cc34b88b4755980973f","duration":64.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.82,"text":"MO fi gbagbo ba Olorun mi rin","marked":"Mo fi gbàgbọ́ bá Ọlọ́run mi rìn"},{"start":2.2,"end":3.967,"text":"Ti ngo fi de 'te ogo","marked":"Tí ngo fi dé 'te ògo"},{"start":4.347,"end":5.974,"text":"Jowo Oluwa se mi ni Tire","marked":"Jọ̀wọ́ Olúwa ṣe mí ní Tìrẹ"},{"start":6.354,"end":7.565,"text":"K'emi r'oju rere Re.","marked":"K'ẹ̀mí r'ojú rere Rẹ̀."}],"end":7.565},{"key":"CHORUS","start":8.515,"lines":[{"start":8.515,"end":10.173,"text":"Fa mi mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra Olúwa"},{"start":10.553,"end":12.143,"text":"S'ibi agbelebu t'oku","marked":"S'ibi àgbélébùú t'ókù"},{"start":12.523,"end":14.622,"text":"Fa mi mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra Olúwa"},{"start":15.002,"end":17.314,"text":"S'ibi eje Re t'o n'iye.","marked":"S'ibi ẹ̀jẹ̀ Rẹ t'ó ń'ìyẹ́."}],"end":17.314},{"key":"2","start":18.264,"lines":[{"start":18.264,"end":20.324,"text":"Nin'egba mefa nin' eya Lefi","marked":"Nín'ẹgbà mẹ́fà nín' ẹ̀yà Léfì"},{"start":20.704,"end":22.016,"text":"A f'edidi sami won,","marked":"A f'èdìdì sàmì wọn"},{"start":22.396,"end":25.031,"text":"Jehofa_Jire, k'O le ka wa kun","marked":"Jèhófà Jíre, k'Ó lè kà wá kún"},{"start":25.411,"end":26.736,"text":"Awon 'yanfe Re 'saju.","marked":"Àwọn 'yanfe Rẹ̀ 'sájú."}],"end":26.736},{"key":"3","start":27.686,"lines":[{"start":27.686,"end":29.972,"text":"Nin'Egba mefa eya Manase","marked":"Nín'Ẹgbà mẹ́fà ẹ̀yà Mánásè"},{"start":30.352,"end":31.665,"text":"A f'edidi sami won","marked":"A f'èdìdì sàmì wọn"},{"start":32.045,"end":33.743,"text":"Oluwa jowo k'a le f'edidi","marked":"Olúwa jọ̀wọ́ k'á lè f'èdìdì"},{"start":34.123,"end":36.175,"text":"Sami s'Egbe Serafu (Kerubu).","marked":"Sámì s'Ẹgbẹ́ Séráfù Kérúbù."}],"end":36.175},{"key":"4","start":37.125,"lines":[{"start":37.125,"end":38.97,"text":"Nin' egbe mefa eya Josefu","marked":"Nín' ẹgbẹ́ mẹ́fà ẹ̀yà Jósẹ́fù"},{"start":39.35,"end":40.654,"text":"A f 'edidi sami won","marked":"A f 'èdìdì sàmì wọn"},{"start":41.034,"end":43.467,"text":"Jehofa-Nassi K'O le f'edidi","marked":"Jehofa-Nassi K'ó lè f'èdìdì"},{"start":43.847,"end":45.788,"text":"Semi s'Egbe Kerubu (Serafu).","marked":"Semi s'Ẹgbẹ́ Kérúbù Séráfù."}],"end":45.788},{"key":"5","start":46.738,"lines":[{"start":46.738,"end":48.642,"text":"Oro Jehovah ko le lo l'ofo,","marked":"Ọ̀rọ̀ Jehovah kò lè lọ l'ófo"},{"start":49.022,"end":50.276,"text":"Oro Baba ki sai se","marked":"Ọ̀rọ̀ Bàbá kì ṣàì ṣe"},{"start":50.656,"end":52.331,"text":"Ileri t'o se fun Abrahamu","marked":"Ìlérí t'ó ṣe fún Ábúráhámù"},{"start":52.711,"end":54.154,"text":"O mu se fun Isaaki.","marked":"Ó mú ṣe fún Ísáákì."}],"end":54.154},{"key":"6","start":55.104,"lines":[{"start":55.104,"end":56.974,"text":"Enia Olorun kan ko le tosi","marked":"Éníà Ọlọ́run kan kò lè tòṣì"},{"start":57.354,"end":58.777,"text":"Nigbati aiye ti se","marked":"Nígbàtí aiye ti ṣe"},{"start":59.157,"end":61.006,"text":"Ma je ki ebi oro at'ale","marked":"Má jẹ́ kí ẹ̀bi ọ̀rọ̀ àt'álẹ̀"},{"start":61.386,"end":62.873,"text":"P'awon Egbe Serafu.","marked":"P'àwọn Ẹgbẹ́ Séráfù."}],"end":62.873}]}