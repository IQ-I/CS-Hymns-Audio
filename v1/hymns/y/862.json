{"v":1,"coll":"y","num":862,"id":"hymn_862","title":"OLUS'AGUTAN, toju wa","duration":51.789,"voices":{"male":{"file":"y-862-male.m4a","bytes":369768,"sha256":"01fb0c9f3baacbd9c9c097495498041a7ceb583561c8e26705a152967f9f56d8","duration":51.8},"female":{"file":"y-862-female.m4a","bytes":383066,"sha256":"14377d5784171d2953af688edb9e3d94d99470af1b866603d157e0d686ff44f2","duration":51.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.482,"text":"OLUS'AGUTAN, toju wa,","marked":"Olùs'ágùtàn, tójú wa"},{"start":2.862,"end":3.988,"text":"Li ojo ibi yi,","marked":"Lí ọjọ́ ìbí yí"},{"start":4.368,"end":5.758,"text":"Fun gbogbo omo-ehin Re,","marked":"Fún gbogbo ọmọ-ẹ̀hìn Rẹ"},{"start":6.138,"end":7.788,"text":"N' ipa lati sona.","marked":"N' ipa láti ṣọ́nà."}],"end":7.788},{"key":"2","start":8.738,"lines":[{"start":8.738,"end":10.133,"text":"B' igba idanwo wa ba pe,","marked":"B' ìgbà ìdánwò wa bá pé"},{"start":10.513,"end":11.827,"text":"T' iponju po fun wa,","marked":"T' ìpọ́njú pọ̀ fún wa"},{"start":12.207,"end":14.223,"text":"Jek' emi wa sirni le O,","marked":"Jẹ́k' ẹ̀mí wa sirni lé O"},{"start":14.603,"end":15.849,"text":"L' adura aisimi.","marked":"L' àdúrà àìsimi."}],"end":15.849},{"key":"3","start":16.799,"lines":[{"start":16.799,"end":18.013,"text":"F' ore-ofe emi ebe,","marked":"F' ọrẹ-ọ̀fẹ́ ẹ̀mí ẹ̀bẹ̀"},{"start":18.393,"end":19.75,"text":"Fun wa nipa 'gbagbo;","marked":"Fún wa nípa 'gbàgbọ́"},{"start":20.13,"end":22.518,"text":"K'a du titi ao r'oju Re,","marked":"K'á du títí àó r'ojú Rẹ"},{"start":22.898,"end":24.109,"text":"T' ao si mo oko Re.","marked":"T' aò sì mọ ọkọ Rẹ."}],"end":24.109},{"key":"4","start":25.059,"lines":[{"start":25.059,"end":26.411,"text":"Titi O fun wa l'ara Re,","marked":"Títí Ó fún wa l'ara Rẹ̀"},{"start":26.791,"end":28.015,"text":"Ati ife pipe","marked":"Àti ìfẹ́ pípé"},{"start":28.395,"end":29.66,"text":"K'eyije igbe gbogbo wa,","marked":"K'èyíjẹ́ igbe gbogbo wa"},{"start":30.04,"end":31.377,"text":"Nki o je ki O lo.","marked":"Nkí ó jẹ́ kí Ó lọ."}],"end":31.377},{"key":"5","start":32.327,"lines":[{"start":32.327,"end":34.579,"text":"O ki o lo, bikosepe,","marked":"O kí o lọ, bìkọ́ṣẹ́pẹ́"},{"start":34.959,"end":36.061,"text":"O s'oko Re fun mi,","marked":"Ó s'ọkọ Rẹ̀ fún mi"},{"start":36.441,"end":37.963,"text":"K' O f'igbala Re bukun mi,","marked":"K' O f'ìgbàlà Rẹ̀ bùkún mi"},{"start":38.343,"end":39.918,"text":"Si jeki ndabi Re.","marked":"Sì jeki ńdàbí Rẹ."}],"end":39.918},{"key":"6","start":40.868,"lines":[{"start":40.868,"end":42.623,"text":"Jeki nr'oju Re kedere","marked":"Jẹki nr'oju Rẹ kedere"},{"start":43.003,"end":44.453,"text":"'Gba m' ba d'ori-oke,","marked":"'Gbá m' bá d'orí-òkè"},{"start":44.833,"end":47.751,"text":"Nibit' a r'ohun t'a gbagbo,","marked":"Níbit' a r'ohun t'á gbàgbọ́"},{"start":48.131,"end":49.367,"text":"T'adura di iyin.","marked":"T'àdúrà di ìyìn."},{"start":49.747,"end":50.239,"text":"Amin.","marked":"Àmín."}],"end":50.239}]}