{"v":1,"coll":"y","num":116,"id":"hymn_116","title":"EMI ba n'egberun ahon","duration":46.904,"voices":{"male":{"file":"y-116-male.m4a","bytes":329107,"sha256":"26f8d070a615f70da730a38090de091e6120a845a7a19488997e392a6cdacfcf","duration":47.0},"female":{"file":"y-116-female.m4a","bytes":344250,"sha256":"fb86124515e897329b8c0401c851aca6ba223aa0f2b7cde0c350956a62dea1f7","duration":47.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.963,"text":"EMI ba n'egberun ahon","marked":"Èmi bá ń'ẹgbẹ̀rún ahọ́n"},{"start":2.343,"end":3.333,"text":"Fun 'yin Olugbala","marked":"Fún 'yin Olùgbàlà"},{"start":3.713,"end":5.257,"text":"Ogo Olorun, Oba mi,","marked":"Ògo Ọlọ́run, Ọba mi"},{"start":5.637,"end":6.645,"text":"lsegun Ore Re.","marked":"lṣẹ́gun Ọ̀rẹ́ Rẹ."}],"end":6.645},{"key":"2","start":7.595,"lines":[{"start":7.595,"end":9.619,"text":"Jesu t'O s'eru wa d'ayo","marked":"Jésù t'Ó s'ẹrú wa d'àyò"},{"start":9.999,"end":11.17,"text":"T'o mu banuje tan","marked":"T'ó mú bànújẹ́ tán"},{"start":11.55,"end":12.858,"text":"Orin ni l'eti elese","marked":"Orin ní l'etí ẹlẹ́sẹ̀"},{"start":13.238,"end":14.49,"text":"Iye at'ilera.","marked":"Iye àt'ìlera."}],"end":14.49},{"key":"3","start":15.44,"lines":[{"start":15.44,"end":16.872,"text":"O segun agbara ese,","marked":"Ó ṣẹ́gun agbára ẹ̀ṣẹ̀"},{"start":17.252,"end":18.32,"text":"O da onde sile","marked":"Ó dá òǹdè sílẹ̀"},{"start":18.7,"end":19.942,"text":"Eje Re Ie w'eleri mo,","marked":"Ẹ̀jẹ̀ Rẹ lè w'ẹ́lẹ́rí mọ́"},{"start":20.322,"end":21.248,"text":"Eje Re seun fun mi.","marked":"Ẹ̀jẹ̀ Rẹ ṣeun fún mi."}],"end":21.248},{"key":"4","start":22.198,"lines":[{"start":22.198,"end":23.509,"text":"O soro oku gb'ohun Re","marked":"Ó sọ̀rọ̀ òkú gb'óhùn Rẹ̀"},{"start":23.889,"end":25.128,"text":"O gba emi titun","marked":"Ó gba ẹ̀mí titun"},{"start":25.508,"end":26.786,"text":"Onirobinuje y'ayo","marked":"Oníròbìnújẹ́ y'àyò"},{"start":27.166,"end":28.481,"text":"Otosi si gba gbo.","marked":"Òtòṣì sì gbà gbọ́."}],"end":28.481},{"key":"5","start":29.431,"lines":[{"start":29.431,"end":30.97,"text":"Odi, e korin iyin Re,","marked":"Odi, ẹ kọrin ìyìn Rẹ̀"},{"start":31.35,"end":32.725,"text":"Aditi, gb'ohun Re","marked":"Adití, gb'óhùn Rẹ"},{"start":33.105,"end":34.921,"text":"Afoju, Olugbala de,","marked":"Afọ́jú, Olùgbàlà dé"},{"start":35.301,"end":37.249,"text":"Ayaro, fo f'ayo.","marked":"Àyàrò, fo f'àyò."}],"end":37.249},{"key":"6","start":38.199,"lines":[{"start":38.199,"end":39.613,"text":"Baba mi at'Olorun mi,","marked":"Bàbá mi àt'Ọlọ́run mi"},{"start":39.993,"end":41.05,"text":"Fun mi n'iranwo Re","marked":"Fún mi ń'ìrànwọ́ Rẹ"},{"start":41.43,"end":43.043,"text":"Ki nle ro ka gbogbo aiye","marked":"Kí ńlẹ̀ rò ká gbogbo aiye"},{"start":43.423,"end":44.377,"text":"Ola Oruko Re.","marked":"Ọlá Orúkọ Rẹ̀."},{"start":44.757,"end":45.354,"text":"Amin.","marked":"Àmín."}],"end":45.354}]}