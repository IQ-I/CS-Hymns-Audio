{"v":1,"coll":"y","num":138,"id":"hymn_138","title":"Ibase p'Oluwa","duration":61.566,"voices":{"male":{"file":"y-138-male.m4a","bytes":429290,"sha256":"ed0e127382bb4598d31f3a5448603fcda5790842c641232c4f539938617cedcb","duration":61.6},"female":{"file":"y-138-female.m4a","bytes":450681,"sha256":"05bdc9f5ffbed00eb817139052dfb8eff4722d3fbd81300fd370b6f5b893c412","duration":61.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.361,"text":"lBASE p'Oluwa","marked":"Ìbaṣẹ́ p'Olúwa"},{"start":1.741,"end":3.067,"text":"Ko ti wa ni tiwa","marked":"Kò ti wà ní tiwa"},{"start":3.447,"end":4.916,"text":"Lo ye k'awa ma wi","marked":"Ló yẹ k'áwà má wí"},{"start":5.296,"end":6.73,"text":"Nigbat'ese gbogun tiwa.","marked":"Nígbat'ẹsẹ̀ gbógun tiwa."}],"end":6.73},{"key":"CHORUS","start":7.68,"lines":[{"start":7.68,"end":8.979,"text":"Ope ni f'Oluwa","marked":"Ọpẹ́ ní f'Olúwa"},{"start":9.359,"end":10.434,"text":"Oba wa Olore","marked":"Ọba wa Ọlọ́rẹ̀"},{"start":10.814,"end":12.063,"text":"A ke kabiyesi","marked":"A ké kábíyèsí"},{"start":12.443,"end":13.691,"text":"A f'ope fun Jehofa","marked":"A f'ọpẹ́ fún Jèhófà"},{"start":14.071,"end":15.433,"text":"T'o gba wa Iowo ota,","marked":"T'ó gbà wá lọ́wọ́ ọ̀tá"},{"start":15.813,"end":16.774,"text":"A dupe Oluwu.","marked":"A dúpẹ́ Olúwu."}],"end":16.774},{"key":"2","start":17.724,"lines":[{"start":17.724,"end":18.862,"text":"Nwon 'ba bo wa mole","marked":"Nwọ̀n 'bá bò wá mọ́lẹ̀"},{"start":19.242,"end":20.221,"text":"Pelu agbara won,","marked":"Pẹ̀lú agbára wọn"},{"start":20.601,"end":21.808,"text":"Ope ni f 'Oluwa,","marked":"Ọpẹ́ ní f 'Olúwa"},{"start":22.188,"end":23.821,"text":"Ti ko jeki t'esu bori.","marked":"Tí kò jẹ́kí t'èṣù borí."}],"end":23.821},{"key":"3","start":24.771,"lines":[{"start":24.771,"end":26.233,"text":"Okan wa yo b'eiye","marked":"Ọkàn wa yọ̀ b'eiye"},{"start":26.613,"end":27.982,"text":"Nin' okun apeiye","marked":"Nín' òkun apeiye"},{"start":28.362,"end":30.284,"text":"Okun ja, awa yo,","marked":"Òkun jà, àwa yó"},{"start":30.664,"end":32.206,"text":"E yo Jesu da wa sile.","marked":"Ẹ yọ Jésù dá wa sílẹ̀."}],"end":32.206},{"key":"4","start":33.156,"lines":[{"start":33.156,"end":34.359,"text":"Tire ni Oluwa","marked":"Tìrẹ ni Olúwa"},{"start":34.739,"end":36.05,"text":"Lati gbe wa leke","marked":"Láti gbé wa lékè"},{"start":36.43,"end":37.223,"text":"Gbogbo awon ota,","marked":"Gbogbo àwọn ọ̀tá"},{"start":37.603,"end":39.231,"text":"T'o wu ko tile yi wa ka.","marked":"T'ó wù kó tilẹ̀ yí wa ká."}],"end":39.231},{"key":"5","start":40.181,"lines":[{"start":40.181,"end":41.311,"text":"Ara f 'okan bale","marked":"Ara f 'ọkàn balẹ̀"},{"start":41.691,"end":42.806,"text":"Sodo Olugbala","marked":"Sọ́dọ̀ Olùgbàlà"},{"start":43.186,"end":44.537,"text":"B'esu ti gbon to ni,","marked":"B'èṣù ti gbọ́n tó ni"},{"start":44.917,"end":46.588,"text":"Ko to kini kan fun Jesu.","marked":"Kó tó kínì kan fún Jésù."}],"end":46.588},{"key":"6","start":47.538,"lines":[{"start":47.538,"end":48.563,"text":"Iranlowo wa mbe","marked":"Ìrànlọ́wọ́ wá mbẹ́"},{"start":48.943,"end":49.974,"text":"L'Oruko Oluwa","marked":"L'Orúkọ Olúwa"},{"start":50.354,"end":51.682,"text":"T'O d'orun on aiye","marked":"T'ó d'ọrùn ọ́n aiye"},{"start":52.062,"end":53.171,"text":"Oba awon eni Mimo.","marked":"Ọba àwọn ẹni Mímọ́́."}],"end":53.171},{"key":"7","start":54.121,"lines":[{"start":54.121,"end":55.136,"text":"Ogo fun Baba wa,","marked":"Ògo fún Bàbá wa"},{"start":55.516,"end":56.657,"text":"Ogo fun Omo Re,","marked":"Ògo fún Ọmọ Rẹ"},{"start":57.037,"end":58.114,"text":"Ogo f'Emi Mimo","marked":"Ògo f'Èmi Mímọ́́"},{"start":58.494,"end":60.016,"text":"Metalokan jo gbo tiwa.","marked":"Mẹ́talọ́kan jọ gbọ́ tiwa."}],"end":60.016}]}