{"v":1,"coll":"y","num":848,"id":"hymn_848","title":"ERO s'orun l'awa nse","duration":84.157,"voices":{"male":{"file":"y-848-male.m4a","bytes":622089,"sha256":"bb2afa17d0ce7c31748219837184e331cbcc9f6f4c146f02e3f2f5c323bafbe7","duration":84.2},"female":{"file":"y-848-female.m4a","bytes":647211,"sha256":"800765a93b321d3d4c6baf8e65e6a599118f9bb158c218a0f3da6c8d69a43ccb","duration":84.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.614,"text":"ERO s'orun l'awa nse","marked":"Èrò s'ọrun l'áwá ńṣe"},{"start":1.994,"end":3.539,"text":"Aiye l'ajo orun n'ile wa","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa"},{"start":3.919,"end":5.488,"text":"Atipo ni awa je o","marked":"Àtìpó ni àwa jẹ́ o"},{"start":5.868,"end":7.805,"text":"Aiye l'ajo, orun n'ile wa","marked":"Aiye l'ájò, orun ń'ilẹ̀ wa"},{"start":8.185,"end":9.839,"text":"Gbogbo ewu lo duro o","marked":"Gbogbo ewu ló dúró o"},{"start":10.219,"end":11.379,"text":"Yika wa l'ojo gbogbo","marked":"Yíká wa l'ọjọ́ gbogbo"},{"start":11.759,"end":13.951,"text":"Ekun l'oni, erin l'ola","marked":"Ekun l'ọ́ni, erin l'ọ́la"},{"start":14.331,"end":16.605,"text":"Aiye l'ajo, orun n'ile wa.","marked":"Aiye l'ájò, orun ń'ilẹ̀ wà."}],"end":16.605},{"key":"2","start":17.555,"lines":[{"start":17.555,"end":19.204,"text":"Irantse ti sun n'nu Oluwa","marked":"Irantse ti sùn ń'nú Olúwa"},{"start":19.584,"end":21.711,"text":"Aiye l'ajo, orun n'ile wa","marked":"Aiye l'ájò, orun ń'ilẹ̀ wa"},{"start":22.091,"end":24.072,"text":"Ise d'opin, ija d'opin","marked":"Iṣẹ́ d'òpin, ìjà d'òpin"},{"start":24.452,"end":26.643,"text":"Aiye l'ajo, orun n'ile wa","marked":"Aiye l'ájò, orun ń'ilẹ̀ wa"},{"start":27.023,"end":28.504,"text":"O ti jagun f'Oluwa","marked":"Ó ti jagun f'Olúwa"},{"start":28.884,"end":30.046,"text":"O bo s'ayo Baba re","marked":"Ó bọ́ s'àyò Bàbá rẹ̀"},{"start":30.426,"end":31.667,"text":"Titi lao se 'ranti re","marked":"Títí laó ṣe 'rántí rẹ̀"},{"start":32.047,"end":33.69,"text":"Aiye l'ajo orun n'ile wa.","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa."}],"end":33.69},{"key":"3","start":34.64,"lines":[{"start":34.64,"end":36.913,"text":"Omode, nku, agba nku o","marked":"Ọmọdé, ńkú, àgbà ńkú o"},{"start":37.293,"end":38.723,"text":"Aiye l'ajo orun n'ile wa","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa"},{"start":39.103,"end":40.83,"text":"K'a ku n'nu Jesu lo dara,","marked":"K'á kú ń'nú Jésù ló dára"},{"start":41.21,"end":42.627,"text":"Aiye l'ajo orun n'ile wa","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa"},{"start":43.007,"end":44.679,"text":"Ka lo 'gba wa fun Jesu","marked":"Ká ló 'gbà wá fún Jésù"},{"start":45.059,"end":46.104,"text":"Tori ojo iku mbe","marked":"Torí ọjọ́ ikú ḿbẹ"},{"start":46.484,"end":47.795,"text":"Ko s'eniti ko ni ku o","marked":"Kò s'énítì kò ní kú o"},{"start":48.175,"end":49.864,"text":"Aiye l'ajo orun n'ile wa.","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa."}],"end":49.864},{"key":"4","start":50.814,"lines":[{"start":50.814,"end":52.19,"text":"Lod'Oluwa ni 'simi mbe","marked":"Lọ́d'Olúwa ní 'simi mbẹ́"},{"start":52.57,"end":54.166,"text":"Aiye l'ajo orun n'ile wa","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa"},{"start":54.546,"end":55.967,"text":"Banuje kan ko si nibe","marked":"Banújẹ́ kan kò sí níbẹ̀"},{"start":56.347,"end":57.959,"text":"Aiye l'ajo orun n'ile wa","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa"},{"start":58.339,"end":59.45,"text":"Opo ibugbe lo wa","marked":"Ọ̀pọ̀ ibùgbé ló wà"},{"start":59.83,"end":61.149,"text":"T'Olorun ti ko s'orun","marked":"T'Ọlọ́run tí kò s'ọrun"},{"start":61.529,"end":63.196,"text":"F'awon to ba sin I dopin","marked":"F'àwọn tó bá sìn Í dópin"},{"start":63.576,"end":65.553,"text":"Aiye l'ajo orun n'ile wa.","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa."}],"end":65.553},{"key":"5","start":66.503,"lines":[{"start":66.503,"end":67.987,"text":"Irantse ma yo n'nu Oluwa","marked":"Irantse má yọ ń'nú Olúwa"},{"start":68.367,"end":69.808,"text":"Aiye l'ajo orun n'ile wa","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa"},{"start":70.188,"end":71.91,"text":"O ti ri Jesu to fe o","marked":"Ó ti rí Jésù tó fẹ́ o"},{"start":72.29,"end":74.405,"text":"Aiye l'ajo, orun n'ile wa","marked":"Aiye l'ájò, orun ń'ilẹ̀ wa"},{"start":74.785,"end":76.053,"text":"Baba rere toju wa","marked":"Bàbá rere tọ́jú wa"},{"start":76.433,"end":77.715,"text":"K'aiye mase gbe wa lo!","marked":"K'áíyé máṣe gbé wa lọ!"},{"start":78.095,"end":79.491,"text":"K'a le j'eni idalare","marked":"K'á lè j'ẹni ìdáláre"},{"start":79.871,"end":81.641,"text":"Aiye l'ajo orun n'ile wa.","marked":"Aiye l'ájọ ọ̀run ń'ilẹ̀ wa."},{"start":82.021,"end":82.607,"text":"Amin.","marked":"Àmín."}],"end":82.607}]}