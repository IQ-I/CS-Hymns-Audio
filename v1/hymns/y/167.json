{"v":1,"coll":"y","num":167,"id":"hymn_167","title":"EDUMARE Jah Jehovah","duration":65.232,"voices":{"male":{"file":"y-167-male.m4a","bytes":465710,"sha256":"b0b5a965a30cab3faa9f3578fe244abcfff43a9da4d506687e48e421a3bd2d59","duration":65.3},"female":{"file":"y-167-female.m4a","bytes":478277,"sha256":"2ab3dfa847a9ed86d77ddb5269cfade1ff93334ba75d58207876badc0af8e4cc","duration":65.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.197,"text":"EDUMARE Jah Jehovah","marked":"Ẹdùmàrè Jah Jehovah"},{"start":2.577,"end":3.658,"text":"OBA Onibu-Ore","marked":"Ọba Oníbù-Ọ̀rẹ́"},{"start":4.038,"end":5.382,"text":"Mo mu ope mi wa fun O","marked":"Mo mú ọpẹ́ mi wá fún Ọ"},{"start":5.762,"end":6.88,"text":"Mo wa jewo ore Re.","marked":"Mo wá jẹ́wọ́ ọ̀rẹ́ Rẹ̀."}],"end":6.88},{"key":"CHORUS","start":7.83,"lines":[{"start":7.83,"end":8.747,"text":"Wa Olugbohun","marked":"Wá Olùgbóhùn"},{"start":9.127,"end":10.344,"text":"Tewogb'ohun ebe mi","marked":"Tẹ́wọ́gb'ọ́hun ẹ̀bẹ̀ mi"},{"start":10.724,"end":12.273,"text":"Baba mo wa d'opo Re mu","marked":"Bàbá mo wá d'ọ́pọ̀ Rẹ̀ mú"},{"start":12.653,"end":14.066,"text":"F'oyin s'aiye fun mi.","marked":"F'oyin s'aiye fún mi."}],"end":14.066},{"key":"2","start":15.016,"lines":[{"start":15.016,"end":16.755,"text":"Edumare Jah Jehovah","marked":"Ẹdùmàrè Jah Jehovah"},{"start":17.135,"end":18.608,"text":"Re mi lekun laiye mi","marked":"Rẹ̀ mí lẹ́kún láìyé mi"},{"start":18.988,"end":20.472,"text":"Mase je ki ota yo mi","marked":"Masẹ̀ jẹ́ kí ọ̀tá yọ mí"},{"start":20.852,"end":22.067,"text":"Gbe mi leke isoro.","marked":"Gbé mi lékè ìṣòro."}],"end":22.067},{"key":"3","start":23.017,"lines":[{"start":23.017,"end":24.967,"text":"Edumare Jah Jehovah","marked":"Ẹdùmàrè Jah Jehovah"},{"start":25.347,"end":26.666,"text":"Ko s'alabaro fun mi","marked":"Kò s'alabaro fún mi"},{"start":27.046,"end":28.874,"text":"Mo ko aniyan mi to O wa,","marked":"Mo kọ àníyàn mi tó O wà"},{"start":29.254,"end":30.674,"text":"Maje k'aiye ri'di mi.","marked":"Màjẹ́ k'áíyé rí'dì mí."}],"end":30.674},{"key":"4","start":31.624,"lines":[{"start":31.624,"end":33.286,"text":"Edumare Jah Jehovah","marked":"Ẹdùmàrè Jah Jehovah"},{"start":33.666,"end":34.752,"text":"Fun mi n'ibale okan","marked":"Fún mi ń'íbàlẹ̀ ọkàn"},{"start":35.132,"end":36.859,"text":"Mase je ki ile le mi","marked":"Masẹ̀ jẹ́ kí ilé lè mì"},{"start":37.239,"end":38.914,"text":"Mase je k'ona na mi.","marked":"Masẹ̀ jẹ k'ọ́nà nà mí."}],"end":38.914},{"key":"5","start":39.864,"lines":[{"start":39.864,"end":41.517,"text":"Edumare Jah Jehovah","marked":"Ẹdùmàrè Jah Jehovah"},{"start":41.897,"end":43.399,"text":"Jek' awon 'mo wa tunla","marked":"Jek' àwọn 'mo wá tunla"},{"start":43.779,"end":45.115,"text":"Awon agon nwo O loju","marked":"Àwọn àgọ́n ńwọ́ Ọ lójú"},{"start":45.495,"end":46.913,"text":"F'Omo rere jinki won.","marked":"F'Ọmọ rere jíǹkí wọn."}],"end":46.913},{"key":"6","start":47.863,"lines":[{"start":47.863,"end":49.576,"text":"Edumare Jah Jehovah","marked":"Ẹdùmàrè Jah Jehovah"},{"start":49.956,"end":51.286,"text":"Se aiye mi ni rere","marked":"Ṣe àìyé mi ní rere"},{"start":51.666,"end":53.57,"text":"Gba mi lowo oso, aje","marked":"Gbà mí lọ́wọ́ oṣó, àjẹ́"},{"start":53.95,"end":55.61,"text":"Ma fi mi t'ore f'Esu.","marked":"Má fi mí t'ọ̀rẹ́ f'Èṣù."}],"end":55.61},{"key":"7","start":56.56,"lines":[{"start":56.56,"end":58.334,"text":"Edumare Jah Jehovah,","marked":"Ẹdùmàrè Jah Jehovah"},{"start":58.714,"end":60.028,"text":"Bukun wa tile-tona","marked":"Bùkún wa tilé-tọ̀nà"},{"start":60.408,"end":61.96,"text":"S'opo at'asa Ijo wa,","marked":"S'ọ́pọ̀ àt'àṣà Ìjọ wa"},{"start":62.34,"end":63.682,"text":"Bukun wa kari-kari.","marked":"Bùkún wa kárí-kárí."}],"end":63.682}]}