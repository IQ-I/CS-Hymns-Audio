{"v":1,"coll":"y","num":860,"id":"hymn_860","title":"B'O ti dun lati gba Jesu","duration":46.898,"voices":{"male":{"file":"y-860-male.m4a","bytes":339121,"sha256":"ee72ca0a2df3ba3c1ba509c41375c0325fada921107470709738de9e4e2f4e69","duration":46.9},"female":{"file":"y-860-female.m4a","bytes":349489,"sha256":"656b3ae4752f34d2c39b706251ac92cb23e54a54e3a2caf9130e0e2bab344e99","duration":46.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.27,"text":"B'O ti dun lati gba Jesu","marked":"B'ó ti dùn láti gba Jésù"},{"start":2.65,"end":3.755,"text":"Gbo gegebi oro Re","marked":"Gbọ́ gẹ́gẹ́bí ọ̀rọ̀ Rẹ"},{"start":4.135,"end":5.28,"text":"K'a simi lor'ileri Re","marked":"K'á sìmí lór'ìlérí Rẹ̀"},{"start":5.66,"end":7.175,"text":"Sa gbagbo l'Oluwa wi.","marked":"Sa gbàgbọ́ l'Olúwa wi."}],"end":7.175},{"key":"CHORUS","start":8.125,"lines":[{"start":8.125,"end":10.687,"text":"Jesu, Jesu, emi gbagbo","marked":"Jésù, Jésù, ẹ̀mí gbàgbọ́"},{"start":11.067,"end":12.765,"text":"Mo gbekele n'gbagbogbo","marked":"Mo gbẹ́kẹ̀lé n'gbàgbogbo"},{"start":13.145,"end":15.236,"text":"Jesu, Jesu, Alabukun","marked":"Jésù, Jésù, Alábùkún"},{"start":15.616,"end":17.313,"text":"Ki nle gbekele O si.","marked":"Kí ńlẹ̀ gbẹ́kẹ̀lé Ó sí."}],"end":17.313},{"key":"2","start":18.263,"lines":[{"start":18.263,"end":20.178,"text":"B'o ti dun lati gba Jesu","marked":"B'ó ti dùn láti gba Jésù"},{"start":20.558,"end":21.973,"text":"K'a gb'eje wenumo Re","marked":"K'á gb'ẹ̀jẹ̀ wenumo Rẹ"},{"start":22.353,"end":24.17,"text":"Igbagbo ni ki a fi bo","marked":"Ìgbàgbọ́́ ni kí a fi bò"},{"start":24.55,"end":26.032,"text":"Sin'eje wenumo na.","marked":"Sin'ẹ̀jẹ̀ wenumo ná."}],"end":26.032},{"key":"3","start":26.982,"lines":[{"start":26.982,"end":29.072,"text":"B'o ti dun lati gba Jesu","marked":"B'ó ti dùn láti gba Jésù"},{"start":29.452,"end":30.792,"text":"Ki nk'ara ese sile","marked":"Kí nk'ara ẹsẹ̀ sílẹ̀"},{"start":31.172,"end":34.102,"text":"Ki ngb'ayo, iye, isimi","marked":"Kí ngb'ayo, iye, ìsimi"},{"start":34.482,"end":36.06,"text":"Lati odo Jesu mi.","marked":"Láti ọ̀dọ̀ Jésù mi."}],"end":36.06},{"key":"4","start":37.01,"lines":[{"start":37.01,"end":38.688,"text":"Mo yo mo gbeke mi le O","marked":"Mo yọ̀ mo gbẹ́kẹ̀ mi lé O"},{"start":39.068,"end":40.892,"text":"Jesu mi, Alabukun","marked":"Jésù mi, Alábùkún"},{"start":41.272,"end":42.72,"text":"Mo mo pe O wa pelu mi","marked":"Mo mọ̀ pé Ó wà pẹ̀lú mi"},{"start":43.1,"end":44.353,"text":"Ntoju mi titi dopin.","marked":"Ntọ́jú mi títí dópin."},{"start":44.733,"end":45.348,"text":"Amin.","marked":"Àmín."}],"end":45.348}]}