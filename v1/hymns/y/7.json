{"v":1,"coll":"y","num":7,"id":"hymn_7","title":"JESU, Orun ododo","duration":54.228,"voices":{"male":{"file":"y-7-male.m4a","bytes":383380,"sha256":"03520994ff63fb1698ce7611ccfaa7a0224d8abd27b77a48ed04cbde7d303d3c","duration":54.3},"female":{"file":"y-7-female.m4a","bytes":403477,"sha256":"a2fc34fb11f7cc2d2b4d34797dda2bd13d7cb45207274d15c1be2e7eca43a8ec","duration":54.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.875,"text":"JESU, Orun ododo,","marked":"Jésù, Ọ̀run òdodo"},{"start":2.255,"end":3.447,"text":"Iwo Imole ife","marked":"Ìwo Ìmọ́lẹ̀̀ ìfẹ́"},{"start":3.827,"end":4.988,"text":"Gbat' imole owuro","marked":"Gbat' ìmọ́lẹ̀̀ òwúrọ̀"},{"start":5.368,"end":6.843,"text":"Ba nt'ila orun tan wa,","marked":"Bá nt'ila ọ̀run tàn wá"},{"start":7.223,"end":8.259,"text":"Tanmole ododo Re","marked":"Tànmọ́lẹ̀ òdodo Rẹ"},{"start":8.639,"end":9.518,"text":"Yi wa ka.","marked":"Yí wa ká."}],"end":9.518},{"key":"2","start":10.468,"lines":[{"start":10.468,"end":11.715,"text":"Gege bi in ti nse,","marked":"Gẹ́gẹ́ bí in ti ńṣe"},{"start":12.095,"end":13.229,"text":"Son eweko gbogbo,","marked":"Sọ́n ewéko gbogbo"},{"start":13.609,"end":14.653,"text":"K'Emi ore'ofe Re","marked":"K'Èmi ọ̀rẹ́'ọ̀fẹ́ Rẹ"},{"start":15.033,"end":16.291,"text":"So okan wa 'di otun;","marked":"Sọ ọkàn wa 'di ọ̀tún"},{"start":16.671,"end":17.761,"text":"Ro ojo ibuknn Re","marked":"Ro ọjọ́ ibuknn Rẹ"},{"start":18.141,"end":19.234,"text":"Sori wa.","marked":"Ṣọ́rí wa."}],"end":19.234},{"key":"3","start":20.184,"lines":[{"start":20.184,"end":21.575,"text":"B'imole orun ti nran","marked":"B'ìmọ́lẹ̀̀ ọ̀run ti ńràn"},{"start":21.955,"end":23.256,"text":"K'imole ife Tire,","marked":"K'ìmọ́lẹ̀̀ ìfẹ́ Tírè"},{"start":23.636,"end":25.17,"text":"Si ma ghona l'okan wa,","marked":"Sì ma ghona l'ọkàn wa"},{"start":25.55,"end":27.167,"text":"K'o si mu wa l'ara ya,","marked":"K'ó sì mú wa l'ara yá"},{"start":27.547,"end":28.958,"text":"K'a le ma fayo sin O,","marked":"K'á lè má fayọ̀ sìn Ọ́"},{"start":29.338,"end":30.142,"text":"L'aiye wa.","marked":"L'aiye wa."}],"end":30.142},{"key":"4","start":31.092,"lines":[{"start":31.092,"end":32.759,"text":"Amona, lreti wa,","marked":"Amọ̀nà, lreti wa"},{"start":33.139,"end":34.621,"text":"Ma fi wa sile tili,","marked":"Má fi wá sílẹ̀ tilí"},{"start":35.001,"end":36.346,"text":"Fi wa sabe iso Re,","marked":"Fi wá sábẹ́ ìṣọ́ Rẹ"},{"start":36.726,"end":38.035,"text":"Titi opin emi wa,","marked":"Títí òpin ẹ̀mí wa"},{"start":38.415,"end":39.901,"text":"Sin wa la ajo wa ja","marked":"Sin wá la àjọ wa já"},{"start":40.281,"end":41.166,"text":"S'ile wa.","marked":"S'ilẹ̀ wà."}],"end":41.166},{"key":"5","start":42.116,"lines":[{"start":42.116,"end":43.501,"text":"Pa wa mo n'nu ife Re,","marked":"Pa wá mò ń'nú ìfẹ́ Rẹ"},{"start":43.881,"end":45.228,"text":"Lojo aiye wa gbogbo,","marked":"Lọ́jọ́ àìyẹ́ wa gbogbo"},{"start":45.608,"end":47.002,"text":"Si mu wa bori iku,","marked":"Sì mú wa borí ikú"},{"start":47.382,"end":48.66,"text":"Mu wa de'le ayo na,","marked":"Mú wa dé'lé ayọ̀ ná"},{"start":49.04,"end":50.269,"text":"K'a le b'awon mimo","marked":"K'á lè b'àwọn mímọ́́"},{"start":50.649,"end":51.696,"text":"gba isin mi.","marked":"gba ìsìn mi."},{"start":52.076,"end":52.678,"text":"Amin.","marked":"Àmín."}],"end":52.678}]}