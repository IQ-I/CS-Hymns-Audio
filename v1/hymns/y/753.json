{"v":1,"coll":"y","num":753,"id":"hymn_753","title":"AWON t'o sowon fun wa","duration":45.44,"voices":{"male":{"file":"y-753-male.m4a","bytes":316737,"sha256":"b9c940a16c963a77ef7dcd33a0a511f6c34a3b2089a13bd1f7b035be275b50e9","duration":45.5},"female":{"file":"y-753-female.m4a","bytes":331154,"sha256":"271961448d25f657782cb0c8964157185717dcda5ce9a52ae53cd6212531bfab","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.593,"text":"AWON t'o sowon fun wa","marked":"Àwọn t'ó ṣọ̀wọ́n fún wa"},{"start":1.973,"end":3.08,"text":"Ninu Egbe Serafu","marked":"Nínú Ẹgbẹ́ Séráfù"},{"start":3.46,"end":4.965,"text":"Nwon ti lo s'aiyeraiye","marked":"Nwọ̀n ti lọ s'aiyérayé"},{"start":5.345,"end":6.619,"text":"Ko ha ye k'a ranti won?","marked":"Kò ha yé k'á rántí wọn?"}],"end":6.619},{"key":"2","start":7.569,"lines":[{"start":7.569,"end":8.848,"text":"Awon t'o sowon fun wa","marked":"Àwọn t'ó ṣọ̀wọ́n fún wa"},{"start":9.228,"end":10.662,"text":"Larin Egbe Kerubu","marked":"Lárin Ẹgbẹ́ Kérúbù"},{"start":11.042,"end":12.358,"text":"Nwon dapo mo jo t'orun","marked":"Nwọ́n dàpọ̀ mo jọ t'orun"},{"start":12.738,"end":14.398,"text":"lse won nto won lehin.","marked":"lṣe wọ́n ńtọ́ wọn lẹ́hìn."}],"end":14.398},{"key":"3","start":15.348,"lines":[{"start":15.348,"end":16.71,"text":"Awon t'o sowon fun wa","marked":"Àwọn t'ó ṣọ̀wọ́n fún wa"},{"start":17.09,"end":18.459,"text":"Ninu Egbe Aladura","marked":"Nínú Ẹgbẹ́ Aladura"},{"start":18.839,"end":20.257,"text":"Enit' o ku ti pari","marked":"Enit' ò kù ti parí"},{"start":20.637,"end":22.107,"text":"Ise re l'odo Jesu.","marked":"Iṣẹ́ rẹ l'ọ́dọ̀ Jésù."}],"end":22.107},{"key":"4","start":23.057,"lines":[{"start":23.057,"end":24.351,"text":"Awon wonyi ti segun","marked":"Àwọn wọ̀nyí ti ṣẹ́gun"},{"start":24.731,"end":25.813,"text":"F'Ola Olugbala won","marked":"F'Ọlá Olùgbàlà wọn"},{"start":26.193,"end":27.794,"text":"Nwon ti gb'ohun Jesu pe","marked":"Nwọ̀n ti gb'óhùn Jésù pé"},{"start":28.174,"end":29.389,"text":"Bo s'ayo Oluwa Re.","marked":"Bó s'àyò Olúwa Rẹ."}],"end":29.389},{"key":"5","start":30.339,"lines":[{"start":30.339,"end":31.415,"text":"Oluwa gbadura wa","marked":"Olúwa gbàdúrà wa"},{"start":31.795,"end":33.396,"text":"K'a le ni 'po lodo Re","marked":"K'á lè ní 'pọ̀ lọ́dọ̀ Rẹ"},{"start":33.776,"end":35.237,"text":"K'a ma tan bi irawo","marked":"K'á ma tán bí ìràwọ̀"},{"start":35.617,"end":37.094,"text":"Titi lai lod'Oluwa.","marked":"Títí láí lód'Olúwa."}],"end":37.094},{"key":"6","start":38.044,"lines":[{"start":38.044,"end":39.372,"text":"E f'ogo fun Baba wa,","marked":"Ẹ f'ògo fún Bàbá wa"},{"start":39.752,"end":40.878,"text":"E f'ogo fun Omo Re","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":41.258,"end":42.332,"text":"E f'ogo Emi Mimo","marked":"Ẹ f'ògò Ẹ̀mí Mímọ́́"},{"start":42.712,"end":43.89,"text":"Ogo fun metalokan.","marked":"Ògo fún Mẹ́talọ́kan."}],"end":43.89}]}