{"v":1,"coll":"y","num":865,"id":"hymn_865","title":"OLUWA awa de","duration":46.387,"voices":{"male":{"file":"y-865-male.m4a","bytes":324180,"sha256":"a5ca88aec23825e1dbb4925379c179482d43ebe2efe3aebf227e8b71bbada446","duration":46.4},"female":{"file":"y-865-female.m4a","bytes":334508,"sha256":"676b526cd044fb2d047a26bc3f9ae1bc7c5bf74ff480e7a36042e1874ec35416","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.255,"text":"OLUWA awa de","marked":"Olúwa àwa dé"},{"start":1.635,"end":3.522,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":3.902,"end":5.308,"text":"Lati je ise to ra wa","marked":"Láti jẹ́ iṣẹ́ tó rà wá"},{"start":5.688,"end":6.891,"text":"Fun gbogbo agbaiye.","marked":"Fún gbogbo agbaiye."}],"end":6.891},{"key":"2","start":7.841,"lines":[{"start":7.841,"end":9.115,"text":"lse t'o ran l'eyi","marked":"lse t'ó ran l'èyí"},{"start":9.495,"end":10.626,"text":"Olorun Oluwa","marked":"Ọlọ́run Olúwa"},{"start":11.006,"end":12.746,"text":"P'a won ti nb'ojo isimi je","marked":"P'á wọn ti ńb'ọjọ́ ìsimi jẹ"},{"start":13.126,"end":14.456,"text":"Ni yio jebi poju.","marked":"Ní yíó jẹ̀bi pọ̀jù."}],"end":14.456},{"key":"3","start":15.406,"lines":[{"start":15.406,"end":16.672,"text":"K'araiye teriba","marked":"K'araiye tẹríbá"},{"start":17.052,"end":18.213,"text":"Niwaju ase Re","marked":"Níwájú àṣẹ Rẹ"},{"start":18.593,"end":19.859,"text":"K'ibinu Olodumare","marked":"K'ìbínú Olódùmarè"},{"start":20.239,"end":21.64,"text":"Le ka kuro l'aiye.","marked":"Lè ká kúrò l'aiye."}],"end":21.64},{"key":"4","start":22.59,"lines":[{"start":22.59,"end":23.85,"text":"Kerubu Serafu","marked":"Kérúbù Séráfù"},{"start":24.23,"end":25.348,"text":"Enyin n'iyo aiye","marked":"Enyin n'iyọ̀ aiye"},{"start":25.728,"end":27.518,"text":"Iluu t'a te sori oke","marked":"Ìlúu t'á tẹ̀ sórí òkè"},{"start":27.898,"end":29.352,"text":"Yio ti se farasin.","marked":"Yío ti ṣe farasin."}],"end":29.352},{"key":"5","start":30.302,"lines":[{"start":30.302,"end":31.74,"text":"E fun 'pe na kikan","marked":"Ẹ fún 'pé ná kíkan"},{"start":32.12,"end":33.492,"text":"Nipa t'ojo isimi","marked":"Nípa t'ọjọ́ ìsimi"},{"start":33.872,"end":34.839,"text":"Ki gbogbo orile-ede","marked":"Kí gbogbo orílẹ̀-èdè"},{"start":35.219,"end":36.374,"text":"Le p'ojo Mimo mo.","marked":"Le p'ọjọ́ Mímọ́́ mọ́."}],"end":36.374},{"key":"6","start":37.324,"lines":[{"start":37.324,"end":38.561,"text":"E f'Ogo fun Baba","marked":"Ẹ f'Ògo fún Bàbá"},{"start":38.941,"end":40.093,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":40.473,"end":42.061,"text":"E f'Ogo fun Emi Mimo","marked":"Ẹ f'Ògo fún Ẹ̀mí Mímọ́́"},{"start":42.441,"end":43.841,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."},{"start":44.221,"end":44.837,"text":"Amin.","marked":"Àmín."}],"end":44.837}]}