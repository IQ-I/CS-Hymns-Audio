{"v":1,"coll":"y","num":157,"id":"hymn_157","title":"J'ALAGBARA n'nu","duration":70.618,"voices":{"male":{"file":"y-157-male.m4a","bytes":524519,"sha256":"f7530d2779ca0c2fdbb8db7565b9b99246500855de335c039c9fca2232504c30","duration":70.7},"female":{"file":"y-157-female.m4a","bytes":539983,"sha256":"2baf1a3abfd1de4b09b4dbd8058cc5a831efd933959a49a65f71ddb1e0f70525","duration":70.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.384,"text":"J'ALAGBARA n'nu","marked":"J'alágbára ń'nú"},{"start":1.764,"end":4.221,"text":"Krist, ati pa agbara Re","marked":"Krist, àti pa agbára Rẹ̀"},{"start":4.601,"end":6.396,"text":"Duro sinsin f'otito oro Re","marked":"Dúró ṣinṣin f'òtítọ́́ ọ̀rọ̀ Rẹ"},{"start":6.776,"end":8.171,"text":"Y'o mu o koja lo larin","marked":"Y'ó mú ọ kọjá lọ lárin"},{"start":8.551,"end":9.611,"text":"ogun to gbona","marked":"ogun tó gbóná"},{"start":9.991,"end":11.929,"text":"'Wo y'o segun l'Oruko Oluwa,","marked":"'Wò y'ó ṣẹ́gun l'Orúkọ Olúwa"},{"start":12.309,"end":13.795,"text":"Egbe:  Duro gbonyin, f'otito","marked":"Dúró gbọ̀nyìn, f'òtítọ́́"},{"start":14.175,"end":15.58,"text":"Lo si 'segun Ii ase Oba","marked":"Lọ sí 'ṣẹ́gun Ií àṣẹ Ọba"},{"start":15.96,"end":17.595,"text":"Fun Ola Oluwa Re ati","marked":"Fún Ọlá Olúwa Rẹ àti"},{"start":17.975,"end":19.036,"text":"'segun oro Re,","marked":"'ṣẹ́gun ọ̀rọ̀ Rẹ"},{"start":19.416,"end":21.02,"text":"Duro gbonyin I'agbara Oluwa.","marked":"Dúró gbọ̀nyìn l'ágbára Olúwa."}],"end":21.02},{"key":"CHORUS","start":21.97,"lines":[{"start":21.97,"end":23.446,"text":"Duro gbonyin, f'otito","marked":"Dúró gbọ̀nyìn, f'òtítọ́́"},{"start":23.826,"end":25.176,"text":"Lo si 'segun Ii ase Oba","marked":"Lọ sí 'ṣẹ́gun Ií àṣẹ Ọba"},{"start":25.556,"end":27.303,"text":"Fun Ola Oluwa Re ati","marked":"Fún Ọlá Olúwa Rẹ àti"},{"start":27.683,"end":28.711,"text":"'segun oro Re,","marked":"'ṣẹ́gun ọ̀rọ̀ Rẹ"},{"start":29.091,"end":30.984,"text":"Duro gbonyin I'agbara Oluwa.","marked":"Dúró gbọ̀nyìn l'ágbára Olúwa."}],"end":30.984},{"key":"2","start":31.934,"lines":[{"start":31.934,"end":34.93,"text":"J'alagbara n'nu Kristi ati","marked":"J'alágbára ń'nú Kristi àti"},{"start":35.31,"end":36.353,"text":"'pa agbara Re.","marked":"'pa agbára Rẹ."},{"start":36.733,"end":38.789,"text":"Mase pehinda niwaju ota","marked":"Masẹ̀ pẹ̀hìndà níwájú ọ̀tá"},{"start":39.169,"end":42.307,"text":"Yio duro ti o b'o ti nja fun Otito","marked":"Yíó dúró tí ó b'ó ti ńjà fún Òtítọ́́"},{"start":42.687,"end":44.666,"text":"Te siwaju n'nu 'pa agbara Re.","marked":"Tẹ̀ síwájú ń'nú 'pa agbára Rẹ."},{"start":45.046,"end":46.866,"text":"Egbe:  Duro gbonyin, f'otito...","marked":"Dúró gbọ̀nyìn, f'òtítọ́́"}],"end":46.866},{"key":"3","start":47.816,"lines":[{"start":47.816,"end":49.178,"text":"J'alagbara n'nu Kristi","marked":"J'alágbára ń'nú Kristi"},{"start":49.558,"end":51.018,"text":"ati 'pa agbara Re,","marked":"àti 'pa agbára Rẹ̀"},{"start":51.398,"end":52.987,"text":"'Tori 'leri Re ki yio ye lai","marked":"'Torí 'lérí Rẹ̀ kí yio yé láí"},{"start":53.367,"end":54.836,"text":"Yio dowo re mu gbat'o","marked":"Yíó dọwọ́ rẹ̀ mú gbat'o"},{"start":55.216,"end":56.263,"text":"nja fun otito","marked":"ńjà fún òtítọ́́"},{"start":56.643,"end":58.583,"text":"Gbekele wo o ma segun lailai","marked":"Gbẹ́kẹ̀lé wo ó má ṣẹ́gun láíláí"},{"start":58.963,"end":60.784,"text":"Egbe:  Duro gbonyin, f'otito","marked":"Dúró gbọ̀nyìn, f'òtítọ́́"},{"start":61.164,"end":62.601,"text":"Lo si 'segun Ii ase Oba","marked":"Lọ sí 'ṣẹ́gun Ií àṣẹ Ọba"},{"start":62.981,"end":64.767,"text":"Fun Ola Oluwa Re ati","marked":"Fún Ọlá Olúwa Rẹ àti"},{"start":65.147,"end":66.128,"text":"'segun oro Re,","marked":"'ṣẹ́gun ọ̀rọ̀ Rẹ"},{"start":66.508,"end":68.101,"text":"Duro gbonyin I'agbara Oluwa.","marked":"Dúró gbọ̀nyìn l'ágbára Olúwa."},{"start":68.481,"end":69.068,"text":"Amin.","marked":"Àmín."}],"end":69.068}]}