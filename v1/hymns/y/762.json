{"v":1,"coll":"y","num":762,"id":"hymn_762","title":"IBUKUN ni foku","duration":53.598,"voices":{"male":{"file":"y-762-male.m4a","bytes":375383,"sha256":"903a2b880615ac1865a9038cc7dc32864bb886b8f203efcdfc8ae482f776509e","duration":53.6},"female":{"file":"y-762-female.m4a","bytes":390572,"sha256":"ba943f2a974b1bb5a77f574de5d36f235dfccd79ce3754fd53ea769d5de2d7bf","duration":53.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.567,"text":"IBUKUN ni f'oku","marked":"Ìbùkún ní f'òkú"},{"start":1.947,"end":3.261,"text":"T'o simi le Jesu","marked":"T'ó sìmí lé Jésù"},{"start":3.641,"end":4.898,"text":"Awon t'o gb'ori won","marked":"Àwọn t'ó gb'orí wọn"},{"start":5.278,"end":6.557,"text":"Le okan aiya Re.","marked":"Lé ọkàn àìyá Rẹ."}],"end":6.557},{"key":"2","start":7.507,"lines":[{"start":7.507,"end":8.726,"text":"Iran 'bukun l'eyi","marked":"Ìran 'bùkún l'èyí"},{"start":9.106,"end":10.382,"text":"Ko si 'boju larin","marked":"Kò sì 'bójú lárin"},{"start":10.762,"end":11.809,"text":"Nwon ri En'imole","marked":"Nwọ̀n rí Ẹ́ń'ìmọ́lẹ̀̀"},{"start":12.189,"end":14.123,"text":"Ti nwon ti fe lairi.","marked":"Ti nwọn ti fẹ́ láìrí."}],"end":14.123},{"key":"3","start":15.073,"lines":[{"start":15.073,"end":16.283,"text":"Nwon bo Iowo aiye","marked":"Nwọ̀n bọ́ lọ́wọ́ aiye"},{"start":16.663,"end":17.83,"text":"Pelu aniyan re","marked":"Pẹ̀lú àníyàn rẹ̀"},{"start":18.21,"end":19.235,"text":"Nwon bo lowo ewu","marked":"Nwọ̀n bọ́ lọ́wọ́ ewu"},{"start":19.615,"end":21.201,"text":"T'o nrin l'osan, l'oru.","marked":"T'ó ńrín l'ọ̀sán, l'oru."}],"end":21.201},{"key":"4","start":22.151,"lines":[{"start":22.151,"end":23.132,"text":"Lori iboji won","marked":"Lórí ibojì wọn"},{"start":23.512,"end":24.928,"text":"L'awa nsokun loni","marked":"L'áwá ǹṣókùn lónì"},{"start":25.308,"end":26.629,"text":"Nwon j'eni ire fun wa","marked":"Nwọn j'ẹni ire fún wa"},{"start":27.009,"end":28.475,"text":"T'a kl y'o gbagbe lai.","marked":"T'á kl y'ó gbàgbé láí."}],"end":28.475},{"key":"5","start":29.425,"lines":[{"start":29.425,"end":30.705,"text":"A k' y'o gbohun won mo","marked":"A k' y'ó gbohùn wọn mọ́"},{"start":31.085,"end":32.061,"text":"Ohun ife didun","marked":"Ohun ìfẹ́ dídùn"},{"start":32.441,"end":34.624,"text":"Lat' oni lo, aiye","marked":"Lát' ọ̀nì lọ, aiye"},{"start":35.004,"end":36.118,"text":"Ki o tun mo won mo.","marked":"Kí o tún mọ̀ wọ́n mọ́."}],"end":36.118},{"key":"6","start":37.068,"lines":[{"start":37.068,"end":38.132,"text":"Enyin oninure","marked":"Enyin onínúrẹ́"},{"start":38.512,"end":39.737,"text":"E fi wa sile lo","marked":"Ẹ fi wá sílẹ̀ lọ"},{"start":40.117,"end":42.178,"text":"Ao sokun nyin titi","marked":"Aó sọkún nyin títí"},{"start":42.558,"end":43.854,"text":"Jesu pa sokun ri.","marked":"Jésù pa sókun rí."}],"end":43.854},{"key":"7","start":44.804,"lines":[{"start":44.804,"end":45.984,"text":"Sugbon a fe gbohun","marked":"Ṣùgbọ́n a fẹ́ gbóhùn"},{"start":46.364,"end":47.434,"text":"Olodumare na","marked":"Olódùmarè ná"},{"start":47.814,"end":50.209,"text":"Y'o ko, y'o si wipe","marked":"Y'ó kọ́, y'ó sì wípé"},{"start":50.589,"end":52.048,"text":"E dide, e si yo.","marked":"Ẹ dìde, ẹ sì yó."}],"end":52.048}]}