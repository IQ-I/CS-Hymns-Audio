{"v":1,"coll":"y","num":331,"id":"hymn_331","title":"JESU ore elese ku","duration":37.371,"voices":{"male":{"file":"y-331-male.m4a","bytes":279887,"sha256":"0fadd6a2df3c053f227550af2a3f7ba940bb34b67eae4c98fc85d6c5110645f5","duration":37.4},"female":{"file":"y-331-female.m4a","bytes":284611,"sha256":"b4432daecb6ab2369a76c93a0c804439af806a805d834309054b9b95fe597e80","duration":37.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.831,"text":"JESU ore elese ku,","marked":"Jésù ọ̀rẹ́ ẹlẹ́ṣẹ̀ kù"},{"start":2.211,"end":3.593,"text":"Awon omo Salem nsokun","marked":"Àwọn ọmọ Salem ǹṣókùn"},{"start":3.973,"end":5.326,"text":"Okunkun bo oju orun","marked":"Òkùnkùn bo ojú ọ̀run"},{"start":5.706,"end":7.223,"text":"Iseti nla se lojiji.","marked":"Ìṣẹ́tí ńlá ṣe lójijì."}],"end":7.223},{"key":"2","start":8.173,"lines":[{"start":8.173,"end":9.682,"text":"Nihin l'a r'anu at'ife","marked":"Nihin l'á r'ánú àt'ife"},{"start":10.062,"end":11.441,"text":"Oba ogo ku f 'enia","marked":"Ọba ògo kù f 'enia"},{"start":11.821,"end":14.179,"text":"Wa! ayo kil' a tun ri yi","marked":"Wá! ayọ̀ kil' á tún rí yí"},{"start":14.559,"end":16.329,"text":"Jesu t'O ku tun ji dide.","marked":"Jésù t'Ó kú tún jí dìde."}],"end":16.329},{"key":"3","start":17.279,"lines":[{"start":17.279,"end":19.401,"text":"Ma beru, \"Oba, wa titi","marked":"Má bẹ̀rù, Ọba, wà títí"},{"start":19.781,"end":21.183,"text":"Iwo t'a bi lati gba wa”","marked":"Ìwọ t'á bí láti gbà wá"},{"start":21.563,"end":23.384,"text":"K'e b'iku pe, ”Oro re da?","marked":"K'é b'ikú pé, Ọ̀rọ̀ rẹ dà?"},{"start":23.764,"end":25.683,"text":"\"Iboji, isegun re da?","marked":"Ibojì, ìṣẹ́gun rẹ̀ dà?"}],"end":25.683},{"key":"4","start":26.633,"lines":[{"start":26.633,"end":29.301,"text":"E wipe, “Oba, wa titi,","marked":"Ẹ wípé, Ọba, wà títí"},{"start":29.681,"end":32.704,"text":"Iwo ta bi Iati gba wa,\"nK'e b'iku pe, “Oro re da?”","marked":"Ìwọ ta bí láti gbà wá,nK'e b'ikú pé, Ọ̀rọ̀ rẹ dà?"},{"start":33.084,"end":34.844,"text":"“iboji, isegun're da?”","marked":"ibojì, ìṣẹ́gun'rẹ̀ dà?"},{"start":35.224,"end":35.821,"text":"Amin.","marked":"Àmín."}],"end":35.821}]}