{"v":1,"coll":"y","num":394,"id":"hymn_394","title":"MO f'iyin ailopin","duration":44.07,"voices":{"male":{"file":"y-394-male.m4a","bytes":312974,"sha256":"a450b9f7bcf84064ce2d7582b80ac9dc792a0ddc1be11e07a3509a8f60cca357","duration":44.1},"female":{"file":"y-394-female.m4a","bytes":324450,"sha256":"a77272f0403f27f414224cf7af68b4798370ec9d30437d57bc5d8a60c598208a","duration":44.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.548,"text":"MO f'iyin ailopin","marked":"Mo f'ìyìn àìlópin"},{"start":1.928,"end":2.918,"text":"Fun Olorun baba","marked":"Fún Ọlọ́run bàbá"},{"start":3.298,"end":4.529,"text":"Fun ore aiye mi","marked":"Fún ọ̀rẹ́ aiye mi"},{"start":4.909,"end":6.016,"text":"At'ireti t'orun","marked":"Àt'ìrètí t'ọrun"},{"start":6.396,"end":7.569,"text":"O ran Omo Re ayanfe","marked":"Ó rán Ọmọ Rẹ̀ àyànfẹ́"},{"start":7.949,"end":9.78,"text":"Lati ku fun ese aiye.","marked":"Láti kú fún ẹ̀ṣẹ̀ aiye."}],"end":9.78},{"key":"2","start":10.73,"lines":[{"start":10.73,"end":12.168,"text":"Mo f'iyin ailopin","marked":"Mo f'ìyìn àìlópin"},{"start":12.548,"end":13.643,"text":"Fun Olorun Omo","marked":"Fún Ọlọ́run Ọmọ"},{"start":14.023,"end":15.134,"text":"T'O f'eje Re we wa","marked":"T'ó f'ẹ̀jẹ̀ Rẹ̀ wé wa"},{"start":15.514,"end":16.557,"text":"Kuro ninu egbe","marked":"Kúrò nínú ẹgbẹ́"},{"start":16.937,"end":18.561,"text":"Nisisiyi O wa l'Oba","marked":"Nisisiyi Ó wà l'Ọba"},{"start":18.941,"end":20.284,"text":"O nri eso irora Re.","marked":"Ó ńrí èso ìrora Rẹ̀."}],"end":20.284},{"key":"3","start":21.234,"lines":[{"start":21.234,"end":22.691,"text":"Mo f'iyin ailopin","marked":"Mo f'ìyìn àìlópin"},{"start":23.071,"end":24.137,"text":"Fun Olorun Emi","marked":"Fún Ọlọ́run Ẹ̀mí"},{"start":24.517,"end":25.546,"text":"Eni f 'agbara Re","marked":"Ẹní f 'ágbára Rẹ̀"},{"start":25.926,"end":27.084,"text":"So elese d'aye","marked":"Sọ ẹlẹ́sẹ̀ d'áyé"},{"start":27.464,"end":28.646,"text":"O pari ise igbala","marked":"Ó parí iṣẹ́ ìgbàlà"},{"start":29.026,"end":30.663,"text":"O si fi ayo kun okan.","marked":"Ó sì fi ayọ̀ kún ọkàn."}],"end":30.663},{"key":"4","start":31.613,"lines":[{"start":31.613,"end":33.036,"text":"Mo f'ola ailopin","marked":"Mo f'ọlá àìlópin"},{"start":33.416,"end":34.365,"text":"Fun Olodumare","marked":"Fún Olódùmarè"},{"start":34.745,"end":35.892,"text":"Wo Ologo meta","marked":"Wo Ológo mẹ́ta"},{"start":36.272,"end":37.323,"text":"Sugbon okansoso","marked":"Ṣùgbọ́n ọ̀kánṣoṣo"},{"start":37.703,"end":39.52,"text":"B'O ti ju imo wa lo ni,","marked":"B'ó ti ju ìmọ̀ wa lọ ni"},{"start":39.9,"end":41.506,"text":"A o ma f'igbagbo yin O.","marked":"A ò mà f'ìgbàgbọ́́ yín O."},{"start":41.886,"end":42.52,"text":"Amin.","marked":"Àmín."}],"end":42.52}]}