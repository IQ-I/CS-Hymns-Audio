{"v":1,"coll":"y","num":377,"id":"hymn_377","title":"EMl orun jare wa","duration":57.871,"voices":{"male":{"file":"y-377-male.m4a","bytes":412974,"sha256":"93189e52762d23b66b206f8cc955a5261f9fb81f18c748441df1daef8f9878b9","duration":57.9},"female":{"file":"y-377-female.m4a","bytes":422411,"sha256":"21fc26375744d044a7e03f358226106fdcc68d5da12701530d865af59ec9dcb4","duration":57.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.523,"text":"EMl orun jare wa,","marked":"EMl ọ̀run jàre wá"},{"start":1.903,"end":3.142,"text":"Wa gunwa s'okan wa","marked":"Wá gúnwà s'ọ́kan wa"},{"start":3.522,"end":4.907,"text":"Ko se 'le re ninu wa","marked":"Kò ṣe 'lé rẹ̀ nínú wa"},{"start":5.287,"end":6.435,"text":"Awa elese mbe O o.","marked":"Àwa ẹlẹ́ṣẹ̀ ḿbẹ O o."}],"end":6.435},{"key":"2","start":7.385,"lines":[{"start":7.385,"end":9.323,"text":"Gbat'a wa n'ile aiye","marked":"Gbat'á wá ń'ilẹ̀ aiye"},{"start":9.703,"end":10.902,"text":"A kun f'opo asise","marked":"A kún f'ọ́pọ̀ àṣìṣe"},{"start":11.282,"end":12.708,"text":"T'o nfa danwo wa ba wa","marked":"T'ó ńfà dánwò wa bá wa"},{"start":13.088,"end":14.881,"text":"Oluwa ye, jowo gba wa o.","marked":"Olúwa yè, jọ̀wọ́ gbà wá o."}],"end":14.881},{"key":"3","start":15.831,"lines":[{"start":15.831,"end":17.141,"text":"Nigbati idanwo ba de","marked":"Nígbàtí ìdánwò bá dé"},{"start":17.521,"end":18.798,"text":"T'ara gbogbo le ko wa","marked":"T'ara gbogbo lè kọ́ wa"},{"start":19.178,"end":21.303,"text":"Mura s'esin, ghadura","marked":"Múra s'ẹ̀sìn, ghadura"},{"start":21.683,"end":23.526,"text":"Jesu yio si wa gbe o Ieke.","marked":"Jésù yìó sì wá gbé ọ lékè."}],"end":23.526},{"key":"4","start":24.476,"lines":[{"start":24.476,"end":25.534,"text":"Nihin l'ore le tan o","marked":"Nihin l'ọ̀rẹ́ lè tán o"},{"start":25.914,"end":27.31,"text":"Pelu baba at'iya","marked":"Pẹ̀lú bàbá àt'íyá"},{"start":27.69,"end":29.716,"text":"Mura s'esin, p'Oluwa","marked":"Múra s'ẹ̀sìn, p'Olúwa"},{"start":30.096,"end":32.024,"text":"'Gbayi ni iwo mo Jesu l'ore.","marked":"'Gbàyí ni ìwọ mọ Jésù l'ọ̀rẹ́."}],"end":32.024},{"key":"5","start":32.974,"lines":[{"start":32.974,"end":34.709,"text":"T'osan t'oru I'Ongbo","marked":"T'ọ̀sán t'oru l'Òǹgbò"},{"start":35.089,"end":36.213,"text":"Gbogbo imikanle re","marked":"Gbogbo ìmìkànlé rẹ"},{"start":36.593,"end":37.758,"text":"Ki o to pe O gbo O","marked":"Kí ó tó pé Ó gbọ́ Ọ"},{"start":38.138,"end":39.65,"text":"Bayi ni ileri re si O.","marked":"Báyì ni ìlérí rẹ̀ sí O."}],"end":39.65},{"key":"6","start":40.6,"lines":[{"start":40.6,"end":42.194,"text":"Pe mi loru ati osan","marked":"Pẹ́ mi lóru àti ọ̀sán"},{"start":42.574,"end":43.86,"text":"Pelu emi igbagbo","marked":"Pẹ̀lú ẹ̀mí ìgbàgbọ́́"},{"start":44.24,"end":45.624,"text":"Gb'okan s'oke s'Oluwa","marked":"Gb'okan s'òkè s'Olúwa"},{"start":46.004,"end":47.69,"text":"Jehovah Jire yio silekun.","marked":"Jehovah Jíre yio ṣílẹ̀kùn."}],"end":47.69},{"key":"7","start":48.64,"lines":[{"start":48.64,"end":50.397,"text":"F'lfe han k'o si ma se","marked":"F'lfe hàn k'ó sì má ṣe"},{"start":50.777,"end":52.114,"text":"lse idariji niso","marked":"lse ìdáríjì nìṣó"},{"start":52.494,"end":53.964,"text":"Mu'gbagbo pelu 'se re","marked":"Mu'gbàgbọ́ pẹ̀lú 'ṣe rẹ"},{"start":54.344,"end":56.321,"text":"'Gbayi ni Jesu to gba o la.","marked":"'Gbàyí ni Jésù tó gbà ọ́ là."}],"end":56.321}]}