{"v":1,"coll":"y","num":277,"id":"hymn_277","title":"KRIST' ki 'joba Re de","duration":44.053,"voices":{"male":{"file":"y-277-male.m4a","bytes":302331,"sha256":"11bc7ed3e5afccb933f261159522641f6538ada9132f85cf87fa94a5fe8a2bf0","duration":44.1},"female":{"file":"y-277-female.m4a","bytes":314774,"sha256":"16afb63aad921764a4ac5cd96dbf3a3e848460cac0ba05d8a742ae894b7584b1","duration":44.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.483,"text":"KRIST' ki 'joba Re de","marked":"Krist' kí 'jọba Rẹ dé"},{"start":2.863,"end":3.923,"text":"Ki ase Re bere","marked":"Kí àṣẹ Rẹ bẹ̀rẹ̀"},{"start":4.303,"end":5.51,"text":"F'opa-irin Re fo","marked":"F'ọ̀pá-ìrìn Rẹ̀ fọ́"},{"start":5.89,"end":7.056,"text":"Gbogbo ipa ese.","marked":"Gbogbo ipa ẹ̀ṣẹ̀."}],"end":7.056},{"key":"2","start":8.006,"lines":[{"start":8.006,"end":9.1,"text":"ljoba ife da","marked":"ljọba ìfẹ́ dá"},{"start":9.48,"end":10.567,"text":"Ati t'alafia","marked":"Àti t'àlàáfíà"},{"start":10.947,"end":12.149,"text":"Gba wo ni irira","marked":"Gba wò ní ìríra"},{"start":12.529,"end":13.605,"text":"Yio tan bi t'orun?","marked":"Yíó tán bí t'ọrun?"}],"end":13.605},{"key":"3","start":14.555,"lines":[{"start":14.555,"end":15.796,"text":"Akoko na ha da","marked":"Àkókò ná ha dá"},{"start":16.176,"end":17.368,"text":"T'ote yio pari","marked":"T'ọ̀tẹ̀ yio parí"},{"start":17.748,"end":18.878,"text":"lka at'ireje","marked":"lka àt'ìrẹ́jẹ"},{"start":19.258,"end":20.421,"text":"Pelu ifekufe?","marked":"Pẹ̀lú ìfẹ́kúfẹ́?"}],"end":20.421},{"key":"4","start":21.371,"lines":[{"start":21.371,"end":22.78,"text":"Oluwa jo, dide","marked":"Olúwa jọ, dìde"},{"start":23.16,"end":24.308,"text":"Wa n'nu aghara Re","marked":"Wá ń'nú aghara Rẹ"},{"start":24.688,"end":25.824,"text":"Fi ayo fun awa","marked":"Fi ayọ̀ fún àwa"},{"start":26.204,"end":27.404,"text":"Ti o ns'aferi Re.","marked":"Tí ó ńs'áfẹ́rí Rẹ."}],"end":27.404},{"key":"5","start":28.354,"lines":[{"start":28.354,"end":29.462,"text":"Eda ngan oko Re","marked":"Ẹ̀dá ngan ọkọ Rẹ"},{"start":29.842,"end":31.336,"text":"Koko nje agbo Re","marked":"Kọ́kọ́ ńjẹ́ agbo Rẹ"},{"start":31.716,"end":32.917,"text":"lwa 'tiju pupo","marked":"lwa 'tijú púpọ̀"},{"start":33.297,"end":34.688,"text":"Nfihan pe 'fe tutu.","marked":"Nfihan pé 'fẹ́ tutù."}],"end":34.688},{"key":"6","start":35.638,"lines":[{"start":35.638,"end":36.733,"text":"Okun bole sibe","marked":"Òkun bọ́lẹ̀ síbẹ̀"},{"start":37.113,"end":38.157,"text":"Ni ile keferi","marked":"Ní ilé kèfèrí"},{"start":38.537,"end":39.461,"text":"Dide 'Rawo oro","marked":"Dídé 'Ráwọ́ ọ̀rọ̀"},{"start":39.841,"end":41.516,"text":"Dide, mase wo mo.","marked":"Dídé, másẹ̀ wo mọ́."},{"start":41.896,"end":42.503,"text":"Amin.","marked":"Àmín."}],"end":42.503}]}