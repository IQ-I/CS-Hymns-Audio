{"v":1,"coll":"y","num":269,"id":"hymn_269","title":"Ki se l'aini reti","duration":64.051,"voices":{"male":{"file":"y-269-male.m4a","bytes":454321,"sha256":"fb5bc488e3a9a65cf07fba9b668e0355ba5960815cab30fd5a4ddf875f56133c","duration":64.1},"female":{"file":"y-269-female.m4a","bytes":479256,"sha256":"4fa324b12267a62bbd22bed569e0d35eb8c94e2f29ab26f858f8939dd4f8a6f3","duration":64.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.547,"text":"Ki se l'aini reti","marked":"Kí ṣe l'áìnì retí"},{"start":1.927,"end":2.812,"text":"Ni mo to wa","marked":"Ni mo tó wá"},{"start":3.192,"end":4.654,"text":"Ki se l'aini 'gbagbo","marked":"Kí ṣe l'àìní 'gbàgbọ́"},{"start":5.034,"end":6.12,"text":"Ni mo kunle","marked":"Ni mo kúnlẹ̀"},{"start":6.5,"end":7.701,"text":"Ese ti gori mi","marked":"Ẹsẹ̀ ti gorí mi"},{"start":8.081,"end":9.226,"text":"Eyi sa l'ebe mi","marked":"Èyí sà l'ẹbẹ mi"},{"start":9.606,"end":10.711,"text":"Eyi sa I'ebe mi,","marked":"Èyí sà l'ẹbẹ mi"},{"start":11.091,"end":12.044,"text":"Jesu ti ku.","marked":"Jésù ti kú."}],"end":12.044},{"key":"2","start":12.994,"lines":[{"start":12.994,"end":14.436,"text":"A! ese mi poju","marked":"A! ẹsẹ̀ mi pọ̀jù"},{"start":14.816,"end":15.715,"text":"O pon koko!","marked":"Ó pọ́n koko!"},{"start":16.095,"end":17.329,"text":"Adale, adale","marked":"Àdàlẹ̀, àdàlẹ̀"},{"start":17.709,"end":18.733,"text":"Ni mo nd'ese!","marked":"Ni mo nd'ese!"},{"start":19.113,"end":20.305,"text":"Ese niferan Re","marked":"Ẹsẹ̀ niferan Rẹ̀"},{"start":20.685,"end":21.655,"text":"Ese aigba O gbo,","marked":"Ẹsẹ̀ àìgbà O gbọ́"},{"start":22.035,"end":22.998,"text":"Ese aigba O gbo","marked":"Ẹsẹ̀ àìgbà O gbọ́"},{"start":23.378,"end":24.311,"text":"Ese nlanla!","marked":"Ẹ̀ṣẹ̀ ńláǹlà!"}],"end":24.311},{"key":"3","start":25.261,"lines":[{"start":25.261,"end":26.275,"text":"Oluwa mo jewo","marked":"Olúwa mo jẹ́wọ́"},{"start":26.655,"end":27.52,"text":"Ese nla mi","marked":"Ẹsẹ̀ ńlá mi"},{"start":27.9,"end":28.979,"text":"O mo bi mo ti ri","marked":"Ó mọ bí mo ti rí"},{"start":29.359,"end":30.231,"text":"Bi mo ti wa","marked":"Bí mo ti wá"},{"start":30.611,"end":31.561,"text":"Jo we ese mi nu!","marked":"Jọ wẹ ẹsẹ̀ mi nù!"},{"start":31.941,"end":33.018,"text":"K'okan mi mo Ioni","marked":"K'ọkàn mi mọ́ lọni"},{"start":33.398,"end":34.664,"text":"K'okan mi mo Ioni","marked":"K'ọkàn mi mọ́ lọni"},{"start":35.044,"end":36.004,"text":"Ki ndi mimo.","marked":"Kí ndi mímọ́́."}],"end":36.004},{"key":"4","start":36.954,"lines":[{"start":36.954,"end":39.269,"text":"Olododo ni O, O ndariji","marked":"Olódodo ni Ọ́, Ó ndariji"},{"start":39.649,"end":40.846,"text":"L' ese agbelebu","marked":"L' ẹsẹ̀ àgbélébùú"},{"start":41.226,"end":42.156,"text":"Ni mo wole","marked":"Ni mo wọlé"},{"start":42.536,"end":43.792,"text":"Jek'eje iwenu","marked":"Jẹ́k'ẹ̀jẹ̀ ìwẹnu"},{"start":44.172,"end":46.854,"text":"Eje Odagutan, Eje Odagutan","marked":"Ẹ̀jẹ̀ Odagutan, Ẹ̀jẹ̀ Odagutan"},{"start":47.234,"end":48.293,"text":"We okan mi.","marked":"Wé ọkàn mi."}],"end":48.293},{"key":"5","start":49.243,"lines":[{"start":49.243,"end":50.796,"text":"'Gbana, alafia","marked":"'Gbaná, àlàáfíà"},{"start":51.176,"end":52.205,"text":"Y'o d'okan mi","marked":"Y'ó d'ọkàn mi"},{"start":52.585,"end":54.404,"text":"'Gbana, ngo ba O rin,","marked":"'Gbaná, ngo bá Ò rìn"},{"start":54.784,"end":55.602,"text":"Ore airi","marked":"Ọ̀rẹ́ àìrí"},{"start":55.982,"end":57.18,"text":"Em'o fara ti O","marked":"Em'ó fara tì Ọ́"},{"start":57.56,"end":58.821,"text":"Jo ma to mi s'ona","marked":"Jo ma tó mi s'ọ́nà"},{"start":59.201,"end":60.269,"text":"Jo ma to mi s'ona","marked":"Jo ma tó mi s'ọ́nà"},{"start":60.649,"end":61.541,"text":"Titi aiye.","marked":"Títí aiye."},{"start":61.921,"end":62.501,"text":"Amin.","marked":"Àmín."}],"end":62.501}]}