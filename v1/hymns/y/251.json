{"v":1,"coll":"y","num":251,"id":"hymn_251","title":"BI mo ti kunle, Oluwa","duration":52.036,"voices":{"male":{"file":"y-251-male.m4a","bytes":371144,"sha256":"d318bbaf390541306737e52a8aaa63038286455d99a25a1a0a5260dc491a16da","duration":52.1},"female":{"file":"y-251-female.m4a","bytes":387438,"sha256":"b549c5e273b9b02b5a33e1d455b029138cf8394f1e6a6030980dc2915d8a2625","duration":52.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.984,"text":"BI mo ti kunle, Oluwa","marked":"Bí mo ti kúnlẹ̀, Olúwa"},{"start":2.364,"end":4.015,"text":"Ti mo mbe f'anu lodo Re","marked":"Tí mo ḿbẹ f'ánú lọ́dọ̀ Rẹ"},{"start":4.395,"end":6.012,"text":"Wo t'Ore lese ti nku lo","marked":"Wo t'Ọ̀rẹ́ lẹ́sẹ̀ ti ńkú lọ"},{"start":6.392,"end":8.079,"text":"Si tori Re gb'adura mi.","marked":"Sì torí Rẹ̀ gb'àdúrà mi."}],"end":8.079},{"key":"2","start":9.029,"lines":[{"start":9.029,"end":10.624,"text":"Ma ro 'tiju at' ebi mi","marked":"Má ro 'tiju àt' ẹbí mi"},{"start":11.004,"end":12.438,"text":"At' aimoye abawon mi","marked":"Àt' àìmọye àbàwọ́n mi"},{"start":12.818,"end":14.501,"text":"Ro t'eje ti Jesu ta 'le","marked":"Ro t'ẹ̀jẹ̀ tí Jésù ta 'lẹ̀"},{"start":14.881,"end":16.157,"text":"Fun 'dariji on iye mi.","marked":"Fún 'dáríjì on iye mi."}],"end":16.157},{"key":"3","start":17.107,"lines":[{"start":17.107,"end":18.409,"text":"Ranti bi mo ti je Tire","marked":"Rántí bí mo ti jẹ́ Tírè"},{"start":18.789,"end":20.06,"text":"Ti mo je eda owo Re","marked":"Tí mo jẹ́ ẹ̀dà ọwọ́ Rẹ"},{"start":20.44,"end":21.977,"text":"Ro b'okan mi ti fa s'ese","marked":"Ro b'ọkàn mi ti fà s'ẹsẹ"},{"start":22.357,"end":23.578,"text":"Bi danwo si ti yi mi ka.","marked":"Bí dánwò sì ti yí mi ká."}],"end":23.578},{"key":"4","start":24.528,"lines":[{"start":24.528,"end":25.938,"text":"A! ronu oro mimo Re","marked":"A! ronú ọ̀rọ̀ mímọ́́ Rẹ"},{"start":26.318,"end":27.508,"text":"Ati gbogbo ileri Re","marked":"Àti gbogbo ìlérí Rẹ"},{"start":27.888,"end":29.579,"text":"Pe 'Wo o gbo adua titi","marked":"Pé 'Wò ó gbọ́ àdúa títí"},{"start":29.959,"end":31.498,"text":"Ogo Re ni lati dasi.","marked":"Ògo Rẹ̀ ní láti dàṣì."}],"end":31.498},{"key":"5","start":32.448,"lines":[{"start":32.448,"end":34.718,"text":"A! ma ro ti 'yemeji mi","marked":"A! má ro ti 'yèméjì mi"},{"start":35.098,"end":36.565,"text":"Ati ailo or-ofe Re","marked":"Àti àìlo or-ọ̀fẹ́ Rẹ"},{"start":36.945,"end":38.636,"text":"Ro ti omije Jesu mi","marked":"Ro ti omijé Jésù mi"},{"start":39.016,"end":40.68,"text":"Si fi toju Re di temi","marked":"Sì fi tọ́jú Rẹ̀ di tèmi"}],"end":40.68},{"key":"6","start":41.63,"lines":[{"start":41.63,"end":43.061,"text":"Oju on eti Re ko se","marked":"Ojú ọ̀n etí Rẹ̀ kò ṣe"},{"start":43.441,"end":45.287,"text":"Agbara Re ko le ye lai","marked":"Agbára Rẹ̀ kò lè yẹ̀ láì"},{"start":45.667,"end":47.336,"text":"Jo wo mi; okan mi wuwo","marked":"Jọ wò mí; ọkàn mi wúwo"},{"start":47.716,"end":49.511,"text":"Da mi si, k'O ran mi lowo.","marked":"Dá mi sí, k'Ó ràn mí lọ́wọ́."},{"start":49.891,"end":50.486,"text":"Amin.","marked":"Àmín."}],"end":50.486}]}