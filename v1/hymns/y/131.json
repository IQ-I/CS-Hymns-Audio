{"v":1,"coll":"y","num":131,"id":"hymn_131","title":"A k'orin s'Omo Olorun","duration":31.33,"voices":{"male":{"file":"y-131-male.m4a","bytes":216373,"sha256":"6d83402773103cef04780e6c1ea51c692fa2336f68a73fa2fe63bd3073450bcc","duration":31.4},"female":{"file":"y-131-female.m4a","bytes":224983,"sha256":"023507b7f0b92a739cdd86f03abcb0faeb708ee264ce48871485f432e10124c3","duration":31.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.552,"text":"A k'orin s'Omo Olorun","marked":"A k'orin s'Ọmọ Ọlọ́run"},{"start":1.932,"end":3.074,"text":"Odagutan t'a pa","marked":"Odagutan t'á pa"},{"start":3.454,"end":5.005,"text":"Ti orun ati aye mbo","marked":"Ti ọ̀run àti ayé ḿbọ́"},{"start":5.385,"end":6.608,"text":"T'O ye lati joba.","marked":"T'ó yẹ láti jọba."}],"end":6.608},{"key":"2","start":7.558,"lines":[{"start":7.558,"end":9.09,"text":"Si O l'awon Angeli nke","marked":"Sí Ò l'àwọn Áńgẹ́lì ńkẹ́"},{"start":9.47,"end":10.439,"text":"L'ekun gbogbo orun","marked":"L'èkùn gbogbo ọ̀run"},{"start":10.819,"end":12.358,"text":"Mimo mimo, mim'Olorun","marked":"Mímọ́ mímọ́́, mim'Ọlọ́run"},{"start":12.738,"end":14.343,"text":"T'ogo at'om'ogun.","marked":"T'ògo àt'om'ogun."}],"end":14.343},{"key":"3","start":15.293,"lines":[{"start":15.293,"end":16.439,"text":"ljo Re li aye dapo","marked":"ljọ Re li ayé dàpọ̀"},{"start":16.819,"end":18.038,"text":"Lati ma kepe O","marked":"Láti má kẹ̀pẹ̀ O"},{"start":18.418,"end":19.647,"text":"Didan Olanlan Olorun","marked":"Dídán Ọláǹlàn Ọlọ́run"},{"start":20.027,"end":21.314,"text":"T'O l'agbara gbogbo.","marked":"T'ó l'ágbára gbogbo."}],"end":21.314},{"key":"4","start":22.264,"lines":[{"start":22.264,"end":23.699,"text":"Larin won ni gbogbo wa nfe","marked":"Lárin wọn ni gbogbo wa ńfẹ́"},{"start":24.079,"end":25.215,"text":"Lai yin eje re","marked":"Láì yin ẹ̀jẹ́ rẹ"},{"start":25.595,"end":27.384,"text":"Joba l'aye ati l'orun","marked":"Jọba l'áyé àti l'ọrun"},{"start":27.764,"end":28.832,"text":"Wo Omo Olorun.","marked":"Wo Ọmọ Ọlọ́run."},{"start":29.212,"end":29.78,"text":"Amin.","marked":"Àmín."}],"end":29.78}]}