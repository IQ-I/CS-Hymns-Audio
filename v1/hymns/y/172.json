{"v":1,"coll":"y","num":172,"id":"hymn_172","title":"YIN Olorun, yin lailai","duration":64.174,"voices":{"male":{"file":"y-172-male.m4a","bytes":461213,"sha256":"594e296e80d8d4b5ea6c8849a71bf32fedee9a9cd5900613f380dc9adb22bb88","duration":64.2},"female":{"file":"y-172-female.m4a","bytes":474488,"sha256":"a630830e7a00676cccfdbea153ed84cda9a8433a99fe8bc609496dbef334d16d","duration":64.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.887,"text":"YIN Olorun, yin lailai","marked":"Yín Ọlọ́run, yín láíláí"},{"start":2.267,"end":3.52,"text":"Fun ife ojojumo","marked":"Fún ìfẹ́ ojojumo"},{"start":3.9,"end":5.13,"text":"Orisun ayo gbogbo","marked":"Orísun ayọ̀ gbogbo"},{"start":5.51,"end":6.717,"text":"K'iyin Re gb'enu wa kan.","marked":"K'ìyìn Rẹ̀ gb'ẹnu wa kan."}],"end":6.717},{"key":"2","start":7.667,"lines":[{"start":7.667,"end":11.037,"text":"Fun ire t'oko nmu wa","marked":"Fún ire t'ọkọ ńmu wa"},{"start":11.417,"end":13.055,"text":"Fun onje t'a nmu l'ogba","marked":"Fún ońjẹ t'á ńmu l'ọgbà"},{"start":13.435,"end":14.824,"text":"Fun eso igi pelu","marked":"Fún èso igi pẹ̀lú"},{"start":15.204,"end":16.577,"text":"At'ororo ti a nlo.","marked":"Àt'òròrò tí à ńlò."}],"end":16.577},{"key":"3","start":17.527,"lines":[{"start":17.527,"end":18.986,"text":"Fun gbogb' eran osin wa","marked":"Fún gbogb' ẹran ọ̀sìn wa"},{"start":19.366,"end":20.51,"text":"T'on siri Oka gbogbo","marked":"T'óń ṣírí Ọkà gbogbo"},{"start":20.89,"end":22.078,"text":"Orun ti nse 'ri sile","marked":"Ọ̀run ti ńṣe 'rí sílẹ̀"},{"start":22.458,"end":24.218,"text":"Orun ti nm'oru re wa.","marked":"Ọ̀run ti nm'oru rẹ̀ wà."}],"end":24.218},{"key":"4","start":25.168,"lines":[{"start":25.168,"end":26.558,"text":"Gbogbo nkan t'erun nmu wa,","marked":"Gbogbo nkan t'ẹrun ńmu wa"},{"start":26.938,"end":28.149,"text":"Kakiri gbogbo ile","marked":"Kàkiri gbogbo ilẹ̀"},{"start":28.529,"end":29.828,"text":"At'eso igba ojo","marked":"Àt'èso ìgbà òjò"},{"start":30.208,"end":31.425,"text":"Lat' inu ekun re wa.","marked":"Lát' inú ẹkùn rẹ̀ wà."}],"end":31.425},{"key":"5","start":32.375,"lines":[{"start":32.375,"end":33.909,"text":"'Wo l'elebun gbogbo won,","marked":"'Wò l'ẹlẹ́bùn gbogbo wọn"},{"start":34.289,"end":35.343,"text":"Orisun ibukun wa;","marked":"Orísun ìbùkún wa"},{"start":35.723,"end":37.038,"text":"'Torina okan wa y'o","marked":"'Tòrìnà ọkàn wa y'o"},{"start":37.418,"end":39.081,"text":"F'iyin at'ope fun O.","marked":"F'ìyìn àt'ọpẹ́ fún O."}],"end":39.081},{"key":"6","start":40.031,"lines":[{"start":40.031,"end":41.123,"text":"lji lile iba ja","marked":"lji líle ibà já"},{"start":41.503,"end":42.675,"text":"Ko ba gbogbo oka je","marked":"Kò ba gbogbo ọkà jẹ́"},{"start":43.055,"end":44.348,"text":"K'eso igi wo danu","marked":"K'èso igi wọ̀ dànù"},{"start":44.728,"end":46.377,"text":"Ki akoko re to pe.","marked":"Kí àkókò rẹ tó pé."}],"end":46.377},{"key":"7","start":47.327,"lines":[{"start":47.327,"end":48.532,"text":"Ajara 'ba ma so mo","marked":"Àjàrà 'bá má so mọ́"},{"start":48.912,"end":49.977,"text":"Ki igi gbogbo si gbe","marked":"Kí igi gbogbo sì gbẹ"},{"start":50.357,"end":51.644,"text":"K'eran osin gbogbo ku","marked":"K'ẹran ọ̀sìn gbogbo kú"},{"start":52.024,"end":53.533,"text":"K'eran igbe tan pelu.","marked":"K'ẹran igbe tán pẹ̀lú."}],"end":53.533},{"key":"8","start":54.483,"lines":[{"start":54.483,"end":56.206,"text":"Sibe, lwo l'okan wa,","marked":"Síbẹ̀, lwo l'ọkàn wa"},{"start":56.586,"end":57.981,"text":"Y'o f'iyin at'ope fun","marked":"Y'ó f'ìyìn àt'ọpẹ́ fún"},{"start":58.361,"end":59.633,"text":"Gbat' ibukun gbogbo tan,","marked":"Gbat' ìbùkún gbogbo tán"},{"start":60.013,"end":61.604,"text":"Ao sa fe O fun 'ra Re.","marked":"Aó sá fẹ́ Ó fún 'ra Rẹ̀."},{"start":61.984,"end":62.625,"text":"Amin.","marked":"Àmín."}],"end":62.625}]}