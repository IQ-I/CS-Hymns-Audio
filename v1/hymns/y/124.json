{"v":1,"coll":"y","num":124,"id":"hymn_124","title":"NIWAJU ite, Jehovah","duration":38.144,"voices":{"male":{"file":"y-124-male.m4a","bytes":277358,"sha256":"5eb59f2fc999326896cd4dc729ad32a1757763e1500dca61a7116951f6520cae","duration":38.2},"female":{"file":"y-124-female.m4a","bytes":282937,"sha256":"2db7078b24c6399c8e92f843b31f8ecaa0c092525f5b54331f76ee519d5cb366","duration":38.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.394,"text":"NIWAJU ite, Jehovah,","marked":"Níwájú ìtẹ́, Jehovah"},{"start":2.774,"end":4.725,"text":"E f'ayo sin, oril'ede","marked":"Ẹ f'àyò sìn, oril'ede"},{"start":5.105,"end":7.022,"text":"Mo p'Oluwa, on kanso ni","marked":"Mo p'Olúwa, on kanṣo ni"},{"start":7.402,"end":9.505,"text":"O le da, O si le parun.","marked":"Ó lè dá, Ó sì lè parun."}],"end":9.505},{"key":"2","start":10.455,"lines":[{"start":10.455,"end":12.573,"text":"lpa Re, laisi 'ranwo wa,","marked":"lpa Rẹ̀, láìsí 'rànwọ́ wa"},{"start":12.953,"end":14.585,"text":"L'o f'amo da wa l'enia","marked":"L'ó f'amọ̀ dá wa l'enia"},{"start":14.965,"end":16.801,"text":"Nigbat' a sako b'agutan","marked":"Nígbat' a ṣàkó b'ágùtàn"},{"start":17.181,"end":18.676,"text":"O tun mu wa si agbo Re.","marked":"Ó tún mú wa sí agbo Rẹ̀."}],"end":18.676},{"key":"3","start":19.626,"lines":[{"start":19.626,"end":20.924,"text":"A o f'orin sunmo 'le Re;","marked":"A ò f'orin súnmọ́ 'lé Rẹ"},{"start":21.304,"end":22.772,"text":"Lohun giga l'a o korin","marked":"Lohun gíga l'á ò kọrin"},{"start":23.152,"end":24.422,"text":"Aiye l'oniruru ede","marked":"Aiye l'oniruru èdè"},{"start":24.802,"end":26.57,"text":"Y'o f'iyin kun agbala Re.","marked":"Y'ó f'ìyìn kún àgbàlá Rẹ̀."}],"end":26.57},{"key":"4","start":27.52,"lines":[{"start":27.52,"end":28.959,"text":"Ase Re gboro b'agbaiye","marked":"Àṣé Rẹ gbọ́rọ̀ b'ágbáíyé"},{"start":29.339,"end":31.064,"text":"Ife Re pe b'ayeraye","marked":"Ìfẹ́ Rẹ̀ pé b'ayérayé"},{"start":31.444,"end":33.387,"text":"Oto Re yio duro lailai","marked":"Ọ̀tọ̀ Rẹ̀ yìó dúró láíláí"},{"start":33.767,"end":35.673,"text":"Gbat' odun ki yio yipo mo.","marked":"Gbat' ọdún kí yíó yípo mọ́."},{"start":36.053,"end":36.594,"text":"Amin.","marked":"Àmín."}],"end":36.594}]}