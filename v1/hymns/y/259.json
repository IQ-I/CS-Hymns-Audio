{"v":1,"coll":"y","num":259,"id":"hymn_259","title":"OTOSI elese, e wa","duration":73.957,"voices":{"male":{"file":"y-259-male.m4a","bytes":547601,"sha256":"0e397962ed34bcfba2d3efbbd93537c122b87654e7508d56cd1f9870b752754f","duration":74.0},"female":{"file":"y-259-female.m4a","bytes":564612,"sha256":"5ea77302a281e88e8602e1580df29f5d6121621eae9805ba02f13f87a357084e","duration":74.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.225,"text":"OTOSI elese, e wa","marked":"Òtòṣì ẹlẹ́sẹ̀, ẹ wá"},{"start":2.605,"end":3.843,"text":"Wa ni wakati anu","marked":"Wà ní wákàtí ànú"},{"start":4.223,"end":6.339,"text":"Jesu setan lati gba nyin","marked":"Jésù ṣetán láti gbá nyin"},{"start":6.719,"end":8.15,"text":"O kun f'anu at'ife","marked":"Ó kún f'ánú àt'ife"},{"start":8.53,"end":11.983,"text":"O si le se, O mura tan, ma foiya.","marked":"Ó sì lè ṣe, Ó múra tán, má fòiya."}],"end":11.983},{"key":"2","start":12.933,"lines":[{"start":12.933,"end":15.404,"text":"Enyin alaini, e wa gba","marked":"Enyin aláìní, ẹ wá gbà"},{"start":15.784,"end":17.212,"text":"Ogo Olorun l'ofe","marked":"Ògo Ọlọ́run l'ọ̀fẹ́"},{"start":17.592,"end":19.413,"text":"'Gbagbo toto, 'ronu toto","marked":"'Gbàgbọ́ tótó, 'ronú toto"},{"start":19.793,"end":21.442,"text":"Or'ofe ti o nfa wa","marked":"Or'ọ̀fẹ́ tí ò ńfà wà"},{"start":21.822,"end":24.242,"text":"Wa 'do Jesu, alaini owo","marked":"Wá 'dọ̀ Jésù, aláìní owó"},{"start":24.622,"end":25.504,"text":"sa wa ra.","marked":"sá wá rà."}],"end":25.504},{"key":"3","start":26.454,"lines":[{"start":26.454,"end":28.099,"text":"Ma je k'okan nyin da nyin ro","marked":"Má jẹ k'ọkàn nyín dà nyín rò"},{"start":28.479,"end":30.137,"text":"Mase ro ti aiye nyin","marked":"Mase ro ti aiye nyin"},{"start":30.517,"end":32.112,"text":"Gbogbo yiye t'o mbere ni","marked":"Gbogbo yíyẹ t'ó mbere ni"},{"start":32.492,"end":33.853,"text":"Ki e sa mo aini nyin","marked":"Kí ẹ sá mọ́ àìní nyín"},{"start":34.233,"end":36.312,"text":"'Yi l'o fun nyin; tansan","marked":"'Yí l'ó fún nyin; tánsan"},{"start":36.692,"end":37.702,"text":"Emi l'okan.","marked":"Èmi l'ókan."}],"end":37.702},{"key":"4","start":38.652,"lines":[{"start":38.652,"end":40.919,"text":"Enyin t'eru npa, t'are mu,","marked":"Enyin t'ẹrù ńpa, t'árẹ̀ mú"},{"start":41.299,"end":42.982,"text":"T'e sonu t'e si segbe","marked":"T'é sọnù t'é sì ṣègbè"},{"start":43.362,"end":45.104,"text":"Bi e duro tit' eo fi san","marked":"Bí ẹ dúró tit' èò fi sàn"},{"start":45.484,"end":46.634,"text":"E ki yio wa rara","marked":"Ẹ kí yio wà rárá"},{"start":47.014,"end":49.879,"text":"F'elese ni, On ko wa f'olododo.","marked":"F'ẹlẹ́sẹ̀ ni, On kò wá f'olódodo."}],"end":49.879},{"key":"5","start":50.829,"lines":[{"start":50.829,"end":52.323,"text":"Olorun goke l'awo wa","marked":"Ọlọ́run gòkè l'áwọ̀ wa"},{"start":52.703,"end":53.962,"text":"O nfi eje Re bebe","marked":"Ó ńfi ẹ̀jẹ̀ Rẹ̀ bẹbẹ"},{"start":54.342,"end":55.784,"text":"Gbe ara le patapata","marked":"Gbé ara lé pátápátá"},{"start":56.164,"end":57.287,"text":"Ma gbekele ohun mi","marked":"Má gbẹ́kẹ̀lé ohùn mi"},{"start":57.667,"end":59.718,"text":"Jesu nikan l'o le elese l'ore.","marked":"Jésù nìkan l'ó lé ẹlẹ́sẹ̀ l'ọ̀rẹ́."}],"end":59.718},{"key":"6","start":60.668,"lines":[{"start":60.668,"end":62.299,"text":"Angeli at' awon mimo","marked":"Áńgẹ́lì àt' àwọn mímọ́́"},{"start":62.679,"end":64.158,"text":"Nkorin 'yin Od'agutan","marked":"Nkọrin 'yín Od'agutan"},{"start":64.538,"end":65.754,"text":"Gbohungbohun Oruko Re","marked":"Gbọ̀hùngbohùn Orúkọ Rẹ"},{"start":66.134,"end":67.977,"text":"Si gba gbogbo orun kan","marked":"Sì gba gbogbo ọrùn kan"},{"start":68.357,"end":71.362,"text":"Halleluya! elese le gberin na.","marked":"Hallelúyà! ẹlẹ́sẹ̀ lè gbẹ̀rín ná."},{"start":71.742,"end":72.407,"text":"Amin.","marked":"Àmín."}],"end":72.407}]}