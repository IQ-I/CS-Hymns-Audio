{"v":1,"coll":"y","num":148,"id":"hymn_148","title":"IMOLE iyanu ntan","duration":60.13,"voices":{"male":{"file":"y-148-male.m4a","bytes":439688,"sha256":"6371274f82a82f7f5adee9260ed550402efab22bd98c7068c4a8a34ff8883fe1","duration":60.2},"female":{"file":"y-148-female.m4a","bytes":451884,"sha256":"7b492393f4474d2423a8408d080c45661fff738662e3ecca21de219f84208bf2","duration":60.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.516,"text":"IMOLE iyanu ntan","marked":"Ìmọ́lẹ̀̀ ìyanu ńtàn"},{"start":1.896,"end":3.325,"text":"Gba Kristien ba nkorin","marked":"Gba Kristien bá ńkọrin"},{"start":3.705,"end":4.862,"text":"Oluwa ni ngbe ni ro","marked":"Olúwa ní ńgbé ni rò"},{"start":5.242,"end":6.345,"text":"lwosan n'n'apa Re","marked":"lwòsàn n'ń'apa Rẹ"},{"start":6.725,"end":8.297,"text":"'Gba olutunu jin'na","marked":"'Gba olùtùnú jin'ná"},{"start":8.677,"end":10.152,"text":"O nfun okan ni'simi","marked":"Ó nfun ọkàn ní'símí"},{"start":10.532,"end":11.882,"text":"lmole otun y'o la","marked":"lmọ́lẹ̀ ọ̀tún y'ó lá"},{"start":12.262,"end":13.584,"text":"Nigba t'ojo si da.","marked":"Nígbà t'ọjọ́ sì dà."}],"end":13.584},{"key":"2","start":14.534,"lines":[{"start":14.534,"end":16.106,"text":"Nigba t'ero mimo nso","marked":"Nígbà t'èrò mímọ́́ ǹṣó"},{"start":16.486,"end":17.989,"text":"L'ayo la'wa nlepa","marked":"L'àyò là'wá ńlépa"},{"start":18.369,"end":19.42,"text":"lgbala Olorun wa","marked":"lgbala Ọlọ́run wa"},{"start":19.8,"end":21.166,"text":"T'a si nri gba l'otun","marked":"T'á sì ńrí gbà l'ọ̀tún"},{"start":21.546,"end":22.903,"text":"O ngba wa n'nu 'banuje","marked":"Ó ńgbà wá ń'nú 'banújẹ́"},{"start":23.283,"end":24.811,"text":"Awa le f'ayo wipe","marked":"Àwa lè f'àyò wípé"},{"start":25.191,"end":26.471,"text":"Je ki ola aimo de","marked":"Jẹ́ kí ọlá àìmọ́ dé"},{"start":26.851,"end":28.047,"text":"Ohun t'o wun k'o je.","marked":"Ohun t'ó wun k'ó jẹ́."}],"end":28.047},{"key":"3","start":28.997,"lines":[{"start":28.997,"end":30.173,"text":"Ohunkohun t'o le de","marked":"Ohunkóhun t'ó lè dé"},{"start":30.553,"end":32.044,"text":"Jesu y'o gba wa la","marked":"Jésù y'ó gbà wá là"},{"start":32.424,"end":34.316,"text":"On t'o wo lili l'aso","marked":"Òǹ t'ó wọ́ lílì l'áṣọ"},{"start":34.696,"end":36.072,"text":"Y'o fi aso wo wa","marked":"Y'ó fi aṣọ wọ̀ wá"},{"start":36.452,"end":37.785,"text":"L'abe orun t'o teju","marked":"L'abẹ́ ọrùn t'ó tẹ́jú"},{"start":38.165,"end":39.442,"text":"Ghogbo eda l'o nbo","marked":"Ghogbo ẹ̀dá l'ó ńbọ̀"},{"start":39.822,"end":41.576,"text":"On t'o nbo eiye orun","marked":"Òǹ t'ó ńbò ẹíyẹ ọ̀run"},{"start":41.956,"end":43.069,"text":"Y'o bo aw'omo Re.","marked":"Y'ó bo aw'ọmọ Rẹ̀."}],"end":43.069},{"key":"4","start":44.019,"lines":[{"start":44.019,"end":45.506,"text":"B'ajara tabi opoto","marked":"B'àjàrà tàbí ọ̀pọ̀tọ́"},{"start":45.886,"end":47.183,"text":"Ko lati m'eso wa","marked":"Kò láti ḿ'èso wa"},{"start":47.563,"end":48.774,"text":"Bi gbogbo eweko gbe","marked":"Bí gbogbo ewéko gbé"},{"start":49.154,"end":50.967,"text":"T' agbo agutan s'egbe","marked":"T' agbo àgùtàn s'ẹ̀gbẹ́"},{"start":51.347,"end":52.531,"text":"Olorun wa mbe sibe","marked":"Ọlọ́run wá ḿbẹ síbẹ̀"},{"start":52.911,"end":54.879,"text":"Iyin Re y'o kun enu mi","marked":"Ìyìn Rẹ̀ y'ó kún ẹnu mi"},{"start":55.259,"end":56.797,"text":"Bi mo gbekele E titi","marked":"Bí mo gbẹ́kẹ̀lé E títí"},{"start":57.177,"end":58.58,"text":"Ayo y'o je t'emi.","marked":"Ayò y'ó jẹ́ t'èmi."}],"end":58.58}]}