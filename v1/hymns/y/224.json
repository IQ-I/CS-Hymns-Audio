{"v":1,"coll":"y","num":224,"id":"hymn_224","title":"ODUN miran tun ti de","duration":43.426,"voices":{"male":{"file":"y-224-male.m4a","bytes":318006,"sha256":"94d02d5442d7a5c9ca2219f8f92c52b82348a3fc65cc8310b4b7c6335ef1d9d6","duration":43.5},"female":{"file":"y-224-female.m4a","bytes":319481,"sha256":"7e5b39213ce7234d4363140dd54563fde2c348eadfe2690aae2f1d42d5d9098e","duration":43.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.627,"text":"ODUN miran tun ti de","marked":"Ọdún miran tún ti dé"},{"start":2.007,"end":3.297,"text":"Baba mi je k'o je","marked":"Bàbá mi jẹ́ k'ó jẹ́"},{"start":3.677,"end":4.744,"text":"Odun miran pelu Re","marked":"Ọdún miràn pẹ̀lú Rẹ"},{"start":5.124,"end":6.729,"text":"N'nu 'se tab' isinmi","marked":"N'nu 'se tab' ìsinmi"},{"start":7.109,"end":8.363,"text":"Odun itesiwaju","marked":"Ọdún ìtẹ̀síwájú"},{"start":8.743,"end":9.975,"text":"Odun miran fun iyin","marked":"Ọdún miràn fún ìyìn"},{"start":10.355,"end":11.57,"text":"Odun miran lati mo","marked":"Ọdún míràn láti mọ̀"},{"start":11.95,"end":13.279,"text":"Wiwa Re n'gbogbojo.","marked":"Wíwá Rẹ̀ n'gbogbojo."}],"end":13.279},{"key":"2","start":14.229,"lines":[{"start":14.229,"end":15.472,"text":"Odun miran fun aanu","marked":"Ọdún miràn fún àánú"},{"start":15.852,"end":17.635,"text":"F'ooto at'oor'ofe","marked":"F'òótọ́ at'oòr'ọ̀fẹ́"},{"start":18.015,"end":19.236,"text":"Odun miran fun ayo","marked":"Ọdún miran fún ayọ̀"},{"start":19.616,"end":20.666,"text":"Fun ogo oju Re","marked":"Fún ògo ojú Rẹ"},{"start":21.046,"end":22.512,"text":"Odun mii' lati sinmi","marked":"Ọdún míì' láti sinmi"},{"start":22.892,"end":24.086,"text":"L'ookan aya 'fe Re","marked":"L'ọ̀ọ́kán àyà 'fẹ́ Rẹ"},{"start":24.466,"end":25.693,"text":"Odun ti n o gbekele E","marked":"Ọdún tí n ò gbẹ́kẹ̀lé E"},{"start":26.073,"end":27.267,"text":"Pelu sinni didun.","marked":"Pẹ̀lú sinni dídùn."}],"end":27.267},{"key":"3","start":28.217,"lines":[{"start":28.217,"end":29.669,"text":"Odun miran fun isin","marked":"Ọdún miràn fún ìsìn"},{"start":30.049,"end":31.199,"text":"Fun 'jen' ife Re","marked":"Fún 'jẹ́n' ìfẹ́ Rẹ"},{"start":31.579,"end":32.886,"text":"Odun miran fun eko","marked":"Ọdún míràn fún ẹ̀kọ́"},{"start":33.266,"end":34.474,"text":"Fun 'se mimo‐l'oke","marked":"Fún 'ṣe mímọ́-l'òkè"},{"start":34.854,"end":36.163,"text":"Odun miran tun ti de","marked":"Ọdún miran tún ti dé"},{"start":36.543,"end":37.683,"text":"Baba mi je k'oje","marked":"Bàbá mi jẹ́ k'oje"},{"start":38.063,"end":39.146,"text":"Odun miran pelu Re","marked":"Ọdún miràn pẹ̀lú Rẹ"},{"start":39.526,"end":40.898,"text":"L'aye tabi l'orun.","marked":"L'áyé tàbí l'ọrun."},{"start":41.278,"end":41.876,"text":"Amin.","marked":"Àmín."}],"end":41.876}]}