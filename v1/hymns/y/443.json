{"v":1,"coll":"y","num":443,"id":"hymn_443","title":"JESU l'Olusagutan mi","duration":49.683,"voices":{"male":{"file":"y-443-male.m4a","bytes":366616,"sha256":"75e847e786993a301b271efbab1b808c7b674ee81099d235ec30fed3c2cfaeec","duration":49.7},"female":{"file":"y-443-female.m4a","bytes":372982,"sha256":"16cd03a13d93fd0fcb3f4a87af82dfe00a7196f165e9daca0eeb235c7de9aba7","duration":49.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.936,"text":"JESU l'Olusagutan mi","marked":"Jésù l'Olùṣàgùtàn mi"},{"start":2.316,"end":3.792,"text":"Nje k'iberu lo jina","marked":"Ǹjẹ́ k'ìbẹ̀rù ló jiná"},{"start":4.172,"end":5.627,"text":"Lowo kiniun at'ekun","marked":"Lọ́wọ́ kiníùn àt'ẹkùn"},{"start":6.007,"end":7.063,"text":"Lowo eranko ibi","marked":"Lọ́wọ́ ẹranko ibi"},{"start":7.443,"end":9.007,"text":"Yio so agutan Tire","marked":"Yíó sọ àgùtàn Tírè"},{"start":9.387,"end":10.889,"text":"Jesu y'o pa Tire mo.","marked":"Jésù y'ó pa Tírè mọ́."}],"end":10.889},{"key":"2","start":11.839,"lines":[{"start":11.839,"end":13.319,"text":"Nigb'ota fe lati mu mi","marked":"Nígb'ọ̀tá fẹ́ láti mú mi"},{"start":13.699,"end":15.463,"text":"On ni: Agutan mi mi","marked":"O̩n ní: Àgùtàn mi mì"},{"start":15.843,"end":17.794,"text":"O si ku, lati gba wa la","marked":"Ó sì kú, láti gbà wá là"},{"start":18.174,"end":19.641,"text":"Jesu ife kil'eyi?","marked":"Jésù ìfẹ́ kil'eyi?"},{"start":20.021,"end":21.25,"text":"lsegun ni ona Tire","marked":"lṣẹ́gun ní ọ̀nà Tírè"},{"start":21.63,"end":23.38,"text":"Ko s'ohun t'o le se e.","marked":"Kò s'óhun t'ó lè ṣe é."}],"end":23.38},{"key":"3","start":24.33,"lines":[{"start":24.33,"end":25.969,"text":"Lona iye I'o ndari mi","marked":"Lọ́nà iye l'ó ndari mi"},{"start":26.349,"end":28.401,"text":"Let' isan to nsan pele","marked":"Let' iṣan tó ńsan pẹ̀lẹ́"},{"start":28.781,"end":30.201,"text":"Ninu oko tutu yoyo","marked":"Nínú ọkọ̀ tutù yọ̀yọ̀"},{"start":30.581,"end":32.088,"text":"Nib'ewe oro ki hu","marked":"Níb'ewé ọrọ̀ kí hù"},{"start":32.468,"end":34.078,"text":"Nibe ni mo gbohun Jesu","marked":"Níbẹ̀ ni mo gbóhùn Jésù"},{"start":34.458,"end":35.896,"text":"Nibe l'o m'okan mi yo.","marked":"Níbẹ̀ l'ó m'ọkàn mi yọ̀."}],"end":35.896},{"key":"4","start":36.846,"lines":[{"start":36.846,"end":38.503,"text":"Gba mo ba nlo s'isa oku","marked":"Gba mo bá ńlọ s'isa òkú"},{"start":38.883,"end":40.416,"text":"B'eru tile wa l'ona","marked":"B'ẹrú tilẹ̀ wà l'ọ́nà"},{"start":40.796,"end":41.964,"text":"Emi ki o berukeru","marked":"Èmi kí ó bẹ̀rùkẹ̀rù"},{"start":42.344,"end":43.495,"text":"Tor'Olusagutan wa","marked":"Tor'Olùṣàgùtàn wa"},{"start":43.875,"end":45.545,"text":"Gba mo r'ogo at'opa Re","marked":"Gbá mọ r'ògò àt'ọ̀pá Rẹ"},{"start":45.925,"end":47.248,"text":"Mo mo p'agutan Re yo.","marked":"Mo mọ p'ágùtàn Rẹ̀ yọ."},{"start":47.628,"end":48.134,"text":"Amin.","marked":"Àmín."}],"end":48.134}]}