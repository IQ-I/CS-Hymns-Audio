{"v":1,"coll":"y","num":229,"id":"hymn_229","title":"OLOWA alafia wa","duration":49.091,"voices":{"male":{"file":"y-229-male.m4a","bytes":359169,"sha256":"04147bdf3666c89879bd30b90116d1709d1111ff25507f84d19179d6c35ff82e","duration":49.1},"female":{"file":"y-229-female.m4a","bytes":371292,"sha256":"1581e4cf3832886bd933f79f0ba9debbf6305a52026fab7dd89e63093677c028","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.859,"text":"OLOWA alafia wa,","marked":"Olówá àlàáfíà wa"},{"start":2.239,"end":3.781,"text":"L'opase t'odun yipo","marked":"L'opase t'ọdún yípo"},{"start":4.161,"end":5.494,"text":"Awa omo Re wa dupe","marked":"Àwa ọmọ Rẹ wá dúpẹ́"},{"start":5.874,"end":7.222,"text":"F'odun titun t'a bere","marked":"F'ọdún titun t'á bẹ̀rẹ̀"},{"start":7.602,"end":8.995,"text":"Yin Oluwa! Yin Oluwn","marked":"Yín Olúwa! Yin Oluwn"},{"start":9.375,"end":11.043,"text":"Oba nla t'O da wa si.","marked":"Ọba ńlá t'Ó dá wa sí."}],"end":11.043},{"key":"2","start":11.993,"lines":[{"start":11.993,"end":13.503,"text":"A dupe fun ipamo wa","marked":"A dúpẹ́ fún ìpamọ́ wa"},{"start":13.883,"end":15.332,"text":"Ni odun ti o koja","marked":"Ní ọdún tí ó kọjá"},{"start":15.712,"end":16.983,"text":"A mbebe iranlowo Re,","marked":"A mbẹ̀bẹ̀ ìrànlọ́wọ́ Rẹ̀"},{"start":17.363,"end":18.698,"text":"Fun gbogbo wa lodun yi","marked":"Fún gbogbo wa lọ́dún yí"},{"start":19.078,"end":20.83,"text":"Jek'ljo wa, jek'ljo wa","marked":"Jek'ljo wa, jek'ljo wa"},{"start":21.21,"end":22.683,"text":"Ma dagba ninu Kristi.","marked":"Má dàgbà nínú Kristi."}],"end":22.683},{"key":"3","start":23.633,"lines":[{"start":23.633,"end":25.274,"text":"K'agba k'o mura lati sin","marked":"K'ágbá k'ó múra láti sìn"},{"start":25.654,"end":27.431,"text":"Lokan kan ni odun yi","marked":"Lọ́kàn kan ní ọdún yí"},{"start":27.811,"end":29.558,"text":"K'awon omode k'o mura","marked":"K'àwọn ọmọdé k'ó múra"},{"start":29.938,"end":31.401,"text":"Lati saferi Jesu","marked":"Láti ṣàfẹ́rí Jésù"},{"start":31.781,"end":33.444,"text":"K'alafia, k'alafia","marked":"K'àlàáfíà, k'àlàáfíà"},{"start":33.824,"end":35.091,"text":"K'o se ade odun yi.","marked":"K'ó ṣe adé ọdún yí."}],"end":35.091},{"key":"4","start":36.041,"lines":[{"start":36.041,"end":37.784,"text":"K'Emi Mimo lat' oke wa","marked":"K'Ẹ̀mí Mímọ́́ lát' òkè wá"},{"start":38.164,"end":39.676,"text":"Ba le wa ni odun yi","marked":"Bá lè wà ní ọdún yí"},{"start":40.056,"end":41.466,"text":"Ki Alufa at'Oluko","marked":"Kí Àlùfá àt'Olùkọ́"},{"start":41.846,"end":42.89,"text":"Pelu gbogbo Ijo wa","marked":"Pẹ̀lú gbogbo Ìjọ wa"},{"start":43.27,"end":44.692,"text":"Mura giri, Mura giri","marked":"Múra gírí, Múra gírí"},{"start":45.072,"end":46.611,"text":"Lati Josin f'Oluwa.","marked":"Láti Jọ́sìn f'Olúwa."},{"start":46.991,"end":47.541,"text":"Amin.","marked":"Àmín."}],"end":47.541}]}