{"v":1,"coll":"y","num":335,"id":"hymn_335","title":"A KAN Krist'lrekoja mo agbelebu","duration":92.601,"voices":{"male":{"file":"y-335-male.m4a","bytes":702213,"sha256":"cd903ea6bbbb84d95140b914b9a44c843e04d1028b6287def37628bf5cd7d3aa","duration":92.7},"female":{"file":"y-335-female.m4a","bytes":720889,"sha256":"af1759faf6ef84e0b549e1e9d8a9cebf25a1e2de7108fae146becb0d0d628cf2","duration":92.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.493,"text":"A KAN Krist'lrekoja mo agbelebu","marked":"A Kan Krist'lrékọjá mọ́ àgbélébùú"},{"start":2.873,"end":5.8,"text":"O kigbe oro wipe, “igbala pari\"","marked":"Ó kígbe ọ̀rọ̀ wípé, ìgbàlà parí"},{"start":6.18,"end":8.347,"text":"O jowo emi re lowo fun irapada Eda","marked":"Ó jọ̀wọ́ ẹ̀mí rẹ̀ lọ́wọ́ fún ìràpadà Ẹ̀dá"},{"start":8.727,"end":11.628,"text":"O sun ninu iboji, o di asegun.","marked":"Ó sùn nínú ibojì, ó di aṣẹ́gun."},{"start":12.008,"end":13.571,"text":"Egbe:  O jinde, O jinde","marked":"Ó jíǹde, Ó jíǹde"},{"start":13.951,"end":15.497,"text":"Jesu, Oba lye","marked":"Jésù, Ọba lyé"},{"start":15.877,"end":17.328,"text":"O jinde, O jinde","marked":"Ó jíǹde, Ó jíǹde"},{"start":17.708,"end":18.8,"text":"O jinde loni.","marked":"Ó jíǹde lónì."}],"end":18.8},{"key":"CHORUS","start":19.75,"lines":[{"start":19.75,"end":21.149,"text":"O jinde, O jinde","marked":"Ó jíǹde, Ó jíǹde"},{"start":21.529,"end":22.78,"text":"Jesu, Oba lye","marked":"Jésù, Ọba lyé"},{"start":23.16,"end":24.797,"text":"O jinde, O jinde","marked":"Ó jíǹde, Ó jíǹde"},{"start":25.177,"end":26.332,"text":"O jinde loni.","marked":"Ó jíǹde lónì."}],"end":26.332},{"key":"2","start":27.282,"lines":[{"start":27.282,"end":30.52,"text":"Jesu Oluwa Iye, o wa to 'ku wo","marked":"Jésù Olúwa Ìyè, ó wá tọ́ 'kú wò"},{"start":30.9,"end":33.884,"text":"Iku ati ipo oku ko tun n'ipa mo","marked":"Ikú àti ipò òkú kò tún ń'ípa mọ́"},{"start":34.264,"end":37.596,"text":"E f'ogo fun Olorun, fun 'segun lor'iku","marked":"Ẹ f'ògo fún Ọlọ́run, fún 'ṣẹ́gun lór'ikú"},{"start":37.976,"end":40.635,"text":"O so oro iku d'asan f'awa elese.","marked":"Ó sọ ọ̀rọ̀ ikú d'asán f'áwá ẹlẹ́sẹ̀."},{"start":41.015,"end":42.482,"text":"Egbe:  O jinde, O jinde ...","marked":"Ó jíǹde, Ó jíǹde"}],"end":42.482},{"key":"3","start":43.432,"lines":[{"start":43.432,"end":45.414,"text":"Oba Olupilese Iye ti jinde","marked":"Ọba Olùpilẹ̀ṣẹ̀ Ìyè ti jíǹde"},{"start":45.794,"end":47.572,"text":"O di akobi ninu awon ti o sun","marked":"Ó di àkọ́bí nínú àwọn tí ó sùn"},{"start":47.952,"end":49.738,"text":"Wo Alfa at'Omega","marked":"Wo Alfa at'Omega"},{"start":50.118,"end":51.524,"text":"Ipilese at'opin","marked":"Ìpilẹ̀ṣẹ̀ àt'òpin"},{"start":51.904,"end":55.251,"text":"Wo ni isika iku at'ipo oku.","marked":"Wo ni ìsíkà ikú àt'ipò òkú."},{"start":55.631,"end":57.303,"text":"Egbe:  O jinde, O jinde ...","marked":"Ó jíǹde, Ó jíǹde"}],"end":57.303},{"key":"4","start":58.253,"lines":[{"start":58.253,"end":60.719,"text":"Jesu nip' ajinde Re so emi wa ji","marked":"Jésù níp' àjíǹde Rẹ̀ sọ ẹ̀mí wa jí"},{"start":61.099,"end":63.103,"text":"Ji wa n'nu iku ese s'iye ododo","marked":"Jí wá ń'nú ikú ẹsẹ̀ s'iye òdodo"},{"start":63.483,"end":65.264,"text":"K'ajinde ara le je tiwa","marked":"K'àjíǹde ara lè jẹ́ tiwa"},{"start":65.644,"end":66.85,"text":"K'ife on Alafia","marked":"K'ífẹ̀ ọ́n Àlàáfíà"},{"start":67.23,"end":69.331,"text":"Ma gbile ninu aiye gege bi t'orun.","marked":"Má gbilẹ̀ nínú aiye gẹ́gẹ́ bí t'ọrun."},{"start":69.711,"end":71.188,"text":"Egbe:  O jinde, O jinde ...","marked":"Ó jíǹde, Ó jíǹde"}],"end":71.188},{"key":"5","start":72.138,"lines":[{"start":72.138,"end":74.205,"text":"Jesu Oluwa Iye se 'lekun iku","marked":"Jésù Olúwa Ìyè ṣe 'lẹ́kùn ikú"},{"start":74.585,"end":76.944,"text":"F'om'egbe Serafu ati Kerubu","marked":"F'om'ẹgbẹ́ Séráfù àti Kérúbù"},{"start":77.324,"end":80.041,"text":"Iye ni tiwa titi l'aiye yi ati l'orun","marked":"Iye ni tiwa títí l'áiye yi àti l'orun"},{"start":80.421,"end":82.817,"text":"Ao si joba pelu re lai ati lailai.","marked":"Aó sì jọba pẹ̀lú rẹ̀ láì àti láíláí."},{"start":83.197,"end":84.646,"text":"Egbe:  O jinde, O jinde","marked":"Ó jíǹde, Ó jíǹde"},{"start":85.026,"end":86.658,"text":"Jesu, Oba lye","marked":"Jésù, Ọba lyé"},{"start":87.038,"end":88.679,"text":"O jinde, O jinde","marked":"Ó jíǹde, Ó jíǹde"},{"start":89.059,"end":90.131,"text":"O jinde loni.","marked":"Ó jíǹde lónì."},{"start":90.511,"end":91.051,"text":"Amin.","marked":"Àmín."}],"end":91.051}]}