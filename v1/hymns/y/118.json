{"v":1,"coll":"y","num":118,"id":"hymn_118","title":"EWE ti Oba orun","duration":74.653,"voices":{"male":{"file":"y-118-male.m4a","bytes":527089,"sha256":"ff0cb14a00a29d94fdd2cfb246fd36b3f001f1c04f02346238b36129a5561b3c","duration":74.7},"female":{"file":"y-118-female.m4a","bytes":553465,"sha256":"f544a95d1579ee0f47c5e703433239f976866265b61e4d265dd99e7c46127a5d","duration":74.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.501,"text":"EWE ti Oba orun,","marked":"Èwe ti Ọba ọ̀run"},{"start":1.881,"end":3.568,"text":"Korin didun be ti nlo","marked":"Kọrin dídùn bẹ́ ti ńlò"},{"start":3.948,"end":5.026,"text":"Korin 'yin Olugbala","marked":"Kọrin 'yin Olùgbàlà"},{"start":5.406,"end":6.716,"text":"Ologo 'nu ise Re.","marked":"Ológo 'nu iṣẹ́ Rẹ."}],"end":6.716},{"key":"CHORUS","start":7.666,"lines":[{"start":7.666,"end":9.119,"text":"A nlo 'le sodo Olorun","marked":"A ńlò 'lè sọ́dọ̀ Ọlọ́run"},{"start":9.499,"end":10.598,"text":"Lona t'awon Baba rin","marked":"Lọ́nà t'áwọn Bàbá rìn"},{"start":10.978,"end":13.125,"text":"Nwon si nyo: nisisiyi","marked":"Nwọ̀n sì nyo: nísìsíyí"},{"start":13.505,"end":14.757,"text":"Ayo won l'awa o ri.","marked":"Ayò wọn l'áwá ò rí."}],"end":14.757},{"key":"2","start":15.707,"lines":[{"start":15.707,"end":17.235,"text":"A nlo sodo Olorun","marked":"A ńlọ sọ́dọ̀ Ọlọ́run"},{"start":17.615,"end":18.86,"text":"Lona t'awon Baba rin","marked":"Lọ́nà t'áwọn Bàbá rìn"},{"start":19.24,"end":21.386,"text":"Nwon si nyo: nisisiyi,","marked":"Nwọ̀n sì nyo: nísìsíyí"},{"start":21.766,"end":23.124,"text":"Ayo won l'awa o ri.","marked":"Ayò wọn l'áwá ò rí."},{"start":23.504,"end":24.449,"text":"Egbe:  A nlo 'le sodo...","marked":"À ńlò 'lè sódò"}],"end":24.449},{"key":"3","start":25.399,"lines":[{"start":25.399,"end":27.123,"text":"Korin agbo kekere","marked":"Kọrin agbo kékeré"},{"start":27.503,"end":28.802,"text":"E o simi n'ite Re,","marked":"Ẹ ò simi n'ìtẹ́ Rẹ"},{"start":29.182,"end":30.705,"text":"'Bit'a pese 'joko nyin","marked":"'Bit'a pèsè 'jokò nyin"},{"start":31.085,"end":32.563,"text":"Ibe si n'ijoba nyin.","marked":"Ibẹ̀ sì ń'ìjọba nyin."},{"start":32.943,"end":33.887,"text":"Egbe:  A nlo 'le sodo...","marked":"À ńlò 'lè sódò"}],"end":33.887},{"key":"4","start":34.837,"lines":[{"start":34.837,"end":36.437,"text":"W'Oke, omo imole","marked":"W'Òkè, ọmọ ìmọ́lẹ̀̀"},{"start":36.817,"end":37.894,"text":"Ilu Sion wa lokan","marked":"Ìlú Sion wà lọ́kàn"},{"start":38.274,"end":39.729,"text":"Ibe n'ile wa titi;","marked":"Ibẹ̀ ń'ilẹ̀ wà títí"},{"start":40.109,"end":41.531,"text":"Ibe l'ao r'Oluwa.","marked":"Ibẹ̀ l'áò r'Olúwa."},{"start":41.911,"end":42.837,"text":"Egbe:  A nlo 'le sodo...","marked":"À ńlò 'lè sódò"}],"end":42.837},{"key":"5","start":43.787,"lines":[{"start":43.787,"end":45.37,"text":"Kerubu, tesiwaju","marked":"Kérúbù, tẹ̀síwájú"},{"start":45.75,"end":47.832,"text":"Serafu, ma jafara","marked":"Séráfù, má jáfara"},{"start":48.212,"end":50.061,"text":"Kristi Omo Baba nwi","marked":"Kristi Ọmọ Bàbá nwi"},{"start":50.441,"end":52.059,"text":"Pe laifoiya ka ma lo.","marked":"Pé láìfọ̀ìyà ká má lọ."},{"start":52.439,"end":53.43,"text":"Egbe:  A nlo 'le sodo...","marked":"À ńlò 'lè sódò"}],"end":53.43},{"key":"6","start":54.38,"lines":[{"start":54.38,"end":56.232,"text":"Jesu, a nlo l'ase Re,","marked":"Jésù, à ńlò l'àsè Rẹ"},{"start":56.612,"end":57.81,"text":"A ko'hun gbogbo sile","marked":"A kò'hun gbogbo sílẹ̀"},{"start":58.19,"end":59.637,"text":"Iwo ma j' amona wa,","marked":"Ìwọ má j' amona wa"},{"start":60.017,"end":61.337,"text":"A o si ma ba o lo.","marked":"A ò sì má bá ọ lọ."},{"start":61.717,"end":62.619,"text":"Egbe:  A nlo 'le sodo...","marked":"À ńlò 'lè sódò"}],"end":62.619},{"key":"7","start":63.569,"lines":[{"start":63.569,"end":64.807,"text":"A f'ogo fun Baba wa,","marked":"A f'ògo fún Bàbá wa"},{"start":65.187,"end":66.432,"text":"A f'ogo fun Omo Re;","marked":"A f'ògo fún Ọmọ Rẹ"},{"start":66.812,"end":68.024,"text":"Ogo ni f'Emi Mimo,","marked":"Ògo ni f'Èmi Mímọ́́"},{"start":68.404,"end":70.159,"text":"Mu wa de 'le ayo na.","marked":"Mú wa dé 'lé ayọ̀ ná."},{"start":70.539,"end":72.077,"text":"Egbe:  A nlo 'le sodo Olorun.","marked":"A ńlò 'lè sọ́dọ̀ Ọlọ́run."},{"start":72.457,"end":73.103,"text":"Amin.","marked":"Àmín."}],"end":73.103}]}