{"v":1,"coll":"y","num":847,"id":"hymn_847","title":"AWON mimo, lala pari","duration":66.649,"voices":{"male":{"file":"y-847-male.m4a","bytes":497917,"sha256":"ab23d29c889048278877bcbe0d8cd28bacec723e0754516d8e0d196cd5d2b48a","duration":66.7},"female":{"file":"y-847-female.m4a","bytes":508847,"sha256":"547737bf57be9db6393abbd72a0e13394df9e997302af9594d586696f72ed3a7","duration":66.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.74,"text":"AWON mimo, lala pari","marked":"Àwọn mímọ́́, lálá parí"},{"start":2.12,"end":4.418,"text":"Nwon ti ja, nwon si ti segun","marked":"Nwọ̀n ti jà, nwọ̀n sì ti ṣẹ́gun"},{"start":4.798,"end":6.559,"text":"Nwon ko fe ohun ija mo","marked":"Nwọn kò fẹ́ ohun ìjà mọ́"},{"start":6.939,"end":8.608,"text":"Nwon da won 'Ie l'ese Jesu:","marked":"Nwọ̀n dà wọ́n 'lé l'ẹsẹ̀ Jésù"},{"start":8.988,"end":10.176,"text":"A! enyin eni ibukun","marked":"Á! ẹnyin ẹni ìbùkún"},{"start":10.556,"end":12.269,"text":"Isimi nyin ti daju to!","marked":"Isimi nyin ti dájú tó!"}],"end":12.269},{"key":"2","start":13.219,"lines":[{"start":13.219,"end":14.792,"text":"Awon mimo, irin pari","marked":"Àwọn mímọ́́, ìrìn parí"},{"start":15.172,"end":16.891,"text":"Nwon ko tun sure ije mo,","marked":"Nwọn kò tún súre ìjẹ mọ́"},{"start":17.271,"end":18.757,"text":"Are at' isubu d'opin,","marked":"Àre àt' ìṣubú d'òpin"},{"start":19.137,"end":20.747,"text":"Are on eru ko si mo","marked":"Are ọ́n ẹrú kò sí mọ́"},{"start":21.127,"end":22.849,"text":"A! enyin eni ibukun","marked":"Á! ẹnyin ẹni ìbùkún"},{"start":23.229,"end":24.706,"text":"Isimi yin ha ti dun to!","marked":"Isimi yín ha ti dùn tó!"}],"end":24.706},{"key":"3","start":25.656,"lines":[{"start":25.656,"end":27.578,"text":"Awon mimo, ajo pari","marked":"Àwọn mímọ́́, àjọ parí"},{"start":27.958,"end":29.621,"text":"Nwon ti gun s'ile ibukun","marked":"Nwọ̀n ti gùn s'ilẹ̀ ìbùkún"},{"start":30.001,"end":31.689,"text":"Iji ko deruba won mo","marked":"Ìjì kò dẹ́rùbà wọn mọ́"},{"start":32.069,"end":33.517,"text":"Igbi omi ko n'ipa mo","marked":"Ìgbì omi kò ń'ípa mọ́"},{"start":33.897,"end":35.655,"text":"A! enyin eni ibukun","marked":"Á! ẹnyin ẹni ìbùkún"},{"start":36.035,"end":37.373,"text":"E nsimi n'ib' alafia.","marked":"Ẹ nsimi n'ib' àlàáfíà."}],"end":37.373},{"key":"4","start":38.323,"lines":[{"start":38.323,"end":40.246,"text":"Awon mimo, oku won sun","marked":"Àwọn mímọ́́, òkú wọn sùn"},{"start":40.626,"end":42.732,"text":"Ninu ile, awon nsona","marked":"Nínú ilé, àwọn ńṣọ́nà"},{"start":43.112,"end":44.66,"text":"Titi nwon yio fi jinde","marked":"Títí nwọn yio fi jíǹde"},{"start":45.04,"end":46.501,"text":"Lati fi ayo goke lo","marked":"Láti fi ayọ̀ gòkè lọ"},{"start":46.881,"end":49.064,"text":"A! eni 'bukun, e korin","marked":"A! ẹni 'bùkún, ẹ kọrin"},{"start":49.444,"end":51.132,"text":"Oluwa at'Oba nyin mbo.","marked":"Olúwa àt'Ọba nyin ḿbọ̀."}],"end":51.132},{"key":"5","start":52.082,"lines":[{"start":52.082,"end":54.026,"text":"Olorun won, Wo l'ankepe","marked":"Ọlọ́run wọn, Wo l'áńkẹ́pẹ́"},{"start":54.406,"end":56.239,"text":"Jesu, bebe fun wa l'oke","marked":"Jésù, bẹbẹ fún wa l'òkè"},{"start":56.619,"end":58.443,"text":"Emi Mimo, Oluto wa","marked":"Ẹ̀mí Mímọ́́, Olùtọ́ wa"},{"start":58.823,"end":60.518,"text":"F'ore-ofe fun wa d'opin","marked":"F'ọrẹ-ọ̀fẹ́ fún wa d'òpin"},{"start":60.898,"end":62.277,"text":"K'a le b'awon mimo simi","marked":"K'á lè b'àwọn mímọ́́ simi"},{"start":62.657,"end":64.095,"text":"Ni Paradise pelu Re.","marked":"Ní Párádísè pẹ̀lú Rẹ."},{"start":64.475,"end":65.099,"text":"Amin.","marked":"Àmín."}],"end":65.099}]}