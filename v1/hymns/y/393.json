{"v":1,"coll":"y","num":393,"id":"hymn_393","title":"OLORUN Olodumare","duration":38.726,"voices":{"male":{"file":"y-393-male.m4a","bytes":270602,"sha256":"12488665c4bded5fbf50b88c92e24f467d65f5e48c14e648da427ba31098b4e3","duration":38.8},"female":{"file":"y-393-female.m4a","bytes":277628,"sha256":"733465eabbd1e6006f1f8b3aa1ac8783e66b352b2917ae3a2bd2e77f9068c5b1","duration":38.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.284,"text":"OLORUN Olodumare","marked":"Ọlọ́run Olódùmarè"},{"start":1.664,"end":3.509,"text":"Baba, Omo, Emi","marked":"Bàbá, Ọmọ, Ẹ̀mí"},{"start":3.889,"end":5.58,"text":"Riri enit'a ko le mo","marked":"Rírí enit'a kò le mọ́"},{"start":5.96,"end":7.419,"text":"Eniti'a ko Ie ri.","marked":"Ẹniti'a kò lè rí."}],"end":7.419},{"key":"2","start":8.369,"lines":[{"start":8.369,"end":9.696,"text":"Ye! Baba Olodumare","marked":"Yé! Bàbá Olódùmarè"},{"start":10.076,"end":11.139,"text":"K'a wariri fun O","marked":"K'á wárìrì fún Ọ"},{"start":11.519,"end":12.563,"text":"Ni gbogbo orile ede","marked":"Ní gbogbo orílẹ̀ èdè"},{"start":12.943,"end":14.045,"text":"Li a o ma sin O.","marked":"Lí a ó ma sin O."}],"end":14.045},{"key":"3","start":14.995,"lines":[{"start":14.995,"end":16.481,"text":"Olorun omo, Ore wa","marked":"Ọlọ́run ọmọ, Ọ̀rẹ́ wa"},{"start":16.861,"end":18.073,"text":"Wo t'o ra wa pada","marked":"Wo t'ó rà wá padà"},{"start":18.453,"end":19.986,"text":"Ma jowo wa, Olugbala!","marked":"Má jọ̀wọ́ wa, Olùgbàlà!"},{"start":20.366,"end":21.532,"text":"Gba wa patapata.","marked":"Gbà wá pátápátá."}],"end":21.532},{"key":"4","start":22.482,"lines":[{"start":22.482,"end":24.002,"text":"A! Olorun Emi Mimo","marked":"A! Ọlọ́run Ẹ̀mí Mímọ́́"},{"start":24.382,"end":25.499,"text":"'Wo olore‐ofe","marked":"'Wo ọlọ́rẹ-ọ̀fẹ́"},{"start":25.879,"end":27.534,"text":"A be O, fun wa ni imo","marked":"A bẹ̀ Ọ́, fún wa ní ìmọ̀"},{"start":27.914,"end":29.112,"text":"K'a m'Olorun n'ife.","marked":"K'á m'Ọlọ́run ń'ìfẹ́."}],"end":29.112},{"key":"5","start":30.062,"lines":[{"start":30.062,"end":31.797,"text":"Okansoso sugbon meta","marked":"Ọ̀kánṣoṣo ṣùgbọ́n mẹ́ta"},{"start":32.177,"end":33.07,"text":"Eni Metalokan","marked":"Ẹni Mẹ́talọ́kan"},{"start":33.45,"end":34.653,"text":"Olorun awamaridi","marked":"Ọlọ́run àwámáridì"},{"start":35.033,"end":36.195,"text":"Eni Metalokan.","marked":"Ẹni Mẹ́talọ́kan."},{"start":36.575,"end":37.176,"text":"Amin.","marked":"Àmín."}],"end":37.176}]}