{"v":1,"coll":"y","num":9,"id":"hymn_9","title":"L'OJU ale, 'gbat' orun wo","duration":62.913,"voices":{"male":{"file":"y-9-male.m4a","bytes":452962,"sha256":"5f1e3acca59e584a61aa2bc43ebb033fde3fdb6e44de5d208420b59c183a5c78","duration":63.0},"female":{"file":"y-9-female.m4a","bytes":462630,"sha256":"e57475c4634debcbcc73b6aea2df95e5f3991c6dcbca17bf44174a95117fd641","duration":63.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.459,"text":"L'OJU ale, 'gbat' orun wo,","marked":"L'ojú alẹ́, 'gbat' ọrùn wo"},{"start":2.839,"end":4.515,"text":"Nwon gbe abirun w'odo Re;","marked":"Nwọ́n gbé abirùn w'ọ̀dọ̀ Rẹ"},{"start":4.895,"end":6.442,"text":"Oniruru ni aisan won,","marked":"Onírúrú ni àìsàn wọn"},{"start":6.822,"end":8.43,"text":"Sugbon nwon f'ayo lo le won.","marked":"Ṣùgbọ́n nwọn f'àyò lọ lé wọn."}],"end":8.43},{"key":"2","start":9.38,"lines":[{"start":9.38,"end":11.151,"text":"Jesu a de loj' ale yi,","marked":"Jésù á dé loj' alẹ́ yí"},{"start":11.531,"end":13.547,"text":"A sunmo O t'awa t'arun wa,","marked":"A súnmọ́ O t'àwá t'àrùn wa"},{"start":13.927,"end":15.858,"text":"Bi a ko tile le ri O,","marked":"Bí a kò tilẹ̀ lè rí O"},{"start":16.238,"end":17.681,"text":"Sugbon a mo p'O sunmo wa","marked":"Ṣùgbọ́n a mọ p'Ó súnmọ́ wa"}],"end":17.681},{"key":"3","start":18.631,"lines":[{"start":18.631,"end":20.339,"text":"Olugbala, wo osi wa,","marked":"Olùgbàlà, wo òsì wa"},{"start":20.719,"end":22.596,"text":"Omi ko san, 'mi banuje","marked":"Omi kò sàn, 'mí bànújẹ́"},{"start":22.976,"end":24.663,"text":"Omi ko ni ife si O,","marked":"Omi kò ní ìfẹ́ sí Ọ"},{"start":25.043,"end":26.417,"text":"Ife elomi si tutu.","marked":"Ìfẹ́ ẹlòmí sì tutù."}],"end":26.417},{"key":"4","start":27.367,"lines":[{"start":27.367,"end":29.085,"text":"Omi mo pe asan l'aiye","marked":"Omi mọ̀ pé asán l'áíyẹ́"},{"start":29.465,"end":31.184,"text":"Beni nwon ko f'aiye sile","marked":"Bẹni nwọn kò f'aiye sílẹ̀"},{"start":31.564,"end":33.259,"text":"Omi l'ore ti ko se 're","marked":"Omi l'ọ̀rẹ́ tí kò ṣe 're"},{"start":33.639,"end":35.223,"text":"Beni nwon ko fi O s'ore.","marked":"Bẹni nwọn kò fi Ó s'ọre."}],"end":35.223},{"key":"5","start":36.173,"lines":[{"start":36.173,"end":37.927,"text":"Ko s'okan ninu wa t'o pe","marked":"Kò s'ọ̀kan nínú wa t'ó pé"},{"start":38.307,"end":39.775,"text":"Gbogbpo wa si ni elese","marked":"Gbogbpo wa sì ni ẹlẹ́ṣẹ̀"},{"start":40.155,"end":41.796,"text":"Awon t'o si nsin O toto","marked":"Àwọn t'ó sì ńsìn Ò tótọ́"},{"start":42.176,"end":43.69,"text":"Mo ara won ni alaipe.","marked":"Mọ ara wọn ní aláìpé."}],"end":43.69},{"key":"6","start":44.64,"lines":[{"start":44.64,"end":46.295,"text":"Sugbon Jesu Olugbala","marked":"Ṣùgbọ́n Jésù Olùgbàlà"},{"start":46.675,"end":48.051,"text":"Eni bi awa ni Iwo se","marked":"Ẹní bí àwa ní Ìwọ ṣe"},{"start":48.431,"end":50.4,"text":"'Wo ti ri danwo bi awa","marked":"'Wo ti rí dánwò bí àwa"},{"start":50.78,"end":52.428,"text":"'Wo si ti mo ailera wa.","marked":"'Wo sì ti mọ àìlera wa."}],"end":52.428},{"key":"7","start":53.378,"lines":[{"start":53.378,"end":54.776,"text":"Agbar'owo Re wa sibe","marked":"Agbár'ọwọ́ Rẹ̀ wá síbẹ̀"},{"start":55.156,"end":56.365,"text":"Ore Re si ni Agbara,","marked":"Ọ̀rẹ́ Rẹ sì ní Agbára"},{"start":56.745,"end":58.291,"text":"Gbo adura ale wa yi,","marked":"Gbọ́ àdúrà alẹ́ wa yí"},{"start":58.671,"end":60.311,"text":"Ni anu, wo gbogbo wa san.","marked":"Ní ànú, wo gbogbo wa sàn."},{"start":60.691,"end":61.363,"text":"Amin.","marked":"Àmín."}],"end":61.363}]}