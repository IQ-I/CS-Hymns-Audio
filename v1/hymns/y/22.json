{"v":1,"coll":"y","num":22,"id":"hymn_22","title":"JESU, a w'odo Re","duration":25.608,"voices":{"male":{"file":"y-22-male.m4a","bytes":179964,"sha256":"60fc5408eba7421dc1d1c972dbe1ad07b9825a17a459d5a690304194843d6f20","duration":25.7},"female":{"file":"y-22-female.m4a","bytes":188033,"sha256":"76f058b85e97d2423db2327ac85c362f196deb8463964760a3b06ad2b3092f7b","duration":25.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.476,"text":"JESU, a w'odo Re","marked":"Jésù, a w'ọ̀dọ̀ Rẹ"},{"start":2.856,"end":4.028,"text":"L'Ojo Re mimo yi,","marked":"L'Ọjọ́ Rẹ mímọ́́ yí"},{"start":4.408,"end":5.704,"text":"To wa bi awa ti pejo","marked":"Tó wá bí àwa ti péjọ"},{"start":6.084,"end":7.605,"text":"Si ko wa fun 'ra Re.","marked":"Sì kọ́ wa fún 'ra Rẹ."}],"end":7.605},{"key":"2","start":8.555,"lines":[{"start":8.555,"end":9.766,"text":"Dari ese ji wa,","marked":"Darí ẹ̀ṣẹ̀ jì wá"},{"start":10.146,"end":11.236,"text":"Fun wa l'Emi Mimo","marked":"Fún wa l'Ẹ̀mí Mímọ́́"},{"start":11.616,"end":13.371,"text":"Ko wa k'ihin je ibere","marked":"Kò wá k'íhìn jẹ ìbẹ̀rẹ̀"},{"start":13.751,"end":15.237,"text":"Aiye ti ko l'opin.","marked":"Aiye tí kò l'òpin."}],"end":15.237},{"key":"3","start":16.187,"lines":[{"start":16.187,"end":17.585,"text":"F'ife kun aiya wa,","marked":"F'ìfẹ́ kún àìyá wa"},{"start":17.965,"end":19.208,"text":"Gba 'se oluko wa;","marked":"Gbà 'ṣe olùkọ́ wa"},{"start":19.588,"end":21.383,"text":"K'awa at' awon le pade","marked":"K'áwá àt' àwọn lè pàdé"},{"start":21.763,"end":22.987,"text":"Niwaju Re l'oke.","marked":"Níwájú Rẹ l'òkè."},{"start":23.367,"end":24.058,"text":"Amin.","marked":"Àmín."}],"end":24.058}]}