{"v":1,"coll":"y","num":28,"id":"hymn_28","title":"OLORUN ojo 'simi","duration":46.4,"voices":{"male":{"file":"y-28-male.m4a","bytes":328028,"sha256":"66dd614b961d2840790e17be181d846f1a4c9c3cb5690a490da1f92f0e36371d","duration":46.4},"female":{"file":"y-28-female.m4a","bytes":338834,"sha256":"22132fe82243848a07bff2364ecf56d038f9cdff3d7b726dee989fb0c5d5482f","duration":46.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.382,"text":"OLORUN ojo 'simi","marked":"Ọlọ́run ọjọ́ 'simi"},{"start":1.762,"end":3.183,"text":"Sokale l'agbara Re","marked":"Sọ̀kalẹ̀ l'ágbára Rẹ"},{"start":3.563,"end":4.853,"text":"Pase 'bukun t'oke wa","marked":"Pasẹ̀ 'bùkún t'òkè wà"},{"start":5.233,"end":6.739,"text":"Je ka ri O larin wa.","marked":"Jẹ́ ká rí Ó lárin wa."}],"end":6.739},{"key":"2","start":7.689,"lines":[{"start":7.689,"end":9.104,"text":"Je ka O ka ri O","marked":"Jẹ́ ká Ò kà rí O"},{"start":9.484,"end":10.599,"text":"Ni Olorun Kerubu","marked":"Ní Ọlọ́run Kérúbù"},{"start":10.979,"end":12.259,"text":"Ko ran ife rere Re","marked":"Kò ran ìfẹ́ rere Rẹ̀"},{"start":12.639,"end":13.928,"text":"Sarin Egbe Serafu.","marked":"Ṣárìn Ẹgbẹ́ Séráfù."}],"end":13.928},{"key":"3","start":14.878,"lines":[{"start":14.878,"end":16.187,"text":"Mu ki gbogbo agbaiye","marked":"Mú kí gbogbo agbaiye"},{"start":16.567,"end":17.665,"text":"Teti soro mimo Re,","marked":"Tẹ́tí sọ́rọ̀ mímọ́́ Rẹ"},{"start":18.045,"end":19.224,"text":"M'alagidi teriba","marked":"M'alágídí tèrìbá"},{"start":19.604,"end":21.531,"text":"S'okan t'o ku d'alaye.","marked":"S'ọ́kan t'ó kù d'àlàyé."}],"end":21.531},{"key":"4","start":22.481,"lines":[{"start":22.481,"end":23.814,"text":"Eni nwa O ko ri O,","marked":"Ẹní ńwá O kò rí O"},{"start":24.194,"end":25.426,"text":"Eni nsubu gbe dide;","marked":"Ẹni ńṣubú gbé dìde"},{"start":25.806,"end":27.79,"text":"W'alaisan, at'afoju,","marked":"W'aláìsàn, àt'afọ́jú"},{"start":28.17,"end":29.504,"text":"Ki gbogbo wa jo yin O.","marked":"Kí gbogbo wa jọ yín O."}],"end":29.504},{"key":"5","start":30.454,"lines":[{"start":30.454,"end":31.662,"text":"Bukun oro mimo Re,","marked":"Bùkún ọ̀rọ̀ mímọ́́ Rẹ"},{"start":32.042,"end":33.486,"text":"To ran wa lakoko yi,","marked":"Tó ràn wá lákòkò yí"},{"start":33.866,"end":35.384,"text":"Je k'aiye fi se 'wa hu","marked":"Jẹ k'áíyé fi ṣe 'wà hù"},{"start":35.764,"end":37.15,"text":"L'agbara Metalokan.","marked":"L'agbára Mẹ́talọ́kan."}],"end":37.15},{"key":"6","start":38.1,"lines":[{"start":38.1,"end":39.278,"text":"Ogo ni fun Baba wa,","marked":"Ògo ni fún Bàbá wa"},{"start":39.658,"end":40.835,"text":"Ogo ni fun Omo Re,","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":41.215,"end":42.343,"text":"Ogo ni f'Emi Mimo","marked":"Ògo ni f'Èmi Mímọ́́"},{"start":42.723,"end":43.859,"text":"Ogo fun Metalokan.","marked":"Ògo fún Mẹ́talọ́kan."},{"start":44.239,"end":44.85,"text":"Amin.","marked":"Àmín."}],"end":44.85}]}