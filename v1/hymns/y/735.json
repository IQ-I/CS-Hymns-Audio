{"v":1,"coll":"y","num":735,"id":"hymn_735","title":"ENYlN om'egbe Serafu","duration":48.744,"voices":{"male":{"file":"y-735-male.m4a","bytes":347467,"sha256":"72c115752d7edde4692ce50d69f432bb13f4afc9b6b5503660155ea594a0d145","duration":48.8},"female":{"file":"y-735-female.m4a","bytes":361904,"sha256":"10498e8793ba046402e44ad5a1a51eeb4ff8eedbda87b706395357a5f15314b2","duration":48.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.702,"text":"ENYlN om'egbe Serafu","marked":"ẸNYlN om'ẹgbẹ́ Séráfù"},{"start":2.082,"end":3.667,"text":"E ko le p'e o ko 'ya","marked":"Ẹ kò lè p'ẹ́ o kò 'ya"},{"start":4.047,"end":5.437,"text":"Enyin om egbe Kerubu","marked":"Enyin om egbe Kérúbù"},{"start":5.817,"end":7.641,"text":"E ko le pe e o ko ya.","marked":"Ẹ kò lè pè é o kò yá."}],"end":7.641},{"key":"2","start":8.591,"lines":[{"start":8.591,"end":9.867,"text":"Enyin om'ogun gbala yi","marked":"Enyin om'ogun gbàlà yí"},{"start":10.247,"end":12.094,"text":"E ko le pe e o k'egan","marked":"Ẹ kò lè pè é o k'ẹ́gàn"},{"start":12.474,"end":13.686,"text":"E ko le ko 'nunibini","marked":"Ẹ kò lè kọ́ 'nunibini"},{"start":14.066,"end":15.368,"text":"Ati keta gbogbo.","marked":"Àti kẹta gbogbo."}],"end":15.368},{"key":"3","start":16.318,"lines":[{"start":16.318,"end":17.619,"text":"E gb'ohun Olugbala wa","marked":"Ẹ gb'óhun Olùgbàlà wa"},{"start":17.999,"end":19.386,"text":"B'o ti nwi jeje pe","marked":"B'ó ti nwi jẹ́jẹ́ pé"},{"start":19.766,"end":21.183,"text":"Ranti mi lor'agbelebu","marked":"Rántí mi lór'àgbélébùú"},{"start":21.563,"end":23.262,"text":"At, owo at'ese.","marked":"Àt, owó àt'ẹsẹ̀."}],"end":23.262},{"key":"4","start":24.212,"lines":[{"start":24.212,"end":25.69,"text":"Bi a ba foriti 'ponju","marked":"Bí a bá forítì 'pọ́njú"},{"start":26.07,"end":27.253,"text":"Ti a si ru 'tiju","marked":"Tí a sì ru 'tiju"},{"start":27.633,"end":29.261,"text":"Ade ogo 'rawo Owuro","marked":"Adé ògo 'ràwọ̀ Òwúrọ̀"},{"start":29.641,"end":31.313,"text":"Y'o je tiwa n'kehin.","marked":"Y'ó jẹ́ tiwa n'kẹhin."}],"end":31.313},{"key":"5","start":32.263,"lines":[{"start":32.263,"end":33.401,"text":"Ao pelu awon t'orun","marked":"Àò pẹ̀lú àwọn t'ọrun"},{"start":33.781,"end":34.883,"text":"Lati ma juba Re","marked":"Láti má júbà Rẹ"},{"start":35.263,"end":36.881,"text":"A o si ma ko orin Mose","marked":"A ó sì má kọ orin Mósè"},{"start":37.261,"end":38.524,"text":"Ati t'Odagutan.","marked":"Àti t'Ọ̀dàgùtàn."}],"end":38.524},{"key":"6","start":39.474,"lines":[{"start":39.474,"end":41.358,"text":"Orin Halle, Halleluya!","marked":"Orin Halle, Hallelúyà!"},{"start":41.738,"end":42.763,"text":"lyin si Oba wa","marked":"lyin sí Ọba wa"},{"start":43.143,"end":44.762,"text":"Metalokan Aiyeraiye","marked":"Mẹ́talọ́kan Aiyérayé"},{"start":45.142,"end":46.32,"text":"Baba, Omo, Emi.","marked":"Bàbá, Ọmọ, Èmi."},{"start":46.7,"end":47.194,"text":"Amin.","marked":"Àmín."}],"end":47.194}]}