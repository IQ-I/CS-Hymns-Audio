{"v":1,"coll":"y","num":162,"id":"hymn_162","title":"EMI Mimo sokale","duration":43.145,"voices":{"male":{"file":"y-162-male.m4a","bytes":308516,"sha256":"acddeaad7b0a7a2f9f5957e7039b3b6d9bd14ffab664d432b07b30d61b13dec4","duration":43.2},"female":{"file":"y-162-female.m4a","bytes":321449,"sha256":"71423f9165091e13daa74a7062c61023a923f4fc688d95bdd728cb95b317603d","duration":43.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.374,"text":"EMI Mimo sokale","marked":"Ẹ̀mí Mímọ́́ sọ̀kalẹ̀"},{"start":1.754,"end":2.868,"text":"Fi ohun orun han","marked":"Fi ohùn ọ̀run hàn"},{"start":3.248,"end":4.712,"text":"K'o mu imole w'aiye","marked":"K'ó mú ìmọ́lẹ̀̀ w'aiye"},{"start":5.092,"end":6.311,"text":"Si ara enia,","marked":"Sí ara enia"},{"start":6.691,"end":8.327,"text":"K'awa t'a wa I'okunkun","marked":"K'àwa t'á wà l'òkùnkùn"},{"start":8.707,"end":9.677,"text":"Ki o le ma riran","marked":"Kí ó lè má ríran"},{"start":10.057,"end":11.607,"text":"'Tori Jesu Kristi ku,","marked":"'Torí Jésù Kristi kú"},{"start":11.987,"end":12.963,"text":"Fun gbogbo enia.","marked":"Fún gbogbo enia."}],"end":12.963},{"key":"2","start":13.913,"lines":[{"start":13.913,"end":15.418,"text":"K'o fi han pe elese","marked":"K'ó fi hàn pé ẹlẹ́ṣẹ̀"},{"start":15.798,"end":16.882,"text":"Ni emi nse papa","marked":"Ní ẹ̀mí ńṣe pápá"},{"start":17.262,"end":18.519,"text":"K'emi k'o le gbeke mi,","marked":"K'èmi k'ó lè gbẹ́kẹ̀ mi"},{"start":18.899,"end":19.838,"text":"Le Olugbala mi,","marked":"Lé Olùgbàlà mi"},{"start":20.218,"end":21.369,"text":"Nigbati a we mi nu","marked":"Nígbàtí a wé mi nù"},{"start":21.749,"end":22.714,"text":"Kuro ninu ese","marked":"Kúrò nínú ẹ̀ṣẹ̀"},{"start":23.094,"end":24.394,"text":"Emi o le fi ogo,","marked":"Èmi ò lè fi ògo"},{"start":24.774,"end":26.329,"text":"Fun Eni-Mimo na.","marked":"Fún Ẹni-Mímọ́ ná."}],"end":26.329},{"key":"3","start":27.279,"lines":[{"start":27.279,"end":28.488,"text":"K'o mu mi se aferi","marked":"K'ó mú mi ṣe àfẹ́rí"},{"start":28.868,"end":30.214,"text":"Lati to Jesu lo;","marked":"Láti tọ Jésù lọ"},{"start":30.594,"end":32.061,"text":"K'o joba ni okan mi,","marked":"K'ó jọba ní ọkàn mi"},{"start":32.441,"end":33.75,"text":"K'o so mi di mimo","marked":"K'ó sọ mí di mímọ́́"},{"start":34.13,"end":35.701,"text":"Ki ara ati okan","marked":"Kí ara àti ọkàn"},{"start":36.081,"end":37.416,"text":"k'o dapo lati sin","marked":"k'ó dàpọ̀ láti sìn"},{"start":37.796,"end":39.089,"text":"Olorun Eni-Mimo","marked":"Ọlọ́run Ẹni-Mímọ́"},{"start":39.469,"end":40.605,"text":"Metalokan soso.","marked":"Mẹ́talọ́kan ṣoṣo."},{"start":40.985,"end":41.595,"text":"Amin.","marked":"Àmín."}],"end":41.595}]}