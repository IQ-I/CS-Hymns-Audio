{"v":1,"coll":"y","num":279,"id":"hymn_279","title":"MURA, elese, lati gbon","duration":41.896,"voices":{"male":{"file":"y-279-male.m4a","bytes":298013,"sha256":"017c44e727ffe1631d5b64b704a5f11e5e5195c438f88e61d35049becc9ef707","duration":41.9},"female":{"file":"y-279-female.m4a","bytes":312361,"sha256":"e11919108e5489ebaa94a3af44e594ef319d3311290d50792d31a505babda44c","duration":41.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.136,"text":"MURA, elese, lati gbon","marked":"Múra, ẹlẹ́sẹ̀, láti gbọ́n"},{"start":2.516,"end":3.746,"text":"Ma duro de ojo ola","marked":"Má dúró de ọjọ́ ọ̀la"},{"start":4.126,"end":5.595,"text":"Niwon b'o ti kegab ogbon","marked":"Níwọ̀n b'ó ti kẹ́gàb ọgbọ́n"},{"start":5.975,"end":7.766,"text":"Be l'o si soro lati ti.","marked":"Bẹ́ l'ó sì ṣòro láti tì."}],"end":7.766},{"key":"2","start":8.716,"lines":[{"start":8.716,"end":9.941,"text":"Murs lati bere anu","marked":"Murs láti bẹ̀rẹ̀ ànú"},{"start":10.321,"end":11.696,"text":"Ma duro de ojo ola","marked":"Má dúró de ọjọ́ ọ̀la"},{"start":12.076,"end":13.383,"text":"Ki igba re ko ma ba tan","marked":"Kí ìgbà rẹ kó má bá tán"},{"start":13.763,"end":15.212,"text":"Ki ojo ale yi to tan.","marked":"Kí ọjọ́ alẹ́ yí tó tán."}],"end":15.212},{"key":"3","start":16.162,"lines":[{"start":16.162,"end":18.105,"text":"Mura, elese k'pada","marked":"Múra, ẹlẹ́sẹ̀ k'padà"},{"start":18.485,"end":19.817,"text":"Ma duro de ojo ola","marked":"Má dúró de ọjọ́ ọ̀la"},{"start":20.197,"end":21.702,"text":"Nitorik'egan ma ba o","marked":"Nítorík'ẹ̀gàn má bà ọ́"},{"start":22.082,"end":23.392,"text":"K'ojo ola k'o to bere.","marked":"K'ọjọ́ ọ̀la k'ó tó bẹ̀rẹ̀."}],"end":23.392},{"key":"4","start":24.342,"lines":[{"start":24.342,"end":25.888,"text":"Mura lati gba ibukun","marked":"Múra láti gba ìbùkún"},{"start":26.268,"end":27.674,"text":"Ma duro de ojo ola","marked":"Má dúró de ọjọ́ ọ̀la"},{"start":28.054,"end":29.483,"text":"Ki fitila re ma ba ku","marked":"Kí fìtílà rẹ má bà kú"},{"start":29.863,"end":31.101,"text":"K'ise rere re to bere.","marked":"K'iṣẹ́ rere rẹ̀ tó bẹ̀rẹ̀."}],"end":31.101},{"key":"5","start":32.051,"lines":[{"start":32.051,"end":33.868,"text":"Oluwa, y'elese pada","marked":"Olúwa, y'ẹ́lẹ́sẹ̀ padà"},{"start":34.248,"end":35.557,"text":"Ki kuro ninun were re","marked":"Kí kúrò ninun wẹ́rẹ́ rẹ"},{"start":35.937,"end":37.542,"text":"Ma je k'o tapa s'imo Re","marked":"Má jẹ́ k'ó tàpá s'ìmọ̀ Rẹ"},{"start":37.922,"end":39.281,"text":"K'o ma f'egbe re se 'lora.","marked":"K'ó má f'ẹgbẹ́ rẹ̀ ṣe 'lọ́ra."},{"start":39.661,"end":40.346,"text":"Amin.","marked":"Àmín."}],"end":40.346}]}