{"v":1,"coll":"y","num":110,"id":"hymn_110","title":"GBOGB'omo Egbe Serafu","duration":50.109,"voices":{"male":{"file":"y-110-male.m4a","bytes":358776,"sha256":"91cdc54b8b9777258a0d897a4f5f6e58d4a36c156e6dc5c9b78f16a1dd42c93f","duration":50.2},"female":{"file":"y-110-female.m4a","bytes":368075,"sha256":"c442e750c230db2b4ae1f326983b6eef30bc4efd5deab3de1b5d69176ff4b356","duration":50.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.755,"text":"GBOGB'omo Egbe Serafu","marked":"Gbogb'omo Ẹgbẹ́ Séráfù"},{"start":2.135,"end":3.625,"text":"Ati Kerubu l'aiye","marked":"Àti Kérúbù l'aiye"},{"start":4.005,"end":5.871,"text":"K'e da 'lu ati 'jo nyin po","marked":"K'é da 'lu àti 'jo nyin po"},{"start":6.251,"end":7.482,"text":"K'e si yin Oba-Ogo.","marked":"K'é sì yin Ọba-Ògo."},{"start":7.862,"end":9.196,"text":"Egbe:  Yin Oluwa, yin l'egbegbe","marked":"Yín Olúwa, yín l'ègbègbè"},{"start":9.576,"end":10.88,"text":"Yin Oluwa lokokan","marked":"Yín Olúwa lọ́kọ̀kan"},{"start":11.26,"end":12.326,"text":"Oba mimo l'Olorun","marked":"Ọba mímọ́́ l'Ọlọ́run"},{"start":12.706,"end":14.046,"text":"Yin Oluwa 'wo okan mi.","marked":"Yín Olúwa 'wọ ọkàn mi."}],"end":14.046},{"key":"2","start":14.996,"lines":[{"start":14.996,"end":16.755,"text":"Larin wahala ati 'ja","marked":"Lárin wàhálà àti 'ja"},{"start":17.135,"end":18.497,"text":"Larin idekun esu","marked":"Lárin ìdẹkùn èṣù"},{"start":18.877,"end":20.477,"text":"Larin isimu at'egan","marked":"Lárin ìsímú àt'ẹ́gàn"},{"start":20.857,"end":22.417,"text":"Ni Serafu ny'Oluwa.","marked":"Ní Séráfù ny'Olúwa."},{"start":22.797,"end":23.792,"text":"Egbe:  Yin Oluwa, yin...","marked":"Yín Olúwa, yín"}],"end":23.792},{"key":"3","start":24.742,"lines":[{"start":24.742,"end":25.988,"text":"Obangiji Oba mimo","marked":"Obangiji Ọba mímọ́́"},{"start":26.368,"end":28.004,"text":"Ni 'yin at'ope ye fun","marked":"Ní 'yín àt'ọpẹ́ yẹ fún"},{"start":28.384,"end":30.039,"text":"K'a mu keta gbogbo kuro","marked":"K'á mú kẹta gbogbo kúrò"},{"start":30.419,"end":31.91,"text":"K'a le gb' ade irawo.","marked":"K'á lè gb' adé ìràwọ̀."},{"start":32.29,"end":33.309,"text":"Egbe:  Yin Oluwa, yin...","marked":"Yín Olúwa, yín"}],"end":33.309},{"key":"4","start":34.259,"lines":[{"start":34.259,"end":35.726,"text":"Baba Ogo dariji wa,","marked":"Bàbá Ògo dariji wa"},{"start":36.106,"end":37.41,"text":"Omo Mimo da wa si,","marked":"Ọmọ Mímọ́́ dá wa sí"},{"start":37.79,"end":38.969,"text":"Emi Mimo radobo wa,","marked":"Ẹ̀mí Mímọ́́ ràdọ́bọ wa"},{"start":39.349,"end":40.891,"text":"K'a si jogun 'te ogo.","marked":"K'á sì jogún 'tẹ ògo."},{"start":41.271,"end":42.929,"text":"Egbe:  Yin Oluwa, yin l'egbegbe","marked":"Yín Olúwa, yín l'ègbègbè"},{"start":43.309,"end":44.455,"text":"Yin Oluwa lokokan","marked":"Yín Olúwa lọ́kọ̀kan"},{"start":44.835,"end":45.935,"text":"Oba mimo l'Olorun","marked":"Ọba mímọ́́ l'Ọlọ́run"},{"start":46.315,"end":47.527,"text":"Yin Oluwa 'wo okan mi.","marked":"Yín Olúwa 'wọ ọkàn mi."},{"start":47.907,"end":48.559,"text":"Amin.","marked":"Àmín."}],"end":48.559}]}