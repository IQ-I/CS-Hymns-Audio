{"v":1,"coll":"y","num":344,"id":"hymn_344","title":"KRISTI, lehin isugun","duration":44.777,"voices":{"male":{"file":"y-344-male.m4a","bytes":327003,"sha256":"615f0ac4e29af10a5aaf82610fe3297b0a240a4a1b672564a910bb2d8d82ec28","duration":44.8},"female":{"file":"y-344-female.m4a","bytes":339743,"sha256":"04cf027198852c82c582a58561bf3542c99da7d62fb312593c02f169c4b098b2","duration":44.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.55,"text":"KRISTI, lehin isugun","marked":"Kristi, lẹ́hìn ìṣùgùn"},{"start":1.93,"end":3.153,"text":"lwo ti goke lo","marked":"lwọ ti gòkè lọ"},{"start":3.533,"end":5.477,"text":"Kerubu at'ogun-orun","marked":"Kérúbù àt'ogun-ọ̀run"},{"start":5.857,"end":7.579,"text":"Wa sin O goke lo","marked":"Wá sìn Ó gòkè lọ"},{"start":7.959,"end":9.286,"text":"K'aiye so 'tan na jade","marked":"K'áíyé sọ 'tán ná jáde"},{"start":9.666,"end":10.533,"text":"Emmanueli wa","marked":"Ẹmmanuẹ́lì wá"},{"start":10.913,"end":12.315,"text":"Ti s'ara iy'ara wa","marked":"Ti s'ara iy'ara wa"},{"start":12.695,"end":13.779,"text":"G'or'ite Baba.","marked":"G'or'ite Bàbá."}],"end":13.779},{"key":"2","start":14.729,"lines":[{"start":14.729,"end":16.861,"text":"Nibe l'O duro, t'O nso","marked":"Níbẹ̀ l'Ó dúró, t'Ó ǹṣó"},{"start":17.241,"end":18.298,"text":"Agbara eje Re","marked":"Agbára ẹ̀jẹ̀ Rẹ"},{"start":18.678,"end":20.022,"text":"O mbebe fun elese","marked":"Ó ḿbẹ̀bẹ̀ fún ẹlẹ́ṣẹ̀"},{"start":20.402,"end":21.617,"text":"“Wo Alagbawi wa","marked":"Wo Alágbàwí wa"},{"start":21.997,"end":23.239,"text":"Gbogbo ayidayida","marked":"Gbogbo àyídáyidà"},{"start":23.619,"end":25.643,"text":"T'ayo, t'aniyan wa,","marked":"T'ayo, t'àníyàn wà"},{"start":26.023,"end":27.201,"text":"N'lwo nse iyonu si","marked":"N'lwọ́ ńṣe ìyọnu sí"},{"start":27.581,"end":28.985,"text":"T'lwo si mbebe fun.","marked":"T'lwọ́ sì mbẹ̀bẹ̀ fún."}],"end":28.985},{"key":"3","start":29.935,"lines":[{"start":29.935,"end":31.179,"text":"Nitori itoye nla","marked":"Nítorí ìtóye ńlá"},{"start":31.559,"end":32.949,"text":"Ti agbelebu Re","marked":"Ti àgbélébùú Rẹ"},{"start":33.329,"end":34.614,"text":"K'O fi Emi Re fun wa","marked":"K'ó fi Ẹ̀mí Rẹ̀ fún wa"},{"start":34.994,"end":36.271,"text":"So ofo wa d'ere","marked":"Sọ ọ̀fọ̀ wa d'ere"},{"start":36.651,"end":38.104,"text":"Titi nipa iyanu","marked":"Títí nípa ìyanu"},{"start":38.484,"end":39.465,"text":"Okan wa o goke","marked":"Ọkàn wa ò gòkè"},{"start":39.845,"end":41.398,"text":"Lati ba O gbe titi","marked":"Láti bá Ọ gbé títí"},{"start":41.778,"end":43.227,"text":"Li ayo ailopin.","marked":"Lí ayọ̀ àìlópin."}],"end":43.227}]}