{"v":1,"coll":"y","num":245,"id":"hymn_245","title":"ELESE mo nfe 'bukun","duration":49.969,"voices":{"male":{"file":"y-245-male.m4a","bytes":349996,"sha256":"c25d4640b66f47abc666debf11bf04561f2a91a3095730499f4cc8ca87b1b0db","duration":50.0},"female":{"file":"y-245-female.m4a","bytes":366708,"sha256":"6dcee50f815dd44ee0f08983c8da301b81cc362a52cd47bb4646d5cc958789f2","duration":50.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.09,"text":"ELESE mo nfe 'bukun","marked":"Ẹlẹ́sẹ̀ mo ńfẹ́ 'bùkún"},{"start":2.47,"end":4.519,"text":"Onde: mo nfe d'omnira","marked":"Òǹdè: mo ńfẹ́ d'omnira"},{"start":4.899,"end":6.763,"text":"Alare: mo nfe simi","marked":"Aláre: mo ńfẹ́ simi"},{"start":7.143,"end":8.788,"text":"“Olorun, sanu fun mi.”","marked":"Ọlọ́run, sanu fún mi."}],"end":8.788},{"key":"2","start":9.738,"lines":[{"start":9.738,"end":11.523,"text":"Ire kan emi ko ni","marked":"Irè kan èmi kọ́ ni"},{"start":11.903,"end":13.259,"text":"Ese sa l'o yi mi ka","marked":"Ẹsẹ̀ sà l'ó yí mi ká"},{"start":13.639,"end":15.021,"text":"Eyi nikan l'ebe mi","marked":"Èyí nìkan l'èbẹ̀ mi"},{"start":15.401,"end":16.811,"text":"“Olorun, sanu fun mi.\"","marked":"Ọlọ́run, sanu fún mi."}],"end":16.811},{"key":"3","start":17.761,"lines":[{"start":17.761,"end":18.793,"text":"lrobinuje okan!","marked":"lrobinuje ọkàn!"},{"start":19.173,"end":20.51,"text":"Nko gbodo gboju s'oke","marked":"Nkò gbọdọ̀ gbójú s'òkè"},{"start":20.89,"end":22.06,"text":"Iwo sa mo edun mi","marked":"Ìwọ sá mọ́ ẹ̀dùn mi"},{"start":22.44,"end":24.212,"text":"“Olorun, sanu fun mi.”","marked":"Ọlọ́run, sanu fún mi."}],"end":24.212},{"key":"4","start":25.162,"lines":[{"start":25.162,"end":26.319,"text":"Okan ese mi yi nfe","marked":"Ọkàn ẹsẹ̀ mi yí ńfẹ́"},{"start":26.699,"end":28.057,"text":"Sa wa simi laiya re","marked":"Sá wá sìmí láìyá rẹ̀"},{"start":28.437,"end":30.591,"text":"Lat'oni, mo di Tire","marked":"Lát'ọ́nì, mo di Tírè"},{"start":30.971,"end":32.543,"text":"“Olorun, sanu fun mi.”","marked":"Ọlọ́run, sanu fún mi."}],"end":32.543},{"key":"5","start":33.493,"lines":[{"start":33.493,"end":34.802,"text":"Enikan mbe l'or ite","marked":"Ẹnìkan mbẹ l'or ìtẹ́"},{"start":35.182,"end":36.345,"text":"Ninu Re nikansoso","marked":"Nínú Rẹ̀ nìkanṣoṣo"},{"start":36.725,"end":38.061,"text":"N'ireti at'ebe mi","marked":"N'ìrètí àt'èbé mi"},{"start":38.441,"end":39.991,"text":"“Olorun, sanu fun mi.”","marked":"Ọlọ́run, sanu fún mi."}],"end":39.991},{"key":"6","start":40.941,"lines":[{"start":40.941,"end":42.273,"text":"On o gba oran mi ro","marked":"On ò gba ọ̀ràn mi rò"},{"start":42.653,"end":43.854,"text":"On ni Alagbawi mi","marked":"Òǹ ni Alágbàwí mi"},{"start":44.234,"end":45.459,"text":"Nitori Tire nikan","marked":"Nítorí Tírè nìkan"},{"start":45.839,"end":47.498,"text":"“Olorun, sanu fun mi.”","marked":"Ọlọ́run, sanu fún mi."},{"start":47.878,"end":48.419,"text":"Amin.","marked":"Àmín."}],"end":48.419}]}