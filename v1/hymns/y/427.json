{"v":1,"coll":"y","num":427,"id":"hymn_427","title":"OLUWA, Iwo wadi mi","duration":47.004,"voices":{"male":{"file":"y-427-male.m4a","bytes":327451,"sha256":"48c6848cc8945643894a8e26512fa53d580a2234fb5e77d9d8843b6837ee1fac","duration":47.1},"female":{"file":"y-427-female.m4a","bytes":341184,"sha256":"07ac63678559beff33f593aa92e60e586c3950a1449ef1c28925b200a6a792f5","duration":47.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.864,"text":"OLUWA, Iwo wadi mi","marked":"Olúwa, Ìwọ wádì mi"},{"start":2.244,"end":3.359,"text":"Em' ise owo Re","marked":"Em' ise ọwọ́ Rẹ"},{"start":3.739,"end":5.074,"text":"Ijoko on idide mi","marked":"Ìjókò ọ́n ìdìde mi"},{"start":5.454,"end":6.558,"text":"Ko pamo loju Re.","marked":"Kò pamọ lójú Rẹ̀."}],"end":6.558},{"key":"2","start":7.508,"lines":[{"start":7.508,"end":9.177,"text":"N'ile mi, ati l'ona mi","marked":"N'ílé mi, àti l'ọ́nà mi"},{"start":9.557,"end":10.775,"text":"N' Iwo ti yi mi ka","marked":"N' Ìwọ ti yí mi ká"},{"start":11.155,"end":13.26,"text":"Ko s'iro tabi oro mi","marked":"Kò s'iro tàbí ọ̀rọ̀ mi"},{"start":13.64,"end":14.951,"text":"T'Iwo ko ti mo tan.","marked":"T'Ìwọ kò ti mọ́ tán."}],"end":14.951},{"key":"3","start":15.901,"lines":[{"start":15.901,"end":17.56,"text":"Niwaju ati lehin mi","marked":"Níwájú àti lẹ́hìn mi"},{"start":17.94,"end":19.062,"text":"N'lwo ti se mi mo","marked":"N'lwọ ti sé mi mọ́"},{"start":19.442,"end":20.725,"text":"Iru'mo yi se 'yanu ju","marked":"Irú'mo yí ṣe 'yanu jù"},{"start":21.105,"end":22.507,"text":"Ti emi ko le mo.","marked":"Ti èmi kò lè mọ́."}],"end":22.507},{"key":"4","start":23.457,"lines":[{"start":23.457,"end":24.935,"text":"Lati sa kuro loju Re","marked":"Láti sá kúrò lójú Rẹ"},{"start":25.315,"end":26.496,"text":"Is' asan ni fun mi","marked":"Is' asán ni fún mi"},{"start":26.876,"end":28.325,"text":"Emi Re lu aluja mi","marked":"Èmi Rẹ̀ lu àlùjá mi"},{"start":28.705,"end":30.037,"text":"Beni mo sa lasan.","marked":"Bẹ́ni mo sá lásán."}],"end":30.037},{"key":"5","start":30.987,"lines":[{"start":30.987,"end":32.429,"text":"Bi mo sa sinu okunkun","marked":"Bí mo sá sínú òkùnkùn"},{"start":32.809,"end":33.938,"text":"Asan ni eyi je","marked":"Asán ni èyí jẹ́"},{"start":34.318,"end":35.969,"text":"Imole l'okunkun fun O","marked":"Ìmọ́lẹ̀̀ l'òkùnkùn fún Ọ"},{"start":36.349,"end":37.626,"text":"B'osangangan l'o ri.","marked":"B'ọ̀sángangan l'ó rí."}],"end":37.626},{"key":"6","start":38.576,"lines":[{"start":38.576,"end":39.871,"text":"Bi Iwo ti mo okan mi","marked":"Bí Ìwọ ti mọ ọkàn mi"},{"start":40.251,"end":41.309,"text":"Lat'inu iya mi","marked":"Lát'ínú ìyá mi"},{"start":41.689,"end":43.066,"text":"Je ki emi k'o f'ara mi","marked":"Jẹ́ kí èmi k'ó f'ara mi"},{"start":43.446,"end":44.47,"text":"Fun O Olugbala.","marked":"Fún Ọ Olùgbàlà."},{"start":44.85,"end":45.454,"text":"Amin.","marked":"Àmín."}],"end":45.454}]}