{"v":1,"coll":"y","num":419,"id":"hymn_419","title":"GB'OKAN mi gegeb' o ti ri","duration":32.373,"voices":{"male":{"file":"y-419-male.m4a","bytes":230195,"sha256":"5b08b9f25718f9029fa7b19762745de1360affd8d707101c430b1183c53a5f11","duration":32.4},"female":{"file":"y-419-female.m4a","bytes":236020,"sha256":"e060a9c40082eedb7bd167f60dabb1fe4bac09919a51e3b9206c99c8143e5189","duration":32.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.606,"text":"GB'OKAN mi gegeb' o ti ri","marked":"Gb'ọkàn mi gegeb' ó ti rí"},{"start":2.986,"end":3.927,"text":"Te ite Re sibe","marked":"Tẹ ìtẹ́ Rẹ síbẹ̀"},{"start":4.307,"end":6.271,"text":"Ki nle fe O ju aiye lo","marked":"Kí ńlẹ̀ fẹ́ Ó ju àìyẹ́ lọ"},{"start":6.651,"end":8.04,"text":"Ki nwa fun O nikan.","marked":"Kí nwà fún O nìkan."}],"end":8.04},{"key":"2","start":8.99,"lines":[{"start":8.99,"end":10.159,"text":"Pari 'se Re Oluwa mi","marked":"Parí 'ṣe Rẹ Olúwa mi"},{"start":10.539,"end":11.592,"text":"Mu mi je oloto","marked":"Mú mi jẹ oloto"},{"start":11.972,"end":13.805,"text":"K'emi le gbohun Re, Jesu","marked":"K'èmí lè gbóhùn Rẹ, Jésù"},{"start":14.185,"end":15.369,"text":"Ti o kun fun ife.","marked":"Tí ó kún fún ìfẹ́."}],"end":15.369},{"key":"3","start":16.319,"lines":[{"start":16.319,"end":17.722,"text":"Ohun ti nko mi n'ife Re","marked":"Ohun tí ńkọ́ mi ń'ìfẹ́ Rẹ"},{"start":18.102,"end":19.572,"text":"Ti nso 'hun ti mba se","marked":"Ti ǹṣó 'hun ti ḿbá ṣe"},{"start":19.952,"end":21.833,"text":"Ti ndoju ti mi, nigba nko","marked":"Ti ndoju tì mí, nígbà ńkọ́"},{"start":22.213,"end":23.347,"text":"Ba topa ona Re.","marked":"Bá tọpa ọ̀nà Rẹ."}],"end":23.347},{"key":"4","start":24.297,"lines":[{"start":24.297,"end":25.883,"text":"Emi 'ba ma ni eko yi","marked":"Èmi 'bá ma ní ẹ̀kọ́ yí"},{"start":26.263,"end":27.542,"text":"To ati Odo Re wa,","marked":"Tó àti Ọ̀dọ̀ Rẹ wá"},{"start":27.922,"end":29.417,"text":"Ki nko 'teriba s'ohun Re","marked":"Kí ńkọ́ 'tẹríba s'ọ́hùn Rẹ"},{"start":29.797,"end":30.823,"text":"At'oro isoye.","marked":"Àt'ọ̀rọ̀ ìsọyé."}],"end":30.823}]}