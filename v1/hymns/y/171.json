{"v":1,"coll":"y","num":171,"id":"hymn_171","title":"OLUWA 'kore, 'Wole l'a nyin","duration":50.771,"voices":{"male":{"file":"y-171-male.m4a","bytes":374508,"sha256":"0834cd2c385ef6daab121b3d40f4c83e51ed62ba731ff00c55d4b526b26741b8","duration":50.8},"female":{"file":"y-171-female.m4a","bytes":383395,"sha256":"cf0bc027fc4b86b2e3d10d6b8d3f2a3eeddd511ae34711e5a9a04fff9b79ee1f","duration":50.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.513,"text":"OLUWA 'kore, 'Wole l'a nyin","marked":"Olúwa 'kórè, 'Wọlé l'á nyin"},{"start":2.893,"end":4.239,"text":"lleri Re 'gbani ko ye","marked":"llérí Rẹ̀ 'gbani kò yé"},{"start":4.619,"end":6.144,"text":"Orisi igba si nyipo,","marked":"Oríṣi ìgbà sì nyípo"},{"start":6.524,"end":8.028,"text":"Ododun kun fun ore Re","marked":"Ọdọdún kún fún ọ̀rẹ́ Rẹ"},{"start":8.408,"end":10.287,"text":"Lojo oni, awa dupe","marked":"Lọ́jọ́ òní, àwa dúpẹ́"},{"start":10.667,"end":12.22,"text":"Jek' iyin gba okan wa kan.","marked":"Jẹ́k' ìyìn gba ọkàn wa kan."}],"end":12.22},{"key":"2","start":13.17,"lines":[{"start":13.17,"end":14.603,"text":"B'akoko 'rugbin mu wa yo","marked":"B'àkókò 'rúgbìn mú wa yọ"},{"start":14.983,"end":16.173,"text":"B'igba erun nmu oru wa;","marked":"B'ígbà ẹ̀rùn ńmú òru wà"},{"start":16.553,"end":17.998,"text":"'Gbati owo ojo ba nrinle","marked":"'Gbàtì owó ọjọ́ bá ńrinlẹ̀"},{"start":18.378,"end":19.717,"text":"Tab'igbat'ikore ba pon","marked":"Tàb'ìgbat'ìkórè bá pọ́n"},{"start":20.097,"end":21.72,"text":"'Wo Oba wa l'a o ma yin","marked":"'Wò Ọba wa l'á ò mà yín"},{"start":22.1,"end":23.629,"text":"'Wo l'alakoso gbogbo won.","marked":"'Wò l'álàkóso gbogbo wọn."}],"end":23.629},{"key":"3","start":24.579,"lines":[{"start":24.579,"end":26.493,"text":"Ju gbogbo re lo, nigbati","marked":"Ju gbogbo rẹ̀ lọ, nígbàti"},{"start":26.873,"end":28.374,"text":"Owo Re fun opo ka 'le","marked":"Ọwọ́ Rẹ fún ọ̀pọ̀ kà 'le"},{"start":28.754,"end":31.032,"text":"Gba t'ohun ayo, gbilekun","marked":"Gba t'ohun ayọ̀, gbilẹ̀kùn"},{"start":31.412,"end":33.109,"text":"B'eda ti n ko ire won jo;","marked":"B'ẹ̀dà ti ń kó ire wọn jọ"},{"start":33.489,"end":34.968,"text":"Awa pelu y'o ma yin O","marked":"Àwa pẹ̀lú y'ó ma yìn O"},{"start":35.348,"end":36.637,"text":"Ore Re ni gbogbo wa npin.","marked":"Ọ̀rẹ́ Rẹ ni gbogbo wa ńpín."}],"end":36.637},{"key":"4","start":37.587,"lines":[{"start":37.587,"end":39.468,"text":"Oluwa 'kore, Tire ni,","marked":"Olúwa 'kórè, Tírè ni"},{"start":39.848,"end":41.206,"text":"Ojo ti nro orun ti nran","marked":"Ọjọ́ tí ńrọ ọrùn ti ńràn"},{"start":41.586,"end":42.873,"text":"lrugbin ti a gbin sile","marked":"lrúgbìn tí a gbìn sílẹ̀"},{"start":43.253,"end":44.744,"text":"Tire l'ohun ti nmu dagba:","marked":"Tìrẹ l'óhun tí ńmu dàgbà"},{"start":45.124,"end":46.619,"text":"Otun l'ebun Re l'ododun","marked":"Ọ̀tún l'ẹ́bùn Rẹ l'ọdọdún"},{"start":46.999,"end":48.203,"text":"Otun n'iyin Re l'enu wa.","marked":"Ọ̀tún ń'ìyìn Rẹ l'ẹnu wa."},{"start":48.583,"end":49.221,"text":"Amin.","marked":"Àmín."}],"end":49.221}]}