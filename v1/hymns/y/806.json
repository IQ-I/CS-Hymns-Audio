{"v":1,"coll":"y","num":806,"id":"hymn_806","title":"OLORUN agbaiye","duration":63.232,"voices":{"male":{"file":"y-806-male.m4a","bytes":461077,"sha256":"2eef74bb93c2e49999b16df4bf354faf6017d8dca3503b3bf8e1943e8c0c84b5","duration":63.3},"female":{"file":"y-806-female.m4a","bytes":459980,"sha256":"ff104931d398743622729bbb18abaab17ceb80e6129bcd977a0a1ce4d4429e69","duration":63.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.343,"text":"OLORUN agbaiye,","marked":"Ọlọ́run agbaiye"},{"start":1.723,"end":3.269,"text":"Owo ni f'Oruko re","marked":"Owó ní f'Orúkọ rẹ"},{"start":3.649,"end":4.919,"text":"Iwo l'agbekele,","marked":"Ìwo l'ágbẹ́kẹ̀lé"},{"start":5.299,"end":6.856,"text":"lai ma je k'oju ti wa.","marked":"láì má jẹ́ k'ojú tì wá."}],"end":6.856},{"key":"CHORUS","start":7.806,"lines":[{"start":7.806,"end":9.614,"text":"Bi kose pe O ko ile na,","marked":"Bí kọ́ṣẹ́ pé Ó kọ́ ilé ná"},{"start":9.994,"end":11.088,"text":"Osise nse lasan,","marked":"Òṣìṣẹ́ ńṣe lásán"},{"start":11.468,"end":13.354,"text":"Wo Alfa ati Omega","marked":"Wo Alfa àti Omega"},{"start":13.734,"end":15.067,"text":"Ran iranwo re si wa.","marked":"Ran ìrànwọ́ rẹ̀ sí wa."}],"end":15.067},{"key":"2","start":16.017,"lines":[{"start":16.017,"end":19.218,"text":"Oba aiku, Airi, Mimo logo julo","marked":"Ọba àìkú, Airi, Mímọ́́ lógo jùlọ"},{"start":19.598,"end":21.769,"text":"Eni aiyeraiye, t'o gunwa","marked":"Ẹni aiyérayé, t'ó gúnwà"},{"start":22.149,"end":23.514,"text":"n'nu 'mole nla.","marked":"ń'nú 'mọ́lẹ̀ ńlá."}],"end":23.514},{"key":"3","start":24.464,"lines":[{"start":24.464,"end":27.877,"text":"L'aiye ati l'orun, tani a ba fi we O!","marked":"L'aiye àti l'orun, tani a bá fi wé O!"},{"start":28.257,"end":31.029,"text":"Eleda, Alase, Baba","marked":"Ẹlẹ́dàá, Aláṣẹ, Bàbá"},{"start":31.409,"end":32.359,"text":"Olodumare.","marked":"Olódùmarè."}],"end":32.359},{"key":"4","start":33.309,"lines":[{"start":33.309,"end":36.003,"text":"Iwo l'o da aiye, ati ohun inu re","marked":"Ìwọ l'ó da aiye, àti ohùn inú rẹ̀"},{"start":36.383,"end":38.531,"text":"O da awon orun, ati gbogbo","marked":"Ó dá àwọn ọ̀run, àti gbogbo"},{"start":38.911,"end":39.736,"text":"ogun won.","marked":"ogún wọn."}],"end":39.736},{"key":"5","start":40.686,"lines":[{"start":40.686,"end":42.899,"text":"Baba wa olore, at'oniyonu julo","marked":"Bàbá wa ọlọ́rẹ́, at'oníyọnu jùlọ"},{"start":43.279,"end":45.669,"text":"Eleru ni iyin, Olorun alagbara.","marked":"Ẹlẹ́rù ni ìyìn, Ọlọ́run alágbára."}],"end":45.669},{"key":"6","start":46.619,"lines":[{"start":46.619,"end":48.757,"text":"Metalokan lailai, Baba,","marked":"Mẹ́talọ́kan láíláí, Bàbá"},{"start":49.137,"end":49.806,"text":"Omo on Emi","marked":"Ọmọ ọn Ẹ̀mí"},{"start":50.186,"end":53.724,"text":"Ipilese, Opin, Mimo Awamaridi.","marked":"Ìpilẹ̀ṣẹ̀, Òpin, Mímọ́ Awamárìdì."}],"end":53.724},{"key":"7","start":54.674,"lines":[{"start":54.674,"end":56.493,"text":"Ogo f'oruko re, t'o ju","marked":"Ògo f'orúkọ rẹ̀, t'ó jù"},{"start":56.873,"end":57.688,"text":"gbogbo iyin lo","marked":"gbogbo ìyìn ló"},{"start":58.068,"end":60.321,"text":"Iwo ni yin ye fun, tit' aye","marked":"Ìwọ ni yín yẹ fún, tit' aye"},{"start":60.701,"end":61.682,"text":"ainipekun.","marked":"àìnípẹ̀kun."}],"end":61.682}]}