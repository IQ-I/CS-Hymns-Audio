{"v":1,"coll":"y","num":316,"id":"hymn_316","title":"IGBAGBO mi ri 'bi 'sinmi","duration":58.069,"voices":{"male":{"file":"y-316-male.m4a","bytes":416454,"sha256":"8aeb6fefda41de992d4c5ee861813243912269e2e56ecd50423ce6d913e30b46","duration":58.1},"female":{"file":"y-316-female.m4a","bytes":435919,"sha256":"54d6d92ce76b39017709d4433bd29851ab0feaf7c351655fe9c135f42e3f5803","duration":58.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.883,"text":"IGBAGBO mi ri 'bi 'sinmi","marked":"Ìgbàgbọ́́ mi rí 'bí 'sinmi"},{"start":2.263,"end":3.258,"text":"Ibi 'sin mi didun","marked":"Ibi 'sìn mi dídùn"},{"start":3.638,"end":5.053,"text":"Mo gbekele Jesu Kristi","marked":"Mo gbẹ́kẹ̀lé Jésù Kristi"},{"start":5.433,"end":6.536,"text":"Eje Re seun fun mi.","marked":"Ẹ̀jẹ̀ Rẹ ṣeun fún mi."},{"start":6.916,"end":8.676,"text":"Egbe: N ko ni s'ariyanjiyan mo","marked":"N kò ní s'áríyànjiyàn mọ́"},{"start":9.056,"end":10.166,"text":"N ko ni se awa wi","marked":"N kò ní ṣe àwa wí"},{"start":10.546,"end":12.325,"text":"Pe Jesu ku fun ese mi","marked":"Pé Jésù kú fún ẹ̀ṣẹ̀ mi"},{"start":12.705,"end":14.063,"text":"Eyi ti to fun mi.","marked":"Èyí ti tó fún mi."}],"end":14.063},{"key":"CHORUS","start":15.013,"lines":[{"start":15.013,"end":16.621,"text":"N ko ni s'ariyanjiyan mo","marked":"N kò ní s'áríyànjiyàn mọ́"},{"start":17.001,"end":18.2,"text":"N ko ni se awa wi","marked":"N kò ní ṣe àwa wí"},{"start":18.58,"end":20.466,"text":"Pe Jesu ku fun ese mi","marked":"Pé Jésù kú fún ẹ̀ṣẹ̀ mi"},{"start":20.846,"end":22.24,"text":"Eyi ti to fun mi.","marked":"Èyí ti tó fún mi."}],"end":22.24},{"key":"2","start":23.19,"lines":[{"start":23.19,"end":24.734,"text":"O to fun mi Jesu n gbala","marked":"Ó tó fún mi Jésù ń gbalá"},{"start":25.114,"end":26.347,"text":"Iyemeji mi tan","marked":"Iyèméjì mi tán"},{"start":26.727,"end":28.149,"text":"Pel'eru ese ni mo wa","marked":"Pel'eru ẹsẹ̀ ni mo wà"},{"start":28.529,"end":29.864,"text":"Ko si je tan mi nu.","marked":"Kò sì jẹ́ tàn mí nù."},{"start":30.244,"end":31.739,"text":"Egbe: N ko ni s'ariyanjiyan...","marked":"N kò ní s'áríyànjiyàn"}],"end":31.739},{"key":"3","start":32.689,"lines":[{"start":32.689,"end":34.0,"text":"Okan mi 'sin mi l'oro Re","marked":"Ọkàn mi 'sìn mí l'ọ̀rọ̀ Rẹ"},{"start":34.38,"end":35.618,"text":"Or'Olorun t'a ko","marked":"Or'Ọlọ́run t'á kọ́"},{"start":35.998,"end":37.492,"text":"Ooko Re l'a fi n gba ni la","marked":"Ooko Rẹ l'á fi ń gbà ni là"},{"start":37.872,"end":38.966,"text":"At'eje Re pelu.","marked":"Àt'ẹ̀jẹ̀ Rẹ pẹ̀lú."},{"start":39.346,"end":40.83,"text":"Egbe: N ko ni s'ariyanjiyan...","marked":"N kò ní s'áríyànjiyàn"}],"end":40.83},{"key":"4","start":41.78,"lines":[{"start":41.78,"end":43.415,"text":"Olugbala mi n wo ni san","marked":"Olùgbàlà mi ń wò ní sàn"},{"start":43.795,"end":45.066,"text":"O si n gbala pelu","marked":"Ó sì ń gbalá pẹ̀lú"},{"start":45.446,"end":46.934,"text":"O t'eje Re sile fun mi","marked":"Ó t'ẹ̀jẹ̀ Rẹ̀ sílẹ̀ fún mi"},{"start":47.314,"end":48.407,"text":"O f'aye Re fun mi","marked":"Ó f'áyè Rẹ̀ fún mi"},{"start":48.787,"end":50.356,"text":"Egbe: N ko ni s'ariyanjiyan mo","marked":"N kò ní s'áríyànjiyàn mọ́"},{"start":50.736,"end":51.925,"text":"N ko ni se awa wi","marked":"N kò ní ṣe àwa wí"},{"start":52.305,"end":53.939,"text":"Pe Jesu ku fun ese mi","marked":"Pé Jésù kú fún ẹ̀ṣẹ̀ mi"},{"start":54.319,"end":55.557,"text":"Eyi ti to fun mi.","marked":"Èyí ti tó fún mi."},{"start":55.937,"end":56.519,"text":"Amin.","marked":"Àmín."}],"end":56.519}]}