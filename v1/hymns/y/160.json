{"v":1,"coll":"y","num":160,"id":"hymn_160","title":"EMI Olorun mi","duration":45.442,"voices":{"male":{"file":"y-160-male.m4a","bytes":338960,"sha256":"b837209482b1268b8f9eab6ed5017813fdfebf66066cd9df362395c94549961e","duration":45.5},"female":{"file":"y-160-female.m4a","bytes":345651,"sha256":"5f51c46b89575d5187622f90981c0fdb62a3f797e07663261a74e10b81072f81","duration":45.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.232,"text":"EMI Olorun mi,","marked":"Èmi Ọlọ́run mi"},{"start":1.612,"end":3.142,"text":"L'ojo 'tewogba yi","marked":"L'ọjọ́ 'tẹ́wọ́gbà yí"},{"start":3.522,"end":5.173,"text":"Gege b'ojo Pentikosti","marked":"Gẹ́gẹ́ b'ọjọ́ Pentikosti"},{"start":5.553,"end":6.762,"text":"Sokale l'agbara","marked":"Sókàlẹ̀ l'ágbára"},{"start":7.142,"end":9.02,"text":"Lokan kan l'apade","marked":"Lọ́kàn kan l'ápàdé"},{"start":9.4,"end":10.375,"text":"Ninu ile Re yi","marked":"Nínú ilé Rẹ yí"},{"start":10.755,"end":12.04,"text":"A duro de ileri Re,","marked":"A dúró de ìlérí Rẹ̀"},{"start":12.42,"end":13.548,"text":"A duro de Emi.","marked":"A dúró de Èmi."}],"end":13.548},{"key":"2","start":14.498,"lines":[{"start":14.498,"end":15.809,"text":"B'iro iji lile,","marked":"B'iro ìjì líle"},{"start":16.189,"end":17.255,"text":"Wa kun 'nu ile yi","marked":"Wá kún 'nú ilé yí"},{"start":17.635,"end":19.0,"text":"Mi Oni isokan si wa","marked":"Mi Oní ìṣọ̀kan sí wa"},{"start":19.38,"end":20.937,"text":"Okan kan, imo kan,","marked":"Ọkàn kan, ìmọ̀ kan"},{"start":21.317,"end":22.678,"text":"Fun ewe at'agba","marked":"Fún ewé àt'àgbà"},{"start":23.058,"end":24.497,"text":"L'ogbon at'oke wa","marked":"L'ọgbọ́n àt'òkè wa"},{"start":24.877,"end":26.208,"text":"Fi okan gbigbona fun wa","marked":"Fi ọkàn gbígbóná fún wa"},{"start":26.588,"end":28.533,"text":"K'a yin, k'agbadura.","marked":"K'á yín, k'ágbàdúrà."}],"end":28.533},{"key":"3","start":29.483,"lines":[{"start":29.483,"end":30.454,"text":"Emi imole wa,","marked":"Ẹ̀mí ìmọ́lẹ̀̀ wa"},{"start":30.834,"end":32.243,"text":"Le okunkun jade","marked":"Lé òkùnkùn jáde"},{"start":32.623,"end":34.041,"text":"Siwaju ni k'imole tan","marked":"Síwájú ní k'ìmọ́lẹ̀̀ tán"},{"start":34.421,"end":35.632,"text":"Tit' d'osangangan","marked":"Tít' d'ọ̀sángangan"},{"start":36.012,"end":36.985,"text":"Emi otito wa,","marked":"Ẹ̀mí òtítọ́́ wà"},{"start":37.365,"end":38.745,"text":"S'amona wa titi","marked":"S'amọ̀nà wà títí"},{"start":39.125,"end":41.176,"text":"Emi Isodomo, si wa","marked":"Ẹ̀mí Ìsọdọmọ, sí wa"},{"start":41.556,"end":42.89,"text":"S'okan wa di mimo.","marked":"S'ọkàn wa di mímọ́́."},{"start":43.27,"end":43.892,"text":"Amin.","marked":"Àmín."}],"end":43.892}]}