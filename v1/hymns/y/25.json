{"v":1,"coll":"y","num":25,"id":"hymn_25","title":"OLUWA awa de","duration":73.859,"voices":{"male":{"file":"y-25-male.m4a","bytes":526015,"sha256":"9cc38fef5381889b9f68afc2921fefdc2b8666b4e202abe7468bbca3aaf0afe0","duration":73.9},"female":{"file":"y-25-female.m4a","bytes":544288,"sha256":"b3154591a110cac2638dfd2b607b52e937d233554cf56852dda4b0430b9a70a8","duration":73.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.219,"text":"OLUWA awa de,","marked":"Olúwa àwa dé"},{"start":1.599,"end":3.083,"text":"Lati yin O logo","marked":"Láti yìn Ọ́ lógo"},{"start":3.463,"end":5.431,"text":"Fun ayo nla t'a nyo loni","marked":"Fún ayọ̀ ńlá t'á nyo lónì"},{"start":5.811,"end":6.795,"text":"Larin Egbe Seraf","marked":"Lárin Ẹgbẹ́ Séráf"}],"end":6.795},{"key":"CHORUS","start":7.745,"lines":[{"start":7.745,"end":9.31,"text":"Olugbala, a de","marked":"Olùgbàlà, a dé"},{"start":9.69,"end":10.822,"text":"Lati f'iyin fun O","marked":"Láti f'ìyìn fún Ọ"},{"start":11.202,"end":12.826,"text":"Ogo, Iyin, f'Oruko Re","marked":"Ògo, Ìyìn, f'Orúkọ Rẹ"},{"start":13.206,"end":14.247,"text":"Alagbara julo","marked":"Alágbára jùlọ"}],"end":14.247},{"key":"2","start":15.197,"lines":[{"start":15.197,"end":16.993,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":17.373,"end":18.504,"text":"Eyin ni'yo aye","marked":"Ẹ̀yin ni'yo ayé"},{"start":18.884,"end":20.009,"text":"llu ta te sori oke","marked":"llu ta tẹ̀ sórí òkè"},{"start":20.389,"end":21.63,"text":"A ko le farasin","marked":"A kò lè farasin"},{"start":22.01,"end":23.672,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":23.672},{"key":"3","start":24.622,"lines":[{"start":24.622,"end":26.892,"text":"Kabiyesi! Oba,","marked":"Kábíyèsí! Ọba"},{"start":27.272,"end":28.652,"text":"Ogo f'Oruko Re!","marked":"Ògo f'Orúkọ Rẹ!"},{"start":29.032,"end":30.335,"text":"Fun iyanu Re larin wa,","marked":"Fún ìyanu Rẹ̀ lárin wa"},{"start":30.715,"end":32.182,"text":"Eyi t'a ko gbo ri","marked":"Èyí t'á kò gbọ́ rí"},{"start":32.562,"end":34.14,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":34.14},{"key":"4","start":35.09,"lines":[{"start":35.09,"end":36.193,"text":"Orin Halleluyah!","marked":"Orin Hallelúyà!"},{"start":36.573,"end":37.83,"text":"L'awa yio ma ko","marked":"L'áwá yíó ma kọ́"},{"start":38.21,"end":39.607,"text":"Awa y'o f'iye fo b'idi","marked":"Àwa y'ó f'iye fọ́ b'idi"},{"start":39.987,"end":41.237,"text":"Lehin irin ajo wa.","marked":"Lẹ́hìn ìrìn àjò wa."},{"start":41.617,"end":43.583,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":43.583},{"key":"5","start":44.533,"lines":[{"start":44.533,"end":45.791,"text":"Aiye sun m'Olorun","marked":"Àìyé sún m'Ọlọ́run"},{"start":46.171,"end":47.322,"text":"Akoko sunmo le:","marked":"Àkókò súnmọ́ lé"},{"start":47.702,"end":48.952,"text":"Ilekun anu fere ti,","marked":"Ilẹ̀kùn ànú fèrè tí"},{"start":49.332,"end":50.462,"text":"E wa wo oko na.","marked":"Ẹ wá wọ ọkọ̀ ná."},{"start":50.842,"end":52.452,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":52.452},{"key":"6","start":53.402,"lines":[{"start":53.402,"end":54.796,"text":"Jesu, Olori wa,","marked":"Jésù, Olórí wa"},{"start":55.176,"end":56.272,"text":"A gb'oju wa si O,","marked":"A gb'ojú wa sí O"},{"start":56.652,"end":58.629,"text":"'Wo l'ao ma yin titi aiye,","marked":"'Wò l'áo ma yín títí aiye"},{"start":59.009,"end":60.572,"text":"Aiye ainipekun","marked":"Aiye àìnípẹ̀kun"},{"start":60.952,"end":62.491,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":62.491},{"key":"7","start":63.441,"lines":[{"start":63.441,"end":64.532,"text":"A f'ogo fun Baba","marked":"A f'ògo fún Bàbá"},{"start":64.912,"end":65.966,"text":"A f'ogo f'Omo Re","marked":"A f'ògo f'Ọmọ Rẹ"},{"start":66.346,"end":67.463,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":67.843,"end":69.291,"text":"Metalokan Iailai.","marked":"Mẹ́talọ́kan láíláí."},{"start":69.671,"end":71.345,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"},{"start":71.725,"end":72.309,"text":"Amin.","marked":"Àmín."}],"end":72.309}]}