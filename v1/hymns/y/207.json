{"v":1,"coll":"y","num":207,"id":"hymn_207","title":"ONIGBAGBO, e bu s' ayo","duration":61.063,"voices":{"male":{"file":"y-207-male.m4a","bytes":443620,"sha256":"0611d5bca5feaa5ad26fac562251f00b69aaed1339e75f7d622b278f0487f5fc","duration":61.1},"female":{"file":"y-207-female.m4a","bytes":457961,"sha256":"9da8db08ce38f1fac5f5f7278e281841861671846c8ea20960fd3b5470611e83","duration":61.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.191,"text":"ONIGBAGBO, e bu s' ayo,","marked":"Onígbàgbọ́, ẹ bú s' ayo"},{"start":2.571,"end":3.837,"text":"Ojo nla l'eyi fun wa;","marked":"Ọjọ́ ńlá l'èyí fún wa"},{"start":4.217,"end":5.436,"text":"E gbo bi awon Angeli,","marked":"Ẹ gbọ́ bí àwọn Áńgẹ́lì"},{"start":5.816,"end":7.363,"text":"Ti nfi Ogo fun Olorun,","marked":"Ti ńfi Ògo fún Ọlọ́run"},{"start":7.743,"end":9.347,"text":"Alafia, Alafia,","marked":"Àlàáfíà, Àlàáfíà"},{"start":9.727,"end":10.941,"text":"Ni fun gbogbo enia.","marked":"Ní fún gbogbo enia."}],"end":10.941},{"key":"2","start":11.891,"lines":[{"start":11.891,"end":13.649,"text":"Ki gbogbo aiye ho f' ayo;","marked":"Kí gbogbo aiye hó f' ayo"},{"start":14.029,"end":15.556,"text":"K' a f'ogo fun Olorun;","marked":"K' a f'ògo fún Ọlọ́run"},{"start":15.936,"end":17.558,"text":"Omo bibi Re l' O fun wa;","marked":"Ọmọ bíbí Rẹ l' Ó fún wa"},{"start":17.938,"end":19.373,"text":"T' a bi ninu Wundia,","marked":"T' a bí nínú Wúńdíá"},{"start":19.753,"end":21.58,"text":"En'lyanu, En' Iyanu,","marked":"En'lyanu, En' Ìyanu"},{"start":21.96,"end":23.663,"text":"Ni Omo t'a bi loni.","marked":"Ní Ọmọ t'á bí lónì."}],"end":23.663},{"key":"3","start":24.613,"lines":[{"start":24.613,"end":25.918,"text":"Ninu gbogbo rudurudu","marked":"Nínú gbogbo rúdurùdu"},{"start":26.298,"end":27.615,"text":"Ohun ibi t' okun aiye,","marked":"Ohun ibi t' okùn aiye"},{"start":27.995,"end":29.39,"text":"Ninu idamu nla ese,","marked":"Nínú ìdàmú ńlá ẹsẹ̀"},{"start":29.77,"end":31.009,"text":"L' Om' Olorun wa gba wa;","marked":"L' Om' Ọlọ́run wa gbà wá"},{"start":31.389,"end":33.049,"text":"Olugbimo, Olugbimo,","marked":"Olùgbìmọ̀, Olùgbìmọ̀"},{"start":33.429,"end":34.836,"text":"Alade alafia.","marked":"Aládé àlàáfíà."}],"end":34.836},{"key":"4","start":35.786,"lines":[{"start":35.786,"end":36.84,"text":"Olorun Olodumare;","marked":"Ọlọ́run Olódùmarè"},{"start":37.22,"end":39.202,"text":"L' a bi. bi omo titun;","marked":"L' á bí. bí ọmọ titun"},{"start":39.582,"end":42.055,"text":"Baba! Eni aiyeraiye;","marked":"Bàbá! Ẹni aiyérayé"},{"start":42.435,"end":43.955,"text":"L'odi alakoso wa:","marked":"L'ódì alákóso wa"},{"start":44.335,"end":46.437,"text":"E bu s'ayo, E bu s'ayo","marked":"Ẹ bú s'àyò, E bù s'àyò"},{"start":46.817,"end":48.185,"text":"Omo Dafidi joba.","marked":"Ọmọ Dáfídì jọba."}],"end":48.185},{"key":"5","start":49.135,"lines":[{"start":49.135,"end":50.441,"text":"O wa gba wa lowo ese,","marked":"Ó wá gbà wá lọ́wọ́ ẹ̀ṣẹ̀"},{"start":50.821,"end":51.967,"text":"O wad'onigbowo wa,","marked":"Ó wád'onígbọ̀wọ́ wa"},{"start":52.347,"end":53.66,"text":"Lati fo itegun esu,","marked":"Láti fọ ìtẹ́gun èṣù"},{"start":54.04,"end":55.31,"text":"A se ni Oga ogo:","marked":"A ṣe ní Ọ̀gá ògo"},{"start":55.69,"end":57.783,"text":"E ku ayo, e ku ayo,","marked":"Ẹ kú ayò, ẹ kú ayò"},{"start":58.163,"end":59.513,"text":"A gba wa lowo iku.","marked":"A gbà wá lọ́wọ́ ikú."}],"end":59.513}]}