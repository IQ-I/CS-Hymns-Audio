{"v":1,"coll":"y","num":384,"id":"hymn_384","title":"EMI 'bukun ti a nsin","duration":125.064,"voices":{"male":{"file":"y-384-male.m4a","bytes":902088,"sha256":"e1711133807dccc430af138a5156eea2f285f493fa5bedf19549e9abe157d778","duration":125.1},"female":{"file":"y-384-female.m4a","bytes":926245,"sha256":"75f892099a411bd31468e98910ad5269447419ed366ff079d8625b4971ac3509","duration":125.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.252,"text":"EMI 'bukun ti a nsin","marked":"Ẹ̀mí 'bùkún tí a ńsìn"},{"start":2.632,"end":4.036,"text":"Pelu baba at'oro","marked":"Pẹ̀lú bàbá àt'ọ̀rọ̀"},{"start":4.416,"end":5.484,"text":"Olorun aiyeraiye","marked":"Ọlọ́run aiyérayé"},{"start":5.864,"end":7.505,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":7.505},{"key":"2","start":8.455,"lines":[{"start":8.455,"end":9.625,"text":"Emi Mimo 'Daba orun","marked":"Ẹ̀mí Mímọ́́ 'Dábá ọ̀run"},{"start":10.005,"end":11.489,"text":"Irti ri nse lat'oke","marked":"Irti rí ńṣe lát'òkè"},{"start":11.869,"end":13.417,"text":"Emi 'ye at'ina fe","marked":"Èmi 'yé àt'íná fẹ́"},{"start":13.797,"end":15.708,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":15.708},{"key":"3","start":16.658,"lines":[{"start":16.658,"end":18.294,"text":"lsun ipa at'imo","marked":"lsun ipa àt'ìmọ́"},{"start":18.674,"end":19.861,"text":"Ogbon at'iwa mimo","marked":"Ọgbọ́n àt'ìwà mímọ́́"},{"start":20.241,"end":21.99,"text":"Oye, imoran, eru","marked":"Òye, ìmọ̀ràn, ẹ̀rù"},{"start":22.37,"end":23.966,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":23.966},{"key":"4","start":24.916,"lines":[{"start":24.916,"end":26.534,"text":"lsun ife, alafia","marked":"lsun ìfẹ́, àlàáfíà"},{"start":26.914,"end":28.898,"text":"Suru, ibisi 'gbagbo","marked":"Suru, ìbísí 'gbàgbọ́"},{"start":29.278,"end":31.436,"text":"Reti, ayo ti ki tan","marked":"Retí, ayọ̀ tí kì tán"},{"start":31.816,"end":33.605,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":33.605},{"key":"5","start":34.555,"lines":[{"start":34.555,"end":35.863,"text":"Emi afonahan ni","marked":"Ẹ̀mí afonahan ni"},{"start":36.243,"end":37.392,"text":"Emi ti nmu 'mole wa","marked":"Èmi tí nmu 'mọ́lẹ̀ wà"},{"start":37.772,"end":38.999,"text":"Emi agbara gbogbo","marked":"Ẹ̀mí agbára gbogbo"},{"start":39.379,"end":41.166,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":41.166},{"key":"6","start":42.116,"lines":[{"start":42.116,"end":43.391,"text":"'Wo t'o mu Wundia bi,","marked":"'Wò t'ó mú Wúńdíá bí"},{"start":43.771,"end":45.033,"text":"Eni t'orun t'aiye mbo","marked":"Ẹni t'ọrùn t'áiye ḿbọ"},{"start":45.413,"end":47.058,"text":"T'a ran lati tun wa bi","marked":"T'á rán láti tún wá bí"},{"start":47.438,"end":49.176,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":49.176},{"key":"7","start":50.126,"lines":[{"start":50.126,"end":51.736,"text":"'Wo ti Jesu t'oke ran","marked":"'Wò tí Jésù t'òkè rán"},{"start":52.116,"end":53.696,"text":"Wa tu enia Re ninu","marked":"Wá tu enia Rẹ̀ nínú"},{"start":54.076,"end":55.26,"text":"Ki nwon ma ba nikan wa,","marked":"Kí nwọn má bà nìkan wà"},{"start":55.64,"end":57.583,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":57.583},{"key":"8","start":58.533,"lines":[{"start":58.533,"end":60.124,"text":"Wo t'o nf'ore kun ljo","marked":"Wo t'ó ńf'ọ̀rẹ́ kún ljọ"},{"start":60.504,"end":61.932,"text":"T'o nfi ife Baba han","marked":"T'ó ńfi ìfẹ́ Bàbá hàn"},{"start":62.312,"end":64.207,"text":"T'O nmu k'o ma ri Jesu","marked":"T'ó nmu k'ó ma rí Jésù"},{"start":64.587,"end":66.346,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":66.346},{"key":"9","start":67.296,"lines":[{"start":67.296,"end":68.596,"text":"F'ebun meje Re fun ni","marked":"F'ẹ̀bùn méje Rẹ fún ni"},{"start":68.976,"end":70.202,"text":"Ogbon lati m'Olorun","marked":"Ọgbọ́n láti m'Ọlọ́run"},{"start":70.582,"end":71.73,"text":"lpa lati ko ota","marked":"lpa láti kọ́ ọ̀tá"},{"start":72.11,"end":73.852,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":73.852},{"key":"10","start":74.802,"lines":[{"start":74.802,"end":76.107,"text":"Pa ese run lokan wa,","marked":"Pa ẹ̀ṣẹ̀ run lọ́kàn wa"},{"start":76.487,"end":77.49,"text":"To ife wa si ona","marked":"To ìfẹ́ wa sí ọ̀nà"},{"start":77.87,"end":79.738,"text":"Gba ba nse O, mu suru","marked":"Gba bá ńṣe O, mú ṣùrù"},{"start":80.118,"end":81.955,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":81.955},{"key":"11","start":82.905,"lines":[{"start":82.905,"end":84.298,"text":"Gbe wa dide b'a subu","marked":"Gbé wa dìde b'á ṣubú"},{"start":84.678,"end":85.967,"text":"Ati nigba idanwo","marked":"Àti nígbà ìdánwò"},{"start":86.347,"end":87.814,"text":"Sa pe wa pada pele","marked":"Sá pè wá padà pẹ̀lẹ́"},{"start":88.194,"end":89.832,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":89.832},{"key":"12","start":90.782,"lines":[{"start":90.782,"end":92.697,"text":"Wa, k'O mu ailera le","marked":"Wá, k'Ó mú àìlera le"},{"start":93.077,"end":94.421,"text":"F'igboiya fun alare","marked":"F'igboiya fún aláre"},{"start":94.801,"end":96.641,"text":"Ko wa l'oro t'a o so","marked":"Kò wá l'ọrọ t'á ò sọ"},{"start":97.021,"end":99.072,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":99.072},{"key":"13","start":100.022,"lines":[{"start":100.022,"end":101.392,"text":"Wa ran okan wa lowo","marked":"Wá ran ọkàn wa lọ́wọ́"},{"start":101.772,"end":102.976,"text":"Lati mo otito Re","marked":"Láti mọ òtítọ́́ Rẹ"},{"start":103.356,"end":104.558,"text":"Ki' fe wa Ie ma gbona","marked":"Kí' fẹ́ wá lè má gbóná"},{"start":104.938,"end":106.73,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":106.73},{"key":"14","start":107.68,"lines":[{"start":107.68,"end":108.903,"text":"Pa wa mo l'ona toro","marked":"Pa wá mọ́ l'ọ́nà tọ́rọ́"},{"start":109.283,"end":110.737,"text":"Ba wa wi nigb'a nsako","marked":"Bá wa wí nígb'á nsako"},{"start":111.117,"end":112.341,"text":"Ba wa bebe l'adura","marked":"Bá wa bẹ̀bẹ̀ l'àdúrà"},{"start":112.721,"end":114.788,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."}],"end":114.788},{"key":"15","start":115.738,"lines":[{"start":115.738,"end":116.706,"text":"Eni Mimo Olufe","marked":"Ẹni Mímọ́́ Olùfẹ́"},{"start":117.086,"end":118.551,"text":"Wa gbe inu okan wa","marked":"Wá gbé inú ọkàn wa"},{"start":118.931,"end":120.351,"text":"Ma fi wa sile titi","marked":"Má fi wá sílẹ̀ títí"},{"start":120.731,"end":122.424,"text":"Emi Mimo, gbo tiwa.","marked":"Ẹ̀mí Mímọ́́, gbọ́ tiwa."},{"start":122.804,"end":123.515,"text":"Amin.","marked":"Àmín."}],"end":123.515}]}