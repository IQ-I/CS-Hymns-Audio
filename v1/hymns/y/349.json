{"v":1,"coll":"y","num":349,"id":"hymn_349","title":"O ti lo, Awosanma","duration":90.91,"voices":{"male":{"file":"y-349-male.m4a","bytes":674189,"sha256":"9104ca0f76e6e258aa75bcd89aea32a1364ba55da4b232f345e1f28f4c608caf","duration":91.0},"female":{"file":"y-349-female.m4a","bytes":701918,"sha256":"09a674c37a4417443d8a884337b5719feb4b422c02e83da8d4172c9bcf8ec8e3","duration":91.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.752,"text":"O ti lo, Awosanma","marked":"Ó ti lọ, Àwọsánmà"},{"start":2.132,"end":3.345,"text":"Ti gba kuro loju wa","marked":"Ti gbà kúrò lójú wa"},{"start":3.725,"end":5.196,"text":"Soke orun nibiti","marked":"Sókè ọ̀run níbìtì"},{"start":5.576,"end":6.888,"text":"Oju wa ko le tele","marked":"Ojú wa kò le tẹ́lẹ̀"},{"start":7.268,"end":8.736,"text":"Oti kuro l'aiye yi","marked":"Ọtí kúrò l'áiye yí"},{"start":9.116,"end":10.26,"text":"O ti de ibi mimo","marked":"Ó ti dé ibi mímọ́́"},{"start":10.64,"end":12.009,"text":"Lala at'irora tan","marked":"Làlá àt'ìrora tán"},{"start":12.389,"end":13.942,"text":"lja tan, O ti segun.","marked":"lja tán, Ó ti ṣẹ́gun."}],"end":13.942},{"key":"2","start":14.892,"lines":[{"start":14.892,"end":16.845,"text":"O ti lo, Awa si wa","marked":"Ó ti lọ, Àwa sì wá"},{"start":17.225,"end":18.57,"text":"L' aiye ese at'iku","marked":"L' aiye ẹsẹ àt'ikú"},{"start":18.95,"end":20.24,"text":"A ni 'se lati se fun","marked":"A ní 'ṣe láti ṣe fún"},{"start":20.62,"end":22.268,"text":"L'aiye t'o ti fi sile","marked":"L'áiye t'ó ti fi sílẹ̀"},{"start":22.648,"end":23.987,"text":"K'a si tele ona Re:","marked":"K'á sì tẹ̀lé ọ̀nà Rẹ"},{"start":24.367,"end":25.619,"text":"K'a tele tokantokan","marked":"K'á tẹ̀lé tọkàntọkàn"},{"start":25.999,"end":27.354,"text":"K'a s'ota re di ore","marked":"K'á s'ọ́tà rẹ di ọ̀rẹ́"},{"start":27.734,"end":29.536,"text":"K'a fi Kristi han n'iwa wa.","marked":"K'á fi Kristi han n'ìwà wa."}],"end":29.536},{"key":"3","start":30.486,"lines":[{"start":30.486,"end":32.282,"text":"O ti lo, On ti wipe","marked":"Ó ti lọ, Ón ti wípé"},{"start":32.662,"end":33.959,"text":"\"O dara ki Emi lo\"","marked":"Ó dára kí Èmi lọ"},{"start":34.339,"end":35.707,"text":"Ni ara sa l'o ya wa","marked":"Ní ara sá l'ó yá wa"},{"start":36.087,"end":37.516,"text":"Sugbon or'ofe Re wa","marked":"Ṣùgbọ́n or'ọ̀fẹ́ Rẹ wà"},{"start":37.896,"end":39.01,"text":"On ni awa ko ri mo","marked":"Ọ̀n ni àwa kò rí mọ́"},{"start":39.39,"end":40.513,"text":"A ni Olutunu re","marked":"A ní Olùtùnú rẹ̀"},{"start":40.893,"end":42.14,"text":"Emi Re si je tiwa","marked":"Ẹ̀mí Rẹ̀ sì jẹ́ tiwa"},{"start":42.52,"end":44.031,"text":"On ns'agbara wa d'otun.","marked":"On ns'ágbára wá d'ọ̀tun."}],"end":44.031},{"key":"4","start":44.981,"lines":[{"start":44.981,"end":47.209,"text":"O ti lo, L'ona kanna","marked":"Ó ti lọ, L'ọ́nà kanná"},{"start":47.589,"end":49.072,"text":"K'o ye k'ljo Re ma lo","marked":"K'ó yé k'ljo Rẹ má lọ"},{"start":49.452,"end":50.664,"text":"K'a gbagbe ohun ehin","marked":"K'á gbàgbé ohun ẹ̀hìn"},{"start":51.044,"end":52.34,"text":"K'a si ma te si waju","marked":"K'á sì má tẹ̀ si waju"},{"start":52.72,"end":54.008,"text":"Oro re ni 'mole wa","marked":"Ọ̀rọ̀ rẹ̀ ni 'mọ́lẹ̀ wà"},{"start":54.388,"end":56.07,"text":"Titi de opin aiye","marked":"Títí dé òpin aiye"},{"start":56.45,"end":57.725,"text":"Nibiti oto Re wa","marked":"Níbitì ọ̀tọ̀ Rẹ̀ wà"},{"start":58.105,"end":59.6,"text":"Y'o pese fun alaini.","marked":"Y'ó pèsè fún aláìní."}],"end":59.6},{"key":"5","start":60.55,"lines":[{"start":60.55,"end":62.455,"text":"O ti lo, Lekan si i,","marked":"Ó ti lọ, Lẹ́kàn sí i"},{"start":62.835,"end":64.052,"text":"A o tun f'oju wa ri","marked":"A ò tún f'ojú wa rí"},{"start":64.432,"end":65.956,"text":"O wa b'o ti wa l'aiye","marked":"Ó wá b'ó ti wá l'aiye"},{"start":66.336,"end":67.765,"text":"Gege b'o ti wa l'aiye","marked":"Gẹ́gẹ́ b'ó ti wà l'aiye"},{"start":68.145,"end":69.536,"text":"N'nu bugbe t'o wa nibe","marked":"N'nu bugbe t'ó wà níbẹ̀"},{"start":69.916,"end":71.33,"text":"Y'o pese aye fun wa","marked":"Y'ó pèsè àyè fún wa"},{"start":71.71,"end":73.098,"text":"Ninu aiye ti mbo wa,","marked":"Nínú aiye tí ḿbọ̀ wá"},{"start":73.478,"end":74.801,"text":"A o  j'okan pelu Re.","marked":"A ò j'ọ̀kan pẹ̀lú Rẹ."}],"end":74.801},{"key":"6","start":75.751,"lines":[{"start":75.751,"end":77.56,"text":"O ti lo, Fun ire wa","marked":"Ó ti lọ, Fún ire wa"},{"start":77.94,"end":79.081,"text":"Eje a duro de","marked":"Ẹ̀jẹ̀ á dúró dè"},{"start":79.461,"end":81.063,"text":"Ojinde, ko si nihin","marked":"Òjíǹde, kò sí níhìn"},{"start":81.443,"end":82.63,"text":"O ti goke re orun","marked":"Ó ti gòkè re ọ̀run"},{"start":83.01,"end":84.379,"text":"Je k'a gb'okan wa soke","marked":"Jẹ k'á gb'ọkàn wa sókè"},{"start":84.759,"end":86.165,"text":"Sibiti Jesu ti lo","marked":"Síbìtì Jésù ti lọ"},{"start":86.545,"end":87.619,"text":"Si odo Olorun wa,","marked":"Sí ọ̀dọ̀ Ọlọ́run wa"},{"start":87.999,"end":89.36,"text":"Nibe l'alafia wa.","marked":"Níbẹ̀ l'àlàáfíà wà."}],"end":89.36}]}