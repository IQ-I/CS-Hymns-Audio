{"v":1,"coll":"y","num":60,"id":"hymn_60","title":"AWA Egbe Kerubu","duration":57.435,"voices":{"male":{"file":"y-60-male.m4a","bytes":402410,"sha256":"172d2f936acc1a91cbd23eb6135a5978c13cccc903f9aae45663fee5074fca6a","duration":57.5},"female":{"file":"y-60-female.m4a","bytes":410858,"sha256":"94275fc1d4e3074035ac75661683921847359c059dd11f3220b61cf63b6453e1","duration":57.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.598,"text":"AWA Egbe Kerubu","marked":"Àwa Ẹgbẹ́ Kérúbù"},{"start":1.978,"end":3.511,"text":"Ati Serafu laiye","marked":"Àti Séráfù láìyẹ"},{"start":3.891,"end":5.144,"text":"Awa mbebe fun 'ranwo","marked":"Àwa mbẹ̀bẹ̀ fún 'rànwọ́"},{"start":5.524,"end":6.644,"text":"Agbara Emi Mimo.","marked":"Agbára Ẹ̀mí Mímọ́́."}],"end":6.644},{"key":"CHORUS","start":7.594,"lines":[{"start":7.594,"end":9.087,"text":"A! Baba sanu fun wa","marked":"A! Bàbá sanu fún wa"},{"start":9.467,"end":10.941,"text":"ko dari ese ji wa.","marked":"kò dárí ẹ̀ṣẹ̀ jì wá."}],"end":10.941},{"key":"2","start":11.891,"lines":[{"start":11.891,"end":13.093,"text":"Ki fitila Re ma ku","marked":"Kí fìtílà Rẹ má kú"},{"start":13.473,"end":15.217,"text":"Ninu Eghe Serafu","marked":"Nínú Eghe Séráfù"},{"start":15.597,"end":17.028,"text":"Ki gbogbo isesi wa","marked":"Kí gbogbo ìṣesí wa"},{"start":17.408,"end":18.805,"text":"Fi wa han bi Omo Re.","marked":"Fi wá hàn bí Ọmọ Rẹ."}],"end":18.805},{"key":"3","start":19.755,"lines":[{"start":19.755,"end":21.145,"text":"Mase ta wa nu kuro","marked":"Masẹ̀ ta wá nù kúrò"},{"start":21.525,"end":22.568,"text":"Iwo olugbala wa","marked":"Ìwọ Olùgbàlà wa"},{"start":22.948,"end":24.331,"text":"K'awa ma ba sako Io,","marked":"K'àwa má bá ṣáko lọ"},{"start":24.711,"end":26.112,"text":"Mu wa rIn ona tire.","marked":"Mú wa rln ọ̀nà tìrẹ."}],"end":26.112},{"key":"4","start":27.062,"lines":[{"start":27.062,"end":28.357,"text":"Jehovah Jire Baba,","marked":"Jehovah Jíre Bàbá"},{"start":28.737,"end":29.919,"text":"Pese f'awon alaini","marked":"Pèsè f'àwọn aláìní"},{"start":30.299,"end":31.755,"text":"At'awon ti ko ri se","marked":"Àt'àwọn tí kò rí ṣe"},{"start":32.135,"end":33.532,"text":"Masai ranti won loni.","marked":"Masai rántí wọn lónì."}],"end":33.532},{"key":"5","start":34.482,"lines":[{"start":34.482,"end":35.73,"text":"Ese wa ti papo ju,","marked":"Ẹsẹ̀ wa ti papọ̀ jù"},{"start":36.11,"end":37.584,"text":"Bi yanrin eti okun","marked":"Bí yanrìn etí òkun"},{"start":37.964,"end":39.211,"text":"Awa nfe 'mularada","marked":"Àwa ńfẹ́ 'múláradá"},{"start":39.591,"end":40.927,"text":"lwenumo ese wa.","marked":"lwenumo ẹ̀ṣẹ̀ wa."}],"end":40.927},{"key":"6","start":41.877,"lines":[{"start":41.877,"end":43.416,"text":"Jehovah Emmanueli,","marked":"Jehovah Ẹmmanuẹ́lì"},{"start":43.796,"end":44.896,"text":"Iwo ni ireti wa,","marked":"Ìwọ ni ìrètí wa"},{"start":45.276,"end":46.737,"text":"Mase je koju ti wa","marked":"Masẹ̀ jẹ́ kójú tì wá"},{"start":47.117,"end":48.495,"text":"L'ojo nla 'dajo.","marked":"L'ọjọ́ ńlá 'dájọ́."}],"end":48.495},{"key":"7","start":49.445,"lines":[{"start":49.445,"end":50.509,"text":"Odagutan Olorun","marked":"Ọ̀dàgùtàn Ọlọ́run"},{"start":50.889,"end":52.321,"text":"Baba at'Emi Mimo","marked":"Bàbá àt'Ẹ̀mí Mímọ́́"},{"start":52.701,"end":53.873,"text":"We ma mo patapata,","marked":"Wẹ̀ ma mọ́ pátápátá"},{"start":54.253,"end":55.885,"text":"Ko to kuro laiye yi.","marked":"Kó tó kúrò láìyé yí."}],"end":55.885}]}