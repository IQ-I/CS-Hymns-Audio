{"v":1,"coll":"y","num":852,"id":"hymn_852","title":"GBAT' agbara Olorun de","duration":41.659,"voices":{"male":{"file":"y-852-male.m4a","bytes":296944,"sha256":"1dbac878d84fa273156f0f386cb52c44b0c44b54c763a6f044dcffbc61f82db2","duration":41.7},"female":{"file":"y-852-female.m4a","bytes":306773,"sha256":"59eef4b87f9cdb964cd3259ef23166a530a8d8bafc83e9085b378d9c90b81c8b","duration":41.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.037,"text":"GBAT' agbara Olorun de","marked":"Gbat' agbára Ọlọ́run dé"},{"start":2.417,"end":3.915,"text":"Li ojo Pentikosti","marked":"Li ọjọ́ Pentikosti"},{"start":4.295,"end":5.819,"text":"Sa if'oju s'ona pari","marked":"Sa if'ojú s'ọ́nà parí"},{"start":6.199,"end":7.303,"text":"'Tori won ri Emi gba.","marked":"'Torí wọn rí Ẹ̀mí gbà."}],"end":7.303},{"key":"CHORUS","start":8.253,"lines":[{"start":8.253,"end":9.806,"text":"Ran agbara, Oluwa","marked":"Ran agbára, Olúwa"},{"start":10.186,"end":11.789,"text":"Ran agbara, Oluwa","marked":"Ran agbára, Olúwa"},{"start":12.169,"end":13.731,"text":"Ran agbara, Oluwa","marked":"Ran agbára, Olúwa"},{"start":14.111,"end":15.857,"text":"Ki O si baptis'wa.","marked":"Kí Ó sí baptis'wa."}],"end":15.857},{"key":"2","start":16.807,"lines":[{"start":16.807,"end":18.12,"text":"Ela ahon ina ba le won","marked":"Ẹlà ahọ́n iná bá le wọ́n"},{"start":18.5,"end":19.978,"text":"Won si wasu oro na","marked":"Wọ́n sì wasu ọ̀rọ̀ ná"},{"start":20.358,"end":21.812,"text":"Opolopo eeya gbagbo","marked":"Ọ̀pọ̀lọpọ̀ eeya gbàgbọ́"},{"start":22.192,"end":23.702,"text":"Won yipada s'Olorun.","marked":"Wọ́n yípadà s'Ọlọ́run."}],"end":23.702},{"key":"3","start":24.652,"lines":[{"start":24.652,"end":26.038,"text":"A nw'ona fun Emi Mimo","marked":"A nW'ọ́nà fún Ẹ̀mí Mímọ́́"},{"start":26.418,"end":27.68,"text":"Gbogbo wa f'ohun sokan","marked":"Gbogbo wa f'ohun sọ́kàn"},{"start":28.06,"end":29.77,"text":"Mu 'leri na se, Oluwa","marked":"Mu 'lérí ná ṣe, Olúwa"},{"start":30.15,"end":31.26,"text":"Ti a se nin'oro Re.","marked":"Tí a ṣe nín'ọ̀rọ̀ Rẹ."}],"end":31.26},{"key":"4","start":32.21,"lines":[{"start":32.21,"end":33.583,"text":"Jo fi agbara Re kun wa","marked":"Jọ fi agbára Rẹ̀ kún wa"},{"start":33.963,"end":35.432,"text":"Fun wa ni 'bukun ta nfe","marked":"Fún wa ní 'bùkún ta ńfẹ́"},{"start":35.812,"end":37.398,"text":"Fi ogo Re kun okan wa","marked":"Fi ògo Rẹ kún ọkàn wa"},{"start":37.778,"end":39.202,"text":"Ba ti nfi 'gbagbo bebe.","marked":"Bá ti ńfi 'gbàgbọ́ bẹbẹ̀."},{"start":39.582,"end":40.109,"text":"Amin.","marked":"Àmín."}],"end":40.109}]}