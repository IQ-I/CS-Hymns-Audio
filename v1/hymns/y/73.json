{"v":1,"coll":"y","num":73,"id":"hymn_73","title":"Mimo, Mimo, Mimo Olodumare","duration":45.58,"voices":{"male":{"file":"y-73-male.m4a","bytes":335153,"sha256":"c512f79a632ad88e2632864882a8067af4ca6b0f61148712aa666c7b6c1022c3","duration":45.6},"female":{"file":"y-73-female.m4a","bytes":334170,"sha256":"6864298b73d72878d3416f4a09f59afb5e5f75681aa1879bff93cdb894de2042","duration":45.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.44,"text":"Mimo, Mimo, Mimo Olodumare,","marked":"Mímọ́́, Mímọ́́, Mímọ́ Olódùmarè"},{"start":2.82,"end":5.185,"text":"Ni kutukutu ni 'wo o gbo orin wa,","marked":"Ní kùtùkùtù ni 'wò ò gbọ́ orin wa"},{"start":5.565,"end":8.514,"text":"Mimo, Mimo, Mimo! Oniyonu julo,","marked":"Mímọ́́, Mímọ́́, Mímọ́́! Oníyọnu jùlọ"},{"start":8.894,"end":10.61,"text":"Ologo meta lai Olubukun.","marked":"Ológo mẹ́ta láì Olùbùkún."}],"end":10.61},{"key":"2","start":11.56,"lines":[{"start":11.56,"end":15.151,"text":"Mimo, Mimo, Mimo awon t'orun nyin","marked":"Mímọ́́, Mímọ́́, Mímọ́ àwọn t'ọrùn nyin"},{"start":15.531,"end":17.684,"text":"Nwon nfi ade wura won lele y'ite ka,","marked":"Nwọ̀n ńfi adé wúrà wọn lélẹ̀ y'ite ka"},{"start":18.064,"end":20.404,"text":"Kerubim Serafim nwole niwaju Re,","marked":"Kerubim Serafim ńwọlẹ̀ níwájú Rẹ̀"},{"start":20.784,"end":22.773,"text":"Wo to ti wa to si wa titi lai.","marked":"Wọ́ tó ti wà tó sì wà títí láì."}],"end":22.773},{"key":"3","start":23.723,"lines":[{"start":23.723,"end":25.97,"text":"Mimo, Mimo, Mimo, Olodumare","marked":"Mímọ́́, Mímọ́́, Mímọ́́, Olódùmarè"},{"start":26.35,"end":28.426,"text":"Bi oju elese ko le ri Ogo Re,","marked":"Bí ojú ẹlẹ́ṣẹ̀ kò lè rí Ògo Rẹ"},{"start":28.806,"end":30.917,"text":"lwo nikan lo mo ko tun si elomi","marked":"lwo nìkan ló mọ̀ kò tún sí ẹlòmí"},{"start":31.297,"end":33.214,"text":"Pipe 'nu agbara ati n'ife.","marked":"Pípẹ́ 'nu agbára àti n'ífẹ́."}],"end":33.214},{"key":"4","start":34.164,"lines":[{"start":34.164,"end":36.34,"text":"Mimo, Mimo, Mimo Olodumare,","marked":"Mímọ́́, Mímọ́́, Mímọ́ Olódùmarè"},{"start":36.72,"end":38.762,"text":"Gbogbo ise Re n'ile l'oke lo nyin O,","marked":"Gbogbo iṣẹ́ Rẹ n'ilẹ̀ l'òkè ló nyin O"},{"start":39.142,"end":41.969,"text":"Mimo, Mimo, Mimo Oniyonu julo","marked":"Mímọ́́, Mímọ́́, Mímọ́́ Oníyọnu jùlọ"},{"start":42.349,"end":44.03,"text":"Ologo meta lai Olubukun.","marked":"Ológo mẹ́ta láì Olùbùkún."}],"end":44.03}]}