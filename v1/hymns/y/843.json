{"v":1,"coll":"y","num":843,"id":"hymn_843","title":"OLORUN Olodumare","duration":65.165,"voices":{"male":{"file":"y-843-male.m4a","bytes":472484,"sha256":"06029b9d525a12cb89695da4f2ff787ea2d63b159baf923d1ca34334d236a069","duration":65.2},"female":{"file":"y-843-female.m4a","bytes":481601,"sha256":"d21f2cf7ce18b33d573fbd0fd3c451614dad18a619b879ba01b2552bc3d12b9a","duration":65.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.38,"text":"OLORUN Olodumare","marked":"Ọlọ́run Olódùmarè"},{"start":1.76,"end":3.239,"text":"Wo n'iyin on ope ye fun","marked":"Wò ń'ìyìn ọ́n ọpẹ́ yẹ fún"},{"start":3.619,"end":5.162,"text":"Wo ti ngbe arin Kerubu","marked":"Wo ti ńgbé àrin Kérúbù"},{"start":5.542,"end":7.121,"text":"Ran tansan ife re si wa.","marked":"Rán tansan ìfẹ́ rẹ sí wa."}],"end":7.121},{"key":"CHORUS","start":8.071,"lines":[{"start":8.071,"end":9.934,"text":"Ogo, Ogo, f'Oba Olore","marked":"Ògo, Ògo, f'Ọba Olọ́rẹ́"},{"start":10.314,"end":11.609,"text":"Iyin Re duro titi lai.","marked":"Ìyìn Rẹ̀ dúró títí láì."}],"end":11.609},{"key":"2","start":12.559,"lines":[{"start":12.559,"end":14.192,"text":"Olorun Mose Orimolade","marked":"Ọlọ́run Mósè Orímọládé"},{"start":14.572,"end":15.88,"text":"A dupe fun lranlowo re","marked":"A dúpẹ́ fún lranlowo rẹ̀"},{"start":16.26,"end":18.105,"text":"T'o f'idi Egbe Serafu sole","marked":"T'ó f'ìdí Ẹgbẹ́ Séráfù sọlẹ̀"},{"start":18.485,"end":19.93,"text":"Lori Apat'ayeraye.","marked":"Lórí Apat'ayérayé."}],"end":19.93},{"key":"3","start":20.88,"lines":[{"start":20.88,"end":22.226,"text":"Gba 'yonu de b'awosanma","marked":"Gba 'yonu de b'àwọsánmà"},{"start":22.606,"end":24.466,"text":"T'o su dudu t'o nsan ara","marked":"T'ó ṣú dùdù t'ó nsan ara"},{"start":24.846,"end":26.283,"text":"O duro ti wa larin re","marked":"Ó dúró tì wá lárin rẹ̀"},{"start":26.663,"end":28.237,"text":"O si mu wa bori dandan.","marked":"Ó sì mú wa borí dandan."}],"end":28.237},{"key":"4","start":29.187,"lines":[{"start":29.187,"end":30.579,"text":"Ogun ota dide si wa","marked":"Ogun ọ̀tá dìde sí wa"},{"start":30.959,"end":32.8,"text":"Aiye on esu ndena wa","marked":"Àìyẹ́ ọ́n èṣù ndena wà"},{"start":33.18,"end":34.578,"text":"O mu wa la gbogbo re koja","marked":"Ó mú wa la gbogbo ré kọjá"},{"start":34.958,"end":36.392,"text":"Ogo, iyin f'Oruko Re.","marked":"Ògo, ìyìn f'Orúkọ Rẹ."}],"end":36.392},{"key":"5","start":37.342,"lines":[{"start":37.342,"end":39.059,"text":"Obangiji, Alaranse Eda","marked":"Obangiji, Alárànṣe Ẹ̀dá"},{"start":39.439,"end":40.916,"text":"Pa wa mo n'nu igbi aiye","marked":"Pa wá mò ń'nú ìgbì aiye"},{"start":41.296,"end":43.621,"text":"K'alafia ipese, ibukun","marked":"K'àlàáfíà ìpèsè, ìbùkún"},{"start":44.001,"end":45.551,"text":"Je ti wa I'ojo aiye wa.","marked":"Jẹ́ ti wà l'ọjọ́ aiye wa."}],"end":45.551},{"key":"6","start":46.501,"lines":[{"start":46.501,"end":48.814,"text":"JAH-JEHOVAH NISSI Oba wa,","marked":"Jah-Jehovah Nissi Ọba wa"},{"start":49.194,"end":50.453,"text":"lwo ni Oba Olusegun","marked":"lwo ni Ọba Olùṣègùn"},{"start":50.833,"end":52.787,"text":"Masai f 'isegun fun Alagba wa,","marked":"Masai f 'íṣègùn fún Alàgbà wa"},{"start":53.167,"end":54.773,"text":"Fun Baba Aladura wa.","marked":"Fún Bàbá Alàdúrà wa."}],"end":54.773},{"key":"7","start":55.723,"lines":[{"start":55.723,"end":57.434,"text":"Olorun Mose Orimolade","marked":"Ọlọ́run Mósè Orímọládé"},{"start":57.814,"end":59.33,"text":"Gba iyin ati ope wa","marked":"Gba ìyìn àti ọpẹ́ wa"},{"start":59.71,"end":61.303,"text":"Ka le yo titi niwaju Re","marked":"Ká lè yọ̀ títí níwájú Rẹ"},{"start":61.683,"end":63.616,"text":"L'oke orun l'ojo 'kehin.","marked":"L'òkè ọ̀run l'ọjọ́ 'kẹhin."}],"end":63.616}]}