{"v":1,"coll":"y","num":300,"id":"hymn_300","title":"AGBELEBU ni ere mi","duration":24.692,"voices":{"male":{"file":"y-300-male.m4a","bytes":169777,"sha256":"42a17b8a7bd3734a5aa063d5949d7598a69d89eb5a3b2eeb4ff99378ea1460ed","duration":24.7},"female":{"file":"y-300-female.m4a","bytes":177625,"sha256":"71d5eded4716f60374bcd09cda267f3de03760554a2d71262f9a817fbd0378f7","duration":24.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.998,"text":"AGBELEBU ni ere mi","marked":"Àgbélébùú ni èrè mi"},{"start":2.378,"end":3.631,"text":"Nibe ni a rubo fun mi","marked":"Níbẹ̀ ni a rúbọ fún mi"},{"start":4.011,"end":6.025,"text":"Nibe l'a kan Oluwa mo","marked":"Níbẹ̀ l'á kan Olúwa mọ́"},{"start":6.405,"end":7.664,"text":"Nibe l'Olugbala mi ku.","marked":"Níbẹ̀ l'Olùgbàlà mi kú."}],"end":7.664},{"key":"2","start":8.614,"lines":[{"start":8.614,"end":9.694,"text":"Kini o le fa okan Re","marked":"Kíni ó lè fa ọkàn Rẹ"},{"start":10.074,"end":11.362,"text":"Lati teri gba iya mi?","marked":"Láti tẹ́rí gba ìyá mi?"},{"start":11.742,"end":13.557,"text":"Aimohun na daju l'o se","marked":"Àìmọ̀hún nà dájú l'ó ṣe"},{"start":13.937,"end":15.176,"text":"T'okan mi tutu be si O.","marked":"T'ọkàn mi tutù bẹ̀ sí O."}],"end":15.176},{"key":"3","start":16.126,"lines":[{"start":16.126,"end":17.475,"text":"Aifohun na oju ti mi","marked":"Àìfohùn na ojú tì mí"},{"start":17.855,"end":19.485,"text":"Niwaju Jesu mimo mi","marked":"Níwájú Jésù mímọ́́ mi"},{"start":19.865,"end":21.278,"text":"T'o ta 'je Re sile fun mi,","marked":"T'ó ta 'jẹ Rẹ̀ sílẹ̀ fún mi"},{"start":21.658,"end":23.142,"text":"'Tori o fe mi l'afeju.","marked":"'Torí ò fẹ́ mi l'afẹ́jú."}],"end":23.142}]}