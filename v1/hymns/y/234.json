{"v":1,"coll":"y","num":234,"id":"hymn_234","title":"OLUWA ati 'gbala wa","duration":35.963,"voices":{"male":{"file":"y-234-male.m4a","bytes":269477,"sha256":"2b15457da9b4d07bc42e4645580de510a6ca8db5143b90f912e9c4f5daac675b","duration":36.0},"female":{"file":"y-234-female.m4a","bytes":276731,"sha256":"ba0b46440cef179c7832086f80ce03107d55ad09cdaac62b767e0e1a87c526df","duration":36.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.965,"text":"OLUWA ati 'gbala wa","marked":"Olúwa àti 'gbàlà wa"},{"start":2.345,"end":3.849,"text":"Amona at'agbara wa","marked":"Amọ̀nà àt'agbára wa"},{"start":4.229,"end":6.2,"text":"L'o ko wa jo l'ale oni","marked":"L'ó kó wa jọ l'álẹ̀ òní"},{"start":6.58,"end":8.157,"text":"Jek' a gbe Ebeneseri ro","marked":"Jẹ́k' á gbé Ebẹ́nẹ́sẹ̀rí ró"},{"start":8.537,"end":10.185,"text":"Odun t'a ti le koja","marked":"Ọdún t'á ti le kọjá"},{"start":10.565,"end":12.279,"text":"Ni On f'ore Re de lade","marked":"Ni On f'ọ̀rẹ́ Rẹ dé ládé"},{"start":12.659,"end":14.302,"text":"Otun l'anu Re l'Owuro","marked":"Ọ̀tún l'ánú Rẹ l'Òwúrọ̀"},{"start":14.682,"end":16.475,"text":"Nje ki ope wa ma po si!","marked":"Ǹjẹ́ kí ọpẹ́ wa má pọ̀ sí!"}],"end":16.475},{"key":"2","start":17.425,"lines":[{"start":17.425,"end":19.389,"text":"Jesus t'o joko lor' ite","marked":"Jésù t'ó jókò lór' ìtẹ́"},{"start":19.769,"end":21.309,"text":"L'a fi Halleluyah wa fun","marked":"L'á fi Hallelúyà wa fún"},{"start":21.689,"end":23.042,"text":"Nitori e nikansoso","marked":"Nítorí ẹ nìkanṣoṣo"},{"start":23.422,"end":25.056,"text":"L'a da wa si lati korin","marked":"L'á dá wa sí láti kọrin"},{"start":25.436,"end":26.763,"text":"Ran wa lowo lati kanu","marked":"Ràn wá lọ́wọ́ láti kánú"},{"start":27.143,"end":29.178,"text":"Ese odun t'o ti koja","marked":"Ẹsẹ̀ ọdún t'ó ti kọjá"},{"start":29.558,"end":31.115,"text":"Fun ni k'a lo eyi ti mbo","marked":"Fún ní k'á lo èyí ti ḿbọ"},{"start":31.495,"end":33.261,"text":"S'iyin Re ju odun t'o lo.","marked":"S'ìyìn Rẹ̀ ju ọdún t'ó lọ."},{"start":33.641,"end":34.413,"text":"Amin.","marked":"Àmín."}],"end":34.413}]}