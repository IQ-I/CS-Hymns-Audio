{"v":1,"coll":"y","num":289,"id":"hymn_289","title":"'WO t'o ku ni Kalfari","duration":45.843,"voices":{"male":{"file":"y-289-male.m4a","bytes":319392,"sha256":"fedbfaa7a9ddc9c57d1b3d19b50ea79abcfa07f690ba92faf3c2afcc5544ebe5","duration":45.9},"female":{"file":"y-289-female.m4a","bytes":331960,"sha256":"bda88aad1b541c80f4506a269ae88ae543dd9c2f3218e3dff951445b1b88e1b5","duration":45.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.801,"text":"'WO t'o ku ni Kalfari","marked":"'Wò t'ó kù ní Kalfárì"},{"start":2.181,"end":3.667,"text":"Wo t'o mbebe f'elese","marked":"Wo t'ó ḿbẹ̀bẹ̀ f'ẹ́lẹ́sẹ̀"},{"start":4.047,"end":5.816,"text":"Ran mi lowo, nigb'aini","marked":"Ràn mí lọ́wọ́, nígb'àìní"},{"start":6.196,"end":7.629,"text":"Jesu, gbo 'gbe mi.","marked":"Jésù, gbọ́ 'gbé mi."}],"end":7.629},{"key":"2","start":8.579,"lines":[{"start":8.579,"end":9.628,"text":"Ninu ibanuje mi,","marked":"Nínú ìbànújẹ́ mi"},{"start":10.008,"end":11.237,"text":"At'okan aigbagbo mi","marked":"Àt'ọkàn àìgbàgbọ́ mi"},{"start":11.617,"end":12.775,"text":"Em'olori elese","marked":"Em'olórí ẹlẹ́sẹ̀"},{"start":13.155,"end":14.139,"text":"Gb'oju mi si O.","marked":"Gb'ojú mi sí O."}],"end":14.139},{"key":"3","start":15.089,"lines":[{"start":15.089,"end":16.807,"text":"Ota lode, eru n'nu","marked":"Ọ̀tá lóde, ẹ̀rù ń'nú"},{"start":17.187,"end":18.595,"text":"Ko s'ire kan lowo mi","marked":"Kò s'ire kan lọ́wọ́ mi"},{"start":18.975,"end":20.234,"text":"Iwo t'o ngb'elese la","marked":"Ìwo t'ó ńgb'ẹlẹ́sẹ̀ là"},{"start":20.614,"end":21.493,"text":"Mo sa to O wa.","marked":"Mo sá tọ̀ Ọ́ wá."}],"end":21.493},{"key":"4","start":22.443,"lines":[{"start":22.443,"end":23.93,"text":"Awon miran dese pe","marked":"Àwọn miran dẹ́ṣẹ̀ pé"},{"start":24.31,"end":25.514,"text":"Nwon si ri igbala","marked":"Nwọ̀n sì rí ìgbàlà"},{"start":25.894,"end":27.314,"text":"Nwon gbo ohun anu Re","marked":"Nwọ̀n gbọ́ ohùn ànú Rẹ"},{"start":27.694,"end":28.759,"text":"Mu mi gbo pelu.","marked":"Mú mi gbọ́ pẹ̀lú."}],"end":28.759},{"key":"5","start":29.709,"lines":[{"start":29.709,"end":30.909,"text":"Mo k'aniyan mi le O","marked":"Mo k'àníyàn mi lé O"},{"start":31.289,"end":32.748,"text":"Mo si ngbadura si O,","marked":"Mo sì ńgbàdúrà sí Ọ"},{"start":33.128,"end":35.453,"text":"Jesu, yo mi n'nu egbe","marked":"Jésù, yó mi ń'nú ẹgbẹ́"},{"start":35.833,"end":37.301,"text":"Gba mi, ki nma ku.","marked":"Gbà mí, kí ńmá kú."}],"end":37.301},{"key":"6","start":38.251,"lines":[{"start":38.251,"end":39.388,"text":"'Gbati wahala ba de","marked":"'Gbàtì wàhálà bá dé"},{"start":39.768,"end":41.147,"text":"Nigb' agbara idanwo","marked":"Nígb' agbára ìdánwò"},{"start":41.527,"end":42.634,"text":"Ati lojo ikehin","marked":"Àti lọ́jọ́ ìkẹhìn"},{"start":43.014,"end":44.293,"text":"Jesu, sunmo mi.","marked":"Jésù, súnmọ́ mi."}],"end":44.293}]}