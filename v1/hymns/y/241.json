{"v":1,"coll":"y","num":241,"id":"hymn_241","title":"ARE mu o aiye su o","duration":53.172,"voices":{"male":{"file":"y-241-male.m4a","bytes":371065,"sha256":"d279e19e1f15f66c7d42bdfa494cfa38284d37307a7279443176e3a20081d673","duration":53.2},"female":{"file":"y-241-female.m4a","bytes":378452,"sha256":"111d32e620f7ba8a22dc2469341cb6d32133566ebb63148b5fc3c6e7c58a9363","duration":53.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.852,"text":"ARE mu o aiye su o","marked":"Are mú ọ àìyé sú ọ"},{"start":2.232,"end":3.237,"text":"Lala po fun o?","marked":"Lálà pọ̀ fún ọ?"},{"start":3.617,"end":5.284,"text":"Jesu ni, 'Wa si odo mi","marked":"Jésù ni, 'Wá sí ọ̀dọ̀ mi"},{"start":5.664,"end":6.554,"text":"K'o simi.","marked":"K'ó sìmí."}],"end":6.554},{"key":"2","start":7.504,"lines":[{"start":7.504,"end":8.804,"text":"Ami wo l'emi o fi mo","marked":"Àmì wo l'èmi ò fi mọ́"},{"start":9.184,"end":10.365,"text":"Pe On l'o npe mi?","marked":"Pé On l'ó ńpẹ́ mi?"},{"start":10.745,"end":11.918,"text":"Am'iso wa lowo,","marked":"Am'isò wà lọ́wọ́"},{"start":12.298,"end":13.122,"text":"ati Ese Re.","marked":"àti Ẹsẹ̀ Rẹ̀."}],"end":13.122},{"key":"3","start":14.072,"lines":[{"start":14.072,"end":15.655,"text":"O ha ni ade bi Oba","marked":"Ó ha ní adé bí Ọba"},{"start":16.035,"end":17.219,"text":"Ti mo le fi mo?","marked":"Tí mo lè fi mọ̀?"},{"start":17.599,"end":19.295,"text":"Toto, ade wa lori Re,","marked":"Tótọ́, adé wà lórí Rẹ̀"},{"start":19.675,"end":20.56,"text":"T'egun ni.","marked":"T'ègùn ni."}],"end":20.56},{"key":"4","start":21.51,"lines":[{"start":21.51,"end":23.678,"text":"Bi mo ba ri, bi mo tele","marked":"Bí mo bá rí, bí mọ̀ tẹ́lẹ̀"},{"start":24.058,"end":24.848,"text":"Kini ere mi?","marked":"Kíni èrè mi?"},{"start":25.228,"end":26.679,"text":"Opolopo iya ati","marked":"Ọ̀pọ̀lọpọ̀ ìyá àti"},{"start":27.059,"end":27.876,"text":"'Banuja.","marked":"'Bànújà."}],"end":27.876},{"key":"5","start":28.826,"lines":[{"start":28.826,"end":31.051,"text":"Bi mo tele tit'aiye mi","marked":"Bí mo tẹ̀lé tít'áiye mi"},{"start":31.431,"end":32.548,"text":"Kini ngo ri gba?","marked":"Kíni ngo rí gbà?"},{"start":32.928,"end":34.669,"text":"Ekun a dopin, o simi","marked":"Ẹkùn á dópin, ó sìmí"},{"start":35.049,"end":36.013,"text":"Tit'aiye.","marked":"Tít'aiye."}],"end":36.013},{"key":"6","start":36.963,"lines":[{"start":36.963,"end":38.555,"text":"Bi mo bere pe ki O gba mi,","marked":"Bí mo bẹ̀rẹ̀ pé kí Ó gbà mí"},{"start":38.935,"end":40.051,"text":"Y'o ko fun mi bi?","marked":"Y'o kò fún mi bí?"},{"start":40.431,"end":41.967,"text":"B'orun at'aiye nkoja lo","marked":"B'ọrùn àt'áiye ńkọjá lọ"},{"start":42.347,"end":43.216,"text":"Ko je ko.","marked":"Kò jẹ́ kọ́."}],"end":43.216},{"key":"7","start":44.166,"lines":[{"start":44.166,"end":46.37,"text":"Bi mo ba ri, ti mo ntele","marked":"Bí mo bá rí, tí mò ńtẹ̀lé"},{"start":46.75,"end":47.899,"text":"Y'o ha bukun mi?","marked":"Y'ó ha bùkún mi?"},{"start":48.279,"end":49.394,"text":"Awon ogun orun wipe","marked":"Àwọn ogun ọ̀run wípé"},{"start":49.774,"end":50.678,"text":"Yio se.","marked":"Yíó ṣe."},{"start":51.058,"end":51.622,"text":"Amin.","marked":"Àmín."}],"end":51.622}]}