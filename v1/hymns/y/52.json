{"v":1,"coll":"y","num":52,"id":"hymn_52","title":"BABA MIMO jowo gbo","duration":86.395,"voices":{"male":{"file":"y-52-male.m4a","bytes":637404,"sha256":"d75adf582029852f9767c7814c4bcfb3df126fd1ac63300c118bb9923b71662d","duration":86.4},"female":{"file":"y-52-female.m4a","bytes":648735,"sha256":"57e96edec8568f4ce987926cc9bfee3ea086b3612d5dd5bb777e6ae5dcc455d7","duration":86.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.478,"text":"BABA MIMO jowo gbo, gbe omo Re,","marked":"Bàbá Mímọ́́ jọ̀wọ́ gbọ́, gbé ọmọ Rẹ"},{"start":2.858,"end":4.456,"text":"METALOKAN MlMO OBA OGO,","marked":"Mẹ́talọ́kan MlMỌ Ọba Ògo"},{"start":4.836,"end":6.361,"text":"Egbe aladura ipe na ndun","marked":"Ẹgbẹ́ aládúrà ìpè nà ńdùn"},{"start":6.741,"end":8.762,"text":"Egbe Serafu t'aiye e mura.","marked":"Ẹgbẹ́ Séráfù t'áìyé e múra."}],"end":8.762},{"key":"CHORUS","start":9.712,"lines":[{"start":9.712,"end":11.774,"text":"Wa ore mi, wa ka jumo rin,","marked":"Wá ọ̀rẹ́ mi, wa ká jùmọ̀ rìn"},{"start":12.154,"end":13.824,"text":"F'oju okan wo agbala ni","marked":"F'ojú ọkàn wo àgbàlá ni"},{"start":14.204,"end":15.783,"text":"Nib'OLUDANDE wa nwipe","marked":"Níb'Olùdáǹdè wa ńwipe"},{"start":16.163,"end":17.585,"text":"BABA MIMO dariji.","marked":"Bàbá Mímọ́́ dariji."}],"end":17.585},{"key":"2","start":18.535,"lines":[{"start":18.535,"end":20.436,"text":"Ogoji odun ni BABA fi gb'ebe,","marked":"Ogójì ọdún ni Bàbá fi gb'ébẹ̀"},{"start":20.816,"end":22.617,"text":"Ka le gb'egbe lo logo yi dide","marked":"Ká lè gb'ẹgbẹ́ ló lógo yí dìde"},{"start":22.997,"end":24.977,"text":"Ogoji Odun ni OMO fi bebe","marked":"Ogójì Ọdún ni Ọmọ fi bẹ̀bẹ̀"},{"start":25.357,"end":27.514,"text":"Lati d'egbe Serafu yi sile.","marked":"Láti d'ẹgbẹ́ Séráfù yí sílẹ̀."}],"end":27.514},{"key":"3","start":28.464,"lines":[{"start":28.464,"end":30.15,"text":"BABA OLUPESE jo pese fun wa,","marked":"Bàbá Olùpèsè jọ pèsè fún wa"},{"start":30.53,"end":32.497,"text":"OLUGBOGBE EDA gbogb' edun wa,","marked":"Olùgbọgbẹ́ Ẹ̀dá gbogb' ẹ̀dùn wa"},{"start":32.877,"end":34.662,"text":"OLUBUKUN-JULO leni ranse na,","marked":"Olùbùkún-Júlò lẹni ránṣẹ́ ná"},{"start":35.042,"end":36.694,"text":"METALOKAN ranse rere si wa.","marked":"Mẹ́talọ́kan ránṣẹ́ rere sí wa."}],"end":36.694},{"key":"4","start":37.644,"lines":[{"start":37.644,"end":39.935,"text":"Egbe akorin e tun ohun nyin se,","marked":"Ẹgbẹ́ akọrin ẹ̀ tún ọ̀hún nyin ṣe"},{"start":40.315,"end":42.002,"text":"Ke Halleluya s'Oba Olore","marked":"Kẹ Hallelúyà s'Ọba Olọ́rẹ́"},{"start":42.382,"end":44.247,"text":"Egbe Aladura e t'esu mole","marked":"Ẹgbẹ́ Alàdúrà ẹ t'èṣù mọ́lẹ̀"},{"start":44.627,"end":46.212,"text":"K'EMI MlMO s'amona Egbe wa.","marked":"K'ẹ̀mí MlMO s'amọ̀nà Ẹgbẹ́ wa."}],"end":46.212},{"key":"5","start":47.162,"lines":[{"start":47.162,"end":48.995,"text":"Enyin ariran nin'egbe Serafu","marked":"Enyin aríran nìn'ẹgbẹ́ Séráfù"},{"start":49.375,"end":51.61,"text":"Mase boju w'ehin esu wa nibe,","marked":"Masẹ̀ bojú w'ehin èṣù wa níbẹ̀"},{"start":51.99,"end":54.31,"text":"Mura gin k'esu ma fa o sehin","marked":"Múra gín k'èṣù má fà ọ́ sẹ́hìn"},{"start":54.69,"end":56.448,"text":"J'eni kikun laiberu enia.","marked":"J'ẹni kíkún láìbẹ̀rù enia."}],"end":56.448},{"key":"6","start":57.398,"lines":[{"start":57.398,"end":58.825,"text":"Awa dupe Iowo OBANGUI","marked":"Àwa dúpẹ́ lọ́wọ́ Obangui"},{"start":59.205,"end":60.762,"text":"OLORUN ALANU buk'egbe wa,","marked":"Ọlọ́run Alanu bùk'ẹgbẹ́ wa"},{"start":61.142,"end":63.351,"text":"JEHOVAH SABAOTH jowo sunmo wa,","marked":"Jehovah Sabaoth jọ̀wọ́ súnmọ́ wa"},{"start":63.731,"end":65.797,"text":"Segun gbogb'ota 'le ati t'ode.","marked":"Ṣẹ́gun gbogb'ota 'lé àti t'ọ̀dẹ̀."}],"end":65.797},{"key":"7","start":66.747,"lines":[{"start":66.747,"end":68.845,"text":"Ope lo ye omo Egbe Kerubu,","marked":"Ọpẹ́ ló yẹ ọmọ Ẹgbẹ́ Kérúbù"},{"start":69.225,"end":70.737,"text":"Fun anu re lori gbogb'egbe wa","marked":"Fún ãnú rẹ̀ lórí gbogb'egbe wa"},{"start":71.117,"end":73.271,"text":"Elom ran jade nile o d'oku","marked":"Elom rán jáde nílé ó d'ókù"},{"start":73.651,"end":75.551,"text":"A dupe fun abo to fi mbo wa.","marked":"A dúpẹ́ fún abọ́ tó fi ḿbọ́ wa."}],"end":75.551},{"key":"8","start":76.501,"lines":[{"start":76.501,"end":78.41,"text":"F'OGO fun BABA MIMO loke orun,","marked":"F'ògo fún Bàbá Mímọ́́ lókè ọ̀run"},{"start":78.79,"end":80.529,"text":"E tun f'ogo fun OMO RE pelu","marked":"Ẹ tún f'ògo fún Ọmọ Rẹ̀ pẹ̀lú"},{"start":80.909,"end":82.617,"text":"E f'ogo EMl to dari wa","marked":"Ẹ f'ògò EMl tó darí wa"},{"start":82.997,"end":84.846,"text":"Metalokan Mimo lope ye fun","marked":"Mẹ́talọ́kan Mímọ́́ lọpẹ́ yẹ fún"}],"end":84.846}]}