{"v":1,"coll":"y","num":385,"id":"hymn_385","title":"EMI Mimo 'Daba orun","duration":34.982,"voices":{"male":{"file":"y-385-male.m4a","bytes":248768,"sha256":"9a29407012141addc75a9f06850552bcd9dba0f9edafb181846ec2a02567bab2","duration":35.0},"female":{"file":"y-385-female.m4a","bytes":258988,"sha256":"2e6d922243018d7140d825ab422ad76d4c6748b86e791f3b4c16a8cbb5c19b82","duration":35.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.392,"text":"EMI Mimo 'Daba orun","marked":"Ẹ̀mí Mímọ́́ 'Dábá ọ̀run"},{"start":1.772,"end":3.213,"text":"Wa mu itunu sokale","marked":"Wá mú ìtùnú sọ̀kalẹ̀"},{"start":3.593,"end":5.299,"text":"Se Oga at'Oluto wa,","marked":"Ṣe Ọ̀gá àt'Olùtọ́ wa"},{"start":5.679,"end":7.256,"text":"Ma pelu gbogbo ero wa.","marked":"Má pẹ̀lú gbogbo èrò wa."}],"end":7.256},{"key":"2","start":8.206,"lines":[{"start":8.206,"end":9.558,"text":"Jo, fi Otito Re han wa","marked":"Jọ, fi Òtítọ́́ Rẹ hàn wá"},{"start":9.938,"end":11.193,"text":"K'a le fe k'a si m'ona Re","marked":"K'á lè fẹ́ k'á sí ḿ'ọ́nà Rẹ"},{"start":11.573,"end":12.963,"text":"Gbin ife toto s'okan wa","marked":"Gbin ìfẹ́ tọ́tò s'ọ́kan wa"},{"start":13.343,"end":14.732,"text":"K'a ma le pada lehin Re.","marked":"K'á má lè padà lẹ́hìn Rẹ."}],"end":14.732},{"key":"3","start":15.682,"lines":[{"start":15.682,"end":17.273,"text":"Mu wa k'a to ona mimo","marked":"Mú wa k'á tọ ọ̀nà mímọ́́"},{"start":17.653,"end":19.148,"text":"T'a le gba d'odo Olorun","marked":"T'á lè gbà d'ọ̀dọ̀ Ọlọ́run"},{"start":19.528,"end":21.737,"text":"Mu wa to Kristi, Ona lye","marked":"Mú wa tọ Kristi, Ọ̀nà lye"},{"start":22.117,"end":23.742,"text":"Ma je ki awa sina Io.","marked":"Má jẹ́ kí àwa ṣìnà lọ."}],"end":23.742},{"key":"4","start":24.692,"lines":[{"start":24.692,"end":25.923,"text":"Mu wa t'Olorun simi wa","marked":"Mú wa t'Ọlọ́run símí wa"},{"start":26.303,"end":28.237,"text":"K'a le ma ba gbe titi lai","marked":"K'á lè má bá gbé títí láí"},{"start":28.617,"end":30.935,"text":"To wa s'orun, k'a le n'ipin","marked":"Tó wá s'ọrun, k'á lè n'ipin"},{"start":31.315,"end":32.612,"text":"L'owo otun Olorun wa.","marked":"L'ọwọ́ ọ̀tún Ọlọ́run wa."},{"start":32.992,"end":33.432,"text":"Amin.","marked":"Àmín."}],"end":33.432}]}