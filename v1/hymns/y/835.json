{"v":1,"coll":"y","num":835,"id":"hymn_835","title":"Gbekele Olurun Re","duration":43.116,"voices":{"male":{"file":"y-835-male.m4a","bytes":307763,"sha256":"26bfb2d9542259150fa2c3a3fab13b97b46c35ae201acec4d1e829508e719c33","duration":43.2},"female":{"file":"y-835-female.m4a","bytes":321148,"sha256":"fe3ac0dc15f2fa9586fc281f7ac958ae8926a4c12061605a72e24cd3bce956f0","duration":43.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.529,"text":"GBOGBO Egbe Serafu","marked":"Gbogbo Ẹgbẹ́ Séráfù"},{"start":1.909,"end":3.739,"text":"Foriti, e foriti","marked":"Forítì, ẹ forítì"},{"start":4.119,"end":5.394,"text":"Ma je k'o re gbogbo nyin","marked":"Má jẹ k'ó rẹ gbogbo nyin"},{"start":5.774,"end":6.737,"text":"E foriti","marked":"Ẹ forítì"},{"start":7.117,"end":8.396,"text":"Ninu irin-ajo re","marked":"Nínú ìrìn-àjò rẹ"},{"start":8.776,"end":9.894,"text":"Efufu lile le ja","marked":"Ẹ̀fùfù líle lè jà"},{"start":10.274,"end":11.485,"text":"Ja fun 'se re ma beru","marked":"Jà fún 'ṣe rẹ má bẹ̀rù"},{"start":11.865,"end":12.925,"text":"Sa foriti.","marked":"Sá forítì."}],"end":12.925},{"key":"2","start":13.875,"lines":[{"start":13.875,"end":15.076,"text":"Kerubu pelu Seraf","marked":"Kérúbù pẹ̀lú Séráf"},{"start":15.456,"end":17.297,"text":"Foriti, e foriti","marked":"Forítì, ẹ forítì"},{"start":17.677,"end":18.998,"text":"Awon Woli isaju","marked":"Àwọn Wòlí ìṣájú"},{"start":19.378,"end":20.406,"text":"Nwon foriti","marked":"Nwọ̀n forítì"},{"start":20.786,"end":22.305,"text":"Mura si 'se ma w'ehin","marked":"Múra sí 'sé ma w'ehin"},{"start":22.685,"end":23.814,"text":"Baba y'o gb'adura re","marked":"Bàbá y'ó gb'àdúrà rẹ̀"},{"start":24.194,"end":25.567,"text":"E foriti iponju","marked":"Ẹ forítì ìpọ́njú"},{"start":25.947,"end":26.951,"text":"Sa foriti.","marked":"Sá forítì."}],"end":26.951},{"key":"3","start":27.901,"lines":[{"start":27.901,"end":29.047,"text":"Egun le wa lona","marked":"Ẹ̀gún lè wà lọ́nà"},{"start":29.427,"end":31.183,"text":"Foriti, e foriti"