{"v":1,"coll":"y","num":844,"id":"hymn_844","title":"ONA kan l'o ntoka s'orun","duration":57.312,"voices":{"male":{"file":"y-844-male.m4a","bytes":410961,"sha256":"9db5cb6ac097e1301d7d6a0170709718d9bff746bcbee43595e2146cb8941849","duration":57.4},"female":{"file":"y-844-female.m4a","bytes":418980,"sha256":"a19575487656f7c110ebb11bc91c83b8297454a5afe0fb7276b90c9bc6690ab5","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.048,"text":"ONA kan l'o ntoka s'orun","marked":"Ọ̀nà kan l'ó ńtọ́ka s'ọrun"},{"start":2.428,"end":3.684,"text":"Isina ni 'yoku","marked":"Ìṣínà ní 'yókù"},{"start":4.064,"end":5.38,"text":"Hiha si l'ojuona na","marked":"Híhá sì l'ojúọ́nà ná"},{"start":5.76,"end":7.2,"text":"Awon Kristian l'o fe.","marked":"Àwọn Kristian l'ó fẹ́."}],"end":7.2},{"key":"2","start":8.15,"lines":[{"start":8.15,"end":10.654,"text":"Lat' aiye, o lo tarata","marked":"Lát' aiye, ó lọ tàràtà"},{"start":11.034,"end":12.165,"text":"O si la ewu lo","marked":"Ó sì la ewu lọ"},{"start":12.545,"end":14.247,"text":"Awon ti nfi igboya rin","marked":"Àwọn tí ńfi ìgboyà rìn"},{"start":14.627,"end":15.887,"text":"Y'o d'orun nikehin.","marked":"Y'ó d'ọrùn níkẹhin."}],"end":15.887},{"key":"3","start":16.837,"lines":[{"start":16.837,"end":18.201,"text":"Awon ewe y'o ha ti se","marked":"Àwọn èwe y'ó ha ti ṣe"},{"start":18.581,"end":19.711,"text":"Le la ewu yija?","marked":"Lè la ewu yíjà?"},{"start":20.091,"end":21.826,"text":"Tori idekun pe l'ona","marked":"Torí ìdẹkùn pé l'ọ́nà"},{"start":22.206,"end":23.428,"text":"F'awon odomode.","marked":"F'àwọn ọ̀dọ́mọdé."}],"end":23.428},{"key":"4","start":24.378,"lines":[{"start":24.378,"end":25.639,"text":"Gbigboro l'ona t'opo nrin","marked":"Gbígboro l'ọ́nà t'ọ́pọ̀ nrìn"},{"start":26.019,"end":27.226,"text":"O si teju pelu","marked":"Ó sì tẹjú pẹ̀lú"},{"start":27.606,"end":29.206,"text":"Mo si mo pe lati dese","marked":"Mo sì mọ̀ pé láti dẹ́ṣẹ̀"},{"start":29.586,"end":30.944,"text":"Ni nwon se nrin nibe.","marked":"Ní nwọ̀n ṣe ńrìn níbẹ̀."}],"end":30.944},{"key":"5","start":31.894,"lines":[{"start":31.894,"end":33.409,"text":"Sugbon k'ese mi ma ba ye","marked":"Ṣùgbọ́n k'ẹsẹ̀ mi mà bá yé"},{"start":33.789,"end":34.89,"text":"Ki nma si sako lo","marked":"Kí ńmá sì ṣáko lọ"},{"start":35.27,"end":36.714,"text":"Oluwa, jo s'Oluto mi","marked":"Olúwa, jọ s'Olutọ mi"},{"start":37.094,"end":38.237,"text":"Emi ki o sina.","marked":"Èmi kí ó ṣìnà."}],"end":38.237},{"key":"6","start":39.187,"lines":[{"start":39.187,"end":41.234,"text":"Nje mo le lo l'aisifoya","marked":"Ǹjẹ́ mo lè lọ l'àìṣífòyà"},{"start":41.614,"end":43.185,"text":"Ki ngbekel' oro Re","marked":"Kí ngbekel' ọ̀rọ̀ Rẹ"},{"start":43.565,"end":45.148,"text":"Apa Re y'o s'agutan Re","marked":"Apá Rẹ y'ó s'ágùtàn Rẹ"},{"start":45.528,"end":46.814,"text":"Y'o si ko won de 'le.","marked":"Y'ó sì kó wọn dé 'lé."}],"end":46.814},{"key":"7","start":47.764,"lines":[{"start":47.764,"end":49.286,"text":"Beni ngo la ewu yi ja","marked":"Bẹni ńgò la ẹ̀wù yí já"},{"start":49.666,"end":50.763,"text":"Nipa itoju Re","marked":"Nípa ìtọ́jú Rẹ"},{"start":51.143,"end":53.152,"text":"Ngo tejumo 'bode orun","marked":"Ńgò tẹjúmọ́ 'bọ́de ọ̀run"},{"start":53.532,"end":54.765,"text":"Titi ngo fi wole.","marked":"Títí ngo fi wọ́lẹ̀."},{"start":55.145,"end":55.762,"text":"Amin.","marked":"Àmín."}],"end":55.762}]}