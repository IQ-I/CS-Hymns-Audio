{"v":1,"coll":"y","num":737,"id":"hymn_737","title":"GBOGBO aiye Serafu de","duration":126.667,"voices":{"male":{"file":"y-737-male.m4a","bytes":903035,"sha256":"3d7db1cd94f91735e8c8f0147ddacb3d4d74c9f492bc57188f79e40c08f12e4a","duration":126.7},"female":{"file":"y-737-female.m4a","bytes":936811,"sha256":"487a5fe97d10d66dc73bc2b08e9cfbbbdfdf4c2b564ca838e68643799dbde13d","duration":126.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.937,"text":"GBOGBO aiye Serafu de","marked":"Gbogbo aiye Séráfù dé"},{"start":2.317,"end":3.762,"text":"Lati kede oro na","marked":"Láti kéde ọ̀rọ̀ ná"},{"start":4.142,"end":5.561,"text":"T'Olugbala ti fi lele","marked":"T'Olùgbàlà ti fi lélẹ̀"},{"start":5.941,"end":7.341,"text":"Lowo Orimolade.","marked":"Lọ́wọ́ Orímọládé."}],"end":7.341},{"key":"CHORUS","start":8.291,"lines":[{"start":8.291,"end":9.777,"text":"Lodo Baba Aladura","marked":"Lọ́dọ̀ Bàbá Alàdúrà"},{"start":10.157,"end":11.599,"text":"Eni to d'egbe yi sile","marked":"Ẹni tó d'ẹgbẹ́ yí sílẹ̀"},{"start":11.979,"end":14.272,"text":"Nibi Serafu, Kerubu","marked":"Níbi Séráfù, Kérúbù"},{"start":14.652,"end":16.33,"text":"Nyin Baba Mimo logo.","marked":"Nyin Bàbá Mímọ́́ lógo."}],"end":16.33},{"key":"2","start":17.28,"lines":[{"start":17.28,"end":19.286,"text":"Adahunse, ateyepe","marked":"Adáhunṣe, ateyepe"},{"start":19.666,"end":20.683,"text":"Aye Egbe si sile","marked":"Ayé Ẹgbẹ́ ṣí sílẹ̀"},{"start":21.063,"end":22.38,"text":"K'enyin wa ronupiwada","marked":"K'ẹ́nyín wá ronúpìwàdà"},{"start":22.76,"end":24.028,"text":"Lodo orimolade.","marked":"Lọ́dọ̀ orímọládé."}],"end":24.028},{"key":"3","start":24.978,"lines":[{"start":24.978,"end":27.231,"text":"Babalawo, onitira","marked":"Babaláwo, onitira"},{"start":27.611,"end":28.723,"text":"E wa ronupiwada","marked":"Ẹ wá ronúpìwàdà"},{"start":29.103,"end":30.648,"text":"Ke wa di opo iye Re mu","marked":"Kẹ́ wá di ọ̀pọ̀ iye Rẹ̀ mú"},{"start":31.028,"end":32.343,"text":"Lodo Orimolade.","marked":"Lọ́dọ̀ Orímọládé."}],"end":32.343},{"key":"4","start":33.293,"lines":[{"start":33.293,"end":34.826,"text":"Sonponna ko lo sora re","marked":"Ṣọ́npọ́nná kọ́ ló ṣọ́ra rẹ̀"},{"start":35.206,"end":36.581,"text":"Lodo Egbe Serafu","marked":"Lọ́dọ̀ Ẹgbẹ́ Séráfù"},{"start":36.961,"end":38.286,"text":"Oniwunde ti sokale","marked":"Oníwúńde ti sọ̀kalẹ̀"},{"start":38.666,"end":39.968,"text":"Sinu Egbe Kerubu.","marked":"Sínú Ẹgbẹ́ Kérúbù."}],"end":39.968},{"key":"5","start":40.918,"lines":[{"start":40.918,"end":42.612,"text":"Egungun ati gelede","marked":"Egungun àti gẹlẹdẹ"},{"start":42.992,"end":44.15,"text":"E wa ronupiwada","marked":"Ẹ wá ronúpìwàdà"},{"start":44.53,"end":45.794,"text":"Ka jumo yin Olorun wa","marked":"Ká jùmọ̀ yin Ọlọ́run wa"},{"start":46.174,"end":47.524,"text":"Ninu Egbe Serafu.","marked":"Nínú Ẹgbẹ́ Séráfù."}],"end":47.524},{"key":"6","start":48.474,"lines":[{"start":48.474,"end":49.906,"text":"lgunnu ati agemo","marked":"lgúnnu àti àgémọ"},{"start":50.286,"end":51.44,"text":"E wa ronupiwada","marked":"Ẹ wá ronúpìwàdà"},{"start":51.82,"end":53.22,"text":"K'e wa di opo iye mu","marked":"K'ẹ́ wá di ọ̀pọ̀ iye mú"},{"start":53.6,"end":54.878,"text":"Lodo Orimolade.","marked":"Lọ́dọ̀ Orímọládé."}],"end":54.878},{"key":"7","start":55.828,"lines":[{"start":55.828,"end":56.959,"text":"A juba Olorun baba","marked":"A júbà Ọlọ́run bàbá"},{"start":57.339,"end":58.467,"text":"Omo at'Emi Mimo","marked":"Ọmọ àt'Ẹ̀mí Mímọ́́"},{"start":58.847,"end":60.513,"text":"Metalokan aiyeraiye","marked":"Mẹ́talọ́kan aiyérayé"},{"start":60.893,"end":62.214,"text":"Ninu Egbe Serafu.","marked":"Nínú Ẹgbẹ́ Séráfù."}],"end":62.214},{"key":"8","start":63.164,"lines":[{"start":63.164,"end":64.925,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":65.305,"end":66.723,"text":"T'o wa ni gbogbo aiye","marked":"T'ó wà ní gbogbo aiye"},{"start":67.103,"end":68.478,"text":"K'awa damure wa giri","marked":"K'àwa dámùrè wa gìrì"},{"start":68.858,"end":70.177,"text":"Lati kdede oro na.","marked":"Láti kdede ọ̀rọ̀ ná."}],"end":70.177},{"key":"9","start":71.127,"lines":[{"start":71.127,"end":72.494,"text":"A ki Baba Aladura","marked":"A kí Bàbá Aládúrà"},{"start":72.874,"end":74.307,"text":"T'Olorun f'Egbe yi ran","marked":"T'Ọlọ́run f'Ègbé yí rán"},{"start":74.687,"end":76.059,"text":"Jerusalemu sokale","marked":"Jerúsálẹ́mù sọ̀kalẹ̀"},{"start":76.439,"end":77.839,"text":"Lodo Orimolade.","marked":"Lọ́dọ̀ Orímọládé."}],"end":77.839},{"key":"10","start":78.789,"lines":[{"start":78.789,"end":80.689,"text":"Enyin ara, e ku 'duro","marked":"Enyin ará, ẹ kù 'dúró"},{"start":81.069,"end":82.955,"text":"Enyin ara, e ku 'joko","marked":"Enyin ará, ẹ kù 'jọ̀kọ̀"},{"start":83.335,"end":84.744,"text":"Oko 'gbala wa lode Eko","marked":"Ọkọ̀ 'gbàlà wa lóde Èkó"},{"start":85.124,"end":86.401,"text":"Lodo orimolade.","marked":"Lọ́dọ̀ orímọládé."}],"end":86.401},{"key":"11","start":87.351,"lines":[{"start":87.351,"end":88.706,"text":"Olorun to gbo t'Elijah","marked":"Ọlọ́run tó gbọ́ t'Elijah"},{"start":89.086,"end":90.424,"text":"T'o so mu lo sodo Re","marked":"T'ó sọ mú lọ sọ́dọ̀ Rẹ"},{"start":90.804,"end":92.138,"text":"Ko wa ran Mosisi lowo","marked":"Kò wá ran Mosisi lọ́wọ́"},{"start":92.518,"end":93.852,"text":"Ko le wa d'odo Re.","marked":"Kò lè wá d'ọ̀dọ̀ Rẹ."}],"end":93.852},{"key":"12","start":94.802,"lines":[{"start":94.802,"end":95.857,"text":"Olorun Abraham","marked":"Ọlọ́run Abraham"},{"start":96.237,"end":97.598,"text":"Isaac ati Jakobu","marked":"Isaac àti Jákọ́bù"},{"start":97.978,"end":99.763,"text":"Baba, Omo, Emi Mimo","marked":"Bàbá, Ọmọ, Ẹ̀mí Mímọ́́"},{"start":100.143,"end":101.977,"text":"Metalokan aiyeraiye.","marked":"Mẹ́talọ́kan aiyérayé."}],"end":101.977},{"key":"13","start":102.927,"lines":[{"start":102.927,"end":104.883,"text":"Adaba orun, sokale","marked":"Àdàbà ọ̀run, sọ̀kalẹ̀"},{"start":105.263,"end":106.415,"text":"E wa ran baba lowo","marked":"Ẹ wá ran bàbá lọ́wọ́"},{"start":106.795,"end":108.277,"text":"K'ade ogo le je tire","marked":"K'adé ògo lè jẹ́ tirẹ̀"},{"start":108.657,"end":110.076,"text":"Ti enikan ko le gba.","marked":"Ti enìkan kò lè gbà."}],"end":110.076},{"key":"14","start":111.026,"lines":[{"start":111.026,"end":112.321,"text":"Michael Gabrieli,","marked":"Michael Gabrieli"},{"start":112.701,"end":114.006,"text":"Enyin agba Angeli","marked":"Enyin àgbà Áńgẹ́lì"},{"start":114.386,"end":115.676,"text":"Emmanueli Oba wa","marked":"Ẹmmanuẹ́lì Ọba wa"},{"start":116.056,"end":117.61,"text":"Metalokan la o sin.","marked":"Mẹ́talọ́kan la ó sìn."}],"end":117.61},{"key":"15","start":118.56,"lines":[{"start":118.56,"end":119.889,"text":"A f'ope f'Olorun Baba","marked":"A f'ọpẹ́ f'Ọlọ́run Bàbá"},{"start":120.269,"end":121.504,"text":"Omo at'Emi Mimo","marked":"Ọmọ àt'Ẹ̀mí Mímọ́́"},{"start":121.884,"end":123.469,"text":"Metalokan aiyeraiye","marked":"Mẹ́talọ́kan aiyérayé"},{"start":123.849,"end":125.117,"text":"Ninu Egbe Serafu.","marked":"Nínú Ẹgbẹ́ Séráfù."}],"end":125.117}]}