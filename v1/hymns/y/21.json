{"v":1,"coll":"y","num":21,"id":"hymn_21","title":"OJO isimi at'ayo","duration":72.649,"voices":{"male":{"file":"y-21-male.m4a","bytes":529381,"sha256":"18c4dbdfcbddc080a8f4918b156faf00668be8879b9b88cc32ba030085f60438","duration":72.7},"female":{"file":"y-21-female.m4a","bytes":551327,"sha256":"9cb9c0f6a9f28b084b55cde13d877cd1c6c7ccf1fb4ce4d62e63166c60d0e63f","duration":72.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.959,"text":"OJO isimi at'ayo","marked":"Ọjọ́ ìsimi àt'àyò"},{"start":2.339,"end":3.587,"text":"Ojo inu didun;","marked":"Ọjọ́ inú dídùn"},{"start":3.967,"end":5.108,"text":"Ogun fun ibanuje","marked":"Ogún fún ìbànújẹ́"},{"start":5.488,"end":6.666,"text":"Ojo dida julo","marked":"Ọjọ́ dídá jùlọ"},{"start":7.046,"end":8.117,"text":"Ti awon eni giga","marked":"Ti àwọn ẹni gíga"},{"start":8.497,"end":9.535,"text":"Niwaju ite Re","marked":"Níwájú ìtẹ́ Rẹ"},{"start":9.915,"end":11.667,"text":"Nko mimo, mimo, mimo","marked":"Nkọ mímọ́́, mímọ́́, mímọ́́"},{"start":12.047,"end":13.61,"text":"S'eni Metalokan.","marked":"S'ẹni Mẹ́talọ́kan."}],"end":13.61},{"key":"2","start":14.56,"lines":[{"start":14.56,"end":16.019,"text":"L'ojo yi ni 'mole la,","marked":"L'ọjọ́ yí ni 'mọ́lẹ̀ là"},{"start":16.399,"end":17.457,"text":"Nigba dida aiye","marked":"Nígbà dídá aiye"},{"start":17.837,"end":19.06,"text":"Ati fun igbala wa","marked":"Àti fún ìgbàlà wa"},{"start":19.44,"end":20.758,"text":"Kristi jinde loni,","marked":"Kristi jíǹde lónì"},{"start":21.138,"end":22.277,"text":"L'ojo oni l'Oluwa","marked":"L'ọjọ́ òní l'Olúwa"},{"start":22.657,"end":23.813,"text":"Ran Emi torun wa;","marked":"Ran Ẹ̀mí tọrùn wá"},{"start":24.193,"end":25.267,"text":"Ojo ologo julo","marked":"Ọjọ́ ológo jùlọ"},{"start":25.647,"end":26.874,"text":"T'o ni mole pipe.","marked":"T'ó ní mọ́lẹ̀ pípé."}],"end":26.874},{"key":"3","start":27.824,"lines":[{"start":27.824,"end":29.096,"text":"Orisun 'tura ni O,","marked":"Orísun 'tura ni O"},{"start":29.476,"end":30.775,"text":"L'aiye aginju yi,","marked":"L'áiye aginjù yí"},{"start":31.155,"end":33.004,"text":"L'ori Re, bi ni Pisga","marked":"L'orí Rẹ, bí ní Písga"},{"start":33.384,"end":34.497,"text":"L'a nwo 'le ileri","marked":"L'á ńwò 'lé ìlérí"},{"start":34.877,"end":36.164,"text":"Ojo ironu didun","marked":"Ọjọ́ ìrònú dídùn"},{"start":36.544,"end":37.541,"text":"Ojo ife mimo","marked":"Ọjọ́ ìfẹ́ mímọ́́"},{"start":37.921,"end":40.15,"text":"Ojo ajinde, lati","marked":"Ọjọ́ àjíǹde, láti"},{"start":40.53,"end":42.004,"text":"Aiye si nkan orun.","marked":"Àìyẹ́ sí nkan ọ̀run."}],"end":42.004},{"key":"4","start":42.954,"lines":[{"start":42.954,"end":44.244,"text":"L'oni s'ilu t'are mu,","marked":"L'ọ́ni s'ìlú t'árẹ̀ mú"},{"start":44.624,"end":45.748,"text":"Ni manna t'orun bo,","marked":"Ní mánná t'ọrùn bọ̀"},{"start":46.128,"end":47.407,"text":"Si ipejopo mimo","marked":"Sí ìpéjọpọ̀ mímọ́́"},{"start":47.787,"end":48.941,"text":"N'ipe fadaka ndun,","marked":"N'ípé fàdákà ńdún"},{"start":49.321,"end":50.407,"text":"Nibiti ihin-rere,","marked":"Níbití ìhìn-rere"},{"start":50.787,"end":51.759,"text":"Ntan imole mimo","marked":"Ntan ìmọ́lẹ̀̀ mímọ́́"},{"start":52.139,"end":53.409,"text":"Omi iye nsan jeje","marked":"Omi ìyẹ́ ńsán jẹ́jẹ́"},{"start":53.789,"end":55.229,"text":"Ti ntu okan lara.","marked":"Ti ńtu ọ̀kan lára."}],"end":55.229},{"key":"5","start":56.179,"lines":[{"start":56.179,"end":57.805,"text":"K'a r'ore‐ofe titun","marked":"K'á r'ọ̀rẹ́-ọ̀fẹ́ titun"},{"start":58.185,"end":59.511,"text":"L'ojo 'simi wa yi","marked":"L'ọjọ́ 'simi wa yi"},{"start":59.891,"end":61.416,"text":"Ka si de simi t'o ku","marked":"Ká sì dé sími t'ó kù"},{"start":61.796,"end":63.198,"text":"F'awon alabukun","marked":"F'àwọn alábùkún"},{"start":63.578,"end":65.226,"text":"Nibe ka gbohun soke","marked":"Níbẹ̀ ká gbóhùn sókè"},{"start":65.606,"end":66.716,"text":"Si Baba at'Omo","marked":"Sí Bàbá àt'Ọmọ"},{"start":67.096,"end":68.28,"text":"Ati si Emi Mimo","marked":"Àti sí Ẹ̀mí Mímọ́́"},{"start":68.66,"end":70.126,"text":"N'iyin Metalokan.","marked":"N'ìyìn Mẹ́talọ́kan."},{"start":70.506,"end":71.1,"text":"Amin.","marked":"Àmín."}],"end":71.1}]}