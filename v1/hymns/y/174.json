{"v":1,"coll":"y","num":174,"id":"hymn_174","title":"Ojo ibukun y'o si ro!","duration":38.839,"voices":{"male":{"file":"y-174-male.m4a","bytes":274664,"sha256":"dcddef074d28821d9295a765297bfb04c090b6e65f2f2be0b2bd1cb489e9136e","duration":38.9},"female":{"file":"y-174-female.m4a","bytes":283601,"sha256":"517de0c0781a8d1b1bde9baba3c1aa71651deabb5868c62d73a8a27e92cee76a","duration":38.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.7,"text":"Ojo ibukun y'o si ro!","marked":"Òjò ìbùkún y'ó sì rọ̀!"},{"start":2.08,"end":3.555,"text":"Ileri ife l'eyi","marked":"Ìlérí ìfẹ́ l'èyí"},{"start":3.935,"end":5.45,"text":"A o ni itura didun","marked":"A ò ní ìtura dídùn"},{"start":5.83,"end":7.054,"text":"Lat'odo Olugbala.","marked":"Lát'ọ̀dọ̀ Olùgbàlà."}],"end":7.054},{"key":"CHORUS","start":8.004,"lines":[{"start":8.004,"end":10.93,"text":"Ojo Ibukun, Ojo ibukun l'a nfe","marked":"Ọjọ́ Ìbùkún, Ọjọ́ ìbùkún l'á ńfẹ́"},{"start":11.31,"end":12.751,"text":"Iri anu nse yi wa ka","marked":"Ìrì ànú ńṣe yí wa ká"},{"start":13.131,"end":14.653,"text":"Sugbon ojo l'a ntoro.","marked":"Ṣùgbọ́n ọjọ́ l'á ńtòrò."}],"end":14.653},{"key":"2","start":15.603,"lines":[{"start":15.603,"end":17.028,"text":"'Ojo ibukun y'o si ro!","marked":"'Òjò ìbùkún y'ó sì rọ̀!"},{"start":17.408,"end":18.505,"text":"Isoji iyebiye","marked":"Ìsọjí iyebíye"},{"start":18.885,"end":20.171,"text":"Lori oke on petele","marked":"Lórí òkè ọ́n pẹ̀tẹ́lẹ̀"},{"start":20.551,"end":21.969,"text":"Iro opo ojo mbo.","marked":"Ìró ọ̀pọ̀ ọjọ́ ḿbọ́."}],"end":21.969},{"key":"3","start":22.919,"lines":[{"start":22.919,"end":24.599,"text":"'Ojo ibukun y'o si ro","marked":"'Òjò ìbùkún y'ó sì rọ̀"},{"start":24.979,"end":26.155,"text":"Ran won si wa Oluwa","marked":"Rán wọ́n sì wá Olúwa"},{"start":26.535,"end":28.085,"text":"Fun wa ni itura didun","marked":"Fún wa ní ìtura dídùn"},{"start":28.465,"end":30.04,"text":"Wa, f'ola fun oro Re.","marked":"Wá, f'ọlá fún ọ̀rọ̀ Rẹ."}],"end":30.04},{"key":"4","start":30.99,"lines":[{"start":30.99,"end":32.26,"text":"'Ojo ibukun y'o si ro","marked":"'Òjò ìbùkún y'ó sì rọ̀"},{"start":32.64,"end":33.788,"text":"lba je le ro loni!","marked":"lba jẹ́ lè rò lónì!"},{"start":34.168,"end":35.635,"text":"B'a ti njewo f'Olorun wa","marked":"B'a ti njewo f'Ọlọ́run wa"},{"start":36.015,"end":37.289,"text":"T'a npe oruko Jesu.","marked":"T'á ńpe orúkọ Jésù."}],"end":37.289}]}