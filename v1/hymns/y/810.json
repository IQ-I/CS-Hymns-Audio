{"v":1,"coll":"y","num":810,"id":"hymn_810","title":"WA, rohin Re yika","duration":30.032,"voices":{"male":{"file":"y-810-male.m4a","bytes":204305,"sha256":"1ead5a0dc8fcc1570821e410e0f44edb17047f80b24e90e9d36c5c34577ee08c","duration":30.1},"female":{"file":"y-810-female.m4a","bytes":214078,"sha256":"d18fed92071207af2e68307bf0baa7f12c191e892d5370cf2660e0facd786c96","duration":30.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.495,"text":"WA, rohin Re yika","marked":"Wá, ròhìn Rẹ̀ yíká"},{"start":1.875,"end":3.27,"text":"K'a si korin ogo","marked":"K'á sì kọrin ògo"},{"start":3.65,"end":4.877,"text":"Alagbara li Oluwa","marked":"Alágbára li Olúwa"},{"start":5.257,"end":6.619,"text":"Oba gbogbo aiye.","marked":"Ọba gbogbo aiye."}],"end":6.619},{"key":"2","start":7.569,"lines":[{"start":7.569,"end":8.77,"text":"On l'O da won ibu","marked":"On l'Ó da wọn ibú"},{"start":9.15,"end":10.188,"text":"O pala fun okun","marked":"Ó pálá fún òkun"},{"start":10.568,"end":11.971,"text":"Tire ni gbogb' awon odo","marked":"Tìrẹ ni gbogb' àwọn odò"},{"start":12.351,"end":13.517,"text":"At'iyangbe ile.","marked":"Àt'ìyàngbẹ ilé."}],"end":13.517},{"key":"3","start":14.467,"lines":[{"start":14.467,"end":15.909,"text":"Wa, wole n'ite Re","marked":"Wá, wọlé n'ìtẹ́ Rẹ"},{"start":16.289,"end":17.392,"text":"Wa, juba Oluwa","marked":"Wá, júbà Olúwa"},{"start":17.772,"end":19.261,"text":"lse owo Re l'awa se,","marked":"lse ọwọ́ Rẹ l'áwá ṣe"},{"start":19.641,"end":21.049,"text":"Oro Re l'o da wa.","marked":"Ọ̀rọ̀ Rẹ l'ó dá wa."}],"end":21.049},{"key":"4","start":21.999,"lines":[{"start":21.999,"end":23.12,"text":"Gbo ohun Re loni","marked":"Gbọ́ ohùn Rẹ lọni"},{"start":23.5,"end":24.609,"text":"Ma si se mu binu","marked":"Má sì ṣe mú bínú"},{"start":24.989,"end":27.028,"text":"Wa, bi eni ayanfe Re","marked":"Wà, bí ẹni àyànfẹ́ Rẹ̀"},{"start":27.408,"end":28.482,"text":"Jewo Olorun re.","marked":"Jẹ́wọ́ Ọlọ́run rẹ."}],"end":28.482}]}