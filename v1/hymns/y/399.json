{"v":1,"coll":"y","num":399,"id":"hymn_399","title":"IWO Oro Olorun","duration":57.753,"voices":{"male":{"file":"y-399-male.m4a","bytes":420231,"sha256":"e1633eb244eb1483ad46652e5364d06785625e844c762fbfd262fb5021dcea46","duration":57.8},"female":{"file":"y-399-female.m4a","bytes":430722,"sha256":"ae24ad03a69e3412569e6450b5038bcf5651b2e7fd07da06945e453dd570c35d","duration":57.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.257,"text":"IWO Oro Olorun","marked":"Ìwọ Ọ̀rọ̀ Ọlọ́run"},{"start":1.637,"end":2.997,"text":"Ogbon at'oke wa","marked":"Ọgbọ́n àt'òkè wa"},{"start":3.377,"end":5.372,"text":"Oto ti ki yipada","marked":"Ọ̀tọ̀ tí kì yípadà"},{"start":5.752,"end":6.823,"text":"Imole aiye wa","marked":"Ìmọ́lẹ̀̀ aiye wa"},{"start":7.203,"end":8.689,"text":"Awa yin O fun 'mole","marked":"Àwa yín Ò fún 'mole"},{"start":9.069,"end":9.996,"text":"T'inu lwe mimo","marked":"T'ínú lwe mímọ́́"},{"start":10.376,"end":11.589,"text":"Fitila fun ese wa","marked":"Fìtílà fún ẹsẹ̀ wa"},{"start":11.969,"end":13.228,"text":"Ti ntan titi aiye.","marked":"Ti ntàn títí aiye."}],"end":13.228},{"key":"2","start":14.178,"lines":[{"start":14.178,"end":15.55,"text":"Oluwa l'o f'ebun yi","marked":"Olúwa l'ó f'ẹ̀bùn yí"},{"start":15.93,"end":17.108,"text":"Fun ljo Re l'aiye","marked":"Fún ljọ Rẹ l'aiye"},{"start":17.488,"end":19.019,"text":"A ngbe 'mole na soke","marked":"A ńgbé 'mọ́lẹ̀ nà sókè"},{"start":19.399,"end":20.681,"text":"Lati tan y'aiye ka","marked":"Láti tán y'áíyé ká"},{"start":21.061,"end":22.162,"text":"Apoti wura n'ise","marked":"Àpótí wúrà ń'iṣẹ́"},{"start":22.542,"end":23.63,"text":"O kun fun Otito","marked":"Ó kún fún Òtítọ́́"},{"start":24.01,"end":25.427,"text":"Aworan kristi si ni","marked":"Àwòrán Kristi sì ni"},{"start":25.807,"end":26.97,"text":"Oro iye toto.","marked":"Ọ̀rọ̀ ìyè tótọ́."}],"end":26.97},{"key":"3","start":27.92,"lines":[{"start":27.92,"end":29.306,"text":"O nfe lele b'asia","marked":"Ó ńfẹ́ lélẹ̀ b'asia"},{"start":29.686,"end":30.856,"text":"T'a ta loju ogun","marked":"T'á ta lójú ogun"},{"start":31.236,"end":32.781,"text":"O ntan b'ina alore","marked":"Ó ńtan b'íná alọ́rẹ́"},{"start":33.161,"end":34.571,"text":"Si okunkun aiye","marked":"Ṣí òkùnkùn aiye"},{"start":34.951,"end":36.262,"text":"Amona enia ni","marked":"Amọ̀nà enia ni"},{"start":36.642,"end":37.796,"text":"Ni wahala gbogbo","marked":"Ní wàhálà gbogbo"},{"start":38.176,"end":39.468,"text":"Nin'arin omi aiye","marked":"Nín'árín omi aiye"},{"start":39.848,"end":41.408,"text":"O mo wa sodo Kristi.","marked":"Ó mọ̀ wá sọ́dọ̀ Kristi."}],"end":41.408},{"key":"4","start":42.358,"lines":[{"start":42.358,"end":43.494,"text":"Olugbala, se 'jo Re","marked":"Olùgbàlà, ṣe 'jọ Rẹ"},{"start":43.874,"end":44.774,"text":"Ni fitila wura","marked":"Ní fìtílà wúrà"},{"start":45.154,"end":46.485,"text":"Lati tan imole Re","marked":"Láti tan ìmọ́lẹ̀̀ Rẹ"},{"start":46.865,"end":47.99,"text":"B'aiye igbani","marked":"B'aiye igbãni"},{"start":48.37,"end":49.65,"text":"Ko awon ti o sako","marked":"Kọ àwọn tí ó ṣáko"},{"start":50.03,"end":51.385,"text":"Lati lo 'mole yi","marked":"Láti lọ 'mọ́lẹ̀ yí"},{"start":51.765,"end":53.637,"text":"Tit'okun aiye y'o pin","marked":"Tít'òkun aiye y'ó pín"},{"start":54.017,"end":55.213,"text":"Ti nwon o r'oju Re.","marked":"Ti nwọn ò r'ojú Rẹ."},{"start":55.593,"end":56.203,"text":"Amin.","marked":"Àmín."}],"end":56.203}]}