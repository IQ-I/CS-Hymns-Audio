{"v":1,"coll":"y","num":303,"id":"hymn_303","title":"OLUGBALA mi ha gbogbe!","duration":40.291,"voices":{"male":{"file":"y-303-male.m4a","bytes":285931,"sha256":"5290ed298530a6540149efeef094f688b79747aae1e6ca8179f4a2f4f70a70ae","duration":40.3},"female":{"file":"y-303-female.m4a","bytes":294373,"sha256":"14dc27bae18db9db33a8f7bc7c99b673786bb14fa051982cb1edd7dee74bee26","duration":40.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.751,"text":"OLUGBALA mi ha gbogbe!","marked":"Olùgbàlà mi ha gbọgbẹ́!"},{"start":2.131,"end":3.242,"text":"Oba ogo ha ku!","marked":"Ọba ògo ha kú!"},{"start":3.622,"end":5.341,"text":"On ha je f'ara Re rubo","marked":"On ha jẹ f'ara Rẹ rúbọ"},{"start":5.721,"end":6.836,"text":"F'eni ile b'emi?","marked":"F'ẹni ilé b'èmi?"}],"end":6.836},{"key":"2","start":7.786,"lines":[{"start":7.786,"end":9.578,"text":"lha se ese ti mo da","marked":"lha ṣe ẹ̀ṣẹ̀ tí mo dá"},{"start":9.958,"end":11.44,"text":"L'o gbe ko s'ori igi?","marked":"L'ó gbé kò s'orí igi?"},{"start":11.82,"end":13.314,"text":"Anu at'ore yi ma po","marked":"Ànú àt'ọ̀rẹ́ yí mà pọ̀"},{"start":13.694,"end":15.065,"text":"lfe yi rekoja!","marked":"lfẹ́ yí rékọjá!"}],"end":15.065},{"key":"3","start":16.015,"lines":[{"start":16.015,"end":17.591,"text":"O ye k'orun f'oju pamo","marked":"Ó yé k'ọrun f'ojú pamọ́"},{"start":17.971,"end":19.145,"text":"K'o b'ogo re mole","marked":"K'ó b'ògo rẹ̀ mọ́lẹ̀"},{"start":19.525,"end":21.23,"text":"'Gbati Kristi Eleda ku","marked":"'Gbátí Kristi Ẹlẹ́dàá kù"},{"start":21.61,"end":22.757,"text":"Fun ese eda Re.","marked":"Fún ẹsẹ̀ ẹ̀dà Rẹ."}],"end":22.757},{"key":"4","start":23.707,"lines":[{"start":23.707,"end":25.2,"text":"Be l'o ye k'oju ba ti mi","marked":"Bẹ́ l'ó yẹ k'ojú bá tì mí"},{"start":25.58,"end":26.788,"text":"'Gba mo r'agbelebu","marked":"'Gbá mọ r'àgbélébùú"},{"start":27.168,"end":28.51,"text":"O ye k'okan mi kun f'ope","marked":"Ó yẹ k'ọkàn mi kún f'ọpẹ́"},{"start":28.89,"end":30.195,"text":"Oju mi f'omije.","marked":"Ojú mi f'omijé."}],"end":30.195},{"key":"5","start":31.145,"lines":[{"start":31.145,"end":32.526,"text":"Sugbon omije ko le san","marked":"Ṣùgbọ́n omijé kò lè ṣàn"},{"start":32.906,"end":34.285,"text":"Gbese 'fe ti mo je","marked":"Gbèsè 'fẹ́ tí mo jẹ́"},{"start":34.665,"end":35.933,"text":"Mo f'ara mi f'Oluwa mi","marked":"Mo f'ara mi f'Olúwa mi"},{"start":36.313,"end":37.736,"text":"Eyi ni mo le se.","marked":"Èyí ni mo lè ṣe."},{"start":38.116,"end":38.742,"text":"Amin.","marked":"Àmín."}],"end":38.742}]}