{"v":1,"coll":"y","num":243,"id":"hymn_243","title":"OLUWA, ma moju kuro","duration":40.841,"voices":{"male":{"file":"y-243-male.m4a","bytes":287934,"sha256":"f5aee916beb3f5f7e345a5842528ddd0f055926ee63bf69acc3d90548b1cfaae","duration":40.9},"female":{"file":"y-243-female.m4a","bytes":294612,"sha256":"ec8c9115b87192d1fe01e7460cf1221b4c2de88bf10adf226a697d36f2821680","duration":40.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.145,"text":"OLUWA, ma moju kuro","marked":"Olúwa, má mójú kúrò"},{"start":2.525,"end":3.999,"text":"L'odo emi t'o nyi'e","marked":"L'odò ẹ̀mí t'ó nyi'e"},{"start":4.379,"end":5.84,"text":"Ti nsokun ese aiye mi","marked":"Ti nsokun ẹsẹ̀ aiye mi"},{"start":6.22,"end":7.613,"text":"N'ite anu ife Re.","marked":"N'ìtẹ́ ànú ìfẹ́ Rẹ̀."}],"end":7.613},{"key":"2","start":8.563,"lines":[{"start":8.563,"end":10.025,"text":"Ma ba lo sinu dajo","marked":"Má bá lọ sínú dájọ́"},{"start":10.405,"end":11.752,"text":"Bi ese mi ti po to","marked":"Bí ẹsẹ̀ mi ti pọ̀ tó"},{"start":12.132,"end":13.444,"text":"Nitori mo mo daju pe","marked":"Nítorí mo mọ̀ dájú pé"},{"start":13.824,"end":15.325,"text":"Emi ko wa lailebi.","marked":"Èmi kò wà láìlẹ́bi."}],"end":15.325},{"key":"3","start":16.275,"lines":[{"start":16.275,"end":17.857,"text":"lwo mo, ki nto jewo re","marked":"lwo mọ́, kí ńtó jẹ́wọ́ rẹ̀"},{"start":18.237,"end":19.734,"text":"Bi mo ti nse laiye mi","marked":"Bí mo ti ńṣe láìyé mi"},{"start":20.114,"end":21.302,"text":"At'iwa isisiyi mi","marked":"Àt'ìwà ìṣíṣíyí mi"},{"start":21.682,"end":23.147,"text":"Gbogbo re l'O kiyesi.","marked":"Gbogbo rẹ̀ l'Ó kíyèsí."}],"end":23.147},{"key":"4","start":24.097,"lines":[{"start":24.097,"end":25.532,"text":"Emi ni f'atunwi se","marked":"Èmi ni f'àtúnwí ṣe"},{"start":25.912,"end":27.097,"text":"Ohun ti mo fe toro","marked":"Ohun tí mo fẹ́ tòrò"},{"start":27.477,"end":29.263,"text":"Ni iwo mo ki nto bere","marked":"Ni ìwọ mọ́ kí ńtọ́ bẹ̀rẹ̀"},{"start":29.643,"end":30.847,"text":"Anu ni lopolopo.","marked":"Ànú ni lọ́pọ̀lọpọ̀."}],"end":30.847},{"key":"5","start":31.797,"lines":[{"start":31.797,"end":32.874,"text":"Anu Oluwa ni mo fe","marked":"Ànú Olúwa ni mo fẹ́"},{"start":33.254,"end":34.591,"text":"Eyi l'opin gbogbo re","marked":"Èyí l'òpin gbogbo rẹ̀"},{"start":34.971,"end":36.607,"text":"Tori anu ni mo ntoro","marked":"Torí ànú ni mò ńtọrọ"},{"start":36.987,"end":38.337,"text":"Jeki nri anu gba.","marked":"Jẹki ńrí ànú gbà."},{"start":38.717,"end":39.291,"text":"Amin.","marked":"Àmín."}],"end":39.291}]}