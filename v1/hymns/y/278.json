{"v":1,"coll":"y","num":278,"id":"hymn_278","title":"RO iponju mi, Oluwa","duration":31.307,"voices":{"male":{"file":"y-278-male.m4a","bytes":214572,"sha256":"59280492c2431bf5be18c70b1374ee767f19d63659bee3f59d7bd003254afc99","duration":31.4},"female":{"file":"y-278-female.m4a","bytes":225211,"sha256":"695a0add18ea578f2cdca8ac96bdc68cb3c12c88a83957ed023dad45e24ad310","duration":31.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.792,"text":"RO iponju mi, Oluwa","marked":"Ro ìpọ́njú mi, Olúwa"},{"start":2.172,"end":3.335,"text":"Ran iranlowo Re!","marked":"Ran ìrànlọ́wọ́ Rẹ!"},{"start":3.715,"end":5.185,"text":"Okan mi daku fun 'gbala","marked":"Ọkàn mi dákú fún 'gbàlà"},{"start":5.565,"end":7.073,"text":"Ise mi ki o pin?","marked":"Iṣẹ́ mi kí ó pin?"}],"end":7.073},{"key":"2","start":8.023,"lines":[{"start":8.023,"end":9.381,"text":"Mo ri pe o dara fun mi","marked":"Mo ri pé ó dára fún mi"},{"start":9.761,"end":10.9,"text":"Bi Baba mi na mi","marked":"Bí Bàbá mi nà mí"},{"start":11.28,"end":12.557,"text":"Iya mu mi k ofin Re","marked":"Ìyá mú mi k òfin Rẹ̀"},{"start":12.937,"end":14.005,"text":"Ki ngeke mi le O.","marked":"Kí ngeke mi lé O."}],"end":14.005},{"key":"3","start":14.955,"lines":[{"start":14.955,"end":16.3,"text":"Mo mo pe idajo Re to","marked":"Mo mọ̀ pé ìdájọ́ Rẹ̀ tó"},{"start":16.68,"end":17.679,"text":"Bi o tile muna","marked":"Bí ó tilẹ̀ múná"},{"start":18.059,"end":19.839,"text":"Iponju ti mo f'ori ti","marked":"Ìpọ́njú tí mo f'orí tì"},{"start":20.219,"end":21.575,"text":"O ti odo Re wa.","marked":"Ó ti ọ̀dọ̀ Rẹ̀ wá."}],"end":21.575},{"key":"4","start":22.525,"lines":[{"start":22.525,"end":23.977,"text":"K'emi to m'owo ina Re","marked":"K'ẹ̀mí tó ḿ'ọwọ́ iná Rẹ"},{"start":24.357,"end":25.589,"text":"Emi a ma sina","marked":"Èmi a ma ṣínà"},{"start":25.969,"end":27.428,"text":"Sugbon bi mo ti k'oro Re","marked":"Ṣùgbọ́n bí mo ti k'ọ̀rọ̀ Rẹ"},{"start":27.808,"end":28.865,"text":"Emi ko sako mo.","marked":"Èmi kò ṣàkó mọ́."},{"start":29.245,"end":29.757,"text":"Amin.","marked":"Àmín."}],"end":29.757}]}