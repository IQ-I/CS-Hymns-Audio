{"v":1,"coll":"y","num":855,"id":"hymn_855","title":"EMI at'ara ile mi","duration":71.066,"voices":{"male":{"file":"y-855-male.m4a","bytes":522364,"sha256":"feda4b942c557e1b8abf80bf39fd9aab65cf6212db85c8981d5908ee739c81b2","duration":71.1},"female":{"file":"y-855-female.m4a","bytes":542081,"sha256":"1a591e297ccb7262fca68eb15a148bcd808fb0625c993db46e9b2090544f295b","duration":71.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.58,"text":"EMI at'ara ile mi","marked":"Èmi àt'ará ilé mi"},{"start":1.96,"end":3.341,"text":"Yoo ma sin Oluwa wa","marked":"Yóò má sin Olúwa wa"},{"start":3.721,"end":4.789,"text":"Sugbon emi papa","marked":"Ṣùgbọ́n ẹ̀mí pápá"},{"start":5.169,"end":6.611,"text":"Yon f'iwa at'oro han","marked":"Yọ́n f'ìwà àt'ọ̀rọ̀ hàn"},{"start":6.991,"end":8.372,"text":"Pe mo mo Oluwa t'orun","marked":"Pé mo mọ Olúwa t'ọrun"},{"start":8.752,"end":10.071,"text":"Mo nf'okan toto sin.","marked":"Mo nf'ọkàn tótọ́ sìn."}],"end":10.071},{"key":"2","start":11.021,"lines":[{"start":11.021,"end":12.467,"text":"Em'o f'apere 're le le","marked":"Em'ó f'apẹ̀rẹ̀ 'rẹ̀ lé lé"},{"start":12.847,"end":14.284,"text":"Un o mu idena na kuro","marked":"Un ò mú ìdènà nà kúrò"},{"start":14.664,"end":15.914,"text":"Lodo om'odo mi","marked":"Lọ́dọ̀ om'ọ̀dọ̀ mi"},{"start":16.294,"end":18.316,"text":"Un o f'ise won han ni iwa mi","marked":"Un ò f'iṣẹ́ wọn hàn ní ìwà mi"},{"start":18.696,"end":20.557,"text":"Sibe n'nu 'se mi ki nsi ni","marked":"Síbẹ̀ ń'nú 'ṣe mí kí ńsì ni"},{"start":20.937,"end":22.341,"text":"Ola na ti ife.","marked":"Ọ̀la na ti ìfẹ́."}],"end":22.341},{"key":"3","start":23.291,"lines":[{"start":23.291,"end":24.91,"text":"Emi ki y'o soro gb'ipe","marked":"Èmi kí y'ó sọ̀rọ̀ gb'ìpẹ́"},{"start":25.29,"end":26.63,"text":"Emi y'o pe tu ninu","marked":"Èmi y'ó pẹ́ tù nínú"},{"start":27.01,"end":28.118,"text":"Om'eyin Olorun","marked":"Om'ẹ̀yìn Ọlọ́run"},{"start":28.498,"end":29.953,"text":"Mo si fe je eni mimo","marked":"Mo sì fẹ́ jẹ́ ẹni mímọ́́"},{"start":30.333,"end":31.714,"text":"Ki nsi fa gbogbo ile mi","marked":"Kí nsì fa gbogbo ilé mi"},{"start":32.094,"end":33.371,"text":"S'oju ona orun.","marked":"S'ojú ọ̀nà ọ̀run."}],"end":33.371},{"key":"4","start":34.321,"lines":[{"start":34.321,"end":36.545,"text":"Jesu, b'o ba da 'na fe na","marked":"Jésù, b'ó bá dá 'ná fẹ́ ná"},{"start":36.925,"end":38.122,"text":"Ohun elo t'lwo fe lo","marked":"Ohun èlò t'lwò fẹ́ lọ"},{"start":38.502,"end":39.499,"text":"Gba s'owo ara Re","marked":"Gba s'ọ́wọ́ ara Rẹ"},{"start":39.879,"end":41.255,"text":"Sise ife rere n'nu mi","marked":"Ṣíṣe ìfẹ́ rere ń'nú mi"},{"start":41.635,"end":43.376,"text":"Ki nfi b'onigbagbo toto","marked":"Kí nfi b'onígbàgbọ́ toto"},{"start":43.756,"end":44.951,"text":"Ti ngbe l'aye han won.","marked":"Ti ngbẹ l'áyé hàn wọ́n."}],"end":44.951},{"key":"5","start":45.901,"lines":[{"start":45.901,"end":47.112,"text":"Fun mi l'or'ofe toto","marked":"Fún mi l'or'ọ̀fẹ́ tótọ́"},{"start":47.492,"end":49.552,"text":"Nje! Emi de lati jeri","marked":"Ǹjẹ́! Èmi dé láti jẹ́ri"},{"start":49.932,"end":50.953,"text":"Yanu oruko Re","marked":"Yanu orúkọ Rẹ"},{"start":51.333,"end":52.567,"text":"Ti o gba mi lowo egbe","marked":"Tí o gbà mí lọ́wọ́ ẹgbẹ́"},{"start":52.947,"end":54.446,"text":"Ire eyi t'a mo l'okan","marked":"Irè èyí t'á mọ́ l'ọ́kan"},{"start":54.826,"end":56.159,"text":"Ti gbogb'ahon le so.","marked":"Ti gbogb'ahon lè sọ."}],"end":56.159},{"key":"6","start":57.109,"lines":[{"start":57.109,"end":58.508,"text":"Emi t'o bo lowo ese","marked":"Èmi t'ó bọ́ lọ́wọ́ ẹsẹ̀"},{"start":58.888,"end":60.287,"text":"Mo wa lati gba le mi la","marked":"Mo wá láti gbà lé mi là"},{"start":60.667,"end":61.952,"text":"Ki nwasu dariji","marked":"Kí ńwàṣù dariji"},{"start":62.332,"end":64.928,"text":"F'omo, f'aya f'omo 'do mi","marked":"F'ọmọ, f'àyà f'ọmọ 'dọ mi"},{"start":65.308,"end":66.934,"text":"Lati mu won to 'na rere","marked":"Láti mú wọn tó 'ná rere"},{"start":67.314,"end":68.483,"text":"Lo si orun mimo.","marked":"Lọ sí ọ̀run mímọ́́."},{"start":68.863,"end":69.516,"text":"Amin.","marked":"Àmín."}],"end":69.516}]}