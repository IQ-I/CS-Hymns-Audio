{"v":1,"coll":"y","num":386,"id":"hymn_386","title":"'GBANI t'Olorun sokale","duration":56.255,"voices":{"male":{"file":"y-386-male.m4a","bytes":395858,"sha256":"67e7dc66cb8efcb714dd12f54c0f6ea39df5fa8050068e32da24d7eb26ec5e1d","duration":56.3},"female":{"file":"y-386-female.m4a","bytes":409860,"sha256":"b3324190907e0e10bbf881a64a786e24f5e70bc304fd174645e74028622630a7","duration":56.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.659,"text":"'GBANI t'Olorun sokale","marked":"'Gbani t'Ọlọ́run sọ̀kalẹ̀"},{"start":2.039,"end":3.058,"text":"O wa ni ibinu","marked":"Ó wà ní ìbínú"},{"start":3.438,"end":4.755,"text":"Ara si nsan niwaju Re","marked":"Ara sí ńsán níwájú Rẹ̀"},{"start":5.135,"end":6.182,"text":"Okunkun on ina.","marked":"Òkùnkùn ọ̀n iná."}],"end":6.182},{"key":"2","start":7.132,"lines":[{"start":7.132,"end":8.496,"text":"Nigbat'o wa nigba keji","marked":"Nígbàt'ó wà nígbà kejì"},{"start":8.876,"end":9.877,"text":"O wa ninu ife","marked":"Ó wà nínú ìfẹ́"},{"start":10.257,"end":11.972,"text":"Emi, Re si ntu ni lara","marked":"Èmi, Rẹ sì ńtu ni lára"},{"start":12.352,"end":13.583,"text":"B'afefe owuro.","marked":"B'afẹ́fẹ́ òwúrọ̀."}],"end":13.583},{"key":"3","start":14.533,"lines":[{"start":14.533,"end":16.037,"text":"Ina Sinai ljo kini","marked":"Iná Sínáì ljo kini"},{"start":16.417,"end":17.544,"text":"T'owo re mbu soke","marked":"T'ọwọ́ rẹ̀ ḿbù sókè"},{"start":17.924,"end":19.432,"text":"sokale jeje bi ade","marked":"sọ̀kalẹ̀ jẹ́jẹ́ bí adé"},{"start":19.812,"end":21.149,"text":"Si ori gbogbo won.","marked":"Sí orí gbogbo wọn."}],"end":21.149},{"key":"4","start":22.099,"lines":[{"start":22.099,"end":23.349,"text":"Bi ohun eru na ti dun","marked":"Bí ohùn ẹrú ná ti dùn"},{"start":23.729,"end":24.755,"text":"Leti Israeli","marked":"Létí Ísírẹ́lì"},{"start":25.135,"end":26.686,"text":"Ti nwon si gbo iro ipe","marked":"Ti nwọn sì gbọ́ ìró ìpè"},{"start":27.066,"end":28.324,"text":"T'o m'ohun angeli gbon.","marked":"T'ó m'ohun áńgẹ́lì gbọ́n."}],"end":28.324},{"key":"5","start":29.274,"lines":[{"start":29.274,"end":31.14,"text":"Be gage nigbat' Emi wa,","marked":"Bẹ́ gàgè nigbat' Emi wa"},{"start":31.52,"end":32.854,"text":"Ba le awon Tire","marked":"Bá lé àwọn Tírè"},{"start":33.234,"end":34.791,"text":"lro kan si ti orun wa","marked":"lró kan sì ti ọ̀run wá"},{"start":35.171,"end":36.337,"text":"Iro iji lile.","marked":"Ìró ìjì líle."}],"end":36.337},{"key":"6","start":37.287,"lines":[{"start":37.287,"end":40.364,"text":"O nkun, ife Jesu, o nkan","marked":"Ó nkún, ìfẹ́ Jésù, ó nkan"},{"start":40.744,"end":41.875,"text":"Aiye ese yika","marked":"Aiye ẹsẹ yíká"},{"start":42.255,"end":43.867,"text":"L'o kan alaigboran nikan","marked":"L'ó kan aláìgbọràn nìkan"},{"start":44.247,"end":45.49,"text":"Ni aye ko si fun.","marked":"Ní àyè kò sí fún."}],"end":45.49},{"key":"7","start":46.44,"lines":[{"start":46.44,"end":48.655,"text":"Wa, Ogbon, ife, at'lpa","marked":"Wà, Ọgbọ́n, ìfẹ́, àt'lpa"},{"start":49.035,"end":50.162,"text":"Mu ki eti wa si","marked":"Mú kí etí wà sí"},{"start":50.542,"end":52.048,"text":"K'a ma so akoko wa nu","marked":"K'á ma sọ àkókò wa nù"},{"start":52.428,"end":53.78,"text":"Ki 'fe Re le gba wa.","marked":"Kí 'fẹ́ Rẹ lè gbà wá."},{"start":54.16,"end":54.705,"text":"Amin.","marked":"Àmín."}],"end":54.705}]}