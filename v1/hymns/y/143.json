{"v":1,"coll":"y","num":143,"id":"hymn_143","title":"GBOGBO Egbe Onigbagbo","duration":89.25,"voices":{"male":{"file":"y-143-male.m4a","bytes":639507,"sha256":"6b1f871bf1f8dc861d73e2fec346ca9613bee4eaca7e60a2f494a37735803f8c","duration":89.3},"female":{"file":"y-143-female.m4a","bytes":664131,"sha256":"199018c612222e10ceeeb4b1a9165fa4a97a591b6e7a3f109792b4625f83b499","duration":89.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.534,"text":"GBOGBO Egbe Onigbagbo","marked":"Gbogbo Ẹgbẹ́ Onígbàgbọ́"},{"start":1.914,"end":3.397,"text":"T'o wa ni gbogbo aiye","marked":"T'ó wà ní gbogbo aiye"},{"start":3.777,"end":5.215,"text":"T'awon to wa nigberiko","marked":"T'àwọn tó wà nígbèríko"},{"start":5.595,"end":6.756,"text":"Ko jade wa woran.","marked":"Kò jáde wá wòran."}],"end":6.756},{"key":"CHORUS","start":7.706,"lines":[{"start":7.706,"end":10.099,"text":"Ka jo ho. Halleluya!","marked":"Ká jọ hó. Hallelúyà!"},{"start":10.479,"end":11.529,"text":"F' Oba Olodumare","marked":"F' Ọba Olódùmarè"},{"start":11.909,"end":13.365,"text":"A sope a t'ope da,","marked":"A ṣọpẹ́ a t'ọpẹ́ dá"},{"start":13.745,"end":15.376,"text":"T'o mu wa dojo oni.","marked":"T'ó mú wa dọjọ́ òní."}],"end":15.376},{"key":"2","start":16.326,"lines":[{"start":16.326,"end":18.165,"text":"Gbogbo Egbe ni gbogbo Ijo,","marked":"Gbogbo Ẹgbẹ́ ni gbogbo Ìjọ"},{"start":18.545,"end":19.737,"text":"Ko si 'ru eyi ri","marked":"Kò sì 'rú èyí rí"},{"start":20.117,"end":21.955,"text":"Ti Maikieli je Balogun fun","marked":"Ti Máíkíẹ́lì jẹ́ Balógun fún"},{"start":22.335,"end":23.801,"text":"Ko s'egbe to dun to.","marked":"Kò s'ègbè tó dùn tó."}],"end":23.801},{"key":"3","start":24.751,"lines":[{"start":24.751,"end":26.021,"text":"Emi Mimo lo ndari wa,","marked":"Ẹ̀mí Mímọ́́ ló ndari wa"},{"start":26.401,"end":27.524,"text":"T'enikan ko le mo","marked":"T'ẹnìkan kò le mọ́"},{"start":27.904,"end":29.346,"text":"A f'awon t'a firan na han","marked":"A f'àwọn t'á fìran ná hàn"},{"start":29.726,"end":31.005,"text":"Lo mo ijinle re.","marked":"Lọ mọ ìjìnlẹ̀ rẹ."}],"end":31.005},{"key":"4","start":31.955,"lines":[{"start":31.955,"end":33.175,"text":"At'okunrin at'obinrin,","marked":"Àt'ọkùnrin àt'obìnrin"},{"start":33.555,"end":34.744,"text":"T'o wa ni Serafu","marked":"T'ó wà ní Séráfù"},{"start":35.124,"end":36.586,"text":"Egbe ogun onigbagbo","marked":"Ẹgbẹ́ ogun onígbàgbọ́"},{"start":36.966,"end":38.197,"text":"K'a jumo d'orin po.","marked":"K'á jùmọ̀ d'orin pọ̀."}],"end":38.197},{"key":"5","start":39.147,"lines":[{"start":39.147,"end":41.643,"text":"Aje, Oso, ko n'ipa kan","marked":"Ajé, Ọ̀ṣọ́, kò ń'ípa kan"},{"start":42.023,"end":43.354,"text":"Lor'Egbe t'awa yi,","marked":"Lọ́r'Ẹgbẹ́ t'áwà yí"},{"start":43.734,"end":45.651,"text":"Balogun Egbe Serafu","marked":"Balógun Ẹgbẹ́ Séráfù"},{"start":46.031,"end":47.22,"text":"Ti jagun o molu.","marked":"Ti jagun ò mọ̀lú."}],"end":47.22},{"key":"6","start":48.17,"lines":[{"start":48.17,"end":49.645,"text":"Awamaridi n'ise Re","marked":"Awamaridi n'iṣẹ́ Rẹ"},{"start":50.025,"end":51.323,"text":"T'enikan ko le mo","marked":"T'ẹnìkan kò le mọ́"},{"start":51.703,"end":53.685,"text":"Eda aiye, eda orun","marked":"Ẹ̀dá aiye, ẹ̀dá ọ̀run"},{"start":54.065,"end":55.092,"text":"Ko le ridi 'se Re.","marked":"Kò lè rídì 'ṣe Rẹ̀."}],"end":55.092},{"key":"7","start":56.042,"lines":[{"start":56.042,"end":57.524,"text":"Gbogbo awon alailera","marked":"Gbogbo àwọn aláìlera"},{"start":57.904,"end":59.187,"text":"To wa nin 'Egbe na;","marked":"Tó wà nin 'Ègbé ná"},{"start":59.567,"end":61.613,"text":"Njeri si ohun ti nwon ri,","marked":"Ǹjẹ́rí sí ohun tí nwọn rí"},{"start":61.993,"end":63.208,"text":"Oluwa lo nsabo won.","marked":"Olúwa ló ńṣàbò wọn."}],"end":63.208},{"key":"8","start":64.158,"lines":[{"start":64.158,"end":65.653,"text":"Awon Egbe to wa lorun","marked":"Àwọn Ẹgbẹ́ tó wà lọ́run"},{"start":66.033,"end":67.852,"text":"Nko si Serafu t'aiye","marked":"Nkò sí Séráfù t'áiye"},{"start":68.232,"end":69.986,"text":"Pe ka mura ka d'owo po","marked":"Pé ká múra ká d'ówó pọ̀"},{"start":70.366,"end":71.748,"text":"Ka jo yin Oba Ogo.","marked":"Ká jọ yin Ọba Ògo."}],"end":71.748},{"key":"9","start":72.698,"lines":[{"start":72.698,"end":74.777,"text":"Pipe, Mimo, Tito, Rere","marked":"Pípé, Mímọ́́, Títọ́, Rere"},{"start":75.157,"end":76.176,"text":"Fawon to wa lorun","marked":"Fáwọn tó wà lọ́run"},{"start":76.556,"end":77.938,"text":"Imole itansan si ntan","marked":"Ìmọ́lẹ̀̀ ìtànṣán sí ńtàn"},{"start":78.318,"end":79.398,"text":"Irawo Owuro.","marked":"Ìràwọ̀ Òwúrọ̀."}],"end":79.398},{"key":"10","start":80.348,"lines":[{"start":80.348,"end":81.931,"text":"Mimo ati Mimo julo","marked":"Mímọ́́ àti Mímọ́́ jùlọ"},{"start":82.311,"end":83.547,"text":"Jehovah-Jireh wa,","marked":"Jehovah-Jireh wà"},{"start":83.927,"end":85.635,"text":"Jehovah‐Rufi yio so wa","marked":"Jehovah-Rufi yìó sọ wá"},{"start":86.015,"end":87.7,"text":"Latubotan aiye wa.","marked":"Látúbọ̀tán aiye wa."}],"end":87.7}]}