{"v":1,"coll":"y","num":258,"id":"hymn_258","title":"MO kese mi le, Jesu","duration":58.597,"voices":{"male":{"file":"y-258-male.m4a","bytes":427605,"sha256":"312a19d7dfa9cc3808d1c9e05d1a3fad85e4f7da691cf7089c87c0c62fa74407","duration":58.6},"female":{"file":"y-258-female.m4a","bytes":442498,"sha256":"047d14986b59211f2c9f0440d5d53a8a9f718d839c335d0baaa4bd9da9088576","duration":58.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.327,"text":"MO kese mi le, Jesu","marked":"Mo kẹ́sẹ̀ mi lé, Jésù"},{"start":2.707,"end":3.875,"text":"Od'agutan Mimo","marked":"Od'agutan Mímọ́́"},{"start":4.255,"end":5.488,"text":"O ru gbogbo eru mi","marked":"Ó ru gbogbo ẹrù mi"},{"start":5.868,"end":7.381,"text":"O so mi d' ominira","marked":"Ó sọ mí d' òmìnira"},{"start":7.761,"end":9.148,"text":"Mo ru ebi mi to wa","marked":"Mo ru ẹbí mi tó wà"},{"start":9.528,"end":10.825,"text":"K'o we eri mi nu","marked":"K'ó wé ẹ̀rí mi nù"},{"start":11.205,"end":12.65,"text":"K'eje Re iyebiye","marked":"K'ẹ̀jẹ̀ Rẹ iyebíye"},{"start":13.03,"end":14.375,"text":"Le so mi di funfun.","marked":"Lè sọ mí di funfun."}],"end":14.375},{"key":"2","start":15.325,"lines":[{"start":15.325,"end":16.851,"text":"Mo k'aini mi le Jesu","marked":"Mo k'áìnì mi lé Jésù"},{"start":17.231,"end":18.461,"text":"Tire l'ohun gbogbo","marked":"Tìrẹ l'ohun gbogbo"},{"start":18.841,"end":20.178,"text":"Ow'arun mi gbogbo san","marked":"Ow'àrùn mi gbogbo sàn"},{"start":20.558,"end":21.542,"text":"O r'emi mi pada","marked":"Ó r'ẹ̀mí mi padà"},{"start":21.922,"end":23.087,"text":"Mo ko ibanuje mi","marked":"Mo kọ ìbànújẹ́ mi"},{"start":23.467,"end":24.954,"text":"Eru at'aniyan","marked":"Ẹrú àt'àníyàn"},{"start":25.334,"end":27.44,"text":"Le Jesu, O si gba mi","marked":"Lé Jésù, Ó sì gbà mí"},{"start":27.82,"end":28.919,"text":"O gba irora mi.","marked":"Ó gba ìrora mi."}],"end":28.919},{"key":"3","start":29.869,"lines":[{"start":29.869,"end":31.08,"text":"Mo gb'okan mi le Jesu","marked":"Mo gb'ọkàn mi lé Jésù"},{"start":31.46,"end":32.663,"text":"Okan ara mi yi","marked":"Ọkàn ara mi yi"},{"start":33.043,"end":34.339,"text":"Ow'otun Re gba mi mu","marked":"Ow'ọ̀tún Rẹ gbá mi mú"},{"start":34.719,"end":35.839,"text":"Mo simi laya Re","marked":"Mo sìmí láyà Rẹ"},{"start":36.219,"end":37.661,"text":"Mo fe oruko Jesu","marked":"Mo fẹ́ orúkọ Jésù"},{"start":38.041,"end":39.422,"text":"Emmanuel, Kristi.","marked":"Emmanuel, Kristi."},{"start":39.802,"end":41.025,"text":"Bi orun didun yika","marked":"Bí ọrùn dídùn yíká"},{"start":41.405,"end":42.514,"text":"Ni oruko Re je.","marked":"Ní orúkọ Rẹ jẹ́."}],"end":42.514},{"key":"4","start":43.464,"lines":[{"start":43.464,"end":44.936,"text":"Mo fe ki nri bi Jesu","marked":"Mo fẹ́ kí ńrí bí Jésù"},{"start":45.316,"end":46.394,"text":"Tokan Re kun fun 'fe","marked":"Tọkàn Rẹ kún fún 'fẹ́"},{"start":46.774,"end":48.139,"text":"Mo fe ki nri bi Jesu","marked":"Mo fẹ́ kí ńrí bí Jésù"},{"start":48.519,"end":49.542,"text":"Omo Mimo Baba","marked":"Ọmọ Mímọ́́ Bàbá"},{"start":49.922,"end":51.492,"text":"Mo fe ki mba Jesu gbe","marked":"Mo fẹ́ kí ḿbá Jésù gbé"},{"start":51.872,"end":52.925,"text":"Larin egbe mimo","marked":"Lárin ẹgbẹ́ mímọ́́"},{"start":53.305,"end":54.491,"text":"Ki nkorin iyin titi","marked":"Kí nkọrin ìyìn títí"},{"start":54.871,"end":56.201,"text":"Orin t'Angeli nko.","marked":"Orin t'Áńgẹ́lì ńkọ́."},{"start":56.581,"end":57.047,"text":"Amin.","marked":"Àmín."}],"end":57.047}]}