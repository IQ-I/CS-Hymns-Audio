{"v":1,"coll":"y","num":126,"id":"hymn_126","title":"OLORUN ailopin, Iwo","duration":63.556,"voices":{"male":{"file":"y-126-male.m4a","bytes":458916,"sha256":"9358441e668f428bff2d008ce3e468011f292a9db4717c2ab1b04f3aeaf27ab7","duration":63.6},"female":{"file":"y-126-female.m4a","bytes":475764,"sha256":"e1d1e59576a763bdd0c6561a8373bafce9257c4386882c31dd15a71047199cf0","duration":63.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.169,"text":"OLORUN ailopin, Iwo","marked":"Ọlọ́run àìlópin, Ìwọ"},{"start":2.549,"end":4.06,"text":"L'a f'iyin atokan wa fun","marked":"L'á f'ìyìn àtọkàn wa fún"},{"start":4.44,"end":5.65,"text":"Gbogbo 'se Re l'aiye yin O","marked":"Gbogbo 'ṣe Ré l'áiye yín O"},{"start":6.03,"end":7.683,"text":"A juba Re, Oluwa wa,","marked":"A júbà Rẹ, Olúwa wa"},{"start":8.063,"end":10.339,"text":"Baba aiyeraiye, jeki","marked":"Bàbá aiyérayé, jẹ́kí"},{"start":10.719,"end":12.15,"text":"Okan wa wole n'ite Re.","marked":"Ọkàn wa wọlé n'ítẹ̀ Rẹ̀."}],"end":12.15},{"key":"2","start":13.1,"lines":[{"start":13.1,"end":14.255,"text":"Awon angel' nkorin yin O","marked":"Àwọn angel' nkorin yín O"},{"start":14.635,"end":16.572,"text":"Balogun, Oba 'won Oba,","marked":"Balógun, Ọba 'wọn Ọba"},{"start":16.952,"end":18.485,"text":"Kikan l'awon Kerubu nyin","marked":"Kíkàn l'àwọn Kérúbù nyin"},{"start":18.865,"end":20.689,"text":"Seraf' si nyin Metalokan;","marked":"Seraf' sì nyín Mẹ́talọ́kan"},{"start":21.069,"end":23.53,"text":"Nwon nko, Mimo mimo, mimo","marked":"Nwọ̀n ńkọ́, Mímọ́́ mímọ́́, mímọ́́"},{"start":23.91,"end":25.86,"text":"Orun, aiye, kun f'ogo Re!","marked":"Ọ̀run, aiye, kún f'ògo Rẹ!"}],"end":25.86},{"key":"3","start":26.81,"lines":[{"start":26.81,"end":27.942,"text":"Olorun awon baba wa","marked":"Ọlọ́run àwọn bàbá wa"},{"start":28.322,"end":29.525,"text":"Awon Woli ti rohin Re","marked":"Àwọn Wòlí ti ròhìn Rẹ̀"},{"start":29.905,"end":31.348,"text":"Egbe Aposteli rere,","marked":"Ẹgbẹ́ Apostélì rere"},{"start":31.728,"end":33.576,"text":"Nwon mbe l'ayo ati ogo","marked":"Nwọn mbẹ l'àyò àti ògo"},{"start":33.956,"end":35.272,"text":"Woli ati awon mimo","marked":"Wòlí àti àwọn mímọ́́"},{"start":35.652,"end":37.13,"text":"Dapo lati gb'ola Re ga.","marked":"Dàpọ̀ láti gb'ọlá Rẹ̀ ga."}],"end":37.13},{"key":"4","start":38.08,"lines":[{"start":38.08,"end":39.459,"text":"Olor' awon ajeriku,","marked":"Olór' àwọn ajẹ́ríkù"},{"start":39.839,"end":41.465,"text":"Nwon nf'oto sogo ninu Re,","marked":"Nwọ̀n ńf'ọ̀tọ̀ ṣògo nínú Rẹ̀"},{"start":41.845,"end":43.121,"text":"Ijo gbe ohun re soke","marked":"Ìjọ gbé ohùn rẹ̀ sókè"},{"start":43.501,"end":44.976,"text":"Yin Eleda gbogbo aiye","marked":"Yin Ẹlẹ́dàá gbogbo aiye"},{"start":45.356,"end":47.712,"text":"Nwon si mba 'won t'o y'ite ka,","marked":"Nwọ̀n sì ḿbá 'wọn t'ó y'ítẹ̀ ká"},{"start":48.092,"end":49.562,"text":"Korin jinle Metalokan.","marked":"Kọrin jinlẹ̀ Mẹ́talọ́kan."}],"end":49.562},{"key":"5","start":50.512,"lines":[{"start":50.512,"end":51.666,"text":"Baba Olola ailopin,","marked":"Bàbá Ọlọ́lá àìlópin"},{"start":52.046,"end":53.864,"text":"Tire l'agbara at'ife","marked":"Tìrẹ l'ágbára àt'ife"},{"start":54.244,"end":55.713,"text":"A juba Omo Re owon","marked":"A júbà Ọmọ Rẹ̀ ọ̀wọ́n"},{"start":56.093,"end":57.666,"text":"T'o mbe n'nu ogo pelu Re,","marked":"T'ó ḿbẹ ń'nú ògo pẹ̀lú Rẹ"},{"start":58.046,"end":59.191,"text":"At'Olorun Emi Mimo,","marked":"Àt'Ọlọ́run Ẹ̀mí Mímọ́́"},{"start":59.571,"end":60.935,"text":"Olutunu aiyeraiye.","marked":"Olùtùnú aiyérayé."},{"start":61.315,"end":62.006,"text":"Amin.","marked":"Àmín."}],"end":62.006}]}