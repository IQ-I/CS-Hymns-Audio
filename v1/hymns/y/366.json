{"v":1,"coll":"y","num":366,"id":"hymn_366","title":"ILE bukun kan wa","duration":55.302,"voices":{"male":{"file":"y-366-male.m4a","bytes":397755,"sha256":"7c48e218787ec0e759ee0af14a905cd8debc7497e89f3d53626dca104f4a1200","duration":55.4},"female":{"file":"y-366-female.m4a","bytes":411820,"sha256":"cd52467068ec82a21731a67ce38bdaa60a828e672e2df126b6f49205c93c1020","duration":55.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.46,"text":"ILE bukun kan wa","marked":"Ilé bùkún kan wà"},{"start":1.84,"end":2.976,"text":"Lehin aiye wa yi","marked":"Lẹ́hìn aiye wa yi"},{"start":3.356,"end":5.073,"text":"Wahala, irora","marked":"Wàhálà, ìrora"},{"start":5.453,"end":6.799,"text":"At'ekun ki de 'be","marked":"Àt'ẹkùn kí dé 'bẹ̀"},{"start":7.179,"end":8.705,"text":"lgbagbo y'o dopin","marked":"lgbàgbọ́ y'ó dópin"},{"start":9.085,"end":10.537,"text":"Ao de 'reti l'ade","marked":"Aó dé 'reti l'ade"},{"start":10.917,"end":12.091,"text":"Imole ailopin","marked":"Ìmọ́lẹ̀̀ àìlópin"},{"start":12.471,"end":13.75,"text":"Ni gbogbo ibe je.","marked":"Ní gbogbo ibẹ̀ jẹ́."}],"end":13.75},{"key":"2","start":14.7,"lines":[{"start":14.7,"end":15.946,"text":"Ile kan si tun mbe","marked":"Ilé kan sì tún ḿbẹ"},{"start":16.326,"end":17.272,"text":"Ile alafia","marked":"Ilẹ̀ àlàáfíà"},{"start":17.652,"end":18.695,"text":"Awon Angel rere","marked":"Àwọn Angel rere"},{"start":19.075,"end":20.444,"text":"Nkorin n'nu re lailai","marked":"Nkọrin ń'nú rẹ̀ láíláí"},{"start":20.824,"end":22.061,"text":"Y'ite ogo Re ka","marked":"Y'ítẹ ògo Rẹ̀ ká"},{"start":22.441,"end":23.413,"text":"L'awon egbe mimo","marked":"L'áwọn ẹgbẹ́ mímọ́́"},{"start":23.793,"end":24.987,"text":"Nwole nwon nteriba","marked":"Ńwọlé nwọn ńtèrìbá"},{"start":25.367,"end":26.529,"text":"F'Eni Metalokan.","marked":"F'Ẹni Mẹ́talọ́kan."}],"end":26.529},{"key":"3","start":27.479,"lines":[{"start":27.479,"end":28.72,"text":"Ayo won ti po to!","marked":"Ayọ̀ wọn ti pọ̀ tó!"},{"start":29.1,"end":30.24,"text":"Awon to ri Jesu","marked":"Àwọn tó rí Jésù"},{"start":30.62,"end":31.808,"text":"Nibit'o gbe gunwa","marked":"Níbit'ó gbé gúnwà"},{"start":32.188,"end":33.663,"text":"T'a si nfi ogo fun","marked":"T'á sì ńfi ògo fún"},{"start":34.043,"end":34.991,"text":"Nwon nkorin iyin Re","marked":"Nwọ̀n ńkọrin ìyìn Rẹ"},{"start":35.371,"end":36.398,"text":"At t' isegun Re","marked":"Àt t' ìṣẹ́gun Rẹ"},{"start":36.778,"end":38.071,"text":"Nwon ko dekun rohin","marked":"Nwọn kò dẹ́kun ròhìn"},{"start":38.451,"end":39.89,"text":"Ohun nla t'o ti se.","marked":"Ohun ńlá t'ó ti ṣe."}],"end":39.89},{"key":"4","start":40.84,"lines":[{"start":40.84,"end":42.424,"text":"W'Oke, enyin mimo","marked":"W'Òkè, enyin mímọ́́"},{"start":42.804,"end":43.775,"text":"E le iberu lo","marked":"Ẹ lé ìbẹ̀rù lọ"},{"start":44.155,"end":45.138,"text":"Ona hiha kanna","marked":"Ọ̀nà híhá kànnà"},{"start":45.518,"end":46.733,"text":"L'Olugbala ti gba","marked":"L'Olùgbàlà ti gbà"},{"start":47.113,"end":48.52,"text":"E fi suru duro","marked":"Ẹ fi ṣùrù dúró"},{"start":48.9,"end":50.244,"text":"Fun igba die sa","marked":"Fún ìgbà díẹ̀ ṣá"},{"start":50.624,"end":51.832,"text":"Terin-terin l'On o","marked":"Tẹ̀rín-tẹ̀rín l'Ọ́n o"},{"start":52.212,"end":53.752,"text":"Fi gba nyin sodo Re.","marked":"Fi gbà nyin sọ́dọ̀ Rẹ."}],"end":53.752}]}