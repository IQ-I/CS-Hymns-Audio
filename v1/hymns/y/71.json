{"v":1,"coll":"y","num":71,"id":"hymn_71","title":"GBANGBA l'oju Re Olorun","duration":46.691,"voices":{"male":{"file":"y-71-male.m4a","bytes":328832,"sha256":"39d994c89aee222746b42e9f9c7ad89ed52c95f6e05fc6c771cdee105cdbb23f","duration":46.7},"female":{"file":"y-71-female.m4a","bytes":350954,"sha256":"c70f0263cbadf19efbe890c438be42162395917acc147bbb5d8f940344a93556","duration":46.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.575,"text":"GBANGBA l'oju Re Olorun","marked":"Gbangba l'ojú Rẹ Ọlọ́run"},{"start":1.955,"end":3.37,"text":"S'Ohun gbogbo ta use,","marked":"S'Ohun gbogbo ta use"},{"start":3.75,"end":5.547,"text":"T'osan t'oru bakanna ni,","marked":"T'ọ̀sán t'oru bákanná ni"},{"start":5.927,"end":7.059,"text":"L'oju Oluwa wa.","marked":"L'ojú Olúwa wa."}],"end":7.059},{"key":"2","start":8.009,"lines":[{"start":8.009,"end":10.13,"text":"Ko s'ese kan ti a le da","marked":"Kò s'ẹsẹ kan tí a lè dá"},{"start":10.51,"end":11.793,"text":"Ko s'oro t'a le so","marked":"Kò s'oro t'á lè so"},{"start":12.173,"end":13.525,"text":"Ti ko si ninu iwe Re","marked":"Tí kò sí nínú ìwé Rẹ"},{"start":13.905,"end":14.922,"text":"Fun iranti gbogbo.","marked":"Fún ìrántí gbogbo."}],"end":14.922},{"key":"3","start":15.872,"lines":[{"start":15.872,"end":17.506,"text":"Ese ole, ese iro","marked":"Ẹsẹ̀ olè, ẹsẹ̀ irọ́"},{"start":17.886,"end":18.991,"text":"Ese aiforiji","marked":"Ẹ̀ṣẹ̀ àìforíjì"},{"start":19.371,"end":20.864,"text":"Ese ka soro eni lehin","marked":"Ẹsẹ̀ ká sọ̀rọ̀ ẹni lẹ́hìn"},{"start":21.244,"end":22.469,"text":"Baba dariji wa.","marked":"Bàbá dáríjì wa."}],"end":22.469},{"key":"4","start":23.419,"lines":[{"start":23.419,"end":24.54,"text":"Ese igberaga okan","marked":"Ẹ̀ṣẹ̀ ìgbéraga ọkàn"},{"start":24.92,"end":26.057,"text":"Ese isokuso","marked":"Ẹsẹ ìsọkúsọ"},{"start":26.437,"end":28.093,"text":"Ese aini 'gbagbo daju","marked":"Ẹsẹ̀ àìní 'gbàgbọ́ dájú"},{"start":28.473,"end":29.686,"text":"Baba dariji wa.","marked":"Bàbá dáríjì wa."}],"end":29.686},{"key":"5","start":30.636,"lines":[{"start":30.636,"end":32.234,"text":"A! l'ojo nla ojo 'dajo","marked":"A! l'ọjọ́ ńlá ọjọ́ 'dájọ́"},{"start":32.614,"end":33.849,"text":"Ma je k'oju tiwa","marked":"Má jẹ k'ojú tiwa"},{"start":34.229,"end":35.984,"text":"T'oju gbogbo aiye yio pe","marked":"T'ojú gbogbo aiye yio pe"},{"start":36.364,"end":37.575,"text":"Baha dariji wa.","marked":"Baha dariji wa."}],"end":37.575},{"key":"6","start":38.525,"lines":[{"start":38.525,"end":39.691,"text":"Dariji mi Olorun mi,","marked":"Dáríjì mi Ọlọ́run mi"},{"start":40.071,"end":41.69,"text":"Ki nto lo laiye yi,","marked":"Kí ńtó ló láìyé yí"},{"start":42.07,"end":43.444,"text":"Si pa gbogbo ese mi re","marked":"Sì pa gbogbo ẹ̀ṣẹ̀ mi rẹ́"},{"start":43.824,"end":45.141,"text":"Baba danriji mi.","marked":"Bàbá dánríjì mi."}],"end":45.141}]}