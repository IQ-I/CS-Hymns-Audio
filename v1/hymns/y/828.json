{"v":1,"coll":"y","num":828,"id":"hymn_828","title":"ONIGBAGBO, e wa","duration":38.89,"voices":{"male":{"file":"y-828-male.m4a","bytes":270185,"sha256":"b76a24a8d190315190e2f7e8a5751b11684ebc9af5a87e00058c5794a0ba668d","duration":38.9},"female":{"file":"y-828-female.m4a","bytes":291765,"sha256":"0899c9af5b63978a7f2d89d650891cd064bd3659045f83389979fa8ca5f0b323","duration":38.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.853,"text":"ONIGBAGBO, e wa","marked":"Onígbàgbọ́, ẹ wà"},{"start":2.233,"end":3.33,"text":"Isreali t'emi","marked":"Isreali t'èmi"},{"start":3.71,"end":5.06,"text":"Jesu mbebe pupopupo","marked":"Jésù ḿbẹ̀bẹ̀ púpọ̀púpọ̀"},{"start":5.44,"end":6.686,"text":"Bi Alagbawi wa.","marked":"Bí Alágbàwí wa."}],"end":6.686},{"key":"CHORUS","start":7.636,"lines":[{"start":7.636,"end":10.573,"text":"E ho, e yo, f'inu didun gberin","marked":"Ẹ hó, ẹ yó, f'ínú dídùn gberin"},{"start":10.953,"end":12.855,"text":"Enyin 'Male ati Keferi","marked":"Enyin 'Málẹ́ àti Kèfèrí"},{"start":13.235,"end":14.321,"text":"E wa si 'mole.","marked":"Ẹ wá sí 'mọ́lẹ̀."}],"end":14.321},{"key":"2","start":15.271,"lines":[{"start":15.271,"end":16.654,"text":"Nigbat' ojo 'dajo ba de","marked":"Nígbàt' ọjọ́ 'dájọ́ bá dé"},{"start":17.034,"end":18.49,"text":"Bawo ni wo o ti wi","marked":"Báwo ni wò ó ti wí"},{"start":18.87,"end":20.563,"text":"Gbat' o pin fun kaluku","marked":"Gbat' ò pín fún kálukú"},{"start":20.943,"end":22.004,"text":"Gege bi ise re.","marked":"Gẹ́gẹ́ bí ìṣe rẹ."}],"end":22.004},{"key":"3","start":22.954,"lines":[{"start":22.954,"end":24.846,"text":"Nigbati nwasu nijosi","marked":"Nígbàtí ńwásù níjọsí"},{"start":25.226,"end":26.233,"text":"Iwo ko si nibe","marked":"Ìwọ kò sí níbẹ̀"},{"start":26.613,"end":28.147,"text":"Mase tun wi awawi mo","marked":"Masẹ̀ tún wí àwáwí mọ́"},{"start":28.527,"end":29.662,"text":"Bo sinu imole.","marked":"Bọ́ sínú ìmọ́lẹ̀̀."}],"end":29.662},{"key":"4","start":30.612,"lines":[{"start":30.612,"end":32.023,"text":"E f'Ogo fun Baba loke","marked":"Ẹ f'Ògo fún Bàbá lókè"},{"start":32.403,"end":33.719,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":34.099,"end":35.43,"text":"E f'Ogo fun Emi Mimo","marked":"Ẹ f'Ògo fún Ẹ̀mí Mímọ́́"},{"start":35.81,"end":37.34,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."}],"end":37.34}]}