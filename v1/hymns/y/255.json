{"v":1,"coll":"y","num":255,"id":"hymn_255","title":"OLU WA, b'agbowode ni","duration":40.229,"voices":{"male":{"file":"y-255-male.m4a","bytes":277599,"sha256":"2eba077dea68946218d28a8efec37630bea97b6d10a5936f62e1ce831b693842","duration":40.3},"female":{"file":"y-255-female.m4a","bytes":288844,"sha256":"d13474b33dd67b7bbaafcd2db2a1a356544a1ce4651ce793143d944619133a75","duration":40.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.953,"text":"OLU WA, b'agbowode ni","marked":"Olú Wa, b'ágbowóde ni"},{"start":2.333,"end":3.314,"text":"Mo gb'okan mi le O","marked":"Mo gb'ọkàn mi le O"},{"start":3.694,"end":5.532,"text":"Oluwa, f' ore-ofe wi","marked":"Olúwa, f' ọrẹ-ọ̀fẹ́ wí"},{"start":5.912,"end":7.141,"text":"K'o se anu fun mi.","marked":"K'ó ṣe ãnú fún mi."}],"end":7.141},{"key":"2","start":8.091,"lines":[{"start":8.091,"end":9.798,"text":"Mo lu aiduro aiya mi","marked":"Mo lu àìdúró àìyá mi"},{"start":10.178,"end":11.269,"text":"Ekun at'irora","marked":"Ẹkùn àt'ìrora"},{"start":11.649,"end":12.853,"text":"K'o gb'okan mi'nu irora","marked":"K'ó gb'ọkàn mi'nú ìrora"},{"start":13.233,"end":14.418,"text":"K'o se anu fun mi.","marked":"K'ó ṣe ãnú fún mi."}],"end":14.418},{"key":"3","start":15.368,"lines":[{"start":15.368,"end":17.633,"text":"N'itiju, mo jew' ese mi","marked":"N'ìtìjú, mo jew' ẹsẹ̀ mi"},{"start":18.013,"end":19.267,"text":"Jo fun mi ni ireti","marked":"Jọ fún mi ní ìrètí"},{"start":19.647,"end":21.652,"text":"Mo be, 'tori eje Jesu","marked":"Mo bẹ̀, 'torí ẹ̀jẹ̀ Jésù"},{"start":22.032,"end":23.287,"text":"K'o se anu fun mi.","marked":"K'ó ṣe ãnú fún mi."}],"end":23.287},{"key":"4","start":24.237,"lines":[{"start":24.237,"end":25.636,"text":"Olori elese ni mi","marked":"Olórí ẹlẹ́ṣẹ̀ ni mí"},{"start":26.016,"end":27.217,"text":"Ese mi p'apoju","marked":"Ẹsẹ̀ mi p'àpọ̀jù"},{"start":27.597,"end":28.927,"text":"Nitori iku Jesu wa","marked":"Nítorí ikú Jésù wá"},{"start":29.307,"end":30.524,"text":"K'O se anu fun mi.","marked":"K'ó ṣe ãnú fún mi."}],"end":30.524},{"key":"5","start":31.474,"lines":[{"start":31.474,"end":32.865,"text":"Mo duro ti agbelebu","marked":"Mo dúró ti àgbélébùú"},{"start":33.245,"end":34.346,"text":"Nko sa f'ojiji re","marked":"Nkò sá f'òjijì rẹ̀"},{"start":34.726,"end":36.178,"text":"Ti Olorun to po l'anu","marked":"Ti Ọlọ́run tó pọ̀ l'ánú"},{"start":36.558,"end":37.79,"text":"O ti sanu fun mi.","marked":"Ó ti sanu fún mi."},{"start":38.17,"end":38.679,"text":"Amin.","marked":"Àmín."}],"end":38.679}]}