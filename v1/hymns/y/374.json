{"v":1,"coll":"y","num":374,"id":"hymn_374","title":"SO itan kanna fun mi","duration":42.86,"voices":{"male":{"file":"y-374-male.m4a","bytes":310066,"sha256":"85a958edba056b3f817e47fc6443ab9c5c7425bccd4a834dfa8d53f04c3b0ab8","duration":42.9},"female":{"file":"y-374-female.m4a","bytes":325498,"sha256":"4a73612337b9ebd5d4817a5fa3ba08765b99c2d7afb956ee8d00fb1a3d362f71","duration":42.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.425,"text":"SO itan kanna fun mi","marked":"Sọ ìtàn kanná fún mi"},{"start":1.805,"end":2.752,"text":"T'ohun ti mbe lorun","marked":"T'óhun ti ḿbẹ lọ́run"},{"start":3.132,"end":4.516,"text":"Ti Jesu on Ogo Re","marked":"Ti Jésù ọ́n Ògo Rẹ̀"},{"start":4.896,"end":6.172,"text":"Ti Jesu on 'Fe Re","marked":"Tí Jésù on 'Fẹ́ Rẹ"},{"start":6.552,"end":7.802,"text":"So 'tan na ye mi daju","marked":"Sọ 'tán ná yé mi dájú"},{"start":8.182,"end":9.5,"text":"B'o ba ti so f'ewe","marked":"B'ó bá ti sọ f'ewé"},{"start":9.88,"end":11.374,"text":"Nitori emi ko l'okun","marked":"Nítorí èmi kò l'òkun"},{"start":11.754,"end":13.212,"text":"Mo si je l'elese.","marked":"Mo ṣì jẹ́ l'ẹlẹ́sẹ̀."}],"end":13.212},{"key":"2","start":14.162,"lines":[{"start":14.162,"end":15.424,"text":"So'tan na fun mi pele","marked":"Sọ́'tán ná fún mi pẹ̀lẹ́"},{"start":15.804,"end":16.894,"text":"Ki o ba Ie ye mi","marked":"Kí ó bá lè yé mi"},{"start":17.274,"end":18.685,"text":"Ti Iyanu Irapada","marked":"Ti Ìyanu Ìràpadà"},{"start":19.065,"end":20.2,"text":"T'etutu fun ese","marked":"T'ètùtù fún ẹ̀ṣẹ̀"},{"start":20.58,"end":21.807,"text":"So fun mi nigbagbogbo","marked":"Sọ fún mi nígbàgbọ́gbò"},{"start":22.187,"end":23.613,"text":"Nitori nko fe gbagbe","marked":"Nítorí ńkọ́ fẹ́ gbàgbé"},{"start":23.993,"end":25.551,"text":"Ero mi si nfe lati gbo","marked":"Èrò mi ṣì ńfẹ́ láti gbọ́"},{"start":25.931,"end":27.033,"text":"Orin adidun na.","marked":"Orin àdídùn ná."}],"end":27.033},{"key":"3","start":27.983,"lines":[{"start":27.983,"end":29.218,"text":"So itan kanna fun mi","marked":"Sọ ìtàn kanná fún mi"},{"start":29.598,"end":30.854,"text":"N'igbat'O ba ri pe","marked":"N'igbat'Ó bá rí pé"},{"start":31.234,"end":32.368,"text":"Ogo asan aiye yi,","marked":"Ògo asán aiye yi"},{"start":32.748,"end":33.855,"text":"Fe gba mi li okan","marked":"Fẹ́ gbà mí li ọkàn"},{"start":34.235,"end":35.894,"text":"Gba t'Ogo oke orun","marked":"Gba t'Ògo òkè ọ̀run"},{"start":36.274,"end":37.787,"text":"Ba si nfara han mi","marked":"Bá sì ńfara hàn mí"},{"start":38.167,"end":39.562,"text":"So 'tan kanna fun mi pe,","marked":"Sọ 'tán kanná fún mi pé"},{"start":39.942,"end":41.31,"text":"Krist' mu o larada.","marked":"Krist' mú ọ láràdá."}],"end":41.31}]}