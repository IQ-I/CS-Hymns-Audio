{"v":1,"coll":"y","num":756,"id":"hymn_756","title":"GBA ta kun fun 'banuje","duration":49.413,"voices":{"male":{"file":"y-756-male.m4a","bytes":363074,"sha256":"294ff2bdd516d499487cad4a66ab8c6eb3b108e5f7d01e8de6f4de5ba4b85162","duration":49.5},"female":{"file":"y-756-female.m4a","bytes":368134,"sha256":"655e94a7059ce1be98c495668c9d1c44c19fb4e8b7b2ddcc15bd4b8d2f241c6a","duration":49.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.748,"text":"GBA ta kun fun 'banuje","marked":"Gba ta kún fún 'banújẹ́"},{"start":2.128,"end":3.483,"text":"Gb'omije nsan loju wa","marked":"Gb'omije ńsán lójú wa"},{"start":3.863,"end":5.55,"text":"Gbat'o nsokun t'a nsofo","marked":"Gbat'ó nsokun t'á ńsòfò"},{"start":5.93,"end":7.682,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":7.682},{"key":"2","start":8.632,"lines":[{"start":8.632,"end":9.966,"text":"Wo ti gbe ara wa wo","marked":"Wo ti gbé ara wa wọ̀"},{"start":10.346,"end":11.521,"text":"O si mo 'banuje wa","marked":"Ó sì mọ 'banújẹ́ wa"},{"start":11.901,"end":13.243,"text":"O ti sokun bi awa","marked":"Ó ti ṣókùn bí àwa"},{"start":13.623,"end":15.333,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":15.333},{"key":"3","start":16.283,"lines":[{"start":16.283,"end":17.665,"text":"Wo ti teriba fun ku","marked":"Wo ti tẹríbà fún kù"},{"start":18.045,"end":19.423,"text":"Wo ti t'eje Re sile","marked":"Wo ti t'ẹ̀jẹ̀ Rẹ̀ sílẹ̀"},{"start":19.803,"end":21.307,"text":"A te O si posi ri","marked":"A tẹ̀ Ọ́ sí pósí rí"},{"start":21.687,"end":23.523,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":23.523},{"key":"4","start":24.473,"lines":[{"start":24.473,"end":25.985,"text":"Gbat' okan wa ba baje","marked":"Gbat' ọkàn wa bá bàjẹ́"},{"start":26.365,"end":27.574,"text":"Nitori ese t'a da","marked":"Nítorí ẹsẹ̀ t'á dá"},{"start":27.954,"end":29.792,"text":"Gbat' eru ba b'okan wa","marked":"Gbat' eru ba b'ọkàn wa"},{"start":30.172,"end":31.817,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":31.817},{"key":"5","start":32.767,"lines":[{"start":32.767,"end":34.348,"text":"Wo ti mo eru ese,","marked":"Wọ́ ti mọ ẹrú ẹ̀ṣẹ̀"},{"start":34.728,"end":36.091,"text":"Ese ti ki se Tire","marked":"Ẹsẹ̀ tí kì ṣe Tírè"},{"start":36.471,"end":37.839,"text":"Eru ese na l'O gbe","marked":"Ẹrù ẹsẹ̀ ná l'Ó gbé"},{"start":38.219,"end":39.874,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":39.874},{"key":"6","start":40.824,"lines":[{"start":40.824,"end":42.247,"text":"O ti silekun iku","marked":"Ó ti ṣílẹ̀kùn ikú"},{"start":42.627,"end":44.026,"text":"O ti s'etutu f'ese","marked":"Ó ti s'etùtù f'èse"},{"start":44.406,"end":45.664,"text":"O wa l'ow otun Baba","marked":"Ó wà l'ów ọ̀tún Bàbá"},{"start":46.044,"end":47.863,"text":"Olugbala, gbo tiwa.","marked":"Olùgbàlà, gbọ́ tiwa."}],"end":47.863}]}