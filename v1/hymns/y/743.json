{"v":1,"coll":"y","num":743,"id":"hymn_743","title":"KERUBU ati Serafu","duration":68.679,"voices":{"male":{"file":"y-743-male.m4a","bytes":487078,"sha256":"893f8d5d9e6453b4da00e42f2f0ff637e5339e909dc426b1cf708b86768f4e50","duration":68.7},"female":{"file":"y-743-female.m4a","bytes":504247,"sha256":"819a306a3d671e70c5dbd0eec392ef251c9d5b81c26c60694053b8512299ab26","duration":68.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.006,"text":"KERUBU ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":2.386,"end":3.874,"text":"Nwon yi 'te Baba ka","marked":"Nwọ̀n yí 'te Bàbá ká"},{"start":4.254,"end":5.554,"text":"Nigbakugba niwaju Re","marked":"Nígbàkugbà níwájú Rẹ̀"},{"start":5.934,"end":7.048,"text":"Ni nwon nkorin ogo","marked":"Ní nwọn ńkọrin ògo"}],"end":7.048},{"key":"CHORUS","start":7.998,"lines":[{"start":7.998,"end":10.095,"text":"Nkorin Ogo, Ogo, Ogo","marked":"Nkọrin Ògo, Ògo, Ògo"},{"start":10.475,"end":12.097,"text":"Nkorin Ogo, Ogo, Ogo.","marked":"Nkọrin Ògo, Ògo, Ògo."}],"end":12.097},{"key":"2","start":13.047,"lines":[{"start":13.047,"end":14.57,"text":"Gbogb' omo Egbe Kerubu","marked":"Gbogb' ọmọ Ẹgbẹ́ Kérúbù"},{"start":14.95,"end":16.247,"text":"E toju iwa nyin","marked":"Ẹ tọ́jú ìwà nyin"},{"start":16.627,"end":18.327,"text":"Gbogbo Egbe t'o wa l'aiye","marked":"Gbogbo Ẹgbẹ́ t'ó wà l'aiye"},{"start":18.707,"end":20.137,"text":"Ni 'dapo mo t'orun.","marked":"Ní 'dàpọ̀ mọ́ t'ọrun."}],"end":20.137},{"key":"3","start":21.087,"lines":[{"start":21.087,"end":22.659,"text":"Gbogb' omo Egbe Serafu","marked":"Gbogb' ọmọ Ẹgbẹ́ Séráfù"},{"start":23.039,"end":24.234,"text":"E toju iwa nyin","marked":"Ẹ tọ́jú ìwà nyin"},{"start":24.614,"end":26.233,"text":"K'a ba le pel'awon t'orun","marked":"K'á bá le pel'awon t'ọrun"},{"start":26.613,"end":27.837,"text":"Lati ma juba Re.","marked":"Láti má júbà Rẹ."}],"end":27.837},{"key":"4","start":28.787,"lines":[{"start":28.787,"end":30.232,"text":"Awon egbe t'o wa l'orun","marked":"Àwọn ẹgbẹ́ t'ó wà l'ọrun"},{"start":30.612,"end":32.436,"text":"Nwon wo bi a ti nja","marked":"Nwọ̀n wo bí a ti ńjà"},{"start":32.816,"end":34.637,"text":"Nwon si nfi ohun kan wipe","marked":"Nwọ̀n sì ńfi ohun kan wípé"},{"start":35.017,"end":36.334,"text":"E ma te siwaju.","marked":"Ẹ má tẹ̀ síwájú."}],"end":36.334},{"key":"5","start":37.284,"lines":[{"start":37.284,"end":38.694,"text":"Ninu iponju at'egun","marked":"Nínú ìpọ́njú àt'ègùn"},{"start":39.074,"end":40.135,"text":"Ninu 'rukerudo","marked":"Nínú 'rukerudo"},{"start":40.515,"end":42.154,"text":"Ninu irumi at'iji","marked":"Nínú irumi àt'íjì"},{"start":42.534,"end":43.841,"text":"Yio s'ona wa fefe.","marked":"Yíó s'ọ́nà wa fẹ́fẹ́."}],"end":43.841},{"key":"6","start":44.791,"lines":[{"start":44.791,"end":46.523,"text":"Majemu ati eje Re","marked":"Májẹ̀mú àti ẹ̀jẹ́ Rẹ"},{"start":46.903,"end":47.945,"text":"Ni igbekeke wa","marked":"Ní ìgbẹ́kẹ̀kẹ̀ wa"},{"start":48.325,"end":49.661,"text":"B'ileri na tile fale","marked":"B'ìlérí ná tilẹ̀ falẹ̀"},{"start":50.041,"end":51.578,"text":"Sugbon ko le pe de.","marked":"Ṣùgbọ́n kò lè pẹ́ dé."}],"end":51.578},{"key":"7","start":52.528,"lines":[{"start":52.528,"end":54.275,"text":"Nigbat' a ba par'ise wa","marked":"Nígbat' à bá par'iṣẹ́ wa"},{"start":54.655,"end":55.963,"text":"Ni aiye osi yi","marked":"Ní àìyẹ òṣì yí"},{"start":56.343,"end":58.078,"text":"Ade Ogo yio je tiwa","marked":"Adé Ògo yìó jẹ́ tiwa"},{"start":58.458,"end":59.941,"text":"T'enikan ko le gba.","marked":"T'ẹnìkan kò lè gbà."}],"end":59.941},{"key":"8","start":60.891,"lines":[{"start":60.891,"end":62.297,"text":"Ogo, ola at'agbara","marked":"Ògo, ọlá àt'ágbára"},{"start":62.677,"end":63.847,"text":"Ni fun Metalokan,","marked":"Ní fún Mẹ́talọ́kan"},{"start":64.227,"end":65.423,"text":"Aiyeraiye Olorun wa","marked":"Aiyérayé Ọlọ́run wa"},{"start":65.803,"end":67.129,"text":"Amin, beni ki o ri.","marked":"Àmín, bẹ́ni kí o rí."}],"end":67.129}]}