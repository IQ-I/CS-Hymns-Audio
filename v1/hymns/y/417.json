{"v":1,"coll":"y","num":417,"id":"hymn_417","title":"OLUWA mo de'bi te Re","duration":23.075,"voices":{"male":{"file":"y-417-male.m4a","bytes":158715,"sha256":"5989e43cfecbeec0c3692ce9c6e7be96c1091abf387388ada7b0206431dcfc14","duration":23.1},"female":{"file":"y-417-female.m4a","bytes":164059,"sha256":"5547b8fb599cc354870643401c8bac89d51fb02f6b64f44cc78e96583c3421de","duration":23.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.574,"text":"OLUWA mo de'bi te Re","marked":"Olúwa mo dé'bí tẹ̀ Rẹ"},{"start":1.954,"end":2.846,"text":"Nibiti anu po","marked":"Níbitì ãnu pọ̀"},{"start":3.226,"end":4.846,"text":"Mo fe dariji ese mi","marked":"Mo fẹ́ dariji ẹ̀ṣẹ̀ mi"},{"start":5.226,"end":6.579,"text":"K'o mu okan mi da.","marked":"K'ó mú ọkàn mi dá."}],"end":6.579},{"key":"2","start":7.529,"lines":[{"start":7.529,"end":9.132,"text":"Oluwa, ko ye k'emi so","marked":"Olúwa, kò yẹ k'ẹ̀mí sọ"},{"start":9.512,"end":10.514,"text":"Ohun ti mba bere","marked":"Ohun tí ḿbá bẹ̀rẹ̀"},{"start":10.894,"end":12.341,"text":"O ti mo k'emi to bere","marked":"Ó ti mọ k'ẹ̀mí tó bẹ̀rẹ̀"},{"start":12.721,"end":13.774,"text":"Ohun ti emi fe.","marked":"Ohun tí èmi fẹ́."}],"end":13.774},{"key":"3","start":14.724,"lines":[{"start":14.724,"end":16.097,"text":"Oluwa mo toro anu","marked":"Olúwa mo tọrọ ànú"},{"start":16.477,"end":17.787,"text":"Eyiyi l'opin na","marked":"Èyíyí l'òpin ná"},{"start":18.167,"end":20.039,"text":"Oluwa, anu l'o ye mi","marked":"Olúwa, ànú l'ó yé mi"},{"start":20.419,"end":21.525,"text":"Je ki anu Re wa.","marked":"Jẹ́ kí ãnú Rẹ wà."}],"end":21.525}]}