{"v":1,"coll":"y","num":329,"id":"hymn_329","title":"B'ELESE s'owo po","duration":38.71,"voices":{"male":{"file":"y-329-male.m4a","bytes":269441,"sha256":"de1dcc40b63dea7a7eb6fc4c03a3797532d41ee60a8902f034f06e0bf64d2e80","duration":38.8},"female":{"file":"y-329-female.m4a","bytes":288485,"sha256":"cc4fa9a9e4f078fb24556f4591dcc1fdc477c5903d418517b90db6d7e0dccb19","duration":38.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.351,"text":"B'ELESE s'owo po","marked":"B'eléṣe ṣ'òwò pọ̀"},{"start":1.731,"end":2.882,"text":"Ti nwon nde s'Oluwa","marked":"Ti nwọn ńde s'Olúwa"},{"start":3.262,"end":4.725,"text":"Dimo si Kristi Re","marked":"Dimo sí Kristi Rẹ"},{"start":5.105,"end":6.576,"text":"Lati gan Oba na","marked":"Láti gan Ọba ná"},{"start":6.956,"end":7.97,"text":"B'aiye nsata","marked":"B'aiye nsata"},{"start":8.35,"end":10.34,"text":"Pelu Esu, Eke ni nwon","marked":"Pẹ̀lú Èṣù, Èké ni nwọn"},{"start":10.72,"end":11.909,"text":"Nwon nse lasan.","marked":"Nwọ̀n ńṣe lásán."}],"end":11.909},{"key":"2","start":12.859,"lines":[{"start":12.859,"end":13.958,"text":"Olugbala joba!","marked":"Olùgbàlà jọba!"},{"start":14.338,"end":15.304,"text":"Lori oke Sion","marked":"Lórí òkè Sion"},{"start":15.684,"end":16.631,"text":"Ase ti Oluwa","marked":"Àṣẹ ti Olúwa"},{"start":17.011,"end":18.046,"text":"Gbe Omo Tire ro","marked":"Gbé Ọmọ Tìrẹ ró"},{"start":18.426,"end":19.308,"text":"Lati 'boji","marked":"Láti 'bojì"},{"start":19.688,"end":21.348,"text":"O ni, k' O nde","marked":"Ó ní, k' Ó ńde"},{"start":21.728,"end":22.593,"text":"K' O si goke","marked":"K' Ó sì gòkè"},{"start":22.973,"end":24.045,"text":"K' O gba ni la.","marked":"K' Ó gbà ní là."}],"end":24.045},{"key":"3","start":24.995,"lines":[{"start":24.995,"end":26.035,"text":"F'eru sin Oluwa","marked":"F'ẹrù sin Olúwa"},{"start":26.415,"end":27.698,"text":"Si bowo f 'ase Re","marked":"Sì bọ̀wọ̀ f 'àṣẹ Rẹ"},{"start":28.078,"end":29.326,"text":"F'ayo wa sodo Re","marked":"F'ayọ̀ wá sọ́dọ̀ Rẹ"},{"start":29.706,"end":31.004,"text":"F' iwariri duro","marked":"F' ìwárìrì dúró"},{"start":31.384,"end":32.507,"text":"E kunle fun","marked":"Ẹ kúnlẹ̀ fún"},{"start":32.887,"end":33.792,"text":"K'e teriba","marked":"K'é tẹríbá"},{"start":34.172,"end":35.128,"text":"So t'ipa Re","marked":"Sọ t'ipa Rẹ"},{"start":35.508,"end":36.316,"text":"Ki omo na.","marked":"Kí ọmọ ná."},{"start":36.696,"end":37.16,"text":"Amin.","marked":"Àmín."}],"end":37.16}]}