{"v":1,"coll":"y","num":764,"id":"hymn_764","title":"ODUN nyipo, o ji emi","duration":32.354,"voices":{"male":{"file":"y-764-male.m4a","bytes":229215,"sha256":"7f1e1abf3b6102f7dda1b32213d48bcfd04d89d9ec2b9b14e4dca446396ec93f","duration":32.4},"female":{"file":"y-764-female.m4a","bytes":237054,"sha256":"9019a8923dd010edd69c8b736847249b4bfb68fe6238f106de07a8122c5feb4f","duration":32.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.443,"text":"ODUN nyipo, o ji emi","marked":"Ọdún nyípo, ó jí èmi"},{"start":2.823,"end":4.059,"text":"T'O ti fi fun wa ri","marked":"T'ó ti fi fún wa rí"},{"start":4.439,"end":5.91,"text":"Ibikibi to wu ka wa","marked":"Ibikíbi tó wù ká wà"},{"start":6.29,"end":7.537,"text":"Isa-oku la nre.","marked":"Isà-òkú là ńrè."}],"end":7.537},{"key":"2","start":8.487,"lines":[{"start":8.487,"end":10.184,"text":"Yi ile ka l'ewu duro","marked":"Yí ilé ká l'ewu dúró"},{"start":10.564,"end":11.789,"text":"Ko le ti wa s'isa","marked":"Kò lè ti wá s'ísà"},{"start":12.169,"end":13.489,"text":"Arun buburu si duro","marked":"Àrùn búburú ṣì dúró"},{"start":13.869,"end":15.201,"text":"Lati le wa lo 'le.","marked":"Láti lè wá lọ 'lé."}],"end":15.201},{"key":"3","start":16.151,"lines":[{"start":16.151,"end":17.842,"text":"Ayo tab'egbe ailopin","marked":"Ayọ̀ tab'ẹgbẹ́ àìlópin"},{"start":18.222,"end":19.109,"text":"Duro de emi wa","marked":"Dúró de ẹ̀mí wa"},{"start":19.489,"end":21.397,"text":"Wo! ba ti nrin laibikita","marked":"Wò! bá ti nrìn láìbìkítà"},{"start":21.777,"end":23.174,"text":"Leti bebe iku.","marked":"Létí bẹ̀bẹ̀ ikú."}],"end":23.174},{"key":"4","start":24.124,"lines":[{"start":24.124,"end":25.484,"text":"Oluwa, ji wa l'orun wa","marked":"Olúwa, jí wa l'ọrùn wa"},{"start":25.864,"end":27.05,"text":"K'a r'ona ewu yi","marked":"K'á r'ọ́nà ewu yí"},{"start":27.43,"end":29.017,"text":"Nigbat' a ba pe okan wa","marked":"Nígbàt' a bá pe ọkàn wa"},{"start":29.397,"end":30.804,"text":"K'a ba O gbe titi.","marked":"K'á bá Ọ gbé títí."}],"end":30.804}]}