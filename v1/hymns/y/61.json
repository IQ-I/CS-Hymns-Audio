{"v":1,"coll":"y","num":61,"id":"hymn_61","title":"BABA WA ti mbe l'orun","duration":99.428,"voices":{"male":{"file":"y-61-male.m4a","bytes":729996,"sha256":"370f67398a7f10ce8584d9da0d58953454863115aa64a3b2bbea0093436d2f4a","duration":99.5},"female":{"file":"y-61-female.m4a","bytes":750014,"sha256":"4a249bef13a1ed6c9e72aa80adbde3afa811b0d323e193c0ef4290d2973a21a5","duration":99.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.5,"text":"BABA WA ti mbe l'orun","marked":"Bàbá Wa ti ḿbẹ l'ọrun"},{"start":1.88,"end":2.898,"text":"Owo loruko Re,","marked":"Owó lorúkọ Rẹ"},{"start":3.278,"end":4.751,"text":"Ife tire ni ka se","marked":"Ìfẹ́ tìrẹ ni ká ṣe"},{"start":5.131,"end":6.301,"text":"Bi nwon ti nse lorun","marked":"Bí nwọn ti ńṣe lọ́run"},{"start":6.681,"end":8.014,"text":"Fun wa l'onje ojo wa","marked":"Fún wa l'ọ́ńjẹ ọjọ́ wa"},{"start":8.394,"end":9.607,"text":"'Dari ese ji wa,","marked":"'Dárí ẹ̀ṣẹ̀ jì wá"},{"start":9.987,"end":11.186,"text":"Gba wa lowo idanwo","marked":"Gbà wá lọ́wọ́ ìdánwò"},{"start":11.566,"end":12.643,"text":"Gba wa lowo ewu.","marked":"Gbà wá lọ́wọ́ ewu."}],"end":12.643},{"key":"2","start":13.593,"lines":[{"start":13.593,"end":14.828,"text":"Iwo to gbo t'Elija","marked":"Ìwọ tó gbọ́ t'Èlíjà"},{"start":15.208,"end":16.696,"text":"Leba odo Kedron","marked":"Lẹ́bà ọ̀dọ̀ Kẹ́dròń"},{"start":17.076,"end":18.741,"text":"lwo to gbo ti Daniel","marked":"lwo tó gbọ́ ti Daniel"},{"start":19.121,"end":20.19,"text":"Ko gbo ti wa loni,","marked":"Kò gbọ́ tì wá lónì"},{"start":20.57,"end":21.791,"text":"Fun wa niru agbara","marked":"Fún wa nírú agbára"},{"start":22.171,"end":23.63,"text":"To fi f'awon Apostle","marked":"Tó fi f'àwọn Apostle"},{"start":24.01,"end":25.358,"text":"K'awa le wulo fun O","marked":"K'áwá lè wúlò fún Ọ"},{"start":25.738,"end":26.995,"text":"Ka jere bi ti won.","marked":"Ká jèrè bí ti wọn."}],"end":26.995},{"key":"3","start":27.945,"lines":[{"start":27.945,"end":29.297,"text":"Fun wa lokan igbagbo","marked":"Fún wa lọ́kàn ìgbàgbọ́́"},{"start":29.677,"end":31.027,"text":"Ti ki y'o ye lailai","marked":"Ti ki y'ó yé láíláí"},{"start":31.407,"end":32.828,"text":"Ka gbekele O titi,","marked":"Ká gbẹ́kẹ̀lé O títí"},{"start":33.208,"end":34.227,"text":"Ao fi r' oju Re,","marked":"Àó fi r' ojú Rẹ"},{"start":34.607,"end":35.903,"text":"Je ka le ni ireti","marked":"Jẹ́ ká lè ní ìrètí"},{"start":36.283,"end":37.357,"text":"Ninu Iwo nikan","marked":"Nínú Ìwọ nìkan"},{"start":37.737,"end":39.184,"text":"Ka nife s'enikeji,","marked":"Ká nífẹ́ s'ẹ́nikeji"},{"start":39.564,"end":40.932,"text":"Ka si n'iwa pele.","marked":"Ká sì ń'ìwà pẹ̀lẹ́."}],"end":40.932},{"key":"4","start":41.882,"lines":[{"start":41.882,"end":43.09,"text":"Baba a si tun mbe O,","marked":"Bàbá a sì tún ḿbẹ Ọ́"},{"start":43.47,"end":44.566,"text":"Ani fun OIon' wa,","marked":"Àní fún Olóǹ' wa"},{"start":44.946,"end":46.366,"text":"Ko fi Emi meje Re","marked":"Kò fi Ẹ̀mí méje Rẹ̀"},{"start":46.746,"end":47.961,"text":"Se 'tura f 'okan re,","marked":"Ṣe 'túra f 'ọkàn rẹ"},{"start":48.341,"end":49.54,"text":"Je ki awa le ma rin","marked":"Jẹ́ kí àwa lè má rìn"},{"start":49.92,"end":51.131,"text":"Lona to nto wa si","marked":"Lọ́nà tó ńtọ́ wa sí"},{"start":51.511,"end":52.796,"text":"Ko le ko wa de Canaan","marked":"Kò lè kó wa dé Cánàán"},{"start":53.176,"end":54.419,"text":"Niwaju Ite re.","marked":"Níwájú Ìtẹ́ rẹ."}],"end":54.419},{"key":"5","start":55.369,"lines":[{"start":55.369,"end":56.695,"text":"Iwo to gbo ti Sedrak,","marked":"Ìwọ tó gbọ́ ti Sedrak"},{"start":57.075,"end":59.45,"text":"Mesak, Abednego","marked":"Mesak, Abednego"},{"start":59.83,"end":61.322,"text":"Gbo t'awa Egbe Serafi,","marked":"Gbọ́ t'áwá Ẹgbẹ́ Séráfì"},{"start":61.702,"end":63.138,"text":"Gbat'a ba nkepe O","marked":"Gbat'á bá nkepe O"},{"start":63.518,"end":64.812,"text":"Fi agbara Re wo wa","marked":"Fi agbára Rẹ̀ wò wá"},{"start":65.192,"end":66.677,"text":"Bi ti woli isaju","marked":"Bí ti wòlí ìṣájú"},{"start":67.057,"end":68.421,"text":"Ka ni 'gboya bi ti won","marked":"Ká ní 'gboyà bí ti wọn"},{"start":68.801,"end":70.124,"text":"Ka segun aiye yi.","marked":"Ká ṣẹ́gun aiye yí."}],"end":70.124},{"key":"6","start":71.074,"lines":[{"start":71.074,"end":72.225,"text":"Awon Omo Isreal,","marked":"Àwọn Ọmọ Isreal"},{"start":72.605,"end":73.629,"text":"Ninu rin ajo won,","marked":"Nínú rin àjọ wọn"},{"start":74.009,"end":75.143,"text":"Iwo lo ns'amona won,","marked":"Ìwọ lo ns'amọ̀nà wọn"},{"start":75.523,"end":76.564,"text":"Ati abo fun won,","marked":"Àti abo fún wọn"},{"start":76.944,"end":78.656,"text":"Bi nwon ti ndese si O,","marked":"Bí nwọn ti ńdẹsẹ̀ sí Ọ"},{"start":79.036,"end":80.318,"text":"Be lo ndariji won,","marked":"Bẹ́ ló ndariji wọn"},{"start":80.698,"end":82.251,"text":"Jowo ko dariji wa,","marked":"Jọ̀wọ́ kò dariji wa"},{"start":82.631,"end":83.821,"text":"Awa Egbe Serafu.","marked":"Àwa Ẹgbẹ́ Séráfù."}],"end":83.821},{"key":"7","start":84.771,"lines":[{"start":84.771,"end":85.764,"text":"Olorun Abrahamu,","marked":"Ọlọ́run Ábúráhámù"},{"start":86.144,"end":87.173,"text":"Olorun Isaaki","marked":"Ọlọ́run Ísáákì"},{"start":87.553,"end":88.849,"text":"Ati Olorun Jakobu","marked":"Àti Ọlọ́run Jákọ́bù"},{"start":89.229,"end":90.347,"text":"Awa f'ope fun O","marked":"Àwa f'ọpẹ́ fún Ọ"},{"start":90.727,"end":93.137,"text":"Ogo, iyin, olanla","marked":"Ògo, ìyìn, ọ̀làǹlà"},{"start":93.517,"end":94.609,"text":"S'Eni Metalokan","marked":"S'Ẹni Mẹ́talọ́kan"},{"start":94.989,"end":96.193,"text":"Halleluyah's Olorun","marked":"Hallelúyàh's Ọlọ́run"},{"start":96.573,"end":97.878,"text":"Aiye ainipekun.","marked":"Àìyẹ àìnípẹ̀kun."}],"end":97.878}]}