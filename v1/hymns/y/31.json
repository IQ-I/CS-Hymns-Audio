{"v":1,"coll":"y","num":31,"id":"hymn_31","title":"Bi mo ti yo lati gb'oro","duration":48.131,"voices":{"male":{"file":"y-31-male.m4a","bytes":344992,"sha256":"735e78a85100e13e0f187d3df08e9e006de316b129f40e85a60cd9c818fda835","duration":48.2},"female":{"file":"y-31-female.m4a","bytes":350440,"sha256":"69adc0817cbcb23fcf51d0da7a015375b5db4c5d0d0c2aa8af4bd8070751fa8f","duration":48.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.946,"text":"Bi mo ti yo lati gb'oro","marked":"Bí mo ti yó láti gb'ọrọ̀"},{"start":2.326,"end":3.305,"text":"Lenu awon ore,","marked":"Lẹ́nu àwọn ọ̀rẹ́"},{"start":3.685,"end":5.844,"text":"Pe, 'Ni Sion ni k'a pe si","marked":"Pé, 'Ní Sion ni k'á pẹ́ sí"},{"start":6.224,"end":7.578,"text":"K'a p'ojo mimo mo.","marked":"K'á p'ọjọ́ mímọ́́ mọ́."}],"end":7.578},{"key":"2","start":8.528,"lines":[{"start":8.528,"end":10.05,"text":"Mo f'onata at'ekun re","marked":"Mo f'onata àt'ẹkùn rẹ̀"},{"start":10.43,"end":11.63,"text":"Ile t'a se loso","marked":"Ilé t'á ṣe lọ́ṣọ́"},{"start":12.01,"end":13.532,"text":"lle t'a ko fun Olorun","marked":"llẹ́ t'á kọ fún Ọlọ́run"},{"start":13.912,"end":15.104,"text":"Lati fi anu han.","marked":"Láti fi ànú hàn."}],"end":15.104},{"key":"3","start":16.054,"lines":[{"start":16.054,"end":17.587,"text":"S'agala ile ayo na","marked":"S'ágálá ilé ayọ̀ ná"},{"start":17.967,"end":19.142,"text":"Leya mimo si lo","marked":"Lẹ́yà mímọ́́ ṣì lọ"},{"start":19.522,"end":21.257,"text":"Omo Dafidi wa lor'ite","marked":"Ọmọ Dáfídì wà lór'ìtẹ́"},{"start":21.637,"end":22.911,"text":"O nda ejo nibe.","marked":"Ó ńdá ẹjọ́ níbẹ̀."}],"end":22.911},{"key":"4","start":23.861,"lines":[{"start":23.861,"end":25.347,"text":"O gbo iyin at'igbe wa;","marked":"Ó gbọ́ ìyìn àt'igbe wa"},{"start":25.727,"end":26.565,"text":"Bi ohun eru re,","marked":"Bí ohùn ẹrú rẹ"},{"start":26.945,"end":28.437,"text":"Ti nya elese sib'egbe","marked":"Ti nya ẹlẹ́sẹ̀ síb'ẹgbẹ́"},{"start":28.817,"end":29.87,"text":"A nyo ni 'wariri.","marked":"A nyo ní 'wárìrì."}],"end":29.87},{"key":"5","start":30.82,"lines":[{"start":30.82,"end":32.487,"text":"K' ibukun pelu ibe na,","marked":"K' ìbùkún pẹ̀lú ibẹ̀ ná"},{"start":32.867,"end":34.057,"text":"Ayo nigbakugba","marked":"Ayọ̀ nígbàkugbà"},{"start":34.437,"end":36.165,"text":"K'a fi ore ati ore","marked":"K'á fi ọ̀rẹ́ àti ọ̀rẹ́"},{"start":36.545,"end":37.955,"text":"F'awon ti nsin nibe.","marked":"F'àwọn ti ńsìn níbẹ̀."}],"end":37.955},{"key":"6","start":38.905,"lines":[{"start":38.905,"end":40.458,"text":"Okan mi bebe fun Sion","marked":"Ọkàn mi bẹ̀bẹ̀ fún Sion"},{"start":40.838,"end":42.036,"text":"Nigbati emi wa;","marked":"Nígbàtí ẹ̀mí wa"},{"start":42.416,"end":44.053,"text":"Nibe n'ibatan at'ore","marked":"Níbẹ̀ n'íbátan àt'ọ̀rẹ́"},{"start":44.433,"end":45.547,"text":"At'olugbala wa.","marked":"Àt'Olùgbàlà wa."},{"start":45.927,"end":46.582,"text":"Amin.","marked":"Àmín."}],"end":46.582}]}