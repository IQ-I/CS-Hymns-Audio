{"v":1,"coll":"y","num":758,"id":"hymn_758","title":"IGBA asale ti dun to","duration":42.897,"voices":{"male":{"file":"y-758-male.m4a","bytes":309854,"sha256":"18088b30f752aab1523f74877742695be8786b9da9a1f6fd73683262a174a746","duration":42.9},"female":{"file":"y-758-female.m4a","bytes":321068,"sha256":"7dfbf4593c8c0372fd889e1d8aa983fdd889a0aa7636f370abbcd6b53b1c5c17","duration":42.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.853,"text":"IGBA asale ti dun to","marked":"Ìgbà aṣálẹ̀ ti dùn tó"},{"start":2.233,"end":3.809,"text":"Ti ara tu ohun gbogbo","marked":"Ti ara tu ohun gbogbo"},{"start":4.189,"end":5.746,"text":"Gbat' itansan orun ale","marked":"Gbat' ìtànṣán ọrùn alẹ́"},{"start":6.126,"end":7.536,"text":"Ba ntanmole s'ohun gbogbo.","marked":"Bá ńtànmọ́lẹ̀ s'ohun gbogbo."}],"end":7.536},{"key":"2","start":8.486,"lines":[{"start":8.486,"end":10.016,"text":"Beni 'kehin onigbagbo","marked":"Bẹni 'kẹ́hìn onígbàgbọ́"},{"start":10.396,"end":11.832,"text":"On a simi l'alafia","marked":"On a simi l'àlàáfíà"},{"start":12.212,"end":14.215,"text":"Igbagbo t'o gbona janjan","marked":"Ìgbàgbọ́́ t'ó gbóná janjan"},{"start":14.595,"end":16.119,"text":"A mole ninu okan re.","marked":"A mọ́lẹ̀ nínú ọkàn rẹ̀."}],"end":16.119},{"key":"3","start":17.069,"lines":[{"start":17.069,"end":18.985,"text":"Imole kan mo loju re","marked":"Ìmọ́lẹ̀̀ kan mọ́ lójú rẹ̀"},{"start":19.365,"end":20.742,"text":"Erin si bo ni enu re","marked":"Ẹ̀rín sì bọ́ ní ẹnu rẹ̀"},{"start":21.122,"end":22.614,"text":"On f'ede t'ahon wa ko mo","marked":"On f'èdè t'ahọ́n wa kò mọ́"},{"start":22.994,"end":24.735,"text":"Soro ogo t'o sunmole.","marked":"Sọ̀rọ̀ ògo t'ó súnmọ́lẹ̀."}],"end":24.735},{"key":"4","start":25.685,"lines":[{"start":25.685,"end":27.005,"text":"Itansan 'mole t'orun wa","marked":"Ìtànṣán 'mọ́lẹ̀ t'ọrun wà"},{"start":27.385,"end":28.811,"text":"Lati gba niyanju lona","marked":"Láti gbà níyànjú lọ́nà"},{"start":29.191,"end":30.355,"text":"Awon angeli duro yika","marked":"Àwọn áńgẹ́lì dúró yíká"},{"start":30.735,"end":32.43,"text":"Lati gbe lo s'ibugbe won.","marked":"Láti gbé lọ s'ibùgbé wọn."}],"end":32.43},{"key":"5","start":33.38,"lines":[{"start":33.38,"end":34.744,"text":"Oluwa, jek'a lo bayi","marked":"Olúwa, jẹ́k'á lọ báyì"},{"start":35.124,"end":37.413,"text":"K'a ba O yo, k'a r'oju Re","marked":"K'á bá Ọ yọ̀, k'á r'ojú Rẹ"},{"start":37.793,"end":39.166,"text":"Te aworan Re s'okan wa","marked":"Tẹ àwòrán Rẹ̀ s'ọkàn wa"},{"start":39.546,"end":41.347,"text":"Si ko wa b'a ti ba O rin.","marked":"Sì kó wá b'á ti bá Ọ rìn."}],"end":41.347}]}