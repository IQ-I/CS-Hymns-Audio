{"v":1,"coll":"y","num":294,"id":"hymn_294","title":"W'OLORI Alufa Giga","duration":50.002,"voices":{"male":{"file":"y-294-male.m4a","bytes":370626,"sha256":"ef6d98da545ac744a8a7a9afce95a4e76ab3544991c01ee22afb2d7ca9c2f479","duration":50.1},"female":{"file":"y-294-female.m4a","bytes":380283,"sha256":"cdd04a5dccdbc87bf023cff46788459b2204f45c66c6b42c9aa007116936b83d","duration":50.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.783,"text":"W'OLORI Alufa Giga","marked":"W'olórí Àlùfá Gíga"},{"start":2.163,"end":3.872,"text":"B'o ti gbe ebe wa lo","marked":"B'ó ti gbé ẹ̀bẹ̀ wa lọ"},{"start":4.252,"end":6.968,"text":"L'ogba, o f 'ikedun wole","marked":"L'ọgbà, ó f 'ìkẹ́dùn wọ̀lé"},{"start":7.348,"end":8.554,"text":"O f'eru dojubole","marked":"Ó f'ẹrù dojúbolẹ̀"},{"start":8.934,"end":10.105,"text":"Angeli f'idamu duro","marked":"Áńgẹ́lì f'ìdàmú dúró"},{"start":10.485,"end":11.725,"text":"Lati ri Eleda be","marked":"Láti rí Ẹlẹ́dàá bẹ́"},{"start":12.105,"end":13.726,"text":"Awa o ha wa l'aigbogbe","marked":"Àwa ò há wa l'àìgbògbè"},{"start":14.106,"end":15.918,"text":"T'a mo pe tori wa ni?","marked":"T'á mọ̀ pé torí wa ni?"}],"end":15.918},{"key":"2","start":16.868,"lines":[{"start":16.868,"end":18.419,"text":"Kiki eje Jesu nikan","marked":"Kìkì ẹ̀jẹ̀ Jésù nìkan"},{"start":18.799,"end":20.702,"text":"L'ole yi oka pada","marked":"L'ọ́lẹ̀ yí ọkà padà"},{"start":21.082,"end":22.429,"text":"On I'o le gba wa n'nu ebi","marked":"On l'ó lè gbà wá ń'nú ebi"},{"start":22.809,"end":24.133,"text":"On l'o le m'okan wa ro","marked":"On l'ó lè m'ọkàn wa rò"},{"start":24.513,"end":26.182,"text":"Ofin at'ikilo ko to","marked":"Òfin àt'ìkìlọ̀ kò tó"},{"start":26.562,"end":27.678,"text":"Nwon ko si le nikan se","marked":"Nwọn kò sì lè nìkan ṣe"},{"start":28.058,"end":29.554,"text":"Ero yi l'o le m'okan ro","marked":"Èrò yí l'ó lè m'ọkàn rò"},{"start":29.934,"end":31.205,"text":"Oluwa ku dipo mi!","marked":"Olúwa kù dípò mi!"}],"end":31.205},{"key":"3","start":32.155,"lines":[{"start":32.155,"end":34.119,"text":"Jesu, gbogbo itunu wa","marked":"Jésù, gbogbo ìtùnú wa"},{"start":34.499,"end":36.347,"text":"Lat'odo Re l'o ti nwa","marked":"Lát'ọ̀dọ̀ Rẹ l'ó ti ńwá"},{"start":36.727,"end":39.145,"text":"lfe, 'gbagbo, reti, suru","marked":"lfẹ́, 'gbàgbọ́, retí, ṣùrù"},{"start":39.525,"end":40.748,"text":"Gbogbo re I'eje Re ra","marked":"Gbogbo rẹ̀ l'ẹ̀jẹ̀ Rẹ rà"},{"start":41.128,"end":42.57,"text":"Lat'inu ekun Re l'a ngba","marked":"Lát'inú ẹkùn Rẹ̀ l'á ńgbá"},{"start":42.95,"end":44.369,"text":"A ko da ohun kan ni","marked":"A kò dá ohun kan ni"},{"start":44.749,"end":46.372,"text":"Lofe n'Iwo nfi won tore","marked":"Lọ́fẹ́ n'Ìwo ńfì wọn tọrẹ"},{"start":46.752,"end":48.452,"text":"Fun awon t'o s' alaini.","marked":"Fún àwọn t'ó s' aláìní."}],"end":48.452}]}