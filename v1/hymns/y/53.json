{"v":1,"coll":"y","num":53,"id":"hymn_53","title":"'K'E wole f'Oba Ologo","duration":78.568,"voices":{"male":{"file":"y-53-male.m4a","bytes":556797,"sha256":"ea4ff82b7e2a2ea76eeb1c2b6725e6c8843228f73b2779343812249d8b284905","duration":78.6},"female":{"file":"y-53-female.m4a","bytes":575905,"sha256":"1888dd5e6283a669ef57231f31bf1a9cf6f15c1dc40c58a5e86431437b9b5280","duration":78.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.754,"text":"'K'E wole f'Oba Ologo","marked":"'K'é wọlé f'Ọba Ológo"},{"start":2.134,"end":3.381,"text":"Eni O ngbe 'nu imole","marked":"Ẹni Ò ńgbé 'nu ìmọ́lẹ̀̀"},{"start":3.761,"end":5.327,"text":"T'oju elese kan ko ri","marked":"T'ojú ẹlẹ́sẹ̀ kan kò rí"},{"start":5.707,"end":6.893,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":6.893},{"key":"2","start":7.843,"lines":[{"start":7.843,"end":9.742,"text":"Gbogbo omo Egbe Serafu,","marked":"Gbogbo ọmọ Ẹgbẹ́ Séráfù"},{"start":10.122,"end":11.433,"text":"L'okunrin at'obinrin","marked":"L'ọkùnrin àt'obìnrin"},{"start":11.813,"end":13.451,"text":"K'a ronu ese ti a da,","marked":"K'á ronú ẹ̀ṣẹ̀ tí a dá"},{"start":13.831,"end":14.968,"text":"K'a toro 'dariji.","marked":"K'á tọrọ 'dáríjì."}],"end":14.968},{"key":"3","start":15.918,"lines":[{"start":15.918,"end":17.304,"text":"B'a ba mo'ra wa l'elese,","marked":"B'á bá mo'ra wa l'ẹ́lẹsẹ̀"},{"start":17.684,"end":19.137,"text":"K'a jewo re la je tan,","marked":"K'á jẹ́wọ́ rẹ̀ la jẹ́ tán"},{"start":19.517,"end":21.004,"text":"K'a ronu k'a si pawada,","marked":"K'á ronú k'á sì pàwàdà"},{"start":21.384,"end":22.586,"text":"Baba yio dariji.","marked":"Bàbá yio dáríjì."}],"end":22.586},{"key":"4","start":23.536,"lines":[{"start":23.536,"end":25.091,"text":"Ese aini 'fe l'o poju","marked":"Ẹsẹ̀ àìní 'fẹ́ l'ó pọ̀jù"},{"start":25.471,"end":26.953,"text":"Larin wa ba ti kunle","marked":"Larin wa bá ti kúnlẹ̀"},{"start":27.333,"end":29.322,"text":"Esu l'o ngb' ogun re ti wa","marked":"Èṣù l'ó ngb' ogun rẹ̀ ti wá"},{"start":29.702,"end":30.871,"text":"Baba jo dariji.","marked":"Bàbá jọ dáríjì."}],"end":30.871},{"key":"5","start":31.821,"lines":[{"start":31.821,"end":33.154,"text":"Ninu 'wa wa ati 'se wa,","marked":"Nínú 'wa wa àti 'ṣe wá"},{"start":33.534,"end":34.557,"text":"Ninu oro enu wa,","marked":"Nínú ọ̀rọ̀ ẹnu wa"},{"start":34.937,"end":36.017,"text":"“Nu gigan enikeji wa","marked":"Nu gígan ẹnìkejì wa"},{"start":36.397,"end":37.527,"text":"Dariji, Daniji.","marked":"Dáríjì, Dáníjí."}],"end":37.527},{"key":"6","start":38.477,"lines":[{"start":38.477,"end":39.886,"text":"Gbogbo wa Iati f'oju ri,","marked":"Gbogbo wa láti f'ojú rí"},{"start":40.266,"end":41.546,"text":"'Wo lo ran 'mole si wa,","marked":"'Wò ló rán 'mọ́lẹ̀ sí wa"},{"start":41.926,"end":43.391,"text":"Lati fi ona Re han wa","marked":"Láti fi ọ̀nà Rẹ hàn wá"},{"start":43.771,"end":44.946,"text":"Dariji, Daniji.","marked":"Dáríjì, Dáníjí."}],"end":44.946},{"key":"7","start":45.896,"lines":[{"start":45.896,"end":47.477,"text":"Bi ko ba se anu Re ni","marked":"Bí kò bá ṣẹ́ ànú Rẹ̀ ni"},{"start":47.857,"end":49.151,"text":"Ka to de 'nu 'mole yi","marked":"Ká tó dé 'nu 'mọ́lẹ̀ yí"},{"start":49.531,"end":51.306,"text":"Esu ba l'ayo lori wa","marked":"Èṣù bá l'áyò lórí wa"},{"start":51.686,"end":52.857,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":52.857},{"key":"8","start":53.807,"lines":[{"start":53.807,"end":55.656,"text":"Bi ko ba s'esu t'o ngb'ogun","marked":"Bí kò bá s'èṣù t'ó ńgb'ogun"},{"start":56.036,"end":57.202,"text":"A le f'ibi s'olore,","marked":"A lè f'ibi s'olọ́rẹ́"},{"start":57.582,"end":59.273,"text":"Jowo pa ise esu run","marked":"Jọ̀wọ́ pa iṣẹ́ èṣù run"},{"start":59.653,"end":60.77,"text":"Dariji, Daniji.","marked":"Dáríjì, Dáníjí."}],"end":60.77},{"key":"9","start":61.72,"lines":[{"start":61.72,"end":63.868,"text":"Wo ti 'ya ti Jesu wa je","marked":"Wo ti 'yà tí Jésù wá jẹ"},{"start":64.248,"end":65.305,"text":"'Ranti ogun eje Re,","marked":"'Rántí ogún ẹ̀jẹ̀ Rẹ"},{"start":65.685,"end":66.947,"text":"Nin'ogba Gestesmani","marked":"Nín'ọgbà Gestesmánì"},{"start":67.327,"end":68.594,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":68.594},{"key":"10","start":69.544,"lines":[{"start":69.544,"end":71.197,"text":"A dupe p'O ti gbo tiwa","marked":"A dúpẹ́ p'Ó ti gbọ́ tiwa"},{"start":71.577,"end":73.04,"text":"Ma je k'a tun d'ese mo,","marked":"Má jẹ k'á tún d'ẹsẹ̀ mọ́"},{"start":73.42,"end":74.901,"text":"Tun wa yipada Oiuwa,","marked":"Tún wá yípadà Oíúwá"},{"start":75.281,"end":77.018,"text":"K'a l'ayo l'ojo 'kehin.","marked":"K'á l'àyò l'ọjọ́ 'kẹhin."}],"end":77.018}]}