{"v":1,"coll":"y","num":260,"id":"hymn_260","title":"ELESE, e yipada","duration":64.958,"voices":{"male":{"file":"y-260-male.m4a","bytes":478852,"sha256":"7d2c5c530351068c42974e152053f7548f677dc8c9390547c19c4ec8ecd1b44a","duration":65.0},"female":{"file":"y-260-female.m4a","bytes":515329,"sha256":"e71ab90c79697f9f1edd3ab4922dca2f7e0df933c37a408f9d1fb0bbda51c601","duration":65.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.302,"text":"ELESE, e yipada","marked":"Ẹlẹ́ṣẹ̀, ẹ yípadà"},{"start":2.682,"end":4.119,"text":"Ese ti e o fi ku?","marked":"Ẹ̀ṣẹ̀ tí ẹ ó fi kú?"},{"start":4.499,"end":5.942,"text":"Eleda nyin lo mbere","marked":"Ẹlẹ́dàá nyín lọ ḿbẹ̀rẹ̀"},{"start":6.322,"end":7.61,"text":"T'o feki e ba On gbe","marked":"T'ó fẹ́kì ẹ bá On gbé"},{"start":7.99,"end":9.44,"text":"Oran nla ni o mbi nyin","marked":"Ọ̀ràn ńlá ni ó mbi nyín"},{"start":9.82,"end":11.031,"text":"lse owo Re ni nyin","marked":"lse ọwọ́ Rẹ̀ ní nyin"},{"start":11.411,"end":13.097,"text":"A! enyin alailope","marked":"A! enyin aláìlọ́pẹ́"},{"start":13.477,"end":15.038,"text":"E se t'e o ko 'fe Re.","marked":"Ẹ ṣe t'é o kò 'fẹ́ Rẹ."}],"end":15.038},{"key":"2","start":15.988,"lines":[{"start":15.988,"end":17.55,"text":"Elese, e yipada,","marked":"Ẹlẹ́ṣẹ̀, ẹ yípadà"},{"start":17.93,"end":19.722,"text":"Ese ti e o fi ku,","marked":"Ẹ̀ṣẹ̀ tí ẹ ó fi kú"},{"start":20.102,"end":21.164,"text":"Olugbala ni mbere","marked":"Olùgbàlà ní mbere"},{"start":21.544,"end":23.044,"text":"Enit' o gb'emi nyin la;","marked":"Enít' ò gb'èmi nyin là"},{"start":23.424,"end":24.813,"text":"Iku Re y'o j'asan bi?","marked":"Ikú Rẹ y'ó j'asán bí?"},{"start":25.193,"end":26.52,"text":"E o tun kan mo 'gi bi?","marked":"Ẹ ò tún kan mọ́ 'gi bí?"},{"start":26.9,"end":28.36,"text":"Eni'rapada, ese","marked":"Ẹni'ràpadà, ẹ̀ṣẹ̀"},{"start":28.74,"end":30.065,"text":"Ti e o gan ore Re?","marked":"Tí ẹ ò gan ọ̀rẹ́ Rẹ?"}],"end":30.065},{"key":"3","start":31.015,"lines":[{"start":31.015,"end":33.091,"text":"Elese, e yipada","marked":"Ẹlẹ́ṣẹ̀, ẹ yípadà"},{"start":33.471,"end":35.2,"text":"Ese ti e o fi ku?","marked":"Ẹ̀ṣẹ̀ tí ẹ ó fi kú?"},{"start":35.58,"end":36.827,"text":"Emi Mimo ni mbere","marked":"Ẹ̀mí Mímọ́́ ní mbere"},{"start":37.207,"end":38.905,"text":"Ti nf'ojo gbogbo ro nyin","marked":"Ti nf'òjò gbogbo rọ̀ nyin"},{"start":39.285,"end":40.536,"text":"E ki o ha gb'oro Re?","marked":"Ẹ kí ó ha gb'ọ̀rọ̀ Rẹ?"},{"start":40.916,"end":42.153,"text":"E o ko iye sile?","marked":"Ẹ ò kọ iye sílẹ̀?"},{"start":42.533,"end":45.137,"text":"A ti nwa nyin pe, ese","marked":"A ti ńwá nyin pé, ẹsẹ̀"},{"start":45.517,"end":46.66,"text":"T'e mbi Olorun ninu?","marked":"T'ẹ́ mbi Ọlọ́run nínú?"}],"end":46.66},{"key":"4","start":47.61,"lines":[{"start":47.61,"end":49.107,"text":"Iyemeji ha nse nyin","marked":"Iyèméjì ha ńṣe nyin"},{"start":49.487,"end":50.748,"text":"Pe ife ni Olorun?","marked":"Pé ìfẹ́ ni Ọlọ́run?"},{"start":51.128,"end":52.393,"text":"E ki o ha gb'oro Re","marked":"Ẹ kí ó ha gb'ọ̀rọ̀ Rẹ"},{"start":52.773,"end":54.049,"text":"K'e gba ileri Re gbo","marked":"K'ẹ gba ìlérí Rẹ̀ gbọ́"},{"start":54.429,"end":56.1,"text":"W'Oluwa nyin, lodo nyin","marked":"W'Olúwa nyin, lọdọ nyin"},{"start":56.48,"end":58.229,"text":"Jesu nsun, w'omije Re","marked":"Jésù ńsun, w'omijé Rẹ̀"},{"start":58.609,"end":60.713,"text":"Eje Re pelu nke, pe","marked":"Ẹ̀jẹ̀ Rẹ pẹ̀lú ńkẹ́, pé"},{"start":61.093,"end":62.563,"text":"'Esse ti e o fi ku?","marked":"'Esse tí ẹ ó fi kú?"},{"start":62.943,"end":63.408,"text":"Amin.","marked":"Àmín."}],"end":63.408}]}