{"v":1,"coll":"y","num":369,"id":"hymn_369","title":"JE ki m'nipo mi lodo Re","duration":35.065,"voices":{"male":{"file":"y-369-male.m4a","bytes":256955,"sha256":"b300536256ffb8f69239bf08e030d7877aa96e115d1db90525dd1a1f21a21886","duration":35.1},"female":{"file":"y-369-female.m4a","bytes":259315,"sha256":"c9ddba92b2b13f5e5715b34a2dba8182a73ee05cb15d05e8bd5400f4b8513d83","duration":35.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.596,"text":"JE ki m'nipo mi lodo Re","marked":"Jẹ́ kí m'nípò mi lọ́dọ̀ Rẹ"},{"start":1.976,"end":4.333,"text":"Jesu, lwo isimi mi","marked":"Jésù, lwo isimi mi"},{"start":4.713,"end":6.207,"text":"'Gbana l'okan y'o simi","marked":"'Gbaná l'ọkàn y'ó simi"},{"start":6.587,"end":8.235,"text":"Y'o si ri ekun 'bukun gba.","marked":"Y'ó sì rí ẹkùn 'bùkún gbà."}],"end":8.235},{"key":"2","start":9.185,"lines":[{"start":9.185,"end":10.732,"text":"Je ki m' n'ipo mi lodo re","marked":"Jẹ́ kí m' n'ípò mi lọ́dọ̀ rẹ"},{"start":11.112,"end":12.391,"text":"K'emi ko le ri ogo Re","marked":"K'èmí kò lè rí ògo Rẹ"},{"start":12.771,"end":14.211,"text":"'Gbana ni okan etan mi","marked":"'Gbaná ni ọkàn ẹ̀tàn mi"},{"start":14.591,"end":15.997,"text":"Yio ri eni f'ara le.","marked":"Yíó rí ẹni f'ára lé."}],"end":15.997},{"key":"3","start":16.947,"lines":[{"start":16.947,"end":18.574,"text":"Je ki m' n'ipo mi lodo Re","marked":"Jẹ́ kí m' n'ípò mi lọ́dọ̀ Rẹ"},{"start":18.954,"end":20.378,"text":"Nibi awon mimo nyin O","marked":"Níbi àwọn mímọ́́ nyin O"},{"start":20.758,"end":22.454,"text":"'Gbana ni okan ese mi","marked":"'Gbaná ni ọkàn ẹsẹ̀ mi"},{"start":22.834,"end":24.371,"text":"Y'o dekun ese ni dida.","marked":"Y'ó dẹ́kun ẹsẹ̀ ní dídà."}],"end":24.371},{"key":"4","start":25.321,"lines":[{"start":25.321,"end":26.772,"text":"Je ki m'n'ipo mi lodo Re","marked":"Jẹ́ kí m'n'ípò mi lọ́dọ̀ Rẹ"},{"start":27.152,"end":28.44,"text":"Nibi a ki yipo pada","marked":"Níbi a kì yípo padà"},{"start":28.82,"end":30.919,"text":"Nib'a ko npe, o digbose","marked":"Níb'á kò ńpẹ́, ó dìgbóṣe"},{"start":31.299,"end":33.515,"text":"Titi aiye, titi aiye.","marked":"Títí aiye, títí aiye."}],"end":33.515}]}