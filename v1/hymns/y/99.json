{"v":1,"coll":"y","num":99,"id":"hymn_99","title":"ENYlN Egbe Serafu,","duration":95.864,"voices":{"male":{"file":"y-99-male.m4a","bytes":668189,"sha256":"63780b81ca32e821fb2e5d86c31c19c9bc9320a69ef387a30466f301ffffca07","duration":95.9},"female":{"file":"y-99-female.m4a","bytes":702942,"sha256":"ef082a46a35124490bcd527449cfc1b62695dee6fd8a4e283d05559261d18409","duration":95.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.768,"text":"ENYlN Egbe Serafu,","marked":"ENYlN Ẹgbẹ́ Séráfù"},{"start":2.148,"end":3.486,"text":"Ati Egbe Kerubu","marked":"Àti Ẹgbẹ́ Kérúbù"},{"start":3.866,"end":5.335,"text":"E fi ope fun Olorun,","marked":"Ẹ fi ọpẹ́ fún Ọlọ́run"},{"start":5.715,"end":7.266,"text":"T'o d'emi wa si d'oni.","marked":"T'ó d'ẹ̀mí wa sí d'òní."}],"end":7.266},{"key":"CHORUS","start":8.216,"lines":[{"start":8.216,"end":9.451,"text":"Emi ko Ie sai sope","marked":"Èmi kò lè ṣàì ṣọpẹ́"},{"start":9.831,"end":11.073,"text":"Ore t'Olorun se fun mi,","marked":"Ọ̀rẹ́ t'Ọlọ́run ṣe fún mi"},{"start":11.453,"end":13.106,"text":"Emi ko Ie sai sope.","marked":"Èmi kò lè ṣàì ṣọpẹ́."}],"end":13.106},{"key":"2","start":14.056,"lines":[{"start":14.056,"end":15.259,"text":"Loto l'esu gbogun","marked":"Lọ́tọ̀ l'èṣù gbógun"},{"start":15.639,"end":17.015,"text":"Sugbon ko le segun","marked":"Ṣùgbọ́n kò lè ṣẹ́gun"},{"start":17.395,"end":18.602,"text":"Lagbara Metalokan wa,","marked":"Lagbára Mẹ́talọ́kan wa"},{"start":18.982,"end":20.264,"text":"Awa yio bori re.","marked":"Àwa yio borí rẹ̀."}],"end":20.264},{"key":"3","start":21.214,"lines":[{"start":21.214,"end":22.467,"text":"Elomiran ti ku,","marked":"Ẹlòmíràn ti kú"},{"start":22.847,"end":23.784,"text":"Elomiran w'ewon","marked":"Ẹlòmíràn w'ẹ́wọ̀n"},{"start":24.164,"end":25.428,"text":"Elomiran nrin ni ile","marked":"Ẹlòmíràn ńrìn ní ilé"},{"start":25.808,"end":27.223,"text":"Ti moto ti te pa.","marked":"Ti mọ́tò ti tẹ̀ pa."}],"end":27.223},{"key":"4","start":28.173,"lines":[{"start":28.173,"end":29.44,"text":"Ope ni f'Olorun,","marked":"Ọpẹ́ ní f'Ọlọ́run"},{"start":29.82,"end":31.052,"text":"F'anu Re l'Ori wa,","marked":"F'ánú Rẹ l'Orí wa"},{"start":31.432,"end":33.688,"text":"O gbo tire, O gbo temi,","marked":"Ó gbọ́ tirẹ̀, Ó gbọ́ tèmi"},{"start":34.068,"end":35.27,"text":"Ogo ni f'Olorun.","marked":"Ògo ni f'Ọlọ́run."}],"end":35.27},{"key":"5","start":36.22,"lines":[{"start":36.22,"end":37.117,"text":"Olorun alanu,","marked":"Ọlọ́run alanu"},{"start":37.497,"end":39.163,"text":"Siju anu wo wa,","marked":"Ṣíjú anu wò wá"},{"start":39.543,"end":40.897,"text":"Jowo pese fun aini wa,","marked":"Jọ̀wọ́ pèsè fún àìní wa"},{"start":41.277,"end":42.544,"text":"K'ile r'oju fun wa.","marked":"K'ilẹ̀ r'ojú fún wa."}],"end":42.544},{"key":"6","start":43.494,"lines":[{"start":43.494,"end":44.691,"text":"F'ilera f'alaisan","marked":"F'iléra f'aláìsàn"},{"start":45.071,"end":46.16,"text":"Jesu Olugbala","marked":"Jésù Olùgbàlà"},{"start":46.54,"end":47.809,"text":"Jeki awon alaisan,","marked":"Jẹki àwọn aláìsàn"},{"start":48.189,"end":49.552,"text":"Ri 'wosan lodo Re.","marked":"Rí 'wòsàn lọ́dọ̀ Rẹ."}],"end":49.552},{"key":"7","start":50.502,"lines":[{"start":50.502,"end":51.558,"text":"Mu ile ri re ese","marked":"Mú ilé rí rẹ ẹsẹ̀"},{"start":51.938,"end":53.505,"text":"Jehovah Tabbikubb,","marked":"Jehovah Tabbikubb"},{"start":53.885,"end":55.232,"text":"K'awon afoju le riran","marked":"K'áwọn afọ́jú lè ríran"},{"start":55.612,"end":57.107,"text":"K'alailera k'o san.","marked":"K'aláìlera k'ó sàn."}],"end":57.107},{"key":"8","start":58.057,"lines":[{"start":58.057,"end":59.371,"text":"Opo ti sako lo","marked":"Ọ̀pọ̀ ti ṣáko lọ"},{"start":59.751,"end":60.878,"text":"Nwon ko si mona mo","marked":"Nwọn kò sì mọ̀nà mọ́"},{"start":61.258,"end":62.675,"text":"Elomiran j'asiwaju","marked":"Ẹlòmíràn j'aṣíwájú"},{"start":63.055,"end":64.81,"text":"Sugbon o fa s'ehin.","marked":"Ṣùgbọ́n ó fa s'ehin."}],"end":64.81},{"key":"9","start":65.76,"lines":[{"start":65.76,"end":67.365,"text":"Jehovah-Jire wa,","marked":"Jehovah-Jire wa"},{"start":67.745,"end":69.056,"text":"Pese fun aini wa,","marked":"Pèsè fún àìní wa"},{"start":69.436,"end":70.657,"text":"Pese omo f'awon agan","marked":"Pèsè ọmọ f'àwọn àgàn"},{"start":71.037,"end":72.494,"text":"Jek' a ri 'bukun gba.","marked":"Jek' á rí 'bùkún gbà."}],"end":72.494},{"key":"10","start":73.444,"lines":[{"start":73.444,"end":74.29,"text":"Olorun alanu","marked":"Ọlọ́run alanu"},{"start":74.67,"end":75.973,"text":"Dariji eda Re;","marked":"Dáríjì ẹ̀dà Rẹ"},{"start":76.353,"end":77.914,"text":"Mase f'ese bi araiye","marked":"Mase f'ẹsẹ̀ bí araiye"},{"start":78.294,"end":79.793,"text":"Jeki ojo k'o ro.","marked":"Jèkì òjò k'ó rọ̀."}],"end":79.793},{"key":"11","start":80.743,"lines":[{"start":80.743,"end":81.94,"text":"F'ibukun Re f'Oba","marked":"F'ìbùkún Rẹ f'Ọba"},{"start":82.32,"end":83.378,"text":"At'awon Igbimo","marked":"Àt'àwọn Ìgbìmọ̀"},{"start":83.758,"end":85.125,"text":"F'alafia fun ilu wa","marked":"F'àlàáfíà fún ìlú wa"},{"start":85.505,"end":86.986,"text":"K'a ma rogun adaja.","marked":"K'á ma rọ̀gún adájà."}],"end":86.986},{"key":"12","start":87.936,"lines":[{"start":87.936,"end":89.149,"text":"E f'ogo fun Baba","marked":"Ẹ f'ògo fún Bàbá"},{"start":89.529,"end":90.754,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":91.134,"end":92.604,"text":"E f'ogo fun Emi Mimo","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́́"},{"start":92.984,"end":94.314,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."}],"end":94.314}]}