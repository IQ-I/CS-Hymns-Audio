{"v":1,"coll":"y","num":191,"id":"hymn_191","title":"WO! Oluwa l'awosanma","duration":49.983,"voices":{"male":{"file":"y-191-male.m4a","bytes":357038,"sha256":"ebc2856571ca7fc78f178fdc3822379e81b06f1d301bc11769e84ae04d59f2c6","duration":50.0},"female":{"file":"y-191-female.m4a","bytes":367234,"sha256":"cf2d5b99d60643e3afbf8de1766df67a48906dfca85a19f6b2ee13f632c3e212","duration":50.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.947,"text":"WO! Oluwa l'awosanma","marked":"Wò! Olúwa l'àwọsánmà"},{"start":2.327,"end":3.822,"text":"O mbo l'ogo l'ola Re,","marked":"Ó ḿbò l'ògo l'ọ́lá Rẹ̀"},{"start":4.202,"end":5.61,"text":"Enit' a pa fun elese","marked":"Enit' á pa fún ẹlẹ́ṣẹ̀"},{"start":5.99,"end":7.195,"text":"Mbo pelu Angeli Re","marked":"Mbọ́ pẹ̀lú Áńgẹ́lì Rẹ̀"},{"start":7.575,"end":8.411,"text":"Halleluyah!","marked":"Hallelúyà!"},{"start":8.791,"end":9.574,"text":"Halleluyah!","marked":"Hallelúyà!"}],"end":9.574},{"key":"CHORUS","start":10.524,"lines":[{"start":10.524,"end":11.317,"text":"Halleluyah!","marked":"Hallelúyà!"},{"start":11.697,"end":12.555,"text":"Halleluyah!","marked":"Hallelúyà!"}],"end":12.555},{"key":"2","start":13.505,"lines":[{"start":13.505,"end":15.338,"text":"Gbogbo eda, wa wo Jesu","marked":"Gbogbo ẹ̀dá, wá wo Jésù"},{"start":15.718,"end":17.407,"text":"Aso ogo I'a wo fun","marked":"Aṣọ ògo l'á wọ̀ fún"},{"start":17.787,"end":20.126,"text":"Awon t'o gan, a won t'o pa","marked":"Àwọn t'ó gan, a wọn t'ó pa"},{"start":20.506,"end":21.767,"text":"T'o kan mo Agbelebu","marked":"T'ó kan mọ́ Àgbélébùú"},{"start":22.147,"end":22.942,"text":"Won o sokun","marked":"Wọn ò ṣókùn"},{"start":23.322,"end":24.521,"text":"Bi nwon ba ri Oluwa.","marked":"Bí nwọn bá rí Olúwa."}],"end":24.521},{"key":"3","start":25.471,"lines":[{"start":25.471,"end":27.543,"text":"Erekusu. okun, Oke,","marked":"Erékùṣù. òkun, Òkè"},{"start":27.923,"end":30.236,"text":"Orun, aiye, a fo lo","marked":"Ọ̀run, aiye, a fò lọ"},{"start":30.616,"end":32.075,"text":"Awon t'o ko a da nwon ru","marked":"Àwọn t'ó kó a dà nwọ̀n rú"},{"start":32.455,"end":33.63,"text":"Nigbati nwon gb'ohun Re","marked":"Nígbàtí nwọn gb'óhùn Rẹ"},{"start":34.01,"end":35.105,"text":"Wa s'idajo","marked":"Wá s'ìdájọ́"},{"start":35.485,"end":36.831,"text":"Wa s'idajo, wa kalo!","marked":"Wá s'ìdájọ́, wà kàló!"}],"end":36.831},{"key":"4","start":37.781,"lines":[{"start":37.781,"end":39.449,"text":"lrapada t'a ti nreti","marked":"lràpadà t'á ti ńrètí"},{"start":39.829,"end":41.256,"text":"O de pelu ogo nla","marked":"Ó dé pẹ̀lú ògo ńlá"},{"start":41.636,"end":42.825,"text":"Awon ti a gan pelu re,","marked":"Àwọn tí a gan pẹ̀lú rẹ̀"},{"start":43.205,"end":44.612,"text":"Yio pade Re loj'orun!","marked":"Yíó pàdé Rẹ̀ loj'orun!"},{"start":44.992,"end":45.754,"text":"Halleluyah!","marked":"Hallelúyà!"},{"start":46.134,"end":47.409,"text":"Ojo Olugbala de.","marked":"Ọjọ́ Olùgbàlà dé."},{"start":47.789,"end":48.434,"text":"Amin.","marked":"Àmín."}],"end":48.434}]}