{"v":1,"coll":"y","num":292,"id":"hymn_292","title":"KRIST t'agbelebu l'orin wa","duration":33.846,"voices":{"male":{"file":"y-292-male.m4a","bytes":241838,"sha256":"2147f1073ce5379ca793def5f049ff3cec5c1b2cfeb8b41028fa3bd07162799c","duration":33.9},"female":{"file":"y-292-female.m4a","bytes":248946,"sha256":"ab194a349328ea1b8cdb2dd81364f85cecb5f1ed0bcac88b7e3fe1db579901b2","duration":33.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.902,"text":"KRIST t'agbelebu l'orin wa,","marked":"Krist t'àgbélébùú l'orin wa"},{"start":2.282,"end":3.504,"text":"ljinle t'awa nso","marked":"ljinlẹ̀ t'áwá ńsọ"},{"start":3.884,"end":5.645,"text":"O j'egan loju awon ju","marked":"Ó j'ẹ́gàn lójú àwọn jù"},{"start":6.025,"end":7.197,"text":"Were lowo Griki.","marked":"Wẹ́rẹ́ lọ́wọ́ Griki."}],"end":7.197},{"key":"2","start":8.147,"lines":[{"start":8.147,"end":9.609,"text":"Sugbon okan t'Olorun ko","marked":"Ṣùgbọ́n ọkàn t'Ọlọ́run kò"},{"start":9.989,"end":11.441,"text":"F'ayo gba oro na","marked":"F'àyò gba ọ̀rọ̀ ná"},{"start":11.821,"end":14.14,"text":"Nwon ri ogbon, ipa, ife","marked":"Nwọ̀n rí ọgbọ́n, ipa, ìfẹ́"},{"start":14.52,"end":15.931,"text":"T'o han n'Oluwa won.","marked":"T'ó hàn n'Olúwa wọn."}],"end":15.931},{"key":"3","start":16.881,"lines":[{"start":16.881,"end":18.67,"text":"Adun, oruko Re yiye","marked":"Adùn, orúkọ Rẹ̀ yíyẹ"},{"start":19.05,"end":20.541,"text":"Mu soji s'okan won","marked":"Mu sọji s'ọkan wọn"},{"start":20.921,"end":22.88,"text":"Aigbagbo l'ohun t'o ba ni je","marked":"Àìgbàgbọ́ l'ohun t'o bá ní jẹ́"},{"start":23.26,"end":24.677,"text":"Si ebi at'iku.","marked":"Sí ẹbí àt'ìkú."}],"end":24.677},{"key":"4","start":25.627,"lines":[{"start":25.627,"end":27.196,"text":"Lai j'OIorun t'o or'ofe ka","marked":"Láì j'Ọlọ́run t'ó or'ọ̀fẹ́ kà"},{"start":27.576,"end":28.605,"text":"Bi owara ojo","marked":"Bí ọ̀wàrà òjò"},{"start":28.985,"end":30.408,"text":"Lasan l'Apollos funrugbin","marked":"Lásán l'Apollos fúnrúgbìn"},{"start":30.788,"end":32.296,"text":"Paul si le gbin lasan.","marked":"Paul ṣì lè gbìn lásán."}],"end":32.296}]}