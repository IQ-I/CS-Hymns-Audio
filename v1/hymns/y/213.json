{"v":1,"coll":"y","num":213,"id":"hymn_213","title":"IGBA mi mbe li owo Re","duration":40.672,"voices":{"male":{"file":"y-213-male.m4a","bytes":290951,"sha256":"701ee76b0fb3e5bbc2338dd3856c7d766aea694ba54ece738c9fd618acb75a60","duration":40.7},"female":{"file":"y-213-female.m4a","bytes":299091,"sha256":"c232d232fd2e8e2f2f5bd9388ba8194c3c6eb875c262ddb7efe1c32632e8708d","duration":40.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.884,"text":"IGBA mi mbe li owo Re;","marked":"Ìgbà mi mbẹ li ọwọ́ Rẹ"},{"start":2.264,"end":3.462,"text":"A fe ko wa nibe;","marked":"A fẹ́ kó wà níbẹ̀"},{"start":3.842,"end":5.798,"text":"A f'ara wa at'ore wa,","marked":"A f'ara wa àt'ọ̀rẹ́ wa"},{"start":6.178,"end":7.35,"text":"Si abe iso Re.","marked":"Sí abẹ́ ìṣọ́ Rẹ."}],"end":7.35},{"key":"2","start":8.3,"lines":[{"start":8.3,"end":9.726,"text":"Igba mi mbe li owo Re,","marked":"Ìgbà mi mbẹ li ọwọ́ Rẹ"},{"start":10.106,"end":11.054,"text":"Awa o se beru?","marked":"Àwa ò ṣe bẹ̀rù?"},{"start":11.434,"end":12.945,"text":"Baba kio je k' omo Re,","marked":"Bàbá kíó jẹ́ k' omo Rẹ"},{"start":13.325,"end":14.738,"text":"Sokun li ainidi.","marked":"Sokun li àìnídì."}],"end":14.738},{"key":"3","start":15.688,"lines":[{"start":15.688,"end":17.071,"text":"Igba mi mbe li owo Re,","marked":"Ìgbà mi mbẹ li ọwọ́ Rẹ"},{"start":17.451,"end":18.834,"text":"'Wo I' ao gbekele;","marked":"'Wò l' àò gbẹ́kẹ̀lé"},{"start":19.214,"end":21.409,"text":"Tit' ao f'aiye osi sile;","marked":"Tít' aó f'aiye òsì sílẹ̀"},{"start":21.789,"end":23.433,"text":"T' a o si r' ogo Re.","marked":"T' a ò sì r' ògo Rẹ̀."}],"end":23.433},{"key":"4","start":24.383,"lines":[{"start":24.383,"end":25.814,"text":"Igba mi mbe li owo Re;","marked":"Ìgbà mi mbẹ li ọwọ́ Rẹ"},{"start":26.194,"end":27.539,"text":"Jesu t'agbelebu","marked":"Jésù t'àgbélébùú"},{"start":27.919,"end":29.702,"text":"Owo na t' ese mi dalu;","marked":"Owó ná t' ese mi dàlú"},{"start":30.082,"end":31.398,"text":"Wa di alabo mi.","marked":"Wá di alábò mi."}],"end":31.398},{"key":"5","start":32.348,"lines":[{"start":32.348,"end":33.86,"text":"Igba mi mbe li owo Re;","marked":"Ìgbà mi mbẹ li ọwọ́ Rẹ"},{"start":34.24,"end":35.262,"text":"Ngo ma simi le O,","marked":"Ngo ma simi lé O"},{"start":35.642,"end":37.022,"text":"Lehin 'ku l'ow' otun Re;","marked":"Lẹ́hìn 'kù l'ów' ọ̀tún Rẹ"},{"start":37.402,"end":39.122,"text":"L'emi o wa titi lai.","marked":"L'èmi ò wà títí láí."}],"end":39.122}]}