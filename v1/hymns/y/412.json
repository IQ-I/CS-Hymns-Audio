{"v":1,"coll":"y","num":412,"id":"hymn_412","title":"LO l'oro kutukutu","duration":59.068,"voices":{"male":{"file":"y-412-male.m4a","bytes":433045,"sha256":"6ce50ebc9a6501e8144b2432ee87b09f95da6a3b64a0b630e968eb3bce73dd99","duration":59.1},"female":{"file":"y-412-female.m4a","bytes":450547,"sha256":"bcdb9f7b9f982b81e504d039eeae3114ee900dd703bee4888b1451d15afa88fd","duration":59.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.508,"text":"LO l'oro kutukutu","marked":"Lọ l'ọrọ kùtùkùtù"},{"start":1.888,"end":3.234,"text":"Lo, ni osangangan","marked":"Lọ, ní ọ̀sángangan"},{"start":3.614,"end":5.309,"text":"Lo, ni igba asale","marked":"Lọ, ní ìgbà aṣálẹ̀"},{"start":5.689,"end":6.76,"text":"Lo ni oganjo oru,","marked":"Lọ ní ọ̀gànjọ́ òru"},{"start":7.14,"end":8.796,"text":"Lo, t'iwo t'inu rere","marked":"Lò, t'ìwo t'inú rere"},{"start":9.176,"end":10.258,"text":"Gbagbe ohun aiye","marked":"Gbàgbé ohun aiye"},{"start":10.638,"end":12.235,"text":"Si kunle n'iyewu re","marked":"Sì kúnlẹ̀ n'ìyẹ̀wù rẹ"},{"start":12.615,"end":13.82,"text":"Gbadura nikoko.","marked":"Gbàdúrà níkọ̀kọ̀."}],"end":13.82},{"key":"2","start":14.77,"lines":[{"start":14.77,"end":16.128,"text":"Ranti awon t'o fe o","marked":"Rántí àwọn t'ó fẹ́ o"},{"start":16.508,"end":17.88,"text":"At' awon t'iwo fe","marked":"Àt' àwọn t'íwò fẹ́"},{"start":18.26,"end":19.42,"text":"Awon t'o korira re","marked":"Àwọn t'ó kóríra rẹ̀"},{"start":19.8,"end":21.0,"text":"Si gbadura fun won","marked":"Sì gbàdúrà fún wọn"},{"start":21.38,"end":22.94,"text":"Lehin na, toro 'bukun","marked":"Lẹ́hìn ná, tọrọ 'bùkún"},{"start":23.32,"end":24.429,"text":"Fun 'wo tikalare","marked":"Fún 'wo tìkàlárè"},{"start":24.809,"end":26.714,"text":"Ninu adura re, ma","marked":"Nínú àdúrà rẹ, má"},{"start":27.094,"end":28.077,"text":"Pe oruko Jesu.","marked":"Pé orúkọ Jésù."}],"end":28.077},{"key":"3","start":29.027,"lines":[{"start":29.027,"end":30.574,"text":"B'aiye ati gbadura","marked":"B'aiye àti gbàdúrà"},{"start":30.954,"end":32.205,"text":"Ni koko ko si si","marked":"Ní kókó kò sì sí"},{"start":32.585,"end":33.762,"text":"T'okan re fe gbadura","marked":"T'ọkàn rẹ fẹ́ gbàdúrà"},{"start":34.142,"end":35.382,"text":"Gbat'ore yi o ka","marked":"Gbat'ọ̀rẹ́ yi ò ká"},{"start":35.762,"end":38.312,"text":"Ghana, adura jeje","marked":"Ghana, àdúrà jẹ́jẹ́"},{"start":38.692,"end":39.794,"text":"Lat' inu okan re","marked":"Lát' inú ọkàn rẹ"},{"start":40.174,"end":41.584,"text":"Y'o de odo Olorun","marked":"Y'ó dé ọ̀dọ̀ Ọlọ́run"},{"start":41.964,"end":43.073,"text":"Olorun Alanu.","marked":"Ọlọ́run Alanu."}],"end":43.073},{"key":"4","start":44.023,"lines":[{"start":44.023,"end":46.027,"text":"Ko si ay, kan l'aiye","marked":"Kò sí ay, kan l'aiye"},{"start":46.407,"end":47.7,"text":"T'o si ju eyi lo","marked":"T'ó sì ju èyí lọ"},{"start":48.08,"end":49.82,"text":"Nit' agbara t'a fun wa","marked":"Nit' agbára t'á fún wa"},{"start":50.2,"end":51.288,"text":"Lati ma gbadura","marked":"Láti má gbàdúrà"},{"start":51.668,"end":53.001,"text":"'Gba t'inu re ko ba dun","marked":"'Gbá t'inú rẹ̀ kò bá dùn"},{"start":53.381,"end":54.453,"text":"Jek'okan re wole","marked":"Jẹ́k'ọkàn rẹ wọ́lẹ̀"},{"start":54.833,"end":55.872,"text":"Ninu ayo re gbogbo","marked":"Nínú ayọ̀ rẹ gbogbo"},{"start":56.252,"end":57.519,"text":"Ranti or'ofe re.","marked":"Rántí or'ọ̀fẹ́ rẹ."}],"end":57.519}]}