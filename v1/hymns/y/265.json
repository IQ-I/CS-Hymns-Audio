{"v":1,"coll":"y","num":265,"id":"hymn_265","title":"Oluwa mo gbo pe, Iwo","duration":61.324,"voices":{"male":{"file":"y-265-male.m4a","bytes":440007,"sha256":"90a536a408352c6ddec212fd92b19c54365c8cd83eec81650e5c6e6474724358","duration":61.4},"female":{"file":"y-265-female.m4a","bytes":452002,"sha256":"d5d9c921a7ba2d6aba828944aa62dcb0cd66f3240afe466bc0417b51cd54a8cb","duration":61.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.252,"text":"Oluwa mo gbo pe, Iwo","marked":"Olúwa mo gbọ́ pé, Ìwọ"},{"start":2.632,"end":3.686,"text":"Nro ojo 'bukun kiri","marked":"Nró ọjọ́ 'bùkún kiri"},{"start":4.066,"end":5.697,"text":"ltunu fun okan are","marked":"ltunu fún ọkàn àrẹ"},{"start":6.077,"end":7.302,"text":"Ro ojo na sori mi.","marked":"Rọ ọjọ́ ná sórí mi."}],"end":7.302},{"key":"CHORUS","start":8.252,"lines":[{"start":8.252,"end":9.891,"text":"An emi, an'emi","marked":"Án ẹ̀mí, àń'ẹ̀mí"},{"start":10.271,"end":11.573,"text":"Ro ojo na sori mi.","marked":"Rọ ọjọ́ ná sórí mi."}],"end":11.573},{"key":"2","start":12.523,"lines":[{"start":12.523,"end":13.813,"text":"Ma koja Baba Olore","marked":"Má kọjá Bàbá Ọlọ́rẹ"},{"start":14.193,"end":15.416,"text":"Bi ese mi tile po","marked":"Bí ẹsẹ̀ mi tilẹ̀ pọ̀"},{"start":15.796,"end":17.486,"text":"Wo le fi mi sile sugbon","marked":"Wọ́ lè fi mí sílẹ̀ ṣùgbọ́n"},{"start":17.866,"end":19.2,"text":"Je k'anu Re ba le mi.","marked":"Jẹ́ k'ánú Rẹ bá lè mí."}],"end":19.2},{"key":"3","start":20.15,"lines":[{"start":20.15,"end":21.722,"text":"Ma koja mi, Olugbala","marked":"Má kọjá mi, Olùgbàlà"},{"start":22.102,"end":23.306,"text":"Je k'emi le ro mo o","marked":"Jẹ k'ẹ̀mí lè rọ̀ mọ́ o"},{"start":23.686,"end":24.994,"text":"Emi nwa oju rere Re","marked":"Èmi ńwá ojú rere Rẹ"},{"start":25.374,"end":26.697,"text":"Pe mi mo awon t'o npe.","marked":"Pẹ́ mi mọ àwọn t'ó ńpẹ́."}],"end":26.697},{"key":"4","start":27.647,"lines":[{"start":27.647,"end":29.411,"text":"Mo koja mi, Emi Mimo","marked":"Mo kọjá mi, Ẹ̀mí Mímọ́́"},{"start":29.791,"end":31.296,"text":"Wo le la 'ju afoju","marked":"Wo lẹ là 'jù afọ́jú"},{"start":31.676,"end":33.327,"text":"Eleri itoye Jesu","marked":"Eleri ìtóye Jésù"},{"start":33.707,"end":35.018,"text":"Soro as na si mi.","marked":"Sọ̀rọ̀ às nà sí mi."}],"end":35.018},{"key":"5","start":35.968,"lines":[{"start":35.968,"end":37.734,"text":"Mo ti sun fonfon nin'ese","marked":"Mo ti sùn fọnfọn níń'ẹsẹ̀"},{"start":38.114,"end":39.356,"text":"Mo bi O ninu koja","marked":"Mo bí Ọ nínú kọjá"},{"start":39.736,"end":41.078,"text":"Aiye ti de okan mi jo","marked":"Aiye ti dé ọkàn mi jọ"},{"start":41.458,"end":43.357,"text":"Tu mi k'o dafiji mi.","marked":"Tù mí k'ó dafiji mi."}],"end":43.357},{"key":"6","start":44.307,"lines":[{"start":44.307,"end":45.949,"text":"lfe Olorun ti ki ye","marked":"lfẹ́ Ọlọ́run tí kì yẹ"},{"start":46.329,"end":47.74,"text":"Eje kristi iyebiye","marked":"Ẹ̀jẹ̀ Kristi iyebíye"},{"start":48.12,"end":49.308,"text":"Ore-Ofe alainiwon","marked":"Ọrẹ-Ọ̀fẹ́ aláìníwọ̀n"},{"start":49.688,"end":51.018,"text":"Gbe gbogbo re ga n'nu mi.","marked":"Gbé gbogbo rẹ̀ ga ń'nú mi."}],"end":51.018},{"key":"7","start":51.968,"lines":[{"start":51.968,"end":54.118,"text":"Ma koja, mi dariji mi","marked":"Má kọjá, mi dariji mi"},{"start":54.498,"end":55.947,"text":"Fa mi mora, Oluwa","marked":"Fà mí mọ́ra, Olúwa"},{"start":56.327,"end":57.814,"text":"“Gba o nf'ibukun f'elomi,","marked":"Gba ò nf'ìbùkún f'élómi"},{"start":58.194,"end":59.774,"text":"Masai f'ibukun fun mi.","marked":"Masai f'ìbùkún fún mi."}],"end":59.774}]}