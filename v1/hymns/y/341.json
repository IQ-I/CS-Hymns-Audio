{"v":1,"coll":"y","num":341,"id":"hymn_341","title":"MO n tesiwaju l'ona naa","duration":51.042,"voices":{"male":{"file":"y-341-male.m4a","bytes":365717,"sha256":"7c5af078219222baf99df989455384ab081127b4b3bbcdd5352e869689eb9537","duration":51.1},"female":{"file":"y-341-female.m4a","bytes":378447,"sha256":"c3370ac6ac4a225a38a6a4755696c1035a3106bb35ee33d178f27cca524fb2ba","duration":51.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.057,"text":"MO n tesiwaju l'ona naa","marked":"Mò ń tẹ̀síwájú l'ọ́nà náà"},{"start":2.437,"end":4.0,"text":"Mo n g'oke si l'ojoojumo","marked":"Mò ń g'òkè sí l'ojoojúmọ́"},{"start":4.38,"end":6.584,"text":"Mo n gbadura bi mo ti n lo","marked":"Mo ń gbàdúrà bí mo ti ń lọ"},{"start":6.964,"end":8.237,"text":"Oluwa f'ese mi mu le.","marked":"Olúwa f'ẹsẹ̀ mi mú le."}],"end":8.237},{"key":"CHORUS","start":9.187,"lines":[{"start":9.187,"end":10.771,"text":"Oluwa joo gbe mi s'oke","marked":"Olúwa jọ̀ọ́ gbé mi s'òkè"},{"start":11.151,"end":13.107,"text":"S'ile orun nipa gbagbo","marked":"S'ílẹ̀ ọ̀run nípa gbàgbọ́"},{"start":13.487,"end":15.021,"text":"Bi t'ayo at'ife gbe wa","marked":"Bí t'àyò àt'ìfẹ́ gbé wa"},{"start":15.401,"end":16.639,"text":"Oluwa f'ese mi mu le.","marked":"Olúwa f'ẹsẹ̀ mi mú le."}],"end":16.639},{"key":"2","start":17.589,"lines":[{"start":17.589,"end":18.945,"text":"lfe okan mi ko duro","marked":"lfe ọkàn mi kò dúró"},{"start":19.325,"end":21.174,"text":"Laarin yemeji at'eru","marked":"Láàrin yèméjì àt'ẹrú"},{"start":21.554,"end":23.713,"text":"Awon miiran le maa gbe be","marked":"Àwọn mìíràn lè máa gbé bẹ́"},{"start":24.093,"end":25.476,"text":"llepa mi n'ibi giga.","marked":"llépa mi n'ibi gíga."}],"end":25.476},{"key":"3","start":26.426,"lines":[{"start":26.426,"end":27.745,"text":"Em'o bori b'idanwo de","marked":"Em'ó borí b'ìdánwò dé"},{"start":28.125,"end":29.563,"text":"Okan mi yoo sinmi le O","marked":"Ọkàn mi yóò sinmi lé O"},{"start":29.943,"end":31.135,"text":"Alaafia kikun si nbe","marked":"Àlàáfíà kíkún sí ńbẹ"},{"start":31.515,"end":33.035,"text":"F'awon t'o ngbe ibi giga.","marked":"F'àwọn t'ó ngbe ibi gíga."}],"end":33.035},{"key":"4","start":33.985,"lines":[{"start":33.985,"end":35.566,"text":"Mo fe de 'bi giga julo","marked":"Mo fẹ́ dé 'bí gíga jùlọ"},{"start":35.946,"end":37.613,"text":"B'o ti wu ki'ija naa le to","marked":"B'ó ti wù kí'ìjà náà le tó"},{"start":37.993,"end":39.573,"text":"No ma ko'rin bi mo ti n lo","marked":"No ma ko'rin bí mo ti ń lọ"},{"start":39.953,"end":41.215,"text":"Oluwa joo mu mi de be.","marked":"Olúwa jọ̀ọ́ mú mi dé bẹ́."}],"end":41.215},{"key":"5","start":42.165,"lines":[{"start":42.165,"end":43.498,"text":"Oluwa joo s'amona mi","marked":"Olúwa jọ̀ọ́ s'amọ̀nà mi"},{"start":43.878,"end":45.662,"text":"Laisi Re n ko ni le de be","marked":"Láìsí Rẹ̀ n kò ní lè dé bẹ́"},{"start":46.042,"end":47.454,"text":"Gba m'ba si de ilu Orun","marked":"Gba m'ba sì dé ìlú Ọ̀run"},{"start":47.834,"end":49.493,"text":"Okan mi yoo f'ope fun O.","marked":"Ọkàn mi yóò f'ọpẹ́ fún Ọ."}],"end":49.493}]}