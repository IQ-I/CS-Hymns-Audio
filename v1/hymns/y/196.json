{"v":1,"coll":"y","num":196,"id":"hymn_196","title":"OKAN wa kun f'ayo loni","duration":87.873,"voices":{"male":{"file":"y-196-male.m4a","bytes":651423,"sha256":"fdbc1ee72b49a595c7332ab7a2da3eded4be0a39634dbdc44f3b6f923dad8153","duration":87.9},"female":{"file":"y-196-female.m4a","bytes":673095,"sha256":"cec314f18d558958a13015ab926a602c477f07d23e81be0c7a47f2083f237104","duration":87.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.739,"text":"OKAN wa kun f'ayo loni","marked":"Ọkàn wa kún f'àyò lọni"},{"start":2.119,"end":3.447,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":3.827,"end":5.39,"text":"Imole re nta l'ona wa","marked":"Ìmọ́lẹ̀̀ rẹ̀ ńta l'ọ́nà wa"},{"start":5.77,"end":7.072,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":7.452,"end":9.234,"text":"O ti pe t'ayun Re nyun wa","marked":"Ó ti pẹ́ t'áyun Rẹ̀ nyún wa"},{"start":9.614,"end":10.966,"text":"Larin ayidayid' aye","marked":"Lárin ayídáyid' ayé"},{"start":11.346,"end":13.286,"text":"Die lo ku fun wa k'o bo","marked":"Díẹ̀ ló kù fún wa k'ó bọ́"},{"start":13.666,"end":14.967,"text":"K'a to r'ona wura na.","marked":"K'á tó r'ọ́nà wúrà ná."}],"end":14.967},{"key":"CHORUS","start":15.917,"lines":[{"start":15.917,"end":17.549,"text":"Egbe: Nje korin, korin ayo","marked":"Ǹjẹ́ kọrin, kọrin ayọ̀"},{"start":17.929,"end":19.513,"text":"F'okan ayo korin soke","marked":"F'ọkàn ayò kọrin sókè"},{"start":19.893,"end":22.113,"text":"Imole de, a de 'ile wa","marked":"Ìmọ́lẹ̀̀ dé, a dé 'ilé wa"},{"start":22.493,"end":23.777,"text":"Ati r'ona wura na.","marked":"Àti r'ọ́nà wúrà ná."}],"end":23.777},{"key":"2","start":24.727,"lines":[{"start":24.727,"end":26.34,"text":"A pe wa kuro l'aye yi","marked":"A pè wá kúrò l'áyé yí"},{"start":26.72,"end":28.167,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":28.547,"end":30.188,"text":"Ore wa gbogbo wa nibe","marked":"Ọ̀rẹ́ wa gbogbo wa níbẹ̀"},{"start":30.568,"end":31.854,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":32.234,"end":33.641,"text":"Awa jeri pe didun na","marked":"Àwa jẹ́rí pé dídùn ná"},{"start":34.021,"end":35.453,"text":"K'a ma tase ijoba orun","marked":"K'á ma tàsé ìjọba ọ̀run"},{"start":35.833,"end":37.565,"text":"Pelu Jesu a nlo 'le wa","marked":"Pẹ̀lú Jésù à ńlò 'lè wà"},{"start":37.945,"end":39.367,"text":"A ti r'ona wura na.","marked":"A ti r'ọ́nà wúrà ná."}],"end":39.367},{"key":"3","start":40.317,"lines":[{"start":40.317,"end":42.263,"text":"Kiun ni 'danwo wa t'o koja","marked":"Kíún ni 'dánwò wa t'ó kọjá"},{"start":42.643,"end":43.903,"text":"A ti t'ona wura na","marked":"A ti t'ọ́nà wúrà ná"},{"start":44.283,"end":45.694,"text":"Ayo ile mu k'a gbagbe","marked":"Ayò ilé mú k'á gbàgbé"},{"start":46.074,"end":47.399,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":47.779,"end":49.526,"text":"'Ji kuku ko ni pe kuro","marked":"'Jí kúkú kò ní pẹ́ kúrò"},{"start":49.906,"end":51.677,"text":"lfayabale yoo si de","marked":"lfàyàbàlẹ̀ yóò sì dé"},{"start":52.057,"end":53.12,"text":"A ta 'gbokun, oko si gun le","marked":"A ta 'gbòkun, ọkọ̀ sì gùn lé"},{"start":53.5,"end":55.038,"text":"A ti r'ona wura na.","marked":"A ti r'ọ́nà wúrà ná."}],"end":55.038},{"key":"4","start":55.988,"lines":[{"start":55.988,"end":57.663,"text":"Pel'okan 'es'Olorun wa","marked":"Pel'okan 'ẹs'Ọlọ́run wa"},{"start":58.043,"end":59.374,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":59.754,"end":61.387,"text":"Lekan ri ti a ti sonu","marked":"Lẹ́kàn rí tí a ti sọnù"},{"start":61.767,"end":63.037,"text":"A ti r'ona wura na","marked":"A ti r'ọ́nà wúrà ná"},{"start":63.417,"end":64.657,"text":"A fe d'odo Olugbala","marked":"A fẹ́ d'odo Olùgbàlà"},{"start":65.037,"end":66.724,"text":"Jesu yoo f'ayo gba wa","marked":"Jésù yóò f'àyò gbà wá"},{"start":67.104,"end":68.575,"text":"O je nipa or'ofe nikan","marked":"Ó jẹ́ nípa or'ọ̀fẹ́ nìkan"},{"start":68.955,"end":70.453,"text":"A ti r'ona wura na.","marked":"A ti r'ọ́nà wúrà ná."}],"end":70.453},{"key":"5","start":71.403,"lines":[{"start":71.403,"end":72.664,"text":"A dupe low'Olorun wa","marked":"A dúpẹ́ lọ́w'Ọlọ́run wa"},{"start":73.044,"end":74.504,"text":"Ti p'a r'ona wura na","marked":"Ti p'á r'ọ́nà wúrà ná"},{"start":74.884,"end":77.457,"text":"Iyin, ogo ope, ola","marked":"Ìyìn, ògo ọ̀pẹ, ọ̀la"},{"start":77.837,"end":79.247,"text":"Fun Baba ati Omo","marked":"Fún Bàbá àti Ọmọ"},{"start":79.627,"end":80.862,"text":"Ati pelu Emi Mimo","marked":"Àti pẹ̀lú Ẹ̀mí Mímọ́́"},{"start":81.242,"end":82.804,"text":"Metalokan ayeraye","marked":"Mẹ́talọ́kan ayérayé"},{"start":83.184,"end":84.718,"text":"Titi aye lao ma yin","marked":"Títí ayé láó mà yín"},{"start":85.098,"end":86.323,"text":"Pe a r'ona wura na.","marked":"Pé a r'ọ́nà wúrà ná."}],"end":86.323}]}