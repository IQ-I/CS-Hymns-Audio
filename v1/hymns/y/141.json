{"v":1,"coll":"y","num":141,"id":"hymn_141","title":"MO f'ope f'Oluwa","duration":61.139,"voices":{"male":{"file":"y-141-male.m4a","bytes":427385,"sha256":"08b608286256971fa85cf14a58576bce99e39197acd42081e0542209c656e911","duration":61.2},"female":{"file":"y-141-female.m4a","bytes":442087,"sha256":"b469574267bbb6200d7ea3f303e9a1841a0e5f686848c120b92c5e47f072ebc0","duration":61.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.528,"text":"MO f'ope f'Oluwa","marked":"Mo f'ọpẹ́ f'Olúwa"},{"start":1.908,"end":3.001,"text":"Ahon mi nyin Jesu","marked":"Ahọ́n mi nyin Jésù"},{"start":3.381,"end":5.012,"text":"Ti a ko ni lat'ewe wa,","marked":"Tí a kò ní lát'ewé wa"},{"start":5.392,"end":6.558,"text":"Lati kaOro Re.","marked":"Láti kaOro Rẹ."}],"end":6.558},{"key":"2","start":7.508,"lines":[{"start":7.508,"end":8.784,"text":"B'ese mi ti po to","marked":"B'ẹsẹ̀ mi ti pọ̀ tó"},{"start":9.164,"end":10.357,"text":"Egbe at'ewu nla","marked":"Ẹgbẹ́ àt'ewu ńlá"},{"start":10.737,"end":12.261,"text":"Eru s'ese nipa eda","marked":"Ẹrú s'ẹsẹ̀ nípa ẹ̀dá"},{"start":12.641,"end":13.887,"text":"Ni Bibeli nko mi.","marked":"Ní Bíbélì ńkọ́ mi."}],"end":13.887},{"key":"3","start":14.837,"lines":[{"start":14.837,"end":16.323,"text":"Bibeli l'o nko ni","marked":"Bíbélì l'ó ńkọ́ ni"},{"start":16.703,"end":18.207,"text":"B'a ko tile senkan;","marked":"B'á kò tilẹ̀ ṣèǹkàn"},{"start":18.587,"end":20.465,"text":"Nje nibo l'elese y'o wo,","marked":"Ǹjẹ́ níbo l'ẹlẹ́sẹ̀ y'ó wọ̀"},{"start":20.845,"end":22.16,"text":"Lati bo n'nu egbe?","marked":"Láti bọ́ ń'nú ẹgbẹ́?"}],"end":22.16},{"key":"4","start":23.11,"lines":[{"start":23.11,"end":24.114,"text":"lwe Mimo Re yi,","marked":"lwe Mímọ́́ Rẹ yí"},{"start":24.494,"end":26.299,"text":"Jesu, Oluwa mi,","marked":"Jésù, Olúwa mi"},{"start":26.679,"end":28.314,"text":"L'o nf' ona igbala han ni,","marked":"L'ó nf' ona ìgbàlà hàn ni"},{"start":28.694,"end":30.162,"text":"L'o si nko-ni rere.","marked":"L'ó sì ńkọ́-ní rere."}],"end":30.162},{"key":"5","start":31.112,"lines":[{"start":31.112,"end":32.378,"text":"Ninu re ni mo ko","marked":"Nínú rẹ̀ ni mo kọ̀"},{"start":32.758,"end":34.042,"text":"Bi Krist'Om'Olorun","marked":"Bí Krist'Om'Ọlọ́run"},{"start":34.422,"end":35.761,"text":"Ti terigba iya nla wa,","marked":"Ti tẹ́rígbà ìyá ńlá wa"},{"start":36.141,"end":37.308,"text":"Ti O Si ku fun wa.","marked":"Tí Ó Ṣì kù fún wa."}],"end":37.308},{"key":"6","start":38.258,"lines":[{"start":38.258,"end":39.405,"text":"O gunwa li orun","marked":"Ó gúnwá li ọ̀run"},{"start":39.785,"end":40.743,"text":"O nran Emi Re wa","marked":"Ó ńràn Ẹ̀mí Rẹ̀ wá"},{"start":41.123,"end":42.656,"text":"Lati fi ife nla Re han","marked":"Láti fi ìfẹ́ ńlá Rẹ hàn"},{"start":43.036,"end":44.039,"text":"At'ilana rere.","marked":"Àt'ìlànà rere."}],"end":44.039},{"key":"7","start":44.989,"lines":[{"start":44.989,"end":47.355,"text":"Emi Mimo, ko mi","marked":"Ẹ̀mí Mímọ́́, kò mí"},{"start":47.735,"end":48.715,"text":"K'okan mi si le gba","marked":"K'ọkàn mi sì lè gbà"},{"start":49.095,"end":50.743,"text":"Gbogbo 'wasu oro Re gbo","marked":"Gbogbo 'wàsù ọ̀rọ̀ Rẹ̀ gbọ́"},{"start":51.123,"end":52.328,"text":"B'awon enia Re.","marked":"B'àwọn enia Rẹ."}],"end":52.328},{"key":"8","start":53.278,"lines":[{"start":53.278,"end":54.556,"text":"Nigbana, Oluwa","marked":"Nígbàná, Olúwa"},{"start":54.936,"end":56.203,"text":"L'orin 'yin mi y'o ga;","marked":"L'orin 'yín mi y'ó ga"},{"start":56.583,"end":58.158,"text":"N'tori t'a ko mi lati ka","marked":"N'torí t'á kọ́ mi láti kà"},{"start":58.538,"end":59.589,"text":"Bibeli mimo Re.","marked":"Bíbélì mímọ́́ Rẹ̀."}],"end":59.589}]}