{"v":1,"coll":"y","num":42,"id":"hymn_42","title":"IWO t'o nmu okan mole","duration":53.546,"voices":{"male":{"file":"y-42-male.m4a","bytes":390772,"sha256":"b2b43d505ab65ebe2799ae3ce7b9c503d762d1a2dcd259b156910c1b6fade48c","duration":53.6},"female":{"file":"y-42-female.m4a","bytes":403068,"sha256":"85b5af2df72bb70330c0919dd00f64c7ae43e98847a2259019a19f2abfc65581","duration":53.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.777,"text":"IWO t'o nmu okan mole","marked":"Ìwo t'ó nmu ọkàn mọ́lẹ̀"},{"start":2.157,"end":3.658,"text":"Nipa 'mole atorunwa","marked":"Nípa 'mole àtọ̀runwá"},{"start":4.038,"end":5.209,"text":"T'o si nse iri ibukun","marked":"T'ó sì ńṣe ìrì ìbùkún"},{"start":5.589,"end":7.206,"text":"Sor'awon ti nsaferi Re.","marked":"Sọ́r'àwọn ti ńṣàfẹ́rí Rẹ."}],"end":7.206},{"key":"2","start":8.156,"lines":[{"start":8.156,"end":9.539,"text":"Jo masai fi ibukun Re,","marked":"Jó máṣàì fi ìbùkún Rẹ"},{"start":9.919,"end":11.329,"text":"Fun oluko at'akeko","marked":"Fún olùkọ́ àt'ákẹ́kọ́"},{"start":11.709,"end":12.965,"text":"Ki ljo Re le je mimo","marked":"Kí ljo Rẹ lè jẹ́ mímọ́́"},{"start":13.345,"end":14.885,"text":"K'atupa re ma jo gere.","marked":"K'atupa rẹ má jọ gẹ́rẹ́."}],"end":14.885},{"key":"3","start":15.835,"lines":[{"start":15.835,"end":17.479,"text":"F'okan mimo fun oluko,","marked":"F'ọkàn mímọ́́ fún olùkọ́"},{"start":17.859,"end":20.632,"text":"Igbagbo, 'reti, at'ife","marked":"Ìgbàgbọ́́, 'reti, at'ife"},{"start":21.012,"end":22.662,"text":"Ki nwon j'enit' lwo ti ko","marked":"Kí nwọn j'enit' lwo tí kò"},{"start":23.042,"end":24.651,"text":"Ki nwon le j'oluko rere.","marked":"Kí nwọn lè j'olùkọ́ rere."}],"end":24.651},{"key":"4","start":25.601,"lines":[{"start":25.601,"end":26.917,"text":"F'eti igboran f'akeko","marked":"F'etí ìgbọràn f'ákẹ́kọ́"},{"start":27.297,"end":28.793,"text":"Okan 'rele at'aitetan","marked":"Ọkàn 'rẹlẹ̀ àt'àìtẹ̀tàn"},{"start":29.173,"end":31.361,"text":"Talaka to kun f'ebun yi,","marked":"Tálákà tó kún f'ẹ̀bùn yí"},{"start":31.741,"end":33.41,"text":"San ju oba aiye yi lo.","marked":"Sàn ju ọba aiye yí lọ."}],"end":33.41},{"key":"5","start":34.36,"lines":[{"start":34.36,"end":36.154,"text":"Buk'oluso: buk'agutan,","marked":"Buk'oluso: bùk'àgùtàn"},{"start":36.534,"end":38.213,"text":"Ki nwon j'okan labe 'so Re,","marked":"Kí nwọn j'ọ̀kan lábẹ́ 'sọ Rẹ"},{"start":38.593,"end":40.061,"text":"Ki nwon ma f'okan kan sona,","marked":"Kí nwọn má f'ọkàn kan sọ́nà"},{"start":40.441,"end":42.051,"text":"Tit' aiye osi yi y'o pin.","marked":"Tít' aiye òsì yí y'ó pín."}],"end":42.051},{"key":"6","start":43.001,"lines":[{"start":43.001,"end":44.832,"text":"Baba, b'awa ba n'ore Re,","marked":"Bàbá, b'áwá bá ń'ọ̀rẹ́ Rẹ"},{"start":45.212,"end":47.033,"text":"Laiye yi l'a ti l'ogo","marked":"Láìyé yí l'á ti l'ògo"},{"start":47.413,"end":48.934,"text":"K'a to koja s'oke orun","marked":"K'á tó kọjá s'òkè ọ̀run"},{"start":49.314,"end":51.05,"text":"L'ao mo ohun ti aiku je.","marked":"L'áo mọ ohun tí àìkú jẹ́."},{"start":51.43,"end":51.996,"text":"Amin.","marked":"Àmín."}],"end":51.996}]}