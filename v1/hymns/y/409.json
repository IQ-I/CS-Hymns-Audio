{"v":1,"coll":"y","num":409,"id":"hymn_409","title":"NINU gbogbo iji ti nja","duration":42.129,"voices":{"male":{"file":"y-409-male.m4a","bytes":307282,"sha256":"4bd7149eb74d04324c410260c8a1568146a09a2b3199e812b0210ad5e1efce72","duration":42.2},"female":{"file":"y-409-female.m4a","bytes":313704,"sha256":"a10c736ec1e71a853bb043e407679064a508e7ad777405b7a7e0187228f3e716","duration":42.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.052,"text":"NINU gbogbo iji ti nja","marked":"Nínú gbogbo ìjì ti ńjà"},{"start":2.432,"end":3.584,"text":"Ninu gbogbo igbi'ponju","marked":"Nínú gbogbo ìgbì'pọ́njú"},{"start":3.964,"end":5.716,"text":"Abo kan mbe ti o daju","marked":"Abo kan ḿbẹ tí ò dájú"},{"start":6.096,"end":7.592,"text":"O wa labe ite‐anu.","marked":"Ó wà lábẹ́ ìtẹ́-ànú."}],"end":7.592},{"key":"2","start":8.542,"lines":[{"start":8.542,"end":10.463,"text":"Ibi kan wa ti Jesu nda","marked":"Ibì kan wà tí Jésù ńdà"},{"start":10.843,"end":11.937,"text":"Ororo ayo sori wa","marked":"Òróró ayọ̀ sórí wa"},{"start":12.317,"end":13.748,"text":"O dun ju ibi gbogbo lo","marked":"Ó dùn ju ibi gbogbo lọ"},{"start":14.128,"end":15.769,"text":"Ite anu t'a f'eje won.","marked":"Ìtẹ́ ànú t'á f'ẹ̀jẹ̀ wọn."}],"end":15.769},{"key":"3","start":16.719,"lines":[{"start":16.719,"end":18.04,"text":"Ibi kan wa fun idapo","marked":"Ibì kan wà fún ìdàpọ̀"},{"start":18.42,"end":19.655,"text":"Nibi ore npade ore","marked":"Níbi ọ̀rẹ́ ńpàdé ọ̀rẹ́"},{"start":20.035,"end":21.437,"text":"Lairi 'ra nipa igbagbo","marked":"Láìrí 'ra nípa ìgbàgbọ́́"},{"start":21.817,"end":23.317,"text":"Nwon y'ite anu kanna ka.","marked":"Nwọn y'ite ãnu kanná ká."}],"end":23.317},{"key":"4","start":24.267,"lines":[{"start":24.267,"end":25.87,"text":"A! nibo ni a ba sa si","marked":"A! níbo ni à bá sá sí"},{"start":26.25,"end":27.629,"text":"Nigba 'danwo at'iponju?","marked":"Nígbà 'dánwò àt'ìpọ́njú?"},{"start":28.009,"end":29.405,"text":"A ba se le bori esu,","marked":"A bá ṣe lè borí èṣù"},{"start":29.785,"end":31.739,"text":"B'o se pe ko si 'te-anu.","marked":"B'ó ṣe pé kò sí 'tẹ-ánú."}],"end":31.739},{"key":"5","start":32.689,"lines":[{"start":32.689,"end":34.642,"text":"A! bi idi l'a fo sibe","marked":"A! bí idì l'á fò síbẹ̀"},{"start":35.022,"end":36.275,"text":"B'enipe ajye ko si mo","marked":"B'ẹnipè ajye kò sí mọ́"},{"start":36.655,"end":37.854,"text":"Orun wa pade okan wa","marked":"Ọ̀run wá pàdé ọkàn wa"},{"start":38.234,"end":39.573,"text":"Ogo si bo ite‐anu.","marked":"Ògo sì bo ìtẹ́-ánú."},{"start":39.953,"end":40.579,"text":"Amin.","marked":"Àmín."}],"end":40.579}]}