{"v":1,"coll":"y","num":464,"id":"hymn_464","title":"N'IRUMI at'iji aiye","duration":51.09,"voices":{"male":{"file":"y-464-male.m4a","bytes":356410,"sha256":"7a96d8c882e9ec201183dd6893372e44a62ce8c356d302dd1ebe1dd47a5ad26e","duration":51.1},"female":{"file":"y-464-female.m4a","bytes":369973,"sha256":"551f818aeba68f50d50946247c256e67b34fb53a63b89d2f5fc3b5510b5e4648","duration":51.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.202,"text":"N'IRUMI at'iji aiye","marked":"N'irumi àt'ìjì aiye"},{"start":2.582,"end":4.34,"text":"Mo gbo ohun itunu kan","marked":"Mo gbọ́ ohun ìtùnú kan"},{"start":4.72,"end":6.139,"text":"O nso si mi l'eti wipe","marked":"Ó ǹṣó sí mi l'etí wípé"},{"start":6.519,"end":8.038,"text":"Emi ni, mase beru.","marked":"Èmi ni, máṣe bẹ̀rù."}],"end":8.038},{"key":"2","start":8.988,"lines":[{"start":8.988,"end":10.371,"text":"Emi l'o we okan re mo","marked":"Èmi l'ó wé ọkàn rẹ̀ mọ́"},{"start":10.751,"end":12.16,"text":"Emi l'o mu ki o riran","marked":"Èmi l'ó mú kí ó ríran"},{"start":12.54,"end":14.01,"text":"Emi n'oiye imole re","marked":"Èmi n'oiye ìmọ́lẹ̀̀ rẹ"},{"start":14.39,"end":16.168,"text":"Emi ni, mase beru.","marked":"Èmi ni, máṣe bẹ̀rù."}],"end":16.168},{"key":"3","start":17.118,"lines":[{"start":17.118,"end":18.359,"text":"Awon igbi omi wonyi","marked":"Àwọn ìgbì omi wọ̀nyí"},{"start":18.739,"end":20.185,"text":"Ti f'agbara won lu mi ri,","marked":"Ti f'ágbára wọn lù mí rí"},{"start":20.565,"end":21.894,"text":"Nwon ko le se o n'ibi mo;","marked":"Nwọn kò lè ṣe ó ń'ìbí mọ́"},{"start":22.274,"end":23.507,"text":"Emi ni, mase beru.","marked":"Èmi ni, máṣe bẹ̀rù."}],"end":23.507},{"key":"4","start":24.457,"lines":[{"start":24.457,"end":26.13,"text":"Mo ti mu ago yi lekan,","marked":"Mo ti mú àgọ́ yí lẹ́kàn"},{"start":26.51,"end":27.974,"text":"'Wo ko le mo kikoro re,","marked":"'Wò kò lè mọ kíkorò rẹ̀"},{"start":28.354,"end":29.659,"text":"Emi ti mo bi o ti ri","marked":"Èmi ti mọ bí ó ti rí"},{"start":30.039,"end":31.562,"text":"Emi ni: mase beru.","marked":"Èmi ni: máṣe bẹ̀rù."}],"end":31.562},{"key":"5","start":32.512,"lines":[{"start":32.512,"end":34.513,"text":"Mo pe, l' or'eni arun re,","marked":"Mo pẹ́, l' or'eni àrùn rẹ"},{"start":34.893,"end":36.536,"text":"Oju mi ko ye l'ara re,","marked":"Ojú mi kò yé l'ara rẹ"},{"start":36.916,"end":38.256,"text":"Ibukun mi wa l'ori re,","marked":"Ìbùkún mi wà l'orí rẹ"},{"start":38.636,"end":40.056,"text":"Emi ni, mase beru.","marked":"Èmi ni, máṣe bẹ̀rù."}],"end":40.056},{"key":"6","start":41.006,"lines":[{"start":41.006,"end":43.0,"text":"Gbat'emi re ba pin laiye,","marked":"Gbat'èmi rẹ bá pín láìyẹ"},{"start":43.38,"end":44.826,"text":"T'awon t'orun wa pade re,","marked":"T'àwọn t'ọrùn wá pàdé rẹ"},{"start":45.206,"end":47.447,"text":"'Wo o gbohun kan t'o mo pe,","marked":"'Wò ó gbóhùn kan t'ó mọ̀ pé"},{"start":47.827,"end":49.54,"text":"Emi ni, mase beru.","marked":"Èmi ni, máṣe bẹ̀rù."}],"end":49.54}]}