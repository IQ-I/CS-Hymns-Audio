{"v":1,"coll":"y","num":354,"id":"hymn_354","title":"F'AWON Ijo ti nsimi","duration":290.144,"voices":{"male":{"file":"y-354-male.m4a","bytes":2131239,"sha256":"3348fc68d1714a33653ca8a4c7822e00e7011e3beaf4308ef73fa93f325575d7","duration":290.2},"female":{"file":"y-354-female.m4a","bytes":2232233,"sha256":"2ecbe3567064a99e397c3f0a0d25664985d6115e59bdbc69d444e61b3982fef5","duration":290.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.031,"text":"F'AWON Ijo ti nsimi","marked":"F'àwọn Ìjọ ti ńsimi"},{"start":2.411,"end":3.708,"text":"Awa ijo t'aiye","marked":"Àwa ìjọ t'áiye"},{"start":4.088,"end":5.365,"text":"A f'iyin gbogbo fun o","marked":"A f'ìyìn gbogbo fún ọ"},{"start":5.745,"end":6.973,"text":"Jesu olubukun","marked":"Jésù Olùbùkún"},{"start":7.353,"end":9.041,"text":"Oluwa, o ti segun","marked":"Olúwa, ó ti ṣẹ́gun"},{"start":9.421,"end":10.568,"text":"Ki nwon ba le segun","marked":"Kí nwọn bá lè ṣẹ́gun"},{"start":10.948,"end":12.084,"text":"'Mole ade ogo won","marked":"'Mọ́lẹ̀ adé ògo wọn"},{"start":12.464,"end":13.778,"text":"Lat'odo re wa ni.","marked":"Lát'ọ̀dọ̀ rẹ̀ wá ni."}],"end":13.778},{"key":"2","start":14.728,"lines":[{"start":14.728,"end":15.902,"text":"A yin o fun 'ranse re","marked":"A yìn ọ́ fún 'ránṣẹ́ rẹ"},{"start":16.282,"end":17.294,"text":"Ti o ko j'ipe re","marked":"Tí o kò j'ìpè rẹ"},{"start":17.674,"end":18.839,"text":"T'o mu arakunrin re,","marked":"T'ó mú arákùnrin rẹ̀"},{"start":19.219,"end":20.73,"text":"Wa, lati ri Kristi","marked":"Wá, láti rí Kristi"},{"start":21.11,"end":22.236,"text":"Pese okan wa sile,","marked":"Pèsè ọkàn wa sílẹ̀"},{"start":22.616,"end":23.829,"text":"K'a s'ona lodun yi,","marked":"K'á s'ọ́nà lọ́dún yí"},{"start":24.209,"end":25.836,"text":"K'a m'awon ara wa wa","marked":"K'á ḿ'àwọn ará wa wá"},{"start":26.216,"end":27.468,"text":"Lati ri bibo Re.","marked":"Láti rí bíbọ̀ Rẹ."}],"end":27.468},{"key":"3","start":28.418,"lines":[{"start":28.418,"end":30.034,"text":"A yin O, fun 'ranse Re","marked":"A yìn Ọ́, fún 'ránṣẹ́ Rẹ"},{"start":30.414,"end":31.695,"text":"T'isiyemeji re,","marked":"T'ìṣiyèméjì rẹ̀"},{"start":32.075,"end":33.802,"text":"F'ese 'gbagbo wa mule","marked":"F'ẹsẹ̀ 'gbàgbọ́ wa múlẹ̀"},{"start":34.182,"end":35.398,"text":"T'o so fi 'fe Re han","marked":"T'ó sọ fi 'fẹ́ Rẹ hàn"},{"start":35.778,"end":37.287,"text":"Oluwa, f 'alafia","marked":"Olúwa, f 'àlàáfíà"},{"start":37.667,"end":38.828,"text":"F'awon ti nreti Re","marked":"F'àwọn tí ńrètí Rẹ"},{"start":39.208,"end":40.919,"text":"Jek' a mo O lotito","marked":"Jek' á mọ Ọ lótìtọ́"},{"start":41.299,"end":42.918,"text":"L'enia at' Olorun.","marked":"L'enia àt' Ọlọ́run."}],"end":42.918},{"key":"4","start":43.868,"lines":[{"start":43.868,"end":45.652,"text":"A yin O, fun 'ranse Re,","marked":"A yìn Ọ́, fún 'ránṣẹ́ Rẹ"},{"start":46.032,"end":47.236,"text":"Ajeriku 'kini","marked":"Ajẹ́ríkù 'kíní"},{"start":47.616,"end":49.131,"text":"Eni, ninu wahala","marked":"Ẹni, nínú wàhálà"},{"start":49.511,"end":50.75,"text":"T'o nkepe Olorun","marked":"T'ó nkepe Ọlọ́run"},{"start":51.13,"end":52.557,"text":"Oluwa, b'o ba kan wa,","marked":"Olúwa, b'ó bá kàn wá"},{"start":52.937,"end":54.141,"text":"Lati jiya fun O","marked":"Láti jìyà fún Ọ"},{"start":54.521,"end":57.016,"text":"L'aiye, je k'a jeri Re,","marked":"L'aiye, jẹ k'á jẹ́ri Rẹ"},{"start":57.396,"end":59.463,"text":"L'orun, je k'a gb'ade.","marked":"L'ọ́run, jẹ́ k'á gb'adé."}],"end":59.463},{"key":"5","start":60.413,"lines":[{"start":60.413,"end":61.903,"text":"A yin O, fun 'ranse Re,","marked":"A yìn Ọ́, fún 'ránṣẹ́ Rẹ"},{"start":62.283,"end":63.469,"text":"L'erekusu Patmo","marked":"L'erékùṣù Patmo"},{"start":63.849,"end":65.561,"text":"A yin O, f'eri toto","marked":"A yìn Ọ́, f'ẹ̀rí tótó"},{"start":65.941,"end":66.955,"text":"Ti o je nipa Re","marked":"Tí ó jẹ́ nípa Rẹ"},{"start":67.335,"end":68.626,"text":"A yin O fun iran na","marked":"A yìn Ọ́ fún ìran ná"},{"start":69.006,"end":70.101,"text":"Ti o fi han fun wa","marked":"Tí ó fi hàn fún wa"},{"start":70.481,"end":71.793,"text":"A o fi suru duro","marked":"A ó fi ṣùrù dúró"},{"start":72.173,"end":73.654,"text":"K'a le ka wa mo won.","marked":"K'á lè kà wá mọ́ wọn."}],"end":73.654},{"key":"6","start":74.604,"lines":[{"start":74.604,"end":76.425,"text":"A yin O, f'awon ewe","marked":"A yìn Ọ́, f'àwọn èwe"},{"start":76.805,"end":77.978,"text":"Ajeriku mimo","marked":"Ajẹ́ríkù mímọ́́"},{"start":78.358,"end":79.136,"text":"A si mimo","marked":"A ṣí mímọ́́"},{"start":79.516,"end":80.77,"text":"A si won l'owo ogun","marked":"A ṣí wọn l'ọwọ́ ogun"},{"start":81.15,"end":82.35,"text":"Lo sibi isimi","marked":"Lọ síbi ìsimi"},{"start":82.73,"end":84.881,"text":"Rakelieli, ma sokun mo","marked":"Rákélíẹ́lì, má ṣókùn mọ́"},{"start":85.261,"end":86.323,"text":"Nwon bo lowo 'rora","marked":"Nwọ̀n bọ́ lọ́wọ́ 'rora"},{"start":86.703,"end":88.195,"text":"F'okan ailetan fun wa","marked":"F'ọkàn àìlètàn fún wa"},{"start":88.575,"end":89.946,"text":"K'a gb'ade bi tiwon.","marked":"K'á gb'adé bí tiwọn."}],"end":89.946},{"key":"7","start":90.896,"lines":[{"start":90.896,"end":92.6,"text":"A yin O, fun imole","marked":"A yìn Ọ́, fún ìmọ́lẹ̀̀"},{"start":92.98,"end":94.367,"text":"At'ohun lat'orun","marked":"Àt'ọ̀hún lát'ọ̀run"},{"start":94.747,"end":96.602,"text":"A si yin O, fun iran","marked":"A sì yìn Ọ́, fún ìran"},{"start":96.982,"end":98.171,"text":"Ti abinuku ri","marked":"Ti abínúkú rí"},{"start":98.551,"end":99.911,"text":"Ati fun 'yipada re","marked":"Àti fún 'yípadà rẹ́"},{"start":100.291,"end":101.307,"text":"A fi ogo fun O","marked":"A fi ògo fún Ọ"},{"start":101.687,"end":103.304,"text":"Jo, tan ina Emi Re","marked":"Jọ, tan iná Ẹ̀mí Rẹ"},{"start":103.684,"end":104.905,"text":"Sinu okunkun wa.","marked":"Sínú òkùnkùn wa."}],"end":104.905},{"key":"8","start":105.855,"lines":[{"start":105.855,"end":107.295,"text":"Oluwa, lwo t'o wa","marked":"Olúwa, lwo t'ó wà"},{"start":107.675,"end":108.782,"text":"Pel'awon t'o pejo","marked":"Pel'awon t'ó péjọ"},{"start":109.162,"end":110.433,"text":"lwo t'o yan Mattia","marked":"lwo t'ó yan Mattia"},{"start":110.813,"end":112.126,"text":"Lati ropo Juda","marked":"Láti rọ́pò Júdà"},{"start":112.506,"end":114.538,"text":"A'mbe O, gba Ijo Re","marked":"A'mbe O, gba Ìjọ Rẹ"},{"start":114.918,"end":115.98,"text":"Lowo eke woli","marked":"Lọ́wọ́ èké wòlí"},{"start":116.36,"end":118.168,"text":"Rant'ileri Re, Jesu","marked":"Rant'ìlérí Rẹ̀, Jésù"},{"start":118.548,"end":119.795,"text":"Pelu 'jo Re dopin.","marked":"Pẹ̀lú 'jọ Rẹ dópin."}],"end":119.795},{"key":"9","start":120.745,"lines":[{"start":120.745,"end":121.973,"text":"A yin O fun 'ranse Re,","marked":"A yìn Ọ́ fún 'ránṣẹ́ Rẹ"},{"start":122.353,"end":123.402,"text":"T'lwo f'agbara fun","marked":"T'lwọ f'ágbára fún"},{"start":123.782,"end":124.793,"text":"Enit' ihinrere Re,","marked":"Enit' ìhìnrere Rẹ̀"},{"start":125.173,"end":126.295,"text":"Mu orin 'segun dun","marked":"Mú orin 'ṣẹ́gun dùn"},{"start":126.675,"end":128.293,"text":"Ati n'nu ailera wa,","marked":"Àti ń'nú àìlera wa"},{"start":128.673,"end":129.732,"text":"Jo je agbara wa","marked":"Jọ jẹ́ agbára wa"},{"start":130.112,"end":131.363,"text":"Je ka s'eso ninu Re,","marked":"Jẹ́ ká s'èso nínú Rẹ̀"},{"start":131.743,"end":132.813,"text":"lwo Ajara wa.","marked":"lwo Àjàrà wa."}],"end":132.813},{"key":"10","start":133.763,"lines":[{"start":133.763,"end":134.933,"text":"A yin O fun 'ranse Re,","marked":"A yìn Ọ́ fún 'ránṣẹ́ Rẹ"},{"start":135.313,"end":136.333,"text":"Filippi amona","marked":"Filippi amọ̀nà"},{"start":136.713,"end":137.99,"text":"Ati f'arakonrin Re,","marked":"Àti f'arakonrin Rẹ"},{"start":138.37,"end":140.357,"text":"Se wa l'arakorin","marked":"Ṣe wá l'arakorin"},{"start":140.737,"end":142.267,"text":"Masai je k'a le mo O,","marked":"Masai jẹ k'á lè mọ̀ Ọ́"},{"start":142.647,"end":144.065,"text":"Ona, lye, Ooto","marked":"Ọ̀nà, lye, Òótọ́"},{"start":144.445,"end":145.89,"text":"K'a doju ko idanwo","marked":"K'á dojú kọ ìdánwò"},{"start":146.27,"end":147.569,"text":"Titi ao fi segun.","marked":"Títí aó fi ṣẹ́gun."}],"end":147.569},{"key":"11","start":148.519,"lines":[{"start":148.519,"end":150.455,"text":"A yin O, fun Barnaba,","marked":"A yìn Ọ́, fún Barnaba"},{"start":150.835,"end":152.078,"text":"Eni't ife re mu","marked":"Ẹni't ìfẹ́ rẹ̀ mú"},{"start":152.458,"end":153.88,"text":"K'o ko 'hun aiye sile","marked":"K'ó kò 'hun aiye sílẹ̀"},{"start":154.26,"end":155.377,"text":"K'o wa ohun orun","marked":"K'ó wá ohun ọ̀run"},{"start":155.757,"end":157.685,"text":"Bi aiye ti n gbile si,","marked":"Bí aiye ti ń gbilẹ̀ sí"},{"start":158.065,"end":159.317,"text":"Ran emi Re si wa","marked":"Rán ẹ̀mí Rẹ sí wa"},{"start":159.697,"end":160.735,"text":"Ki itunu Re toto","marked":"Kí ìtùnú Rẹ̀ tọ́tọ́"},{"start":161.115,"end":162.334,"text":"Tan bo gbogbo aiye.","marked":"Tàn bo gbogbo aiye."}],"end":162.334},{"key":"12","start":163.284,"lines":[{"start":163.284,"end":164.768,"text":"A yin O f'Onibaptis,","marked":"A yìn Ọ́ f'Onibaptis"},{"start":165.148,"end":165.995,"text":"Asaju Oluwa","marked":"Aṣájú Olúwa"},{"start":166.375,"end":167.579,"text":"Elija toto ni 'se","marked":"Èlíjà tótó ni 'se"},{"start":167.959,"end":169.366,"text":"Lati tun ona se","marked":"Láti tún ọ̀nà ṣe"},{"start":169.746,"end":171.222,"text":"Woli to ga julo ni","marked":"Wòlí tó ga jùlọ ni"},{"start":171.602,"end":172.781,"text":"O ri owuro Re","marked":"Ó rí òwúrọ̀ Rẹ"},{"start":173.161,"end":174.521,"text":"Se wa l'alabukun fun,","marked":"Ṣé wá l'àlàbùkún fún"},{"start":174.901,"end":176.029,"text":"Ti nreti ojo re.","marked":"Ti nrètí ọjọ́ rẹ."}],"end":176.029},{"key":"13","start":176.979,"lines":[{"start":176.979,"end":178.535,"text":"A yin O, fun'ranse Re;","marked":"A yìn Ọ́, fún'ránṣẹ́ Rẹ"},{"start":178.915,"end":180.055,"text":"Ogboiya ninu won","marked":"Ògbòìyà nínú wọn"},{"start":180.435,"end":181.815,"text":"O subu nigba meta","marked":"Ó ṣubú nígbà mẹ́ta"},{"start":182.195,"end":183.173,"text":"O ronupiwada","marked":"Ó ronúpìwàdà"},{"start":183.553,"end":184.477,"text":"Pelu awon alufa","marked":"Pẹ̀lú àwọn àlùfà"},{"start":184.857,"end":186.134,"text":"Lati toju agbo","marked":"Láti tọ́jú agbo"},{"start":186.514,"end":187.822,"text":"Si fun won ni igboiya","marked":"Sì fún wọn ní igboiya"},{"start":188.202,"end":189.38,"text":"At'itara pelu.","marked":"Àt'ìtara pẹ̀lú."}],"end":189.38},{"key":"14","start":190.33,"lines":[{"start":190.33,"end":191.761,"text":"A yin O, fun 'ranse re","marked":"A yìn Ọ́, fún 'ránṣẹ́ rẹ"},{"start":192.141,"end":193.616,"text":"Eniti Herod pa","marked":"Ẹniti Herod pa"},{"start":193.996,"end":195.23,"text":"O mu ago iya Re","marked":"Ó mú àgọ́ ìyá Rẹ̀"},{"start":195.61,"end":196.782,"text":"O mu oro Re se","marked":"Ó mú ọ̀rọ̀ Rẹ̀ ṣẹ"},{"start":197.162,"end":198.412,"text":"K'a ko iwara sile","marked":"K'á kọ ìwàrà sílẹ̀"},{"start":198.792,"end":200.075,"text":"K'a fi suru duro","marked":"K'á fi ṣùrù dúró"},{"start":200.455,"end":201.85,"text":"K'a ka iya si ayo","marked":"K'á ka ìyà sí ayọ̀"},{"start":202.23,"end":203.437,"text":"B'O ba fa we mo O.","marked":"B'ó bá fà wé mọ́ O."}],"end":203.437},{"key":"15","start":204.387,"lines":[{"start":204.387,"end":205.867,"text":"A yin O, fun 'ranse Re","marked":"A yìn Ọ́, fún 'ránṣẹ́ Rẹ"},{"start":206.247,"end":207.401,"text":"Eni oloto ni","marked":"Ẹni ọlọ́tọ̀ ni"},{"start":207.781,"end":208.854,"text":"Enit'oju Re ti ri","marked":"Enit'oju Rẹ ti ri"},{"start":209.234,"end":210.466,"text":"Labe 'gi opoto","marked":"Lábẹ́ 'gi ọ̀pọ̀tọ́"},{"start":210.846,"end":212.151,"text":"Jo, se wa l'ailetan","marked":"Jó, ṣe wá l'àìlẹ́tàn"},{"start":212.531,"end":213.821,"text":"lsraeli toto","marked":"lsraeli tọ́tọ́"},{"start":214.201,"end":215.435,"text":"Ki O le ma ba wa gbe","marked":"Kí Ó lè má bá wa gbé"},{"start":215.815,"end":217.071,"text":"K'O ma bo okan wa.","marked":"K'ó má bo ọkàn wa."}],"end":217.071},{"key":"16","start":218.021,"lines":[{"start":218.021,"end":219.625,"text":"A yin O, fun'ranse re,","marked":"A yìn Ọ́, fún'ránṣẹ́ rẹ"},{"start":220.005,"end":221.069,"text":"T'o so ti ibi Re;","marked":"T'ó sọ ti ibi Rẹ"},{"start":221.449,"end":222.674,"text":"To ko'hun aiye sile","marked":"Tó ko'hun aiye sílẹ̀"},{"start":223.054,"end":224.199,"text":"T'o yan ona iye","marked":"T'ó yan ọ̀nà ìyè"},{"start":224.579,"end":226.172,"text":"Jo, da okan wa nide","marked":"Jọ, dá ọkàn wa nídè"},{"start":226.552,"end":227.556,"text":"Lowo ife owo","marked":"Lọ́wọ́ ìfẹ́ owó"},{"start":227.936,"end":229.269,"text":"Je ka le je ipe Re","marked":"Jẹ́ ká lè jẹ́ ìpè Rẹ"},{"start":229.649,"end":231.155,"text":"K'a nde ka tele O.","marked":"K'á ńde ká tẹ̀lé O."}],"end":231.155},{"key":"17","start":232.105,"lines":[{"start":232.105,"end":234.084,"text":"A yin O, f'onisegun","marked":"A yìn Ọ́, f'oníṣègùn"},{"start":234.464,"end":235.283,"text":"Ti ihinrere re","marked":"Ti ìhìnrere rẹ"},{"start":235.663,"end":237.179,"text":"Fi O han b'Onisegun","marked":"Fi Ọ́ han b'Oníṣègùn"},{"start":237.559,"end":238.568,"text":"At'Abanidaro","marked":"Àt'Àbánidárò"},{"start":238.948,"end":240.562,"text":"Jo, f'ororo iwosan","marked":"Jo, f'òròrò ìwòsàn"},{"start":240.942,"end":242.1,"text":"Si okan gbogbo wa,","marked":"Sí ọkàn gbogbo wa"},{"start":242.48,"end":243.896,"text":"At' ikunra 'yebiye","marked":"Àt' ìkunra 'yebíye"},{"start":244.276,"end":245.498,"text":"Kun wa nigbagbogbo.","marked":"Kún wa nígbàgbọ́gbò."}],"end":245.498},{"key":"18","start":246.448,"lines":[{"start":246.448,"end":247.563,"text":"F'awon iranse Re yi","marked":"F'àwọn ìránṣẹ́ Rẹ yí"},{"start":247.943,"end":249.089,"text":"A yin O, Oluwa","marked":"A yìn Ọ́, Olúwa"},{"start":249.469,"end":250.877,"text":"Ife kanna l'o mu won","marked":"Ìfẹ́ kanná l'ó mú wọn"},{"start":251.257,"end":252.513,"text":"Lati gb'ona rnimo","marked":"Láti gb'ọ́nà rnimo"},{"start":252.893,"end":253.946,"text":"Awa iba le jo won","marked":"Àwa ibà lè jọ wọ́n"},{"start":254.326,"end":255.662,"text":"Lati gbe Jesu ga","marked":"Láti gbé Jésù ga"},{"start":256.042,"end":257.302,"text":"Ki ife so wa sokan","marked":"Kí ìfẹ́ sọ wá sọ́kàn"},{"start":257.682,"end":258.945,"text":"K'a de ibi isimi.","marked":"K'á dé ibi ìsimi."}],"end":258.945},{"key":"19","start":259.895,"lines":[{"start":259.895,"end":261.994,"text":"Apostle, Woli, Martyr","marked":"Apostle, Wòlí, Martyr"},{"start":262.374,"end":263.35,"text":"Awon egbe mimo","marked":"Àwọn ẹgbẹ́ mímọ́́"},{"start":263.73,"end":265.169,"text":"Nwon ko d'ekun orin won","marked":"Nwọn kò d'ẹkùn orin wọn"},{"start":265.549,"end":266.461,"text":"Nwon wo aso ala","marked":"Nwọ̀n wọ aṣọ àlà"},{"start":266.841,"end":268.928,"text":"F'awonyi t'o ti koja","marked":"F'àwọ̀nyí t'ó ti kọjá"},{"start":269.308,"end":270.549,"text":"A yin O, Oluwa;","marked":"A yìn Ọ́, Olúwa"},{"start":270.929,"end":272.698,"text":"A o tele ipase won","marked":"A ò tẹ̀lé ipasẹ̀ wọn"},{"start":273.078,"end":274.252,"text":"A o si ma sin O.","marked":"A ò sì má sin O."}],"end":274.252},{"key":"20","start":275.202,"lines":[{"start":275.202,"end":276.437,"text":"Iyin f'Olorun Baba","marked":"Ìyìn f'Ọlọ́run Bàbá"},{"start":276.817,"end":277.769,"text":"At'Olorun Omo","marked":"Àt'Ọlọ́run Ọmọ"},{"start":278.149,"end":279.171,"text":"Olorun Emi Mimo","marked":"Ọlọ́run Ẹ̀mí Mímọ́́"},{"start":279.551,"end":280.71,"text":"Metalokan Mimo","marked":"Mẹ́talọ́kan Mímọ́́"},{"start":281.09,"end":282.549,"text":"Awon ti a ra pada,","marked":"Àwọn tí a rà padà"},{"start":282.929,"end":284.253,"text":"Y'o teriba fun O","marked":"Y'ó tẹríbà fún Ọ"},{"start":284.633,"end":286.208,"text":"Tire l'ola, at'ipa","marked":"Tìrẹ l'ọ́la, àt'ipa"},{"start":286.588,"end":287.624,"text":"At'ogo, Olorun.","marked":"Àt'ògo, Ọlọ́run."},{"start":288.004,"end":288.594,"text":"Amin.","marked":"Àmín."}],"end":288.594}]}