{"v":1,"coll":"y","num":210,"id":"hymn_210","title":"APATA aiyeraiye","duration":60.744,"voices":{"male":{"file":"y-210-male.m4a","bytes":451687,"sha256":"6da41e6236c188e4b9ac631691ddfc3a8992bb2bd410cdf7cd7f47f51655904e","duration":60.8},"female":{"file":"y-210-female.m4a","bytes":469337,"sha256":"f6ce97b9876edf1ab0e945cea23b66f1379e2a5dca12d5c389009947190af4e5","duration":60.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.657,"text":"APATA aiyeraiye,","marked":"Apata aiyérayé"},{"start":2.037,"end":3.473,"text":"Enit' o mbe lailai,","marked":"Enit' ò ḿbẹ láíláí"},{"start":3.853,"end":5.681,"text":"Nigbakugba t'iji nla,","marked":"Nígbàkugbà t'íjì ńlá"},{"start":6.061,"end":7.064,"text":"'Wo 'bugbe alafia;","marked":"'Wo 'bùgbé àlàáfíà"},{"start":7.444,"end":8.602,"text":"Saju dida aiye yi,","marked":"Ṣájú dídá aiye yí"},{"start":8.982,"end":10.69,"text":"lwo mbe, bakanna,","marked":"lwo ḿbẹ, bákanná"},{"start":11.07,"end":12.89,"text":"Tit' aiaye ainipekun,","marked":"Tít' àìayé àìnípẹ̀kun"},{"start":13.27,"end":14.496,"text":"Aiyeraiye ni 'Wo.","marked":"Aiyérayé ni 'Wo."}],"end":14.496},{"key":"2","start":15.446,"lines":[{"start":15.446,"end":16.891,"text":"OJ' odun wa ri b'oji,","marked":"Òj' ọdún wa rí b'òji"},{"start":17.271,"end":18.8,"text":"T' ohan l'ori oke;","marked":"T' ọ̀hàn l'orí òkè"},{"start":19.18,"end":20.298,"text":"Bi koriko ipado,","marked":"Bí koríko ipadò"},{"start":20.678,"end":22.524,"text":"T' o ru ti o si ku;","marked":"T' ó ru tí ó sì kú"},{"start":22.904,"end":24.944,"text":"Bi ala; tabi b' itan,","marked":"Bí àlá; tàbí b' itan"},{"start":25.324,"end":26.794,"text":"T' enikan nyara pa;","marked":"T' enìkan nyara pa"},{"start":27.174,"end":28.289,"text":"Ogo ti ko ni si mo,","marked":"Ògo tí kò ní sí mọ́"},{"start":28.669,"end":29.901,"text":"Ohun t' o gbo tan ni.","marked":"Ohun t' ò gbọ́ tán ni."}],"end":29.901},{"key":"3","start":30.851,"lines":[{"start":30.851,"end":32.033,"text":"'Wo eniti ti togbe,","marked":"'Wo ẹniti ti tógbẹ́"},{"start":32.413,"end":33.539,"text":"'Mole enit' itan:","marked":"'Mọ́lẹ̀ enit' ìtàn"},{"start":33.919,"end":35.262,"text":"Ko wa bi ao ti ka,","marked":"Kò wá bí aò ti kà"},{"start":35.642,"end":36.761,"text":"Ojo wa koto tan;","marked":"Ọjọ́ wa kòtò tán"},{"start":37.141,"end":38.335,"text":"Jek'anu Re ba le wa,","marked":"Jẹ́k'ánú Rẹ bá lè wà"},{"start":38.715,"end":40.085,"text":"K' ore Re po fun wa;","marked":"K' ọ̀rẹ́ Rẹ pọ̀ fún wa"},{"start":40.465,"end":41.824,"text":"Si jek' Emi Mimo Re,","marked":"Sì jẹ́k' Ẹ̀mí Mímọ́́ Rẹ"},{"start":42.204,"end":43.437,"text":"Mole si okan wa.","marked":"Mọ́lẹ̀ sí ọkàn wa."}],"end":43.437},{"key":"4","start":44.387,"lines":[{"start":44.387,"end":46.641,"text":"Jesu, f' ewa at' ore,","marked":"Jésù, f' ẹwà àt' ọrẹ"},{"start":47.021,"end":48.721,"text":"De'gbagbo wa l' ade;","marked":"De'gbàgbọ́ wa l' adé"},{"start":49.101,"end":50.723,"text":"Tit' ao fi ri O gbangba,","marked":"Tít' aó fi rí Ó gbangba"},{"start":51.103,"end":52.563,"text":"Ninu mole lailia;","marked":"Nínú mọ́lẹ̀ lailia"},{"start":52.943,"end":54.188,"text":"Ayo t'enu ko le so,","marked":"Ayọ̀ t'ẹnu kò lè so"},{"start":54.568,"end":55.528,"text":"Orisun akunya,","marked":"Orísun àkúnya"},{"start":55.908,"end":57.514,"text":"Alafia Ailopin;","marked":"Àlàáfíà Àìlópin"},{"start":57.894,"end":59.194,"text":"Okun ailebute.","marked":"Òkun àìlèbúté."}],"end":59.194}]}