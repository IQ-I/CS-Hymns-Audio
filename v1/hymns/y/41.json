{"v":1,"coll":"y","num":41,"id":"hymn_41","title":"EMI Olorun alaye","duration":45.247,"voices":{"male":{"file":"y-41-male.m4a","bytes":325429,"sha256":"65df5f60467065a544123e2b44eca88b6157894f77eb629beaac0cb55647c875","duration":45.3},"female":{"file":"y-41-female.m4a","bytes":334196,"sha256":"02049ca409766859fcd98e8b0150fe0ecee5076063fd363860ab4becb9d35056","duration":45.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.483,"text":"EMI Olorun alaye","marked":"Ẹ̀mí Ọlọ́run àlàyé"},{"start":1.863,"end":3.459,"text":"N'nu ekun ore-ofe Re,","marked":"N'nú ẹkùn ọrẹ-ọ̀fẹ́ Rẹ"},{"start":3.839,"end":5.581,"text":"Nibit' ese enia ti te","marked":"Níbit' ẹsẹ̀ enia ti tẹ̀"},{"start":5.961,"end":7.689,"text":"Sokake sori iran wa.","marked":"Sọ̀kàkẹ̀ sórí ìran wa."}],"end":7.689},{"key":"2","start":8.639,"lines":[{"start":8.639,"end":10.821,"text":"F'ebun ahon, okan ife,","marked":"F'ẹ̀bùn ahọ́n, ọkàn ìfẹ́"},{"start":11.201,"end":12.518,"text":"Fun wa lati soro 'fe Re,","marked":"Fún wa láti sọ̀rọ̀ 'fẹ́ Rẹ"},{"start":12.898,"end":14.415,"text":"K'ibukun at'agbara Re,","marked":"K'ìbùkún àt'agbára Rẹ̀"},{"start":14.795,"end":16.955,"text":"Ba l'awon t'o ngbo oro na.","marked":"Bá l'àwọn t'ó ńgbọ́ ọ̀rọ̀ ná."}],"end":16.955},{"key":"3","start":17.905,"lines":[{"start":17.905,"end":19.377,"text":"K'okun kase ni bibo Re;","marked":"K'òkun kásẹ̀ ní bíbọ̀ Rẹ"},{"start":19.757,"end":21.271,"text":"Ki darudapo di tito","marked":"Kí dàrúdàpọ̀ di títọ́"},{"start":21.651,"end":23.184,"text":"F'ilera f'okan ailera","marked":"F'ìlera f'ọkàn àìlera"},{"start":23.564,"end":24.987,"text":"Jeki anu bori ibinu.","marked":"Jẹki ãnu borí ìbínú."}],"end":24.987},{"key":"4","start":25.937,"lines":[{"start":25.937,"end":28.029,"text":"Emi Olorun, jo pese","marked":"Ẹ̀mí Ọlọ́run, jọ pésẹ̀"},{"start":28.409,"end":29.949,"text":"Gbogbo aiye fun Oluwa;","marked":"Gbogbo àìyẹ fún Olúwa"},{"start":30.329,"end":31.892,"text":"Mi si won b' afefe oro","marked":"Mí sí wọn b' afẹ́fẹ́ ọrọ̀"},{"start":32.272,"end":34.041,"text":"K'okan okuta le soji.","marked":"K'ókan òkúta lè sọjí."}],"end":34.041},{"key":"5","start":34.991,"lines":[{"start":34.991,"end":36.411,"text":"Baptis' gbogb' orile-ede","marked":"Baptis' gbogb' orílẹ̀-èdè"},{"start":36.791,"end":38.503,"text":"Rohin 'segun Jesu yika","marked":"Rọ́hìn 'ṣẹ́gun Jésù yíká"},{"start":38.883,"end":40.482,"text":"Yin Oruko Jesu logo","marked":"Yin Orúkọ Jésù lógo"},{"start":40.862,"end":42.612,"text":"Tit'araiye yio jewo Re.","marked":"Tít'àràìyé yio jẹ́wọ́ Rẹ."},{"start":42.992,"end":43.697,"text":"Amin.","marked":"Àmín."}],"end":43.697}]}