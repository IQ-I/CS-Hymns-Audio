{"v":1,"coll":"y","num":293,"id":"hymn_293","title":"GBOGBO eje eran","duration":37.285,"voices":{"male":{"file":"y-293-male.m4a","bytes":261028,"sha256":"8b440d1b7f89e4cf4ed217827c55e865644c349ca09d209b1bb191420dc3717f","duration":37.3},"female":{"file":"y-293-female.m4a","bytes":267669,"sha256":"7b87c85f11148d1bc8639386e84bf1a5fcc786bdcd8f83fbde042cbd1e4bf7e9","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.402,"text":"GBOGBO eje eran,","marked":"Gbogbo ẹ̀jẹ̀ ẹran"},{"start":1.782,"end":2.925,"text":"Ti pepe awon Ju","marked":"Ti pẹpẹ àwọn Jù"},{"start":3.305,"end":4.722,"text":"Ko le f'okan l'alafia","marked":"Kò lè f'ọ̀kan l'àlàáfíà"},{"start":5.102,"end":6.604,"text":"Ko le we eri nu.","marked":"Kò lè wẹ ẹ̀rí nù."}],"end":6.604},{"key":"2","start":7.554,"lines":[{"start":7.554,"end":9.172,"text":"Kristi Od'agutan","marked":"Kristi Od'agutan"},{"start":9.552,"end":10.6,"text":"M'ese wa gbogbo lo","marked":"M'ẹsẹ̀ wa gbogbo lọ"},{"start":10.98,"end":12.614,"text":"Ebo t'o ni oruko nla","marked":"Ẹbọ t'ó ní orúkọ ńlá"},{"start":12.994,"end":14.26,"text":"T'o ju eje won lo.","marked":"T'ó ju ẹ̀jẹ́ wọn lọ."}],"end":14.26},{"key":"3","start":15.21,"lines":[{"start":15.21,"end":16.579,"text":"Mo f'igbagbo gb'owo","marked":"Mo f'ìgbàgbọ́́ gb'òwò"},{"start":16.959,"end":18.014,"text":"Le ori Re owon","marked":"Lé orí Rẹ ọ̀wọ́n"},{"start":18.394,"end":19.791,"text":"B'enit'o ronupiwada","marked":"B'enit'ó ronúpìwàdà"},{"start":20.171,"end":21.523,"text":"Mo jewo ese mi.","marked":"Mo jẹ́wọ́ ẹ̀ṣẹ̀ mi."}],"end":21.523},{"key":"4","start":22.473,"lines":[{"start":22.473,"end":23.452,"text":"Okan mi npada wo","marked":"Ọkàn mi ńpadà wọ̀"},{"start":23.832,"end":24.933,"text":"Eru t'lwo ti ru","marked":"Ẹrù t'lwọ ti ru"},{"start":25.313,"end":26.839,"text":"Nigbati a kan O mo 'gi","marked":"Nígbàtí a kan Ò mọ 'gi"},{"start":27.219,"end":28.423,"text":"Ese re wa nibe.","marked":"Ẹ̀ṣẹ̀ rẹ̀ wà níbẹ̀."}],"end":28.423},{"key":"5","start":29.373,"lines":[{"start":29.373,"end":30.619,"text":"Awa nyoi ni 'gbagbo","marked":"Àwa nyoi ní 'gbàgbọ́"},{"start":30.999,"end":32.508,"text":"Bi egun ti kuro","marked":"Bí ègún ti kúrò"},{"start":32.888,"end":34.372,"text":"Awa nyin Odo-agutan,","marked":"Àwa nyin Ọ̀dọ́-àgùtàn"},{"start":34.752,"end":35.735,"text":"A nkorin ife re.","marked":"A ńkọrin ìfẹ́ rẹ̀."}],"end":35.735}]}