{"v":1,"coll":"y","num":446,"id":"hymn_446","title":"ALAFIA, li aiye ese yi?","duration":42.096,"voices":{"male":{"file":"y-446-male.m4a","bytes":298265,"sha256":"1e10c50fa3f73d4636cea1d8e4d31057a47b2f146a1be3a4a81097b763d55326","duration":42.1},"female":{"file":"y-446-female.m4a","bytes":306990,"sha256":"aae1c9f88c0b9ee570405a831c08abb697b0d324ba03c05c931e6d9ff10753bd","duration":42.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.888,"text":"ALAFIA, li aiye ese yi?","marked":"Àlàáfíà, li aiye ẹsẹ yi?"},{"start":3.268,"end":5.596,"text":"Eje Jesu nwipe, Alafia”","marked":"Ẹ̀jẹ̀ Jésù ńwípé, Àlàáfíà"}],"end":5.596},{"key":"2","start":6.546,"lines":[{"start":6.546,"end":8.255,"text":"Alafia ninu opo lala?","marked":"Àlàáfíà nínú ọ̀pọ̀ lálá?"},{"start":8.635,"end":11.231,"text":"Lati se ife Jesu, ni 'simi.","marked":"Láti ṣe ìfẹ́ Jésù, ní 'simi."}],"end":11.231},{"key":"3","start":12.181,"lines":[{"start":12.181,"end":14.568,"text":"Alafia, n'nu igbi 'banuje?","marked":"Àlàáfíà, ń'nú ìgbì 'banújẹ́?"},{"start":14.948,"end":16.981,"text":"L'aiya Jesu ni dake roro wa.","marked":"L'áíyá Jésù ni dákẹ́ rọ́rọ́ wa."}],"end":16.981},{"key":"4","start":17.931,"lines":[{"start":17.931,"end":19.953,"text":"Alafia, gb'ara wa wa l'ajo?","marked":"Àlàáfíà, gb'ara wa wà l'ájọ?"},{"start":20.333,"end":23.025,"text":"Ni 'pamo Jesu, iberu ko si.","marked":"Ní 'pamọ́ Jésù, ìbẹ̀rù kò sí."}],"end":23.025},{"key":"5","start":23.975,"lines":[{"start":23.975,"end":26.775,"text":"Alafia, b'a ko tile m'ola?","marked":"Àlàáfíà, b'á kò tilé ḿ'ọ́la?"},{"start":27.155,"end":28.881,"text":"Sugbon a mo pe Jesu wa lailai.","marked":"Ṣùgbọ́n a mọ̀ pé Jésù wà láíláí."}],"end":28.881},{"key":"6","start":29.831,"lines":[{"start":29.831,"end":31.613,"text":"Alafia, nigb'akoko iku?","marked":"Àlàáfíà, nígb'àkókò ikú?"},{"start":31.993,"end":33.939,"text":"Olugbala wa ti segun iku?","marked":"Olùgbàlà wa ti ṣẹ́gun ikú?"}],"end":33.939},{"key":"7","start":34.889,"lines":[{"start":34.889,"end":37.11,"text":"O to: jakadi aiye fere pin","marked":"Ó tó: jákàdì aiye fẹ́rẹ̀ pin"},{"start":37.49,"end":39.557,"text":"Jesu y'o pe wa s'orun alafia.","marked":"Jésù y'ó pè wá s'ọrun àlàáfíà."},{"start":39.937,"end":40.546,"text":"Amin.","marked":"Àmín."}],"end":40.546}]}