{"v":1,"coll":"y","num":353,"id":"hymn_353","title":"E WA k'a da orin wa po","duration":40.8,"voices":{"male":{"file":"y-353-male.m4a","bytes":290196,"sha256":"88137280b40e845bbf9e47adf5282866b6da9a51905b6c62f3f0cd981183611a","duration":40.8},"female":{"file":"y-353-female.m4a","bytes":297412,"sha256":"a67ac2ba37c36512d69603a979445566657bba34b353aba65c5dca3e5377b54d","duration":40.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.072,"text":"E WA k'a da orin wa po","marked":"Ẹ Wá k'á da orin wa pọ̀"},{"start":2.452,"end":3.401,"text":"Mo t'awon Angeli","marked":"Mo t'àwọn Áńgẹ́lì"},{"start":3.781,"end":5.16,"text":"Egbegberun ni ohun won","marked":"Egbegberun ni ohùn wọn"},{"start":5.54,"end":6.764,"text":"Okan ni ayo won.","marked":"Ọ̀kan ni ayọ̀ wọn."}],"end":6.764},{"key":"2","start":7.714,"lines":[{"start":7.714,"end":10.59,"text":"Nwon nkorin pe, 'Ola-nla ye","marked":"Nwọ̀n ńkọrin pé, 'Ọlá-ńlá yé"},{"start":10.97,"end":12.18,"text":"Od-agutan t'a pa","marked":"Od-àgùtàn t'á pa"},{"start":12.56,"end":14.521,"text":"K'a agberin pe “Ola-nla ye\"","marked":"K'á agbérìn pé Ọlá-ńlá yé"},{"start":14.901,"end":16.059,"text":"Tori O ku fun wa.","marked":"Torí Ó kù fún wa."}],"end":16.059},{"key":"3","start":17.009,"lines":[{"start":17.009,"end":18.715,"text":"Jesu, li O ye lati gba","marked":"Jésù, li Ó yẹ láti gbà"},{"start":19.095,"end":20.255,"text":"Ola at'agbara","marked":"Ọlá àt'ágbára"},{"start":20.635,"end":22.223,"text":"K'iyin t'enu wa ko le gba","marked":"K'ìyìn t'ẹnu wa kò lè gbà"},{"start":22.603,"end":23.806,"text":"Je Tire, Oluwa.","marked":"Jẹ́ Tirẹ̀, Olúwa."}],"end":23.806},{"key":"4","start":24.756,"lines":[{"start":24.756,"end":25.974,"text":"K'awon t'o wa loke orun","marked":"K'àwọn t'ó wà lókè ọ̀run"},{"start":26.354,"end":27.411,"text":"At'ile at'okun","marked":"Àt'ilẹ̀ àt'òkun"},{"start":27.791,"end":29.572,"text":"Dapo lati gb'ogo Re ga","marked":"Dàpọ̀ láti gb'ògo Rẹ̀ ga"},{"start":29.952,"end":30.921,"text":"Jumo yin ola Re.","marked":"Jùmọ̀ yin ọlá Rẹ."}],"end":30.921},{"key":"5","start":31.871,"lines":[{"start":31.871,"end":33.337,"text":"Ki gbogbo eda d'ohun po","marked":"Kí gbogbo ẹ̀dá d'óhùn pọ̀"},{"start":33.717,"end":34.898,"text":"Lati yin oruko","marked":"Láti yin orúkọ"},{"start":35.278,"end":36.515,"text":"Enit' o joko lor'ite","marked":"Enit' ò jókò lór'ìtẹ́"},{"start":36.895,"end":38.304,"text":"Ki nwon si wole fun.","marked":"Kí nwọn sì wọlé fún."},{"start":38.684,"end":39.25,"text":"Amin.","marked":"Àmín."}],"end":39.25}]}