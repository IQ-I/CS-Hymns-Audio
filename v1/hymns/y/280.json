{"v":1,"coll":"y","num":280,"id":"hymn_280","title":"BABA alanu t'o fe wa","duration":24.934,"voices":{"male":{"file":"y-280-male.m4a","bytes":168406,"sha256":"5b23490fd6f301612f48bf9d5befd4728effa0c2c04a5278e087a37452bceca1","duration":25.0},"female":{"file":"y-280-female.m4a","bytes":177187,"sha256":"fa4dc24e25003a120f685a6ed67fb605c67eee728ae8ddc8c779a7b1b4f577cb","duration":25.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.584,"text":"BABA alanu t'o fe wa","marked":"Bàbá alanu t'ó fẹ́ wà"},{"start":1.964,"end":3.144,"text":"Mo gb'okan mi si O","marked":"Mo gb'ọkàn mi sí O"},{"start":3.524,"end":5.241,"text":"lpa Re t'o po l'o gba wa;","marked":"lpa Re t'ó pọ̀ l'ó gbà wá"},{"start":5.621,"end":6.735,"text":"Awa nkorin si O.","marked":"Àwa nkorin sí O."}],"end":6.735},{"key":"2","start":7.685,"lines":[{"start":7.685,"end":9.341,"text":"Tire papa l'awa fe ese","marked":"Tírè pápá l'áwá fẹ́ ẹsẹ̀"},{"start":9.721,"end":10.925,"text":"Gb'okan wa fun ebo;","marked":"Gb'okan wa fún ẹbọ"},{"start":11.305,"end":13.231,"text":"O da wa, o si tun wa bi","marked":"Ó dá wa, ó sì tún wá bí"},{"start":13.611,"end":14.879,"text":"A f' ara wa fun O.","marked":"A f' ara wa fún O."}],"end":14.879},{"key":"3","start":15.829,"lines":[{"start":15.829,"end":17.527,"text":"Emi Mimo, wa sodo mi,","marked":"Ẹ̀mí Mímọ́́, wá sọ́dọ̀ mi"},{"start":17.907,"end":18.897,"text":"F'ife Oluwa han","marked":"F'ìfẹ́ Olúwa hàn"},{"start":19.277,"end":20.801,"text":"Fun mi k'emi k'o le ma rin","marked":"Fún mi k'èmí k'ó lè má rìn"},{"start":21.181,"end":22.453,"text":"N'ife Oluwa mi.","marked":"N'ìfẹ́ Olúwa mi."},{"start":22.833,"end":23.384,"text":"Amin.","marked":"Àmín."}],"end":23.384}]}