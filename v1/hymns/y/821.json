{"v":1,"coll":"y","num":821,"id":"hymn_821","title":"E jeka yin Olugbala","duration":52.251,"voices":{"male":{"file":"y-821-male.m4a","bytes":385206,"sha256":"49caf5545fc2732db3ffa16564aaeea749bd79b73c184a6e2f6527830b8cf7f7","duration":52.3},"female":{"file":"y-821-female.m4a","bytes":398040,"sha256":"001dd7dbbe7b47988db861e93e8b090494cf8bce68fd103d14bc45b835c6bf47","duration":52.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.753,"text":"E jek' a yin Olugbala","marked":"Ẹ jẹ́k' a yin Olùgbàlà"},{"start":2.133,"end":3.47,"text":"T'o da Emi wa si di oni","marked":"T'ó dá Ẹ̀mí wa sí di òní"},{"start":3.85,"end":5.132,"text":"Nitori a ko mo ojo","marked":"Nítorí a kò mọ ọjọ́"},{"start":5.512,"end":7.101,"text":"T'o mbo wa se 'dajo aiye","marked":"T'ó ḿbọ̀ wá ṣe 'dájọ́ aiye"},{"start":7.481,"end":9.371,"text":"Ojo kan mbo gba aiye ba pin","marked":"Ọjọ́ kan ḿbọ́ gba àìyẹ́ bá pín"},{"start":9.751,"end":11.751,"text":"Kerubu yio ko 'rin Alleuyah.","marked":"Kérúbù yìó kò 'rin Alleuyah."}],"end":11.751},{"key":"2","start":12.701,"lines":[{"start":12.701,"end":13.98,"text":"Ojo 'dajo ojo eru","marked":"Ọjọ́ 'dájọ́ ọjọ́ ẹrú"},{"start":14.36,"end":16.458,"text":"Gba Jesu yio ya Agutan Re","marked":"Gba Jésù yìó ya Àgùtàn Rẹ̀"},{"start":16.838,"end":18.334,"text":"Kuro ninu agbo esu","marked":"Kúrò nínú agbo èṣù"},{"start":18.714,"end":21.225,"text":"Gbana ipe nla yio si dun","marked":"Gbaná ìpè ńlá yìó sì dún"},{"start":21.605,"end":23.21,"text":"Gbogbo aiye yio wa si idajo","marked":"Gbogbo aiye yio wá sí ìdájọ́"},{"start":23.59,"end":25.605,"text":"Serafu yio ko 'rin Alleluyah.","marked":"Séráfù yìó kó 'rin Allelúyàh."}],"end":25.605},{"key":"3","start":26.555,"lines":[{"start":26.555,"end":27.887,"text":"Awon elese yio fe sa","marked":"Àwọn ẹlẹ́ṣẹ̀ yio fẹ́ sà"},{"start":28.267,"end":29.516,"text":"Kuro niwaju Olugbala","marked":"Kúrò níwájú Olùgbàlà"},{"start":29.896,"end":31.335,"text":"Sugbon iye ko ni si mo","marked":"Ṣùgbọ́n iye kò ní sí mọ́"},{"start":31.715,"end":33.1,"text":"Nwon yio ke gba mi Oluwa","marked":"Nwọ̀n yio ké gbà mí Olúwa"},{"start":33.48,"end":35.085,"text":"Sugbon ojo anu koja","marked":"Ṣùgbọ́n ọjọ́ anu kọjá"},{"start":35.465,"end":37.299,"text":"Kerubu yio ma ko Alleluyah.","marked":"Kérúbù yìó ma ko Allelúyàh."}],"end":37.299},{"key":"4","start":38.249,"lines":[{"start":38.249,"end":40.369,"text":"Ara mi jek' a gba adura","marked":"Ara mi jẹ́k' a gba àdúrà"},{"start":40.749,"end":41.985,"text":"S'Olorun Metalokan","marked":"S'Ọlọ́run Mẹ́talọ́kan"},{"start":42.365,"end":43.813,"text":"Tori on lo da aiye","marked":"Torí ọ̀n ló da aiye"},{"start":44.193,"end":45.596,"text":"Ati gbogbo eda 'nu re","marked":"Àti gbogbo ẹ̀dá 'nu rẹ̀"},{"start":45.976,"end":47.65,"text":"Yio si ko awon Tire jo","marked":"Yíó sì kó àwọn Tírè jọ"},{"start":48.03,"end":49.695,"text":"Lati ma korin niwaju ite.","marked":"Láti má kọrin níwájú ìtẹ́."},{"start":50.075,"end":50.701,"text":"Amin.","marked":"Àmín."}],"end":50.701}]}