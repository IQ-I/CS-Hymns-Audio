{"v":1,"coll":"y","num":765,"id":"hymn_765","title":"BI agogo ofo ti nlu","duration":34.392,"voices":{"male":{"file":"y-765-male.m4a","bytes":247285,"sha256":"7cf6b7fc781d7254f0afda15ce65e6b48cecb13f9caac0d7d9fd9e3501f2b7f5","duration":34.4},"female":{"file":"y-765-female.m4a","bytes":256956,"sha256":"8bec45fd5adf33bdcedac314bdf58ad1ff2eae887574bf32d066211757b86f49","duration":34.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.935,"text":"BI agogo ofo ti nlu","marked":"Bí agogo òfo ti ńlù"},{"start":2.315,"end":3.859,"text":"Ti npe okan yi koja lo","marked":"Ti ńpẹ́ ọkàn yí kọjá lọ"},{"start":4.239,"end":5.592,"text":"K'olukuluku bi ra re","marked":"K'olúkúlùkù bi rà rẹ́"},{"start":5.972,"end":7.525,"text":"Mo ha se tan b'iku pe mi?","marked":"Mo ha ṣe tán b'ikú pè mí?"}],"end":7.525},{"key":"2","start":8.475,"lines":[{"start":8.475,"end":10.035,"text":"Ki nf'ohun ti mo fe sile","marked":"Kí nf'ohun tí mo fẹ́ sílẹ̀"},{"start":10.415,"end":12.049,"text":"Ki nlo sibi ite 'dajo","marked":"Kí ńlọ síbi ìtẹ́ 'dájọ́"},{"start":12.429,"end":13.762,"text":"Ki ngbohun Onidajo na","marked":"Kí ńgbóhùn Onídàjọ́ ná"},{"start":14.142,"end":15.81,"text":"Ti y'o so ipo mi fun mi.","marked":"Ti y'ó sọ ipò mi fún mi."}],"end":15.81},{"key":"3","start":16.76,"lines":[{"start":16.76,"end":18.225,"text":"Ara mi ha gba b'O wipe","marked":"Ara mi ha gbà b'O wipe"},{"start":18.605,"end":20.257,"text":"'Lo lodo Mi eni-egun","marked":"'Lọ lọ́dọ̀ Mi ẹni-ẹ̀gún"},{"start":20.637,"end":22.269,"text":"Sinu ina t'a ti pese","marked":"Sínú iná t'á ti pèsè"},{"start":22.649,"end":24.314,"text":"Fun Esu ati ogun re.","marked":"Fún Èṣù àti ogún rẹ̀."}],"end":24.314},{"key":"4","start":25.264,"lines":[{"start":25.264,"end":27.218,"text":"Jesu, Oluwa jo gba mi","marked":"Jésù, Olúwa jọ gbà mí"},{"start":27.598,"end":28.983,"text":"Iwo ni mo gbeke mi le","marked":"Ìwọ ni mo gbẹ́kẹ̀ mi lé"},{"start":29.363,"end":30.838,"text":"Ko mi ki nr'ona ewu yi","marked":"Kò mí kí nr'ona ewu yi"},{"start":31.218,"end":32.842,"text":"Ko ni ki mba O gbe titi.","marked":"Kò ní kí ḿbá Ó gbé títí."}],"end":32.842}]}