{"v":1,"coll":"y","num":805,"id":"hymn_805","title":"OLUPAMO gbogbo eda","duration":56.413,"voices":{"male":{"file":"y-805-male.m4a","bytes":402581,"sha256":"c5cf0c644720e9a4a15ea997a4ebd60f45b43f66b53a6d6dde912340d744b10c","duration":56.5},"female":{"file":"y-805-female.m4a","bytes":417411,"sha256":"e4e669f6af2db450bd70338f78cbad59cc538bd210adf19474bde193fdaea724","duration":56.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.469,"text":"OLUPAMO gbogbo eda,","marked":"Olùpamọ́ gbogbo ẹ̀dá"},{"start":1.849,"end":3.217,"text":"Oba Asekan-maku","marked":"Ọba Àṣekàn-makú"},{"start":3.597,"end":5.033,"text":"Awa fi malu ete wa","marked":"Àwa fi màlú ètè wa"},{"start":5.413,"end":6.562,"text":"Rubo ope si O.","marked":"Rúbọ ọpẹ́ sí O."}],"end":6.562},{"key":"2","start":7.512,"lines":[{"start":7.512,"end":9.008,"text":"T'Omode at'agba dupe","marked":"T'Ọmọdé àt'àgbà dúpẹ́"},{"start":9.388,"end":10.761,"text":"F'abo Re loni wa","marked":"F'abo Rẹ lọni wà"},{"start":11.141,"end":13.121,"text":"Fun ike ati ise Re","marked":"Fún ìkẹ́ àti ìṣe Rẹ"},{"start":13.501,"end":14.79,"text":"Lori wa lat'esi.","marked":"Lórí wa lát'èsì."}],"end":14.79},{"key":"3","start":15.74,"lines":[{"start":15.74,"end":17.153,"text":"E bu s'ayo Omo Ogun","marked":"Ẹ bú s'àyò Ọmọ Ogun"},{"start":17.533,"end":18.749,"text":"Ati gbogbo egbe","marked":"Àti gbogbo ègbè"},{"start":19.129,"end":20.665,"text":"Ajodun t'oni t'o ba wa","marked":"Àjọ̀dún t'ọ́ni t'ó bá wà"},{"start":21.045,"end":22.066,"text":"Lorile alaye.","marked":"Lórílẹ̀ àlàyé."}],"end":22.066},{"key":"4","start":23.016,"lines":[{"start":23.016,"end":25.126,"text":"Eleru, Niyi, a be O","marked":"Ẹlẹ́rù, Nìyí, a bẹ O"},{"start":25.506,"end":26.72,"text":"Se wa l'enia Re","marked":"Ṣe wà l'enia Rẹ"},{"start":27.1,"end":28.431,"text":"K'a mase pada lodo Re","marked":"K'á máṣe padà lọ́dọ̀ Rẹ"},{"start":28.811,"end":30.374,"text":"K'a le sin O dopin.","marked":"K'á lè sìn Ó dópin."}],"end":30.374},{"key":"5","start":31.324,"lines":[{"start":31.324,"end":32.766,"text":"Awa si mbebe siwaju","marked":"Àwa ṣì mbẹ̀bẹ̀ síwájú"},{"start":33.146,"end":34.408,"text":"Nin'odun t'a wa yi","marked":"Nín'ọdún t'á wá yí"},{"start":34.788,"end":36.047,"text":"Fi ohun rere kari wa","marked":"Fi ohun rere kárí wa"},{"start":36.427,"end":37.695,"text":"S'aiye wa ni rere.","marked":"S'aiye wa ni rere."}],"end":37.695},{"key":"6","start":38.645,"lines":[{"start":38.645,"end":40.533,"text":"Oba amona gbogb'eda","marked":"Ọba amọ̀nà gbogb'eda"},{"start":40.913,"end":42.155,"text":"S'amona wa dopin","marked":"S'amọ̀nà wa dópin"},{"start":42.535,"end":44.203,"text":"Ma jek' esu ba wa d'egbon","marked":"Má jẹ́k' esu bá wá d'ẹ́gbọ́n"},{"start":44.583,"end":45.924,"text":"Ma jek' a padanu.","marked":"Má jẹ́k' á pàdánù."}],"end":45.924},{"key":"7","start":46.874,"lines":[{"start":46.874,"end":49.483,"text":"B'a ti njosin, t'a si nyin O","marked":"B'á ti njọsìn, t'á sì nyin O"},{"start":49.863,"end":51.129,"text":"L'aginju aiye yi","marked":"L'aginjù aiye yi"},{"start":51.509,"end":53.171,"text":"Se wa ye k'a tun le yin O","marked":"Ṣé wá yé k'á tún lè yìn Ọ́"},{"start":53.551,"end":54.863,"text":"Loke orun pelu.","marked":"Lókè ọ̀run pẹ̀lú."}],"end":54.863}]}