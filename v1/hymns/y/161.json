{"v":1,"coll":"y","num":161,"id":"hymn_161","title":"EMI Orun wa nisisyi","duration":43.293,"voices":{"male":{"file":"y-161-male.m4a","bytes":305415,"sha256":"8d710ae2cc1a7f56aa9753ff1d10b5729ffa5f9e79cd905165a443a8a4559d0e","duration":43.3},"female":{"file":"y-161-female.m4a","bytes":315571,"sha256":"29856afb6386a20b32e3db9b49564053d7d5db0dd603e4341e3ec6f34bd24c45","duration":43.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.781,"text":"EMI Orun wa nisisyi","marked":"Ẹ̀mí Ọ̀run wà nísìsyí"},{"start":2.161,"end":3.682,"text":"Mi si wa b'a ti ngbadura","marked":"Mi sì wá b'á ti ńgbàdúrà"},{"start":4.062,"end":6.068,"text":"Orisun 'ye titun ni O,","marked":"Orísun 'yé titun ni O"},{"start":6.448,"end":8.01,"text":"Imole ojo wa titun.","marked":"Ìmọ́lẹ̀̀ ọjọ́ wa titun."}],"end":8.01},{"key":"2","start":8.96,"lines":[{"start":8.96,"end":10.624,"text":"O mba wa gbe l'ona ara,","marked":"Ó mba wá gbé l'ọ́nà àrà"},{"start":11.004,"end":12.209,"text":"lwo ko si jinna si wa","marked":"lwo kò sì jìnnà sí wa"},{"start":12.589,"end":14.473,"text":"A o gbo ohun Re Nitosi","marked":"A ò gbọ́ ohùn Rẹ̀ Nítòsí"},{"start":14.853,"end":16.235,"text":"Emi Re mb'emi wa soro","marked":"Ẹ̀mí Rẹ̀ mb'emi wa sọ̀rọ̀"}],"end":16.235},{"key":"3","start":17.185,"lines":[{"start":17.185,"end":18.885,"text":"Krist' l'Alagbawi wa loke","marked":"Krist' l'Alágbàwí wà lókè"},{"start":19.265,"end":20.72,"text":"Iwo l'Alagbawi n'nu wa","marked":"Ìwo l'Alágbàwí ń'nú wa"},{"start":21.1,"end":22.355,"text":"Fi otito da wa lebi","marked":"Fi òtítọ́́ dá wa lẹ́bi"},{"start":22.735,"end":24.24,"text":"Gbogbo awawi ese wa.","marked":"Gbogbo àwáwí ẹ̀ṣẹ̀ wa."}],"end":24.24},{"key":"4","start":25.19,"lines":[{"start":25.19,"end":26.605,"text":"Okan mi se aigbagbo po!","marked":"Ọkàn mi ṣe àìgbàgbọ́ pọ̀!"},{"start":26.985,"end":28.48,"text":"Mo m'ona at'Oluto mi;","marked":"Mo m'ọ́nà àt'Olùtọ́ mi"},{"start":28.86,"end":30.755,"text":"Dariji mi, Wo Ore mi","marked":"Dáríjì mi, Wo Ọ̀rẹ́ mi"},{"start":31.135,"end":32.56,"text":"Fun 'yapa mi igbukugba.","marked":"Fún 'yapa mi ìgbùkúgbà."}],"end":32.56},{"key":"5","start":33.51,"lines":[{"start":33.51,"end":35.164,"text":"Pelu mi n'igba ko s'ore","marked":"Pẹ̀lú mi n'igba kò s'ore"},{"start":35.544,"end":36.714,"text":"Ti mo le f'asiri mi han","marked":"Tí mo lè f'àṣírí mi hàn"},{"start":37.094,"end":38.574,"text":"'Gbat'eru Ieke l'okan mi,","marked":"'Gbat'eru lékè l'ọkàn mi"},{"start":38.954,"end":40.825,"text":"Jeki nmo O l'Olutunu.","marked":"Jèkì ńmọ́ Ó l'Olùtùnú."},{"start":41.205,"end":41.743,"text":"Amin.","marked":"Àmín."}],"end":41.743}]}