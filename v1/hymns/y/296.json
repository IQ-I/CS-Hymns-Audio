{"v":1,"coll":"y","num":296,"id":"hymn_296","title":"E gb'ohun ife at'anu","duration":51.629,"voices":{"male":{"file":"y-296-male.m4a","bytes":387631,"sha256":"5dc65639846ff5ef95b4513ad0b709be8ba311b450d5c358a445a9592eebaeec","duration":51.7},"female":{"file":"y-296-female.m4a","bytes":397190,"sha256":"e53050c1583189059b9c9520f3a04cf5cb1389cce498e9d40f7bad0d0ccc6d35","duration":51.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.015,"text":"E gb'ohun ife at'anu","marked":"Ẹ gb'ohun ìfẹ́ àt'ánú"},{"start":2.395,"end":3.734,"text":"Ti ndun l'oke Kalfari!","marked":"Ti ńdún l'òkè Kalfárì!"},{"start":4.114,"end":5.583,"text":"Wo! o san awon apta!","marked":"Wò! ó san àwọn apta!"},{"start":5.963,"end":7.613,"text":"O mi le, o m' orun su!","marked":"Ó mí lé, ó ḿ' ọ̀run sú!"},{"start":7.993,"end":9.883,"text":"'O ti pari \"O ti pari“","marked":"'Ó ti parí Ó ti parí"},{"start":10.263,"end":11.757,"text":"Gbo b'Olugbala ti ke.","marked":"Gbọ́ b'Olùgbàlà ti ké."}],"end":11.757},{"key":"2","start":12.707,"lines":[{"start":12.707,"end":15.089,"text":"'0 ti pari! b'o ti dun to","marked":"'Ó ti parí! b'ó ti dùn tó"},{"start":15.469,"end":16.746,"text":"Ohun t'oro wonyi wi","marked":"Ohun t'ọrọ wọ̀nyí wí"},{"start":17.126,"end":18.388,"text":"lbukun orun l'ainiye","marked":"lbùkún ọ̀run l'àìníye"},{"start":18.768,"end":20.402,"text":"Ti odo Kristi san si wa","marked":"Ti ọ̀dọ̀ Kristi sàn sí wa"},{"start":20.782,"end":22.807,"text":"'O ti pari. “O ti pari\"","marked":"'Ó ti parí. Ó ti parí"},{"start":23.187,"end":24.737,"text":"E ranti oro wonyi.","marked":"Ẹ rántí ọ̀rọ̀ wọ̀nyí."}],"end":24.737},{"key":"3","start":25.687,"lines":[{"start":25.687,"end":26.992,"text":"Ise igbala wa pari,","marked":"Iṣẹ́ ìgbàlà wa parí"},{"start":27.372,"end":28.961,"text":"Jesu ti mu ofin se","marked":"Jésù ti mú òfin ṣẹ"},{"start":29.341,"end":31.203,"text":"O pari, nkan t'Olorun wi","marked":"Ó parí, nkan t'Ọlọ́run wí"},{"start":31.583,"end":33.029,"text":"Awa ki o ka 'ku si","marked":"Àwa kí ó ka 'kù sí"},{"start":33.409,"end":35.349,"text":"'O ti pari, 'O ti pari,","marked":"'Ó ti parí, 'Ó ti parí"},{"start":35.729,"end":37.291,"text":"Elese ipe l'eyi.","marked":"Ẹlẹ́sẹ̀ ìpẹ́ l'èyí."}],"end":37.291},{"key":"4","start":38.241,"lines":[{"start":38.241,"end":40.54,"text":"E tun harpu nyin se, Seraf","marked":"Ẹ tún harpu nyin ṣe, Séráf"},{"start":40.92,"end":42.509,"text":"Larti korin ogo Re","marked":"Larti kọrin ògo Rẹ"},{"start":42.889,"end":44.505,"text":"Ar'aiye at'ara orun","marked":"Ar'aiye àt'ará ọ̀run"},{"start":44.885,"end":46.195,"text":"Yin 'ruko Emmanuel","marked":"Yín 'ruko Emmanuel"},{"start":46.575,"end":48.43,"text":"'O ti pari, 'O ti pari","marked":"'Ó ti parí, 'Ó ti parí"},{"start":48.81,"end":50.08,"text":"Ogo fun Od'aguntan.","marked":"Ògo fún Od'ágùntàn."}],"end":50.08}]}