{"v":1,"coll":"y","num":72,"id":"hymn_72","title":"OBA awon eni Mimo","duration":72.04,"voices":{"male":{"file":"y-72-male.m4a","bytes":509489,"sha256":"3902786d885e5ffc75ecd907011f11e264a54fbfa8f527436d8f67032543999f","duration":72.1},"female":{"file":"y-72-female.m4a","bytes":523303,"sha256":"008a6e07cc18d9a18aceb26374d8d836e065ed68163b113f7d7bfbe08493147b","duration":72.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.337,"text":"OBA awon eni Mimo","marked":"Ọba àwọn ẹni Mímọ́́"},{"start":1.717,"end":3.147,"text":"T'o mo ye awon 'rawo","marked":"T'ó mo yé àwọn 'ràwọ̀"},{"start":3.527,"end":4.925,"text":"Opo enit' Eda gbagbe","marked":"Ọ̀pọ̀ enit' Ẹ̀dá gbàgbé"},{"start":5.305,"end":6.783,"text":"Wa yika ite Re lati.","marked":"Wà yíká ìtẹ́ Rẹ láti."}],"end":6.783},{"key":"CHORUS","start":7.733,"lines":[{"start":7.733,"end":10.643,"text":"Mimo Mimo, Mimo Mimo, Mimo Mimo","marked":"Mímọ́ Mímọ́́, Mímọ́ Mímọ́́, Mímọ́ Mímọ́́"},{"start":11.023,"end":11.973,"text":"Lo ye O.","marked":"Ló yé O."},{"start":12.353,"end":13.806,"text":"Iwo I'a ba ma f' iyin fun","marked":"Ìwọ l'á bá má f' ìyìn fún"},{"start":14.186,"end":15.495,"text":"Olorun, Edumare.","marked":"Ọlọ́run, Èdùmàrè."}],"end":15.495},{"key":"2","start":16.445,"lines":[{"start":16.445,"end":17.724,"text":"Enit' o wa ninu 'mole","marked":"Enit' ò wà nínú 'mọ́lẹ̀"},{"start":18.104,"end":19.248,"text":"T oju enikan ko ri","marked":"T ojú ẹnìkan kò rí"},{"start":19.628,"end":20.836,"text":"Mose ri akehinsi Re","marked":"Mósè rí akehinsi Rẹ̀"},{"start":21.216,"end":22.656,"text":"Oju Mose ran b'orun.","marked":"Ojú Mósè ran b'ọrun."}],"end":22.656},{"key":"3","start":23.606,"lines":[{"start":23.606,"end":25.109,"text":"Mole ti 'kuku aiye bo","marked":"Mọ́lẹ̀ tí 'kúkú aiye bò"},{"start":25.489,"end":27.374,"text":"Ntan mole roro loke","marked":"Ntàn mọ́lẹ̀ roro lókè"},{"start":27.754,"end":29.142,"text":"Nwon je omo alade l'orun","marked":"Nwọ̀n jẹ́ ọmọ aládé l'ọ̀run"},{"start":29.522,"end":31.13,"text":"Eda gbagbe won t'aiye.","marked":"Ẹ̀dà gbàgbé wọn t'aiye."}],"end":31.13},{"key":"4","start":32.08,"lines":[{"start":32.08,"end":33.902,"text":"Lala at'iya won fun O,","marked":"Lalá àt'ìyá wọn fún Ọ"},{"start":34.282,"end":35.909,"text":"Eda ko rohin re mo","marked":"Ẹ̀dá kò ròhìn rẹ̀ mọ́"},{"start":36.289,"end":37.629,"text":"Iwa rere won farasin","marked":"Ìwà rere wọn farasin"},{"start":38.009,"end":39.228,"text":"Oluwa nikan lo mo.","marked":"Olúwa nìkan ló mọ̀."}],"end":39.228},{"key":"5","start":40.178,"lines":[{"start":40.178,"end":42.035,"text":"Nwon farasin fun wa sugbon","marked":"Nwọ̀n farasin fún wa ṣùgbọ́n"},{"start":42.415,"end":43.854,"text":"A ko-won s'iwe iye","marked":"A kò-wọ̀n s'íwé ìye"},{"start":44.234,"end":45.861,"text":"lgbagbo, adura, suru","marked":"lgbàgbọ́, àdúrà, ṣùrù"},{"start":46.241,"end":47.414,"text":"Lala on'jakadi won","marked":"Làlà oń'jàkadì wọn"}],"end":47.414},{"key":"6","start":48.364,"lines":[{"start":48.364,"end":49.875,"text":"Nwon mo isura Re lohun","marked":"Nwọ̀n mọ ìṣúra Rẹ lóhùn"},{"start":50.255,"end":51.416,"text":"Ka wa mo won Oluwa","marked":"Ká wá mọ wọ́n Olúwa"},{"start":51.796,"end":53.118,"text":"Nigba'O ba nsiro oso","marked":"Nígbà'Ó bá ńṣírò ọ̀ṣọ́"},{"start":53.498,"end":55.073,"text":"Ti mbe lara ade Re.","marked":"Ti ḿbẹ lára adé Rẹ."}],"end":55.073},{"key":"7","start":56.023,"lines":[{"start":56.023,"end":57.476,"text":"E wole f'Oba Ologo","marked":"Ẹ wọlé f'Ọba Ológo"},{"start":57.856,"end":59.601,"text":"Serafu e wole fun","marked":"Séráfù ẹ̀ wọlé fún"},{"start":59.981,"end":61.43,"text":"Niwaju ite Jehovah","marked":"Níwájú ìtẹ́ Jehovah"},{"start":61.81,"end":62.9,"text":"Olorun Metalokan.","marked":"Ọlọ́run Mẹ́talọ́kan."}],"end":62.9},{"key":"8","start":63.85,"lines":[{"start":63.85,"end":65.263,"text":"E wole f'Oba Ologo","marked":"Ẹ wọlé f'Ọba Ológo"},{"start":65.643,"end":66.942,"text":"Kerubu e wole fun","marked":"Kérúbù ẹ̀ wọlé fún"},{"start":67.322,"end":69.049,"text":"Niwaju ite Jehovah","marked":"Níwájú ìtẹ́ Jehovah"},{"start":69.429,"end":70.491,"text":"Olorun Metalokan.","marked":"Ọlọ́run Mẹ́talọ́kan."}],"end":70.491}]}