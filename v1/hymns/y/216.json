{"v":1,"coll":"y","num":216,"id":"hymn_216","title":"MA tan, Irawo didan","duration":38.968,"voices":{"male":{"file":"y-216-male.m4a","bytes":275564,"sha256":"ecf67a9d45ac9a6f2fe964921d772f6e29bf91adf6f33b9aa2596acf0c4f0013","duration":39.0},"female":{"file":"y-216-female.m4a","bytes":285719,"sha256":"1404c2a67ba5161d576e3abb121b9edd71831b123e8cf502bb48d1a6b18adb77","duration":39.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.09,"text":"MA tan, Irawo didan,","marked":"Má tàn, Ìràwọ̀ dídán"},{"start":2.47,"end":3.724,"text":"Lat' Ile Re loke;","marked":"Lát' Ilé Rẹ lókè"},{"start":4.104,"end":5.376,"text":"Ma fi 'feran Baba han,","marked":"Má fi 'fẹ́ràn Bàbá hàn"},{"start":5.756,"end":7.028,"text":"N'nu titan didan Re.","marked":"N'nu títàn dídán Rẹ."}],"end":7.028},{"key":"CHORUS","start":7.978,"lines":[{"start":7.978,"end":9.961,"text":"Ma tan, ma tan,","marked":"Má tàn, má tan"},{"start":10.341,"end":11.417,"text":"Iwo lrawo didan,","marked":"Ìwọ lrawo dídán"},{"start":11.797,"end":13.553,"text":"Ma tan, ma tan,","marked":"Má tàn, má tan"},{"start":13.933,"end":15.2,"text":"Iwo Irawo didan.","marked":"Ìwo Ìràwọ̀ dídán."}],"end":15.2},{"key":"2","start":16.15,"lines":[{"start":16.15,"end":17.883,"text":"Ma tan, Irawo Ogo,","marked":"Má tàn, Ìrawọ́ Ògo"},{"start":18.263,"end":19.335,"text":"A gboju wa si O;","marked":"A gbójú wa sí Ọ"},{"start":19.715,"end":20.797,"text":"Li oke awosanma,","marked":"Lí òkè àwọsánmà"},{"start":21.177,"end":22.215,"text":"Awa nri 'tansan Re.","marked":"Àwa ńrí 'tànṣán Rẹ̀."}],"end":22.215},{"key":"3","start":23.165,"lines":[{"start":23.165,"end":25.231,"text":"Ma tan, 'wo ti ki paro,","marked":"Má tàn, 'wò tí kì parọ́"},{"start":25.611,"end":26.785,"text":"Ko si s'amona wa;","marked":"Kò sì s'amọ̀nà wa"},{"start":27.165,"end":28.632,"text":"Sibi t'imole ayo,","marked":"Ṣíbí t'ìmọ́lẹ̀̀ ayò"},{"start":29.012,"end":30.154,"text":"Ti ko lopin gbe wa.","marked":"Tí kò lópin gbé wa."}],"end":30.154},{"key":"4","start":31.104,"lines":[{"start":31.104,"end":32.438,"text":"'Gba ba si d'orun pelu,","marked":"'Gbà bá sì d'ọrun pẹ̀lú"},{"start":32.818,"end":33.872,"text":"Awon t'arapada;","marked":"Àwọn t'àràpadà"},{"start":34.252,"end":35.833,"text":"k'a wa pelu Re n'nu Ogo,","marked":"k'á wà pẹ̀lú Rẹ̀ ń'nú Ògo"},{"start":36.213,"end":37.418,"text":"Le ma tan titi lai.","marked":"Lè má tán títí láì."}],"end":37.418}]}