{"v":1,"coll":"y","num":321,"id":"hymn_321","title":"Lo so fun gbogbo aiye","duration":35.538,"voices":{"male":{"file":"y-321-male.m4a","bytes":249816,"sha256":"b771914a35ed9b79083a9d3b5cf87a661a077824710e45a22075a231258d2e13","duration":35.6},"female":{"file":"y-321-female.m4a","bytes":261663,"sha256":"686492ece580d87a3837a48f9ca38e8bafd30e970c04c55f62df997e51a93a38","duration":35.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.693,"text":"Lo so fun gbogbo aiye","marked":"Lọ sọ fún gbogbo aiye"},{"start":2.073,"end":3.642,"text":"Lo tan ihin ayo yi","marked":"Ló tan ìhìn ayọ̀ yí"},{"start":4.022,"end":6.292,"text":"Eti t'o ba gbo, y'o si,","marked":"Etí t'ó bá gbó, y'ó sì"},{"start":6.672,"end":8.83,"text":"Okan t'o ba gbo, y'o la.","marked":"Ọ̀kan t'ó bá gbó, y'ó là."}],"end":8.83},{"key":"2","start":9.78,"lines":[{"start":9.78,"end":11.122,"text":"Jesu Olugbala wa,","marked":"Jésù Olùgbàlà wa"},{"start":11.502,"end":13.333,"text":"T'a sin, fi 'boji sile","marked":"T'á sìn, fi 'bòji sílẹ̀"},{"start":13.713,"end":14.862,"text":"Olorun gba ebo Re,","marked":"Ọlọ́run gba ẹbọ Rẹ̀"},{"start":15.242,"end":16.463,"text":"Ebo ese araiye.","marked":"Ẹbọ ẹ̀ṣẹ̀ aráiye."}],"end":16.463},{"key":"3","start":17.413,"lines":[{"start":17.413,"end":18.729,"text":"O ji lati ma ku mo","marked":"Ó jí láti má kú mọ́"},{"start":19.109,"end":20.83,"text":"Akobi awon t'o sun","marked":"Àkọ́bí àwọn t'ó sùn"},{"start":21.21,"end":22.863,"text":"Eniti o ba gba a gbo","marked":"Ẹniti ò bá gbà á gbọ́"},{"start":23.243,"end":25.424,"text":"Yio ye, b'o tile ku.","marked":"Yíó yé, b'ó tilẹ̀ kú."}],"end":25.424},{"key":"4","start":26.374,"lines":[{"start":26.374,"end":28.108,"text":"Angeli! eda orun","marked":"Áńgẹ́lì! ẹ̀dá ọ̀run"},{"start":28.488,"end":29.784,"text":"E ba araiye gberin","marked":"Ẹ bá aráiye gberin"},{"start":30.164,"end":31.402,"text":"Jesu OIudande ji,","marked":"Jésù Olùdáǹdè jí"},{"start":31.782,"end":32.963,"text":"Alafia titi lai.","marked":"Àlàáfíà títí láì."},{"start":33.343,"end":33.988,"text":"Amin.","marked":"Àmín."}],"end":33.988}]}