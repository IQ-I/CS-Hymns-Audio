{"v":1,"coll":"y","num":327,"id":"hymn_327","title":"HALLELUYAH Halleluyah!","duration":79.436,"voices":{"male":{"file":"y-327-male.m4a","bytes":581943,"sha256":"a9a86e38401510abcda1d1651742b48425af44867f2cdbf9241e41dc733fa26a","duration":79.5},"female":{"file":"y-327-female.m4a","bytes":607572,"sha256":"25f4a7f9979f77bbec17f98db2387cb4362e544869c88b1c114e71415ac4bb6e","duration":79.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.881,"text":"HALLELUYAH Halleluyah!","marked":"Hallelúyà Hallelúyà!"},{"start":2.261,"end":3.618,"text":"E gbe ohun ayo ga","marked":"Ẹ gbé ohun ayọ̀ ga"},{"start":3.998,"end":5.303,"text":"E ko orin inudidun","marked":"Ẹ kọ orin ìnùdídùn"},{"start":5.683,"end":6.737,"text":"K'e si yin Olorun wa!","marked":"K'ẹ sì yin Ọlọ́run wa!"},{"start":7.117,"end":8.677,"text":"Enit' a kan m'agbelebu","marked":"Enit' á kan m'àgbélébùú"},{"start":9.057,"end":10.448,"text":"T'o jiya fun ese wa","marked":"T'ó jìyà fún ẹ̀ṣẹ̀ wa"},{"start":10.828,"end":12.388,"text":"Jesu Kristi Oba ogo","marked":"Jésù Kristi Ọba ògo"},{"start":12.768,"end":14.122,"text":"Jinde kuro n'nu oku.","marked":"Jíǹde kúrò ń'nú òkú."}],"end":14.122},{"key":"2","start":15.072,"lines":[{"start":15.072,"end":16.274,"text":"lrin idabu se kuro","marked":"lrìn ìdábù ṣe kúrò"},{"start":16.654,"end":18.222,"text":"Kristi ku O si tun ye","marked":"Kristi kú Ó sì tún yé"},{"start":18.602,"end":20.496,"text":"O mu iye ati aiku","marked":"Ó mú ìyè àti àìkú"},{"start":20.876,"end":22.321,"text":"Wa l'oro ajinde Re","marked":"Wà l'ọ̀rọ̀ àjíǹde Rẹ"},{"start":22.701,"end":25.529,"text":"Kristi ti segun, awa segun","marked":"Kristi ti ṣẹ́gun, àwa ṣẹ́gun"},{"start":25.909,"end":27.199,"text":"Nipa agbara nla Re","marked":"Nípa agbára ńlá Rẹ"},{"start":27.579,"end":29.106,"text":"Awa o jinde pelu Re","marked":"Àwa ò jíǹde pẹ̀lú Rẹ"},{"start":29.486,"end":30.983,"text":"A o ba wo 'nu Ogo.","marked":"A ò bá wò 'nú Ògo."}],"end":30.983},{"key":"3","start":31.933,"lines":[{"start":31.933,"end":34.178,"text":"Kristi jinde, akobi ni","marked":"Kristi jíǹde, àkọ́bí ni"},{"start":34.558,"end":35.884,"text":"Ninu awon t'o ti sun","marked":"Nínú àwọn t'ó ti sùn"},{"start":36.264,"end":37.727,"text":"Awon yi ni y'o ji dide","marked":"Àwọn yí ni y'ó jí dìde"},{"start":38.107,"end":39.516,"text":"Ni abo Re ekeji","marked":"Ní àbọ̀ Rẹ èkejì"},{"start":39.896,"end":41.432,"text":"lkore ti won ti pon tan","marked":"lkórè tí wọ́n ti pọ́n tán"},{"start":41.812,"end":42.856,"text":"Nwon nreti Olukore","marked":"Nwọn nrètí Olùkórè"},{"start":43.236,"end":44.542,"text":"Eniti y'o mu won kuro","marked":"Eniti y'ó mú wọn kúrò"},{"start":44.922,"end":45.937,"text":"Ninu isa oku'won.","marked":"Nínú isà òkú'wọn."}],"end":45.937},{"key":"4","start":46.887,"lines":[{"start":46.887,"end":48.528,"text":"Awa jinde pelu Kristi","marked":"Àwa jíǹde pẹ̀lú Kristi"},{"start":48.908,"end":50.391,"text":"To nfun wa l'ohun gbogbo","marked":"Tó ńfun wa l'ohun gbogbo"},{"start":50.771,"end":52.504,"text":"Ojo, iri, ati ogo","marked":"Ọjọ́, ìrì, àti ògo"},{"start":52.884,"end":54.137,"text":"To ntan jade loju Re","marked":"Tó ntàn jáde lójú Rẹ"},{"start":54.517,"end":56.903,"text":"Oluwa, b'a ti wa l'aiye","marked":"Olúwa, b'á ti wà l'aiye"},{"start":57.283,"end":58.359,"text":"Fa okan wa sodo Re","marked":"Fa ọkàn wa sọ́dọ̀ Rẹ"},{"start":58.739,"end":60.053,"text":"K'awon angeli sa wa jo","marked":"K'àwọn áńgẹ́lì sá wa jọ"},{"start":60.433,"end":61.888,"text":"Ki nwon ko wa d'odo Re.","marked":"Kí nwọn kó wá d'ọ̀dọ̀ Rẹ."}],"end":61.888},{"key":"5","start":62.838,"lines":[{"start":62.838,"end":64.514,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":64.894,"end":66.095,"text":"Ogo ni fun Olorun","marked":"Ògo ni fún Ọlọ́run"},{"start":66.475,"end":67.578,"text":"Halleluya f'Olugbala","marked":"Hallelúyà f'Olùgbàlà"},{"start":67.958,"end":69.495,"text":"Enit' O segun iku","marked":"Enit' Ó ṣẹ́gun ikú"},{"start":69.875,"end":71.103,"text":"Halleluya f'Emi Mimo","marked":"Hallelúyà f'Ẹ̀mí Mímọ́́"},{"start":71.483,"end":72.771,"text":"Orisun 'fe iwa mimo","marked":"Orísun 'fẹ́ ìwà mímọ́́"},{"start":73.151,"end":75.068,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":75.448,"end":76.951,"text":"F'Olrun Metalokan.","marked":"F'Olrun Mẹ́talọ́kan."},{"start":77.331,"end":77.886,"text":"Amin.","marked":"Àmín."}],"end":77.886}]}