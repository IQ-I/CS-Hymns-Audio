{"v":1,"coll":"y","num":781,"id":"hymn_781","title":"SURE fun wa loni, Baba wa orun","duration":48.512,"voices":{"male":{"file":"y-781-male.m4a","bytes":348472,"sha256":"14044375ab5fd6ad5defcddcb84062db05cde279e3f5f02e308696e7581e7f96","duration":48.6},"female":{"file":"y-781-female.m4a","bytes":362150,"sha256":"a962f4fe53bd90d98c5222f5a1e845fc3a85aa4c49b8a06fb9028eb28bc7f07b","duration":48.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.677,"text":"SURE fun wa loni, Baba wa orun","marked":"Súre fún wa lónì, Bàbá wa ọ̀run"},{"start":3.057,"end":4.46,"text":"A gboju wa soke si O,","marked":"A gbójú wa sókè sí Ọ"},{"start":4.84,"end":6.336,"text":"Wo to sure f'Abraham","marked":"Wo tó súre f'Abraham"},{"start":6.716,"end":7.598,"text":"baba wa,","marked":"bàbá wa"},{"start":7.978,"end":9.195,"text":"Jowo sure fun wa.","marked":"Jọ̀wọ́ súre fún wa."}],"end":9.195},{"key":"CHORUS","start":10.145,"lines":[{"start":10.145,"end":11.691,"text":"Egbe: Alpha ati Omega","marked":"Alpha àti Omega"},{"start":12.071,"end":13.653,"text":"A si okan wa paya fun O,","marked":"A ṣí ọkàn wa payá fún Ọ"},{"start":14.033,"end":15.366,"text":"Ma je ka lo Iofo.","marked":"Má jẹ́ ká lọ lófo."}],"end":15.366},{"key":"2","start":16.316,"lines":[{"start":16.316,"end":18.037,"text":"Metalokan Mimo Alagbara","marked":"Mẹ́talọ́kan Mímọ́́ Alágbára"},{"start":18.417,"end":19.975,"text":"lfe to jinle julo","marked":"lfẹ́ tó jinlẹ̀ jùlọ"},{"start":20.355,"end":21.819,"text":"Awamaridi Olodumare","marked":"Àwámáridì Olódùmarè"},{"start":22.199,"end":23.485,"text":"Jo f'ire kari wa.","marked":"Jọ f'ire kárí wa."},{"start":23.865,"end":25.17,"text":"Egbe: Alpha ati Omega...","marked":"Alpha àti Omega"}],"end":25.17},{"key":"3","start":26.12,"lines":[{"start":26.12,"end":28.599,"text":"Awa nke pe O loni, Baba wa,","marked":"Àwa ǹkẹ́ pé Ó lọ́ni, Bàbá wa"},{"start":28.979,"end":30.34,"text":"Ma je k'omo Re rahun","marked":"Má jẹ k'ọmọ Rẹ ráhùn"},{"start":30.72,"end":32.239,"text":"Ko sohun ti jamo lehin ekun","marked":"Kò sóhun tí jámọ́ lẹ́hìn ẹkùn"},{"start":32.619,"end":33.801,"text":"Jowo dabobo wa.","marked":"Jọ̀wọ́ dábòbò wa."},{"start":34.181,"end":35.394,"text":"Egbe: Alpha ati Omega...","marked":"Alpha àti Omega"}],"end":35.394},{"key":"4","start":36.344,"lines":[{"start":36.344,"end":38.376,"text":"Wo lo m'omi lat'inu apata","marked":"Wò lọ ḿ'omi lát'inú àpáta"},{"start":38.756,"end":40.238,"text":"F'awon enia Re saju","marked":"F'àwọn enia Rẹ ṣaju"},{"start":40.618,"end":42.564,"text":"O rojo manna pelu lat'orun","marked":"Ó rojọ́ mánnà pẹ̀lú lát'ọ̀run"},{"start":42.944,"end":44.278,"text":"Jowo pese fun wa.","marked":"Jọ̀wọ́ pèsè fún wa."},{"start":44.658,"end":46.116,"text":"Egbe: Alpha ati Omega...","marked":"Alpha àti Omega"},{"start":46.496,"end":46.962,"text":"Amin.","marked":"Àmín."}],"end":46.962}]}