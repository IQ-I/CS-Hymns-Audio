{"v":1,"coll":"y","num":424,"id":"hymn_424","title":"JE ki ilekun aitase","duration":36.069,"voices":{"male":{"file":"y-424-male.m4a","bytes":256622,"sha256":"082f3502c1e5dd162cdd6bef8c4a340430cbf2700ba11bbb98448b6192249e4e","duration":36.1},"female":{"file":"y-424-female.m4a","bytes":266986,"sha256":"cf308166eaf8f05206a1dd7519d44f4059bbfd05b2bccc4e520bc61f4e91abea","duration":36.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.031,"text":"JE ki ilekun aitase","marked":"Jẹ́ kí ilẹ̀kùn aitase"},{"start":2.411,"end":4.451,"text":"Si fun ise wa, Oluwa","marked":"Sì fún iṣẹ́ wa, Olúwa"},{"start":4.831,"end":6.352,"text":"Ti o si ti ki o ti mo","marked":"Tí ó sì ti kí o ti mọ̀"},{"start":6.732,"end":8.577,"text":"Ilekun 'wole oro re.","marked":"Ilẹ̀kùn 'wọlé ọ̀rọ̀ rẹ."}],"end":8.577},{"key":"2","start":9.527,"lines":[{"start":9.527,"end":10.973,"text":"F'owo ina to ete won","marked":"F'ọwọ́ iná tó ètè wọn"},{"start":11.353,"end":13.002,"text":"Ti nfi' lana Re han aiye","marked":"Ti nfi' lànà Rẹ̀ han aiye"},{"start":13.382,"end":14.8,"text":"F'ife mimo si aiya won","marked":"F'ìfẹ́ mímọ́́ sí àìyá wọn"},{"start":15.18,"end":16.598,"text":"Ti Olorun at'enia.","marked":"Ti Ọlọ́run at'enia."}],"end":16.598},{"key":"3","start":17.548,"lines":[{"start":17.548,"end":18.97,"text":"F'itara fun iranse Re,","marked":"F'ìtara fún ìránṣẹ́ Rẹ"},{"start":19.35,"end":21.006,"text":"T'ohun kan ko le mu tutu","marked":"T'ohun kan kò lè mú tutù"},{"start":21.386,"end":22.788,"text":"Bi nwon si ti ntan oro Re","marked":"Bí nwọn sì ti ńtan ọ̀rọ̀ Rẹ"},{"start":23.168,"end":24.941,"text":"Bukun imo at'ise won.","marked":"Bùkún ìmọ̀ àt'iṣẹ́ wọn."}],"end":24.941},{"key":"4","start":25.891,"lines":[{"start":25.891,"end":27.792,"text":"Ran Emi Re lat'oke wa","marked":"Ran Ẹ̀mí Rẹ lát'òkè wá"},{"start":28.172,"end":29.638,"text":"Ma je ki agbara Re pin","marked":"Má jẹ́ kí agbára Rẹ pin"},{"start":30.018,"end":31.754,"text":"Tit'irira o fi pari,","marked":"Tit'irira ò fi parí"},{"start":32.134,"end":33.586,"text":"Ti gbogbo ija o si tan.","marked":"Tí gbogbo ìjà ò sì tán."},{"start":33.966,"end":34.519,"text":"Amin.","marked":"Àmín."}],"end":34.519}]}