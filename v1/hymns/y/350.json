{"v":1,"coll":"y","num":350,"id":"hymn_350","title":"SALEM t'orun ilu 'bukun","duration":58.691,"voices":{"male":{"file":"y-350-male.m4a","bytes":431960,"sha256":"bafcf7cee206db5aa04fc55658a08521d75e6ef0b9e7c6714fcbc31dc1eacc42","duration":58.7},"female":{"file":"y-350-female.m4a","bytes":452935,"sha256":"943950a8794a4fc609e5d92a812f06336987a70c9a30e6740f85c5782744cd58","duration":58.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.898,"text":"SALEM t'orun ilu 'bukun","marked":"Salem t'ọrùn ìlú 'bùkún"},{"start":2.278,"end":3.803,"text":"T'okun fun 'fe at'ayo","marked":"T'okùn fún 'fẹ́ àt'àyò"},{"start":4.183,"end":5.648,"text":"Ti af'okuta aye ko","marked":"Ti àf'òkúta ayé kọ́"},{"start":6.028,"end":7.22,"text":"Ni orun giga loke","marked":"Ní ọ̀run gíga lókè"},{"start":7.6,"end":8.877,"text":"Pel'ogun angeli yika","marked":"Pẹ̀lọ́gùn áńgẹ́lì yíká"},{"start":9.257,"end":10.775,"text":"Ton nsokale b'iyawo.","marked":"Tọ́n ńsọ̀kalẹ̀ b'íyàwó."}],"end":10.775},{"key":"2","start":11.725,"lines":[{"start":11.725,"end":13.018,"text":"Lat'ode orun lohun wa,","marked":"Lát'ọ̀dẹ̀ ọ̀run lohun wà"},{"start":13.398,"end":14.852,"text":"L'o ti wo aso ogo","marked":"L'ó ti wọ aṣọ ògo"},{"start":15.232,"end":16.363,"text":"To ye eniti o fe o","marked":"Tó yé ẹniti ò fẹ́ o"},{"start":16.743,"end":18.197,"text":"Ao sin o f'oko re","marked":"Àò sin ò f'ọkọ rẹ̀"},{"start":18.577,"end":20.334,"text":"Gbogbo ita at'odi re","marked":"Gbogbo ìta àt'òdì rẹ"},{"start":20.714,"end":22.114,"text":"Je kiki oso wura.","marked":"Jẹ́ kìkì ọ̀ṣọ́ wúrà."}],"end":22.114},{"key":"3","start":23.064,"lines":[{"start":23.064,"end":24.708,"text":"Ilekun re ndan fun pearli","marked":"Ilẹ̀kùn rẹ̀ ńdán fún pearli"},{"start":25.088,"end":26.733,"text":"Nwon wa ni sisi titi","marked":"Nwọ̀n wà ní ṣíṣí títí"},{"start":27.113,"end":28.216,"text":"Awon oloto wo 'nu re","marked":"Àwọn ọlọ́tọ̀ wọ̀ 'nu rẹ̀"},{"start":28.596,"end":29.607,"text":"Nip' eje Olugbala","marked":"Nip' ẹ̀jẹ̀ Olùgbàlà"},{"start":29.987,"end":31.531,"text":"Awon to fara da 'ponju","marked":"Àwọn tó fara da 'pọ́njú"},{"start":31.911,"end":33.077,"text":"Tori oruko Jesu.","marked":"Torí orúkọ Jésù."}],"end":33.077},{"key":"4","start":34.027,"lines":[{"start":34.027,"end":35.515,"text":"Wahala at'iponju nla","marked":"Wàhálà àt'ìpọ́njú ńlá"},{"start":35.895,"end":37.513,"text":"L'o s'okuta re lewa","marked":"L'ó s'òkúta rẹ̀ lẹ́wà"},{"start":37.893,"end":39.393,"text":"Jesu papa l'Eni to won,","marked":"Jésù pàpà l'Ẹ́ni tó wọ́n"},{"start":39.773,"end":41.509,"text":"S'ipo ti o gbe dara","marked":"S'ípò tí ó gbé dára"},{"start":41.889,"end":43.371,"text":"Ife inu Re san ni pe","marked":"Ìfẹ́ inú Rẹ̀ sàn ni pé"},{"start":43.751,"end":45.289,"text":"K'a le s'afin Re loso.","marked":"K'á lè s'áfín Rẹ lọ́ṣọ́."}],"end":45.289},{"key":"5","start":46.239,"lines":[{"start":46.239,"end":47.769,"text":"Ogo at'ola fun Baba","marked":"Ògo àt'ọ́lá fún Bàbá"},{"start":48.149,"end":49.431,"text":"Ogo at'ola fun Omo","marked":"Ògo àt'ọ́lá fún Ọmọ"},{"start":49.811,"end":51.551,"text":"Ogo at'ola fun Emi","marked":"Ògo àt'ọ́lá fún Èmi"},{"start":51.931,"end":53.303,"text":"Metalokan titi lai","marked":"Mẹ́talọ́kan títí láì"},{"start":53.683,"end":55.215,"text":"At'aiyeraiye okanna,","marked":"Àt'aiyérayé ọkànnà"},{"start":55.595,"end":57.141,"text":"Bakanna titi aiye.","marked":"Bákanná títí aiye."}],"end":57.141}]}