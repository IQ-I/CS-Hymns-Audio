{"v":1,"coll":"y","num":14,"id":"hymn_14","title":"IFE Re da wa wa si loni","duration":34.671,"voices":{"male":{"file":"y-14-male.m4a","bytes":254088,"sha256":"1f4d91263aa05a22173842fc1ffc8e7e6ed89fd79296b345c97c2ec337411539","duration":34.7},"female":{"file":"y-14-female.m4a","bytes":262425,"sha256":"ea81ad82676986c31285dfd35815cf6cb4dd046db9dae4ce054df0a6cfd5fec1","duration":34.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.655,"text":"IFE Re da wa si loni,","marked":"Ìfẹ́ Rẹ̀ dá wa sí lónì"},{"start":2.035,"end":3.343,"text":"L'are a si dubule;","marked":"L'árẹ̀ á sì dùbúlẹ̀"},{"start":3.723,"end":5.2,"text":"Ma so wa ni dake oru","marked":"Má sọ wá ní dákẹ́ òru"},{"start":5.58,"end":6.95,"text":"K'ota ma yo wa lenu;","marked":"K'ọ̀tá má yọ wá lẹ́nu"},{"start":7.33,"end":9.198,"text":"Jesu, se Olutoju wa,","marked":"Jésù, ṣe Olùtọ́jú wa"},{"start":9.578,"end":11.113,"text":"lwo l'o dun gbekele.","marked":"lwo l'ó dùn gbẹ́kẹ̀lé."}],"end":11.113},{"key":"CHORUS","start":12.063,"lines":[{"start":12.063,"end":13.957,"text":"Halleluyah, Halleluyah","marked":"Hallelúyà, Hallelúyà"},{"start":14.337,"end":15.843,"text":"Ni won nko t'osan t'oru","marked":"Ní wọ́n ńkọ́ t'ọ̀sán t'oru"},{"start":16.223,"end":17.616,"text":"Nibi t'Olugbala ngbe","marked":"Níbi t'Olùgbàlà ngbe"},{"start":17.996,"end":19.533,"text":"Ni won nko t'osan t'orun","marked":"Ní wọ́n ńkọ́ t'ọ̀sán t'ọrun"}],"end":19.533},{"key":"2","start":20.483,"lines":[{"start":20.483,"end":22.19,"text":"Ero at'alejo l'aiye","marked":"Èrò àt'àlejò l'aiye"},{"start":22.57,"end":23.802,"text":"A ngb'arin awon ota!","marked":"A ngb'árín àwọn ọ̀tá!"},{"start":24.182,"end":26.26,"text":"Yo wa, at'ile wa l'ewu","marked":"Yọ wá, àt'ilẹ̀ wa l'ewu"},{"start":26.64,"end":28.042,"text":"L'apa Re ni ka sun si;","marked":"L'apá Rẹ ní ká sùn sí"},{"start":28.422,"end":30.157,"text":"N'ijo iyonu aiye pin,","marked":"N'ijó ìyọnu aiye pin"},{"start":30.537,"end":32.145,"text":"Ka le simi l'odo Re.","marked":"Ká lè símí l'ọ̀dọ̀ Rẹ."},{"start":32.525,"end":33.121,"text":"Amin.","marked":"Àmín."}],"end":33.121}]}