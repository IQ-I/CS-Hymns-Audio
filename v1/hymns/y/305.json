{"v":1,"coll":"y","num":305,"id":"hymn_305","title":"OGO ni fun Jesu","duration":51.167,"voices":{"male":{"file":"y-305-male.m4a","bytes":354696,"sha256":"9fd8900d5acb9b426cf51cd177d6152b3f51e2ef83596cf2f6cb2c2e29a0da83","duration":51.2},"female":{"file":"y-305-female.m4a","bytes":369114,"sha256":"33847f4e3c8919e595f9d17fb3ad5205facdcff935a1638725dbd2051c11eea0","duration":51.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.581,"text":"OGO ni fun Jesu,","marked":"Ògo ni fún Jésù"},{"start":1.961,"end":3.069,"text":"T'o f' irora nla,","marked":"T'ó f' ìrora ńlá"},{"start":3.449,"end":4.404,"text":"Ta eje Re fun mi,","marked":"Ta ẹ̀jẹ́ Rẹ fún mi"},{"start":4.784,"end":5.793,"text":"Lati iha Re.","marked":"Láti ìhà Rẹ."}],"end":5.793},{"key":"2","start":6.743,"lines":[{"start":6.743,"end":7.9,"text":"Mo r' iye ailopin,","marked":"Mo r' ìyè àìlópin"},{"start":8.28,"end":9.234,"text":"Ninu eje na;","marked":"Nínú ẹ̀jẹ́ ná"},{"start":9.614,"end":10.606,"text":"lyonu Re sa po,","marked":"lyonu Rẹ̀ sá pọ̀"},{"start":10.986,"end":11.841,"text":"Ore Re ki tan.","marked":"Ọ̀rẹ́ Rẹ kí tán."}],"end":11.841},{"key":"3","start":12.791,"lines":[{"start":12.791,"end":13.903,"text":"Ope ni titi lai,","marked":"Ọpẹ́ ní títí láì"},{"start":14.283,"end":15.233,"text":"F'eje 'yebiye,","marked":"F'ẹ̀jẹ̀ 'yebíye"},{"start":15.613,"end":17.29,"text":"'T o ra aiye pada,","marked":"'T ó ra aiye padà"},{"start":17.67,"end":18.799,"text":"Kuro n'nu egbe.","marked":"Kúrò ń'nú ẹgbẹ́."}],"end":18.799},{"key":"4","start":19.749,"lines":[{"start":19.749,"end":21.109,"text":"Eje Abel' nkigbe,","marked":"Ẹ̀jẹ̀ Abel' ǹkìgbẹ́"},{"start":21.489,"end":22.671,"text":"Si orun f' esan;","marked":"Sí ọrùn f' esan"},{"start":23.051,"end":24.955,"text":"Sugb' eje Jesu nke,","marked":"Sugb' ẹ̀jẹ̀ Jésù ńkẹ́"},{"start":25.335,"end":26.461,"text":"Fun 'dariji wa.","marked":"Fún 'dáríjì wa."}],"end":26.461},{"key":"5","start":27.411,"lines":[{"start":27.411,"end":28.554,"text":"Nigbati a bu won,","marked":"Nígbàtí a bù wọ́n"},{"start":28.934,"end":29.818,"text":"Okan ese wa,","marked":"Ọkàn ẹsẹ̀ wa"},{"start":30.198,"end":32.212,"text":"Satan, n' idamu re,","marked":"Sátán, n' ìdàmú rẹ̀"},{"start":32.592,"end":33.908,"text":"F'eru sa jade.","marked":"F'ẹrú sá jáde."}],"end":33.908},{"key":"6","start":34.858,"lines":[{"start":34.858,"end":36.419,"text":"Nigbat' aiye ba nyo,","marked":"Nígbàt' aiye bá nyo"},{"start":36.799,"end":37.976,"text":"T'ongbe 'Yin Re ga,","marked":"T'òǹgbè 'Yín Rẹ̀ ga"},{"start":38.356,"end":39.195,"text":"Awon ogun Angel,","marked":"Àwọn ogun Ángel"},{"start":39.575,"end":41.129,"text":"A ma f' ayo gbe.","marked":"A mà f' ayo gbé."}],"end":41.129},{"key":"7","start":42.079,"lines":[{"start":42.079,"end":44.038,"text":"Nje, e gbohun nyin ga,","marked":"Ǹjẹ́, ẹ gbóhun nyin ga"},{"start":44.418,"end":45.451,"text":"Ki iro na dun!","marked":"Kí irọ́ ná dùn!"},{"start":45.831,"end":47.17,"text":"Kikan lohun goro,","marked":"Kíkàn lohun gọ̀rọ̀"},{"start":47.55,"end":48.688,"text":"Yin Od' agutan.","marked":"Yin Od' àgùtàn."},{"start":49.068,"end":49.617,"text":"Amin.","marked":"Àmín."}],"end":49.617}]}