{"v":1,"coll":"y","num":237,"id":"hymn_237","title":"JESU, l'ojo anu yi","duration":42.698,"voices":{"male":{"file":"y-237-male.m4a","bytes":294017,"sha256":"3e88ed357176956be6a4ca6446b26b887e1747d9f74edcf0f3c8bf5bd35eb077","duration":42.7},"female":{"file":"y-237-female.m4a","bytes":299911,"sha256":"12afa44dd0d1e0b57be2f40ca9dd81197807976f55eebc817190920a53ced612","duration":42.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.917,"text":"JESU, l'ojo anu yi","marked":"Jésù, l'ọjọ́ ànú yí"},{"start":2.297,"end":3.484,"text":"Ki akoko to koja","marked":"Kí àkókò tó kọjá"},{"start":3.864,"end":5.158,"text":"A wole ni ekun wa.","marked":"A wọlé ní ẹkún wa."}],"end":5.158},{"key":"2","start":6.108,"lines":[{"start":6.108,"end":7.844,"text":"Oluwa, m'ekun gbon wa","marked":"Olúwa, m'ẹkùn gbọ̀n wa"},{"start":8.224,"end":9.625,"text":"Fi eru kun aiya wa","marked":"Fi èrú kún àìyá wa"},{"start":10.005,"end":11.38,"text":"Ki ojo iku to de.","marked":"Kí ọjọ́ ikú tó dé."}],"end":11.38},{"key":"3","start":12.33,"lines":[{"start":12.33,"end":13.769,"text":"Tu Emi Re s'okan wa","marked":"Tu Ẹ̀mí Rẹ s'ọkàn wa"},{"start":14.149,"end":15.3,"text":"L'enu ona Re la nke","marked":"L'ẹnu ọ̀nà Rẹ la ńkẹ́"},{"start":15.68,"end":17.034,"text":"K'ilekun anu to se.","marked":"K'ilẹ̀kùn ànú tó ṣe."}],"end":17.034},{"key":"4","start":17.984,"lines":[{"start":17.984,"end":19.098,"text":"Tori waiya-ija Re","marked":"Torí wáíyá-ìjà Rẹ"},{"start":19.478,"end":20.829,"text":"Tori ogun-eje Re","marked":"Torí ogun-ẹ̀jẹ̀ Rẹ"},{"start":21.209,"end":22.407,"text":"Tori iku Re fun wa.","marked":"Torí ikú Rẹ̀ fún wa."}],"end":22.407},{"key":"5","start":23.357,"lines":[{"start":23.357,"end":24.751,"text":"Tor'ekun kikoro Re","marked":"Tor'ẹkùn kíkorò Rẹ̀"},{"start":25.131,"end":26.343,"text":"Lori Jerusalemu","marked":"Lórí Jerúsálẹ́mù"},{"start":26.723,"end":28.145,"text":"Ma je ka gan ife Re.","marked":"Má jẹ́ ká gan ìfẹ́ Rẹ."}],"end":28.145},{"key":"6","start":29.095,"lines":[{"start":29.095,"end":30.097,"text":"lwo Onidajo wa","marked":"lwo Onídàjọ́ wa"},{"start":30.477,"end":31.993,"text":"Ghat'oju wa ba ri O","marked":"Ghat'oju wa bá rí O"},{"start":32.373,"end":33.752,"text":"Fun wa n'ipo lodo re.","marked":"Fún wa ń'ipò lọ́dọ̀ rẹ̀."}],"end":33.752},{"key":"7","start":34.702,"lines":[{"start":34.702,"end":35.941,"text":"lfe Re l'a simi le","marked":"lfe Re l'á ṣímí le"},{"start":36.321,"end":38.203,"text":"N'ile wa l'oke l'a o mo","marked":"N'ilẹ̀ wa l'òkè l'á ò mọ́"},{"start":38.583,"end":40.188,"text":"B'ife na ti tobi to.","marked":"B'ife ná ti tóbi tó."},{"start":40.568,"end":41.148,"text":"Amin.","marked":"Àmín."}],"end":41.148}]}