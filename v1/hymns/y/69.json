{"v":1,"coll":"y","num":69,"id":"hymn_69","title":"RAPADA lowo 'ku on ese","duration":44.934,"voices":{"male":{"file":"y-69-male.m4a","bytes":327873,"sha256":"fae3fc3ead853ee389e2147d5b5a3d6eabc09cf3b60355dbd485d153b4125fbe","duration":45.0},"female":{"file":"y-69-female.m4a","bytes":334678,"sha256":"416e221d9c5937c1429ee979a194034dffbb19f9346d81f17d0d46131c99ac66","duration":45.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.791,"text":"RAPADA lowo 'ku on ese","marked":"Rápàdà lowó 'kú ọ́n ẹsẹ̀"},{"start":2.171,"end":3.499,"text":"lrapada n'ile l'ode","marked":"lràpadà n'ilẹ̀ l'ọ̀dẹ̀"},{"start":3.879,"end":5.654,"text":"'Mole titun wo lo to yi!","marked":"'Mọ́lẹ̀ titun wo ló tó yí!"},{"start":6.034,"end":7.868,"text":"Ogo wo Io tan s'okan wa.","marked":"Ògo wo ló tán s'ọkàn wa."}],"end":7.868},{"key":"CHORUS","start":8.818,"lines":[{"start":8.818,"end":10.802,"text":"lrapada! I'orin mi yio je","marked":"lràpadà! l'orin mi yio jẹ́"},{"start":11.182,"end":13.527,"text":"Titi aiye ainipekurn","marked":"Títí aiye ainipekurn"},{"start":13.907,"end":15.443,"text":"Je k'eni 'rapada k'o ko","marked":"Jẹ k'ẹni 'ràpadà k'ó kó"},{"start":15.823,"end":17.249,"text":"Orin iyin si Kristi Oba.","marked":"Orin ìyìn sí Kristi Ọba."}],"end":17.249},{"key":"2","start":18.199,"lines":[{"start":18.199,"end":19.754,"text":"Ogo f'eni t'ao le mo'fe Re","marked":"Ògo f'ẹni t'áò le mọ́'fẹ́ Rẹ"},{"start":20.134,"end":21.922,"text":"To tan'mole s'ona enia,","marked":"Tó tan'mọ́lẹ̀ s'ọ́nà enia"},{"start":22.302,"end":23.96,"text":"B'itansan 'Rawo titun nyo","marked":"B'itansàn 'Rawo titun nyo"},{"start":24.34,"end":25.771,"text":"A gbe rin titun rapada,","marked":"A gbé rìn titun ràpadà"}],"end":25.771},{"key":"3","start":26.721,"lines":[{"start":26.721,"end":28.242,"text":"Bi 'gbi okun ti nru soke","marked":"Bí 'gbi òkun ti ńru sókè"},{"start":28.622,"end":30.213,"text":"Beni gb'orin ayo yio dun","marked":"Bẹ́ni gb'orin ayò yio dùn"},{"start":30.593,"end":31.989,"text":"lfe Jesu jijin b'okun","marked":"lfẹ́ Jésù jíjìn b'ókùn"},{"start":32.369,"end":34.17,"text":"Yio k'eni 'rapada wa le.","marked":"Yío k'ẹni 'ràpadà wá le."}],"end":34.17},{"key":"4","start":35.12,"lines":[{"start":35.12,"end":36.963,"text":"lrapada! gbogbo eda,","marked":"lrapada! gbogbo ẹ̀dá"},{"start":37.343,"end":39.021,"text":"Yo f'ayo m'ore f'Oba wa","marked":"Yọ f'àyò m'ọ̀rẹ́ f'Ọba wa"},{"start":39.401,"end":41.412,"text":"lrapada! gbogbo aiye","marked":"lrapada! gbogbo aiye"},{"start":41.792,"end":43.384,"text":"Yo d'ohun po korin iyin Re","marked":"Yọ d'óhùn pọ̀ kọrin ìyìn Rẹ"}],"end":43.384}]}