{"v":1,"coll":"y","num":815,"id":"hymn_815","title":"OLORUN Alagbara nla","duration":39.278,"voices":{"male":{"file":"y-815-male.m4a","bytes":283183,"sha256":"d8e7a2916c926fb92a0fff39dbd0bcc983e3810923261cf84619382830925aa4","duration":39.3},"female":{"file":"y-815-female.m4a","bytes":296696,"sha256":"0dc862e429126f5a6be125c80db75347121f4fde2d4709383f8600611645ad5c","duration":39.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.505,"text":"OLORUN Alagbara nla","marked":"Ọlọ́run Alágbára ńlá"},{"start":1.885,"end":3.226,"text":"T'O p'ara Egypt run","marked":"T'ó p'ará Egypt run"},{"start":3.606,"end":5.231,"text":"L'eti okun nijokini","marked":"L'etí òkun níjokíni"},{"start":5.611,"end":6.776,"text":"P'agbara Ota mi run.","marked":"P'agbára Ọ̀tá mi rún."}],"end":6.776},{"key":"CHORUS","start":7.726,"lines":[{"start":7.726,"end":8.779,"text":"Jowo gbe mi leke","marked":"Jọ̀wọ́ gbé mi lékè"},{"start":9.159,"end":10.486,"text":"Ma jek'ota bori mi","marked":"Má jẹ́k'ọ̀tá borí mi"},{"start":10.866,"end":13.447,"text":"Segun, gbogbo ota fun mi,","marked":"Ṣẹ́gun, gbogbo ọ̀tá fún mi"},{"start":13.827,"end":14.869,"text":"Gbe mi leke 'danwo.","marked":"Gbé mi lékè 'dánwò."}],"end":14.869},{"key":"2","start":15.819,"lines":[{"start":15.819,"end":18.003,"text":"Jesu, loni mo kepe O,","marked":"Jésù, lọni mo kẹ̀pẹ̀ O"},{"start":18.383,"end":19.514,"text":"Baba mi gbo temi","marked":"Bàbá mi gbọ́ tèmi"},{"start":19.894,"end":22.16,"text":"Segun gbogbo' ogun ti mo ri","marked":"Ṣẹ́gun gbogbo' ogun tí mo rí"},{"start":22.54,"end":24.063,"text":"Mase jeki nseku","marked":"Masẹ̀ jẹkì ńṣekú"},{"start":24.443,"end":25.709,"text":"Mu ki Ifoiya mi lo","marked":"Mú kí Ifòìyá mi lọ"},{"start":26.089,"end":27.779,"text":"F'okan mi bale lat'oni","marked":"F'ọkàn mi balẹ̀ lát'ọ́nì"},{"start":28.159,"end":29.167,"text":"K'ota ma le mi mo.","marked":"K'ọ̀tá mà lè mí mọ́."}],"end":29.167},{"key":"3","start":30.117,"lines":[{"start":30.117,"end":31.636,"text":"Jesu Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":32.016,"end":33.256,"text":"Wo ni mo gbekele","marked":"Wo ni mo gbẹ́kẹ̀lé"},{"start":33.636,"end":35.98,"text":"Lai, ma jeki oju ti mi","marked":"Láì, má jẹ̀kì ojú tì mí"},{"start":36.36,"end":37.728,"text":"Pese fun aini mi.","marked":"Pèsè fún àìní mi."}],"end":37.728}]}