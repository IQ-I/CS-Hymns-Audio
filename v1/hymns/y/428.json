{"v":1,"coll":"y","num":428,"id":"hymn_428","title":"SA wo ite anu!","duration":31.246,"voices":{"male":{"file":"y-428-male.m4a","bytes":219789,"sha256":"701cb26515906a4d50a28b50e737d863a6c81323e4a11bda03b6697521b9e082","duration":31.3},"female":{"file":"y-428-female.m4a","bytes":228169,"sha256":"2d1242864cd909639a7439f8258477a03c21a72e7020b9249268f78ef8ebb0c1","duration":31.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.522,"text":"SA wo ite anu!","marked":"Sá wọ ìtẹ́ ànú!"},{"start":1.902,"end":2.947,"text":"Oro Re pe mi wa,","marked":"Ọ̀rọ̀ Rẹ̀ pè mí wá"},{"start":3.327,"end":4.97,"text":"Nibe Jesu f'oju 're han","marked":"Níbẹ̀ Jésù f'ojú 'rẹ̀ hàn"},{"start":5.35,"end":6.605,"text":"Lati gbo adura.","marked":"Láti gbọ́ àdúrà."}],"end":6.605},{"key":"2","start":7.555,"lines":[{"start":7.555,"end":8.635,"text":"Eje etutu ni,","marked":"Ẹ̀jẹ̀ ètùtù ni"},{"start":9.015,"end":10.133,"text":"Ti a ti ta sile","marked":"Tí a ti ta sílẹ̀"},{"start":10.513,"end":12.112,"text":"Pese ebe t'o le bori","marked":"Pèsè ebè t'ó lè borí"},{"start":12.492,"end":13.915,"text":"F'awon t'o nt'Olorun.","marked":"F'àwọn t'ó nt'Ọlọ́run."}],"end":13.915},{"key":"3","start":14.865,"lines":[{"start":14.865,"end":15.981,"text":"Ife Re je fun mi","marked":"Ìfẹ́ Rẹ jẹ́ fún mi"},{"start":16.361,"end":17.545,"text":"Ju bi mo ti fe lo","marked":"Ju bí mo ti fẹ́ lọ"},{"start":17.925,"end":19.322,"text":"A ma fun enti'o bere","marked":"A ma fún enti'o bẹ̀rẹ̀"},{"start":19.702,"end":20.944,"text":"Ju bi nwon ti nfe Io.","marked":"Ju bí nwọn ti ńfẹ́ lọ."}],"end":20.944},{"key":"4","start":21.894,"lines":[{"start":21.894,"end":23.1,"text":"Fun wa l'aworan Re","marked":"Fún wa l'àwòrán Rẹ̀"},{"start":23.48,"end":24.682,"text":"At'oju rere Re","marked":"At'ojú rere Rẹ"},{"start":25.062,"end":26.954,"text":"Jeki nle sin O nihinyi","marked":"Jèkì ńlẹ̀ sìn Ò níhìnyí"},{"start":27.334,"end":28.674,"text":"Ki mba le ba O gbe.","marked":"Kí ḿbá lè bá Ọ gbé."},{"start":29.054,"end":29.696,"text":"Amin.","marked":"Àmín."}],"end":29.696}]}