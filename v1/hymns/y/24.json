{"v":1,"coll":"y","num":24,"id":"hymn_24","title":"OLUS' AGUTAN mi","duration":35.353,"voices":{"male":{"file":"y-24-male.m4a","bytes":241625,"sha256":"69bc67d1452175e656c3a07430ec22c2c658b8e77482064732ca0fc53fbff84a","duration":35.4},"female":{"file":"y-24-female.m4a","bytes":255025,"sha256":"405ac7d614ccfa58194063ad7eeb2cd4c73d4fefddf32c6a4e65cd33061e7994","duration":35.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.706,"text":"OLUS' AGUTAN mi,","marked":"Olùs' Àgùtàn mi"},{"start":2.086,"end":3.093,"text":"Ma bo mi titi,","marked":"Má bọ̀ mí títí"},{"start":3.473,"end":4.536,"text":"Olus'agutan mi,","marked":"Olùs'ágùtàn mi"},{"start":4.916,"end":6.056,"text":"Ma to ese mi.","marked":"Má tọ́ ẹsẹ̀ mi."}],"end":6.056},{"key":"2","start":7.006,"lines":[{"start":7.006,"end":8.444,"text":"Di mi mu, si to mi,","marked":"Dì mí mú, sì tó mi"},{"start":8.824,"end":9.793,"text":"Ni ona hiha","marked":"Ní ọ̀nà híhá"},{"start":10.173,"end":11.278,"text":"B'O ba wa lodo mi,","marked":"B'ó bá wà lọ́dọ̀ mi"},{"start":11.658,"end":12.589,"text":"Emi ko sina.","marked":"Èmi kò ṣìnà."}],"end":12.589},{"key":"3","start":13.539,"lines":[{"start":13.539,"end":14.639,"text":"Sin mi s'ona orun","marked":"Sin mí s'ọ́nà ọ̀run"},{"start":15.019,"end":15.837,"text":"Ni ojojumo","marked":"Ní ojojumo"},{"start":16.217,"end":17.394,"text":"Ma busi 'gbagbo mi","marked":"Má bùsí 'gbàgbọ́ mi"},{"start":17.774,"end":19.311,"text":"Si mu mi fe O.","marked":"Sì mú mi fẹ́ O."}],"end":19.311},{"key":"4","start":20.261,"lines":[{"start":20.261,"end":21.62,"text":"K'ayo at'alafia","marked":"K'ayo at'àlàáfíà"},{"start":22.0,"end":22.983,"text":"Ti odo Re wa","marked":"Ti ọ̀dọ̀ Rẹ wá"},{"start":23.363,"end":24.392,"text":"K'iye ainipekun","marked":"K'íyè àìnípẹ̀kun"},{"start":24.772,"end":26.22,"text":"Le je ayo mi.","marked":"Lè jẹ́ ayọ̀ mi."}],"end":26.22},{"key":"5","start":27.17,"lines":[{"start":27.17,"end":28.316,"text":"Ma pese okan mi,","marked":"Má pèsè ọkàn mi"},{"start":28.696,"end":29.491,"text":"Ni ojojumo","marked":"Ní ojojumo"},{"start":29.871,"end":31.136,"text":"Si je k'Angeli Re,","marked":"Sì jẹ́ k'Áńgẹ́lì Rẹ"},{"start":31.516,"end":32.813,"text":"Sin mi lo ile.","marked":"Sin mí lọ ilé."},{"start":33.193,"end":33.803,"text":"Amin.","marked":"Àmín."}],"end":33.803}]}