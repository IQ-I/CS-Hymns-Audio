{"v":1,"coll":"y","num":182,"id":"hymn_182","title":"GBO ohun alore","duration":65.768,"voices":{"male":{"file":"y-182-male.m4a","bytes":462932,"sha256":"3dec731153fe99ec3d91039b519a2236044ea40c919d1c08847fc341abe93a32","duration":65.8},"female":{"file":"y-182-female.m4a","bytes":482737,"sha256":"30df30b745ece4e6d72699457df1a1220375e3036e68acef77084fe34911538a","duration":65.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.179,"text":"GBO ohun alore","marked":"Gbọ́ ohun alọ́rẹ́"},{"start":1.559,"end":2.414,"text":"Ji, ara, ji","marked":"Jí, ará, jí"},{"start":2.794,"end":4.123,"text":"Jesu ma fere de","marked":"Jésù mà fẹ́rẹ̀ dé"},{"start":4.503,"end":5.288,"text":"Ji, ara, ji","marked":"Jí, ará, jí"},{"start":5.668,"end":6.805,"text":"Omo oru ni nsun","marked":"Ọmọ òru ní ńsùn"},{"start":7.185,"end":8.468,"text":"Omo imole l'enyin","marked":"Ọmọ ìmọ́lẹ̀̀ l'ẹ́nyín"},{"start":8.848,"end":10.121,"text":"Ti nyin l'ogo didan","marked":"Ti nyin l'ògò dídán"},{"start":10.501,"end":11.267,"text":"Ji, ara ji.","marked":"Jí, ara jí."}],"end":11.267},{"key":"2","start":12.217,"lines":[{"start":12.217,"end":13.922,"text":"So f'egbe t'o ti ji","marked":"Ṣó f'ègbè t'ó ti jí"},{"start":14.302,"end":15.703,"text":"Ara, sora","marked":"Ara, ṣọ́ra"},{"start":16.083,"end":17.312,"text":"Ase Jesu daju","marked":"Àṣẹ Jésù dájú"},{"start":17.692,"end":18.653,"text":"Ara, sora","marked":"Ara, ṣọ́ra"},{"start":19.033,"end":20.15,"text":"Ese b'olusona","marked":"Ẹsẹ̀ b'olusona"},{"start":20.53,"end":21.781,"text":"N'ilekun Oluwa nyin,","marked":"N'ilẹ̀kùn Olúwa nyin"},{"start":22.161,"end":23.188,"text":"Bi o tile pe de,","marked":"Bí ó tilẹ̀ pẹ́ dé"},{"start":23.568,"end":24.686,"text":"Ara, sora.","marked":"Ara, ṣọ́ra."}],"end":24.686},{"key":"3","start":25.636,"lines":[{"start":25.636,"end":26.64,"text":"Gbo ohun Iriju,","marked":"Gbọ́ ohun Ìríjú"},{"start":27.02,"end":28.476,"text":"Ara. sise","marked":"Ara. ṣíṣe"},{"start":28.856,"end":29.844,"text":"Ise na kari wa,","marked":"Iṣẹ́ nà kárí wa"},{"start":30.224,"end":31.134,"text":"Ara sise,","marked":"Ara ṣíṣe"},{"start":31.514,"end":32.461,"text":"Ogba Oluwa wa,","marked":"Ọgbà Olúwa wa"},{"start":32.841,"end":33.971,"text":"Kun fun 'se n'gbagbogbo","marked":"Kún fún 'ṣe ń'gbàgbògbò"},{"start":34.351,"end":35.593,"text":"Y'o si fun wa lere","marked":"Y'ó sì fún wa lérè"},{"start":35.973,"end":36.954,"text":"Ara sise.","marked":"Ara ṣíṣe."}],"end":36.954},{"key":"4","start":37.904,"lines":[{"start":37.904,"end":38.933,"text":"Gb'ohun Oluwa wa,","marked":"Gb'ohun Olúwa wa"},{"start":39.313,"end":40.148,"text":"E gbadura","marked":"Ẹ gbàdúrà"},{"start":40.528,"end":42.119,"text":"B'e fe k' inu Re dun","marked":"B'ẹ fẹ́ k' inú Rẹ dùn"},{"start":42.499,"end":43.393,"text":"E gbadura,","marked":"Ẹ gbàdúrà"},{"start":43.773,"end":44.756,"text":"Ese mu 'beru wa,","marked":"Ẹsẹ̀ mú 'bẹ̀rù wá"},{"start":45.136,"end":46.405,"text":"Alailera si ni wa,","marked":"Aláìlera sì ni wá"},{"start":46.785,"end":47.99,"text":"Ni ijakadi nyin","marked":"Ní ìjàkadì nyin"},{"start":48.37,"end":49.295,"text":"E gbadura.","marked":"Ẹ gbàdúrà."}],"end":49.295},{"key":"5","start":50.245,"lines":[{"start":50.245,"end":51.616,"text":"Ko orin ikehin","marked":"Kọ orin ìkẹhìn"},{"start":51.996,"end":52.952,"text":"Yin, ara, yin","marked":"Yín, ará, yín"},{"start":53.332,"end":54.386,"text":"Mimo ni Oluwa","marked":"Mímọ́́ ni Olúwa"},{"start":54.766,"end":55.737,"text":"Yin, ara, yin","marked":"Yín, ará, yín"},{"start":56.117,"end":57.27,"text":"Kil'o tun ye ahon","marked":"Kil'ó tún yé ahọ́n"},{"start":57.65,"end":59.605,"text":"T'o fere b'angeli korin","marked":"T'ó fẹ́rẹ̀ b'áńgẹ́lì kọrin"},{"start":59.985,"end":61.821,"text":"T'y'o r'Oloru titi","marked":"T'y'ó r'Oloru títí"},{"start":62.201,"end":63.277,"text":"Yin ara, yin.","marked":"Yín ará, yín."},{"start":63.657,"end":64.218,"text":"Amin.","marked":"Àmín."}],"end":64.218}]}