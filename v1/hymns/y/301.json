{"v":1,"coll":"y","num":301,"id":"hymn_301","title":"IFE lo to bayi!","duration":55.306,"voices":{"male":{"file":"y-301-male.m4a","bytes":394277,"sha256":"e5dc798f807f6fa47dd0881b8ea5d9b5845f988d0e6f3bd322cd072d03b4f6d3","duration":55.4},"female":{"file":"y-301-female.m4a","bytes":413178,"sha256":"15a2674b739f2ae66b37c6df2e2c09cb90800e5a8ff13bb3e3c35f4fc6a0c235","duration":55.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.377,"text":"IFE lo to bayi!","marked":"Ìfẹ́ ló tó báyì!"},{"start":1.757,"end":2.658,"text":"Ohun gbogbo pari,","marked":"Ohun gbogbo parí"},{"start":3.038,"end":4.674,"text":"O ti pari gbogbo ise,","marked":"Ó ti parí gbogbo iṣẹ́"},{"start":5.054,"end":6.334,"text":"T' o tori re w' aiye.","marked":"T' ó torí rẹ̀ w' aiye."}],"end":6.334},{"key":"2","start":7.284,"lines":[{"start":7.284,"end":8.327,"text":"Ohun ti Baba fe,","marked":"Ohun tí Bàbá fẹ́"},{"start":8.707,"end":10.246,"text":"Ni Jesus ti se tan:","marked":"Ni Jésù ti ṣe tán"},{"start":10.626,"end":12.055,"text":"Wahala ati iya Re,","marked":"Wàhálà àti ìyá Rẹ̀"},{"start":12.435,"end":13.533,"text":"Mu Iwe Mimo se.","marked":"Mú Ìwé Mímọ́́ ṣẹ."}],"end":13.533},{"key":"3","start":14.483,"lines":[{"start":14.483,"end":15.642,"text":"Ko si 'rora wa kan,","marked":"Kò sì 'rora wa kan"},{"start":16.022,"end":17.5,"text":"Ti Jesu ko je ri","marked":"Tí Jésù kò jẹ́ rí"},{"start":17.88,"end":19.759,"text":"Gbogbo edun at' aniyan,","marked":"Gbogbo ẹ̀dùn àt' àníyàn"},{"start":20.139,"end":21.567,"text":"L' okan Re si ti mo.","marked":"L' ọkàn Rẹ sì ti mọ́."}],"end":21.567},{"key":"4","start":22.517,"lines":[{"start":22.517,"end":24.187,"text":"L' ori t' a f' egun de,","marked":"L' orí t' á f' egun dé"},{"start":24.567,"end":25.66,"text":"At' okan Re mimo,","marked":"Àt' ọkàn Rẹ mímọ́́"},{"start":26.04,"end":27.759,"text":"L' a ko gbogbo ese wa le,","marked":"L' a kó gbogbo ẹ̀ṣẹ̀ wa lé"},{"start":28.139,"end":29.488,"text":"K'O ba le wo sa san.","marked":"K'ó bá lè wò sá sàn."}],"end":29.488},{"key":"5","start":30.438,"lines":[{"start":30.438,"end":32.059,"text":"Ife lo mu k' O ku,","marked":"Ìfẹ́ ló mú k' Ó kú"},{"start":32.439,"end":33.591,"text":"Fun emi otosi;","marked":"Fún ẹ̀mí òtòṣì"},{"start":33.971,"end":35.824,"text":"'Wo Etutu f' ese gbogbo,","marked":"'Wo Ètùtù f' ẹsẹ̀ gbogbo"},{"start":36.204,"end":37.756,"text":"Mo f' igbagbo ro mo.","marked":"Mo f' ìgbàgbọ́́ rò mọ́."}],"end":37.756},{"key":"6","start":38.706,"lines":[{"start":38.706,"end":39.741,"text":"Nigba aini gbogbo,","marked":"Nígbà àìní gbogbo"},{"start":40.121,"end":41.589,"text":"Ati n' ite 'dajo,","marked":"Àti n' ìtẹ́ 'dájọ́"},{"start":41.969,"end":44.197,"text":"Jesu, ododo Re nikan,","marked":"Jésù, òdodo Rẹ̀ nìkan"},{"start":44.577,"end":45.569,"text":"Ni igbekele mi.","marked":"Ní ìgbẹ́kẹ̀lé mi."}],"end":45.569},{"key":"7","start":46.519,"lines":[{"start":46.519,"end":47.745,"text":"Jo sise ninu mi,","marked":"Jọ ṣiṣẹ́ nínú mi"},{"start":48.125,"end":49.325,"text":"Bi O ti se fun mi,","marked":"Bí Ó ti ṣe fún mi"},{"start":49.705,"end":51.214,"text":"Si jeki ife mi si O,","marked":"Sì jẹ́kí ìfẹ́ mi sí Ọ"},{"start":51.594,"end":52.788,"text":"Ma fi ore Re han.","marked":"Má fi ọ̀rẹ́ Rẹ hàn."},{"start":53.168,"end":53.756,"text":"Amin.","marked":"Àmín."}],"end":53.756}]}