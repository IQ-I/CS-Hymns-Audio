{"v":1,"coll":"y","num":244,"id":"hymn_244","title":"OKAN mi sunmo 'te anu","duration":39.648,"voices":{"male":{"file":"y-244-male.m4a","bytes":271833,"sha256":"0115692cfc7b0869a968357b975f2ed3b814990a8d8200e54b59ebf2ec265e21","duration":39.7},"female":{"file":"y-244-female.m4a","bytes":281622,"sha256":"79cb0cce9d2f886f156a373656cc9cd05f95c3bc1270cf2798156ce33303563d","duration":39.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.632,"text":"OKAN mi sunmo 'te anu","marked":"Ọkàn mi súnmọ́ 'tẹ ànú"},{"start":2.012,"end":3.361,"text":"Nibi Jesu ngb'ebe","marked":"Níbi Jésù ngb'ebẹ̀"},{"start":3.741,"end":5.078,"text":"F'irele wole l'ese Re,","marked":"F'ìrẹ̀lẹ̀ wọlé l'ẹsẹ̀ Rẹ"},{"start":5.458,"end":6.76,"text":"'Wo ko le gbe nibe.","marked":"'Wò kò lè gbé níbẹ̀."}],"end":6.76},{"key":"2","start":7.71,"lines":[{"start":7.71,"end":9.016,"text":"Ileri Re ni ebe mi","marked":"Ìlérí Rẹ̀ ni ẹ̀bẹ̀ mi"},{"start":9.396,"end":10.378,"text":"Eyi ni mo mu wa","marked":"Èyí ni mo mú wá"},{"start":10.758,"end":12.466,"text":"lwo npe okan t'eru npa","marked":"lwo ńpẹ́ ọkàn t'ẹrù ńpa"},{"start":12.846,"end":13.916,"text":"Bi emi Oluwa.","marked":"Bí ẹ̀mí Olúwa."}],"end":13.916},{"key":"3","start":14.866,"lines":[{"start":14.866,"end":16.24,"text":"Eru ese wo mi l'orun","marked":"Ẹrù ẹsẹ̀ wọ̀ mí l'ọ̀run"},{"start":16.62,"end":17.926,"text":"Ese use mi n'ise","marked":"Ẹsẹ̀ use mí ń'iṣẹ́"},{"start":18.306,"end":20.203,"text":"Ogun I'ode, eru ninu","marked":"Ogun l'ọ̀dẹ̀, èrú nínú"},{"start":20.583,"end":21.681,"text":"Mo wa isimi mi.","marked":"Mo wá isimi mi."}],"end":21.681},{"key":"4","start":22.631,"lines":[{"start":22.631,"end":24.253,"text":"Se Apata at' Asa mi","marked":"Ṣe Àpáta àt' Ásà mi"},{"start":24.633,"end":25.693,"text":"Ki nfi O se abo","marked":"Kí nfì Ó ṣe abo"},{"start":26.073,"end":27.726,"text":"Ki ndoju ti Olufisun","marked":"Kí ndoju tí Olùfisùn"},{"start":28.106,"end":29.503,"text":"Ki nso pe Kristi ku.","marked":"Kí ǹṣó pé Kristi kú."}],"end":29.503},{"key":"5","start":30.453,"lines":[{"start":30.453,"end":32.065,"text":"Ife Iyanu! Iwo ku","marked":"Ìfẹ́ Ìyanu! Ìwọ kù"},{"start":32.445,"end":33.577,"text":"Iwo ru itiju","marked":"Ìwọ ru ìtìjú"},{"start":33.957,"end":35.437,"text":"Ki elese b'iru emi","marked":"Kí ẹlẹ́sẹ̀ b'irú ẹ̀mí"},{"start":35.817,"end":37.136,"text":"Le be I'oruko Re.","marked":"Lè bẹ́ l'orúkọ Rẹ."},{"start":37.516,"end":38.098,"text":"Amin.","marked":"Àmín."}],"end":38.098}]}