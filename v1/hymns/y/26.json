{"v":1,"coll":"y","num":26,"id":"hymn_26","title":"GBOGBO ara aiye","duration":59.593,"voices":{"male":{"file":"y-26-male.m4a","bytes":422414,"sha256":"0e4b014dc2c1883ad14336ef72ae7d61679ae2269e738c52b1907cfee5455b88","duration":59.6},"female":{"file":"y-26-female.m4a","bytes":438500,"sha256":"c45943fb734ded26109c1bdfa74d509d2834e5350589da82449abf493fb25e99","duration":59.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.762,"text":"GBOGBO ara aiye","marked":"Gbogbo ara aiye"},{"start":2.142,"end":3.251,"text":"T'o wa ninu ese","marked":"T'ó wà nínú ẹsẹ"},{"start":3.631,"end":4.773,"text":"T'o nb ojo 'simi je","marked":"T'ó nb ọjọ́ 'simi jẹ́"},{"start":5.153,"end":6.503,"text":"Oluwa nke si yin.","marked":"Olúwa ńkẹ́ sí yín."}],"end":6.503},{"key":"CHORUS","start":7.453,"lines":[{"start":7.453,"end":9.414,"text":"Egbe Kerubu, Serafu","marked":"Ẹgbẹ́ Kérúbù, Séráfù"},{"start":9.794,"end":11.358,"text":"So faraiye p'Oluwa mbo. (2ce)","marked":"Sọ faraiye p'Olúwa ḿbọ́."}],"end":11.358},{"key":"2","start":12.308,"lines":[{"start":12.308,"end":13.509,"text":"E damure giri,","marked":"Ẹ dámùrè gírí"},{"start":13.889,"end":15.654,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":16.034,"end":17.461,"text":"E funpe na kikan","marked":"Ẹ fúńpẹ́ ná kíkan"},{"start":17.841,"end":19.166,"text":"Nipa t'ojo 'simi","marked":"Nípa t'ọjọ́ 'simi"},{"start":19.546,"end":21.605,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":21.605},{"key":"3","start":22.555,"lines":[{"start":22.555,"end":23.687,"text":"Enyin Onigbagbo","marked":"Enyin Onígbàgbọ́"},{"start":24.067,"end":25.078,"text":"L'awon Imale nwo","marked":"L'àwọn Ìmàlẹ̀ ńwò"},{"start":25.458,"end":26.492,"text":"At'awon Keferi","marked":"Àt'àwọn Kèfèrí"},{"start":26.872,"end":28.181,"text":"Nipa t'ojo 'simi.","marked":"Nípa t'ọjọ́ 'simi."},{"start":28.561,"end":30.56,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":30.56},{"key":"4","start":31.51,"lines":[{"start":31.51,"end":32.64,"text":"E mura Iati ba","marked":"Ẹ múra láti bá"},{"start":33.02,"end":33.949,"text":"Oluwa yin laja","marked":"Olúwa yín lájà"},{"start":34.329,"end":35.487,"text":"Mase f'aye sile","marked":"Mase f'áyé sílẹ̀"},{"start":35.867,"end":37.157,"text":"F'esu lati mi yin.","marked":"F'èṣù láti mì yín."},{"start":37.537,"end":39.409,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":39.409},{"key":"5","start":40.359,"lines":[{"start":40.359,"end":41.343,"text":"Toro ida Emi,","marked":"Tọrọ idà Ẹ̀mí"},{"start":41.723,"end":42.909,"text":"Lowo Olorun re,","marked":"Lọ́wọ́ Ọlọ́run rẹ"},{"start":43.289,"end":44.178,"text":"Pelu bata irin","marked":"Pẹ̀lú bàtà irin"},{"start":44.558,"end":45.848,"text":"Lati t'esu mole.","marked":"Láti t'èṣù mọ́lẹ̀."},{"start":46.228,"end":48.232,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":48.232},{"key":"6","start":49.182,"lines":[{"start":49.182,"end":50.279,"text":"Oluwa fun wa se,","marked":"Olúwa fún wa ṣe"},{"start":50.659,"end":51.982,"text":"K'a p'ojo mimo mo","marked":"K'á p'ọjọ́ mímọ́́ mọ́"},{"start":52.362,"end":53.37,"text":"Ka le ri igbala","marked":"Ká lè rí ìgbàlà"},{"start":53.75,"end":54.93,"text":"Nikehin ojo wa.","marked":"Níkẹhin ọjọ́ wa."},{"start":55.31,"end":57.114,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"},{"start":57.494,"end":58.043,"text":"Amin.","marked":"Àmín."}],"end":58.043}]}