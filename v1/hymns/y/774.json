{"v":1,"coll":"y","num":774,"id":"hymn_774","title":"E wa ka jo jumo korin","duration":62.146,"voices":{"male":{"file":"y-774-male.m4a","bytes":459408,"sha256":"70edfe909389c547813e2bbb6f9a456e372547ce503e2691a38119a07dce171e","duration":62.2},"female":{"file":"y-774-female.m4a","bytes":470849,"sha256":"6bfbf87241016d464e0f363b1dd308ef3a3f2879d5daa1d5319b5a900d2d1323","duration":62.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.278,"text":"E wa k'a jo jumo korin","marked":"Ẹ wá k'á jọ jùmọ̀ kọrin"},{"start":2.658,"end":3.968,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":4.348,"end":6.141,"text":"Orun, aye mu yin won wa","marked":"Ọ̀run, ayé mú yín wọn wá"},{"start":6.521,"end":7.405,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":7.785,"end":9.002,"text":"Ki gbogbo okan ji kuro","marked":"Kí gbogbo ọkàn jí kúrò"},{"start":9.382,"end":11.178,"text":"Ninu ese ki won f'ayo","marked":"Nínú ẹsẹ̀ kí wọ́n f'àyò"},{"start":11.558,"end":13.031,"text":"Korin didun n'tori Jesu","marked":"Kọrin dídùn ń'torí Jésù"},{"start":13.411,"end":14.571,"text":"lfe ni Olorun.","marked":"lfe ni Ọlọ́run."}],"end":14.571},{"key":"2","start":15.521,"lines":[{"start":15.521,"end":17.0,"text":"E so ni gbogbo agbaye","marked":"Ẹ sọ ní gbogbo àgbáyé"},{"start":17.38,"end":18.553,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":18.933,"end":20.907,"text":"N'nu Krist' l'ekun 'rapada wa","marked":"N'nu Krist' l'èkùn 'ràpadà wa"},{"start":21.287,"end":22.451,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":22.831,"end":24.436,"text":"Eje Re le w'ese wa nu","marked":"Ẹ̀jẹ̀ Rẹ lè w'ẹsẹ̀ wa nù"},{"start":24.816,"end":26.222,"text":"Emi Re s'oru wa d'osan","marked":"Ẹ̀mí Rẹ̀ s'oru wa d'ọ̀sán"},{"start":26.602,"end":28.556,"text":"O nto 'kan wa lati so pe","marked":"Ó ńtọ́ 'kan wá láti sọ pé"},{"start":28.936,"end":30.108,"text":"Ife ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."}],"end":30.108},{"key":"3","start":31.058,"lines":[{"start":31.058,"end":32.435,"text":"Ayo ni ipin wa nihin","marked":"Ayọ̀ ni ìpín wa níhìn"},{"start":32.815,"end":33.873,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":34.253,"end":35.733,"text":"Okan wa nyo si 'leri Re","marked":"Ọkàn wa nyo sí 'lérí Rẹ̀"},{"start":36.113,"end":37.26,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":37.64,"end":39.104,"text":"Orun at' abo wa losan","marked":"Ọrùn àt' abo wà lọ́sàn"},{"start":39.484,"end":40.993,"text":"O si mba wa gbe ni oru","marked":"Ó sì ḿbá wa gbé ní òru"},{"start":41.373,"end":43.058,"text":"On yo wa pelu wa titi","marked":"On yo wà pẹ̀lú wa títí"},{"start":43.438,"end":44.685,"text":"Ife ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."}],"end":44.685},{"key":"4","start":45.635,"lines":[{"start":45.635,"end":47.341,"text":"Ni Sion Iao tun korin yi","marked":"Ní Sion laó tún kọrin yí"},{"start":47.721,"end":48.859,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":49.239,"end":50.723,"text":"Orin t'o ga soke julo","marked":"Orin t'ó ga sókè jùlọ"},{"start":51.103,"end":52.356,"text":"Ife ni Olorun","marked":"Ìfẹ́ ni Ọlọ́run"},{"start":52.736,"end":54.435,"text":"Titi aye aninipekun","marked":"Títí ayé aninípẹ̀kun"},{"start":54.815,"end":56.306,"text":"Pelu awon mimo loke","marked":"Pẹ̀lú àwọn mímọ́́ lókè"},{"start":56.686,"end":58.031,"text":"Orin wa to dun julo ni","marked":"Orin wa tó dùn jùlọ ni"},{"start":58.411,"end":59.611,"text":"Ife ni Olorun.","marked":"Ìfẹ́ ni Ọlọ́run."},{"start":59.991,"end":60.596,"text":"Amin.","marked":"Àmín."}],"end":60.596}]}