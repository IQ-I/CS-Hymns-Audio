{"v":1,"coll":"y","num":410,"id":"hymn_410","title":"OJU kan mbe ti ki togbe","duration":50.782,"voices":{"male":{"file":"y-410-male.m4a","bytes":367611,"sha256":"db45df3181e08736785925a20769cff45f40598becb257d70d85372803d0a849","duration":50.8},"female":{"file":"y-410-female.m4a","bytes":379328,"sha256":"d511ada774555556ca71308f86d3497521f601e60db59b5bc6ae184f7b104fd5","duration":50.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.072,"text":"OJU kan mbe ti ki togbe","marked":"Ojú kan ḿbẹ tí kì tògbé"},{"start":2.452,"end":3.721,"text":"Nigbat'ile ba su","marked":"Nígbat'ilẹ̀ bá ṣú"},{"start":4.101,"end":5.946,"text":"Eti kan mbe ti ki ise","marked":"Etí kan ḿbẹ tí kí iṣẹ́"},{"start":6.326,"end":7.578,"text":"'Gbat orun ba wo.","marked":"'Gbat ọ̀run bá wọ̀."}],"end":7.578},{"key":"2","start":8.528,"lines":[{"start":8.528,"end":10.468,"text":"Apa kan mbe ti ko le re","marked":"Apá kan ḿbẹ tí kò lè rẹ́"},{"start":10.848,"end":12.139,"text":"Gba 'pa enia pin","marked":"Gba 'pa enia pin"},{"start":12.519,"end":14.061,"text":"Ife kan mbe ti ko le ku","marked":"Ìfẹ́ kan ḿbẹ tí kò lè kú"},{"start":14.441,"end":15.978,"text":"Gba fe aiye ba ku.","marked":"Gbà fẹ́ àìyẹ́ bá kú."}],"end":15.978},{"key":"3","start":16.928,"lines":[{"start":16.928,"end":18.874,"text":"Oju na nwo awon Serafu","marked":"Ojú ná ńwo àwọn Séráfù"},{"start":19.254,"end":20.331,"text":"Apa na d'orun mu","marked":"Apá nà d'ọrùn mú"},{"start":20.711,"end":22.211,"text":"Eti na kun f'orin Angel","marked":"Etí nà kún f'orin Angel"},{"start":22.591,"end":23.747,"text":"Ife na ga loke.","marked":"Ìfẹ́ ná ga lókè."}],"end":23.747},{"key":"4","start":24.697,"lines":[{"start":24.697,"end":26.128,"text":"Ipa kan l'enia le lo","marked":"Ipa kan l'enia lè lò"},{"start":26.508,"end":27.855,"text":"Gbat ipa gbogbo pin","marked":"Gbat ipa gbogbo pín"},{"start":28.235,"end":30.166,"text":"Lati ri oju at'apa","marked":"Láti rí ojú àt'apá"},{"start":30.546,"end":31.618,"text":"Ati ife nla na.","marked":"Àti ife ńlá ná."}],"end":31.618},{"key":"5","start":32.568,"lines":[{"start":32.568,"end":34.087,"text":"Ipa na ni adura wa","marked":"Ipa ná ni àdúrà wa"},{"start":34.467,"end":36.133,"text":"Ti nlo 'waju ite","marked":"Ti ńlọ 'wájú ìtẹ́"},{"start":36.513,"end":38.22,"text":"To nmi owo t'o s'aiye ro","marked":"Tó nmi owó t'ó s'aiye rò"},{"start":38.6,"end":39.748,"text":"Lati mu 'gbala wa.","marked":"Láti mú 'gbàlà wá."}],"end":39.748},{"key":"6","start":40.698,"lines":[{"start":40.698,"end":42.274,"text":"Iwo t'anu re ko lopin","marked":"Ìwo t'ánú rẹ̀ kò lópin"},{"start":42.654,"end":43.95,"text":"T'ife Re ko le ku","marked":"T'ìfẹ́ Rẹ kò lè kú"},{"start":44.33,"end":46.407,"text":"Je k'a n'igbagbo at'ife","marked":"Jẹ k'á ń'ìgbàgbọ́́ àt'ìfẹ́"},{"start":46.787,"end":48.172,"text":"K'a le ma gbadura.","marked":"K'á lè má gbàdúrà."},{"start":48.552,"end":49.232,"text":"Amin.","marked":"Àmín."}],"end":49.232}]}