{"v":1,"coll":"y","num":789,"id":"hymn_789","title":"IBUKUN ni fun agbara","duration":61.939,"voices":{"male":{"file":"y-789-male.m4a","bytes":438735,"sha256":"66d8f59c746eed35af5a46fa9a701112b89329ecced5a375c05318594b55b8d4","duration":62.0},"female":{"file":"y-789-female.m4a","bytes":451885,"sha256":"e75854246a03055ac71bb5c8d54803e4b84998fee914a3aea3f1ba3a2814e612","duration":62.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.894,"text":"IBUKUN ni fun agbara","marked":"Ìbùkún ni fún agbára"},{"start":2.274,"end":3.087,"text":"Ododo on Ogbon","marked":"Òdodo ọ́n Ọgbọ́n"},{"start":3.467,"end":4.902,"text":"At'Ore-ofe t'o papo","marked":"Àt'Ọ̀rẹ́-ọ̀fẹ́ t'ó papọ̀"},{"start":5.282,"end":6.503,"text":"S'Ise Igbala wa.","marked":"S'Iṣẹ́ Ìgbàlà wa."}],"end":6.503},{"key":"2","start":7.453,"lines":[{"start":7.453,"end":9.25,"text":"Baba wa j'eso-gi aije","marked":"Bàbá wa j'èso-gi àìjẹ́"},{"start":9.63,"end":10.699,"text":"Ogo Re si wo mi","marked":"Ògo Rẹ sì wọ̀ mí"},{"start":11.079,"end":12.495,"text":"Awa omo re si d'eru","marked":"Àwa ọmọ rẹ sì d'ẹrú"},{"start":12.875,"end":14.057,"text":"Esu ati Iku.","marked":"Èṣù àti Ikú."}],"end":14.057},{"key":"3","start":15.007,"lines":[{"start":15.007,"end":16.398,"text":"Ope fun Baba t'o f'Omo","marked":"Ọpẹ́ fún Bàbá t'ó f'Ọmọ"},{"start":16.778,"end":17.938,"text":"Re kansoso fun wa","marked":"Rẹ̀ kanṣoṣo fún wa"},{"start":18.318,"end":20.495,"text":"Enit'O ku, k'awa le ye","marked":"Enít'Ó kú, k'áwá lè yé"},{"start":20.875,"end":22.138,"text":"Ka le d'om'Olorun.","marked":"Ká lè d'om'Ọlọ́run."}],"end":22.138},{"key":"4","start":23.088,"lines":[{"start":23.088,"end":24.446,"text":"Ofin Baba gbogbo t'a ru","marked":"Òfin Bàbá gbogbo t'á rú"},{"start":24.826,"end":26.0,"text":"L'Omo ti a pa mo","marked":"L'Ọmọ tí a pa mọ́"},{"start":26.38,"end":27.89,"text":"O ku lori agbelebu","marked":"Ó kú lórí àgbélébùú"},{"start":28.27,"end":29.456,"text":"Nitori ese wa.","marked":"Nítorí ẹ̀ṣẹ̀ wa."}],"end":29.456},{"key":"5","start":30.406,"lines":[{"start":30.406,"end":31.891,"text":"Wo! O Ji dide n'iboji","marked":"Wò! Ó Jí dìde ń'íbòji"},{"start":32.271,"end":33.426,"text":"O si goke r'orun","marked":"Ó sì gòkè r'orun"},{"start":33.806,"end":35.681,"text":"Nibe li O nf' ltoye Re","marked":"Níbẹ̀ li O nf' ltọyẹ Rẹ"},{"start":36.061,"end":37.443,"text":"Gba gbogb' arufin la.","marked":"Gba gbogb' arúfin là."}],"end":37.443},{"key":"6","start":38.393,"lines":[{"start":38.393,"end":39.848,"text":"O gunwa lor'ite ogo","marked":"Ó gúnwà lór'ìtẹ́ ògo"},{"start":40.228,"end":41.214,"text":"Pelu agbara nla","marked":"Pẹ̀lú agbára ńlá"},{"start":41.594,"end":42.993,"text":"O f'ewon ide ese ja","marked":"Ó f'ẹ̀wọ̀n ìdè ẹ̀ṣẹ̀ já"},{"start":43.373,"end":44.664,"text":"T'Esu ti fi de wa.","marked":"T'Èṣù ti fi dè wá."}],"end":44.664},{"key":"7","start":45.614,"lines":[{"start":45.614,"end":47.13,"text":"O si tun mbo wa se 'dajo","marked":"Ó sì tún ḿbọ̀ wá ṣe 'dájọ́"},{"start":47.51,"end":48.628,"text":"Pelu ola-nla Re","marked":"Pẹ̀lú ọlá-ńlá Rẹ"},{"start":49.008,"end":50.565,"text":"Y'o pe awon oku mimo","marked":"Y'ó pe àwọn òkú mímọ́́"},{"start":50.945,"end":52.083,"text":"Jade pelu ayo.","marked":"Jáde pẹ̀lú ayọ̀."}],"end":52.083},{"key":"8","start":53.033,"lines":[{"start":53.033,"end":54.544,"text":"Mba le duro l'ayo pelu","marked":"Mba lè dúró l'àyò pẹ̀lú"},{"start":54.924,"end":56.694,"text":"N'waju O n d'dajo yi!","marked":"N'wájú Ó ń d'dájọ́ yí!"},{"start":57.074,"end":58.484,"text":"Ki nsi korin irapada","marked":"Kí nsì kọrin ìràpadà"},{"start":58.864,"end":60.39,"text":"Pel' awon t'a gbala.","marked":"Pel' àwọn t'á gbala."}],"end":60.39}]}