{"v":1,"coll":"y","num":122,"id":"hymn_122","title":"OLORUN Olodumare","duration":39.08,"voices":{"male":{"file":"y-122-male.m4a","bytes":267181,"sha256":"370612a58eb59432fca93465b9650bb08ba0e809c223f7f789def5b70f608f55","duration":39.1},"female":{"file":"y-122-female.m4a","bytes":280205,"sha256":"d0db17c6816b8d8d8913f010a0cdc9eab638c30f404f6e164136bb80b40778ac","duration":39.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.407,"text":"OLORUN Olodumare","marked":"Ọlọ́run Olódùmarè"},{"start":1.787,"end":3.454,"text":"Baba, Omo, Emi","marked":"Bàbá, Ọmọ, Ẹ̀mí"},{"start":3.834,"end":5.385,"text":"Riri Eni t'a ko le mo","marked":"Rírí Ẹni t'á kò le mọ́"},{"start":5.765,"end":7.201,"text":"Eni t'a ko le ri.","marked":"Ẹni t'á kò lè rí."}],"end":7.201},{"key":"2","start":8.151,"lines":[{"start":8.151,"end":9.598,"text":"Ye! Baba Olodumare","marked":"Yé! Bàbá Olódùmarè"},{"start":9.978,"end":11.097,"text":"K'a wariri fun O","marked":"K'á wárìrì fún Ọ"},{"start":11.477,"end":12.509,"text":"Ni gbogbo orile-ede","marked":"Ní gbogbo orílẹ̀-èdè"},{"start":12.889,"end":13.986,"text":"Li a o ma sin O.","marked":"Lí a ó ma sin O."}],"end":13.986},{"key":"3","start":14.936,"lines":[{"start":14.936,"end":16.474,"text":"Olorun Omo, Ore wa","marked":"Ọlọ́run Ọmọ, Ọ̀rẹ́ wa"},{"start":16.854,"end":18.119,"text":"“Wo t'o ra wa pada","marked":"Wo t'ó rà wá padà"},{"start":18.499,"end":20.017,"text":"Ma jowo wa, Olugbala","marked":"Má jọ̀wọ́ wa, Olùgbàlà"},{"start":20.397,"end":21.673,"text":"Gba wa patapata.","marked":"Gbà wá pátápátá."}],"end":21.673},{"key":"4","start":22.623,"lines":[{"start":22.623,"end":24.331,"text":"A! Olorun Emi Mimo","marked":"A! Ọlọ́run Ẹ̀mí Mímọ́́"},{"start":24.711,"end":25.662,"text":"Wo Olore-Ofe","marked":"Wo Ọlọ́rẹ-Ọ̀fẹ́"},{"start":26.042,"end":27.881,"text":"A be O, fun wa ni imo","marked":"A bẹ̀ Ọ́, fún wa ní ìmọ̀"},{"start":28.261,"end":29.574,"text":"K'a m'Olorun n'ife.","marked":"K'á m'Ọlọ́run ń'ìfẹ́."}],"end":29.574},{"key":"5","start":30.524,"lines":[{"start":30.524,"end":32.39,"text":"Okansoso sugbon meta","marked":"Ọ̀kánṣoṣo ṣùgbọ́n mẹ́ta"},{"start":32.77,"end":33.65,"text":"Eni Metalokan","marked":"Ẹni Mẹ́talọ́kan"},{"start":34.03,"end":35.126,"text":"Olorun awamaridi","marked":"Ọlọ́run àwámáridì"},{"start":35.506,"end":36.643,"text":"Eni Metalokan.","marked":"Ẹni Mẹ́talọ́kan."},{"start":37.023,"end":37.53,"text":"Amin.","marked":"Àmín."}],"end":37.53}]}