{"v":1,"coll":"y","num":51,"id":"hymn_51","title":"Jesu nfe gba elese","duration":42.429,"voices":{"male":{"file":"y-51-male.m4a","bytes":305768,"sha256":"95ba61e4b64051b2adc3dde4711b0fe28cf632d14100e95c8426c29c8b4e8038","duration":42.5},"female":{"file":"y-51-female.m4a","bytes":316831,"sha256":"0f4385e85c28c6449b5c4a4ef58a1362d119fddc4310179beef7c38899ce0697","duration":42.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.743,"text":"Jesu nfe gba elese","marked":"Jésù nfe gba ẹlẹ́ṣẹ̀"},{"start":2.123,"end":3.668,"text":"Kede re fun gbogbo eda,","marked":"Kédé rẹ fún gbogbo ẹ̀dá"},{"start":4.048,"end":5.56,"text":"T'o yapa ona run le,","marked":"T'ó yapa ọ̀nà run lé"},{"start":5.94,"end":7.528,"text":"At' awon ti njafara.","marked":"Àt' àwọn ti ńjáfara."}],"end":7.528},{"key":"CHORUS","start":8.478,"lines":[{"start":8.478,"end":10.38,"text":"Ko o Iorin ko si tun ko","marked":"Kó o lórin kó sì tún kọ́"},{"start":10.76,"end":12.318,"text":"Kristi ngba gbogbo elese","marked":"Kristi ńgbà gbogbo ẹlẹ́ṣẹ̀"},{"start":12.698,"end":14.118,"text":"Je ki 'hin na daju pe","marked":"Jẹ́ kí 'hin ná dájú pé"},{"start":14.498,"end":16.158,"text":"Kristi ngba gbogbo elese.","marked":"Kristi ńgbà gbogbo ẹlẹ́ṣẹ̀."}],"end":16.158},{"key":"2","start":17.108,"lines":[{"start":17.108,"end":18.648,"text":"Wa y'o o fun o ni 'simi","marked":"Wá y'ó o fún ọ ní 'simi"},{"start":19.028,"end":20.857,"text":"Gba A gbo, oro re ni:","marked":"Gbà Á gbọ́, ọ̀rọ̀ rẹ̀ ni"},{"start":21.237,"end":22.934,"text":"Y'o gb'elese to buru","marked":"Y'ó gb'ẹlẹ́sẹ̀ tó burú"},{"start":23.314,"end":25.183,"text":"Krisiti ngba gbogbo elese.","marked":"Krisiti ńgbá gbogbo ẹlẹ́ṣẹ̀."}],"end":25.183},{"key":"3","start":26.133,"lines":[{"start":26.133,"end":27.562,"text":"Okan mi ko lebi mo,","marked":"Ọkàn mi kò lẹ́bi mọ́"},{"start":27.942,"end":29.58,"text":"Mo mo niwaju ofin,","marked":"Mo mọ̀ níwájú òfin"},{"start":29.96,"end":30.96,"text":"Enit'o we mi mo","marked":"Enít'ó wé mi mọ́"},{"start":31.34,"end":32.742,"text":"Ti san gbogbo gbese mi.","marked":"Ti san gbogbo gbèsè mi."}],"end":32.742},{"key":"4","start":33.692,"lines":[{"start":33.692,"end":35.215,"text":"Kristi ngba gbogbo'elese","marked":"Kristi ńgbá gbogbo'ẹlẹ́ṣẹ̀"},{"start":35.595,"end":37.273,"text":"An' emi to d'ese ju,","marked":"An' emi tó d'ẹ́ṣẹ̀ jù"},{"start":37.653,"end":39.002,"text":"T'a we mo patapata","marked":"T'á wé mọ́ pátápátá"},{"start":39.382,"end":40.88,"text":"Y'o ba wo 'joba orun.","marked":"Y'ó bá wọ 'jọba ọ̀run."}],"end":40.88}]}