{"v":1,"coll":"y","num":778,"id":"hymn_778","title":"K'ORE-OFE Krist'Oluwa","duration":16.408,"voices":{"male":{"file":"y-778-male.m4a","bytes":115187,"sha256":"c2af5e1c5b66f0388b69aa383505f81343267f6d350f756cd2940c92e884eb59","duration":16.5},"female":{"file":"y-778-female.m4a","bytes":118644,"sha256":"96ef28b48aa342a7b76e72e8fa1d5953c9ce73e8a4c297da11a6a372f2fdfb42","duration":16.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.904,"text":"K'ORE-OFE Krist'Oluwa","marked":"K'ọ̀rẹ́-Ọ̀fẹ́ Krist'Olúwa"},{"start":2.284,"end":3.535,"text":"Ife Baba ailopin","marked":"Ìfẹ́ Bàbá àìlópin"},{"start":3.915,"end":5.121,"text":"Oju rere Emi Mimo","marked":"Ojú rere Ẹ̀mí Mímọ́́"},{"start":5.501,"end":7.045,"text":"K'o t'oke ba s'ori wa.","marked":"K'ó t'òkè bá s'orí wa."}],"end":7.045},{"key":"2","start":7.995,"lines":[{"start":7.995,"end":9.467,"text":"Bayi l'a le wa n'irepo","marked":"Báyì l'á lè wà ń'ìrẹ́pọ̀"},{"start":9.847,"end":11.106,"text":"Ninu wa pel'Oluwa,","marked":"Nínú wa pel'Olúwa"},{"start":11.486,"end":12.962,"text":"K'a si le n'idapo didun","marked":"K'á sì lè ń'ìdàpọ̀ dídùn"},{"start":13.342,"end":14.858,"text":"At'ayo t'aiye ko ni.","marked":"Àt'àyò t'áíyẹ̀ kọ́ ni."}],"end":14.858}]}