{"v":1,"coll":"y","num":769,"id":"hymn_769","title":"JESU Oluwa nise","duration":70.488,"voices":{"male":{"file":"y-769-male.m4a","bytes":522140,"sha256":"1955973e5d9975d022ddf4ebc6f60786a671d22cd136077f28d0a1eb1a2373a0","duration":70.5},"female":{"file":"y-769-female.m4a","bytes":535865,"sha256":"c63c8b366ba16d69e0526b2e05f9a5ea6f01909bc2b7a04088cd6e38baa3b77a","duration":70.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.589,"text":"JESU Oluwa ni'se","marked":"Jésù Olúwa nì'ṣe"},{"start":1.969,"end":2.96,"text":"lpile Ijo re","marked":"lpilẹ̀ Ìjọ rẹ"},{"start":3.34,"end":4.539,"text":"Omi ati oro Re","marked":"Omi àti ọ̀rọ̀ Rẹ"},{"start":4.919,"end":6.225,"text":"Ni On si fi tun da","marked":"Ní Ọ́n sì fi tún dá"},{"start":6.605,"end":8.513,"text":"O t'orun wa, O fi se","marked":"Ó t'ọrùn wa, Ó fi ṣe"},{"start":8.893,"end":9.822,"text":"Iyawo mimo Re","marked":"Ìyàwó mímọ́́ Rẹ"},{"start":10.202,"end":11.897,"text":"Eje Re l'O si fi ra","marked":"Ẹ̀jẹ̀ Rẹ l'Ó sì fi rà"},{"start":12.277,"end":13.325,"text":"Ti O si ku fun u.","marked":"Tí Ó sì kù fún u."}],"end":13.325},{"key":"2","start":14.275,"lines":[{"start":14.275,"end":15.448,"text":"N'ile gbogbo l'a sa won","marked":"N'ilé gbogbo l'á sá wọn"},{"start":15.828,"end":16.859,"text":"Sugbon nwon je okan","marked":"Ṣùgbọ́n nwọn jẹ́ ọ̀kan"},{"start":17.239,"end":18.874,"text":"Oluwa kan, gbagbo kan","marked":"Olúwa kan, gbàgbọ́ kan"},{"start":19.254,"end":20.42,"text":"Ati baptisi kan","marked":"Àti baptisi kan"},{"start":20.8,"end":22.289,"text":"Oruko kan ni nwon nyin","marked":"Orúkọ kan ní ńwọ̀n nyin"},{"start":22.669,"end":23.945,"text":"Onje kan ni nwon nje","marked":"Ọ̀njẹ́ kan ní ńwọ̀n ńjẹ́"},{"start":24.325,"end":25.779,"text":"Opin kan ni nwon nlepa","marked":"Òpin kan ní nwọn ńlépa"},{"start":26.159,"end":27.417,"text":"Nipa ore-ofe.","marked":"Nípa ọrẹ-ọ̀fẹ́."}],"end":27.417},{"key":"3","start":28.367,"lines":[{"start":28.367,"end":29.719,"text":"Bi aiye tile nkegan","marked":"Bí aiye tilẹ̀ nkẹ́gàn"},{"start":30.099,"end":31.303,"text":"Gbat' iyonu de ba","marked":"Gbat' ìyọnu dé bá"},{"start":31.683,"end":32.962,"text":"Bi 'ja on eko‐ke-ko","marked":"Bí 'jà ọ́n ẹ̀kọ́-ké-kó"},{"start":33.342,"end":34.428,"text":"Ba mu iyapa wa","marked":"Bá mú ìyapa wá"},{"start":34.808,"end":36.025,"text":"Awon mimo yio ma ke","marked":"Àwọn mímọ́́ yio mà kẹ̀"},{"start":36.405,"end":37.478,"text":"Wipe 'yo ti pe to?","marked":"Wípé 'yó ti pẹ́ tó?"},{"start":37.858,"end":39.122,"text":"Oru ekun fere di","marked":"Òru ẹkún fẹ́rẹ́ dì"},{"start":39.502,"end":40.413,"text":"Oro orin ayo.","marked":"Ọ̀rọ̀ orin ayọ̀."}],"end":40.413},{"key":"4","start":41.363,"lines":[{"start":41.363,"end":42.545,"text":"L'arin gbogbo 'banuje","marked":"L'árín gbogbo 'banújẹ́"},{"start":42.925,"end":44.238,"text":"At'iyonu aiye","marked":"Àt'ìyọnu aiye"},{"start":44.618,"end":45.683,"text":"O nreti ojo kehin","marked":"Ó nrètí ọjọ́ kẹ́hìn"},{"start":46.063,"end":47.208,"text":"Alafia lailai","marked":"Àlàáfíà láíláí"},{"start":47.588,"end":49.2,"text":"Titi y'o f'oju re ri","marked":"Títí y'ó f'ojú rẹ rí"},{"start":49.58,"end":50.444,"text":"Iran ologo na","marked":"Ìran ológo ná"},{"start":50.824,"end":52.114,"text":"Ti ijo nla asegun","marked":"Ti ìjọ ńlá àṣegùn"},{"start":52.494,"end":53.912,"text":"Y'o d'ijo ti nsimi.","marked":"Y'ó d'íjọ ti ńsimi."}],"end":53.912},{"key":"5","start":54.862,"lines":[{"start":54.862,"end":56.71,"text":"L'aiye, yi ni 'dapo","marked":"L'aiye, yi ni 'dapo"},{"start":57.09,"end":58.105,"text":"Pelu Metalokan","marked":"Pẹ̀lú Mẹ́talọ́kan"},{"start":58.485,"end":59.794,"text":"O si ni 'dapo didun","marked":"Ó sì ní 'dàpọ̀ dídùn"},{"start":60.174,"end":61.714,"text":"Pel'awon t'o ti sun","marked":"Pel'awon t'ó ti sùn"},{"start":62.094,"end":63.913,"text":"A! alabukun mimo","marked":"A! alábùkún mímọ́́"},{"start":64.293,"end":65.628,"text":"Oluwa, fi fun wa","marked":"Olúwa, fi fún wa"},{"start":66.008,"end":67.316,"text":"Ka ba le ri bi awon","marked":"Ká bá lè rí bí àwọn"},{"start":67.696,"end":68.938,"text":"Ka ba O gbe 'lorun.","marked":"Ká bá Ò gbé 'lọ́run."}],"end":68.938}]}