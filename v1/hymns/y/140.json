{"v":1,"coll":"y","num":140,"id":"hymn_140","title":"OM'Egbe Serafu","duration":93.915,"voices":{"male":{"file":"y-140-male.m4a","bytes":680131,"sha256":"0d082683d59b2969e258b5ebf1687458e70ac1a742b4c58d33c48e06ffa87d8f","duration":94.0},"female":{"file":"y-140-female.m4a","bytes":700611,"sha256":"d96c9ce76a85dcec00270086c5326279674aed65d563e12721e46606b67e62c0","duration":94.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.399,"text":"OM'Egbe Serafu","marked":"Om'Ẹgbẹ́ Séráfù"},{"start":1.779,"end":2.947,"text":"At'Egbe Kerubu","marked":"Àt'Ẹgbẹ́ Kérúbù"},{"start":3.327,"end":4.945,"text":"E f'ope fun Olorun wa,","marked":"Ẹ f'ọpẹ́ fún Ọlọ́run wa"},{"start":5.325,"end":7.118,"text":"E f'ope fun Olorun wa","marked":"Ẹ f'ọpẹ́ fún Ọlọ́run wa"},{"start":7.498,"end":8.646,"text":"T'iru ojo oni.","marked":"T'írú ọjọ́ òní."},{"start":9.026,"end":10.175,"text":"Fi soju emi wa.","marked":"Fi sójú ẹ̀mí wa."}],"end":10.175},{"key":"CHORUS","start":11.125,"lines":[{"start":11.125,"end":12.289,"text":"E ba wa korin po,","marked":"Ẹ bá wa kọrin pọ̀"},{"start":12.669,"end":14.725,"text":"K'awa jumo k'AIleluya","marked":"K'àwa jùmọ̀ k'Allelúyà"},{"start":15.105,"end":16.63,"text":"Ope to ye fun Jehovah","marked":"Ọpẹ́ tó yẹ fún Jehovah"},{"start":17.01,"end":18.126,"text":"Oba Onibu-Ore.","marked":"Ọba Oníbù-Ọ̀rẹ́."}],"end":18.126},{"key":"2","start":19.076,"lines":[{"start":19.076,"end":20.142,"text":"Opo Elegbe wa,","marked":"Ọ̀pọ̀ Ẹlẹgbẹ́ wa"},{"start":20.522,"end":21.7,"text":"Ni ko r'ojo oni,","marked":"Ní kó r'ọjọ́ òní"},{"start":22.08,"end":23.589,"text":"Opolopo ti sako lo","marked":"Ọ̀pọ̀lọpọ̀ ti ṣáko lọ"},{"start":23.969,"end":25.185,"text":"Idamu wa f'elomiran,","marked":"Ìdàmú wa f'ẹlòmíràn"},{"start":25.565,"end":26.801,"text":"Opo si ti koja","marked":"Ọ̀pọ̀ sì ti kọjá"},{"start":27.181,"end":28.489,"text":"Lo si aiyeraiye.","marked":"Lọ sí aiyérayé."}],"end":28.489},{"key":"3","start":29.439,"lines":[{"start":29.439,"end":30.528,"text":"Egbe Aladura,","marked":"Ẹgbẹ́ Aládúrà"},{"start":30.908,"end":32.155,"text":"E mura si adura;","marked":"Ẹ múra sí àdúrà"},{"start":32.535,"end":34.132,"text":"Gbe ida 'segun nyin soke","marked":"Gbé idà 'ṣẹ́gun nyin sókè"},{"start":34.512,"end":35.978,"text":"Oluwa yio ba wa segun","marked":"Olúwa yio bá wa ṣẹ́gun"},{"start":36.358,"end":37.705,"text":"Oto l'esu gbogun","marked":"Ọ̀tọ̀ l'èṣù gbógun"},{"start":38.085,"end":39.293,"text":"Ko ni le bori wa.","marked":"Kò ní lè borí wa."}],"end":39.293},{"key":"4","start":40.243,"lines":[{"start":40.243,"end":41.54,"text":"Ninu odun tawa yi","marked":"Nínú ọdún táwa yí"},{"start":41.92,"end":43.16,"text":"Agan yio gb'omo pon","marked":"Àgàn yíó gb'omo pọ́n"},{"start":43.54,"end":45.236,"text":"Awon alaisan yo dide!","marked":"Àwọn aláìsàn yọ̀ dìde!"},{"start":45.616,"end":47.047,"text":"Arun ko ni ya ile wa,","marked":"Àrùn kò ní ya ilé wa"},{"start":47.427,"end":48.355,"text":"Onirobinuje;","marked":"Oníròbìnújẹ́"},{"start":48.735,"end":49.791,"text":"Yio ri itunu gba.","marked":"Yío rí ìtùnú gbà."}],"end":49.791},{"key":"5","start":50.741,"lines":[{"start":50.741,"end":52.257,"text":"F'awon ti ko r'ise","marked":"F'àwọn tí kò r'iṣẹ́"},{"start":52.637,"end":53.926,"text":"Baba yio pese","marked":"Bàbá yìó pèsè"},{"start":54.306,"end":56.072,"text":"Awon t'ebi npa yio si yo","marked":"Àwọn t'ebi ńpa yíó sì yọ"},{"start":56.452,"end":58.187,"text":"Awon t'o je 'gbese y'o san","marked":"Àwọn t'ó jẹ́ 'gbèsè y'ó san"},{"start":58.567,"end":59.568,"text":"Aini ko ni si mo","marked":"Àìní kò ní sí mọ́"},{"start":59.948,"end":61.313,"text":"Ayo yio kari wa.","marked":"Ayọ̀ yìó kárí wa."}],"end":61.313},{"key":"6","start":62.263,"lines":[{"start":62.263,"end":63.695,"text":"lfe l'akoja ofin","marked":"lfe l'ákọjá òfin"},{"start":64.075,"end":65.465,"text":"Baba fun wa n'ife","marked":"Bàbá fún wa n'ìfẹ́"},{"start":65.845,"end":67.037,"text":"Ki agba feran omode","marked":"Kí àgbà fẹ́ràn ọmọdé"},{"start":67.417,"end":68.973,"text":"At'okunrin at'obirin,","marked":"Àt'ọkùnrin àt'òbirin"},{"start":69.353,"end":70.473,"text":"Ife l'awon Angeli","marked":"Ìfẹ́ l'àwọn Áńgẹ́lì"},{"start":70.853,"end":72.256,"text":"Fi nyin Baba loke.","marked":"Fi nyin Bàbá lókè."}],"end":72.256},{"key":"7","start":73.206,"lines":[{"start":73.206,"end":74.188,"text":"lwe Woli Joel","marked":"lwe Wòlí Joel"},{"start":74.568,"end":75.612,"text":"Ni ori ekeji","marked":"Ní orí èkejì"},{"start":75.992,"end":77.216,"text":"Ese ekejidinlogbon","marked":"Ẹsẹ èkejìdínlọ́gbọ̀n"},{"start":77.596,"end":79.291,"text":"Ase na se si Kerubu","marked":"Àṣé nà ṣe sí Kérúbù"},{"start":79.671,"end":80.867,"text":"Ati Serafu loni,","marked":"Àti Séráfù lónì"},{"start":81.247,"end":82.398,"text":"Ni arin Egbe wa.","marked":"Ní àrìn Ẹgbẹ́ wa."}],"end":82.398},{"key":"8","start":83.348,"lines":[{"start":83.348,"end":84.374,"text":"Ogo ni fun Baba","marked":"Ògo ni fún Bàbá"},{"start":84.754,"end":85.692,"text":"Ogo ni fun Omo","marked":"Ògo ni fún Ọmọ"},{"start":86.072,"end":87.375,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":87.755,"end":89.024,"text":"Ogo ni f 'Olodumare","marked":"Ògo ni f 'Olódùmarè"},{"start":89.404,"end":90.498,"text":"'Wo ni Serafu nwo","marked":"'Wò ni Séráfù ńwò"},{"start":90.878,"end":92.365,"text":"Ma je k'oju, ti wa.","marked":"Má jẹ k'ojú, ti wa."}],"end":92.365}]}