{"v":1,"coll":"y","num":330,"id":"hymn_330","title":"A mu ileri se","duration":24.893,"voices":{"male":{"file":"y-330-male.m4a","bytes":173335,"sha256":"20302047344170a1b8ac2f4166a037477a04e5f0b280b188c3841b1f5daadb10","duration":24.9},"female":{"file":"y-330-female.m4a","bytes":178383,"sha256":"7bd3d972e5919e229ce46f94f07630dbd039b155318020bb6b8fe1b115ce9b08","duration":24.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.296,"text":"A mu ileri se","marked":"A mú ìlérí ṣẹ"},{"start":1.676,"end":2.7,"text":"Ise 'gbala pari","marked":"Iṣẹ́ 'gbàlà parí"},{"start":3.08,"end":4.761,"text":"Oto at'anu di ore","marked":"Ọ̀tọ̀ àt'ánú di ọ̀rẹ́"},{"start":5.141,"end":6.555,"text":"Om'Olorun jinde.","marked":"Om'Ọlọ́run jíǹde."}],"end":6.555},{"key":"2","start":7.505,"lines":[{"start":7.505,"end":8.787,"text":"Okan mi yin Jesu","marked":"Ọkàn mi yin Jésù"},{"start":9.167,"end":10.275,"text":"T'O ru gbogb'ese re","marked":"T'ó ru gbọgbẹ́sẹ̀ rẹ̀"},{"start":10.655,"end":12.251,"text":"T'O ku f'ese gbogbo aiye","marked":"T'ó kù f'ẹsẹ̀ gbogbo aiye"},{"start":12.631,"end":14.426,"text":"O wa, K'O ma ku mo.","marked":"Ó wá, K'ó mà kú mọ́."}],"end":14.426},{"key":"3","start":15.376,"lines":[{"start":15.376,"end":16.507,"text":"Iku Re ra 'simi","marked":"Ikú Rẹ̀ ra 'simi"},{"start":16.887,"end":18.401,"text":"Fun O, l' O ji dide","marked":"Fún Ọ, l' Ó jí dìde"},{"start":18.781,"end":20.743,"text":"Gbagbo, gba ekun 'dariji","marked":"Gbagbó, gba ẹkùn 'dáríjì"},{"start":21.123,"end":22.323,"text":"T'a sa l'ami eje.","marked":"T'á sá l'àmì ẹ̀jẹ̀."},{"start":22.703,"end":23.343,"text":"Amin.","marked":"Àmín."}],"end":23.343}]}