{"v":1,"coll":"y","num":275,"id":"hymn_275","title":"BABA wa orun npe","duration":38.738,"voices":{"male":{"file":"y-275-male.m4a","bytes":272546,"sha256":"2a00d96c0f07e084c0d7df4308c61efcff8f489e435d6e9bf1fc41013c31a3f7","duration":38.8},"female":{"file":"y-275-female.m4a","bytes":282020,"sha256":"421d040388bf29c32afa08aad4b7881246331f8a70da6365be3096ce8f1fa7cf","duration":38.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.479,"text":"BABA wa orun npe","marked":"Bàbá wa ọ̀run ńpè"},{"start":1.859,"end":3.457,"text":"Krist' npe wa sodo Re","marked":"Krist' ńpẹ́ wá sọ́dọ̀ Rẹ"},{"start":3.837,"end":5.176,"text":"Ore wa pelu won o dun","marked":"Ọ̀rẹ́ wa pẹ̀lú wọn ò dùn"},{"start":5.556,"end":7.122,"text":"Dapo wa y'o s'owon.","marked":"Dàpọ̀ wa y'ó s'ọwọ̀n."}],"end":7.122},{"key":"2","start":8.072,"lines":[{"start":8.072,"end":8.972,"text":"Olorun nkanu mi","marked":"Ọlọ́run nkanú mi"},{"start":9.352,"end":10.537,"text":"O dar'ese mi ji","marked":"Ó dar'ese mi jì"},{"start":10.917,"end":12.247,"text":"Olodumare s'okan mi","marked":"Olódùmarè s'ọkàn mi"},{"start":12.627,"end":13.974,"text":"O f'ogbon to pa mi.","marked":"Ó f'ọgbọ́n tó pa mí."}],"end":13.974},{"key":"3","start":14.924,"lines":[{"start":14.924,"end":16.217,"text":"Ebun Re ti po to!","marked":"Ẹ̀bùn Rẹ̀ ti pọ̀ tó!"},{"start":16.597,"end":17.504,"text":"Ol'opo isura","marked":"Ol'ọ̀pọ̀ ìṣúra"},{"start":17.884,"end":19.538,"text":"T'a t'owo Olugbala pin","marked":"T'á t'ọwọ́ Olùgbàlà pin"},{"start":19.918,"end":21.143,"text":"Ti a f'eje Re ra!","marked":"Tí a f'ẹ̀jẹ̀ Rẹ rà!"}],"end":21.143},{"key":"4","start":22.093,"lines":[{"start":22.093,"end":23.88,"text":"Jesu, Ori 'ye mi","marked":"Jésù, Orí 'yé mi"},{"start":24.26,"end":25.483,"text":"Mo fi 'bukun fun O","marked":"Mo fi 'bùkún fún Ọ"},{"start":25.863,"end":27.299,"text":"Alagbawi lodo Baba","marked":"Alágbàwí lọ́dọ̀ Bàbá"},{"start":27.679,"end":28.917,"text":"Asaju lodo Re.","marked":"Aṣájú lọ́dọ̀ Rẹ."}],"end":28.917},{"key":"5","start":29.867,"lines":[{"start":29.867,"end":31.094,"text":"Okan at'ife mi","marked":"Ọkàn àt'ìfẹ́ mi"},{"start":31.474,"end":32.646,"text":"E duro je nihin","marked":"Ẹ dúró jẹ níhìn"},{"start":33.026,"end":34.399,"text":"Titi 'dapo yio fi kun","marked":"Títí 'dàpọ̀ yìó fi kún"},{"start":34.779,"end":36.179,"text":"L'oke orun l'ohun.","marked":"L'òkè ọ̀run l'ọ̀hún."},{"start":36.559,"end":37.188,"text":"Amin.","marked":"Àmín."}],"end":37.188}]}