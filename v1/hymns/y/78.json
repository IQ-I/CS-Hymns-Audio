{"v":1,"coll":"y","num":78,"id":"hymn_78","title":"T'OLORUN Oluwa nile","duration":71.976,"voices":{"male":{"file":"y-78-male.m4a","bytes":519993,"sha256":"80b816cd4ba98911eaf55d401e9f28ec24419d5fc4c430e29e16b1f270a9e846","duration":72.0},"female":{"file":"y-78-female.m4a","bytes":530725,"sha256":"346329cd5564e151d0472be881a51e795a800552181fcb5984188bc69324ee38","duration":72.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.634,"text":"T'OLORUN Oluwa nile","marked":"T'Ọlọ́run Olúwa nílẹ̀"},{"start":2.014,"end":3.314,"text":"Ati gbogbo ekun re,","marked":"Àti gbogbo ẹkún rẹ̀"},{"start":3.694,"end":5.262,"text":"Aiye at'awon enia","marked":"Aiye àt'àwọn enia"},{"start":5.642,"end":6.85,"text":"Ti O tedo sinu re.","marked":"Tí Ó tẹ̀dó sínú rẹ̀."}],"end":6.85},{"key":"CHORUS","start":7.8,"lines":[{"start":7.8,"end":9.111,"text":"Awamaridi ni 'se Re,","marked":"Àwámáridì ní 'ṣe Rẹ̀"},{"start":9.491,"end":10.55,"text":"OLuwa omo-ogun","marked":"Olúwa ọmọ-ogun"},{"start":10.93,"end":12.726,"text":"Ogo Ogo ola at'agbara,","marked":"Ògo Ògo ọlá àt'ágbára"},{"start":13.106,"end":14.79,"text":"Ni fun O, Metalokan.","marked":"Ní fún Ọ, Mẹ́talọ́kan."}],"end":14.79},{"key":"2","start":15.74,"lines":[{"start":15.74,"end":17.069,"text":"Tani yio goke Oluwa","marked":"Tani yio gòkè Olúwa"},{"start":17.449,"end":18.63,"text":"Ati ibi Mimo Re","marked":"Àti ibi Mímọ́́ Rẹ"},{"start":19.01,"end":20.318,"text":"Enit'o ni owo mimo","marked":"Enit'ó ní ọwọ́ mímọ́́"},{"start":20.698,"end":22.463,"text":"TI aiyaa re si funfun.","marked":"Ti àìyáa rẹ̀ sí funfun."},{"start":22.843,"end":24.072,"text":"Egbe:  Awamaridi ni 'se...","marked":"Awamaridi ni 'se"}],"end":24.072},{"key":"3","start":25.022,"lines":[{"start":25.022,"end":26.513,"text":"Awon ti ko gbokan soke","marked":"Àwọn tí kò gbọ́kàn sókè"},{"start":26.893,"end":28.367,"text":"S'ohun asan aiye yi,","marked":"S'ohun asán aiye yi"},{"start":28.747,"end":30.106,"text":"Ti ko si je bura etan","marked":"Tí kò sì jẹ́ búra ẹ̀tàn"},{"start":30.486,"end":31.986,"text":"Yio ri 'bukun Oluwa gba.","marked":"Yíó rí 'bùkún Olúwa gbà."},{"start":32.366,"end":33.669,"text":"Egbe:  Awamaridi ni 'se...","marked":"Awamaridi ni 'se"}],"end":33.669},{"key":"4","start":34.619,"lines":[{"start":34.619,"end":36.148,"text":"Eyi I'awon ti nsaferi","marked":"Èyí l'àwọn tí nsaferi"},{"start":36.528,"end":37.663,"text":"Oju Olorun Jakobu,","marked":"Ojú Ọlọ́run Jákọ́bù"},{"start":38.043,"end":39.328,"text":"Awon to duro d'Oluwa","marked":"Àwọn tó dúró d'Olúwa"},{"start":39.708,"end":40.886,"text":"Ni yio ri 'bukun gba.","marked":"Ní yìó rí 'bùkún gbà."},{"start":41.266,"end":42.46,"text":"Egbe:  Awamaridi ni 'se...","marked":"Awamaridi ni 'se"}],"end":42.46},{"key":"5","start":43.41,"lines":[{"start":43.41,"end":44.533,"text":"Gbori soke enu ona,","marked":"Gbórí sókè ẹnu ọ̀nà"},{"start":44.913,"end":46.428,"text":"Ka si tun gbe nyin soke","marked":"Ká sì tún gbé nyin sókè"},{"start":46.808,"end":48.123,"text":"Enyin l'ekun aiyeraiye,","marked":"Enyin l'èkùn aiyérayé"},{"start":48.503,"end":49.813,"text":"K'Oba ogo le wole.","marked":"K'Ọba ògo lè wọlé."},{"start":50.193,"end":51.424,"text":"Egbe:  Awamaridi ni 'se...","marked":"Awamaridi ni 'se"}],"end":51.424},{"key":"6","start":52.374,"lines":[{"start":52.374,"end":53.829,"text":"Tani Oba Ologo yi!","marked":"Tani Ọba Ológo yí!"},{"start":54.209,"end":55.218,"text":"Oluwa Omo Ogun","marked":"Olúwa Ọmọ Ogun"},{"start":55.598,"end":57.284,"text":"Eni to I'agbara l'ogun","marked":"Ẹni tó l'ágbára l'ogun"},{"start":57.664,"end":58.92,"text":"On ni Oba Ogo yi.","marked":"Òǹ ni Ọba Ògo yí."},{"start":59.3,"end":60.501,"text":"Egbe:  Awamaridi ni 'se...","marked":"Awamaridi ni 'se"}],"end":60.501},{"key":"7","start":61.451,"lines":[{"start":61.451,"end":62.685,"text":"Gbori soke enu ona,","marked":"Gbórí sókè ẹnu ọ̀nà"},{"start":63.065,"end":64.52,"text":"K'Oba ogo le wole","marked":"K'Ọba ògo lè wọ́lẹ̀"},{"start":64.9,"end":66.134,"text":"Tani Oba Ogo yi?","marked":"Tani Ọba Ògo yí?"},{"start":66.514,"end":67.678,"text":"Oluwa Omo Ogun.","marked":"Olúwa Ọmọ Ogun."},{"start":68.058,"end":69.482,"text":"Egbe:  Awamaridi ni 'se...","marked":"Awamaridi ni 'se"},{"start":69.862,"end":70.426,"text":"Amin.","marked":"Àmín."}],"end":70.426}]}