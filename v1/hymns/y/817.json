{"v":1,"coll":"y","num":817,"id":"hymn_817","title":"EMI ti nji oku dide","duration":86.638,"voices":{"male":{"file":"y-817-male.m4a","bytes":633174,"sha256":"022a880d2c51dfd1da5c2781d28d97805b91a7c0c17c2ddc568043d66b34777a","duration":86.7},"female":{"file":"y-817-female.m4a","bytes":659893,"sha256":"56738de95b26380dff889708f256a474c1407f2033e965745926940b16196456","duration":86.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.877,"text":"EMI ti nji oku dide","marked":"Èmi ti ńjí òkú dìde"},{"start":2.257,"end":3.416,"text":"A wole niwaju Re","marked":"A wọlé níwájú Rẹ̀"},{"start":3.796,"end":5.363,"text":"Na 'wo Emi 'ye Re si wa","marked":"Na 'wo Èmi 'yé Rẹ̀ sí wa"},{"start":5.743,"end":7.127,"text":"Ko so gbogbo wa d'otun","marked":"Kò sọ gbogbo wa d'ọ̀tun"},{"start":7.507,"end":8.731,"text":"Omo Baba to d'enia","marked":"Ọmọ Bàbá tó d'enia"},{"start":9.111,"end":10.695,"text":"Woli, Alufa, Oluwa.","marked":"Wòlí, Àlùfà, Olúwa."}],"end":10.695},{"key":"CHORUS","start":11.645,"lines":[{"start":11.645,"end":13.07,"text":"Olugbala, Olugbala","marked":"Olùgbàlà, Olùgbàlà"},{"start":13.45,"end":14.829,"text":"Olugbala, gba wa la.","marked":"Olùgbàlà, gbà wá là."}],"end":14.829},{"key":"2","start":15.779,"lines":[{"start":15.779,"end":17.593,"text":"Egbe Kerubu aiye yi","marked":"Ẹgbẹ́ Kérúbù aiye yi"},{"start":17.973,"end":19.216,"text":"E se ara nyin lokan","marked":"Ẹ ṣe ara nyin lọ́kàn"},{"start":19.596,"end":21.294,"text":"Egbe Serafu aiye yi","marked":"Ẹgbẹ́ Séráfù aiye yi"},{"start":21.674,"end":22.981,"text":"E fi okan kan sise","marked":"Ẹ fi ọkàn kan ṣiṣẹ́"},{"start":23.361,"end":24.777,"text":"Ran wa lowo ka sise Re","marked":"Ràn wá lọ́wọ́ ká ṣiṣẹ́ Rẹ̀"},{"start":25.157,"end":26.437,"text":"Ka mase se aseti.","marked":"Ká máṣe ṣe àṣetì."}],"end":26.437},{"key":"3","start":27.387,"lines":[{"start":27.387,"end":28.874,"text":"Ma sise l'oruko Jesu","marked":"Má ṣiṣẹ́ l'orúkọ Jésù"},{"start":29.254,"end":30.462,"text":"Mase wo awon elegan","marked":"Masẹ̀ wọ àwọn ẹlẹ́gàn"},{"start":30.842,"end":32.329,"text":"Si Matteu ori keta","marked":"Sí Matteu orí kẹta"},{"start":32.709,"end":33.971,"text":"W'ese kerindilogun","marked":"W'ẹsẹ kerindilogun"},{"start":34.351,"end":35.862,"text":"Sokale ninu olanla","marked":"Sókàlẹ̀ nínú ọ̀làǹlà"},{"start":36.242,"end":37.641,"text":"Sarin Egbe Serafu.","marked":"Ṣárìn Ẹgbẹ́ Séráfù."}],"end":37.641},{"key":"4","start":38.591,"lines":[{"start":38.591,"end":39.977,"text":"F'ojurere wo 'dapo wa","marked":"F'ojúrere wo 'dàpọ̀ wa"},{"start":40.357,"end":41.851,"text":"F'oro mimo Re ye wa","marked":"F'ọ̀rọ̀ mímọ́́ Rẹ yé wa"},{"start":42.231,"end":43.794,"text":"Fitila t'o ran sarin wa","marked":"Fìtílà t'ó ran sarin wa"},{"start":44.174,"end":45.565,"text":"Ma ba wa b'ororo si","marked":"Má bá wá b'òròrò sí"},{"start":45.945,"end":47.39,"text":"Nigbat' ota ba sunmo wa","marked":"Nígbàt' ọ̀tá bá súnmọ́ wa"},{"start":47.77,"end":49.544,"text":"Jesu, jowo sunmo wa.","marked":"Jésù, jọ̀wọ́ súnmọ́ wa."}],"end":49.544},{"key":"5","start":50.494,"lines":[{"start":50.494,"end":52.125,"text":"Okunkun yio b'oju orun","marked":"Òkùnkùn yíó b'ojú ọ̀run"},{"start":52.505,"end":54.014,"text":"Isele nla y'o sise","marked":"Ìṣẹ̀lẹ̀ ńlá y'ó ṣiṣẹ́"},{"start":54.394,"end":55.611,"text":"Awon irawo y'o ma ja","marked":"Àwọn ìràwọ̀ y'ó ma jà"},{"start":55.991,"end":57.333,"text":"Gegebi ojo ti nro","marked":"Gegebi ọjọ́ ti ńrọ́"},{"start":57.713,"end":58.848,"text":"E ma jafara adura","marked":"Ẹ má jáfara àdúrà"},{"start":59.228,"end":60.897,"text":"Gbogbo enyin enia mi.","marked":"Gbogbo enyin enia mi."}],"end":60.897},{"key":"6","start":61.847,"lines":[{"start":61.847,"end":63.499,"text":"Nigbat' o ba d'ojo kehin","marked":"Nígbàt' ó bá d'ọjọ́ kẹ́hìn"},{"start":63.879,"end":65.381,"text":"T'omo ko ni mo baba","marked":"T'ọmọ kò ní mọ bàbá"},{"start":65.761,"end":67.386,"text":"Ma doju ti wa l'ojo na","marked":"Má dojú tì wá l'ọjọ́ ná"},{"start":67.766,"end":69.445,"text":"Gba 'awa Egbe Serafu","marked":"Gba 'àwa Ẹgbẹ́ Séráfù"},{"start":69.825,"end":71.246,"text":"Ran wa lowo ka sise Re","marked":"Ràn wá lọ́wọ́ ká ṣiṣẹ́ Rẹ̀"},{"start":71.626,"end":73.235,"text":"K'a le ma ja f'otito.","marked":"K'á lè má jà f'òtítọ́́."}],"end":73.235},{"key":"7","start":74.185,"lines":[{"start":74.185,"end":75.816,"text":"E f'oge fun Baba loke","marked":"Ẹ f'oge fún Bàbá lókè"},{"start":76.196,"end":77.514,"text":"E f'ogo fun Omo Re","marked":"Ẹ f'ògo fún Ọmọ Rẹ"},{"start":77.894,"end":79.352,"text":"E f'ogo fun Emi Mimo","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́́"},{"start":79.732,"end":81.397,"text":"Metalokan a juba","marked":"Mẹ́talọ́kan á júbà"},{"start":81.777,"end":83.147,"text":"Ongbe re ma nghe okan wa","marked":"Ọ̀ǹgbè rẹ má nghe ọkàn wa"},{"start":83.527,"end":85.088,"text":"Fi manna orun bo wa.","marked":"Fi mánná ọ̀run bò wá."}],"end":85.088}]}