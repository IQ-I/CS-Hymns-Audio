{"v":1,"coll":"y","num":218,"id":"hymn_218","title":"ODUN titun de awa nyo","duration":111.406,"voices":{"male":{"file":"y-218-male.m4a","bytes":829790,"sha256":"32173a693442f10ce645803cd4400d6ae2c7151d67fc2d8a33ce5cf9558041f5","duration":111.5},"female":{"file":"y-218-female.m4a","bytes":846489,"sha256":"4c7758897a76538f2a69fb4640521f1547094a074cd1d39b72178409518506bc","duration":111.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.1,"text":"ODUN titun de awa nyo,","marked":"Ọdún titun dẹ àwa nyo"},{"start":2.48,"end":4.523,"text":"Tiwa to be, o ju be lo,","marked":"Tiwa tó bẹ́, ó jù bẹ́ lọ"},{"start":4.903,"end":6.034,"text":"Aw' Egbe Serafu,","marked":"Àw' Ẹgbẹ́ Séráfù"},{"start":6.414,"end":7.789,"text":"Ko ni gbagbe l'odun to lo,","marked":"Kò ní gbàgbé l'ọdún tó lò"},{"start":8.169,"end":9.825,"text":"K' Olorun se 'yi l'odun 're,","marked":"K' Ọlọ́run ṣe 'yí l'ọdún 're"},{"start":10.205,"end":11.333,"text":"E ku ewu odun.","marked":"Ẹ kú ewu ọdún."}],"end":11.333},{"key":"2","start":12.283,"lines":[{"start":12.283,"end":13.66,"text":"Enyin Om'Egbe Kerubu,","marked":"Enyin Om'Ẹgbẹ́ Kérúbù"},{"start":14.04,"end":15.55,"text":"K' e sotiti titi d'opin,","marked":"K' ẹ ṣọ́tìtì títí d'òpin"},{"start":15.93,"end":17.356,"text":"K' emura s' adura,","marked":"K' emúra s' àdúrà"},{"start":17.736,"end":19.273,"text":"K' ema woju enikeni,","marked":"K' ẹ̀mà wojú ẹnikẹ́ni"},{"start":19.653,"end":21.067,"text":"E gboran si agba l' enu,","marked":"Ẹ gbọ́ràn sí àgbà l' enu"},{"start":21.447,"end":22.746,"text":"E ye 'ra odun wo.","marked":"Ẹ yé 'ra ọdún wò."}],"end":22.746},{"key":"3","start":23.696,"lines":[{"start":23.696,"end":25.523,"text":"Enyin Egbe Aladura,","marked":"Enyin Ẹgbẹ́ Alàdúrà"},{"start":25.903,"end":27.457,"text":"K' e ranti iran ti e nri,","marked":"K' ẹ rántí ìran tí ẹ ńrí"},{"start":27.837,"end":28.948,"text":"S'ipa iwa rere,","marked":"S'ípa ìwà rere"},{"start":29.328,"end":31.374,"text":"K' e mura lati d' ohun po,","marked":"K' ẹ múra láti d' ohùn pọ̀"},{"start":31.754,"end":33.33,"text":"E se ara nyin ni okan,","marked":"Ẹ ṣe ara nyin ní ọkàn"},{"start":33.71,"end":35.015,"text":"E ye 'ra odun wo.","marked":"Ẹ yé 'ra ọdún wò."}],"end":35.015},{"key":"4","start":35.965,"lines":[{"start":35.965,"end":37.297,"text":"Awon ti ko gba iran gbo,","marked":"Àwọn tí kò gba ìran gbọ́"},{"start":37.677,"end":38.962,"text":"Nwon dabi ako keferi;","marked":"Nwọ̀n dàbí akọ kèfèrí"},{"start":39.342,"end":40.643,"text":"Nwon ko mo 'kan s'okan,","marked":"Nwọn kò mọ 'kan s'ọ̀kan"},{"start":41.023,"end":42.368,"text":"Bere lowo Jenny Winful,","marked":"Bẹ̀rẹ̀ lọ́wọ́ Jenny Winful"},{"start":42.748,"end":44.717,"text":"Ohun t' ori k' o to bimo,","marked":"Ohun t' orí k' ò tó bímọ"},{"start":45.097,"end":46.241,"text":"E ye 'ra odun wo.","marked":"Ẹ yé 'ra ọdún wò."}],"end":46.241},{"key":"5","start":47.191,"lines":[{"start":47.191,"end":49.117,"text":"K' a fi keta gbogbo sile,","marked":"K' a fi kẹta gbogbo sílẹ̀"},{"start":49.497,"end":51.332,"text":"k' a fe om' enikeji wa,","marked":"k' á fẹ́ om' ẹnìkejì wa"},{"start":51.712,"end":53.23,"text":"L' odun t' a bo si yi,","marked":"L' ọdún t' á bọ́ sí yí"},{"start":53.61,"end":54.824,"text":"K' a m soro eni lehin,","marked":"K' a ḿ sọ̀rọ̀ ẹni lẹ́hìn"},{"start":55.204,"end":56.72,"text":"K' ija gbogbo kuro l'ona,","marked":"K' ìjà gbogbo kúrò l'ọ́nà"},{"start":57.1,"end":58.282,"text":"E ye 'ra odun wo.","marked":"Ẹ yé 'ra ọdún wò."}],"end":58.282},{"key":"6","start":59.232,"lines":[{"start":59.232,"end":61.362,"text":"Ninu odun t' a bo si yi,","marked":"Nínú ọdún t' á bọ́ sí yí"},{"start":61.742,"end":63.534,"text":"Agan a f' owo s' osun,","marked":"Àgàn a f' owo s' osùn"},{"start":63.914,"end":64.871,"text":"Olomo a tun bi,","marked":"Ọlọ́mọ á tún bí"},{"start":65.251,"end":66.745,"text":"Enit' o je 'gbese y'osan,","marked":"Enit' ò jẹ́ 'gbèsè y'ọ̀sán"},{"start":67.125,"end":70.496,"text":"Aje, oso ko ni ri wa,","marked":"Àjẹ́, ọ̀ṣọ́ kò ní rí wa"},{"start":70.876,"end":72.155,"text":"E ye 'ra odun wo.","marked":"Ẹ yé 'ra ọdún wò."}],"end":72.155},{"key":"7","start":73.105,"lines":[{"start":73.105,"end":74.639,"text":"E wo bi ilu wa ti ri,","marked":"Ẹ wo bí ìlú wa ti rí"},{"start":75.019,"end":77.071,"text":"Ajakal' arun tun gb'ode,","marked":"Ajakal' àrùn tún gb'ọdẹ"},{"start":77.451,"end":78.704,"text":"K'Olorun mu kuro,","marked":"K'Ọlọ́run mú kúrò"},{"start":79.084,"end":80.764,"text":"Nipa awe at'adura,","marked":"Nípa awẹ́ àt'àdúrà"},{"start":81.144,"end":82.813,"text":"K'okan gbogbo wa nirepo,","marked":"K'ókan gbogbo wà nírẹ́pọ̀"},{"start":83.193,"end":84.347,"text":"E ye 'ra odun wo.","marked":"Ẹ yé 'ra ọdún wò."}],"end":84.347},{"key":"8","start":85.297,"lines":[{"start":85.297,"end":87.501,"text":"A ko ri ra, a ko ri ta,","marked":"A kò rí rà, a kò rí ta"},{"start":87.881,"end":89.371,"text":"Ko tun s' awon alanu mo,","marked":"Kò tún s' àwọn alanu mọ́"},{"start":89.751,"end":90.961,"text":"Owo ko si l'ode,","marked":"Owó kò sì l'ọdẹ"},{"start":91.341,"end":93.0,"text":"Ibawi Olorun l'eyi,","marked":"Ìbáwí Ọlọ́run l'èyí"},{"start":93.38,"end":94.972,"text":"K'a ronu k' a p'iwa wa da,","marked":"K'á ronú k' á p'ìwà wa dà"},{"start":95.352,"end":96.621,"text":"Eye ra odun wo.","marked":"Ẹyẹ ra ọdún wò."}],"end":96.621},{"key":"9","start":97.571,"lines":[{"start":97.571,"end":99.417,"text":"Nigbat' o ba d'ojo 'kehin","marked":"Nígbat' ó bá d'ọjọ́ 'kẹhin"},{"start":99.797,"end":101.24,"text":"Ti omo ko ni mo baba,","marked":"Tí ọmọ kò ní mọ bàbá"},{"start":101.62,"end":103.451,"text":"Oluwa, ranti mi,","marked":"Olúwa, rántí mi"},{"start":103.831,"end":105.425,"text":"K'a le gbo ohun 'kele ni,","marked":"K'á lè gbọ́ ohùn 'kẹ́lẹ́ ni"},{"start":105.805,"end":107.942,"text":"Wipe, ma bo, omo rere,","marked":"Wípé, má bọ̀, ọmọ rere"},{"start":108.322,"end":109.857,"text":"K' a gb' ade nikehin.","marked":"K' a gb' adé níkẹhin."}],"end":109.857}]}