{"v":1,"coll":"y","num":310,"id":"hymn_310","title":"JESU Oluwa awa de","duration":43.614,"voices":{"male":{"file":"y-310-male.m4a","bytes":311197,"sha256":"d28e805fdd51967e13fd550f1a47e9e68eba64a434782508b1bf221427c1486b","duration":43.7},"female":{"file":"y-310-female.m4a","bytes":323699,"sha256":"19ebccac2e9972fa0faafec1f7c35b436018c0df1b5306107552604b095ffaa7","duration":43.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.916,"text":"JESU Oluwa awa de,","marked":"Jésù Olúwa àwa dé"},{"start":2.296,"end":3.874,"text":"Loni Ojo Ajinde wa,","marked":"Lóní Ọjọ́ Àjíǹde wa"},{"start":4.254,"end":5.653,"text":"Lati gb'okan s'oke,","marked":"Láti gb'ókan s'òkè"},{"start":6.033,"end":7.442,"text":"Si Oruko re Mimo ni.","marked":"Sí Orúkọ rẹ Mímọ́́ ni."}],"end":7.442},{"key":"2","start":8.392,"lines":[{"start":8.392,"end":9.9,"text":"Ba wa pe Olorun Baba,","marked":"Bá wa pé Ọlọ́run Bàbá"},{"start":10.28,"end":11.495,"text":"Ba wa pe Olorun Omo,","marked":"Bá wa pe Ọlọ́run Ọmọ"},{"start":11.875,"end":13.279,"text":"Ba wa pe Olorun Emi,","marked":"Bá wa pé Ọlọ́run Ẹ̀mí"},{"start":13.659,"end":15.559,"text":"Wa so gbogbo wa di mimo.","marked":"Wá sọ gbogbo wa di mímọ́́."}],"end":15.559},{"key":"3","start":16.509,"lines":[{"start":16.509,"end":18.295,"text":"Lojo oni, awa dupe,","marked":"Lọ́jọ́ òní, àwa dúpẹ́"},{"start":18.675,"end":20.355,"text":"Teru teru l'awa josin,","marked":"Tèrú tẹrú l'áwá jọ́sìn"},{"start":20.735,"end":22.573,"text":"Gba wa lowo aiye osi yi,","marked":"Gbà wá lọ́wọ́ àìyẹ òṣì yí"},{"start":22.953,"end":25.15,"text":"Ma jek' a s' esin laiye yi.","marked":"Má jẹ́k' a s' ẹ̀sìn láìyé yí."}],"end":25.15},{"key":"4","start":26.1,"lines":[{"start":26.1,"end":27.604,"text":"Hosana s' Oba Olore,","marked":"Hósánà s' Ọba Olórè"},{"start":27.984,"end":29.654,"text":"A dupe fun Ajinde yi,","marked":"A dúpẹ́ fún Àjíǹde yí"},{"start":30.034,"end":31.925,"text":"F' Enikan na to jinde,","marked":"F' Ẹnìkan ná tó jíǹde"},{"start":32.305,"end":33.547,"text":"A sope fun Metalokan.","marked":"A ṣọpẹ́ fún Mẹ́talọ́kan."}],"end":33.547},{"key":"5","start":34.497,"lines":[{"start":34.497,"end":35.915,"text":"Ogo ni fun Baba l'oke","marked":"Ògo ni fún Bàbá l'òkè"},{"start":36.295,"end":37.556,"text":"Ogo ni fun Omo pelu,","marked":"Ògo ni fún Ọmọ pẹ̀lú"},{"start":37.936,"end":39.118,"text":"Ogo ni fun Emi Mimo,","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":39.498,"end":41.221,"text":"Ogo ni f' Olodumure.","marked":"Ògo ni f' Olodumure."},{"start":41.601,"end":42.064,"text":"Amin.","marked":"Àmín."}],"end":42.064}]}