{"v":1,"coll":"y","num":795,"id":"hymn_795","title":"AWA fe ohun aiye yi","duration":40.818,"voices":{"male":{"file":"y-795-male.m4a","bytes":286496,"sha256":"46dba26534a968dd20dec1a1f96dda9c888768e5a440f41f2c9bbf65ea5f3dba","duration":40.9},"female":{"file":"y-795-female.m4a","bytes":298589,"sha256":"c5d5c2fd76d7d9ff84fb25cdba5b985ce567d4fd96546b9460bd077cf05bcb1e","duration":40.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.606,"text":"AWA fe ohun aiye yi","marked":"Àwa fẹ́ ohun aiye yí"},{"start":1.986,"end":3.101,"text":"Nwon dara l'oju wa","marked":"Nwọn dára l'ojú wa"},{"start":3.481,"end":5.673,"text":"A fe k'a duro pe titi","marked":"A fẹ́ k'á dúró pẹ́ títí"},{"start":6.053,"end":7.367,"text":"Laifi won sile lo.","marked":"Láìfi wọ́n sílẹ̀ lọ."}],"end":7.367},{"key":"2","start":8.317,"lines":[{"start":8.317,"end":9.797,"text":"Nitori kini a nse be?","marked":"Nítorí kíni á ńṣe bẹ?"},{"start":10.177,"end":11.69,"text":"Aiye kan wa loke","marked":"Aiye kan wà lókè"},{"start":12.07,"end":13.554,"text":"Nibe l'ese on buburu","marked":"Níbẹ̀ l'ẹsẹ̀ ọn búburú"},{"start":13.934,"end":15.029,"text":"Ati ewu ko si.","marked":"Àti ewu kò sí."}],"end":15.029},{"key":"3","start":15.979,"lines":[{"start":15.979,"end":17.369,"text":"Aiye t'o wa loke orun","marked":"Aiye t'ó wà lókè ọ̀run"},{"start":17.749,"end":18.679,"text":"Awa iba je mo","marked":"Àwa ibà jẹ mọ́"},{"start":19.059,"end":21.067,"text":"Ayo, ife inu rere","marked":"Ayọ̀, ìfẹ́ inú rere"},{"start":21.447,"end":22.522,"text":"Gbogbo re wa n'be.","marked":"Gbogbo rẹ̀ wà ń'bẹ̀."}],"end":22.522},{"key":"4","start":23.472,"lines":[{"start":23.472,"end":25.707,"text":"Iku, o wa ni aiye yi","marked":"Ikú, ó wà ní àìyé yí"},{"start":26.087,"end":27.301,"text":"Ko si loke orun","marked":"Kò sí lókè ọ̀run"},{"start":27.681,"end":28.675,"text":"Eniyan Olorun wa mbe","marked":"Ènìyàn Ọlọ́run wá ḿbẹ"},{"start":29.055,"end":30.467,"text":"Ni aye ni aiku.","marked":"Ní ayé ni àìkú."}],"end":30.467},{"key":"5","start":31.417,"lines":[{"start":31.417,"end":33.244,"text":"K'a ba ona ti Jesu lo","marked":"K'á bá ọ̀nà tí Jésù lò"},{"start":33.624,"end":35.067,"text":"Eyi t'O la fun wa","marked":"Èyí t'Ó la fún wa"},{"start":35.447,"end":37.658,"text":"Sibi rere, sibi simi","marked":"Ṣíbí rere, ṣíbí símí"},{"start":38.038,"end":39.268,"text":"S'ile Olorun wa.","marked":"S'ilẹ̀ Ọlọ́run wà."}],"end":39.268}]}