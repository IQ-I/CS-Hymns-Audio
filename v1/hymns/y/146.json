{"v":1,"coll":"y","num":146,"id":"hymn_146","title":"ELEDA gbogbo aiye","duration":62.735,"voices":{"male":{"file":"y-146-male.m4a","bytes":426662,"sha256":"3852740ef0b2fe1d9fe2fe314a544ca17012fb64012aa719a2996270af5b66b4","duration":62.8},"female":{"file":"y-146-female.m4a","bytes":450353,"sha256":"ccfb84c29f3c8dc88f978e8022abca09cb96989650b41f7bfaf21ea847ddb3e3","duration":62.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.562,"text":"ELEDA gbogbo aiye","marked":"Ẹlẹ́dàá gbogbo aiye"},{"start":1.942,"end":2.835,"text":"Li ase Re ni","marked":"Lí àṣẹ Rẹ̀ ni"},{"start":3.215,"end":4.234,"text":"Awa pejo loni","marked":"Àwa péjọ lónì"},{"start":4.614,"end":5.979,"text":"Lati yin Oko Re.","marked":"Láti yin Ọkọ Rẹ."}],"end":5.979},{"key":"CHORUS","start":6.929,"lines":[{"start":6.929,"end":7.983,"text":"A dupe Iowo Re","marked":"A dúpẹ́ lọ́wọ́ Rẹ"},{"start":8.363,"end":9.177,"text":"Baba Olore,","marked":"Bàbá Ọlọ́rẹ́"},{"start":9.557,"end":10.794,"text":"Ki 'bukun Re orun","marked":"Kí 'bùkún Rẹ ọ̀run"},{"start":11.174,"end":12.228,"text":"Ba le gbogbo wa.","marked":"Bá lé gbogbo wa."}],"end":12.228},{"key":"2","start":13.178,"lines":[{"start":13.178,"end":14.308,"text":"Toju wa Baba orun","marked":"Tọ́jú wa Bàbá ọ̀run"},{"start":14.688,"end":15.821,"text":"Larin aiye wa yi","marked":"Lárin aiye wa yi"},{"start":16.201,"end":17.416,"text":"Pa wa mo k'o bo wa,","marked":"Pa wá mọ́ k'ó bò wá"},{"start":17.796,"end":18.967,"text":"Pese f'aini wa.","marked":"Pèsè f'áìnì wa."}],"end":18.967},{"key":"3","start":19.917,"lines":[{"start":19.917,"end":21.64,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":22.02,"end":23.383,"text":"E m'okan nyin le,","marked":"Ẹ̀ m'ọ̀kan nyin lé"},{"start":23.763,"end":24.902,"text":"Awa ni Baba nla","marked":"Àwa ni Bàbá ńlá"},{"start":25.282,"end":26.205,"text":"T'o mo edun wa.","marked":"T'ó mọ ẹ̀dùn wa."}],"end":26.205},{"key":"4","start":27.155,"lines":[{"start":27.155,"end":28.859,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":29.239,"end":30.443,"text":"E d'amure nyin","marked":"Ẹ d'àmùrè nyin"},{"start":30.823,"end":32.042,"text":"E ma fi aye sile","marked":"Ẹ má fi àyè sílẹ̀"},{"start":32.422,"end":33.469,"text":"Fun emi Esu.","marked":"Fún ẹ̀mí Èṣù."}],"end":33.469},{"key":"5","start":34.419,"lines":[{"start":34.419,"end":35.565,"text":"Enyin asaju wa,","marked":"Enyin aṣájú wa"},{"start":35.945,"end":36.897,"text":"E ku 'se Emi","marked":"Ẹ kú 'se Èmi"},{"start":37.277,"end":38.368,"text":"Olorun alaye","marked":"Ọlọ́run àlàyé"},{"start":38.748,"end":40.065,"text":"Yio wa pelu nyin.","marked":"Yíó wà pẹ̀lú nyin."}],"end":40.065},{"key":"6","start":41.015,"lines":[{"start":41.015,"end":42.16,"text":"Enyin Aladura","marked":"Enyin Alàdúrà"},{"start":42.54,"end":43.564,"text":"K'e ma gbadura","marked":"K'ẹ má gbàdúrà"},{"start":43.944,"end":45.573,"text":"Metalokan y'o gbo","marked":"Mẹ́talọ́kan y'ó gbọ́"},{"start":45.953,"end":47.273,"text":"Y'o segun fun wa.","marked":"Y'ó ṣẹ́gun fún wa."}],"end":47.273},{"key":"7","start":48.223,"lines":[{"start":48.223,"end":49.376,"text":"Gbogbo enyin agan,","marked":"Gbogbo enyin àgàn"},{"start":49.756,"end":51.001,"text":"Baba yio pese","marked":"Bàbá yìó pèsè"},{"start":51.381,"end":52.537,"text":"Enyin ti e bimo","marked":"Enyin tí ẹ bímọ"},{"start":52.917,"end":53.952,"text":"Gbogbo won yio la.","marked":"Gbogbo wọn yio la."}],"end":53.952},{"key":"8","start":54.902,"lines":[{"start":54.902,"end":56.235,"text":"Enyin t'e si loyun","marked":"Enyin t'ẹ́ sì lóyún"},{"start":56.615,"end":57.963,"text":"Jah yio s'abo nyin","marked":"Jah yio s'abo nyin"},{"start":58.343,"end":59.7,"text":"Enyin t'e ko ri se","marked":"Enyin t'ẹ́ kò rí ṣe"},{"start":60.08,"end":61.186,"text":"Jah yio pese.","marked":"Jah yíó pèsè."}],"end":61.186}]}