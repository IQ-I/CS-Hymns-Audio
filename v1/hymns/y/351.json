{"v":1,"coll":"y","num":351,"id":"hymn_351","title":"OKE kan mbe t'o ndan t'o ga","duration":47.909,"voices":{"male":{"file":"y-351-male.m4a","bytes":342060,"sha256":"619754159e2a530e7cd50f7f2ec81c7fb9f4992925c58f4b4d4fb5a1b4fc060d","duration":48.0},"female":{"file":"y-351-female.m4a","bytes":349571,"sha256":"ae1fb11a75c9cb12cbbfd9c69e1a3be686993577ce6983e2782f0c4d570743ba","duration":48.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.069,"text":"OKE kan mbe t'o ndan t'o ga","marked":"Òkè kan mbẹ́ t'ó ńdán t'ó ga"},{"start":2.449,"end":3.505,"text":"Nibi t'a m'Olorun","marked":"Níbi t'á m'Ọlọ́run"},{"start":3.885,"end":5.205,"text":"O wa l'okere ni orun","marked":"Ó wà l'òkèrè ní ọ̀run"},{"start":5.585,"end":6.792,"text":"Ite Olorun ni.","marked":"Ìtẹ́ Ọlọ́run ni."}],"end":6.792},{"key":"2","start":7.742,"lines":[{"start":7.742,"end":9.065,"text":"Tal'awon t'o sunmo ibe","marked":"Tal'àwọn t'ó súnmọ́ ibẹ̀"},{"start":9.445,"end":10.62,"text":"Lati wo ite Re?","marked":"Láti wo ìtẹ́ Rẹ?"},{"start":11.0,"end":12.743,"text":"Egbarun 'won t'o wa nibe","marked":"Egbárùn 'wọn t'ó wà níbẹ̀"},{"start":13.123,"end":14.24,"text":"Omode bi awa.","marked":"Ọmọdé bí àwa."}],"end":14.24},{"key":"3","start":15.19,"lines":[{"start":15.19,"end":16.542,"text":"Olugbala w'ese won nu","marked":"Olùgbàlà w'ẹsẹ̀ wọn nù"},{"start":16.922,"end":18.036,"text":"O so won di mimo","marked":"Ó sọ wọ́n di mímọ́́"},{"start":18.416,"end":19.251,"text":"Nwon f'oro Re, nwon f'ojo Re,","marked":"Nwọn f'ọ̀rọ̀ Rẹ, nwọn f'ọjọ́ Rẹ"},{"start":19.631,"end":21.592,"text":"Nwon fe, nwon si ri i.","marked":"Nwọ̀n fẹ́, nwọ̀n sì rí i."}],"end":21.592},{"key":"4","start":22.542,"lines":[{"start":22.542,"end":24.092,"text":"Labe opo oko tutu","marked":"Lábẹ́ ọ̀pọ̀ ọkọ̀ tútù"},{"start":24.472,"end":25.807,"text":"La'ara won simi si","marked":"La'ara wọn ṣímí sí"},{"start":26.187,"end":27.562,"text":"Nwon ri igbala okan won he","marked":"Nwọ̀n rí ìgbàlà ọkàn wọn he"},{"start":27.942,"end":29.132,"text":"Laiya Olugbala.","marked":"Láìyá Olùgbàlà."}],"end":29.132},{"key":"5","start":30.082,"lines":[{"start":30.082,"end":31.723,"text":"K'awa k'o rin bi nwon ti nrin","marked":"K'àwa k'ó rìn bí nwọn ti ńrìn"},{"start":32.103,"end":33.545,"text":"lpa t'o lo s' orun","marked":"lpa t'ó lọ s' ọ̀run"},{"start":33.925,"end":35.289,"text":"Wa idariji Olorun","marked":"Wá ìdáríjì Ọlọ́run"},{"start":35.669,"end":36.819,"text":"To ti dariji won.","marked":"Tó ti dariji wọn."}],"end":36.819},{"key":"6","start":37.769,"lines":[{"start":37.769,"end":39.498,"text":"Jesu ngbo irele ekun","marked":"Jésù ńgbọ́ ìrẹ̀lẹ̀ ẹkún"},{"start":39.878,"end":41.232,"text":"T'o mu okan d'otun","marked":"T'ó mú ọkàn d'ọ̀tun"},{"start":41.612,"end":43.874,"text":"Lori oke t'o dan, t'o ga","marked":"Lórí òkè t'ó dán, t'ó ga"},{"start":44.254,"end":45.384,"text":"L' awa o ma wo, O.","marked":"L' àwa ò mà wò, O."},{"start":45.764,"end":46.359,"text":"Amin.","marked":"Àmín."}],"end":46.359}]}