{"v":1,"coll":"y","num":3,"id":"hymn_3","title":"Ninu gbogbo ewu oru","duration":32.251,"voices":{"male":{"file":"y-3-male.m4a","bytes":219195,"sha256":"d7a63ebe5d178e8e8320366667b3e427db4ca058dec2cd536ae698f0b702cafa","duration":32.3},"female":{"file":"y-3-female.m4a","bytes":226447,"sha256":"2f74931b5af66863371300b30160bea021d5915aec777f1fc87add013a0c06ae","duration":32.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.392,"text":"Ninu gbogbo ewu oru,","marked":"Nínú gbogbo ewu òru"},{"start":1.772,"end":2.895,"text":"Oluwa l'o so mi","marked":"Olúwa l'ó sọ mí"},{"start":3.275,"end":4.938,"text":"Awa si tun ri' mole yi","marked":"Àwa sì tún rí' mọ́lẹ̀ yí"},{"start":5.318,"end":6.614,"text":"A tun te ekun ba.","marked":"A tún tẹ ẹkún bá."}],"end":6.614},{"key":"2","start":7.564,"lines":[{"start":7.564,"end":9.442,"text":"Oluwa, pa wa mo l'oni,","marked":"Olúwa, pa wá mọ́ l'ọ́nì"},{"start":9.822,"end":11.034,"text":"Fi apa Re so wa;","marked":"Fi apá Rẹ sọ wá"},{"start":11.414,"end":12.584,"text":"Kiki awon ti 'Wo pamo","marked":"Kìkì àwọn tí 'Wo pamọ́"},{"start":12.964,"end":14.134,"text":"L'o nyo ninu ewu.","marked":"L'ó nyo nínú ewu."}],"end":14.134},{"key":"3","start":15.084,"lines":[{"start":15.084,"end":16.941,"text":"K'oro wa, ati iwa wa","marked":"K'ọ́rọ́ wa, àti ìwà wa"},{"start":17.321,"end":18.733,"text":"Wipe, Tire l'awa,","marked":"Wípé, Tírè l'áwá"},{"start":19.113,"end":20.605,"text":"Tobe t'imole otito","marked":"Tobẹ t'ìmọ́lẹ̀̀ òtítọ́́"},{"start":20.985,"end":22.338,"text":"Le tan l'oju aiye.","marked":"Lè tán l'ojú aiye."}],"end":22.338},{"key":"4","start":23.288,"lines":[{"start":23.288,"end":24.874,"text":"Ma je k'a pada lodo Re,","marked":"Má jẹ k'á padà lọ́dọ̀ Rẹ"},{"start":25.254,"end":26.095,"text":"Olugbala owon","marked":"Olùgbàlà ọ̀wọ́n"},{"start":26.475,"end":28.221,"text":"Titi a o f'oju wa ri,","marked":"Títí a ò f'ojú wa rí"},{"start":28.601,"end":29.864,"text":"Oju Re li opin.","marked":"Ojú Rẹ li òpin."},{"start":30.244,"end":30.701,"text":"Amin.","marked":"Àmín."}],"end":30.701}]}