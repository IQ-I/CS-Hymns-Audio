{"v":1,"coll":"y","num":792,"id":"hymn_792","title":"EMI o ha lo lowo ofo?","duration":56.707,"voices":{"male":{"file":"y-792-male.m4a","bytes":398376,"sha256":"0f570dab9bf2a95d7f5650308c2d85d1aa283c2ed203dacecf3893fd37a1e0ac","duration":56.8},"female":{"file":"y-792-female.m4a","bytes":418060,"sha256":"6cff2819bcc02d18f60c611aeced93a92f872a60669d54acaa5e41aecfc8b5ac","duration":56.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.818,"text":"EMI o ha lo lowo ofo?","marked":"Èmi ò ha lọ lọ́wọ́ òfo?"},{"start":2.198,"end":3.502,"text":"Lati b'Oba Olorun mi","marked":"Láti b'Ọba Ọlọ́run mi"},{"start":3.882,"end":5.524,"text":"K'a ma jiya laiye yi tan","marked":"K'á má jìyà láìyẹ yí tán"},{"start":5.904,"end":7.342,"text":"K'a tun jiya ni orun.","marked":"K'á tún jìyà ní ọ̀run."}],"end":7.342},{"key":"CHORUS","start":8.292,"lines":[{"start":8.292,"end":10.384,"text":"Egbe: Jesu npe agbaiye, e wa","marked":"Jésù ńpe agbaiye, ẹ wá"},{"start":10.764,"end":12.116,"text":"Lati gba 'gbala I'ofe","marked":"Láti gba 'gbàlà l'ọ̀fẹ́"},{"start":12.496,"end":13.795,"text":"Ki oko 'gbehin to koja","marked":"Kí ọkọ̀ 'gbẹ̀hìn tó kọjá"},{"start":14.175,"end":15.72,"text":"Pe, ma bo enyin omo MI.","marked":"Pé, má bọ́ ẹ̀nyìn ọmọ Mi."}],"end":15.72},{"key":"2","start":16.67,"lines":[{"start":16.67,"end":18.235,"text":"Elese jowo yipada","marked":"Ẹlẹ́ṣẹ̀ jọ̀wọ́ yípadà"},{"start":18.615,"end":19.979,"text":"Ki oko 'gbehin to kun","marked":"Kí ọkọ̀ 'gbẹ̀hìn tó kún"},{"start":20.359,"end":21.81,"text":"Ki o ma ba ke abamo","marked":"Kí ó má bá ké àbámọ̀"},{"start":22.19,"end":23.779,"text":"Ni ojo igbehin yi.","marked":"Ní ọjọ́ ìgbẹ̀hìn yí."}],"end":23.779},{"key":"3","start":24.729,"lines":[{"start":24.729,"end":26.086,"text":"Enyin Om-Egbe Serafu","marked":"Enyin Om-Ègbè Séráfù"},{"start":26.466,"end":27.97,"text":"E mura si ise nyin","marked":"Ẹ múra sí iṣẹ́ nyin"},{"start":28.35,"end":29.63,"text":"Lati ma kede oro na","marked":"Láti má kéde ọ̀rọ̀ ná"},{"start":30.01,"end":31.656,"text":"K'oko 'gbehin to koja.","marked":"K'ọkọ̀ 'gbẹ̀hìn tó kọjá."}],"end":31.656},{"key":"4","start":32.606,"lines":[{"start":32.606,"end":34.078,"text":"Enyin Om-Egbe Kerubu","marked":"Enyin Om-Ẹgbẹ́ Kérúbù"},{"start":34.458,"end":35.738,"text":"E damure nyin giri","marked":"Ẹ dámùrè nyin gìrì"},{"start":36.118,"end":37.326,"text":"E ma j'afara adura","marked":"Ẹ má j'afara àdúrà"},{"start":37.706,"end":39.171,"text":"K'oko gbehin to kun tan.","marked":"K'ọkọ̀ gbẹ̀hìn tó kún tán."}],"end":39.171},{"key":"5","start":40.121,"lines":[{"start":40.121,"end":41.596,"text":"Enyin Egbe Aladura","marked":"Enyin Ẹgbẹ́ Alàdúrà"},{"start":41.976,"end":43.372,"text":"E gbe 'da segun soke","marked":"Ẹ gbé 'dá ṣẹ́gun sókè"},{"start":43.752,"end":45.173,"text":"Lati fi ba esu jagun","marked":"Láti fi bá èṣù jagun"},{"start":45.553,"end":46.959,"text":"Fun Kristi Oba Ogo.","marked":"Fún Kristi Ọba Ògo."}],"end":46.959},{"key":"6","start":47.909,"lines":[{"start":47.909,"end":49.822,"text":"Enyin Asaj' Egbe Seraf'","marked":"Enyin Àṣáj' Ẹgbẹ́ Séráf'"},{"start":50.202,"end":51.598,"text":"E wasu 'ihinrere Mi","marked":"Ẹ wasu 'ihinrere Mi"},{"start":51.978,"end":53.479,"text":"Ki e ba le gba 'de Ogo","marked":"Kí ẹ bá lè gbà 'dé Ògo"},{"start":53.859,"end":55.157,"text":"Ni ojo igbehin na.","marked":"Ní ọjọ́ ìgbẹ̀hìn ná."}],"end":55.157}]}