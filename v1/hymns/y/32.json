{"v":1,"coll":"y","num":32,"id":"hymn_32","title":"EYI I'ojo t'Oluwa da","duration":40.958,"voices":{"male":{"file":"y-32-male.m4a","bytes":289504,"sha256":"71f45a74bc8a3038f398b34c0775d5aaa86b4132b9e7425d3fb66b0c090c23ce","duration":41.0},"female":{"file":"y-32-female.m4a","bytes":299060,"sha256":"29cc2dbafcce173e3f13b16fa671faafb4da521d8ddf2cf4aad7e2ca5edf36d5","duration":41.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.8,"text":"EYI I'ojo t'Oluwa da,","marked":"Èyí l'ọjọ́ t'Olúwa da"},{"start":2.18,"end":3.464,"text":"O pe 'gba na ntire","marked":"Ó pẹ́ 'gba na ntirẹ"},{"start":3.844,"end":6.512,"text":"K'orun k'o yo, k'aiye ko yo","marked":"K'ọrùn k'ó yọ, k'áíyé kò yọ"},{"start":6.892,"end":8.058,"text":"K'iyin yi 'te na ka.","marked":"K'ìyìn yí 'té ná ká."}],"end":8.058},{"key":"2","start":9.008,"lines":[{"start":9.008,"end":10.473,"text":"Loni, o jinde 'nu oku","marked":"Lọ́ni, ó jíǹde 'nu òkú"},{"start":10.853,"end":11.994,"text":"ljoba Satan tu","marked":"ljọba Sátán tu"},{"start":12.374,"end":13.748,"text":"'Won mimo tan 'segun Re ka,","marked":"'Wọ́n mímọ́́ tan 'ṣẹ́gun Rẹ̀ ká"},{"start":14.128,"end":15.401,"text":"Nwon nsoro 'yanu Re.","marked":"Nwọ̀n ńsọ̀rọ̀ 'yanu Rẹ̀."}],"end":15.401},{"key":"3","start":16.351,"lines":[{"start":16.351,"end":18.017,"text":"Hosanna si Oba t'a yan","marked":"Hosanna sí Ọba t'á yan"},{"start":18.397,"end":19.603,"text":"S'Omo Mimo Dafidi","marked":"S'Ọmọ Mímọ́́ Dáfídì"},{"start":19.983,"end":21.741,"text":"Oluwa, jo sokale wa,","marked":"Olúwa, jọ sọ̀kalẹ̀ wa"},{"start":22.121,"end":23.344,"text":"T' lwo t'igbala Re.","marked":"T' lwo t'ìgbàlà Rẹ."}],"end":23.344},{"key":"4","start":24.294,"lines":[{"start":24.294,"end":25.853,"text":"Abukun l'Oluwa t'o wa","marked":"Àbùkún l'Olúwa t'ó wà"},{"start":26.233,"end":27.329,"text":"N'ise ore-ofe","marked":"N'iṣẹ́ ọ̀rẹ́-ọ̀fẹ́"},{"start":27.709,"end":29.263,"text":"T'o wa l'Oruko Baba Re,","marked":"T'ó wà l'Orúkọ Bàbá Rẹ"},{"start":29.643,"end":30.84,"text":"Lati gba 'ran wa la.","marked":"Láti gbà 'rán wa là."}],"end":30.84},{"key":"5","start":31.79,"lines":[{"start":31.79,"end":33.117,"text":"Hosanna li ohun goro,","marked":"Hosanna li ohùn gọ̀rọ̀"},{"start":33.497,"end":34.728,"text":"L'orin ljo t'aiye","marked":"L'orin ljọ t'áiye"},{"start":35.108,"end":36.505,"text":"Orin t'oke orun lohun","marked":"Orin t'òkè ọ̀run lohun"},{"start":36.885,"end":38.417,"text":"Yio dun ju be lo.","marked":"Yíó dùn jù bẹ́ lọ."},{"start":38.797,"end":39.408,"text":"Amin.","marked":"Àmín."}],"end":39.408}]}