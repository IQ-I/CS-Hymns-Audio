{"v":1,"coll":"y","num":771,"id":"hymn_771","title":"ISIN Jesu ni funni","duration":17.704,"voices":{"male":{"file":"y-771-male.m4a","bytes":121988,"sha256":"85293f4a0c9c63dca8550ad0f7e999fa1e2d0137891508214c04ead168cf6695","duration":17.8},"female":{"file":"y-771-female.m4a","bytes":127949,"sha256":"bcd273082c124a8a8e9d7c66d0dba1abe23da74dae04f4aa55f88eb1f7f9271d","duration":17.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.702,"text":"ISIN Jesu ni funni","marked":"Ìsìn Jésù ni fúnni"},{"start":2.082,"end":3.909,"text":"L'ayo toto, laiye yi","marked":"L'àyò tótọ́, láìyé yí"},{"start":4.289,"end":5.664,"text":"Isin Jesu ni funni","marked":"Ìsìn Jésù ni fúnni"},{"start":6.044,"end":7.443,"text":"N'itunu ninu iku.","marked":"N'ìtùnú nínú ikú."}],"end":7.443},{"key":"2","start":8.393,"lines":[{"start":8.393,"end":9.922,"text":"Lehin 'ku ayo na mbe","marked":"Lẹ́hìn 'kù ayọ̀ ná ḿbẹ"},{"start":10.302,"end":11.806,"text":"Ti ko ni d'opin lailai","marked":"Tí kò ní d'òpin láíláí"},{"start":12.186,"end":13.444,"text":"K'Olorun sa je temi","marked":"K'Ọlọ́run sá jẹ́ tèmi"},{"start":13.824,"end":15.129,"text":"Ayo mi ki o l'opin.","marked":"Ayò mi kí ó l'òpin."},{"start":15.509,"end":16.154,"text":"Amin.","marked":"Àmín."}],"end":16.154}]}