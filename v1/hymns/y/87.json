{"v":1,"coll":"y","num":87,"id":"hymn_87","title":"OPE lo ye f'Olugbala","duration":73.623,"voices":{"male":{"file":"y-87-male.m4a","bytes":526296,"sha256":"d74215e728c0ec6d53f06cc34e1b1162d139f9e206c948b5f81f09533dee2c19","duration":73.7},"female":{"file":"y-87-female.m4a","bytes":545819,"sha256":"fee9498c8245faab086b449f91d71b72fc95e16f514480b29b16076649579a17","duration":73.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.854,"text":"OPE lo ye f'Olugbala","marked":"Ọpẹ́ ló yé f'Olùgbàlà"},{"start":2.234,"end":3.439,"text":"Iyin fun Metalokan","marked":"Ìyìn fún Mẹ́talọ́kan"},{"start":3.819,"end":5.241,"text":"T'O da wa si d'ojo oni,","marked":"T'ó dá wa sí d'ọjọ́ òní"},{"start":5.621,"end":7.074,"text":"A f'ogo f'oruko Re.","marked":"A f'ògo f'orúkọ Rẹ̀."}],"end":7.074},{"key":"CHORUS","start":8.024,"lines":[{"start":8.024,"end":8.85,"text":"Korin Ogo, Alleluya,","marked":"Kọrin Ògo, Allelúyà"},{"start":9.23,"end":10.457,"text":"Orin ogo lao ko","marked":"Orin ògo laó kọ́"},{"start":10.837,"end":12.694,"text":"Korin Ogo, Alleluyah,","marked":"Kọrin Ògo, Allelúyàh"},{"start":13.074,"end":14.551,"text":"Ko Hosannah s'Oba wa.","marked":"Kò Hosannah s'Ọba wa."}],"end":14.551},{"key":"2","start":15.501,"lines":[{"start":15.501,"end":17.232,"text":"Metalokan Oba Ogo","marked":"Mẹ́talọ́kan Ọba Ògo"},{"start":17.612,"end":18.99,"text":"Baba fun wa l'agbara","marked":"Bàbá fún wa l'ágbára"},{"start":19.37,"end":21.003,"text":"F'awon asaju n'isegun","marked":"F'àwọn aṣájú ń'íṣègùn"},{"start":21.383,"end":22.944,"text":"Fun won l'ogbon at'oye","marked":"Fún wọn l'ọgbọ́n àt'òye"},{"start":23.324,"end":24.22,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":24.22},{"key":"3","start":25.17,"lines":[{"start":25.17,"end":26.539,"text":"Obangiji Oba Ogo,","marked":"Obangiji Ọba Ògo"},{"start":26.919,"end":28.157,"text":"Ranti Egbe Aladura,","marked":"Rántí Ẹgbẹ́ Alàdúrà"},{"start":28.537,"end":30.067,"text":"Fun won l'agbara at'ife","marked":"Fún wọn l'ágbára àt'ife"},{"start":30.447,"end":31.892,"text":"Ko won l'adura t'orun.","marked":"Kò wọ́n l'àdúrà t'ọrun."},{"start":32.272,"end":33.274,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":33.274},{"key":"4","start":34.224,"lines":[{"start":34.224,"end":35.848,"text":"Jehovah-Nissi Oba wa,","marked":"Jehovah-Nissi Ọba wa"},{"start":36.228,"end":37.387,"text":"Sanu f'Egbe Serafu;","marked":"Sanu f'Ẹgbẹ́ Séráfù"},{"start":37.767,"end":39.459,"text":"F'isegun f'Egbe Kerubu","marked":"F'íṣègùn f'Ẹgbẹ́ Kérúbù"},{"start":39.839,"end":41.267,"text":"Se wa gege bi t'orun.","marked":"Ṣe wà gẹ́gẹ́ bí t'ọrun."},{"start":41.647,"end":42.64,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":42.64},{"key":"5","start":43.59,"lines":[{"start":43.59,"end":45.322,"text":"Awon ti ko ri 'se yio ri,","marked":"Àwọn tí kò rí 'ṣe yìò rí"},{"start":45.702,"end":47.061,"text":"Agan a f'owo s'osun","marked":"Àgàn a f'ọwọ́ s'osùn"},{"start":47.441,"end":48.701,"text":"Olomo ko ni padanu,","marked":"Ọlọ́mọ kò ní pàdánù"},{"start":49.081,"end":50.716,"text":"Alaisan yio dide.","marked":"Aláìsàn yio dìde."},{"start":51.096,"end":52.07,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":52.07},{"key":"6","start":53.02,"lines":[{"start":53.02,"end":54.296,"text":"Gbo tiwa Baba wa orun","marked":"Gbọ́ tiwa Bàbá wa ọ̀run"},{"start":54.676,"end":55.859,"text":"Ranti Egbe idale,","marked":"Rántí Ẹgbẹ́ ìdálẹ̀"},{"start":56.239,"end":57.883,"text":"Fun won l'agbara at'ipa","marked":"Fún wọn l'ágbára àt'ipa"},{"start":58.263,"end":59.504,"text":"Fun gbogbo wa n'isegun","marked":"Fún gbogbo wa n'íṣègùn"},{"start":59.884,"end":60.643,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":60.643},{"key":"7","start":61.593,"lines":[{"start":61.593,"end":63.073,"text":"Jehovah Shammah Oba wa,","marked":"Jehovah Sham·mah Ọba wa"},{"start":63.453,"end":65.647,"text":"Gbat' o ba d'ojo ikehin","marked":"Gbat' ò bá d'ọjọ́ ìkẹhìn"},{"start":66.027,"end":67.768,"text":"Mu wa d'agbala itura,","marked":"Mú wa d'ágbálà ìtura"},{"start":68.148,"end":69.835,"text":"JAH mu wa de 'te Ogo.","marked":"Jah mú wa dé 'te Ògo."},{"start":70.215,"end":71.046,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"},{"start":71.426,"end":72.073,"text":"Amin.","marked":"Àmín."}],"end":72.073}]}