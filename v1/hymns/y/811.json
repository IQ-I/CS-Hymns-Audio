{"v":1,"coll":"y","num":811,"id":"hymn_811","title":"TA L'awon wonyi bi 'irawo","duration":59.123,"voices":{"male":{"file":"y-811-male.m4a","bytes":436132,"sha256":"a167cc7201c6b86ed23d6a24f30571bfcd0878e02c632b54864977e5318d56d5","duration":59.2},"female":{"file":"y-811-female.m4a","bytes":441675,"sha256":"c69e56c6d96aa1dc5815e4982553f92bd9ca0a5a8ecb3464247447f7e6f560ca","duration":59.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.011,"text":"TA L'awon wonyi bi 'irawo","marked":"Ta L'àwọn wọ̀nyí bí 'ìràwọ̀"},{"start":2.391,"end":3.511,"text":"Niwaju ite Mimo","marked":"Níwájú ìtẹ́ Mímọ́́"},{"start":3.891,"end":5.226,"text":"Ti nwon si de ade wura","marked":"Ti nwọn sì dé adé wúrà"},{"start":5.606,"end":7.207,"text":"Egbe ogo wo l'eyi","marked":"Ẹgbẹ́ ògo wó l'èyí"},{"start":7.587,"end":9.271,"text":"Gbo! nwon nko Halleluya","marked":"Gbọ́! nwọn ńkọ Hallelúyà"},{"start":9.651,"end":10.853,"text":"Orin iyin Oba won!","marked":"Orin ìyìn Ọba wọn!"}],"end":10.853},{"key":"2","start":11.803,"lines":[{"start":11.803,"end":13.241,"text":"Tali awon ti nko mana","marked":"Tali àwọn tí ńkọ mànà"},{"start":13.621,"end":15.011,"text":"T'a wo l'aso ododo?","marked":"T'á wo l'aṣọ òdodo?"},{"start":15.391,"end":16.595,"text":"Awon ti aso funfun won","marked":"Àwọn ti aṣọ funfun wọn"},{"start":16.975,"end":18.696,"text":"Y'o ma funfun titi lai","marked":"Y'ó ma funfun títí láí"},{"start":19.076,"end":20.594,"text":"Beni ki y'o gbo lailai","marked":"Bẹni kí y'ó gbọ́ láíláí"},{"start":20.974,"end":22.302,"text":"Nibo l'egbe yi ti wa?","marked":"Níbo l'ègbè yí ti wá?"}],"end":22.302},{"key":"3","start":23.252,"lines":[{"start":23.252,"end":24.56,"text":"Awon wonyi l'o ti jagun","marked":"Àwọn wọ̀nyí l'ó ti jagun"},{"start":24.94,"end":26.027,"text":"F'ola Olugbala won","marked":"F'ọlá Olùgbàlà wọn"},{"start":26.407,"end":28.196,"text":"Nwon jijakadi titi iku","marked":"Nwọ̀n jìjàkadì títí ikú"},{"start":28.576,"end":30.161,"text":"Nwon ki b'elese k'egbe","marked":"Nwọ̀n kí b'ẹlẹ́sẹ̀ k'ẹgbẹ́"},{"start":30.541,"end":32.032,"text":"Wonyin ni ko sa f'ogun","marked":"Wọ̀nyìn ni kò sá f'ogun"},{"start":32.412,"end":34.18,"text":"Nwon segun nipa Kristi.","marked":"Nwọ̀n ṣẹ́gun nípa Kristi."}],"end":34.18},{"key":"4","start":35.13,"lines":[{"start":35.13,"end":36.811,"text":"Wonyi l'okan won ti gbogbe","marked":"Wọ̀nyí l'ọkàn wọn ti gbọgbẹ́"},{"start":37.191,"end":38.515,"text":"Ninu 'danwo kikoro","marked":"Nínú 'dánwò kíkorò"},{"start":38.895,"end":40.353,"text":"Wonyi ni o ti f'adura","marked":"Wọ̀nyí ni o ti f'àdúrà"},{"start":40.733,"end":41.927,"text":"Mu Olorun gbo ti won","marked":"Mú Ọlọ́run gbọ́ tí wọ́n"},{"start":42.307,"end":43.684,"text":"Nisisyi won segun","marked":"Nísìsyí wọ́n ṣẹ́gun"},{"start":44.064,"end":45.61,"text":"Olorun re won lekun.","marked":"Ọlọ́run rẹ̀ wọ́n lẹ́kún."}],"end":45.61},{"key":"5","start":46.56,"lines":[{"start":46.56,"end":48.097,"text":"Awon wonyi l'o ti sora","marked":"Àwọn wọ̀nyí l'ó ti ṣọ́ra"},{"start":48.477,"end":50.231,"text":"Ti won fi fe won fun Krist'","marked":"Tí wọ́n fi fẹ́ wọn fún Krist'"},{"start":50.611,"end":51.988,"text":"Nwon si y'ara won si mimo","marked":"Nwọ̀n sì y'ára wọn sí mímọ́́"},{"start":52.368,"end":53.778,"text":"Lati sin nigbagbogbo","marked":"Láti sìn nígbàgbogbo"},{"start":54.158,"end":55.539,"text":"Nisisiyi li orun","marked":"Nisisiyi li orun"},{"start":55.919,"end":57.574,"text":"Nwon wa l'ayo l'odo Re.","marked":"Nwọ̀n wa l'àyò l'ọ̀dọ̀ Rẹ."}],"end":57.574}]}