{"v":1,"coll":"y","num":264,"id":"hymn_264","title":"IBU anu! O le je","duration":62.721,"voices":{"male":{"file":"y-264-male.m4a","bytes":456870,"sha256":"eab70ddda04b065d6219518fb1583036f4e3fdbe9934a6b53e7e74361cde6925","duration":62.8},"female":{"file":"y-264-female.m4a","bytes":480132,"sha256":"ba354c1b2174d8be4574678e84653d21796823fc68bd8ad71c893d187382ae30","duration":62.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.944,"text":"IBU anu! O le je","marked":"Ìbú ànú! Ó lè jẹ́"},{"start":2.324,"end":3.345,"text":"P' anu si mbe fun mi","marked":"P' ãnu sì ḿbẹ fún mi"},{"start":3.725,"end":4.851,"text":"Olorun le mu suru","marked":"Ọlọ́run lè mú ṣùrù"},{"start":5.231,"end":6.353,"text":"F' emi olori elese?","marked":"F' èmi olórí ẹlẹ́ṣẹ̀?"},{"start":6.733,"end":8.158,"text":"Mo ti ko or'ofe Re","marked":"Mo ti kọ́ or'ọ̀fẹ́ Rẹ"},{"start":8.538,"end":9.935,"text":"Mo bi n'nu lojukoju","marked":"Mo bí ń'nú lójúkojú"},{"start":10.315,"end":11.732,"text":"Nko f'eti si ipe Re","marked":"Nkọ f'etí sí ìpè Rẹ"},{"start":12.112,"end":13.583,"text":"Mo so ninu I'ainiye.","marked":"Mo sọ nínú l'àìníye."}],"end":13.583},{"key":"2","start":14.533,"lines":[{"start":14.533,"end":15.974,"text":"Mo tan a ni suru to","marked":"Mo tán a ní ṣùrù tó"},{"start":16.354,"end":17.851,"text":"Sibe o si da mi si","marked":"Síbẹ̀ ó ṣì dá mi sí"},{"start":18.231,"end":20.167,"text":"O nke, 'Ngo se jowo re","marked":"Ó nke, 'Ngo ṣe jọ̀wọ́ rẹ̀"},{"start":20.547,"end":22.009,"text":"Sa gba ago igbala","marked":"Sá gba àgọ́ ìgbàlà"},{"start":22.389,"end":23.467,"text":"Olugbala mi nduro","marked":"Olùgbàlà mi ńdúró"},{"start":23.847,"end":25.238,"text":"O si nfi ogbe Re han","marked":"Ó sì ńfi ọgbẹ́ Rẹ̀ hàn"},{"start":25.618,"end":27.251,"text":"Mo mo, ife l'Olorun","marked":"Mo mọ̀, ìfẹ́ l'Ọlọ́run"},{"start":27.631,"end":29.225,"text":"Jesu, nsun, O feran mi.","marked":"Jésù, ńsun, Ó fẹ́ràn mi."}],"end":29.225},{"key":"3","start":30.175,"lines":[{"start":30.175,"end":32.329,"text":"Jesu, dahun lat'oke","marked":"Jésù, dáhùn lát'òkè"},{"start":32.709,"end":34.41,"text":"Ife k'iwa Re gbogbo?","marked":"Ìfẹ́ k'íwà Rẹ gbogbo?"},{"start":34.79,"end":36.271,"text":"'Wo ki y'o dariji mi","marked":"'Wò kí y'ó dariji mi"},{"start":36.651,"end":37.911,"text":"Ki nwole ii ese Re?","marked":"Kí ńwọlé ìí ẹsẹ̀ Rẹ?"},{"start":38.291,"end":39.516,"text":"Bi m'ba mo inu Re re","marked":"Bí m'bá mọ inú Rẹ̀ rẹ́"},{"start":39.896,"end":41.277,"text":"B'Iwo 'ba se alanu","marked":"B'Ìwo 'bá ṣe alanu"},{"start":41.657,"end":42.806,"text":"F'anu deti Re sile","marked":"F'ánú dẹtí Rẹ sílẹ̀"},{"start":43.186,"end":45.236,"text":"Dariji, k'o si gba mi.","marked":"Dáríjì, k'ó sì gbà mí."}],"end":45.236},{"key":"4","start":46.186,"lines":[{"start":46.186,"end":47.624,"text":"F'oju iyonu wo mi","marked":"F'ojú ìyọnu wò mí"},{"start":48.004,"end":49.134,"text":"Fi wiwo oju pe mi","marked":"Fi wíwo ojú pè mí"},{"start":49.514,"end":50.985,"text":"Mu okan okuta ro","marked":"Mú ọkàn òkúta rò"},{"start":51.365,"end":53.08,"text":"Yipada, ro mi lokan","marked":"Yípadà, rò mí lọ́kàn"},{"start":53.46,"end":54.492,"text":"Mu'mi ronupiwada","marked":"Mu'mi ronúpìwàdà"},{"start":54.872,"end":56.163,"text":"Je ki ngbawe f'ese mi","marked":"Jẹ́ kí ńgbàwé f'ẹsẹ̀ mi"},{"start":56.543,"end":57.993,"text":"Ki nsi kanu ise mi","marked":"Kí nsì kanú iṣẹ́ mi"},{"start":58.373,"end":60.175,"text":"Ki ngbagbo, ki nye dese.","marked":"Kí ńgbàgbọ́, kí nye dẹ́ṣẹ̀."},{"start":60.555,"end":61.172,"text":"Amin.","marked":"Àmín."}],"end":61.172}]}