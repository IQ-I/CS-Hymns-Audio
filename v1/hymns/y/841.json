{"v":1,"coll":"y","num":841,"id":"hymn_841","title":"OMO Egbe Kerubu Serafu","duration":54.084,"voices":{"male":{"file":"y-841-male.m4a","bytes":396969,"sha256":"917acba699be6f6e6f8bd7d35f1dad53ff3c665682584dbf5b8f6d1baacd698a","duration":54.1},"female":{"file":"y-841-female.m4a","bytes":406182,"sha256":"69445393fe18397b5048ca9815d0b07d93aa2eb60e040dba9a0a1b8d7fcdae51","duration":54.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.9,"text":"OM' Egbe Kerubu Serafu","marked":"Om' Ẹgbẹ́ Kérúbù Séráfù"},{"start":2.28,"end":3.5,"text":"Sora iru ohun to nghin","marked":"Ṣọ́ra irú ohun tó nghin"},{"start":3.88,"end":5.916,"text":"Yala alikama tab' epo","marked":"Yálà àlìkámà tab' epo"},{"start":6.296,"end":8.081,"text":"Ohun to ba gbin n'iwo o ka.","marked":"Ohun tó bá gbìn ń'íwò ò ká."}],"end":8.081},{"key":"CHORUS","start":9.031,"lines":[{"start":9.031,"end":10.756,"text":"Ohun to ba gbin n'iwo o ka - 2ce","marked":"Ohun tó bá gbìn ń'íwò ò ká"},{"start":11.136,"end":12.406,"text":"Akoko ikore tete","marked":"Àkókò ìkórè tẹ́tẹ́"},{"start":12.786,"end":14.261,"text":"Ohun to ba gbin n'iwo o ka.","marked":"Ohun tó bá gbìn ń'íwò ò ká."}],"end":14.261},{"key":"2","start":15.211,"lines":[{"start":15.211,"end":18.018,"text":"Gbin 'bukun, ibukun y'o si pon","marked":"Gbin 'bùkún, ìbùkún y'ó sì pọ́n"},{"start":18.398,"end":20.88,"text":"Gbin irora, y'o si dagba","marked":"Gbin ìrora, y'ó sì dàgbà"},{"start":21.26,"end":23.473,"text":"Gbin anu, wo o si gbadun re,","marked":"Gbin ànú, wò ó sì gbádùn rẹ̀"},{"start":23.853,"end":25.324,"text":"Ohun to ba gbin n'iwo o sa.","marked":"Ohun tó bá gbìn ń'íwò ò sá."}],"end":25.324},{"key":"3","start":26.274,"lines":[{"start":26.274,"end":28.855,"text":"Gbin ife, ife yio si tan","marked":"Gbin ìfẹ́, ìfẹ́ yío sì tán"},{"start":29.235,"end":30.445,"text":"Si inu gbogbo okan re","marked":"Sí inú gbogbo ọkàn rẹ"},{"start":30.825,"end":33.058,"text":"Gbin ireti, si ka eso re","marked":"Gbin ìrètí, sì ká èso rẹ"},{"start":33.438,"end":35.175,"text":"Ohun to ba gbin n'iwo o ka.","marked":"Ohun tó bá gbìn ń'íwò ò ká."}],"end":35.175},{"key":"4","start":36.125,"lines":[{"start":36.125,"end":38.26,"text":"N'igbagbo, gbin oro Oluwa","marked":"N'ìgbàgbọ́́, gbin ọ̀rọ̀ Olúwa"},{"start":38.64,"end":40.157,"text":"Wo o si ri 'bukun re gba","marked":"Wò ó sì rí 'bùkún rẹ gbà"},{"start":40.537,"end":41.917,"text":"Opo irawo n'nu ade re","marked":"Ọ̀pọ̀ ìràwọ̀ ń'nú adé rẹ"},{"start":42.297,"end":43.96,"text":"Ohun to ba gbin n'iwo o ka.","marked":"Ohun tó bá gbìn ń'íwò ò ká."}],"end":43.96},{"key":"5","start":44.91,"lines":[{"start":44.91,"end":46.702,"text":"Wasu Kristi pelu 'kanu Re","marked":"Wásù Kristi pẹ̀lú 'kánú Rẹ̀"},{"start":47.082,"end":48.501,"text":"K'aiye le mo igbala Re","marked":"K'aiye lè mọ ìgbàlà Rẹ"},{"start":48.881,"end":50.695,"text":"Wo yio ka iye ainipekun","marked":"Wò yíó ka ìyè àìnípẹ̀kun"},{"start":51.075,"end":52.534,"text":"Ohun to ba gbin n'iwo o ka.","marked":"Ohun tó bá gbìn ń'íwò ò ká."}],"end":52.534}]}