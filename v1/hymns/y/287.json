{"v":1,"coll":"y","num":287,"id":"hymn_287","title":"GBOGB' ogo, iyin, ola","duration":53.912,"voices":{"male":{"file":"y-287-male.m4a","bytes":385291,"sha256":"a6eee63d1a7ce9c102f0f01ae0e1b87e74c976cc153c57fad246edee25c0d11b","duration":54.0},"female":{"file":"y-287-female.m4a","bytes":397672,"sha256":"515cd3960c339672471d14059ccf5916fc6a3087c59c33b5dafe495b077b04c7","duration":54.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.855,"text":"GBOGB' ogo, iyin, ola","marked":"Gbogb' ògo, ìyìn, ọ̀la"},{"start":2.235,"end":3.765,"text":"Fun O, Oludande","marked":"Fún Ọ, Olùdáǹdè"},{"start":4.145,"end":6.035,"text":"S'Eni t'awon omode","marked":"S'Ẹ́ni t'àwọn ọmọdé"},{"start":6.415,"end":7.711,"text":"Ko Hosanna didun!","marked":"Kò Hosanna dídùn!"},{"start":8.091,"end":9.705,"text":"'Wo! l'Oba lsreali","marked":"'Wò! l'Ọba lsreali"},{"start":10.085,"end":11.164,"text":"Om'Alade Dafidi","marked":"Om'Aládé Dáfídì"},{"start":11.544,"end":12.891,"text":"T'o wa l'Oko Oluwa","marked":"T'ó wà l'Ọkọ Olúwa"},{"start":13.271,"end":14.299,"text":"Oba Olubukun.","marked":"Ọba Olùbùkún."}],"end":14.299},{"key":"CHORUS","start":15.249,"lines":[{"start":15.249,"end":16.948,"text":"Gbogb'ogo, iyin, ola","marked":"Gbogb'ògo, ìyìn, ọ̀la"},{"start":17.328,"end":19.096,"text":"Fun O, Oludande,","marked":"Fún Ọ, Olùdáǹdè"},{"start":19.476,"end":20.906,"text":"S'Eni t'awon omode","marked":"S'Ẹ́ni t'àwọn ọmọdé"},{"start":21.286,"end":22.6,"text":"Ko Hosanna didun.","marked":"Kò Hosanna dídùn."}],"end":22.6},{"key":"2","start":23.55,"lines":[{"start":23.55,"end":24.746,"text":"Egbe awon Maleka","marked":"Ẹgbẹ́ àwọn Málékà"},{"start":25.126,"end":26.221,"text":"Nyin O Ioke giga","marked":"Nyin O lókè gíga"},{"start":26.601,"end":28.135,"text":"Awa at'eda gbogbo","marked":"Àwa àt'ẹ̀dà gbogbo"},{"start":28.515,"end":29.877,"text":"Si dapo gberin na.","marked":"Sì dàpọ̀ gbẹ̀rín ná."}],"end":29.877},{"key":"3","start":30.827,"lines":[{"start":30.827,"end":32.333,"text":"Awon Hebru lo saju","marked":"Àwọn Hebru ló ṣájú"},{"start":32.713,"end":33.698,"text":"Pelu imo ope","marked":"Pẹ̀lú ìmọ̀ ọ̀pẹ"},{"start":34.078,"end":35.808,"text":"lyin, adua at'orin","marked":"lyin, àdùà àt'orin"},{"start":36.188,"end":37.569,"text":"L'a mu wa 'waju Re.","marked":"L'á mú wa 'wájú Rẹ̀."}],"end":37.569},{"key":"4","start":38.519,"lines":[{"start":38.519,"end":39.863,"text":"Si O saju iya Re","marked":"Sí Ọ ṣájú ìyá Rẹ"},{"start":40.243,"end":41.213,"text":"Nwon korin iyin won","marked":"Nwọ̀n kọrin ìyìn wọn"},{"start":41.593,"end":43.356,"text":"Wo t'a gbe ga nisisyi","marked":"Wo t'á gbé ga nísìsyí"},{"start":43.736,"end":44.799,"text":"L'a nkorin iyin si.","marked":"L'á nkorin ìyìn sí."}],"end":44.799},{"key":"5","start":45.749,"lines":[{"start":45.749,"end":46.99,"text":"'Wo gba orin iyin won","marked":"'Wo gba orin ìyìn wọn"},{"start":47.37,"end":48.879,"text":"Gb'adura t'a mu wa","marked":"Gb'àdúrà t'á mú wá"},{"start":49.259,"end":50.923,"text":"Wo ti nyo s'ohun rere","marked":"Wo ti nyo s'óhun rere"},{"start":51.303,"end":52.362,"text":"Oba wa Olore.","marked":"Ọba wá Ọlọ́rẹ."}],"end":52.362}]}