{"v":1,"coll":"y","num":812,"id":"hymn_812","title":"EMI ogbon, to oju wa","duration":58.337,"voices":{"male":{"file":"y-812-male.m4a","bytes":421855,"sha256":"c33f34cbefbb679d7abd8cf7cfd5444306c800159a1bc670abe8ffa4d34903dd","duration":58.4},"female":{"file":"y-812-female.m4a","bytes":440226,"sha256":"41c200bb57a7358d3cff8ee6500c0aedcfbc85f44db4b2c9e0e3876d6c7f74d9","duration":58.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.953,"text":"EMI ogbon, to oju wa","marked":"Ẹ̀mí ọgbọ́n, tó ojú wa"},{"start":2.333,"end":3.567,"text":"Kuro ninu asan aye","marked":"Kúrò nínú asán ayé"},{"start":3.947,"end":5.149,"text":"S'oto on 'fe orun","marked":"S'ọ́tọ̀ on 'fẹ́ ọ̀run"},{"start":5.529,"end":6.883,"text":"Emi oye ti o daju","marked":"Ẹ̀mí òye tí ó dájú"},{"start":7.263,"end":8.627,"text":"Fi mole orun fun wa","marked":"Fi mọ́lẹ̀ ọ̀run fún wa"},{"start":9.007,"end":10.454,"text":"Lati wa nkan toke.","marked":"Láti wá nkan tòkè."}],"end":10.454},{"key":"2","start":11.404,"lines":[{"start":11.404,"end":12.693,"text":"Emi 'moran s'Amona wa","marked":"Èmi 'mọ̀ràn s'Amọ̀nà wa"},{"start":13.073,"end":14.705,"text":"F'ijakadi aye ko wa","marked":"F'ìjàkadì ayé kọ́ wa"},{"start":15.085,"end":16.556,"text":"K'a gba ade t'orun","marked":"K'á gba adé t'ọrun"},{"start":16.936,"end":18.723,"text":"Emi 'gboya, k'agbara Re","marked":"Èmi 'gboyà, k'ágbára Rẹ"},{"start":19.103,"end":20.591,"text":"Ran wa lowo nigba 'danwo","marked":"Ràn wá lọ́wọ́ nígbà 'dánwò"},{"start":20.971,"end":22.473,"text":"Pa wa mo lailese.","marked":"Pa wá mọ́ láìlèṣe."}],"end":22.473},{"key":"3","start":23.423,"lines":[{"start":23.423,"end":25.567,"text":"Emi imo, to ese wa","marked":"Ẹ̀mí ìmọ̀, tó ẹsẹ̀ wa"},{"start":25.947,"end":27.718,"text":"Li ona Re ti ko l'ewu","marked":"Lí ọ̀nà Rẹ tí kò l'ewu"},{"start":28.098,"end":29.26,"text":"T'awon angel 'ti rin","marked":"T'áwọn angel 'ti rìn"},{"start":29.64,"end":31.426,"text":"Nib i t'Iwo Oluto wa","marked":"Níb i t'Ìwò Olùtọ́ wa"},{"start":31.806,"end":33.151,"text":"Iwo Emi ifokansin","marked":"Ìwọ Ẹ̀mí ìfọkànsìn"},{"start":33.531,"end":34.698,"text":"Mu wa sunm'Olorun.","marked":"Mú wa sùnm'Ọlọ́run."}],"end":34.698},{"key":"4","start":35.648,"lines":[{"start":35.648,"end":36.932,"text":"Sunmo wa lojo aye wa","marked":"Súnmọ́ wà lọ́jọ́ ayé wa"},{"start":37.312,"end":38.312,"text":"Emi iberu Olorun","marked":"Ẹ̀mí ìbẹ̀rù Ọlọ́run"},{"start":38.692,"end":39.889,"text":"N'ikoko aya wa","marked":"N'ìkòkò àyà wa"},{"start":40.269,"end":41.781,"text":"F'owo t'o ye kun okan wa","marked":"F'ọwọ́ t'ó yẹ kún ọkàn wa"},{"start":42.161,"end":43.466,"text":"Lati sin ife mimo Re","marked":"Láti sin ìfẹ́ mímọ́́ Rẹ"},{"start":43.846,"end":45.076,"text":"T'o l'ododo julo.","marked":"T'ó l'òdodo jùlọ."}],"end":45.076},{"key":"5","start":46.026,"lines":[{"start":46.026,"end":47.89,"text":"Ma to wa lo l'alafia","marked":"Má tó wá lọ l'àlàáfíà"},{"start":48.27,"end":49.803,"text":"Sinu iye ainipekun","marked":"Sínú ìyè àìnípẹ̀kun"},{"start":50.183,"end":51.313,"text":"K'a jere giga na","marked":"K'á jèrè gíga ná"},{"start":51.693,"end":53.268,"text":"K'a ja ogun aye wa yi","marked":"K'á ja ogun ayé wa yí"},{"start":53.648,"end":54.879,"text":"Nipa agbara Re mimo","marked":"Nípa agbára Rẹ mímọ́́"},{"start":55.259,"end":56.787,"text":"K'a si ba Krist'joba.","marked":"K'á sì bá Krist'jọba."}],"end":56.787}]}