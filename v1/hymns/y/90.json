{"v":1,"coll":"y","num":90,"id":"hymn_90","title":"AWA dupe, awa t'ope da,","duration":59.454,"voices":{"male":{"file":"y-90-male.m4a","bytes":417022,"sha256":"913450ff70b66b0720fa2d62c3b5a9fbca0b9b6c592b3f91da8d6569247ceb5a","duration":59.5},"female":{"file":"y-90-female.m4a","bytes":427001,"sha256":"5b6e68ef3a4d7272300225fe94d960a60e223b029d29fa8ec2769e8d6b9aefb8","duration":59.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.229,"text":"AWA dupe, awa t'ope da,","marked":"Àwa dúpẹ́, àwa t'ọpẹ́ dà"},{"start":2.609,"end":4.78,"text":"T'o ti pa agbara ina ileru","marked":"T'ó ti pa agbára iná ìléru"},{"start":5.16,"end":6.785,"text":"Egbe:  Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":7.165,"end":8.67,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."}],"end":8.67},{"key":"CHORUS","start":9.62,"lines":[{"start":9.62,"end":11.297,"text":"Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":11.677,"end":13.22,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."}],"end":13.22},{"key":"2","start":14.17,"lines":[{"start":14.17,"end":17.545,"text":"Aje, oso at'alawirin, sonponna,","marked":"Ajé, ọ̀ṣọ́ at'aláwírin, ṣóńpọ́nná"},{"start":17.925,"end":19.745,"text":"Irun-Mole ti di 'temole.","marked":"Irun-Mọ́lẹ̀ ti di 'tèmọ́lẹ̀."},{"start":20.125,"end":20.947,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":20.947},{"key":"3","start":21.897,"lines":[{"start":21.897,"end":23.119,"text":"Awa omo egbe Serafu,","marked":"Àwa ọmọ ẹgbẹ́ Séráfù"},{"start":23.499,"end":25.559,"text":"E mura ka si le te esu mole.","marked":"Ẹ múra ká sì lè tẹ èṣù mọ́lẹ̀."},{"start":25.939,"end":26.802,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":26.802},{"key":"4","start":27.752,"lines":[{"start":27.752,"end":29.21,"text":"Enit' o ro p'on ti duro","marked":"Enit' ò ro p'ọ́n ti dúró"},{"start":29.59,"end":31.698,"text":"K'o sora ki o ma ba subu lule.","marked":"K'ó ṣọ́ra kí ó má bá ṣubú lulẹ̀."},{"start":32.078,"end":32.818,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":32.818},{"key":"5","start":33.768,"lines":[{"start":33.768,"end":35.301,"text":"Orin Halleluyah l'ao ko","marked":"Orin Hallelúyà l'áo kọ́"},{"start":35.681,"end":38.262,"text":"'Gbati gbogbo idanwo ba koja lo.","marked":"'Gbàtì gbogbo ìdánwò bá kọjá lọ."},{"start":38.642,"end":39.435,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":39.435},{"key":"6","start":40.385,"lines":[{"start":40.385,"end":41.994,"text":"E f'ogo fun Baba wa l'oke","marked":"Ẹ f'ògo fún Bàbá wa l'òkè"},{"start":42.374,"end":44.252,"text":"Ka si f'ogo f'Omo Re l'orun.","marked":"Ká sì f'ògo f'Ọmọ Rẹ l'ọ̀run."},{"start":44.632,"end":45.507,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":45.507},{"key":"7","start":46.457,"lines":[{"start":46.457,"end":47.991,"text":"K'a f'ogo fun Emi Mimo","marked":"K'á f'ògo fún Ẹ̀mí Mímọ́́"},{"start":48.371,"end":50.266,"text":"Metalokan si l'ope ye fun.","marked":"Mẹ́talọ́kan sì l'ọpẹ́ yẹ fún."},{"start":50.646,"end":51.475,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":51.475},{"key":"8","start":52.425,"lines":[{"start":52.425,"end":54.054,"text":"Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":54.434,"end":55.815,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."},{"start":56.195,"end":57.001,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"},{"start":57.381,"end":57.904,"text":"Amin.","marked":"Àmín."}],"end":57.904}]}