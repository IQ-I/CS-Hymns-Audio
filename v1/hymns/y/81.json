{"v":1,"coll":"y","num":81,"id":"hymn_81","title":"E YO nin'Oluwa, e yo","duration":58.289,"voices":{"male":{"file":"y-81-male.m4a","bytes":417729,"sha256":"9b5f3eb2e55468e95f0aba8c967d71ff0350f03c25aa48fb3da96944b1ac099b","duration":58.3},"female":{"file":"y-81-female.m4a","bytes":434449,"sha256":"21a2f665005d00c61c3014cd37fa222ab745b6717418150a92cf8a5a3cafbc66","duration":58.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.107,"text":"E YO nin'Oluwa, e yo","marked":"Ẹ Yọ̀ nín'Olúwa, ẹ yọ̀"},{"start":2.487,"end":3.783,"text":"enyin olokan diduro","marked":"enyin ọlọ́kàn dídúró"},{"start":4.163,"end":6.633,"text":"At'enyin t'ase l'ayanfe","marked":"Àt'ẹnyin t'àsè l'àyànfẹ́"},{"start":7.013,"end":8.637,"text":"Mu 'banuje kuro l'okan nyin.","marked":"Mu 'banújẹ́ kúrò l'ọkàn nyin."}],"end":8.637},{"key":"CHORUS","start":9.587,"lines":[{"start":9.587,"end":12.202,"text":"E yo, e yo, e yo nin' Oluwa,","marked":"Ẹ yọ̀, ẹ yó, ẹ yọ̀ nín' Olúwa"},{"start":12.582,"end":13.147,"text":"e yo. 2ce","marked":"ẹ yọ."}],"end":13.147},{"key":"2","start":14.097,"lines":[{"start":14.097,"end":15.628,"text":"E yo n'tori On l'Oluwa,","marked":"Ẹ yò n'torí Ọ̀n l'Olúwa"},{"start":16.008,"end":18.061,"text":"L' aiye ati l'orun pelu","marked":"L' aiye àti l'orun pẹ̀lú"},{"start":18.441,"end":19.926,"text":"O njoba nipa ase Re,","marked":"Ó njoba nípa àṣẹ Rẹ̀"},{"start":20.306,"end":21.851,"text":"O l'agbara lati gbala.","marked":"Ó l'ágbára láti gbala."},{"start":22.231,"end":23.583,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yó, ẹ yó"}],"end":23.583},{"key":"3","start":24.533,"lines":[{"start":24.533,"end":26.114,"text":"Nigbati ogun ba gbona","marked":"Nígbàtí ogun bá gbóná"},{"start":26.494,"end":27.893,"text":"T'ota ba fere segun nyin","marked":"T'ọ̀tá bá fẹ́rẹ̀ ṣẹ́gun nyin"},{"start":28.273,"end":30.088,"text":"Ogun Jesu ti a ko ri,","marked":"Ogún Jésù tí a kò rí"},{"start":30.468,"end":32.081,"text":"Po ju gbogbo otan nyin lo.","marked":"Pọ̀ ju gbogbo ọ̀tàn nyin lọ."},{"start":32.461,"end":33.834,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yó, ẹ yó"}],"end":33.834},{"key":"4","start":34.784,"lines":[{"start":34.784,"end":36.574,"text":"B'osan d'orun mo nyin loju,","marked":"B'ọ̀sán d'ọrùn mo nyin lójú"},{"start":36.954,"end":38.663,"text":"T'okunkun re nderu ba nyin","marked":"T'òkùnkùn rẹ ńdẹ́rù bá nyín"},{"start":39.043,"end":40.761,"text":"E ma je k'okan nyin baje","marked":"Ẹ má jẹ k'ókan nyin bàjẹ́"},{"start":41.141,"end":43.004,"text":"Gbekele tit' ewu yio tan.","marked":"Gbẹ́kẹ̀lé tít' ewu yio tán."},{"start":43.384,"end":44.886,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yó, ẹ yó"}],"end":44.886},{"key":"5","start":45.836,"lines":[{"start":45.836,"end":47.646,"text":"E yo nin'Oluwa, e yo","marked":"Ẹ yó nín'Olúwa, ẹ yọ"},{"start":48.026,"end":49.58,"text":"E f'orin didun yin logo","marked":"Ẹ f'orin dídùn yín lógo"},{"start":49.96,"end":52.065,"text":"Fi duru, fere, at'ohun","marked":"Fi dùrù, fèrè, àt'ohun"},{"start":52.445,"end":54.036,"text":"Korin Halleluyah kikan.","marked":"Kọrin Hallelúyà kíkan."},{"start":54.416,"end":55.703,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yó, ẹ yó"},{"start":56.083,"end":56.739,"text":"Amin.","marked":"Àmín."}],"end":56.739}]}