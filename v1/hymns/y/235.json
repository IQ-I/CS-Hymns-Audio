{"v":1,"coll":"y","num":235,"id":"hymn_235","title":"MO ri ayo n'nu banuje","duration":63.094,"voices":{"male":{"file":"y-235-male.m4a","bytes":457623,"sha256":"c5f69ab69da1d2c1985519885bc46dff914fa1f0756cbfeb7d16a2a2b9edd590","duration":63.1},"female":{"file":"y-235-female.m4a","bytes":471605,"sha256":"3ba6f4889f3e2f2f0d00ca4b4936fd335a9085afd6456b1eb317601f42d2bfc2","duration":63.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.778,"text":"MO ri ayo n'nu banuje","marked":"Mo rí ayọ̀ ń'nú bànújẹ́"},{"start":2.158,"end":3.116,"text":"Ogun fun irora","marked":"Ogún fún ìrora"},{"start":3.496,"end":5.09,"text":"Mo r'ojo nla t'o dara","marked":"Mo r'ọjọ́ ńlá t'ó dára"},{"start":5.47,"end":6.554,"text":"T'o ran lehin ojo","marked":"T'ó rán lẹ́hìn ọjọ́"},{"start":6.934,"end":8.226,"text":"Mo ri'ran lehin ojo","marked":"Mo rí'ran lẹ́hìn ọjọ́"},{"start":8.606,"end":9.806,"text":"Mo r'eka 'mularada","marked":"Mo r'ẹ̀ka 'múláradá"},{"start":10.186,"end":11.766,"text":"Nibi isun ki ikoro.","marked":"Níbi ìsun kí ìkorò."}],"end":11.766},{"key":"CHORUS","start":12.716,"lines":[{"start":12.716,"end":14.12,"text":"lleri jeje t'a se","marked":"lleri jẹ́jẹ́ t'á ṣe"},{"start":14.5,"end":15.612,"text":"Fun eniti njaya,","marked":"Fún ẹniti ńjayà"},{"start":15.992,"end":17.417,"text":"lleri jeje t'a se","marked":"lleri jẹ́jẹ́ t'á ṣe"},{"start":17.797,"end":18.9,"text":"Fun eniti njaya.","marked":"Fún ẹniti ńjayà."}],"end":18.9},{"key":"2","start":19.85,"lines":[{"start":19.85,"end":21.092,"text":"Ninu irin ajo mi","marked":"Nínú ìrìn àjò mi"},{"start":21.472,"end":22.679,"text":"Mo ba Jesu pade","marked":"Mo bá Jésù pàdé"},{"start":23.059,"end":24.171,"text":"Ti o f'okan mi bale","marked":"Tí o f'ọkàn mi balẹ̀"},{"start":24.551,"end":26.001,"text":"Lati ri anu gba","marked":"Láti rí ànú gbà"},{"start":26.381,"end":27.938,"text":"Anu ti nko Ie gbagbe","marked":"Ànú tí ńkọ́ lè gbàgbé"},{"start":28.318,"end":29.621,"text":"lf'aiya bale nla.","marked":"lf'aiya balẹ̀ ńlá."},{"start":30.001,"end":31.416,"text":"Egbe:  lleri jeje t'a se...","marked":"lleri jẹ́jẹ́ t'á ṣe"}],"end":31.416},{"key":"3","start":32.366,"lines":[{"start":32.366,"end":33.611,"text":"Mo ti ri sinu ese","marked":"Mo ti rì sínú ẹ̀ṣẹ̀"},{"start":33.991,"end":35.294,"text":"Fitila mi ku tan","marked":"Fìtílà mi kù tán"},{"start":35.674,"end":36.654,"text":"Nipa anu Olorun","marked":"Nípa ànú Ọlọ́run"},{"start":37.034,"end":38.478,"text":"Mo d'eniti nsoji","marked":"Mo d'ẹniti nsoji"},{"start":38.858,"end":39.928,"text":"Anu re ra mi pada","marked":"Ànú rẹ̀ rà mí padà"},{"start":40.308,"end":41.686,"text":"O fl ireti fun mi.","marked":"Ó fl ìrètí fún mi."},{"start":42.066,"end":43.461,"text":"Egbe:  lleri jeje t'a se...","marked":"lleri jẹ́jẹ́ t'á ṣe"}],"end":43.461},{"key":"4","start":44.411,"lines":[{"start":44.411,"end":45.984,"text":"Enyin Egbe Serafu","marked":"Enyin Ẹgbẹ́ Séráfù"},{"start":46.364,"end":47.471,"text":"Ejo ma jafara","marked":"Ẹjọ́ má jáfara"},{"start":47.851,"end":49.183,"text":"E je ka damure wa","marked":"Ẹ jẹ́ ká damure wa"},{"start":49.563,"end":50.623,"text":"K'ina wa si ma tan","marked":"K'íná wa sì ma tan"},{"start":51.003,"end":52.356,"text":"Amure ko gbodo tu","marked":"Àmùrè kò gbọ́dọ̀ tú"},{"start":52.736,"end":53.848,"text":"lna ko gbodo ku","marked":"lná kò gbọdọ̀ kú"},{"start":54.228,"end":55.55,"text":"Egbe:  lleri jeje t'a se","marked":"lleri jẹ́jẹ́ t'á ṣe"},{"start":55.93,"end":57.161,"text":"Fun eniti njaya,","marked":"Fún ẹniti ńjayà"},{"start":57.541,"end":58.776,"text":"lleri jeje t'a se","marked":"lleri jẹ́jẹ́ t'á ṣe"},{"start":59.156,"end":60.474,"text":"Fun eniti njaya.","marked":"Fún ẹniti ńjayà."},{"start":60.854,"end":61.544,"text":"Amin.","marked":"Àmín."}],"end":61.544}]}