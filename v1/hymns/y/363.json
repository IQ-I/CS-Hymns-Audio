{"v":1,"coll":"y","num":363,"id":"hymn_363","title":"ENYIN wo ni tempili Re","duration":48.77,"voices":{"male":{"file":"y-363-male.m4a","bytes":357324,"sha256":"bfe2e70cf1143094b5f09dd52b36fc652520bfefb246bab93265d1a3d0973283","duration":48.8},"female":{"file":"y-363-female.m4a","bytes":370409,"sha256":"63ca5cdfd1475df0dbd2d4ccda863965aebbcefb919ef88e5eb0851a818bcd87","duration":48.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.641,"text":"ENYIN wo ni tempili Re","marked":"Enyin wo ni tempili Rẹ̀"},{"start":2.021,"end":3.233,"text":"Oluwa t'a ti nreti","marked":"Olúwa t'á ti ńrètí"},{"start":3.613,"end":5.027,"text":"Woli 'gbani ti so tele","marked":"Wòlí 'gbani ti sọ tẹ́lẹ̀"},{"start":5.407,"end":6.577,"text":"Olorun m'oro Re se","marked":"Ọlọ́run m'ọ̀rọ̀ Rẹ ṣe"},{"start":6.957,"end":8.284,"text":"Awon ti a ti ra pada","marked":"Àwọn tí a ti rà padà"},{"start":8.664,"end":9.92,"text":"Yio fi ohun kan yin.","marked":"Yíó fi ohun kan yín."}],"end":9.92},{"key":"2","start":10.87,"lines":[{"start":10.87,"end":12.24,"text":"L'apa wundia iya Re","marked":"L'apá wúńdíá ìyá Rẹ"},{"start":12.62,"end":14.035,"text":"E sa wo bi O ti sun","marked":"Ẹ sá wo bí Ó ti sùn"},{"start":14.415,"end":16.198,"text":"Ti awon alagba ni si nsin","marked":"Tí àwọn alàgbà ní sí ńsìn"},{"start":16.578,"end":18.06,"text":"Ki nwon to ku 'nu 'gbagbo","marked":"Kí nwọn tó kù 'nú 'gbàgbọ́"},{"start":18.44,"end":20.014,"text":"Halleluya, Halleluya,","marked":"Hallelúyà, Hallelúyà"},{"start":20.394,"end":21.698,"text":"W'Olorun Oga Ogo.","marked":"W'Ọlọ́run Ọ̀gá Ògo."}],"end":21.698},{"key":"3","start":22.648,"lines":[{"start":22.648,"end":24.916,"text":"Jesu, nipa ifihan Re","marked":"Jésù, nípa ìfihàn Rẹ̀"},{"start":25.296,"end":26.628,"text":"O ti gba iya wa je","marked":"Ó ti gba ìyà wa jẹ"},{"start":27.008,"end":28.941,"text":"Jo, je ka ri 'gbala nla Re","marked":"Jọ, jẹ́ ká rí 'gbàlá ńlá Rẹ"},{"start":29.321,"end":30.695,"text":"Mu 'leri Re se si wa","marked":"Mú 'lérí Rẹ̀ ṣẹ sí wa"},{"start":31.075,"end":32.449,"text":"Mu wa lo sinu ogo Re","marked":"Mú wa lọ sínú ògo Rẹ"},{"start":32.829,"end":34.364,"text":"Sodo Baba Mimo ni.","marked":"Sọ́dọ̀ Bàbá Mímọ́́ ni."}],"end":34.364},{"key":"4","start":35.314,"lines":[{"start":35.314,"end":37.009,"text":"'Wo Alade igbala wa","marked":"'Wo Aládé ìgbàlà wa"},{"start":37.389,"end":38.765,"text":"K'ife Re je orin wa","marked":"K'ífẹ́ Rẹ jẹ́ orin wa"},{"start":39.145,"end":41.492,"text":"Jesu, Iwo l'a fiyin fun","marked":"Jésù, Ìwọ l'á fìyìn fún"},{"start":41.872,"end":43.485,"text":"Ni t'aiye t'O ra pada","marked":"Ní t'áiye t'Ó rà padà"},{"start":43.865,"end":45.453,"text":"Pelu Baba ati Emi","marked":"Pẹ̀lú Bàbá àti Ẹ̀mí"},{"start":45.833,"end":47.22,"text":"Oluwa Eleda wa.","marked":"Olúwa Ẹlẹ́dàá wa."}],"end":47.22}]}