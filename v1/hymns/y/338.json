{"v":1,"coll":"y","num":338,"id":"hymn_338","title":"'BUGBE Re ti l'ewa to!","duration":61.759,"voices":{"male":{"file":"y-338-male.m4a","bytes":444631,"sha256":"4a2661408ae365cff07ed0676527ba650d5d8a46fcf4a4cd5e5b234d5c96a558","duration":61.8},"female":{"file":"y-338-female.m4a","bytes":467156,"sha256":"b1d5125ecd7e65e0bb3f99b9ea73f9c7ccb657821c5addab1d55e3c0def93536","duration":61.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.941,"text":"'BUGBE Re ti l'ewa to!","marked":"'Búgbẹ Rẹ ti l'ẹwà tó!"},{"start":2.321,"end":3.884,"text":"Ni le 'mole at'ife","marked":"Ní le 'mọ́lẹ̀ àt'ife"},{"start":4.264,"end":5.739,"text":"'Bugbe Re ti l'ewa to!","marked":"'Búgbẹ Rẹ ti l'ẹwà tó!"},{"start":6.119,"end":7.61,"text":"Laiye ese at'osi","marked":"Láìyẹ ẹsẹ̀ àt'òsì"},{"start":7.99,"end":9.329,"text":"Okan mi nfa nitoto","marked":"Ọkàn mi ńfà nítòtó"},{"start":9.709,"end":11.071,"text":"Fun idapo enia re","marked":"Fún ìdàpọ̀ enia rẹ"},{"start":11.451,"end":12.775,"text":"Fun imole oju Re","marked":"Fún ìmọ́lẹ̀̀ ojú Rẹ"},{"start":13.155,"end":14.524,"text":"Fun ekun Re, Olorun.","marked":"Fún ẹkún Rẹ, Ọlọ́run."}],"end":14.524},{"key":"2","start":15.474,"lines":[{"start":15.474,"end":16.73,"text":"Ayo ba awon eiye","marked":"Ayọ̀ bá àwọn eiye"},{"start":17.11,"end":18.523,"text":"Ti nfo yi pepe Re ka","marked":"Ti ńfọ́ yí pẹpẹ Rẹ ká"},{"start":18.903,"end":20.477,"text":"Ayo okan l'o simi","marked":"Ayò ọkàn l'ó simi"},{"start":20.857,"end":22.171,"text":"L'aiya Baba l'o poju","marked":"L'áíyá Bàbá l'ó pọ̀jù"},{"start":22.551,"end":23.623,"text":"Gege b'adaba Noa","marked":"Gẹ́gẹ́ b'àdàbà Nóà"},{"start":24.003,"end":25.243,"text":"Ti ko r'ibi simi le","marked":"Tí kò r'ibi sími lé"},{"start":25.623,"end":27.081,"text":"Nwon pada sodo Baba","marked":"Nwọ̀n padà sọ́dọ̀ Bàbá"},{"start":27.461,"end":29.059,"text":"Nwon si nyo tili aiye.","marked":"Nwọ̀n sì nyo tìlì aiye."}],"end":29.059},{"key":"3","start":30.009,"lines":[{"start":30.009,"end":31.44,"text":"Nwon ko simi iyin won","marked":"Nwọn kò ṣimí ìyìn wọn"},{"start":31.82,"end":33.477,"text":"Ninu aiye osi yi","marked":"Nínú àìyẹ òṣì yí"},{"start":33.857,"end":35.12,"text":"Omi nsun ni aginju","marked":"Omi ńsun ní aginjù"},{"start":35.5,"end":36.921,"text":"Manna nt'orun wa fun won","marked":"Manna nt'ọrùn wà fún wọn"},{"start":37.301,"end":39.583,"text":"Nwon nlo Iat' ipa de 'pa","marked":"Nwọ̀n ńlò lat' ipa dé 'pa"},{"start":39.963,"end":41.135,"text":"Titi nwon fi yo si O","marked":"Títí nwọn fi yọ sí Ọ"},{"start":41.515,"end":42.801,"text":"Nwo si wole l'ese Re","marked":"Nwọ sì wọlé l'ẹsẹ̀ Rẹ"},{"start":43.181,"end":44.795,"text":"T'O mu won la ewu ja.","marked":"T'ó mú wọn la ewu já."}],"end":44.795},{"key":"4","start":45.745,"lines":[{"start":45.745,"end":47.929,"text":"Baba, je ki njere be","marked":"Bàbá, jẹ́ kí ǹjèrè bẹ́"},{"start":48.309,"end":49.574,"text":"S'amona mi l'aiye yi","marked":"S'amọ̀nà mi l'áiye yi"},{"start":49.954,"end":51.061,"text":"Fore ofe pa mi mo","marked":"Fọ́rẹ́ ọ̀fẹ́ pa mí mọ́"},{"start":51.441,"end":52.679,"text":"Fun mi l'aye lodo Re","marked":"Fún mi l'áyé lọ́dọ̀ Rẹ"},{"start":53.059,"end":54.611,"text":"lwo l'orun at'Asa","marked":"lwo l'òrun àt'Àsà"},{"start":54.991,"end":56.018,"text":"To okan isina mi","marked":"Tọ ọkàn ìṣìnà mi"},{"start":56.398,"end":57.579,"text":"lwo l'orisun ore","marked":"lwo l'orísun ọ̀rẹ́"},{"start":57.959,"end":59.163,"text":"Ro ojo re sori mi.","marked":"Rọ ọjọ́ rẹ sórí mi."},{"start":59.543,"end":60.209,"text":"Amin.","marked":"Àmín."}],"end":60.209}]}