{"v":1,"coll":"y","num":407,"id":"hymn_407","title":"BABA anu, n'nu am Re","duration":42.765,"voices":{"male":{"file":"y-407-male.m4a","bytes":297352,"sha256":"8ffaff40fa39eda48f8460b9ca7c7eb407039b87be9b066eb77604529cd202ee","duration":42.8},"female":{"file":"y-407-female.m4a","bytes":312423,"sha256":"23886d50d289c5489ae455070b164a7ec7e13ab325e50de8496f5068d320e4b1","duration":42.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.137,"text":"BABA anu, n'nu am Re","marked":"Bàbá ànú, ń'nú am Re"},{"start":2.517,"end":4.1,"text":"L'ogo ailopin ntan","marked":"L'ògò àìlópin ńtàn"},{"start":4.48,"end":6.656,"text":"K'a ma yin oruko Re lai","marked":"K'á má yin orúkọ Rẹ̀ láì"},{"start":7.036,"end":8.409,"text":"Fun iwe mimo yi.","marked":"Fún ìwé mímọ́́ yí."}],"end":8.409},{"key":"2","start":9.359,"lines":[{"start":9.359,"end":11.211,"text":"N'nu re l'awon alaini le","marked":"N'nu rẹ̀ l'áwọn aláìní lé"},{"start":11.591,"end":12.744,"text":"Ri oro ailopin","marked":"Rí ọ̀rọ̀ àìlópin"},{"start":13.124,"end":15.452,"text":"Oro, t'aiye ko le fun-ni","marked":"Ọrọ̀, t'áiye kò lè fún-ni"},{"start":15.832,"end":17.396,"text":"T'o daju bi iye.","marked":"T'ó dájú bí iye."}],"end":17.396},{"key":"3","start":18.346,"lines":[{"start":18.346,"end":19.837,"text":"N'nu re n'igi imo rere","marked":"N'nú rẹ̀ ń'igi ìmọ̀ rere"},{"start":20.217,"end":21.618,"text":"Nfun-ni l'onje ofe","marked":"Nfun-ní l'ọ́ńjẹ ọ̀fẹ́"},{"start":21.998,"end":23.693,"text":"T'adun re po ju t'aiye lo","marked":"T'adùn rẹ̀ pọ̀ ju t'áiye lọ"},{"start":24.073,"end":25.402,"text":"To nfa gbogbo eda.","marked":"Tó ńfa gbogbo ẹ̀dá."}],"end":25.402},{"key":"4","start":26.352,"lines":[{"start":26.352,"end":28.124,"text":"N'nu re l'a gbo t'Oludande","marked":"N'nú rẹ̀ l'á gbọ́ t'Olùdáǹdè"},{"start":28.504,"end":29.421,"text":"Nkede alafia","marked":"Ńkéde àlàáfíà"},{"start":29.801,"end":31.311,"text":"Iro didun na je iye","marked":"Ìró dídùn ná jẹ́ iye"},{"start":31.691,"end":32.947,"text":"At'ayo ailopin.","marked":"Àt'àyò àìlópin."}],"end":32.947},{"key":"5","start":33.897,"lines":[{"start":33.897,"end":35.373,"text":"Oluwa, Oluko mimo","marked":"Olúwa, Olùkọ́ mímọ́́"},{"start":35.753,"end":36.954,"text":"Ma sunmo mi titi","marked":"Má súnmọ́ mi títí"},{"start":37.334,"end":38.637,"text":"Ko mi lati fe oro Re","marked":"Kọ́ mi láti fẹ́ ọ̀rọ̀ Rẹ"},{"start":39.017,"end":40.289,"text":"Ki nri Jesu nibe.","marked":"Kí ńrí Jésù níbẹ̀."},{"start":40.669,"end":41.215,"text":"Amin.","marked":"Àmín."}],"end":41.215}]}