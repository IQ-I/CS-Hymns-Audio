{"v":1,"coll":"y","num":76,"id":"hymn_76","title":"WA, Parakliti Mimo,","duration":59.478,"voices":{"male":{"file":"y-76-male.m4a","bytes":403268,"sha256":"8c19a92c6b8a9315ae32f649de2760ca9db86324a62e0c0cc19b9c0f37d93d32","duration":59.5},"female":{"file":"y-76-female.m4a","bytes":426014,"sha256":"ca8909b0e876a3b052cadea55be4b777c2daf1faf20d8ac7600403abc2c5beb2","duration":59.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.078,"text":"WA, Parakliti Mimo,","marked":"Wà, Parakliti Mímọ́"},{"start":2.458,"end":4.337,"text":"Lat'ibugbe Re, Orun,","marked":"Lat'ibugbe Rẹ, Ọ̀run"},{"start":4.717,"end":5.945,"text":"Ran itansan 'mole wa.","marked":"Ran ìtànṣán 'mọ́lẹ̀ wa."}],"end":5.945},{"key":"2","start":6.895,"lines":[{"start":6.895,"end":8.665,"text":"Baba talaka, wa 'hin","marked":"Bàbá tálákà, wa 'hin"},{"start":9.045,"end":10.251,"text":"Olufunni l'ebun wa,","marked":"Olùfúnni l'ẹ́bùn wa"},{"start":10.631,"end":11.937,"text":"Imole okan jo wa.","marked":"Ìmọ́lẹ̀̀ ọkàn jọ wà."}],"end":11.937},{"key":"3","start":12.887,"lines":[{"start":12.887,"end":14.016,"text":"Baba Olutunu wa","marked":"Bàbá Olùtùnú wa"},{"start":14.396,"end":15.566,"text":"Alejo toro f 'okan,","marked":"Àlejò tọ́rọ̀ f 'ọkàn"},{"start":15.946,"end":17.229,"text":"Pelu itura-Re wa.","marked":"Pẹ̀lú ìtura-Ré wa."}],"end":17.229},{"key":"4","start":18.179,"lines":[{"start":18.179,"end":19.545,"text":"'Wo n'isimi n'nu lala","marked":"'Wò ń'isimi ń'nú lala"},{"start":19.925,"end":21.318,"text":"lboji ninu orun,","marked":"lbojì nínú ọ̀run"},{"start":21.698,"end":23.138,"text":"ltunu ninu 'ponju.","marked":"ltunu nínú 'pọ́njú."}],"end":23.138},{"key":"5","start":24.088,"lines":[{"start":24.088,"end":25.524,"text":"'Wo 'mole t'o mo gara","marked":"'Wò 'mọ́lẹ̀ t'ó mọ́ gara"},{"start":25.904,"end":27.027,"text":"Tan sinu aiya awon;","marked":"Tàn sínú àìyá àwọn"},{"start":27.407,"end":28.399,"text":"Enia Re oloto.","marked":"Ẹníà Rẹ̀ ọlọ́tọ̀."}],"end":28.399},{"key":"6","start":29.349,"lines":[{"start":29.349,"end":30.91,"text":"L'aisi Re kil'eda je?","marked":"L'àìsí Rẹ kil'eda jẹ́?"},{"start":31.29,"end":32.574,"text":"Ise at'ero Mimo,","marked":"Iṣẹ́ àt'èrò Mímọ́́"},{"start":32.954,"end":34.411,"text":"Lat'odo Re wa ni won.","marked":"Lát'ọ̀dọ̀ Rẹ̀ wá ni wọ́n."}],"end":34.411},{"key":"7","start":35.361,"lines":[{"start":35.361,"end":36.656,"text":"Eleri, so di mimo,","marked":"Ẹlẹ́rì, sọ di mímọ́́"},{"start":37.036,"end":38.355,"text":"Agbogbe masai wo san,","marked":"Àgbọgbẹ́ masai wò sàn"},{"start":38.735,"end":40.187,"text":"Alaileso mu s'eso.","marked":"Aláìléso mú s'èso."}],"end":40.187},{"key":"8","start":41.137,"lines":[{"start":41.137,"end":42.551,"text":"Mu okan tutu gbona","marked":"Mú ọkàn tutù gbóná"},{"start":42.931,"end":44.054,"text":"M'alagidi teriba,","marked":"M'alágídí tèrìbá"},{"start":44.434,"end":46.122,"text":"Fa asako wa jeje.","marked":"Fa àṣàkò wa jẹ́jẹ́."}],"end":46.122},{"key":"9","start":47.072,"lines":[{"start":47.072,"end":48.237,"text":"F'emi 'jinle Re meje,","marked":"F'èmi 'jinlẹ̀ Rẹ méje"},{"start":48.617,"end":49.642,"text":"Kun awon oloto Re,","marked":"Kún àwọn ọlọ́tọ̀ Rẹ"},{"start":50.022,"end":51.516,"text":"F'agbara Re s'abo won.","marked":"F'agbára Rẹ s'abo wọn."}],"end":51.516},{"key":"10","start":52.466,"lines":[{"start":52.466,"end":53.604,"text":"Ran or'ofe Re sihin,","marked":"Ran or'ọ̀fẹ́ Rẹ síhìn"},{"start":53.984,"end":55.225,"text":"Ekun igbala laiye,","marked":"Ẹkùn ìgbàlà láìyẹ"},{"start":55.605,"end":56.967,"text":"At'alafia l'orun.","marked":"At'àlàáfíà l'ọ̀run."},{"start":57.347,"end":57.928,"text":"Amin.","marked":"Àmín."}],"end":57.928}]}