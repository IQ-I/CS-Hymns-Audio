{"v":1,"coll":"y","num":23,"id":"hymn_23","title":"K'AWA to pari eko wa","duration":25.735,"voices":{"male":{"file":"y-23-male.m4a","bytes":180236,"sha256":"cddaaa32ad226fe93eb68fc57d5b2c549bf336686e169dd3776c8f604358c241","duration":25.8},"female":{"file":"y-23-female.m4a","bytes":187637,"sha256":"9f225d8834116bc979ae859073bbea0207b532f34b3ad05ecd10d719782e6d9b","duration":25.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.605,"text":"K'AWA to pari eko wa,","marked":"K'àwa tó parí ẹ̀kọ́ wa"},{"start":1.985,"end":3.201,"text":"Awa f' iyin fun O","marked":"Àwa f' ìyìn fún Ọ"},{"start":3.581,"end":4.968,"text":"T'ori ojo Re mimo yi,","marked":"T'orí ọjọ́ Rẹ mímọ́́ yí"},{"start":5.348,"end":7.111,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọ̀rẹ́ èwe."}],"end":7.111},{"key":"2","start":8.061,"lines":[{"start":8.061,"end":9.377,"text":"Gbin oro Re si okan wa,","marked":"Gbin ọ̀rọ̀ Rẹ sí ọkàn wa"},{"start":9.757,"end":10.692,"text":"Gba wa lowo ese","marked":"Gbà wá lọ́wọ́ ẹ̀ṣẹ̀"},{"start":11.072,"end":12.917,"text":"Ma je k'a pada lehin Re,","marked":"Má jẹ k'á padà lẹ́hìn Rẹ"},{"start":13.297,"end":14.813,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọ̀rẹ́ èwe."}],"end":14.813},{"key":"3","start":15.763,"lines":[{"start":15.763,"end":17.668,"text":"Jesu jo, bukun ile wa,","marked":"Jésù jó, bùkún ilé wa"},{"start":18.048,"end":19.183,"text":"K'a lo ojo yi 're","marked":"K'á lo ọjọ́ yí 'rẹ̀"},{"start":19.563,"end":21.054,"text":"K'a le ri aye lodo Re,","marked":"K'á lè rí àyè lọ́dọ̀ Rẹ"},{"start":21.434,"end":23.179,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọ̀rẹ́ èwe."},{"start":23.559,"end":24.185,"text":"Amin.","marked":"Àmín."}],"end":24.185}]}