{"v":1,"coll":"y","num":290,"id":"hymn_290","title":"TANl le so t'ayo ti mbe","duration":26.03,"voices":{"male":{"file":"y-290-male.m4a","bytes":183317,"sha256":"6250bdf023ac4572d64dbce4acd5f22c7cb75f1ac0da766fb120db6ff60af5d4","duration":26.1},"female":{"file":"y-290-female.m4a","bytes":194935,"sha256":"281256ed8ea887428a030ef90ae1f318378f02e3aaa81c679f681abd6a480e75","duration":26.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.365,"text":"TANl le so t'ayo ti mbe","marked":"TÁNL lè sọ t'àyò ti mbẹ́"},{"start":2.745,"end":4.136,"text":"Ni agbala Paradise","marked":"Ní àgbàlá Párádísè"},{"start":4.516,"end":6.045,"text":"Gba t'amusua ba pada","marked":"Gba t'amusua bá padà"},{"start":6.425,"end":7.833,"text":"T'o si di arole ogo?","marked":"T'ó sì di àròlé ògo?"}],"end":7.833},{"key":"2","start":8.783,"lines":[{"start":8.783,"end":10.489,"text":"Ni ayo ni Baba fi wo","marked":"Ní ayọ̀ ni Bàbá fi wọ̀"},{"start":10.869,"end":12.357,"text":"Eso ife Re ailopin","marked":"Èso ìfẹ́ Rẹ àìlópin"},{"start":12.737,"end":14.442,"text":"L'ayo l'Omo we Ie t'O ri","marked":"L'àyò l'Ọmọ wé le t'Ó rí"},{"start":14.822,"end":16.3,"text":"Ere iwaya-ija Re.","marked":"Eré ìwáyà-ìjà Rẹ."}],"end":16.3},{"key":"3","start":17.25,"lines":[{"start":17.25,"end":18.736,"text":"Tayotayo l'Emi si nwo","marked":"Tayọ̀tayọ̀ l'Èmi sì ńwò"},{"start":19.116,"end":20.918,"text":"Okan mimo t'o n so dotun","marked":"Ọkàn mímọ́́ t'ó ń sọ dọ̀tun"},{"start":21.298,"end":23.009,"text":"Awon mimo at'Angel nko","marked":"Àwọn mímọ́́ at'Angel ńkọ́"},{"start":23.389,"end":24.48,"text":"Orin Igbala Oba won.","marked":"Orin Ìgbàlà Ọba wọn."}],"end":24.48}]}