{"v":1,"coll":"y","num":736,"id":"hymn_736","title":"E YO, Jesu joba","duration":48.48,"voices":{"male":{"file":"y-736-male.m4a","bytes":352033,"sha256":"6f28d298580c924245ff278e00a146581a4e5e58c991769612c4b7d545d73d98","duration":48.5},"female":{"file":"y-736-female.m4a","bytes":370094,"sha256":"daff9b228a31d06848bfbd3aebf517fd4a3067acab3230151bd5b487128d9cb7","duration":48.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.378,"text":"E YO, Jesu joba","marked":"Ẹ Yọ̀, Jésù jọba"},{"start":2.758,"end":3.545,"text":"'Nu omo enia","marked":"'Nu ọmọ enia"},{"start":3.925,"end":5.358,"text":"O da ara tubu","marked":"Ó da ara túbú"},{"start":5.738,"end":6.938,"text":"O so won d'ominira","marked":"Ó sọ wọ́n d'òmìnira"},{"start":7.318,"end":9.003,"text":"K'esu koju s'om' Olorun","marked":"K'èṣù kọjú s'om' Ọlọ́run"},{"start":9.383,"end":10.984,"text":"Lai f'ota pe ise Re nlo.","marked":"Láì f'ọ̀tá pe iṣẹ́ Rẹ ńlò."}],"end":10.984},{"key":"2","start":11.934,"lines":[{"start":11.934,"end":13.098,"text":"lse ti ododo","marked":"lṣe ti òdodo"},{"start":13.478,"end":14.891,"text":"Oto, alafia","marked":"Ọ̀tọ̀, àlàáfíà"},{"start":15.271,"end":16.499,"text":"Fun r'orun aiye wa","marked":"Fún r'ọrùn aiye wa"},{"start":16.879,"end":17.955,"text":"Yio tan ka kiri","marked":"Yíó tàn ká kiri"},{"start":18.335,"end":20.293,"text":"Keferi, Ju nwon o wole","marked":"Kèfèrí, Jù nwọn ò wọlé"},{"start":20.673,"end":22.211,"text":"Nwon o jeje isin yiye.","marked":"Nwọn ò jẹ́jẹ́ ìsìn yíyẹ."}],"end":22.211},{"key":"3","start":23.161,"lines":[{"start":23.161,"end":24.194,"text":"Agbara l'owo Re","marked":"Agbára l'ọwọ́ Rẹ"},{"start":24.574,"end":25.61,"text":"Fun abo eni Re","marked":"Fún abo ẹni Rẹ"},{"start":25.99,"end":27.172,"text":"Si ase giga Re","marked":"Sí àṣẹ gíga Rẹ"},{"start":27.552,"end":28.931,"text":"L'opo o kiyesi","marked":"L'ọ́pọ̀ ò kíyèsí"},{"start":29.311,"end":30.613,"text":"Orun ayo ri ise Re,","marked":"Ọ̀run ayọ̀ rí iṣẹ́ Rẹ̀"},{"start":30.993,"end":32.428,"text":"Ekusu rere gb'ofin Re.","marked":"Ekusu rere gb'òfin Rẹ."}],"end":32.428},{"key":"4","start":33.378,"lines":[{"start":33.378,"end":35.971,"text":"Serafu (Kerubu) t' aiye yi","marked":"Séráfù Kérúbù t' aiye yi"},{"start":36.351,"end":37.542,"text":"O fere d'ijo nla","marked":"Ó fẹ́rẹ̀ d'íjọ́ ńlá"},{"start":37.922,"end":38.988,"text":"Abukun wukara","marked":"Àbùkún wukara"},{"start":39.368,"end":40.456,"text":"Ko le sai tan kiri","marked":"Kò lè ṣàì tán kiri"},{"start":40.836,"end":42.396,"text":"Tit' Olorun Omo tun wa","marked":"Tit' Ọlọ́run Ọmọ tún wà"},{"start":42.776,"end":45.938,"text":"Ko le sai lo. Amin! Amin!","marked":"Kò lè ṣàì lọ. Àmín! Àmín!"},{"start":46.318,"end":46.93,"text":"Amin.","marked":"Àmín."}],"end":46.93}]}