{"v":1,"coll":"y","num":734,"id":"hymn_734","title":"EGBE Serafu, e dide","duration":34.603,"voices":{"male":{"file":"y-734-male.m4a","bytes":255276,"sha256":"a6ae6bafc4819a97a2839e97bf0763424932edbd02aaf7a1b077908598782162","duration":34.7},"female":{"file":"y-734-female.m4a","bytes":267194,"sha256":"2476fd4324661e172a799cf54ca8106d63c404092d8a4e08eaaea2ef7d15f425","duration":34.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.388,"text":"EGBE Serafu, e dide","marked":"Ẹgbẹ́ Séráfù, ẹ dìde"},{"start":2.768,"end":4.145,"text":"E d'amure nyin giri","marked":"Ẹ d'àmùrè nyin gìrì"},{"start":4.525,"end":6.196,"text":"Olorun lo d'egbe yi sile","marked":"Ọlọ́run ló d'ẹgbẹ́ yí sílẹ̀"},{"start":6.576,"end":8.016,"text":"E ma jek'eru ba yin","marked":"Ẹ má jẹk'ẹ̀rù bà yín"},{"start":8.396,"end":9.922,"text":"Lo wasu ihinrere Re,","marked":"Lọ wasu ìhìnrere Rẹ"},{"start":10.302,"end":11.74,"text":"Yio pelu wa titi d'opin,","marked":"Yíó pẹ̀lú wa títí d'òpin"},{"start":12.12,"end":14.171,"text":"Ke sa ma wo Jesu li okan","marked":"Kẹ́ sá má wọ Jésù li ọkàn"},{"start":14.551,"end":16.024,"text":"Titi ao fi segun.","marked":"Títí aó fi ṣẹ́gun."}],"end":16.024},{"key":"2","start":16.974,"lines":[{"start":16.974,"end":19.016,"text":"Egbe Serafu, e dide","marked":"Ẹgbẹ́ Séráfù, ẹ dìde"},{"start":19.396,"end":20.884,"text":"Lati tan oro Olorun","marked":"Láti tan ọ̀rọ̀ Ọlọ́run"},{"start":21.264,"end":22.676,"text":"Papa larin ilu Eko","marked":"Pápá lárin ìlú Èkó"},{"start":23.056,"end":24.681,"text":"F'awon to ti sako Io","marked":"F'àwọn tó ti ṣáko lọ"},{"start":25.061,"end":26.319,"text":"Ka le d'eni irapada","marked":"Ká lè d'ẹni ìràpadà"},{"start":26.699,"end":28.27,"text":"Larin awon ti o nsegbe lo","marked":"Lárin àwọn tí ò ńṣègbè lọ"},{"start":28.65,"end":30.404,"text":"Lati ran won s'agbo Jesu","marked":"Láti rán wọn s'ágbó Jésù"},{"start":30.784,"end":32.098,"text":"Si iye ainipekun.","marked":"Sí ìyè àìnípẹ̀kun."},{"start":32.478,"end":33.053,"text":"Amin.","marked":"Àmín."}],"end":33.053}]}