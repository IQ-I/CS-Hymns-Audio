{"v":1,"coll":"y","num":200,"id":"hymn_200","title":"ENYIN Angel' l'orun ogo","duration":44.017,"voices":{"male":{"file":"y-200-male.m4a","bytes":305967,"sha256":"6dfafefeda7382fcabcb177647b87fecfa099f058e24c260009deb9f4f988791","duration":44.1},"female":{"file":"y-200-female.m4a","bytes":322434,"sha256":"338b1ea6131498d352ecc4e5d94b2fff88e3c78df8662a394ce95d5d0c0a2de4","duration":44.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.306,"text":"ENYIN Angel' l'orun ogo,","marked":"Enyin Angel' l'ọrùn ògo"},{"start":2.686,"end":4.109,"text":"To yi gbogbo aiye ka;","marked":"Tó yí gbogbo àìyẹ ká"},{"start":4.489,"end":5.825,"text":"E ti korin dida aiye,","marked":"Ẹ ti kọrin dídá aiye"},{"start":6.205,"end":7.734,"text":"E so ti' ibi Messia.","marked":"Ẹ sọ ti' ibi Messia."}],"end":7.734},{"key":"CHORUS","start":8.684,"lines":[{"start":8.684,"end":10.71,"text":"Egbe: E wa josin, e wa josin,","marked":"Ẹ wá jọ́sìn, ẹ wá jọ́sìn"},{"start":11.09,"end":12.558,"text":"Fun Kristi Oba titun.","marked":"Fún Kristi Ọba titun."}],"end":12.558},{"key":"2","start":13.508,"lines":[{"start":13.508,"end":14.755,"text":"Enyin Oluso - agutan,","marked":"Enyin Olùṣọ́ àgùtàn"},{"start":15.135,"end":16.571,"text":"Ti nso eran nyin loru,","marked":"Ti nso ẹran nyin lóru"},{"start":16.951,"end":18.132,"text":"Emmanueli wa ti de,","marked":"Ẹmmanuẹ́lì wá ti dé"},{"start":18.512,"end":19.573,"text":"Irawo Omo na ntan.","marked":"Ìràwọ̀ Ọmọ ná ńtán."}],"end":19.573},{"key":"3","start":20.523,"lines":[{"start":20.523,"end":21.755,"text":"Eyin Oluso-aguntan,","marked":"Ẹ̀yin Olùṣọ́-àgùntàn"},{"start":22.135,"end":23.471,"text":"Ti n so eran yin loru,","marked":"Ti ń ṣọ́ ẹran yín lóru"},{"start":23.851,"end":25.16,"text":"Emmanueli wa ti de,","marked":"Ẹmmanuẹ́lì wá ti dé"},{"start":25.54,"end":26.732,"text":"Irawo omo naa n tan.","marked":"Ìràwọ̀ ọmọ náà ń tán."}],"end":26.732},{"key":"4","start":27.682,"lines":[{"start":27.682,"end":28.874,"text":"Elese 'wo alaironu,","marked":"Ẹlẹ́ṣẹ̀ 'wò aláìronú"},{"start":29.254,"end":30.699,"text":"Elebi ati egbe,","marked":"Ẹlẹ́bi àti ẹgbẹ́"},{"start":31.079,"end":32.316,"text":"Ododo Olorun duro,","marked":"Òdodo Ọlọ́run dúró"},{"start":32.696,"end":34.478,"text":"Anu npe o, pa 'wa da.","marked":"Ànú ńpẹ́ o, pa 'wá dà."}],"end":34.478},{"key":"5","start":35.428,"lines":[{"start":35.428,"end":36.799,"text":"Gbogbo eda e fo f'ayo,","marked":"Gbogbo ẹ̀dá ẹ̀ fọ f'ayo"},{"start":37.179,"end":38.778,"text":"Jesu Olugbala de,","marked":"Jésù Olùgbàlà dé"},{"start":39.158,"end":40.551,"text":"Anfani miran ko si mo,","marked":"Àǹfàní miran kò sí mọ́"},{"start":40.931,"end":42.467,"text":"B'eyi ba fo yin koja.","marked":"B'èyí bá fọ́ yín kọjá."}],"end":42.467}]}