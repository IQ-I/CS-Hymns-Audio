{"v":1,"coll":"y","num":79,"id":"hymn_79","title":"BABA Mimo jowo sunmo wa,","duration":70.306,"voices":{"male":{"file":"y-79-male.m4a","bytes":511463,"sha256":"9cd59fdf2a95588be83e24d0d00a06e2bc675824059ccdabaae4ebf77fce13e9","duration":70.4},"female":{"file":"y-79-female.m4a","bytes":535101,"sha256":"4ac3bdd8d1bd8b009170c720aa7c802e27dee91dff3298c431d9313f824b777b","duration":70.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.773,"text":"BABA Mimo jowo sunmo wa,","marked":"Bàbá Mímọ́́ jọ̀wọ́ súnmọ́ wa"},{"start":2.153,"end":3.503,"text":"Omo Mimo jowo sunmo wa,","marked":"Ọmọ Mímọ́́ jọ̀wọ́ súnmọ́ wa"},{"start":3.883,"end":5.406,"text":"Emi Mimo jowo sunmo wa,","marked":"Ẹ̀mí Mímọ́́ jọ̀wọ́ súnmọ́ wa"},{"start":5.786,"end":8.129,"text":"A sunmo O, fi 'bukun fun wa,","marked":"A súnmọ́ O, fi 'bùkún fún wa"}],"end":8.129},{"key":"CHORUS","start":9.079,"lines":[{"start":9.079,"end":10.462,"text":"Baba wa, Baba wa","marked":"Bàbá wa, Bàbá wa"},{"start":10.842,"end":12.314,"text":"Edumare jowo bukun wa,","marked":"Ẹ̀dùmàrè jọ̀wọ́ bùkún wa"},{"start":12.694,"end":13.908,"text":"Baba wa, Baba wa,","marked":"Bàbá wa, Bàbá wa"},{"start":14.288,"end":16.0,"text":"Edumare jowo bukun wa.","marked":"Ẹ̀dùmàrè jọ̀wọ́ bùkún wa."}],"end":16.0},{"key":"2","start":16.95,"lines":[{"start":16.95,"end":19.057,"text":"Jehovah Jire wa ba wa pe,","marked":"Jehovah Jíre wá bá wa pé"},{"start":19.437,"end":21.102,"text":"K'O si ma gbe inu okan wa,","marked":"K'ó sì má gbé inú ọkàn wa"},{"start":21.482,"end":23.184,"text":"Masai f'oju anu Re wo wa,","marked":"Masai f'ojú ãnu Rẹ̀ wò wá"},{"start":23.564,"end":25.135,"text":"Ko si f'ese Egbe wa mule.","marked":"Kò sì f'ẹsẹ̀ Ẹgbẹ́ wa múlẹ̀."},{"start":25.515,"end":26.783,"text":"Egbe:  Baba wa, Baba wa...","marked":"Bàbá wa, Bàbá wa"}],"end":26.783},{"key":"3","start":27.733,"lines":[{"start":27.733,"end":29.562,"text":"Oluwa pese Emi Re fun wa,","marked":"Olúwa pèsè Ẹ̀mí Rẹ̀ fún wa"},{"start":29.942,"end":31.96,"text":"Ka wa le sin O titi d'opin","marked":"Ká wá lè sìn Ọ́ títí d'òpin"},{"start":32.34,"end":33.633,"text":"Ko si ma samona Egbe wa,","marked":"Kò sì má ṣamọ̀nà Ẹgbẹ́ wa"},{"start":34.013,"end":35.477,"text":"Ka le fi 'joba Re s'ere je","marked":"Ká lè fi 'jọba Rẹ̀ s'ère jẹ"},{"start":35.857,"end":37.262,"text":"Egbe:  Baba wa, Baba wa...","marked":"Bàbá wa, Bàbá wa"}],"end":37.262},{"key":"4","start":38.212,"lines":[{"start":38.212,"end":39.698,"text":"Pese fun gbogbo awon omo Egbe","marked":"Pèsè fún gbogbo àwọn ọmọ Ẹgbẹ́"},{"start":40.078,"end":41.704,"text":"Pese ise f'awon alairise,","marked":"Pèsè iṣẹ́ f'àwọn aláìríṣẹ́"},{"start":42.084,"end":44.137,"text":"Mase jeki gbogbo wa rahun","marked":"Masẹ̀ jẹ́kí gbogbo wa ráhùn"},{"start":44.517,"end":46.345,"text":"Masai fi 'bukun Re kari wa.","marked":"Masai fi 'bùkún Rẹ̀ kárí wa."},{"start":46.725,"end":48.049,"text":"Egbe:  Baba wa, Baba wa...","marked":"Bàbá wa, Bàbá wa"}],"end":48.049},{"key":"5","start":48.999,"lines":[{"start":48.999,"end":50.83,"text":"Nigbat' a ba si f'aiye yi sile","marked":"Nígbàt' a bá sì f'aiye yí sílẹ̀"},{"start":51.21,"end":52.76,"text":"Ka wa je eni 'tewogba","marked":"Ká wá jẹ́ ẹni 'tẹ́wọ́gbà"},{"start":53.14,"end":54.648,"text":"K'awa sile ba Jesu gunwa,","marked":"K'áwá sìlè bá Jésù gúnwà"},{"start":55.028,"end":56.575,"text":"Niwaju ite Metalokan.","marked":"Níwájú ìtẹ́ Mẹ́talọ́kan."},{"start":56.955,"end":58.309,"text":"Egbe:  Baba wa, Baba wa...","marked":"Bàbá wa, Bàbá wa"}],"end":58.309},{"key":"6","start":59.259,"lines":[{"start":59.259,"end":60.906,"text":"Nikehin k'a le gbo ohun ni,","marked":"Níkẹhin k'á lè gbọ́ ohùn ni"},{"start":61.286,"end":62.909,"text":"E wa enyin Alabukun fun","marked":"Ẹ wá ẹnyin Alábùkún fún"},{"start":63.289,"end":64.715,"text":"Bo sinu ayo Oluwa Re,","marked":"Bọ́ sínú ayọ̀ Olúwa Rẹ"},{"start":65.095,"end":66.724,"text":"K'a le b'awon Angeli korin 'yin.","marked":"K'á lè b'àwọn Áńgẹ́lì kọrin 'yín."},{"start":67.104,"end":68.756,"text":"Egbe:  Baba wa, Baba wa... Amin.","marked":"Bàbá wa, Bàbá wa Àmín."}],"end":68.756}]}