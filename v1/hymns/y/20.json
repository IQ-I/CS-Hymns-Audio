{"v":1,"coll":"y","num":20,"id":"hymn_20","title":"OSE, Ose rere","duration":60.262,"voices":{"male":{"file":"y-20-male.m4a","bytes":435474,"sha256":"8b99d5770c2bb672823a0b7876687e48f3107f1dbb358a3b653cba82aafa9e89","duration":60.3},"female":{"file":"y-20-female.m4a","bytes":452634,"sha256":"8d1f4afa73eaa28e6896b0860595178aad84dacaf5d0e729aa032208f503bf68","duration":60.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.481,"text":"OSE, Ose rere, Iwo ojo simi;","marked":"Ọ̀sẹ̀, Ọ̀sẹ̀ rere, Ìwọ ọjọ́ símí"},{"start":3.861,"end":5.422,"text":"O ye k'a fi ojo kan,","marked":"Ó yé k'á fi ọjọ́ kan"},{"start":5.802,"end":6.878,"text":"Fun Olorun rere,","marked":"Fún Ọlọ́run rere"},{"start":7.258,"end":8.562,"text":"B'ojo mi ba m'ekun wa,","marked":"B'ọjọ́ mi bá m'ẹkùn wa"},{"start":8.942,"end":10.023,"text":"Iwo n'oju wa nu;","marked":"Ìwọ ń'ojú wa nù"},{"start":10.403,"end":11.527,"text":"Iwo ti s'ojo ayo,","marked":"Ìwọ ti s'ọ́jọ́ ayò"},{"start":11.907,"end":13.135,"text":"Emi fe dide re.","marked":"Èmi fẹ́ dìde rẹ̀."}],"end":13.135},{"key":"2","start":14.085,"lines":[{"start":14.085,"end":16.862,"text":"Ose, Ose, rere","marked":"Ọ̀sẹ̀, Ọ̀sẹ̀, rere"},{"start":17.242,"end":18.256,"text":"A ki o sise loni","marked":"A kí ó ṣiṣẹ́ lónì"},{"start":18.636,"end":20.058,"text":"A o f'ise wa gbogbo","marked":"A ò f'iṣẹ́ wa gbogbo"},{"start":20.438,"end":21.551,"text":"Fun aisimi ola,","marked":"Fún àìsími ọlá"},{"start":21.931,"end":23.209,"text":"Didan l'oju re ma dan","marked":"Dídán l'ojú rẹ má dán"},{"start":23.589,"end":24.697,"text":"'Wo arewa ojo","marked":"'Wo àrẹwà ọjọ́"},{"start":25.077,"end":26.499,"text":"Ojo mi nso ti lala,","marked":"Ọjọ́ mi ǹṣó ti lálà"},{"start":26.879,"end":28.439,"text":"Iwo nso ti 'simi.","marked":"Ìwọ ńsọ ti 'simi."}],"end":28.439},{"key":"3","start":29.389,"lines":[{"start":29.389,"end":31.479,"text":"Ose. Ose, rere","marked":"Ọ̀sẹ̀. Ọ̀sẹ̀, rere"},{"start":31.859,"end":33.273,"text":"Ago tile nwipe","marked":"Àgọ́ tilẹ̀ ńwípé"},{"start":33.653,"end":34.986,"text":"F'Eleda re l'ojo kan,","marked":"F'Ẹlẹ́dàá rẹ l'ọjọ́ kan"},{"start":35.366,"end":36.706,"text":"T'O fun wa n'Ijo mefa","marked":"T'ó fún wa n'Ìjọ mẹ́fà"},{"start":37.086,"end":38.206,"text":"A o fi 'se wa sile","marked":"A ò fi 'ṣẹ̀ wá sílẹ̀"},{"start":38.586,"end":39.825,"text":"Lati lo sin nibe","marked":"Láti lọ sìn níbẹ̀"},{"start":40.205,"end":41.422,"text":"Awa ati ore we,","marked":"Àwa àti ọ̀rẹ́ we"},{"start":41.802,"end":43.016,"text":"Ao lo sile adua.","marked":"Aó lọ sílẹ̀ àdúà."}],"end":43.016},{"key":"4","start":43.966,"lines":[{"start":43.966,"end":46.3,"text":"Ose, Ose, rere","marked":"Ọ̀sẹ̀, Ọ̀sẹ̀, rere"},{"start":46.68,"end":48.059,"text":"Wakati re wu mi,","marked":"Wákàtí rẹ̀ wù mí"},{"start":48.439,"end":49.608,"text":"Ojo orun ni 'wo se","marked":"Ọjọ́ ọ̀run ni 'wọ́ ṣe"},{"start":49.988,"end":50.873,"text":"'Wo apere orun","marked":"'Wo apẹ̀rẹ̀ ọ̀run"},{"start":51.253,"end":52.418,"text":"Oluwa, je ki njogun","marked":"Olúwa, jẹ́ kí njogun"},{"start":52.798,"end":53.867,"text":"'Simi lehin iku","marked":"'Símí lẹ́hìn ikú"},{"start":54.247,"end":56.264,"text":"Ki nle ma sin O titi,","marked":"Kí ńlẹ̀ má sìn Ọ́ títí"},{"start":56.644,"end":57.686,"text":"Pelu enia Re.","marked":"Pẹ̀lú enia Rẹ."},{"start":58.066,"end":58.713,"text":"Amin.","marked":"Àmín."}],"end":58.713}]}