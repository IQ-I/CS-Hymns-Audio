{"v":1,"coll":"y","num":271,"id":"hymn_271","title":"APATA aiyeraiye","duration":49.217,"voices":{"male":{"file":"y-271-male.m4a","bytes":356520,"sha256":"b1377f51163670e660de0433edebeaa473620f81389bf27a052e81b37e2db407","duration":49.3},"female":{"file":"y-271-female.m4a","bytes":370422,"sha256":"6fe1af07c19dd5574ccc93745dacea4fec0035a98a907e895fd65b0dd7e9fce0","duration":49.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.686,"text":"APATA aiyeraiye","marked":"Apata aiyérayé"},{"start":2.066,"end":3.256,"text":"Se ibi isadi mi","marked":"Ṣe ibi ìsádi mi"},{"start":3.636,"end":4.803,"text":"Jeki omi on eje","marked":"Jẹki omi on ẹ̀jẹ̀"},{"start":5.183,"end":6.531,"text":"T'o nsan lati iha Re","marked":"T'ó ńsan láti ìhà Rẹ"},{"start":6.911,"end":8.663,"text":"Se iwosan f'ese mi","marked":"Ṣe ìwòsàn f'ẹsẹ̀ mi"},{"start":9.043,"end":10.723,"text":"K'o si so mi di mimo.","marked":"K'ó sì sọ mí di mímọ́́."}],"end":10.723},{"key":"2","start":11.673,"lines":[{"start":11.673,"end":13.157,"text":"K'lse ise owo mi,","marked":"K'lse iṣẹ́ ọwọ́ mi"},{"start":13.537,"end":14.856,"text":"Lo le mu ofin Re se","marked":"Ló lè mú òfin Rẹ̀ ṣẹ"},{"start":15.236,"end":17.173,"text":"B'itara mi ko l'are","marked":"B'ìtara mi kò l'are"},{"start":17.553,"end":19.365,"text":"T'omije mi nsan titi","marked":"T'omijé mi ńsán títí"},{"start":19.745,"end":21.03,"text":"Nwon ko to fun etutu","marked":"Nwọn kò tó fún ètùtù"},{"start":21.41,"end":22.776,"text":"Wo nikan l'o le gbala.","marked":"Wo nìkan l'ó lè gbala."}],"end":22.776},{"key":"3","start":23.726,"lines":[{"start":23.726,"end":25.099,"text":"Ko s' ohun ti mo mu wa","marked":"Kò s' ohun tí mo mú wá"},{"start":25.479,"end":26.734,"text":"Mo ro mo agbelebu","marked":"Mo rọ̀ mọ́ àgbélébùú"},{"start":27.114,"end":28.959,"text":"Mo wa, k'o d'aso bo mi","marked":"Mo wá, k'ó d'áṣọ bò mí"},{"start":29.339,"end":30.922,"text":"Mo nwo O fun iranwo","marked":"Mo ńwò Ó fún ìrànwọ́"},{"start":31.302,"end":32.802,"text":"Mo wa sib'orisun ni","marked":"Mo wá sib'orisun ni"},{"start":33.182,"end":34.943,"text":"We mi, Olugbala mi.","marked":"Wẹ̀ mí, Olùgbàlà mi."}],"end":34.943},{"key":"4","start":35.893,"lines":[{"start":35.893,"end":37.253,"text":"'Gbati emi mi ba nlo","marked":"'Gbàtì ẹ̀mí mi bá ńlọ"},{"start":37.633,"end":39.05,"text":"T'iku ba p'oju mi de","marked":"T'ikú bá p'ojú mi dé"},{"start":39.43,"end":41.182,"text":"Ti mba nlo s'aiye aimo","marked":"Ti mba ńlọ s'áíyé àìmọ́"},{"start":41.562,"end":43.188,"text":"Ti nri o n'ite 'dajo","marked":"Ti ńrí ò ń'ìtẹ́ 'dájọ́"},{"start":43.568,"end":45.043,"text":"Apata aiyeraiye","marked":"Apata aiyérayé"},{"start":45.423,"end":46.734,"text":"Se ibi isadi mi.","marked":"Ṣe ibi ìsádi mi."},{"start":47.114,"end":47.667,"text":"Amin.","marked":"Àmín."}],"end":47.667}]}