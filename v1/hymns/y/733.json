{"v":1,"coll":"y","num":733,"id":"hymn_733","title":"EGBE Kerubu Seraf'","duration":71.128,"voices":{"male":{"file":"y-733-male.m4a","bytes":509678,"sha256":"94a5368aad6c5728c1520169088415ea32c363873a7a4ccdee4e8005d4c59094","duration":71.2},"female":{"file":"y-733-female.m4a","bytes":539098,"sha256":"444c8a9589a53baf269b063442e9c0747785377ed5203870b6f14453da6f44ec","duration":71.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.757,"text":"EGBE Kerubu Seraf'","marked":"Ẹgbẹ́ Kérúbù Séráf'"},{"start":2.137,"end":3.221,"text":"Egbe ogun orun","marked":"Ẹgbẹ́ ogun ọ̀run"},{"start":3.601,"end":5.044,"text":"Egbe awon Aposteli","marked":"Ẹgbẹ́ àwọn Aposteli"},{"start":5.424,"end":6.407,"text":"Egbe ljo Mimo","marked":"Ẹgbẹ́ ljo Mímọ́́"},{"start":6.787,"end":7.865,"text":"Gbogbo won loke orun","marked":"Gbogbo wọn lókè ọ̀run"},{"start":8.245,"end":9.924,"text":"Nyin O t'osan, t'oru","marked":"Nyin O t'ọ̀sán, t'oru"},{"start":10.304,"end":11.448,"text":"W'Olorun Metalokan","marked":"W'Ọlọ́run Mẹ́talọ́kan"},{"start":11.828,"end":13.072,"text":"Oga Ogo julo.","marked":"Ọ̀gá Ògo jùlọ."}],"end":13.072},{"key":"2","start":14.022,"lines":[{"start":14.022,"end":15.186,"text":"Awa Egbe Serafu","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":15.566,"end":17.459,"text":"Aiye nyin O, Baba","marked":"Aiye nyin O, Bàbá"},{"start":17.839,"end":19.804,"text":"lfe Tire ni ki a se","marked":"lfẹ́ Tírè ni kí a ṣe"},{"start":20.184,"end":21.436,"text":"Bi nwon ti nse lorun","marked":"Bí nwọn ti ńṣe lọ́run"},{"start":21.816,"end":23.17,"text":"Pelu wa b'a ti pejo","marked":"Pẹ̀lú wa b'á ti péjọ"},{"start":23.55,"end":24.654,"text":"Je k'a le sin l'emi","marked":"Jẹ k'á lè sìn l'èmi"},{"start":25.034,"end":26.601,"text":"Baba wa, jo sokale","marked":"Bàbá wa, jọ sọ̀kalẹ̀"},{"start":26.981,"end":28.264,"text":"F'Ogo Re han nihin.","marked":"F'Ògo Rẹ hàn níhìn."}],"end":28.264},{"key":"3","start":29.214,"lines":[{"start":29.214,"end":30.413,"text":"Larin ainiye ibi","marked":"Lárin àìníye ibi"},{"start":30.793,"end":32.158,"text":"To rogba yi w'a ka","marked":"Tó rọ̀gbà yí w'á ká"},{"start":32.538,"end":33.936,"text":"Larin 'jamba on 'ponju","marked":"Larin 'jàm̀bá on 'pọ́njú"},{"start":34.316,"end":35.393,"text":"To ja ni igboro wa","marked":"Tó jà ní ìgboro wa"},{"start":35.773,"end":36.976,"text":"Emi o f'ope fun O","marked":"Èmi ò f'ọpẹ́ fún Ọ"},{"start":37.356,"end":38.718,"text":"Tori Iwo da mi si","marked":"Torí Ìwọ dá mi sí"},{"start":39.098,"end":40.141,"text":"Oba Afenife-re","marked":"Ọba Afẹ́nifẹ́-rẹ̀"},{"start":40.521,"end":41.68,"text":"Ogo f'Oruko Re.","marked":"Ògo f'Orúkọ Rẹ."}],"end":41.68},{"key":"4","start":42.63,"lines":[{"start":42.63,"end":44.041,"text":"Gba Noah rubo ope","marked":"Gba Noah rúbọ ọpẹ́"},{"start":44.421,"end":45.703,"text":"Wo f'osumare han","marked":"Wo f'òṣùmàrè hàn"},{"start":46.083,"end":47.202,"text":"Majemu pe ikunmi","marked":"Májẹ̀mú pé ikunmi"},{"start":47.582,"end":48.671,"text":"Ki yio bo aiye mo","marked":"Kí yio bo aiye mọ́"},{"start":49.051,"end":50.419,"text":"Baba f'osumare han","marked":"Bàbá f'òṣùmàrè hàn"},{"start":50.799,"end":52.038,"text":"N'irubo isin wa","marked":"N'ìrúbọ ìsìn wa"},{"start":52.418,"end":53.564,"text":"K'a mase ri ibi mo","marked":"K'á máṣe rí ibi mọ́"},{"start":53.944,"end":55.176,"text":"Jakejado le wa.","marked":"Jákèjádò lè wà."}],"end":55.176},{"key":"5","start":56.126,"lines":[{"start":56.126,"end":57.458,"text":"We lo d'Egbe yi sile","marked":"Wé lọ d'Ẹgbẹ́ yí sílẹ̀"},{"start":57.838,"end":59.123,"text":"Se Egbe na logo","marked":"Ṣe Ẹgbẹ́ ná lógo"},{"start":59.503,"end":60.855,"text":"S'Amona at'Odi re","marked":"S'Amọ̀nà àt'Ódì rẹ̀"},{"start":61.235,"end":62.348,"text":"Larin danwo aiye","marked":"Larin dánwò aiye"},{"start":62.728,"end":63.716,"text":"Baba Olodumare","marked":"Bàbá Olódùmarè"},{"start":64.096,"end":65.491,"text":"Wo lo npe ko yeni","marked":"Wo ló ńpẹ́ kò yéni"},{"start":65.871,"end":67.281,"text":"Jek'o y'Egbe yi kale","marked":"Jek'ó y'Ègbé yí kalẹ̀"},{"start":67.661,"end":68.651,"text":"Nitori Omo Re.","marked":"Nítorí Ọmọ Rẹ."},{"start":69.031,"end":69.578,"text":"Amin.","marked":"Àmín."}],"end":69.578}]}