{"v":1,"coll":"y","num":64,"id":"hymn_64","title":"'BUKUN ni f'awon mimo","duration":59.49,"voices":{"male":{"file":"y-64-male.m4a","bytes":427974,"sha256":"6bb475088351dc34986a57a558dcb574fbabbf015f590e895db6a0fd9ef06cf1","duration":59.5},"female":{"file":"y-64-female.m4a","bytes":447212,"sha256":"63b63f101a0e23d1f1f853cddefe60e64c6150ed330df44a9e711603a7227ba8","duration":59.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.717,"text":"'BUKUN ni f'awon mimo","marked":"'Bùkún ní f'àwọn mímọ́́"},{"start":2.097,"end":3.273,"text":"Won ti ko 'se angeli","marked":"Wọ́n tí kò 'ṣe áńgẹ́lì"},{"start":3.653,"end":4.755,"text":"Orun n'ife okan won","marked":"Ọ̀run ń'ífẹ́ ọkàn wọn"},{"start":5.135,"end":6.733,"text":"Won fe lati r'Olorun","marked":"Wọ́n fẹ́ láti r'Ọlọ́run"},{"start":7.113,"end":8.375,"text":"A we abawon won nu","marked":"A wé àbàwọ́n wọn nù"},{"start":8.755,"end":10.186,"text":"Won n'idapo pelu Re","marked":"Wọ́n ń'ìdàpọ̀ pẹ̀lú Rẹ"},{"start":10.566,"end":11.6,"text":"Won dabi Oluwa won","marked":"Wọ́n dàbí Olúwa wọn"},{"start":11.98,"end":13.359,"text":"Ti ise ere nla fun won.","marked":"Ti iṣẹ́ eré ńlá fún wọn."}],"end":13.359},{"key":"2","start":14.309,"lines":[{"start":14.309,"end":16.067,"text":"Won n'josin ninu emi","marked":"Wọ́n ń'jọ́sìn nínú ẹ̀mí"},{"start":16.447,"end":17.775,"text":"Won wole ni'bi'te Re","marked":"Wọ́n wọlé ní'bí'tẹ̀ Rẹ"},{"start":18.155,"end":19.478,"text":"Won te ba nib'imole","marked":"Wọ́n tẹ̀ ba níb'ìmọ́lẹ̀̀"},{"start":19.858,"end":20.841,"text":"lmole Olorun tan","marked":"lmọ́lẹ̀ Ọlọ́run tán"},{"start":21.221,"end":22.192,"text":"Awon olokan-riro","marked":"Àwọn ọlọ́kàn-ríro"},{"start":22.572,"end":24.234,"text":"Ti won fe lati kekoo","marked":"Tí wọ́n fẹ́ láti kẹ́kọ̀ọ́"},{"start":24.614,"end":26.22,"text":"Won wa inu Oro naa","marked":"Wọ́n wá inú Ọ̀rọ̀ náà"},{"start":26.6,"end":28.17,"text":"Titi won fi gb'ohun Re.","marked":"Títí wọ́n fi gb'óhùn Rẹ."}],"end":28.17},{"key":"3","start":29.12,"lines":[{"start":29.12,"end":30.431,"text":"Oun ni Eleda won","marked":"Òun ni Ẹlẹ́dàá wọn"},{"start":30.811,"end":32.299,"text":"Won ba Oun nikan soro","marked":"Wọ́n bá Òun nìkan sọ̀rọ̀"},{"start":32.679,"end":34.192,"text":"Lat'ooro di asale","marked":"Lát'ooro di aṣálẹ̀"},{"start":34.572,"end":36.397,"text":"Ni won nyin l'Ojo 'sinmi","marked":"Ni wọ́n nyin l'Ojo 'sinmi"},{"start":36.777,"end":38.377,"text":"Won di Ii mu ninu laalaa","marked":"Wọ́n di Íì mú nínú làálàá"},{"start":38.757,"end":40.321,"text":"Won gbekele e n'nu 'ponju","marked":"Wọ́n gbẹ́kẹ̀lé e ń'nú 'pọ́njú"},{"start":40.701,"end":41.973,"text":"lmole Re n tan n'nu won","marked":"lmọ́lẹ̀ Rẹ̀ ń tan ń'nú wọn"},{"start":42.353,"end":43.706,"text":"Ayida ko bori re.","marked":"Àyídà kò borí rẹ̀."}],"end":43.706},{"key":"4","start":44.656,"lines":[{"start":44.656,"end":45.93,"text":"Oun ni won n yin l'aye won","marked":"Òun ni wọ́n ń yìn l'áyé wọn"},{"start":46.31,"end":47.43,"text":"Won ki yoo ri iku mo","marked":"Wọn kì yóò rí ikú mọ́"},{"start":47.81,"end":49.155,"text":"Won yoo maa b'Oluwa gbe","marked":"Wọn yóò máa b'Olúwa gbé"},{"start":49.535,"end":51.0,"text":"Titi won yoo fi jinde","marked":"Títí wọn yóò fi jíǹde"},{"start":51.38,"end":52.623,"text":"Won yoo sunmo Oluwa","marked":"Wọn yóò súnmọ́ Olúwa"},{"start":53.003,"end":54.215,"text":"Pelu ara ajinde","marked":"Pẹ̀lú ara àjíǹde"},{"start":54.595,"end":55.763,"text":"Pelu Baba n'nu Omo","marked":"Pẹ̀lú Bàbá ń'nú Ọmọ"},{"start":56.143,"end":57.94,"text":"At'Emi, metalokan.","marked":"Àt'Èmi, Mẹ́talọ́kan."}],"end":57.94}]}