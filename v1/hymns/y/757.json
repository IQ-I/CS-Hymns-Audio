{"v":1,"coll":"y","num":757,"id":"hymn_757","title":"A! nwon ti gun s'ebute","duration":76.618,"voices":{"male":{"file":"y-757-male.m4a","bytes":567260,"sha256":"0aa2c4fb977109ea35b0e82675ae9e6478193e3787cd9a6cbf9d5aa76472f052","duration":76.7},"female":{"file":"y-757-female.m4a","bytes":585102,"sha256":"f226ec553c2479b6dd7b7141ed0982e4eb9a33e30bb2efaab3e3d113c9f79707","duration":76.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.58,"text":"A! nwon ti gun s'ebute","marked":"A! nwọn ti gun s'èbúté"},{"start":1.96,"end":3.881,"text":"Loke orun, Loke orun","marked":"Lókè ọ̀run, Lókè ọ̀run"},{"start":4.261,"end":5.665,"text":"Ebi ko ni pa won mo","marked":"Ebi kò ní pa wọ́n mọ́"},{"start":6.045,"end":7.256,"text":"Nown bo lowo irora","marked":"Nown bọ́ lọ́wọ́ ìrora"},{"start":7.636,"end":9.703,"text":"Loke orun, Loke orun.","marked":"Lókè ọ̀run, Lókè ọ̀run."}],"end":9.703},{"key":"2","start":10.653,"lines":[{"start":10.653,"end":12.238,"text":"A! nwon ko wa fitila","marked":"A! nwọn kò wá fìtílà"},{"start":12.618,"end":14.856,"text":"Loke orun: loke orun","marked":"Lókè ọ̀run: lókè ọ̀run"},{"start":15.236,"end":16.876,"text":"Mole ni I'ojo gbogbo","marked":"Mọ́lẹ̀ ní l'ọjọ́ gbogbo"},{"start":17.256,"end":18.62,"text":"Jesu si n'lmole won","marked":"Jésù sì ń'lmọ́lẹ̀ wọn"},{"start":19.0,"end":20.937,"text":"Loke orun: loke orun.","marked":"Lókè ọ̀run: lókè ọ̀run."}],"end":20.937},{"key":"3","start":21.887,"lines":[{"start":21.887,"end":23.593,"text":"A! wura n'ita won je","marked":"A! wúrà ń'íta wọn jẹ́"},{"start":23.973,"end":26.183,"text":"Loke orun: loke orun","marked":"Lókè ọ̀run: lókè ọ̀run"},{"start":26.563,"end":27.818,"text":"Ogo 'be si po pupo","marked":"Ògo 'bẹ̀ sì pọ̀ púpọ̀"},{"start":28.198,"end":29.883,"text":"Agbo Jesu ni nwon je","marked":"Agbo Jésù ní ǹwọ̀n jẹ́"},{"start":30.263,"end":32.329,"text":"Loke orun: loke orun.","marked":"Lókè ọ̀run: lókè ọ̀run."}],"end":32.329},{"key":"4","start":33.279,"lines":[{"start":33.279,"end":34.591,"text":"A! otutu ki mu won","marked":"A! òtútù kì mú wọn"},{"start":34.971,"end":37.367,"text":"Loke orun: loke orun","marked":"Lókè ọ̀run: lókè ọ̀run"},{"start":37.747,"end":38.799,"text":"Owore won ti koja","marked":"Owore wọn ti kọjá"},{"start":39.179,"end":40.238,"text":"Gbogbo ojo l'o dara","marked":"Gbogbo ọjọ́ l'ó dára"},{"start":40.618,"end":42.285,"text":"Loke orun: loke orun.","marked":"Lókè ọ̀run: lókè ọ̀run."}],"end":42.285},{"key":"5","start":43.235,"lines":[{"start":43.235,"end":44.827,"text":"A! nwon dekun ija ja","marked":"A! nwọn dẹ́kun ìjà jà"},{"start":45.207,"end":47.414,"text":"Loke orun: loke orun","marked":"Lókè ọ̀run: lókè ọ̀run"},{"start":47.794,"end":49.357,"text":"Jesu l'o ti gba won la","marked":"Jésù l'ó ti gbà wọ́n là"},{"start":49.737,"end":51.1,"text":"T'awon Tire l'o si nrin","marked":"T'àwọn Tírè l'ó sì ńrìn"},{"start":51.48,"end":52.957,"text":"Loke orun: loke orun.","marked":"Lókè ọ̀run: lókè ọ̀run."}],"end":52.957},{"key":"6","start":53.907,"lines":[{"start":53.907,"end":55.52,"text":"A! nwon ko ni sokun mo","marked":"A! nwọn kò ní sókun mọ́"},{"start":55.9,"end":57.825,"text":"Loke orun: loke orun","marked":"Lókè ọ̀run: lókè ọ̀run"},{"start":58.205,"end":59.7,"text":"Jesu sa wa lodo won","marked":"Jésù sá wa lọ́dọ̀ wọn"},{"start":60.08,"end":61.642,"text":"Lodo Re ni ayo wa","marked":"Lọ́dọ̀ Rẹ̀ ni ayọ̀ wà"},{"start":62.022,"end":64.044,"text":"Loke orun: loke orun.","marked":"Lókè ọ̀run: lókè ọ̀run."}],"end":64.044},{"key":"7","start":64.994,"lines":[{"start":64.994,"end":66.681,"text":"A! a o dapo mo won","marked":"A! a ò dàpọ̀ mọ́ wọn"},{"start":67.061,"end":69.011,"text":"Loke orun: Ioke orun","marked":"Lókè ọ̀run: lókè ọ̀run"},{"start":69.391,"end":70.693,"text":"A nreti akoko wa","marked":"A nrètí àkókò wa"},{"start":71.073,"end":72.587,"text":"Gba Oluwa ba pe ni","marked":"Gba Olúwa bá pẹ́ ni"},{"start":72.967,"end":75.068,"text":"S'Oke orun, S'oke orun.","marked":"S'Òkè ọ̀run, S'òkè ọ̀run."}],"end":75.068}]}