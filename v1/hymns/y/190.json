{"v":1,"coll":"y","num":190,"id":"hymn_190","title":"OJO 'binu ojo eru","duration":29.49,"voices":{"male":{"file":"y-190-male.m4a","bytes":213028,"sha256":"642efc90ea1c58a9f9b5ca3b06cec4268a69289c7f71da7cdb3c3e2093f27cac","duration":29.5},"female":{"file":"y-190-female.m4a","bytes":218815,"sha256":"21e6265df0309cf15bc9cd6453b43df3519aa710f1eb34c50be90b3e719ea697","duration":29.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.539,"text":"OJO 'binu ojo eru","marked":"Ọjọ́ 'bínú ọjọ́ ẹrú"},{"start":1.919,"end":3.857,"text":"T'aiye at'orun y'o fo lo","marked":"T'aiye àt'ọrùn y'ó fò lọ"},{"start":4.237,"end":5.616,"text":"Kin'igbekele elese","marked":"Kín'ígbẹ́kẹ̀lé ẹlẹ́sẹ̀"},{"start":5.996,"end":7.744,"text":"Y'o se le yoju l'ojo na?","marked":"Y'ó ṣe lè yọjú l'ọjọ́ ná?"}],"end":7.744},{"key":"2","start":8.694,"lines":[{"start":8.694,"end":10.657,"text":"Nigbati orun y'o kako","marked":"Nígbàtí ọrùn y'ó kákò"},{"start":11.037,"end":13.403,"text":"Bi awo ti a fi ina sun","marked":"Bí awọ tí a fi iná sun"},{"start":13.783,"end":15.285,"text":"T'ipe ajinde y'o ma dun","marked":"T'ìpè àjíǹde y'ó mà dùn"},{"start":15.665,"end":17.819,"text":"Kikankina, teruteru.","marked":"Kikankina, tẹ̀rùtẹ̀rù."}],"end":17.819},{"key":"3","start":18.769,"lines":[{"start":18.769,"end":20.742,"text":"A! l'ojo na, ojo 'binu","marked":"A! l'ọjọ́ ná, ọjọ́ 'bínú"},{"start":21.122,"end":22.758,"text":"T eda yio ji si dajo","marked":"T ẹ̀dà yio jí sí dájọ́"},{"start":23.138,"end":25.112,"text":"Kristi, jo ji si dajo","marked":"Kristi, jọ jí sí dájọ́"},{"start":25.492,"end":27.059,"text":"'Gba t'ayie t'orun ba fo lo.","marked":"'Gbá t'àyíé t'orun bá fò lọ."},{"start":27.439,"end":27.94,"text":"Amin.","marked":"Àmín."}],"end":27.94}]}