{"v":1,"coll":"y","num":790,"id":"hymn_790","title":"GBOGBO talaka ti mo mo","duration":48.527,"voices":{"male":{"file":"y-790-male.m4a","bytes":341781,"sha256":"8aa8a49eceb0f5261daebf9e5e3b1c2b121d914cbcaec45a502c4438ef210161","duration":48.6},"female":{"file":"y-790-female.m4a","bytes":355800,"sha256":"88505d09975524c7319d704a4e9b29efba2569373740fc623c6bc32b2a1e173f","duration":48.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.786,"text":"GBOGBO talaka ti mo mo","marked":"Gbogbo tálákà tí mo mọ̀"},{"start":2.166,"end":3.473,"text":"Nwonti po n'iye to","marked":"Nwọ̀ntì pọ̀ n'iye tó"},{"start":3.853,"end":5.348,"text":"Kini mba se f'Olorun mi","marked":"Kíni mba ṣe f'Ọlọ́run mi"},{"start":5.728,"end":6.778,"text":"Fun gbogbo ebun Re?","marked":"Fún gbogbo ẹ̀bùn Rẹ?"}],"end":6.778},{"key":"2","start":7.728,"lines":[{"start":7.728,"end":9.453,"text":"Mo san j'awon elomi ni","marked":"Mo ṣàn j'àwọn ẹlòmí ni"},{"start":9.833,"end":11.206,"text":"T'Olorun se nke mi?","marked":"T'Ọlọ́run ṣe ǹkẹ́ mi?"},{"start":11.586,"end":13.742,"text":"Awon ti nkiri, ti nsagbe","marked":"Àwọn tí ńkiri, ti ńṣagbe"},{"start":14.122,"end":15.148,"text":"Lati ile de 'le?","marked":"Láti ilé dé 'lé?"}],"end":15.148},{"key":"3","start":16.098,"lines":[{"start":16.098,"end":17.336,"text":"Alakisa omo melo","marked":"Àlàkísà ọmọ mélò"},{"start":17.716,"end":18.986,"text":"Ni mbe l'otutu yi?","marked":"Ní ḿbẹ l'òtútù yí?"},{"start":19.366,"end":21.105,"text":"Gbati a fi aso wo mi","marked":"Gbátí a fi aṣọ wọ̀ mí"},{"start":21.485,"end":22.65,"text":"Lat' ori d'ese mi.","marked":"Lát' orí d'ẹsẹ̀ mi."}],"end":22.65},{"key":"4","start":23.6,"lines":[{"start":23.6,"end":25.263,"text":"Gba t'awon mi se alairi","marked":"Gba t'àwọ̀n mi ṣe aláìrí"},{"start":25.643,"end":26.82,"text":"Ibi gb'ori won le","marked":"Ibi gb'orí wọn le"},{"start":27.2,"end":28.78,"text":"Emi ni ile lati gbe","marked":"Èmi ni ilé láti gbé"},{"start":29.16,"end":30.323,"text":"Ati 'bukun rere.","marked":"Àti 'bùkún rere."}],"end":30.323},{"key":"5","start":31.273,"lines":[{"start":31.273,"end":33.41,"text":"Gbat awon mi, ti nwon npuro","marked":"Gbat àwọn mi, tí nwọn npuro"},{"start":33.79,"end":35.599,"text":"Ti njale, ti mbura","marked":"Ti ńjálẹ̀, ti ḿbúra"},{"start":35.979,"end":37.369,"text":"Ni mo ti ko iberu Re","marked":"Ni mo ti kọ ìbẹ̀rù Rẹ"},{"start":37.749,"end":38.9,"text":"Lati igba ewe mi.","marked":"Láti ìgbà èwe mi."}],"end":38.9},{"key":"6","start":39.85,"lines":[{"start":39.85,"end":41.636,"text":"Sa wo, bi oju rere Re","marked":"Sá wọ̀, bí ojú rere Rẹ"},{"start":42.016,"end":43.311,"text":"S'emi nikan ti po","marked":"S'èmi nìkan ti pọ̀"},{"start":43.691,"end":45.393,"text":"Nje o ye ki nfe O pupo","marked":"Ǹjẹ́ ó yẹ kí nfẹ́ O púpọ̀"},{"start":45.773,"end":46.977,"text":"Ki nma sin O rere?","marked":"Kí ńmá sin Ọ́ rere?"}],"end":46.977}]}