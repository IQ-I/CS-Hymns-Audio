{"v":1,"coll":"y","num":827,"id":"hymn_827","title":"MOSE Orimolade","duration":78.032,"voices":{"male":{"file":"y-827-male.m4a","bytes":552768,"sha256":"4c05b3344b05035d236a104b1a29d400aae829b51c49822e5b1d573741e84622","duration":78.1},"female":{"file":"y-827-female.m4a","bytes":577395,"sha256":"92d1546038f30cecf63a0ad9a6d2f28de7fe039f533ba0f9b9b1735b4ecd757e","duration":78.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.803,"text":"MOSE Orimolade","marked":"Mósè Orímọládé"},{"start":2.183,"end":3.006,"text":"Ni Oluko wa,","marked":"Ní Olùkọ́ wa"},{"start":3.386,"end":4.573,"text":"Olorun ran s'aiye","marked":"Ọlọ́run rán s'aiye"},{"start":4.953,"end":6.548,"text":"Lati d'egbe yi sile.","marked":"Láti d'ẹgbẹ́ yí sílẹ̀."}],"end":6.548},{"key":"CHORUS","start":7.498,"lines":[{"start":7.498,"end":9.558,"text":"Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":9.938,"end":11.012,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":11.012},{"key":"2","start":11.962,"lines":[{"start":11.962,"end":13.106,"text":"Olorun Tunolase","marked":"Ọlọ́run Túnọláṣẹ"},{"start":13.486,"end":14.659,"text":"Ran Emi re si wa,","marked":"Rán Ẹ̀mí rẹ sí wa"},{"start":15.039,"end":16.51,"text":"Ka mase se aseti","marked":"Ká máṣe ṣe àṣetì"},{"start":16.89,"end":18.057,"text":"Ninu adura wa.","marked":"Nínú àdúrà wa."},{"start":18.437,"end":20.451,"text":"Egbe: Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":20.831,"end":21.925,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":21.925},{"key":"3","start":22.875,"lines":[{"start":22.875,"end":24.283,"text":"Ma je k'esu tan wa,","marked":"Má jẹ k'èṣù tàn wá"},{"start":24.663,"end":26.122,"text":"Lati se Tunolase","marked":"Láti ṣe Túnọláṣẹ"},{"start":26.502,"end":27.503,"text":"Ka ma d'eni egbe","marked":"Ká má d'ẹni ẹgbẹ́"},{"start":27.883,"end":29.042,"text":"Ni ojo ikehin.","marked":"Ní ọjọ́ ìkẹhìn."},{"start":29.422,"end":31.386,"text":"Egbe: Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":31.766,"end":32.985,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":32.985},{"key":"4","start":33.935,"lines":[{"start":33.935,"end":35.273,"text":"Lonakona t'ota,","marked":"Lọ́nàkọnà t'ọ̀tá"},{"start":35.653,"end":36.97,"text":"Ba ngbogun re si wa;","marked":"Bá ńgbógun rẹ̀ sí wa"},{"start":37.35,"end":38.276,"text":"Baba Olusegun,","marked":"Bàbá Olùṣègùn"},{"start":38.656,"end":40.218,"text":"Segun logan fun wa.","marked":"Ṣẹ́gun lọ́gán fún wa."},{"start":40.598,"end":42.712,"text":"Egbe: Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":43.092,"end":44.415,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":44.415},{"key":"5","start":45.365,"lines":[{"start":45.365,"end":46.493,"text":"Gbogbo eyin te duro","marked":"Gbogbo eyín tẹ̀ dúró"},{"start":46.873,"end":48.285,"text":"Lati je omo Mose","marked":"Láti jẹ́ ọmọ Mósè"},{"start":48.665,"end":49.729,"text":"Olupilese IYE","marked":"Olùpilẹ̀ṣẹ̀ Ìyè"},{"start":50.109,"end":51.319,"text":"Yio di nyin mu dopin.","marked":"Yíó di nyin mú dópin."},{"start":51.699,"end":53.513,"text":"Egbe: Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":53.893,"end":54.969,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":54.969},{"key":"6","start":55.919,"lines":[{"start":55.919,"end":57.141,"text":"A nlo si ile wa,","marked":"A ńlọ sí ilé wa"},{"start":57.521,"end":58.925,"text":"F'ogun orun yi wa ka","marked":"F'ogun ọ̀run yí wa ká"},{"start":59.305,"end":60.765,"text":"Ki gbogbo ibi aiye","marked":"Kí gbogbo ibi aiye"},{"start":61.145,"end":62.401,"text":"Ma le se wa nibi.","marked":"Má lè ṣe wá níbí."},{"start":62.781,"end":64.691,"text":"Egbe: Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":65.071,"end":66.149,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":66.149},{"key":"7","start":67.099,"lines":[{"start":67.099,"end":68.097,"text":"Baba Aladura","marked":"Bàbá Aládúrà"},{"start":68.477,"end":69.772,"text":"Ti Baba gbe dide","marked":"Tí Bàbá gbé dìde"},{"start":70.152,"end":71.15,"text":"K'Olorun ran lowo","marked":"K'Ọlọ́run ràn lọ́wọ́"},{"start":71.53,"end":72.695,"text":"Ko gbowo re soke.","marked":"Kò gbowó rẹ̀ sókè."},{"start":73.075,"end":74.967,"text":"Egbe: Kerubu, Serafu l'o so","marked":"Kérúbù, Séráfù l'ó sọ"},{"start":75.347,"end":76.482,"text":"Oruko Egbe na.(2ce)","marked":"Orúkọ Ẹgbẹ́ ná."}],"end":76.482}]}