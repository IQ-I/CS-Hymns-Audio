{"v":1,"coll":"y","num":206,"id":"hymn_206","title":"GBO, eda orun nkorin","duration":46.505,"voices":{"male":{"file":"y-206-male.m4a","bytes":344177,"sha256":"7abdf74f960940f7ca76fd176a3311f2eeefb971f6c4dd288d2cabb0945640b8","duration":46.6},"female":{"file":"y-206-female.m4a","bytes":358999,"sha256":"d2f5596126d8e1387ebd9c6c87480797e38c10066782c3ce3a37fede9a92fda5","duration":46.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.429,"text":"GBO, eda orun nkorin:","marked":"Gbọ́, ẹ̀dá ọ̀run nkorin"},{"start":2.809,"end":3.882,"text":"“Ogo fun Oba t'a bi“","marked":"Ògo fún Ọba t'á bí"},{"start":4.262,"end":5.636,"text":"“Alafia laiye yi,","marked":"Àlàáfíà laiye yí"},{"start":6.016,"end":7.229,"text":"Olorun ba wa laja,","marked":"Ọlọ́run bá wa lájà"},{"start":7.609,"end":8.898,"text":"Gbogbo eda nde layo;","marked":"Gbogbo ẹ̀dá ńdẹ láyọ̀"},{"start":9.278,"end":10.611,"text":"Dapo mo hiho orun;","marked":"Dàpọ̀ mọ́ híhò ọ̀run"},{"start":10.991,"end":12.31,"text":"W' Alade Alafia!","marked":"W' Aládé Àlàáfíà!"},{"start":12.69,"end":14.144,"text":"Wo, Orun ododo de.","marked":"Wò, Ọ̀run òdodo dé."}],"end":14.144},{"key":"2","start":15.094,"lines":[{"start":15.094,"end":16.67,"text":"O bo'go Re s'apakan;","marked":"Ó bọ́'go Rẹ̀ s'apakan"},{"start":17.05,"end":18.349,"text":"A bi k'enia ma ku;","marked":"A bí k'enia ma kú"},{"start":18.729,"end":20.508,"text":"Abi k' o'gb'enia ro;","marked":"Àbí k' ò'gb'enia rò"},{"start":20.888,"end":22.699,"text":"A bi k' o le tun wa bi.","marked":"A bí k' ó lè tún wá bí."},{"start":23.079,"end":24.993,"text":"Wa, ireti enia","marked":"Wà, ìrètí enia"},{"start":25.373,"end":26.675,"text":"Se ile Re ninu wa","marked":"Ṣe ilé Rẹ nínú wa"},{"start":27.055,"end":28.941,"text":"N'de, lru omobinrin","marked":"N'de, lru ọmọbìnrin"},{"start":29.321,"end":30.529,"text":"Bori esu ninu wa.","marked":"Borí èṣù nínú wa."}],"end":30.529},{"key":"3","start":31.479,"lines":[{"start":31.479,"end":32.758,"text":"Pa aworan Adam run;","marked":"Pa àwòrán Ádám run"},{"start":33.138,"end":34.756,"text":"F' aworun Re s'ipo re;","marked":"F' àwòrun Rẹ s'ipò rẹ"},{"start":35.136,"end":36.676,"text":"Jo masai f' Emi Re kun,","marked":"Jó máṣàì f' Emi Rẹ kún"},{"start":37.056,"end":38.41,"text":"Okan gbogbo' onigbagbo,","marked":"Ọ̀kan gbogbo' onígbàgbọ́"},{"start":38.79,"end":40.027,"text":"“Ogo fun Oba t' a bi”","marked":"Ògo fún Ọba t' á bí"},{"start":40.407,"end":41.719,"text":"Jeki gbogbo wa gberin;","marked":"Jẹki gbogbo wa gberin"},{"start":42.099,"end":43.333,"text":"\"Alafia laiye yi\"","marked":"Àlàáfíà laiye yí"},{"start":43.713,"end":44.955,"text":"Olorun ba wa laja.","marked":"Ọlọ́run bá wa lájà."}],"end":44.955}]}