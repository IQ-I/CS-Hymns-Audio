{"v":1,"coll":"y","num":197,"id":"hymn_197","title":"OJO nla kan ma mbo","duration":30.11,"voices":{"male":{"file":"y-197-male.m4a","bytes":206167,"sha256":"b7ef0f5df623b88976b189f7737f404f9fea1c7f528499059fc2acaa2d72e685","duration":30.2},"female":{"file":"y-197-female.m4a","bytes":217638,"sha256":"181e1dd4635767d3aa688f24be3ad3b90e0260a484374b043d3f18f088f7e85c","duration":30.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.591,"text":"OJO nla kan ma mbo","marked":"Ọjọ́ ńlá kan mà ḿbọ̀"},{"start":1.971,"end":3.405,"text":"T'Olusiro y'o de,","marked":"T'Olùṣirò y'ó dé"},{"start":3.785,"end":4.857,"text":"Gbogbo eniyan y'o ri","marked":"Gbogbo ènìyàn y'ó rí"},{"start":5.237,"end":6.331,"text":"Aye yio wariri.","marked":"Ayé yio wárìrì."}],"end":6.331},{"key":"2","start":7.281,"lines":[{"start":7.281,"end":8.466,"text":"Igbagbo re ha da","marked":"Ìgbàgbọ́́ rẹ ha dá"},{"start":8.846,"end":9.989,"text":"Wo ti ko m'Olorun","marked":"Wo tí kò m'Ọlọ́run"},{"start":10.369,"end":11.727,"text":"T'o f'eda se igbekele","marked":"T'ó f'ẹ̀dà ṣe ìgbẹ́kẹ̀lé"},{"start":12.107,"end":13.436,"text":"T'o f' Oluwa sile.","marked":"T'ó f' Olúwa sílẹ̀."}],"end":13.436},{"key":"3","start":14.386,"lines":[{"start":14.386,"end":15.575,"text":"Ayo pupo yio wa,","marked":"Ayọ̀ púpọ̀ yío wà"},{"start":15.955,"end":17.504,"text":"L'okan ti Jesu ngbe","marked":"L'ọ́kàn tí Jésù ńgbẹ̀"},{"start":17.884,"end":19.296,"text":"Ti nwon ti ko aiye sile","marked":"Tí nwọn ti kọ àìyẹ́ sílẹ̀"},{"start":19.676,"end":20.667,"text":"T'o gba Emi Mimo.","marked":"T'ó gba Ẹ̀mí Mímọ́́."}],"end":20.667},{"key":"4","start":21.617,"lines":[{"start":21.617,"end":22.629,"text":"E ku 'se Oluwa","marked":"Ẹ kú 'ṣe Olúwa"},{"start":23.009,"end":24.332,"text":"Enyin ara at'ore","marked":"Enyin ará àt'ọ̀rẹ́"},{"start":24.712,"end":25.901,"text":"Ki Baba Olodumare","marked":"Kí Bàbá Olódùmarè"},{"start":26.281,"end":27.665,"text":"Bukun fun gbogbo wa.","marked":"Bùkún fún gbogbo wa."},{"start":28.045,"end":28.56,"text":"Amin.","marked":"Àmín."}],"end":28.56}]}