{"v":1,"coll":"y","num":272,"id":"hymn_272","title":"SA dake okan mi","duration":30.755,"voices":{"male":{"file":"y-272-male.m4a","bytes":214455,"sha256":"8229d2bb2f2d7c3ede7b8c782c2f099b695e42ed7b5d70e3b9e4905b19367d42","duration":30.8},"female":{"file":"y-272-female.m4a","bytes":223957,"sha256":"eea3bd962d12a23956329bc6835ca856319bffea231636095086f8e620ed1dce","duration":30.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.365,"text":"SA dake okan mi","marked":"Ṣá dákẹ́ ọkàn mi"},{"start":1.745,"end":2.845,"text":"Oluwa re wa mbe","marked":"Olúwa rẹ̀ wá mbẹ́"},{"start":3.225,"end":4.762,"text":"Enit' o ti se ileri","marked":"Enit' ò ti ṣe ìlérí"},{"start":5.142,"end":6.399,"text":"Yio fe mu u se.","marked":"Yíó fẹ́ mú u ṣe."}],"end":6.399},{"key":"2","start":7.349,"lines":[{"start":7.349,"end":8.438,"text":"On ti fa O lowo","marked":"On ti fà Ọ́ lọ́wọ́"},{"start":8.818,"end":9.899,"text":"Omu o de 'hin yi","marked":"Òmu ò dé 'hin yí"},{"start":10.279,"end":12.158,"text":"Y'o pa o mo la ewu ja","marked":"Y'ó pa ọ́ mọ́ la ewu já"},{"start":12.538,"end":13.999,"text":"Tit' opin aiye re.","marked":"Tít' òpin aiye rẹ."}],"end":13.999},{"key":"3","start":14.949,"lines":[{"start":14.949,"end":16.207,"text":"Nigbat'iwo ti bo","marked":"Nígbat'ìwò ti bọ́"},{"start":16.587,"end":17.639,"text":"Sinu wahala ri","marked":"Sínú wàhálà rí"},{"start":18.019,"end":19.905,"text":"lgbe re na ki On ha gbo","marked":"lgbẹ́ rẹ̀ ná kí Ón ha gbó"},{"start":20.285,"end":21.401,"text":"T'o si yo O kuro?","marked":"T'ó sì yọ Ọ́ kúrò?"}],"end":21.401},{"key":"4","start":22.351,"lines":[{"start":22.351,"end":23.522,"text":"B'ona ko tile dan","marked":"B'ọ́nà kò tilẹ̀ dán"},{"start":23.902,"end":24.883,"text":"Yio mu o de 'le","marked":"Yíó mú ọ dé 'le"},{"start":25.263,"end":26.811,"text":"Sa ti wahala aiye tan","marked":"Sá ti wàhálà aiye tán"},{"start":27.191,"end":28.218,"text":"O san fun gbogbo re.","marked":"Ó sàn fún gbogbo rẹ̀."},{"start":28.598,"end":29.205,"text":"Amin.","marked":"Àmín."}],"end":29.205}]}