{"v":1,"coll":"y","num":397,"id":"hymn_397","title":"BAWO ni awon ewe wa","duration":32.297,"voices":{"male":{"file":"y-397-male.m4a","bytes":223568,"sha256":"d08d3b02227cdb1e88ed517bc4dbbc03e46efa22a69a7617a21afea445deda89","duration":32.3},"female":{"file":"y-397-female.m4a","bytes":225890,"sha256":"9b482a5f55091f862770beb1844b6c001cfeb30455610de6ac02bb2df469e67b","duration":32.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.701,"text":"BAWO ni awon ewe wa","marked":"Báwo ni àwọn èwe wà"},{"start":2.081,"end":3.205,"text":"Y'o ti ma sora won?","marked":"Y'ó ti má ṣọ́ra wọn?"},{"start":3.585,"end":5.349,"text":"Bikose 'nipa kiyesi","marked":"Bíkọ́ṣẹ́ 'nípa kíyèsí"},{"start":5.729,"end":7.016,"text":"Gegebi oro Re.","marked":"Gegebi ọ̀rọ̀ Rẹ̀."}],"end":7.016},{"key":"2","start":7.966,"lines":[{"start":7.966,"end":9.935,"text":"Gba oro na wo 'nu okan","marked":"Gba ọ̀rọ̀ ná wò 'nú ọkàn"},{"start":10.315,"end":11.646,"text":"A tan imole ka","marked":"A tan ìmọ́lẹ̀̀ ká"},{"start":12.026,"end":13.468,"text":"Oro na ko ope l'ogbon","marked":"Ọ̀rọ̀ nà ko ọ̀pẹ l'ọgbọ́n"},{"start":13.848,"end":14.96,"text":"At'imo Olorun.","marked":"Àt'ìmọ̀ Ọlọ́run."}],"end":14.96},{"key":"3","start":15.91,"lines":[{"start":15.91,"end":17.418,"text":"Orun ni, imole wa ni","marked":"Ọ̀run ni, ìmọ́lẹ̀̀ wa ni"},{"start":17.798,"end":18.895,"text":"Amona wa l'osan","marked":"Amọ̀nà wa l'ọ̀sán"},{"start":19.275,"end":21.185,"text":"Fitila ti nfonahan wa","marked":"Fìtílà tí nfonahan wà"},{"start":21.565,"end":22.561,"text":"Ninu ewu oru.","marked":"Nínú ewu òru."}],"end":22.561},{"key":"4","start":23.511,"lines":[{"start":23.511,"end":25.118,"text":"Oro Re, oto ni titi","marked":"Ọ̀rọ̀ Rẹ, ọ̀tọ̀ ni títí"},{"start":25.498,"end":26.639,"text":"Mimo ni gbogbo re","marked":"Mímọ́́ ni gbogbo rẹ̀"},{"start":27.019,"end":28.191,"text":"Amona wa l'ojo ewe","marked":"Amọ̀nà wa l'ọjọ́ èwe"},{"start":28.571,"end":29.838,"text":"Opa l'ojo ogbo.","marked":"Ọ̀pá l'ọjọ́ ogbó."},{"start":30.218,"end":30.747,"text":"Amin.","marked":"Àmín."}],"end":30.747}]}