{"v":1,"coll":"y","num":406,"id":"hymn_406","title":"IJO kerubu ti ye","duration":87.753,"voices":{"male":{"file":"y-406-male.m4a","bytes":645980,"sha256":"2e1628819198f4eeebd3217f2b63f1b1692868e45e97f21fd6c33f189e2533a4","duration":87.8},"female":{"file":"y-406-female.m4a","bytes":668843,"sha256":"e8d3decc486eef1d7a3347420d6fc9b7b8f1a6fee5541886df20cbfd0c70ab92","duration":87.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.747,"text":"Ijo kerubu ti ye","marked":"Ìjọ Kérúbù ti yẹ"},{"start":2.127,"end":3.242,"text":"So fun mi lekan si","marked":"Sọ fún mi lẹ́kàn sí"},{"start":3.622,"end":5.417,"text":"Jesu Kristi l'Oba Ogo","marked":"Jésù Kristi l'Ọba Ògo"},{"start":5.797,"end":6.936,"text":"Olugbala l'Oba lye","marked":"Olùgbàlà l'Ọba lye"},{"start":7.316,"end":8.816,"text":"Ijo kerubu l'Ijo iye","marked":"Ìjọ Kérúbù l'Ijó ìyè"},{"start":9.196,"end":10.699,"text":"Ijo Kerubu ti ye.","marked":"Ìjọ Kérúbù ti yẹ."}],"end":10.699},{"key":"CHORUS","start":11.649,"lines":[{"start":11.649,"end":13.987,"text":"Iyanu, Iyanu, Iyanu","marked":"Ìyanu, Ìyanu, Ìyanu"},{"start":14.367,"end":15.825,"text":"Ijo Kerubu ti ye.","marked":"Ìjọ Kérúbù ti yẹ."}],"end":15.825},{"key":"2","start":16.775,"lines":[{"start":16.775,"end":18.474,"text":"Ijo Serafu ti ye","marked":"Ìjọ Séráfù ti yẹ"},{"start":18.854,"end":19.949,"text":"E f'ogo fun baba","marked":"Ẹ f'ògo fún bàbá"},{"start":20.329,"end":21.717,"text":"T'o mu wa ri ojo oni","marked":"T'ó mú wa rí ọjọ́ òní"},{"start":22.097,"end":23.574,"text":"Fi ola fun Baba loke","marked":"Fi ọlá fún Bàbá lókè"},{"start":23.954,"end":25.716,"text":"Ijo Serafu l'Ijo iye","marked":"Ìjọ Séráfù l'Ijó ìyè"},{"start":26.096,"end":27.743,"text":"Ijo Serafu ti ye.","marked":"Ìjọ Séráfù ti yẹ."},{"start":28.123,"end":30.106,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":30.106},{"key":"3","start":31.056,"lines":[{"start":31.056,"end":32.377,"text":"Ijo kerubu ti ye","marked":"Ìjọ Kérúbù ti yẹ"},{"start":32.757,"end":33.949,"text":"E so fun mi ki ngbo","marked":"Ẹ sọ fún mi kí ńgbọ́"},{"start":34.329,"end":36.061,"text":"Jesu Kristi Olusegun","marked":"Jésù Kristi Olùṣègùn"},{"start":36.441,"end":37.711,"text":"Olusegun l'Oba lye","marked":"Olùṣègùn l'Ọba lye"},{"start":38.091,"end":39.723,"text":"Ijo kerubu I'Ijo iye","marked":"Ìjọ Kérúbù l'Ijó ìyè"},{"start":40.103,"end":41.471,"text":"Ijo Kerubu ti ye.","marked":"Ìjọ Kérúbù ti yẹ."},{"start":41.851,"end":43.889,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":43.889},{"key":"4","start":44.839,"lines":[{"start":44.839,"end":46.78,"text":"Ijo Serafu ti ye","marked":"Ìjọ Séráfù ti yẹ"},{"start":47.16,"end":48.658,"text":"T'o mo ti Krist' nikan","marked":"T'ó mọ ti Krist' nìkan"},{"start":49.038,"end":50.533,"text":"Jesu t'o wa niwaju wa","marked":"Jésù t'ó wà níwájú wa"},{"start":50.913,"end":52.698,"text":"Olugbala, Balogun wa","marked":"Olùgbàlà, Balógun wa"},{"start":53.078,"end":54.61,"text":"Ijo Serafu l'Ijo iye","marked":"Ìjọ Séráfù l'Ijó ìyè"},{"start":54.99,"end":56.483,"text":"Ijo Serafu ti ye.","marked":"Ìjọ Séráfù ti yẹ."},{"start":56.863,"end":58.845,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":58.845},{"key":"5","start":59.795,"lines":[{"start":59.795,"end":61.264,"text":"Ijo kerubu ti ye","marked":"Ìjọ Kérúbù ti yẹ"},{"start":61.644,"end":62.752,"text":"Oba lyanu ni;","marked":"Ọba lyanu ni"},{"start":63.132,"end":65.567,"text":"Jesu Kristi, Balogun wa,","marked":"Jésù Kristi, Balógun wa"},{"start":65.947,"end":67.26,"text":"Obangiji l'Oba iye","marked":"Obangiji l'Ọba ìyẹ́"},{"start":67.64,"end":69.281,"text":"Ijo kerubu l'Ijo iye.","marked":"Ìjọ Kérúbù l'Ìjọ ìyè."},{"start":69.661,"end":72.241,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":72.241},{"key":"6","start":73.191,"lines":[{"start":73.191,"end":74.789,"text":"Ijo Serafu ti ye","marked":"Ìjọ Séráfù ti yẹ"},{"start":75.169,"end":76.211,"text":"Ijo Iyanu ni","marked":"Ìjọ Ìyanu ni"},{"start":76.591,"end":78.108,"text":"“Olubukun I'Enit' o mbo","marked":"Olùbùkún l'Enit' ò ḿbò"},{"start":78.488,"end":79.696,"text":"Li oruko Oluwa wa","marked":"Lí orúkọ Olúwa wa"},{"start":80.076,"end":81.689,"text":"Ogo ni fun Baba loke","marked":"Ògo ni fún Bàbá lókè"},{"start":82.069,"end":83.27,"text":"Ogo fun Metalokan.","marked":"Ògo fún Mẹ́talọ́kan."},{"start":83.65,"end":86.203,"text":"Egbe:Iyanu, Iyanu, Iyanu...","marked":"Ìyanu, Ìyanu, Ìyanu"}],"end":86.203}]}