{"v":1,"coll":"y","num":299,"id":"hymn_299","title":"GBATI mo ri agbelebu","duration":38.308,"voices":{"male":{"file":"y-299-male.m4a","bytes":278179,"sha256":"d92f6914375089a0e80479a7807fbbf1423fd2c1991d1610a022ef9e16d6e3b8","duration":38.4},"female":{"file":"y-299-female.m4a","bytes":283867,"sha256":"0dcfd3d58ba4bf16ddeef687a8372930679a0932673789ea83c5ef1525167407","duration":38.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.978,"text":"GBATI mo ri agbelebu","marked":"Gbátí mo rí àgbélébùú"},{"start":2.358,"end":3.974,"text":"Ti a kan Oba ogo mo","marked":"Tí a kan Ọba ògo mọ́"},{"start":4.354,"end":5.921,"text":"Mo ka gbogbo oro s'ofo","marked":"Mo ka gbogbo ọ̀rọ̀ s'ọ̀fọ̀"},{"start":6.301,"end":7.944,"text":"Mo kegan gbogbo ogo mi.","marked":"Mo kẹ́gàn gbogbo ògo mi."}],"end":7.944},{"key":"2","start":8.894,"lines":[{"start":8.894,"end":11.508,"text":"K'a, ma se gbo pe, mo nhale,","marked":"K'á, má ṣe gbọ́ pé, mo nhale"},{"start":11.888,"end":13.284,"text":"B'o ye n'iku Oluwa mi","marked":"B'ó yé n'ikú Olúwa mi"},{"start":13.664,"end":16.033,"text":"Gbogbo nkan asan ti mo fe","marked":"Gbogbo nkan asán tí mo fẹ́"},{"start":16.413,"end":18.049,"text":"Mo da sile fun eje Re.","marked":"Mo dá sílẹ̀ fún ẹ̀jẹ̀ Rẹ."}],"end":18.049},{"key":"3","start":18.999,"lines":[{"start":18.999,"end":21.046,"text":"Wo lat' ori, owo , ese","marked":"Wo lát' orí, owó , ẹsẹ̀"},{"start":21.426,"end":23.304,"text":"B'ikanu at'ife ti nsan","marked":"B'ìkanú àt'ìfẹ́ ti ńsan"},{"start":23.684,"end":25.271,"text":"'Banuje at'ife papo","marked":"'Bànújẹ́ àt'ìfẹ́ papọ̀"},{"start":25.651,"end":27.748,"text":"A f'egun se ade Ogo.","marked":"A f'ẹ̀gún ṣe adé Ògo."}],"end":27.748},{"key":"4","start":28.698,"lines":[{"start":28.698,"end":30.138,"text":"Gbogbo aiye ba je t'emi","marked":"Gbogbo aiye bá jẹ́ t'èmi"},{"start":30.518,"end":31.755,"text":"Ebun abere ni fun mi","marked":"Ẹ̀bùn abẹ́rẹ́ ni fún mi"},{"start":32.135,"end":34.114,"text":"Ife nla ti nyanilenu","marked":"Ìfẹ́ ńlá ti nyanilenu"},{"start":34.494,"end":35.553,"text":"Gba gbogbo okan,","marked":"Gba gbogbo ọkàn"},{"start":35.933,"end":36.758,"text":"emi mi.","marked":"ẹ̀mí mi."}],"end":36.758}]}