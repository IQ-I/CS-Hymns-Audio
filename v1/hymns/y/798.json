{"v":1,"coll":"y","num":798,"id":"hymn_798","title":"ENYIN ero nibo l'e nlo","duration":81.593,"voices":{"male":{"file":"y-798-male.m4a","bytes":592942,"sha256":"e1269436c0bc6e5a0f1a2858ac5515c8819098d99379561db8bc9df596f165aa","duration":81.6},"female":{"file":"y-798-female.m4a","bytes":612574,"sha256":"a5ba09605fa090b48f7ab75d9007fcd96d3c586f32de4a6868e0c1c075b067ce","duration":81.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.919,"text":"ENYIN ero nibo l'e nlo","marked":"Ẹ́ńyìn èrò níbò l'é ńlò"},{"start":2.299,"end":3.445,"text":"T'enyin ti 'mope,","marked":"T'ẹnyin ti 'mọpẹ́"},{"start":3.825,"end":4.669,"text":"lowo nyin?","marked":"lowó nyin?"},{"start":5.049,"end":6.471,"text":"Awa nlo pade Oba wa","marked":"Àwa ńlọ pàdé Ọba wa"},{"start":6.851,"end":8.093,"text":"Gegebi 'leri re si wa.","marked":"Gẹ́gẹ́bí 'lérí rẹ̀ sì wà."}],"end":8.093},{"key":"CHORUS","start":9.043,"lines":[{"start":9.043,"end":11.421,"text":"A nlo s'afin, s'afin Oba rere,","marked":"A ńlò s'áfín, s'áfín Ọba rere"},{"start":11.801,"end":13.729,"text":"A nlo s'ile 'leri, nibiti","marked":"A ńlò s'ilẹ̀ 'lérí, níbìtì"},{"start":14.109,"end":14.985,"text":"ese ko le de","marked":"ẹ̀ṣẹ̀ kò lè dé"},{"start":15.365,"end":17.043,"text":"Nibiti simi wa lailai.","marked":"Níbitì ṣímì wà láíláí."}],"end":17.043},{"key":"2","start":17.993,"lines":[{"start":17.993,"end":20.523,"text":"Enyin, ero, e so fun wa","marked":"Enyin, èrò, ẹ sọ fún wa"},{"start":20.903,"end":22.668,"text":"T'ayo pipe ti mbe nibe","marked":"T'àyò pípé ti ḿbẹ níbẹ̀"},{"start":23.048,"end":25.053,"text":"T'aso ala at'ade Ogo","marked":"T'aṣọ àlà àt'adé Ògo"},{"start":25.433,"end":27.107,"text":"Ti Jesu y'o fun wa loke.","marked":"Tí Jésù y'ó fún wa lókè."}],"end":27.107},{"key":"3","start":28.057,"lines":[{"start":28.057,"end":29.295,"text":"A ko ni 'bugbe kan nihin","marked":"A kò ní 'búgbẹ́ kan níhìn"},{"start":29.675,"end":31.153,"text":"O buru bi 'hin je le wa","marked":"Ó burú bí 'hin jẹ́ lé wa"},{"start":31.533,"end":33.224,"text":"Ayo l'ogo ekun lale","marked":"Ayò l'ògò ẹkùn lálẹ́"},{"start":33.604,"end":35.323,"text":"Sugbon eyi ko si loke.","marked":"Ṣùgbọ́n èyí kò sí lókè."}],"end":35.323},{"key":"4","start":36.273,"lines":[{"start":36.273,"end":38.152,"text":"Egbe orun, e silekun","marked":"Ẹgbẹ́ ọ̀run, ẹ ṣílẹ̀kùn"},{"start":38.532,"end":40.403,"text":"F'egbe aiye lati wole","marked":"F'ẹgbẹ́ aiye láti wọlé"},{"start":40.783,"end":42.174,"text":"Awa n'ise at'iponju","marked":"Àwa ń'iṣẹ́ àt'ìpọ́njú"},{"start":42.554,"end":44.26,"text":"Nwon de lati b'Oluwa gbe.","marked":"Nwọ̀n dé láti b'Olúwa gbé."}],"end":44.26},{"key":"5","start":45.21,"lines":[{"start":45.21,"end":46.543,"text":"Ogunlogo nibi gbogbo","marked":"Ogunlọ́gọ̀ níbi gbogbo"},{"start":46.923,"end":48.933,"text":"Ti nwon ti segun aiye yi","marked":"Ti nwọn ti ṣẹ́gun aiye yi"},{"start":49.313,"end":50.703,"text":"Olorun so won di omo","marked":"Ọlọ́run sọ wọ́n di ọmọ"},{"start":51.083,"end":52.928,"text":"Wa ore mi, ki ile to su.","marked":"Wá ọ̀rẹ́ mi, kí ilé tó ṣú."}],"end":52.928},{"key":"6","start":53.878,"lines":[{"start":53.878,"end":56.422,"text":"Oja aiye, oja asan","marked":"Ọjà aiye, ọjà asán"},{"start":56.802,"end":58.915,"text":"B'Oluwa n'oja, k'o jere","marked":"B'Olúwa n'ọ́jà, k'ó jèrè"},{"start":59.295,"end":60.856,"text":"Ore aiye, ore asan","marked":"Ọ̀rẹ́ aiye, ọ̀rẹ́ asán"},{"start":61.236,"end":63.193,"text":"B'Oluwa s'ore, ki idani.","marked":"B'Olúwa s'ọre, kí ìdáni."}],"end":63.193},{"key":"7","start":64.143,"lines":[{"start":64.143,"end":66.66,"text":"Wo! ko tun s'adun laiye mo","marked":"Wò! kò tún s'ádùn láìyẹ mọ́"},{"start":67.04,"end":68.173,"text":"Ibjae po rere lo","marked":"Ibjae pọ̀ rere lọ"},{"start":68.553,"end":69.99,"text":"B'Olowa re, pinnu loni","marked":"B'Ọlọ́wà rẹ, pinnu lónì"},{"start":70.37,"end":71.791,"text":"Ki 'gbehin re ba le layo.","marked":"Kí 'gbẹ̀hìn rẹ bá lè láyọ̀."}],"end":71.791},{"key":"8","start":72.741,"lines":[{"start":72.741,"end":73.912,"text":"Agbagba merinlegun","marked":"Àgbàgbà mẹ́rìnlégùn"},{"start":74.292,"end":75.925,"text":"Enyin l'awa fe ba k'egbe","marked":"Enyin l'áwá fẹ́ bá k'ẹ́gbẹ́"},{"start":76.305,"end":78.028,"text":"Tori ko s'adun laiye mo","marked":"Torí kò s'ádùn láìyẹ mọ́"},{"start":78.408,"end":80.043,"text":"E ka wa ye f'adun loke.","marked":"Ẹ kà wá yé f'adùn lókè."}],"end":80.043}]}