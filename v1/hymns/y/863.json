{"v":1,"coll":"y","num":863,"id":"hymn_863","title":"OMO'GUN Kristi, e dide","duration":37.299,"voices":{"male":{"file":"y-863-male.m4a","bytes":269171,"sha256":"e05e84d0db1f13c7d150d1ea55d8f4e3c00f57dc7a7c9015607187b8b44f4dd3","duration":37.3},"female":{"file":"y-863-female.m4a","bytes":273146,"sha256":"333085ec425bf681cc02320c460146c2ed106ac60dcbc578e2689dcfc12aec15","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.761,"text":"OMO'GUN Kristi, e dide","marked":"Ọmọ'gun Kristi, ẹ dìde"},{"start":3.141,"end":4.817,"text":"So f'araiye p'Oluwa mbo","marked":"Sọ f'araiye p'Olúwa ḿbọ́"},{"start":5.197,"end":6.593,"text":"E busayo k'e si ho ye","marked":"Ẹ bùṣàyò k'ẹ sì hó yé"},{"start":6.973,"end":8.208,"text":"K'e f'orin pade Oluwa.","marked":"K'ẹ f'orin pàdé Olúwa."}],"end":8.208},{"key":"CHORUS","start":9.158,"lines":[{"start":9.158,"end":11.656,"text":"O mbo, O mbo, O fere de","marked":"Ó ḿbọ́, Ó ḿbọ́, Ó fẹ́rẹ̀ dé"},{"start":12.036,"end":13.294,"text":"Oluwa mbo l'awonsanma","marked":"Olúwa ḿbò l'àwọ̀nsánmà"},{"start":13.674,"end":16.063,"text":"O mbo, O mbo, O fere de","marked":"Ó ḿbọ́, Ó ḿbọ́, Ó fẹ́rẹ̀ dé"},{"start":16.443,"end":18.099,"text":"Oluwa mbo l'awonsanmo.","marked":"Olúwa ḿbò l'áwọ̀nsánmọ́."}],"end":18.099},{"key":"2","start":19.049,"lines":[{"start":19.049,"end":20.496,"text":"Oluwa s'ohun nla fun wa","marked":"Olúwa s'ohun ńlá fún wa"},{"start":20.876,"end":23.022,"text":"Nitorina, e jek'a yo","marked":"Nítorina, ẹ jẹk'á yọ"},{"start":23.402,"end":25.034,"text":"Ajodun t'oni to ba wa","marked":"Àjọ̀dún t'ọ́ni tó bá wà"},{"start":25.414,"end":26.844,"text":"Ope lo ye fun Jehovah.","marked":"Ọpẹ́ ló yẹ fún Jehovah."}],"end":26.844},{"key":"3","start":27.794,"lines":[{"start":27.794,"end":29.297,"text":"Omo'gun Kristi e mura","marked":"Ọmọ'gun Kristi ẹ̀ múra"},{"start":29.677,"end":31.12,"text":"De bibo Jesu Oluwa","marked":"Dé bíbọ Jésù Olúwa"},{"start":31.5,"end":32.962,"text":"Oluwa mbo bakanna ko","marked":"Olúwa mbo bákanná kọ́"},{"start":33.342,"end":34.789,"text":"Bi o ti wa n'irele ri.","marked":"Bí o ti wá ń'ìrẹ̀lẹ̀ rí."},{"start":35.169,"end":35.749,"text":"Amin.","marked":"Àmín."}],"end":35.749}]}