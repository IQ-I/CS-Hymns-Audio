{"v":1,"coll":"y","num":57,"id":"hymn_57","title":"GBA WA lojo na t' ao se 'dajo aiye","duration":113.769,"voices":{"male":{"file":"y-57-male.m4a","bytes":837564,"sha256":"5cee2ce6ff8983e52536a7ee84ac02697a66b32a250a182c3df1017571fc21aa","duration":113.8},"female":{"file":"y-57-female.m4a","bytes":872733,"sha256":"bc0f48aba181c5443bd91aa09b1f89df10859e7054ec7c82438a3c5e92a52e06","duration":113.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.878,"text":"GBA WA lojo na t' ao se 'dajo aiye,","marked":"Gbà Wá lọ́jọ́ ná t' ao ṣe 'dájọ́ aiye"},{"start":3.258,"end":4.673,"text":"K'awa le j'eni 'tewogba","marked":"K'áwá lè j'ẹni 'tewogba"},{"start":5.053,"end":6.731,"text":"Se iranlowo fun wa ka j'eni","marked":"Ṣe ìrànlọ́wọ́ fún wa ká j'ẹni"},{"start":7.111,"end":7.725,"text":"'tewogba","marked":"'tewọgbà"},{"start":8.105,"end":9.855,"text":"Sibi omi 'ye t'O pese.","marked":"Ṣíbí omi 'yé t'Ó pèsè."}],"end":9.855},{"key":"CHORUS","start":10.805,"lines":[{"start":10.805,"end":12.392,"text":"Sanu fun wa gbadura wa,","marked":"Sànù fún wa gbàdúrà wa"},{"start":12.772,"end":14.848,"text":"Ji okan ti ntogbe kuro nin'ese. 2ce","marked":"Jí ọkàn tí ńtògbé kúrò níń'ẹsẹ̀."}],"end":14.848},{"key":"2","start":15.798,"lines":[{"start":15.798,"end":17.757,"text":"Jowo tan imole Re loni Oluwa,","marked":"Jọ̀wọ́ tan ìmọ́lẹ̀̀ Rẹ lọ́ni Olúwa"},{"start":18.137,"end":19.604,"text":"S'oju awon ti ko riran","marked":"S'ojú àwọn tí kò ríran"},{"start":19.984,"end":21.965,"text":"Ni apa Jesu aye wa sibe","marked":"Ni apá Jésù ayé wá síbẹ̀"},{"start":22.345,"end":24.103,"text":"Mase tun wi awawi mo.","marked":"Masẹ̀ tún wí àwáwí mọ́."},{"start":24.483,"end":26.003,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":26.003},{"key":"3","start":26.953,"lines":[{"start":26.953,"end":28.611,"text":"Enyin lmale ati Keferi,","marked":"Enyin lmale àti Kèfèrí"},{"start":28.991,"end":30.318,"text":"E wa gbo ihin rere yi,","marked":"Ẹ wá gbọ́ ìhìn rere yí"},{"start":30.698,"end":33.108,"text":"Akoko na mbo t'a o bere lowo re","marked":"Àkókò ná ḿbọ́ t'á ò bẹ̀rẹ̀ lọ́wọ́ rẹ̀"},{"start":33.488,"end":34.592,"text":"Pe ise kini iwo nse?","marked":"Pé iṣẹ́ kíni ìwọ ńṣe?"},{"start":34.972,"end":36.691,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":36.691},{"key":"4","start":37.641,"lines":[{"start":37.641,"end":40.127,"text":"Enyin Egbe Kerubu ati Serafu","marked":"Enyin Ẹgbẹ́ Kérúbù àti Séráfù"},{"start":40.507,"end":42.289,"text":"E j'arowa e ma w'ehin","marked":"Ẹ j'arowa ẹ̀ ma w'ehin"},{"start":42.669,"end":44.656,"text":"Lo wo Isaiah ori ogota,","marked":"Lọ wo Isaiah orí ọgọ́ta"},{"start":45.036,"end":46.353,"text":"Ese kini ati keji.","marked":"Ẹsẹ̀ kíni àti kejì."},{"start":46.733,"end":48.271,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":48.271},{"key":"5","start":49.221,"lines":[{"start":49.221,"end":51.557,"text":"Enyin ero iworan ati enijoko","marked":"Enyin ẹ̀rọ ìwòran àti ẹnijókò"},{"start":51.937,"end":53.594,"text":"Bi'dajo ba o nin'ese nko","marked":"Bí'dájọ́ bá ò nin'ese ńkọ́"},{"start":53.974,"end":56.238,"text":"E wa si imole ninu Egbe Serafu,","marked":"Ẹ wá sí ìmọ́lẹ̀̀ nínú Ẹgbẹ́ Séráfù"},{"start":56.618,"end":57.944,"text":"Ke ba le j'eni 'tewogba.","marked":"Kẹ́ bá lè j'ẹni 'tẹ́wọ́gbà."},{"start":58.324,"end":59.997,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":59.997},{"key":"6","start":60.947,"lines":[{"start":60.947,"end":62.804,"text":"Gbogbo Omo Egbe t'o s'olotito","marked":"Gbogbo Ọmọ Ẹgbẹ́ t'ó s'olòtìtọ́"},{"start":63.184,"end":64.956,"text":"Ade ogo ti wa fun nyin,","marked":"Adé ògo ti wà fún nyin"},{"start":65.336,"end":67.111,"text":"Bohubiea Aleakutatabb","marked":"Bohubiea Aleakutatabb"},{"start":67.491,"end":69.09,"text":"Ko ni jeki gbogbo wa segbe.","marked":"Kò ní jẹ́kí gbogbo wa ṣègbè."},{"start":69.47,"end":71.006,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":71.006},{"key":"7","start":71.956,"lines":[{"start":71.956,"end":74.056,"text":"Enyin agan to wa ninu Egbe","marked":"Enyin àgàn tó wà nínú Ẹgbẹ́"},{"start":74.436,"end":75.59,"text":"E mura si 'gbagbo,","marked":"Ẹ múra sí 'gbàgbọ́"},{"start":75.97,"end":77.557,"text":"Ki e le ni omo bi Samueli","marked":"Kí ẹ lè ní ọmọ bí Sámúẹ́lì"},{"start":77.937,"end":79.162,"text":"Lodo Olodumare.","marked":"Lọ́dọ̀ Olódùmarè."},{"start":79.542,"end":81.06,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":81.06},{"key":"8","start":82.01,"lines":[{"start":82.01,"end":84.18,"text":"Enyin Alamodi to wa  nin' Egbe","marked":"Enyin Àlámódì tó wà nín' Ẹgbẹ́"},{"start":84.56,"end":86.152,"text":"Enyin yio si ri 'wosan gba","marked":"Enyin yìó sì rí 'wòsàn gbà"},{"start":86.532,"end":88.206,"text":"Lat'odo onisegun Jerusalemu","marked":"Lát'ódò oníṣègùn Jerúsálẹ́mù"},{"start":88.586,"end":89.947,"text":"E o ri imularada.","marked":"Ẹ ò rí ìmúláradá."},{"start":90.327,"end":91.932,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":91.932},{"key":"9","start":92.882,"lines":[{"start":92.882,"end":94.891,"text":"Enyin ti e ko ti ri 'se se,","marked":"Enyin tí ẹ kò ti rí 'ṣe ṣe"},{"start":95.271,"end":96.746,"text":"Jehofa Jireh yio pese,","marked":"Jèhófà Jireh yìó pèsè"},{"start":97.126,"end":98.827,"text":"lse rere fun itelorun nyin,","marked":"lse rere fún ìtẹ́lọ́rùn nyin"},{"start":99.207,"end":100.26,"text":"E o ri tunu gba.","marked":"Ẹ ò rí túnu gbà."},{"start":100.64,"end":102.149,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"}],"end":102.149},{"key":"10","start":103.099,"lines":[{"start":103.099,"end":104.607,"text":"Ogo ni fun Baba loke","marked":"Ògo ni fún Bàbá lókè"},{"start":104.987,"end":106.008,"text":"Ogo ni fun Omo,","marked":"Ògo ni fún Ọmọ"},{"start":106.388,"end":107.611,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́́"},{"start":107.991,"end":109.38,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láíláí."},{"start":109.76,"end":111.319,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Sànù fún wa gbàdúrà wa"},{"start":111.699,"end":112.219,"text":"Amin.","marked":"Àmín."}],"end":112.219}]}