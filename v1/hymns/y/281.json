{"v":1,"coll":"y","num":281,"id":"hymn_281","title":"ESE mi po bi irawo","duration":18.041,"voices":{"male":{"file":"y-281-male.m4a","bytes":125654,"sha256":"39796c5ac4e1838c4bd236c63c9e1afc331d0e581aef31be4389857909ce13e3","duration":18.1},"female":{"file":"y-281-female.m4a","bytes":130251,"sha256":"80fa6bbcb8537c67ec4f1a70b5284260f8fcbff3ca42fdaada765522bf76200f","duration":18.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.688,"text":"ESE mi po bi irawo","marked":"Ẹsẹ̀ mi pọ̀ bí ìràwọ̀"},{"start":2.068,"end":3.43,"text":"Bi'yanrin let'okun","marked":"Bí'yanrìn lét'òkun"},{"start":3.81,"end":5.173,"text":"Sugbon iyonu Olorun","marked":"Ṣùgbọ́n ìyọnu Ọlọ́run"},{"start":5.553,"end":6.846,"text":"O p'apoju be lo.","marked":"Ó p'àpọ̀jù bẹ̀ lọ."}],"end":6.846},{"key":"2","start":7.796,"lines":[{"start":7.796,"end":10.435,"text":"Manase, Paul, On Magdalen","marked":"Mánásè, Paul, On Magdalen"},{"start":10.815,"end":11.838,"text":"lwo dariji won","marked":"lwo dariji wọn"},{"start":12.218,"end":13.901,"text":"Mo ti ka mo si gbagbo pe","marked":"Mo ti kà mo sì gbàgbọ́ pé"},{"start":14.281,"end":15.429,"text":"O ti dariji mi.","marked":"Ó ti dariji mi."},{"start":15.809,"end":16.491,"text":"Amin.","marked":"Àmín."}],"end":16.491}]}