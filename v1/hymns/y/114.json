{"v":1,"coll":"y","num":114,"id":"hymn_114","title":"N'NU gbogbo ayida aiye","duration":49.093,"voices":{"male":{"file":"y-114-male.m4a","bytes":346517,"sha256":"c6f7e9c418d76140aaf5e10318c87179d06ddd6f950ac91c480f9e1752d7d68e","duration":49.1},"female":{"file":"y-114-female.m4a","bytes":357897,"sha256":"93614c875cd426034434b12d228999d97f9e17cfecfa46fc622402ebf90c1710","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.707,"text":"N'NU gbogbo ayida aiye","marked":"N'nu gbogbo àyídà aiye"},{"start":2.087,"end":3.246,"text":"Ayo on wahala","marked":"Ayọ̀ ọ́n wàhálà"},{"start":3.626,"end":5.386,"text":"lyin Olorun ni y'o ma","marked":"lyin Ọlọ́run ni y'ó ma"},{"start":5.766,"end":6.88,"text":"Wa l'enu mi titi.","marked":"Wà l'ẹnu mi títí."}],"end":6.88},{"key":"2","start":7.83,"lines":[{"start":7.83,"end":9.523,"text":"Em'o yangan ti segun Re","marked":"Em'ó yangàn ti ṣẹ́gun Rẹ̀"},{"start":9.903,"end":11.158,"text":"Tit'awon t'eru npa","marked":"Tít'àwọn t'ẹrù ńpa"},{"start":11.538,"end":13.081,"text":"Y'o fi mi se awokose","marked":"Y'ó fi mí ṣe àwòkọ́ṣe"},{"start":13.461,"end":14.838,"text":"Ti banuje y'o tan.","marked":"Ti bànújẹ́ y'ó tán."}],"end":14.838},{"key":"3","start":15.788,"lines":[{"start":15.788,"end":17.039,"text":"Gbe Oluwa ga pelu mi,","marked":"Gbé Olúwa ga pẹ̀lú mi"},{"start":17.419,"end":18.493,"text":"Ba mi gb'Oko Re ga","marked":"Bá mi gb'Ọkọ Rẹ̀ ga"},{"start":18.873,"end":21.425,"text":"N'nu wahala. 'gba mo kepe","marked":"N'nu wàhálà. 'gbà mo kepe"},{"start":21.805,"end":23.097,"text":"O si yo mi kuro.","marked":"Ó sì yọ mí kúrò."}],"end":23.097},{"key":"4","start":24.047,"lines":[{"start":24.047,"end":25.604,"text":"Ogun Olorun wa yika","marked":"Ogun Ọlọ́run wà yíká"},{"start":25.984,"end":27.011,"text":"Ibugbe oloto;","marked":"Ibùgbé ọlọ́tọ̀"},{"start":27.391,"end":28.77,"text":"Eniti o ba gbekele","marked":"Ẹniti ò bá gbẹ́kẹ̀lé"},{"start":29.15,"end":30.234,"text":"Yio si ri 'gbala.","marked":"Yíó sì rí 'gbàlà."}],"end":30.234},{"key":"5","start":31.184,"lines":[{"start":31.184,"end":32.829,"text":"Sa dan ife Re wo lekan","marked":"Sá dán ìfẹ́ Rẹ̀ wò lẹ́kàn"},{"start":33.209,"end":34.405,"text":"Gbana 'wo o mo pe","marked":"Gbaná 'wò ó mọ̀ pé"},{"start":34.785,"end":36.141,"text":"Awon t'o di oto Re mu","marked":"Àwọn t'ó di ọ̀tọ̀ Rẹ̀ mú"},{"start":36.521,"end":37.751,"text":"Nikan l'eni 'bukun.","marked":"Nìkan l'ẹni 'bùkún."}],"end":37.751},{"key":"6","start":38.701,"lines":[{"start":38.701,"end":40.847,"text":"E beru Re, enyin mimo,","marked":"Ẹ bẹ̀rù Rẹ̀, enyin mímọ́́"},{"start":41.227,"end":42.647,"text":"Eru miran ko si,","marked":"Ẹ̀rù miran kò sí"},{"start":43.027,"end":44.822,"text":"Sa je ki 'sin Re j'ayo nyin,","marked":"Ṣá jẹ́ kí 'sin Rẹ j'àyò nyin"},{"start":45.202,"end":46.652,"text":"On y'o ma toju nyin.","marked":"On y'ó ma tojú nyin."},{"start":47.032,"end":47.544,"text":"Amin.","marked":"Àmín."}],"end":47.544}]}