{"v":1,"coll":"y","num":833,"id":"hymn_833","title":"A JA ni gbo-Ekun aja","duration":40.538,"voices":{"male":{"file":"y-833-male.m4a","bytes":285477,"sha256":"6f267ad07e2c1ac87f728c9148d61c526e27b6b61b48f503892a460e8e733c06","duration":40.6},"female":{"file":"y-833-female.m4a","bytes":301011,"sha256":"73faf1bd2c1aa4f894d9b221baa161cd713f49c1edd2211fa25925a91ff15ea7","duration":40.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.806,"text":"A JA ni gbo-Ekun aja","marked":"A Jà ní gbọ́-Ẹkùn ajá"},{"start":2.186,"end":3.464,"text":"Be l'a sa s'ede won","marked":"Bẹ́ l'á sá s'èdè wọn"},{"start":3.844,"end":5.734,"text":"Ogidan, l'ola iju","marked":"Ogidan, l'ọ́lá ijù"},{"start":6.114,"end":7.414,"text":"L'akomo l'ain obe.","marked":"L'àkómọ l'àín ọbẹ̀."}],"end":7.414},{"key":"2","start":8.364,"lines":[{"start":8.364,"end":10.289,"text":"Sugbon enia l'a da nyin","marked":"Ṣùgbọ́n enia l'á dà nyin"},{"start":10.669,"end":11.889,"text":"E hu wa bi omo","marked":"Ẹ hù wá bí ọmọ"},{"start":12.269,"end":13.86,"text":"K'e mase ba ara nyin ja","marked":"K'é máṣe bá ara nyin jà"},{"start":14.24,"end":15.412,"text":"Ere ni k'e ma se.","marked":"Eré ni k'ẹ má ṣe."}],"end":15.412},{"key":"3","start":16.362,"lines":[{"start":16.362,"end":17.423,"text":"Bi Omo-rere Maria","marked":"Bí Ọmọ-rere Màríà"},{"start":17.803,"end":19.065,"text":"Ni k'iwa nyin tutu","marked":"Ní k'ìwà nyin tútù"},{"start":19.445,"end":21.018,"text":"K'e po n'ife bi Oluwa","marked":"K'ẹ́ pọ̀ n'ìfẹ́ bí Olúwa"},{"start":21.398,"end":22.608,"text":"Jesu Om'Olorun.","marked":"Jésù Om'Ọlọ́run."}],"end":22.608},{"key":"4","start":23.558,"lines":[{"start":23.558,"end":24.802,"text":"Eni jeje bi agutan","marked":"Ẹní jẹ́jẹ́ bí àgùtàn"},{"start":25.182,"end":26.292,"text":"Ti iwa Re wun ni","marked":"Ti ìwà Rẹ̀ wun ni"},{"start":26.672,"end":28.071,"text":"Enia ati Olorun","marked":"Éníà àti Ọlọ́run"},{"start":28.451,"end":29.718,"text":"N'idagba Re si won.","marked":"N'ìdàgbà Rẹ sí wọn."}],"end":29.718},{"key":"5","start":30.668,"lines":[{"start":30.668,"end":31.971,"text":"Oluwa gunwa bi Ona","marked":"Olúwa gúnwà bí Ọ̀nà"},{"start":32.351,"end":33.497,"text":"L'ori 'te Re lorun","marked":"L'orí 'tẹ́ Rẹ lọ́rùn"},{"start":33.877,"end":36.14,"text":"O nwo aw' omo t'o n'ife","marked":"Ó ńwò aw' ọmọ t'ó ń'ífẹ́"},{"start":36.52,"end":37.939,"text":"O si nsami si won.","marked":"Ó sì ńsàmì sí wọn."},{"start":38.319,"end":38.988,"text":"Amin.","marked":"Àmín."}],"end":38.988}]}