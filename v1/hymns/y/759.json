{"v":1,"coll":"y","num":759,"id":"hymn_759","title":"LALA alagbase, tan","duration":53.485,"voices":{"male":{"file":"y-759-male.m4a","bytes":377748,"sha256":"1d6ae140db8ee19ae38ed77ce807db1644d250737950f7e5b67394b1e6d98a00","duration":53.5},"female":{"file":"y-759-female.m4a","bytes":391523,"sha256":"61a80b49f3b0a5942258f0e62f2fbc60376fb045a32e744dd7ac0607396dd9c7","duration":53.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.268,"text":"LALA alagbase, tan;","marked":"Làlá alágbàṣe, tán"},{"start":2.648,"end":3.754,"text":"Ojo ogun ti pari;","marked":"Ọjọ́ ogun ti parí"},{"start":4.134,"end":5.596,"text":"L'ebute jijin rere,","marked":"L'èbúté jíjìn réré"},{"start":5.976,"end":7.619,"text":"Ni oko re ti gun si.","marked":"Ni ọkọ rẹ̀ ti gùn sí."}],"end":7.619},{"key":"CHORUS","start":8.569,"lines":[{"start":8.569,"end":10.181,"text":"Egbe: Baba, Iabe itoju Re,","marked":"Bàbá, lábẹ́ ìtọ́jú Rẹ"},{"start":10.561,"end":12.169,"text":"L'awa f'iranse Re yi si.","marked":"L'áwá f'ìránṣẹ́ Rẹ̀ yí sí."}],"end":12.169},{"key":"2","start":13.119,"lines":[{"start":13.119,"end":14.672,"text":"Nibe l'a re won l'ekun","marked":"Níbẹ̀ l'á rẹ̀ wọ́n l'èkùn"},{"start":15.052,"end":16.667,"text":"Nibe, nwon m'ohun gbogbo","marked":"Níbẹ̀, nwọn m'ohun gbogbo"},{"start":17.047,"end":18.854,"text":"Nibe l'onidaj' oto","marked":"Níbẹ̀ l'onidaj' ọ̀tọ̀"},{"start":19.234,"end":20.661,"text":"Ndan ise aiye won wo.","marked":"Ndán iṣẹ́ àìyẹ́ wọn wò."}],"end":20.661},{"key":"3","start":21.611,"lines":[{"start":21.611,"end":23.133,"text":"Nibe l'olus'agutan","marked":"Níbẹ̀ l'olus'agutan"},{"start":23.513,"end":24.558,"text":"Nko awon agutan lo,","marked":"Ńkó àwọn àgùtàn lọ"},{"start":24.938,"end":26.265,"text":"Nibe l'o ndabobo won,","marked":"Níbẹ̀ l'ó ndabobo wọn"},{"start":26.645,"end":28.654,"text":"Koriko ko le de 'be.","marked":"Koríko kò lè dé 'bẹ̀."}],"end":28.654},{"key":"4","start":29.604,"lines":[{"start":29.604,"end":30.995,"text":"Nibe l'awon elese","marked":"Níbẹ̀ l'áwọn ẹlẹ́sẹ̀"},{"start":31.375,"end":32.818,"text":"Ti nteju m'agbelebu,","marked":"Ti nteju m'àgbélébùú"},{"start":33.198,"end":34.783,"text":"Y'o mo ife Kristi tan","marked":"Y'ó mọ ìfẹ́ Kristi tán"},{"start":35.163,"end":36.819,"text":"L'ese Re ni Paradise.","marked":"L'ẹsẹ̀ Rẹ ní Párádísè."}],"end":36.819},{"key":"5","start":37.769,"lines":[{"start":37.769,"end":39.027,"text":"Nibe l'agbara Esu,","marked":"Níbẹ̀ l'ágbára Èṣù"},{"start":39.407,"end":40.769,"text":"Ko le b'ayo won je mo","marked":"Kò lè b'àyò wọn jẹ́ mọ́"},{"start":41.149,"end":43.001,"text":"Krist Jesu sa nso won;","marked":"Krist Jésù sá ǹṣó wọn"},{"start":43.381,"end":44.769,"text":"On t'o ku dande won.","marked":"On t'ó kù dánde wọn."}],"end":44.769},{"key":"6","start":45.719,"lines":[{"start":45.719,"end":46.777,"text":"'Erupe fun erupe","marked":"'Erúpẹ́ fún erùpẹ̀"},{"start":47.157,"end":48.356,"text":"L'ede wa nisisi","marked":"L'èdè wa nísìsí"},{"start":48.736,"end":50.126,"text":"A te sile lati sun","marked":"A tẹ̀ sílẹ̀ láti sùn"},{"start":50.506,"end":51.935,"text":"Titi d'ojo ajinde.","marked":"Títí d'ọjọ́ àjíǹde."}],"end":51.935}]}