{"v":1,"coll":"y","num":755,"id":"hymn_755","title":"GB'ohun t'o t'orun wa ti wi","duration":23.844,"voices":{"male":{"file":"y-755-male.m4a","bytes":164050,"sha256":"11218d1d2b32d2fe5b8dabaa82b95f8f04ce694cb733ff3e0f4c18417099a5f0","duration":23.9},"female":{"file":"y-755-female.m4a","bytes":169174,"sha256":"9b17d2b441d8dc1ab5509799916da1d4ef6d03080c3c5e0077e88c06e5cbbced","duration":23.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.933,"text":"GB'ohun t'o t'orun wa ti wi","marked":"Gb'ohun t'ó t'ọrùn wa ti wí"},{"start":2.313,"end":3.418,"text":"F'awon oku mimo","marked":"F'àwọn òkú mímọ́́"},{"start":3.798,"end":5.406,"text":"Didun n'irant'oruko won","marked":"Dídùn n'irant'orúkọ wọn"},{"start":5.786,"end":6.999,"text":"Busun won n'itura.","marked":"Bùsùn wọn n'ìtura."}],"end":6.999},{"key":"2","start":7.949,"lines":[{"start":7.949,"end":9.763,"text":"Nwon ki n'nu Jesu abukun","marked":"Nwọn kí n'nú Jésù àbùkún"},{"start":10.143,"end":11.165,"text":"Orun won ti dun to!","marked":"Ọrùn wọn ti dùn tó!"},{"start":11.545,"end":12.679,"text":"Ninu irora on ese","marked":"Nínú ìrora ọ́n ẹ̀ṣẹ̀"},{"start":13.059,"end":14.494,"text":"Nwon yo ninu danwo.","marked":"Nwọ̀n yọ nínú dánwò."}],"end":14.494},{"key":"3","start":15.444,"lines":[{"start":15.444,"end":16.936,"text":"Lona jijin s'ayie ise","marked":"Lọ́nà jíjìn s'áyìé iṣẹ́"},{"start":17.316,"end":18.588,"text":"Nwon mbe lod'Oluwa","marked":"Nwọ̀n ḿbẹ lod'Olúwa"},{"start":18.968,"end":20.536,"text":"Ise won l'aiye iku yi","marked":"Iṣẹ́ wọn l'áìyẹ ikú yí"},{"start":20.916,"end":22.294,"text":"Pari li ere nla.","marked":"Parí li ère ńlá."}],"end":22.294}]}