{"v":1,"coll":"y","num":775,"id":"hymn_775","title":"BABA mi gbo temi","duration":29.616,"voices":{"male":{"file":"y-775-male.m4a","bytes":198677,"sha256":"e4eaefac10d67e5d54618bd41fc14ae294c681a7fcd7a8d29896467483396051","duration":29.7},"female":{"file":"y-775-female.m4a","bytes":208337,"sha256":"8182fcf375e5d23eabb4b8b397fb010f308b95fb3e2da6d78ca29558ea5e31a7","duration":29.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.35,"text":"BABA mi gbo temi","marked":"Bàbá mi gbọ́ tèmi"},{"start":1.73,"end":2.675,"text":"Wo ni Alabo mi","marked":"Wò ni Àlàbò mi"},{"start":3.055,"end":4.588,"text":"Ma sunmo ni titi","marked":"Má súnmọ́ ní títí"},{"start":4.968,"end":5.927,"text":"Oninure julo!","marked":"Oninure jùlọ!"}],"end":5.927},{"key":"2","start":6.877,"lines":[{"start":6.877,"end":7.884,"text":"Jesu Oluwa mi","marked":"Jésù Olúwa mi"},{"start":8.264,"end":9.333,"text":"Iye at'ogo mi","marked":"Iye àt'ògo mi"},{"start":9.713,"end":10.855,"text":"K'igba na yara de","marked":"K'ígbà ná yàrá dé"},{"start":11.235,"end":12.445,"text":"Ti ngo de odo Re.","marked":"Ti ngo dé ọ̀dọ̀ Rẹ."}],"end":12.445},{"key":"3","start":13.395,"lines":[{"start":13.395,"end":14.47,"text":"Olutunu julo","marked":"Olùtùnú jùlọ"},{"start":14.85,"end":16.011,"text":"Wo ti ngbe inu mi","marked":"Wo ti ńgbé inú mi"},{"start":16.391,"end":17.761,"text":"Wo to mo aini mi","marked":"Wò tó mọ àìní mi"},{"start":18.141,"end":19.885,"text":"Fa mi, ko si gba mi.","marked":"Fà mí, kò sì gbà mí."}],"end":19.885},{"key":"4","start":20.835,"lines":[{"start":20.835,"end":22.231,"text":"Mimo, Mimo, Mimo","marked":"Mímọ́́, Mímọ́́, Mímọ́́"},{"start":22.611,"end":23.906,"text":"Ma fi mi sile lai","marked":"Má fi mí sílẹ̀ láì"},{"start":24.286,"end":25.37,"text":"Se mi n'ibugbe Re","marked":"Ṣe mí n'ibùgbé Rẹ"},{"start":25.75,"end":27.055,"text":"Tire nikan lailia.","marked":"Tìrẹ nìkan lailia."},{"start":27.435,"end":28.066,"text":"Amin.","marked":"Àmín."}],"end":28.066}]}