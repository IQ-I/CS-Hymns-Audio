{"v":1,"coll":"y","num":59,"id":"hymn_59","title":"IRAPADA; ltan iyanu","duration":53.319,"voices":{"male":{"file":"y-59-male.m4a","bytes":385651,"sha256":"9ac40e00249f3433c853c238cd4d9945bc024438fb59abecb7141e601136bce4","duration":53.4},"female":{"file":"y-59-female.m4a","bytes":398576,"sha256":"eee2cb84a11e7f230e4622f3a1c12a3636041e1907fb86e71af36d05237e0eb5","duration":53.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.364,"text":"IRAPADA; ltan iyanu,","marked":"Ìràpadà; ltan ìyanu"},{"start":2.744,"end":4.629,"text":"Ni ayo fun o at'emi,","marked":"Ní ayọ̀ fún ọ àt'èmi"},{"start":5.009,"end":6.623,"text":"Pe Jesu ti ra idariji","marked":"Pé Jésù ti ra ìdáríjì"},{"start":7.003,"end":8.629,"text":"O san gbese na lori 'gi.","marked":"Ó san gbèsè ná lórí 'gi."}],"end":8.629},{"key":"CHORUS","start":9.579,"lines":[{"start":9.579,"end":11.357,"text":"A! 'wo elese gba eyi gbo","marked":"A! 'wò ẹlẹ́ṣẹ̀ gba èyí gbọ́"},{"start":11.737,"end":13.021,"text":"Gba ihin otito no gbo","marked":"Gba ìhìn òtítọ́́ nọ gbọ́"},{"start":13.401,"end":15.521,"text":"Gbeke l 'eni to ku Iori 'gi","marked":"Gbẹ́kẹ̀ l 'ẹni tó kú lórí 'gi"},{"start":15.901,"end":17.183,"text":"To mu igbala wa fun o.","marked":"Tó mú ìgbàlà wá fún ọ."}],"end":17.183},{"key":"2","start":18.133,"lines":[{"start":18.133,"end":19.634,"text":"Gbani Olorun nisisiyi","marked":"Gbani Ọlọ́run nísìsíyí"},{"start":20.014,"end":21.733,"text":"Segun agbar'ese fun wa,","marked":"Ṣẹ́gun agbár'ẹ̀ṣẹ̀ fún wa"},{"start":22.113,"end":23.482,"text":"'Tori on yio gba enito wa","marked":"'Torí ọ́n yío gba enítọ́ wa"},{"start":23.862,"end":25.648,"text":"Ki yio si ta o nu lailai.","marked":"Kí yìó sì ta ọ́ nù láíláí."}],"end":25.648},{"key":"3","start":26.598,"lines":[{"start":26.598,"end":28.311,"text":"Ese ki yio fun lagbara mo,","marked":"Ẹsẹ̀ kì yio fún lágbára mọ́"},{"start":28.691,"end":30.406,"text":"Bi ko tile ye dan wa wo,","marked":"Bí kò tilẹ̀ yé dán wa wò"},{"start":30.786,"end":32.396,"text":"Nipa ise 'rapada Kristi","marked":"Nípa iṣẹ́ 'ràpadà Kristi"},{"start":32.776,"end":34.154,"text":"Agbara ese yio parun.","marked":"Agbára ẹ̀ṣẹ̀ yio parun."}],"end":34.154},{"key":"4","start":35.104,"lines":[{"start":35.104,"end":36.735,"text":"O mu wa lat' iku bo si iye","marked":"Ó mú wa lat' iku bọ́ sí ìyè"},{"start":37.115,"end":38.701,"text":"O si so wa d'om'Olorun","marked":"Ó sì sọ wá d'om'Ọlọ́run"},{"start":39.081,"end":40.581,"text":"Orisun kan si fun elese","marked":"Orísun kan sì fún ẹlẹ́ṣẹ̀"},{"start":40.961,"end":43.103,"text":"We nin' eje na ko si mo.","marked":"Wé nín' ẹ̀jẹ́ ná kò sí mọ́."}],"end":43.103},{"key":"5","start":44.053,"lines":[{"start":44.053,"end":45.53,"text":"Gba anu t'Olorun fi lo o","marked":"Gba ànú t'Ọlọ́run fi lọ̀ ọ́"},{"start":45.91,"end":47.675,"text":"Sa wa sodo Jesu loni","marked":"Sá wá sọ́dọ̀ Jésù lónì"},{"start":48.055,"end":49.78,"text":"'Tori y'o gb'eni to ba to wa","marked":"'Torí y'ó gb'ẹni tó bá tọ́ wa"},{"start":50.16,"end":51.769,"text":"Ki yio si pada lailai.","marked":"Kí yío sì padà láíláí."}],"end":51.769}]}