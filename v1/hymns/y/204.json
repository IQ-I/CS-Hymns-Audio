{"v":1,"coll":"y","num":204,"id":"hymn_204","title":"AYO b'aiye! Oluwa de","duration":33.482,"voices":{"male":{"file":"y-204-male.m4a","bytes":239110,"sha256":"46179e96e9bb04cb45427cc10f5cb167d4144ffa82107802f5e5c6ee2c2f859f","duration":33.5},"female":{"file":"y-204-female.m4a","bytes":245974,"sha256":"100c04bddd46b6bbded93585b024f7c1312b077aad2a8a867da6b0f53dff9b85","duration":33.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.152,"text":"AYO b'aiye! Oluwa de;","marked":"Ayọ̀ b'áíyẹ! Olúwa dé"},{"start":2.532,"end":4.171,"text":"K' aiye gba Oba re;","marked":"K' aiye gba Ọba rẹ̀"},{"start":4.551,"end":5.751,"text":"Ki gbogbo okan mura de,","marked":"Kí gbogbo ọkàn múra dé"},{"start":6.131,"end":7.58,"text":"K'aiye korin soke.","marked":"K'aiye kọrin sókè."}],"end":7.58},{"key":"2","start":8.53,"lines":[{"start":8.53,"end":10.725,"text":"Ayo b'aiye! Jesu joba,","marked":"Ayọ̀ b'aiye! Jésù jọba"},{"start":11.105,"end":12.299,"text":"E je ' Ka ho f' ayo;","marked":"Ẹ jẹ́ ' Ká hó f' ayò"},{"start":12.679,"end":14.176,"text":"Gbogbo igbe, omi, oke,","marked":"Gbogbo ìgbẹ́, omi, òkè"},{"start":14.556,"end":15.954,"text":"Nwon ngberin ayo na.","marked":"Nwọ̀n ńgbérìn ayọ̀ ná."}],"end":15.954},{"key":"3","start":16.904,"lines":[{"start":16.904,"end":18.458,"text":"K'ese on 'yonu pin l'aiye,","marked":"K'èse on 'yonu pin l'aiye"},{"start":18.838,"end":20.272,"text":"K' egun ye hun n' ile;","marked":"K' egun yẹ̀ hùn n' ile"},{"start":20.652,"end":22.235,"text":"O de lati mu 'bukun san,","marked":"Ó dé láti mú 'bùkún san"},{"start":22.615,"end":24.078,"text":"De'bi t'egun gbe de.","marked":"De'bí t'ẹ́gun gbé dé."}],"end":24.078},{"key":"4","start":25.028,"lines":[{"start":25.028,"end":27.05,"text":"O f' oto at' ife joba,","marked":"Ó f' ọ̀tọ̀ at' ife jọba"},{"start":27.43,"end":28.716,"text":"O jek' Oril' ede,","marked":"Ó jẹ́k' Oríl' èdè"},{"start":29.096,"end":30.243,"text":"Mo ododo ljoba Re,","marked":"Mọ òdodo ljoba Rẹ"},{"start":30.623,"end":31.932,"text":"At' ife 'iyanu Re.","marked":"Àt' ìfẹ́ 'ìyanu Rẹ̀."}],"end":31.932}]}