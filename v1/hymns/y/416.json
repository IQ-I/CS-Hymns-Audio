{"v":1,"coll":"y","num":416,"id":"hymn_416","title":"OLUWA, awa'do Re","duration":32.938,"voices":{"male":{"file":"y-416-male.m4a","bytes":233443,"sha256":"4b39a8fce185243942b5701b1be817f741a72143c2954f7f69432dfcd2dc4ed8","duration":33.0},"female":{"file":"y-416-female.m4a","bytes":236938,"sha256":"1323b27b7ddf1207db2323f72e08fef46cf78f9a9dac44b0810e5a8058cf82d1","duration":33.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.037,"text":"OLUWA, awa'do Re","marked":"Olúwa, àwá'dọ̀ Rẹ"},{"start":2.417,"end":4.161,"text":"L'ese Re l'a kunle si","marked":"L'ẹsẹ̀ Rẹ l'á kúnlẹ̀ sí"},{"start":4.541,"end":6.442,"text":"A! ma kegan ebe wa","marked":"A! má kẹ́gàn ẹ̀bẹ̀ wa"},{"start":6.822,"end":7.794,"text":"Ao wa lasan bi!","marked":"Àò wá lásán bí!"}],"end":7.794},{"key":"2","start":8.744,"lines":[{"start":8.744,"end":10.172,"text":"L' ona to O yan fun wa","marked":"L' ọ̀nà tó O yàn fún wa"},{"start":10.552,"end":11.835,"text":"L'a nwa O lowolowo","marked":"L'á ńwá O lọ́wọ́lọ́wọ́"},{"start":12.215,"end":13.498,"text":"Oluwa a ki o lo","marked":"Olúwa a kí ó lọ"},{"start":13.878,"end":15.286,"text":"Titi 'Wo o bukun wa.","marked":"Títí 'Wò ó bùkún wa."}],"end":15.286},{"key":"3","start":16.236,"lines":[{"start":16.236,"end":17.455,"text":"Ranse lat'oro Re wa","marked":"Ránṣẹ́ lát'ọ̀rọ̀ Rẹ̀ wá"},{"start":17.835,"end":19.292,"text":"Ti O fi ayo‐fun wa","marked":"Tí Ó fi ayọ̀-fún wa"},{"start":19.672,"end":21.018,"text":"Je ki emi Re ko fun","marked":"Jẹ́ kí ẹ̀mí Rẹ kò fún"},{"start":21.398,"end":22.518,"text":"Okan wa ni igbala.","marked":"Ọkàn wa ni ìgbàlà."}],"end":22.518},{"key":"4","start":23.468,"lines":[{"start":23.468,"end":25.456,"text":"Jek'a wa, k'a si ri O","marked":"Jẹ́k'á wá, k'á sì rí O"},{"start":25.836,"end":26.832,"text":"Ni Olorun Olore","marked":"Ní Ọlọ́run Ọlọ́rẹ́"},{"start":27.212,"end":29.689,"text":"W'alasian, da 'gbekun si,","marked":"W'alasian, dá 'gbèkùn sí"},{"start":30.069,"end":31.388,"text":"Ki gbogbo wa yo si O.","marked":"Kí gbogbo wa yọ sí O."}],"end":31.388}]}