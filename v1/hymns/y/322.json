{"v":1,"coll":"y","num":322,"id":"hymn_322","title":"OLUWA ji loto","duration":61.996,"voices":{"male":{"file":"y-322-male.m4a","bytes":457686,"sha256":"d17a37534d084d0a280af4db3df2390c59a2c4635c664adfe2927951896879e0","duration":62.0},"female":{"file":"y-322-female.m4a","bytes":468731,"sha256":"5b5cf82417f675c8903704c47a083b39b0b46c23f249fb6d289380a89ee23b62","duration":62.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.693,"text":"OLUWA ji loto","marked":"Olúwa jí lọ́tọ̀"},{"start":2.073,"end":3.119,"text":"Olugbala dide","marked":"Olùgbàlà dìde"},{"start":3.499,"end":4.595,"text":"O f'agbara Re han","marked":"Ó f'agbára Rẹ̀ hàn"},{"start":4.975,"end":6.237,"text":"L'or'orun apadi","marked":"L'or'ọ̀run àpádì"},{"start":6.617,"end":8.503,"text":"N'iberu nla, awon eso","marked":"N'ìbẹ̀rù ńlá, àwọn ẹ̀ṣọ́"},{"start":8.883,"end":10.958,"text":"Subu lule, nwon si daku.","marked":"Ṣubú lulẹ̀, nwọn sì dákú."}],"end":10.958},{"key":"2","start":11.908,"lines":[{"start":11.908,"end":13.439,"text":"Wo, egbe angeli","marked":"Wò, ẹgbẹ́ áńgẹ́lì"},{"start":13.819,"end":15.066,"text":"Pade l'ajo kikun","marked":"Pádẹ l'ájò kíkún"},{"start":15.446,"end":16.594,"text":"Lati gbo ase Re","marked":"Láti gbọ́ àṣẹ Rẹ"},{"start":16.974,"end":17.886,"text":"Ati lati juba","marked":"Àti láti júbà"},{"start":18.266,"end":20.535,"text":"Nwon f'ayo wa, nwon si nfo lo","marked":"Nwọ̀n f'àyò wa, nwọ̀n sì ńfò lọ"},{"start":20.915,"end":22.726,"text":"Lati orun si 'boji na.","marked":"Láti ọ̀run sí 'bòji ná."}],"end":22.726},{"key":"3","start":23.676,"lines":[{"start":23.676,"end":25.011,"text":"Nwon tun fo lo s'orun","marked":"Nwọ̀n tún fò lọ s'ọrun"},{"start":25.391,"end":26.717,"text":"Nwon mu 'hin ayo lo","marked":"Nwọ̀n mú 'hin ayọ̀ lọ"},{"start":27.097,"end":27.983,"text":"Gbo iro orin won","marked":"Gbọ́ ìró orin wọn"},{"start":28.363,"end":29.821,"text":"Bi nwon si ti nfo lo","marked":"Bí nwọ̀n sì ti ńfọ́ lọ"},{"start":30.201,"end":32.214,"text":"Orin won ni, Jesu t'o ku","marked":"Orin wọn ni, Jésù t'ó kú"},{"start":32.594,"end":34.501,"text":"Ti ji dide, o Ji Ioni.","marked":"Ti jí dìde, ó Jí lónì."}],"end":34.501},{"key":"4","start":35.451,"lines":[{"start":35.451,"end":36.834,"text":"Enyin t'a ra pada","marked":"Enyin t'á rà padà"},{"start":37.214,"end":38.415,"text":"E gberin ayo na","marked":"Ẹ gbẹ̀rín ayọ̀ ná"},{"start":38.795,"end":40.04,"text":"Run iro re kiri","marked":"Rùn irọ́ rẹ kiri"},{"start":40.42,"end":41.732,"text":"Si gbogbo agbaiye","marked":"Sí gbogbo agbaiye"},{"start":42.112,"end":44.249,"text":"E ho f'ayo, Jesu t'o ku","marked":"Ẹ hó f'àyò, Jésù t'ó kú"},{"start":44.629,"end":47.114,"text":"Ti ji dide, ki y'o ku mo.","marked":"Ti jí dìde, kí y'ó kú mọ́."}],"end":47.114},{"key":"5","start":48.064,"lines":[{"start":48.064,"end":49.609,"text":"Kabiyesi! Jesu!","marked":"Kábíyèsí! Jésù!"},{"start":49.989,"end":51.044,"text":"T'o Feje Re gba wa","marked":"T'ó Fẹ́jẹ̀ Rẹ̀ gbà wá"},{"start":51.424,"end":52.365,"text":"Ki iyin Re jale","marked":"Kí ìyìn Rẹ jálẹ̀"},{"start":52.745,"end":54.101,"text":"lwo t'o ji dide","marked":"lwo t'ó jí dìde"},{"start":54.481,"end":56.678,"text":"A ba O ji, a si joba","marked":"A bá Ó jí, a sì jọba"},{"start":57.058,"end":59.362,"text":"Pelu Re lai, l'oke orun.","marked":"Pẹ̀lú Rẹ láì, l'òkè ọ̀run."},{"start":59.742,"end":60.446,"text":"Amin.","marked":"Àmín."}],"end":60.446}]}