{"v":1,"coll":"y","num":47,"id":"hymn_47","title":"ELESE kan mbe to nf'anu","duration":64.298,"voices":{"male":{"file":"y-47-male.m4a","bytes":479939,"sha256":"5e38e71fcc147330c30e8b2a82eebe1138044e065987209676dd91cd5e681411","duration":64.3},"female":{"file":"y-47-female.m4a","bytes":499547,"sha256":"afee68fb5c69517cb22d058bc13a3ff96ce2e6c7d96b0cf91d814dcde6298035","duration":64.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.969,"text":"ELESE kan mbe to nf'anu,","marked":"Ẹlẹ́sẹ̀ kan mbẹ́ tó ńf'ánú"},{"start":2.349,"end":3.304,"text":"Ati 'dariji loni,","marked":"Àti 'dáríjì lónì"},{"start":3.684,"end":5.652,"text":"Fi ayo gba ihin t'a mu wa","marked":"Fi ayọ̀ gba ìhìn t'á mú wá"},{"start":6.032,"end":7.426,"text":"Jesu nkoja lo nihin;","marked":"Jésù ńkọjá lọ níhìn"},{"start":7.806,"end":9.274,"text":"Mbo wa pin 'fe ati anu","marked":"Mbo wá pín 'fẹ́ àti ànú"},{"start":9.654,"end":10.929,"text":"'Dariji on alafia","marked":"'Dáríjì on àlàáfíà"},{"start":11.309,"end":13.272,"text":"Mbo wa yo l'okan elese","marked":"Mbọ̀ wá yó l'ọ́kan ẹlẹ́sẹ̀"},{"start":13.652,"end":15.213,"text":"Irora ati osi.","marked":"Ìrora àti òṣì."}],"end":15.213},{"key":"CHORUS","start":16.163,"lines":[{"start":16.163,"end":17.576,"text":"Jesu nkoja lo nihin,","marked":"Jésù ńkọjá lọ níhìn"},{"start":17.956,"end":18.973,"text":"Loni...loni","marked":"Lọ́ni lónì"},{"start":19.353,"end":21.066,"text":"Gbagbo gbat'o wa nitosi","marked":"Gbagbó gbat'ó wà nítòsí"},{"start":21.446,"end":23.114,"text":"S'okan re paya lati gba.","marked":"S'ọkàn rẹ̀ payá láti gbà."},{"start":23.494,"end":24.919,"text":"'Tori Jesu nkoja nihin","marked":"'Torí Jésù ńkọjá níhìn"},{"start":25.299,"end":26.506,"text":"O nkoja nihin Ioni.","marked":"Ó ńkọjá níhìn lónì."}],"end":26.506},{"key":"2","start":27.456,"lines":[{"start":27.456,"end":29.271,"text":"Arakunrin, Jesu nduro","marked":"Arákùnrin, Jésù ńdúró"},{"start":29.651,"end":31.261,"text":"Lati dariji l'ofe","marked":"Láti dariji l'ọ̀fẹ́"},{"start":31.641,"end":33.544,"text":"Ese t'o ko gba nisisiyi","marked":"Ẹsẹ̀ t'ó kò gbà nísìsíyí"},{"start":33.924,"end":35.226,"text":"Gbekele or'ofe Re","marked":"Gbẹ́kẹ̀lé or'ọ̀fẹ́ Rẹ"},{"start":35.606,"end":37.158,"text":"Anu ati 'fe Re sowon,","marked":"Ànú àti 'fẹ́ Rẹ̀ ṣọ̀wọ́n"},{"start":37.538,"end":38.629,"text":"Ko jina si o loni","marked":"Kò jiná sí ọ lónì"},{"start":39.009,"end":40.634,"text":"A! silekun okan Re fun","marked":"A! ṣílẹ̀kùn ọkàn Rẹ fún"},{"start":41.014,"end":42.65,"text":"B'O ti sunmo tosi re.","marked":"B'ó ti súnmọ́ tòsí rẹ̀."},{"start":43.03,"end":44.439,"text":"Egbe: Jesu nkoja lo nihin...","marked":"Jésù ńkọjá lọ níhìn"}],"end":44.439},{"key":"3","start":45.389,"lines":[{"start":45.389,"end":47.35,"text":"A! o mbo lati bukun o,","marked":"A! ó ḿbọ́ láti bùkún o"},{"start":47.73,"end":49.185,"text":"Gbo, fi irele teriba","marked":"Gbọ́, fi ìrẹ̀lẹ̀ tẹríbá"},{"start":49.565,"end":50.892,"text":"Mbo wa ra o ninu ese","marked":"Mbo wá rà ọ́ nínú ẹsẹ"},{"start":51.272,"end":53.058,"text":"O setan lati gba o,","marked":"Ó ṣetán láti gbà ọ́"},{"start":53.438,"end":54.82,"text":"lwo ha je ko 'gbala yi","marked":"lwo ha jẹ́ kó 'gbàlà yí"},{"start":55.2,"end":56.504,"text":"Ti Jesu nfi ro o,","marked":"Tí Jésù ńfi rò ó"},{"start":56.884,"end":58.129,"text":"A! silekun okan re fun,","marked":"A! ṣílẹ̀kùn ọkàn rẹ fún"},{"start":58.509,"end":60.044,"text":"B'O ti nsunmo 'tosi re.","marked":"B'ó ti ńsúnmọ́ 'tòsí rẹ̀."},{"start":60.424,"end":61.799,"text":"Egbe: Jesu nkoja lo nihin...","marked":"Jésù ńkọjá lọ níhìn"},{"start":62.179,"end":62.749,"text":"Amin.","marked":"Àmín."}],"end":62.749}]}