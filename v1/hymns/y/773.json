{"v":1,"coll":"y","num":773,"id":"hymn_773","title":"OLORUN awa fe","duration":44.48,"voices":{"male":{"file":"y-773-male.m4a","bytes":303426,"sha256":"ed38a1ed2d7d5ba16f3a12f00f3cc2c47422e0dbfaaa46f94a1bd9d92cf5f350","duration":44.5},"female":{"file":"y-773-female.m4a","bytes":319012,"sha256":"9028580fd1f662c197121dff6b3dc51505fa4d8f7d32334a533d4018dc9653ed","duration":44.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.233,"text":"OLORUN, awa fe","marked":"Ọlọ́run, àwa fẹ́"},{"start":2.613,"end":3.635,"text":"Ile t'ola Re wa","marked":"Ilé t'ọ́lá Rẹ wà"},{"start":4.015,"end":4.936,"text":"Ayo ibugbe Re","marked":"Ayọ̀ ibùgbé Rẹ"},{"start":5.316,"end":6.538,"text":"Ju gbogbo ayo lo.","marked":"Ju gbogbo ayọ̀ lọ."}],"end":6.538},{"key":"2","start":7.488,"lines":[{"start":7.488,"end":8.567,"text":"Ile adura ni","marked":"Ilé àdúrà ni"},{"start":8.947,"end":9.956,"text":"Fun awa omo Re","marked":"Fún àwa ọmọ Rẹ"},{"start":10.336,"end":11.939,"text":"Jesu, O wa nibe","marked":"Jésù, Ó wà níbẹ̀"},{"start":12.319,"end":13.851,"text":"Lati gbo ebe wa.","marked":"Láti gbọ́ ẹ̀bẹ̀ wa."}],"end":13.851},{"key":"3","start":14.801,"lines":[{"start":14.801,"end":15.758,"text":"Awa fe ase Re","marked":"Àwa fẹ́ àṣẹ Rẹ̀"},{"start":16.138,"end":17.69,"text":"Kil'o dun to laiye","marked":"Kil'ó dùn tó láìyẹ"},{"start":18.07,"end":19.166,"text":"Nib'awon oloto","marked":"Níb'àwọn ọlọ́tọ̀"},{"start":19.546,"end":20.59,"text":"Nri O nitosi won.","marked":"Nri O nítòsí wọn."}],"end":20.59},{"key":"4","start":21.54,"lines":[{"start":21.54,"end":22.869,"text":"Awa fe oro Re","marked":"Àwa fẹ́ ọ̀rọ̀ Rẹ"},{"start":23.249,"end":24.175,"text":"oro Alafia","marked":"ọ̀rọ̀ Àlàáfíà"},{"start":24.555,"end":25.679,"text":"Tinunu at'iye","marked":"Tinunu àt'ìyẹ"},{"start":26.059,"end":27.3,"text":"Oro ayo titi.","marked":"Ọ̀rọ̀ ayọ̀ títí."}],"end":27.3},{"key":"5","start":28.25,"lines":[{"start":28.25,"end":29.258,"text":"A fe korin anu","marked":"A fẹ́ kọrin ànú"},{"start":29.638,"end":30.869,"text":"T'a nri gba l'aiye yi","marked":"T'á ńrí gbá l'áiye yí"},{"start":31.249,"end":32.707,"text":"Sugbon awa fe mo","marked":"Ṣùgbọ́n àwa fẹ́ mọ̀"},{"start":33.087,"end":34.281,"text":"Orin ayo t'orun.","marked":"Orin ayò t'ọrun."}],"end":34.281},{"key":"6","start":35.231,"lines":[{"start":35.231,"end":36.819,"text":"Jesu, Oluwa wa","marked":"Jésù, Olúwa wa"},{"start":37.199,"end":38.327,"text":"Busi fe wa nihin","marked":"Búsì fẹ́ wà níhìn"},{"start":38.707,"end":39.982,"text":"Mu wa de 'nu ogo","marked":"Mú wa dé 'nu ògo"},{"start":40.362,"end":41.955,"text":"Lati yin O titi.","marked":"Láti yìn Ọ́ títí."},{"start":42.335,"end":42.93,"text":"Amin.","marked":"Àmín."}],"end":42.93}]}