{"v":1,"coll":"y","num":185,"id":"hymn_185","title":"ONIDAJO mbo wa","duration":30.586,"voices":{"male":{"file":"y-185-male.m4a","bytes":214812,"sha256":"dfdd6fa8809dba4d731713ff34595b07fb7d935c84005ced09ad8f2a4d4ae149","duration":30.6},"female":{"file":"y-185-female.m4a","bytes":217818,"sha256":"c4d2554cfc04ea7e020f7da0e6493e84bd1c7ec83ed4d8e46c8df258639c2699","duration":30.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.277,"text":"ONIDAJO mbo wa","marked":"Onídàjọ́ ḿbọ̀ wá"},{"start":1.657,"end":2.896,"text":"Awon oku jinde","marked":"Àwọn òkú jíǹde"},{"start":3.276,"end":4.547,"text":"Enikan ko yo kuro","marked":"Ẹnìkan kò yọ kúrò"},{"start":4.927,"end":6.209,"text":"'Nu imole oju Re.","marked":"'Nu ìmọ́lẹ̀̀ ojú Rẹ."}],"end":6.209},{"key":"2","start":7.159,"lines":[{"start":7.159,"end":8.078,"text":"Enu ododo Re","marked":"Ẹnu òdodo Rẹ"},{"start":8.458,"end":9.709,"text":"Yio da ebi fun","marked":"Yíó dá ẹ̀bi fún"},{"start":10.089,"end":11.319,"text":"Awon t'o so anu Re nu","marked":"Àwọn t'ó sọ ãnú Rẹ̀ nù"},{"start":11.699,"end":12.868,"text":"Ti nwon se buburu.","marked":"Ti nwọn ṣe búburú."}],"end":12.868},{"key":"3","start":13.818,"lines":[{"start":13.818,"end":14.959,"text":"'Lo kuro lodo mi","marked":"'Lọ kúrò lọ́dọ̀ mi"},{"start":15.339,"end":17.057,"text":"S'ina ti ko l'opin","marked":"S'íná tí kò l'òpin"},{"start":17.437,"end":19.013,"text":"Ti a ti pese fun Esu","marked":"Tí a ti pèsè fún Èṣù"},{"start":19.393,"end":20.706,"text":"T'o ti nsote si mi.","marked":"T'ó ti nsọtẹ̀ sí mi."}],"end":20.706},{"key":"4","start":21.656,"lines":[{"start":21.656,"end":22.918,"text":"lwo ti duro to!","marked":"lwo ti dúró tó!"},{"start":23.298,"end":24.485,"text":"Oju na o mbo wa","marked":"Ojú ná ó ḿbọ̀ wá"},{"start":24.865,"end":26.354,"text":"T'aiye at'orun o fo lo","marked":"T'aiye àt'ọrùn ò fò lọ"},{"start":26.734,"end":28.109,"text":"Kuro ni wiwa Re.","marked":"Kúrò ní wíwá Rẹ."},{"start":28.489,"end":29.036,"text":"Amin.","marked":"Àmín."}],"end":29.036}]}