{"v":1,"coll":"y","num":317,"id":"hymn_317","title":"LO kede ayo na fun gbogbo aiye","duration":92.02,"voices":{"male":{"file":"y-317-male.m4a","bytes":680389,"sha256":"10985ffa0d8080cc485b3f0911afea10f4e873e05ceedeffae411923353fc5be","duration":92.1},"female":{"file":"y-317-female.m4a","bytes":702982,"sha256":"b0e1e0a73bec4857144699f0ddaf16513321a9c1f4979037a5bdc3270658dd63","duration":92.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.475,"text":"LO kede ayo na fun gbogbo aiye","marked":"Ló kéde ayọ̀ ná fún gbogbo aiye"},{"start":2.855,"end":4.462,"text":"P'Omo Olorun segun iku","marked":"P'Ọmọ Ọlọ́run ṣẹ́gun ikú"},{"start":4.842,"end":7.081,"text":"Fi iyin-tiyin pel'ayo rohin na,","marked":"Fi ìyìn-tìyín pel'ayo ròhìn ná"},{"start":7.461,"end":8.764,"text":"Emi Mimo to gunwa.","marked":"Ẹ̀mí Mímọ́́ tó gúnwà."},{"start":9.144,"end":9.925,"text":"Egbe: Oba mi de!","marked":"Ọba mi dé!"},{"start":10.305,"end":11.26,"text":"Asegun mi de!","marked":"Aṣẹ́gun mi dé!"},{"start":11.64,"end":13.91,"text":"Ogo, Ola at'agbara ati 'pa","marked":"Ògo, Ọlá àt'ágbára àti 'pa"},{"start":14.29,"end":15.74,"text":"F 'Odagutan to gunwa.","marked":"F 'Ọ̀dàgùtàn tó gúnwà."}],"end":15.74},{"key":"CHORUS","start":16.69,"lines":[{"start":16.69,"end":17.484,"text":"Oba mi de!","marked":"Ọba mi dé!"},{"start":17.864,"end":18.787,"text":"Asegun mi de!","marked":"Aṣẹ́gun mi dé!"},{"start":19.167,"end":21.561,"text":"Ogo, Ola at'agbara ati 'pa","marked":"Ògo, Ọlá àt'ágbára àti 'pa"},{"start":21.941,"end":23.536,"text":"F 'Odagutan to gunwa.","marked":"F 'Ọ̀dàgùtàn tó gúnwà."}],"end":23.536},{"key":"2","start":24.486,"lines":[{"start":24.486,"end":25.829,"text":"lyin Jesu l'awon","marked":"lyin Jésù l'àwọn"},{"start":26.209,"end":27.235,"text":"Ange li nke","marked":"Àǹgẹ́ li ńkẹ́"},{"start":27.615,"end":28.996,"text":"T'o wa ra 'raiye pada","marked":"T'ó wá ra 'raiye padà"},{"start":29.376,"end":31.437,"text":"Okan soso ajanaku ni Jesu,","marked":"Ọ̀kan ṣoṣo àjànàkù ni Jésù"},{"start":31.817,"end":33.241,"text":"T'o m'aiye pelu orun.","marked":"T'ó m'aiye pẹ̀lú ọrun."},{"start":33.621,"end":34.356,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":34.356},{"key":"3","start":35.306,"lines":[{"start":35.306,"end":36.952,"text":"Kabiyesi Oba Alaiyeluwa","marked":"Kábíyèsí Ọba Aláìyẹ́lúwà"},{"start":37.332,"end":38.889,"text":"Metalokan Alagbara","marked":"Mẹ́talọ́kan Alágbára"},{"start":39.269,"end":40.796,"text":"Awamaridi Olodumare","marked":"Àwámáridì Olódùmarè"},{"start":41.176,"end":42.208,"text":"T'o nse ise iyanu.","marked":"T'ó ńṣe iṣẹ́ ìyanu."},{"start":42.588,"end":43.339,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":43.339},{"key":"4","start":44.289,"lines":[{"start":44.289,"end":45.881,"text":"ltiju nla d a bo awon ika","marked":"ltiju ńlá d á bo àwọn ìkà"},{"start":46.261,"end":47.697,"text":"T'o kan Oluwa wa mo 'gi","marked":"T'ó kan Olúwa wa mọ́ 'gi"},{"start":48.077,"end":50.504,"text":"Rikisi ikoko ota ti d' asan","marked":"Rikisi ìkòkò ọta ti d' asán"},{"start":50.884,"end":52.373,"text":"Olugbala ji dide.","marked":"Olùgbàlà jí dìde."},{"start":52.753,"end":53.618,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":53.618},{"key":"5","start":54.568,"lines":[{"start":54.568,"end":56.34,"text":"Bi orile-ede enia dudu","marked":"Bí orílẹ̀-èdè enia dúdú"},{"start":56.72,"end":58.177,"text":"Ati ka wa si eweko","marked":"Àti ká wá sí ewéko"},{"start":58.557,"end":60.473,"text":"Sugbon awa ni Baba kan l'oke","marked":"Ṣùgbọ́n àwa ni Bàbá kan l'òkè"},{"start":60.853,"end":62.129,"text":"T'o mo pe 'se Re ni wa.","marked":"T'ó mọ̀ pé 'ṣe Ré ni wá."},{"start":62.509,"end":63.273,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":63.273},{"key":"6","start":64.223,"lines":[{"start":64.223,"end":65.889,"text":"Ayo t'o wa ninu Ajinde","marked":"Ayọ̀ t'ó wà nínú Àjíǹde"},{"start":66.269,"end":67.596,"text":"Jowo fun wa Olugbala","marked":"Jọ̀wọ́ fún wa Olùgbàlà"},{"start":67.976,"end":70.241,"text":"'Gbat'a ba yo si O Eleda wa","marked":"'Gbat'á bá yọ sí Ọ Ẹlẹ́dàá wa"},{"start":70.621,"end":72.262,"text":"K'awa le gb'ade ogo.","marked":"K'áwá lè gb'adé ògo."},{"start":72.642,"end":73.393,"text":"Egbe: Oba mi de!...","marked":"Ọba mi dé!"}],"end":73.393},{"key":"7","start":74.343,"lines":[{"start":74.343,"end":76.346,"text":"Awa f'ogo fun Baba wa l'oke","marked":"Àwa f'ògo fún Bàbá wa l'òkè"},{"start":76.726,"end":78.042,"text":"A tun f'ogo fun Omo Re","marked":"A tún f'ògo fún Ọmọ Rẹ"},{"start":78.422,"end":80.308,"text":"Awa tun f'ogo fun O Emi Mimo","marked":"Àwa tún f'ògo fún O Ẹ̀mí Mímọ́́"},{"start":80.688,"end":82.124,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọpẹ́ yẹ."},{"start":82.504,"end":83.26,"text":"Egbe: Oba mi de!","marked":"Ọba mi dé!"},{"start":83.64,"end":84.565,"text":"Asegun mi de!","marked":"Aṣẹ́gun mi dé!"},{"start":84.945,"end":87.673,"text":"Ogo, Ola at'agbara ati 'pa","marked":"Ògo, Ọlá àt'ágbára àti 'pa"},{"start":88.053,"end":89.501,"text":"F 'Odagutan to gunwa.","marked":"F 'Ọ̀dàgùtàn tó gúnwà."},{"start":89.881,"end":90.47,"text":"Amin.","marked":"Àmín."}],"end":90.47}]}