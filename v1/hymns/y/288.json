{"v":1,"coll":"y","num":288,"id":"hymn_288","title":"HOSANNA s'Omo Dafidi","duration":39.859,"voices":{"male":{"file":"y-288-male.m4a","bytes":284160,"sha256":"a2a79a4675c01d1967d66cf0288156763549c090568c3f005eff79f804e307f7","duration":39.9},"female":{"file":"y-288-female.m4a","bytes":294797,"sha256":"60aac2454f8148c419a486c50da09c0785c60242f2471f9060db4bf6ce039c9e","duration":39.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.776,"text":"HOSANNA s'Omo Dafidi","marked":"Hosanna s'Ọmọ Dáfídì"},{"start":2.156,"end":3.811,"text":"Hosanna, e korin","marked":"Hosanna, ẹ kọrin"},{"start":4.191,"end":5.369,"text":"'Olubukun l'Eniti mbo","marked":"'Olùbùkún l'Eniti ḿbọ̀"},{"start":5.749,"end":6.717,"text":"L'oruko Oluwa.","marked":"L'orúkọ Olúwa."}],"end":6.717},{"key":"2","start":7.667,"lines":[{"start":7.667,"end":9.233,"text":"Hosanna s'Omo Dafidi","marked":"Hosanna s'Ọmọ Dáfídì"},{"start":9.613,"end":10.771,"text":"L'Egbe Angeli nke","marked":"L'Ẹgbẹ́ Áńgẹ́lì ńkẹ́"},{"start":11.151,"end":12.477,"text":"Gbogbo eda jumo gberin","marked":"Gbogbo ẹ̀dá jùmọ̀ gbẹ̀rín"},{"start":12.857,"end":14.046,"text":"Hosanna s'Oba wa.","marked":"Hosanna s'Ọba wa."}],"end":14.046},{"key":"3","start":14.996,"lines":[{"start":14.996,"end":16.97,"text":"Hosanna! awon Heberu","marked":"Hosanna! àwọn Hébérù"},{"start":17.35,"end":18.521,"text":"Ja imo ope sona","marked":"Já ìmọ̀ ọpẹ́ sọ́nà"},{"start":18.901,"end":20.342,"text":"Hosanna a mu ebun wa","marked":"Hosanna á mú ẹ̀bùn wá"},{"start":20.722,"end":21.739,"text":"Fi tun ona Re se.","marked":"Fi tún ọ̀nà Rẹ ṣe."}],"end":21.739},{"key":"4","start":22.689,"lines":[{"start":22.689,"end":24.72,"text":"T'agba t'ewe nke Hosanna!","marked":"T'àgbà t'ewé ńkẹ́ Hosanna!"},{"start":25.1,"end":26.529,"text":"K'ijiya Re to de;","marked":"K'ìjìyà Rẹ̀ tó dé"},{"start":26.909,"end":28.674,"text":"Loni, a si nko Hosanna!","marked":"Lọ́ni, a ṣì ńkọ́ Hosanna!"},{"start":29.054,"end":30.387,"text":"B'O ti njoba l'oke.","marked":"B'ó ti njoba l'òkè."}],"end":30.387},{"key":"5","start":31.337,"lines":[{"start":31.337,"end":32.845,"text":"'B'O ti gba 'yin won nigbana","marked":"'B'o ti gbà 'yìn wọn nígbàná"},{"start":33.225,"end":34.661,"text":"Jo gba ebe wa yi","marked":"Jọ gba ẹ̀bẹ̀ wa yí"},{"start":35.041,"end":36.615,"text":"Lorun ka le b'angel 'korin","marked":"Lọ́run ká lè b'angel 'kọrin"},{"start":36.995,"end":38.309,"text":"Hosanna s'Oba wa.","marked":"Hosanna s'Ọba wa."}],"end":38.309}]}