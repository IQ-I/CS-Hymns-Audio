{"v":1,"coll":"y","num":787,"id":"hymn_787","title":"E BA wa korin iyin Halleluya","duration":69.086,"voices":{"male":{"file":"y-787-male.m4a","bytes":500200,"sha256":"1984665044161aa320a7e6ef25baa0188f1b4dc88e338b5a29ea296bbedd69d9","duration":69.1},"female":{"file":"y-787-female.m4a","bytes":517820,"sha256":"0472e5bcb1d300a81756107539d148f10dbeacd8f84153844b48d686abdafe7f","duration":69.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.977,"text":"E BA wa korin iyin Halleluya","marked":"Ẹ Bá wa kọrin ìyìn Hallelúyà"},{"start":2.357,"end":3.947,"text":"E ba wa yin Oba Ogo,","marked":"Ẹ bá wá yin Ọba Ògo"},{"start":4.327,"end":5.595,"text":"To da wa si di oni","marked":"Tó dá wa sì di òní"},{"start":5.975,"end":6.867,"text":"Halleluyah!","marked":"Hallelúyà!"},{"start":7.247,"end":8.479,"text":"E ba yin Oba Ogo.","marked":"Ẹ bá yin Ọba Ògo."}],"end":8.479},{"key":"CHORUS","start":9.429,"lines":[{"start":9.429,"end":11.096,"text":"Egbe: Bus'ayo, arakunrin","marked":"Bus'ayo, arákùnrin"},{"start":11.476,"end":12.528,"text":"E gbe orin iyin 'ga,","marked":"Ẹ gbé orin ìyìn 'ga"},{"start":12.908,"end":14.928,"text":"Bu s'ayo, arabinrin,","marked":"Bu s'ayo, arábìnrin"},{"start":15.308,"end":16.237,"text":"Halleluya!","marked":"Hallelúyà!"},{"start":16.617,"end":18.252,"text":"E wa gbe Ebenezer ro.","marked":"Ẹ wá gbé Ebenezer ró."}],"end":18.252},{"key":"2","start":19.202,"lines":[{"start":19.202,"end":20.3,"text":"E ba wa korin iyin","marked":"Ẹ bá wa kọrin ìyìn"},{"start":20.68,"end":21.461,"text":"Halleluya","marked":"Hallelúyà"},{"start":21.841,"end":23.41,"text":"Fun isegun t'O fi fun wa,","marked":"Fún ìṣẹ́gun t'Ó fi fún wa"},{"start":23.79,"end":25.655,"text":"Ti ko jek'ota yo wa Halleluya","marked":"Tí kò jẹ́k'ọ̀tá yọ wá Hallelúyà"},{"start":26.035,"end":27.565,"text":"E ba wa yin Oba Ogo.","marked":"Ẹ bá wá yin Ọba Ògo."},{"start":27.945,"end":29.575,"text":"Egbe: Bus'ayo, arakunrin...","marked":"Bus'ayo, arákùnrin"}],"end":29.575},{"key":"3","start":30.525,"lines":[{"start":30.525,"end":31.673,"text":"E ba wa korin iyin,","marked":"Ẹ bá wa kọrin ìyìn"},{"start":32.053,"end":32.853,"text":"Halleluyah","marked":"Hallelúyà"},{"start":33.233,"end":34.77,"text":"Fun 'se 'yanu to se larin wa,","marked":"Fún 'ṣe 'yanu tó ṣe lárin wa"},{"start":35.15,"end":38.39,"text":"To fo itegun Esu, Halleluya!","marked":"Tó fọ́ ìtẹ́gun Èṣù, Hallelúyà!"},{"start":38.77,"end":40.672,"text":"T'o mu wa la 'danwo koja.","marked":"T'ó mú wa la 'dánwò kọjá."},{"start":41.052,"end":42.722,"text":"Egbe: Bus'ayo, arakunrin...","marked":"Bus'ayo, arákùnrin"}],"end":42.722},{"key":"4","start":43.672,"lines":[{"start":43.672,"end":44.83,"text":"E ba wa korin iyin,","marked":"Ẹ bá wa kọrin ìyìn"},{"start":45.21,"end":46.066,"text":"Halleluya!","marked":"Hallelúyà!"},{"start":46.446,"end":47.976,"text":"Fun idagbasoke emi wa,","marked":"Fún ìdàgbàsókè ẹ̀mí wa"},{"start":48.356,"end":49.765,"text":"To pe wa sinu agbo,","marked":"Tó pè wá sínú agbo"},{"start":50.145,"end":51.079,"text":"Halleluya!","marked":"Hallelúyà!"},{"start":51.459,"end":53.133,"text":"Ti ko je ka d'eni gbajare.","marked":"Tí kò jẹ́ ká d'ẹni gbàjarè."},{"start":53.513,"end":55.101,"text":"Egbe: Bus'ayo, arakunrin...","marked":"Bus'ayo, arákùnrin"}],"end":55.101},{"key":"5","start":56.051,"lines":[{"start":56.051,"end":57.281,"text":"Iyin f'Olorun Baba","marked":"Ìyìn f'Ọlọ́run Bàbá"},{"start":57.661,"end":58.488,"text":"Halleluya!","marked":"Hallelúyà!"},{"start":58.868,"end":60.235,"text":"Iyin fun Olorun Omo,","marked":"Ìyìn fún Ọlọ́run Ọmọ"},{"start":60.615,"end":62.521,"text":"Iyin fun Emi Mimo Halleluya!","marked":"Ìyìn fún Ẹ̀mí Mímọ́́ Hallelúyà!"},{"start":62.901,"end":64.486,"text":"Metalokan la fi 'yin fun.","marked":"Mẹ́talọ́kan la fi 'yìn fún."},{"start":64.866,"end":66.596,"text":"Egbe: Bus'ayo, arakunrin...","marked":"Bus'ayo, arákùnrin"},{"start":66.976,"end":67.536,"text":"Amin.","marked":"Àmín."}],"end":67.536}]}