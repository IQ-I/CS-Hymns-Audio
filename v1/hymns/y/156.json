{"v":1,"coll":"y","num":156,"id":"hymn_156","title":"SI O olutunu Orun","duration":54.488,"voices":{"male":{"file":"y-156-male.m4a","bytes":391508,"sha256":"3fbb7506a12bbb88e9f6ed307bd9705b8ac4d0f564e182ce6134f5bccf367822","duration":54.5},"female":{"file":"y-156-female.m4a","bytes":398176,"sha256":"dbabce577d439b59257870919c939f943fcb210dd4798e31e2714304c6574c37","duration":54.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.571,"text":"SI O olutunu Orun","marked":"Sí Ọ olùtùnú Ọ̀run"},{"start":1.951,"end":3.582,"text":"Fun ore at'agbara Re,","marked":"Fún ọrẹ àt'agbára Rẹ"},{"start":3.962,"end":5.267,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":5.267},{"key":"2","start":6.217,"lines":[{"start":6.217,"end":8.355,"text":"Si O, ife enit' o wa,","marked":"Sí Ọ, ìfẹ́ enit' ò wà"},{"start":8.735,"end":9.823,"text":"Ninu Majemu Olorun","marked":"Nínú Májẹ̀mú Ọlọ́run"},{"start":10.203,"end":11.413,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":11.413},{"key":"3","start":12.363,"lines":[{"start":12.363,"end":13.869,"text":"Si O ohun eniti npe","marked":"Sí Ọ ohun ẹniti ńpẹ́"},{"start":14.249,"end":15.619,"text":"Asako kuro ninu ese,","marked":"Àṣàkò kúrò nínú ẹ̀ṣẹ̀"},{"start":15.999,"end":17.431,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":17.431},{"key":"4","start":18.381,"lines":[{"start":18.381,"end":19.985,"text":"Si O, agbara eniti","marked":"Sí Ọ, agbára ẹniti"},{"start":20.365,"end":22.811,"text":"O nwe ni mo, t'o nwo ni san","marked":"Ó ńwé ni mo, t'ó ńwò ni sàn"},{"start":23.191,"end":24.708,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":24.708},{"key":"5","start":25.658,"lines":[{"start":25.658,"end":27.664,"text":"Si O, ododo Eniti","marked":"Sí Ọ, òdodo Énìtì"},{"start":28.044,"end":29.333,"text":"Gbogbo ileri Re je ti wa","marked":"Gbogbo ìlérí Rẹ̀ jẹ́ ti wá"},{"start":29.713,"end":31.182,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":31.182},{"key":"6","start":32.132,"lines":[{"start":32.132,"end":34.363,"text":"Si O, Oluko at'Ore","marked":"Sí Ọ, Olùkọ́ àt'Ọ̀rẹ́"},{"start":34.743,"end":36.569,"text":"Amona wa toto d'opin","marked":"Amọ̀nà wa toto d'òpin"},{"start":36.949,"end":38.251,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":38.251},{"key":"7","start":39.201,"lines":[{"start":39.201,"end":41.355,"text":"Si O, Eniti Kristi ran","marked":"Sí Ọ, Ẹniti Kristi rán"},{"start":41.735,"end":43.391,"text":"Ade on gbongbo ebun Re,","marked":"Adé on gbòǹgbò ẹ̀bùn Rẹ"},{"start":43.771,"end":45.218,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."}],"end":45.218},{"key":"8","start":46.168,"lines":[{"start":46.168,"end":48.298,"text":"Si O, Enit'o je okan","marked":"Sí Ọ, Enit'ó jẹ́ ọ̀kan"},{"start":48.678,"end":50.169,"text":"Pelu Baba ati Omo","marked":"Pẹ̀lú Bàbá àti Ọmọ"},{"start":50.549,"end":51.919,"text":"A nko Alleluya.","marked":"A ńkọ́ Allelúyà."},{"start":52.299,"end":52.938,"text":"Amin.","marked":"Àmín."}],"end":52.938}]}