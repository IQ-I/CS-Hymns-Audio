{"v":1,"coll":"y","num":150,"id":"hymn_150","title":"OHUN t'Oluwa yio se","duration":33.85,"voices":{"male":{"file":"y-150-male.m4a","bytes":223825,"sha256":"5bc13c8f2c2efb0b85207d173ac7ebec2a0b3796b8743b475b4492b782e5a727","duration":33.9},"female":{"file":"y-150-female.m4a","bytes":230947,"sha256":"9a2bb112a0f7ed47ef3ce7025888ef142dc785883565ab30a5744e410445f400","duration":33.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.739,"text":"OHUN t'Oluwa yio se","marked":"Ohun t'Olúwa yio ṣe"},{"start":2.119,"end":4.009,"text":"Oba mi ko fi y'enikan.","marked":"Ọba mi kò fi y'ẹnìkan."}],"end":4.009},{"key":"CHORUS","start":4.959,"lines":[{"start":4.959,"end":6.838,"text":"Awon enia pataki lo ti ku","marked":"Àwọn enia pàtàkì ló ti kú"},{"start":7.218,"end":9.36,"text":"Opo enia pataki lo ti Io o","marked":"Ọ̀pọ̀ enia pàtàkì ló ti lò ó"},{"start":9.74,"end":11.153,"text":"Eda to ba wa laye,","marked":"Ẹ̀dá tó bá wà láyé"},{"start":11.533,"end":13.058,"text":"Ko wa fi iyin f'onise Nla.","marked":"Kò wá fi ìyìn f'oníṣẹ́ Ńlá."}],"end":13.058},{"key":"2","start":14.008,"lines":[{"start":14.008,"end":15.139,"text":"Ore t'Oluwa ba se","marked":"Ọ̀rẹ́ t'Olúwa bá ṣe"},{"start":15.519,"end":16.828,"text":"Ara mi jowo fi han o.","marked":"Ara mi jọ̀wọ́ fi hàn ọ́."}],"end":16.828},{"key":"3","start":17.778,"lines":[{"start":17.778,"end":18.945,"text":"Ore t'Oluwa ba se","marked":"Ọ̀rẹ́ t'Olúwa bá ṣe"},{"start":19.325,"end":20.678,"text":"Ore mi jowo fi han o.","marked":"Ọ̀rẹ́ mi jọ̀wọ́ fi hàn ọ́."}],"end":20.678},{"key":"4","start":21.628,"lines":[{"start":21.628,"end":22.702,"text":"Omo l'Olorun fun o","marked":"Ọmọ l'Ọlọ́run fún ọ"},{"start":23.082,"end":24.461,"text":"Ore mi jowo fi han o.","marked":"Ọ̀rẹ́ mi jọ̀wọ́ fi hàn ọ́."}],"end":24.461},{"key":"5","start":25.411,"lines":[{"start":25.411,"end":26.612,"text":"lke l'Olorun fun o","marked":"lkè l'Ọlọ́run fún ọ"},{"start":26.992,"end":28.342,"text":"Ore mi jowo fi han o.","marked":"Ọ̀rẹ́ mi jọ̀wọ́ fi hàn ọ́."}],"end":28.342},{"key":"6","start":29.292,"lines":[{"start":29.292,"end":30.317,"text":"Ohun t'Oluwa fun o","marked":"Ohun t'Olúwa fún ọ"},{"start":30.697,"end":32.301,"text":"Jowo fi yin Messiah o.","marked":"Jọ̀wọ́ fi yin Messiah o."}],"end":32.301}]}