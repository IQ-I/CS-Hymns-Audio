{"v":1,"coll":"y","num":34,"id":"hymn_34","title":"A BE a fe ri O","duration":29.374,"voices":{"male":{"file":"y-34-male.m4a","bytes":204570,"sha256":"80a840090f69de6bcb6e64851a2373b169c9b855772e5332cc485922ea14019c","duration":29.4},"female":{"file":"y-34-female.m4a","bytes":208548,"sha256":"27f5f2e59f212f5ef1631549e640d5579f8985360c3c1d48532df6e32c008e1e","duration":29.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.37,"text":"A BE a fe ri O,","marked":"A Bẹ́ a fẹ́ rí O"},{"start":1.75,"end":2.815,"text":"Ojo 'simi rere","marked":"Ọjọ́ 'sími rere"},{"start":3.195,"end":4.655,"text":"Gbogbo ose a ma wipe","marked":"Gbogbo ọ̀sẹ̀ á mà wípé"},{"start":5.035,"end":6.063,"text":"lwo o ti pe to?","marked":"lwo ò ti pẹ́ tó?"}],"end":6.063},{"key":"2","start":7.013,"lines":[{"start":7.013,"end":8.484,"text":"O ko wa pe Kristi","marked":"Ó kọ́ wa pé Kristi"},{"start":8.864,"end":10.132,"text":"Jinde ninu oku","marked":"Jíǹde nínú òkú"},{"start":10.512,"end":12.079,"text":"Gbogbo ose a ma wipe","marked":"Gbogbo ọ̀sẹ̀ á mà wípé"},{"start":12.459,"end":13.393,"text":"Iwo o ti pe to!","marked":"Ìwọ ò ti pẹ́ tó!"}],"end":13.393},{"key":"3","start":14.343,"lines":[{"start":14.343,"end":15.497,"text":"O so t'ajnde wa","marked":"Ó sọ t'ajnde wa"},{"start":15.877,"end":17.054,"text":"Gege bi ti Jesu,","marked":"Gẹ́gẹ́ bí ti Jésù"},{"start":17.434,"end":18.97,"text":"Gbogbo ose a ma wipe,","marked":"Gbogbo ọ̀sẹ̀ á mà wípé"},{"start":19.35,"end":20.286,"text":"Iwo o ti pe to!","marked":"Ìwọ ò ti pẹ́ tó!"}],"end":20.286},{"key":"4","start":21.236,"lines":[{"start":21.236,"end":22.44,"text":"Iwo so t' isimi","marked":"Ìwọ sọ t' isimi"},{"start":22.82,"end":23.746,"text":"T'ilu alafia","marked":"T'ìlú àlàáfíà"},{"start":24.126,"end":25.511,"text":"Ti'ibukun enia mimo","marked":"Ti'ìbùkún enia mímọ́́"},{"start":25.891,"end":26.803,"text":"Iwo o ti pe to.","marked":"Ìwọ ò ti pẹ́ tó."},{"start":27.183,"end":27.824,"text":"Amin.","marked":"Àmín."}],"end":27.824}]}