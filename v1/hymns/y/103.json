{"v":1,"coll":"y","num":103,"id":"hymn_103","title":"OLUWA l'Olus'agutan mi","duration":62.142,"voices":{"male":{"file":"y-103-male.m4a","bytes":450313,"sha256":"b1697c6612b15e8a87770b8827cf05fb4baaedf0d5ba983f3572652a8f881750","duration":62.2},"female":{"file":"y-103-female.m4a","bytes":459620,"sha256":"49603302d0cdeb6adeb71c427d07bf4206e23f8e9391914d0ae43b5db507d51b","duration":62.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.749,"text":"OLUWA l'Olus'agutan mi,","marked":"Olúwa l'Olùs'àgùtàn mi"},{"start":2.129,"end":3.458,"text":"Emi k'o salani","marked":"Èmi k'ó ṣalani"},{"start":3.838,"end":5.568,"text":"O mu mi dubule 'nu papa oko,","marked":"Ó mú mi dùbúlẹ̀ 'nu pápá oko"},{"start":5.948,"end":7.092,"text":"Tutu minimini.","marked":"Tútù minimini."},{"start":7.472,"end":9.388,"text":"Egbe:  Awa dupe, at'ope da,","marked":"Àwa dúpẹ́, àt'ọpẹ́ dà"},{"start":9.768,"end":10.961,"text":"Fun idasi Re fun wa","marked":"Fún ìdásí Rẹ fún wa"},{"start":11.341,"end":12.977,"text":"Larin Egbe Serafu.","marked":"Lárin Ẹgbẹ́ Séráfù."}],"end":12.977},{"key":"2","start":13.927,"lines":[{"start":13.927,"end":15.451,"text":"O mu mi lo si iha omi,","marked":"Ó mú mi lọ sí ìhà omi"},{"start":15.831,"end":17.054,"text":"Idake roro si de,","marked":"Ìdákẹ́ rọ́rọ́ sì dé"},{"start":17.434,"end":18.606,"text":"O si tu okan mi lara,","marked":"Ó sì tu ọkàn mi lára"},{"start":18.986,"end":20.209,"text":"Ni ipa oruko Re.","marked":"Ní ipa orúkọ Rẹ."},{"start":20.589,"end":21.539,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":21.539},{"key":"3","start":22.489,"lines":[{"start":22.489,"end":24.061,"text":"Nitoto bi mo tile nrin","marked":"Nítòtò bí mo tilẹ̀ ńrìn"},{"start":24.441,"end":25.73,"text":"Larin afonifoji","marked":"Lárin àfonífojì"},{"start":26.11,"end":27.824,"text":"Emi ki yio beru ibi kan","marked":"Èmi kí yíó bẹ̀rù ibì kan"},{"start":28.204,"end":29.604,"text":"Nitori o wa pelu mi.","marked":"Nítorí ó wà pẹ̀lú mi."},{"start":29.984,"end":30.862,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":30.862},{"key":"4","start":31.812,"lines":[{"start":31.812,"end":33.465,"text":"Ogo Re ati opa Re","marked":"Ògo Rẹ àti ọ̀pá Rẹ"},{"start":33.845,"end":35.234,"text":"Nwon si ntu mi ninu","marked":"Nwọ̀n sì ńtù mí nínú"},{"start":35.614,"end":37.259,"text":"lwo te tabili onje sile","marked":"lwọ́ tẹ́ tábìlì ońjẹ sílẹ̀"},{"start":37.639,"end":38.765,"text":"Ni iwaju mi.","marked":"Ní iwájú mi."},{"start":39.145,"end":40.18,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":40.18},{"key":"5","start":41.13,"lines":[{"start":41.13,"end":42.798,"text":"Nitoto ire ati anu","marked":"Nítòtó ire àti ànú"},{"start":43.178,"end":44.448,"text":"Ni yio ma to mi lehin","marked":"Ní yíó má tó mi lẹ́hìn"},{"start":44.828,"end":46.042,"text":"Emi o gbekele Oluwa","marked":"Èmi ò gbẹ́kẹ̀lé Olúwa"},{"start":46.422,"end":47.929,"text":"Ni gbogbo ojo aiye mi.","marked":"Ní gbogbo ọjọ́ aiye mi."},{"start":48.309,"end":49.202,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":49.202},{"key":"6","start":50.152,"lines":[{"start":50.152,"end":51.982,"text":"K'a f'ogo fun Baba wa loke","marked":"K'á f'ògo fún Bàbá wa lókè"},{"start":52.362,"end":53.771,"text":"K'a f'ogo fun Omo Re","marked":"K'á f'ògo fún Ọmọ Rẹ"},{"start":54.151,"end":55.954,"text":"K'a f'ogo fun O Emi Mimo","marked":"K'á f'ògo fún O Ẹ̀mí Mímọ́́"},{"start":56.334,"end":58.248,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọpẹ́ yẹ."},{"start":58.628,"end":59.55,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"},{"start":59.93,"end":60.592,"text":"Amin.","marked":"Àmín."}],"end":60.592}]}