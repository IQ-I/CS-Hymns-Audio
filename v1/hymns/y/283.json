{"v":1,"coll":"y","num":283,"id":"hymn_283","title":"lWO Iow'enit' ire nsan","duration":43.742,"voices":{"male":{"file":"y-283-male.m4a","bytes":310745,"sha256":"1770351752a958b503746d0ef047bf3d2ccec52f98bd6c69cba1890816f266d1","duration":43.8},"female":{"file":"y-283-female.m4a","bytes":319976,"sha256":"fdec79261c79a67ec1b00016b1ddba3ff1a960d90cbf8ee303552880712883bf","duration":43.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.492,"text":"lWO Iow'enit' ire nsan","marked":"Ìwo low'enit' irè ńsan"},{"start":2.872,"end":4.026,"text":"Mo gb'okan mi si O","marked":"Mo gb'ọkàn mi sí O"},{"start":4.406,"end":6.281,"text":"Ni 'ibanuje at'ise mi,","marked":"Ní 'ìbànújẹ́ àt'iṣẹ́ mi"},{"start":6.661,"end":8.122,"text":"Oluwa, ranti mi.","marked":"Olúwa, rántí mi."}],"end":8.122},{"key":"2","start":9.072,"lines":[{"start":9.072,"end":10.498,"text":"'Gba mo nkerora l'okan mi","marked":"'Gbà mo ńkérora l'ọkàn mi"},{"start":10.878,"end":12.121,"text":"T'ese wo mi l'orun","marked":"T'ẹsẹ̀ wọ̀ mí l'ọ̀run"},{"start":12.501,"end":13.997,"text":"Dari gbogbo ese ji mi","marked":"Darí gbogbo ẹ̀ṣẹ̀ jì mí"},{"start":14.377,"end":16.008,"text":"Ni ife, ranti mi.","marked":"Ní ìfẹ́, rántí mi."}],"end":16.008},{"key":"3","start":16.958,"lines":[{"start":16.958,"end":18.422,"text":"'Gba 'danwo kikan yi mi ka","marked":"'Gbà 'dánwò kíkan yí mi ká"},{"start":18.802,"end":19.921,"text":"Ti ibi le mi ba","marked":"Tí ibi lè mí bá"},{"start":20.301,"end":22.054,"text":"Oluwa, fun mi l'agbara","marked":"Olúwa, fún mi l'ágbára"},{"start":22.434,"end":24.045,"text":"Fun rere, ranti mi.","marked":"Fún rere, rántí mi."}],"end":24.045},{"key":"4","start":24.995,"lines":[{"start":24.995,"end":26.595,"text":"Bi 'tiju at'egan ba de","marked":"Bí 'tìjú àt'ẹ̀gàn bá dé"},{"start":26.975,"end":28.111,"text":"'Tiro oruko re","marked":"'Tiro orúkọ rẹ"},{"start":28.491,"end":30.961,"text":"Ngo yo s'egan, ngo gba t'iju,","marked":"Ngo yó s'ẹ̀gàn, ngo gba t'ijù"},{"start":31.341,"end":32.715,"text":"B'iwo ba ranti mi.","marked":"B'ìwọ bá rántí mi."}],"end":32.715},{"key":"5","start":33.665,"lines":[{"start":33.665,"end":34.974,"text":"Oluwa, gba iku de","marked":"Olúwa, gba ikú dé"},{"start":35.354,"end":36.837,"text":"Em' o sa ku dandan;","marked":"Em' ò sá kù dandan"},{"start":37.217,"end":38.862,"text":"K'eyi j'adura gbehin mi,","marked":"K'èyí j'àdúrà gbẹ̀hìn mi"},{"start":39.242,"end":41.25,"text":"Oluwa, ranti mi.","marked":"Olúwa, rántí mi."},{"start":41.63,"end":42.192,"text":"Amin.","marked":"Àmín."}],"end":42.192}]}