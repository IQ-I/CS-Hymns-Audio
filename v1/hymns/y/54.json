{"v":1,"coll":"y","num":54,"id":"hymn_54","title":"BABA jo ranti mi","duration":58.106,"voices":{"male":{"file":"y-54-male.m4a","bytes":410664,"sha256":"79e73b58eb9d4a1e1a195e1caea142a1adb3eee4fe19ea4c80cafd292558070c","duration":58.2},"female":{"file":"y-54-female.m4a","bytes":421117,"sha256":"a52c66edcb5881a688b161ad804195a5856e6c5a3f3bc505070fa3f6d37268e9","duration":58.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.52,"text":"BABA jo ranti mi,","marked":"Bàbá jọ rántí mi"},{"start":1.9,"end":3.48,"text":"Ni 'ile Mimo Ioke","marked":"Ní 'ilẹ̀ Mímọ́́ lókè"},{"start":3.86,"end":5.464,"text":"Jo gba mi ki nje tire,","marked":"Jọ gbà mí kí ǹjẹ́ tìrẹ"},{"start":5.844,"end":7.342,"text":"S'ile Mimo loke.","marked":"S'ilẹ̀ Mímọ́́ lókè."}],"end":7.342},{"key":"CHORUS","start":8.292,"lines":[{"start":8.292,"end":9.234,"text":"Oluwa ranti mi,","marked":"Olúwa rántí mi"},{"start":9.614,"end":10.66,"text":"Oluwa ranti mi,","marked":"Olúwa rántí mi"},{"start":11.04,"end":12.343,"text":"Gbat'O ba de joba Re,","marked":"Gbat'Ó bá dé jọba Rẹ̀"},{"start":12.723,"end":13.859,"text":"Oluwa ranti mi.","marked":"Olúwa rántí mi."}],"end":13.859},{"key":"2","start":14.809,"lines":[{"start":14.809,"end":15.859,"text":"Elese jo ronu","marked":"Ẹlẹ́ṣẹ̀ jọ ronú"},{"start":16.239,"end":17.644,"text":"K'akoko to koja","marked":"K'àkókò tó kọjá"},{"start":18.024,"end":19.151,"text":"Akoko koja f'ole","marked":"Àkókò kọjá f'ọ́lẹ̀"},{"start":19.531,"end":20.677,"text":"To wa lowo osi","marked":"Tó wà lọ́wọ́ òsì"}],"end":20.677},{"key":"3","start":21.627,"lines":[{"start":21.627,"end":22.602,"text":"Okan mi ji giri,","marked":"Ọkàn mi jí gìrì"},{"start":22.982,"end":24.299,"text":"K'akoko to koja","marked":"K'àkókò tó kọjá"},{"start":24.679,"end":25.971,"text":"Ki ilekun anu re se;","marked":"Kí ilẹ̀kùn ãnu rẹ ṣe"},{"start":26.351,"end":27.329,"text":"Oluwa ranti mi","marked":"Olúwa rántí mi"}],"end":27.329},{"key":"4","start":28.279,"lines":[{"start":28.279,"end":29.279,"t