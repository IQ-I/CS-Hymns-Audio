{"v":1,"coll":"y","num":121,"id":"hymn_121","title":"F'ORUK' Olorun loke","duration":34.584,"voices":{"male":{"file":"y-121-male.m4a","bytes":248054,"sha256":"67c487dd5e218ce6ba0de90852c7a5fbd83b5dcbf1fa3e1c14fc3017b66e5893","duration":34.6},"female":{"file":"y-121-female.m4a","bytes":255551,"sha256":"3bf18a30400f59168213b822504ed1c65dd8943adb12697d3f00b598db5ded91","duration":34.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.916,"text":"F'ORUK' Olorun loke","marked":"F'oruk' Ọlọ́run lókè"},{"start":2.296,"end":3.91,"text":"T'O l'agbara at'ola","marked":"T'ó l'ágbára àt'ọ́lá"},{"start":4.29,"end":5.391,"text":"Olorun ibi gbogbo","marked":"Ọlọ́run ibi gbogbo"},{"start":5.771,"end":6.969,"text":"N'iyin ati ogo wa","marked":"N'ìyìn àti ògo wa"}],"end":6.969},{"key":"2","start":7.919,"lines":[{"start":7.919,"end":9.397,"text":"F'oruko Krist' Oluwa","marked":"F'orúkọ Krist' Olúwa"},{"start":9.777,"end":10.957,"text":"Om' Olorun ti a bi","marked":"Om' Ọlọ́run tí a bí"},{"start":11.337,"end":13.334,"text":"Krist' t'O da ohun gbogbo","marked":"Krist' t'Ó dá ohun gbogbo"},{"start":13.714,"end":15.451,"text":"Ni k'a san 'yin ailopin.","marked":"Ní k'á sàn 'yín àìlópin."}],"end":15.451},{"key":"3","start":16.401,"lines":[{"start":16.401,"end":17.635,"text":"F'Olorun Emi Mimo","marked":"F'Ọlọ́run Ẹ̀mí Mímọ́́"},{"start":18.015,"end":19.496,"text":"Ni k'iyin pipe wa lae","marked":"Ní k'ìyìn pípé wà láé"},{"start":19.876,"end":21.282,"text":"Pelu baba at'Omo","marked":"Pẹ̀lú bàbá àt'Ọmọ"},{"start":21.662,"end":23.458,"text":"Okan l'oruko, l'ogo.","marked":"Ọ̀kan l'òrukọ, l'ògo."}],"end":23.458},{"key":"4","start":24.408,"lines":[{"start":24.408,"end":26.048,"text":"Orin t'a ti ko koja","marked":"Orin t'á tí kò kọjá"},{"start":26.428,"end":28.284,"text":"T'ao si ma ko lae leyi","marked":"T'áò sì má kọ́ láé lèyí"},{"start":28.664,"end":30.202,"text":"Ki awon iran ti mbo","marked":"Kí àwọn ìran ti ḿbọ"},{"start":30.582,"end":31.997,"text":"Dapo korin didun na.","marked":"Dàpọ̀ kọrin dídùn ná."},{"start":32.377,"end":33.035,"text":"Amin.","marked":"Àmín."}],"end":33.035}]}