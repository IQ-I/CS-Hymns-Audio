{"v":1,"coll":"y","num":208,"id":"hymn_208","title":"OJO ayo nlanla na de","duration":51.744,"voices":{"male":{"file":"y-208-male.m4a","bytes":374854,"sha256":"1e4a924a2d1268e317ff66ba3beb23bb9df156bbbccfede68af5b439ae24faf9","duration":51.8},"female":{"file":"y-208-female.m4a","bytes":387326,"sha256":"406eec5ad878ba56250b5ac1e8978bd9a7d1c5940ae612b2126404a48ae10c54","duration":51.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.036,"text":"OJO ayo nlanla na de,","marked":"Ọjọ́ ayọ̀ ńláǹlà nà dé"},{"start":2.416,"end":4.181,"text":"Eyit' araiye ti nreti;","marked":"Èyít' aráiye ti ńrètí"},{"start":4.561,"end":6.636,"text":"Nigbati' Olugbala W' aiye,","marked":"Nígbàtí' Olùgbàlà W' aiye"},{"start":7.016,"end":8.514,"text":"Nigbat'a bi ninu ara.","marked":"Nígbat'á bí nínú ara."}],"end":8.514},{"key":"2","start":9.464,"lines":[{"start":9.464,"end":11.046,"text":"Olus'agutan ni papa,","marked":"Olùs'ágùtàn ní pápá"},{"start":11.426,"end":13.052,"text":"Bi nwon ti so agutan won,","marked":"Bí nwọn ti sọ àgùtàn wọn"},{"start":13.432,"end":14.83,"text":"Ni ihin ayo na ko ba,","marked":"Ní ìhìn ayọ̀ ná kò bá"},{"start":15.21,"end":16.539,"text":"lhin bibi Olugbala.","marked":"lhìn bíbí Olùgbàlà."}],"end":16.539},{"key":"3","start":17.489,"lines":[{"start":17.489,"end":18.634,"text":"Angel iranse Oluwa,","marked":"Angel ìránṣẹ́ Olúwa"},{"start":19.014,"end":21.387,"text":"L' a ran si won, alabukun,","marked":"L' á rán sí wọn, alábùkún"},{"start":21.767,"end":23.492,"text":"Pelu ogo t' o ntan julo,","marked":"Pẹ̀lú ògo t' o ńtàn jùlọ"},{"start":23.872,"end":25.595,"text":"Lati so ihin ayo yi.","marked":"Láti sọ ìhìn ayọ̀ yí."}],"end":25.595},{"key":"4","start":26.545,"lines":[{"start":26.545,"end":27.717,"text":"Gdigidi l' eru ba won,","marked":"Gdigidi l' eru bà wọ́n"},{"start":28.097,"end":29.408,"text":"Fun ajeji iran nla yi;","marked":"Fún àjèjì ìran ńlá yí"},{"start":29.788,"end":31.325,"text":"“Ma beru\" l' oro iyanju,","marked":"Má bẹ̀rù l' oro ìyànjú"},{"start":31.705,"end":32.959,"text":"T' o t'enu Angeli wa.","marked":"T' ò t'ẹnu Áńgẹ́lì wa."}],"end":32.959},{"key":"5","start":33.909,"lines":[{"start":33.909,"end":35.025,"text":"A bi Olugbala loni,","marked":"A bí Olùgbàlà lónì"},{"start":35.405,"end":37.044,"text":"Kristi Oluwa aiye ni;","marked":"Kristi Olúwa aiye ni"},{"start":37.424,"end":39.212,"text":"N' ilu nla Dafidi I' O wa,","marked":"N' ìlú ńlá Dáfídì l' Ó wà"},{"start":39.592,"end":41.672,"text":"N' ibuje eran l'a te si.","marked":"N' ibùjẹ ẹran l'á tẹ̀ sí."}],"end":41.672},{"key":"6","start":42.622,"lines":[{"start":42.622,"end":44.269,"text":"“Ogo fun Olorun' l'orin,","marked":"Ògo fún Ọlọ́run' l'orin"},{"start":44.649,"end":46.517,"text":"Ti enia y'o ko s'orun;","marked":"Ti enia y'ó kò s'orun"},{"start":46.897,"end":48.309,"text":"Fun ife Re laini opin,","marked":"Fún ìfẹ́ Rẹ láìní òpin"},{"start":48.689,"end":50.195,"text":"T' o mu alafia w' aiye.","marked":"T' ó mú àlàáfíà w' aiye."}],"end":50.195}]}