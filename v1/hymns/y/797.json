{"v":1,"coll":"y","num":797,"id":"hymn_797","title":"EMI at'ara ile mi","duration":71.754,"voices":{"male":{"file":"y-797-male.m4a","bytes":522886,"sha256":"ae3e2c19c9d369724d379144e7fdcdf5770b76ead295ff01ed641c5bcf0d6eae","duration":71.8},"female":{"file":"y-797-female.m4a","bytes":547950,"sha256":"fafbf4268a81e90d18d45a1623b17bdc7e5c0897cb2fadd4ae62b1bf8ba28129","duration":71.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.516,"text":"EMI at'ara ile mi","marked":"Èmi àt'ará ilé mi"},{"start":1.896,"end":3.124,"text":"Yio ma sin Oluwa wa","marked":"Yíó má sin Olúwa wa"},{"start":3.504,"end":4.559,"text":"Sugbon emi papa;","marked":"Ṣùgbọ́n ẹ̀mí pápá"},{"start":4.939,"end":6.732,"text":"Yio f'iwa at'oro han","marked":"Yíó f'ìwà àt'ọ̀rọ̀ hàn"},{"start":7.112,"end":8.426,"text":"Pe mo mo Oluwa t'orun","marked":"Pé mo mọ Olúwa t'ọrun"},{"start":8.806,"end":10.053,"text":"Mo nfi toto sin.","marked":"Mo ńfi tọ́tọ́ sìn."}],"end":10.053},{"key":"2","start":11.003,"lines":[{"start":11.003,"end":12.845,"text":"Em'o f'apere 're le 'le","marked":"Em'ó f'apẹ̀rẹ̀ 'rẹ̀ lé 'le"},{"start":13.225,"end":14.732,"text":"Ngo mu idena na kuro","marked":"Ngo mú ìdènà ná kúrò"},{"start":15.112,"end":16.142,"text":"Lodo om'odo mi","marked":"Lọ́dọ̀ om'ọ̀dọ̀ mi"},{"start":16.522,"end":18.446,"text":"Ngo f'ise won han n'iwa mi","marked":"Ngo f'iṣẹ́ wọn hàn n'ìwà mi"},{"start":18.826,"end":20.932,"text":"Sibe n'nu 'se mi ki nsi ni","marked":"Síbẹ̀ ń'nú 'ṣe mí kí ńsì ni"},{"start":21.312,"end":22.749,"text":"Ola na ti ife.","marked":"Ọ̀la na ti ìfẹ́."}],"end":22.749},{"key":"3","start":23.699,"lines":[{"start":23.699,"end":25.203,"text":"Emi ki y'o soro gb'ipe","marked":"Èmi kí y'ó sọ̀rọ̀ gb'ìpẹ́"},{"start":25.583,"end":27.259,"text":"Emi ki y'o pe tu ninu","marked":"Èmi kí y'ó pẹ́ tù nínú"},{"start":27.639,"end":28.596,"text":"Om'ehin Olorun","marked":"Om'ẹ̀hìn Ọlọ́run"},{"start":28.976,"end":30.453,"text":"Mo si fe je eni mimo","marked":"Mo sì fẹ́ jẹ́ ẹni mímọ́́"},{"start":30.833,"end":32.343,"text":"Ki nsi fa gbogbo ile mi","marked":"Kí nsì fa gbogbo ilé mi"},{"start":32.723,"end":33.969,"text":"S'oju ona orun.","marked":"S'ojú ọ̀nà ọ̀run."}],"end":33.969},{"key":"4","start":34.919,"lines":[{"start":34.919,"end":37.545,"text":"Jesu, b'O ba da 'na fe na","marked":"Jésù, b'Ó bá dá 'ná fẹ́ ná"},{"start":37.925,"end":39.26,"text":"Ohun elo t'iwo fe lo","marked":"Ohun èlò t'íwò fẹ́ lọ"},{"start":39.64,"end":40.795,"text":"Gba s'owo ara Re!","marked":"Gba s'ọ́wọ́ ara Rẹ!"},{"start":41.175,"end":42.534,"text":"Sise ife rere n'nu mi","marked":"Ṣíṣe ìfẹ́ rere ń'nú mi"},{"start":42.914,"end":44.634,"text":"Ki nfi b' onigbagbo toto","marked":"Kí nfi b' onígbàgbọ́ tótó"},{"start":45.014,"end":46.179,"text":"Ti ngbe l'aiye han won.","marked":"Ti ngbẹ l'áìyẹ́ hàn wọ́n."}],"end":46.179},{"key":"5","start":47.129,"lines":[{"start":47.129,"end":48.383,"text":"Fun mi l'ore-ofe toto","marked":"Fún mi l'ọ̀rẹ́-ọ̀fẹ́ tótọ́"},{"start":48.763,"end":50.824,"text":"Nje! Emi de lati jeri","marked":"Ǹjẹ́! Èmi dé láti jẹ́ri"},{"start":51.204,"end":52.13,"text":"Yanu oruko Re","marked":"Yanu orúkọ Rẹ"},{"start":52.51,"end":53.72,"text":"Ti o gba mi l'owo egbe","marked":"Tí ó gbà mí l'ọwọ́ ẹgbẹ́"},{"start":54.1,"end":55.773,"text":"Ire eyi t'a mo l'okan","marked":"Irè èyí t'á mọ́ l'ọ́kan"},{"start":56.153,"end":57.397,"text":"Ti gbogb'ahon le so.","marked":"Ti gbogb'ahon lè sọ."}],"end":57.397},{"key":"6","start":58.347,"lines":[{"start":58.347,"end":59.672,"text":"Emi t'o bo lowo ese","marked":"Èmi t'ó bọ́ lọ́wọ́ ẹsẹ̀"},{"start":60.052,"end":61.533,"text":"Mo wa lati gba 'le mi la","marked":"Mo wá láti gbà 'lé mi là"},{"start":61.913,"end":63.05,"text":"Ki nwasu dariji","marked":"Kí ńwàṣù dariji"},{"start":63.43,"end":65.456,"text":"F'omo, f'aya, f'omo-do mi","marked":"F'ọmọ, f'áyà, f'ọmọ-dọ mi"},{"start":65.836,"end":67.498,"text":"Lati mu won to 'na rere","marked":"Láti mú wọn tó 'ná rere"},{"start":67.878,"end":69.174,"text":"Lo si orun mimo.","marked":"Lọ sí ọ̀run mímọ́́."},{"start":69.554,"end":70.204,"text":"Amin.","marked":"Àmín."}],"end":70.204}]}