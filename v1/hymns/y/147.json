{"v":1,"coll":"y","num":147,"id":"hymn_147","title":"GBO orin eni irapada","duration":39.178,"voices":{"male":{"file":"y-147-male.m4a","bytes":277515,"sha256":"6f3bbb87bfd5b37a6ce27f0de79cc7c6f7bb2c385cab742ab30618723640b0b1","duration":39.2},"female":{"file":"y-147-female.m4a","bytes":285595,"sha256":"c885e66f73bd120dc98dae29c8272942de1f719cb84d801cdc7ed361b065b052","duration":39.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.813,"text":"GBO orin eni irapada","marked":"Gbọ́ orin ẹni ìràpadà"},{"start":2.193,"end":3.145,"text":"Orin iyin titun","marked":"Orin ìyìn titun"},{"start":3.525,"end":5.69,"text":"Nwon nyin Odagutan l'ogo","marked":"Nwọ̀n nyin Ọ̀dàgùtàn l'ògò"},{"start":6.07,"end":7.407,"text":"Nwon nkorin na bayi.","marked":"Nwọ̀n nkorin ná báyì."}],"end":7.407},{"key":"CHORUS","start":8.357,"lines":[{"start":8.357,"end":9.587,"text":"Ogo f 'Eni to fe wa,","marked":"Ògo f 'Ẹni tó fẹ́ wá"},{"start":9.967,"end":11.257,"text":"T'o f 'eje Re we wa,","marked":"T'ó f 'ẹ̀jẹ̀ Rẹ̀ wé wa"},{"start":11.637,"end":12.945,"text":"Ti o si so wa di mimo","marked":"Tí ó sì sọ wá di mímọ́́"},{"start":13.325,"end":14.691,"text":"N'nu ibi iye ni.","marked":"N'nu ibi ìyẹ́ ni."}],"end":14.691},{"key":"2","start":15.641,"lines":[{"start":15.641,"end":17.176,"text":"A f'oso wa n'nu eje e,","marked":"A f'ọṣọ wa ń'nú ẹ̀jẹ̀ ẹ̀"},{"start":17.556,"end":18.821,"text":"O si funfun laulau","marked":"Ó sì funfun laulau"},{"start":19.201,"end":20.725,"text":"'Mole t'O tan si okan","marked":"'Mọ́lẹ̀ t'Ó tán sí ọ̀kan"},{"start":21.105,"end":22.257,"text":"Nf' Ipa Oto Re han.","marked":"Nf' Ipa Ọ̀tọ̀ Rẹ hàn."}],"end":22.257},{"key":"3","start":23.207,"lines":[{"start":23.207,"end":25.119,"text":"Nipa agbara Eje Jesu","marked":"Nípa agbára Ẹ̀jẹ̀ Jésù"},{"start":25.499,"end":26.701,"text":"L'a fo 'tegun Esu","marked":"L'á fọ́ 'tẹ́gun Èṣù"},{"start":27.081,"end":28.568,"text":"Nipa agbara Oto Re,","marked":"Nípa agbára Ọ̀tọ̀ Rẹ"},{"start":28.948,"end":30.033,"text":"La se bori ota.","marked":"La ṣe borí ọ̀tá."}],"end":30.033},{"key":"4","start":30.983,"lines":[{"start":30.983,"end":32.331,"text":"Je ka juba Odagutan","marked":"Jẹ́ ká júbà Ọ̀dàgùtàn"},{"start":32.711,"end":33.884,"text":"T'o fun wa ni 'imole","marked":"T'ó fún wa ní 'ìmọ́lẹ̀̀"},{"start":34.264,"end":35.875,"text":"Tire l'ogo at'agbara","marked":"Tírè l'ògo àt'ágbára"},{"start":36.255,"end":37.628,"text":"Olanla at'lpa.","marked":"Ọ̀làǹlà àt'lpa."}],"end":37.628}]}