{"v":1,"coll":"y","num":431,"id":"hymn_431","title":"BA mi soro, Jesu","duration":34.726,"voices":{"male":{"file":"y-431-male.m4a","bytes":232040,"sha256":"a407eab4789464f21692e29d42d7c30b4d7f85001af16c955e3dc238d2687b32","duration":34.8},"female":{"file":"y-431-female.m4a","bytes":246866,"sha256":"a8f2bdb6a9445e938c2b31d39f5dff28c4d3d030b9e7fcd85c121d3c155ec7bc","duration":34.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.421,"text":"BA mi soro, Jesu","marked":"Bá mi sọ̀rọ̀, Jésù"},{"start":2.801,"end":3.919,"text":"Bi mo ti duro","marked":"Bí mo ti dúró"},{"start":4.299,"end":5.421,"text":"Fi okan mi le 'le","marked":"Fi ọkàn mi le 'le"},{"start":5.801,"end":6.773,"text":"Ninu ireti.","marked":"Nínú ìrètí."}],"end":6.773},{"key":"2","start":7.723,"lines":[{"start":7.723,"end":8.708,"text":"Ba mi soro Baba","marked":"Bá mi sọ̀rọ̀ Bàbá"},{"start":9.088,"end":10.229,"text":"Ni wakati yi","marked":"Ní wákàtí yí"},{"start":10.609,"end":11.674,"text":"Je ki nri oju Re","marked":"Jẹ́ kí ńrí ojú Rẹ"},{"start":12.054,"end":13.084,"text":"Nin'olanla Re.","marked":"Nin'olanla Rẹ."}],"end":13.084},{"key":"3","start":14.034,"lines":[{"start":14.034,"end":15.109,"text":"Oro ti O ba so","marked":"Ọ̀rọ̀ tí Ó bá sọ"},{"start":15.489,"end":16.212,"text":"'Oro iye ni","marked":"'Ọ̀rọ̀ ìyè ni"},{"start":16.592,"end":17.487,"text":"Onje orun","marked":"Oǹjẹ ọ̀run"},{"start":17.867,"end":19.203,"text":"Ma bo mi titi.","marked":"Má bọ̀ mí títí."}],"end":19.203},{"key":"4","start":20.153,"lines":[{"start":20.153,"end":21.343,"text":"Tire l'ohun gbogbo","marked":"Tìrẹ l'ohun gbogbo"},{"start":21.723,"end":22.96,"text":"Nki si se t'emi","marked":"Nkí sì ṣe t'èmi"},{"start":23.34,"end":24.586,"text":"Ayo ni mo fi wi","marked":"Ayọ̀ ni mo fi wí"},{"start":24.966,"end":26.224,"text":"Pe, Tire l'emi.","marked":"Pé, Tírè l'èmi."}],"end":26.224},{"key":"5","start":27.174,"lines":[{"start":27.174,"end":28.166,"text":"Fun mi ni imo na","marked":"Fún mi ní ìmọ̀ ná"},{"start":28.546,"end":29.467,"text":"T'ise ogo Re","marked":"T'iṣẹ́ ògo Rẹ"},{"start":29.847,"end":30.657,"text":"Mu gbogbo ileri","marked":"Mú gbogbo ìlérí"},{"start":31.037,"end":32.234,"text":"Re se s'ara mi.","marked":"Rẹ̀ ṣe s'ara mi."},{"start":32.614,"end":33.177,"text":"Amin.","marked":"Àmín."}],"end":33.177}]}