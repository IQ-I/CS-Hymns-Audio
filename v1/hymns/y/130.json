{"v":1,"coll":"y","num":130,"id":"hymn_130","title":"ALLELUYAH! orin t'o dun","duration":50.627,"voices":{"male":{"file":"y-130-male.m4a","bytes":370870,"sha256":"1e9a3b65d9db88000ed4bd2920100908b75cc778839b7f82e545ea7972dffb0d","duration":50.7},"female":{"file":"y-130-female.m4a","bytes":383662,"sha256":"ca09cfb42911b9df86f0c619efc90f3f115357ff158ee3d6b33125787c72a7a9","duration":50.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.919,"text":"ALLELUYAH! orin t'o dun","marked":"Alleluyah! orin t'ó dùn"},{"start":2.299,"end":3.611,"text":"Ohun ayo ti ki ku","marked":"Ohun ayọ̀ tí kì kù"},{"start":3.991,"end":5.673,"text":"Alleluya! orin didun","marked":"Allelúyà! orin dídùn"},{"start":6.053,"end":7.368,"text":"T'awon t'o wa l'orun fe","marked":"T'àwọn t'ó wà l'ọrun fẹ́"},{"start":7.748,"end":9.228,"text":"N'ile ti Olorun mi ngbe","marked":"N'ilẹ̀ tí Ọlọ́run mí ngbe"},{"start":9.608,"end":11.025,"text":"Ni nwon nko tosan-toru.","marked":"Ní nwọn ńkọ́ tọ̀sán-tòru."}],"end":11.025},{"key":"2","start":11.975,"lines":[{"start":11.975,"end":13.724,"text":"Alleluya! ljo orun","marked":"Allelúyà! ljo ọ̀run"},{"start":14.104,"end":15.282,"text":"E le korin ayo na,","marked":"Ẹ lè kọrin ayọ̀ ná"},{"start":15.662,"end":17.215,"text":"Alleluya! orin 'segun","marked":"Allelúyà! orin 'ṣẹ́gun"},{"start":17.595,"end":19.23,"text":"Ye awon t'a rapada","marked":"Yé àwọn t'á ràpadà"},{"start":19.61,"end":21.024,"text":"Awa ero at'alejo","marked":"Àwa èrò àt'àlejò"},{"start":21.404,"end":22.951,"text":"Iyin wa ko nilari.","marked":"Ìyìn wa kò nílárí."}],"end":22.951},{"key":"3","start":23.901,"lines":[{"start":23.901,"end":25.975,"text":"Alleluya! orin ayo","marked":"Allelúyà! orin ayọ̀"},{"start":26.355,"end":27.846,"text":"Lo ye wa nigbagbogbo","marked":"Ló yé wa nígbàgbọ́gbò"},{"start":28.226,"end":29.631,"text":"Alleluya! ohun aro","marked":"Allelúyà! ohùn arò"},{"start":30.011,"end":31.366,"text":"Da mo orin ayo wa;","marked":"Dá mọ́ orin ayọ̀ wa"},{"start":31.746,"end":33.525,"text":"Gbat' a wa laiye osi yi,","marked":"Gbat' á wà láìyẹ òsì yí"},{"start":33.905,"end":35.332,"text":"A ngbawe f'ese wa.","marked":"A ńgbàwé f'ẹsẹ̀ wa."}],"end":35.332},{"key":"4","start":36.282,"lines":[{"start":36.282,"end":37.655,"text":"Iyin dapo m'adua wa;","marked":"Ìyìn dàpọ̀ m'ádùá wa"},{"start":38.035,"end":40.327,"text":"Gbo tiwa, Metalokan!","marked":"Gbọ́ tiwa, Mẹ́talọ́kan!"},{"start":40.707,"end":42.224,"text":"Mu wa de 'waju Re I'ayo","marked":"Mú wa dé 'wájú Rẹ l'àyò"},{"start":42.604,"end":44.22,"text":"K'a r'Odagutan t'a pa","marked":"K'á r'Odagutan t'á pa"},{"start":44.6,"end":45.943,"text":"K'a le ma ko Alleluyah,","marked":"K'á lè má kọ́ Allelúyàh"},{"start":46.323,"end":48.138,"text":"Nibe lai ati lailai.","marked":"Níbẹ̀ láì àti láíláí."},{"start":48.518,"end":49.077,"text":"Amin.","marked":"Àmín."}],"end":49.077}]}