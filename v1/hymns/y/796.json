{"v":1,"coll":"y","num":796,"id":"hymn_796","title":"OJO Imole leyi","duration":72.785,"voices":{"male":{"file":"y-796-male.m4a","bytes":511620,"sha256":"173fa3e73c75d24a0e70f74e833b6daac50e9123b5457b0b3740e15cebae4e68","duration":72.8},"female":{"file":"y-796-female.m4a","bytes":531926,"sha256":"81a98ebe18452c572500b633aba4a6c4f89f58af57fb06a031279adfb6be1589","duration":72.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.789,"text":"OJO 'mole l'eyi","marked":"Ọjọ́ 'mọ́lẹ̀ l'èyí"},{"start":2.169,"end":3.26,"text":"Ki 'mole wa l'oni","marked":"Kí 'mọ́lẹ̀ wa l'ọ́nì"},{"start":3.64,"end":5.395,"text":"Wo Orun, ran s'okunkun wa,","marked":"Wo Orun, ran s'òkùnkùn wa"},{"start":5.775,"end":7.163,"text":"K'o si le oru lo.","marked":"K'ó sì lé òru lọ."}],"end":7.163},{"key":"2","start":8.113,"lines":[{"start":8.113,"end":9.599,"text":"Ojo simi l'eyi","marked":"Ọjọ́ simi l'èyí"},{"start":9.979,"end":11.143,"text":"S'agbara wa d'otun","marked":"S'ágbára wa d'ọ̀tun"},{"start":11.523,"end":13.564,"text":"S'ori aibale aiya wa","marked":"S'orí àìbalẹ̀ aiya wa"},{"start":13.944,"end":15.532,"text":"Seri itura Re.","marked":"Ṣẹ́rí ìtura Rẹ."}],"end":15.532},{"key":"3","start":16.482,"lines":[{"start":16.482,"end":17.338,"text":"Ojo alafia","marked":"Ọjọ́ àlàáfíà"},{"start":17.718,"end":18.852,"text":"F'alafia fun wa","marked":"F'àlàáfíà fún wa"},{"start":19.232,"end":20.95,"text":"Da iyapa gbogbo duro","marked":"Dá ìyapa gbogbo dúró"},{"start":21.33,"end":22.517,"text":"Si mu ija kuro.","marked":"Sì mú ìjà kúrò."}],"end":22.517},{"key":"4","start":23.467,"lines":[{"start":23.467,"end":24.462,"text":"Ojo adura ni","marked":"Ọjọ́ àdúrà ni"},{"start":24.842,"end":26.378,"text":"K'aiye sunmo Orun","marked":"K'aiye súnmọ́ Ọ̀run"},{"start":26.758,"end":28.455,"text":"Gb'okan soke si odo Re","marked":"Gb'okan sókè sí ọ̀dọ̀ Rẹ"},{"start":28.835,"end":30.107,"text":"Si pade wa nihin.","marked":"Sì pàdé wa níhìn."}],"end":30.107},{"key":"5","start":31.057,"lines":[{"start":31.057,"end":32.355,"text":"Oba ojo l'eyi","marked":"Ọba ọjọ́ l'èyí"},{"start":32.735,"end":33.809,"text":"Fun wa ni isoji","marked":"Fún wa ní ìsọjí"},{"start":34.189,"end":35.613,"text":"Ji oku okan wa s'ife","marked":"Jí òkú ọkàn wa s'ife"},{"start":35.993,"end":38.717,"text":"Wo asegun iku.  Amin","marked":"Wo aṣẹ́gun ikú. Àmín"},{"start":39.097,"end":40.245,"text":"------APA Keji------","marked":"Apá Kejì"}],"end":40.245},{"key":"6","start":41.195,"lines":[{"start":41.195,"end":43.08,"text":"KABO! ojo 'simi","marked":"Kábọ̀! ọjọ́ 'simi"},{"start":43.46,"end":44.792,"text":"T'o r'ajinde Jesu","marked":"T'ó r'àjíǹde Jésù"},{"start":45.172,"end":46.824,"text":"Ma bo wa m'okan yi soji","marked":"Má bò wá ḿ'ọ̀kan yí sóji"},{"start":47.204,"end":48.232,"text":"Si mu inu mi dun.","marked":"Sì mú inú mi dùn."}],"end":48.232},{"key":"7","start":49.182,"lines":[{"start":49.182,"end":50.192,"text":"Oba tikare wa","marked":"Ọba tíkàrẹ́ wa"},{"start":50.572,"end":51.706,"text":"Bo ljo Re loni","marked":"Bó ljo Rẹ lónì"},{"start":52.086,"end":53.911,"text":"Nihin l'a wa ti a si ri","marked":"Níhìn l'á wà tí a sì rí"},{"start":54.291,"end":55.976,"text":"A nyin, a gbadura.","marked":"A nyin, a gbàdúrà."}],"end":55.976},{"key":"8","start":56.926,"lines":[{"start":56.926,"end":58.058,"text":"Ojo kan f'adura","marked":"Ọjọ́ kan f'àdúrà"},{"start":58.438,"end":59.542,"text":"N'nu ile mimo Re","marked":"N'nu ilé mímọ́́ Rẹ"},{"start":59.922,"end":61.34,"text":"O san j'egberun ojo lo","marked":"Ó sàn j'ẹgbẹ̀rún ọjọ́ lọ"},{"start":61.72,"end":62.883,"text":"T'a lo f'adun ese.","marked":"T'á lọ f'adùn ẹsẹ̀."}],"end":62.883},{"key":"9","start":63.833,"lines":[{"start":63.833,"end":65.155,"text":"Okan mi y'o f'ayo","marked":"Ọkàn mi y'ó f'ayo"},{"start":65.535,"end":66.702,"text":"Wa n'iru ipo yi","marked":"Wà ń'irú ipò yí"},{"start":67.082,"end":68.429,"text":"Y'o si ma duro de ojo","marked":"Y'ó sì má dúró de ọjọ́"},{"start":68.809,"end":71.235,"text":"Ibukun ailopin.  Amin","marked":"Ìbùkún àìlópin. Àmín"}],"end":71.235}]}