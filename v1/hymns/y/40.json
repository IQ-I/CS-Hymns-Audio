{"v":1,"coll":"y","num":40,"id":"hymn_40","title":"AYO l'ojo 'simi fun mi","duration":36.858,"voices":{"male":{"file":"y-40-male.m4a","bytes":268508,"sha256":"b919d8716f52c09658b46820281714d2baa53d6ef5f902d26bd476ab579c0214","duration":36.9},"female":{"file":"y-40-female.m4a","bytes":276403,"sha256":"023e6a94fd35df14c6114252c7945ead42d436b33743c819225bb2e69624f3b2","duration":36.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.593,"text":"AYO l'ojo 'simi fun mi","marked":"Ayọ̀ l'ọjọ́ 'simi fún mi"},{"start":1.973,"end":3.813,"text":"Ati agogo at'iwasu","marked":"Àti agogo àt'ìwàsù"},{"start":4.193,"end":6.226,"text":"Gbat a ba mi n'nu 'banuje","marked":"Gbat a bá mi ń'nú 'banújẹ́"},{"start":6.606,"end":7.989,"text":"Awon l'o nmu inu mi dun.","marked":"Àwọn l'ó ńmú inú mi dùn."}],"end":7.989},{"key":"2","start":8.939,"lines":[{"start":8.939,"end":10.455,"text":"Ayo si ni wakati na,","marked":"Ayọ̀ sì ni wákàtí ná"},{"start":10.835,"end":12.07,"text":"Ti mo lo n'nu agbala Re,","marked":"Tí mo lọ ń'nú àgbàlá Rẹ"},{"start":12.45,"end":14.135,"text":"Lati mo adun adura","marked":"Láti mọ adùn àdúrà"},{"start":14.515,"end":16.248,"text":"Lati gba manna oro Re.","marked":"Láti gbà mánná ọ̀rọ̀ Rẹ."}],"end":16.248},{"key":"3","start":17.198,"lines":[{"start":17.198,"end":18.494,"text":"Ayo ni idahun 'Amin'","marked":"Ayọ̀ ni ìdáhùn 'Amin'"},{"start":18.874,"end":20.531,"text":"To gba gbogbo ile na kan,","marked":"Tó gba gbogbo ilé ná kan"},{"start":20.911,"end":23.429,"text":"Lekokan l'o ndun t'o nrole","marked":"Lẹ́kọ̀kan l'ó ńdún t'ó ńrọlẹ̀"},{"start":23.809,"end":25.617,"text":"O nkoja lo s'odo Baba.","marked":"Ó ńkọjá lọ s'odo Bàbá."}],"end":25.617},{"key":"4","start":26.567,"lines":[{"start":26.567,"end":27.757,"text":"B'aiye fe f'agbara de mi","marked":"B'aiye fe f'ágbára dé mi"},{"start":28.137,"end":29.613,"text":"Mo ise ijo mefa re;","marked":"Mọ iṣẹ́ ìjọ mẹ́fà rẹ"},{"start":29.993,"end":31.708,"text":"Oluwa, jo tu ide na,","marked":"Olúwa, jọ tú ìdè ná"},{"start":32.088,"end":34.322,"text":"K'O so okan mi d'ominira.","marked":"K'ó sọ ọkàn mi d'òmìnira."},{"start":34.702,"end":35.308,"text":"Amin.","marked":"Àmín."}],"end":35.308}]}