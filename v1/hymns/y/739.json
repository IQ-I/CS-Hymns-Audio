{"v":1,"coll":"y","num":739,"id":"hymn_739","title":"HA! kerubu, e se giri","duration":53.424,"voices":{"male":{"file":"y-739-male.m4a","bytes":373864,"sha256":"a5c47bd8e9f54746ed5c84feb4987c6e91d358c3e4f1d32c2d65526c719ccb11","duration":53.5},"female":{"file":"y-739-female.m4a","bytes":391355,"sha256":"4a1cd6c8c314a825771da03a8ed46b8ad3c105b86a1cabeda364f6f77bab8bb4","duration":53.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.568,"text":"HA! kerubu, e se giri","marked":"Ha! Kérúbù, ẹ ṣe gírí"},{"start":2.948,"end":3.911,"text":"E ma jafara","marked":"Ẹ má jáfara"},{"start":4.291,"end":6.717,"text":"Esu ngbongun l'osan, l'oru","marked":"Èṣù ńgbọ̀ngùn l'ọ̀sán, l'oru"},{"start":7.097,"end":8.453,"text":"O nse lasan ni.","marked":"Ó ńṣe lásán ni."}],"end":8.453},{"key":"CHORUS","start":9.403,"lines":[{"start":9.403,"end":11.112,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":11.492,"end":12.659,"text":"E damure nyin","marked":"Ẹ dámùrè nyin"},{"start":13.039,"end":14.358,"text":"Ka le doju 'ja ko esu","marked":"Ká lè dojú 'jà ko èṣù"},{"start":14.738,"end":15.83,"text":"Ati ogun re.","marked":"Àti ogún rẹ̀."}],"end":15.83},{"key":"2","start":16.78,"lines":[{"start":16.78,"end":18.608,"text":"Ha! Serafu, e se giri","marked":"Ha! Séráfù, ẹ ṣe gírí"},{"start":18.988,"end":20.106,"text":"E ma so'ra nu","marked":"Ẹ má so'ra nù"},{"start":20.486,"end":22.068,"text":"E ma f'aye sile f'esu","marked":"Ẹ má f'áyè sílẹ̀ f'èṣù"},{"start":22.448,"end":23.503,"text":"N'ijakadi nyin.","marked":"N'ìjàkadì nyin."}],"end":23.503},{"key":"3","start":24.453,"lines":[{"start":24.453,"end":25.955,"text":"Enyin Egbe Aladura","marked":"Enyin Ẹgbẹ́ Alàdúrà"},{"start":26.335,"end":27.328,"text":"Ninu Egbe yi","marked":"Nínú Ẹgbẹ́ yí"},{"start":27.708,"end":28.724,"text":"K'Olorun Olodumare","marked":"K'Ọlọ́run Olódùmarè"},{"start":29.104,"end":30.221,"text":"Ma je k'o re nyin.","marked":"Má jẹ k'ó rẹ̀ nyin."}],"end":30.221},{"key":"4","start":31.171,"lines":[{"start":31.171,"end":32.4,"text":"Enyin Om'Egbe Akorin","marked":"Enyin Om'Ẹgbẹ́ Akọrin"},{"start":32.78,"end":33.875,"text":"E t'ohun nyin se","marked":"Ẹ t'óhun nyin ṣe"},{"start":34.255,"end":35.599,"text":"A o korin Halleluyah","marked":"A ò kọrin Hallelúyà"},{"start":35.979,"end":37.215,"text":"Pel' awon t'orun.","marked":"Pel' àwọn t'ọrun."}],"end":37.215},{"key":"5","start":38.165,"lines":[{"start":38.165,"end":40.421,"text":"Gbogbo Egbe, e ho, e yo","marked":"Gbogbo Ẹgbẹ́, ẹ hó, ẹ yó"},{"start":40.801,"end":41.684,"text":"E tesiwaju","marked":"Ẹ tẹ̀síwájú"},{"start":42.064,"end":43.346,"text":"A o segun gbogbo ota,","marked":"A ó ṣẹ́gun gbogbo ọ̀tá"},{"start":43.726,"end":44.683,"text":"Ni oruko Re.","marked":"Ní orúkọ Rẹ."}],"end":44.683},{"key":"6","start":45.633,"lines":[{"start":45.633,"end":47.033,"text":"Ogo ni fun Baba loke","marked":"Ògo ni fún Bàbá lókè"},{"start":47.413,"end":48.382,"text":"Ogo ni f'Omo","marked":"Ògo ni f'Ọmọ"},{"start":48.762,"end":50.09,"text":"Ogo ni fun Emi-Mimo","marked":"Ògo ni fún Ẹ̀mí-Mímọ́"},{"start":50.47,"end":51.874,"text":"Lai ati lailai.","marked":"Láì àti láíláí."}],"end":51.874}]}