{"v":1,"coll":"y","num":222,"id":"hymn_222","title":"OLORUN at' ireti mi","duration":24.757,"voices":{"male":{"file":"y-222-male.m4a","bytes":173108,"sha256":"e85c163c42534135259c410594287cb5d83d590cff6e860fdca04b154a2aa353","duration":24.8},"female":{"file":"y-222-female.m4a","bytes":178518,"sha256":"0c55781de7f12aab8c0eaa3e270d4ca52e349556f5810eb4b2827417d6eab4e9","duration":24.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.81,"text":"OLORUN at' ireti mi","marked":"Ọlọ́run àt' ìrètí mi"},{"start":2.19,"end":3.254,"text":"Oro Re l'onje mi","marked":"Ọ̀rọ̀ Rẹ l'ọ́ńjẹ mi"},{"start":3.634,"end":5.134,"text":"Owo Re gbe mi ro l'ewe","marked":"Ọwọ́ Rẹ gbé mi ró l'ewe"},{"start":5.514,"end":6.67,"text":"Ati l'odomode.","marked":"Àti l'ọ̀dọ́mọdé."}],"end":6.67},{"key":"2","start":7.62,"lines":[{"start":7.62,"end":9.044,"text":"Sibe mo rohun iyanu","marked":"Síbẹ̀ mo róhun ìyanu"},{"start":9.424,"end":10.434,"text":"'O nse ni ododun","marked":"'Ó ńṣe ní ọdọdún"},{"start":10.814,"end":12.266,"text":"Mo fi ojo mi ti o ku","marked":"Mo fi ọjọ́ mi tí ó kú"},{"start":12.646,"end":14.202,"text":"S'iso Tire nikan.","marked":"S'iso Tírè nìkan."}],"end":14.202},{"key":"3","start":15.152,"lines":[{"start":15.152,"end":17.119,"text":"Ma ko mi, nigba'agbara ye","marked":"Má kọ́ mi, nígbà'agbára yé"},{"start":17.499,"end":18.726,"text":"Ti ewu ba bo mi","marked":"Tí ewu bá bò mí"},{"start":19.106,"end":20.62,"text":"Ki ogo Re ran yi mi ka","marked":"Kí ògo Rẹ ràn yí mi ká"},{"start":21.0,"end":22.328,"text":"Nigbati mo ba ku.","marked":"Nígbàtí mo bá kú."},{"start":22.708,"end":23.207,"text":"Amin.","marked":"Àmín."}],"end":23.207}]}