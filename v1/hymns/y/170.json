{"v":1,"coll":"y","num":170,"id":"hymn_170","title":"YIN Oluwa Oba 'wa","duration":62.856,"voices":{"male":{"file":"y-170-male.m4a","bytes":448489,"sha256":"376a9c30e5fe32c4ca2b4a75625ee95fc7de242150733ed3bbe5c52f1a72d81f","duration":62.9},"female":{"file":"y-170-female.m4a","bytes":458171,"sha256":"56706e3d9d3e0a9b99c224f4e1b99adcfcee9b736062c0a6e61c7823b7af2784","duration":62.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.594,"text":"YIN Oluwa Oba 'wa","marked":"Yín Olúwa Ọba 'wa"},{"start":1.974,"end":3.287,"text":"Egbe ohun iyin ga","marked":"Ẹgbẹ́ ohun ìyìn ga"},{"start":3.667,"end":4.647,"text":"Anu re o titi","marked":"Ànú rẹ̀ ò títí"},{"start":5.027,"end":6.319,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":6.319},{"key":"2","start":7.269,"lines":[{"start":7.269,"end":8.957,"text":"Yin Enit' o da orun","marked":"Yin Enit' ó dá ọ̀run"},{"start":9.337,"end":10.562,"text":"Ti o nran l'ojojumo","marked":"Tí ó ńràn l'ojojumo"},{"start":10.942,"end":12.228,"text":"Anu re o wa titi","marked":"Anu rẹ̀ ò wà títí"},{"start":12.608,"end":13.99,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":13.99},{"key":"3","start":14.94,"lines":[{"start":14.94,"end":16.077,"text":"Ati osupa l'oru","marked":"Àti òṣùpá l'oru"},{"start":16.457,"end":17.877,"text":"Ti o ntanmole jeje","marked":"Tí ò ńtànmọ́lẹ̀ jẹ́jẹ́"},{"start":18.257,"end":19.566,"text":"Anu re o wa titi","marked":"Anu rẹ̀ ò wà títí"},{"start":19.946,"end":21.296,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":21.296},{"key":"4","start":22.246,"lines":[{"start":22.246,"end":23.906,"text":"Yin Enit'o nm'ojo ro,","marked":"Yín Enit'ó nm'òjò rọ̀"},{"start":24.286,"end":25.406,"text":"T'o nmu irugbin dagba","marked":"T'ó ńmú irúgbìn dàgbà"},{"start":25.786,"end":27.088,"text":"Anu re o wa titi","marked":"Anu rẹ̀ ò wà títí"},{"start":27.468,"end":28.875,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":28.875},{"key":"5","start":29.825,"lines":[{"start":29.825,"end":31.176,"text":"Enit'o pase fun 'le","marked":"Enit'ó pàṣẹ fún 'lè"},{"start":31.556,"end":33.093,"text":"Lati mu eso po si","marked":"Láti mú èso pọ̀ sí"},{"start":33.473,"end":34.819,"text":"Anu re o wa titi","marked":"Anu rẹ̀ ò wà títí"},{"start":35.199,"end":36.657,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":36.657},{"key":"6","start":37.607,"lines":[{"start":37.607,"end":39.06,"text":"Yin fun ikore oko","marked":"Yín fún ìkórè oko"},{"start":39.44,"end":40.709,"text":"O mu ki a ka wa kun;","marked":"Ó mú kí a kà wá kún"},{"start":41.089,"end":42.587,"text":"Anu re o wa titi","marked":"Anu rẹ̀ ò wà títí"},{"start":42.967,"end":44.377,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":44.377},{"key":"7","start":45.327,"lines":[{"start":45.327,"end":47.292,"text":"Yin f'onje t'o ju yi lo,","marked":"Yín f'ọ́ńjẹ t'ó jù yí lọ"},{"start":47.672,"end":49.012,"text":"Eri 'bukun ailopin","marked":"Ẹ̀rí 'bùkún àìlópin"},{"start":49.392,"end":50.838,"text":"Anu re o wa titi","marked":"Anu rẹ̀ ò wà títí"},{"start":51.218,"end":52.568,"text":"Lododo dajudaju.","marked":"Lódodo dájúdájú."}],"end":52.568},{"key":"8","start":53.518,"lines":[{"start":53.518,"end":54.714,"text":"Ogo f 'Oba olore","marked":"Ògo f 'Ọba ọlọ́rẹ́"},{"start":55.094,"end":56.417,"text":"Ki gbogbo eda gberin","marked":"Kí gbogbo ẹ̀dá gbẹ̀rín"},{"start":56.797,"end":58.114,"text":"Ogo fun Baba, Omo","marked":"Ògo fún Bàbá, Ọmọ"},{"start":58.494,"end":60.407,"text":"At' Emi: Metalokan.","marked":"Àt' Èmi: Mẹ́talọ́kan."},{"start":60.787,"end":61.306,"text":"Amin.","marked":"Àmín."}],"end":61.306}]}