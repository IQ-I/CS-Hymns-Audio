{"v":1,"coll":"y","num":837,"id":"hymn_837","title":"JESU fe mi mo mo be","duration":32.724,"voices":{"male":{"file":"y-837-male.m4a","bytes":223220,"sha256":"56ab1912092be89cf478d3a8d08ea2a928d4fdbdbb07f53d8fe4c77ddfa11181","duration":32.8},"female":{"file":"y-837-female.m4a","bytes":234977,"sha256":"6e28e881d689be7046d249865431c193c45bc2fbfae728b0797851882e9a103d","duration":32.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.099,"text":"JESU fe mi, mo mo be","marked":"Jésù fẹ́ mi, mo mọ̀ bẹ́"},{"start":2.479,"end":3.765,"text":"Bibeli l'o so fun mi","marked":"Bíbélì l'ó sọ fún mi"},{"start":4.145,"end":5.292,"text":"Tire l'awon omode","marked":"Tìrẹ l'áwọn ọmọdé"},{"start":5.672,"end":7.278,"text":"Nwon ko lagbara, On ni.","marked":"Nwọn kò lágbára, Ón ni."}],"end":7.278},{"key":"2","start":8.228,"lines":[{"start":8.228,"end":9.497,"text":"Jesu fe mi En'to ku","marked":"Jésù fẹ́ mi Ẹ́ń'tó kú"},{"start":9.877,"end":11.098,"text":"Lati si orun sile","marked":"Láti ṣí ọ̀run sílẹ̀"},{"start":11.478,"end":12.724,"text":"Yio we ese mi nu","marked":"Yíó wẹ ẹsẹ̀ mi nù"},{"start":13.104,"end":14.363,"text":"Jeki omo Re wole.","marked":"Jẹki ọmọ Rẹ wọ́lẹ̀."}],"end":14.363},{"key":"3","start":15.313,"lines":[{"start":15.313,"end":16.699,"text":"Jesu fe mi sibe si","marked":"Jésù fẹ́ mí síbẹ̀ sí"},{"start":17.079,"end":18.357,"text":"Bi emi tile s'aisan","marked":"Bí èmi tilé s'àìsàn"},{"start":18.737,"end":20.179,"text":"Lor'akete aisan ni","marked":"Lọ́r'àkété àìsàn ni"},{"start":20.559,"end":22.21,"text":"Y'o t'ite Re wa so mi.","marked":"Y'ó t'ìtẹ̀ Rẹ̀ wá sọ mí."}],"end":22.21},{"key":"4","start":23.16,"lines":[{"start":23.16,"end":25.185,"text":"Jesu fe mi, y'o duro","marked":"Jésù fẹ́ mi, y'ó dúró"},{"start":25.565,"end":26.715,"text":"Ti mi ni gbogb'ona mi","marked":"Tì mí ní gbogb'ona mi"},{"start":27.095,"end":28.553,"text":"Gba mba f'aiye yi sile","marked":"Gbà mba f'aiye yí sílẹ̀"},{"start":28.933,"end":30.148,"text":"Y'o mu mi re 'le orun.","marked":"Y'ó mú mi rẹ̀ 'lé ọ̀run."},{"start":30.528,"end":31.174,"text":"Amin.","marked":"Àmín."}],"end":31.174}]}