{"v":1,"coll":"y","num":263,"id":"hymn_263","title":"PADA asako s'ile re","duration":29.219,"voices":{"male":{"file":"y-263-male.m4a","bytes":208405,"sha256":"caaf4ef077a20d39a0593cad1fbb46f3ff8c349cad3c814956bdfe88a0311a2d","duration":29.3},"female":{"file":"y-263-female.m4a","bytes":215053,"sha256":"fa8825d1373556e16781f011bf16d322a6616805fed3dbedb82ac29dc1e83eb8","duration":29.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.825,"text":"PADA asako s'ile re","marked":"Padà àṣàkò s'ilé rẹ"},{"start":2.205,"end":3.215,"text":"Baba re l'o npe o","marked":"Bàbá rẹ l'ó ńpẹ́ o"},{"start":3.595,"end":5.057,"text":"Mase alarinkiri mo","marked":"Masẹ̀ alárìnkiri mọ́"},{"start":5.437,"end":6.824,"text":"Nin'ese at'osi","marked":"Nín'ẹsẹ̀ àt'òsì"},{"start":7.204,"end":8.411,"text":"Pada, pada.","marked":"Padà, padà."}],"end":8.411},{"key":"2","start":9.361,"lines":[{"start":9.361,"end":10.922,"text":"Pada asako s'ile re","marked":"Padà àṣàkò s'ilé rẹ"},{"start":11.302,"end":12.795,"text":"Jesu l'o sa npe o","marked":"Jésù l'ó sá ńpẹ́ o"},{"start":13.175,"end":14.711,"text":"Emi pelu ljo si npe","marked":"Èmi pẹ̀lú ljọ sí ńpè"},{"start":15.091,"end":16.411,"text":"Yara sa asala","marked":"Yàrá sá àsálà"},{"start":16.791,"end":17.629,"text":"Pada, pada.","marked":"Padà, padà."}],"end":17.629},{"key":"3","start":18.579,"lines":[{"start":18.579,"end":19.94,"text":"Pada asako s'ile re","marked":"Padà àṣàkò s'ilé rẹ"},{"start":20.32,"end":22.214,"text":"Were ni, b'o ba pe","marked":"Wẹ́rẹ́ ni, b'ó bá pẹ́"},{"start":22.594,"end":24.105,"text":"Ko si 'dariji n'iboji","marked":"Kò sí 'dáríjì ń'íbòji"},{"start":24.485,"end":25.399,"text":"Ojo anu kuru","marked":"Ọjọ́ ànu kúrú"},{"start":25.779,"end":26.783,"text":"Pada, pada.","marked":"Padà, padà."},{"start":27.163,"end":27.669,"text":"Amin.","marked":"Àmín."}],"end":27.669}]}