{"v":1,"coll":"y","num":850,"id":"hymn_850","title":"EGBE awon angeli","duration":84.255,"voices":{"male":{"file":"y-850-male.m4a","bytes":617068,"sha256":"99144695f25f378ac86088e623ec527467ed6d784f76b1ae0304bc5a539fe379","duration":84.3},"female":{"file":"y-850-female.m4a","bytes":637129,"sha256":"9fb9db86cc02f4f1e5eafe8cf560620b76c37fd4c51d13edc220adf8b0e4da62","duration":84.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.554,"text":"EGBE awon angeli","marked":"Ẹgbẹ́ àwọn áńgẹ́lì"},{"start":1.934,"end":3.004,"text":"Egbe ogun orun","marked":"Ẹgbẹ́ ogun ọ̀run"},{"start":3.384,"end":4.862,"text":"Egbe awon Aposteli","marked":"Ẹgbẹ́ àwọn Aposteli"},{"start":5.242,"end":6.094,"text":"Awon Eni-Mimo","marked":"Àwọn Ẹni-Mímọ́"},{"start":6.474,"end":7.627,"text":"Gbogbo won loke orun","marked":"Gbogbo wọn lókè ọ̀run"},{"start":8.007,"end":9.283,"text":"Nyin O tosan-toru","marked":"Nyin O tọ̀sán-tòru"},{"start":9.663,"end":10.822,"text":"Olorun Metalokan wa","marked":"Ọlọ́run Mẹ́talọ́kan wa"},{"start":11.202,"end":12.384,"text":"Oga-Ogo julo.","marked":"Ọ̀gá-Ògo jùlọ."}],"end":12.384},{"key":"2","start":13.334,"lines":[{"start":13.334,"end":14.713,"text":"Legbegbe l'awa pejo","marked":"Lẹ́gbẹ́gbẹ́ l'áwà péjọ"},{"start":15.093,"end":16.581,"text":"Niwaju Re, Baba","marked":"Níwájú Rẹ, Bàbá"},{"start":16.961,"end":18.371,"text":"Lati fi ope wa fun O","marked":"Láti fi ọpẹ́ wà fún Ọ"},{"start":18.751,"end":19.665,"text":"Pel' awon ore wa","marked":"Pel' àwọn ọ̀rẹ́ wa"},{"start":20.045,"end":21.277,"text":"Ope 'kore l'a mu wa","marked":"Ọpẹ́ 'kórè l'á mú wá"},{"start":21.657,"end":22.711,"text":"F'Oluwa ikore","marked":"F'Olúwa ìkórè"},{"start":23.091,"end":24.758,"text":"Olorun, jo sokale wa","marked":"Ọlọ́run, jọ sọ̀kalẹ̀ wa"},{"start":25.138,"end":26.579,"text":"F'ogo Re kun 'le yi.","marked":"F'ògo Rẹ kún 'lé yí."}],"end":26.579},{"key":"3","start":27.529,"lines":[{"start":27.529,"end":28.661,"text":"Larin ainiye ibi","marked":"Lárin àìníye ibi"},{"start":29.041,"end":30.376,"text":"T'o rogba yi wa ka","marked":"T'ó rọ̀gbà yí wa ká"},{"start":30.756,"end":32.498,"text":"Larin ayida aiye yi","marked":"Lárin àyídà aiye yi"},{"start":32.878,"end":33.841,"text":"Lehin 'kore esi","marked":"Lẹ́hìn 'kórè èsì"},{"start":34.221,"end":35.377,"text":"Awa f'ope fun O","marked":"Àwa f'ọpẹ́ fún Ọ"},{"start":35.757,"end":37.12,"text":"N'tori 'Wo da wa si","marked":"N'torí 'Wo dá wa sí"},{"start":37.5,"end":39.055,"text":"Loni, odun ikore wa","marked":"Lọ́ni, ọdún ìkórè wà"},{"start":39.435,"end":40.672,"text":"A f'ogo f'Oko Re.","marked":"A f'ògò f'Ọkọ Rẹ̀."}],"end":40.672},{"key":"4","start":41.622,"lines":[{"start":41.622,"end":42.798,"text":"Gba Noa rubo ope","marked":"Gba Nóà rúbọ ọpẹ́"},{"start":43.178,"end":44.444,"text":"Wo f'osumare han","marked":"Wo f'òṣùmàrè hàn"},{"start":44.824,"end":46.186,"text":"Ami wi pe kikun omi","marked":"Àmì wí pé kíkún omi"},{"start":46.566,"end":47.535,"text":"Ki o bo aiye mo","marked":"Kí ó bo àìyẹ́ mọ́"},{"start":47.915,"end":49.123,"text":"Baba f'osumare han","marked":"Bàbá f'òṣùmàrè hàn"},{"start":49.503,"end":50.501,"text":"Nitori Jesu wa","marked":"Nítorí Jésù wà"},{"start":50.881,"end":52.087,"text":"K'iponju on ibanuje","marked":"K'ìpọ́njú on ìbànújẹ́"},{"start":52.467,"end":53.755,"text":"Mase tun de da wa.","marked":"Masẹ̀ tún dé dá wa."}],"end":53.755},{"key":"5","start":54.705,"lines":[{"start":54.705,"end":55.831,"text":"Obinrin opo 'gbani","marked":"Obìnrin opó 'gbani"},{"start":56.211,"end":57.264,"text":"Ko ri pupo mu wa","marked":"Kò rí púpọ̀ mú wa"},{"start":57.644,"end":59.101,"text":"Sugbon o ri ibukun gba","marked":"Ṣùgbọ́n ó rí ìbùkún gbà"},{"start":59.481,"end":61.031,"text":"Fun iwon ti o le se","marked":"Fún ìwọ̀n tí o lè ṣe"},{"start":61.411,"end":63.382,"text":"Jesu, yin wa loni","marked":"Jésù, yìn wá lónì"},{"start":63.762,"end":65.114,"text":"Je k'a ri 'bukun gba","marked":"Jẹ k'á rí 'bùkún gbà"},{"start":65.494,"end":66.696,"text":"Tewogba ore ope wa","marked":"Tẹ́wọ́gba ọrẹ ọpẹ́ wa"},{"start":67.076,"end":68.359,"text":"B'otile s'alaiye.","marked":"B'otile s'aláìyé."}],"end":68.359},{"key":"6","start":69.309,"lines":[{"start":69.309,"end":70.71,"text":"Awa mbe O, Olorun","marked":"Àwa ḿbẹ Ọ́, Ọlọ́run"},{"start":71.09,"end":72.097,"text":"Gba okan wa pelu","marked":"Gba ọkàn wa pẹ̀lú"},{"start":72.477,"end":73.918,"text":"Okan ese wa la mu wa","marked":"Ọkàn ẹsẹ̀ wa la mú wá"},{"start":74.298,"end":75.343,"text":"Egbin po ninu re","marked":"Ẹ̀gbin pọ̀ nínú rẹ̀"},{"start":75.723,"end":77.032,"text":"F'Eje Re mimo Jesu","marked":"F'Ẹ̀jẹ̀ Rẹ mímọ́́ Jésù"},{"start":77.412,"end":78.447,"text":"We abawon re nu","marked":"Wẹ àbàwọ́n rẹ̀ nù"},{"start":78.827,"end":80.145,"text":"Ki okan ati ore wa","marked":"Kí ọkàn àti ọ̀rẹ́ wa"},{"start":80.525,"end":81.748,"text":"J'ebo ope fun o.","marked":"J'ẹbọ ọpẹ́ fún ọ."},{"start":82.128,"end":82.705,"text":"Amin.","marked":"Àmín."}],"end":82.705}]}