{"v":1,"coll":"y","num":376,"id":"hymn_376","title":"TANI o gbe Jakob dide","duration":34.51,"voices":{"male":{"file":"y-376-male.m4a","bytes":246969,"sha256":"17ac281b2174f99990903455ae11c04f7f504d2d48009b728238d2cc21abf1eb","duration":34.6},"female":{"file":"y-376-female.m4a","bytes":253475,"sha256":"6ca572571b32e572844d013c548f36eb2d546ff6b5cbb565ce9c6909f032d65d","duration":34.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.284,"text":"TANI o gbe Jakob dide","marked":"Tani ó gbé Jakob dìde"},{"start":2.664,"end":3.919,"text":"Ore Jakob ko po;","marked":"Ọ̀rẹ́ Jakob kò pọ̀"},{"start":4.299,"end":6.091,"text":"Eyi t'o je 'yanu ni pe","marked":"Èyí t'ó jẹ́ 'yanu ni pé"},{"start":6.471,"end":7.782,"text":"lmo won ko s'okan.","marked":"lmó wọn kò s'ọ̀kan."}],"end":7.782},{"key":"2","start":8.732,"lines":[{"start":8.732,"end":10.722,"text":"Tani o gbe Jakob dide","marked":"Tani ó gbé Jakob dìde"},{"start":11.102,"end":12.536,"text":"Ota Jakob nipa","marked":"Ọ̀tá Jakob nípa"},{"start":12.916,"end":14.774,"text":"Mo r'ayo 'segun loju won","marked":"Mo r'àyò 'ṣẹ́gun lójú wọn"},{"start":15.154,"end":16.908,"text":"Nwon ni, o pari fun.","marked":"Nwọ̀n ni, ó parí fún."}],"end":16.908},{"key":"3","start":17.858,"lines":[{"start":17.858,"end":19.877,"text":"Tani o gbe Jakob dide","marked":"Tani ó gbé Jakob dìde"},{"start":20.257,"end":21.472,"text":"A ha r'eni le wi?","marked":"A ha r'ẹni lè wí?"},{"start":21.852,"end":23.322,"text":"E ka to ro nibule yi","marked":"Ẹ ká tó rò níbùlẹ̀ yí"},{"start":23.702,"end":24.761,"text":"O ha tun le ye mo?","marked":"Ó ha tún lè yé mọ́?"}],"end":24.761},{"key":"4","start":25.711,"lines":[{"start":25.711,"end":27.532,"text":"Oluwa mi, ise Re ni!","marked":"Olúwa mi, iṣẹ́ Rẹ ni!"},{"start":27.912,"end":29.515,"text":"Ko s'eniti o le se","marked":"Kò s'énítì ò lè ṣe"},{"start":29.895,"end":31.475,"text":"Se b'iri s'ori Jakobu,","marked":"Ṣe b'ìrì s'orí Jákọ́bù"},{"start":31.855,"end":32.96,"text":"On yio si tun ye.","marked":"Ọ̀n yio sì tún yé."}],"end":32.96}]}