{"v":1,"coll":"y","num":233,"id":"hymn_233","title":"ESE won ti da to","duration":40.728,"voices":{"male":{"file":"y-233-male.m4a","bytes":292859,"sha256":"1eeb36e0c9f1b62277edae3c67a2593f7998223f61cdcbe39bbcb1e76077d722","duration":40.8},"female":{"file":"y-233-female.m4a","bytes":292979,"sha256":"dca4687ee4106a1225cb28d0f1194fdb9385860a0bdcb3427e62f4a007e607bf","duration":40.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.862,"text":"ESE won ti da to","marked":"Ẹ̀ṣẹ̀ wọn ti dá tó"},{"start":2.242,"end":3.234,"text":"Ti nduro ni Sion","marked":"Ti ńdúró ní Sion"},{"start":3.614,"end":5.199,"text":"Awon t'o mu 'hin gbala wa","marked":"Àwọn t'ó mú 'hìn gbala wá"},{"start":5.579,"end":7.042,"text":"Awon t'o f'ayo han.","marked":"Àwọn t'ó f'ayò hàn."}],"end":7.042},{"key":"2","start":7.992,"lines":[{"start":7.992,"end":9.061,"text":"Ohun won ti wo to","marked":"Ohùn wọn ti wọ́ tó"},{"start":9.441,"end":10.861,"text":"Ihin na ti dun to","marked":"Ìhìn ná ti dùn tó"},{"start":11.241,"end":13.07,"text":"Sion, w'Olorun Oba re","marked":"Síọn, w'Ọlọ́run Ọba rẹ"},{"start":13.45,"end":14.61,"text":"B'o ti segun nihin.","marked":"B'ó ti ṣẹ́gun níhìn."}],"end":14.61},{"key":"3","start":15.56,"lines":[{"start":15.56,"end":16.693,"text":"Eti wa ti yo to","marked":"Etí wa ti yọ́ tó"},{"start":17.073,"end":18.142,"text":"Lati gboro ayo","marked":"Láti gbọ́rọ̀ ayọ̀"},{"start":18.522,"end":20.266,"text":"Woli, Oba, ti duro de","marked":"Wòlí, Ọba, ti dúró dè"},{"start":20.646,"end":22.519,"text":"Nwon wa, nwon ko siri.","marked":"Nwọ̀n wa, nwọn kò sírí."}],"end":22.519},{"key":"4","start":23.469,"lines":[{"start":23.469,"end":24.561,"text":"Oju wa ti yo to","marked":"Ojú wa ti yọ tó"},{"start":24.941,"end":26.087,"text":"To ri 'mole orun","marked":"Tó rí 'mọ́lẹ̀ ọ̀run"},{"start":26.467,"end":29.027,"text":"Oba, Woli, nwon wa titi","marked":"Ọba, Wòlí, nwọn wà títí"},{"start":29.407,"end":31.349,"text":"Nwon si ku, nwon ko ri.","marked":"Nwọ̀n sì kú, nwọn kò rí."}],"end":31.349},{"key":"5","start":32.299,"lines":[{"start":32.299,"end":33.771,"text":"Oluwa, f'ipa han","marked":"Olúwa, f'ipa hàn"},{"start":34.151,"end":35.245,"text":"Lori gbogbo aiye","marked":"Lórí gbogbo aiye"},{"start":35.625,"end":36.769,"text":"Ki gbogbo orile ede","marked":"Kí gbogbo orílẹ̀ èdè"},{"start":37.149,"end":38.238,"text":"W'Oba Olorun won.","marked":"W'Ọba Ọlọ́run wọn."},{"start":38.618,"end":39.178,"text":"Amin.","marked":"Àmín."}],"end":39.178}]}