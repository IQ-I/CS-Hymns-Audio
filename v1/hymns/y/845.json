{"v":1,"coll":"y","num":845,"id":"hymn_845","title":"OLORUN to fe Abraham","duration":91.793,"voices":{"male":{"file":"y-845-male.m4a","bytes":672830,"sha256":"a9d89ef60d577e1f31a511bfd9bf4483f42d9745d60a522bcefd95f5ff41ab01","duration":91.8},"female":{"file":"y-845-female.m4a","bytes":703292,"sha256":"ead02fc0a6c96742b352935fae1b5a0617c8704aafcb80eefe4a6a26d0a95f6e","duration":91.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.76,"text":"OLORUN to fe Abraham","marked":"Ọlọ́run tó fẹ́ Abraham"},{"start":2.14,"end":3.377,"text":"To fi se ore re","marked":"Tó fi ṣe ọ̀rẹ́ rẹ"},{"start":3.757,"end":4.991,"text":"Pe ni 'ru omo re laiye","marked":"Pé ní 'ru ọmọ rẹ láìyẹ"},{"start":5.371,"end":6.39,"text":"Yio dabi irawo","marked":"Yíó dàbí ìràwọ̀"},{"start":6.77,"end":8.296,"text":"O fi Isaaki seleri","marked":"Ó fi Ísáákì ṣèlérí"},{"start":8.676,"end":10.044,"text":"Lati gba ile na","marked":"Láti gba ilé ná"},{"start":10.424,"end":11.977,"text":"O mu ileri na se fun.","marked":"Ó mú ìlérí ná ṣẹ fún."},{"start":12.357,"end":13.497,"text":"Jakobu omo re.","marked":"Jákọ́bù ọmọ rẹ̀."}],"end":13.497},{"key":"CHORUS","start":14.447,"lines":[{"start":14.447,"end":16.102,"text":"K'a damure lati jagun - 2ce","marked":"K'á dámùrè láti jagun"},{"start":16.482,"end":17.489,"text":"K'a damure e, - 2ce","marked":"K'á dámùrè ẹ̀"},{"start":17.869,"end":19.667,"text":"K'a damure lati jagun.","marked":"K'á dámùrè láti jagun."}],"end":19.667},{"key":"2","start":20.617,"lines":[{"start":20.617,"end":22.473,"text":"Iwo to gbo ti Mosisi","marked":"Ìwọ tó gbọ́ ti Mòsísì"},{"start":22.853,"end":24.042,"text":"Lori oke Sinai","marked":"Lórí òkè Sínáì"},{"start":24.422,"end":25.613,"text":"Iwo to pe Samueli","marked":"Ìwọ tó pe Sámúẹ́lì"},{"start":25.993,"end":27.258,"text":"Nigbat' o wa lewe","marked":"Nígbàt' ó wà léwe"},{"start":27.638,"end":29.069,"text":"Iwo to pelu Dafidi","marked":"Ìwọ tó pẹ̀lú Dáfídì"},{"start":29.449,"end":30.609,"text":"T'o segun Golayat","marked":"T'ó ṣẹ́gun Golayat"},{"start":30.989,"end":32.446,"text":"E wa di Egbe Serafu","marked":"Ẹ wá di Ẹgbẹ́ Séráfù"},{"start":32.826,"end":33.989,"text":"Lamure ododo.","marked":"Lámùrè òdodo."}],"end":33.989},{"key":"3","start":34.939,"lines":[{"start":34.939,"end":36.512,"text":"Gbo ti Jesu Oluwa wa","marked":"Gbọ́ tí Jésù Olúwa wa"},{"start":36.892,"end":37.91,"text":"Ti se ileri fun","marked":"Ti ṣe ìlérí fún"},{"start":38.29,"end":39.715,"text":"Awon Aposteli gbani","marked":"Àwọn Apostélì gbani"},{"start":40.095,"end":41.183,"text":"Lari j'alagbara","marked":"Lárí j'alágbára"},{"start":41.563,"end":42.913,"text":"Nigba nwon gba Emi Mimo","marked":"Nígbà nwọn gba Ẹ̀mí Mímọ́́"},{"start":43.293,"end":44.725,"text":"Nwon fi ayo sise","marked":"Nwọ̀n fi ayọ̀ ṣiṣẹ́"},{"start":45.105,"end":46.352,"text":"Irapada d'orin fun won","marked":"Ìràpadà d'orin fún wọn"},{"start":46.732,"end":47.912,"text":"Titi d'oke orun.","marked":"Títí d'òkè ọ̀run."}],"end":47.912},{"key":"4","start":48.862,"lines":[{"start":48.862,"end":50.582,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":50.962,"end":52.155,"text":"E damure giri","marked":"Ẹ dámùrè gírí"},{"start":52.535,"end":53.848,"text":"Ki Egbe Aladura","marked":"Kí Ẹgbẹ́ Aládúra"},{"start":54.228,"end":55.38,"text":"Mura lati sise","marked":"Múra láti ṣiṣẹ́"},{"start":55.76,"end":56.94,"text":"Ileri ti Oluwa se","marked":"Ìlérí tí Olúwa ṣe"},{"start":57.32,"end":58.509,"text":"Nipa ti otito","marked":"Nípa ti òtítọ́́"},{"start":58.889,"end":60.423,"text":"K'a ranti a o segun","marked":"K'á rántí a ó ṣẹ́gun"},{"start":60.803,"end":61.889,"text":"Ni ojo ikehin.","marked":"Ní ọjọ́ ìkẹhìn."}],"end":61.889},{"key":"5","start":62.839,"lines":[{"start":62.839,"end":64.147,"text":"Enyin eni irapada","marked":"Enyin ẹni ìràpadà"},{"start":64.527,"end":65.397,"text":"E korin igbala","marked":"Ẹ kọrin ìgbàlà"},{"start":65.777,"end":66.793,"text":"Si eni ti o fe wa","marked":"Sí ẹni tí o fẹ́ wá"},{"start":67.173,"end":68.34,"text":"To f'eje Re ra wa","marked":"Tó f'ẹ̀jẹ̀ Rẹ rà wá"},{"start":68.72,"end":70.021,"text":"Lati oko eru wa","marked":"Láti oko ẹrú wá"},{"start":70.401,"end":71.575,"text":"Lo si ile Kenaani,","marked":"Lọ sí ilẹ̀ Kénáánì"},{"start":71.955,"end":73.206,"text":"Ilu Jerusalemu","marked":"Ìlú Jerúsálẹ́mù"},{"start":73.586,"end":74.833,"text":"Lodo Jesu Oba.","marked":"Lọ́dọ̀ Jésù Ọba."}],"end":74.833},{"key":"6","start":75.783,"lines":[{"start":75.783,"end":77.228,"text":"Eni to ran Mose lowo","marked":"Ẹni tó ran Mósè lọ́wọ́"},{"start":77.608,"end":78.613,"text":"Baba Aladura","marked":"Bàbá Aládúrà"},{"start":78.993,"end":80.664,"text":"Lati se ise Alakoso","marked":"Láti ṣe iṣẹ́ Alákọ̀so"},{"start":81.044,"end":82.989,"text":"Serafu, Kerubu","marked":"Séráfù, Kérúbù"},{"start":83.369,"end":85.028,"text":"Fi 'segun fun de isegun","marked":"Fi 'ṣẹ́gun fún dé ìṣègùn"},{"start":85.408,"end":86.682,"text":"Lati ja ajaye","marked":"Láti ja àjàyè"},{"start":87.062,"end":88.733,"text":"Lati gba ade Ogo na","marked":"Láti gba adé Ògo ná"},{"start":89.113,"end":90.243,"text":"B'awon Woli saju.","marked":"B'àwọn Wòlí ṣajú."}],"end":90.243}]}