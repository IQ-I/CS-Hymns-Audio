{"v":1,"coll":"y","num":270,"id":"hymn_270","title":"JESU Oluf'okan mi","duration":62.932,"voices":{"male":{"file":"y-270-male.m4a","bytes":470945,"sha256":"d3dae289c42f2616b50cdba9bd360bfbda4e7cf6dcf264caf6032588674e7fe7","duration":63.0},"female":{"file":"y-270-female.m4a","bytes":480368,"sha256":"b7f8828503548b8ab1546ef97853215f932e08f8d3087e37a3b8aeb4f9d12c69","duration":63.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.754,"text":"JESU Oluf'okan mi","marked":"Jésù Olùf'ọkàn mi"},{"start":2.134,"end":3.557,"text":"Je ki nsala s'aiya Re","marked":"Jẹ́ kí ńsálà s'áíyá Rẹ"},{"start":3.937,"end":5.121,"text":"Sa t'irumi sunmo mo","marked":"Ṣá t'irumi súnmọ́ mọ́"},{"start":5.501,"end":7.228,"text":"Sa ti iji nfe s'oke","marked":"Ṣá ti ìjì ńfẹ́ s'òkè"},{"start":7.608,"end":9.235,"text":"Pa mi mo, Olugbala","marked":"Pa mí mọ́, Olùgbàlà"},{"start":9.615,"end":11.44,"text":"Tit'iji aiye y'o pin","marked":"Tít'ìjì aiye y'ó pín"},{"start":11.82,"end":13.017,"text":"To mi lo s'ebute Re","marked":"Tó mi lọ s'èbúté Rẹ"},{"start":13.397,"end":14.662,"text":"Nikehin gba okan mi.","marked":"Nikehin gba ọkàn mi."}],"end":14.662},{"key":"2","start":15.612,"lines":[{"start":15.612,"end":17.469,"text":"Abo mi, emi ko ni","marked":"Àbó mi, èmi kọ́ ni"},{"start":17.849,"end":19.122,"text":"Iwo lokan mi ro mo","marked":"Ìwọ lọkàn mi rò mọ́"},{"start":19.502,"end":21.246,"text":"Ma f'emi nikan sile","marked":"Má f'ẹ̀mí nìkan sílẹ̀"},{"start":21.626,"end":23.306,"text":"Gba mi, si tu mi ninu","marked":"Gbà mí, sì tù mí nínú"},{"start":23.686,"end":25.137,"text":"lwo ni mo gbekele","marked":"lwo ni mo gbẹ́kẹ̀lé"},{"start":25.517,"end":26.509,"text":"lwo n'iranlowo mi","marked":"lwo ń'ìrànlọ́wọ́ mi"},{"start":26.889,"end":28.421,"text":"Masai f'iye apa Re","marked":"Masai f'ìyẹ́ apá Rẹ"},{"start":28.801,"end":30.514,"text":"D'abo b'ori aibo mi.","marked":"D'abo b'orí àìbọ́ mi."}],"end":30.514},{"key":"3","start":31.464,"lines":[{"start":31.464,"end":33.409,"text":"Kristi 'Wo nikan ni mo fe","marked":"Kristi 'Wò nìkan ni mo fẹ́"},{"start":33.789,"end":35.662,"text":"N'nu Re, mo r'ohun gbogbo","marked":"N'nú Rẹ̀, mo r'ohun gbogbo"},{"start":36.042,"end":37.553,"text":"Gb'enit'o subu dide","marked":"Gb'enit'ó ṣubú dìde"},{"start":37.933,"end":40.195,"text":"W'alaisan, at'afoju","marked":"W'aláìsàn, àt'afọ́jú"},{"start":40.575,"end":41.861,"text":"Ododo l'oruko Re","marked":"Òdodo l'orukọ Rẹ"},{"start":42.241,"end":43.324,"text":"Alaisododo l'emi","marked":"Aláìṣòdodo l'èmi"},{"start":43.704,"end":44.961,"text":"Mo kun fun ese pupo","marked":"Mo kún fún ẹ̀ṣẹ̀ púpọ̀"},{"start":45.341,"end":46.785,"text":"Iwo kun fun ododo.","marked":"Ìwọ kún fún òdodo."}],"end":46.785},{"key":"4","start":47.735,"lines":[{"start":47.735,"end":48.916,"text":"'Wo l'opo ore-ofe","marked":"'Wò l'ọ́pọ̀ ọrẹ-ọ̀fẹ́"},{"start":49.296,"end":50.468,"text":"Lati fi bor'ese mi","marked":"Láti fi bor'ẹsẹ̀ mi"},{"start":50.848,"end":52.11,"text":"Jeki omi iwosan","marked":"Jẹki omi ìwòsàn"},{"start":52.49,"end":53.786,"text":"We inu okan mi mo;","marked":"Wé inú ọkàn mi mọ́"},{"start":54.166,"end":55.244,"text":"lwo l'orisun iye","marked":"lwo l'orísun ìyè"},{"start":55.624,"end":57.071,"text":"Je ki mbu n'nu Re l'ofe","marked":"Jẹ́ kí ḿbu ń'nú Rẹ l'ọ̀fẹ́"},{"start":57.451,"end":58.765,"text":"Ru jade n'nu okan mi","marked":"Rú jáde ń'nú ọkàn mi"},{"start":59.145,"end":60.432,"text":"Si iye ainipekun.","marked":"Sí ìyè àìnípẹ̀kun."},{"start":60.812,"end":61.382,"text":"Amin.","marked":"Àmín."}],"end":61.382}]}