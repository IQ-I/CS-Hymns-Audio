{"v":1,"coll":"y","num":268,"id":"hymn_268","title":"'WO ti npafo ninu ese","duration":51.808,"voices":{"male":{"file":"y-268-male.m4a","bytes":373773,"sha256":"224008f0ba9c174aa2cad563d9f8766718ceef716b5f1d2e7cfc47c6f60a9fc6","duration":51.9},"female":{"file":"y-268-female.m4a","bytes":388540,"sha256":"5d6cc34362de709ae0e6bdc538cd91b8670397fd6814223ad51817341da876f3","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.007,"text":"'WO ti npafo ninu ese","marked":"'Wo ti ńpafọ́ nínú ẹsẹ"},{"start":2.387,"end":4.056,"text":"Kristi npe o wa sodo Re","marked":"Kristi ńpẹ́ ò wá sọ́dọ̀ Rẹ̀"},{"start":4.436,"end":5.718,"text":"O ti so eru ese re","marked":"Ó ti sọ ẹrù ẹ̀ṣẹ̀ rẹ̀"},{"start":6.098,"end":7.455,"text":"Wa sinu agbo Jesu.","marked":"Wá sínú agbo Jésù."}],"end":7.455},{"key":"CHORUS","start":8.405,"lines":[{"start":8.405,"end":10.273,"text":"Kristi npe o wa sodo Re","marked":"Kristi ńpẹ́ ò wá sọ́dọ̀ Rẹ̀"},{"start":10.653,"end":12.753,"text":"On I' O ni igbala kikun","marked":"On l' Ó ní ìgbàlà kíkún"},{"start":13.133,"end":15.224,"text":"Jesu nduro O nreti re","marked":"Jésù ńdúró Ó ńrètí rẹ̀"},{"start":15.604,"end":17.23,"text":"Wo yio ha ko ipe Re.","marked":"Wò yìó ha kọ ìpè Rẹ̀."}],"end":17.23},{"key":"2","start":18.18,"lines":[{"start":18.18,"end":19.508,"text":"Olugbala wa s'aiye yi","marked":"Olùgbàlà wa s'aiye yi"},{"start":19.888,"end":21.174,"text":"Lati wa ra o pada","marked":"Láti wá rà ọ́ padà"},{"start":21.554,"end":22.942,"text":"Lowo ese ati arun","marked":"Lọ́wọ́ ẹsẹ̀ àti àrùn"},{"start":23.322,"end":24.631,"text":"lgbala wo lo to yi?","marked":"lgbala wo ló tó yí?"}],"end":24.631},{"key":"3","start":25.581,"lines":[{"start":25.581,"end":27.349,"text":"Bo ti wu k'ese re po to","marked":"Bó ti wu k'ẹsẹ̀ rẹ̀ pọ̀ tó"},{"start":27.729,"end":29.579,"text":"Kristi nfe so O di mimo","marked":"Kristi ńfẹ́ sọ Ọ́ di mímọ́́"},{"start":29.959,"end":31.529,"text":"O ti pari 'se gbala yi","marked":"Ó ti parí 'ṣe gbala yí"},{"start":31.909,"end":33.466,"text":"O ku sowo re, ma bo.","marked":"Ó kù sọ́wọ́ rẹ, má bọ́."}],"end":33.466},{"key":"4","start":34.416,"lines":[{"start":34.416,"end":36.118,"text":"Kristi npe o Iati ronu","marked":"Kristi ńpẹ́ o láti ronú"},{"start":36.498,"end":37.639,"text":"Aye mbe sibe fun o","marked":"Ayé ḿbẹ síbẹ̀ fún ọ"},{"start":38.019,"end":39.603,"text":"Wa, mase kiri 'nu ese","marked":"Wá, máse kiri 'nu ẹsẹ̀"},{"start":39.983,"end":41.303,"text":"Aiye ko lere fun o.","marked":"Aiye kò lérè fún ọ."}],"end":41.303},{"key":"5","start":42.253,"lines":[{"start":42.253,"end":44.509,"text":"B'aiye at' esu nde si o","marked":"B'aiye at' esu ńdẹ sí o"},{"start":44.889,"end":45.976,"text":"Ti 'ponju bo o mole","marked":"Ti 'pọ́njú bò ó mọ́lẹ̀"},{"start":46.356,"end":48.389,"text":"Wa si abe abo Kristi","marked":"Wá sí abẹ́ abo Kristi"},{"start":48.769,"end":50.258,"text":"Nibe a o ri isimi.","marked":"Níbẹ̀ a ò rí ìṣímí."}],"end":50.258}]}