{"v":1,"coll":"y","num":437,"id":"hymn_437","title":"ISUN kan wa to kun f'eje","duration":41.003,"voices":{"male":{"file":"y-437-male.m4a","bytes":292006,"sha256":"44e56fa20ca53538def2e8e21baa00e9fbf7c7ee024c4dba1a32299852193eab","duration":41.1},"female":{"file":"y-437-female.m4a","bytes":297262,"sha256":"64310b2675346ba5bce1ca77a699fbe550f968228a941decf780207007088c54","duration":41.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.116,"text":"ISUN kan wa to kun f'eje","marked":"Ìsun kan wà tó kún f'ẹ̀jẹ̀"},{"start":2.496,"end":3.87,"text":"O yo nihan jesu","marked":"Ó yọ níhàn Jésù"},{"start":4.25,"end":5.888,"text":"Elese mokun ninu re","marked":"Ẹlẹ́ṣẹ̀ mókun nínú rẹ̀"},{"start":6.268,"end":7.451,"text":"O bo ninu ebi.","marked":"Ó bọ́ nínú ebi."}],"end":7.451},{"key":"2","start":8.401,"lines":[{"start":8.401,"end":10.218,"text":"'Gba mo f'igbagbo r'isun na","marked":"'Gbà mo f'ìgbàgbọ́́ r'ìsun ná"},{"start":10.598,"end":12.034,"text":"Ti nsan fun ogbe Re","marked":"Ti nṣan fún ọgbẹ́ Rẹ"},{"start":12.414,"end":13.653,"text":"Irapada d'orin fun mi","marked":"Ìràpadà d'orin fún mi"},{"start":14.033,"end":15.372,"text":"Ti ngo ma ko titi.","marked":"Ti ngo má kọ́ títí."}],"end":15.372},{"key":"3","start":16.322,"lines":[{"start":16.322,"end":17.971,"text":"Ninu orin to dun julo","marked":"Nínú orin tó dùn jùlọ"},{"start":18.351,"end":19.484,"text":"L'emi o korin Re","marked":"L'èmi ò kọrin Rẹ"},{"start":19.864,"end":21.338,"text":"Gbat'akololo ahon yi","marked":"Gbat'akọlòlò ahọ́n yí"},{"start":21.718,"end":22.919,"text":"Ba dake n'iboji.","marked":"Bá dákẹ́ ń'íbòji."}],"end":22.919},{"key":"4","start":23.869,"lines":[{"start":23.869,"end":25.831,"text":"Mo gbagbo p'O pese fun mi","marked":"Mo gbàgbọ́ p'Ó pèsè fún mi"},{"start":26.211,"end":27.362,"text":"Bi mo tile saiye","marked":"Bí mo tilẹ̀ ṣàìyẹ́"},{"start":27.742,"end":29.133,"text":"Ebun ofe ta f'eje ra","marked":"Ẹ̀bùn ọ̀fẹ́ ta f'ẹ̀jẹ̀ rà"},{"start":29.513,"end":30.718,"text":"Ati duru wura.","marked":"Àti dùrù wúrà."}],"end":30.718},{"key":"5","start":31.668,"lines":[{"start":31.668,"end":33.216,"text":"Duru t'a tow'Olorun se,","marked":"Dùrù t'á tọw'Ọlọ́run ṣe"},{"start":33.596,"end":34.812,"text":"Ti ko ni baje lai","marked":"Tí kò ní bàjẹ́ láì"},{"start":35.192,"end":36.944,"text":"T'a o ma fi iyin Baba wa","marked":"T'á ò má fi ìyìn Bàbá wa"},{"start":37.324,"end":38.451,"text":"Oruko Re nikan.","marked":"Orúkọ Rẹ nìkan."},{"start":38.831,"end":39.454,"text":"Amin.","marked":"Àmín."}],"end":39.454}]}