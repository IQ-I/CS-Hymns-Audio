{"v":1,"coll":"y","num":129,"id":"hymn_129","title":"YIN Olorun Abraham","duration":41.779,"voices":{"male":{"file":"y-129-male.m4a","bytes":292481,"sha256":"281aca9940b5fe3854ed020b806fb8e5e063f77d7256375101037106c496f4d9","duration":41.8},"female":{"file":"y-129-female.m4a","bytes":304950,"sha256":"6286330e4d135dc98aab0a3bac54cf2a4da07db8e609ece0cbe6bf5106fe094c","duration":41.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.514,"text":"YIN Olorun Abraham","marked":"Yin Ọlọ́run Abraham"},{"start":1.894,"end":3.023,"text":"To gunwa lok'orun","marked":"Tó gúnwà lók'ọ̀run"},{"start":3.403,"end":4.643,"text":"Eni agba aiyeraiye","marked":"Ẹni àgbà aiyérayé"},{"start":5.023,"end":5.916,"text":"Olorun 'fe","marked":"Ọlọ́run 'fẹ́"},{"start":6.296,"end":7.523,"text":"Emi Jehofa nla","marked":"Ẹ̀mí Jèhófà ńlá"},{"start":7.903,"end":9.31,"text":"T'aiye t'orun njewo","marked":"T'aiye t'orun ǹjẹwò"},{"start":9.69,"end":11.029,"text":"Mo yin oruko mimo Re","marked":"Mo yin orúkọ mímọ́́ Rẹ"},{"start":11.409,"end":12.275,"text":"Olubukun.","marked":"Olùbùkún."}],"end":12.275},{"key":"2","start":13.225,"lines":[{"start":13.225,"end":14.371,"text":"B'ipa ara baje","marked":"B'ipa ara bàjẹ́"},{"start":14.751,"end":16.237,"text":"T'aiye t'esu ndena","marked":"T'aiye t'èṣù ndena"},{"start":16.617,"end":18.237,"text":"Ngo dojuko ile Kenaan,","marked":"Ngo dójúkọ ilẹ̀ Kénáán"},{"start":18.617,"end":19.592,"text":"Nip'ase Re.","marked":"Nípasẹ̀ Rẹ."},{"start":19.972,"end":21.151,"text":"Ngo la ibu koja","marked":"Ngo la ìbú kọjá"},{"start":21.531,"end":22.784,"text":"Ngo tejumo Jesu","marked":"Ngo tẹjúmọ́ Jésù"},{"start":23.164,"end":24.865,"text":"Larin aginju to leru","marked":"Lárin aginjù tó lẹ́rù"},{"start":25.245,"end":26.347,"text":"Ngo ma rin lo.","marked":"Ngo má rìn lọ."}],"end":26.347},{"key":"3","start":27.297,"lines":[{"start":27.297,"end":28.796,"text":"S'Olorun Oba l'oke","marked":"S'Ọlọ́run Ọba l'òkè"},{"start":29.176,"end":30.353,"text":"L'olor' Angeli nke","marked":"L'olor' Áńgẹ́lì nke"},{"start":30.733,"end":31.69,"text":"Wipe Mimo Mimo","marked":"Wípé Mímọ́ Mímọ́́"},{"start":32.07,"end":32.862,"text":"Olodumare,","marked":"Olódùmarè"},{"start":33.242,"end":34.458,"text":"Eniti o ti wa,","marked":"Ẹniti ò ti wá"},{"start":34.838,"end":36.274,"text":"Ti yio si wa lailai,","marked":"Ti yío sì wà láíláí"},{"start":36.654,"end":38.039,"text":"Emi Jehovah Baba nla","marked":"Èmi Jehovah Bàbá ńlá"},{"start":38.419,"end":39.431,"text":"Kabiyesi.","marked":"Kàbìyèsí."},{"start":39.811,"end":40.229,"text":"Amin.","marked":"Àmín."}],"end":40.229}]}