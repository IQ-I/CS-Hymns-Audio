{"v":1,"coll":"y","num":820,"id":"hymn_820","title":"EMI l'Olorun ni Baba","duration":62.592,"voices":{"male":{"file":"y-820-male.m4a","bytes":459395,"sha256":"cfc32f1d87d458308b1af31eeaae2a4ce3b43c7a7309ac46432dc19509c3e131","duration":62.6},"female":{"file":"y-820-female.m4a","bytes":478784,"sha256":"067a6c598227a66ab3acfe64d54a34e0485bf9559c5b205f37a4c927b0db920e","duration":62.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.687,"text":"EMI l'Olorun ni Baba","marked":"Èmi l'Ọlọ́run ni Bàbá"},{"start":2.067,"end":3.491,"text":"Iberu ko si fun mi","marked":"Ìbẹ̀rù kò sì fún mi"},{"start":3.871,"end":5.585,"text":"B'o ti wu k'ota k'o gbogun","marked":"B'ó ti wu k'ọta k'ó gbógun"},{"start":5.965,"end":7.385,"text":"Ti Jesu ni yio bori","marked":"Tí Jésù ní yìó borí"},{"start":7.765,"end":9.085,"text":"On l'ore ti ki tan ni","marked":"Ọ̀n l'ọ̀rẹ́ tí kì tán ni"},{"start":9.465,"end":11.225,"text":"Ko ni fi mi sile dandan","marked":"Kò ní fi mí sílẹ̀ dandan"},{"start":11.605,"end":12.951,"text":"Bo ti wu kiji ko le to","marked":"Bó ti wù kìjí kò le tó"},{"start":13.331,"end":14.849,"text":"Yio mu mi gun s'ebute.","marked":"Yíó mú mi gún s'èbúté."}],"end":14.849},{"key":"2","start":15.799,"lines":[{"start":15.799,"end":17.752,"text":"B'ojo nro t'orun nran pelu","marked":"B'ọjọ́ ńrọ́ t'ọrun ńràn pẹ̀lú"},{"start":18.132,"end":20.15,"text":"B'ile nmi t'oke si nyi","marked":"B'ilẹ̀ ńmi t'òkè sí nyi"},{"start":20.53,"end":22.264,"text":"B'ara nsan b'ina njo kikan","marked":"B'ara ńsan b'íná ńjò kíkàn"},{"start":22.644,"end":24.073,"text":"Emi ko je se Jesu","marked":"Èmi kò jẹ́ ṣe Jésù"},{"start":24.453,"end":25.63,"text":"On l'Olugbala aiye","marked":"On l'Olùgbàlà aiye"},{"start":26.01,"end":27.547,"text":"Boya opo eda ko mo","marked":"Bóyá ọ̀pọ̀ ẹ̀dá kò mọ́"},{"start":27.927,"end":29.453,"text":"On ni yio ji wa dide","marked":"On ní yíó jí wa dìde"},{"start":29.833,"end":31.065,"text":"L'ojo 'dajo ikehin.","marked":"L'ọjọ́ 'dájọ́ ìkẹhìn."}],"end":31.065},{"key":"3","start":32.015,"lines":[{"start":32.015,"end":33.746,"text":"Okan mi bale laiye mi","marked":"Ọkàn mi balẹ̀ láìyé mi"},{"start":34.126,"end":35.333,"text":"Mo l'Olorun ni Baba","marked":"Mo l'Ọlọ́run ni Bàbá"},{"start":35.713,"end":37.427,"text":"Ko s'ohun bi to le se mi","marked":"Kò s'óhun bí tó lè ṣe mí"},{"start":37.807,"end":38.809,"text":"Nipa eje omo Re","marked":"Nípa ẹ̀jẹ̀ ọmọ Rẹ"},{"start":39.189,"end":40.698,"text":"Mo wa si bi orisun na","marked":"Mo wá sì bí orísun ná"},{"start":41.078,"end":42.296,"text":"Jo we mi Olugbala mi","marked":"Jọ wé mi Olùgbàlà mi"},{"start":42.676,"end":44.343,"text":"Mase je ki nsako kuro","marked":"Masẹ̀ jẹ́ kí nṣáko kúrò"},{"start":44.723,"end":46.342,"text":"Fa mi jeje sodo Re.","marked":"Fà mí jẹ́jẹ́ sọ́dọ̀ Rẹ."}],"end":46.342},{"key":"4","start":47.292,"lines":[{"start":47.292,"end":48.991,"text":"Di mi mu, di mi mu sinsin","marked":"Di mí mú, dì mí mú ṣinṣin"},{"start":49.371,"end":50.486,"text":"'Nu oko gbala Seraf","marked":"'Nu ọkọ̀ gbàlà Séráf"},{"start":50.866,"end":52.61,"text":"Mase je k'eranko enia","marked":"Masẹ̀ jẹ k'ẹranko enia"},{"start":52.99,"end":54.094,"text":"Ba ise owo mi je","marked":"Bá iṣẹ́ ọwọ́ mi jẹ́"},{"start":54.474,"end":55.673,"text":"Olorun Orimolade","marked":"Ọlọ́run Orímọládé"},{"start":56.053,"end":57.478,"text":"Lo d'Egbe Serafu s'ile","marked":"Lo d'Ẹgbẹ́ Séráfù s'ilẹ̀"},{"start":57.858,"end":59.056,"text":"Mo juba Olorun Re o","marked":"Mo júbà Ọlọ́run Rẹ o"},{"start":59.436,"end":61.042,"text":"K'ona la f'adura mi.","marked":"K'ọ́nà la f'àdúrà mi."}],"end":61.042}]}