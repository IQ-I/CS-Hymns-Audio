{"v":1,"coll":"y","num":440,"id":"hymn_440","title":"IGBAGBO mi wo O","duration":45.625,"voices":{"male":{"file":"y-440-male.m4a","bytes":318884,"sha256":"d2a8df442f2a420ea5291eabeeb38883d8c2929ebe6f6b504557f021eb20dab0","duration":45.7},"female":{"file":"y-440-female.m4a","bytes":336662,"sha256":"c766dd41910a56866e31ff62d61f1ba352d234c67a140e764c518fbac979eb6c","duration":45.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.467,"text":"IGBAGBO mi wo O","marked":"Ìgbàgbọ́́ mi wọ̀ Ọ́"},{"start":1.847,"end":3.207,"text":"Iwo Odagutan,","marked":"Ìwọ Ọ̀dàgùtàn"},{"start":3.587,"end":4.274,"text":"Olugbala,","marked":"Olùgbàlà"},{"start":4.654,"end":5.73,"text":"Jo gbo adura mi","marked":"Jọ gbọ́ àdúrà mi"},{"start":6.11,"end":7.282,"text":"M'ese mi gbogbo lo","marked":"M'ẹsẹ̀ mi gbogbo lọ"},{"start":7.662,"end":8.995,"text":"K'erni lat'oni lo","marked":"K'erni lát'ọ́ni lọ"},{"start":9.375,"end":10.381,"text":"Si je Tire.","marked":"Sì jẹ́ Tírè."}],"end":10.381},{"key":"2","start":11.331,"lines":[{"start":11.331,"end":12.35,"text":"Ki ore-ofe Re","marked":"Kí ọ̀rẹ́-ọ̀fẹ́ Rẹ"},{"start":12.73,"end":13.829,"text":"F'ilera f'okan mi","marked":"F'ìlera f'ọkàn mi"},{"start":14.209,"end":15.147,"text":"Mu mi tara","marked":"Mú mi tara"},{"start":15.527,"end":16.674,"text":"B'Iwo ti ku fun mi","marked":"B'Ìwọ ti kú fún mi"},{"start":17.054,"end":18.3,"text":"A! k'ife mi si O","marked":"A! k'ífẹ́ mí sí O"},{"start":18.68,"end":19.875,"text":"K'o ma gbona titi!","marked":"K'ó má gbóná títí!"},{"start":20.255,"end":21.035,"text":"B'ina iye.","marked":"B'íná ìyè."}],"end":21.035},{"key":"3","start":21.985,"lines":[{"start":21.985,"end":23.288,"text":"Gba mo nrin l'okunkun","marked":"Gbá mọ nrín l'òkùnkùn"},{"start":23.668,"end":24.506,"text":"Ninu ibinuje","marked":"Nínú ìbìnújẹ́"},{"start":24.886,"end":25.96,"text":"S'amona mi","marked":"S'amọ̀nà mi"},{"start":26.34,"end":27.534,"text":"M'okunkun lo loni","marked":"M'òkùnkùn ló lọni"},{"start":27.914,"end":28.921,"text":"Pa 'banuje mi re","marked":"Pa 'banújẹ́ mi rẹ́"},{"start":29.301,"end":30.462,"text":"Ki nma sako kuro","marked":"Kí ńmá ṣáko kúrò"},{"start":30.842,"end":31.673,"text":"Li odo re.","marked":"Lí ọ̀dọ̀ rẹ."}],"end":31.673},{"key":"4","start":32.623,"lines":[{"start":32.623,"end":34.018,"text":"Gbati aiye ba pin","marked":"Gbátí aiye bá pín"},{"start":34.398,"end":35.462,"text":"T'odo tutu iku","marked":"T'ódò tutù ikú"},{"start":35.842,"end":36.753,"text":"Nsan lori mi","marked":"Nsàn lórí mi"},{"start":37.133,"end":38.648,"text":"Jesu, ninu ife","marked":"Jésù, nínú ìfẹ́"},{"start":39.028,"end":40.139,"text":"Mu k'ifoya mi lo","marked":"Mu k'ìfòyà mi lọ"},{"start":40.519,"end":41.667,"text":"Gbe mi d'oke orun","marked":"Gbé mi d'òkè ọ̀run"},{"start":42.047,"end":43.1,"text":"B'okan t'ara.","marked":"B'ọkàn t'ára."},{"start":43.48,"end":44.075,"text":"Amin.","marked":"Àmín."}],"end":44.075}]}