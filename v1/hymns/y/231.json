{"v":1,"coll":"y","num":231,"id":"hymn_231","title":"AWA onigbagbo","duration":80.615,"voices":{"male":{"file":"y-231-male.m4a","bytes":583721,"sha256":"26dd44d38a9745ae785b43f88920557ae80afd2ea21b4565311bfeb294e7ab3f","duration":80.7},"female":{"file":"y-231-female.m4a","bytes":603827,"sha256":"1bf2b00413653c452d4ac3475da6ddb16f8690771c7f15ca8198111bf0de77c0","duration":80.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.4,"text":"AWA onigbagbo","marked":"Àwa onígbàgbọ́"},{"start":1.78,"end":2.938,"text":"T'o wa ninu ese","marked":"T'ó wà nínú ẹsẹ"},{"start":3.318,"end":4.432,"text":"K'a f'ope f'Olorun","marked":"K'á f'ọpẹ́ f'Ọlọ́run"},{"start":4.812,"end":6.131,"text":"To da wa si doni.","marked":"Tó dá wa sí dòní."},{"start":6.511,"end":8.075,"text":"Egbe:  Arakunrin, arabinrin","marked":"Arákùnrin, arábìnrin"},{"start":8.455,"end":10.752,"text":"E ku odun; e ku 'yedun x2","marked":"Ẹ kú ọdún; ẹ kú 'yẹdùn"}],"end":10.752},{"key":"CHORUS","start":11.702,"lines":[{"start":11.702,"end":13.468,"text":"Arakunrin, arabinrin","marked":"Arákùnrin, arábìnrin"},{"start":13.848,"end":16.1,"text":"E ku odun; e ku 'yedun x2","marked":"Ẹ kú ọdún; ẹ kú 'yẹdùn"}],"end":16.1},{"key":"2","start":17.05,"lines":[{"start":17.05,"end":18.898,"text":"Jesu, Oluwa wa","marked":"Jésù, Olúwa wa"},{"start":19.278,"end":20.584,"text":"Emi airi nso wa","marked":"Ẹ̀mí àìrí ǹṣó wà"},{"start":20.964,"end":22.414,"text":"Eni nku lo y'o ye","marked":"Ẹní ńkú ló y'ó yé"},{"start":22.794,"end":24.442,"text":"Alaisan yio dide.","marked":"Aláìsàn yio dìde."},{"start":24.822,"end":26.53,"text":"Egbe:  Arakunrin, arabinrin...","marked":"Arákùnrin, arábìnrin"}],"end":26.53},{"key":"3","start":27.48,"lines":[{"start":27.48,"end":28.614,"text":"Oba Ologo meta","marked":"Ọba Ológo mẹ́ta"},{"start":28.994,"end":29.958,"text":"Eni Metalokan","marked":"Ẹni Mẹ́talọ́kan"},{"start":30.338,"end":31.716,"text":"Gbogb' eda njuba Re","marked":"Gbogb' ẹ̀dá ńjúbà Rẹ"},{"start":32.096,"end":33.444,"text":"Loke ati 'sale.","marked":"Lókè àti 'sàlẹ̀."},{"start":33.824,"end":35.555,"text":"Egbe:  Arakunrin, arabinrin...","marked":"Arákùnrin, arábìnrin"}],"end":35.555},{"key":"4","start":36.505,"lines":[{"start":36.505,"end":37.645,"text":"Odun to koja lo","marked":"Ọdún tó kọjá lọ"},{"start":38.025,"end":39.338,"text":"Ko ni 'gbagbe l'o je","marked":"Kò ní 'gbàgbé l'ó jẹ́"},{"start":39.718,"end":40.891,"text":"Akopo enia","marked":"Àkópọ̀ enia"},{"start":41.271,"end":42.598,"text":"Arun nti won sorun.","marked":"Àrùn ǹtì wọ́n sọ́rùn."},{"start":42.978,"end":44.747,"text":"Egbe:  Arakunrin, arabinrin...","marked":"Arákùnrin, arábìnrin"}],"end":44.747},{"key":"5","start":45.697,"lines":[{"start":45.697,"end":47.153,"text":"Ise ko si lode","marked":"Iṣẹ́ kò sí lóde"},{"start":47.533,"end":48.664,"text":"Oja ko tun la mo","marked":"Ọjà kò tún là mọ́"},{"start":49.044,"end":50.14,"text":"Opo ti sa kuro","marked":"Ọ̀pọ̀ ti sá kúrò"},{"start":50.52,"end":51.736,"text":"Fun 'gbese adako.","marked":"Fún 'gbèsè àdàkọ."},{"start":52.116,"end":53.85,"text":"Egbe:  Arakunrin, arabinrin...","marked":"Arákùnrin, arábìnrin"}],"end":53.85},{"key":"6","start":54.8,"lines":[{"start":54.8,"end":55.9,"text":"Jehovah Jire wa","marked":"Jehovah Jíre wà"},{"start":56.28,"end":57.7,"text":"Yio so wa lodun yi","marked":"Yíó sọ wá lọ́dún yí"},{"start":58.08,"end":59.371,"text":"Jehovah Nissi wa","marked":"Jehovah Nissi wa"},{"start":59.751,"end":60.949,"text":"Ti tele f'enia re.","marked":"Ti tẹ́lẹ̀ f'enia rẹ."},{"start":61.329,"end":62.868,"text":"Egbe:  Arakunrin, arabinrin...","marked":"Arákùnrin, arábìnrin"}],"end":62.868},{"key":"7","start":63.818,"lines":[{"start":63.818,"end":65.084,"text":"Ko seru mo lode","marked":"Kò ṣẹrú mọ́ lóde"},{"start":65.464,"end":66.71,"text":"B'Olorun je tiwa","marked":"B'Ọlọ́run jẹ́ tiwa"},{"start":67.09,"end":68.803,"text":"Amin, Amin, Ase","marked":"Àmín, Àmín, Àṣé"},{"start":69.183,"end":70.879,"text":"Dandan ko le sai se.","marked":"Dandan kó lè ṣàì ṣe."},{"start":71.259,"end":73.03,"text":"Egbe:  Arakunrin, arabinrin","marked":"Arákùnrin, arábìnrin"},{"start":73.41,"end":75.259,"text":"E ku odun; e ku 'yedun","marked":"Ẹ kú ọdún; ẹ kú 'yẹdùn"},{"start":75.639,"end":78.149,"text":"E ku odun; e ku 'yedun.","marked":"Ẹ kú ọdún; ẹ kú 'yẹdùn."},{"start":78.529,"end":79.065,"text":"Amin.","marked":"Àmín."}],"end":79.065}]}