{"v":1,"coll":"y","num":13,"id":"hymn_13","title":"A GBOJU soke si O","duration":26.069,"voices":{"male":{"file":"y-13-male.m4a","bytes":182807,"sha256":"29d7fdc3e93a267ce5e2920a20fc515e1e4c5cbc6dfe285dc8ad69c62905f703","duration":26.1},"female":{"file":"y-13-female.m4a","bytes":189716,"sha256":"a9bfbb5b46baca525e7fa38e4b4d7ab846048eeefb41df30ff173c87a5260436","duration":26.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.524,"text":"A GBOJU soke si O,","marked":"A Gbójú sókè sí Ọ"},{"start":1.904,"end":3.282,"text":"At'owo ati okan,","marked":"Àt'ọwọ́ àti ọkàn"},{"start":3.662,"end":4.845,"text":"Tewo gba adura wa,","marked":"Tẹ́wọ́ gba àdúrà wa"},{"start":5.225,"end":6.724,"text":"B'o tile se ailera.","marked":"B'ó tilẹ̀ ṣe àìlera."}],"end":6.724},{"key":"2","start":7.674,"lines":[{"start":7.674,"end":9.117,"text":"Oluwa, je k'a mo O","marked":"Olúwa, jẹ k'á mọ̀ Ọ́"},{"start":9.497,"end":10.614,"text":"Je k'a mo oruko Re;","marked":"Jẹ k'á mọ orúkọ Rẹ"},{"start":10.994,"end":12.371,"text":"Je k'awa se ife Re,","marked":"Jẹ́ k'áwá ṣe ìfẹ́ Rẹ"},{"start":12.751,"end":14.214,"text":"Bi nwon ti nse Ii orun.","marked":"Bí nwọn ti ńṣe Ii ọ̀run."}],"end":14.214},{"key":"3","start":15.164,"lines":[{"start":15.164,"end":16.611,"text":"Nigbati a sun l'oru","marked":"Nígbàtí a sùn l'oru"},{"start":16.991,"end":19.148,"text":"So wa, k'O duro ti wa","marked":"Sọ wá, k'Ó dúró tì wá"},{"start":19.528,"end":20.64,"text":"Nigbati ile si mo","marked":"Nígbàtí ilé sì mọ́"},{"start":21.02,"end":23.628,"text":"K'a ji, k'a fi iyin fun O.","marked":"K'á jí, k'á fi ìyìn fún O."},{"start":24.008,"end":24.519,"text":"Amin.","marked":"Àmín."}],"end":24.519}]}