{"v":1,"coll":"y","num":27,"id":"hymn_27","title":"GBOGBO enyin ar'a niye","duration":79.543,"voices":{"male":{"file":"y-27-male.m4a","bytes":585955,"sha256":"6b3533adb3e8740884261012a86f8c6e0afdb4a8c377cf5f4689fcf6d095f2b7","duration":79.6},"female":{"file":"y-27-female.m4a","bytes":605046,"sha256":"70ed6e5c1c35730993ddf00dcb3195a653f6ca7d9123990e0e07a4afb1d42531","duration":79.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.684,"text":"GBOGBO enyin ar'a niye","marked":"Gbogbo ènyin ar'á níye"},{"start":2.064,"end":3.389,"text":"To mb' ojo simi je","marked":"Tó mb' ọjọ́ simi jẹ́"},{"start":3.769,"end":5.085,"text":"At' enyin alaigboran","marked":"Àt' ẹnyin aláìgbọràn"},{"start":5.465,"end":6.721,"text":"Ti mb' ojo simi je,","marked":"Ti mb' ọjọ́ simi jẹ́"},{"start":7.101,"end":8.336,"text":"Oluwa ran wa si nyin","marked":"Olúwa rán wa sì nyin"},{"start":8.716,"end":9.893,"text":"Gegeb' alore Re,","marked":"Gegeb' alọ́rẹ Rẹ"},{"start":10.273,"end":11.74,"text":"Lati kede fun araiye","marked":"Láti kéde fún araiye"},{"start":12.12,"end":13.388,"text":"P’ Oluwa mbo Kankan.","marked":"P' Olúwa ḿbò Kankan."}],"end":13.388},{"key":"CHORUS","start":14.338,"lines":[{"start":14.338,"end":15.876,"text":"Enyin Egbe kerubu","marked":"Enyin Ẹgbẹ́ Kérúbù"},{"start":16.256,"end":17.337,"text":"E mase jafara","marked":"Ẹ máṣe jáfara"},{"start":17.717,"end":19.029,"text":"Enyin Egbe Serafu","marked":"Enyin Ẹgbẹ́ Séráfù"},{"start":19.409,"end":20.677,"text":"E d' amure giri","marked":"Ẹ d' àmùrè gírí"}],"end":20.677},{"key":"2","start":21.627,"lines":[{"start":21.627,"end":23.046,"text":"Oluwa binu s' aiye","marked":"Olúwa bínú s' aiye"},{"start":23.426,"end":24.734,"text":"Eda ko Kiyesi","marked":"Ẹ̀dà kò Kíyèsí"},{"start":25.114,"end":26.122,"text":"Awon to ti ni lowo","marked":"Àwọn tó ti ní lọ́wọ́"},{"start":26.502,"end":28.352,"text":"Nwon deni ti ko ni","marked":"Nwọ̀n dẹni tí kò ní"},{"start":28.732,"end":29.886,"text":"Ode 'Badan wa kede","marked":"Òde 'Bádán wa kéde"},{"start":30.266,"end":31.292,"text":"Oro t' Angeli so","marked":"Ọ̀rọ̀ t' Áńgẹ́lì sọ"},{"start":31.672,"end":33.405,"text":"Sugbon kaka k'a yi pada","marked":"Ṣùgbọ́n kàkà k'á yí padà"},{"start":33.785,"end":35.035,"text":"A nri Sinu ese","marked":"A ńrí Sínú ẹ̀ṣẹ̀"}],"end":35.035},{"key":"3","start":35.985,"lines":[{"start":35.985,"end":37.184,"text":"Keferi e yi pada","marked":"Kèfèrí ẹ̀ yí padà"},{"start":37.564,"end":38.947,"text":"At' enyin Imale","marked":"Àt' ẹnyin Ìmàlẹ̀"},{"start":39.327,"end":40.734,"text":"At' awon Onigbagbo","marked":"Àt' àwọn Onígbàgbọ́"},{"start":41.114,"end":42.412,"text":"T' o jebi oro na,","marked":"T' ò jẹ̀bi ọ̀rọ̀ ná"},{"start":42.792,"end":44.205,"text":"E wa ka jo gbadura,","marked":"Ẹ wá ká jọ gbàdúrà"},{"start":44.585,"end":46.131,"text":"K' a be Baba Mimo","marked":"K' a bẹ Bàbá Mímọ́́"},{"start":46.511,"end":48.114,"text":"K' a teriba niwaju Re,","marked":"K' á tẹríbà níwájú Rẹ"},{"start":48.494,"end":49.596,"text":"Yio dariji wa","marked":"Yíó dariji wá"}],"end":49.596},{"key":"4","start":50.546,"lines":[{"start":50.546,"end":51.837,"text":"Alanu ni Oluwa","marked":"Alanu ni Olúwa"},{"start":52.217,"end":53.372,"text":"Eleti gb' aroye","marked":"Elétí gb' àròyé"},{"start":53.752,"end":54.95,"text":"Bi a ba yipada si","marked":"Bí a bá yípadà sí"},{"start":55.33,"end":56.733,"text":"y' o yipada si wa,","marked":"y' ó yípadà sí wa"},{"start":57.113,"end":58.47,"text":"Ka p' ojo Oluwa mo,","marked":"Ká p' ọjọ́ Olúwa mọ́"},{"start":58.85,"end":59.917,"text":"Gege bi ase Re,","marked":"Gẹ́gẹ́ bí àṣẹ Rẹ"},{"start":60.297,"end":62.244,"text":"Y' o si ferese Re l'orun","marked":"Y' ó sì fẹrẹsẹ̀ Rẹ l'ọrun"},{"start":62.624,"end":63.69,"text":"Igba rere yio de","marked":"Ìgbà rere yìó dé"}],"end":63.69},{"key":"5","start":64.64,"lines":[{"start":64.64,"end":66.255,"text":"Nje t’ a ba si pe wa","marked":"Ǹjẹ́ t' á bá sì pè wá"},{"start":66.635,"end":67.764,"text":"Lati faiye sile,","marked":"Láti fàìyẹ̀ sílẹ̀"},{"start":68.144,"end":69.734,"text":"T' a rekoja odo na,","marked":"T' á rékọjá odò ná"},{"start":70.114,"end":71.184,"text":"Odo tutu iku","marked":"Ọ̀dọ́ tutù ikú"},{"start":71.564,"end":72.801,"text":"Olorun Eleda wa","marked":"Ọlọ́run Ẹlẹ́dàá wa"},{"start":73.181,"end":74.461,"text":"Ma je k' oju ti wa","marked":"Má jẹ́ k' ojú tì wá"},{"start":74.841,"end":76.143,"text":"Mu wa d' prun Alafia","marked":"Mú wa d' prun Àlàáfíà"},{"start":76.523,"end":77.993,"text":"K'a ba O gbe titi.","marked":"K'á bá Ọ gbé títí."}],"end":77.993}]}