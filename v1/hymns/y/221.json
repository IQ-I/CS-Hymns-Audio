{"v":1,"coll":"y","num":221,"id":"hymn_221","title":"A ki gbogbo nyin ku odun","duration":69.543,"voices":{"male":{"file":"y-221-male.m4a","bytes":506719,"sha256":"a42aa287de5920b0df2b9588bc48136029be3143073311b362cf0d31fd8f723e","duration":69.6},"female":{"file":"y-221-female.m4a","bytes":519749,"sha256":"9d9c73a55fe35f240585c018818f47e3d584e8f0697bcd019df69c726cf1e1cc","duration":69.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.027,"text":"A ki gbogbo nyin ku odun,","marked":"A ki gbogbo nyin ku ọdún"},{"start":2.407,"end":3.978,"text":"E ku ajoy'odun titun","marked":"Ẹ kú àjọy'ọdún titun"},{"start":4.358,"end":5.853,"text":"E jek'a sope f'Oluwa","marked":"Ẹ jẹ́k'á ṣọpẹ́ f'Olúwa"},{"start":6.233,"end":8.347,"text":"T'o da Emi wa si d'oni.","marked":"T'ó da Èmi wa sí d'òní."}],"end":8.347},{"key":"2","start":9.297,"lines":[{"start":9.297,"end":10.791,"text":"Opo omode at'agba","marked":"Ọ̀pọ̀ ọmọdé àt'àgbà"},{"start":11.171,"end":12.686,"text":"T'o ti ngbo 'mura ajodun yi,","marked":"T'ó ti ńgbọ́ 'múra àjọ̀dún yí"},{"start":13.066,"end":14.548,"text":"Opolopo ti koja lo","marked":"Ọ̀pọ̀lọpọ̀ ti kọjá lọ"},{"start":14.928,"end":16.421,"text":"Won ti file bora b'aso.","marked":"Wọ́n ti filé bora b'aso."}],"end":16.421},{"key":"3","start":17.371,"lines":[{"start":17.371,"end":18.944,"text":"Egbe agba alatunse","marked":"Ẹgbẹ́ àgbà alátúnṣe"},{"start":19.324,"end":20.828,"text":"E ku atunse egbe na","marked":"Ẹ kú àtúnṣe ẹgbẹ́ ná"},{"start":21.208,"end":22.457,"text":"Baba orun yio pelu nyin","marked":"Bàbá ọ̀run yio pẹ̀lú nyin"},{"start":22.837,"end":24.227,"text":"Yio fi nyin s'agba kale.","marked":"Yíó fi nyin s'ágbà kalẹ̀."}],"end":24.227},{"key":"4","start":25.177,"lines":[{"start":25.177,"end":26.59,"text":"A ki Bale p'e ku odun","marked":"A kí Bale p'ẹ́ kú ọdún"},{"start":26.97,"end":28.593,"text":"Ati gbogb' awon ljoye","marked":"Àti gbogb' àwọn ljoye"},{"start":28.973,"end":30.577,"text":"E ku itoju ilu yi","marked":"Ẹ kú ìtọ́jú ìlú yí"},{"start":30.957,"end":32.502,"text":"Oluwa yio ran yin lowo.","marked":"Olúwa yio ràn yín lọ́wọ́."}],"end":32.502},{"key":"5","start":33.452,"lines":[{"start":33.452,"end":35.094,"text":"Mase foiya onigbagbo","marked":"Masẹ̀ fòiya onígbàgbọ́"},{"start":35.474,"end":37.307,"text":"Jesu yio pese l'odun yi","marked":"Jésù yìó pèsè l'ọdún yí"},{"start":37.687,"end":39.675,"text":"Eni ko bi, iyen a bi","marked":"Ẹní kò bí, ìyẹn á bí"},{"start":40.055,"end":41.553,"text":"Eni bi tire a tunla.","marked":"Ẹní bí tirẹ̀ á tunla."}],"end":41.553},{"key":"6","start":42.503,"lines":[{"start":42.503,"end":44.035,"text":"B'ina ku a feru b'oju","marked":"B'íná kù á fẹ́rù b'ojú"},{"start":44.415,"end":46.191,"text":"B'ogede ku a f'omo ropo","marked":"B'ọ̀gẹ̀dẹ̀ kù á f'ọmọ rọ́pò"},{"start":46.571,"end":48.203,"text":"O daju pe b'o tile pe","marked":"Ó dájú pé b'ó tilẹ̀ pẹ́"},{"start":48.583,"end":49.784,"text":"Omo wa ni o ropo wa.","marked":"Ọmọ wa ni ò rọ́pò wa."}],"end":49.784},{"key":"7","start":50.734,"lines":[{"start":50.734,"end":52.668,"text":"Gbogbo alejo, a ki nyin","marked":"Gbogbo àlejò, a kì nyin"},{"start":53.048,"end":54.643,"text":"At' awon olufe owon","marked":"Àt' àwọn olùfẹ́ ọ̀wọ́n"},{"start":55.023,"end":56.88,"text":"Jesu yio toju ile nyin","marked":"Jésù yìó tọ́jú ilé nyin"},{"start":57.26,"end":58.688,"text":"Yio si bukun gbogbo nyin.","marked":"Yíó sì bùkún gbogbo nyin."}],"end":58.688},{"key":"8","start":59.638,"lines":[{"start":59.638,"end":61.051,"text":"A ki nyin pe E ku odun","marked":"A kì nyin pé E kú ọdún"},{"start":61.431,"end":63.278,"text":"Odun titun t'a nse loni","marked":"Ọdún titun t'á ńṣe lọni"},{"start":63.658,"end":65.086,"text":"K'Olorun da emi wa si","marked":"K'Ọlọ́run dá ẹ̀mí wa sí"},{"start":65.466,"end":67.021,"text":"Ki gbogbo wa se t' amodun.","marked":"Kí gbogbo wa ṣe t' àmọ̀dún."},{"start":67.401,"end":67.993,"text":"Amin.","marked":"Àmín."}],"end":67.993}]}