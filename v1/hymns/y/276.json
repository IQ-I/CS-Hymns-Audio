{"v":1,"coll":"y","num":276,"id":"hymn_276","title":"JESU yio joba ni gbogbo","duration":52.729,"voices":{"male":{"file":"y-276-male.m4a","bytes":380519,"sha256":"22addf23d723e243dad9c43a52908000512a0861fe6382bde9b7f7a78d7374fe","duration":52.8},"female":{"file":"y-276-female.m4a","bytes":394763,"sha256":"475fac4d701f1de8af980b061b1db1636bea3f6cbb0551cb8f693a680309bb79","duration":52.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.04,"text":"JESU yio joba ni gbogbo","marked":"Jésù yìó jọba ní gbogbo"},{"start":2.42,"end":3.685,"text":"lbit'a ba le ri orun","marked":"lbit'á bá lè rí ọ̀run"},{"start":4.065,"end":6.005,"text":"'Joba Re yo tan kakiri","marked":"'Jọba Rẹ̀ yó tán kákiri"},{"start":6.385,"end":8.095,"text":"'Joba Re ki y'o nipekun.","marked":"'Jọba Rẹ̀ kí y'ó nípẹ̀kun."}],"end":8.095},{"key":"2","start":9.045,"lines":[{"start":9.045,"end":10.695,"text":"On l' ao ma gbadura si,","marked":"On l' àò má gbàdúrà sí"},{"start":11.075,"end":12.505,"text":"Awon oba yio pe l'Oba","marked":"Àwọn ọba yio pé l'Ọba"},{"start":12.885,"end":14.391,"text":"Oruko Re b'orun didun","marked":"Orúkọ Rẹ̀ b'ọrun dídùn"},{"start":14.771,"end":16.697,"text":"Y'o ba ebo oro goke.","marked":"Y'ó bá ẹbọ ọ̀rọ̀ gòkè."}],"end":16.697},{"key":"3","start":17.647,"lines":[{"start":17.647,"end":18.727,"text":"Gbogbo oniruru ede","marked":"Gbogbo onírúrú èdè"},{"start":19.107,"end":20.564,"text":"Y'o fi fe Re korin didun","marked":"Y'ó fi fẹ́ Rẹ̀ kọrin dídùn"},{"start":20.944,"end":22.046,"text":"Awon omode o jewo","marked":"Àwọn ọmọdé ò jẹ́wọ́"},{"start":22.426,"end":24.229,"text":"Pe, 'bukun won t'odo Re wa.","marked":"Pé, 'bùkún wọn t'ọ̀dọ̀ Rẹ wà."}],"end":24.229},{"key":"4","start":25.179,"lines":[{"start":25.179,"end":26.901,"text":"'Bukun po nibit'On joba","marked":"'Bùkún pọ̀ níbit'On jọba"},{"start":27.281,"end":28.955,"text":"A tu awon onde sile","marked":"A tú àwọn òǹdè sílẹ̀"},{"start":29.335,"end":30.597,"text":"Awon alare ri isimi","marked":"Àwọn aláre rí ìṣímí"},{"start":30.977,"end":32.41,"text":"Alaini si ri 'bukun gba.","marked":"Aláìní sì rí 'bùkún gbà."}],"end":32.41},{"key":"5","start":33.36,"lines":[{"start":33.36,"end":34.666,"text":"O f'agbara iwosan han","marked":"Ó f'agbára ìwòsàn hàn"},{"start":35.046,"end":37.217,"text":"Iku, egun ko ni 'pa mo","marked":"Ikú, ègún kò ní 'pa mọ́"},{"start":37.597,"end":39.619,"text":"N'nu Re n'iran Adam nyangan","marked":"N'nu Rẹ̀ n'iran Adam nyangan"},{"start":39.999,"end":41.377,"text":"'Won ri opo ibukun gba.","marked":"'Wọ́n rí ọ̀pọ̀ ìbùkún gbà."}],"end":41.377},{"key":"6","start":42.327,"lines":[{"start":42.327,"end":43.819,"text":"Ki gbogho eda k'o dide","marked":"Kí gbogho ẹ̀dà k'ó dìde"},{"start":44.199,"end":45.459,"text":"Ki nwon f'ola fun Oba wa;","marked":"Kí nwọn f'ọlá fún Ọba wa"},{"start":45.839,"end":47.864,"text":"K'Angel' tun wa t'awon t'orin","marked":"K'Angel' tún wá t'àwọn t'orin"},{"start":48.244,"end":50.248,"text":"Ki gbogb' aiye jumo gberin.","marked":"Kí gbogb' aiye jùmọ̀ gberin."},{"start":50.628,"end":51.179,"text":"Amin.","marked":"Àmín."}],"end":51.179}]}