{"v":1,"coll":"y","num":332,"id":"hymn_332","title":"MO wi fun olukaluku","duration":41.742,"voices":{"male":{"file":"y-332-male.m4a","bytes":295754,"sha256":"630db7481409e9906e4e6c82c15f570667ea9f95239ba1d062b11ecab0e97900","duration":41.8},"female":{"file":"y-332-female.m4a","bytes":301509,"sha256":"a8686b71bea9827df2b84923432cf30d5c97f8c5da08e765acb74b8bdebef4ee","duration":41.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.72,"text":"MO wi fun olukaluku","marked":"Mo wí fún olúkálukú"},{"start":2.1,"end":4.048,"text":"Pe, On ji, O si ye","marked":"Pé, Ón jí, Ó sì yẹ"},{"start":4.428,"end":5.9,"text":"O si wa larin wa pelu","marked":"Ó sì wá lárin wa pẹ̀lú"},{"start":6.28,"end":7.266,"text":"Nipa Emi iye.","marked":"Nípa Ẹ̀mí ìyè."}],"end":7.266},{"key":"2","start":8.216,"lines":[{"start":8.216,"end":9.768,"text":"E wi fun enikeji nyin","marked":"Ẹ wí fún ẹnìkejì nyin"},{"start":10.148,"end":11.231,"text":"Ki nwon ji pelu wa","marked":"Kí nwọn jí pẹ̀lú wa"},{"start":11.611,"end":13.333,"text":"K'imole k'o wa kakiri","marked":"K'ìmọ́lẹ̀̀ k'ó wà kákiri"},{"start":13.713,"end":14.865,"text":"Ni gbogbo aiye wa.","marked":"Ní gbogbo aiye wa."}],"end":14.865},{"key":"3","start":15.815,"lines":[{"start":15.815,"end":17.242,"text":"Nisisiyi aiye yi ri","marked":"Nisisiyi aiye yi ri"},{"start":17.622,"end":18.719,"text":"Bi ile Baba wa","marked":"Bí ilé Bàbá wa"},{"start":19.099,"end":21.075,"text":"lye titun ti On fun ni","marked":"lyé titun tí Ọ́n fún ni"},{"start":21.455,"end":22.833,"text":"O so d'ile Baba.","marked":"Ó sọ d'ílé Bàbá."}],"end":22.833},{"key":"4","start":23.783,"lines":[{"start":23.783,"end":25.086,"text":"Ona okun ti On ti rin","marked":"Ọ̀nà òkun tí Ọ́n ti rìn"},{"start":25.466,"end":26.751,"text":"Mu ni lo si orun","marked":"Mu ni lọ sí ọ̀run"},{"start":27.131,"end":29.108,"text":"Enit' o rin bi On ti rin","marked":"Enit' ò rìn bí On ti rìn"},{"start":29.488,"end":31.285,"text":"Y'o d'odo Re l'orun.","marked":"Y'ó d'ọ̀dọ̀ Rẹ l'ọ̀run."}],"end":31.285},{"key":"5","start":32.235,"lines":[{"start":32.235,"end":34.306,"text":"On ye, O si wa pelu wa","marked":"On yé, Ó sì wà pẹ̀lú wa"},{"start":34.686,"end":35.837,"text":"Ni gbogbo aiye yi","marked":"Ní gbogbo àìyẹ yí"},{"start":36.217,"end":37.722,"text":"Ati nigbati a f'ara wa,","marked":"Àti nígbàtí a f'ara wa"},{"start":38.102,"end":39.216,"text":"F'erupe ni 'reti.","marked":"F'erùpẹ̀ ni 'retí."},{"start":39.596,"end":40.192,"text":"Amin.","marked":"Àmín."}],"end":40.192}]}