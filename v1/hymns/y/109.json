{"v":1,"coll":"y","num":109,"id":"hymn_109","title":"K'A fi ope fun Oluwa","duration":96.718,"voices":{"male":{"file":"y-109-male.m4a","bytes":714288,"sha256":"e4285f0732293af5936249091ef22b50f2f68075bc04d61f01a4396f908383d3","duration":96.8},"female":{"file":"y-109-female.m4a","bytes":739377,"sha256":"0d1ab55e7e7b2e7cdd3ede7b3ef2f22e23b3f0af02fd96b66a8ebfb25e9b362b","duration":96.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.56,"text":"K'A fi ope fun Oluwa","marked":"K'á fi ọpẹ́ fún Olúwa"},{"start":1.94,"end":3.187,"text":"fun gbogbo opo anu Re","marked":"fún gbogbo ọ̀pọ̀ ãnú Rẹ̀"},{"start":3.567,"end":4.754,"text":"K'a wa di ihamora wa","marked":"K'á wá di ìhámọ́ra wa"},{"start":5.134,"end":6.612,"text":"Lati b'esu jagun.","marked":"Láti b'èṣù jagun."},{"start":6.992,"end":8.858,"text":"Egbe:  Esu n'ipe sugbon a o segun","marked":"Èṣù ń'ípẹ́ ṣùgbọ́n a ò ṣẹ́gun"},{"start":9.238,"end":10.451,"text":"Ni agbara metalokan","marked":"Ní agbára Mẹ́talọ́kan"},{"start":10.831,"end":12.305,"text":"Ileri ti Oluwa se","marked":"Ìlérí tí Olúwa ṣe"},{"start":12.685,"end":14.18,"text":"Y'o wa sibe titi.","marked":"Y'ó wá síbẹ̀ títí."}],"end":14.18},{"key":"2","start":15.13,"lines":[{"start":15.13,"end":16.689,"text":"Gbogbo aiye e ho f'ayo","marked":"Gbogbo aiye ẹ̀ hó f'ayo"},{"start":17.069,"end":18.609,"text":"Ki gbogbo wa si kun fun 'se","marked":"Kí gbogbo wa sì kún fún 'se"},{"start":18.989,"end":20.334,"text":"Ki aja titi de opin","marked":"Kí ajá títí dé òpin"},{"start":20.714,"end":22.102,"text":"K'a si fi 'da le le.","marked":"K'á sì fi 'dá lé lẹ̀."},{"start":22.482,"end":24.128,"text":"Egbe:  Lese Kristi omo Baba","marked":"Lẹ́sẹ̀ Kristi ọmọ Bàbá"},{"start":24.508,"end":26.384,"text":"Ni ibi awon Angeli nyo","marked":"Ní ibi àwọn Áńgẹ́lì nyo"},{"start":26.764,"end":28.592,"text":"K'a be won yin Baba loke","marked":"K'á bẹ̀ wọ́n yin Bàbá lókè"},{"start":28.972,"end":30.383,"text":"Omo, Emi lailai.","marked":"Ọmọ, Èmi láíláí."}],"end":30.383},{"key":"3","start":31.333,"lines":[{"start":31.333,"end":32.799,"text":"Awa omo egbe Serafu","marked":"Àwa ọmọ ẹgbẹ́ Séráfù"},{"start":33.179,"end":34.47,"text":"A fi ogo fun Oluwa","marked":"A fi ògo fún Olúwa"},{"start":34.85,"end":36.451,"text":"T'o je k'emi tun ri emi","marked":"T'ó jẹ́ k'ẹ̀mí tún rí èmi"},{"start":36.831,"end":38.179,"text":"Ogo f 'oruko Re.","marked":"Ògo f 'orúkọ Rẹ̀."},{"start":38.559,"end":40.213,"text":"Egbe:  Gb 'oju s 'oke wo asia,","marked":"Gb 'ojú s 'òkè wọ àsíá"},{"start":40.593,"end":42.094,"text":"Fun gbogbo awon t'o segun","marked":"Fún gbogbo àwọn t'ó ṣẹ́gun"},{"start":42.474,"end":44.042,"text":"Enyin ara e ku abo,","marked":"Enyin ará ẹ̀ ku abo"},{"start":44.422,"end":45.799,"text":"Ki Baba pelu nyin.","marked":"Kí Bàbá pẹ̀lú nyin."}],"end":45.799},{"key":"4","start":46.749,"lines":[{"start":46.749,"end":48.747,"text":"Awon t'o ti segun saju","marked":"Àwọn t'ó ti ṣẹ́gun ṣajú"},{"start":49.127,"end":50.77,"text":"Nwon nwo wa bi awa ti nja","marked":"Nwọ̀n nwọ́ wa bí àwa ti ńjà"},{"start":51.15,"end":52.763,"text":"Nwon si nfi ohun kan wipe","marked":"Nwọ̀n sì ńfi ohun kan wípé"},{"start":53.143,"end":54.316,"text":"Ara ma jafara.","marked":"Ara mà jáfara."},{"start":54.696,"end":56.706,"text":"Egbe:  Nitor' akoko die loku","marked":"Nítor' àkókò díẹ̀ lókù"},{"start":57.086,"end":58.744,"text":"Ti aiye yi yio koja lo","marked":"Ti aiye yi yio kọjá lọ"},{"start":59.124,"end":60.82,"text":"Bi asegun o daju pe,","marked":"Bí àṣegùn ò dájú pé"},{"start":61.2,"end":62.678,"text":"A o gb'a ade iye.","marked":"A ò gb'á adé ìyè."}],"end":62.678},{"key":"5","start":63.628,"lines":[{"start":63.628,"end":65.244,"text":"Awa si tun ki asaju wa,","marked":"Àwa sì tún kí aṣájú wa"},{"start":65.624,"end":67.026,"text":"Ati awon 'mo ogun re,","marked":"Àti àwọn 'mọ ogun rẹ̀"},{"start":67.406,"end":68.939,"text":"Ara e ku ise emi,","marked":"Ara ẹ̀ kù iṣẹ́ ẹ̀mí"},{"start":69.319,"end":70.819,"text":"K'a gb'owo lowo ara wa.","marked":"K'á gb'owó lọ́wọ́ ara wa."},{"start":71.199,"end":73.521,"text":"Egbe:  E ku abo, enyin ku iIe","marked":"Ẹ kú abọ́, enyin ku ilé"},{"start":73.901,"end":75.322,"text":"K'Olorun pelu gbogbo wa,","marked":"K'Ọlọ́run pẹ̀lú gbogbo wa"},{"start":75.702,"end":77.185,"text":"K'o si fi ade ogo Re,","marked":"K'ó sì fi adé ògo Rẹ̀"},{"start":77.565,"end":78.843,"text":"De gbogbo wa lori.","marked":"Dé gbogbo wa lórí."}],"end":78.843},{"key":"6","start":79.793,"lines":[{"start":79.793,"end":81.091,"text":"Ope ni fun Metalokan","marked":"Ọpẹ́ ni fún Mẹ́talọ́kan"},{"start":81.471,"end":83.21,"text":"T'o ba wa fo 'tegun esu,","marked":"T'ó bá wa fọ́ 'tẹ́gun èṣù"},{"start":83.59,"end":84.904,"text":"Halleluyah's Olorun wa,","marked":"Hallelúyàh's Ọlọ́run wa"},{"start":85.284,"end":86.557,"text":"Oju ti Lusifa.","marked":"Ojú ti Lúsífà."},{"start":86.937,"end":88.374,"text":"Egbe:  Ara e jo pelu ayo,","marked":"Ara ẹ̀ jọ pẹ̀lú ayọ̀"},{"start":88.754,"end":90.412,"text":"Ara e gbe ohun s'oke","marked":"Ara ẹ̀ gbé ohun s'ókè"},{"start":90.792,"end":92.573,"text":"Ki Baba fun wa ni fe Re.","marked":"Kí Bàbá fún wa ní fẹ́ Rẹ."},{"start":92.953,"end":94.176,"text":"Eyi ti ko l'egbe.","marked":"Èyí tí kò l'ègbè."},{"start":94.556,"end":95.168,"text":"Amin.","marked":"Àmín."}],"end":95.168}]}