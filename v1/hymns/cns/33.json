{"v":1,"coll":"cns","num":33,"id":"hymn_33","title":"Dari ese ji wa","duration":42.738,"voices":{"male":{"file":"cns-33-male.m4a","bytes":308452,"sha256":"01116e156409a485f0b4cf9ed14157e0f5cd08c42aa784b22378b43ea612d535","duration":42.8},"female":{"file":"cns-33-female.m4a","bytes":321903,"sha256":"5e366526da6baedcfa2d89b2cef7f4915f84e96103983bcf3f0028efea858f73","duration":42.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.688,"text":"Dari ese ji wa,","marked":"Darí ẹ̀ṣẹ̀ jì wá"},{"start":2.068,"end":3.18,"text":"Olorun o -Olorun wa","marked":"Ọlọ́run ò Ọlọ́run wa"},{"start":3.56,"end":4.803,"text":"Dari ese ji wa, (2ce)","marked":"Darí ẹ̀ṣẹ̀ jì wá"},{"start":5.183,"end":6.305,"text":"Atobiju Olorun wa,","marked":"Atọ́bíjú Ọlọ́run wa"},{"start":6.685,"end":8.175,"text":"Awa mora wa ni elese,","marked":"Àwa mọra wa ní ẹlẹ́ṣẹ̀"},{"start":8.555,"end":9.695,"text":"Abara more je,","marked":"Abara mọ́rẹ́ jẹ́"},{"start":10.075,"end":11.335,"text":"Bi akisa alegbin o,","marked":"Bí àkísà àlégbin o"},{"start":11.715,"end":13.09,"text":"L'ese ni waju Re,","marked":"L'ẹsẹ̀ ní wájú Rẹ"},{"start":13.47,"end":16.342,"text":"Ni kutukutu a be O o Eleruniyin,","marked":"Ní kùtùkùtù a bẹ́ Ọ o Eleruniyin"},{"start":16.722,"end":18.691,"text":"Loni o awa wole -saanu fun wa.","marked":"Lòní o àwa wọlé ṣàánú fún wa."}],"end":18.691},{"key":"CHORUS","start":19.641,"lines":[{"start":19.641,"end":20.514,"text":"Baba-Baba,","marked":"Baba-Bàbá"},{"start":20.894,"end":22.267,"text":"Jowo wa gbadura wa -Baba","marked":"Jọ̀wọ́ wa gbàdúrà wa Bàbá"}],"end":22.267},{"key":"2","start":23.217,"lines":[{"start":23.217,"end":25.301,"text":"SOLO: k'aye wa ko loyin,","marked":"Solo: k'áyé wa kò lóyin"},{"start":25.681,"end":27.162,"text":"k'oro wa ko d'ayo,","marked":"k'ọ́rọ́ wa kò d'àyò"},{"start":27.542,"end":28.641,"text":"ki'le wa ko roju,","marked":"kí'lè wá kó rojú"},{"start":29.021,"end":30.28,"text":"K'ona wa ko l'ayo","marked":"K'ọ́nà wa kò l'àyò"},{"start":30.66,"end":31.987,"text":"K'aboyun bi were","marked":"K'aboyún bí wẹ́rẹ́"},{"start":32.367,"end":34.037,"text":"K'aboyun T'owo bosun","marked":"K'aboyún T'ọwọ́ bọ́sùn"},{"start":34.417,"end":38.79,"text":"FULL: Ni kutukutu a be O o -Eleru niyin,","marked":"Full: Ní kùtùkùtù a bẹ́ Ọ ọ́ Ẹlẹ́rù níyìn"},{"start":39.17,"end":41.188,"text":"Loni o awa wole -saanu fun wa.","marked":"Lòní o àwa wọlé ṣàánú fún wa."}],"end":41.188}]}