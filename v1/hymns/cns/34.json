{"v":1,"coll":"cns","num":34,"id":"hymn_34","title":"Baba dariji wa o","duration":31.608,"voices":{"male":{"file":"cns-34-male.m4a","bytes":230880,"sha256":"2c951c69c406eec2fdbea52e372b5298141288897deca4db0dbe15c53852355f","duration":31.7},"female":{"file":"cns-34-female.m4a","bytes":239335,"sha256":"6a53c108adb879058581d7e681173e313a297e0b7326343771928b4ba1e05217","duration":31.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.549,"text":"Baba dariji wa o, (2ce)","marked":"Bàbá dáríjì wa o"},{"start":1.929,"end":3.661,"text":"Awa elese abara m'ore je,","marked":"Àwa ẹlẹ́sẹ̀ abara m'ọ̀rẹ́ jẹ́"},{"start":4.041,"end":5.213,"text":"Baba dariji wa o,","marked":"Bàbá dáríjì wa o"},{"start":5.593,"end":7.339,"text":"Ni ti mimo a ko mo,","marked":"Ní ti mímọ́̀ a kò mọ̀"},{"start":7.719,"end":9.708,"text":"Ni ti yiyege a ko ye'ge (2ce)","marked":"Ní ti yíyege a kò ye'ge"},{"start":10.088,"end":11.679,"text":"Bi a ba ni ka s'ami ese,","marked":"Bí a bá ní ká s'àmì ẹsẹ̀"},{"start":12.059,"end":14.052,"text":"Ko s'eni to le duro ninu wa -","marked":"Kò s'ẹni tó lè dúró nínú wa"},{"start":14.432,"end":16.305,"text":"Baba Orun -Jowo dariji wa o.","marked":"Bàbá Ọ̀run Jọ̀wọ́ dariji wa o."}],"end":16.305},{"key":"2","start":17.255,"lines":[{"start":17.255,"end":18.215,"text":"Ya wa si mimo (2ce)","marked":"Yà wá sí mímọ́́"},{"start":18.595,"end":20.064,"text":"Je ka le wulo fun ise Re,","marked":"Jẹ́ ká lè wúlò fún iṣẹ́ Rẹ"},{"start":20.444,"end":21.35,"text":"Ya wa si mimo,","marked":"Yà wá sí mímọ́́"},{"start":21.73,"end":23.114,"text":"Ogun aye -Ogun Esu, (2ce)","marked":"Ogun ayé Ogun Èṣù"},{"start":23.494,"end":24.749,"text":"Ma je ko de wa lona,","marked":"Má jẹ́ kó dè wá lọ́nà"},{"start":25.129,"end":26.521,"text":"Ninu ara -Ninu emi,","marked":"Nínú ara Nínú ẹ̀mí"},{"start":26.901,"end":28.612,"text":"Ma je k'adura wa ni 'de na,","marked":"Má jẹ k'àdúrà wa ní 'de ná"},{"start":28.992,"end":30.058,"text":"Ya wa si mimo.","marked":"Yà wá sí mímọ́́."}],"end":30.058}]}