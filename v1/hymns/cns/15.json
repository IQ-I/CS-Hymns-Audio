{"v":1,"coll":"cns","num":15,"id":"hymn_15","title":"Jah L'oke a de o, a tun de","duration":25.898,"voices":{"male":{"file":"cns-15-male.m4a","bytes":199670,"sha256":"35fc8fdc3339c0e39ef0faa4e81e0f538244318b2ba322b2a1396ee3363d1764","duration":25.9},"female":{"file":"cns-15-female.m4a","bytes":202488,"sha256":"548f57e709a8d3b2b9cbe88b53b877c3d756af2d21ef32e214f329c26b05ad02","duration":25.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.125,"text":"Jah L'oke a de o, a tun de","marked":"Jah L'òkè á dé o, á tún dé"},{"start":3.505,"end":5.654,"text":"O, a tun de t'aroye wa","marked":"O, a tún dé t'àròyé wa"},{"start":6.034,"end":7.701,"text":"A de o t'owo t'owo (2ce)","marked":"A dé ò t'ọwọ́ t'ọwọ́"},{"start":8.081,"end":9.596,"text":"Messiah ye wa gbo","marked":"Messiah yé wa gbọ́"},{"start":9.976,"end":11.844,"text":"Wa ba w ape ninu wakati","marked":"Wá bá w àpẹ́ nínú wákàtí"},{"start":12.224,"end":13.385,"text":"Yi o Oba OLola","marked":"Yí ọ Ọba Ọlọ́la"},{"start":13.765,"end":15.578,"text":"Olu pese Oba Pataki jowo ye","marked":"Olú pèsè Ọba Pàtàkì jọ̀wọ́ yé"},{"start":15.958,"end":16.725,"text":"Awa mbe O o.","marked":"Àwa ḿbẹ O o."},{"start":17.105,"end":19.606,"text":"Jah l'oke a de o, a tun de","marked":"Jah l'òkè á dé o, á tún dé"},{"start":19.986,"end":20.954,"text":"T'aroye wa,","marked":"T'àròyé wa"},{"start":21.334,"end":22.44,"text":"Ade o teruteru,","marked":"Adé ò tẹ̀rùtẹ̀rù"},{"start":22.82,"end":24.348,"text":"Oyigiyigi ye wa gbo.","marked":"Oyìgìyigì yé wa gbọ́."}],"end":24.348}]}