{"v":1,"coll":"cns","num":12,"id":"hymn_12","title":"Olugbala gbadura wa","duration":15.139,"voices":{"male":{"file":"cns-12-male.m4a","bytes":108459,"sha256":"6bcd5a4c48904f869486227bd7e27699da9a8d8e2361087c8ff263faca528600","duration":15.2},"female":{"file":"cns-12-female.m4a","bytes":111209,"sha256":"500ac813bb5a69b2c6c1c81031f86759252c02e98c3e4c7d94162471d49da87a","duration":15.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.55,"text":"Olugbala gbadura wa,","marked":"Olùgbàlà gbàdúrà wa"},{"start":1.93,"end":3.554,"text":"B'a ti fi 'gbagbo kunle","marked":"B'á ti fi 'gbàgbọ́ kúnlẹ̀"},{"start":3.934,"end":5.383,"text":"Jo si ferese anu Re","marked":"Jọ sí fèrèsé ãnu Rẹ"},{"start":5.763,"end":7.222,"text":"Ko de Oluwa a mbe O,","marked":"Kò dé Olúwa a ḿbẹ O"},{"start":7.602,"end":9.118,"text":"Je k'ojo ibukun de o","marked":"Jẹ k'ọjọ́ ìbùkún dé o"},{"start":9.498,"end":11.558,"text":"Awa n duro, awa n duro,","marked":"Àwa ń dúró, àwa ń dúró"},{"start":11.938,"end":13.589,"text":"M'okan gbogbo wa soji.","marked":"M'ọ̀kan gbogbo wá sọjí."}],"end":13.589}]}