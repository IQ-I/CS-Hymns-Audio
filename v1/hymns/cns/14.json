{"v":1,"coll":"cns","num":14,"id":"hymn_14","title":"Oluwa awa de, kabiyesi Oba wa","duration":15.36,"voices":{"male":{"file":"cns-14-male.m4a","bytes":106855,"sha256":"98e1d3670c795440a15bb038e0efb5be004dead83202202bb14a364031cd8173","duration":15.4},"female":{"file":"cns-14-female.m4a","bytes":110881,"sha256":"570499c92de01b38c8f13c0dfbf5d57a27928cd41e83a34d8ce84e3b92b41147","duration":15.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.868,"text":"Oluwa awa de, kabiyesi Oba wa","marked":"Olúwa àwa dé, kábíyèsí Ọba wa"},{"start":3.248,"end":5.1,"text":"Eleru ni yin, darijiwa","marked":"Ẹlẹ́rù ni yín, daríjìwà"},{"start":5.48,"end":6.245,"text":"Baba wa","marked":"Bàbá wa"},{"start":6.625,"end":7.821,"text":"Ta l'a ni t'a gbojule","marked":"Ta l'á ní t'á gbójúlé"},{"start":8.201,"end":9.886,"text":"Ta la ni ta fehin ti,","marked":"Ta la ní ta fẹ̀hìn tì"},{"start":10.266,"end":11.778,"text":"Bikose Iwo Olorun wa,","marked":"Bíkọ́ṣẹ́ Ìwọ Ọlọ́run wa"},{"start":12.158,"end":13.81,"text":"Eleru ni yin dariji wa o.","marked":"Ẹlẹ́rù ni yín dariji wa o."}],"end":13.81}]}