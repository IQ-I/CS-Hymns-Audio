{"v":2,"coll":"en","num":293,"id":"hymn_293","title":"NOT all the blood of beasts","duration":49.952,"voices":{"grace":{"file":"en-293-grace-s1.m4a","bytes":430405,"sha256":"e4e756accb0f676d984e533637ac813ac3c5e501673c6a16576a80d63f3c802f","duration":49.952,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.811,"text":"NOT all the blood of beasts"},{"start":2.431,"end":3.918,"text":"On Jewish altars slain"},{"start":4.538,"end":6.466,"text":"Could give the guilty conscience peace"},{"start":7.086,"end":8.429,"text":"Or wash away the stain."}],"start":0.35,"end":8.429},{"key":"2","lines":[{"start":10.199,"end":11.71,"text":"But Christ the heavenly Lamb"},{"start":12.33,"end":13.705,"text":"Takes all our Sins away"},{"start":14.325,"end":16.131,"text":"A sacrifice of nobler name"},{"start":16.751,"end":18.138,"text":"And richer blood than they."}],"start":10.199,"end":18.138},{"key":"3","lines":[{"start":19.908,"end":21.433,"text":"My faith would lay her hand"},{"start":22.053,"end":23.463,"text":"On that dear head of Thine"},{"start":24.083,"end":25.746,"text":"While like a penitent I stand"},{"start":26.366,"end":27.771,"text":"And there confess my sin."}],"start":19.908,"end":27.771},{"key":"4","lines":[{"start":29.541,"end":31.102,"text":"My soul looks back to see"},{"start":31.722,"end":33.277,"text":"The burdens Thou didst bear"},{"start":33.897,"end":35.646,"text":"When hanging on the accursed tree"},{"start":36.266,"end":37.648,"text":"I know my guilt He bore."}],"start":29.541,"end":37.648},{"key":"5","lines":[{"start":39.418,"end":40.811,"text":"Believing, we rejoice"},{"start":41.431,"end":42.789,"text":"To see the curse remove"},{"start":43.409,"end":45.343,"text":"We bless the Lamb with cheerful voice"},{"start":45.963,"end":47.482,"text":"And sing His bleeding love!"}],"start":39.418,"end":47.482}]},"daniel":{"file":"en-293-daniel-s1.m4a","bytes":435300,"sha256":"3ce1db3a0db61527fe64bca13cfa6a8a3217f6c04e1c9bae0c8ecbfd7fa3986d","duration":49.655,"segm