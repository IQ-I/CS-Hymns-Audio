{"v":2,"coll":"en","num":100,"id":"hymn_100","title":"SPIRIT of the living God","duration":68.557,"voices":{"grace":{"file":"en-100-grace.m4a","bytes":597187,"sha256":"ed1130c966a6cbd9435f4b3632f550fa23a24143037d08c6f393ee738ad79320","duration":68.557,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.805,"text":"SPIRIT of the living God"},{"start":2.425,"end":3.609,"text":"O descend Thou now"},{"start":4.229,"end":5.851,"text":"With pow'r of the Pentecost"},{"start":6.471,"end":7.757,"text":"And revive our souls"},{"start":8.377,"end":9.697,"text":"And make us to be warm"},{"start":10.317,"end":11.725,"text":"Like heavenly fire, come"},{"start":12.345,"end":13.712,"text":"With Thy great comfort"},{"start":14.332,"end":15.426,"text":"Show us Thy Light."}],"start":0.35,"end":15.426},{"key":"2","lines":[{"start":17.196,"end":18.928,"text":"The world and our soul receive"},{"start":19.548,"end":20.721,"text":"And make it Thy Own"},{"start":21.341,"end":22.938,"text":"Lord, In our adoration"},{"start":23.558,"end":24.743,"text":"Let us see Thy help"},{"start":25.363,"end":26.568,"text":"And sincerity be"},{"start":27.188,"end":28.464,"text":"And the gift from heav'n"},{"start":29.084,"end":30.285,"text":"Of the Pentecost"},{"start":30.905,"end":31.861,"text":"Be upon us."}],"start":17.196,"end":31.861},{"key":"3","lines":[{"start":33.631,"end":35.311,"text":"Wash us with Thy precious blood"},{"start":35.931,"end":36.851,"text":"of the Calvary"},{"start":37.471,"end":39.075,"text":"Wash our souls of sin away"},{"start":39.695,"end":40.846,"text":"And redeem us now"},{"start":41.466,"end":42.983,"text":"Fill our heart with Thy love"},{"start":43.603,"end":44.901,"text":"To walk the good path"},{"start":45.521,"end":46.897,"text":"Lord, Thy will, we'll do"},{"start":47.517,"end":48.633,"text":"As done in heav'n."}],"start":33.631,"end":48.633},{"key":"4","lines":[{"start":50.403,"end":52.074,"text":"Father Son and Holy Ghost"},{"start":52.694,"end":53.694,"text":"‘terna