{"v":2,"coll":"en","num":786,"id":"hymn_786","title":"THANKS we offer unto God","duration":114.275,"voices":{"grace":{"file":"en-786-grace-s1.m4a","bytes":1021515,"sha256":"1ad6690411f89fcae26e5be9892a387b8bb4f26594faff0109d097d25ff85931","duration":114.275,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.924,"text":"THANKS we offer unto God"},{"start":2.544,"end":4.189,"text":"Who offered us Christ Jesus"},{"start":4.809,"end":6.148,"text":"To redeem the universe"},{"start":6.768,"end":8.4,"text":"From the hold of satan and sin."}],"start":0.35,"end":8.4},{"key":"CHORUS","lines":[{"start":10.17,"end":12.258,"text":"Praise Him loudly, offer Him thanks"},{"start":12.878,"end":14.253,"text":"Holy God the Trinity"},{"start":14.873,"end":16.39,"text":"For His mercies and favour"},{"start":17.01,"end":18.663,"text":"Broadly on the Seraphim Band."}],"start":10.17,"end":18.663},{"key":"2","lines":[{"start":20.433,"end":22.257,"text":"Divine power of God doth grow"},{"start":22.877,"end":24.755,"text":"Glory of Jesus manifests"},{"start":25.375,"end":27.239,"text":"The pow’r of Holy Spirit dwells"},{"start":27.859,"end":29.462,"text":"Amidst the Band of Seraphim."}],"start":20.433,"end":29.462},{"key":"3","lines":[{"start":31.232,"end":33.009,"text":"All men and nations on earth"},{"start":33.629,"end":35.287,"text":"Bow down in pray'r unto God"},{"start":35.907,"end":37.596,"text":"Repent ye in Spirit of Truth"},{"start":38.216,"end":39.758,"text":"May Father above save us."}],"start":31.232,"end":39.758},{"key":"4","lines":[{"start":41.528,"end":43.599,"text":"Sins increaseth, earth is troubled"},{"start":44.219,"end":46.034,"text":"Satan pilfers and rejoicing"},{"start":46.654,"end":48.32,"text":"Let all Christians congregate"},{"start":48.94,"end":50.614,"text":"In prayers to conquer satan."}],"start":41.528,"end":50.614},{"key":"5","lines":[{"start":52.384,"end":53.864,"text":"All ye pious believers"},{"start":54.484,"end":56.367,"text":"Jesus knows thine hidden works"},{"start":56.987,"end":58.708,"text":"No further argument with God"},{"start":59.328,"end":60.999,"text":"Thine divine teacher is nigh."}],"start":52.384,"end":60.999},{"key":"6","lines":[{"start":62.769,"end":64.289,"text":"Cherub, Seraph be ready"},{"start":64.909,"end":66.696,"text":"Priests and Bishops be prepared"},{"start":67.316,"end":68.956,"text":"Jesus disciples be ready"},{"start":69.576,"end":71.102,"text":"For the latterday of judgement."}],"start":62.769,"end":71.102},{"key":"7","lines":[{"start":72.872,"end":74.509,"text":"We celebrates anniversary"},{"start":75.129,"end":76.701,"text":"As commanded Saint Moses"},{"start":77.321,"end":78.807,"text":"To Christen this Holy Band"},{"start":79.427,"end":80.94,"text":"Host of Seraphim below."}],"start":72.872,"end":80.94},{"key":"8","lines":[{"start":82.71,"end":84.163,"text":"Band of Moses be ready"},{"start":84.783,"end":86.699,"text":"‘Midst Band of Cherub, Seraph"},{"start":87.319,"end":88.865,"text":"Given us by Father, God"},{"start":89.485,"end":91.143,"text":"Hoist up its banner high now."}],"start":82.71,"end":91.143},{"key":"9","lines":[{"start":92.913,"end":94.722,"text":"Lo! Pagan and muslims come"},{"start":95.342,"end":96.899,"text":"All ye Christians follow suit"},{"start":97.519,"end":99.206,"text":"Let us all praise Holy God"},{"start":99.826,"end":101.44,"text":"Crown of life may we receive."}],"start":92.913,"end":101.44},{"key":"10","lines":[{"start":103.21,"end":104.707,"text":"Be merciful God to us"},{"start":105.327,"end":107.156,"text":"Forgive and preserve us all"},{"start":107.776,"end":109.619,"text":"Be of help, receive our prayers"},{"start":110.239,"end":111.806,"text":"Now and till eternity."}],"start":103.21,"end":111.806}]},"daniel":{"file":"en-786-daniel-s1.m4a","bytes":1012808,"sha256":"710a27bb929f8302252ba57ff3811c3ea9309d5197ede799733e49af24a27ce5","duration":112.942,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.988,"text":"THANKS we offer unto God"},{"st