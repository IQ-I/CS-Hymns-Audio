{"v":2,"coll":"en","num":61,"id":"hymn_61","title":"FATHER which art in heaven","duration":126.618,"voices":{"grace":{"file":"en-61-grace-s1.m4a","bytes":1162031,"sha256":"b16c00653cfd77dfc96044cc5bc0032c4b561e1b51b9e73bc66c5e1d7d4952a5","duration":126.618,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.905,"text":"FATHER which art in heaven"},{"start":2.525,"end":3.835,"text":"Halloweth be Thine name"},{"start":4.455,"end":6.101,"text":"Thine will be done here on earth"},{"start":6.721,"end":7.901,"text":"As be it in heaven"},{"start":8.521,"end":10.092,"text":"Give us Lord our daily bread"},{"start":10.712,"end":12.132,"text":"Forgive us all our debts"},{"start":12.752,"end":14.36,"text":"Lead us not to temptation"},{"start":14.98,"end":16.337,"text":"Keep us from all evil."}],"start":0.35,"end":16.337},{"key":"2","lines":[{"start":18.107,"end":19.417,"text":"Thou hearkened to Elijah"},{"start":20.037,"end":21.338,"text":"A bank river Cedron"},{"start":21.958,"end":23.456,"text":"Thou who hearkened to Daniel"},{"start":24.076,"end":25.452,"text":"Oh God today hear us"},{"start":26.072,"end":27.569,"text":"Give us the Holy Spirit"},{"start":28.189,"end":30.162,"text":"As Note! Thou gave the Apostles"},{"start":30.782,"end":32.394,"text":"Glorious vessels we may be"},{"start":33.014,"end":34.456,"text":"Reward as they of Old."}],"start":18.107,"end":34.456},{"key":"3","lines":[{"start":36.226,"end":37.932,"text":"The faithful heart we plead Thee"},{"start":38.552,"end":39.968,"text":"That ever waiver not"},{"start":40.588,"end":42.008,"text":"For us to ever trust Thee"},{"start":42.628,"end":43.965,"text":"Till we shall meet with Thee"},{"start":44.585,"end":46.119,"text":"Re‐assuring hope we plead"},{"start":46.739,"end":48.277,"text":"In Thee and not in any"},{"start":48.897,"end":50.549,"text":"Beaming love to our brethren"},{"start":51.169,"end":52.45,"text":"Humbly and peacefully."}],"start":36.226,"end":52.45},{"key":"4","lines":[{"start":54.22,"end":55.