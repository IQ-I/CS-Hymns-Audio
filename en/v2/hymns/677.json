{"v":2,"coll":"en","num":677,"id":"hymn_677","title":"THERE'S a friend for little children","duration":110.876,"voices":{"grace":{"file":"en-677-grace.m4a","bytes":1029624,"sha256":"b641cf33aa538627147162674827cfbcb9baf7babcf57e295c56cf3ad8ddfe2a","duration":110.876,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.215,"text":"THERE'S a friend for little children"},{"start":2.835,"end":4.255,"text":"Above the bright blue sky"},{"start":4.875,"end":6.39,"text":"A friend who changeth never"},{"start":7.01,"end":8.552,"text":"Whose love can never die"},{"start":9.172,"end":10.792,"text":"Unlike our friends by nature"},{"start":11.412,"end":13.147,"text":"Who changeth with changing years"},{"start":13.767,"end":15.394,"text":"This friend is always worthy"},{"start":16.014,"end":17.497,"text":"The precious name He bears."}],"start":0.35,"end":17.497},{"key":"2","lines":[{"start":19.267,"end":20.987,"text":"There's a rest for little children"},{"start":21.607,"end":23.027,"text":"Above the bright blue sky"},{"start":23.647,"end":25.296,"text":"For those who love the saviour"},{"start":25.916,"end":27.284,"text":"And Abba Father cry"},{"start":27.904,"end":29.368,"text":"A rest from every trouble"},{"start":29.988,"end":31.618,"text":"From sin and danger free"},{"start":32.238,"end":33.738,"text":"Where every little pilgrim"},{"start":34.358,"end":35.572,"text":"Shall rest eternally."}],"start":19.267,"end":35.572},{"key":"3","lines":[{"start":37.342,"end":39.141,"text":"There's a home for little children"},{"start":39.761,"end":41.181,"text":"Above the bright blue sky"},{"start":41.801,"end":43.488,"text":"Where Jesus reigns in glory"},{"start":44.108,"end":45.575,"text":"A home of peace and joy"},{"start":46.195,"end":47.859,"text":"No home on earth is like it"},{"start":48.479,"end":49.88,"text":"None can with it compare"},{"start":50.5,"end":51.939,"text":"Where every one is happy"},{"start":52.559,"end":53.894,"text":"All can be happier there."}],"start":37.342,"e