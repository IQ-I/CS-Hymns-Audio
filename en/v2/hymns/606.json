{"v":2,"coll":"en","num":606,"id":"hymn_606","title":"SWALLOW up hence thine woe","duration":45.522,"voices":{"grace":{"file":"en-606-grace-s1.m4a","bytes":420207,"sha256":"e5863adde739911a9e4fcb32eb90ce0ae99eba2fc6c6e8cdda994a63266aecc5","duration":45.522,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.848,"text":"SWALLOW up hence thine woe"},{"start":2.468,"end":3.521,"text":"It’s universal"},{"start":4.141,"end":5.233,"text":"Let it be forgotten"},{"start":5.853,"end":7.004,"text":"Further endure on"},{"start":7.624,"end":9.659,"text":"Patiently ponder on/it during the dusk"},{"start":10.279,"end":12.861,"text":"To Jesus petition/thou shall find relief."}],"start":0.35,"end":12.861},{"key":"2","lines":[{"start":14.631,"end":17.439,"text":"To Jesus petition, thine desire He knows"},{"start":18.059,"end":20.645,"text":"To Jesus petition, He shall, thee to aid"},{"start":21.265,"end":23.44,"text":"Go to savour the joy gave He unto thee"},{"start":24.06,"end":26.731,"text":"He, thine burden lighten/but in prayer be firm."}],"start":14.631,"end":26.731},{"key":"3","lines":[{"start":28.501,"end":29.92,"text":"Those who so are wretched"},{"start":30.54,"end":31.659,"text":"More over than thee"},{"start":32.279,"end":33.699,"text":"Their woeful heart to bow"},{"start":34.319,"end":35.804,"text":"Thine, them to comfort"},{"start":36.424,"end":38.927,"text":"Swallow up hence thine woe/others, offer joy"},{"start":39.547,"end":41.708,"text":"Shine unto them, thine light/to Jesus"},{"start":42.328,"end":43.052,"text":"report."}],"start":28.501,"end":43.052}]},"daniel":{"file":"en-606-daniel-s1.m4a","bytes":421112,"sha256":"ee96555e410d3e8c6ee5ec62da4298210ae09971e84acbe8a6861b1970b9f725","duration":45.043,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.811,"text":"SWALLOW up hence thine woe"},{"start":2.431,"end":3.551,"text":"It’s universal"},{"start":4.171,"end":5.292,"text":"Let it be forgotten"},{"start":5.912,"end":7.081,"text":"Further endure on"},{"start":