{"v":2,"coll":"en","num":232,"id":"hymn_232","title":"O GOD of Bethel, by whose hand","duration":51.944,"voices":{"grace":{"file":"en-232-grace-s1.m4a","bytes":471223,"sha256":"24d09e7cdc12c7a06152f934e81bac3a506db4fe3b5ec1cd5aaedaad763a5e2d","duration":51.944,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.255,"text":"O GOD of Bethel, by whose hand"},{"start":2.875,"end":4.293,"text":"Thy people still are fed,"},{"start":4.673,"end":6.54,"text":"Who through this weary pilgrimage"},{"start":7.16,"end":8.732,"text":"Hast all our fathers led."}],"start":0.35,"end":8.732},{"key":"2","lines":[{"start":10.502,"end":12.599,"text":"Our vows, our prayer, we now present"},{"start":13.219,"end":14.726,"text":"Before thy throne of grace;"},{"start":15.186,"end":16.907,"text":"God of our fathers, be the God"},{"start":17.527,"end":18.913,"text":"Of their succeeding race."}],"start":10.502,"end":18.913},{"key":"3","lines":[{"start":20.683,"end":22.618,"text":"Through each perplexing path of life"},{"start":23.238,"end":24.912,"text":"Our wandering footsteps guide:"},{"start":25.372,"end":27.174,"text":"Give us each day our daily bread,"},{"start":27.554,"end":28.994,"text":"And raiment fit provide."}],"start":20.683,"end":28.994},{"key":"4","lines":[{"start":30.764,"end":32.706,"text":"O spread thy covering wings around,"},{"start":33.086,"end":34.664,"text":"Till all our wandering cease"},{"start":35.284,"end":36.996,"text":"And at our father‘s loved abode"},{"start":37.616,"end":39.16,"text":"Our souls arrive in peace."}],"start":30.764,"end":39.16},{"key":"5","lines":[{"start":40.93,"end":43.019,"text":"Such blessings from thy gracious hand"},{"start":43.639,"end":45.263,"text":"Our humble prayers implore"},{"start":45.883,"end":47.606,"text":"And thou shalt be our chosen God"},{"start":48.226,"end":49.475,"text":"And portion evermore."}],"start":40.93,"end":49.475}]},"daniel":{"file":"en-232-daniel-s1.m4a","bytes":469950,"sha256":"a726fddee2a12743df9b81ecb2b829c25d718d