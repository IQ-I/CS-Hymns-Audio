{"v":2,"coll":"en","num":187,"id":"hymn_187","title":"HARK! the glad sound! The Saviour comes","duration":52.767,"voices":{"grace":{"file":"en-187-grace-s1.m4a","bytes":476951,"sha256":"0e9eb632dc97933ccec1b772e6e2357fb9afc91248e65472a47f8602093a19ae","duration":52.767,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.88,"text":"HARK! the glad sound! The Saviour comes"},{"start":3.5,"end":4.9,"text":"The Saviour promise long"},{"start":5.52,"end":7.298,"text":"Let every heart prepare a throne"},{"start":7.918,"end":9.295,"text":"And every voice a song."}],"start":0.35,"end":9.295},{"key":"2","lines":[{"start":11.065,"end":12.858,"text":"He comes the prisoners to release"},{"start":13.478,"end":15.002,"text":"In Satan's bondage held,"},{"start":15.382,"end":17.352,"text":"The gates of brass before Him burst"},{"start":17.972,"end":19.458,"text":"The Iron fetters yield."}],"start":11.065,"end":19.458},{"key":"3","lines":[{"start":21.228,"end":23.247,"text":"He comes from thickest films of vice"},{"start":23.867,"end":25.259,"text":"To clear the mental ray"},{"start":25.879,"end":27.736,"text":"And on the eye balls of the blind"},{"start":28.356,"end":29.718,"text":"To pour Celestial day."}],"start":21.228,"end":29.718},{"key":"4","lines":[{"start":31.488,"end":33.39,"text":"He comes the broken heart to bind"},{"start":34.01,"end":35.388,"text":"The bleeding soul to cure"},{"start":36.008,"end":37.739,"text":"And with the treasures of his grace"},{"start":38.359,"end":39.815,"text":"Enrich the humble poor."}],"start":31.488,"end":39.815},{"key":"5","lines":[{"start":41.585,"end":43.629,"text":"Our glad hossanas, Prince of peace"},{"start":44.249,"end":45.8,"text":"Thy welcome shall proclaim"},{"start":46.42,"end":48.408,"text":"And heaven's eternal arches ring"},{"start":49.028,"end":50.297,"text":"With Thy beloved name."}],"start":41.585,"end":50.297}]},"daniel":{"file":"en-187-daniel-s1.m4a","bytes":477192,"sha256":"c6b43f4b883a5bedd4cf36f7bca9d17241a9feaaa18126f