{"v":2,"coll":"en","num":407,"id":"hymn_407","title":"MERCIFUL Father in Thine Word","duration":53.888,"voices":{"grace":{"file":"en-407-grace-s1.m4a","bytes":484515,"sha256":"89f79344f0fef05a2c94fdf9a4b056c405c8dac597a9955b33c303ce5610db8a","duration":53.888,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.051,"text":"MERCIFUL Father in Thine Word"},{"start":2.671,"end":4.13,"text":"Eternal glory beams"},{"start":4.75,"end":6.595,"text":"Ever, Thine holy name to praise"},{"start":7.215,"end":8.648,"text":"For sacred book divine."}],"start":0.35,"end":8.648},{"key":"2","lines":[{"start":10.418,"end":12.509,"text":"In Thine word wretched poor is blessed"},{"start":13.129,"end":14.586,"text":"Infinite wealth is found"},{"start":15.206,"end":17.266,"text":"Wealth of the sort, world can not"},{"start":17.886,"end":19.592,"text":"give So sure and sure as life."}],"start":10.418,"end":19.592},{"key":"3","lines":[{"start":21.362,"end":23.139,"text":"The tree of knowledge is Thine word"},{"start":23.759,"end":25.148,"text":"Oh what grace He giveth"},{"start":25.768,"end":27.77,"text":"So much His savour, naught of earth"},{"start":28.39,"end":29.972,"text":"To men, Thine word appeal."}],"start":21.362,"end":29.972},{"key":"4","lines":[{"start":31.742,"end":33.651,"text":"Of Thine word, heard of Redeemer"},{"start":34.271,"end":35.694,"text":"Peaceful tiding proclaim"},{"start":36.314,"end":38.366,"text":"The sounding voice, of life it be"},{"start":38.986,"end":40.362,"text":"And everlasting joy."}],"start":31.742,"end":40.362},{"key":"5","lines":[{"start":42.132,"end":44.388,"text":"Christ Jesus, holy Teacher, Lord"},{"start":45.008,"end":46.216,"text":"Ever draw nigh to me"},{"start":46.836,"end":49.209,"text":"Thine Word, Lord, teach me all to love"},{"start":49.829,"end":51.419,"text":"Christ Jesus, me to find"}],"start":42.132,"end":51.419}]},"daniel":{"file":"en-407-daniel-s1.m4a","bytes":471569,"sha256":"8007016cedbb837e3fe9c3d89653ba6fdbadad11fb24ae14da2271211a