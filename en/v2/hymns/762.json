{"v":2,"coll":"en","num":762,"id":"hymn_762","title":"HUSH! blessed are the dead","duration":77.893,"voices":{"grace":{"file":"en-762-grace-s1.m4a","bytes":670102,"sha256":"fbd8808c9d393713cc379092684e3400e75ee7814aa45fb2e13e992710550e51","duration":77.893,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.8,"text":"HUSH! blessed are the dead"},{"start":2.42,"end":3.967,"text":"In Jesus’ arms who rest"},{"start":4.587,"end":5.958,"text":"And lean their weary head"},{"start":6.578,"end":7.973,"text":"Forever on His breast."}],"start":0.35,"end":7.973},{"key":"2","lines":[{"start":9.743,"end":10.927,"text":"Oh beautiful a sight!"},{"start":11.547,"end":13.188,"text":"No darkling veil between"},{"start":13.808,"end":15.199,"text":"They see the Light of Light"},{"start":15.819,"end":17.432,"text":"Whom here they loved unseen."}],"start":9.743,"end":17.432},{"key":"3","lines":[{"start":19.202,"end":20.765,"text":"For them the world is past"},{"start":21.385,"end":22.829,"text":"With all its toil and care"},{"start":23.449,"end":25.086,"text":"Its withering midnight blast"},{"start":25.706,"end":27.213,"text":"Its fiery noonday glare."}],"start":19.202,"end":27.213},{"key":"4","lines":[{"start":28.983,"end":30.575,"text":"Them the good shepherd leads"},{"start":31.195,"end":32.79,"text":"Where storms are never rife"},{"start":33.41,"end":34.775,"text":"In tranquil dewy meads"},{"start":35.395,"end":36.746,"text":"Beside the Fount of life."}],"start":28.983,"end":36.746},{"key":"5","lines":[{"start":38.516,"end":40.029,"text":"Ours only are the tears"},{"start":40.649,"end":42.069,"text":"Who weep around their tomb"},{"start":42.689,"end":44.113,"text":"The light of bygone years"},{"start":44.733,"end":46.256,"text":"And shadowing years to come."}],"start":38.516,"end":46.256},{"key":"6","lines":[{"start":48.026,"end":49.66,"text":"Their voice their touch their smile"},{"start":50.28,"end":51.91,"text":"Those love-spring flowing o'er"},{"start":52.53,"end":53.794,"text"