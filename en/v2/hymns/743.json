{"v":2,"coll":"en","num":743,"id":"hymn_743","title":"CHERUBIM and the Seraphim","duration":87.523,"voices":{"grace":{"file":"en-743-grace.m4a","bytes":770852,"sha256":"23e26e253450510f6f2977278aaa69d95faa95d9927642d7697358c37ee76dbc","duration":87.523,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.826,"text":"CHERUBIM and the Seraphim"},{"start":2.446,"end":3.82,"text":"Around the throne of God"},{"start":4.44,"end":6.241,"text":"All the day and night before Him"},{"start":6.861,"end":8.309,"text":"Songs of glory they rend."}],"start":0.35,"end":8.309},{"key":"CHORUS","lines":[{"start":10.079,"end":12.193,"text":"Singing glory, glory, glory"},{"start":12.813,"end":14.928,"text":"Singing glory, glory, glory."}],"start":10.079,"end":14.928},{"key":"2","lines":[{"start":16.698,"end":18.473,"text":"Ye members of Cherubim Band"},{"start":19.093,"end":20.502,"text":"Be all of good repute"},{"start":21.122,"end":22.93,"text":"All the existing earthly Band"},{"start":23.55,"end":24.882,"text":"In fellowship divine."}],"start":16.698,"end":24.882},{"key":"3","lines":[{"start":26.652,"end":28.439,"text":"Ye members of Seraphim Band"},{"start":29.059,"end":30.468,"text":"Be all of good repute"},{"start":31.088,"end":32.938,"text":"May we be merged with saints above"},{"start":33.558,"end":34.994,"text":"To praise and Him adore."}],"start":26.652,"end":34.994},{"key":"4","lines":[{"start":36.764,"end":38.316,"text":"The Holy Band in the highest"},{"start":38.936,"end":40.376,"text":"Watching as we fight on"},{"start":40.996,"end":42.673,"text":"And in one accord they chorus"},{"start":43.293,"end":44.866,"text":"Progress and march onward!"}],"start":36.764,"end":44.866},{"key":"5","lines":[{"start":46.636,"end":48.67,"text":"Through tribulations and the thorns"},{"start":49.29,"end":50.839,"text":"Through all earthly turmoil"},{"start":51.459,"end":53.457,"text":"Through the storm of life and tempest"},{"start":54.077,"end":55.632,"text":"Our paths He gently clear."}],"