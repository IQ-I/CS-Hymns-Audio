{"v":2,"coll":"en","num":98,"id":"hymn_98","title":"ALL ye Band of Seraph","duration":78.116,"voices":{"grace":{"file":"en-98-grace-s1.m4a","bytes":697943,"sha256":"fffdbddefac0b16549f86f98a17240da2fe2f5c41e5c5bdd8ed5eb1a61f45392","duration":78.116,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.679,"text":"ALL ye Band of Seraph"},{"start":2.299,"end":3.929,"text":"Come show the joy of your heart"},{"start":4.549,"end":6.079,"text":"Together sing a sweet song"},{"start":6.699,"end":8.605,"text":"For wondrous work he's done to us"},{"start":9.225,"end":11.579,"text":"For He has not let us go astray from His side."}],"start":0.35,"end":11.579},{"key":"CHORUS","lines":[{"start":13.349,"end":14.66,"text":"We’re marching to zion"},{"start":15.28,"end":16.95,"text":"Zion the greater! of all"},{"start":17.57,"end":19.173,"text":"We are marching forth to zion"},{"start":19.793,"end":21.292,"text":"The habitat of our God."}],"start":13.349,"end":21.292},{"key":"2","lines":[{"start":23.062,"end":24.291,"text":"O ye Praying Father"},{"start":24.911,"end":26.235,"text":"Give thanks to our God"},{"start":26.855,"end":28.585,"text":"That made you triumph o'er enemies"},{"start":29.205,"end":30.813,"text":"And let no enemy prevail"},{"start":31.433,"end":32.741,"text":"And has made you the head"},{"start":33.361,"end":34.859,"text":"And head till eternity."}],"start":23.062,"end":34.859},{"key":"3","lines":[{"start":36.629,"end":37.896,"text":"Ye Chorister's Band"},{"start":38.516,"end":40.097,"text":"Show forth the joy of your heart"},{"start":40.717,"end":42.385,"text":"For his firm strong covenants"},{"start":43.005,"end":44.608,"text":"Amidst the Band of Seraphim"},{"start":45.228,"end":46.276,"text":"That he fulfilled"},{"start":46.896,"end":48.394,"text":"And fill the world to come."}],"start":36.629,"end":48.394},{"key":"4","lines":[{"start":50.164,"end":51.464,"text":"People may be mocking"},{"start":52.084,"end":53.254,"text":"And may though condemn"},{"start":53.87