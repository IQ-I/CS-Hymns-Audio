{"v":2,"coll":"en","num":718,"id":"hymn_718","title":"GOD the Lord is King, before Him","duration":87.558,"voices":{"grace":{"file":"en-718-grace.m4a","bytes":798774,"sha256":"60699e7cf61dc8401bc6ae5ef71a039bbce0d729e3fbbaf5dcdea12d759b57ff","duration":87.558,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.337,"text":"GOD the Lord is King, before Him"},{"start":2.957,"end":4.68,"text":"Earth, with thy nations, wait"},{"start":5.3,"end":6.768,"text":"Where the cherubim adore Him"},{"start":7.388,"end":8.94,"text":"Sitteth He His royal state"},{"start":9.56,"end":10.457,"text":"He is holy"},{"start":11.077,"end":12.603,"text":"Blessed, only Potentate!"}],"start":0.35,"end":12.603},{"key":"2","lines":[{"start":14.373,"end":16.097,"text":"God the Lord is King of Glory"},{"start":16.717,"end":18.565,"text":"Zion, tell the world His fame"},{"start":19.185,"end":20.781,"text":"Ancient Israel, the story"},{"start":21.401,"end":23.036,"text":"Of His faithfulness proclaim"},{"start":23.656,"end":24.554,"text":"He is holy"},{"start":25.174,"end":26.75,"text":"Holy is His awful name."}],"start":14.373,"end":26.75},{"key":"3","lines":[{"start":28.52,"end":30.569,"text":"In old times when dangers darkened"},{"start":31.189,"end":33.098,"text":"When, invoked by priest and seer"},{"start":33.718,"end":35.582,"text":"To His people‘s cry He hearkened"},{"start":36.202,"end":37.769,"text":"Answer'd them in all their fear"},{"start":38.389,"end":39.287,"text":"He is holy"},{"start":39.907,"end":41.743,"text":"As they call‘d they found Him near."}],"start":28.52,"end":41.743},{"key":"4","lines":[{"start":43.513,"end":45.384,"text":"Laws divine to them were spoken"},{"start":46.004,"end":47.36,"text":"From the pillar of the cloud"},{"start":47.98,"end":50.133,"text":"I Sacred precepts, quickly broker"},{"start":50.753,"end":52.677,"text":"Fiercely then His vengeance flow'd"},{"start":53.297,"end":54.195,"text":"He is holy"},{"start":54.815,"end":56.514,"text":"To the dust thier hea