{"v":2,"coll":"en","num":687,"id":"hymn_687","title":"BEHOLD the bee so wise and brave","duration":42.362,"voices":{"grace":{"file":"en-687-grace.m4a","bytes":373915,"sha256":"6a7526e8fee24148aa859fe8dea0092a3e80bf6c0aa30464a3fab0081d81d319","duration":42.362,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.395,"text":"BEHOLD the bee so wise and brave"},{"start":3.015,"end":4.577,"text":"Atop all flow’ry shrubs"},{"start":5.197,"end":7.025,"text":"Busy ever, honey gathereth"},{"start":7.645,"end":9.181,"text":"From all shrubs deriveth."}],"start":0.35,"end":9.181},{"key":"2","lines":[{"start":10.951,"end":13.037,"text":"Behold how sweet, honey gathereth"},{"start":13.657,"end":14.939,"text":"into the comb he hath"},{"start":15.559,"end":17.636,"text":"All grief and pains thus endureth"},{"start":18.256,"end":19.671,"text":"Behold its jelly bright."}],"start":10.951,"end":19.671},{"key":"3","lines":[{"start":21.441,"end":23.319,"text":"Thus ought I to be brave and wise"},{"start":23.939,"end":25.302,"text":"In all I thus engage"},{"start":25.922,"end":27.859,"text":"Idle hands doth satan engage"},{"start":28.479,"end":30.127,"text":"in worthless toils and care."}],"start":21.441,"end":30.127},{"key":"4","lines":[{"start":31.897,"end":33.395,"text":"I shall endeavour to study"},{"start":34.015,"end":35.441,"text":"At so tender my age"},{"start":36.061,"end":38.008,"text":"And shall attend harder my toils"},{"start":38.628,"end":39.892,"text":"May I not be ashamed"}],"start":31.897,"end":39.892}]},"daniel":{"file":"en-687-daniel.m4a","bytes":372653,"sha256":"56e7dbf3d932a265a430e34c0c9d720a8428933768ea2911fe0f21f527bec1d4","duration":41.926,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.369,"text":"BEHOLD the bee so wise and brave"},{"start":2.989,"end":4.56,"text":"Atop all flow’ry shrubs"},{"start":5.18,"end":6.863,"text":"Busy ever, honey gathereth"},{"start":7.483,"end":8.973,"text":"From all shrubs deriveth."}],"start":0.35,"end":8.973},{"key":"2","lin