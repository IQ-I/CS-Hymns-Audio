{"v":2,"coll":"en","num":708,"id":"hymn_708","title":"OUR thanks offering, Father receive","duration":102.335,"voices":{"grace":{"file":"en-708-grace.m4a","bytes":907027,"sha256":"f5015164e3f9ccd2fee11d356ddeb06bbbfe50d27daaa67a274d62e3a48c75b9","duration":102.335,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.441,"text":"OUR thanks offering, Father receive"},{"start":3.061,"end":4.592,"text":"For today’s anniversary"},{"start":5.212,"end":6.926,"text":"For Thine protection and thy care"},{"start":7.546,"end":8.997,"text":"Receiveth often of Thee."}],"start":0.35,"end":8.997},{"key":"CHORUS","lines":[{"start":10.767,"end":11.741,"text":"Jehovah Jireh"},{"start":12.361,"end":14.054,"text":"Descend Thine blessings on us"},{"start":14.674,"end":16.355,"text":"Thine will may we ever observe"},{"start":16.975,"end":18.387,"text":"Lead us into Paradise."}],"start":10.767,"end":18.387},{"key":"2","lines":[{"start":20.157,"end":22.109,"text":"Holy Saviour, our thanks receive"},{"start":22.729,"end":24.301,"text":"For the victory, for us earn"},{"start":24.921,"end":26.698,"text":"When against us the devil rage"},{"start":27.318,"end":28.905,"text":"Unto us Thine help descend."}],"start":20.157,"end":28.905},{"key":"3","lines":[{"start":30.675,"end":32.135,"text":"Cherubim and ye Seraphim"},{"start":32.755,"end":34.577,"text":"Let us come, Father to praise"},{"start":35.197,"end":37.334,"text":"From destruction our souls He saved"},{"start":37.954,"end":39.521,"text":"And His help is ever nigh."}],"start":30.675,"end":39.521},{"key":"4","lines":[{"start":41.291,"end":42.932,"text":"Jehovah Shammah avail for us"},{"start":43.552,"end":44.974,"text":"Michael descend Thee to us"},{"start":45.594,"end":47.34,"text":"Vic-to-ry ever won for us"},{"start":47.96,"end":49.274,"text":"Glory be to trinity."}],"start":41.291,"end":49.274},{"key":"5","lines":[{"start":51.044,"end":52.837,"text":"Provider, God the procurer"},{"start":53.457,"end":54.999,"text":"Employment for us pr