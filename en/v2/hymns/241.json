{"v":2,"coll":"en","num":241,"id":"hymn_241","title":"ART thou weary art thou languid","duration":67.237,"voices":{"grace":{"file":"en-241-grace-s1.m4a","bytes":571018,"sha256":"cb1a0be2fdd13418c447fd8a4e4d2ff85db69b2a640d7d7db62785e8aa3ca572","duration":67.237,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.111,"text":"ART thou weary art thou languid"},{"start":2.731,"end":4.177,"text":"Art thou sore distress’d?"},{"start":4.797,"end":5.807,"text":"Come to me\" saith"},{"start":6.427,"end":7.98,"text":"The Holy one and “be at rest\""}],"start":0.35,"end":7.98},{"key":"2","lines":[{"start":9.75,"end":11.373,"text":"Hath He marks to lead me to Him"},{"start":11.993,"end":13.155,"text":"If he be my guide?"},{"start":13.775,"end":15.205,"text":"In His feet and hands are"},{"start":15.825,"end":16.791,"text":"wound prints"},{"start":17.411,"end":18.357,"text":"And His side."}],"start":9.75,"end":18.357},{"key":"3","lines":[{"start":20.127,"end":21.963,"text":"Is there diadem, as monarch,"},{"start":22.343,"end":23.663,"text":"That His brow adorns?"},{"start":24.283,"end":26.083,"text":"“Yea, a crown in very surety"},{"start":26.703,"end":27.666,"text":"But of Thorns."}],"start":20.127,"end":27.666},{"key":"4","lines":[{"start":29.436,"end":31.18,"text":"If I find Him, If I follow"},{"start":31.8,"end":32.947,"text":"What His guerdon here?"},{"start":33.567,"end":35.04,"text":"Many a sorrow many a labour"},{"start":35.66,"end":36.563,"text":"Many a tear."}],"start":29.436,"end":36.563},{"key":"5","lines":[{"start":38.333,"end":40.094,"text":"If I still hold closely to Him"},{"start":40.714,"end":41.853,"text":"What have he at last?"},{"start":42.473,"end":44.119,"text":"Sorrow vanquish'd labour ended"},{"start":44.739,"end":45.767,"text":"Jordan passed."}],"start":38.333,"end":45.767},{"key":"6","lines":[{"start":47.537,"end":49.223,"text":"If I ask Him to receive me"},{"start":49.843,"end":50.938,"text":"Will He say me nay?"},{"start":51.558,"end":53.33,"text":"No