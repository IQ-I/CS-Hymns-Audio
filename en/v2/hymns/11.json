{"v":2,"coll":"en","num":11,"id":"hymn_11","title":"Father, breathe an evening blessing","duration":62.764,"voices":{"grace":{"file":"en-11-grace.m4a","bytes":590441,"sha256":"dc75922912816fcf9286ce290fc9c17af1554d0e3b8d366c96e490419efbd38c","duration":62.764,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.244,"text":"Father, breathe an evening blessing"},{"start":2.864,"end":4.505,"text":"Ere repose our spirits seal,"},{"start":4.885,"end":6.855,"text":"Sin and want we come confessing:"},{"start":7.315,"end":9.301,"text":"Thou canst save and Thou canst heal."}],"start":0.35,"end":9.301},{"key":"2","lines":[{"start":11.071,"end":12.784,"text":"Though the night be dark and dreary,"},{"start":13.164,"end":14.914,"text":"Darkness cannot hide from Thee;"},{"start":15.374,"end":17.145,"text":"Thou art He who, never weary,"},{"start":17.525,"end":19.18,"text":"Watchest where Thy people be."}],"start":11.071,"end":19.18},{"key":"3","lines":[{"start":20.95,"end":22.688,"text":"Though destruction walk around us,"},{"start":23.068,"end":24.694,"text":"Though the arrows past us fly,"},{"start":25.074,"end":26.912,"text":"Angel guards from Thee surround us;"},{"start":27.372,"end":28.861,"text":"We are safe if Thou art nigh."}],"start":20.95,"end":28.861},{"key":"4","lines":[{"start":30.631,"end":32.417,"text":"Blessed Spirit, brooding o’er us,"},{"start":32.797,"end":34.421,"text":"Chase the darkness of our night,"},{"start":34.801,"end":36.45,"text":"Till the perfect day before us"},{"start":37.07,"end":38.777,"text":"Breaks in everlasting light."}],"start":30.631,"end":38.777},{"key":"5","lines":[{"start":40.547,"end":42.301,"text":"Father, to Thy holy keeping"},{"start":42.921,"end":44.55,"text":"Humbly we ourselves resign;"},{"start":45.01,"end":47.069,"text":"Saviour, who hast slept our sleeping,"},{"start":47.45,"end":49.251,"text":"Make our slumbers pure as Thine."}],"start":40.547,"end":49.251},{"key":"6","lines":[{"start":51.021,"end":52.665,"text":"Holy Spirit 