{"v":2,"coll":"en","num":829,"id":"hymn_829","title":"WE worship Thee, Halleluyah","duration":90.602,"voices":{"grace":{"file":"en-829-grace-s1.m4a","bytes":795310,"sha256":"35d5e0a3dc3456fd5b484d876042accadd436dfd2344b4ff95f7477620b614b8","duration":90.602,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.859,"text":"WE worship Thee, Halleluyah"},{"start":2.479,"end":3.61,"text":"Halle, Halleluyah"},{"start":4.23,"end":6.232,"text":"Our Sacred God, whom we worship"},{"start":6.852,"end":8.405,"text":"Will make our joy o'er flow."}],"start":0.35,"end":8.405},{"key":"CHORUS","lines":[{"start":10.175,"end":11.579,"text":"There is a pleasant abode"},{"start":12.198,"end":13.78,"text":"Change never there exist"},{"start":14.4,"end":16.242,"text":"There is no dusk but ever dawn"},{"start":16.863,"end":18.336,"text":"Joy shall Seraphim gain."}],"start":10.175,"end":18.336},{"key":"2","lines":[{"start":20.106,"end":22.08,"text":"Awake! Awake! All ye faithfuls"},{"start":22.7,"end":24.271,"text":"Hark, Seraphim proclaim"},{"start":24.891,"end":26.586,"text":"The infidels wrought “miracles”"},{"start":27.206,"end":28.704,"text":"And the faithfuls despise."}],"start":20.106,"end":28.704},{"key":"3","lines":[{"start":30.474,"end":32.173,"text":"Many are sins that all abound"},{"start":32.793,"end":34.072,"text":"But the worst of them all"},{"start":34.692,"end":36.676,"text":"Sins committed ‘gainst Holy Ghost"},{"start":37.296,"end":38.554,"text":"Not ever forgiven."}],"start":30.474,"end":38.554},{"key":"4","lines":[{"start":40.324,"end":41.978,"text":"Many are tribulations here"},{"start":42.598,"end":43.877,"text":"But the worst of them all"},{"start":44.497,"end":46.493,"text":"Financial abysmal, ill health"},{"start":47.113,"end":48.52,"text":"Jesus conquer for us."}],"start":40.324,"end":48.52},{"key":"5","lines":[{"start":50.29,"end":52.105,"text":"Ain’t no reward here reap on earth"},{"start":52.725,"end":54.125,"text":"For members of Seraph"},{"start":54.745,"end"