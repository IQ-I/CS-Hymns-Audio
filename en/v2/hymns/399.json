{"v":2,"coll":"en","num":399,"id":"hymn_399","title":"O Word of God incarnate","duration":77.101,"voices":{"grace":{"file":"en-399-grace-s1.m4a","bytes":728258,"sha256":"808c30e1bbc4f9578d1e0d2346fccd384f24ac62901266857d9b573be6049316","duration":77.101,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.946,"text":"O Word of God incarnate"},{"start":2.566,"end":4.009,"text":"O Wisdom from on high"},{"start":4.629,"end":6.72,"text":"O truth unchanged, unchanging"},{"start":7.34,"end":8.818,"text":"O Light of our dark sky"},{"start":9.438,"end":11.096,"text":"We praise Thee for the radiance"},{"start":11.716,"end":13.174,"text":"That from the hallowed page"},{"start":13.794,"end":15.367,"text":"A lantern to our footsteps"},{"start":15.987,"end":17.644,"text":"Shines on from age to age."}],"start":0.35,"end":17.644},{"key":"2","lines":[{"start":19.414,"end":21.04,"text":"The Church from her dear Master"},{"start":21.66,"end":23.142,"text":"Receive the gift divine"},{"start":23.762,"end":25.447,"text":"And still that light she lifteth"},{"start":26.067,"end":27.448,"text":"O‘er all the earth to shine"},{"start":28.068,"end":29.54,"text":"It is the golden casket"},{"start":30.16,"end":31.747,"text":"Where gems of truth are stored"},{"start":32.367,"end":34.073,"text":"It is the heaven‐drawn picture"},{"start":34.693,"end":36.31,"text":"Of Christ, the living Word."}],"start":19.414,"end":36.31},{"key":"3","lines":[{"start":38.08,"end":39.513,"text":"It floateth like a banner"},{"start":40.133,"end":41.874,"text":"Before God’s host unfurled;"},{"start":42.334,"end":43.811,"text":"It shineth like a beacon"},{"start":44.431,"end":45.811,"text":"Above the darkling world"},{"start":46.431,"end":47.961,"text":"It is a chart and compass"},{"start":48.581,"end":50.167,"text":"That, o’er life’s surging sea"},{"start":50.787,"end":52.915,"text":"Mid mists, and rocks, and quick-sands"},{"start":53.535,"end":55.297,"text":"Still guides, O Christ, to Thee."}],"start":38.08,"end":55.297},{"key":"4","lines":[{"start":57.067,"end":59.035,"text":"O make Thy Church, dear Saviour"},{"start":59.655,"end":61.143,"text":"A lamp of burnished gold"},{"start":61.763,"end":63.265,"text":"To bear before the nations"},{"start":63.885,"end":65.576,"text":"Thy true light, as of old"},{"start":66.196,"end":68.12,"text":"O teach Thy wandering pilgrims"},{"start":68.74,"end":70.334,"text":"By this their path to trace"},{"start":70.954,"end":72.762,"text":"Till, clouds and darkness ended,"},{"start":73.142,"end":74.632,"text":"They see Thee face to face."}],"start":57.067,"end":74.632}]},"daniel":{"file":"en-399-daniel-s1.m4a","bytes":717070,"sha256":"8e11f6281d1f28d327034d1a5558fa90093a63c66046ecbe13eaceeb0bdddf38","duration":76.052,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.96,"text":"O Word of God incarnate"},{"start":2.58,"end":3.962,"text":"O Wisdom from on high"},{"start":4.582,"end":6.585,"text":"O truth unchanged, unchanging"},{"start":7.205,"end":8.638,"text":"O Light of our dark sky"},{"start":9.258,"end":10.944,"text":"We praise Thee for the radiance"},{"start":11.564,"end":13.049,"text":"That from the hallowed page"},{"start":13.669,"end":15.334,"text":"A lantern to our footsteps"},{"start":15.954,"end":17.614,"text":"Shines on from age to age."}],"start":0.35,"end":17.614},{"key":"2","lines":[{"start":19.384,"end":20.989,"text":"The Church from her dear Master"},{"start":21.609,"end":23.061,"text":"Receive the gift divine"},{"start":23.681,"end":25.386,"text":"And still that light she lifteth"},{"start":26.006,"end":27.41,"text":"O‘er all the earth to shine"},{"start":28.03,"end":29.4,"text":"It is the golden casket"},{"start":30.02,"end":31.613,"text":"Where gems of truth are stored"},{"start":32.233,"end":33.846,"text":"It is the heaven‐drawn picture"},{"start":34.466,"end":35.907,"text":"Of Christ, the living Word."}],"start":19.384,"end":35.907},{"key":"3","lines":[{"start":37.677,"end":39.114,"text":"It floateth like a banner"},{"star