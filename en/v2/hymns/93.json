{"v":2,"coll":"en","num":93,"id":"hymn_93","title":"NOW thank we all our God","duration":55.457,"voices":{"grace":{"file":"en-93-grace-s1.m4a","bytes":510716,"sha256":"e4539655d76d696e41a0e53d78c1b2a958c95cb0af5bbf1b195d7c70588d4eaa","duration":55.457,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.889,"text":"NOW thank we all our God"},{"start":2.509,"end":4.308,"text":"With heart and hands and voices"},{"start":4.928,"end":6.504,"text":"Who wondrous things hath done"},{"start":7.124,"end":8.974,"text":"In whom His world rejoices"},{"start":9.594,"end":11.052,"text":"Who from our mother's arms"},{"start":11.672,"end":13.179,"text":"Hath bless‘d us on our way"},{"start":13.799,"end":15.414,"text":"With countless gifts of love"},{"start":16.034,"end":17.49,"text":"And still is ours today."}],"start":0.35,"end":17.49},{"key":"2","lines":[{"start":19.26,"end":20.773,"text":"Oh may this bounteous God"},{"start":21.393,"end":23.002,"text":"Through all our life be near us,"},{"start":23.382,"end":24.905,"text":"With ever joyful hearts"},{"start":25.525,"end":27.038,"text":"And blessed peace to cheer us,"},{"start":27.418,"end":28.864,"text":"And keep us in His grace"},{"start":29.484,"end":30.945,"text":"And guide us when perplex'd"},{"start":31.565,"end":33.105,"text":"And free us from all ills"},{"start":33.725,"end":35.246,"text":"In this world and the next."}],"start":19.26,"end":35.246},{"key":"3","lines":[{"start":37.016,"end":38.699,"text":"All praise and thanks to God"},{"start":39.319,"end":40.689,"text":"The Father now be given"},{"start":41.309,"end":42.815,"text":"The Son, and Holy Ghost"},{"start":43.435,"end":44.955,"text":"Supreme in highest heaven"},{"start":45.575,"end":46.866,"text":"The One eternal God"},{"start":47.486,"end":49.032,"text":"Whom earth and heaven adore"},{"start":49.652,"end":51.087,"text":"For this it was, is now"},{"start":51.707,"end":52.987,"text":"And shall be evermore."}],"start":37.016,"end":52.987}]},"daniel":{"file":"en-93