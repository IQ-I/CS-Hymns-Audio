{"v":2,"coll":"en","num":601,"id":"hymn_601","title":"RESCUE the perishing, care for the dying","duration":49.932,"voices":{"grace":{"file":"en-601-grace-s1.m4a","bytes":456106,"sha256":"4672a0c5968990788a8654d7f809a995ad98efdca52ade1d2a2fd7e94922de03","duration":49.932,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.633,"text":"RESCUE the perishing, care for the dying"},{"start":3.253,"end":5.717,"text":"Snatch them in pity from sin and the grave"},{"start":6.337,"end":7.745,"text":"Weep o‘er the erring ones"},{"start":8.365,"end":9.521,"text":"Lift up the fallen"},{"start":10.141,"end":12.151,"text":"Tell them of Jesus the Mighty to save."}],"start":0.35,"end":12.151},{"key":"CHORUS","lines":[{"start":13.921,"end":15.148,"text":"Rescue the perishing,"},{"start":15.528,"end":16.557,"text":"care for the dying"},{"start":17.177,"end":18.611,"text":"Jesus is merciful,"},{"start":18.991,"end":20.185,"text":"Jesus will save."}],"start":13.921,"end":20.185},{"key":"2","lines":[{"start":21.955,"end":23.219,"text":"Though they are slighting Him"},{"start":23.839,"end":25.032,"text":"Still He is waiting"},{"start":25.652,"end":27.663,"text":"Waiting the penitent child to receive"},{"start":28.283,"end":29.697,"text":"Plead with them earnestly,"},{"start":30.077,"end":31.365,"text":"Plead with them gently"},{"start":31.985,"end":33.997,"text":"He will forgive if thy only believe."}],"start":21.955,"end":33.997},{"key":"3","lines":[{"start":35.767,"end":38.019,"text":"Rescue the perishing, duty demands it"},{"start":38.639,"end":40.971,"text":"Strength for thy labour the Lord will provide"},{"start":41.591,"end":42.84,"text":"Back to the narrow way"},{"start":43.46,"end":44.594,"text":"Patiently win them"},{"start":45.214,"end":47.462,"text":"Tell the poor wand‘rer a Saviour had died."}],"start":35.767,"end":47.462}]},"daniel":{"file":"en-601-daniel-s1.m4a","bytes":449261,"sha256":"8509112a77286e8ef5b829cc6a77aaf181885e243c47fc4c04a1b9ffa95e0372","duration":49.505,"segm