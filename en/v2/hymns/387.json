{"v":2,"coll":"en","num":387,"id":"hymn_387","title":"OUR blest Redeemer, ere He breathed","duration":62.084,"voices":{"grace":{"file":"en-387-grace-s1.m4a","bytes":550998,"sha256":"a874692fffd7724021e30b515210d943f4f501eb862ce55d1a37300d82e624e5","duration":62.084,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.371,"text":"OUR blest Redeemer, ere He breathed"},{"start":2.991,"end":4.463,"text":"His tender last farewell"},{"start":5.083,"end":6.992,"text":"A Guide, a Comforter bequeathed"},{"start":7.612,"end":8.66,"text":"With us to dwell."}],"start":0.35,"end":8.66},{"key":"2","lines":[{"start":10.43,"end":12.181,"text":"He came in semblance of a dove"},{"start":12.801,"end":14.501,"text":"With sheltering wings outspread"},{"start":15.121,"end":17.08,"text":"The holy balm of peace and love"},{"start":17.7,"end":18.779,"text":"On each to shed."}],"start":10.43,"end":18.779},{"key":"3","lines":[{"start":20.549,"end":22.597,"text":"He comes sweet influence to impart"},{"start":23.217,"end":24.783,"text":"A gracious, willing Guest"},{"start":25.403,"end":27.41,"text":"While He can find one humble heart"},{"start":28.03,"end":29.088,"text":"Wherein to rest."}],"start":20.549,"end":29.088},{"key":"4","lines":[{"start":30.858,"end":32.853,"text":"And His that gentle voice we hear"},{"start":33.473,"end":35.097,"text":"Soft as the breath of even"},{"start":35.717,"end":38.19,"text":"That checks each fault, that calms each fear"},{"start":38.81,"end":39.986,"text":"And speaks of heaven."}],"start":30.858,"end":39.986},{"key":"5","lines":[{"start":41.756,"end":43.516,"text":"And every virtue we possess"},{"start":44.136,"end":45.733,"text":"And every conquest won"},{"start":46.353,"end":47.999,"text":"And every thought of holiness"},{"start":48.619,"end":49.583,"text":"Are His alone."}],"start":41.756,"end":49.583},{"key":"6","lines":[{"start":51.353,"end":53.097,"text":"Spirit of purity and grace"},{"start":53.717,"end":55.303,"text":"Our weakness, pitying, see"},{"s