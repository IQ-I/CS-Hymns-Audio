{"v":2,"coll":"en","num":631,"id":"hymn_631","title":"O Jesus I have promised","duration":86.577,"voices":{"grace":{"file":"en-631-grace-s1.m4a","bytes":830886,"sha256":"1c49212d52aa3a768db253a7375558ce8539483e6d615247f054a2bc1493c8b3","duration":86.577,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.946,"text":"O Jesus I have promised"},{"start":2.566,"end":3.935,"text":"To serve Thee to the end;"},{"start":4.395,"end":5.801,"text":"Be Thou forever near me,"},{"start":6.181,"end":7.66,"text":"My master and my friend;"},{"start":8.12,"end":9.505,"text":"I shall not tear the battle"},{"start":10.125,"end":11.586,"text":"If thou art by my side,"},{"start":11.966,"end":13.588,"text":"Nor wander from the pathway"},{"start":14.208,"end":15.563,"text":"If thou will be my Guide."}],"start":0.35,"end":15.563},{"key":"2","lines":[{"start":17.333,"end":18.763,"text":"Oh let me feel Thee near me;"},{"start":19.223,"end":20.608,"text":"The world is ever drear;"},{"start":21.068,"end":22.665,"text":"I see the sights that dazzle"},{"start":23.285,"end":24.713,"text":"The tempting sounds I hear;"},{"start":25.173,"end":26.72,"text":"My foes are ever near me,"},{"start":27.1,"end":28.314,"text":"Around me and within;"},{"start":28.774,"end":30.57,"text":"But, Jesus, draw Thou nearer,"},{"start":30.95,"end":32.483,"text":"And shield my soul from sin."}],"start":17.333,"end":32.483},{"key":"3","lines":[{"start":34.253,"end":35.689,"text":"Oh let me hear Thee speaking"},{"start":36.309,"end":37.867,"text":"In accents clear and still,"},{"start":38.247,"end":39.781,"text":"Above the storms of passion,"},{"start":40.161,"end":41.536,"text":"The murmurs of self-will;"},{"start":41.996,"end":43.352,"text":"Oh speak to reassure me"},{"start":43.972,"end":45.492,"text":"To hasten, or control;"},{"start":45.952,"end":47.654,"text":"Oh speak, and make me listen,"},{"start":48.034,"end":49.493,"text":"Thou Guardian of my soul."}],"start":34.253,"end":49.493},{"key":"4","lines":[{"start":51.263,"end":53.071,"text":"O Jesus, Thou hast promised"},{"start":53.691,"end":54.83,"text":"To all who follow Thee"},{"start":55.45,"end":57.032,"text":"That where Thou art in glory"},{"start":57.652,"end":59.021,"text":"There shall Thy servant be"},{"start":59.641,"end":61.189,"text":"And Jesus I have promised"},{"start":61.809,"end":63.177,"text":"To serve Thee to the end!"},{"start":63.797,"end":65.34,"text":"Oh give me grace to follow,"},{"start":65.72,"end":67.204,"text":"My Master and my Friend."}],"start":51.263,"end":67.204},{"key":"5","lines":[{"start":68.974,"end":70.495,"text":"Oh let me see Thy footmarks"},{"start":71.115,"end":72.659,"text":"And in them plant mine own;"},{"start":73.119,"end":74.575,"text":"My hope to follow duly"},{"start":75.195,"end":76.596,"text":"Is in Thy strength alone,"},{"start":76.976,"end":78.606,"text":"Oh guide me, call me,draw me,"},{"start":78.986,"end":80.262,"text":"Uphold me to the end;"},{"start":80.722,"end":82.298,"text":"And then in heaven receive me,"},{"start":82.678,"end":84.108,"text":"My Saviour and my Friend."}],"start":68.974,"end":84.108}]},"daniel":{"file":"en-631-daniel-s1.m4a","bytes":831588,"sha256":"7cdbceef44233bc4d146b962e26e4002d854c12e98facc4ebaf2679164136b14","duration":85.837,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.85,"text":"O Jesus I have promised"},{"start":2.47,"end":3.784,"text":"To serve Thee to the end;"},{"start":4.244,"end":5.594,"text":"Be Thou forever near me,"},{"start":5.974,"end":7.427,"text":"My master and my friend;"},{"start":7.887,"end":9.247,"text":"I shall not tear the battle"},{"start":9.867,"end":11.355,"text":"If thou art by my side,"},{"start":11.735,"end":13.392,"text":"Nor wander from the pathway"},{"start":14.012,"end":15.376,"text":"If thou will be my Guide."}],"start":0.35,"end":15.376},{"key":"2","lines":[{"start":17.146,"end":18.534,"text":"Oh let me feel Thee near me;"},{"start":18.994,"end":20.46,"text":"The world is ever drear;"},{"start":20.92,"e