{"v":2,"coll":"en","num":258,"id":"hymn_258","title":"I LAY my sins on Jesus","duration":72.121,"voices":{"grace":{"file":"en-258-grace.m4a","bytes":691559,"sha256":"4b2ef43cde8a68df5378610dd440ad5385f2ab7cc9cac40aa4a21c185746fd5e","duration":72.121,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.99,"text":"I LAY my sins on Jesus"},{"start":2.61,"end":4.095,"text":"The spotless Lamb of God"},{"start":4.715,"end":6.393,"text":"He bears them all and frees us"},{"start":7.013,"end":8.352,"text":"From the accursed load"},{"start":8.972,"end":10.521,"text":"I bring my guilt to Jesus"},{"start":11.141,"end":12.76,"text":"To wash my crimson stains"},{"start":13.38,"end":15.179,"text":"White in His blood most precious"},{"start":15.799,"end":17.125,"text":"Till not a spot remains."}],"start":0.35,"end":17.125},{"key":"2","lines":[{"start":18.895,"end":20.544,"text":"I lay my wants on Jesus"},{"start":21.164,"end":22.616,"text":"All fullness dwells in Him"},{"start":23.236,"end":24.868,"text":"He heals all my diseases;"},{"start":25.328,"end":26.786,"text":"He doth my soul redeem,"},{"start":27.166,"end":28.832,"text":"I lay my grieves on Jesus,"},{"start":29.212,"end":30.737,"text":"My burdens and my cares;"},{"start":31.197,"end":32.89,"text":"He from them all releases;"},{"start":33.35,"end":34.785,"text":"He all my sorrows shares."}],"start":18.895,"end":34.785},{"key":"3","lines":[{"start":36.555,"end":38.203,"text":"I rest my soul on Jesus,"},{"start":38.583,"end":40.035,"text":"This weary soul of mine;"},{"start":40.495,"end":42.165,"text":"His right hand me embraces;"},{"start":42.625,"end":44.103,"text":"I on His breast recline,"},{"start":44.483,"end":45.975,"text":"I love the name of Jesus"},{"start":46.595,"end":48.132,"text":"Emmanuel, Christ the Lord;"},{"start":48.592,"end":50.255,"text":"Like fragrance on the breezes"},{"start":50.875,"end":52.408,"text":"His name abroad is pour'd."}],"start":36.555,"end":52.408},{"key":"4","lines":[{"start":54.178,"end":55.714,"text":"I long to be like Jesus,"},{"start":56.094,"end":57.824,"text":"Meek, loving, lowly, mild;"},{"start":58.284,"end":59.82,"text":"I long to be like Jesus,"},{"start":60.2,"end":61.597,"text":"The Father's Holy Child,"},{"start":61.977,"end":63.466,"text":"I long to be with Jesus,"},{"start":63.846,"end":65.275,"text":"Amid the heavenly throne"},{"start":65.895,"end":67.621,"text":"To sing with saints His praises"},{"start":68.241,"end":69.651,"text":"And learn the Angels‘ song."}],"start":54.178,"end":69.651}]},"daniel":{"file":"en-258-daniel.m4a","bytes":696914,"sha256":"d8f61c4758d749a8c8de79ecc1f82fc907b5cfe0584c42791d8403f18e747b40","duration":71.806,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.985,"text":"I LAY my sins on Jesus"},{"start":2.605,"end":4.084,"text":"The spotless Lamb of God"},{"start":4.704,"end":6.348,"text":"He bears them all and frees us"},{"start":6.968,"end":8.301,"text":"From the accursed load"},{"start":8.921,"end":10.502,"text":"I bring my guilt to Jesus"},{"start":11.122,"end":12.762,"text":"To wash my crimson stains"},{"start":13.382,"end":15.144,"text":"White in His blood most precious"},{"start":15.764,"end":17.18,"text":"Till not a spot remains."}],"start":0.35,"end":17.18},{"key":"2","lines":[{"start":18.95,"end":20.575,"text":"I lay my wants on Jesus"},{"start":21.195,"end":22.613,"text":"All fullness dwells in Him"},{"start":23.233,"end":24.91,"text":"He heals all my diseases;"},{"start":25.37,"end":26.773,"text":"He doth my soul redeem,"},{"start":27.153,"end":28.866,"text":"I lay my grieves on Jesus,"},{"start":29.246,"end":30.759,"text":"My burdens and my cares;"},{"start":31.219,"end":32.793,"text":"He from them all releases;"},{"start":33.253,"end":34.688,"text":"He all my sorrows shares."}],"start":18.95,"end":34.688},{"key":"3","lines":[{"start":36.458,"end":38.149,"text":"I rest my soul on Jesus,"},{"start":38.529,"end":39.997,"text":"This weary soul of mine;"},{"start":40.457,"end":42.089,"text":"