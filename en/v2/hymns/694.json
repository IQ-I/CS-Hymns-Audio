{"v":2,"coll":"en","num":694,"id":"hymn_694","title":"SOLEMNLY without a romp","duration":98.077,"voices":{"grace":{"file":"en-694-grace-s1.m4a","bytes":924829,"sha256":"116956008f4fece5148059824e9e371212195dea68371b23857d171b06309227","duration":98.077,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.86,"text":"SOLEMNLY without a romp"},{"start":2.48,"end":4.148,"text":"Solemnly the sun doth rise"},{"start":4.768,"end":6.454,"text":"When at sunrise doth emerge"},{"start":7.074,"end":9.016,"text":"Men the sky, the sun may gaze"},{"start":9.636,"end":11.558,"text":"Gently its gleams brighter raise"},{"start":12.178,"end":14.152,"text":"Gently, brighter grows in strength"},{"start":14.772,"end":16.499,"text":"Brighter, growing forth to peak"},{"start":17.119,"end":18.637,"text":"To the glory ne'er to gaze."}],"start":0.35,"end":18.637},{"key":"2","lines":[{"start":20.407,"end":22.063,"text":"Darkness with o’erwhelming might"},{"start":22.683,"end":24.362,"text":"Nay with sound worthy of note"},{"start":24.982,"end":26.809,"text":"Gentle moon and shinning stars"},{"start":27.429,"end":28.911,"text":"Beaming light upon the earth"},{"start":29.531,"end":31.28,"text":"Nay with roaring sound doth come"},{"start":31.9,"end":33.487,"text":"Mighty drips of heav'nly dew"},{"start":34.107,"end":35.615,"text":"All around the earth descend"},{"start":36.235,"end":37.914,"text":"Nay with sound worthy of note."}],"start":20.407,"end":37.914},{"key":"3","lines":[{"start":39.684,"end":41.498,"text":"Mys-te-rious the deeds of God"},{"start":42.118,"end":43.694,"text":"Amidst the Seraphim fold"},{"start":44.314,"end":45.902,"text":"Though feeble and frail we be"},{"start":46.522,"end":48.152,"text":"And we decreaseth in strength"},{"start":48.772,"end":50.221,"text":"But the providence of God"},{"start":50.841,"end":52.484,"text":"On us all day doth descend"},{"start":53.104,"end":54.758,"text":"By the power and might of God"},{"start":55.378,"end":56.953,"text":"This abode doth accomplish."}],"start":39.684,"end":56.953},{"key":"4","lines":[{"start":58.723,"end":60.553,"text":"This day God our thanks we give"},{"start":61.173,"end":62.852,"text":"Members of Seraphim fold"},{"start":63.472,"end":64.989,"text":"All the young and all the old"},{"start":65.609,"end":67.477,"text":"Male folks and the female folks"},{"start":68.097,"end":69.596,"text":"Host and visitors alike"},{"start":70.216,"end":71.75,"text":"Our thanks we offer to Thee"},{"start":72.37,"end":73.812,"text":"In this sanctuary divine"},{"start":74.432,"end":76.058,"text":"All our thanks Father receive."}],"start":58.723,"end":76.058},{"key":"5","lines":[{"start":77.828,"end":79.31,"text":"Father God, the Trinity"},{"start":79.93,"end":81.707,"text":"Who art this fold established"},{"start":82.327,"end":84.134,"text":"This house consecrate we plead"},{"start":84.754,"end":86.56,"text":"By Thine power and sacred might"},{"start":87.18,"end":88.897,"text":"Descend Lord today we plead"},{"start":89.517,"end":91.127,"text":"With Holy Spirit inspire"},{"start":91.747,"end":93.319,"text":"Adopt us all, Thine to be"},{"start":93.939,"end":95.607,"text":"Here on earth and there above."}],"start":77.828,"end":95.607}]},"daniel":{"file":"en-694-daniel-s1.m4a","bytes":928506,"sha256":"a2d38f4a0530ae717f84ab0a933c5ec5105966bc010c5e6d7371a3d3e92c659a","duration":97.059,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.722,"text":"SOLEMNLY without a romp"},{"start":2.342,"end":3.994,"text":"Solemnly the sun doth rise"},{"start":4.614,"end":6.337,"text":"When at sunrise doth emerge"},{"start":6.957,"end":8.666,"text":"Men the sky, the sun may gaze"},{"start":9.286,"end":11.192,"text":"Gently its gleams brighter raise"},{"start":11.812,"end":13.735,"text":"Gently, brighter grows in strength"},{"start":14.355,"end":16.064,"text":"Brighter, growing forth to peak"},{"start":16.684,"end":18.192,"text":"To the glory ne'er to gaze."}],"start":0.35,"end":18.192},{"key":"2","lines":[{"start":19.962