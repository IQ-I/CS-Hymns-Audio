{"v":2,"coll":"en","num":817,"id":"hymn_817","title":"HOLY Spirit, dead reviving","duration":111.604,"voices":{"grace":{"file":"en-817-grace-s1.m4a","bytes":1031103,"sha256":"4cf89b623130936bcb18a549f9596170e5faf4f90fef505e7075486a26abcdc6","duration":111.604,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.29,"text":"HOLY Spirit, dead reviving"},{"start":2.91,"end":4.588,"text":"We bow down before Thine throne"},{"start":5.208,"end":7.397,"text":"Stretch forth Thine hand of life on us"},{"start":8.017,"end":9.443,"text":"All we multitude renew"},{"start":10.063,"end":11.703,"text":"Thou Son of Father incarnate"},{"start":12.323,"end":14.325,"text":"Prophet, priest and Saviour Lord."}],"start":0.35,"end":14.325},{"key":"CHORUS","lines":[{"start":16.095,"end":18.043,"text":"Saviour divine, Saviour divine"},{"start":18.663,"end":20.647,"text":"Saviour divine, save our souls."}],"start":16.095,"end":20.647},{"key":"2","lines":[{"start":22.417,"end":24.191,"text":"Band of Cherubim here on earth"},{"start":24.811,"end":26.249,"text":"Unite in one accord all"},{"start":26.869,"end":28.624,"text":"Band of Seraphim here on earth"},{"start":29.244,"end":30.988,"text":"Work in love and one accord"},{"start":31.608,"end":33.322,"text":"Be of help to us as we work"},{"start":33.942,"end":35.651,"text":"Lest we fail nor exhausted."}],"start":22.417,"end":35.651},{"key":"3","lines":[{"start":37.421,"end":39.096,"text":"Work on in the name of Jesus"},{"start":39.716,"end":41.338,"text":"Discountenance the mockers"},{"start":41.958,"end":43.756,"text":"Book of Matthew the tenth chapter"},{"start":44.376,"end":46.079,"text":"Read the verse of ten and six"},{"start":46.699,"end":48.373,"text":"Descend now in Thine Majesty"},{"start":48.993,"end":50.458,"text":"Amidst Band of Seraphim."}],"start":37.421,"end":50.458},{"key":"4","lines":[{"start":52.228,"end":53.954,"text":"Fellowship with us in goodwill"},{"start":54.574,"end":56.075,"text":"With Thine Word enlighten us"},{"start