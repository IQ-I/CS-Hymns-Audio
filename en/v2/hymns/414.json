{"v":2,"coll":"en","num":414,"id":"hymn_414","title":"JESUS helps expectant mother","duration":93.203,"voices":{"grace":{"file":"en-414-grace-s1.m4a","bytes":826673,"sha256":"1be8d8d946b3e60600ebb5664b987c990fcf1c16f5b4f0c4329ef8f7a7a073cd","duration":93.203,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.244,"text":"JESUS helps expectant mother"},{"start":2.864,"end":4.256,"text":"We need not be afrightened"},{"start":4.876,"end":6.671,"text":"Our Lord and saviour is Jesus"},{"start":7.291,"end":8.683,"text":"We need not be afrightened."}],"start":0.35,"end":8.683},{"key":"CHORUS","lines":[{"start":10.453,"end":12.234,"text":"You need not fear But be of Joy"},{"start":12.854,"end":15.117,"text":"For Jesus is ever with Seraph (Cherub)"},{"start":15.737,"end":17.493,"text":"How serious condition may be"},{"start":18.113,"end":19.556,"text":"You’ll ever be triumphant."}],"start":10.453,"end":19.556},{"key":"2","lines":[{"start":21.326,"end":23.024,"text":"Ye Seraph expectant mothers"},{"start":23.644,"end":25.136,"text":"Look up to Jesus only"},{"start":25.756,"end":27.694,"text":"And put all thy trust on His love"},{"start":28.314,"end":29.68,"text":"You will safely deliver."}],"start":21.326,"end":29.68},{"key":"3","lines":[{"start":31.45,"end":33.416,"text":"Our Lord whose life was like to us"},{"start":34.036,"end":35.746,"text":"Nine months in mothers belly"},{"start":36.366,"end":37.864,"text":"In Bethlehem of Judea"},{"start":38.484,"end":40.102,"text":"The joy of birth was chorused."}],"start":31.45,"end":40.102},{"key":"4","lines":[{"start":41.872,"end":43.621,"text":"What is the cause of all your fear"},{"start":44.241,"end":45.961,"text":"Ye soldier of Christ Jesus"},{"start":46.581,"end":48.372,"text":"Since Jesus with us e‘er abide"},{"start":48.992,"end":50.376,"text":"Joy will ever be with us."}],"start":41.872,"end":50.376},{"key":"5","lines":[{"start":52.146,"end":54.077,"text":"From all witches and all wizards"},{"start":54.697,"end":56.297,"te