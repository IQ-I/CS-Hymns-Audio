{"v":2,"coll":"en","num":36,"id":"hymn_36","title":"WHEN shall it Be my Saviour Lord","duration":41.082,"voices":{"grace":{"file":"en-36-grace-s1.m4a","bytes":351631,"sha256":"6da850c4e0c9213b9206df36f038799d8daa60bccc5992807916eb6a679ae254","duration":41.082,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.154,"text":"WHEN shall it Be my Saviour Lord"},{"start":2.774,"end":4.23,"text":"Gentle, Thee, I may see"},{"start":4.85,"end":6.71,"text":"In Thine rest ladden with blessing"},{"start":7.33,"end":8.619,"text":"Without a covering veil."}],"start":0.35,"end":8.619},{"key":"2","lines":[{"start":10.389,"end":12.257,"text":"Be of help to me while I trod"},{"start":12.877,"end":14.423,"text":"Amidst earthly desires"},{"start":15.043,"end":16.719,"text":"May I in love pray unto Thee"},{"start":17.339,"end":18.96,"text":"Harken unto my prayers."}],"start":10.389,"end":18.96},{"key":"3","lines":[{"start":20.73,"end":22.698,"text":"Father, Thy saving grace I plead"},{"start":23.318,"end":24.663,"text":"My soul I offer Thee"},{"start":25.283,"end":26.849,"text":"All of me receive to be Thine"},{"start":27.469,"end":28.791,"text":"Offer Thine self to me."}],"start":20.73,"end":28.791},{"key":"4","lines":[{"start":30.561,"end":32.257,"text":"Thine Spirit, Father, me endow"},{"start":32.877,"end":34.136,"text":"Let Him abide with me"},{"start":34.756,"end":36.631,"text":"Shining Light, be Him to my feet"},{"start":37.251,"end":38.613,"text":"Unto eternal rest"}],"start":30.561,"end":38.613}]},"daniel":{"file":"en-36-daniel-s1.m4a","bytes":357246,"sha256":"0d6d502b89e731599765d013fc6d6b99a3b0a918ff9482a190c0e17eb90387d6","duration":40.841,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.193,"text":"WHEN shall it Be my Saviour Lord"},{"start":2.813,"end":4.128,"text":"Gentle, Thee, I may see"},{"start":4.748,"end":6.555,"text":"In Thine rest ladden with blessing"},{"start":7.175,"end":8.503,"text":"Without a covering veil."}],"start":0.35,"end":8.503},{"key":"2","line