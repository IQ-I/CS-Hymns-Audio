{"v":2,"coll":"en","num":56,"id":"hymn_56","title":"CHRIST Jesus hath the pow'r","duration":93.46,"voices":{"grace":{"file":"en-56-grace.m4a","bytes":857609,"sha256":"a6dfbe0ce93f32f3002201bc3386412077c261a600955d6b2338686597f8e37e","duration":93.46,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.998,"text":"CHRIST Jesus hath the pow'r"},{"start":2.618,"end":3.935,"text":"The power to forgive"},{"start":4.555,"end":6.004,"text":"The pow'r to quicken whom"},{"start":6.624,"end":8.475,"text":"He will And make the sinner live"},{"start":9.095,"end":10.743,"text":"Christ Jesus hath the pow'r"},{"start":11.363,"end":12.694,"text":"O tell it far and near!"},{"start":13.314,"end":15.096,"text":"O bring to Him your guilty heart"},{"start":15.716,"end":17.188,"text":"And grace shall banish fear!"}],"start":0.35,"end":17.188},{"key":"CHORUS","lines":[{"start":18.958,"end":20.606,"text":"Christ Jesus hath the pow'r"},{"start":21.226,"end":22.815,"text":"The pow'r of God He wields!"},{"start":23.435,"end":25.083,"text":"Christ Jesus hath the pow'r"},{"start":25.703,"end":27.227,"text":"My heart surrender yields!"},{"start":27.847,"end":29.495,"text":"Christ Jesus hath the pow'r"},{"start":30.115,"end":31.441,"text":"l trust Him ever-more"},{"start":32.061,"end":33.709,"text":"Christ Jesus hath the pow'r"},{"start":34.329,"end":35.606,"text":"I worship and adore!"}],"start":18.958,"end":35.606},{"key":"2","lines":[{"start":37.376,"end":39.024,"text":"Christ Jesus hath the pow’r"},{"start":39.644,"end":40.725,"text":"The power to renew"},{"start":41.345,"end":43.299,"text":"The pow’r to cleanse your heart from sin,"},{"start":43.679,"end":45.101,"text":"And make you wholly true"},{"start":45.721,"end":47.369,"text":"Christ Jesus hath the pow'r"},{"start":47.989,"end":49.273,"text":"For evermore to keep"},{"start":49.893,"end":51.813,"text":"O none can pluck you from His hand"},{"start":52.433,"end":53.848,"text":"Or rob Him of His sheep"}],"start":37.376,"end":53.848},{"key