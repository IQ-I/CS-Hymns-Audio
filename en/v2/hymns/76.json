{"v":2,"coll":"en","num":76,"id":"hymn_76","title":"COME,Thou Holy Paraclete","duration":80.626,"voices":{"grace":{"file":"en-76-grace-s1.m4a","bytes":692417,"sha256":"e98c69d56c411256793592f59cc070767ec27356f9b654ced2f3f207c3d2e79f","duration":80.626,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.366,"text":"COME, Thou Holy"},{"start":1.986,"end":3.425,"text":"Paraclete And from Thy"},{"start":4.045,"end":6.549,"text":"celestial seat Send Thy light and brilliancy."}],"start":0.35,"end":6.549},{"key":"2","lines":[{"start":8.319,"end":10.015,"text":"Father of the poor, draw near"},{"start":10.635,"end":12.222,"text":"Giver of all gifts, be here"},{"start":12.842,"end":14.886,"text":"Come, the soul’s true radiancy."}],"start":8.319,"end":14.886},{"key":"3","lines":[{"start":16.656,"end":18.334,"text":"Come, of comforters the best"},{"start":18.954,"end":20.676,"text":"Of the soul the sweetest Guest"},{"start":21.296,"end":22.844,"text":"Come in toil refreshingly."}],"start":16.656,"end":22.844},{"key":"4","lines":[{"start":24.614,"end":26.383,"text":"Thou in labour rest most sweet"},{"start":27.003,"end":28.576,"text":"Thou art shadow from the heat"},{"start":29.196,"end":30.548,"text":"Comfort in adversity."}],"start":24.614,"end":30.548},{"key":"5","lines":[{"start":32.318,"end":34.225,"text":"O Thou Light, most pure and blest"},{"start":34.845,"end":36.604,"text":"Shine within the inmost breast"},{"start":37.224,"end":38.764,"text":"Of Thy faithful company."}],"start":32.318,"end":38.764},{"key":"6","lines":[{"start":40.534,"end":42.389,"text":"Where Thou art not, man hath nought"},{"start":43.009,"end":44.593,"text":"Every holy deed and thought"},{"start":45.213,"end":46.513,"text":"Comes from Thy Divinity."}],"start":40.534,"end":46.513},{"key":"7","lines":[{"start":48.283,"end":49.893,"text":"What is soiled, make Thou pure"},{"start":50.513,"end":52.176,"text":"What is wounded, work its cure"},{"start":52.796,"end":54.257,"text":"What is parched, fortify.