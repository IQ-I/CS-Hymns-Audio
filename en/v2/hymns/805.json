{"v":2,"coll":"en","num":805,"id":"hymn_805","title":"THE Keeper of all creation","duration":71.823,"voices":{"grace":{"file":"en-805-grace-s1.m4a","bytes":633317,"sha256":"a3d8bd63150a332d8e215ada2cf5e64df9fdc693274c4c5bc2e397dab25871e0","duration":71.823,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.946,"text":"THE Keeper of all creation"},{"start":2.566,"end":3.843,"text":"Our Omnipotent God"},{"start":4.463,"end":6.372,"text":"With all our tongues and all our lips"},{"start":6.992,"end":8.336,"text":"Offer to Thee our praise."}],"start":0.35,"end":8.336},{"key":"2","lines":[{"start":10.106,"end":11.961,"text":"The young and the old give Thee thanks"},{"start":12.581,"end":13.94,"text":"Thou protecteth us all"},{"start":14.56,"end":16.512,"text":"For Thine mercies and Thy blessings"},{"start":17.132,"end":18.665,"text":"On us from ages past."}],"start":10.106,"end":18.665},{"key":"3","lines":[{"start":20.435,"end":22.864,"text":"Burst into joy, soliders of Christ"},{"start":23.484,"end":24.878,"text":"And to thee sacred Bands"},{"start":25.498,"end":27.122,"text":"For this anniversary, today"},{"start":27.742,"end":29.175,"text":"On the surface of earth."}],"start":20.435,"end":29.175},{"key":"4","lines":[{"start":30.945,"end":32.82,"text":"Glorious in Holiness, we plead"},{"start":33.44,"end":34.773,"text":"Make us to all be Thine"},{"start":35.393,"end":37.09,"text":"May we not ever Thee reject"},{"start":37.71,"end":39.028,"text":"But ever worship Thee."}],"start":30.945,"end":39.028},{"key":"5","lines":[{"start":40.798,"end":42.796,"text":"Further we pray, further we plead"},{"start":43.416,"end":44.791,"text":"In this existing year"},{"start":45.411,"end":46.806,"text":"Be benevolent to us all"},{"start":47.426,"end":48.917,"text":"Thine favour all we plead."}],"start":40.798,"end":48.917},{"key":"6","lines":[{"start":50.687,"end":52.505,"text":"Divine Guide of all creations"},{"start":53.125,"end":54.45,"text":"Guide us all to the end"},{"start":55.07,"end":57.154,"text":"Thine blessings may not satan snatch"},{"start":57.774,"end":59.161,"text":"May we be not at loss."}],"start":50.687,"end":59.161},{"key":"7","lines":[{"start":60.931,"end":63.007,"text":"As we worship and praise Thee Lord"},{"start":63.627,"end":65.085,"text":"On planet earth below"},{"start":65.705,"end":67.452,"text":"Make us all worthy of Thy praise"},{"start":68.072,"end":69.354,"text":"In heaven high above."}],"start":60.931,"end":69.354}]},"daniel":{"file":"en-805-daniel-s1.m4a","bytes":647518,"sha256":"94cb70be980611aeb8bb0d0751b3e6d8fc63e4df5efef6c12b0b66c5d9392eeb","duration":71.804,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.922,"text":"THE Keeper of all creation"},{"start":2.542,"end":3.908,"text":"Our Omnipotent God"},{"start":4.528,"end":6.346,"text":"With all our tongues and all our lips"},{"start":6.966,"end":8.297,"text":"Offer to Thee our praise."}],"start":0.35,"end":8.297},{"key":"2","lines":[{"start":10.067,"end":11.92,"text":"The young and the old give Thee thanks"},{"start":12.54,"end":13.925,"text":"Thou protecteth us all"},{"start":14.545,"end":16.479,"text":"For Thine mercies and Thy blessings"},{"start":17.099,"end":18.609,"text":"On us from ages past."}],"start":10.067,"end":18.609},{"key":"3","lines":[{"start":20.379,"end":22.756,"text":"Burst into joy, soliders of Christ"},{"start":23.377,"end":24.827,"text":"And to thee sacred Bands"},{"start":25.447,"end":27.074,"text":"For this anniversary, today"},{"start":27.694,"end":29.066,"text":"On the surface of earth."}],"start":20.379,"end":29.066},{"key":"4","lines":[{"start":30.836,"end":32.675,"text":"Glorious in Holiness, we plead"},{"start":33.295,"end":34.696,"text":"Make us to all be Thine"},{"start":35.316,"end":37.059,"text":"May we not ever Thee reject"},{"start":37.679,"end":38.969,"text":"But ever worship Thee."}],"start":30.836,"end":38.969},{"key":"5","lines":[{"start":40.739,"end":42.785,"text":"Further we pray, further we plead"},{"start":43.