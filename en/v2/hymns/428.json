{"v":2,"coll":"en","num":428,"id":"hymn_428","title":"Behold the throne of grace","duration":41.16,"voices":{"grace":{"file":"en-428-grace.m4a","bytes":359145,"sha256":"a574a54d4142151521b95ff358279b72d2983d0d3f1b929afc681c8776249626","duration":41.16,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.816,"text":"Behold the throne of grace"},{"start":2.436,"end":3.913,"text":"Thy promise calls me near"},{"start":4.533,"end":6.485,"text":"There Jesus shows a smiling face"},{"start":7.105,"end":8.636,"text":"And waits to answer prayer."}],"start":0.35,"end":8.636},{"key":"2","lines":[{"start":10.406,"end":11.849,"text":"That rich atoning blood"},{"start":12.469,"end":14.026,"text":"Which sprinkled round I see"},{"start":14.646,"end":16.52,"text":"Provides for those who come to God"},{"start":17.14,"end":18.482,"text":"An all-prevailing plea."}],"start":10.406,"end":18.482},{"key":"3","lines":[{"start":20.252,"end":21.846,"text":"Beyond thine utmost wants"},{"start":22.466,"end":24.279,"text":"His love and pow'r can bless"},{"start":24.899,"end":26.842,"text":"To praying souls He always grants"},{"start":27.462,"end":28.882,"text":"More than they can express."}],"start":20.252,"end":28.882},{"key":"4","lines":[{"start":30.652,"end":32.363,"text":"Thine image, Lord, bestow"},{"start":32.983,"end":34.451,"text":"Thine mercies Lord endow"},{"start":35.071,"end":36.788,"text":"I ask to serve Thee here below"},{"start":37.408,"end":38.69,"text":"And reign with Thee above."}],"start":30.652,"end":38.69}]},"daniel":{"file":"en-428-daniel.m4a","bytes":356642,"sha256":"aafa7e571092c1619828827808be8f3ed2e199658b8b8c240457cde743860aa5","duration":40.752,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.814,"text":"Behold the throne of grace"},{"start":2.434,"end":3.853,"text":"Thy promise calls me near"},{"start":4.473,"end":6.366,"text":"There Jesus shows a smiling face"},{"start":6.986,"end":8.515,"text":"And waits to answer prayer."}],"start":0.35,"end":8.515},{"key":"2