{"v":2,"coll":"en","num":725,"id":"hymn_725","title":"WE are/Thee O Lord","duration":54.385,"voices":{"grace":{"file":"en-725-grace.m4a","bytes":461377,"sha256":"efb699452f03d7a7a411fe4abd8bbe24cc5051de253d9115cc50f4a5d05ef337","duration":54.385,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.533,"text":"WE are/Thee O Lord"},{"start":2.153,"end":4.092,"text":"Thou head of the Church/of Thy people"},{"start":4.712,"end":6.504,"text":"The Churches here on earth/and in"},{"start":7.124,"end":8.209,"text":"heav'n Hallelujah."}],"start":0.35,"end":8.209},{"key":"CHORUS","lines":[{"start":9.979,"end":10.787,"text":"Hallelujah."},{"start":11.407,"end":12.093,"text":"Amen."}],"start":9.979,"end":12.093},{"key":"2","lines":[{"start":13.863,"end":15.524,"text":"Thou who died/and rose for us"},{"start":16.144,"end":18.15,"text":"Who is with the Father/pleading for us"},{"start":18.77,"end":20.223,"text":"Glory and honour/be to Thee"},{"start":20.843,"end":21.651,"text":"Hallelujah."}],"start":13.863,"end":21.651},{"key":"3","lines":[{"start":23.421,"end":25.336,"text":"And on great day/of Pentecost"},{"start":25.956,"end":27.887,"text":"Thou who sent Paraclete/to the World"},{"start":28.507,"end":30.391,"text":"His comfort is a/biding with us"},{"start":31.011,"end":32.096,"text":"Halle/lujah."}],"start":23.421,"end":32.096},{"key":"4","lines":[{"start":33.866,"end":35.657,"text":"FromThy throne above/in the sky"},{"start":36.277,"end":37.95,"text":"Where He’s looking/at His servants"},{"start":38.57,"end":40.273,"text":"He is coming/for His martyrs"},{"start":40.893,"end":41.7,"text":"Hallelujah."}],"start":33.866,"end":41.7},{"key":"5","lines":[{"start":43.47,"end":46.019,"text":"Praises, honour and majesty/to His name"},{"start":46.639,"end":48.169,"text":"For the death/of His servant"},{"start":48.789,"end":50.211,"text":"Throughout/the world at large"},{"start":50.831,"end":51.915,"text":"Halle/lujah."}],"start":43.47,"end":51.915}]},"daniel":{"file":"en-725-daniel.