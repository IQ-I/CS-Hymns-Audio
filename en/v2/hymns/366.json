{"v":2,"coll":"en","num":366,"id":"hymn_366","title":"THERE is a Blessed Home","duration":72.243,"voices":{"grace":{"file":"en-366-grace-s1.m4a","bytes":661756,"sha256":"dbf0b42235ae94dac5c2dbacde45904266bf07cb4fa52f29d91caf2f70aca278","duration":72.243,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.523,"text":"THERE is a Blessed Home"},{"start":2.143,"end":3.558,"text":"Beyond this land of woe"},{"start":4.178,"end":5.63,"text":"Where trials never come"},{"start":6.25,"end":7.734,"text":"Nor tears of sorrows flow"},{"start":8.354,"end":10.008,"text":"Where faith is lost in sight"},{"start":10.628,"end":12.111,"text":"And patient hope is crowned"},{"start":12.731,"end":14.166,"text":"And everlasting light"},{"start":14.786,"end":16.326,"text":"Its glory throws around."}],"start":0.35,"end":16.326},{"key":"2","lines":[{"start":18.096,"end":19.499,"text":"There is a land of peace"},{"start":20.119,"end":21.531,"text":"Good Angels know it well"},{"start":22.151,"end":23.848,"text":"Glad songs that never cease"},{"start":24.468,"end":25.814,"text":"Within its portals swell"},{"start":26.434,"end":27.938,"text":"Around its glorious Throne"},{"start":28.558,"end":30.054,"text":"Ten thousand Saints adore"},{"start":30.674,"end":32.232,"text":"CHRIST, with the FATHER, ONE"},{"start":32.852,"end":34.055,"text":"And SPIRIT, evermore."}],"start":18.096,"end":34.055},{"key":"3","lines":[{"start":35.825,"end":37.415,"text":"Oh! joy all joys beyond,"},{"start":37.795,"end":39.185,"text":"To see the LAMB who died"},{"start":39.805,"end":41.438,"text":"And count each sacred Wound"},{"start":42.058,"end":43.755,"text":"In Hands, and feet, and Side"},{"start":44.375,"end":45.829,"text":"To give to Him the praise"},{"start":46.449,"end":47.894,"text":"Of every triumph won"},{"start":48.514,"end":50.147,"text":"And sing through endless days"},{"start":50.767,"end":52.158,"text":"The great things He hath done."}],"start":35.825,"end":52.158},{"key":"4","lines":[{"start":53.928,"e