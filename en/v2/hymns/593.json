{"v":2,"coll":"en","num":593,"id":"hymn_593","title":"O Saviour, may we never rest","duration":43.115,"voices":{"grace":{"file":"en-593-grace-s1.m4a","bytes":384152,"sha256":"9adc890264d6d337329449080a0cb96824e2513f28fad4ca068c3289ea65bc3e","duration":43.115,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.232,"text":"O Saviour, may we never rest"},{"start":2.852,"end":4.343,"text":"Till Thou art formed within"},{"start":4.963,"end":7.144,"text":"Till Thou hast claimed our troubl’d breast"},{"start":7.764,"end":9.178,"text":"And crush’d the pow’r of sin."}],"start":0.35,"end":9.178},{"key":"2","lines":[{"start":10.948,"end":12.642,"text":"O may we gaze upon Thy Cross"},{"start":13.262,"end":14.665,"text":"Until the wondrous sight"},{"start":15.285,"end":17.451,"text":"Makes earthly treasures seems but dross"},{"start":18.071,"end":19.578,"text":"And earthly sorrows light."}],"start":10.948,"end":19.578},{"key":"3","lines":[{"start":21.348,"end":23.273,"text":"Until releas’d from carnal ties"},{"start":23.893,"end":25.518,"text":"Our spirit upward springs"},{"start":26.138,"end":28.137,"text":"And sees true peace above the skies"},{"start":28.757,"end":30.444,"text":"True joy in heav’nly things."}],"start":21.348,"end":30.444},{"key":"4","lines":[{"start":32.214,"end":34.184,"text":"There as we gaze, may we become"},{"start":34.804,"end":36.259,"text":"United, Lord, to Thee"},{"start":36.879,"end":38.591,"text":"And in fairer, happier home"},{"start":39.211,"end":40.646,"text":"Thy perfect beauty see."}],"start":32.214,"end":40.646}]},"daniel":{"file":"en-593-daniel-s1.m4a","bytes":380943,"sha256":"54d2be0c317c1e21a5aba6e891a295380a9a8c5aa5dd923f1ffc6ad432f4bbc9","duration":42.463,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.134,"text":"O Saviour, may we never rest"},{"start":2.754,"end":4.248,"text":"Till Thou art formed within"},{"start":4.868,"end":7.042,"text":"Till Thou hast claimed our troubl’d breast"},{"start":7.662,"end":9.097,"text":"And crush