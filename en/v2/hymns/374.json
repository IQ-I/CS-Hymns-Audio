{"v":2,"coll":"en","num":374,"id":"hymn_374","title":"TELL me the same old, story","duration":75.176,"voices":{"grace":{"file":"en-374-grace-s1.m4a","bytes":697483,"sha256":"575ff881c918933284c41a84b29851adb6a525fc2d443019564335fb8ca48cd8","duration":75.176,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.93,"text":"TELL me the same old, story"},{"start":2.55,"end":4.081,"text":"Of unseen things above,"},{"start":4.461,"end":6.168,"text":"Of Jesus and His glory,"},{"start":6.548,"end":8.18,"text":"Of Jesus and His love,"},{"start":8.56,"end":9.857,"text":"Tell me the story simply,"},{"start":10.237,"end":11.538,"text":"As to a little child;"},{"start":11.998,"end":13.484,"text":"For I am weak, and weary"},{"start":14.104,"end":15.701,"text":"And helpless, and defiled."}],"start":0.35,"end":15.701},{"key":"CHORUS","lines":[{"start":17.471,"end":19.105,"text":"Tell me the old, old story"},{"start":19.725,"end":21.372,"text":"Of Jesus and His love."}],"start":17.471,"end":21.372},{"key":"2","lines":[{"start":23.142,"end":24.508,"text":"Tell me the story slowly,"},{"start":24.888,"end":26.087,"text":"That I may take it in"},{"start":26.707,"end":28.305,"text":"That wonderful redemption,"},{"start":28.685,"end":30.036,"text":"God’s remedy for sin,"},{"start":30.416,"end":31.732,"text":"Tell me the story often,"},{"start":32.112,"end":33.438,"text":"For I forget so soon;"},{"start":33.898,"end":35.203,"text":"The early dew of morning"},{"start":35.823,"end":37.202,"text":"Has passed away at noon."}],"start":23.142,"end":37.202},{"key":"3","lines":[{"start":38.972,"end":40.378,"text":"Tell me the story softly"},{"start":40.998,"end":42.602,"text":"With earnest tones and grave;"},{"start":43.062,"end":44.436,"text":"Remember, I’m the sinner"},{"start":45.056,"end":46.664,"text":"Whom Jesus came to save"},{"start":47.284,"end":48.69,"text":"Tell me the story always,"},{"start":49.07,"end":50.252,"text":"If you would really be"},{"start":50.872,"end":52.137,"text":"In an