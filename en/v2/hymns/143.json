{"v":2,"coll":"en","num":143,"id":"hymn_143","title":"ALL Christian Churches of the world","duration":110.234,"voices":{"grace":{"file":"en-143-grace-s1.m4a","bytes":974218,"sha256":"63478e7d6fd8206bbddfe7829a87083fca84c1dfd3f23117963026e0d408b7da","duration":110.234,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.222,"text":"ALL Christian Churches of the world"},{"start":2.842,"end":4.175,"text":"Be ye ever draw nigh"},{"start":4.795,"end":6.509,"text":"To learn the true way of the Lord"},{"start":7.129,"end":8.472,"text":"In the Band of Seraphim."}],"start":0.35,"end":8.472},{"key":"CHORUS","lines":[{"start":10.242,"end":11.622,"text":"Join us shout Hallelujah"},{"start":12.242,"end":13.59,"text":"To the Al-Almighty God"},{"start":14.21,"end":15.918,"text":"We give thanks and praise to Him"},{"start":16.538,"end":18.021,"text":"Who has called us to this band."}],"start":10.242,"end":18.021},{"key":"2","lines":[{"start":19.791,"end":21.437,"text":"There is no band like Seraphim"},{"start":22.057,"end":23.399,"text":"In all the world we know"},{"start":24.019,"end":25.627,"text":"Whose Captain is Holy Michael"},{"start":26.247,"end":27.646,"text":"Like Cherubim Seraphim."}],"start":19.791,"end":27.646},{"key":"3","lines":[{"start":29.416,"end":31.174,"text":"Our guide is the Holy Spirit"},{"start":31.794,"end":33.179,"text":"That no one ever knows"},{"start":33.799,"end":35.373,"text":"Only the Visioners of God"},{"start":35.993,"end":37.294,"text":"Can testify to it."}],"start":29.416,"end":37.294},{"key":"4","lines":[{"start":39.064,"end":40.871,"text":"The Brothers and all our sisters"},{"start":41.491,"end":43.171,"text":"In this our glorious Band"},{"start":43.791,"end":45.505,"text":"The Christian Army of this world"},{"start":46.125,"end":47.581,"text":"Let sing the glorious song."}],"start":39.064,"end":47.581},{"key":"5","lines":[{"start":49.351,"end":51.097,"text":"The witches and all the wizards"},{"start":51.717,"end":53.27,"text":"Have no power on