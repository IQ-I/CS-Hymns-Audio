{"v":2,"coll":"en","num":359,"id":"hymn_359","title":"COME worship our God Jehovah","duration":96.448,"voices":{"grace":{"file":"en-359-grace-s1.m4a","bytes":875303,"sha256":"4f130e514939914154c4a63c89ace87e5546b3f687aa427aa247b8d272fd2bf1","duration":96.448,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.041,"text":"COME worship our God Jehovah"},{"start":2.661,"end":4.283,"text":"Lord of hyper love divine"},{"start":4.903,"end":6.662,"text":"The conqueror and super victor"},{"start":7.282,"end":8.867,"text":"King of heaven and of earth."}],"start":0.35,"end":8.867},{"key":"CHORUS","lines":[{"start":10.637,"end":12.19,"text":"Deep and deep is \"The Wand\""},{"start":12.81,"end":14.346,"text":"And in-com-pre-hen-si-ble,"},{"start":14.726,"end":16.28,"text":"Deep and deep is \"The Wand\""},{"start":16.9,"end":18.435,"text":"And in-com-pre-hen-si-ble."}],"start":10.637,"end":18.435},{"key":"2","lines":[{"start":20.205,"end":22.069,"text":"Thus all creatures Thou hath formed"},{"start":22.689,"end":24.286,"text":"At Thine will all Thou hath made"},{"start":24.906,"end":26.679,"text":"Affirmative utterer Thou art"},{"start":27.299,"end":29.191,"text":"None can comprehend Thine being."}],"start":20.205,"end":29.191},{"key":"3","lines":[{"start":30.961,"end":32.575,"text":"Where hath hitherto been no way"},{"start":33.195,"end":35.012,"text":"There right is my seat be found"},{"start":35.632,"end":37.561,"text":"By my divine strength and status"},{"start":38.181,"end":39.877,"text":"Amidst my fold there I dwell."}],"start":30.961,"end":39.877},{"key":"4","lines":[{"start":41.647,"end":43.275,"text":"Can anyone counter my will"},{"start":43.895,"end":45.323,"text":"When my glorious works are"},{"start":45.943,"end":47.752,"text":"wrought Even powerful Arch‐Angel"},{"start":48.372,"end":49.996,"text":"My prowess they never dare."}],"start":41.647,"end":49.996},{"key":"5","lines":[{"start":51.766,"end":53.458,"text":"Lucifer of greater valour"},{"start":54.078,"end":55