{"v":2,"coll":"en","num":99,"id":"hymn_99","title":"ALL ye Band of Seraphim","duration":126.369,"voices":{"grace":{"file":"en-99-grace-s1.m4a","bytes":1097840,"sha256":"ce653ea8ddae33140b3ea50b16a590432e9449e2512a4852686d68bb59d5c78a","duration":126.369,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.711,"text":"ALL ye Band of Seraphim"},{"start":2.331,"end":3.763,"text":"And ye fold of Cherubim"},{"start":4.383,"end":6.164,"text":"Give all praises unto our God"},{"start":6.784,"end":8.193,"text":"Who spared us till this day."}],"start":0.35,"end":8.193},{"key":"CHORUS","lines":[{"start":9.963,"end":11.524,"text":"I cannot but offer thanks"},{"start":12.144,"end":13.705,"text":"I cannot but offer thanks"},{"start":14.325,"end":16.044,"text":"For all good receiveth of God"},{"start":16.664,"end":18.298,"text":"I can not but offer thanks."}],"start":9.963,"end":18.298},{"key":"2","lines":[{"start":20.068,"end":21.474,"text":"Satan truely rages"},{"start":22.094,"end":23.377,"text":"But can not overcome"},{"start":23.997,"end":25.495,"text":"By the power of our trinity"},{"start":26.115,"end":27.489,"text":"We shall be victorious."}],"start":20.068,"end":27.489},{"key":"3","lines":[{"start":29.259,"end":30.738,"text":"Though one else had passed on"},{"start":31.358,"end":32.829,"text":"Others incarcerated"},{"start":33.449,"end":35.225,"text":"And some other trod on the ground"},{"start":35.845,"end":37.535,"text":"Got knocked down and passed on."}],"start":29.259,"end":37.535},{"key":"4","lines":[{"start":39.305,"end":40.825,"text":"Thanks we give unto God"},{"start":41.445,"end":42.819,"text":"For His mercies on us"},{"start":43.439,"end":45.132,"text":"For all our request He granted"},{"start":45.752,"end":47.107,"text":"Glory be unto God."}],"start":39.305,"end":47.107},{"key":"5","lines":[{"start":48.877,"end":50.348,"text":"Merciful Father God"},{"start":50.968,"end":52.269,"text":"Be merciful to us"},{"start":52.889,"end":54.696,"text":"Provide for all our daily needs"},{"start":55.316,"end":56.798,"text":"Let Thy peace dwell with us."}],"start":48.877,"end":56.798},{"key":"6","lines":[{"start":58.568,"end":60.002,"text":"Healing grant to the sick"},{"start":60.622,"end":62.281,"text":"Jesus Christ Saviour Lord"},{"start":62.901,"end":64.636,"text":"Let all the Sick receive from Thee"},{"start":65.256,"end":66.735,"text":"Divine, perfect healing."}],"start":58.568,"end":66.735},{"key":"7","lines":[{"start":68.505,"end":69.942,"text":"Divine promise fulfil"},{"start":70.562,"end":71.8,"text":"Jehovah Thabbicubb"},{"start":72.42,"end":74.183,"text":"Restore the sight to all the blind"},{"start":74.803,"end":76.286,"text":"And give strength to the weak."}],"start":68.505,"end":76.286},{"key":"8","lines":[{"start":78.056,"end":79.407,"text":"Many had gone astray"},{"start":80.027,"end":81.451,"text":"They can not find The Way"},{"start":82.071,"end":83.562,"text":"Many leaders supposedly"},{"start":84.182,"end":85.468,"text":"Weary and retreating."}],"start":78.056,"end":85.468},{"key":"9","lines":[{"start":87.238,"end":88.506,"text":"Jehovah Jireh God"},{"start":89.126,"end":90.59,"text":"Provide for all our needs"},{"start":91.21,"end":93.047,"text":"Bless the barren With good children"},{"start":93.667,"end":95.303,"text":"Thy blessings let's receive."}],"start":87.238,"end":95.303},{"key":"10","lines":[{"start":97.073,"end":98.545,"text":"Merciful father God"},{"start":99.165,"end":100.591,"text":"Forgive us all our sins"},{"start":101.211,"end":103.041,"text":"Do not recompense all our sins"},{"start":103.661,"end":105.102,"text":"Rain Thy blessings on us."}],"start":97.073,"end":105.102},{"key":"11","lines":[{"start":106.872,"end":108.376,"text":"Blessing give unto Kings"},{"start":108.996,"end":110.283,"text":"And to the council too"},{"start":110.903,"end":112.788,"text":"Let peace supreme reign in our land"},{"start":113.408,"end":114.946,"text":"Cast civil strife away."}],"start":106.872,"end":114.946},{"key":"