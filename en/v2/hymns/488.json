{"v":2,"coll":"en","num":488,"id":"hymn_488","title":"SEE these ones in white apparel","duration":60.034,"voices":{"grace":{"file":"en-488-grace.m4a","bytes":544036,"sha256":"1e7c47455e1eeca5a9370a9ec90792a725615f2bf1863a07b53361774ee3f632","duration":60.034,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.103,"text":"SEE these ones in white apparel"},{"start":2.723,"end":4.37,"text":"Standing by the river's brink"},{"start":4.99,"end":6.814,"text":"Their back turned to the world and sin"},{"start":7.434,"end":9.028,"text":"And waiting to be baptized"},{"start":9.648,"end":10.68,"text":"And expecting"},{"start":11.3,"end":12.963,"text":"To fulfill the Lord’s command."}],"start":0.35,"end":12.963},{"key":"2","lines":[{"start":14.733,"end":16.669,"text":"Behold, how they stand there in fear"},{"start":17.289,"end":18.761,"text":"But they not of hope bereft"},{"start":19.381,"end":20.939,"text":"They know that their blessed Saviour"},{"start":21.559,"end":22.901,"text":"Commanded their immersion"},{"start":23.521,"end":24.696,"text":"Jordan is cold"},{"start":25.316,"end":27.031,"text":"But their faith is waxing hot."}],"start":14.733,"end":27.031},{"key":"3","lines":[{"start":28.801,"end":30.819,"text":"Behold and see, other brethren"},{"start":31.439,"end":33.174,"text":"Their elders in Jesus Christ"},{"start":33.794,"end":35.806,"text":"Stretch our hands of love to help then"},{"start":36.426,"end":37.963,"text":"They have been like them before"},{"start":38.583,"end":39.549,"text":"At this moment"},{"start":40.169,"end":42.027,"text":"They rejoice in pard'ning grace."}],"start":28.801,"end":42.027},{"key":"4","lines":[{"start":43.797,"end":45.671,"text":"Go, follow your Saviour and Lord"},{"start":46.291,"end":47.822,"text":"Behold with the eye of faith"},{"start":48.442,"end":50.514,"text":"The heavens open: God's spirit"},{"start":51.134,"end":52.529,"text":"Loudly saying from heaven"},{"start":53.149,"end":54.298,"text":"These disciples"},{"start":54.918,"e