{"v":2,"coll":"en","num":427,"id":"hymn_427","title":"O Lord, art Thou examined me","duration":62.042,"voices":{"grace":{"file":"en-427-grace.m4a","bytes":549544,"sha256":"17ae6cb0c0d86fd064a2346c9bbd8a39a3f948e72121f0355bb46a66db3f89c3","duration":62.042,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.353,"text":"O Lord, art Thou examined me"},{"start":2.973,"end":4.415,"text":"I, the work of Thy hand"},{"start":5.035,"end":6.758,"text":"My sitting and my uprightness"},{"start":7.378,"end":8.672,"text":"Are not hidden from Thee."}],"start":0.35,"end":8.672},{"key":"2","lines":[{"start":10.442,"end":12.296,"text":"In my house and in my panways"},{"start":12.915,"end":14.311,"text":"Thou art surrounded me"},{"start":14.931,"end":16.923,"text":"No thought or word of mine is hid"},{"start":17.543,"end":18.805,"text":"All are known unto Thee."}],"start":10.442,"end":18.805},{"key":"3","lines":[{"start":20.575,"end":22.205,"text":"Behold before and me behind"},{"start":22.825,"end":24.441,"text":"Thou art confined me, Lord"},{"start":25.061,"end":26.97,"text":"Greatest mystery art this knowledge"},{"start":27.59,"end":29.021,"text":"I can comprehend not."}],"start":20.575,"end":29.021},{"key":"4","lines":[{"start":30.791,"end":32.471,"text":"Absconding away from Thy sight"},{"start":33.091,"end":34.445,"text":"It‘s vain effort to me"},{"start":35.065,"end":36.872,"text":"Thine spirit is far beyond me"},{"start":37.492,"end":38.943,"text":"So, I abscond in vain."}],"start":30.791,"end":38.943},{"key":"5","lines":[{"start":40.713,"end":42.48,"text":"Though I abscond into darkness"},{"start":43.1,"end":44.53,"text":"Of vain effort it be"},{"start":45.15,"end":46.963,"text":"Darkness is more of light to Thee"},{"start":47.583,"end":49.012,"text":"Same as the brightest day."}],"start":40.713,"end":49.012},{"key":"6","lines":[{"start":50.782,"end":52.382,"text":"As Thou art known mine heart"},{"start":53.002,"end":54.941,"text":"Oh Lord From mine maternal womb"},{"start"