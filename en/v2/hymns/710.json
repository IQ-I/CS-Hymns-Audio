{"v":2,"coll":"en","num":710,"id":"hymn_710","title":"GLORY praise and honour","duration":69.769,"voices":{"grace":{"file":"en-710-grace.m4a","bytes":624586,"sha256":"058d40c86864992fc8c7b8346e5613c3d7f99c47e09f2728ca9e4e4eafa712f7","duration":69.769,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.725,"text":"GLORY praise and honour"},{"start":2.345,"end":3.779,"text":"Unto Jesus our Lord"},{"start":4.399,"end":5.724,"text":"For keeping us alive"},{"start":6.344,"end":7.701,"text":"And to witness this day"},{"start":8.321,"end":9.91,"text":"Our hearts are fill’d with joy"},{"start":10.53,"end":11.922,"text":"For His great privilege"},{"start":12.542,"end":13.75,"text":"And to labour for Thee"},{"start":14.37,"end":15.791,"text":"In Thy vineyard on earth."}],"start":0.35,"end":15.791},{"key":"2","lines":[{"start":17.561,"end":19.013,"text":"We thank Thee for guidance"},{"start":19.633,"end":20.983,"text":"And the pow‘r of Spirit"},{"start":21.603,"end":23.145,"text":"And the gift of great love"},{"start":23.765,"end":25.071,"text":"That binds us together"},{"start":25.691,"end":27.202,"text":"O Jesus, our Shepherd"},{"start":27.822,"end":29.287,"text":"Accept our praises now"},{"start":29.907,"end":31.318,"text":"For Thy Compassion sake"},{"start":31.938,"end":33.072,"text":"Unite us for ever."}],"start":17.561,"end":33.072},{"key":"3","lines":[{"start":34.842,"end":36.3,"text":"Bless us heav'nly Father"},{"start":36.92,"end":38.4,"text":"On this our harvest day"},{"start":39.02,"end":40.485,"text":"Send Thy sign unto us"},{"start":41.105,"end":42.58,"text":"To have joy in Thy praise"},{"start":43.2,"end":44.485,"text":"Let us be successful"},{"start":45.105,"end":46.638,"text":"Lord in our daily task"},{"start":47.258,"end":48.77,"text":"Let‘s put our trust in Thee"},{"start":49.39,"end":50.454,"text":"Forever and ever."}],"start":34.842,"end":50.454},{"key":"4","lines":[{"start":52.224,"end":53.507,"text":"O Lord our Creator"},{"start":54.127,"end":55.413,"te