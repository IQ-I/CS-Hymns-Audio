{"v":2,"coll":"en","num":137,"id":"hymn_137","title":"IN the Name of Jesus","duration":81.917,"voices":{"grace":{"file":"en-137-grace-s1.m4a","bytes":723272,"sha256":"f281605386008987c7a9babc0293cd6cc81cb5ba875afb98a97c22a27d454eac","duration":81.917,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.591,"text":"IN the Name of Jesus"},{"start":2.211,"end":3.354,"text":"Every knee shall bow"},{"start":3.974,"end":5.422,"text":"Every tongue confess Him"},{"start":6.042,"end":7.217,"text":"King of Glory now"},{"start":7.837,"end":9.144,"text":"‘Tis the Father’s pleasure"},{"start":9.764,"end":10.991,"text":"We should call Him Lord"},{"start":11.611,"end":12.815,"text":"Who from the beginning"},{"start":13.435,"end":14.613,"text":"Was the mighty word."}],"start":0.35,"end":14.613},{"key":"2","lines":[{"start":16.383,"end":17.643,"text":"Humbled for a season"},{"start":18.263,"end":19.406,"text":"To receive a name"},{"start":20.026,"end":21.298,"text":"From the lips of sinners"},{"start":21.918,"end":23.123,"text":"Unto whom He came"},{"start":23.743,"end":25.074,"text":"Faithfully He bore it"},{"start":25.694,"end":27.002,"text":"Spotless to the last"},{"start":27.622,"end":29.081,"text":"Brought it back victorious"},{"start":29.701,"end":30.988,"text":"When from death Separate."}],"start":16.383,"end":30.988},{"key":"3","lines":[{"start":32.758,"end":34.476,"text":"Name Him, brothers, name Him,"},{"start":34.856,"end":36.351,"text":"With love strong as death"},{"start":36.971,"end":38.346,"text":"But with awe and wonder"},{"start":38.966,"end":40.239,"text":"And with bated breath"},{"start":40.859,"end":42.155,"text":"He is Christ the Lord"},{"start":42.775,"end":43.986,"text":"Ever to be worshipped"},{"start":44.606,"end":45.917,"text":"Trusted, and adored."}],"start":32.758,"end":45.917},{"key":"4","lines":[{"start":47.687,"end":49.069,"text":"In your hearts enthrone Him"},{"start":49.689,"end":50.803,"text":"There let Him subdue"},{"start":51.423,"end":52.703,"te