{"v":2,"coll":"en","num":653,"id":"hymn_653","title":"OUR lamps are trimm‘d and burning","duration":63.535,"voices":{"grace":{"file":"en-653-grace.m4a","bytes":586640,"sha256":"f8aa10e90cc9fc7897ec6a0553d040551576233a690c26155994f9a0cc90c998","duration":63.535,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.047,"text":"OUR lamps are trimm‘d and burning,"},{"start":2.427,"end":3.982,"text":"Our robes are white and clean"},{"start":4.602,"end":6.17,"text":"We’ve tarried for the Bridegroom"},{"start":6.79,"end":7.982,"text":"Oh may we enter in"},{"start":8.602,"end":10.065,"text":"We know we've nothing worthy"},{"start":10.685,"end":11.971,"text":"That we can call our own"},{"start":12.591,"end":14.541,"text":"The light, the oil the robes we wear,"},{"start":14.921,"end":16.292,"text":"All come from Him alone."}],"start":0.35,"end":16.292},{"key":"CHORUS","lines":[{"start":18.062,"end":19.63,"text":"Behold the Bridegroom cometh"},{"start":20.25,"end":21.467,"text":"And all may enter in;"},{"start":21.927,"end":23.699,"text":"Whose lamps are trimm‘d and burning"},{"start":24.319,"end":25.94,"text":"Whose robes are white and clean."}],"start":18.062,"end":25.94},{"key":"2","lines":[{"start":27.71,"end":29.382,"text":"Go forth go forth to meet Him"},{"start":30.002,"end":31.207,"text":"The way is open now,"},{"start":31.587,"end":33.006,"text":"All lighted with the glory"},{"start":33.626,"end":35.133,"text":"Thats streaming from his brow,"},{"start":35.513,"end":36.845,"text":"Accept the invitation"},{"start":37.465,"end":39.304,"text":"Beyond de-ser-ving kind make no"},{"start":39.924,"end":41.385,"text":"delay but take your lamps"},{"start":42.005,"end":43.407,"text":"And joy eternal find."}],"start":27.71,"end":43.407},{"key":"3","lines":[{"start":45.177,"end":47.001,"text":"We see the marriage splendour Within"},{"start":47.621,"end":48.602,"text":"the open door;"},{"start":49.062,"end":50.542,"text":"We know that those who enter"},{"start":51.162,"end":52.481,