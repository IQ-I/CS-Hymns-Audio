{"v":2,"coll":"en","num":492,"id":"hymn_492","title":"THOU art my hiding-place, O Lord","duration":78.77,"voices":{"grace":{"file":"en-492-grace-s1.m4a","bytes":743934,"sha256":"2ec518753f2f3a887f005cedead19b90254b284e904b76013da842269bee9d15","duration":78.77,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.383,"text":"THOU art my hiding-place, O Lord"},{"start":3.003,"end":4.497,"text":"In Thee I put my trust"},{"start":5.117,"end":6.817,"text":"Encouraged by Thy holy word"},{"start":7.437,"end":8.911,"text":"A feeble child of dust"},{"start":9.531,"end":11.13,"text":"I have no argument beside"},{"start":11.75,"end":13.098,"text":"I urge no other plea"},{"start":13.718,"end":15.433,"text":"And ‘tis enough my Saviour died"},{"start":16.053,"end":17.503,"text":"My Saviour died for me."}],"start":0.35,"end":17.503},{"key":"2","lines":[{"start":19.273,"end":21.349,"text":"When storms of fierce temptation beat"},{"start":21.969,"end":23.539,"text":"And furious foes assail"},{"start":24.159,"end":25.929,"text":"My refuge is the mercy-seat"},{"start":26.549,"end":27.888,"text":"My hope within the veil"},{"start":28.508,"end":30.585,"text":"From strife of tongues and bitter words"},{"start":31.205,"end":32.74,"text":"My spirit flies to Thee"},{"start":33.36,"end":35.084,"text":"Joy to my heart though I affords"},{"start":35.703,"end":37.153,"text":"My Saviour died for me."}],"start":19.273,"end":37.153},{"key":"3","lines":[{"start":38.923,"end":40.655,"text":"'Midst trials heavy to be borne"},{"start":41.275,"end":42.892,"text":"When mortal strength is vain"},{"start":43.512,"end":45.534,"text":"A heart with grief and anguish torn"},{"start":46.154,"end":47.625,"text":"A body rack'd with pain"},{"start":48.245,"end":50.292,"text":"Ah! what could give the suff'rer rest"},{"start":50.912,"end":52.561,"text":"I Bid every murmur flee,"},{"start":52.941,"end":54.797,"text":"But this the witness in my breast"},{"start":55.417,"end":56.867,"text":"My Saviour died for me."}]