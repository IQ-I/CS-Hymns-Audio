{"v":2,"coll":"en","num":203,"id":"hymn_203","title":"JOY fills our most heart to day","duration":51.637,"voices":{"grace":{"file":"en-203-grace-s1.m4a","bytes":463605,"sha256":"7f2f9e861f92b8159ffa0d7fd55eec77236b89c73768e7f5beb01fa16ec6f181","duration":51.637,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.126,"text":"JOY fills our most heart to day"},{"start":2.746,"end":4.166,"text":"The royal Child is born;"},{"start":4.626,"end":6.503,"text":"And Angels hosts in glad array"},{"start":7.123,"end":8.648,"text":"His Advent keep this morn."}],"start":0.35,"end":8.648},{"key":"CHORUS","lines":[{"start":10.418,"end":12.923,"text":"Rejoice, rejoice! The incarnate Word"},{"start":13.543,"end":14.994,"text":"Has come on earth to dwell;"},{"start":15.454,"end":16.919,"text":"No sweeter sound than this"},{"start":17.539,"end":18.604,"text":"is heard-Emmanuel."}],"start":10.418,"end":18.604},{"key":"2","lines":[{"start":20.374,"end":22.209,"text":"Low at the cradle throne we bend"},{"start":22.829,"end":24.104,"text":"We wonder and adore"},{"start":24.724,"end":26.908,"text":"And feel no bliss can ours transcend,"},{"start":27.288,"end":28.674,"text":"No joy was sweet before."}],"start":20.374,"end":28.674},{"key":"3","lines":[{"start":30.444,"end":32.527,"text":"For us the world must loose its charms"},{"start":33.147,"end":34.438,"text":"Before the manger shine,"},{"start":34.818,"end":36.873,"text":"When, folded in Thy mother‘s arms"},{"start":37.493,"end":38.929,"text":"We see Thee, Babe divine."}],"start":30.444,"end":38.929},{"key":"4","lines":[{"start":40.699,"end":42.586,"text":"Thou Light of uncreated Light"},{"start":43.206,"end":44.798,"text":"Shine on us, Holy Child;"},{"start":45.258,"end":47.074,"text":"That we may keep Thy birthday bright"},{"start":47.694,"end":49.167,"text":"With service undefiled."}],"start":40.699,"end":49.167}]},"daniel":{"file":"en-203-daniel-s1.m4a","bytes":469609,"sha256":"951a1822c2ede7212302561e619c174919afd44d6912d4e19d2a63