{"v":2,"coll":"en","num":769,"id":"hymn_769","title":"THE Church’s one foundation","duration":93.038,"voices":{"grace":{"file":"en-769-grace-s1.m4a","bytes":859167,"sha256":"136200dd0d480a94b6516a8003201b2a92afa47adf7b7d5793b7afdb518048af","duration":93.038,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.0,"text":"THE Church’s one foundation"},{"start":2.62,"end":4.192,"text":"Is Jesus Christ her Lord"},{"start":4.812,"end":6.296,"text":"She is His new creation"},{"start":6.916,"end":8.217,"text":"By water and the word"},{"start":8.837,"end":10.611,"text":"From heav'n He came and sought her"},{"start":11.231,"end":12.597,"text":"To be His holy bride"},{"start":13.217,"end":14.828,"text":"With His own blood He bought her,"},{"start":15.208,"end":16.614,"text":"And for her life He died."}],"start":0.35,"end":16.614},{"key":"2","lines":[{"start":18.384,"end":19.889,"text":"Elect from every nation"},{"start":20.509,"end":21.919,"text":"Yet one o’er all the earth"},{"start":22.539,"end":24.009,"text":"Her charter of salvation"},{"start":24.629,"end":26.733,"text":"One Lord, one faith, one birth"},{"start":27.353,"end":29.005,"text":"One holy name she blesses"},{"start":29.625,"end":31.141,"text":"Partakes one holy food"},{"start":31.761,"end":33.411,"text":"And to one hope she presses,"},{"start":33.791,"end":35.324,"text":"With every grace endued."}],"start":18.384,"end":35.324},{"key":"3","lines":[{"start":37.094,"end":38.564,"text":"Though with a scornful wonder"},{"start":39.184,"end":40.686,"text":"Men see her sore oppressed"},{"start":41.306,"end":42.902,"text":"By schisms rent asunder"},{"start":43.522,"end":45.039,"text":"By heresies distressed"},{"start":45.659,"end":47.455,"text":"Yet saints their watch are keeping"},{"start":48.075,"end":49.791,"text":"Their cry goes up: How long?"},{"start":50.411,"end":51.83,"text":"And soon the night of weeping"},{"start":52.45,"end":53.809,"text":"Shall be the morn of song."}],"start":37.094,"end":53.809},{"key":"4","lines":[{"start":55.579,"end":57.328,"text":"Mid toil and tribulation"},{"start":57.947,"end":59.37,"text":"And tumult of her war"},{"start":59.99,"end":61.53,"text":"She waits the consummation"},{"start":62.15,"end":63.458,"text":"Of peace for evermore"},{"start":64.078,"end":65.66,"text":"Till with the vision glorious"},{"start":66.28,"end":67.886,"text":"Her longing eyes are blest"},{"start":68.506,"end":70.177,"text":"And the great Church victorious"},{"start":70.797,"end":72.238,"text":"Shall be the Church at rest."}],"start":55.579,"end":72.238},{"key":"5","lines":[{"start":74.008,"end":75.541,"text":"Yet she on earth hath union"},{"start":76.161,"end":77.573,"text":"With God the Three in One"},{"start":78.193,"end":79.603,"text":"And mystic sweet communion"},{"start":80.223,"end":81.989,"text":"With those whose rest is won"},{"start":82.609,"end":83.98,"text":"O happy ones and holy!"},{"start":84.6,"end":86.324,"text":"Lord, give us grace that we"},{"start":86.944,"end":88.535,"text":"Like them the meek and lowly"},{"start":89.155,"end":90.568,"text":"On high may dwell with Thee."}],"start":74.008,"end":90.568}]},"daniel":{"file":"en-769-daniel-s1.m4a","bytes":852201,"sha256":"cad02c9bdab7c7a917360e607dece13e78b8209b2669a06e54d6f97a3b3a7185","duration":91.714,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.943,"text":"THE Church’s one foundation"},{"start":2.563,"end":4.089,"text":"Is Jesus Christ her Lord"},{"start":4.709,"end":6.145,"text":"She is His new creation"},{"start":6.765,"end":8.031,"text":"By water and the word"},{"start":8.651,"end":10.342,"text":"From heav'n He came and sought her"},{"start":10.962,"end":12.295,"text":"To be His holy bride"},{"start":12.915,"end":14.569,"text":"With His own blood He bought her,"},{"start":14.949,"end":16.403,"text":"And for her life He died."}],"start":0.35,"end":16.403},{"key":"2","lines":[{"start":18.173,"end":19.629,"text":"Elect from every nation"},{"start":20.249,"end":21.577,"text":"Yet one o’er al