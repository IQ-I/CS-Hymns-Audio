{"v":2,"coll":"en","num":634,"id":"hymn_634","title":"AWAKE, my soul! stretch every nerve","duration":42.612,"voices":{"grace":{"file":"en-634-grace-s1.m4a","bytes":380243,"sha256":"8332a056287cd8caee8fdf431bf3f8930c9220599139840ff42984f13e59b7f4","duration":42.612,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.674,"text":"AWAKE, my soul! stretch every nerve"},{"start":3.294,"end":4.693,"text":"And press with vigour on"},{"start":5.313,"end":7.175,"text":"A heav'nly race demands thy zeal"},{"start":7.795,"end":9.105,"text":"And an immortal crown."}],"start":0.35,"end":9.105},{"key":"2","lines":[{"start":10.875,"end":12.495,"text":"A cloud of witnesses around"},{"start":13.115,"end":14.58,"text":"Hold thee in full survey"},{"start":15.2,"end":16.87,"text":"Forget the steps already trod"},{"start":17.49,"end":18.994,"text":"And onward urge thy way."}],"start":10.875,"end":18.994},{"key":"3","lines":[{"start":20.764,"end":22.698,"text":"“'Tis God’s all-animating Voice"},{"start":23.318,"end":24.806,"text":"That calls thee from on high"},{"start":25.426,"end":27.523,"text":"'Tis His own Hand presents the prize"},{"start":28.143,"end":29.475,"text":"To thine aspiring eye."}],"start":20.764,"end":29.475},{"key":"4","lines":[{"start":31.245,"end":33.31,"text":"Blest Saviour, introduced by Thee"},{"start":33.93,"end":35.259,"text":"Have I my race begun"},{"start":35.879,"end":38.077,"text":"And crown’d with vict’ry, at Thy feet"},{"start":38.697,"end":40.142,"text":"I’ll lay my honours down."}],"start":31.245,"end":40.142}]},"daniel":{"file":"en-634-daniel-s1.m4a","bytes":373718,"sha256":"2ffe06a03ad7c5ca7b59082b442a763231c714a32dceab6228724c451377a5b1","duration":42.06,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.562,"text":"AWAKE, my soul! stretch every nerve"},{"start":3.182,"end":4.546,"text":"And press with vigour on"},{"start":5.166,"end":7.087,"text":"A heav'nly race demands thy zeal"},{"start":7.707,"end":9.066,"text":"And an immortal crown."}],"star