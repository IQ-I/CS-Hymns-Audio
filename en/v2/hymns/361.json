{"v":2,"coll":"en","num":361,"id":"hymn_361","title":"JERUSALEM on high","duration":65.769,"voices":{"grace":{"file":"en-361-grace-s1.m4a","bytes":565384,"sha256":"484f5abd3d63d9f9ff748ddc08d218935d2643696d954960d043061f4e5dcadb","duration":65.769,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.568,"text":"JERUSALEM on high"},{"start":2.188,"end":3.569,"text":"My song and city is"},{"start":4.189,"end":5.659,"text":"My home whenever I die"},{"start":6.279,"end":7.641,"text":"The centre of my bliss."}],"start":0.35,"end":7.641},{"key":"CHORUS","lines":[{"start":9.411,"end":10.493,"text":"Oh happy place"},{"start":11.113,"end":12.522,"text":"When shall I be My God,"},{"start":12.902,"end":14.332,"text":"With Thee to see Thy face"},{"start":14.952,"end":15.661,"text":"Oh Lord."}],"start":9.411,"end":15.661},{"key":"2","lines":[{"start":17.431,"end":18.917,"text":"There dwells my Lord, my King"},{"start":19.537,"end":21.064,"text":"Judge here unfit in live"},{"start":21.684,"end":23.118,"text":"There Angels to Him sing"},{"start":23.738,"end":25.183,"text":"And lowly him age give."}],"start":17.431,"end":25.183},{"key":"3","lines":[{"start":26.953,"end":28.324,"text":"The Patriachs of old"},{"start":28.944,"end":30.494,"text":"There from their travels cease"},{"start":31.114,"end":32.588,"text":"The prophets there behold"},{"start":33.208,"end":34.865,"text":"Their long‘d for Prince of peace."}],"start":26.953,"end":34.865},{"key":"4","lines":[{"start":36.635,"end":38.102,"text":"The Lamb's Apostles there"},{"start":38.722,"end":40.13,"text":"I might with joy behold"},{"start":40.75,"end":42.088,"text":"The Harper’s I might hear"},{"start":42.708,"end":44.204,"text":"Harping on harps of gold."}],"start":36.635,"end":44.204},{"key":"5","lines":[{"start":45.974,"end":47.304,"text":"The bleeding Martyrs, they"},{"start":47.924,"end":49.457,"text":"Within those courts are found"},{"start":50.077,"end":51.647,"text":"Clothed in pure robe array,"},{"start":52.027,"end":