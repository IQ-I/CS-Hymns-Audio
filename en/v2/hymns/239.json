{"v":2,"coll":"en","num":239,"id":"hymn_239","title":"JESUS my strength, my hope","duration":73.759,"voices":{"grace":{"file":"en-239-grace-s1.m4a","bytes":677998,"sha256":"f3040dc0f76de8bc0dbe464e5d0e8102c918a1f4053cd85c0e934048d4377177","duration":73.759,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.954,"text":"JESUS my strength, my hope"},{"start":2.574,"end":3.988,"text":"On Thee I cast my care"},{"start":4.608,"end":6.38,"text":"With humble confidence look up"},{"start":7.0,"end":8.738,"text":"And know Thou hear'st my prayer"},{"start":9.358,"end":10.696,"text":"Give me on Thee to wait"},{"start":11.316,"end":12.691,"text":"Till I can all things do"},{"start":13.311,"end":15.138,"text":"On Thee, Almighty to create"},{"start":15.758,"end":16.816,"text":"Almighty to renew."}],"start":0.35,"end":16.816},{"key":"2","lines":[{"start":18.586,"end":19.877,"text":"I want a godly fear"},{"start":20.497,"end":21.699,"text":"A quick-discerning eye"},{"start":22.319,"end":24.069,"text":"That looks to Thee when sin is near"},{"start":24.689,"end":26.271,"text":"And sees the tempter fly"},{"start":26.891,"end":28.369,"text":"A spirit still prepared"},{"start":28.989,"end":30.465,"text":"And armed with jealous care"},{"start":31.085,"end":32.799,"text":"For ever standing on its guard"},{"start":33.419,"end":34.942,"text":"And watching unto prayer."}],"start":18.586,"end":34.942},{"key":"3","lines":[{"start":36.712,"end":37.989,"text":"I want a true regard"},{"start":38.609,"end":40.016,"text":"A single, steady aim"},{"start":40.636,"end":42.567,"text":"Unmoved by threatening or reward"},{"start":43.187,"end":44.731,"text":"To Thee and Thy great name"},{"start":45.351,"end":46.833,"text":"A jealous just concern"},{"start":47.453,"end":48.999,"text":"For Thine immortal praise"},{"start":49.619,"end":51.354,"text":"A pure desire that all may learn"},{"start":51.974,"end":53.386,"text":"And glorify Thy grace."}],"start":36.712,"end":53.386},{"key":"4","lines":[{"start":55.156,"end":56.536,"text":"I rest upon Thy word"},{"start":57.156,"end":58.417,"text":"The promise is for me"},{"start":59.037,"end":60.789,"text":"My succour and salvation Lord"},{"start":61.409,"end":62.849,"text":"Shall surely come from Thee"},{"start":63.469,"end":64.751,"text":"But let me still abide"},{"start":65.371,"end":66.784,"text":"Nor from my hope remove"},{"start":67.404,"end":69.189,"text":"Till Thou my patient spirit guide"},{"start":69.809,"end":71.29,"text":"Into Thy perfect love."}],"start":55.156,"end":71.29}]},"daniel":{"file":"en-239-daniel-s1.m4a","bytes":684166,"sha256":"2807583259b533a2df45b6f969d1231a52c949e06cae04c849b43ddde441807c","duration":73.562,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.914,"text":"JESUS my strength, my hope"},{"start":2.534,"end":3.997,"text":"On Thee I cast my care"},{"start":4.617,"end":6.404,"text":"With humble confidence look up"},{"start":7.024,"end":8.767,"text":"And know Thou hear'st my prayer"},{"start":9.387,"end":10.708,"text":"Give me on Thee to wait"},{"start":11.328,"end":12.778,"text":"Till I can all things do"},{"start":13.398,"end":15.066,"text":"On Thee, Almighty to create"},{"start":15.686,"end":16.822,"text":"Almighty to renew."}],"start":0.35,"end":16.822},{"key":"2","lines":[{"start":18.592,"end":19.826,"text":"I want a godly fear"},{"start":20.446,"end":21.696,"text":"A quick-discerning eye"},{"start":22.316,"end":24.113,"text":"That looks to Thee when sin is near"},{"start":24.733,"end":26.264,"text":"And sees the tempter fly"},{"start":26.884,"end":28.386,"text":"A spirit still prepared"},{"start":29.006,"end":30.5,"text":"And armed with jealous care"},{"start":31.12,"end":32.835,"text":"For ever standing on its guard"},{"start":33.455,"end":34.997,"text":"And watching unto prayer."}],"start":18.592,"end":34.997},{"key":"3","lines":[{"start":36.767,"end":38.025,"text":"I want a true regard"},{"start":38.645,"end":39.98,"text":"A single, steady aim"},{"start":40.6,"end":42.527,"text"