{"v":2,"coll":"en","num":148,"id":"hymn_148","title":"SOMETIMES a light surprises","duration":71.936,"voices":{"grace":{"file":"en-148-grace.m4a","bytes":671543,"sha256":"75cf3dda369469282f52cfb6ea565eddb80491e148277e5c4fdd9ceaf9c0bcae","duration":71.936,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.114,"text":"SOMETIMES a light surprises"},{"start":2.734,"end":4.219,"text":"The Christians while he sings;"},{"start":4.679,"end":6.193,"text":"It is the Lord who rises"},{"start":6.813,"end":8.201,"text":"With healing in his wings;"},{"start":8.661,"end":10.124,"text":"When comforts are declining"},{"start":10.744,"end":12.204,"text":"He grants the soul again"},{"start":12.824,"end":14.247,"text":"A season of clear shining"},{"start":14.867,"end":16.15,"text":"To cheer it after rain."}],"start":0.35,"end":16.15},{"key":"2","lines":[{"start":17.92,"end":19.424,"text":"ln holy contemplation"},{"start":20.044,"end":21.517,"text":"We sweetly then pursue"},{"start":22.137,"end":23.832,"text":"The theme of God's salvation,"},{"start":24.212,"end":25.659,"text":"And find it ever never"},{"start":26.279,"end":27.819,"text":"Set free from present sorrow,"},{"start":28.199,"end":29.497,"text":"We cheerfully can say,"},{"start":29.877,"end":31.364,"text":"E’en let the unknown to-morrow"},{"start":31.984,"end":33.296,"text":"Bring with it what it may."}],"start":17.92,"end":33.296},{"key":"3","lines":[{"start":35.066,"end":36.567,"text":"lt can bring with it nothing"},{"start":37.187,"end":38.464,"text":"But He will hear us through"},{"start":39.084,"end":40.554,"text":"Who gives the lilies clothing"},{"start":41.174,"end":42.713,"text":"Will clothes His people too"},{"start":43.333,"end":44.812,"text":"Beneath the spreading heavens"},{"start":45.432,"end":46.84,"text":"No creature but is fed,"},{"start":47.22,"end":48.914,"text":"And He who feeds the ravens"},{"start":49.534,"end":51.028,"text":"Will give His children bread."}],"start":35.066,"end":51.028},{"key":"4","lines":[{"start":52.798,"end":54.393,"text":"Though vine nor fig-tree neither"},{"start":55.013,"end":56.488,"text":"Their wanted fruit should bear"},{"start":57.108,"end":58.579,"text":"Though all the field should wither"},{"start":59.199,"end":61.022,"text":"Nor flocks nor herds be there"},{"start":61.642,"end":63.238,"text":"Yet, God the same abiding"},{"start":63.858,"end":65.49,"text":"His praise shall tune my voice;"},{"start":65.95,"end":67.497,"text":"For while in Him confiding"},{"start":68.117,"end":69.466,"text":"I cannot but rejoice."}],"start":52.798,"end":69.466}]},"daniel":{"file":"en-148-daniel.m4a","bytes":674241,"sha256":"af2e61c4f403326f86a40235eacf8c5c5d0cbf8ce573748c010d92abd76e5514","duration":71.81,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.067,"text":"SOMETIMES a light surprises"},{"start":2.687,"end":4.166,"text":"The Christians while he sings;"},{"start":4.626,"end":6.151,"text":"It is the Lord who rises"},{"start":6.771,"end":8.213,"text":"With healing in his wings;"},{"start":8.673,"end":10.214,"text":"When comforts are declining"},{"start":10.834,"end":12.205,"text":"He grants the soul again"},{"start":12.825,"end":14.248,"text":"A season of clear shining"},{"start":14.868,"end":16.161,"text":"To cheer it after rain."}],"start":0.35,"end":16.161},{"key":"2","lines":[{"start":17.931,"end":19.376,"text":"ln holy contemplation"},{"start":19.996,"end":21.528,"text":"We sweetly then pursue"},{"start":22.148,"end":23.764,"text":"The theme of God's salvation,"},{"start":24.144,"end":25.601,"text":"And find it ever never"},{"start":26.221,"end":27.826,"text":"Set free from present sorrow,"},{"start":28.206,"end":29.531,"text":"We cheerfully can say,"},{"start":29.911,"end":31.43,"text":"E’en let the unknown to-morrow"},{"start":32.05,"end":33.365,"text":"Bring with it what it may."}],"start":17.931,"end":33.365},{"key":"3","lines":[{"start":35.135,"end":36.625,"text":"lt can bring with it nothing"},{"start":37.245,"end":38.509,"text":"Bu