{"v":2,"coll":"en","num":132,"id":"hymn_132","title":"REJOICE ye Holy Angels of above","duration":94.692,"voices":{"grace":{"file":"en-132-grace-s1.m4a","bytes":864459,"sha256":"3723b65ee7b5cf7c708114dc9eaf47cf58a7c91f7bc0dfb069765c0f388f2edc","duration":94.692,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.438,"text":"REJOICE ye Holy Angels of above"},{"start":3.058,"end":5.348,"text":"Cherubim Seraphim raise up voices"},{"start":5.968,"end":7.376,"text":"Let us all shout Hosannah"},{"start":7.996,"end":9.496,"text":"And give homage to our God."},{"start":10.116,"end":11.498,"text":"Holy Trinity above."}],"start":0.35,"end":11.498},{"key":"CHORUS","lines":[{"start":13.268,"end":14.208,"text":"Shout for joy (2ce)"},{"start":14.828,"end":16.619,"text":"‘Tis born the Saviour of Israel (2ce)"},{"start":17.239,"end":18.179,"text":"Shout for joy (2ce)"},{"start":18.799,"end":20.301,"text":"For the Lord has called us in"},{"start":20.921,"end":22.267,"text":"to the Band of Seraphim."}],"start":13.268,"end":22.267},{"key":"2","lines":[{"start":24.037,"end":26.325,"text":"Glory be to God who ever long with us"},{"start":26.945,"end":28.757,"text":"Who make Holy Michael our Captain"},{"start":29.377,"end":30.917,"text":"Let us ever more rejoice"},{"start":31.537,"end":33.114,"text":"And give praises to Our God"},{"start":33.734,"end":35.395,"text":"Who saved us to see this day"}],"start":24.037,"end":35.395},{"key":"3","lines":[{"start":37.165,"end":38.974,"text":"Blessed sacred shepherd of Israel"},{"start":39.594,"end":42.101,"text":"Thou who slumber not and doth sleepeth not"},{"start":42.721,"end":44.489,"text":"Lead us with Thine gentle rod"},{"start":45.109,"end":46.759,"text":"All the sluggard souls within"},{"start":47.379,"end":49.114,"text":"Thus Thine love may ever glow."}],"start":37.165,"end":49.114},{"key":"CHORUS-3","lines":[{"start":50.884,"end":52.02,"text":"Shout for joy...3."},{"start":52.64,"end":54.556,"text":"Make us worthy Father to be Thy sheep