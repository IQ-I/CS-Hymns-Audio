{"v":2,"coll":"en","num":116,"id":"hymn_116","title":"OH! for a thousand tongue to sing","duration":64.121,"voices":{"grace":{"file":"en-116-grace.m4a","bytes":573314,"sha256":"c4cdcecf69da89f19f9747f4fd24e9caae6582f344d784519d3de49f7c280c68","duration":64.121,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.246,"text":"OH! for a thousand tongue to sing"},{"start":2.866,"end":4.393,"text":"My dear redeemer's Praise"},{"start":5.013,"end":6.711,"text":"The glories of my God and King"},{"start":7.331,"end":8.845,"text":"The triumphs of His grace."}],"start":0.35,"end":8.845},{"key":"2","lines":[{"start":10.615,"end":12.694,"text":"Jesus the name that charms our fears"},{"start":13.314,"end":14.848,"text":"That bids our sorrows cease"},{"start":15.468,"end":17.221,"text":"‘Tis music in the sinners ears"},{"start":17.841,"end":19.66,"text":"‘T'is life and health, and peace."}],"start":10.615,"end":19.66},{"key":"3","lines":[{"start":21.43,"end":23.435,"text":"He breaks the power of cancelled sin"},{"start":24.055,"end":25.516,"text":"And sets the prisoner free"},{"start":26.136,"end":28.075,"text":"His blood can make the foulest clean"},{"start":28.695,"end":30.039,"text":"His blood availeth me."}],"start":21.43,"end":30.039},{"key":"4","lines":[{"start":31.809,"end":33.93,"text":"He speaks and listening to His voice"},{"start":34.55,"end":36.04,"text":"New life the dead receive"},{"start":36.66,"end":38.565,"text":"The mournful broken hearts rejoice"},{"start":39.185,"end":40.608,"text":"The humble poor believe."}],"start":31.809,"end":40.608},{"key":"5","lines":[{"start":42.378,"end":44.657,"text":"Hear Him ye dead, His praise ye dumb"},{"start":45.277,"end":46.838,"text":"Your loosened tongues employ"},{"start":47.458,"end":49.426,"text":"Ye blind behold your Saviour come"},{"start":50.046,"end":51.517,"text":"And leap ye lame for joy."}],"start":42.378,"end":51.517},{"key":"6","lines":[{"start":53.287,"end":55.196,"text":"My gracious Master and my God"},{"start