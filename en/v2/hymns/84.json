{"v":2,"coll":"en","num":84,"id":"hymn_84","title":"YE angels that dwell in Heaven","duration":118.073,"voices":{"grace":{"file":"en-84-grace-s1.m4a","bytes":1139906,"sha256":"5fbd4b66fe4bc37f2f93dcadce8e3d460139fbc7f273a9d0b7b432905221124f","duration":118.073,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.116,"text":"YE angels that dwell in Heaven,"},{"start":2.496,"end":3.925,"text":"Give praise to our Father,"},{"start":4.305,"end":6.169,"text":"For the band established here below"},{"start":6.789,"end":8.134,"text":"For the redemption of soul;"},{"start":8.594,"end":10.683,"text":"Therefore let's rejoice and be glad"},{"start":11.303,"end":12.656,"text":"And then shout Hallelujah,"},{"start":13.036,"end":14.826,"text":"In remembrance of Jesus death"},{"start":15.446,"end":16.964,"text":"Painful death on the cross."}],"start":0.35,"end":16.964},{"key":"CHORUS","lines":[{"start":18.734,"end":20.17,"text":"There's Command from Heaven's"},{"start":20.79,"end":21.673,"text":"Courts above"},{"start":22.293,"end":24.028,"text":"That this Band must multiply!"},{"start":24.648,"end":26.084,"text":"There's Command from heaven's"},{"start":26.704,"end":27.613,"text":"Courts above,"},{"start":27.993,"end":29.906,"text":"It must grow from strength to strength;"},{"start":30.366,"end":32.458,"text":"Till Blind in spirit behold Light"},{"start":33.078,"end":34.738,"text":"In this world and that to come"},{"start":35.358,"end":37.37,"text":"So that death of Jesus on Cross"},{"start":37.99,"end":39.514,"text":"Would never pass in vain."}],"start":18.734,"end":39.514},{"key":"2","lines":[{"start":41.284,"end":42.819,"text":"Ye Cherubim and Seraphim"},{"start":43.439,"end":44.963,"text":"Give praises to our Father,"},{"start":45.343,"end":47.225,"text":"Who has established this Holy Band"},{"start":47.845,"end":49.232,"text":"To procure us salvation;"},{"start":49.692,"end":51.69,"text":"Therefore let us run the swift race"},{"start":52.31,"end":53.667,"text":"Of service to Almighty"},{"start":54.287,"end":56.105,"text":"Perseverance to the end shall bring"},{"start":56.725,"end":58.235,"text":"Everlasting life to us."}],"start":41.284,"end":58.235},{"key":"3","lines":[{"start":60.005,"end":61.76,"text":"All the works we do in this world"},{"start":62.38,"end":63.818,"text":"All the characters we show"},{"start":64.438,"end":66.278,"text":"All the words that we utter therein"},{"start":66.898,"end":68.507,"text":"Let’s be watchful and careful"},{"start":69.127,"end":70.97,"text":"For the Lord shall bring to Judgement"},{"start":71.59,"end":73.054,"text":"All that we do in this world"},{"start":73.674,"end":75.413,"text":"With every secret thing we do"},{"start":76.033,"end":77.306,"text":"Be it good or evil."}],"start":60.005,"end":77.306},{"key":"4","lines":[{"start":79.076,"end":81.393,"text":"Jesus proclameth us Light of world"},{"start":82.013,"end":83.65,"text":"To cast all darkness away;"},{"start":84.11,"end":85.835,"text":"The city built on the top of Hill"},{"start":86.455,"end":88.046,"text":"Can never hide from vision,"},{"start":88.426,"end":90.527,"text":"God has made us the salt of the earth"},{"start":91.147,"end":92.627,"text":"To greatly sweeten the earth"},{"start":93.247,"end":94.956,"text":"But if salt has lost its savour,"},{"start":95.336,"end":96.582,"text":"How can it be seasoned?"}],"start":79.076,"end":96.582},{"key":"5","lines":[{"start":98.352,"end":100.101,"text":"Glory be to Lord our saviour"},{"start":100.721,"end":102.32,"text":"For the love bestowed on us"},{"start":102.94,"end":104.714,"text":"Calling us into this Holy Band"},{"start":105.334,"end":107.139,"text":"The lst Ark of Salvation"},{"start":107.759,"end":109.454,"text":"Glory and honour Might and power,"},{"start":109.834,"end":111.278,"text":"Highest honour and wisdom"},{"start":111.898,"end":114.067,"text":"To Father, Son and Holy Ghost, For"},{"start":114.687,"end":115.603,"text":"ever Trinity."}],"start":98.352,"end":115.603}]},"daniel":{