{"v":2,"coll":"en","num":715,"id":"hymn_715","title":"CHRIST Jesus our dear Saviour","duration":162.323,"voices":{"grace":{"file":"en-715-grace.m4a","bytes":1534429,"sha256":"45776caf1201570b01f7963bd6d3692eaa023cb48c4be654eddb153de756bb63","duration":162.323,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.209,"text":"CHRIST Jesus our dear Saviour"},{"start":2.829,"end":4.196,"text":"To Thee glory we give"},{"start":4.816,"end":6.443,"text":"For Thine saving grace on us"},{"start":7.063,"end":8.455,"text":"Ever from ages past"},{"start":9.075,"end":10.598,"text":"We’re gathered before Thee now"},{"start":11.218,"end":12.741,"text":"To praise Thine Holy name"},{"start":13.361,"end":15.122,"text":"We mortal soldiers of Christ"},{"start":15.742,"end":17.084,"text":"Cherubim, Seraphim"},{"start":17.704,"end":19.162,"text":"This day We’re celebrating"},{"start":19.782,"end":21.1,"text":"Before Thee Holy Lord"},{"start":21.72,"end":23.508,"text":"All glory, praise and honour"},{"start":24.128,"end":25.253,"text":"Ever to Trinity."}],"start":0.35,"end":25.253},{"key":"2","lines":[{"start":27.023,"end":28.821,"text":"Thine blessings we plead Father"},{"start":29.441,"end":30.709,"text":"In this anniversary"},{"start":31.329,"end":32.855,"text":"With Holy Spirit fill us"},{"start":33.475,"end":35.121,"text":"And Divine Strenght we plead"},{"start":35.741,"end":37.211,"text":"That we may wholly serve Thee"},{"start":37.831,"end":39.374,"text":"Save us from sin we plead"},{"start":39.994,"end":41.828,"text":"From demons and temptations"},{"start":42.448,"end":44.015,"text":"Grant us victory we plead"},{"start":44.635,"end":46.118,"text":"May our light shine forever"},{"start":46.738,"end":48.0,"text":"Like city on the rock"},{"start":48.62,"end":50.372,"text":"Let us worship Christ Jesus"},{"start":50.992,"end":52.167,"text":"Our benevolent King."}],"start":27.023,"end":52.167},{"key":"3","lines":[{"start":53.937,"end":55.758,"text":"Ye mortal soldiers of Christ"},{"star