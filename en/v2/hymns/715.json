eed"},{"start":120.454,"end":122.073,"text":"Moreso all we His Children"},{"start":122.693,"end":124.059,"text":"He doth feed everyday"},{"start":124.679,"end":126.209,"text":"All worthy gifts descending"},{"start":126.829,"end":128.146,"text":"All from heaven above"},{"start":128.766,"end":130.511,"text":"Our thanks unto God we give"},{"start":131.131,"end":132.524,"text":"For all His love unend."}],"start":107.214,"end":132.524},{"key":"6","lines":[{"start":134.294,"end":136.008,"text":"Our time is in Thine hand Lord"},{"start":136.628,"end":137.975,"text":"Oh in this passing year"},{"start":138.595,"end":140.407,"text":"Pray hard ye soldiers of Christ"},{"start":141.027,"end":142.361,"text":"The Trinity shall hark"},{"start":142.981,"end":144.506,"text":"Thou we look to and worship"},{"start":145.126,"end":146.57,"text":"Lest we be put to shame"},{"start":147.19,"end":148.76,"text":"And let not we Thine children"},{"start":149.38,"end":150.95,"text":"Sob and weep not we plead"},{"start":151.57,"end":153.34,"text":"On Thee we rest all our trust"},{"start":153.96,"end":155.591,"text":"Thou art our hope Oh Lord"},{"start":156.211,"end":157.793,"text":"Help us That we may worship"},{"start":158.413,"end":159.853,"text":"Till when our life endures."}],"start":134.294,"end":159.853}]},"daniel":{"file":"en-715-daniel.m4a","bytes":1530067,"sha256":"e8e9180f30e8b49a1be7307aab801e46b0de72eef77ab0d2259e2cd819e81778","duration":160.879,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.07,"text":"CHRIST Jesus our dear Saviour"},{"start":2.69,"end":3.958,"text":"To Thee glory we give"},{"start":4.578,"end":6.233,"text":"For Thine saving grace on us"},{"start":6.853,"end":8.191,"text":"Ever from ages past"},{"start":8.811,"end":10.391,"text":"We’re gathered before Thee now"},{"start":11.011,"end":12.496,"text":"To praise Thine Holy name"},{"start":13.116,"end":14.917,"text":"We mortal soldiers of Christ"},{"start":15.537,"end":16.801,"text":"Cherubim, Seraphim"},{"start":17