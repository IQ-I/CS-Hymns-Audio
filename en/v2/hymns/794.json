{"v":2,"coll":"en","num":794,"id":"hymn_794","title":"AROUND the throne of God in heaven","duration":66.97,"voices":{"grace":{"file":"en-794-grace.m4a","bytes":593834,"sha256":"08d57dd8c8fd7e0ec77ce894615f00a50aeb9c412bfa0c02b6d8d000e2d3a7f2","duration":66.97,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.302,"text":"AROUND the throne of God in heaven"},{"start":2.922,"end":4.511,"text":"Thousands of Children stand"},{"start":5.131,"end":7.17,"text":"Children whose sins are (all) forgiven"},{"start":7.79,"end":9.158,"text":"A Holy Happy Band."}],"start":0.35,"end":9.158},{"key":"CHORUS","lines":[{"start":10.928,"end":13.043,"text":"Singing Glory, Glory, Glory."}],"start":10.928,"end":13.043},{"key":"2","lines":[{"start":14.812,"end":16.773,"text":"In flowing robes of spotless white"},{"start":17.393,"end":18.716,"text":"See every one array’d"},{"start":19.336,"end":21.116,"text":"Dwelling in everlasting light"},{"start":21.736,"end":23.233,"text":"And joy that never fade."}],"start":14.812,"end":23.233},{"key":"3","lines":[{"start":25.003,"end":26.856,"text":"What brought them to that world above"},{"start":27.476,"end":29.072,"text":"That Heaven so right and fair"},{"start":29.692,"end":31.843,"text":"Where all is peace, and joy and love,"},{"start":32.223,"end":33.753,"text":"How came those children there."}],"start":25.003,"end":33.753},{"key":"4","lines":[{"start":35.523,"end":37.309,"text":"Because the Saviour shed his blood"},{"start":37.929,"end":39.289,"text":"To wash away their sin"},{"start":39.909,"end":41.757,"text":"Bathed in that precious pure Blood"},{"start":42.377,"end":43.906,"text":"Behold them white and clean."}],"start":35.523,"end":43.906},{"key":"5","lines":[{"start":45.676,"end":47.775,"text":"On earth they sought the Saviour’s Grace"},{"start":48.395,"end":50.034,"text":"On earth they love His Name"},{"start":50.654,"end":52.378,"text":"So now they see His blessed face"},{"start":52.998,"end":54.427,"text":"And stand before the Lamb."