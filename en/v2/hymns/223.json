{"v":2,"coll":"en","num":223,"id":"hymn_223","title":"O GOD, our help in ages past","duration":49.446,"voices":{"grace":{"file":"en-223-grace-s1.m4a","bytes":454835,"sha256":"c94c6c063e67c5e25489a41db0252bbb31bd4f208ad23b6b8e6f16e4ebe8079d","duration":49.446,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.407,"text":"O GOD, our help in ages past,"},{"start":2.787,"end":4.283,"text":"Our hope for years to come,"},{"start":4.663,"end":6.548,"text":"Our shelter from the stormy blast,"},{"start":6.928,"end":8.223,"text":"And our eternal home."}],"start":0.35,"end":8.223},{"key":"2","lines":[{"start":9.993,"end":11.556,"text":"Under the shadow of thy throne"},{"start":12.176,"end":13.777,"text":"Thy saints have dwelt secure:"},{"start":14.237,"end":16.001,"text":"Sufficient is thine arm alone,"},{"start":16.381,"end":17.733,"text":"And our defense is sure."}],"start":9.993,"end":17.733},{"key":"3","lines":[{"start":19.503,"end":21.116,"text":"Before the hills in order stood,"},{"start":21.496,"end":23.059,"text":"Or earth received her frame,"},{"start":23.439,"end":25.219,"text":"From everlasting Thou art God,"},{"start":25.599,"end":27.104,"text":"To endless years the same."}],"start":19.503,"end":27.104},{"key":"4","lines":[{"start":28.874,"end":30.728,"text":"Time, like an ever-rolling stream,"},{"start":31.108,"end":32.604,"text":"Bears all its sons away;"},{"start":33.064,"end":34.931,"text":"They fly forgotten, as a dream"},{"start":35.551,"end":37.029,"text":"Dies at the opening day."}],"start":28.874,"end":37.029},{"key":"5","lines":[{"start":38.799,"end":40.56,"text":"A thousand ages in thy sight"},{"start":41.18,"end":42.546,"text":"Are like an evening gone;"},{"start":43.006,"end":45.047,"text":"Short as the watch that ends the night"},{"start":45.667,"end":46.976,"text":"Before the rising sun."}],"start":38.799,"end":46.976}]},"daniel":{"file":"en-223-daniel-s1.m4a","bytes":453823,"sha256":"1749a4d165184ce7865426b41190b4d97249930964616cd4d611a7dac41e4f6