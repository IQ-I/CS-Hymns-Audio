{"v":2,"coll":"en","num":713,"id":"hymn_713","title":"HARK the voice of Jesus say","duration":93.656,"voices":{"grace":{"file":"en-713-grace.m4a","bytes":866010,"sha256":"3264d4c729fa0c7afd31d26686504f40c70b2fb772728f6d0432085b26b97a6a","duration":93.656,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.996,"text":"HARK the voice of Jesus say"},{"start":2.616,"end":4.555,"text":"Fields are white, harvest waiting"},{"start":5.175,"end":6.665,"text":"But the lab’rers are so few"},{"start":7.285,"end":8.932,"text":"Art thou prepared for the work"},{"start":9.552,"end":10.944,"text":"The sower went forth sowing"},{"start":11.564,"end":13.503,"text":"Fields are white, harvest waiting"},{"start":14.123,"end":15.532,"text":"The harvester with sickle"},{"start":16.152,"end":17.745,"text":"Came and bear the sheaves away."}],"start":0.35,"end":17.745},{"key":"2","lines":[{"start":19.515,"end":20.988,"text":"The Saviour is now calling"},{"start":21.608,"end":23.053,"text":"Calling upon the lab‘rers"},{"start":23.674,"end":25.024,"text":"Put my armour upon thee"},{"start":25.644,"end":27.11,"text":"And prepare to do the work"},{"start":27.73,"end":29.341,"text":"The time is running fastly"},{"start":29.961,"end":31.427,"text":"The day of harvest is nigh"},{"start":32.047,"end":33.384,"text":"The harvest is ready"},{"start":34.004,"end":35.563,"text":"To carry sheaves to the barn."}],"start":19.515,"end":35.563},{"key":"3","lines":[{"start":37.333,"end":38.837,"text":"Ten virgins were appointed"},{"start":39.457,"end":41.111,"text":"Five of them were not prepared"},{"start":41.731,"end":43.303,"text":"Five of them are now ready"},{"start":43.923,"end":45.374,"text":"To enter with our Saviour"},{"start":45.994,"end":47.605,"text":"Make use of thy talents now"},{"start":48.225,"end":49.587,"text":"Do the work given to thee"},{"start":50.207,"end":51.959,"text":"Press thou on with longsuffering"},{"start":52.579,"end":54.194,"text":"Thou shall have victorious crown."}],"start":