{"v":1,"coll":"en","num":631,"id":"hymn_631","title":"O Jesus I have promised","duration":86.674,"voices":{"grace":{"file":"en-631-grace.m4a","bytes":830322,"sha256":"b2f94834b117246fda29eded29eb6680b2c03f43d5bf4f6d625ce63208b44fea","duration":86.674,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.946,"text":"O Jesus I have promised"},{"start":2.566,"end":3.935,"text":"To serve Thee to the end;"},{"start":4.395,"end":5.801,"text":"Be Thou forever near me,"},{"start":6.181,"end":7.66,"text":"My master and my friend;"},{"start":8.12,"end":9.505,"text":"I shall not tear the battle"},{"start":10.125,"end":11.586,"text":"If thou art by my side,"},{"start":11.966,"end":13.588,"text":"Nor wander from the pathway"},{"start":14.208,"end":15.563,"text":"If thou will be my Guide."}],"start":0.35,"end":15.563},{"key":"2","lines":[{"start":17.333,"end":18.763,"text":"Oh let me feel Thee near me;"},{"start":19.223,"end":20.608,"text":"The world is ever drear;"},{"start":21.068,"end":22.665,"text":"I see the sights that dazzle"},{"start":23.285,"end":24.713,"text":"The tempting sounds I hear;"},{"start":25.173,"end":26.72,"text":"My foes are ever near me,"},{"start":27.1,"end":28.314,"text":"Around me and within;"},{"start":28.774,"end":30.57,"text":"But, Jesus, draw Thou nearer,"},{"start":30.95,"end":32.483,"text":"And shield my soul from sin."}],"start":17.333,"end":32.483},{"key":"3","lines":[{"start":34.253,"end":35.689,"text":"Oh let me hear Thee speaking"},{"start":36.309,"end":37.867,"text":"In accents clear and still,"},{"start":38.247,"end":39.781,"text":"Above the storms of passion,"},{"start":40.161,"end":41.536,"text":"The murmurs of self-will;"},{"start":41.996,"end":43.352,"text":"Oh speak to reassure me"},{"start":43.972,"end":45.492,"text":"To hasten, or control;"},{"start":45.952,"end":47.654,"text":"Oh speak, and make me listen,"},{"start":48.034,"end":49.493,"text":"Thou Guardian of my soul."}],"start":34.253,"end":49.493},{"key":"4","lines":[{"start":51.263,"end":53.071,"text":"O Jesus, Thou hast promised"},{"start":53.691,"end":54.83,"text":"To all who follow Thee"},{"start":55.45,"end":57.032,"text":"That where Thou art in glory"},{"start":57.652,"end":59.021,"text":"There shall Thy servant be"},{"start":59.641,"end":61.189,"text":"And Jesus I have promised"},{"start":61.809,"end":63.177,"text":"To serve Thee to the end!"},{"start":63.797,"end":65.337,"text":"Oh give me grace to follow,"},{"start":65.717,"end":67.3,"text":"My Master tind my Friend."}],"start":51.263,"end":67.3},{"key":"5","lines":[{"start":69.07,"end":70.59,"text":"Oh let me see Thy footmarks"},{"start":71.21,"end":72.755,"text":"And in them plant mine own;"},{"start":73.215,"end":74.67,"text":"My hope to follow duly"},{"start":75.29,"end":76.691,"text":"Is in Thy strength alone,"},{"start":77.071,"end":78.701,"text":"Oh guide me, call me,draw me,"},{"start":79.081,"end":80.357,"text":"Uphold me to the end;"},{"start":80.817,"end":82.396,"text":"And then in heaven receive me,"},{"start":82.776,"end":84.205,"text":"My Saviour and my Friend."}],"start":69.07,"end":84.205}]},"daniel":{"file":"en-631-daniel.m4a","bytes":834661,"sha256":"0cd16f031b870f61b1e28a69fa667fa28efc81f164b253799304001e011b911d","duration":85.983,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.85,"text":"O Jesus I have promised"},{"start":2.47,"end":3.784,"text":"To serve Thee to the end;"},{"start":4.244,"end":5.594,"text":"Be Thou forever near me,"},{"start":5.974,"end":7.427,"text":"My master and my friend;"},{"start":7.887,"end":9.247,"text":"I shall not tear the battle"},{"start":9.867,"end":11.355,"text":"If thou art by my side,"},{"start":11.735,"end":13.392,"text":"Nor wander from the pathway"},{"start":14.012,"end":15.376,"text":"If thou will be my Guide."}],"start":0.35,"end":15.376},{"key":"2","lines":[{"start":17.146,"end":18.534,"text":"Oh let me feel Thee near me;"},{"start":18.994,"end":20.46,"text":"The world is ever drear;"},{"start":20.92,"end":22.503,"t