{"v":1,"coll":"en","num":308,"id":"hymn_308","title":"WEEPING will not save me!","duration":62.877,"voices":{"grace":{"file":"en-308-grace.m4a","bytes":559317,"sha256":"c0df7ab853ac98b146936f7221802665315946d3afb3c0b5c4e4d54824d61d57","duration":62.877,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.727,"text":"WEEPING will not save me!"},{"start":2.347,"end":3.703,"text":"Though my face were bathed"},{"start":4.323,"end":5.126,"text":"in tears"},{"start":5.746,"end":7.568,"text":"That could not, allay my fears"},{"start":8.188,"end":9.987,"text":"Could not wash the sins of years"},{"start":10.607,"end":11.984,"text":"Weeping will not save me!"}],"start":0.35,"end":11.984},{"key":"CHORUS","lines":[{"start":13.754,"end":15.413,"text":"Jesus wept and died for me"},{"start":16.033,"end":17.635,"text":"Jesus suffered on the tree"},{"start":18.255,"end":19.971,"text":"Jesus waits to make me free"},{"start":20.591,"end":22.03,"text":"He alone can save me!"}],"start":13.754,"end":22.03},{"key":"2","lines":[{"start":23.8,"end":25.25,"text":"Working will not save me!"},{"start":25.87,"end":27.527,"text":"Purest deeds that I can do"},{"start":28.147,"end":29.912,"text":"Holiest thoughts and feelings too"},{"start":30.532,"end":31.973,"text":"Cannot form my soul anew"},{"start":32.593,"end":34.043,"text":"Working will not save me!"}],"start":23.8,"end":34.043},{"key":"3","lines":[{"start":35.813,"end":37.21,"text":"Waiting will not save me"},{"start":37.83,"end":39.925,"text":"Helpless, guilty, lost, I lie"},{"start":40.545,"end":42.225,"text":"In my car is Marcy's cry"},{"start":42.845,"end":44.265,"text":"If I wait I can but die"},{"start":44.885,"end":46.261,"text":"Waiting will not save me!"}],"start":35.813,"end":46.261},{"key":"4","lines":[{"start":48.031,"end":49.663,"text":"Faith in Christ will save me!"},{"start":50.283,"end":51.839,"text":"Let me trust Thy weeping son"},{"start":52.459,"end":54.107,"text":"Trust the work that He has done"},{"start":54.727,"end"