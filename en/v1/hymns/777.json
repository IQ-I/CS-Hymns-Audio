{"v":1,"coll":"en","num":777,"id":"hymn_777","title":"JESUS the Head of Holy Band","duration":68.694,"voices":{"grace":{"file":"en-777-grace.m4a","bytes":624205,"sha256":"dea13bb3cd3cc6f1d5d722b694091e9bbe614620f7e59393d182bbb765d75cbb","duration":68.694,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.059,"text":"JESUS the Head of Holy Band"},{"start":2.679,"end":4.194,"text":"Bless us here before we go;"},{"start":4.654,"end":6.661,"text":"Father, source of plenteous blessing"},{"start":7.281,"end":8.739,"text":"Descend Thy spirit on us."}],"start":0.35,"end":8.739},{"key":"CHORUS","lines":[{"start":10.509,"end":11.448,"text":"Jah Jehovah - 2ce"},{"start":12.068,"end":14.764,"text":"Glory, honour to our King. - 6x"}],"start":10.509,"end":14.764},{"key":"2","lines":[{"start":16.534,"end":18.819,"text":"Christ Jesus, Saviour we do plead,"},{"start":19.199,"end":20.971,"text":"Save us from world temptation;"},{"start":21.431,"end":23.483,"text":"Provide for us, bless our handwork,"},{"start":23.863,"end":25.532,"text":"Let Thy children never lack."}],"start":16.534,"end":25.532},{"key":"3","lines":[{"start":27.302,"end":29.239,"text":"Bless us throughout the days of life"},{"start":29.859,"end":31.784,"text":"Save (us) from hunger at old age,"},{"start":32.164,"end":33.972,"text":"Let us not lament we pray Thee"},{"start":34.592,"end":36.142,"text":"Let us stand firm to the end."}],"start":27.302,"end":36.142},{"key":"4","lines":[{"start":37.912,"end":39.532,"text":"Kindle the light of Thy Spirit,"},{"start":39.912,"end":41.446,"text":"Amidst Cherub and Seraphim,"},{"start":41.826,"end":43.397,"text":"As our counterpart in Heaven"},{"start":44.017,"end":45.601,"text":"Let us all serve Thee with joy."}],"start":37.912,"end":45.601},{"key":"5","lines":[{"start":47.371,"end":49.24,"text":"Remember all our branches Lord"},{"start":49.86,"end":51.454,"text":"Grant them thy Holy Spirit"},{"start":52.074,"end":54.088,"text":"Save them from witches and wizards"},{"start