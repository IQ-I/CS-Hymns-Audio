{"v":1,"coll":"en","num":749,"id":"hymn_749","title":"SERVANT of God, well done","duration":59.006,"voices":{"grace":{"file":"en-749-grace.m4a","bytes":546087,"sha256":"22138ab78333b9444d98664938375f037204d015bf824db70db302d92d40e402","duration":59.006,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.017,"text":"\"SERVANT of God, well done"},{"start":2.637,"end":4.086,"text":"From all your labour rest"},{"start":4.706,"end":6.633,"text":"Thou has fought and Thou has triumphed"},{"start":7.253,"end":8.695,"text":"Enter Thy Master’s joy”"},{"start":9.315,"end":10.658,"text":"The call came in the night"},{"start":11.278,"end":12.823,"text":"He rais‘d himself to hear"},{"start":13.443,"end":14.985,"text":"The arrow of death enter'd in"},{"start":15.605,"end":17.18,"text":"He fell, but did not fear."}],"start":0.35,"end":17.18},{"key":"2","lines":[{"start":18.95,"end":20.482,"text":"The midnight cry went forth"},{"start":21.102,"end":22.506,"text":"Arise to meet thy God"},{"start":23.126,"end":24.939,"text":"He woke, and saw his commander"},{"start":25.559,"end":27.039,"text":"Through prayer and in faith"},{"start":27.659,"end":29.241,"text":"His soul rose up at once"},{"start":29.861,"end":31.295,"text":"Left this body of clay"},{"start":31.915,"end":33.913,"text":"When morn broke, this body of clay"},{"start":34.533,"end":36.039,"text":"Was found lying down dead."}],"start":18.95,"end":36.039},{"key":"3","lines":[{"start":37.809,"end":39.409,"text":"The pangs of death is past"},{"start":40.029,"end":41.526,"text":"Cares and distress are o'er"},{"start":42.146,"end":43.822,"text":"The days of fighting are all gone"},{"start":44.442,"end":46.17,"text":"His heart has found real peace"},{"start":46.79,"end":48.542,"text":"Soldier of Christ, ‘well done'"},{"start":49.162,"end":50.699,"text":"Keep singing songs of joy"},{"start":51.319,"end":53.409,"text":"Take thy rest in Thy Saviour's breast"},{"start":54.029,"end":55.229,"text":"And rest eternally."},{"start":55.849,