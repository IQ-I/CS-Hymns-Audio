{"v":1,"coll":"en","num":555,"id":"hymn_555","title":"JESUS is Head of Seraph Band","duration":96.46,"voices":{"grace":{"file":"en-555-grace.m4a","bytes":872138,"sha256":"49edc10180eebe3dee9ae5ce15b22503c31f42a1ec7d8179ab47b8355abd4c37","duration":96.46,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.316,"text":"JESUS is Head of Seraph Band"},{"start":2.936,"end":4.301,"text":"We need not be affrightened"},{"start":4.921,"end":6.748,"text":"He captains the boat of our lives"},{"start":7.368,"end":8.734,"text":"We need not be affrightened."}],"start":0.35,"end":8.734},{"key":"CHORUS","lines":[{"start":10.504,"end":11.586,"text":"We need not fear"},{"start":12.206,"end":13.416,"text":"But filled with joy"},{"start":14.036,"end":15.951,"text":"For Jesus shall captain our boat"},{"start":16.571,"end":18.326,"text":"How serious condition may be"},{"start":18.946,"end":20.65,"text":"We shall safely land unhurt."},{"start":21.27,"end":21.957,"text":"Amen."}],"start":10.504,"end":21.957},{"key":"2","lines":[{"start":23.727,"end":25.46,"text":"All we in boat of Christ Jesus"},{"start":26.08,"end":27.536,"text":"Look unto Saviour only,"},{"start":27.916,"end":29.844,"text":"Respose implicit faith in Him"},{"start":30.464,"end":32.015,"text":"He shall land us in safety."}],"start":23.727,"end":32.015},{"key":"3","lines":[{"start":33.785,"end":35.699,"text":"Lord Jesus Saviour whose command"},{"start":36.319,"end":37.699,"text":"Quietened the waves of sea"},{"start":38.319,"end":40.071,"text":"Thou who traversed over the sea,"},{"start":40.451,"end":42.209,"text":"And slept as if unconcerned."}],"start":33.785,"end":42.209},{"key":"4","lines":[{"start":43.979,"end":45.802,"text":"What is the cause of all your fears?"},{"start":46.422,"end":48.28,"text":"Ye, Army of Christ Jesus"},{"start":48.9,"end":50.779,"text":"Jesus who dwellest in our boat"},{"start":51.399,"end":53.118,"text":"Shall make us laugh at all waves."}],"start":43.979,"end":53.118},{"key":"5","lines":[{"st