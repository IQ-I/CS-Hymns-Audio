{"v":1,"coll":"en","num":36,"id":"hymn_36","title":"WHEN shall it Be my Saviour Lord","duration":42.344,"voices":{"grace":{"file":"en-36-grace.m4a","bytes":363054,"sha256":"fe7851e9672d7c7025128b447aae60ad48797e7f84880dedc7cffb9491f3ad7e","duration":42.344,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.154,"text":"WHEN shall it Be my Saviour Lord"},{"start":2.774,"end":4.23,"text":"Gentle, Thee, I may see"},{"start":4.85,"end":6.71,"text":"In Thine rest ladden with blessing"},{"start":7.33,"end":8.619,"text":"Without a covering veil."}],"start":0.35,"end":8.619},{"key":"2","lines":[{"start":10.389,"end":12.257,"text":"Be of help to me while I trod"},{"start":12.877,"end":14.423,"text":"Amidst earthly desires"},{"start":15.043,"end":16.692,"text":"May | in love pray unto Thee"},{"start":17.312,"end":18.932,"text":"Harken unto my prayers."}],"start":10.389,"end":18.932},{"key":"3","lines":[{"start":20.702,"end":22.67,"text":"Father, Thy saving grace I plead"},{"start":23.29,"end":24.635,"text":"My soul I offer Thee"},{"start":25.255,"end":26.822,"text":"All of me receive to be Thine"},{"start":27.442,"end":28.764,"text":"Offer Thine self to me."}],"start":20.702,"end":28.764},{"key":"4","lines":[{"start":30.534,"end":32.229,"text":"Thine Spirit, Father, me endow"},{"start":32.849,"end":34.109,"text":"Let Him abide with me"},{"start":34.729,"end":36.586,"text":"Shinning Light, be Him to my feet"},{"start":37.206,"end":38.568,"text":"Unto eternal rest."},{"start":39.188,"end":39.874,"text":"Amen."}],"start":30.534,"end":39.874}]},"daniel":{"file":"en-36-daniel.m4a","bytes":367545,"sha256":"41f8b557f3caab58e0a2248a3ca5e5649005e5f0922ef358cb6fb3859b5be4ff","duration":41.98,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.193,"text":"WHEN shall it Be my Saviour Lord"},{"start":2.813,"end":4.128,"text":"Gentle, Thee, I may see"},{"start":4.748,"end":6.555,"text":"In Thine rest ladden with blessing"},{"start":7.175,"end":8.503,"text":"Without a covering veil."}],