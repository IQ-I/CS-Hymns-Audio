{"v":1,"coll":"en","num":230,"id":"hymn_230","title":"ANOTHER year is dawning","duration":110.38,"voices":{"grace":{"file":"en-230-grace.m4a","bytes":1016492,"sha256":"0431aeee2c7620cd3e382eb409eb0b5531a44010b17ccefbec124b1bd452eeeb","duration":110.38,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.721,"text":"ANOTHER year is dawning"},{"start":2.341,"end":3.965,"text":"A path unknown, untried"},{"start":4.585,"end":6.259,"text":"He would fill me with foreboding"},{"start":6.879,"end":8.209,"text":"Had I no hand to guide"},{"start":8.829,"end":10.295,"text":"But He who walked beside me"},{"start":10.915,"end":12.371,"text":"All through the yester year"},{"start":12.991,"end":14.391,"text":"Whatever may betide me"},{"start":15.011,"end":16.394,"text":"He’s promised to be near."}],"start":0.35,"end":16.394},{"key":"2","lines":[{"start":18.164,"end":19.61,"text":"Another year with Jesus"},{"start":20.23,"end":21.643,"text":"Ah, then, no dread I know"},{"start":22.263,"end":23.89,"text":"His love is ever precious"},{"start":24.51,"end":25.952,"text":"Howe‘er the winds may blow"},{"start":26.572,"end":28.174,"text":"E‘en when the storm is fiercest,"},{"start":28.554,"end":30.084,"text":"In Him my soul may rest"},{"start":30.704,"end":32.553,"text":"And find sweet peace and comfort"},{"start":33.173,"end":34.577,"text":"In Thy bossom we plead."}],"start":18.164,"end":34.577},{"key":"3","lines":[{"start":36.347,"end":37.776,"text":"Another year to trust Him"},{"start":38.396,"end":40.082,"text":"Yes, I can trust Him still"},{"start":40.702,"end":42.32,"text":"Who never yet has failed me"},{"start":42.94,"end":44.268,"text":"As I have sought His will"},{"start":44.888,"end":46.6,"text":"His rod and staff He giveth"},{"start":47.22,"end":48.703,"text":"To be my strength and stay"},{"start":49.323,"end":50.817,"text":"And tenderly He leadeth"},{"start":51.437,"end":52.746,"text":"Along the homeward way."}],"start":36.347,"end":52.746},{"key":"4","lines":[{"start":54.516