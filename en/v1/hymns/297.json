{"v":1,"coll":"en","num":297,"id":"hymn_297","title":"BEHOLD the Lamb of God","duration":43.936,"voices":{"grace":{"file":"en-297-grace.m4a","bytes":388149,"sha256":"e40373e53f20b61533fa62373c034fe6a30d14633c20b7e053080d522d4c193b","duration":43.936,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.279,"text":"BEHOLD the Lamb of God, who bore"},{"start":2.899,"end":4.281,"text":"Thy burdens on the tree"},{"start":4.901,"end":6.597,"text":"He died the captives to restore"},{"start":7.217,"end":8.691,"text":"His blood was shed for thee."}],"start":0.35,"end":8.691},{"key":"2","lines":[{"start":10.461,"end":12.511,"text":"Look to him, till the sight endears"},{"start":13.131,"end":14.525,"text":"The Saviour to thy heart"},{"start":15.145,"end":16.948,"text":"His pierced feet bedew with tears"},{"start":17.568,"end":19.165,"text":"Nor from His cross depart."}],"start":10.461,"end":19.165},{"key":"3","lines":[{"start":20.935,"end":22.913,"text":"Look to him, till His dying love"},{"start":23.533,"end":24.982,"text":"Thy every thought control"},{"start":25.602,"end":27.778,"text":"Its vast constraining influence Prove"},{"start":28.398,"end":29.979,"text":"O'er body, spirit, soul."}],"start":20.935,"end":29.979},{"key":"4","lines":[{"start":31.749,"end":33.732,"text":"Look to Him, as the race ye run"},{"start":34.352,"end":35.74,"text":"Thy never-failing friend"},{"start":36.36,"end":38.031,"text":"He Will complete the work begun"},{"start":38.651,"end":40.159,"text":"And grace in glory end."},{"start":40.779,"end":41.466,"text":"Amen."}],"start":31.749,"end":41.466}]},"daniel":{"file":"en-297-daniel.m4a","bytes":385533,"sha256":"59676460f0a6d9fecdfc8aa008c644731f69b4d748d61ed9b73dd8aadd6690f6","duration":43.453,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.214,"text":"BEHOLD the Lamb of God, who bore"},{"start":2.834,"end":4.176,"text":"Thy burdens on the tree"},{"start":4.796,"end":6.542,"text":"He died the captives to restore"},{"start":7.162,"end":8.624,"t