{"v":1,"coll":"en","num":515,"id":"hymn_515","title":"HOW sweet the name of Jesus sound","duration":64.376,"voices":{"grace":{"file":"en-515-grace.m4a","bytes":575424,"sha256":"5889a602607ed05ff0f108899e0f905e8b9e22295b3f1c0f707302fa56b87bb7","duration":64.376,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.161,"text":"HOW sweet the name of Jesus sound"},{"start":2.781,"end":3.935,"text":"In a believer’s ear"},{"start":4.555,"end":6.763,"text":"It soothes his sorrows, heals his wounds"},{"start":7.383,"end":8.914,"text":"And drives away his fears."}],"start":0.35,"end":8.914},{"key":"2","lines":[{"start":10.684,"end":12.404,"text":"It makes the wounded spirit whole"},{"start":13.024,"end":14.694,"text":"And calms the troubled breast"},{"start":15.314,"end":16.958,"text":"‘Tis manna to the hungry soul"},{"start":17.578,"end":18.863,"text":"And to the weary rest."}],"start":10.684,"end":18.863},{"key":"3","lines":[{"start":20.633,"end":22.52,"text":"Dear name the rock on which I built"},{"start":23.14,"end":24.728,"text":"My shield and hiding place"},{"start":25.348,"end":27.394,"text":"My never failing treasury, filled"},{"start":28.014,"end":29.701,"text":"With boundless stores of grace."}],"start":20.633,"end":29.701},{"key":"4","lines":[{"start":31.471,"end":33.754,"text":"Jesus my shepherd, husband, Friend"},{"start":34.374,"end":36.062,"text":"My Prophet, Priest and King"},{"start":36.682,"end":38.622,"text":"My Lord, my life, my way, my end"},{"start":39.242,"end":40.667,"text":"Accept the praise I bring."}],"start":31.471,"end":40.667},{"key":"5","lines":[{"start":42.437,"end":44.187,"text":"Week is the effort of my heart"},{"start":44.807,"end":46.287,"text":"And cold my warmest thought"},{"start":46.907,"end":48.528,"text":"But when I see thee as Thou art"},{"start":49.148,"end":50.553,"text":"I’ll praise Thee as I ought."}],"start":42.437,"end":50.553},{"key":"6","lines":[{"start":52.323,"end":54.368,"text":"Till then I would Thy love proclaim"},{"start":54.988,"end":56.47,"text":"With every fleeting breadth:"},{"start":56.93,"end":58.475,"text":"And may the music of thy name"},{"start":59.095,"end":60.6,"text":"Refresh my soul in death."},{"start":61.22,"end":61.907,"text":"Amen."}],"start":52.323,"end":61.907}]},"daniel":{"file":"en-515-daniel.m4a","bytes":569158,"sha256":"fb4111cc69a426addbdc9eefb87d9bbce9d7eb62a707f8c53e6e22ab25c816f9","duration":63.331,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.217,"text":"HOW sweet the name of Jesus sound"},{"start":2.837,"end":3.987,"text":"In a believer’s ear"},{"start":4.607,"end":6.74,"text":"It soothes his sorrows, heals his wounds"},{"start":7.36,"end":8.878,"text":"And drives away his fears."}],"start":0.35,"end":8.878},{"key":"2","lines":[{"start":10.648,"end":12.386,"text":"It makes the wounded spirit whole"},{"start":13.006,"end":14.634,"text":"And calms the troubled breast"},{"start":15.254,"end":16.866,"text":"‘Tis manna to the hungry soul"},{"start":17.486,"end":18.729,"text":"And to the weary rest."}],"start":10.648,"end":18.729},{"key":"3","lines":[{"start":20.499,"end":22.428,"text":"Dear name the rock on which I built"},{"start":23.048,"end":24.589,"text":"My shield and hiding place"},{"start":25.209,"end":27.189,"text":"My never failing treasury, filled"},{"start":27.809,"end":29.522,"text":"With boundless stores of grace."}],"start":20.499,"end":29.522},{"key":"4","lines":[{"start":31.292,"end":33.369,"text":"Jesus my shepherd, husband, Friend"},{"start":33.989,"end":35.605,"text":"My Prophet, Priest and King"},{"start":36.225,"end":38.125,"text":"My Lord, my life, my way, my end"},{"start":38.745,"end":40.163,"text":"Accept the praise I bring."}],"start":31.292,"end":40.163},{"key":"5","lines":[{"start":41.933,"end":43.581,"text":"Week is the effort of my heart"},{"start":44.201,"end":45.691,"text":"And cold my warmest thought"},{"start":46.311,"end":47.896,"text":"But when I see thee as Thou art"},{"start":48.516,"end":49.898,"text":"I’ll pr