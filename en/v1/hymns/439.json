{"v":1,"coll":"en","num":439,"id":"hymn_439","title":"CHRIST Jesus is my Shepherd","duration":90.357,"voices":{"grace":{"file":"en-439-grace.m4a","bytes":833438,"sha256":"84157ac16a4e21887dd44cf3bc12a2dbc968736d5a451cf7c290f3013958181f","duration":90.357,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.089,"text":"CHRIST Jesus is my Shepherd"},{"start":2.709,"end":4.194,"text":"I shall never ever lack"},{"start":4.814,"end":6.878,"text":"Jesus Shepherd of His chosen ones"},{"start":7.498,"end":9.235,"text":"Me He leads beside waters"},{"start":9.855,"end":11.541,"text":"Lying down in pastures green"},{"start":12.161,"end":14.32,"text":"In comfort my gentle soul restore."}],"start":0.35,"end":14.32},{"key":"CHORUS","lines":[{"start":16.09,"end":18.047,"text":"Come rejoice; praising the Lord"},{"start":18.667,"end":20.276,"text":"In-com-pre‐hen-sibly deep"},{"start":20.896,"end":22.347,"text":"Holy Messiah we plead"},{"start":22.967,"end":24.504,"text":"May we from Thee not depart"},{"start":25.124,"end":26.423,"text":"By grace may we reign"},{"start":27.043,"end":28.013,"text":"with Thee above."}],"start":16.09,"end":28.013},{"key":"2","lines":[{"start":29.783,"end":31.232,"text":"Though I tred within valley"},{"start":31.852,"end":33.36,"text":"Of dreary shadow of death"},{"start":33.98,"end":35.855,"text":"And the billows of death o’er me roll"},{"start":36.475,"end":37.976,"text":"I shall not of evil fear"},{"start":38.596,"end":40.003,"text":"Whatever on me enthrall"},{"start":40.623,"end":42.423,"text":"God of glory e’er with me abide."}],"start":29.783,"end":42.423},{"key":"3","lines":[{"start":44.193,"end":45.929,"text":"Thou my daily bread provides"},{"start":46.549,"end":48.045,"text":"In the presence of my foes"},{"start":48.665,"end":50.637,"text":"With Thy precious oil my head anoint"},{"start":51.257,"end":53.044,"text":"Thy blessings goodness, mercy"},{"start":53.664,"end":55.11,"text":"Shall for e‘er With me abide"},{"start":55.73,"end":58.073,"te