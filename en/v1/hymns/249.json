{"v":1,"coll":"en","num":249,"id":"hymn_249","title":"OH! Gladly we behold the grace","duration":42.844,"voices":{"grace":{"file":"en-249-grace.m4a","bytes":372997,"sha256":"db6ddc63809762b86e48eea81a7637f5f731e5d561915f686268f96bc09382b3","duration":42.844,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.278,"text":"OH! Gladly we behold the grace"},{"start":2.898,"end":4.655,"text":"Of Christ our Great High Priest"},{"start":5.275,"end":7.175,"text":"His heart is filled with compassion"},{"start":7.795,"end":9.204,"text":"And rejoiceth for love."}],"start":0.35,"end":9.204},{"key":"2","lines":[{"start":10.974,"end":12.552,"text":"Passionately us He bemoans"},{"start":13.172,"end":14.691,"text":"Our weakness all He knows"},{"start":15.311,"end":17.318,"text":"Of temptations also He knows"},{"start":17.938,"end":19.278,"text":"For of same He partook."}],"start":10.974,"end":19.278},{"key":"3","lines":[{"start":21.048,"end":22.57,"text":"He also while sojourning here"},{"start":23.19,"end":24.578,"text":"Bitterly thus He wept"},{"start":25.198,"end":26.835,"text":"With everyone He also share"},{"start":27.455,"end":28.905,"text":"Of all our grief and pain."}],"start":21.048,"end":28.905},{"key":"4","lines":[{"start":30.675,"end":32.533,"text":"Humbly with faith let us all seek"},{"start":33.153,"end":34.673,"text":"His compassion and strength"},{"start":35.293,"end":37.047,"text":"Salvation we shall all receive"},{"start":37.667,"end":39.068,"text":"When trouble shall erupt."},{"start":39.688,"end":40.374,"text":"Amen."}],"start":30.675,"end":40.374}]},"daniel":{"file":"en-249-daniel.m4a","bytes":374005,"sha256":"e84f80701ad2d684d456170e27f0ebb6ab57a5e9705a9aee35f3314471763669","duration":42.372,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.088,"text":"OH! Gladly we behold the grace"},{"start":2.708,"end":4.457,"text":"Of Christ our Great High Priest"},{"start":5.077,"end":6.886,"text":"His heart is filled with compassion"},{"start":7.506,"end":8.89,"text