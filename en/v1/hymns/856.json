{"v":1,"coll":"en","num":856,"id":"hymn_856","title":"I always go to Jesus","duration":55.836,"voices":{"grace":{"file":"en-856-grace.m4a","bytes":505663,"sha256":"1e422b8303958d0a7c48930f86056e37fc19fc5071f8ff8d28edd7d7d8274dfc","duration":55.836,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.797,"text":"I always go to Jesus"},{"start":2.417,"end":3.953,"text":"When troubled or distressed"},{"start":4.573,"end":6.094,"text":"I always find a refuge"},{"start":6.714,"end":8.19,"text":"Upon His loving breast"},{"start":8.81,"end":10.23,"text":"I tell Him all my trials"},{"start":10.85,"end":12.196,"text":"I tell Him all my grief"},{"start":12.816,"end":14.335,"text":"And while my lips are speaking"},{"start":14.955,"end":16.402,"text":"He gives my heart relief."}],"start":0.35,"end":16.402},{"key":"2","lines":[{"start":18.172,"end":19.863,"text":"When full of dread forebodings"},{"start":20.483,"end":21.951,"text":"And flowing o'er my tears"},{"start":22.572,"end":24.024,"text":"He calms away my sorrow"},{"start":24.644,"end":26.15,"text":"And hushes all my fears"},{"start":26.77,"end":28.433,"text":"He comprehends my weakness"},{"start":29.053,"end":30.201,"text":"The peril I am in"},{"start":30.821,"end":32.335,"text":"And He supplies the armour"},{"start":32.955,"end":34.299,"text":"I need to conquer sin."}],"start":18.172,"end":34.299},{"key":"3","lines":[{"start":36.069,"end":37.517,"text":"I always go to Jesus"},{"start":38.137,"end":39.547,"text":"No matter when or where"},{"start":40.167,"end":41.824,"text":"I seek His gracious presence"},{"start":42.444,"end":43.829,"text":"I’m sure to find Him there"},{"start":44.449,"end":46.051,"text":"In times of joy or sorrow"},{"start":46.671,"end":47.984,"text":"What’er my need may be"},{"start":48.604,"end":50.051,"text":"I always go to Jesus"},{"start":50.671,"end":52.059,"text":"And Jesus comes to me."},{"start":52.679,"end":53.366,"text":"Amen."}],"start":36.069,"end":53.366}]},"daniel":{"file":"en-856-danie