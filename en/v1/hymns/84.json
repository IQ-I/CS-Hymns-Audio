{"v":1,"coll":"en","num":84,"id":"hymn_84","title":"YE angels that dwell in Heaven","duration":118.113,"voices":{"grace":{"file":"en-84-grace.m4a","bytes":1136590,"sha256":"103ec9aafdee20f7a1036d74b03a174208d757a68c889301f10cc6cd143fac89","duration":118.113,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.116,"text":"YE angels that dwell in Heaven,"},{"start":2.496,"end":3.925,"text":"Give praise to our Father,"},{"start":4.305,"end":6.169,"text":"For the band established here below"},{"start":6.789,"end":8.134,"text":"For the redemption of soul;"},{"start":8.594,"end":10.683,"text":"Therefore let's rejoice and be glad"},{"start":11.303,"end":12.656,"text":"And then shout Hallelujah,"},{"start":13.036,"end":14.826,"text":"In remembrance of Jesus death"},{"start":15.446,"end":16.964,"text":"Painful death on the cross."}],"start":0.35,"end":16.964},{"key":"CHORUS","lines":[{"start":18.734,"end":20.17,"text":"There's Command from Heaven's"},{"start":20.79,"end":21.673,"text":"Courts above"},{"start":22.293,"end":24.028,"text":"That this Band must multiply!"},{"start":24.648,"end":26.084,"text":"There's Command from heaven's"},{"start":26.704,"end":27.613,"text":"Courts above,"},{"start":27.993,"end":29.906,"text":"It must grow from strength to strength;"},{"start":30.366,"end":32.458,"text":"Till Blind in spirit behold Light"},{"start":33.078,"end":34.738,"text":"In this world and that to come"},{"start":35.358,"end":37.369,"text":"So that death of Jesus on Cross"},{"start":37.989,"end":39.513,"text":"Would never pass in vain."}],"start":18.734,"end":39.513},{"key":"2","lines":[{"start":41.283,"end":42.859,"text":"Ye Cherubirn and Seraphim"},{"start":43.479,"end":45.003,"text":"Give praises to our Father,"},{"start":45.383,"end":47.265,"text":"Who has established this Holy Band"},{"start":47.885,"end":49.273,"text":"To procure us salvation;"},{"start":49.733,"end":51.73,"text":"Therefore let us run the swift race"},{"start":52.35,"end":53.707,"text":"Of service to Almighty"},{"start":54.327,"end":56.145,"text":"Perseverance to the end shall bring"},{"start":56.765,"end":58.276,"text":"Everlasting life to us."}],"start":41.283,"end":58.276},{"key":"3","lines":[{"start":60.046,"end":61.8,"text":"All the works we do in this world"},{"start":62.42,"end":63.859,"text":"All the characters we show"},{"start":64.479,"end":66.318,"text":"All the words that we utter therein"},{"start":66.938,"end":68.547,"text":"Let’s be watchful and careful"},{"start":69.167,"end":71.011,"text":"For the Lord shall bring to Judgement"},{"start":71.631,"end":73.094,"text":"All that we do in this world"},{"start":73.714,"end":75.454,"text":"With every secret thing we do"},{"start":76.074,"end":77.346,"text":"Be it good or evil."}],"start":60.046,"end":77.346},{"key":"4","lines":[{"start":79.116,"end":81.433,"text":"Jesus proclameth us Light of world"},{"start":82.053,"end":83.691,"text":"To cast all darkness away;"},{"start":84.151,"end":85.875,"text":"The city built on the top of Hill"},{"start":86.495,"end":88.086,"text":"Can never hide from vision,"},{"start":88.466,"end":90.567,"text":"God has made us the salt of the earth"},{"start":91.187,"end":92.668,"text":"To greatly sweeten the earth"},{"start":93.288,"end":94.996,"text":"But if salt has lost its savour,"},{"start":95.376,"end":96.622,"text":"How can it be seasoned?"}],"start":79.116,"end":96.622},{"key":"5","lines":[{"start":98.392,"end":100.142,"text":"Glory be to Lord our saviour"},{"start":100.762,"end":102.361,"text":"For the love bestowed on us"},{"start":102.981,"end":104.755,"text":"Calling us into this Holy Band"},{"start":105.375,"end":107.18,"text":"The lst Ark of Salvation"},{"start":107.8,"end":109.494,"text":"Glory and honour Might and power,"},{"start":109.874,"end":111.319,"text":"Highest honour and wisdom"},{"start":111.939,"end":114.108,"text":"To Father, Son and Holy Ghost, For"},{"start":114.728,"end":115.643,"text":"ever Trinity."}],"start":98.392,"end":115.643}]},"daniel"