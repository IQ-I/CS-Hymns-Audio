{"v":1,"coll":"en","num":137,"id":"hymn_137","title":"IN the Name of Jesus","duration":81.992,"voices":{"grace":{"file":"en-137-grace.m4a","bytes":726718,"sha256":"376fa134a85127198591c6254440aee5bd3b18f11e4a848ae35ea28629421dc2","duration":81.992,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.591,"text":"IN the Name of Jesus"},{"start":2.211,"end":3.354,"text":"Every knee shall bow"},{"start":3.974,"end":5.422,"text":"Every tongue confess Him"},{"start":6.042,"end":7.217,"text":"King of Glory now"},{"start":7.837,"end":9.144,"text":"‘Tis the Father’s pleasure"},{"start":9.764,"end":10.991,"text":"We should call Him Lord"},{"start":11.611,"end":12.815,"text":"Who from the beginning"},{"start":13.435,"end":14.613,"text":"Was the mighty word."}],"start":0.35,"end":14.613},{"key":"2","lines":[{"start":16.383,"end":17.643,"text":"Humbled for a season"},{"start":18.263,"end":19.406,"text":"To receive a name"},{"start":20.026,"end":21.298,"text":"From the lips of sinners"},{"start":21.918,"end":23.123,"text":"Unto whom He came"},{"start":23.743,"end":25.074,"text":"Faithfully He bore it"},{"start":25.694,"end":27.002,"text":"Spotless to the last"},{"start":27.622,"end":29.081,"text":"Brought it back victorious"},{"start":29.701,"end":31.063,"text":"When form death Separate."}],"start":16.383,"end":31.063},{"key":"3","lines":[{"start":32.833,"end":34.551,"text":"Name Him, brothers, name Him,"},{"start":34.931,"end":36.425,"text":"With love strong as death"},{"start":37.045,"end":38.42,"text":"But with awe and wonder"},{"start":39.04,"end":40.314,"text":"And with bated breath"},{"start":40.934,"end":42.23,"text":"He is Christ the Lord"},{"start":42.849,"end":44.06,"text":"Ever to be worshipped"},{"start":44.68,"end":45.992,"text":"Trusted, and adored."}],"start":32.833,"end":45.992},{"key":"4","lines":[{"start":47.762,"end":49.144,"text":"In your hearts enthrone Him"},{"start":49.764,"end":50.877,"text":"There let Him subdue"},{"start":51.497,"end":52.778,"text":"All