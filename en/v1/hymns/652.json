{"v":1,"coll":"en","num":652,"id":"hymn_652","title":"SWEET feast of love divine","duration":62.816,"voices":{"grace":{"file":"en-652-grace.m4a","bytes":549044,"sha256":"fbc7394017dc058a1e1c31a8a229a4f608b71ae2f34fe51b695363de1eebf35d","duration":62.816,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.98,"text":"SWEET feast of love divine"},{"start":2.6,"end":4.263,"text":"Tis grace that makes us free"},{"start":4.883,"end":6.588,"text":"To feed upon this bread and wine"},{"start":7.208,"end":8.875,"text":"In mem‘ry, Lord of Thee."}],"start":0.35,"end":8.875},{"key":"2","lines":[{"start":10.645,"end":12.22,"text":"Here every welcome guest"},{"start":12.84,"end":14.457,"text":"Waits, Lord, from Thee to learn"},{"start":15.077,"end":16.942,"text":"The secrets of Thy Father’s breast"},{"start":17.562,"end":18.971,"text":"And all Thy grace discern."}],"start":10.645,"end":18.971},{"key":"3","lines":[{"start":20.741,"end":22.506,"text":"Here conscience ends its strife"},{"start":23.126,"end":24.711,"text":"And faith delights to prove"},{"start":25.331,"end":27.131,"text":"The sweetness of the bread of life"},{"start":27.751,"end":29.189,"text":"The fullness of Thy love."}],"start":20.741,"end":29.189},{"key":"4","lines":[{"start":30.959,"end":32.479,"text":"The blood that flow‘d for sin"},{"start":33.099,"end":34.395,"text":"In symbol here we see"},{"start":35.014,"end":36.691,"text":"And feel the blessed pledge within"},{"start":37.311,"end":38.594,"text":"That we are loved of Thee."}],"start":30.959,"end":38.594},{"key":"5","lines":[{"start":40.364,"end":42.014,"text":"Oh, if this glimpse of love"},{"start":42.634,"end":44.042,"text":"Is so divinely sweet"},{"start":44.662,"end":46.56,"text":"What will it be, O Lord, above"},{"start":47.18,"end":48.803,"text":"Thy gladdening smile to meet."}],"start":40.364,"end":48.803},{"key":"6","lines":[{"start":50.573,"end":52.046,"text":"To see Thee face to face"},{"start":52.666,"end":54.201,"text":"Thy perfect likeness wea