{"v":1,"coll":"en","num":582,"id":"hymn_582","title":"WITH the sweet word of peace","duration":60.708,"voices":{"grace":{"file":"en-582-grace.m4a","bytes":521896,"sha256":"53b33d3577621d54911a69765fa90535d827c58d6b2b6c7f4c3d0b1ea5bd95c2","duration":60.708,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.907,"text":"WITH the sweet word of peace"},{"start":2.527,"end":3.997,"text":"We bid our brethren go"},{"start":4.617,"end":6.461,"text":"Peace, as a river, to increase"},{"start":7.081,"end":8.252,"text":"And ceaseless flow."}],"start":0.35,"end":8.252},{"key":"2","lines":[{"start":10.022,"end":11.597,"text":"With the calm word of pray‘r"},{"start":12.216,"end":13.524,"text":"We earnestly commend"},{"start":14.144,"end":15.961,"text":"Our brethren to Thy watchful care"},{"start":16.581,"end":17.6,"text":"Eternal Friend."}],"start":10.022,"end":17.6},{"key":"3","lines":[{"start":19.37,"end":20.844,"text":"With the dear word of love"},{"start":21.464,"end":22.813,"text":"We give our brief farewell"},{"start":23.433,"end":25.262,"text":"Our love below, and Thine above"},{"start":25.882,"end":27.057,"text":"With them shall dwell."}],"start":19.37,"end":27.057},{"key":"4","lines":[{"start":28.827,"end":30.474,"text":"With the strong word of faith"},{"start":31.094,"end":32.54,"text":"We stay ourselves on Thee"},{"start":33.16,"end":35.417,"text":"That Thou, O Lord, in life and death"},{"start":36.037,"end":37.196,"text":"Their help shall be."}],"start":28.827,"end":37.196},{"key":"5","lines":[{"start":38.966,"end":40.442,"text":"Then the bright word of hope"},{"start":41.062,"end":42.485,"text":"Shall on our parting gleam"},{"start":43.105,"end":44.962,"text":"And tell of joys beyond the scope"},{"start":45.582,"end":46.832,"text":"Of earth-born dream."}],"start":38.966,"end":46.832},{"key":"6","lines":[{"start":48.602,"end":50.371,"text":"Farewell; in hope and love"},{"start":50.991,"end":52.855,"text":"In faith, and peace, and prayer"},{"start":53.475,"end":55.348,"text":"Till He whose home is ours above"},{"start":55.968,"end":56.932,"text":"Unite us there."},{"start":57.552,"end":58.238,"text":"Amen."}],"start":48.602,"end":58.238}]},"daniel":{"file":"en-582-daniel.m4a","bytes":519276,"sha256":"2dcbc41bfa272daf53f8e0bce23eb96038878713ef1cf7799ca31c9387b742c3","duration":60.125,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.88,"text":"WITH the sweet word of peace"},{"start":2.5,"end":3.927,"text":"We bid our brethren go"},{"start":4.547,"end":6.285,"text":"Peace, as a river, to increase"},{"start":6.905,"end":8.071,"text":"And ceaseless flow."}],"start":0.35,"end":8.071},{"key":"2","lines":[{"start":9.841,"end":11.382,"text":"With the calm word of pray‘r"},{"start":12.002,"end":13.296,"text":"We earnestly commend"},{"start":13.916,"end":15.817,"text":"Our brethren to Thy watchful care"},{"start":16.438,"end":17.431,"text":"Eternal Friend."}],"start":9.841,"end":17.431},{"key":"3","lines":[{"start":19.201,"end":20.663,"text":"With the dear word of love"},{"start":21.283,"end":22.735,"text":"We give our brief farewell"},{"start":23.355,"end":25.189,"text":"Our love below, and Thine above"},{"start":25.809,"end":27.073,"text":"With them shall dwell."}],"start":19.201,"end":27.073},{"key":"4","lines":[{"start":28.843,"end":30.406,"text":"With the strong word of faith"},{"start":31.026,"end":32.465,"text":"We stay ourselves on Thee"},{"start":33.085,"end":35.201,"text":"That Thou, O Lord, in life and death"},{"start":35.821,"end":36.947,"text":"Their help shall be."}],"start":28.843,"end":36.947},{"key":"5","lines":[{"start":38.717,"end":40.082,"text":"Then the bright word of hope"},{"start":40.702,"end":42.105,"text":"Shall on our parting gleam"},{"start":42.725,"end":44.537,"text":"And tell of joys beyond the scope"},{"start":45.157,"end":46.399,"text":"Of earth-born dream."}],"start":38.717,"end":46.399},{"key":"6","lines":[{"start":48.169,"end":49.835,"text":"Farewell; in hope and love"},{"start":50.455,"end":52.204,"