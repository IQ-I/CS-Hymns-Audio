{"v":1,"coll":"en","num":634,"id":"hymn_634","title":"AWAKE, my soul! stretch every nerve","duration":42.642,"voices":{"grace":{"file":"en-634-grace.m4a","bytes":381471,"sha256":"005313036a90abe1f3971e8eee73a3d6c632aa733e612ecce1deb025a9dd261c","duration":42.642,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.674,"text":"AWAKE, my soul! stretch every nerve"},{"start":3.294,"end":4.693,"text":"And press with vigour on"},{"start":5.313,"end":7.175,"text":"A heav'nly race demands thy zeal"},{"start":7.795,"end":9.105,"text":"And an immortal crown."}],"start":0.35,"end":9.105},{"key":"2","lines":[{"start":10.875,"end":12.495,"text":"A cloud of witnesses around"},{"start":13.115,"end":14.58,"text":"Hold thee in full survey"},{"start":15.2,"end":16.87,"text":"Forget the steps already trod"},{"start":17.49,"end":18.994,"text":"And onward urge thy way."}],"start":10.875,"end":18.994},{"key":"3","lines":[{"start":20.764,"end":22.729,"text":"“'lis God’s all-animatting Voice"},{"start":23.349,"end":24.837,"text":"That calls thee from on high"},{"start":25.457,"end":27.553,"text":"'Tis His own Hand presents the prize"},{"start":28.174,"end":29.506,"text":"To thine aspiring eye."}],"start":20.764,"end":29.506},{"key":"4","lines":[{"start":31.276,"end":33.34,"text":"Blest Saviour, introduced by Thee"},{"start":33.96,"end":35.29,"text":"Have I my race begun"},{"start":35.91,"end":38.108,"text":"And crown’d with vict’ry, at Thy feet"},{"start":38.728,"end":40.172,"text":"I’ll lay my honours down."}],"start":31.276,"end":40.172}]},"daniel":{"file":"en-634-daniel.m4a","bytes":377125,"sha256":"b213d68614472c32a83851da752453a709028b0ab12491fce63bdb7ea3631feb","duration":42.128,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.562,"text":"AWAKE, my soul! stretch every nerve"},{"start":3.182,"end":4.546,"text":"And press with vigour on"},{"start":5.166,"end":7.087,"text":"A heav'nly race demands thy zeal"},{"start":7.707,"end":9.066,"text":"And an immortal crown."}],"start":0.3