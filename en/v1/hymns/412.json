{"v":1,"coll":"en","num":412,"id":"hymn_412","title":"GO when the morning shineth","duration":74.442,"voices":{"grace":{"file":"en-412-grace.m4a","bytes":684686,"sha256":"8d23107137b4b548c58bfd7cd6de62c296b35b3fb4de8bfdcc69d00942138dc0","duration":74.442,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.8,"text":"GO when the morning shineth"},{"start":2.42,"end":3.926,"text":"Go, when the noon is bright"},{"start":4.546,"end":6.227,"text":"Go, when the eve declineth"},{"start":6.847,"end":8.381,"text":"Go, in the hush of night"},{"start":9.001,"end":10.693,"text":"Go with pure mind and feeling"},{"start":11.313,"end":12.878,"text":"Fling earthly cares away"},{"start":13.498,"end":14.937,"text":"And in thy chamber kneeling"},{"start":15.557,"end":17.099,"text":"Do thou in secret pray."}],"start":0.35,"end":17.099},{"key":"2","lines":[{"start":18.869,"end":20.379,"text":"Remember all who love thee"},{"start":20.999,"end":22.366,"text":"All who are loved by thee"},{"start":22.986,"end":24.683,"text":"Pray too for those who hate thee"},{"start":25.303,"end":26.585,"text":"If any such there be"},{"start":27.205,"end":28.866,"text":"Then for thyself in meekness"},{"start":29.486,"end":30.892,"text":"A blessing humbly claim"},{"start":31.512,"end":33.022,"text":"And link with each petition"},{"start":33.642,"end":35.09,"text":"Thy great Redeemer's name."}],"start":18.869,"end":35.09},{"key":"3","lines":[{"start":36.86,"end":38.416,"text":"Or if ‘tis here denied thee"},{"start":39.036,"end":40.262,"text":"In solitude to pray"},{"start":40.882,"end":42.466,"text":"Should holy thoughts come o'er thee"},{"start":43.086,"end":44.609,"text":"When friends are round thy way"},{"start":45.229,"end":46.505,"text":"When then silent pleading"},{"start":47.125,"end":48.621,"text":"Of thy heart raised above"},{"start":49.241,"end":50.841,"text":"Will reach His throne of glory"},{"start":51.461,"end":53.38,"text":"Who's mercy, truth, and love."}],"start":36.86,"end":53.38},{"key":"4","lines":[{"start":55.15,"end":56.728,"text":"Oh, not a joy or blessing"},{"start":57.348,"end":58.769,"text":"With this can we compare"},{"start":59.389,"end":61.047,"text":"The pow’r that He has giv’n us"},{"start":61.667,"end":63.128,"text":"To pour our souls in pray’r"},{"start":63.748,"end":65.551,"text":"Where’er thou pin'st in sadness"},{"start":66.171,"end":67.606,"text":"Before His footstool fall"},{"start":68.226,"end":69.749,"text":"Remember in thy gladness"},{"start":70.369,"end":71.972,"text":"His grace who gives thee all."}],"start":55.15,"end":71.972}]},"daniel":{"file":"en-412-daniel.m4a","bytes":679444,"sha256":"8104db2cd084264c355aacecca52bc73c125e7e777a388d3dc6c0771164c82b5","duration":73.093,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.724,"text":"GO when the morning shineth"},{"start":2.344,"end":3.743,"text":"Go, when the noon is bright"},{"start":4.363,"end":5.903,"text":"Go, when the eve declineth"},{"start":6.523,"end":7.871,"text":"Go, in the hush of night"},{"start":8.491,"end":10.075,"text":"Go with pure mind and feeling"},{"start":10.695,"end":12.177,"text":"Fling earthly cares away"},{"start":12.797,"end":14.146,"text":"And in thy chamber kneeling"},{"start":14.766,"end":16.233,"text":"Do thou in secret pray."}],"start":0.35,"end":16.233},{"key":"2","lines":[{"start":18.003,"end":19.422,"text":"Remember all who love thee"},{"start":20.042,"end":21.336,"text":"All who are loved by thee"},{"start":21.956,"end":23.622,"text":"Pray too for those who hate thee"},{"start":24.242,"end":25.426,"text":"If any such there be"},{"start":26.046,"end":27.718,"text":"Then for thyself in meekness"},{"start":28.338,"end":29.729,"text":"A blessing humbly claim"},{"start":30.349,"end":31.871,"text":"And link with each petition"},{"start":32.491,"end":33.868,"text":"Thy great Redeemer's name."}],"start":18.003,"end":33.868},{"key":"3","lines":[{"start":35.638,"end":37.168,"text":"Or if ‘tis here denied thee"},{"start":37.788,"end":39.077,"text":"I