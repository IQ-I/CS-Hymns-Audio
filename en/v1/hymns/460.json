{"v":1,"coll":"en","num":460,"id":"hymn_460","title":"MY spirit on Thy care,","duration":40.756,"voices":{"grace":{"file":"en-460-grace.m4a","bytes":351714,"sha256":"b331c5412ffe871ffce5c0434f2f6764bf33b1a7a7ff82f9738d45983655302d","duration":40.756,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.636,"text":"MY spirit on Thy care,"},{"start":2.016,"end":3.649,"text":"Blest Saviour. I recline"},{"start":4.269,"end":6.014,"text":"Thou will not leave me in despair"},{"start":6.634,"end":8.154,"text":"For Thou art Love divine."}],"start":0.35,"end":8.154},{"key":"2","lines":[{"start":9.924,"end":11.493,"text":"In Thee I place my trust"},{"start":12.113,"end":13.518,"text":"On Thee I calmly rest"},{"start":14.138,"end":15.916,"text":"I know Thee good, I know Thee just"},{"start":16.536,"end":18.095,"text":"And count Thy choice the best."}],"start":9.924,"end":18.095},{"key":"3","lines":[{"start":19.865,"end":21.266,"text":"Whate’er events betide"},{"start":21.886,"end":23.275,"text":"Thy will they all perform"},{"start":23.895,"end":25.729,"text":"Safe in Thy breast my head I hide"},{"start":26.349,"end":27.887,"text":"Nor fear the coming storm."}],"start":19.865,"end":27.887},{"key":"4","lines":[{"start":29.657,"end":31.08,"text":"Let good or ill befall"},{"start":31.7,"end":32.973,"text":"It must be good for me"},{"start":33.593,"end":35.115,"text":"Secure of having Thee in all"},{"start":35.735,"end":36.98,"text":"Of having all in Thee."},{"start":37.6,"end":38.286,"text":"Amen."}],"start":29.657,"end":38.286}]},"daniel":{"file":"en-460-daniel.m4a","bytes":352544,"sha256":"d5201eadd7ff09cc3e26e66fbd189688c792a37721a54e788f39bd12007ebf71","duration":40.51,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.705,"text":"MY spirit on Thy care,"},{"start":2.085,"end":3.57,"text":"Blest Saviour. I recline"},{"start":4.19,"end":5.971,"text":"Thou will not leave me in despair"},{"start":6.591,"end":8.125,"text":"For Thou art Love divine."}],"start":0.35,"end":8.125},{