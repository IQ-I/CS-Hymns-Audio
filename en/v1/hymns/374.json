{"v":1,"coll":"en","num":374,"id":"hymn_374","title":"TELL me the same old, story","duration":76.483,"voices":{"grace":{"file":"en-374-grace.m4a","bytes":709077,"sha256":"08bb311980a30279f49bc8629eea4bea3bcd32d7b4ad134799963d2ad1321bd7","duration":76.483,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.93,"text":"TELL me the same old, story"},{"start":2.55,"end":4.081,"text":"Of unseen things above,"},{"start":4.461,"end":6.168,"text":"Of Jesus and His glory,"},{"start":6.548,"end":8.18,"text":"Of Jesus and His love,"},{"start":8.56,"end":9.857,"text":"Tell me the story simply,"},{"start":10.237,"end":11.538,"text":"As to a little child;"},{"start":11.998,"end":13.484,"text":"For I am weak, and weary"},{"start":14.104,"end":15.701,"text":"And helpless, and defiled."}],"start":0.35,"end":15.701},{"key":"CHORUS","lines":[{"start":17.471,"end":19.105,"text":"Tell me the old, old story"},{"start":19.725,"end":21.372,"text":"Of Jesus and His love."},{"start":21.992,"end":22.679,"text":"Amen."}],"start":17.471,"end":22.679},{"key":"2","lines":[{"start":24.449,"end":25.815,"text":"Tell me the story slowly,"},{"start":26.195,"end":27.394,"text":"That I may take it in"},{"start":28.014,"end":29.612,"text":"That wonderful redemption,"},{"start":29.992,"end":31.343,"text":"God’s remedy for sin,"},{"start":31.723,"end":33.039,"text":"Tell me the story often,"},{"start":33.419,"end":34.745,"text":"For I forget so soon;"},{"start":35.205,"end":36.51,"text":"The early dew of morning"},{"start":37.13,"end":38.509,"text":"Has passed away at noon."}],"start":24.449,"end":38.509},{"key":"3","lines":[{"start":40.279,"end":41.685,"text":"Tell me the story softly"},{"start":42.305,"end":43.909,"text":"With earnest tones and grave;"},{"start":44.369,"end":45.743,"text":"Remember, I’m the sinner"},{"start":46.363,"end":47.971,"text":"Whom Jesus came to save"},{"start":48.591,"end":49.996,"text":"Tell me the story always,"},{"start":50.376,"end":51.559,"text":"If you would really be"},