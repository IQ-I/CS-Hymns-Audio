{"v":1,"coll":"en","num":296,"id":"hymn_296","title":"HARK, the voice of love and mercy","duration":61.957,"voices":{"grace":{"file":"en-296-grace.m4a","bytes":570756,"sha256":"a68059ca4c47505fd2dbf207c30d8d9c7d2f08ad403416ce946c52e23c953aa8","duration":61.957,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.436,"text":"HARK, the voice of love and mercy"},{"start":3.056,"end":4.577,"text":"Sounds aloud from Calvary"},{"start":5.197,"end":6.876,"text":"See it rends the rocks asunder"},{"start":7.496,"end":9.392,"text":"Shakes the earth and veils the sky"},{"start":10.012,"end":11.649,"text":"“It is finish’d\", It is finished"},{"start":12.269,"end":13.897,"text":"Here the dying Saviour cry."}],"start":0.35,"end":13.897},{"key":"2","lines":[{"start":15.667,"end":17.312,"text":"“It is finish’d Oh what pleasure"},{"start":17.932,"end":19.605,"text":"Do the wondrous words afford"},{"start":20.225,"end":22.08,"text":"Heavenly blessings without measure"},{"start":22.7,"end":24.393,"text":"Flow to us from Christ the Lord"},{"start":25.013,"end":26.649,"text":"“It is finish’d\", It is finished"},{"start":27.269,"end":28.891,"text":"Saints the dying was record."}],"start":15.667,"end":28.891},{"key":"3","lines":[{"start":30.661,"end":32.486,"text":"Finish‘d all the types and shadows"},{"start":33.106,"end":34.446,"text":"Of the ceremonial law"},{"start":35.066,"end":36.855,"text":"Finish’d all that God had promised"},{"start":37.475,"end":39.001,"text":"Death and hell no more shall awe"},{"start":39.621,"end":41.258,"text":"“It is finish'd\", It is finished"},{"start":41.878,"end":43.651,"text":"Saints from hence your comfort draw."}],"start":30.661,"end":43.651},{"key":"4","lines":[{"start":45.421,"end":47.167,"text":"Tune your harps anew, ye Seraphs"},{"start":47.787,"end":49.523,"text":"Strike them to Emmanuel‘s name"},{"start":50.143,"end":51.873,"text":"All on earth, and all in heaven"},{"start":52.493,"end":54.081,"text":"Join the triumph to proclaim"},{"start":54.