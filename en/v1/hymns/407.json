{"v":1,"coll":"en","num":407,"id":"hymn_407","title":"MERCIFUL Father in Thine Word","duration":55.244,"voices":{"grace":{"file":"en-407-grace.m4a","bytes":494080,"sha256":"ce556613b3696c030fcc164e9433579b9a880ca924c4bedc6e47b61512740660","duration":55.244,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.051,"text":"MERCIFUL Father in Thine Word"},{"start":2.671,"end":4.13,"text":"Eternal glory beams"},{"start":4.75,"end":6.595,"text":"Ever, Thine holy name to praise"},{"start":7.215,"end":8.648,"text":"For sacred book divine."}],"start":0.35,"end":8.648},{"key":"2","lines":[{"start":10.418,"end":12.509,"text":"In Thine word wretched poor is blessed"},{"start":13.129,"end":14.586,"text":"Infinite wealth is found"},{"start":15.206,"end":17.266,"text":"Wealth of the sort, world can not"},{"start":17.886,"end":19.568,"text":"give Sosure and sure as life."}],"start":10.418,"end":19.568},{"key":"3","lines":[{"start":21.338,"end":23.115,"text":"The tree of knowledge is Thine word"},{"start":23.735,"end":25.124,"text":"Oh what grace He giveth"},{"start":25.744,"end":27.746,"text":"So much His savour, naught of earth"},{"start":28.366,"end":29.948,"text":"To men, Thine word appeal."}],"start":21.338,"end":29.948},{"key":"4","lines":[{"start":31.718,"end":33.627,"text":"Of Thine word, heard of Redeemer"},{"start":34.247,"end":35.702,"text":"Peaceful tidding proclaim"},{"start":36.322,"end":38.374,"text":"The sounding voice, of life it be"},{"start":38.994,"end":40.383,"text":"And everlasting joy."}],"start":31.718,"end":40.383},{"key":"5","lines":[{"start":42.153,"end":44.41,"text":"Christ Jesus, holy Teacher, Lord"},{"start":45.03,"end":46.237,"text":"Ever draw nigh to me"},{"start":46.857,"end":49.258,"text":"Thine Word, Lord, teach me all to Iove"},{"start":49.878,"end":51.467,"text":"Christ Jesus, me to find."},{"start":52.087,"end":52.774,"text":"Amen."}],"start":42.153,"end":52.774}]},"daniel":{"file":"en-407-daniel.m4a","bytes":480344,"sha256":"7f535190821b49957c