{"v":1,"coll":"en","num":259,"id":"hymn_259","title":"COME, ye sinners, poor and wretched","duration":87.673,"voices":{"grace":{"file":"en-259-grace.m4a","bytes":817034,"sha256":"0084bde8092a3f56e1ec28e20f5b9ed93288f42fbe94c29cb3a35cbfdd705688","duration":87.673,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.354,"text":"COME, ye sinners, poor and wretched,"},{"start":2.734,"end":4.376,"text":"Come in mercy's gracious hour"},{"start":4.996,"end":6.973,"text":"Jesus ready stands to save you"},{"start":7.593,"end":9.579,"text":"Full of pity, love, and pow‘r"},{"start":10.199,"end":12.729,"text":"He is able, He is willing: doubt no more."}],"start":0.35,"end":12.729},{"key":"2","lines":[{"start":14.499,"end":16.447,"text":"Come, ye needy, come and welcome"},{"start":17.067,"end":18.77,"text":"God's free bounty glorify"},{"start":19.39,"end":21.272,"text":"True belief, and true repentance,"},{"start":21.652,"end":23.395,"text":"Every grace which brings us nigh"},{"start":24.015,"end":25.71,"text":"Without money come to Jesus"},{"start":26.33,"end":27.279,"text":"Christ and buy."}],"start":14.499,"end":27.279},{"key":"3","lines":[{"start":29.049,"end":30.85,"text":"Let not conscience make you linger"},{"start":31.47,"end":33.167,"text":"Nor of fitness fondly dream"},{"start":33.787,"end":35.455,"text":"All the fitness He requireth"},{"start":36.075,"end":37.582,"text":"Is to feel your need O Him;"},{"start":38.042,"end":39.752,"text":"This he gives you; ‘tis the"},{"start":40.372,"end":41.739,"text":"Spirit rising beam."}],"start":29.049,"end":41.739},{"key":"4","lines":[{"start":43.509,"end":45.256,"text":"Come, ye weary, heavy laden,"},{"start":45.636,"end":47.313,"text":"Lost and ruin‘d by the fall"},{"start":47.933,"end":49.441,"text":"If you tarry till you‘re better"},{"start":50.061,"end":51.463,"text":"You will never come at all"},{"start":52.083,"end":54.135,"text":"Not the righteous, sinners Jesus"},{"start":54.755,"end":55.574,"text":"came to call."}],"st