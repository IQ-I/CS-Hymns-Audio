{"v":1,"coll":"en","num":546,"id":"hymn_546","title":"ACCORDING to thy gracious word","duration":51.859,"voices":{"grace":{"file":"en-546-grace.m4a","bytes":460855,"sha256":"da50be915152759a192877b3d2ef556c198f2d019f4985aa128e7113810edd4a","duration":51.859,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.03,"text":"ACCORDING to thy gracious word,"},{"start":2.41,"end":3.545,"text":"In meek humility"},{"start":4.165,"end":6.054,"text":"This will I do, my dying Lord,"},{"start":6.434,"end":7.694,"text":"I will remember thee."}],"start":0.35,"end":7.694},{"key":"2","lines":[{"start":9.464,"end":11.355,"text":"Thy body, broken for my sake"},{"start":11.975,"end":13.801,"text":"O! bread from heaven shall be"},{"start":14.421,"end":16.187,"text":"Thy testamental cup I take"},{"start":16.807,"end":18.208,"text":"And thus remember thee."}],"start":9.464,"end":18.208},{"key":"3","lines":[{"start":19.978,"end":21.576,"text":"Gethsemane can I forget?"},{"start":22.196,"end":23.707,"text":"O! there thy conflict see"},{"start":24.327,"end":26.125,"text":"Thine agony and bloody sweat"},{"start":26.745,"end":28.086,"text":"And not remember thee?"}],"start":19.978,"end":28.086},{"key":"4","lines":[{"start":29.856,"end":31.821,"text":"Remember Thee, and all thy pains"},{"start":32.441,"end":33.686,"text":"And all thy love to me"},{"start":34.306,"end":36.523,"text":"Yea, while a breath, a pulse remains"},{"start":37.143,"end":38.415,"text":"Will I remember thee."}],"start":29.856,"end":38.415},{"key":"5","lines":[{"start":40.185,"end":42.075,"text":"And when these failing lips grow dumb"},{"start":42.695,"end":44.24,"text":"And mind and mem’ry flee,"},{"start":44.62,"end":46.295,"text":"When thou shall in thy Kingdom come,"},{"start":46.675,"end":48.083,"text":"Jesus, remember me."},{"start":48.703,"end":49.389,"text":"Amen."}],"start":40.185,"end":49.389}]},"daniel":{"file":"en-546-daniel.m4a","bytes":452324,"sha256":"11505cc3d512e3bf9b10018529738f8137ec7396b26cb7c96237bbac96