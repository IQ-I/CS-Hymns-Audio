{"v":1,"coll":"en","num":301,"id":"hymn_301","title":"O perfect life of love!","duration":70.977,"voices":{"grace":{"file":"en-301-grace.m4a","bytes":624561,"sha256":"f7ab33d49495809adb29d4f0e3a12025257c57d70e034fd2766daed421b2d70f","duration":70.977,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.913,"text":"O perfect life of love!"},{"start":2.533,"end":3.981,"text":"All, all is finished now,"},{"start":4.361,"end":6.075,"text":"All that He left His throne above"},{"start":6.695,"end":7.892,"text":"To do for us below."}],"start":0.35,"end":7.892},{"key":"2","lines":[{"start":9.662,"end":11.173,"text":"No work is left undone"},{"start":11.793,"end":13.165,"text":"Of all the Father willed"},{"start":13.785,"end":15.926,"text":"His toils and sorrows, one by one"},{"start":16.546,"end":18.03,"text":"The Scriptures have fulfilled."}],"start":9.662,"end":18.03},{"key":"3","lines":[{"start":19.8,"end":21.232,"text":"No pain that we can share"},{"start":21.852,"end":23.238,"text":"But He has felt its smart"},{"start":23.858,"end":25.812,"text":"All forms of human grief and care"},{"start":26.432,"end":28.067,"text":"Have pierced that tender heart."}],"start":19.8,"end":28.067},{"key":"4","lines":[{"start":29.837,"end":31.367,"text":"And on His thorn-crowned head"},{"start":31.987,"end":33.242,"text":"And on His sinless soul"},{"start":33.862,"end":35.773,"text":"Our sins in all their guilt were laid"},{"start":36.393,"end":37.759,"text":"That He might make us whole."}],"start":29.837,"end":37.759},{"key":"5","lines":[{"start":39.529,"end":41.07,"text":"In perfect love He dies"},{"start":41.69,"end":43.114,"text":"For me He dies, for me!"},{"start":43.734,"end":45.461,"text":"O! all-atoning sacrifice,"},{"start":45.841,"end":47.282,"text":"I cling by faith to Thee."}],"start":39.529,"end":47.282},{"key":"6","lines":[{"start":49.052,"end":50.413,"text":"In every time of need"},{"start":51.033,"end":52.446,"text":"Before the judgement throne"},{"start":53.066,"end":55.238,"text":"Thy work, O lamb of God, I'll plead"},{"start":55.858,"end":57.202,"text":"Thy merits, not my own."}],"start":49.052,"end":57.202},{"key":"7","lines":[{"start":58.972,"end":60.53,"text":"Yet work, O Lord, in me"},{"start":61.15,"end":62.635,"text":"As Thou for me hast wrought"},{"start":63.255,"end":64.956,"text":"And let my love the answer be"},{"start":65.576,"end":67.201,"text":"To grace Thy love has brought."},{"start":67.821,"end":68.507,"text":"Amen."}],"start":58.972,"end":68.507}]},"daniel":{"file":"en-301-daniel.m4a","bytes":627466,"sha256":"6d6c7b059b3a58491ad9569ecc7da082054a5d04c3d73502f98632db09c517f8","duration":70.366,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.81,"text":"O perfect life of love!"},{"start":2.43,"end":3.687,"text":"All, all is finished now,"},{"start":4.067,"end":5.859,"text":"All that He left His throne above"},{"start":6.479,"end":7.706,"text":"To do for us below."}],"start":0.35,"end":7.706},{"key":"2","lines":[{"start":9.476,"end":10.891,"text":"No work is left undone"},{"start":11.511,"end":12.879,"text":"Of all the Father willed"},{"start":13.499,"end":15.555,"text":"His toils and sorrows, one by one"},{"start":16.175,"end":17.645,"text":"The Scriptures have fulfilled."}],"start":9.476,"end":17.645},{"key":"3","lines":[{"start":19.415,"end":20.799,"text":"No pain that we can share"},{"start":21.419,"end":22.877,"text":"But He has felt its smart"},{"start":23.497,"end":25.514,"text":"All forms of human grief and care"},{"start":26.134,"end":27.743,"text":"Have pierced that tender heart."}],"start":19.415,"end":27.743},{"key":"4","lines":[{"start":29.513,"end":31.071,"text":"And on His thorn-crowned head"},{"start":31.691,"end":32.978,"text":"And on His sinless soul"},{"start":33.598,"end":35.593,"text":"Our sins in all their guilt were laid"},{"start":36.213,"end":37.535,"text":"That He might make us whole."}],"start":29.513,"end":37.535},{"key":"5","lines":[{"start":39.305,"end":40.881,"text":"In perfect lov