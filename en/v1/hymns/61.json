{"v":1,"coll":"en","num":61,"id":"hymn_61","title":"FATHER which art in heaven","duration":127.926,"voices":{"grace":{"file":"en-61-grace.m4a","bytes":1168497,"sha256":"20501d3ba1c7e525b18e338e32b7f92a3e3b1913620bee61a6c5b15ec2455ec7","duration":127.926,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.905,"text":"FATHER which art in heaven"},{"start":2.525,"end":3.835,"text":"Halloweth be Thine name"},{"start":4.455,"end":6.101,"text":"Thine will be done here on earth"},{"start":6.721,"end":7.901,"text":"As be it in heaven"},{"start":8.521,"end":10.092,"text":"Give us Lord our daily bread"},{"start":10.712,"end":12.132,"text":"Forgive us all our debts"},{"start":12.752,"end":14.36,"text":"Lead us not to temptation"},{"start":14.98,"end":16.337,"text":"Keep us from all evil."}],"start":0.35,"end":16.337},{"key":"2","lines":[{"start":18.107,"end":19.417,"text":"Thou hearkened to Elijah"},{"start":20.037,"end":21.339,"text":"A bank river Cedron"},{"start":21.959,"end":23.456,"text":"Thou who hearkened to Daniel"},{"start":24.076,"end":25.452,"text":"Oh God today hear us"},{"start":26.072,"end":27.569,"text":"Give us the Holy Spirit"},{"start":28.189,"end":30.162,"text":"As Note! Thou gave the Apostles"},{"start":30.782,"end":32.394,"text":"Glorious vessels we may be"},{"start":33.014,"end":34.455,"text":"Reward as they of Old."}],"start":18.107,"end":34.455},{"key":"3","lines":[{"start":36.225,"end":37.931,"text":"The faithful heart we plead Thee"},{"start":38.551,"end":39.967,"text":"That ever waiver not"},{"start":40.587,"end":42.007,"text":"For us to ever trust Thee"},{"start":42.627,"end":43.964,"text":"Till we shall meet with Thee"},{"start":44.584,"end":46.118,"text":"Re‐assuring hope we plead"},{"start":46.738,"end":48.276,"text":"In Thee and not in any"},{"start":48.896,"end":50.548,"text":"Beaming love to our brethren"},{"start":51.168,"end":52.449,"text":"Humbly and peacefully."}],"start":36.225,"end":52.449},{"key":"4","lines":[{"start":54.219,"end":55.