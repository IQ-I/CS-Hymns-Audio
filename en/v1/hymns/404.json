{"v":1,"coll":"en","num":404,"id":"hymn_404","title":"THERE is a book","duration":43.405,"voices":{"grace":{"file":"en-404-grace.m4a","bytes":384680,"sha256":"70a7846d7729c7d1e7d47f70ec28b36259ef7deeb3fa610ae13b20ced73af1c4","duration":43.405,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.252,"text":"THERE is a book, who runs may read,"},{"start":2.632,"end":4.316,"text":"Which heav'nly truth imparts"},{"start":4.936,"end":6.679,"text":"And all the lore its scholars need"},{"start":7.299,"end":9.069,"text":"Pure eyes and Christian hearts."}],"start":0.35,"end":9.069},{"key":"2","lines":[{"start":10.839,"end":12.534,"text":"The works of God above, below"},{"start":13.154,"end":14.523,"text":"Within us and around"},{"start":15.143,"end":16.892,"text":"Are pages in that book to show"},{"start":17.512,"end":19.092,"text":"How God himself is found."}],"start":10.839,"end":19.092},{"key":"3","lines":[{"start":20.862,"end":22.741,"text":"The glorious sky embracing all"},{"start":23.361,"end":24.784,"text":"Is like the Maker's love"},{"start":25.404,"end":27.263,"text":"Where with encompass’d, great and"},{"start":27.883,"end":29.719,"text":"small In peace and order move."}],"start":20.862,"end":29.719},{"key":"4","lines":[{"start":31.489,"end":33.439,"text":"Thou who hast giv'n me eyes to see"},{"start":34.059,"end":35.657,"text":"And love this sight so fair"},{"start":36.277,"end":37.887,"text":"Give me a heart to find out Thee,"},{"start":38.267,"end":39.629,"text":"And read Thee everywhere."},{"start":40.249,"end":40.936,"text":"Amen."}],"start":31.489,"end":40.936}]},"daniel":{"file":"en-404-daniel.m4a","bytes":386159,"sha256":"beec38ee6c9031d3bb483b5fed73e14d001535dd26d3e42fd7581c71c5b3e504","duration":42.97,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.274,"text":"THERE is a book, who runs may read,"},{"start":2.654,"end":4.341,"text":"Which heav'nly truth imparts"},{"start":4.961,"end":6.688,"text":"And all the lore its scholars need"},{"start":7.308,