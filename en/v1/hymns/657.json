{"v":1,"coll":"en","num":657,"id":"hymn_657","title":"THE voice that breathed o‘er Eden","duration":81.308,"voices":{"grace":{"file":"en-657-grace.m4a","bytes":710546,"sha256":"7fa8fc55b99c01482c81bed1454725ca680a50e2148639358cc82bf3c4c8d05d","duration":81.308,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.954,"text":"THE voice that breathed o‘er Eden"},{"start":2.574,"end":4.161,"text":"That earliest wedding day"},{"start":4.781,"end":6.325,"text":"The primal marriage blessing"},{"start":6.945,"end":8.327,"text":"It hath not pass‘d away."}],"start":0.35,"end":8.327},{"key":"2","lines":[{"start":10.097,"end":11.587,"text":"Still in the pure espousal"},{"start":12.207,"end":13.705,"text":"Of Christian man and maid"},{"start":14.325,"end":15.818,"text":"The Holy Three are with us"},{"start":16.438,"end":18.028,"text":"The Three-fold grace is said."}],"start":10.097,"end":18.028},{"key":"3","lines":[{"start":19.798,"end":21.316,"text":"For dower of blessed children"},{"start":21.936,"end":23.68,"text":"For love and faith’s sweet sake"},{"start":24.3,"end":25.789,"text":"For high mysterious Union"},{"start":26.409,"end":28.066,"text":"Which Nought on earth may break."}],"start":19.798,"end":28.066},{"key":"4","lines":[{"start":29.836,"end":31.513,"text":"Be present heavenly Father"},{"start":32.133,"end":33.516,"text":"To give away this bride"},{"start":34.136,"end":35.783,"text":"As Eve Thou gav’st to Adam"},{"start":36.403,"end":37.88,"text":"Out of His own pierced side."}],"start":29.836,"end":37.88},{"key":"5","lines":[{"start":39.65,"end":41.077,"text":"Be present here Emmanuel"},{"start":41.697,"end":43.172,"text":"To join their loving hands"},{"start":43.792,"end":45.653,"text":"As Thou didst bind two natures"},{"start":46.273,"end":47.626,"text":"In Thine Eternal Bands."}],"start":39.65,"end":47.626},{"key":"6","lines":[{"start":49.396,"end":50.898,"text":"Be present Holy Spirit"},{"start":51.518,"end":52.991,"text":"To bless them as they kneel"},{"start"