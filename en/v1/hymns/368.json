{"v":1,"coll":"en","num":368,"id":"hymn_368","title":"JERUSALEM, my happy home","duration":66.586,"voices":{"grace":{"file":"en-368-grace.m4a","bytes":585416,"sha256":"096a2740df2fa985b4a60e974c63d755185d1e0164c917a147033b6dcaddde61","duration":66.586,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.063,"text":"JERUSALEM, my happy home"},{"start":2.683,"end":4.002,"text":"Name ever dear to me!"},{"start":4.622,"end":6.138,"text":"When shall my labours have an"},{"start":6.758,"end":8.555,"text":"End in joy, and peace, in Thee?"}],"start":0.35,"end":8.555},{"key":"2","lines":[{"start":10.325,"end":11.778,"text":"When shall these eyes thy"},{"start":12.398,"end":13.593,"text":"Heaven-built walls"},{"start":14.213,"end":15.699,"text":"And pearly gates behold"},{"start":16.319,"end":18.2,"text":"Thy bulwarks with salvation strong."},{"start":18.82,"end":20.293,"text":"And streets of shinning gold?"}],"start":10.325,"end":20.293},{"key":"3","lines":[{"start":22.063,"end":23.823,"text":"There happier bowers than Eden‘s"},{"start":24.443,"end":26.337,"text":"Bloom Nor sin, nor sorrow know"},{"start":26.957,"end":28.614,"text":"Blest seats, through rude and"},{"start":29.235,"end":30.251,"text":"Stormy scenes."},{"start":30.871,"end":32.119,"text":"I onward press to you."}],"start":22.063,"end":32.119},{"key":"4","lines":[{"start":33.889,"end":35.639,"text":"Why should I shrink at pain and woe"},{"start":36.259,"end":37.711,"text":"Or feel, at death, dismay?"},{"start":38.331,"end":40.137,"text":"I've Canaan's goodly land in view"},{"start":40.757,"end":42.3,"text":"And realms of endless day."}],"start":33.889,"end":42.3},{"key":"5","lines":[{"start":44.07,"end":46.235,"text":"Apostles, martyrs, prophets there"},{"start":46.855,"end":48.253,"text":"Around my Saviour stood"},{"start":48.873,"end":50.798,"text":"And soon my friends in Christ below"},{"start":51.418,"end":52.97,"text":"Will join the glorious band."}],"start":44.07,"end":52.97},{"key":"6","lines":[{"start"