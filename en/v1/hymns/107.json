{"v":1,"coll":"en","num":107,"id":"hymn_107","title":"HARK, creation's Alleluia","duration":123.055,"voices":{"grace":{"file":"en-107-grace.m4a","bytes":1176408,"sha256":"237d3b6c0a188b51bcf9effc4fc5a0fcd5f26e044c850f237f3a7b9b9dcfb8b4","duration":123.055,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.997,"text":"HARK, creation's Alleluia"},{"start":2.617,"end":4.367,"text":"Rising from a thousand shores"},{"start":4.987,"end":7.005,"text":"Vibrates sweet as angel voices"},{"start":7.625,"end":9.457,"text":"Loud as many waters, roars"},{"start":10.076,"end":12.258,"text":"Blessing, glory, power, salvation"},{"start":12.878,"end":14.321,"text":"To our God upon the throne"},{"start":14.941,"end":16.828,"text":"Father, Son, and Holy Spirit"},{"start":17.448,"end":19.209,"text":"lnfinite supreme, alone."}],"start":0.35,"end":19.209},{"key":"2","lines":[{"start":20.979,"end":23.177,"text":"On and on, from dawn to sunset"},{"start":23.797,"end":25.591,"text":"Bome on every changeful wind"},{"start":26.211,"end":27.856,"text":"From the myriad-minded people"},{"start":28.476,"end":29.999,"text":"Of the hoary climes of Ind,"},{"start":30.379,"end":32.227,"text":"From the ransom‘d sons of Afric"},{"start":32.847,"end":34.669,"text":"From Old Sinim's crowded lands"},{"start":35.289,"end":37.158,"text":"From the freeborn Wanderers roaming"},{"start":37.778,"end":39.316,"text":"Arab‘s unconquer‘d sands."}],"start":20.979,"end":39.316},{"key":"3","lines":[{"start":41.086,"end":42.931,"text":"From the coasts of ice to regions"},{"start":43.551,"end":45.257,"text":"Where perpetual summer smiles"},{"start":45.877,"end":47.5,"text":"From the sunny-hearted children"},{"start":48.12,"end":49.691,"text":"Of the far Pacific isles"},{"start":50.311,"end":52.004,"text":"From the numbers without number"},{"start":52.624,"end":54.146,"text":"Of rejoicing Christendom"},{"start":54.766,"end":56.41,"text":"From the watchers for His advent"},{"start":57.03,"end":58.478,"text":"Who will so