{"v":1,"coll":"en","num":583,"id":"hymn_583","title":"YE servant of the Lord","duration":51.391,"voices":{"grace":{"file":"en-583-grace.m4a","bytes":451276,"sha256":"e2798981557835ff7113542abc0a604bfcb5164bea9739619d0a8dd43dac4c5b","duration":51.391,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.747,"text":"YE servant of the Lord,"},{"start":2.127,"end":3.553,"text":"Each in his office wait"},{"start":4.173,"end":6.038,"text":"Observant of His heav’nly word"},{"start":6.658,"end":8.154,"text":"And watchful at His gate."}],"start":0.35,"end":8.154},{"key":"2","lines":[{"start":9.924,"end":11.417,"text":"Let all your lamps be bright"},{"start":12.037,"end":13.583,"text":"And trim the golden flame"},{"start":14.203,"end":16.361,"text":"Gird up your loins, as in His sight"},{"start":16.981,"end":18.426,"text":"For awful is His name."}],"start":9.924,"end":18.426},{"key":"3","lines":[{"start":20.196,"end":21.744,"text":"Watch ‘tis your Lord’s command"},{"start":22.364,"end":23.94,"text":"And while we speak, He’s near"},{"start":24.56,"end":26.428,"text":"Mark the first signal of His hand"},{"start":27.048,"end":28.354,"text":"And ready all appear."}],"start":20.196,"end":28.354},{"key":"4","lines":[{"start":30.124,"end":31.392,"text":"Oh, happy servant he,"},{"start":31.772,"end":33.25,"text":"In such a posture found"},{"start":33.87,"end":35.671,"text":"He shall his Lord with rapture see,"},{"start":36.051,"end":37.485,"text":"And be with honour crown’d."}],"start":30.124,"end":37.485},{"key":"5","lines":[{"start":39.255,"end":40.831,"text":"Christ shall the banquet spread"},{"start":41.451,"end":42.852,"text":"With His own royal hand"},{"start":43.472,"end":45.395,"text":"And raise that faithful servant‘s head"},{"start":46.015,"end":47.615,"text":"Amid (the) angelic band."},{"start":48.235,"end":48.921,"text":"Amen."}],"start":39.255,"end":48.921}]},"daniel":{"file":"en-583-daniel.m4a","bytes":456786,"sha256":"aaa071a932450b55ebb43cc975432330408e6f8b29866610313