{"v":1,"coll":"en","num":528,"id":"hymn_528","title":"BLEST be the dear uniting love","duration":42.56,"voices":{"grace":{"file":"en-528-grace.m4a","bytes":368911,"sha256":"a396117abb90e6996aa73c81ed77af8267f32f879b35e04488a9880fda45b952","duration":42.56,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.058,"text":"BLEST be the dear uniting love"},{"start":2.678,"end":4.045,"text":"That will not let us part"},{"start":4.665,"end":6.499,"text":"Our bodies may far off depart"},{"start":7.119,"end":8.577,"text":"We still are one in heart."}],"start":0.35,"end":8.577},{"key":"2","lines":[{"start":10.347,"end":12.146,"text":"Joined in one spirit to our head"},{"start":12.766,"end":14.108,"text":"Where He appoints we go"},{"start":14.728,"end":16.716,"text":"And still in Jesus footsteps tread"},{"start":17.336,"end":18.821,"text":"And show His praise below."}],"start":10.347,"end":18.821},{"key":"3","lines":[{"start":20.591,"end":22.142,"text":"O may we ever walk in Him"},{"start":22.762,"end":24.156,"text":"And nothing know beside"},{"start":24.776,"end":26.583,"text":"Nothing desire nothing esteem"},{"start":27.203,"end":28.685,"text":"But Jesus crucified!"}],"start":20.591,"end":28.685},{"key":"4","lines":[{"start":30.455,"end":32.256,"text":"Closer and closer let us cleave"},{"start":32.876,"end":34.285,"text":"To His beloved embrace"},{"start":34.905,"end":36.651,"text":"Expect His fullness to receive"},{"start":37.271,"end":38.783,"text":"And grace to answer grace."},{"start":39.403,"end":40.09,"text":"Amen."}],"start":30.455,"end":40.09}]},"daniel":{"file":"en-528-daniel.m4a","bytes":374602,"sha256":"4d2d9e15ce6d04c3ff608c1fa0f0385b1b4ae8d17e18bf6e2cf10925e5034399","duration":42.615,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.076,"text":"BLEST be the dear uniting love"},{"start":2.696,"end":4.073,"text":"That will not let us part"},{"start":4.693,"end":6.511,"text":"Our bodies may far off depart"},{"start":7.131,"end":8.593,"text":"We still are one i