{"v":1,"coll":"en","num":245,"id":"hymn_245","title":"SlNFUL, sighing to be blest","duration":60.026,"voices":{"grace":{"file":"en-245-grace.m4a","bytes":548031,"sha256":"3e9bca74b4165512dad7c36fc54e562e41eca75c731e239584e09bc3b580e0c5","duration":60.026,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.451,"text":"SlNFUL, sighing to be blest,"},{"start":2.831,"end":4.577,"text":"Bound, and longing to be free;"},{"start":5.037,"end":6.71,"text":"Weary, waiting for my rest;"},{"start":7.17,"end":8.651,"text":"God be merciful to me."}],"start":0.35,"end":8.651},{"key":"2","lines":[{"start":10.421,"end":12.11,"text":"Goodness I have none to plead,"},{"start":12.49,"end":13.895,"text":"Sinfulness in all I see,"},{"start":14.275,"end":15.76,"text":"I can only bring my need:"},{"start":16.22,"end":17.701,"text":"God be merciful to me."}],"start":10.421,"end":17.701},{"key":"3","lines":[{"start":19.471,"end":21.374,"text":"Broken heart and downcast eyes"},{"start":21.994,"end":23.688,"text":"Dare not lift themselves to Thee;"},{"start":24.148,"end":25.978,"text":"Yet Thou canst interpret signs:"},{"start":26.438,"end":27.919,"text":"God be merciful to me."}],"start":19.471,"end":27.919},{"key":"4","lines":[{"start":29.689,"end":31.301,"text":"From this sinful heart of mine"},{"start":31.921,"end":33.486,"text":"To Thy bosom I would flee:"},{"start":33.946,"end":35.445,"text":"I am not my own but Thine:"},{"start":35.905,"end":37.385,"text":"God be merciful to me."}],"start":29.689,"end":37.385},{"key":"5","lines":[{"start":39.155,"end":40.782,"text":"There is one beside the throne,"},{"start":41.162,"end":42.708,"text":"And my only hope and plea"},{"start":43.328,"end":44.978,"text":"Are in Him, and Him alone;"},{"start":45.438,"end":46.919,"text":"God be merciful to me."}],"start":39.155,"end":46.919},{"key":"6","lines":[{"start":48.689,"end":50.269,"text":"He my cause will undertake,"},{"start":50.649,"end":52.102,"text":"My Interpreter will be,"},{"start":52.482,"en