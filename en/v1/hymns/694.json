{"v":1,"coll":"en","num":694,"id":"hymn_694","title":"SOLEMNLY without a romp","duration":99.385,"voices":{"grace":{"file":"en-694-grace.m4a","bytes":935458,"sha256":"8246942b50476ce00d899f90594f73279d12b66817830142dc8ee34b3c0fec6a","duration":99.385,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.86,"text":"SOLEMNLY without a romp"},{"start":2.48,"end":4.148,"text":"Solemnly the sun doth rise"},{"start":4.768,"end":6.454,"text":"When at sunrise doth emerge"},{"start":7.074,"end":9.016,"text":"Men the sky, the sun may gaze"},{"start":9.636,"end":11.558,"text":"Gently its gleams brighter raise"},{"start":12.178,"end":14.152,"text":"Gently, brighter grows in strength"},{"start":14.772,"end":16.499,"text":"Brighter, growing forth to peak"},{"start":17.119,"end":18.637,"text":"To the glory ne'er to gaze."}],"start":0.35,"end":18.637},{"key":"2","lines":[{"start":20.407,"end":22.063,"text":"Darkness with o’erwhelming might"},{"start":22.683,"end":24.362,"text":"Nay with sound worthy of note"},{"start":24.982,"end":26.809,"text":"Gentle moon and shinning stars"},{"start":27.429,"end":28.911,"text":"Beaming light upon the earth"},{"start":29.531,"end":31.28,"text":"Nay with roaring sound doth come"},{"start":31.9,"end":33.487,"text":"Mighty drips of heav'nly dew"},{"start":34.107,"end":35.615,"text":"All around the earth descend"},{"start":36.235,"end":37.914,"text":"Nay with sound worthy of note."}],"start":20.407,"end":37.914},{"key":"3","lines":[{"start":39.684,"end":41.498,"text":"Mys-te-rious the deeds of God"},{"start":42.118,"end":43.694,"text":"Amidst the Seraphim fold"},{"start":44.314,"end":45.902,"text":"Though feeble and frail we be"},{"start":46.522,"end":48.154,"text":"And we descreseth in strength"},{"start":48.774,"end":50.222,"text":"But the providence of God"},{"start":50.842,"end":52.486,"text":"On us all day doth descend"},{"start":53.106,"end":54.759,"text":"By the power and might of God"},{"start":55.379,"end":56.955,"text":"This abode doth accomplish."}],"start":39.684,"end":56.955},{"key":"4","lines":[{"start":58.725,"end":60.555,"text":"This day God our thanks we give"},{"start":61.175,"end":62.853,"text":"Members of Seraphim fold"},{"start":63.473,"end":64.991,"text":"All the young and all the old"},{"start":65.611,"end":67.478,"text":"Male folks and the female folks"},{"start":68.098,"end":69.597,"text":"Host and visitors alike"},{"start":70.217,"end":71.752,"text":"Our thanks we offer to Thee"},{"start":72.372,"end":73.814,"text":"In this sanctuary divine"},{"start":74.434,"end":76.059,"text":"All our thanks Father receive."}],"start":58.725,"end":76.059},{"key":"5","lines":[{"start":77.829,"end":79.312,"text":"Father God, the Trinity"},{"start":79.932,"end":81.708,"text":"Who art this fold established"},{"start":82.328,"end":84.136,"text":"This house consecrate we plead"},{"start":84.756,"end":86.561,"text":"By Thine power and sacred might"},{"start":87.181,"end":88.899,"text":"Descend Lord today we plead"},{"start":89.519,"end":91.129,"text":"With Holy Spirit inspire"},{"start":91.749,"end":93.321,"text":"Adopt us all, Thine to be"},{"start":93.941,"end":95.609,"text":"Here on earth and there above."},{"start":96.229,"end":96.916,"text":"Amen."}],"start":77.829,"end":96.916}]},"daniel":{"file":"en-694-daniel.m4a","bytes":934625,"sha256":"d3f49fa9a3f24052b04f16ecc6d04805e8ca52678adde23842bd67f44dc0efa8","duration":98.4,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.722,"text":"SOLEMNLY without a romp"},{"start":2.342,"end":3.994,"text":"Solemnly the sun doth rise"},{"start":4.614,"end":6.337,"text":"When at sunrise doth emerge"},{"start":6.957,"end":8.666,"text":"Men the sky, the sun may gaze"},{"start":9.286,"end":11.192,"text":"Gently its gleams brighter raise"},{"start":11.812,"end":13.735,"text":"Gently, brighter grows in strength"},{"start":14.355,"end":16.064,"text":"Brighter, growing forth to peak"},{"start":16.684,"end":18.192,"text":"To the glory ne'er to gaze."}],"start":0.35,"end":