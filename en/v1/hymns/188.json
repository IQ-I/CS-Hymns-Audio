{"v":1,"coll":"en","num":188,"id":"hymn_188","title":"Rejoice, all ye believers","duration":92.579,"voices":{"grace":{"file":"en-188-grace.m4a","bytes":860878,"sha256":"52df09024351036ffadc46cd9b39dd64be75c88bff4c00e8ac335e563c1f7748","duration":92.579,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.067,"text":"Rejoice, all ye believers"},{"start":2.687,"end":3.981,"text":"And let your lights appear"},{"start":4.601,"end":6.153,"text":"The evening is advancing"},{"start":6.773,"end":8.214,"text":"And darker night is near"},{"start":8.834,"end":10.307,"text":"The Bridegroom is arising"},{"start":10.927,"end":12.284,"text":"As soon will he draw nigh"},{"start":12.904,"end":14.668,"text":"Up, pray and watch and wrestle"},{"start":15.288,"end":16.747,"text":"At midnight comes the cry."}],"start":0.35,"end":16.747},{"key":"2","lines":[{"start":18.517,"end":20.07,"text":"See that your lamps are burning"},{"start":20.69,"end":21.996,"text":"Replenish them with oil"},{"start":22.616,"end":24.12,"text":"Look now for your Salvation"},{"start":24.74,"end":26.149,"text":"The end of earthly toil"},{"start":26.77,"end":28.188,"text":"The watchers on the Mountain"},{"start":28.808,"end":30.354,"text":"Proclaim the Bridegroom near"},{"start":30.974,"end":32.633,"text":"Go meet him, as He cometh"},{"start":33.253,"end":34.539,"text":"With Halleluyahs shout."}],"start":18.517,"end":34.539},{"key":"3","lines":[{"start":36.309,"end":38.075,"text":"Ye wise and Holy virgins"},{"start":38.695,"end":40.22,"text":"Now raise your voices high"},{"start":40.84,"end":42.438,"text":"Until in songs of triumph"},{"start":43.058,"end":44.55,"text":"They meet the Angel choir"},{"start":45.17,"end":46.727,"text":"The marriage feast is waiting"},{"start":47.347,"end":48.895,"text":"The gates wide open stand"},{"start":49.515,"end":51.093,"text":"Up Up, ye heirs of glory:"},{"start":51.553,"end":52.879,"text":"The Bridegroom is at hand."}],"start":36.309,"end":52.879},{"key":"4","lines":[{"start"