{"v":1,"coll":"en","num":773,"id":"hymn_773","title":"WE love the place, O God","duration":59.728,"voices":{"grace":{"file":"en-773-grace.m4a","bytes":514547,"sha256":"9970f9a38e7c22cddf9650b1091003d6675b6cbf6295cad332110caade817be2","duration":59.728,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.99,"text":"WE love the place, O God,"},{"start":2.37,"end":3.917,"text":"Wherein Thine honour dwells"},{"start":4.537,"end":5.818,"text":"The joy of Thine abode"},{"start":6.438,"end":8.008,"text":"All earthly joy excels."}],"start":0.35,"end":8.008},{"key":"2","lines":[{"start":9.778,"end":11.151,"text":"It is the house of prayer"},{"start":11.771,"end":13.26,"text":"Wherein Thy servants meet"},{"start":13.88,"end":15.541,"text":"And Thou, O Lord, art there"},{"start":16.162,"end":17.798,"text":"Thy chosen flock to greet."}],"start":9.778,"end":17.798},{"key":"3","lines":[{"start":19.568,"end":21.033,"text":"We love the sacred font"},{"start":21.653,"end":23.058,"text":"For there the Holy Dove"},{"start":23.678,"end":25.365,"text":"Pours out, as He is wont"},{"start":25.985,"end":27.347,"text":"The effluence from above."}],"start":19.568,"end":27.347},{"key":"4","lines":[{"start":29.117,"end":30.602,"text":"We love the word of life"},{"start":31.222,"end":32.709,"text":"The word that tells of peace"},{"start":33.329,"end":34.729,"text":"Of comfort in the strife,"},{"start":35.109,"end":36.72,"text":"And joys that never cease."}],"start":29.117,"end":36.72},{"key":"5","lines":[{"start":38.49,"end":39.842,"text":"We love to sing below"},{"start":40.462,"end":41.999,"text":"For mercies freely given"},{"start":42.619,"end":44.022,"text":"But oh! we long to know"},{"start":44.642,"end":46.064,"text":"The truimph-song of heaven."}],"start":38.49,"end":46.064},{"key":"6","lines":[{"start":47.834,"end":49.655,"text":"Lord Jesus, give us grace"},{"start":50.275,"end":51.737,"text":"On earth to love Thee more"},{"start":52.357,"end":53.924,"text":"In heaven to see Thy face"}