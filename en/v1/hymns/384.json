{"v":1,"coll":"en","num":384,"id":"hymn_384","title":"SPIRIT blest who art adored","duration":154.6,"voices":{"grace":{"file":"en-384-grace.m4a","bytes":1366449,"sha256":"5a84dfc92aead7b2a784b314af505cb65c5cebf277868a02a5f4f21a81c41ffe","duration":154.6,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.024,"text":"SPIRIT blest who art adored"},{"start":2.644,"end":4.195,"text":"With the Father and the World"},{"start":4.815,"end":6.555,"text":"One eternal God and Lord"},{"start":7.175,"end":8.569,"text":"Hear us, Holy Spirit."}],"start":0.35,"end":8.569},{"key":"2","lines":[{"start":10.339,"end":12.219,"text":"Holy Spirit, heavenly Dove"},{"start":12.839,"end":14.331,"text":"Dew descending from above"},{"start":14.951,"end":16.904,"text":"Breath of life, and fire of love"},{"start":17.524,"end":18.918,"text":"Hear us, Holy Spirit."}],"start":10.339,"end":18.918},{"key":"3","lines":[{"start":20.688,"end":22.235,"text":"Source of strength and knowledge"},{"start":22.855,"end":25.137,"text":"clear. Wisdom, godliness sincere"},{"start":25.757,"end":27.655,"text":"Understanding, counsel, fear"},{"start":28.275,"end":29.669,"text":"Hear us, Holy Spirit."}],"start":20.688,"end":29.669},{"key":"4","lines":[{"start":31.439,"end":33.605,"text":"Source of meekness, love, and peace"},{"start":34.225,"end":36.274,"text":"Patience, pureness, faith's increase"},{"start":36.894,"end":38.554,"text":"Hope and joy that cannot cease"},{"start":39.174,"end":40.569,"text":"Hear us, Holy Spirit."}],"start":31.439,"end":40.569},{"key":"5","lines":[{"start":42.339,"end":43.84,"text":"Spirit guiding us aright"},{"start":44.46,"end":46.182,"text":"Spirit making darkness light"},{"start":46.802,"end":48.434,"text":"Spirit of resistless might"},{"start":49.054,"end":50.448,"text":"Hear us, Holy Spirit."}],"start":42.339,"end":50.448},{"key":"6","lines":[{"start":52.218,"end":53.817,"text":"Thou by whom the Virgin bore"},{"start":54.437,"end":56.353,"text":"Him, whom heaven and earth adore"}