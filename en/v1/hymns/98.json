{"v":1,"coll":"en","num":98,"id":"hymn_98","title":"ALL ye Band of Seraph","duration":78.047,"voices":{"grace":{"file":"en-98-grace.m4a","bytes":694278,"sha256":"68d4e7d58f2ed62778a37600545caf0a87dc16361079aff38ac005088f5efacf","duration":78.047,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.679,"text":"ALL ye Band of Seraph"},{"start":2.299,"end":3.929,"text":"Come show the joy of your heart"},{"start":4.549,"end":6.079,"text":"Together sing a sweet song"},{"start":6.699,"end":8.605,"text":"For wondrous work he's done to us"},{"start":9.225,"end":11.579,"text":"For He has not let us go astray from His side."}],"start":0.35,"end":11.579},{"key":"CHORUS","lines":[{"start":13.349,"end":14.591,"text":"We’re marchng to zion"},{"start":15.211,"end":16.881,"text":"Zion the greater! of all"},{"start":17.501,"end":19.104,"text":"We are marching forth to zion"},{"start":19.724,"end":21.223,"text":"The habitat of our God."}],"start":13.349,"end":21.223},{"key":"2","lines":[{"start":22.993,"end":24.222,"text":"O ye Praying Father"},{"start":24.842,"end":26.165,"text":"Give thanks to our God"},{"start":26.785,"end":28.516,"text":"That made you triumph o'er enemies"},{"start":29.136,"end":30.744,"text":"And let no enemy prevail"},{"start":31.364,"end":32.672,"text":"And has made you the head"},{"start":33.292,"end":34.79,"text":"And head till eternity."}],"start":22.993,"end":34.79},{"key":"3","lines":[{"start":36.56,"end":37.827,"text":"Ye Chorister's Band"},{"start":38.447,"end":40.028,"text":"Show forth the joy of your heart"},{"start":40.648,"end":42.316,"text":"For his firm strong covenants"},{"start":42.936,"end":44.539,"text":"Amidst the Band of Seraphim"},{"start":45.159,"end":46.207,"text":"That he fulfilled"},{"start":46.827,"end":48.325,"text":"And fill the world to come."}],"start":36.56,"end":48.325},{"key":"4","lines":[{"start":50.095,"end":51.395,"text":"People may be mocking"},{"start":52.015,"end":53.185,"text":"And may though condemn"},{"start":53.805,"e