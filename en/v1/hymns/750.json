{"v":1,"coll":"en","num":750,"id":"hymn_750","title":"HE's asleep Jesus saith","duration":71.635,"voices":{"grace":{"file":"en-750-grace.m4a","bytes":622807,"sha256":"c9ba63b29c8f801d918df306460db4cb52689dacafd345ea4ae31b5c7c1801f0","duration":71.635,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.768,"text":"HE's asleep Jesus saith"},{"start":2.388,"end":3.805,"text":"Of Lazarus His friend"},{"start":4.425,"end":6.372,"text":"Was dead, buried beneath the earth"},{"start":6.992,"end":8.233,"text":"In the sepulchre laid."}],"start":0.35,"end":8.233},{"key":"2","lines":[{"start":10.003,"end":11.605,"text":"Four whole days he was dead"},{"start":12.225,"end":13.643,"text":"He's asleep Jesus saith"},{"start":14.263,"end":16.289,"text":"Jesus, resurrection and life"},{"start":16.909,"end":18.268,"text":"Unto all that believes."}],"start":10.003,"end":18.268},{"key":"3","lines":[{"start":20.038,"end":21.746,"text":"Christ friends ever shall live"},{"start":22.366,"end":23.836,"text":"To celestial being form"},{"start":24.456,"end":26.399,"text":"Away from earthly worms and dust"},{"start":27.019,"end":28.551,"text":"With Angelic hosts fly."}],"start":20.038,"end":28.551},{"key":"4","lines":[{"start":30.321,"end":32.255,"text":"Sleep on! sleep on! belov'd"},{"start":32.875,"end":34.442,"text":"Thy companion is Christ"},{"start":35.062,"end":37.036,"text":"Be courageous, soundeth His voice"},{"start":37.656,"end":38.985,"text":"Thou shall with me “arise”."}],"start":30.321,"end":38.985},{"key":"5","lines":[{"start":40.755,"end":42.4,"text":"Soon His voice thou shall hark"},{"start":43.02,"end":44.442,"text":"From thy rest home below"},{"start":45.062,"end":47.031,"text":"The sounding voice of Christ Jesus"},{"start":47.651,"end":48.901,"text":"To thee saying arise!."}],"start":40.755,"end":48.901},{"key":"6","lines":[{"start":50.671,"end":51.987,"text":"Thine sorrow bid away"},{"start":52.607,"end":53.832,"text":"But be alive in hope"},{"start":54.452,"end":56.448,"te