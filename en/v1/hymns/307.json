{"v":1,"coll":"en","num":307,"id":"hymn_307","title":"JESUS in Thy dying woes","duration":211.626,"voices":{"grace":{"file":"en-307-grace.m4a","bytes":1871177,"sha256":"600420a603645d546cb31aea2060de0dd935a5144c59c1b36109410be963409c","duration":211.626,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.007,"text":"JESUS in Thy dying woes"},{"start":2.627,"end":4.457,"text":"Even while Thy life‐blood flows"},{"start":5.077,"end":6.741,"text":"Craving pardon for Thy foes:"},{"start":7.201,"end":8.623,"text":"Hear us, Holy Jesus."}],"start":0.35,"end":8.623},{"key":"2","lines":[{"start":10.393,"end":11.983,"text":"Saviour, for our pardon sue,"},{"start":12.363,"end":13.916,"text":"When our sins Thy pangs renew"},{"start":14.536,"end":15.975,"text":"For we know not what we do"},{"start":16.595,"end":18.017,"text":"Hear us, Holy Jesus."}],"start":10.393,"end":18.017},{"key":"3","lines":[{"start":19.787,"end":21.447,"text":"Oh may we, whom mercy need"},{"start":22.067,"end":23.625,"text":"Be like thee in heart and deed"},{"start":24.245,"end":25.899,"text":"When with wrong our spirits bleed"},{"start":26.519,"end":27.874,"text":"Hear us Holy Jesus."}],"start":19.787,"end":27.874},{"key":"4","lines":[{"start":29.644,"end":31.147,"text":"Jesus pitying the sighs"},{"start":31.767,"end":33.484,"text":"Of the thiefwho near Thee dies"},{"start":34.104,"end":35.535,"text":"Promising him paradise"},{"start":36.155,"end":37.576,"text":"Hear us, Holy Jesus."}],"start":29.644,"end":37.576},{"key":"5","lines":[{"start":39.346,"end":40.87,"text":"May we in our guilt and shame"},{"start":41.49,"end":43.348,"text":"Still thy love and mercy claim"},{"start":43.968,"end":45.553,"text":"Calling humbly on Thy name"},{"start":46.173,"end":47.595,"text":"Hear us, Holy Jesus."}],"start":39.346,"end":47.595},{"key":"6","lines":[{"start":49.365,"end":50.837,"text":"Oh remember us who pine"},{"start":51.457,"end":53.047,"text":"Looking from our cross toThine"},{"start":53.667,"end":55.362,"te