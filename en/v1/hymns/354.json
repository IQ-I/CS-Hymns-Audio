{"v":1,"coll":"en","num":354,"id":"hymn_354","title":"CONGREGATION in respite","duration":371.291,"voices":{"grace":{"file":"en-354-grace.m4a","bytes":3463749,"sha256":"6ae944325ef55f1360ca979dcc85ea4746b2491964d4163dee948e9391f15f87","duration":371.291,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.913,"text":"CONGREGATION in respite"},{"start":2.533,"end":3.965,"text":"We all church of the world"},{"start":4.585,"end":6.156,"text":"All praises we offer Thee"},{"start":6.776,"end":8.335,"text":"Christ Jesus Blessed Lord"},{"start":8.955,"end":10.697,"text":"Holy Lord Thou art conquered"},{"start":11.317,"end":12.788,"text":"That they may also conquer"},{"start":13.408,"end":15.076,"text":"The light of their glorious crown"},{"start":15.696,"end":17.076,"text":"Ordained from Thee above."}],"start":0.35,"end":17.076},{"key":"2","lines":[{"start":18.846,"end":20.485,"text":"Thou we praise for Saint Andrew"},{"start":21.105,"end":22.75,"text":"Who Thine voice first he hark"},{"start":23.37,"end":24.975,"text":"Whose brethren hath he brought"},{"start":25.595,"end":27.326,"text":"Forth Christ Jesus all to see"},{"start":27.946,"end":29.53,"text":"Set apart our hearts oh Lord"},{"start":30.15,"end":31.659,"text":"Let‘s on the watch be for Thee"},{"start":32.279,"end":33.871,"text":"And all our brethren also"},{"start":34.491,"end":35.919,"text":"Thine return to witness."}],"start":18.846,"end":35.919},{"key":"3","lines":[{"start":37.689,"end":39.388,"text":"Thou we praise for Saint Thomas"},{"start":40.008,"end":41.442,"text":"Thine be-ing doth he doubt"},{"start":42.062,"end":43.79,"text":"Our faith he thus establish"},{"start":44.41,"end":45.989,"text":"Thine divine love revealed"},{"start":46.609,"end":48.421,"text":"Oh dear Lord Thine peace we plead"},{"start":49.041,"end":50.438,"text":"To all who Thee expecting"},{"start":51.058,"end":52.468,"text":"Knowmg Thee as all faithful"},{"start":53.088,"end":54.559,"text":"And divine being of God."}],"start":37.689,