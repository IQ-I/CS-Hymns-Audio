,"text":"Who through all tribulations"},{"start":63.14,"end":64.407,"text":"Calling upon the Lord"},{"start":65.027,"end":66.751,"text":"Oh God when our turn shall be"},{"start":67.371,"end":68.713,"text":"To suffer for Thine honour"},{"start":69.333,"end":70.993,"text":"Let’s for Thee on earth witness"},{"start":71.613,"end":72.998,"text":"The crown to earn above."}],"start":56.329,"end":72.998},{"key":"5","lines":[{"start":74.768,"end":76.385,"text":"Thou we praise for Thy Servant"},{"start":77.005,"end":78.37,"text":"On Island of Patmos"},{"start":78.99,"end":80.569,"text":"We praise Thee for witnessing"},{"start":81.189,"end":82.499,"text":"Honestly for Thine sake"},{"start":83.119,"end":84.663,"text":"We praise Thee for the vision"},{"start":85.283,"end":86.652,"text":"Revealeth to us from Thee"},{"start":87.272,"end":88.759,"text":"Patiently we'll be waiting"},{"start":89.379,"end":90.631,"text":"That we may worthy be."}],"start":74.768,"end":90.631},{"key":"6","lines":[{"start":92.401,"end":93.962,"text":"Thou we praise for the children"},{"start":94.582,"end":96.039,"text":"Witnesses of Thine death"},{"start":96.659,"end":98.155,"text":"All halted from the battle"},{"start":98.775,"end":99.976,"text":"To the abode of rest"},{"start":100.596,"end":102.244,"text":"Mother Rachael stop weeping"},{"start":102.864,"end":104.606,"text":"From pains they are liberated"},{"start":105.226,"end":106.815,"text":"Grant us hearts un-deceiving"},{"start":107.435,"end":108.981,"text":"Like them, crown we may earn."}],"start":92.401,"end":108.981},{"key":"7","lines":[{"start":110.751,"end":112.511,"text":"Thou we praise for divine Light"},{"start":113.131,"end":114.576,"text":"And voice all from above"},{"start":115.196,"end":116.73,"text":"And Thou we praise for vision"},{"start":117.35,"end":118.654,"text":"Of the per-se-cutor"},{"start":119.274,"end":121.233,"text":"Also for his convertion We give"},{"start":121.853,"end":123.661,"text":"Thee all the glory Beam unto us"},{