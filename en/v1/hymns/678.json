{"v":1,"coll":"en","num":678,"id":"hymn_678","title":"MOTHER who conceiveth me for","duration":80.048,"voices":{"grace":{"file":"en-678-grace.m4a","bytes":732855,"sha256":"9b1c39689fcbf88fe51fe5f3da8d23e6ae0d7b4fb53519e17063fb7deb1aeabc","duration":80.048,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.996,"text":"MOTHER who conceiveth me for"},{"start":2.616,"end":3.52,"text":"nine months"},{"start":4.14,"end":5.59,"text":"Me, never she abort"},{"start":6.21,"end":8.72,"text":"Me. delivereth, borne in her porch about"},{"start":9.34,"end":11.011,"text":"For three whole solid years."}],"start":0.35,"end":11.011},{"key":"CHORUS","lines":[{"start":12.781,"end":14.744,"text":"Mother, mother, mother, I thank thee"},{"start":15.364,"end":17.06,"text":"For thy toiling dusk and dawn"},{"start":17.68,"end":19.674,"text":"In the time of surplusity and want"},{"start":20.294,"end":21.8,"text":"Mother, all sake of me."}],"start":12.781,"end":21.8},{"key":"2","lines":[{"start":23.57,"end":25.967,"text":"In sickness and ill health who stood by me"},{"start":26.587,"end":28.244,"text":"Me, bore in warm embrace"},{"start":28.864,"end":31.23,"text":"When in dis-com-fort, who me doth console?"},{"start":31.85,"end":33.293,"text":"Mother! none else but thee."}],"start":23.57,"end":33.293},{"key":"3","lines":[{"start":35.063,"end":37.377,"text":"At infancy when not a word can speak"},{"start":37.997,"end":39.364,"text":"Who all my wants discern?"},{"start":39.984,"end":42.0,"text":"At adolescent who my care art borne"},{"start":42.62,"end":44.062,"text":"Mother! none else but thee."}],"start":35.063,"end":44.062},{"key":"4","lines":[{"start":45.832,"end":48.041,"text":"The savour of the milk on mother's breast"},{"start":48.661,"end":49.789,"text":"Ever in me endure"},{"start":50.409,"end":52.944,"text":"So great and much that money can’t purchase"},{"start":53.564,"end":54.9,"text":"Thy toiling all on me."}],"start":45.832,"end":54.9},{"key":"5","lines":[{"start":56.67,"end":59.026,"text":"Thou whose mother, from earth hath departed"},{"start":59.646,"end":60.936,"text":"I commiserate with thee"},{"start":61.556,"end":63.81,"text":"Ye all whose mothers art on earth to live"},{"start":64.43,"end":65.949,"text":"Give praises unto God."}],"start":56.67,"end":65.949},{"key":"6","lines":[{"start":67.719,"end":69.755,"text":"Let us all cultivate good characters"},{"start":70.375,"end":72.208,"text":"As wise and brave children"},{"start":72.828,"end":75.35,"text":"Like Christ Jesus, meekly and cheerfully"},{"start":75.97,"end":77.578,"text":"Let’s be virtuous children."}],"start":67.719,"end":77.578}]},"daniel":{"file":"en-678-daniel.m4a","bytes":720555,"sha256":"fcce0cc91fe35e13fdc68f90abdd69fb0528f4617f5f07d1e6ba4374856c9317","duration":78.769,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.01,"text":"MOTHER who conceiveth me for"},{"start":2.63,"end":3.491,"text":"nine months"},{"start":4.111,"end":5.338,"text":"Me, never she abort"},{"start":5.958,"end":8.284,"text":"Me. delivereth, borne in her porch about"},{"start":8.904,"end":10.468,"text":"For three whole solid years."}],"start":0.35,"end":10.468},{"key":"CHORUS","lines":[{"start":12.238,"end":14.158,"text":"Mother, mother, mother, I thank thee"},{"start":14.778,"end":16.488,"text":"For thy toiling dusk and dawn"},{"start":17.108,"end":18.994,"text":"In the time of surplusity and want"},{"start":19.614,"end":21.026,"text":"Mother, all sake of me."}],"start":12.238,"end":21.026},{"key":"2","lines":[{"start":22.796,"end":25.197,"text":"In sickness and ill health who stood by me"},{"start":25.817,"end":27.293,"text":"Me, bore in warm embrace"},{"start":27.913,"end":30.286,"text":"When in dis-com-fort, who me doth console?"},{"start":30.906,"end":32.307,"text":"Mother! none else but thee."}],"start":22.796,"end":32.307},{"key":"3","lines":[{"start":34.077,"end":36.405,"text":"At infancy when not a word can speak"},{"start":37.025,"end":38.444,"text":"Who all my wants discern?"},{"star