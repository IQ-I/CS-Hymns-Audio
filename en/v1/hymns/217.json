{"v":1,"coll":"en","num":217,"id":"hymn_217","title":"JESUS the highest name on earth","duration":81.548,"voices":{"grace":{"file":"en-217-grace.m4a","bytes":716964,"sha256":"6c3d9e0d71831b9aac26bc44a3c797ce7ca586324649db05831dd46448cc709d","duration":81.548,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.108,"text":"JESUS the highest name on earth"},{"start":2.728,"end":4.279,"text":"And heaven the throne above"},{"start":4.899,"end":6.72,"text":"The Angels ever kneel for Him"},{"start":7.34,"end":8.891,"text":"While Satan tears and flee."}],"start":0.35,"end":8.891},{"key":"CHORUS","lines":[{"start":10.661,"end":12.317,"text":"There is no longer argument"},{"start":12.937,"end":14.195,"text":"No other railing now"},{"start":14.815,"end":16.588,"text":"Surely Christ died for you and me"},{"start":17.208,"end":18.536,"text":"For all the sinful soul."}],"start":10.661,"end":18.536},{"key":"2","lines":[{"start":20.306,"end":21.839,"text":"Cherubim Seraphim above"},{"start":22.459,"end":23.938,"text":"Surround the Father's throne"},{"start":24.558,"end":26.338,"text":"Always in His presence above"},{"start":26.958,"end":28.513,"text":"Singing the songs of praise."}],"start":20.306,"end":28.513},{"key":"3","lines":[{"start":30.283,"end":32.611,"text":"Christ Saviour, cruel death He o'ercame"},{"start":33.231,"end":34.757,"text":"Find Satan‘s kingdom fall"},{"start":35.377,"end":37.409,"text":"All creatures now hurst forth with joy"},{"start":38.029,"end":39.237,"text":"The Father glorify."}],"start":30.283,"end":39.237},{"key":"4","lines":[{"start":41.007,"end":42.517,"text":"Cherubim and ye Seruphim"},{"start":43.137,"end":44.409,"text":"Let there be love within"},{"start":45.029,"end":46.841,"text":"The, Angelic Hosts all in love"},{"start":47.461,"end":48.809,"text":"Worship Father above."}],"start":41.007,"end":48.809},{"key":"5","lines":[{"start":50.579,"end":52.36,"text":"Jesus the Captain of our Band"},{"start":52.98,"end":54.412,"text":"Bless us on earth b