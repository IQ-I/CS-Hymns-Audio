{"v":1,"coll":"en","num":825,"id":"hymn_825","title":"WHEN upon life‘s billows you are tempest tost","duration":79.759,"voices":{"grace":{"file":"en-825-grace.m4a","bytes":720218,"sha256":"bd5807307fa57f8cbf264ac3317171ca5c269fcf2db1f7ae598e85108e9eb83c","duration":79.759,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.055,"text":"WHEN upon life‘s billows you are"},{"start":2.675,"end":3.712,"text":"tempest tost"},{"start":4.332,"end":5.549,"text":"When you are discouraged,"},{"start":5.929,"end":7.183,"text":"thinking all is lost"},{"start":7.803,"end":9.144,"text":"Count your many blessings,"},{"start":9.524,"end":10.881,"text":"name them one by one"},{"start":11.501,"end":13.076,"text":"And it will surprise you what"},{"start":13.696,"end":14.774,"text":"the Lord hath done."}],"start":0.35,"end":14.774},{"key":"CHORUS","lines":[{"start":16.544,"end":17.858,"text":"Count your blessings name"},{"start":18.478,"end":19.618,"text":"them one by one"},{"start":20.238,"end":21.485,"text":"Count your blessings see"},{"start":22.105,"end":23.283,"text":"what God hath done"},{"start":23.903,"end":25.217,"text":"Count your blessings name"},{"start":25.837,"end":26.977,"text":"them one by one"},{"start":27.597,"end":29.172,"text":"And it will surprise you what"},{"start":29.792,"end":30.87,"text":"the Lord hath done."}],"start":16.544,"end":30.87},{"key":"2","lines":[{"start":32.64,"end":34.758,"text":"Are you ever burdened with a load of care"},{"start":35.377,"end":37.002,"text":"Does the cross seem heavy you are"},{"start":37.622,"end":38.494,"text":"called to bear"},{"start":39.114,"end":40.776,"text":"Count your many blessings every"},{"start":41.396,"end":42.393,"text":"doubt will fly"},{"start":43.013,"end":44.46,"text":"And you will keep singing as the"},{"start":45.08,"end":46.039,"text":"days go by."}],"start":32.64,"end":46.039},{"key":"3","lines":[{"start":47.809,"end":49.31,"text":"When you look at others with their"},{"start":49.93,"end":51.109,"text":"la