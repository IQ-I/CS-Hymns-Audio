{"v":1,"coll":"en","num":114,"id":"hymn_114","title":"THROUGH all the changing scenes of life","duration":61.307,"voices":{"grace":{"file":"en-114-grace.m4a","bytes":558756,"sha256":"9d64f0c71fdb6c84e97fa2885417127f817b2279f96c1acd8ffd88e2edf89115","duration":61.307,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.232,"text":"THROUGH all the changing scenes of life"},{"start":2.852,"end":4.231,"text":"In trouble and in joy"},{"start":4.851,"end":6.651,"text":"The praises of my God shall still"},{"start":7.271,"end":8.697,"text":"My heart and tongue employ."}],"start":0.35,"end":8.697},{"key":"2","lines":[{"start":10.467,"end":12.309,"text":"Of His deliverance I will boast,"},{"start":12.689,"end":14.108,"text":"Till all that are distressed"},{"start":14.728,"end":16.503,"text":"From my example comfort take,"},{"start":16.883,"end":18.499,"text":"And charm their griefs to rest."}],"start":10.467,"end":18.499},{"key":"3","lines":[{"start":20.269,"end":21.933,"text":"O magnify the Lord with me,"},{"start":22.313,"end":23.854,"text":"With me exalt His name;"},{"start":24.314,"end":25.928,"text":"When in distress to Him I called,"},{"start":26.308,"end":27.665,"text":"He to my rescue came."}],"start":20.269,"end":27.665},{"key":"4","lines":[{"start":29.435,"end":31.387,"text":"The host of God encamp around"},{"start":32.007,"end":33.405,"text":"The dwellings of the just"},{"start":34.025,"end":35.594,"text":"Deliverance He afford to all"},{"start":36.214,"end":37.721,"text":"Who on His succour trust."}],"start":29.435,"end":37.721},{"key":"5","lines":[{"start":39.491,"end":41.263,"text":"O make but trial of His love;"},{"start":41.723,"end":43.205,"text":"Experience will decide"},{"start":43.825,"end":45.718,"text":"How blest they are, and only they,"},{"start":46.098,"end":47.58,"text":"Who in His truth confide."}],"start":39.491,"end":47.58},{"key":"6","lines":[{"start":49.35,"end":51.422,"text":"Fear Him, ye saints, and you will then"},{"start":52.042,"end":53.488,"text":"Have nothing else to fear;"},{"start":53.948,"end":55.68,"text":"Make you His service your delight,"},{"start":56.06,"end":57.53,"text":"He'll make your wants His care."},{"start":58.15,"end":58.837,"text":"Amen."}],"start":49.35,"end":58.837}]},"daniel":{"file":"en-114-daniel.m4a","bytes":560957,"sha256":"7a4b22bb34f8ec0e2bfa66eb984c46321d5d3dbf8b7ec20abf42fb11ac6a591b","duration":60.958,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.279,"text":"THROUGH all the changing scenes of life"},{"start":2.899,"end":4.222,"text":"In trouble and in joy"},{"start":4.842,"end":6.694,"text":"The praises of my God shall still"},{"start":7.314,"end":8.754,"text":"My heart and tongue employ."}],"start":0.35,"end":8.754},{"key":"2","lines":[{"start":10.524,"end":12.391,"text":"Of His deliverance I will boast,"},{"start":12.771,"end":14.172,"text":"Till all that are distressed"},{"start":14.792,"end":16.574,"text":"From my example comfort take,"},{"start":16.954,"end":18.562,"text":"And charm their griefs to rest."}],"start":10.524,"end":18.562},{"key":"3","lines":[{"start":20.332,"end":21.986,"text":"O magnify the Lord with me,"},{"start":22.366,"end":23.831,"text":"With me exalt His name;"},{"start":24.291,"end":25.955,"text":"When in distress to Him I called,"},{"start":26.335,"end":27.681,"text":"He to my rescue came."}],"start":20.332,"end":27.681},{"key":"4","lines":[{"start":29.451,"end":31.38,"text":"The host of God encamp around"},{"start":32.0,"end":33.394,"text":"The dwellings of the just"},{"start":34.014,"end":35.594,"text":"Deliverance He afford to all"},{"start":36.214,"end":37.64,"text":"Who on His succour trust."}],"start":29.451,"end":37.64},{"key":"5","lines":[{"start":39.41,"end":41.188,"text":"O make but trial of His love;"},{"start":41.648,"end":43.073,"text":"Experience will decide"},{"start":43.693,"end":45.459,"text":"How blest they are, and only they,"},{"start":45.839,"end":47.33,"text":"Who in His truth confide."}],"start":39.41,"end":47.