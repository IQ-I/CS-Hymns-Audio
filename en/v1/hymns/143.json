{"v":1,"coll":"en","num":143,"id":"hymn_143","title":"ALL Christian Churches of the world","duration":110.299,"voices":{"grace":{"file":"en-143-grace.m4a","bytes":974359,"sha256":"100c7cb4edac250e84038ba38e911a134ee832a049aba4fbf59664a8cdae4973","duration":110.299,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.222,"text":"ALL Christian Churches of the world"},{"start":2.842,"end":4.175,"text":"Be ye ever draw nigh"},{"start":4.795,"end":6.509,"text":"To learn the true way of the Lord"},{"start":7.129,"end":8.472,"text":"In the Band of Seraphim."}],"start":0.35,"end":8.472},{"key":"CHORUS","lines":[{"start":10.242,"end":11.622,"text":"Join us shout Hallelujah"},{"start":12.242,"end":13.59,"text":"To the Al-Almighty God"},{"start":14.21,"end":15.918,"text":"We give thanks and praise to Him"},{"start":16.538,"end":18.021,"text":"Who has called us to this band."}],"start":10.242,"end":18.021},{"key":"2","lines":[{"start":19.791,"end":21.437,"text":"There is no band like Seraphim"},{"start":22.057,"end":23.399,"text":"In all the world we know"},{"start":24.019,"end":25.627,"text":"Whose Captain is Holy Michael"},{"start":26.247,"end":27.672,"text":"Like Cherubim Scraphim."}],"start":19.791,"end":27.672},{"key":"3","lines":[{"start":29.442,"end":31.2,"text":"Our guide is the Holy Spirit"},{"start":31.82,"end":33.205,"text":"That no one ever knows"},{"start":33.825,"end":35.399,"text":"Only the Visioners of God"},{"start":36.019,"end":37.319,"text":"Can testify to it."}],"start":29.442,"end":37.319},{"key":"4","lines":[{"start":39.089,"end":40.896,"text":"The Brothers and all our sisters"},{"start":41.516,"end":43.196,"text":"In this our glorious Band"},{"start":43.816,"end":45.531,"text":"The Christian Army of this world"},{"start":46.151,"end":47.606,"text":"Let sing the glorious song."}],"start":39.089,"end":47.606},{"key":"5","lines":[{"start":49.376,"end":51.122,"text":"The witches and all the wizards"},{"start":51.742,"end":53.295,"text":"Have no power on this