{"v":1,"coll":"en","num":624,"id":"hymn_624","title":"I heard thy voice in my sweet dream","duration":65.753,"voices":{"grace":{"file":"en-624-grace.m4a","bytes":607202,"sha256":"8ce34202480fd47a0af10f6d3a7bf5206700fbde41226a856902eb2d9ffcb34a","duration":65.753,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.211,"text":"I heard thy voice in my sweet dream"},{"start":2.831,"end":4.465,"text":"Thy sweet and quiet voice"},{"start":5.085,"end":7.066,"text":"The voice that tells of our God’s love"},{"start":7.686,"end":9.16,"text":"Redemption by His blood"},{"start":9.78,"end":11.342,"text":"I listen patiently to hear"},{"start":11.962,"end":13.303,"text":"And that to my surprise"},{"start":13.923,"end":15.699,"text":"The voice exhort me more and more"},{"start":16.319,"end":17.782,"text":"To pray and always pray."}],"start":0.35,"end":17.782},{"key":"CHORUS","lines":[{"start":19.552,"end":20.89,"text":"I pray show me thy sight - 2ce"},{"start":21.51,"end":23.313,"text":"And patiently to see thy face"},{"start":23.933,"end":25.296,"text":"I pray show me Thy sight."}],"start":19.552,"end":25.296},{"key":"2","lines":[{"start":27.066,"end":28.757,"text":"While wordly trouble on my way"},{"start":29.377,"end":30.703,"text":"To elder skip and run"},{"start":31.323,"end":33.082,"text":"Who gave me the golden advice"},{"start":33.702,"end":35.244,"text":"To watch and pray always"},{"start":35.864,"end":37.399,"text":"I patiently listen to hear"},{"start":38.019,"end":39.49,"text":"And made my heart so sweet"},{"start":40.11,"end":41.846,"text":"He further exhort me nicely"},{"start":42.466,"end":44.007,"text":"To watch and pray always."}],"start":27.066,"end":44.007},{"key":"3","lines":[{"start":45.777,"end":47.39,"text":"Almighty God deliver us"},{"start":48.01,"end":49.895,"text":"We Cherubim and Seraphim below"},{"start":50.515,"end":52.148,"text":"When trouble shall be on our way"},{"start":52.768,"end":54.275,"text":"To hear our daily prayers"},{"start":54.895,"end"