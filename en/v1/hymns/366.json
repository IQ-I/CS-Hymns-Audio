{"v":1,"coll":"en","num":366,"id":"hymn_366","title":"THERE is a Blessed Home","duration":73.55,"voices":{"grace":{"file":"en-366-grace.m4a","bytes":671334,"sha256":"91b455cef1faabb0b17e2432d356cd6acb887dda526fbb21a3d1affdaa9e2647","duration":73.55,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.523,"text":"THERE is a Blessed Home"},{"start":2.143,"end":3.558,"text":"Beyond this land of woe"},{"start":4.178,"end":5.63,"text":"Where trials never come"},{"start":6.25,"end":7.734,"text":"Nor tears of sorrows flow"},{"start":8.354,"end":10.008,"text":"Where faith is lost in sight"},{"start":10.628,"end":12.111,"text":"And patient hope is crowned"},{"start":12.731,"end":14.166,"text":"And everlasting light"},{"start":14.786,"end":16.326,"text":"Its glory throws around."}],"start":0.35,"end":16.326},{"key":"2","lines":[{"start":18.096,"end":19.499,"text":"There is a land of peace"},{"start":20.119,"end":21.531,"text":"Good Angels know it well"},{"start":22.151,"end":23.848,"text":"Glad songs that never cease"},{"start":24.468,"end":25.814,"text":"Within its portals swell"},{"start":26.434,"end":27.938,"text":"Around its glorious Throne"},{"start":28.558,"end":30.054,"text":"Ten thousand Saints adore"},{"start":30.674,"end":32.232,"text":"CHRIST, with the FATHER, ONE"},{"start":32.852,"end":34.055,"text":"And SPIRIT, evermore."}],"start":18.096,"end":34.055},{"key":"3","lines":[{"start":35.825,"end":37.415,"text":"Oh! joy all joys beyond,"},{"start":37.795,"end":39.185,"text":"To see the LAMB who died"},{"start":39.805,"end":41.438,"text":"And count each sacred Wound"},{"start":42.058,"end":43.755,"text":"In Hands, and feet, and Side"},{"start":44.375,"end":45.829,"text":"To give to Him the praise"},{"start":46.449,"end":47.894,"text":"Of every triumph won"},{"start":48.514,"end":50.147,"text":"And sing through endless days"},{"start":50.767,"end":52.158,"text":"The great things He hath done."}],"start":35.825,"end":52.158},{"key":"4","lines":[{"start":53.928,"end":55.372,"text":"Look up, ye saints of GOD"},{"start":55.992,"end":57.562,"text":"Nor fear to tread below"},{"start":58.182,"end":59.606,"text":"The path your SAVIOUR trod"},{"start":60.226,"end":61.6,"text":"Of daily toil and woe"},{"start":62.22,"end":63.531,"text":"Wait but a little while"},{"start":64.151,"end":65.51,"text":"In uncomplaining love"},{"start":66.13,"end":67.787,"text":"His own most gracious smile"},{"start":68.407,"end":69.773,"text":"Shall welcome you above."},{"start":70.393,"end":71.08,"text":"Amen."}],"start":53.928,"end":71.08}]},"daniel":{"file":"en-366-daniel.m4a","bytes":667411,"sha256":"8b0ff4ab66675e331f109220e9edcabe64ccfb173d8e6710bfbed2f5be673bea","duration":72.928,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.527,"text":"THERE is a Blessed Home"},{"start":2.147,"end":3.504,"text":"Beyond this land of woe"},{"start":4.124,"end":5.629,"text":"Where trials never come"},{"start":6.249,"end":7.741,"text":"Nor tears of sorrows flow"},{"start":8.361,"end":9.937,"text":"Where faith is lost in sight"},{"start":10.557,"end":12.083,"text":"And patient hope is crowned"},{"start":12.703,"end":14.064,"text":"And everlasting light"},{"start":14.684,"end":16.211,"text":"Its glory throws around."}],"start":0.35,"end":16.211},{"key":"2","lines":[{"start":17.981,"end":19.412,"text":"There is a land of peace"},{"start":20.032,"end":21.401,"text":"Good Angels know it well"},{"start":22.021,"end":23.651,"text":"Glad songs that never cease"},{"start":24.271,"end":25.706,"text":"Within its portals swell"},{"start":26.326,"end":27.839,"text":"Around its glorious Throne"},{"start":28.459,"end":29.921,"text":"Ten thousand Saints adore"},{"start":30.541,"end":32.03,"text":"CHRIST, with the FATHER, ONE"},{"start":32.65,"end":33.912,"text":"And SPIRIT, evermore."}],"start":17.981,"end":33.912},{"key":"3","lines":[{"start":35.682,"end":37.196,"text":"Oh! joy all joys beyond,"},{"start":37.576,"end":38.957,"text":"To see the LAMB who died"},{"start":39.577,"en