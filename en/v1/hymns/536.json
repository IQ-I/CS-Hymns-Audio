{"v":1,"coll":"en","num":536,"id":"hymn_536","title":"BEHOLD how pleasant for brethren","duration":44.585,"voices":{"grace":{"file":"en-536-grace.m4a","bytes":398531,"sha256":"5a44d94135c80d976944162f4c7e454cb6f62c48c04842390365486e659a9e56","duration":44.585,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.219,"text":"BEHOLD how pleasant for brethren"},{"start":2.839,"end":4.062,"text":"In unity to dwell"},{"start":4.682,"end":6.708,"text":"Kits, Kins whose hearts in one accord"},{"start":7.328,"end":8.694,"text":"In fellowship with Thee."}],"start":0.35,"end":8.694},{"key":"2","lines":[{"start":10.464,"end":12.536,"text":"When stream of love from Christ doth flow"},{"start":13.156,"end":14.619,"text":"In every heart it glows"},{"start":15.239,"end":17.134,"text":"The blissful peace of God that blows"},{"start":17.754,"end":19.422,"text":"Protects comfort and cares."}],"start":10.464,"end":19.422},{"key":"3","lines":[{"start":21.192,"end":23.104,"text":"Like precious balm and ointment sweet"},{"start":23.724,"end":25.329,"text":"On Aaron's beard that drop"},{"start":25.949,"end":27.86,"text":"Flo'd on his skirt as for the scoop"},{"start":28.48,"end":30.016,"text":"Perfume’ry like the rose."}],"start":21.192,"end":30.016},{"key":"4","lines":[{"start":31.786,"end":33.674,"text":"Pleasant and cool like morning dew"},{"start":34.294,"end":35.748,"text":"That on Zion descends"},{"start":36.368,"end":38.606,"text":"There God, His glory great reveal‘d"},{"start":39.226,"end":40.808,"text":"His loving grace bestow‘d."},{"start":41.428,"end":42.115,"text":"Amen."}],"start":31.786,"end":42.115}]},"daniel":{"file":"en-536-daniel.m4a","bytes":396754,"sha256":"f5d187e22f1361373bf7c174574dbb0bdfc6851c0735d5490c11608826c68273","duration":44.459,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.192,"text":"BEHOLD how pleasant for brethren"},{"start":2.812,"end":3.969,"text":"In unity to dwell"},{"start":4.589,"end":6.556,"text":"Kits, Kins whose hearts in one accord"},{"