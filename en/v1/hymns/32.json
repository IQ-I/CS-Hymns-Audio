{"v":1,"coll":"en","num":32,"id":"hymn_32","title":"This is the day the Lord hath made","duration":54.687,"voices":{"grace":{"file":"en-32-grace.m4a","bytes":486503,"sha256":"6051f2f826dddf87ae88434d8ab9c58a6bee799e97464cdfec640ecce4358114","duration":54.687,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.329,"text":"This is the day the Lord hath made"},{"start":2.949,"end":4.488,"text":"He calls the hour His own"},{"start":5.108,"end":7.268,"text":"Let heaven rejoice let earth be glad"},{"start":7.888,"end":9.411,"text":"And praise surround the throne."}],"start":0.35,"end":9.411},{"key":"2","lines":[{"start":11.181,"end":13.024,"text":"To-day He rose and left the death"},{"start":13.644,"end":15.272,"text":"And Satan‘s empire fell"},{"start":15.892,"end":17.825,"text":"To-day the saints His triumphs spread"},{"start":18.445,"end":19.915,"text":"And all His wonders tell."}],"start":11.181,"end":19.915},{"key":"3","lines":[{"start":21.685,"end":23.242,"text":"Hosannah to anointed King"},{"start":23.862,"end":25.224,"text":"To David’s Holy Son"},{"start":25.844,"end":27.748,"text":"Help us O Lord descend and bring"},{"start":28.368,"end":29.91,"text":"Salvation from thy throne."}],"start":21.685,"end":29.91},{"key":"4","lines":[{"start":31.68,"end":33.812,"text":"Bless‘d bethe Lord, who comes to men"},{"start":34.432,"end":35.95,"text":"With messages of grace"},{"start":36.57,"end":38.799,"text":"Who comes, in God His Father's Name"},{"start":39.419,"end":40.887,"text":"To save our sinful race."}],"start":31.68,"end":40.887},{"key":"5","lines":[{"start":42.657,"end":44.305,"text":"Hossanah in the highest strains"},{"start":44.925,"end":46.521,"text":"The church on earth can raise,"},{"start":46.901,"end":48.69,"text":"The Highest heaven in which he reigns"},{"start":49.31,"end":50.911,"text":"Shall give Him nobler praise."},{"start":51.531,"end":52.218,"text":"Amen."}],"start":42.657,"end":52.218}]},"daniel":{"file":"en-32-daniel.m4a","bytes":486869,"sha256":"1