{"v":1,"coll":"en","num":601,"id":"hymn_601","title":"RESCUE the perishing, care for the dying","duration":51.264,"voices":{"grace":{"file":"en-601-grace.m4a","bytes":464946,"sha256":"96634f4464060f890c1f3a98e378dec9e0bdedf370414e1b8e0ecc32850ab577","duration":51.264,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.633,"text":"RESCUE the perishing, care for the dying"},{"start":3.253,"end":5.717,"text":"Snatch them in pity from sin and the grave"},{"start":6.337,"end":7.745,"text":"Weep o‘er the erring ones"},{"start":8.365,"end":9.521,"text":"Lift up the fallen"},{"start":10.141,"end":12.151,"text":"Tell them of Jesus the Mighty to save."}],"start":0.35,"end":12.151},{"key":"CHORUS","lines":[{"start":13.921,"end":15.148,"text":"Rescue the perishing,"},{"start":15.528,"end":16.557,"text":"care for the dying"},{"start":17.177,"end":18.611,"text":"Jesus is merciful,"},{"start":18.991,"end":20.185,"text":"Jesus will save."}],"start":13.921,"end":20.185},{"key":"2","lines":[{"start":21.955,"end":23.219,"text":"Though they are slighting Him"},{"start":23.839,"end":25.032,"text":"Still He is waiting"},{"start":25.652,"end":27.663,"text":"Waiting the penitent child to receive"},{"start":28.283,"end":29.697,"text":"Plead with them earnestly,"},{"start":30.077,"end":31.365,"text":"Plead with them gently"},{"start":31.985,"end":33.997,"text":"He will forgive if thy only believe."}],"start":21.955,"end":33.997},{"key":"3","lines":[{"start":35.767,"end":38.044,"text":"Rescue the perishin, duty demands it"},{"start":38.664,"end":40.996,"text":"Strength for thy labour the Lord will provide"},{"start":41.616,"end":42.864,"text":"Back to the narrow way"},{"start":43.484,"end":44.618,"text":"Patiently win them"},{"start":45.238,"end":47.487,"text":"Tell the poor wand‘rer a Saviour had died."},{"start":48.107,"end":48.794,"text":"Amen."}],"start":35.767,"end":48.794}]},"daniel":{"file":"en-601-daniel.m4a","bytes":459054,"sha256":"1582737e085f9f9d1098643ce0c2f707fa070fbab7981e07c