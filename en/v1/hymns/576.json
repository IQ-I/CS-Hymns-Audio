{"v":1,"coll":"en","num":576,"id":"hymn_576","title":"SOLDIERS of Christ arise","duration":52.437,"voices":{"grace":{"file":"en-576-grace.m4a","bytes":457206,"sha256":"a269b3161837c1bb1a4ca3a0fcd5ea528c1e1562787a08bf28a0c12da569b57c","duration":52.437,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.91,"text":"SOLDIERS of Christ arise"},{"start":2.53,"end":3.766,"text":"And put your armour on"},{"start":4.386,"end":6.525,"text":"Strong in the strength which God supplies"},{"start":7.145,"end":8.565,"text":"Through His eternal Son."}],"start":0.35,"end":8.565},{"key":"2","lines":[{"start":10.335,"end":11.879,"text":"Strong in the Lord of Hosts"},{"start":12.499,"end":13.778,"text":"And in His mighty power"},{"start":14.398,"end":16.373,"text":"Who in the strenght of Jesus trusts"},{"start":16.993,"end":18.178,"text":"Is more than conqueror."}],"start":10.335,"end":18.178},{"key":"3","lines":[{"start":19.948,"end":21.609,"text":"Stand then in His great might"},{"start":22.229,"end":23.783,"text":"With all His strenght endued"},{"start":24.403,"end":26.251,"text":"But take, to arm you for the fight"},{"start":26.871,"end":28.158,"text":"The panoply of God."}],"start":19.948,"end":28.158},{"key":"4","lines":[{"start":29.928,"end":31.691,"text":"From strength to strength go on"},{"start":32.311,"end":33.825,"text":"Wrestle, and fight, and pray"},{"start":34.445,"end":36.436,"text":"Tread all the powers of darkness down"},{"start":37.056,"end":38.433,"text":"And win the well-fought day."}],"start":29.928,"end":38.433},{"key":"5","lines":[{"start":40.203,"end":41.817,"text":"That, having all things done"},{"start":42.437,"end":44.01,"text":"And all the conflicts past"},{"start":44.63,"end":46.429,"text":"Ye may o’ercome through Christ alone"},{"start":47.049,"end":48.661,"text":"And stand entire at last."},{"start":49.281,"end":49.968,"text":"Amen."}],"start":40.203,"end":49.968}]},"daniel":{"file":"en-576-daniel.m4a","bytes":461439,"sha256":"32200716434d84269f666e486