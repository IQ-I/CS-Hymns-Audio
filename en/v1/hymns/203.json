{"v":1,"coll":"en","num":203,"id":"hymn_203","title":"JOY fills our most heart to day","duration":51.802,"voices":{"grace":{"file":"en-203-grace.m4a","bytes":466689,"sha256":"6bff544c8f3a0f73a82a44cd21264e486b464354164631ec51cef171282006a1","duration":51.802,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.126,"text":"JOY fills our most heart to day"},{"start":2.746,"end":4.166,"text":"The royal Child is born;"},{"start":4.626,"end":6.503,"text":"And Angels hosts in glad array"},{"start":7.123,"end":8.648,"text":"His Advent keep this morn."}],"start":0.35,"end":8.648},{"key":"CHORUS","lines":[{"start":10.418,"end":13.07,"text":"Rejoice, rejoice! The incarntate Word"},{"start":13.69,"end":15.14,"text":"Has come on earth to dwell;"},{"start":15.6,"end":17.066,"text":"No sweeter sound than this"},{"start":17.686,"end":18.751,"text":"is heard-Emmanuel."}],"start":10.418,"end":18.751},{"key":"2","lines":[{"start":20.521,"end":22.355,"text":"Low at the cradle throne we bend"},{"start":22.976,"end":24.269,"text":"We wander and adore"},{"start":24.889,"end":27.073,"text":"And feel no bliss can ours transcend,"},{"start":27.453,"end":28.84,"text":"No joy was sweet before."}],"start":20.521,"end":28.84},{"key":"3","lines":[{"start":30.61,"end":32.692,"text":"For us the world must loose its charms"},{"start":33.312,"end":34.604,"text":"Before the manger shine,"},{"start":34.984,"end":37.039,"text":"When, folded in Thy mother‘s arms"},{"start":37.659,"end":39.095,"text":"We see Thee, Babe divine."}],"start":30.61,"end":39.095},{"key":"4","lines":[{"start":40.865,"end":42.751,"text":"Thou Light of uncreated Light"},{"start":43.371,"end":44.963,"text":"Shine on us, Holy Child;"},{"start":45.423,"end":47.24,"text":"That we may keep Thy birthday bright"},{"start":47.86,"end":49.333,"text":"With service undefiled."}],"start":40.865,"end":49.333}]},"daniel":{"file":"en-203-daniel.m4a","bytes":471966,"sha256":"83e456b1eb770d07d0945aac88ba6106fb7df6091e8986609a6f8b2ae620a4cf","dur