{"v":1,"coll":"en","num":289,"id":"hymn_289","title":"THOU who didst on Calvary bleed","duration":58.225,"voices":{"grace":{"file":"en-289-grace.m4a","bytes":539682,"sha256":"ec0c5aa75fc19b3ed9a828c92674d0c488b0fdcd904569f01f9c994ad1b19ceb","duration":58.225,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.198,"text":"THOU who didst on Calvary bleed,"},{"start":2.578,"end":4.308,"text":"Thou who dost for sinners plead,"},{"start":4.688,"end":6.206,"text":"Help me in my time of need,"},{"start":6.586,"end":7.992,"text":"Jesus, hear my cry."}],"start":0.35,"end":7.992},{"key":"2","lines":[{"start":9.762,"end":11.406,"text":"In my darkness and my grief,"},{"start":11.786,"end":13.241,"text":"With my heart of unbelief,"},{"start":13.621,"end":15.126,"text":"I, who am of sinners chief,"},{"start":15.506,"end":16.718,"text":"Lift to Thee mine eye."}],"start":9.762,"end":16.718},{"key":"3","lines":[{"start":18.488,"end":20.172,"text":"Foes without and fears within"},{"start":20.792,"end":21.723,"text":"with no plea"},{"start":22.343,"end":23.411,"text":"Thy grace to win,"},{"start":23.791,"end":25.5,"text":"But that Thou canst save from sin,"},{"start":25.88,"end":27.174,"text":"To Thy cross I fly."}],"start":18.488,"end":27.174},{"key":"4","lines":[{"start":28.944,"end":31.016,"text":"Brethren, long in fetters bound,"},{"start":31.396,"end":33.016,"text":"There deliverance sought and found,"},{"start":33.396,"end":35.103,"text":"Heard the voice of mercy sound,"},{"start":35.483,"end":36.565,"text":"Surely so may I."}],"start":28.944,"end":36.565},{"key":"5","lines":[{"start":38.335,"end":39.922,"text":"There an Thee I cast my care,"},{"start":40.302,"end":42.163,"text":"There to Thee I raise my prayer,"},{"start":42.543,"end":44.42,"text":"Jesus, save me from despair,"},{"start":44.8,"end":46.082,"text":"Save me, or I die."}],"start":38.335,"end":46.082},{"key":"6","lines":[{"start":47.852,"end":49.455,"text":"When the storms of trial lower,"},{"start":49.835,"end":5