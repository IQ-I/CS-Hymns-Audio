{"v":1,"coll":"en","num":701,"id":"hymn_701","title":"TO Thee, O Lord, our hearts we raise","duration":82.996,"voices":{"grace":{"file":"en-701-grace.m4a","bytes":790755,"sha256":"e235188bf58eeae5aabee0e1502a45ae64fd465e0d5ec6c7c797380a3444f6b7","duration":82.996,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.79,"text":"TO Thee, O Lord, our hearts we raise"},{"start":3.41,"end":4.824,"text":"In hymns of adoration"},{"start":5.444,"end":7.328,"text":"To Thee bring sacrifice of praise"},{"start":7.948,"end":9.561,"text":"With shouts of exultations"},{"start":10.181,"end":12.248,"text":"Bright robes of gold the field adorn"},{"start":12.868,"end":14.471,"text":"The hills with joy are ringing"},{"start":15.091,"end":16.633,"text":"The valleys stand are ringing"},{"start":17.253,"end":19.141,"text":"The valleys stand so thick with corn"},{"start":19.761,"end":21.022,"text":"That even they are singing."}],"start":0.35,"end":21.022},{"key":"2","lines":[{"start":22.792,"end":24.837,"text":"And now, on this our festal day"},{"start":25.457,"end":27.261,"text":"Thy bounteous hand confessing"},{"start":27.881,"end":29.52,"text":"Before Thee thankfully we lay"},{"start":30.14,"end":31.836,"text":"The first-fruits of Thy blessing"},{"start":32.456,"end":34.262,"text":"By Thee the souls of men are fed"},{"start":34.882,"end":36.615,"text":"With gifts of grace supernals"},{"start":37.235,"end":39.165,"text":"Thou who dost give us earthly bread"},{"start":39.785,"end":41.18,"text":"Give us the bread eternal."}],"start":22.792,"end":41.18},{"key":"3","lines":[{"start":42.95,"end":44.558,"text":"We bear the burden of the day"},{"start":45.178,"end":46.854,"text":"And often toil seems dreary"},{"start":47.474,"end":49.322,"text":"But labour ends with sunset ray"},{"start":49.942,"end":51.397,"text":"And rest comes for the weary"},{"start":52.017,"end":53.784,"text":"May we, the angel-reaping o’er"},{"start":54.404,"end":55.943,"text":"Stand at the last accepted"},{"start":56.563,"end":58.4,"text":"Christ's golden sheaves for evermore"},{"start":59.02,"end":60.601,"text":"To garmers bright elected."}],"start":42.95,"end":60.601},{"key":"4","lines":[{"start":62.371,"end":64.114,"text":"O blessed is that land of God"},{"start":64.734,"end":66.244,"text":"Where saints abide for ever"},{"start":66.864,"end":68.989,"text":"Where golden fields spread far and broad"},{"start":69.609,"end":71.219,"text":"Where flows the crystal river"},{"start":71.839,"end":73.552,"text":"The strains of all its holy throng"},{"start":74.172,"end":75.834,"text":"With ours to-day are blending"},{"start":76.454,"end":78.253,"text":"Thrice blessed is that harvest song"},{"start":78.873,"end":80.526,"text":"Which never hath and ending."}],"start":62.371,"end":80.526}]},"daniel":{"file":"en-701-daniel.m4a","bytes":788116,"sha256":"be657697ca0e4e1ef33929a6f72a71d7d9b6f71a74e8bf7fb0045f30bb747cb3","duration":82.35,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.465,"text":"TO Thee, O Lord, our hearts we raise"},{"start":3.085,"end":4.467,"text":"In hymns of adoration"},{"start":5.087,"end":7.021,"text":"To Thee bring sacrifice of praise"},{"start":7.641,"end":9.208,"text":"With shouts of exultations"},{"start":9.828,"end":11.868,"text":"Bright robes of gold the field adorn"},{"start":12.488,"end":14.076,"text":"The hills with joy are ringing"},{"start":14.696,"end":16.179,"text":"The valleys stand are ringing"},{"start":16.799,"end":18.767,"text":"The valleys stand so thick with corn"},{"start":19.387,"end":20.642,"text":"That even they are singing."}],"start":0.35,"end":20.642},{"key":"2","lines":[{"start":22.412,"end":24.267,"text":"And now, on this our festal day"},{"start":24.887,"end":26.607,"text":"Thy bounteous hand confessing"},{"start":27.227,"end":28.785,"text":"Before Thee thankfully we lay"},{"start":29.405,"end":31.097,"text":"The first-fruits of Thy blessing"},{"start":31.717,"end":33.543,"text":"By Thee the souls of men are fed"},{"start":34.163,"end"