{"v":1,"coll":"en","num":344,"id":"hymn_344","title":"O CHRIST, Thou hast ascended","duration":57.063,"voices":{"grace":{"file":"en-344-grace.m4a","bytes":527310,"sha256":"1f80be21a5d4108ac0dc17ec636f421298aa20b312bc3de60fd8df807b930b1c","duration":57.063,"segments":[{"key":"1","lines":[{"start":0.35,"end":2.187,"text":"O CHRIST, Thou hast ascended"},{"start":2.807,"end":4.085,"text":"Triumphantly on high"},{"start":4.705,"end":6.237,"text":"By cherub guards attended"},{"start":6.857,"end":8.181,"text":"And armies of the sky"},{"start":8.801,"end":10.385,"text":"Let earth tell forth the story"},{"start":11.005,"end":12.45,"text":"Our very flesh and bone"},{"start":13.07,"end":14.479,"text":"Emmanuel, in glory"},{"start":15.099,"end":16.633,"text":"Ascends His FATHER‘s Throne."}],"start":0.35,"end":16.633},{"key":"2","lines":[{"start":18.403,"end":20.193,"text":"There, there Thou standest pleading"},{"start":20.813,"end":22.198,"text":"The virtue of Thy Blood"},{"start":22.818,"end":24.326,"text":"For sinners interceding"},{"start":24.946,"end":26.299,"text":"Our Advocate with GOD;"},{"start":26.759,"end":28.435,"text":"And every changeful fashion"},{"start":29.055,"end":30.748,"text":"Of our brief joys and cares"},{"start":31.368,"end":32.939,"text":"Finds though in Thy compassion"},{"start":33.559,"end":35.083,"text":"And echo in Thy prayers."}],"start":18.403,"end":35.083},{"key":"3","lines":[{"start":36.853,"end":38.36,"text":"Oh, for a priceless merit"},{"start":38.98,"end":40.393,"text":"Of Thy redeeming Cross"},{"start":41.013,"end":42.988,"text":"Vouchsafe Thy Sevenfold SPIRIT"},{"start":43.608,"end":45.053,"text":"And turn to gain our loss"},{"start":45.673,"end":47.314,"text":"Till we, by strong endeavour"},{"start":47.934,"end":49.406,"text":"In heart and mind ascend,"},{"start":49.786,"end":51.233,"text":"And dwell with Thee for ever"},{"start":51.853,"end":53.286,"text":"In glories without end."},{"start":53.906,"end":54.593,"text":"Amen."}],"start":36.8