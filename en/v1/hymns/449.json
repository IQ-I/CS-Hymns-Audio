{"v":1,"coll":"en","num":449,"id":"hymn_449","title":"GIVE to the winds thy fears","duration":44.807,"voices":{"grace":{"file":"en-449-grace.m4a","bytes":396203,"sha256":"90b55715ecdde8d418aaae0f3fa1965eb3645c021fd059fd6070c23db6520bdf","duration":44.807,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.954,"text":"GIVE to the winds thy fears"},{"start":2.574,"end":4.005,"text":"Hope, and be undismayed"},{"start":4.625,"end":7.289,"text":"God hears thy sighs, and counts thy tears"},{"start":7.909,"end":9.464,"text":"God shall lift up thy head."}],"start":0.35,"end":9.464},{"key":"2","lines":[{"start":11.234,"end":13.277,"text":"Through waves, and clouds, and storms"},{"start":13.897,"end":15.362,"text":"He gently clear thy way"},{"start":15.982,"end":18.311,"text":"Wait thou His times: so shall this night"},{"start":18.931,"end":20.412,"text":"Soon end in joyous day."}],"start":11.234,"end":20.412},{"key":"3","lines":[{"start":22.182,"end":23.605,"text":"Still heavy is thy heart?"},{"start":24.225,"end":25.794,"text":"Still sink thy spirit down?"},{"start":26.414,"end":28.59,"text":"Cast off the weight, let fear depart"},{"start":29.21,"end":30.733,"text":"Bid every care be gone."}],"start":22.182,"end":30.733},{"key":"4","lines":[{"start":32.503,"end":33.939,"text":"What though thou rulest not?"},{"start":34.559,"end":36.293,"text":"Yet heav’n, and earth, and hell"},{"start":36.913,"end":38.956,"text":"Proclaim, God sitteth to the throne"},{"start":39.576,"end":41.03,"text":"And ruleth all things well!"},{"start":41.65,"end":42.337,"text":"Amen."}],"start":32.503,"end":42.337}]},"daniel":{"file":"en-449-daniel.m4a","bytes":391357,"sha256":"eb63fb1774aac565d630636672d0be4a0b7ebf28eae495edc6299f9409bb84e2","duration":43.938,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.995,"text":"GIVE to the winds thy fears"},{"start":2.615,"end":4.03,"text":"Hope, and be undismayed"},{"start":4.65,"end":7.115,"text":"God hears thy sighs, and counts thy tears"},{"start":