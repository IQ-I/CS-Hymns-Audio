{"v":1,"coll":"en","num":239,"id":"hymn_239","title":"JESUS my strength, my hope","duration":73.786,"voices":{"grace":{"file":"en-239-grace.m4a","bytes":681460,"sha256":"170913d4d5db08a2bbca699ddf0aedaee26e461041f2e584d56d5096eb389ef6","duration":73.786,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.954,"text":"JESUS my strength, my hope"},{"start":2.574,"end":3.988,"text":"On Thee I cast my care"},{"start":4.608,"end":6.38,"text":"With humble confidence look up"},{"start":7.0,"end":8.738,"text":"And know Thou hear'st my prayer"},{"start":9.358,"end":10.696,"text":"Give me on Thee to wait"},{"start":11.316,"end":12.718,"text":"TillI can all things do"},{"start":13.338,"end":15.165,"text":"On Thee, Almighty to create"},{"start":15.785,"end":16.842,"text":"Almighty to renew."}],"start":0.35,"end":16.842},{"key":"2","lines":[{"start":18.612,"end":19.904,"text":"I want a godly fear"},{"start":20.524,"end":21.725,"text":"A quick-discerning eye"},{"start":22.345,"end":24.095,"text":"That looks to Thee when sin is near"},{"start":24.715,"end":26.297,"text":"And sees the tempter fly"},{"start":26.917,"end":28.396,"text":"A spirit still prepared"},{"start":29.016,"end":30.492,"text":"And armed with jealous care"},{"start":31.112,"end":32.826,"text":"For ever standing on its guard"},{"start":33.446,"end":34.969,"text":"And watching unto prayer."}],"start":18.612,"end":34.969},{"key":"3","lines":[{"start":36.739,"end":38.016,"text":"I want a true regard"},{"start":38.636,"end":40.042,"text":"A single, steady aim"},{"start":40.662,"end":42.594,"text":"Unmoved by threatening or reward"},{"start":43.214,"end":44.758,"text":"To Thee and Thy great name"},{"start":45.378,"end":46.86,"text":"A jealous just concern"},{"start":47.48,"end":49.025,"text":"For Thine immortal praise"},{"start":49.645,"end":51.381,"text":"A pure desire that all may learn"},{"start":52.001,"end":53.413,"text":"And glorify Thy grace."}],"start":36.739,"end":53.413},{"key":"4","lines":[{"start":55.183,"