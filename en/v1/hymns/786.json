{"v":1,"coll":"en","num":786,"id":"hymn_786","title":"THANKS we offer unto God","duration":114.16,"voices":{"grace":{"file":"en-786-grace.m4a","bytes":1021416,"sha256":"784ff08496b78d8b486b4064d0f4baaa1beab0793007826184eda49ada947a8b","duration":114.16,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.924,"text":"THANKS we offer unto God"},{"start":2.544,"end":4.189,"text":"Who offered us Christ Jesus"},{"start":4.809,"end":6.148,"text":"To redeem the universe"},{"start":6.768,"end":8.4,"text":"From the hold of satan and sin."}],"start":0.35,"end":8.4},{"key":"CHORUS","lines":[{"start":10.17,"end":12.258,"text":"Praise Him loudly, offer Him thanks"},{"start":12.878,"end":14.253,"text":"Holy God the Trinity"},{"start":14.873,"end":16.39,"text":"For His mercies and favour"},{"start":17.01,"end":18.663,"text":"Broadly on the Seraphim Band."}],"start":10.17,"end":18.663},{"key":"2","lines":[{"start":20.433,"end":22.257,"text":"Divine power of God doth grow"},{"start":22.877,"end":24.755,"text":"Glory of Jesus manifests"},{"start":25.375,"end":27.239,"text":"The pow’r of Holy Spirit dwells"},{"start":27.859,"end":29.462,"text":"Amidst the Band of Seraphim."}],"start":20.433,"end":29.462},{"key":"3","lines":[{"start":31.232,"end":33.009,"text":"All men and nations on earth"},{"start":33.629,"end":35.287,"text":"Bow down in pray'r unto God"},{"start":35.907,"end":37.596,"text":"Repent ye in Spirit of Truth"},{"start":38.216,"end":39.758,"text":"May Father above save us."}],"start":31.232,"end":39.758},{"key":"4","lines":[{"start":41.528,"end":43.599,"text":"Sins increaseth, earth is troubled"},{"start":44.219,"end":46.034,"text":"Satan pilfers and rejoicing"},{"start":46.654,"end":48.32,"text":"Let all Christians congregate"},{"start":48.94,"end":50.614,"text":"In prayers to conquer satan."}],"start":41.528,"end":50.614},{"key":"5","lines":[{"start":52.384,"end":53.864,"text":"All ye pious believers"},{"start":54.484,"end":56.367,"text":"Jesus knows thine hidden works"