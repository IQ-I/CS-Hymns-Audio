{"v":1,"coll":"en","num":348,"id":"hymn_348","title":"THOU art gone up on high","duration":55.45,"voices":{"grace":{"file":"en-348-grace.m4a","bytes":506859,"sha256":"c9d7fb1650e2fc895c9a2b11d1cb32d401c3e56531cdd6902496eb66c27b8f07","duration":55.45,"segments":[{"key":"1","lines":[{"start":0.35,"end":1.801,"text":"THOU art gone up on high"},{"start":2.421,"end":3.855,"text":"To mansions in the skies"},{"start":4.475,"end":6.263,"text":"And round Thy Throne unceasingly"},{"start":6.883,"end":8.166,"text":"But we are lingering here"},{"start":8.786,"end":10.254,"text":"With sin and care oppressed"},{"start":10.874,"end":12.914,"text":"Lord, send Thy promised Comforter"},{"start":13.534,"end":14.84,"text":"And lead us to our rest."}],"start":0.35,"end":14.84},{"key":"2","lines":[{"start":16.61,"end":18.079,"text":"Thou art gone upon high"},{"start":18.699,"end":20.329,"text":"But Thou didst first come down"},{"start":20.949,"end":22.665,"text":"Through earth‘s most bitter misery"},{"start":23.285,"end":24.74,"text":"To pass unto Thy Crown"},{"start":25.36,"end":26.893,"text":"And girt with griefs and fear"},{"start":27.513,"end":29.064,"text":"Our onward course must be"},{"start":29.684,"end":31.445,"text":"But only let this path of tears"},{"start":32.065,"end":33.421,"text":"Lead us at last to Thee."}],"start":16.61,"end":33.421},{"key":"3","lines":[{"start":35.191,"end":36.642,"text":"Thou art gone up on high"},{"start":37.262,"end":38.651,"text":"But Thou shalt come again"},{"start":39.271,"end":40.946,"text":"With all the bright ones of the sky"},{"start":41.566,"end":42.942,"text":"Attendant in Thy train"},{"start":43.562,"end":45.188,"text":"Lord, by Thy saving power"},{"start":45.808,"end":47.167,"text":"So make us live and die"},{"start":47.787,"end":49.354,"text":"That we may stand in that dread"},{"start":49.974,"end":51.673,"text":"hour At Thy right Hand on high."},{"start":52.293,"end":52.98,"text":"Amen."}],"start":35.191,"end":52.98}]},"daniel":{"file":"