{"v":2,"coll":"y","num":77,"id":"hymn_77","title":"T'OLUWA n'ile at'ekun re,","duration":55.952,"voices":{"male":{"file":"y-77-male-v2.m4a","bytes":383173,"sha256":"05c76804b964c290befc02787b102c9b035efd2226279e24ad1d76aa647b43fa","duration":56.0},"female":{"file":"y-77-female-v2.m4a","bytes":399331,"sha256":"039f4178f89b2d74887fddea3bde8167bffde3e16a84d18c84c4685aa93c3455","duration":56.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.895,"text":"T'OLUWA n'ile at'ekun re,","marked":"T'Olúwa n'ilé àt'ẹkùn rẹ̀"},{"start":2.345,"end":3.739,"text":"Aiye at'ekun 'nu re,","marked":"Ayé àt'ẹkùn nù rẹ̀"},{"start":4.189,"end":6.158,"text":"O fi 'di re sole lor'okun","marked":"Ó fi di rẹ̀ sọlẹ̀ lór'òkun"},{"start":6.608,"end":7.958,"text":"Ati lori 'san omi.","marked":"Àti lórí san omi."}],"end":7.958},{"key":"CHORUS","start":8.908,"lines":[{"start":8.908,"end":9.975,"text":"Gb'ori soke","marked":"Gb'orí sókè"},{"start":10.425,"end":11.252,"text":"Enyin 'Iekun","marked":"Ẹ̀yin lẹ́kùn"},{"start":11.702,"end":13.098,"text":"K'a gbe nyin soke","marked":"K'á gbé yín sókè"},{"start":13.548,"end":14.906,"text":"K'Oba Ogo wole wa.","marked":"K'Ọba Ògo wọlé wá."}],"end":14.906},{"key":"2","start":15.856,"lines":[{"start":15.856,"end":17.662,"text":"Tani yio g'ori oke yi lo","marked":"Tani yóò g'orí òkè yí lọ"},{"start":18.112,"end":19.125,"text":"Ori oke Oluwa","marked":"Orí òkè Olúwa"},{"start":19.575,"end":20.976,"text":"Tani yio duro niwaju Re,","marked":"Tani yóò dúró níwájú Rẹ"},{"start":21.426,"end":22.805,"text":"Niwaju Oluwa wa.","marked":"Níwájú Olúwa wà."},{"start":23.255,"end":24.406,"text":"Egbe:  Gb'ori soke...","marked":"Gb'orí sókè"}],"end":24.406},{"key":"3","start":25.356,"lines":[{"start":25.356,"end":26.591,"text":"Enit'o ni owo mimo","marked":"Ẹnit'ó ní ọwọ́ mímọ́"},{"start":27.041,"end":28.507,"text":"T'o si ni aiya funfun,","marked":"T'ó sì ní àìyá funfun"},{"start":28.957,"end":30.583,"text":"Ti ko gb'okan re s'oke s'asan","marked":"Tí kò gb'ọkàn rẹ̀ s'òkè s'ásán"},{"start":31.033,"end":32.439,"text":"Ti ko si bura etan.","marked":"Tí kò sì búra ẹ̀tàn."},{"start":32.889,"end":33.958,"text":"Egbe:  Gb'ori soke...","marked":"Gb'orí sókè"}],"end":33.958},{"key":"4","start":34.908,"lines":[{"start":34.908,"end":36.417,"text":"Awa n'iran ti ns'aferi Re,","marked":"Àwa n'ìran tí ńṣ'àfẹ́rí Rẹ̀"},{"start":36.867,"end":37.984,"text":"Saferi Re Oluwa,","marked":"Ṣàfẹ́rí Rẹ Olúwa"},{"start":38.434,"end":40.232,"text":"Awa yio si ri ibukun gba,","marked":"Àwa yóò sì rí ìbùkún gbà"},{"start":40.682,"end":41.848,"text":"Lowo Olorun Jakob.","marked":"Lọ́wọ́ Ọlọ́run Jakọb."},{"start":42.298,"end":43.327,"text":"Egbe:  Gb'ori soke...","marked":"Gb'orí sókè"}],"end":43.327},{"key":"5","start":44.277,"lines":[{"start":44.277,"end":46.351,"text":"A! Tani Oba Ogo yi?","marked":"A! Tani Ọba Ògo yí?"},{"start":46.801,"end":48.092,"text":"Ti 'se Oba Ogo yi?","marked":"Tí ṣe Ọba Ògo yí?"},{"start":48.542,"end":49.992,"text":"Oluwa awon omo-ogun,","marked":"Olúwa àwọn omo-ogun"},{"start":50.442,"end":51.864,"text":"On na ni Oba Ogo.","marked":"Òn nà ní Ọba Ògo."},{"start":52.314,"end":53.395,"text":"Egbe:  Gb'ori soke...","marked":"Gb'orí sókè"},{"start":53.845,"end":54.403,"text":"Amin.","marked":"Àmín."}],"end":54.403}]}