{"v":2,"coll":"y","num":108,"id":"hymn_108","title":"KERUBU ati Serafu","duration":82.574,"voices":{"male":{"file":"y-108-male-v2.m4a","bytes":585287,"sha256":"10194b128ed4bb32bff1f84a4a9b6c9f8537423cd47a521af54ce2673d6dd963","duration":82.6},"female":{"file":"y-108-female-v2.m4a","bytes":612663,"sha256":"304bce1a2793f9cb5294f4ea6af51322806cdeebc44c8fcacd3cee100fcb3a13","duration":82.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.072,"text":"KERUBU ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":2.522,"end":3.944,"text":"E fun irugbin rere s'aiye","marked":"Ẹ fún irúgbìn rere s'ayé"},{"start":4.394,"end":6.057,"text":"Enyin l'a pe Iati s' awon","marked":"Ẹ̀yin l'á pẹ́ láti ṣ àwọn"},{"start":6.507,"end":8.064,"text":"Ti yio pade Oluwa l'oke.","marked":"Tí yóò pàdé Olúwa l'òkè."},{"start":8.514,"end":9.736,"text":"Egbe:  Gbo, gbo, gba b'awon","marked":"Gbọ́, gbọ́, gba b'àwọn"},{"start":10.186,"end":11.866,"text":"Serafu ti nke","marked":"Séráfù ti ńké"},{"start":12.316,"end":13.547,"text":"Gbo, gbo, gbo b'awon","marked":"Gbọ́, gbọ́, gbọ́ b'àwọn"},{"start":13.997,"end":15.285,"text":"Kerubu ti nke","marked":"Kérúbù tí ńké"},{"start":15.735,"end":17.575,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":18.025,"end":19.494,"text":"Halleluyah, f'Oba wa.","marked":"Hallelúyà, f'Ọba wa."}],"end":19.494},{"key":"2","start":20.444,"lines":[{"start":20.444,"end":21.975,"text":"Onigbagbo, e ji giri,","marked":"Onígbàgbọ́, ẹ jí gírí"},{"start":22.425,"end":23.772,"text":"K'a fi iwa ese s'ile","marked":"K'á fi ìwà ẹ̀ṣẹ̀ s'ilẹ̀"},{"start":24.222,"end":25.641,"text":"K'a se ife Oluwa wa,","marked":"K'á ṣe ìfẹ́ Olúwa wa"},{"start":26.091,"end":27.518,"text":"K'a Ie r'oju rere Olorun.","marked":"K'á lè r'ojú rere Ọlọ́run."},{"start":27.968,"end":28.769,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":28.769},{"key":"3","start":29.719,"lines":[{"start":29.719,"end":31.818,"text":"Onigbngbo, e gb'adura","marked":"Onígbngbo, ẹ gb'àdúrà"},{"start":32.268,"end":33.879,"text":"E fi okan funfun sise","marked":"Ẹ fi ọkàn funfun ṣiṣẹ́"},{"start":34.329,"end":35.918,"text":"E gb' awe pelu iwa mimo","marked":"Ẹ gb àwẹ̀ pẹ̀lú ìwà mímọ́"},{"start":36.368,"end":37.219,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":37.219},{"key":"4","start":38.169,"lines":[{"start":38.169,"end":40.752,"text":"Enyin araiye, e tun aiye se","marked":"Ẹ̀yin aráìyè, ẹ tún ayé ṣe"},{"start":41.202,"end":42.611,"text":"Fun bibo Jesu Oluwa","marked":"Fún bíbọ̀ Jésù Olúwa"},{"start":43.061,"end":45.631,"text":"K'ese dinku, k'ajakale aron","marked":"K'ẹsẹ̀ dínkù, k'àjàkálẹ̀ arọn"},{"start":46.081,"end":47.782,"text":"Ma ti wa lo s'orun apadi.","marked":"Má ti wá lọ s'ọ̀run àpadì."},{"start":48.232,"end":49.038,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":49.038},{"key":"5","start":49.988,"lines":[{"start":49.988,"end":51.326,"text":"Onigbagbo beru Olorun","marked":"Onígbàgbọ́ bẹ̀rù Ọlọ́run"},{"start":51.776,"end":53.063,"text":"Feran Omonikeji re","marked":"Fẹ́ràn Ọmọnìkejì rẹ"},{"start":53.513,"end":54.988,"text":"Mase pegan mase binu","marked":"Màṣẹ pẹ̀gàn màṣẹ bínú"},{"start":55.438,"end":57.215,"text":"Olorun yio gbo adura re.","marked":"Ọlọ́run yóò gbọ́ àdúrà rẹ̀."},{"start":57.665,"end":58.411,"text":"Egbe:  Gbo, gbo...","marked":"Gbọ́, gbọ́"}],"end":58.411},{"key":"6","start":59.361,"lines":[{"start":59.361,"end":60.932,"text":"Opo idanwo l'o wa l'aiye","marked":"Ọ̀pọ̀ ìdánwò l'ó wà l'ayé"},{"start":61.382,"end":63.154,"text":"Sugbon eyi t'o buruju","marked":"Ṣùgbọ́n èyí t'ó burújú"},{"start":63.604,"end":66.165,"text":"K'a ma r'owo, k'aisan de ni","marked":"K'á má r'ọwọ́, k'àìsàn dé ni"},{"start":66.615,"end":68.368,"text":"JAH jowo ma fi eyi se wa.","marked":"Jah jọ̀wọ́ má fi èyí ṣe wá."},{"start":68.818,"end":70.253,"text":"Egbe:  Gbo, gbo, gba b'awon","marked":"Gbọ́, gbọ́, gba b'àwọn"},{"start":70.703,"end":72.041,"text":"Serafu ti nke","marked":"Séráfù ti ńké"},{"start":72.491,"end":73.691,"text":"Gbo, gbo, gbo b'awon","marked":"Gbọ́, gbọ́, gbọ́ b'àwọn"},{"start":74.141,"end":75.574,"text":"Kerubu ti nke","marked":"Kérúbù tí ńké"},{"start":76.024,"end":77.849,"text":"Halleluyah, Halleluyah,","marked":"Hallelúyà, Hallelúyà"},{"start":78.299,"end":79.964,"text":"Halleluyah, f'Oba wa.","marked":"Hallelúyà, f'Ọba wa."},{"start":80.414,"end":81.025,"text":"Amin.","marked":"Àmín."}],"end":81.025}]}