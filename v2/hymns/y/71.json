{"v":2,"coll":"y","num":71,"id":"hymn_71","title":"GBANGBA l'oju Re Olorun","duration":47.529,"voices":{"male":{"file":"y-71-male-v2.m4a","bytes":324863,"sha256":"45a0072bea8a0d687a6cf96440541aa169067ac607467f879c95c01e51a41ab8","duration":47.6},"female":{"file":"y-71-female-v2.m4a","bytes":349967,"sha256":"719c140f60ea583e2fdc8c613f119a3d0ec6030f6e6e61d31b5d16841806ca47","duration":47.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.552,"text":"GBANGBA l'oju Re Olorun","marked":"Gbangba l'ojú Rẹ Ọlọ́run"},{"start":2.002,"end":3.409,"text":"S'Ohun gbogbo ta use,","marked":"S'Ohun gbogbo ta úṣẹ"},{"start":3.859,"end":5.662,"text":"T'osan t'oru bakanna ni,","marked":"T'ọ̀sán t'òru bákanná ni"},{"start":6.112,"end":7.245,"text":"L'oju Oluwa wa.","marked":"L'ojú Olúwa wa."}],"end":7.245},{"key":"2","start":8.195,"lines":[{"start":8.195,"end":10.351,"text":"Ko s'ese kan ti a le da","marked":"Kò s'ẹ̀ṣẹ̀ kan tí a lè dá"},{"start":10.801,"end":12.183,"text":"Ko s'oro t'a le so","marked":"Kò s'ọ̀rọ̀ t'á lè sọ"},{"start":12.633,"end":13.97,"text":"Ti ko si ninu iwe Re","marked":"Tí kò sí nínú ìwé Rẹ"},{"start":14.42,"end":15.465,"text":"Fun iranti gbogbo.","marked":"Fún ìrántí gbogbo."}],"end":15.465},{"key":"3","start":16.415,"lines":[{"start":16.415,"end":18.116,"text":"Ese ole, ese iro","marked":"Ẹsẹ̀ olè, ẹsẹ̀ irọ́"},{"start":18.566,"end":19.737,"text":"Ese aiforiji","marked":"Ẹ̀ṣẹ̀ àìforíjì"},{"start":20.187,"end":21.706,"text":"Ese ka soro eni lehin","marked":"Ẹ̀ṣẹ̀ ká sọ̀rọ̀ ẹni lẹ́hìn"},{"start":22.156,"end":23.432,"text":"Baba dariji wa.","marked":"Baba dáríjì wá."}],"end":23.432},{"key":"4","start":24.382,"lines":[{"start":24.382,"end":25.557,"text":"Ese igberaga okan","marked":"Ẹ̀ṣẹ̀ ìgbéraga ọkàn"},{"start":26.007,"end":27.094,"text":"Ese isokuso","marked":"Ẹ̀ṣẹ̀ ìsọkúsọ"},{"start":27.544,"end":29.154,"text":"Ese aini 'gbagbo daju","marked":"Ẹsẹ̀ àìní gbàgbọ́ dájú"},{"start":29.604,"end":30.841,"text":"Baba dariji wa.","marked":"Baba dáríjì wá."}],"end":30.841},{"key":"5","start":31.791,"lines":[{"start":31.791,"end":33.369,"text":"A! l'ojo nla ojo 'dajo","marked":"A! l'ọjọ́ ńlá ọjọ́ dájọ́"},{"start":33.819,"end":34.981,"text":"Ma je k'oju tiwa","marked":"Má jẹ́ k'ojú tiwa"},{"start":35.431,"end":36.661,"text":"T'oju gbogbo aiye yio pe","marked":"T'ojú gbogbo ayé yóò pé"},{"start":37.111,"end":38.332,"text":"Baha dariji wa.","marked":"Baha dáríjì wá."}],"end":38.332},{"key":"6","start":39.282,"lines":[{"start":39.282,"end":40.47,"text":"Dariji mi Olorun mi,","marked":"Dáríjì mi Ọlọ́run mi"},{"start":40.92,"end":42.412,"text":"Ki nto lo laiye yi,","marked":"Kí ńtọ́ lọ láìyẹ́ yí"},{"start":42.862,"end":44.145,"text":"Si pa gbogbo ese mi re","marked":"Sì pa gbogbo ẹ̀ṣẹ̀ mi rẹ"},{"start":44.595,"end":45.98,"text":"Baba danriji mi.","marked":"Baba dàǹríjì mi."}],"end":45.98}]}