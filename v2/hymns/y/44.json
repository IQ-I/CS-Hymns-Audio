{"v":2,"coll":"y","num":44,"id":"hymn_44","title":"OJO isimi Olorun","duration":42.087,"voices":{"male":{"file":"y-44-male-v2.m4a","bytes":287512,"sha256":"f87e644eb1d39aa3cb94223f8940f8c39a89aa28777d44f2496bc6ede564fc73","duration":42.1},"female":{"file":"y-44-female-v2.m4a","bytes":299505,"sha256":"6db353670304647daa9e50ce7160d57bdad31de7018810d735e94faa19a5c783","duration":42.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.426,"text":"OJO isimi Olorun","marked":"Ọjọ́ ìṣímí Ọlọ́run"},{"start":1.876,"end":3.158,"text":"Ojo ti o dara julo","marked":"Ọjọ́ tí ó dára jùlọ"},{"start":3.608,"end":4.899,"text":"Ti Olorun ti fun wa","marked":"Tí Ọlọ́run ti fún wa"},{"start":5.349,"end":6.762,"text":"K'awa ko simi ninu re.","marked":"K'àwa kò ṣímí nínú rẹ̀."}],"end":6.762},{"key":"2","start":7.712,"lines":[{"start":7.712,"end":9.182,"text":"Ijo mefa l'O fi fun wa","marked":"Ìjọ mẹ́fà l'Ó fi fún wa"},{"start":9.632,"end":11.26,"text":"K'a fi se ise wa gbogbo","marked":"K'á fi ṣe iṣẹ́ wa gbogbo"},{"start":11.71,"end":13.468,"text":"Sugbon ojo keje yato","marked":"Ṣùgbọ́n ọjọ́ keje yàtọ̀"},{"start":13.918,"end":15.371,"text":"Ojo 'simi Olorun ni.","marked":"Ọjọ́ ṣímí Ọlọ́run ni."}],"end":15.371},{"key":"3","start":16.321,"lines":[{"start":16.321,"end":18.302,"text":"K'a fi 'se asan wa,sile","marked":"K'á fi ṣe asán wa,sile"},{"start":18.752,"end":20.166,"text":"Ti awa nse n'ijo mefa","marked":"Tí àwa ńṣe n'ìjọ mẹ́fà"},{"start":20.616,"end":22.144,"text":"Mimo ni ise ti oni","marked":"Mímọ́ ni iṣẹ́ tí òní"},{"start":22.594,"end":23.684,"text":"Ti Olorun Oluwa wa.","marked":"Ti Ọlọ́run Olúwa wà."}],"end":23.684},{"key":"4","start":24.634,"lines":[{"start":24.634,"end":26.015,"text":"A pada de nisisyi","marked":"A padà dé níṣìṣyí"},{"start":26.465,"end":27.467,"text":"Ninu ile Olorun wa","marked":"Nínú ilé Ọlọ́run wa"},{"start":27.917,"end":29.472,"text":"Je k'a korin didun si i","marked":"Jẹ́ k'á kọrin dídùn sí i"},{"start":29.922,"end":31.262,"text":"Li owuro ojo oni.","marked":"Lí òwúrọ̀ ọjọ́ òní."}],"end":31.262},{"key":"5","start":32.212,"lines":[{"start":32.212,"end":33.729,"text":"Ni kutukutu 'jo keje","marked":"Ní kùtùkùtù jọ keje"},{"start":34.179,"end":35.419,"text":"Ni ojo isimi mimo","marked":"Ní ọjọ́ ìṣímí mímọ́"},{"start":35.869,"end":37.364,"text":"Je k'a jumo korin didun","marked":"Jẹ́ k'á jùmọ̀ kọrin dídùn"},{"start":37.814,"end":39.437,"text":"Je k'a si jumo gbadura.","marked":"Jẹ́ k'á sì jùmọ̀ gbàdúrà."},{"start":39.887,"end":40.537,"text":"Amin.","marked":"Àmín."}],"end":40.537}]}