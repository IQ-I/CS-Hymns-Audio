{"v":2,"coll":"y","num":52,"id":"hymn_52","title":"BABA MIMO jowo gbo","duration":89.736,"voices":{"male":{"file":"y-52-male-v2.m4a","bytes":653326,"sha256":"5f044f4f5e249acf1c92deff28be2714b3eceb5f965b6122fc9d060dca06dff3","duration":89.8},"female":{"file":"y-52-female-v2.m4a","bytes":668839,"sha256":"f69749793eb5c37591f6badadcbba783b8ae653e218cb6b682105b989403b8a7","duration":89.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.457,"text":"BABA MIMO jowo gbo, gbe omo Re,","marked":"Baba Mímọ́ jọ̀wọ́ gbọ́, gbé ọmọ Rẹ"},{"start":2.907,"end":4.414,"text":"METALOKAN MlMO OBA OGO,","marked":"Mẹ́talọ́kan Mlmo Ọba Ògo"},{"start":4.864,"end":6.556,"text":"Egbe aladura ipe na ndun","marked":"Ẹgbẹ́ aládúrà ìpè nà ńdún"},{"start":7.006,"end":8.937,"text":"Egbe Serafu t'aiye e mura.","marked":"Ẹgbẹ́ Séráfù t'ayé e múra."}],"end":8.937},{"key":"CHORUS","start":9.887,"lines":[{"start":9.887,"end":12.517,"text":"Wa ore mi, wa ka jumo rin,","marked":"Wá ọrẹ mi, wa ká jùmọ̀ rìn"},{"start":12.967,"end":14.652,"text":"F'oju okan wo agbala ni","marked":"F'ojú ọkàn wo àgbàlá ni"},{"start":15.102,"end":16.721,"text":"Nib'OLUDANDE wa nwipe","marked":"Níb'olùdáǹdè wà ńwípé"},{"start":17.171,"end":18.596,"text":"BABA MIMO dariji.","marked":"Baba Mímọ́ dáríjì."}],"end":18.596},{"key":"2","start":19.546,"lines":[{"start":19.546,"end":21.634,"text":"Ogoji odun ni BABA fi gb'ebe,","marked":"Ogójì ọdún ni Baba fi gb'ẹ̀bẹ̀"},{"start":22.084,"end":23.842,"text":"Ka le gb'egbe lo logo yi dide","marked":"Ká lè gb'ègbè lọ lógo yí dìde"},{"start":24.292,"end":26.304,"text":"Ogoji Odun ni OMO fi bebe","marked":"Ogójì Ọdún ni Ọmọ fi bẹ̀bẹ̀"},{"start":26.754,"end":29.026,"text":"Lati d'egbe Serafu yi sile.","marked":"Láti d'ẹgbẹ́ Séráfù yí sílẹ̀."}],"end":29.026},{"key":"3","start":29.976,"lines":[{"start":29.976,"end":31.748,"text":"BABA OLUPESE jo pese fun wa,","marked":"Baba Olùpèsè jọ pèsè fún wa"},{"start":32.198,"end":33.874,"text":"OLUGBOGBE EDA gbogb' edun wa,","marked":"Olùgbọgbẹ́ Ẹ̀dá gbogb ẹ̀dùn wa"},{"start":34.324,"end":35.939,"text":"OLUBUKUN-JULO leni ranse na,","marked":"Olubukun-julo lẹ́ni ránṣẹ́ na"},{"start":36.389,"end":37.93,"text":"METALOKAN ranse rere si wa.","marked":"Mẹ́talọ́kan ránṣẹ́ rere sí wa."}],"end":37.93},{"key":"4","start":38.88,"lines":[{"start":38.88,"end":41.958,"text":"Egbe akorin e tun ohun nyin se,","marked":"Ẹgbẹ́ akọrin ẹ tún ohun yín ṣe"},{"start":42.408,"end":43.972,"text":"Ke Halleluya s'Oba Olore","marked":"Ké Hallelúyà s'Ọba Ọlọ́rẹ́"},{"start":44.422,"end":46.201,"text":"Egbe Aladura e t'esu mole","marked":"Ẹgbẹ́ Aládúrà ẹ t'èṣù mọ́lẹ̀"},{"start":46.651,"end":48.266,"text":"K'EMI MlMO s'amona Egbe wa.","marked":"K'èmi Mlmo s'amọ̀nà Ẹgbẹ́ wa."}],"end":48.266},{"key":"5","start":49.216,"lines":[{"start":49.216,"end":51.024,"text":"Enyin ariran nin'egbe Serafu","marked":"Ẹ̀yin aríran nín'ẹ̀gbẹ́ Séráfù"},{"start":51.474,"end":53.432,"text":"Mase boju w'ehin esu wa nibe,","marked":"Máṣe bojú w'ẹ̀hìn èṣù wà níbẹ̀"},{"start":53.882,"end":56.217,"text":"Mura gin k'esu ma fa o sehin","marked":"Múra gín k'èṣù má fà ọ́ sẹ́hìn"},{"start":56.667,"end":58.289,"text":"J'eni kikun laiberu enia.","marked":"J'ẹni kíkún láìbẹ̀rù ẹnìà."}],"end":58.289},{"key":"6","start":59.239,"lines":[{"start":59.239,"end":60.683,"text":"Awa dupe Iowo OBANGUI","marked":"Àwa dúpẹ́ lọ́wọ́ Obangui"},{"start":61.133,"end":62.485,"text":"OLORUN ALANU buk'egbe wa,","marked":"Ọlọ́run Alánù bùk'ẹ̀gbẹ́ wa"},{"start":62.935,"end":65.064,"text":"JEHOVAH SABAOTH jowo sunmo wa,","marked":"Jehovah Sabaoth jọ̀wọ́ súnmọ́ wa"},{"start":65.514,"end":67.735,"text":"Segun gbogb'ota 'le ati t'ode.","marked":"Ṣẹ́gun gbogb'ọ̀tá lé àti t'òde."}],"end":67.735},{"key":"7","start":68.685,"lines":[{"start":68.685,"end":70.748,"text":"Ope lo ye omo Egbe Kerubu,","marked":"Ọpẹ́ ló yẹ ọmọ Ẹgbẹ́ Kérúbù"},{"start":71.198,"end":72.788,"text":"Fun anu re lori gbogb'egbe wa","marked":"Fún àánú rẹ̀ lórí gbogb'ẹgbẹ́ wa"},{"start":73.238,"end":75.905,"text":"Elom ran jade nile o d'oku","marked":"Ẹlọ́m rán jáde nílé ó d'òkú"},{"start":76.355,"end":78.322,"text":"A dupe fun abo to fi mbo wa.","marked":"A dúpẹ́ fún abo tó fi mbọ̀ wá."}],"end":78.322},{"key":"8","start":79.272,"lines":[{"start":79.272,"end":81.366,"text":"F'OGO fun BABA MIMO loke orun,","marked":"F'ògo fún Baba Mímọ́ lókè ọ̀run"},{"start":81.816,"end":83.506,"text":"E tun f'ogo fun OMO RE pelu","marked":"Ẹ tún f'ògo fún Ọmọ Rẹ̀ pẹ̀lú"},{"start":83.956,"end":85.8,"text":"E f'ogo EMl to dari wa","marked":"Ẹ f'ògo Eml tó darí wa"},{"start":86.25,"end":88.187,"text":"Metalokan Mimo lope ye fun","marked":"Mẹ́talọ́kan Mímọ́ lòpẹ́ yẹ fún"}],"end":88.187}]}