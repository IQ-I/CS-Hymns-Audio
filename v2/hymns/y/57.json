{"v":2,"coll":"y","num":57,"id":"hymn_57","title":"GBA WA lojo na t' ao se 'dajo aiye","duration":114.947,"voices":{"male":{"file":"y-57-male-v2.m4a","bytes":829020,"sha256":"59b244b6080b0a5f324b67d908deecc292c7fb8301c2688c7dd0c0f103a853a6","duration":115.0},"female":{"file":"y-57-female-v2.m4a","bytes":856195,"sha256":"e49ebab9239efae991fe09b1034bc15baac3da772926ed3a48304e678fb295ec","duration":115.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.595,"text":"GBA WA lojo na t' ao se 'dajo aiye,","marked":"Gbà Wá lọ́jọ́ ná t àó ṣe dájọ́ ayé"},{"start":3.045,"end":4.312,"text":"K'awa le j'eni 'tewogba","marked":"K'àwa lè j'ẹni tẹ́wọ́gbà"},{"start":4.762,"end":6.337,"text":"Se iranlowo fun wa ka j'eni","marked":"Ṣe ìrànlọ́wọ́ fún wa ká j'ẹni"},{"start":6.787,"end":7.406,"text":"'tewogba","marked":"tẹ́wọ́gbà"},{"start":7.856,"end":9.486,"text":"Sibi omi 'ye t'O pese.","marked":"Ṣíbí omi yẹ t'Ó pèsè."}],"end":9.486},{"key":"CHORUS","start":10.436,"lines":[{"start":10.436,"end":11.912,"text":"Sanu fun wa gbadura wa,","marked":"Ṣànù fún wa gbàdúrà wa"},{"start":12.362,"end":14.124,"text":"Ji okan ti ntogbe kuro nin'ese. 2ce","marked":"Jí ọkàn tí ńtọgbẹ́ kúrò nín'ẹsẹ̀."}],"end":14.124},{"key":"2","start":15.074,"lines":[{"start":15.074,"end":16.989,"text":"Jowo tan imole Re loni Oluwa,","marked":"Jọ̀wọ́ tan ìmọ́lẹ̀ Rẹ lóní Olúwa"},{"start":17.439,"end":18.837,"text":"S'oju awon ti ko riran","marked":"S'ojú àwọn tí kò ríran"},{"start":19.287,"end":21.342,"text":"Ni apa Jesu aye wa sibe","marked":"Ní apá Jésù ayé wá síbẹ̀"},{"start":21.792,"end":23.496,"text":"Mase tun wi awawi mo.","marked":"Mase tún wí àwáwí mọ́."},{"start":23.946,"end":25.46,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":25.46},{"key":"3","start":26.41,"lines":[{"start":26.41,"end":28.408,"text":"Enyin lmale ati Keferi,","marked":"Ẹ̀yin lmálẹ̀ àti Kèfèrí"},{"start":28.858,"end":30.122,"text":"E wa gbo ihin rere yi,","marked":"Ẹ wá gbọ́ ìhín rere yí"},{"start":30.572,"end":33.131,"text":"Akoko na mbo t'a o bere lowo re","marked":"Àkókò na mbo t'á ó bẹ̀rẹ̀ lọ́wọ́ rẹ̀"},{"start":33.581,"end":34.709,"text":"Pe ise kini iwo nse?","marked":"Pé iṣẹ́ kíni ìwọ ńṣe?"},{"start":35.159,"end":36.724,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":36.724},{"key":"4","start":37.674,"lines":[{"start":37.674,"end":39.899,"text":"Enyin Egbe Kerubu ati Serafu","marked":"Ẹ̀yin Ẹgbẹ́ Kérúbù àti Séráfù"},{"start":40.349,"end":42.084,"text":"E j'arowa e ma w'ehin","marked":"Ẹ j'àrọ̀wá ẹ má w'ẹ̀hìn"},{"start":42.534,"end":44.636,"text":"Lo wo Isaiah ori ogota,","marked":"Lọ wo Isaiah orí ọgọ́ta"},{"start":45.086,"end":46.403,"text":"Ese kini ati keji.","marked":"Ẹsẹ̀ kiní àti kejì."},{"start":46.853,"end":48.227,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":48.227},{"key":"5","start":49.177,"lines":[{"start":49.177,"end":51.295,"text":"Enyin ero iworan ati enijoko","marked":"Ẹ̀yin èrò ìwòran àti ẹnìjókò"},{"start":51.745,"end":53.494,"text":"Bi'dajo ba o nin'ese nko","marked":"Bí'dájọ́ bá ọ nín'ẹsẹ̀ ńkọ́"},{"start":53.944,"end":56.032,"text":"E wa si imole ninu Egbe Serafu,","marked":"Ẹ wá sí ìmọ́lẹ̀ nínú Ẹgbẹ́ Séráfù"},{"start":56.482,"end":57.775,"text":"Ke ba le j'eni 'tewogba.","marked":"Ké bá lè j'ẹni tẹ́wọ́gbà."},{"start":58.225,"end":59.711,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":59.711},{"key":"6","start":60.661,"lines":[{"start":60.661,"end":62.302,"text":"Gbogbo Omo Egbe t'o s'olotito","marked":"Gbogbo Ọmọ Ẹgbẹ́ t'ó s'olótítọ́"},{"start":62.752,"end":64.55,"text":"Ade ogo ti wa fun nyin,","marked":"Adé ògo ti wà fún yín"},{"start":65.0,"end":66.765,"text":"Bohubiea Aleakutatabb","marked":"Bohubiea Aleakutatabb"},{"start":67.215,"end":68.853,"text":"Ko ni jeki gbogbo wa segbe.","marked":"Kò ní jẹ́kí gbogbo wa ṣègbé."},{"start":69.303,"end":70.739,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":70.739},{"key":"7","start":71.689,"lines":[{"start":71.689,"end":73.662,"text":"Enyin agan to wa ninu Egbe","marked":"Ẹ̀yin àgàn tó wà nínú Ẹgbẹ́"},{"start":74.112,"end":75.293,"text":"E mura si 'gbagbo,","marked":"Ẹ múra sí gbàgbọ́"},{"start":75.743,"end":77.363,"text":"Ki e le ni omo bi Samueli","marked":"Kí ẹ lè ní ọmọ bí Samuẹli"},{"start":77.813,"end":79.078,"text":"Lodo Olodumare.","marked":"Lọ́dọ̀ Olódùmarè."},{"start":79.528,"end":80.981,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":80.981},{"key":"8","start":81.931,"lines":[{"start":81.931,"end":84.367,"text":"Enyin Alamodi to wa  nin' Egbe","marked":"Ẹ̀yin Alamodi tó wà nín Ẹgbẹ́"},{"start":84.817,"end":86.244,"text":"Enyin yio si ri 'wosan gba","marked":"Ẹ̀yin yóò sì rí wòsàn gbà"},{"start":86.694,"end":88.47,"text":"Lat'odo onisegun Jerusalemu","marked":"Lát'ọ̀dọ̀ oníṣègùn Jerúsálẹ́mù"},{"start":88.92,"end":90.311,"text":"E o ri imularada.","marked":"Ẹ ò rí ìmúláradá."},{"start":90.761,"end":92.238,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":92.238},{"key":"9","start":93.188,"lines":[{"start":93.188,"end":94.991,"text":"Enyin ti e ko ti ri 'se se,","marked":"Ẹ̀yin tí ẹ kò ti rí ṣe ṣe"},{"start":95.441,"end":97.178,"text":"Jehofa Jireh yio pese,","marked":"Jèhófà Jireh yóò pèsè"},{"start":97.628,"end":99.507,"text":"lse rere fun itelorun nyin,","marked":"lṣe rere fún ìtẹ́lọ́rùn yín"},{"start":99.957,"end":101.128,"text":"E o ri tunu gba.","marked":"Ẹ ò rí tùnú gbà."},{"start":101.578,"end":103.012,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"}],"end":103.012},{"key":"10","start":103.962,"lines":[{"start":103.962,"end":105.492,"text":"Ogo ni fun Baba loke","marked":"Ògo ni fún Baba lókè"},{"start":105.942,"end":106.975,"text":"Ogo ni fun Omo,","marked":"Ògo ni fún Ọmọ"},{"start":107.425,"end":108.602,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":109.052,"end":110.424,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":110.874,"end":112.373,"text":"Egbe: Sanu fun wa gbadura wa...","marked":"Ṣànù fún wa gbàdúrà wa"},{"start":112.823,"end":113.398,"text":"Amin.","marked":"Àmín."}],"end":113.398}]}