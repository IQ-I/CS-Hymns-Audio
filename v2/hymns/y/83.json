{"v":2,"coll":"y","num":83,"id":"hymn_83","title":"A DUPE lowo Olorun","duration":55.108,"voices":{"male":{"file":"y-83-male-v2.m4a","bytes":378181,"sha256":"c9d99f93d1723a0ccbb2b5e589faf1f538286b52753f4ce283e3ad61e4aa052e","duration":55.2},"female":{"file":"y-83-female-v2.m4a","bytes":394430,"sha256":"6fcdae18481e7ab962dcc8198250a71341a6aac21cf325bcb85a1782eec57e12","duration":55.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.416,"text":"A DUPE lowo Olorun","marked":"A Dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":1.866,"end":3.151,"text":"T'o da wa si d'oni","marked":"T'ó dá wa sì d'óní"},{"start":3.601,"end":5.167,"text":"T'o je k'emi tun emi ri,","marked":"T'ó jẹ́ k'èmi tún èmi rí"},{"start":5.617,"end":6.91,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":6.91},{"key":"CHORUS","start":7.86,"lines":[{"start":7.86,"end":8.964,"text":"A dupe lowo Olorun","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":9.414,"end":10.97,"text":"T'o da emi wa si d'oni","marked":"T'ó dá ẹ̀mí wa sì d'óní"},{"start":11.42,"end":12.891,"text":"T'o je k'emi tun emi ri","marked":"T'ó jẹ́ k'èmi tún èmi rí"},{"start":13.341,"end":14.623,"text":"Ogo f'oruko Re.","marked":"Ògo f'orúkọ Rẹ."}],"end":14.623},{"key":"2","start":15.573,"lines":[{"start":15.573,"end":17.088,"text":"Ise po n'ilu Osogbo","marked":"Iṣẹ́ pọ̀ n'ìlú Òṣògbò"},{"start":17.538,"end":18.755,"text":"T'ilesa ko ni so;","marked":"T'ìlẹ́sà kò ní sọ"},{"start":19.205,"end":20.674,"text":"Egbe Ondo ti mura tan","marked":"Ẹgbẹ́ Òǹdó ti múra tán"},{"start":21.124,"end":22.494,"text":"Lati gbe Jesu ga.","marked":"Láti gbé Jésù ga."},{"start":22.944,"end":24.041,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"}],"end":24.041},{"key":"3","start":24.991,"lines":[{"start":24.991,"end":26.601,"text":"Egbe Eko damure nyin,","marked":"Ẹgbẹ́ Ẹ̀kọ́ dàmúrè yín"},{"start":27.051,"end":28.293,"text":"Lati besu jagun;","marked":"Láti bẹ̀ṣù jagun"},{"start":28.743,"end":30.23,"text":"Oko pon pupo n'ilu Oke,","marked":"Oko pọ́n púpọ̀ n'ìlú Òkè"},{"start":30.68,"end":31.606,"text":"Tani yio lo ka?","marked":"Tani yóò lọ ká?"},{"start":32.056,"end":33.18,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"}],"end":33.18},{"key":"4","start":34.13,"lines":[{"start":34.13,"end":35.627,"text":"A ki Baba Aladura","marked":"A kí Baba Aládúrà"},{"start":36.077,"end":37.32,"text":"O ku afojuba","marked":"Ó kú àfojúba"},{"start":37.77,"end":39.452,"text":"Olori ti jagun fun Jesu,","marked":"Olórí ti jagun fún Jésù"},{"start":39.902,"end":41.116,"text":"O si segun Esu.","marked":"Ó sì ṣẹ́gun Èṣù."},{"start":41.566,"end":42.753,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"}],"end":42.753},{"key":"5","start":43.703,"lines":[{"start":43.703,"end":45.673,"text":"Orin Halle, Halleluya","marked":"Orin Halle, Hallelúyà"},{"start":46.123,"end":47.559,"text":"L'awa y'o ko l'orun","marked":"L'àwa y'ó kò l'ọ̀run"},{"start":48.009,"end":49.219,"text":"Nigbat' a ba r'Olugbala,","marked":"Nígbàt a bá r'Olùgbàlà"},{"start":49.669,"end":50.725,"text":"Ni ori ite Re.","marked":"Ní orí ìtẹ́ Rẹ."},{"start":51.175,"end":52.451,"text":"Egbe:  A dupe lowo Olorun...","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":52.901,"end":53.559,"text":"Amin.","marked":"Àmín."}],"end":53.559}]}