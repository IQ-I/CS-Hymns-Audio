{"v":2,"coll":"y","num":53,"id":"hymn_53","title":"'K'E wole f'Oba Ologo","duration":80.613,"voices":{"male":{"file":"y-53-male-v2.m4a","bytes":562904,"sha256":"1831868206318537e174e11c66712cb97b491c4cf2f02c8c7b9b50b6f70360ff","duration":80.7},"female":{"file":"y-53-female-v2.m4a","bytes":580670,"sha256":"d0d336cc48d0575d1832401a81bfc7b4f555693f0309b23bb02cb6dcbca1c9f8","duration":80.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.772,"text":"'K'E wole f'Oba Ologo","marked":"k'é wọlé f'Ọba Ológo"},{"start":2.222,"end":3.398,"text":"Eni O ngbe 'nu imole","marked":"Ẹni Ó ńgbé nu ìmọ́lẹ̀"},{"start":3.848,"end":5.485,"text":"T'oju elese kan ko ri","marked":"T'ojú ẹlẹ́ṣẹ̀ kan kò rí"},{"start":5.935,"end":7.176,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":7.176},{"key":"2","start":8.126,"lines":[{"start":8.126,"end":9.922,"text":"Gbogbo omo Egbe Serafu,","marked":"Gbogbo ọmọ Ẹgbẹ́ Séráfù"},{"start":10.372,"end":11.757,"text":"L'okunrin at'obinrin","marked":"L'ọkùnrin àt'obìnrin"},{"start":12.207,"end":13.78,"text":"K'a ronu ese ti a da,","marked":"K'á ronú ẹ̀ṣẹ̀ tí a dá"},{"start":14.23,"end":15.405,"text":"K'a toro 'dariji.","marked":"K'á tọrọ dáríjì."}],"end":15.405},{"key":"3","start":16.355,"lines":[{"start":16.355,"end":17.732,"text":"B'a ba mo'ra wa l'elese,","marked":"B'á bá mọ̀'rà wá l'ẹlẹ́ṣẹ̀"},{"start":18.182,"end":19.6,"text":"K'a jewo re la je tan,","marked":"K'á jẹ́wọ́ rẹ̀ la jẹ́ tán"},{"start":20.05,"end":21.562,"text":"K'a ronu k'a si pawada,","marked":"K'á ronú k'á sì pàwádà"},{"start":22.012,"end":23.162,"text":"Baba yio dariji.","marked":"Baba yóò dáríjì."}],"end":23.162},{"key":"4","start":24.112,"lines":[{"start":24.112,"end":25.715,"text":"Ese aini 'fe l'o poju","marked":"Ẹsẹ̀ àìní fẹ́ l'ó pọ̀jù"},{"start":26.165,"end":27.482,"text":"Larin wa ba ti kunle","marked":"Lárin wa bá ti kúnlẹ̀"},{"start":27.932,"end":29.67,"text":"Esu l'o ngb' ogun re ti wa","marked":"Èṣù l'ó ńgb ogun rẹ̀ ti wá"},{"start":30.12,"end":31.394,"text":"Baba jo dariji.","marked":"Baba jọ dáríjì."}],"end":31.394},{"key":"5","start":32.344,"lines":[{"start":32.344,"end":33.783,"text":"Ninu 'wa wa ati 'se wa,","marked":"Nínú wa wa àti ṣe wá"},{"start":34.233,"end":35.197,"text":"Ninu oro enu wa,","marked":"Nínú ọ̀rọ̀ ẹnu wa"},{"start":35.647,"end":36.914,"text":"“Nu gigan enikeji wa","marked":"Nù gígan ẹnìkejì wà"},{"start":37.364,"end":38.571,"text":"Dariji, Daniji.","marked":"Dáríjì, Danijì."}],"end":38.571},{"key":"6","start":39.521,"lines":[{"start":39.521,"end":40.971,"text":"Gbogbo wa Iati f'oju ri,","marked":"Gbogbo wa láti f'ojú rí"},{"start":41.421,"end":42.646,"text":"'Wo lo ran 'mole si wa,","marked":"wò ló rán mọ́lẹ̀ sí wa"},{"start":43.096,"end":44.522,"text":"Lati fi ona Re han wa","marked":"Láti fi ọ̀nà Rẹ hàn wá"},{"start":44.972,"end":46.276,"text":"Dariji, Daniji.","marked":"Dáríjì, Danijì."}],"end":46.276},{"key":"7","start":47.226,"lines":[{"start":47.226,"end":48.584,"text":"Bi ko ba se anu Re ni","marked":"Bí kò bá ṣe àánú Rẹ̀ ni"},{"start":49.034,"end":50.423,"text":"Ka to de 'nu 'mole yi","marked":"Ká tó dé nù mọ́lẹ̀ yí"},{"start":50.873,"end":52.472,"text":"Esu ba l'ayo lori wa","marked":"Èṣù bá l'ayọ̀ lórí wa"},{"start":52.922,"end":54.153,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":54.153},{"key":"8","start":55.103,"lines":[{"start":55.103,"end":57.083,"text":"Bi ko ba s'esu t'o ngb'ogun","marked":"Bí kò bá s'eṣú t'ó ńgb'ogun"},{"start":57.533,"end":58.656,"text":"A le f'ibi s'olore,","marked":"A lè f'ibi s'ọlọ́rẹ̀"},{"start":59.106,"end":60.744,"text":"Jowo pa ise esu run","marked":"Jọ̀wọ́ pa iṣẹ́ èṣù run"},{"start":61.194,"end":62.419,"text":"Dariji, Daniji.","marked":"Dáríjì, Danijì."}],"end":62.419},{"key":"9","start":63.369,"lines":[{"start":63.369,"end":65.261,"text":"Wo ti 'ya ti Jesu wa je","marked":"Wò ti yà tí Jésù wá jẹ"},{"start":65.711,"end":66.793,"text":"'Ranti ogun eje Re,","marked":"rántí ogun ẹ̀jẹ̀ Rẹ"},{"start":67.243,"end":68.61,"text":"Nin'ogba Gestesmani","marked":"Nín'ọgbà Gestesmani"},{"start":69.06,"end":70.341,"text":"Dariji, Dariji.","marked":"Dáríjì, Dáríjì."}],"end":70.341},{"key":"10","start":71.291,"lines":[{"start":71.291,"end":72.958,"text":"A dupe p'O ti gbo tiwa","marked":"A dúpẹ́ p'Ó ti gbọ́ tiwa"},{"start":73.408,"end":74.985,"text":"Ma je k'a tun d'ese mo,","marked":"Má jẹ́ k'a tún d'ẹ̀ṣẹ̀ mọ́"},{"start":75.435,"end":77.102,"text":"Tun wa yipada Oiuwa,","marked":"Tún wá yípadà Oíúwa"},{"start":77.552,"end":79.064,"text":"K'a l'ayo l'ojo 'kehin.","marked":"K'á l'ayọ̀ l'ọjọ́ kẹhìn."}],"end":79.064}]}