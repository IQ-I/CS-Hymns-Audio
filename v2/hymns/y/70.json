{"v":2,"coll":"y","num":70,"id":"hymn_70","title":"ELESE wa sodo Jesu","duration":73.38,"voices":{"male":{"file":"y-70-male-v2.m4a","bytes":516147,"sha256":"fb44a779430e68115cc8c88333ed526e0aa81899dc8278db6842e6f131195f09","duration":73.4},"female":{"file":"y-70-female-v2.m4a","bytes":542522,"sha256":"2340262913107287da55b73178b4d5e03e8187591854eb22a290d3f276a6f4cd","duration":73.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.884,"text":"ELESE wa sodo Jesu","marked":"Ẹlẹ́ṣẹ̀ wá sọ́dọ̀ Jésù"},{"start":2.334,"end":3.58,"text":"Fun igbala re lofe","marked":"Fún ìgbàlà rẹ lọ́fẹ́"},{"start":4.03,"end":5.859,"text":"On pe o ni ohun kele","marked":"Òn pé ó ní ohun kẹ́lẹ́"},{"start":6.309,"end":7.625,"text":"Pe omo ma sako mo.","marked":"Pé ọmọ má ṣáko mọ́."}],"end":7.625},{"key":"CHORUS","start":8.575,"lines":[{"start":8.575,"end":10.609,"text":"Kil' ao ro! Kil' ao so?","marked":"Kíl àò rò! Kíl àò sọ?"},{"start":11.059,"end":12.527,"text":"'Gbati Baba ba npe wa,","marked":"gbàtí Baba bá ńpè wá"},{"start":12.977,"end":14.775,"text":"Pe omo, siwo ko ma bo","marked":"Pé ọmọ, ṣíwọ́ kò má bọ̀"},{"start":15.225,"end":16.473,"text":"Wa jihin ise re o.","marked":"Wá jíhìn iṣẹ́ rẹ̀ ọ́."}],"end":16.473},{"key":"2","start":17.423,"lines":[{"start":17.423,"end":19.051,"text":"Elese wa sodo Jesu,","marked":"Ẹlẹ́ṣẹ̀ wá sọ́dọ̀ Jésù"},{"start":19.501,"end":20.629,"text":"Loni lojo igbala","marked":"Lónì lọ́jọ́ ìgbàlà"},{"start":21.079,"end":22.484,"text":"Yara ma si je ko pe ju","marked":"Yára má sì jẹ́ kó pẹ́ jù"},{"start":22.934,"end":24.232,"text":"lye mbe fun o loni.","marked":"lyè mbẹ́ fún ọ lónì."}],"end":24.232},{"key":"3","start":25.182,"lines":[{"start":25.182,"end":26.847,"text":"Serafu damure giri","marked":"Séráfù dàmúrè gírí"},{"start":27.297,"end":28.991,"text":"Kerubu ma jafara,","marked":"Kérúbù má jáfara"},{"start":29.441,"end":30.649,"text":"Opo okan ti se gbe lo,","marked":"Ọ̀pọ̀ ọkàn ti ṣe gbé lọ"},{"start":31.099,"end":32.688,"text":"Wa, e wa s'agbo Jesu.","marked":"Wá, ẹ wá s'àgbò Jésù."}],"end":32.688},{"key":"4","start":33.638,"lines":[{"start":33.638,"end":34.945,"text":"Jesu Olori Egbe wa,","marked":"Jésù Olórí Ẹgbẹ́ wa"},{"start":35.395,"end":36.567,"text":"lfe Re ti sowon to,","marked":"lfẹ́ Rẹ ti ṣọ̀wọ́n tó"},{"start":37.017,"end":38.501,"text":"Ti O da Egbe yi sile","marked":"Tí Ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":38.951,"end":40.409,"text":"Pe k'a le ri igbala.","marked":"Pé k'á lè rí ìgbàlà."}],"end":40.409},{"key":"5","start":41.359,"lines":[{"start":41.359,"end":43.234,"text":"Aje nyonu, oso nyonu","marked":"Ajé ńyọnu, ọ̀ṣọ́ ńyọnu"},{"start":43.684,"end":45.134,"text":"Wa sabe abo Jesu","marked":"Wá sábẹ́ abo Jésù"},{"start":45.584,"end":46.96,"text":"Ohun ibi t'o wuk'o je","marked":"Ohun ibi t'ó wùk'ó jẹ́"},{"start":47.41,"end":48.719,"text":"Wa si egbe Serafu.","marked":"Wá sí ẹgbẹ́ Séráfù."}],"end":48.719},{"key":"6","start":49.669,"lines":[{"start":49.669,"end":50.984,"text":"Elese ronu piwada","marked":"Ẹlẹ́ṣẹ̀ ronú píwàdà"},{"start":51.434,"end":52.668,"text":"Ki akoko to koja","marked":"Kí àkókò tó kọjá"},{"start":53.118,"end":54.46,"text":"Ki metalokan to pe o,","marked":"Kí Mẹ́talọ́kan tó pé ọ́"},{"start":54.91,"end":56.178,"text":"Pe wa siro ise re.","marked":"Pè wá ṣírò iṣẹ́ rẹ."}],"end":56.178},{"key":"7","start":57.128,"lines":[{"start":57.128,"end":58.582,"text":"Ka le gbo nikehin ojo","marked":"Ká lè gbọ́ níkẹhìn ọjọ́"},{"start":59.032,"end":60.245,"text":"Pe o se omo rere","marked":"Pé ó ṣe ọmọ rere"},{"start":60.695,"end":62.201,"text":"Kerubu pelu Serafu","marked":"Kérúbù pẹ̀lú Séráfù"},{"start":62.651,"end":63.874,"text":"Bo s'ayo Oluwa re.","marked":"Bó s'ayọ̀ Olúwa rẹ̀."}],"end":63.874},{"key":"8","start":64.824,"lines":[{"start":64.824,"end":66.082,"text":"Orin Halle Halleluya,","marked":"Orin Halle Hallelúyà"},{"start":66.532,"end":67.737,"text":"L'a o ko ni'te baba","marked":"L'á ò kò ní'tẹ́ Baba"},{"start":68.187,"end":69.819,"text":"'Wo n'iyin at'ope ye fun","marked":"wò n'ìyìn àt'ọpẹ́ yẹ fún"},{"start":70.269,"end":71.831,"text":"Ti t' aiye ainipekun.","marked":"Ti t ayé àìnípẹ̀kun."}],"end":71.831}]}