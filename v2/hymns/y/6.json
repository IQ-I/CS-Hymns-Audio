{"v":2,"coll":"y","num":6,"id":"hymn_6","title":"OLUWA mi, mo njade lo","duration":51.345,"voices":{"male":{"file":"y-6-male-v2.m4a","bytes":353056,"sha256":"dc79d395bc003514f0938c16113cfa2a93419156c6359613b8423fe9aaf47823","duration":51.4},"female":{"file":"y-6-female-v2.m4a","bytes":364848,"sha256":"f557275dac8678e7b4139b620ac8184bd5c1bf65a35f6833fda255d91804c0ef","duration":51.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.091,"text":"OLUWA mi, mo njade lo,","marked":"Olúwa mi, mo ńjáde lọ"},{"start":2.541,"end":3.758,"text":"Lati seise ojo mi,","marked":"Láti ṣẹiṣẹ́ ọjọ́ mi"},{"start":4.208,"end":5.559,"text":"lwo nikan l'emi o mo,","marked":"lwo nìkan l'èmi ó mọ̀"},{"start":6.009,"end":7.887,"text":"L'oro l'ero, ati n'ise.","marked":"L'ọ̀rọ̀ l'èrò, àti n'iṣẹ́."}],"end":7.887},{"key":"2","start":8.837,"lines":[{"start":8.837,"end":10.265,"text":"Ise t'o yan mi l'anu Re","marked":"Iṣẹ́ t'ó yàn mí l'àánú Rẹ̀"},{"start":10.715,"end":12.122,"text":"Jeki nle se tayo tayo","marked":"Jẹ́kí ńlè ṣe tayọ tayọ"},{"start":12.572,"end":13.919,"text":"Ki nroju Re ni ise mi","marked":"Kí ńrojú Rẹ ni iṣẹ́ mi"},{"start":14.369,"end":15.741,"text":"K'emi si le f'ife Re han.","marked":"K'èmi sì lè f'ìfẹ́ Rẹ hàn."}],"end":15.741},{"key":"3","start":16.691,"lines":[{"start":16.691,"end":18.162,"text":"Dabobo mi mi lowo 'danwo","marked":"Dàbòbò mi mí lọ́wọ́ dánwò"},{"start":18.612,"end":20.022,"text":"K ' o pa okan mi mo kuro,","marked":"K ' ó pa ọkàn mi mọ́ kúrò"},{"start":20.472,"end":22.05,"text":"L'owo aniyan aiye yi,","marked":"L'ọ́wọ́ àníyàn ayé yí"},{"start":22.5,"end":23.921,"text":"Ati gbogbo ifekufe.","marked":"Àti gbogbo ìfẹ́kúfẹ́."}],"end":23.921},{"key":"4","start":24.871,"lines":[{"start":24.871,"end":26.109,"text":"lwo t'oju Re r'okan mi,","marked":"lwó t'ojú Rẹ r'ọkàn mi"},{"start":26.559,"end":27.975,"text":"Ma wa low'otun mi titi","marked":"Má wà lọ́w'ọ̀tún mi títí"},{"start":28.425,"end":29.844,"text":"Ki mma sise lo lase Re,","marked":"Kí mmá ṣiṣẹ́ lọ láṣẹ Rẹ"},{"start":30.294,"end":31.593,"text":"Ki nf'ise mi gbogbo fun O.","marked":"Kí ńf'iṣẹ́ mi gbogbo fún Ọ."}],"end":31.593},{"key":"5","start":32.543,"lines":[{"start":32.543,"end":34.244,"text":"Je ki nr'eru Re t'o fuye","marked":"Jẹ́ kí ńr'ẹ̀rù Rẹ t'ó fúyẹ́"},{"start":34.694,"end":36.158,"text":"Ki mma sora nigbagbogbo;","marked":"Kí mmá ṣọ́ra nígbàgbogbo"},{"start":36.608,"end":38.416,"text":"Ki mma f'oju si nkan t'orun","marked":"Kí mmá f'ojú sí nǹkan t'ọ̀run"},{"start":38.866,"end":40.655,"text":"Ki nsi mura d'ojo ogo.","marked":"Kí ńsì múra d'ọjọ́ ògo."}],"end":40.655},{"key":"6","start":41.605,"lines":[{"start":41.605,"end":42.863,"text":"Ohunkohun t'o fi fun mi,","marked":"Ohunkóhun t'ó fi fún mi"},{"start":43.313,"end":44.623,"text":"Jeki nle lo fun ago Re,","marked":"Jẹ́kí ńlè lọ fún àgọ́ Rẹ"},{"start":45.073,"end":46.455,"text":"Ki nf'ayo sure ije mi,","marked":"Kí ńf'ayọ̀ súre ìjẹ mi"},{"start":46.905,"end":48.811,"text":"Ki mba O rin titi d'orun.","marked":"Kí mbá Ó rìn títí d'ọ̀run."},{"start":49.261,"end":49.796,"text":"Amin.","marked":"Àmín."}],"end":49.796}]}