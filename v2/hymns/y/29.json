{"v":2,"coll":"y","num":29,"id":"hymn_29","title":"OLORUN wa orun","duration":46.002,"voices":{"male":{"file":"y-29-male-v2.m4a","bytes":308923,"sha256":"b737f08794a7c5f219e5b3de6caec0f1882062c2fed86d7105e9c254dfaa4040","duration":46.1},"female":{"file":"y-29-female-v2.m4a","bytes":323434,"sha256":"d767709a9411eab75a71218b5adfc6baf4f583a3965d93b81f3c9538e0f39e4f","duration":46.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.2,"text":"OLORUN wa orun,","marked":"Ọlọ́run wá ọ̀run"},{"start":1.65,"end":2.716,"text":"T'o fi ojo mefa","marked":"T'ó fi ọjọ́ mẹ́fà"},{"start":3.166,"end":5.232,"text":"Da nkan gbogbo ti mbe laiye,","marked":"Dá nǹkan gbogbo ti mbẹ̀ láìyẹ"},{"start":5.682,"end":6.996,"text":"Simi nijo keje.","marked":"Ṣimi níjọ́ keje."}],"end":6.996},{"key":"2","start":7.946,"lines":[{"start":7.946,"end":9.276,"text":"O pase k'a bowo","marked":"Ó pàṣẹ k'á bọ̀wọ̀"},{"start":9.726,"end":10.779,"text":"Fun ojo isimi,","marked":"Fún ọjọ́ ìṣímí"},{"start":11.229,"end":12.429,"text":"lbunu Re tobi pupo","marked":"lbùnú Rẹ̀ tóbi púpọ̀"},{"start":12.879,"end":14.546,"text":"S'awon t'o o rufin yi.","marked":"S'àwọn t'ó ò rùfin yí."}],"end":14.546},{"key":"3","start":15.496,"lines":[{"start":15.496,"end":16.531,"text":"Awon baba nla wa","marked":"Àwọn Baba ńlá wa"},{"start":16.981,"end":18.095,"text":"Ti ku nin'okunkun;","marked":"Ti kú nín'òkùnkùn"},{"start":18.545,"end":20.063,"text":"Nwon je ogbo aborisa","marked":"Wọ́n jẹ́ ọ̀gbọ̀ abọ̀rìṣà"},{"start":20.513,"end":21.819,"text":"Nwon ko mo ofin Re.","marked":"Wọ́n kò mọ òfin Rẹ̀."}],"end":21.819},{"key":"4","start":22.769,"lines":[{"start":22.769,"end":23.969,"text":"Awa de, Oluwa","marked":"Àwa dé, Olúwa"},{"start":24.419,"end":25.517,"text":"Gege bi ase Re,","marked":"Gẹ́gẹ́ bí àṣẹ Rẹ"},{"start":25.967,"end":27.442,"text":"Lehin ise ijo mefa,","marked":"Lẹ́hìn iṣẹ́ ìjọ mẹ́fà"},{"start":27.892,"end":29.23,"text":"Lati se ife Re.","marked":"Láti ṣe ìfẹ́ Rẹ."}],"end":29.23},{"key":"5","start":30.18,"lines":[{"start":30.18,"end":31.207,"text":"Mimo l'ojo oni,","marked":"Mímọ́ l'ọjọ́ òní"},{"start":31.657,"end":32.733,"text":"O ye ki a simi","marked":"Ó yẹ kí a ṣímí"},{"start":33.183,"end":34.41,"text":"K'a pejo ninu ile Re","marked":"K'á péjọ nínú ilé Rẹ"},{"start":34.86,"end":35.925,"text":"K'a gbo 'ro mimo Re.","marked":"K'á gbọ́ rọ mímọ́ Rẹ̀."}],"end":35.925},{"key":"6","start":36.875,"lines":[{"start":36.875,"end":38.258,"text":"Isimi nla kan ku","marked":"Ìṣímí ńlá kan kú"},{"start":38.708,"end":39.646,"text":"F'awon enia Re,","marked":"F'àwọn ẹnìà Rẹ"},{"start":40.096,"end":41.803,"text":"Om'Olorun, Alabukun","marked":"Ọm'ọlọ́run, Alábùkún"},{"start":42.253,"end":43.359,"text":"Mu wa de 'simi re!","marked":"Mú wa dé ṣímí rẹ!"},{"start":43.809,"end":44.453,"text":"Amin.","marked":"Àmín."}],"end":44.453}]}