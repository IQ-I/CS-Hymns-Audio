{"v":2,"coll":"y","num":12,"id":"hymn_12","title":"JESU, bukun wa k'a to lo","duration":66.589,"voices":{"male":{"file":"y-12-male-v2.m4a","bytes":474321,"sha256":"17f81ebd1883a69252df7656a5d8a7fe6c5819979c9ad9fe486565ec4ea35495","duration":66.6},"female":{"file":"y-12-female-v2.m4a","bytes":495988,"sha256":"ad737b3c9696c9ccfcba208ad2cff4c8d5cbeb5adbe1010df29ca26caea6ceab","duration":66.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.101,"text":"JESU, bukun wa k'a to lo","marked":"Jésù, bùkún wa k'á tó lọ"},{"start":2.551,"end":3.847,"text":"Gbin oro Re si okan wa;","marked":"Gbin ọ̀rọ̀ Rẹ sí ọkàn wa"},{"start":4.297,"end":5.949,"text":"K'o si mu k'ife gbigbona","marked":"K'ó sì mú k'ìfẹ́ gbígbóná"},{"start":6.399,"end":7.441,"text":"Kun okan ilowowo wa,","marked":"Kún ọkàn ìlọ́wọ́wọ́ wa"},{"start":7.891,"end":9.562,"text":"Egbe:  Nigba iye at'iku wa","marked":"Nígbà iye àt'ikú wà"},{"start":10.012,"end":12.397,"text":"Jesu, jare se' mole wa.","marked":"Jésù, jàre ṣe mọ́lẹ̀ wá."}],"end":12.397},{"key":"2","start":13.347,"lines":[{"start":13.347,"end":15.256,"text":"Ile ti su, orunti wo,","marked":"Ilẹ̀ ti ṣú, ọ̀runtí wò"},{"start":15.706,"end":17.23,"text":"'Wo si ti siro iwa wa","marked":"wo sì ti ṣírò ìwà wa"},{"start":17.68,"end":19.081,"text":"Die n'isegun wa loni","marked":"Díẹ̀ n'ìṣẹ́gun wa lónì"},{"start":19.531,"end":20.824,"text":"Isubu wa lo papoju","marked":"Ìṣubú wa lọ pàpọ̀jù"},{"start":21.274,"end":22.713,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":22.713},{"key":"3","start":23.663,"lines":[{"start":23.663,"end":25.415,"text":"Jesu dariji wa: fun wa","marked":"Jésù dáríjì wá: fún wa"},{"start":25.865,"end":27.412,"text":"L'ayo ati eru mimo","marked":"L'ayọ̀ àti ẹrú mímọ́"},{"start":27.862,"end":29.491,"text":"At'okan ti ko l'abawon","marked":"Àt'ọkàn tí kò l'àbàwọ́n"},{"start":29.941,"end":31.392,"text":"K'a ba le jo O l'ajotan:","marked":"K'á bá lè jọ Ọ́ l'àjọtán"},{"start":31.842,"end":33.018,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":33.018},{"key":"4","start":33.968,"lines":[{"start":33.968,"end":35.416,"text":"Lala dun 'tor Iwo se ri","marked":"Lálà dùn tọ́r Ìwọ ṣe rí"},{"start":35.866,"end":37.769,"text":"Aniyan fere, O se ri:","marked":"Àníyàn fèrè, Ó ṣe rí"},{"start":38.219,"end":39.937,"text":"Ma je k'a gbo t'ara nikan","marked":"Má jẹ́ k'á gbọ́ t'ara nìkan"},{"start":40.387,"end":41.813,"text":"K'a ma bo sinu idanwo,","marked":"K'á má bọ́ sínú ìdánwò"},{"start":42.263,"end":43.32,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":43.32},{"key":"5","start":44.27,"lines":[{"start":44.27,"end":45.599,"text":"A mbe O f'awon alaini,","marked":"A mbẹ́ Ọ f'àwọn aláìní"},{"start":46.049,"end":48.005,"text":"F'elese at' awon t'a fe,","marked":"F'ẹlẹ́ṣẹ̀ àt àwọn t'á fẹ́"},{"start":48.455,"end":49.756,"text":"Je ki anu Re mu wa yo,","marked":"Jẹ́ kí àánú Rẹ mú wa yọ̀"},{"start":50.206,"end":52.303,"text":"'Wo Jesu, l'ohun gbogbo wa,","marked":"wò Jésù, l'ohun gbogbo wa"},{"start":52.753,"end":53.984,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"}],"end":53.984},{"key":"6","start":54.934,"lines":[{"start":54.934,"end":57.012,"text":"Jesu, bukun wa, - ile su;","marked":"Jésù, bùkún wá, ilẹ̀ ṣú"},{"start":57.462,"end":58.761,"text":"Tikalare wa ba wa gbe","marked":"Tìkáláre wa bá wa gbé"},{"start":59.211,"end":60.562,"text":"Angeli rere nso ile wa;","marked":"Áńgẹ́lì rere ńṣọ́ ilé wa"},{"start":61.012,"end":62.474,"text":"A tun f'ojo kan sunmo O","marked":"A tún f'ọjọ́ kan súnmọ́ Ọ"},{"start":62.924,"end":64.002,"text":"Egbe:  Nigba iye ati...","marked":"Nígbà ìyè àti"},{"start":64.452,"end":65.04,"text":"Amin.","marked":"Àmín."}],"end":65.04}]}