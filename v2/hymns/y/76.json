{"v":2,"coll":"y","num":76,"id":"hymn_76","title":"WA, Parakliti Mimo,","duration":61.543,"voices":{"male":{"file":"y-76-male-v2.m4a","bytes":415412,"sha256":"c32bda923edac20667e03728cb2ea08c3ffe8c0397a798e20d06afdc4b7157c4","duration":61.6},"female":{"file":"y-76-female-v2.m4a","bytes":426526,"sha256":"f0f3cb7225fe038c6cb511d4d8807999a70af211aebd8525db67da29fe7e8f91","duration":61.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.101,"text":"WA, Parakliti Mimo,","marked":"Wá, Parakliti Mímọ́"},{"start":2.551,"end":4.363,"text":"Lat'ibugbe Re, Orun,","marked":"Lát'ibùgbé Rẹ, Ọ̀run"},{"start":4.813,"end":6.005,"text":"Ran itansan 'mole wa.","marked":"Rán ìtànṣán mọ́lẹ̀ wá."}],"end":6.005},{"key":"2","start":6.955,"lines":[{"start":6.955,"end":8.659,"text":"Baba talaka, wa 'hin","marked":"Baba tálákà, wá hín"},{"start":9.109,"end":10.263,"text":"Olufunni l'ebun wa,","marked":"Olùfúnni l'ẹ̀bùn wà"},{"start":10.713,"end":12.222,"text":"Imole okan jo wa.","marked":"Ìmọ́lẹ̀ ọkàn jọ wá."}],"end":12.222},{"key":"3","start":13.172,"lines":[{"start":13.172,"end":14.359,"text":"Baba Olutunu wa","marked":"Baba Olùtùnú wa"},{"start":14.809,"end":15.943,"text":"Alejo toro f 'okan,","marked":"Àlejò tọ́rọ̀ f ọkàn"},{"start":16.393,"end":17.933,"text":"Pelu itura-Re wa.","marked":"Pẹ̀lú itura-re wà."}],"end":17.933},{"key":"4","start":18.883,"lines":[{"start":18.883,"end":20.244,"text":"'Wo n'isimi n'nu lala","marked":"wò n'ìṣímí n'nú lala"},{"start":20.694,"end":22.085,"text":"lboji ninu orun,","marked":"lbojì nínú ọ̀run"},{"start":22.535,"end":23.893,"text":"ltunu ninu 'ponju.","marked":"ltùnú nínú pọ́njú."}],"end":23.893},{"key":"5","start":24.843,"lines":[{"start":24.843,"end":26.235,"text":"'Wo 'mole t'o mo gara","marked":"wò mọ́lẹ̀ t'ó mọ́ gara"},{"start":26.685,"end":27.769,"text":"Tan sinu aiya awon;","marked":"Tán sínú àìyá àwọn"},{"start":28.219,"end":29.25,"text":"Enia Re oloto.","marked":"Ẹníà Rẹ̀ ọlọ́tọ̀."}],"end":29.25},{"key":"6","start":30.2,"lines":[{"start":30.2,"end":31.759,"text":"L'aisi Re kil'eda je?","marked":"L'àìsí Rẹ kíl'ẹ̀dà jẹ́?"},{"start":32.209,"end":33.586,"text":"Ise at'ero Mimo,","marked":"Iṣẹ́ àt'ẹ̀rọ Mímọ́"},{"start":34.036,"end":35.484,"text":"Lat'odo Re wa ni won.","marked":"Lát'ọ̀dọ̀ Rẹ̀ wà ni wọ́n."}],"end":35.484},{"key":"7","start":36.434,"lines":[{"start":36.434,"end":37.79,"text":"Eleri, so di mimo,","marked":"Ẹlẹ́rí, sọ di mímọ́"},{"start":38.24,"end":39.65,"text":"Agbogbe masai wo san,","marked":"Agbogbe masai wò sàn"},{"start":40.1,"end":41.636,"text":"Alaileso mu s'eso.","marked":"Aláìléso mú s'èṣọ́."}],"end":41.636},{"key":"8","start":42.586,"lines":[{"start":42.586,"end":43.871,"text":"Mu okan tutu gbona","marked":"Mú ọkàn tútù gbóná"},{"start":44.321,"end":45.435,"text":"M'alagidi teriba,","marked":"M'alágídí tẹríba"},{"start":45.885,"end":47.622,"text":"Fa asako wa jeje.","marked":"Fa àṣàkò wà jẹ́jẹ́."}],"end":47.622},{"key":"9","start":48.572,"lines":[{"start":48.572,"end":49.85,"text":"F'emi 'jinle Re meje,","marked":"F'ẹ̀mí jinlẹ̀ Rẹ méje"},{"start":50.3,"end":51.332,"text":"Kun awon oloto Re,","marked":"Kún àwọn ọlọ́tọ̀ Rẹ"},{"start":51.782,"end":53.164,"text":"F'agbara Re s'abo won.","marked":"F'agbára Rẹ̀ s'abo wọn."}],"end":53.164},{"key":"10","start":54.114,"lines":[{"start":54.114,"end":55.223,"text":"Ran or'ofe Re sihin,","marked":"Rán ọr'ọ̀fẹ́ Rẹ síhìn"},{"start":55.673,"end":57.094,"text":"Ekun igbala laiye,","marked":"Ẹkún ìgbàlà láìyẹ"},{"start":57.544,"end":58.932,"text":"At'alafia l'orun.","marked":"Àt'àlàfíà l'ọ̀run."},{"start":59.382,"end":59.994,"text":"Amin.","marked":"Àmín."}],"end":59.994}]}