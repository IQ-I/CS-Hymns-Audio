{"v":2,"coll":"y","num":22,"id":"hymn_22","title":"JESU, a w'odo Re","duration":25.758,"voices":{"male":{"file":"y-22-male-v2.m4a","bytes":179088,"sha256":"a45ff2151e1280a5290b12565456e13b61fa903d2d2a1355fb26ebc720228adb","duration":25.8},"female":{"file":"y-22-female-v2.m4a","bytes":184622,"sha256":"3d4e597bb5e6e4877ef7e617e439c9a7058d2063be6e73c4316e665bf6d92b4d","duration":25.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.479,"text":"JESU, a w'odo Re","marked":"Jésù, a w'ọ̀dọ̀ Rẹ"},{"start":2.929,"end":4.079,"text":"L'Ojo Re mimo yi,","marked":"L'Ọjọ́ Rẹ mímọ́ yí"},{"start":4.529,"end":5.875,"text":"To wa bi awa ti pejo","marked":"Tó wá bí àwa ti péjọ"},{"start":6.325,"end":7.81,"text":"Si ko wa fun 'ra Re.","marked":"Sì kó wá fún ra Rẹ."}],"end":7.81},{"key":"2","start":8.76,"lines":[{"start":8.76,"end":9.961,"text":"Dari ese ji wa,","marked":"Dárí ẹ̀ṣẹ̀ jì wá"},{"start":10.411,"end":11.527,"text":"Fun wa l'Emi Mimo","marked":"Fún wa l'Ẹ̀mí Mímọ́"},{"start":11.977,"end":13.446,"text":"Ko wa k'ihin je ibere","marked":"Kò wá k'ìhín jẹ́ ìbẹ̀rẹ̀"},{"start":13.896,"end":15.316,"text":"Aiye ti ko l'opin.","marked":"Ayé tí kò l'òpin."}],"end":15.316},{"key":"3","start":16.266,"lines":[{"start":16.266,"end":17.693,"text":"F'ife kun aiya wa,","marked":"F'ìfẹ́ kún àìyá wa"},{"start":18.143,"end":19.403,"text":"Gba 'se oluko wa;","marked":"Gbà ṣe olùkọ́ wa"},{"start":19.853,"end":21.395,"text":"K'awa at' awon le pade","marked":"K'àwa àt àwọn lè pàdé"},{"start":21.845,"end":23.1,"text":"Niwaju Re l'oke.","marked":"Níwájú Rẹ l'òkè."},{"start":23.55,"end":24.208,"text":"Amin.","marked":"Àmín."}],"end":24.208}]}