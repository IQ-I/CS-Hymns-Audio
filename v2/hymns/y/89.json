{"v":2,"coll":"y","num":89,"id":"hymn_89","title":"EYIN Egbe Igbala | Eyin Ijo Igbala Je Ka Yin Oba Ogo","duration":29.752,"voices":{"male":{"file":"y-89-male-v2.m4a","bytes":200486,"sha256":"a0b52b2615206edc9e8b272638e29312606832ad556f1032499891bc5bdab5df","duration":29.8},"female":{"file":"y-89-female-v2.m4a","bytes":208040,"sha256":"e4546120215589ce9e4cecc56ccf30af751c2254cd9f611b6d7c1d08f186ec70","duration":29.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.395,"text":"ENYIN Egbę Igbala","marked":"Ẹ̀yin Ègbẹ́ Ìgbàlà"},{"start":1.845,"end":3.025,"text":"Je k'a yin oba Ogo,","marked":"Jẹ́ k'á yin ọba Ògo"},{"start":3.475,"end":4.775,"text":"T'o da wa si di oni,","marked":"T'ó dá wa sì di òní"},{"start":5.225,"end":6.422,"text":"T'iparun ko ba wa.","marked":"T'ìparun kò bá wà."}],"end":6.422},{"key":"CHORUS","start":7.372,"lines":[{"start":7.372,"end":8.151,"text":"Yin Oluwa, (2ce)","marked":"Yín Olúwa"},{"start":8.601,"end":10.275,"text":"Kerubu, Serafu,","marked":"Kérúbù, Séráfù"},{"start":10.725,"end":12.138,"text":"Enyin agbaiye dide,","marked":"Ẹ̀yin àgbàìyẹ́ dìde"},{"start":12.588,"end":13.887,"text":"K'a yin oba Ogo.","marked":"K'á yin ọba Ògo."}],"end":13.887},{"key":"2","start":14.837,"lines":[{"start":14.837,"end":16.052,"text":"Onigbagbo agbaiye,","marked":"Onígbàgbọ́ àgbáìyè"},{"start":16.502,"end":17.861,"text":"Imale gbogb❜aiye","marked":"Ìmàlẹ̀ gbogb'àìyè"},{"start":18.311,"end":19.673,"text":"Ati Keferi agbaiye","marked":"Àti Kèfèrí àgbáìyè"},{"start":20.123,"end":21.351,"text":"Ę wa k'a yin Oluwa","marked":"Ẹ wá k'á yin Olúwa"}],"end":21.351},{"key":"3","start":22.301,"lines":[{"start":22.301,"end":23.44,"text":"Emi Adaba Orun","marked":"Ẹ̀mí Àdàbà Ọ̀run"},{"start":23.89,"end":24.905,"text":"Șe 'le Rę ninu wa,","marked":"Ṣe lé Rẹ̀ nínú wa"},{"start":25.355,"end":26.587,"text":"'Fun wa l'okun lera","marked":"fún wa l'okùn léra"},{"start":27.037,"end":28.203,"text":"Lati yin Olorun.","marked":"Láti yin Ọlọ́run."}],"end":28.203}]}