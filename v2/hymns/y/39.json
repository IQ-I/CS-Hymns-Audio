{"v":2,"coll":"y","num":39,"id":"hymn_39","title":"K'OJO 'simi yi to tan","duration":40.948,"voices":{"male":{"file":"y-39-male-v2.m4a","bytes":276482,"sha256":"02ef1a859048f2b8b525cfe77515860101bd952fd74da8df550b8cd442c018c8","duration":41.0},"female":{"file":"y-39-female-v2.m4a","bytes":285642,"sha256":"4de0a52db755721650c32602786a13fbf2a509867fdfeccfc3dfc24ded80ca8e","duration":41.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.912,"text":"K'OJO 'simi yi to tan","marked":"K'ọjọ́ ṣímí yí tó tán"},{"start":2.362,"end":3.874,"text":"K' a to lo f'ara le 'le,","marked":"K a tó lọ f'ara lé lé"},{"start":4.324,"end":5.501,"text":"Awa wole l'ese Re,","marked":"Àwa wọlé l'ẹsẹ̀ Rẹ"},{"start":5.951,"end":7.118,"text":"A nkorin iyin si O.","marked":"A ńkọrin ìyìn sí Ọ."}],"end":7.118},{"key":"2","start":8.068,"lines":[{"start":8.068,"end":9.259,"text":"Fun anu ojo oni,","marked":"Fún àánú ọjọ́ òní"},{"start":9.709,"end":10.897,"text":"Fun isimi Iona wa,","marked":"Fún ìṣimi lọ́nà wa"},{"start":11.347,"end":12.721,"text":"'Wo nikan l'a f'ope fun","marked":"wò nìkan l'á f'ọpẹ́ fún"},{"start":13.171,"end":14.561,"text":"Oluwa at'oba wa.","marked":"Olúwa àt'ọba wa."}],"end":14.561},{"key":"3","start":15.511,"lines":[{"start":15.511,"end":17.109,"text":"lsin wa ko nilari","marked":"lsin wa kò nílárí"},{"start":17.559,"end":18.752,"text":"Adura wa lu m'ese","marked":"Àdúrà wa lu m'ẹsẹ̀"},{"start":19.202,"end":20.738,"text":"Sugbon 'Wo l'o nf'ese ji,","marked":"Ṣùgbọ́n wò l'ó ńf'ẹsẹ̀ jí"},{"start":21.188,"end":22.545,"text":"Or'ofe Re to fun wa.","marked":"Ọ̀r'ọ̀fẹ́ Rẹ̀ tó fún wa."}],"end":22.545},{"key":"4","start":23.495,"lines":[{"start":23.495,"end":24.73,"text":"Je k'ife Re ma to wa","marked":"Jẹ́ k'ìfẹ́ Rẹ má tó wá"},{"start":25.18,"end":26.581,"text":"B'a ti nrin 'na aiye yi:'","marked":"B'á ti ńrìn ná ayé yi:"},{"start":27.031,"end":28.502,"text":"Nigbat'ajo wa ba pin","marked":"Nígbàt'àjọ wa bá pín"},{"start":28.952,"end":30.457,"text":"K'a le simi lodo Re.","marked":"K'á lè ṣímí lọ́dọ̀ Rẹ."}],"end":30.457},{"key":"5","start":31.407,"lines":[{"start":31.407,"end":32.905,"text":"K'ojo 'simi wonyi je","marked":"K'ọjọ́ ṣímì wọ̀nyí jẹ́"},{"start":33.355,"end":34.268,"text":"lbere ayo orun;","marked":"lbẹ̀rẹ̀ ayọ̀ ọ̀run"},{"start":34.718,"end":36.146,"text":"B'a ti nrin ajo wa lo,","marked":"B'á ti ńrìn àjò wa lọ"},{"start":36.596,"end":38.347,"text":"S'isimi ti ko l'opin.","marked":"S'ìṣimi tí kò l'òpin."},{"start":38.797,"end":39.399,"text":"Amin.","marked":"Àmín."}],"end":39.399}]}