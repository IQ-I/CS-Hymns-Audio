{"v":2,"coll":"y","num":64,"id":"hymn_64","title":"'BUKUN ni f'awon mimo","duration":59.806,"voices":{"male":{"file":"y-64-male-v2.m4a","bytes":419230,"sha256":"2ca61b35023d6862c4a0bf167571e778401b15dd35b451627c7c1ce5f5239a30","duration":59.9},"female":{"file":"y-64-female-v2.m4a","bytes":434270,"sha256":"6e21ad32080a3f616aab08e94970eddfbf2d2398827e125816d164c8d1442985","duration":59.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.672,"text":"'BUKUN ni f'awon mimo","marked":"bùkún ni f'àwọn mímọ́"},{"start":2.122,"end":3.296,"text":"Won ti ko 'se angeli","marked":"Wọ́n tí kò ṣe áńgẹ́lì"},{"start":3.746,"end":4.879,"text":"Orun n'ife okan won","marked":"Ọ̀run n'ìfẹ́ ọkàn wọn"},{"start":5.329,"end":6.842,"text":"Won fe lati r'Olorun","marked":"Wọ́n fẹ́ láti r'Ọlọ́run"},{"start":7.292,"end":8.356,"text":"A we abawon won nu","marked":"A wẹ àbàwọ́n wọn nù"},{"start":8.806,"end":10.097,"text":"Won n'idapo pelu Re","marked":"Wọ́n n'ìdàpọ̀ pẹ̀lú Rẹ"},{"start":10.547,"end":11.588,"text":"Won dabi Oluwa won","marked":"Wọ́n dàbí Olúwa wọn"},{"start":12.038,"end":13.414,"text":"Ti ise ere nla fun won.","marked":"Tí iṣẹ́ ère ńlá fún wọn."}],"end":13.414},{"key":"2","start":14.364,"lines":[{"start":14.364,"end":15.806,"text":"Won n'josin ninu emi","marked":"Wọ́n n'jọ̀sìn nínú èmi"},{"start":16.256,"end":17.487,"text":"Won wole ni'bi'te Re","marked":"Wọ́n wọlé ní'bí'tẹ́ Rẹ"},{"start":17.937,"end":19.2,"text":"Won te ba nib'imole","marked":"Wọ́n tẹ̀ bá níb'ìmọ́lẹ̀"},{"start":19.65,"end":20.596,"text":"lmole Olorun tan","marked":"lmọ́lẹ̀ Ọlọ́run tán"},{"start":21.046,"end":21.972,"text":"Awon olokan-riro","marked":"Àwọn olokan-riro"},{"start":22.422,"end":23.972,"text":"Ti won fe lati kekoo","marked":"Tí wọ́n fẹ́ láti kẹ́kọ̀ọ́"},{"start":24.422,"end":25.94,"text":"Won wa inu Oro naa","marked":"Wọ́n wá inú Ọ̀rọ̀ náà"},{"start":26.39,"end":27.913,"text":"Titi won fi gb'ohun Re.","marked":"Títí wọ́n fi gb'ohùn Rẹ."}],"end":27.913},{"key":"3","start":28.863,"lines":[{"start":28.863,"end":30.094,"text":"Oun ni Eleda won","marked":"Òun ni Ẹlẹ́dàá wọn"},{"start":30.544,"end":32.039,"text":"Won ba Oun nikan soro","marked":"Wọ́n bá Òun nìkan sọ̀rọ̀"},{"start":32.489,"end":33.978,"text":"Lat'ooro di asale","marked":"Lát'ooro di aṣálẹ̀"},{"start":34.428,"end":36.009,"text":"Ni won nyin l'Ojo 'sinmi","marked":"Ni wọ́n yín l'Ọjọ́ sinmi"},{"start":36.459,"end":38.07,"text":"Won di Ii mu ninu laalaa","marked":"Wọ́n di Ìí mú nínú làálàá"},{"start":38.52,"end":39.954,"text":"Won gbekele e n'nu 'ponju","marked":"Wọ́n gbẹ́kẹ̀lé e n'nú pọ́njú"},{"start":40.404,"end":41.621,"text":"lmole Re n tan n'nu won","marked":"lmọ́lẹ̀ Rẹ̀ ń tan n'nù wọn"},{"start":42.071,"end":43.387,"text":"Ayida ko bori re.","marked":"Àyídà kò borí rẹ̀."}],"end":43.387},{"key":"4","start":44.337,"lines":[{"start":44.337,"end":45.596,"text":"Oun ni won n yin l'aye won","marked":"Òun ni wọ́n ń yìn l'ayé wọn"},{"start":46.046,"end":47.186,"text":"Won ki yoo ri iku mo","marked":"Wọn kì yóò rí ikú mọ́"},{"start":47.636,"end":48.957,"text":"Won yoo maa b'Oluwa gbe","marked":"Wọn yóò máa b'Olúwa gbé"},{"start":49.407,"end":50.873,"text":"Titi won yoo fi jinde","marked":"Títí wọn yóò fi jíǹde"},{"start":51.323,"end":52.566,"text":"Won yoo sunmo Oluwa","marked":"Wọn yóò súnmọ́ Olúwa"},{"start":53.016,"end":54.289,"text":"Pelu ara ajinde","marked":"Pẹ̀lú ara àjíǹde"},{"start":54.739,"end":56.059,"text":"Pelu Baba n'nu Omo","marked":"Pẹ̀lú Baba n'nú Ọmọ"},{"start":56.509,"end":58.257,"text":"At'Emi, metalokan.","marked":"Àt'ẹ̀mí, Mẹ́talọ́kan."}],"end":58.257}]}