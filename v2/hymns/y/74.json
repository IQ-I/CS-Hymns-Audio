{"v":2,"coll":"y","num":74,"id":"hymn_74","title":"BABA niwaju ite Re","duration":46.54,"voices":{"male":{"file":"y-74-male-v2.m4a","bytes":332561,"sha256":"454f9d4a3522a47e9cbbd8c67a9b0bcd2026d1efbcc310361e1831a0a4a7d549","duration":46.6},"female":{"file":"y-74-female-v2.m4a","bytes":348501,"sha256":"af1c80bf75f2f0d74f501403a4688245cbc771f1d9eb8528bf61aa7c9c0c1d64","duration":46.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.54,"text":"BABA niwaju ite Re,","marked":"Baba níwájú ìtẹ́ Rẹ"},{"start":1.99,"end":3.095,"text":"L'Angeli nteriba,","marked":"L'Áńgẹ́lì ńtẹríba"},{"start":3.545,"end":4.827,"text":"Nigbagbo niwaju Re,","marked":"Nígbàgbọ́ níwájú Rẹ"},{"start":5.277,"end":6.482,"text":"Ni nwon nkorin iyin,","marked":"Ní wọ́n ńkọrin ìyìn"},{"start":6.932,"end":8.56,"text":"Nwon si nfi ade wura won,","marked":"Wọ́n sì ńfi adé wúrà wọn"},{"start":9.01,"end":10.272,"text":"Lele y'ite na ka","marked":"Lélẹ̀ y'ìtẹ́ ná ká"},{"start":10.722,"end":12.075,"text":"Nwon nfi ohun pelu duru,","marked":"Wọ́n ńfi ohun pẹ̀lú dùrù"},{"start":12.525,"end":13.619,"text":"Korin si Oluwa.","marked":"Kọrin sí Olúwa."}],"end":13.619},{"key":"2","start":14.569,"lines":[{"start":14.569,"end":16.331,"text":"Didan osumare si ntan","marked":"Dídán òṣùmàrè sí ńtán"},{"start":16.781,"end":17.889,"text":"Si ara iye won,","marked":"Sí ara ìyè wọn"},{"start":18.339,"end":20.406,"text":"Bi Seraf ti nke si Seraf'","marked":"Bí Seraf ti ńké sí Seraf"},{"start":20.856,"end":22.053,"text":"Ti nwon korin 'yin Re.","marked":"Ti wọ́n kọrin yín Rẹ."},{"start":22.503,"end":23.818,"text":"Bi a ti kunle nihinyi,","marked":"Bí a ti kúnlẹ̀ níhìnyí"},{"start":24.268,"end":25.275,"text":"Ran ore Re si wa,","marked":"Rán ọrẹ Rẹ sí wa"},{"start":25.725,"end":27.412,"text":"Ka mo pe 'Wo wa nitosi","marked":"Ká mọ̀ pé wò wà nítòsí"},{"start":27.862,"end":29.235,"text":"Lati da wa l'ohun.","marked":"Láti dá wa l'ohun."}],"end":29.235},{"key":"3","start":30.185,"lines":[{"start":30.185,"end":31.503,"text":"Nihin nibit'awon Angeli","marked":"Níhìn níbit'àwọn Áńgẹ́lì"},{"start":31.953,"end":33.824,"text":"Nwo wa, ba ti nsin O,","marked":"Ǹwo wá, bá ti ńṣin Ọ"},{"start":34.274,"end":36.037,"text":"Ko wa k'a wa ile orun,","marked":"Kò wá k'á wá ilé ọ̀run"},{"start":36.487,"end":37.606,"text":"K'a sin O bi ti won","marked":"K'á sin Ọ́ bí tí wọ́n"},{"start":38.056,"end":39.401,"text":"K'a ba won ko orin iyin,","marked":"K'á bá wọn kọ orin ìyìn"},{"start":39.851,"end":40.974,"text":"K'a ba won mo 'fe Re,","marked":"K'á bá wọn mọ́ fẹ́ Rẹ"},{"start":41.424,"end":42.921,"text":"Titi agbara y'o fi di","marked":"Títí agbára y'ó fi di"},{"start":43.371,"end":44.99,"text":"Tire, Tire nikan.","marked":"Tirẹ̀, Tirẹ̀ nìkan."}],"end":44.99}]}