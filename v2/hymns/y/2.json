{"v":2,"coll":"y","num":2,"id":"hymn_2","title":"Mo ji, Mo ji, Ogun orun","duration":35.315,"voices":{"male":{"file":"y-2-male-v2.m4a","bytes":246725,"sha256":"5745aba50a89ab21e5b75bcbba548cdf37bdc6e8a217e53e991f801a5b8c7e6c","duration":35.4},"female":{"file":"y-2-female-v2.m4a","bytes":251173,"sha256":"cfc975271f047ee77d4e56e9443579bbbd5a60c5744efd4684aea07b5d1bd189","duration":35.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.487,"text":"Mo ji, Mo ji, Ogun orun","marked":"Mo jí, Mo jí, Ogun ọ̀run"},{"start":2.937,"end":4.45,"text":"K'emi l'agbara bi ti nyin","marked":"K'èmi l'agbára bí ti yín"},{"start":4.9,"end":6.16,"text":"K'emi ba le lo ojo mi","marked":"K'èmi bá lè lo ọjọ́ mi"},{"start":6.61,"end":7.826,"text":"Fun iyin Olugbala mi.","marked":"Fún ìyìn Olùgbàlà mi."}],"end":7.826},{"key":"2","start":8.776,"lines":[{"start":8.776,"end":10.397,"text":"Ogo fun Eru' o so mi","marked":"Ògo fún Ẹ̀rù ó sọ mí"},{"start":10.847,"end":12.201,"text":"To tu mi lara loju Orun","marked":"Tó tú mi lára lójú Ọ̀run"},{"start":12.651,"end":14.095,"text":"Oluwa ijo mo ba ku","marked":"Olúwa ìjọ mo bá kú"},{"start":14.545,"end":16.114,"text":"Ji mi s'iye ainipekun.","marked":"Jí mi s'ìyẹ́ àìnípẹ̀kun."}],"end":16.114},{"key":"3","start":17.064,"lines":[{"start":17.064,"end":18.486,"text":"Oluwa mo tun eje je","marked":"Olúwa mo tún ẹ̀jẹ̀ jẹ"},{"start":18.936,"end":20.512,"text":"Tu ese ka b'iri oro","marked":"Tú ẹsẹ̀ ká b'ìrì ọ̀rọ̀"},{"start":20.962,"end":22.359,"text":"So akoronu mi oni","marked":"Sọ akọ̀rọ́nú mi òní"},{"start":22.809,"end":24.628,"text":"Si f'Emi Re kun inu mi.","marked":"Sì f'Ẹ̀mí Rẹ kún inú mi."}],"end":24.628},{"key":"4","start":25.578,"lines":[{"start":25.578,"end":26.919,"text":"Oro at'ise mi oni","marked":"Ọ̀rọ̀ àt'iṣẹ́ mi òní"},{"start":27.369,"end":28.884,"text":"Ki nwon le re bi eko Re","marked":"Kí wọ́n lè rẹ̀ bí ẹ̀kọ́ Rẹ"},{"start":29.334,"end":30.737,"text":"K'emi si f'ipa mi gbogbo","marked":"K'èmi sì f'ipá mi gbogbo"},{"start":31.187,"end":32.635,"text":"Sise rere fun Ogo Re.","marked":"Ṣíṣe rere fún Ògo Rẹ."},{"start":33.085,"end":33.766,"text":"Amin.","marked":"Àmín."}],"end":33.766}]}