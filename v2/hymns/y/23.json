{"v":2,"coll":"y","num":23,"id":"hymn_23","title":"K'AWA to pari eko wa","duration":26.556,"voices":{"male":{"file":"y-23-male-v2.m4a","bytes":179177,"sha256":"8280fffee98bf0e785cde88ef4f7cbb6a464366759a81d556f07b11794f191b7","duration":26.6},"female":{"file":"y-23-female-v2.m4a","bytes":186322,"sha256":"da6074eda8188e2ee612f6d4018e5ee60294b5bd2e4d758730ff8b274eeb40b8","duration":26.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.645,"text":"K'AWA to pari eko wa,","marked":"K'àwa tó parí ẹ̀kọ́ wa"},{"start":2.095,"end":3.239,"text":"Awa f' iyin fun O","marked":"Àwa f ìyìn fún Ọ"},{"start":3.689,"end":5.075,"text":"T'ori ojo Re mimo yi,","marked":"T'orí ọjọ́ Rẹ mímọ́ yí"},{"start":5.525,"end":7.298,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọrẹ èwe."}],"end":7.298},{"key":"2","start":8.248,"lines":[{"start":8.248,"end":9.492,"text":"Gbin oro Re si okan wa,","marked":"Gbin ọ̀rọ̀ Rẹ sí ọkàn wa"},{"start":9.942,"end":10.89,"text":"Gba wa lowo ese","marked":"Gbà wá lọ́wọ́ ẹ̀ṣẹ̀"},{"start":11.34,"end":12.982,"text":"Ma je k'a pada lehin Re,","marked":"Má jẹ́ k'á padà lẹ́hìn Rẹ"},{"start":13.432,"end":15.027,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọrẹ èwe."}],"end":15.027},{"key":"3","start":15.977,"lines":[{"start":15.977,"end":18.051,"text":"Jesu jo, bukun ile wa,","marked":"Jésù jọ, bùkún ilé wa"},{"start":18.501,"end":19.636,"text":"K'a lo ojo yi 're","marked":"K'á lo ọjọ́ yí rẹ̀"},{"start":20.086,"end":21.721,"text":"K'a le ri aye lodo Re,","marked":"K'á lè rí ayé lọ́dọ̀ Rẹ"},{"start":22.171,"end":23.925,"text":"Jesu, Ore ewe.","marked":"Jésù, Ọrẹ èwe."},{"start":24.375,"end":25.007,"text":"Amin.","marked":"Àmín."}],"end":25.007}]}