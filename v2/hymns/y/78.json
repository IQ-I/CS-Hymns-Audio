{"v":2,"coll":"y","num":78,"id":"hymn_78","title":"T'OLORUN Oluwa nile","duration":73.239,"voices":{"male":{"file":"y-78-male-v2.m4a","bytes":508965,"sha256":"d741ec2c114f91a703ec2e277d7d00cf33a0ba673be08b8c796e2e8014e40467","duration":73.3},"female":{"file":"y-78-female-v2.m4a","bytes":522654,"sha256":"e2bd8de79a3f56a7f05cd031c08956cf56248adf9c335e4bc6d70e458d819e0c","duration":73.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.539,"text":"T'OLORUN Oluwa nile","marked":"T'Ọlọ́run Olúwa nílẹ̀"},{"start":1.989,"end":3.17,"text":"Ati gbogbo ekun re,","marked":"Àti gbogbo ẹkún rẹ̀"},{"start":3.62,"end":5.151,"text":"Aiye at'awon enia","marked":"Ayé àt'àwọn ẹnìà"},{"start":5.601,"end":6.789,"text":"Ti O tedo sinu re.","marked":"Tí Ó tẹ̀dó sínú rẹ̀."}],"end":6.789},{"key":"CHORUS","start":7.739,"lines":[{"start":7.739,"end":9.083,"text":"Awamaridi ni 'se Re,","marked":"Àwamaridi ni ṣe Rẹ̀"},{"start":9.533,"end":10.549,"text":"OLuwa omo-ogun","marked":"Olúwa omo-ogun"},{"start":10.999,"end":12.879,"text":"Ogo Ogo ola at'agbara,","marked":"Ògo Ògo ọlá àt'agbára"},{"start":13.329,"end":15.101,"text":"Ni fun O, Metalokan.","marked":"Ní fún Ọ, Mẹ́talọ́kan."}],"end":15.101},{"key":"2","start":16.051,"lines":[{"start":16.051,"end":17.402,"text":"Tani yio goke Oluwa","marked":"Tani yóò gòkè Olúwa"},{"start":17.852,"end":18.998,"text":"Ati ibi Mimo Re","marked":"Àti ibi Mímọ́ Rẹ"},{"start":19.448,"end":20.706,"text":"Enit'o ni owo mimo","marked":"Ẹnit'ó ní ọwọ́ mímọ́"},{"start":21.156,"end":22.492,"text":"TI aiyaa re si funfun.","marked":"Tí àìyàá rẹ̀ sì funfun."},{"start":22.942,"end":24.213,"text":"Egbe:  Awamaridi ni 'se...","marked":"Àwamaridi ni ṣe"}],"end":24.213},{"key":"3","start":25.163,"lines":[{"start":25.163,"end":26.548,"text":"Awon ti ko gbokan soke","marked":"Àwọn tí kò gbọkàn sókè"},{"start":26.998,"end":28.28,"text":"S'ohun asan aiye yi,","marked":"S'ohun asán ayé yí"},{"start":28.73,"end":30.054,"text":"Ti ko si je bura etan","marked":"Tí kò sì jẹ́ búra ẹ̀tàn"},{"start":30.504,"end":31.909,"text":"Yio ri 'bukun Oluwa gba.","marked":"Yóò rí bùkún Olúwa gbà."},{"start":32.359,"end":33.646,"text":"Egbe:  Awamaridi ni 'se...","marked":"Àwamaridi ni ṣe"}],"end":33.646},{"key":"4","start":34.596,"lines":[{"start":34.596,"end":36.125,"text":"Eyi I'awon ti nsaferi","marked":"Èyí l'àwọn tí ńṣàfẹ́rí"},{"start":36.575,"end":37.871,"text":"Oju Olorun Jakobu,","marked":"Ojú Ọlọ́run Jakọbu"},{"start":38.321,"end":39.565,"text":"Awon to duro d'Oluwa","marked":"Àwọn tó dúró d'Olúwa"},{"start":40.015,"end":41.213,"text":"Ni yio ri 'bukun gba.","marked":"Ni yóò rí bùkún gbà."},{"start":41.663,"end":42.879,"text":"Egbe:  Awamaridi ni 'se...","marked":"Àwamaridi ni ṣe"}],"end":42.879},{"key":"5","start":43.829,"lines":[{"start":43.829,"end":44.937,"text":"Gbori soke enu ona,","marked":"Gborí sókè ẹnu ọ̀nà"},{"start":45.387,"end":46.828,"text":"Ka si tun gbe nyin soke","marked":"Ká sì tún gbé yín sókè"},{"start":47.278,"end":48.499,"text":"Enyin l'ekun aiyeraiye,","marked":"Ẹ̀yin l'ẹkún ayérayé"},{"start":48.949,"end":50.324,"text":"K'Oba ogo le wole.","marked":"K'Ọba ògo lè wọlé."},{"start":50.774,"end":52.025,"text":"Egbe:  Awamaridi ni 'se...","marked":"Àwamaridi ni ṣe"}],"end":52.025},{"key":"6","start":52.975,"lines":[{"start":52.975,"end":54.496,"text":"Tani Oba Ologo yi!","marked":"Tani Ọba Ológo yí!"},{"start":54.946,"end":56.025,"text":"Oluwa Omo Ogun","marked":"Olúwa Ọmọ Ogun"},{"start":56.475,"end":58.048,"text":"Eni to I'agbara l'ogun","marked":"Ẹni tó l'agbára l'ogun"},{"start":58.498,"end":59.624,"text":"On ni Oba Ogo yi.","marked":"Ọ́n ni Ọba Ògo yí."},{"start":60.074,"end":61.337,"text":"Egbe:  Awamaridi ni 'se...","marked":"Àwamaridi ni ṣe"}],"end":61.337},{"key":"7","start":62.287,"lines":[{"start":62.287,"end":63.554,"text":"Gbori soke enu ona,","marked":"Gborí sókè ẹnu ọ̀nà"},{"start":64.004,"end":65.52,"text":"K'Oba ogo le wole","marked":"K'Ọba ògo lè wọlé"},{"start":65.97,"end":67.269,"text":"Tani Oba Ogo yi?","marked":"Tani Ọba Ògo yí?"},{"start":67.719,"end":68.895,"text":"Oluwa Omo Ogun.","marked":"Olúwa Ọmọ Ogun."},{"start":69.345,"end":70.63,"text":"Egbe:  Awamaridi ni 'se...","marked":"Àwamaridi ni ṣe"},{"start":71.08,"end":71.69,"text":"Amin.","marked":"Àmín."}],"end":71.69}]}