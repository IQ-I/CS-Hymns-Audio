{"v":2,"coll":"y","num":85,"id":"hymn_85","title":"O DA mi loju, Jesu n' temi","duration":44.033,"voices":{"male":{"file":"y-85-male-v2.m4a","bytes":318448,"sha256":"db8fcb1bbf10340e54f2447bd41db22bd67f019b03bd4383631bf5253f05801e","duration":44.1},"female":{"file":"y-85-female-v2.m4a","bytes":328601,"sha256":"443819f2fc72f2a26beaba6f213ad92ed7a63f25f8f013a29dc6d17eff19c532","duration":44.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.598,"text":"O DA mi loju, Jesu n' temi","marked":"Ó Dá mi lójú, Jésù ń tèmi"},{"start":3.048,"end":4.761,"text":"Itowo adun orun l'eyi je","marked":"Ìtọwọ́ adùn ọ̀run l'èyí jẹ́"},{"start":5.211,"end":6.777,"text":"Mo di ajogun igbala nla","marked":"Mo di ajogún ìgbàlà ńlá"},{"start":7.227,"end":9.441,"text":"Eje Re we mi, a tun mi bi.","marked":"Ẹ̀jẹ̀ Rẹ̀ wẹ̀ mi, a tún mi bí."}],"end":9.441},{"key":"CHORUS","start":10.391,"lines":[{"start":10.391,"end":11.894,"text":"Eyi ni 'tan mi at 'orin mi","marked":"Èyí ni tàn mí àt orin mi"},{"start":12.344,"end":14.508,"text":"Ngo yin Olugbala mi titi","marked":"Ǹgọ́ yín Olùgbàlà mi títí"},{"start":14.958,"end":16.55,"text":"Eyi ni 'tan mi at' orin mi","marked":"Èyí ni tàn mí àt orin mi"},{"start":17.0,"end":18.401,"text":"Ngo yin Olugbala mi titi.","marked":"Ǹgọ́ yin Olùgbàlà mi títí."}],"end":18.401},{"key":"2","start":19.351,"lines":[{"start":19.351,"end":21.687,"text":"'Teriba pipe, ayo pipe","marked":"tẹríba pípẹ́, ayọ̀ pípẹ́"},{"start":22.137,"end":23.702,"text":"Mo n ri iran ogo bibo Re","marked":"Mo ń rí ìran ògo bíbọ̀ Rẹ"},{"start":24.152,"end":25.618,"text":"Angeli n mu ihin didun wa","marked":"Áńgẹ́lì ń mú ìhìn dídùn wá"},{"start":26.068,"end":27.92,"text":"Ti ife at'aanu Re si mi","marked":"Ti ìfẹ́ àt'àánú Rẹ sí mi"},{"start":28.37,"end":29.665,"text":"Egbe:  Eyi ni 'tan mi...","marked":"Èyí ni tàn mi"}],"end":29.665},{"key":"3","start":30.615,"lines":[{"start":30.615,"end":33.139,"text":"“Teriba pipe, isin mi ni","marked":"Tẹríba pípẹ́, ìsìn mi ni"},{"start":33.589,"end":35.462,"text":"Ninu Kristi mo d'eni 'bukun","marked":"Nínú Kristi mo d'ẹni bùkún"},{"start":35.912,"end":37.54,"text":"N'igba gbogbo mo n w'oke orun","marked":"N'ìgbà gbogbo mò ń w'òkè ọ̀run"},{"start":37.99,"end":39.752,"text":"Mo si kun f'oore at'ife Re.","marked":"Mo sì kún f'oore àt'ìfẹ́ Rẹ̀."},{"start":40.202,"end":41.439,"text":"Egbe:  Eyi ni 'tan mi...","marked":"Èyí ni tàn mi"},{"start":41.889,"end":42.484,"text":"Amin.","marked":"Àmín."}],"end":42.484}]}