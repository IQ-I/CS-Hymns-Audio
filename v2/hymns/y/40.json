{"v":2,"coll":"y","num":40,"id":"hymn_40","title":"AYO l'ojo 'simi fun mi","duration":37.209,"voices":{"male":{"file":"y-40-male-v2.m4a","bytes":258027,"sha256":"4562b9d9519f1cf1a615c337d9f73815671ff9ab6d797bd8a25bd2c252c62f1f","duration":37.3},"female":{"file":"y-40-female-v2.m4a","bytes":263720,"sha256":"878d2fe3b5ff7b5b1515c3e12c441dae0aae33c90bc76737143110b718eeb6a0","duration":37.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.626,"text":"AYO l'ojo 'simi fun mi","marked":"Ayọ̀ l'ọjọ́ ṣímí fún mi"},{"start":2.076,"end":3.981,"text":"Ati agogo at'iwasu","marked":"Àti agogo àt'ìwàṣù"},{"start":4.431,"end":5.993,"text":"Gbat a ba mi n'nu 'banuje","marked":"Gbàt a bá mi n'nú banújẹ́"},{"start":6.443,"end":7.759,"text":"Awon l'o nmu inu mi dun.","marked":"Àwọn l'ó ńmú inú mi dùn."}],"end":7.759},{"key":"2","start":8.709,"lines":[{"start":8.709,"end":10.242,"text":"Ayo si ni wakati na,","marked":"Ayọ̀ sì ni wákàtí ná"},{"start":10.692,"end":12.136,"text":"Ti mo lo n'nu agbala Re,","marked":"Tí mo lọ n'nú àgbàlá Rẹ"},{"start":12.586,"end":14.256,"text":"Lati mo adun adura","marked":"Láti mọ adùn àdúrà"},{"start":14.706,"end":16.322,"text":"Lati gba manna oro Re.","marked":"Láti gba manna ọ̀rọ̀ Rẹ̀."}],"end":16.322},{"key":"3","start":17.272,"lines":[{"start":17.272,"end":18.568,"text":"Ayo ni idahun 'Amin'","marked":"Ayọ̀ ni ìdáhùn àmín"},{"start":19.018,"end":20.906,"text":"To gba gbogbo ile na kan,","marked":"Tó gba gbogbo ilẹ̀ ná kan"},{"start":21.356,"end":23.851,"text":"Lekokan l'o ndun t'o nrole","marked":"Lẹ́kọ̀kan l'ó ńdùn t'ó ńrọlẹ̀"},{"start":24.301,"end":25.947,"text":"O nkoja lo s'odo Baba.","marked":"Ó ńkọjá lọ s'ọ́dọ̀ Baba."}],"end":25.947},{"key":"4","start":26.897,"lines":[{"start":26.897,"end":28.147,"text":"B'aiye fe f'agbara de mi","marked":"B'ayé fẹ́ f'agbára dé mi"},{"start":28.597,"end":30.06,"text":"Mo ise ijo mefa re;","marked":"Mọ iṣẹ́ ìjọ mẹ́fà rẹ"},{"start":30.51,"end":32.019,"text":"Oluwa, jo tu ide na,","marked":"Olúwa, jọ tú idẹ ná"},{"start":32.469,"end":34.596,"text":"K'O so okan mi d'ominira.","marked":"K'ó sọ ọkàn mi d'òmìnira."},{"start":35.046,"end":35.66,"text":"Amin.","marked":"Àmín."}],"end":35.66}]}