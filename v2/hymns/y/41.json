{"v":2,"coll":"y","num":41,"id":"hymn_41","title":"EMI Olorun alaye","duration":44.297,"voices":{"male":{"file":"y-41-male-v2.m4a","bytes":308506,"sha256":"2291c3fa9164b1824a5a0694bb57febf1f2679ad8691d920ef59e41df9361102","duration":44.3},"female":{"file":"y-41-female-v2.m4a","bytes":317019,"sha256":"a92ddd784d1ab00b6883fe75797a07f83bf710b71a15fc160cffe7f5b28d0ffc","duration":44.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.463,"text":"EMI Olorun alaye","marked":"Ẹ̀mí Ọlọ́run àlàyé"},{"start":1.913,"end":3.426,"text":"N'nu ekun ore-ofe Re,","marked":"N'nú ẹkún oore-ọ̀fẹ́ Rẹ"},{"start":3.876,"end":5.227,"text":"Nibit' ese enia ti te","marked":"Níbit ẹsẹ̀ ẹnìà ti tẹ́"},{"start":5.677,"end":7.24,"text":"Sokake sori iran wa.","marked":"Ṣọ̀kakẹ́ sórí ìran wa."}],"end":7.24},{"key":"2","start":8.19,"lines":[{"start":8.19,"end":10.262,"text":"F'ebun ahon, okan ife,","marked":"F'ẹ̀bùn ahọ́n, ọkàn ìfẹ́"},{"start":10.712,"end":12.052,"text":"Fun wa lati soro 'fe Re,","marked":"Fún wa láti sọ̀rọ̀ fẹ́ Rẹ"},{"start":12.502,"end":13.969,"text":"K'ibukun at'agbara Re,","marked":"K'ìbùkún àt'agbára Rẹ̀"},{"start":14.419,"end":16.413,"text":"Ba l'awon t'o ngbo oro na.","marked":"Bá l'àwọn t'ó ńgbọ́ ọ̀rọ̀ ná."}],"end":16.413},{"key":"3","start":17.363,"lines":[{"start":17.363,"end":18.688,"text":"K'okun kase ni bibo Re;","marked":"K'okùn kàṣe ni bíbọ̀ Rẹ"},{"start":19.138,"end":20.684,"text":"Ki darudapo di tito","marked":"Kí dàrúdàpọ̀ di títọ́"},{"start":21.134,"end":22.725,"text":"F'ilera f'okan ailera","marked":"F'ìlera f'ọkàn àìlera"},{"start":23.175,"end":24.529,"text":"Jeki anu bori ibinu.","marked":"Jẹ́kí àánú borí ìbínú."}],"end":24.529},{"key":"4","start":25.479,"lines":[{"start":25.479,"end":27.262,"text":"Emi Olorun, jo pese","marked":"Ẹ̀mí Ọlọ́run, jọ pèsè"},{"start":27.712,"end":29.018,"text":"Gbogbo aiye fun Oluwa;","marked":"Gbogbo ayé fún Olúwa"},{"start":29.468,"end":30.816,"text":"Mi si won b' afefe oro","marked":"Mi sì wọn b afẹ́fẹ́ ọ̀rọ̀"},{"start":31.266,"end":32.64,"text":"K'okan okuta le soji.","marked":"K'ọkàn òkúta lè sọjí."}],"end":32.64},{"key":"5","start":33.59,"lines":[{"start":33.59,"end":35.142,"text":"Baptis' gbogb' orile-ede","marked":"Baptis gbogb orile-ede"},{"start":35.592,"end":37.226,"text":"Rohin 'segun Jesu yika","marked":"Ròhìn ṣẹ́gun Jésù yíká"},{"start":37.676,"end":39.277,"text":"Yin Oruko Jesu logo","marked":"Yin Orúkọ Jésù lógo"},{"start":39.727,"end":41.609,"text":"Tit'araiye yio jewo Re.","marked":"Tít'aráìyè yóò jẹ́wọ́ Rẹ."},{"start":42.059,"end":42.748,"text":"Amin.","marked":"Àmín."}],"end":42.748}]}