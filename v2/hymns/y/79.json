{"v":2,"coll":"y","num":79,"id":"hymn_79","title":"BABA Mimo jowo sunmo wa,","duration":75.453,"voices":{"male":{"file":"y-79-male-v2.m4a","bytes":541958,"sha256":"6cf029b02e37457db3d287172e3fe10c5748cc9c8c584d1c634178d7e2221bce","duration":75.5},"female":{"file":"y-79-female-v2.m4a","bytes":558435,"sha256":"cf36606a71383e26b26a520ed9c50cf38a77e01176fbbb2aaddcab8accc72274","duration":75.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.754,"text":"BABA Mimo jowo sunmo wa,","marked":"Baba Mímọ́ jọ̀wọ́ súnmọ́ wa"},{"start":2.204,"end":3.554,"text":"Omo Mimo jowo sunmo wa,","marked":"Ọmọ Mímọ́ jọ̀wọ́ súnmọ́ wa"},{"start":4.004,"end":5.454,"text":"Emi Mimo jowo sunmo wa,","marked":"Ẹ̀mí Mímọ́ jọ̀wọ́ súnmọ́ wa"},{"start":5.904,"end":8.215,"text":"A sunmo O, fi 'bukun fun wa,","marked":"A súnmọ́ Ọ, fi bùkún fún wa"}],"end":8.215},{"key":"CHORUS","start":9.165,"lines":[{"start":9.165,"end":11.045,"text":"Baba wa, Baba wa","marked":"Baba wa, Baba wa"},{"start":11.495,"end":12.859,"text":"Edumare jowo bukun wa,","marked":"Èdùmàrè jọ̀wọ́ bùkún wá"},{"start":13.309,"end":15.013,"text":"Baba wa, Baba wa,","marked":"Baba wa, Baba wa"},{"start":15.463,"end":17.082,"text":"Edumare jowo bukun wa.","marked":"Èdùmàrè jọ̀wọ́ bùkún wá."}],"end":17.082},{"key":"2","start":18.032,"lines":[{"start":18.032,"end":20.209,"text":"Jehovah Jire wa ba wa pe,","marked":"Jehovah Jire wá bá wa pé"},{"start":20.659,"end":22.359,"text":"K'O si ma gbe inu okan wa,","marked":"K'ó sì má gbé inú ọkàn wa"},{"start":22.809,"end":24.536,"text":"Masai f'oju anu Re wo wa,","marked":"Masai f'ojú àánú Rẹ̀ wò wá"},{"start":24.986,"end":26.562,"text":"Ko si f'ese Egbe wa mule.","marked":"Kò sì f'ẹsẹ̀ Ẹgbẹ́ wa múlẹ̀."},{"start":27.012,"end":28.802,"text":"Egbe:  Baba wa, Baba wa...","marked":"Baba wa, Baba wa"}],"end":28.802},{"key":"3","start":29.752,"lines":[{"start":29.752,"end":31.5,"text":"Oluwa pese Emi Re fun wa,","marked":"Olúwa pèsè Ẹ̀mí Rẹ̀ fún wa"},{"start":31.95,"end":33.99,"text":"Ka wa le sin O titi d'opin","marked":"Ká wá lè sìn Ọ́ títí d'òpin"},{"start":34.44,"end":35.716,"text":"Ko si ma samona Egbe wa,","marked":"Kò sì má ṣamọ̀nà Ẹgbẹ́ wa"},{"start":36.166,"end":37.613,"text":"Ka le fi 'joba Re s'ere je","marked":"Ká lè fi jọba Rẹ̀ s'èrè jẹ́"},{"start":38.063,"end":40.041,"text":"Egbe:  Baba wa, Baba wa...","marked":"Baba wa, Baba wa"}],"end":40.041},{"key":"4","start":40.991,"lines":[{"start":40.991,"end":42.407,"text":"Pese fun gbogbo awon omo Egbe","marked":"Pèsè fún gbogbo àwọn ọmọ Ẹgbẹ́"},{"start":42.857,"end":44.445,"text":"Pese ise f'awon alairise,","marked":"Pèsè iṣẹ́ f'àwọn aláìríṣẹ́"},{"start":44.895,"end":46.804,"text":"Mase jeki gbogbo wa rahun","marked":"Mase jẹ́kí gbogbo wa ráhùn"},{"start":47.254,"end":49.078,"text":"Masai fi 'bukun Re kari wa.","marked":"Masai fi bùkún Rẹ̀ kárí wa."},{"start":49.528,"end":51.438,"text":"Egbe:  Baba wa, Baba wa...","marked":"Baba wa, Baba wa"}],"end":51.438},{"key":"5","start":52.388,"lines":[{"start":52.388,"end":54.191,"text":"Nigbat' a ba si f'aiye yi sile","marked":"Nígbàt a bá sì f'ayé yí sílẹ̀"},{"start":54.641,"end":56.109,"text":"Ka wa je eni 'tewogba","marked":"Ká wá jẹ́ ẹni tẹ́wọ́gbà"},{"start":56.559,"end":58.407,"text":"K'awa sile ba Jesu gunwa,","marked":"K'àwa sílẹ̀ bá Jésù gúnwà"},{"start":58.857,"end":60.364,"text":"Niwaju ite Metalokan.","marked":"Níwájú ìtẹ́ Mẹ́talọ́kan."},{"start":60.814,"end":62.759,"text":"Egbe:  Baba wa, Baba wa...","marked":"Baba wa, Baba wa"}],"end":62.759},{"key":"6","start":63.709,"lines":[{"start":63.709,"end":65.444,"text":"Nikehin k'a le gbo ohun ni,","marked":"Níkẹ̀hìn k'á lè gbọ́ ohùn ni"},{"start":65.894,"end":67.408,"text":"E wa enyin Alabukun fun","marked":"Ẹ wá ẹ̀yin Alábùkún fún"},{"start":67.858,"end":69.318,"text":"Bo sinu ayo Oluwa Re,","marked":"Bọ́ sínú ayọ̀ Olúwa Rẹ"},{"start":69.768,"end":71.311,"text":"K'a le b'awon Angeli korin 'yin.","marked":"K'á lè b'àwọn Áńgẹ́lì kọrin yín."},{"start":71.761,"end":73.904,"text":"Egbe:  Baba wa, Baba wa... Amin.","marked":"Baba wa, Baba wa Àmín."}],"end":73.904}]}