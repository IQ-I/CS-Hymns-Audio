{"v":2,"coll":"y","num":5,"id":"hymn_5","title":"WA s'adura oro","duration":33.522,"voices":{"male":{"file":"y-5-male-v2.m4a","bytes":224670,"sha256":"b97703dfab96310441dccff8d782973670c56508ed7fa3407490f8d0cab89569","duration":33.6},"female":{"file":"y-5-female-v2.m4a","bytes":241510,"sha256":"f3a21b8176636a65532681cc5b158066ef8a7f016581da15ffe1475d72d33047","duration":33.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.47,"text":"WA s'adura oro","marked":"Wá s'àdúrà ọ̀rọ̀"},{"start":1.92,"end":3.363,"text":"Kunle k'a gbadura;","marked":"Kúnlẹ̀ k'á gbàdúrà"},{"start":3.813,"end":5.651,"text":"Adura ni opa Kristiani,","marked":"Àdúrà ní ọ̀pá Kristiani"},{"start":6.101,"end":7.288,"text":"Lati b'Olorun rin.","marked":"Láti b'Ọlọ́run rìn."}],"end":7.288},{"key":"2","start":8.238,"lines":[{"start":8.238,"end":9.805,"text":"Losan, wole labe","marked":"Lọ́sàn, wọlé lábẹ́"},{"start":10.255,"end":11.606,"text":"Apat' aiyeraiye;","marked":"Àpát ayérayé"},{"start":12.056,"end":13.672,"text":"Itura ojiji Re dun,","marked":"Ìtura òjìji Rẹ̀ dùn"},{"start":14.122,"end":15.371,"text":"Nigbat' orun ba mu.","marked":"Nígbàt ọ̀run bá mú."}],"end":15.371},{"key":"3","start":16.321,"lines":[{"start":16.321,"end":17.368,"text":"Je ki gbogbo ile,","marked":"Jẹ́ kí gbogbo ilẹ̀"},{"start":17.818,"end":19.209,"text":"Wa gbadura l'ale","marked":"Wá gbàdúrà l'alẹ́"},{"start":19.659,"end":21.002,"text":"Ki ile wa di t'Olorun,","marked":"Kí ilẹ̀ wa di t'Ọlọ́run"},{"start":21.452,"end":22.663,"text":"Ati 'bode orun.","marked":"Àti bodè ọ̀run."}],"end":22.663},{"key":"4","start":23.613,"lines":[{"start":23.613,"end":25.058,"text":"Nigbati od'oganjo","marked":"Nígbàtí ọ̀d'ọ̀gànjọ́"},{"start":25.508,"end":26.866,"text":"Jek'a wi l'emi, pe","marked":"Jẹ́k'á wí l'èmi, pé"},{"start":27.316,"end":29.278,"text":"Mo sun, sugbon okan mi ji","marked":"Mo sùn, ṣùgbọ́n ọkàn mi jí"},{"start":29.728,"end":31.0,"text":"Lati ba O sona.","marked":"Láti bá Ọ ṣọ́nà."},{"start":31.45,"end":31.973,"text":"Amin.","marked":"Àmín."}],"end":31.973}]}