{"v":2,"coll":"y","num":14,"id":"hymn_14","title":"IFE Re da wa wa si loni","duration":35.554,"voices":{"male":{"file":"y-14-male-v2.m4a","bytes":255620,"sha256":"7f9b957d482ae46520c504806a22e74c801bd775197d2ed64de55bec0b3028fd","duration":35.6},"female":{"file":"y-14-female-v2.m4a","bytes":262521,"sha256":"0e42b7c2f34addb07fd1049f2d02490ee8590c3fb3f2ac920ea421cbd01ff0ed","duration":35.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.656,"text":"IFE Re da wa si loni,","marked":"Ìfẹ́ Rẹ̀ dá wa sí lónì"},{"start":2.106,"end":3.503,"text":"L'are a si dubule;","marked":"L'àrẹ a sì dùbúlẹ̀"},{"start":3.953,"end":5.418,"text":"Ma so wa ni dake oru","marked":"Má sọ wá ní dákẹ́ òru"},{"start":5.868,"end":7.151,"text":"K'ota ma yo wa lenu;","marked":"K'ọ̀tá má yọ wá lẹ́nu"},{"start":7.601,"end":9.532,"text":"Jesu, se Olutoju wa,","marked":"Jésù, ṣe Olùtọ́jú wa"},{"start":9.982,"end":11.633,"text":"lwo l'o dun gbekele.","marked":"lwó l'ó dùn gbẹ́kẹ̀lé."}],"end":11.633},{"key":"CHORUS","start":12.583,"lines":[{"start":12.583,"end":14.458,"text":"Halleluyah, Halleluyah","marked":"Hallelúyà, Hallelúyà"},{"start":14.908,"end":16.511,"text":"Ni won nko t'osan t'oru","marked":"Ní wọ́n ńkọ́ t'ọ̀sán t'òru"},{"start":16.961,"end":18.182,"text":"Nibi t'Olugbala ngbe","marked":"Níbi t'Olùgbàlà ńgbé"},{"start":18.632,"end":20.115,"text":"Ni won nko t'osan t'orun","marked":"Ní wọ́n ńkọ́ t'ọ̀sán t'ọ̀run"}],"end":20.115},{"key":"2","start":21.065,"lines":[{"start":21.065,"end":22.714,"text":"Ero at'alejo l'aiye","marked":"Èrò àt'àlejò l'ayé"},{"start":23.164,"end":24.42,"text":"A ngb'arin awon ota!","marked":"A ńgb'arin àwọn ọ̀tá!"},{"start":24.87,"end":26.861,"text":"Yo wa, at'ile wa l'ewu","marked":"Yọ wá, àt'ilé wa l'ewu"},{"start":27.311,"end":28.824,"text":"L'apa Re ni ka sun si;","marked":"L'apá Rẹ̀ ni ká sùn sí"},{"start":29.274,"end":30.849,"text":"N'ijo iyonu aiye pin,","marked":"N'ìjọ ìyọnu ayé pín"},{"start":31.299,"end":32.922,"text":"Ka le simi l'odo Re.","marked":"Ká lè ṣímì l'ọ̀dọ̀ Rẹ."},{"start":33.372,"end":34.004,"text":"Amin.","marked":"Àmín."}],"end":34.004}]}