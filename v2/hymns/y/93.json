{"v":2,"coll":"y","num":93,"id":"hymn_93","title":"A F'OPE f'Olorun.","duration":43.972,"voices":{"male":{"file":"y-93-male-v2.m4a","bytes":303808,"sha256":"ac3f9dcd45b51d69cbcafb26222baf898cfd918a606e0382095c11c911ff4967","duration":44.0},"female":{"file":"y-93-female-v2.m4a","bytes":318748,"sha256":"8a8a71c05274a8b7d17cf3f342b05b60169182958051a871163a73551c419e4d","duration":44.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.517,"text":"A F'OPE f'Olorun.","marked":"A F'ọpẹ́ f'Ọlọ́run."},{"start":1.967,"end":3.396,"text":"L'Okan ati Ohun wa,","marked":"L'Ọkàn àti Ohun wa"},{"start":3.846,"end":4.916,"text":"Eni ns'ohun 'yanu,","marked":"Ẹni ńṣ'ohun yanu"},{"start":5.366,"end":7.067,"text":"N'nu Eniti araiye nyo","marked":"N'nú Eniti aráìyè ńyọ̀"},{"start":7.517,"end":8.585,"text":"Gbat' a wa l'om'owo","marked":"Gbàt a wá l'ọ́m'ọwọ́"},{"start":9.035,"end":10.211,"text":"On na l'o ntoju wa,","marked":"Ọ́n ná l'ó ńtọ́jú wa"},{"start":10.661,"end":11.853,"text":"O si nf'ebun ife","marked":"Ó sì ńf'ẹ̀bùn ìfẹ́"},{"start":12.303,"end":13.605,"text":"Se 'toju wa sibe.","marked":"Ṣe tọ́jú wá síbẹ̀."}],"end":13.605},{"key":"2","start":14.555,"lines":[{"start":14.555,"end":15.512,"text":"Oba Onib'ore","marked":"Ọba Oníb'ọ̀rẹ́"},{"start":15.962,"end":17.316,"text":"Ma fi wa sile lailai","marked":"Má fi wá sílẹ̀ láéláé"},{"start":17.766,"end":19.627,"text":"Ayo ti ko l'opin","marked":"Ayọ̀ tí kò l'òpin"},{"start":20.077,"end":21.741,"text":"On bukun y'o je tiwa","marked":"Òn bùkún y'ó jẹ́ tiwa"},{"start":22.191,"end":23.219,"text":"Pa wa mo n'nu ore","marked":"Pa wá mọ̀ n'nú ọ̀rẹ́"},{"start":23.669,"end":24.913,"text":"To wa gba ba damu","marked":"Tó wá gbà bá dàmú"},{"start":25.363,"end":26.435,"text":"Yo wa ninu ibi","marked":"Yọ wà nínú ibi"},{"start":26.885,"end":28.323,"text":"Laiye ati l'orun.","marked":"Láìyẹ àti l'ọ̀run."}],"end":28.323},{"key":"3","start":29.273,"lines":[{"start":29.273,"end":30.287,"text":"K'a f'iyin on ope","marked":"K'á f'ìyìn ọn ọpẹ́"},{"start":30.737,"end":32.034,"text":"F'Olorun Baba Omo,","marked":"F'Ọlọ́run Baba Ọmọ"},{"start":32.484,"end":33.505,"text":"At'Emi Mimo","marked":"Àt'ẹ̀mí Mímọ́"},{"start":33.955,"end":35.328,"text":"Ti o ga julo I'Orun","marked":"Tí ó ga jùlọ l'Ọ̀run"},{"start":35.778,"end":36.881,"text":"Olorun kan lailai","marked":"Ọlọ́run kan láéláé"},{"start":37.331,"end":38.741,"text":"T'aiye at'orun mbo","marked":"T'ayé àt'ọ̀run mbọ̀"},{"start":39.191,"end":40.382,"text":"Be l'o wa d'isiyi","marked":"Bẹ́ l'ó wá d'ìṣíyì"},{"start":40.832,"end":42.422,"text":"Beni y'o wa lailai.","marked":"Bẹni y'ó wà láéláé."}],"end":42.422}]}