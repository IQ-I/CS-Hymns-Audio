{"v":2,"coll":"y","num":63,"id":"hymn_63","title":"BABA jo gbo temi","duration":44.882,"voices":{"male":{"file":"y-63-male-v2.m4a","bytes":299312,"sha256":"06a0df0cc059d7526cd013198751f1eb627d4250a78acc1062664f1467397494","duration":44.9},"female":{"file":"y-63-female-v2.m4a","bytes":311849,"sha256":"0da8eff1c1d1a6146d26fbbfc695346aed1a80aa5e529cfa1c14519dd6a6510f","duration":44.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.628,"text":"BABA jo gbo temi","marked":"Baba jọ gbọ́ tèmi"},{"start":2.078,"end":3.11,"text":"Mo wole lese Re","marked":"Mo wọlé lẹ́sẹ̀ Rẹ"},{"start":3.56,"end":5.481,"text":"'Wo to nwosan to ndariji,","marked":"wò tó ńwòsàn tó ńdáríjì"},{"start":5.931,"end":7.2,"text":"Jowo gbadura wa.","marked":"Jọ̀wọ́ gbàdúrà wa."}],"end":7.2},{"key":"2","start":8.15,"lines":[{"start":8.15,"end":9.207,"text":"Olorun Oluwa,","marked":"Ọlọ́run Olúwa"},{"start":9.657,"end":10.661,"text":"Jehofa Oba mi,","marked":"Jèhófà Ọba mi"},{"start":11.111,"end":12.436,"text":"'Wo to tedo sinu 'mole","marked":"wò tó tẹ̀dó sínú mọ́lẹ̀"},{"start":12.886,"end":14.161,"text":"Ajuba O'ko Re.","marked":"Àjùbá O'kọ́ Rẹ."}],"end":14.161},{"key":"3","start":15.111,"lines":[{"start":15.111,"end":16.241,"text":"Tali oba ti aiye?","marked":"Tálì ọba ti ayé?"},{"start":16.691,"end":18.232,"text":"Jesu Emmanuel,","marked":"Jésù Emmanuel"},{"start":18.682,"end":20.213,"text":"Gbongbo Jesse Eni 'Yanu","marked":"Gbòǹgbò Jesse Ẹni yanu"},{"start":20.663,"end":21.76,"text":"Ran 'ranwo Re si mi.","marked":"Rán rànwọ́ Rẹ̀ sí mi."}],"end":21.76},{"key":"4","start":22.71,"lines":[{"start":22.71,"end":23.935,"text":"Mimo Mimo julo","marked":"Mímọ́ Mímọ́ jùlọ"},{"start":24.385,"end":25.272,"text":"Oba Olugbala","marked":"Ọba Olùgbàlà"},{"start":25.722,"end":27.249,"text":"Alagbara ninu orun","marked":"Alágbára nínú ọ̀run"},{"start":27.699,"end":28.914,"text":"Ranti majemu Re.","marked":"Rántí májẹ̀mú Rẹ."}],"end":28.914},{"key":"5","start":29.864,"lines":[{"start":29.864,"end":30.967,"text":"Lowuro gbo temi,","marked":"Lówúrọ̀ gbọ́ tèmi"},{"start":31.417,"end":32.515,"text":"Losan gbo ebe mi,","marked":"Lọ́sàn gbọ́ ẹ̀bẹ̀ mi"},{"start":32.965,"end":34.318,"text":"Loju ale gbat'orun wo","marked":"Lójú alẹ́ gbàt'ọ̀run wò"},{"start":34.768,"end":36.179,"text":"Jowo gbo ebe mi.","marked":"Jọ̀wọ́ gbọ́ ẹ̀bẹ̀ mi."}],"end":36.179},{"key":"6","start":37.129,"lines":[{"start":37.129,"end":38.228,"text":"Ogo fun Baba wa,","marked":"Ògo fún Baba wa"},{"start":38.678,"end":39.842,"text":"Ogo ni fun Omo Re","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":40.292,"end":41.491,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":41.941,"end":43.332,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":43.332}]}