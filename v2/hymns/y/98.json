{"v":2,"coll":"y","num":98,"id":"hymn_98","title":"ENYIN egbe Serafu,","duration":62.219,"voices":{"male":{"file":"y-98-male-v2.m4a","bytes":433208,"sha256":"d2606fbeece874d96b287272c3a01c53722a456ed818e954e2093f83cd7501f2","duration":62.3},"female":{"file":"y-98-female-v2.m4a","bytes":456507,"sha256":"b6751c83937e1ed3391cb1e8fe3bca7c396a7dc89919fc5ddc3bbbb7ab42acb1","duration":62.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.438,"text":"ENYIN egbe Serafu,","marked":"Ẹ̀yin ẹgbẹ́ Séráfù"},{"start":1.888,"end":3.259,"text":"Wa fi ayo nyin han,","marked":"Wá fi ayọ̀ yín hàn"},{"start":3.709,"end":5.028,"text":"E jumo ko orin didun","marked":"Ẹ jùmọ̀ kọ orin dídùn"},{"start":5.478,"end":7.179,"text":"Fun se'yanu to se fun wa","marked":"Fún ṣe'yanu tó ṣe fún wa"},{"start":7.629,"end":9.891,"text":"Ti ko je ka sonu kuro ni ona Re.","marked":"Tí kò jẹ́ ká sọnù kúrò ní ọ̀nà Rẹ̀."}],"end":9.891},{"key":"CHORUS","start":10.841,"lines":[{"start":10.841,"end":12.086,"text":"A nyan lo si Sion,","marked":"A nyan lọ sí Sion"},{"start":12.536,"end":13.817,"text":"Sion to dara julo","marked":"Sion tó dára jùlọ"},{"start":14.267,"end":15.666,"text":"A nyan goke lo si Sion","marked":"A nyan gòkè lọ sí Sion"},{"start":16.116,"end":17.105,"text":"Ilu Olorun wa.","marked":"Ìlú Ọlọ́run wa."}],"end":17.105},{"key":"2","start":18.055,"lines":[{"start":18.055,"end":19.259,"text":"Baba Aladura","marked":"Baba Aládúrà"},{"start":19.709,"end":20.931,"text":"F'ope fun Olorun","marked":"F'ọpẹ́ fún Ọlọ́run"},{"start":21.381,"end":22.615,"text":"To mu O bori awon ota","marked":"Tó mú Ọ borí àwọn ọ̀tá"},{"start":23.065,"end":24.53,"text":"Ti ko je ki ota yo o","marked":"Tí kò jẹ́ kí ọ̀tá yọ ọ́"},{"start":24.98,"end":26.13,"text":"To fi o se ori","marked":"Tó fi ọ́ ṣe orí"},{"start":26.58,"end":27.813,"text":"Yio fi o se d'opin.","marked":"Yóò fi ó ṣe d'òpin."}],"end":27.813},{"key":"3","start":28.763,"lines":[{"start":28.763,"end":30.047,"text":"Enyin Egbe Akorin","marked":"Ẹ̀yin Ẹgbẹ́ Akọrin"},{"start":30.497,"end":31.65,"text":"E fi ayo nyin han","marked":"Ẹ fi ayọ̀ yín hàn"},{"start":32.1,"end":33.88,"text":"Fun Majemu Re ti ko ye,","marked":"Fún Májẹ̀mú Rẹ tí kò yẹ"},{"start":34.33,"end":35.634,"text":"Ni arin Egbe Serafu","marked":"Ní àrín Ẹgbẹ́ Séráfù"},{"start":36.084,"end":37.236,"text":"To mu se di oni,","marked":"Tó mú ṣe di òní"},{"start":37.686,"end":38.937,"text":"Ati aiye ti mbo.","marked":"Àti ayé ti mbọ̀."}],"end":38.937},{"key":"4","start":39.887,"lines":[{"start":39.887,"end":41.004,"text":"Enia Ie ma kegan","marked":"Ẹníà lè má kẹ́gàn"},{"start":41.454,"end":42.528,"text":"Nwon si le ma sata","marked":"Wọ́n sì lè má ṣátà"},{"start":42.978,"end":44.249,"text":"Awon ti ko m'Olorun wa,","marked":"Àwọn tí kò m'Ọlọ́run wá"},{"start":44.699,"end":46.262,"text":"Sugbon awa Egbe Kerubu","marked":"Ṣùgbọ́n àwa Ẹgbẹ́ Kérúbù"},{"start":46.712,"end":47.865,"text":"A si m'eni t'a nsin","marked":"A sì m'ẹni t'á ńṣin"},{"start":48.315,"end":49.599,"text":"Yio si fun wa lere.","marked":"Yóò sì fún wa lérè."}],"end":49.599},{"key":"5","start":50.549,"lines":[{"start":50.549,"end":51.78,"text":"Kerubu Serafu","marked":"Kérúbù Séráfù"},{"start":52.23,"end":53.388,"text":"E mura sis'Emi","marked":"Ẹ múra sís'èmi"},{"start":53.838,"end":55.442,"text":"Enyin yio sise na dopin","marked":"Ẹ̀yin yóò ṣiṣẹ́ nà dópin"},{"start":55.892,"end":57.218,"text":"E o si ri Olugbala","marked":"Ẹ ó sì rí Olùgbàlà"},{"start":57.668,"end":58.892,"text":"L'aye mimo loke","marked":"L'ayé mímọ́ lókè"},{"start":59.342,"end":60.67,"text":"Ati I'orun pelu.","marked":"Àti l'ọ̀run pẹ̀lú."}],"end":60.67}]}