{"v":2,"coll":"y","num":91,"id":"hymn_91","title":"E DAMURE enyin Seraf'","duration":51.944,"voices":{"male":{"file":"y-91-male-v2.m4a","bytes":367285,"sha256":"577d4a62ba0b465944dcb31217098f3eb295cc0b3f658e1dd6472934f2dbeb91","duration":52.0},"female":{"file":"y-91-female-v2.m4a","bytes":374805,"sha256":"fdc898a00c3b26dbf0bf3c71343b8a21c4dac05bd27ec1bf3c5640365d6270f1","duration":52.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.834,"text":"E DAMURE enyin Seraf'","marked":"Ẹ Damure ẹ̀yin Seraf"},{"start":2.284,"end":3.908,"text":"E mu harpu nyin pelu","marked":"Ẹ mú harpu yín pẹ̀lú"},{"start":4.358,"end":5.936,"text":"E je ki Kimbali nyin dun","marked":"Ẹ jẹ́ kí Kimbali yín dùn"},{"start":6.386,"end":7.834,"text":"Lati pade Oba wa.","marked":"Láti pàdé Ọba wá."}],"end":7.834},{"key":"CHORUS","start":8.784,"lines":[{"start":8.784,"end":10.956,"text":"Loke odo ona Eden,","marked":"Lókè ọ̀dọ̀ ọ̀nà Eden"},{"start":11.406,"end":12.643,"text":"Ibugbe mimo to dara","marked":"Ibùgbé mímọ́ tó dára"},{"start":13.093,"end":14.665,"text":"Nibi Kerubu Serafu,","marked":"Níbi Kérúbù Séráfù"},{"start":15.115,"end":16.503,"text":"Nyin Baba Mimo Logo.","marked":"Yín Baba Mímọ́ Lógo."}],"end":16.503},{"key":"2","start":17.453,"lines":[{"start":17.453,"end":19.15,"text":"Fi 'lu ati 'jo yin Baba","marked":"Fi lu àti jọ yín Baba"},{"start":19.6,"end":21.055,"text":"Baba y'o f'ayo fun wa","marked":"Baba y'ó f'ayọ̀ fún wa"},{"start":21.505,"end":22.911,"text":"Bi awa ba je le gbagbo","marked":"Bí àwa bá jẹ́ lè gbàgbọ́"},{"start":23.361,"end":24.718,"text":"Ere pupo ni fun wa.","marked":"Èrè púpọ̀ ni fún wa."}],"end":24.718},{"key":"3","start":25.668,"lines":[{"start":25.668,"end":27.218,"text":"Baba masai fi 're fun wa","marked":"Baba masai fi rẹ̀ fún wa"},{"start":27.668,"end":28.893,"text":"Awa Seraf' aiye yi;","marked":"Àwa Seraf ayé yí"},{"start":29.343,"end":31.126,"text":"Se wa ye fun isin gbogbo","marked":"Ṣé wá yẹ fún ìsìn gbogbo"},{"start":31.576,"end":33.062,"text":"Ka gb'ade wa nikehin.","marked":"Ká gb'adé wà níkẹ̀hìn."}],"end":33.062},{"key":"4","start":34.012,"lines":[{"start":34.012,"end":35.705,"text":"Baba to gbo ti Elijah,","marked":"Baba tó gbọ́ ti Elijah"},{"start":36.155,"end":37.925,"text":"Masai gbo ti Serafu;","marked":"Masai gbọ́ tí Séráfù"},{"start":38.375,"end":40.094,"text":"Jehovah-Jire Oba wa,","marked":"Jehovah-jire Ọba wa"},{"start":40.544,"end":41.903,"text":"Se wa ye lojo 'kehin.","marked":"Ṣé wá yẹ lọ́jọ́ kẹhìn."}],"end":41.903},{"key":"5","start":42.853,"lines":[{"start":42.853,"end":44.153,"text":"Ao f'ogo fun Baba wa,","marked":"Àó f'ògo fún Baba wa"},{"start":44.603,"end":46.445,"text":"Fun Omo, to da wa si;","marked":"Fún Ọmọ, tó dá wa sí"},{"start":46.895,"end":48.583,"text":"Bi odun si ti nyipo lo,","marked":"Bí ọdún sì ti ńyípo lọ"},{"start":49.033,"end":50.394,"text":"Metalokan la O yin.","marked":"Mẹ́talọ́kan la Ó yín."}],"end":50.394}]}