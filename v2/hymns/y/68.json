{"v":2,"coll":"y","num":68,"id":"hymn_68","title":"NGO korin ti Oludande mi","duration":42.822,"voices":{"male":{"file":"y-68-male-v2.m4a","bytes":296198,"sha256":"d9f79c4304ab960c94696d459c8e37b95d8991486a24363bf41cb031033aed76","duration":42.9},"female":{"file":"y-68-female-v2.m4a","bytes":311741,"sha256":"19bea79323a80da9edb4c00924ec04f6cdc58f85e56dc208a8006622c91c6013","duration":42.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.342,"text":"NGO korin ti Oludande mi","marked":"Ǹgọ́ kọrin tí Olùdáǹdè mi"},{"start":2.792,"end":4.039,"text":"Ati ife iyanu Re,","marked":"Àti ìfẹ́ ìyanu Rẹ"},{"start":4.489,"end":5.706,"text":"O jiya lori 'gi oro","marked":"Ó jìyà lórí gi ọ̀rọ̀"},{"start":6.156,"end":7.769,"text":"Lati so mi dom'nira.","marked":"Láti sọ mí dọ́m'nira."}],"end":7.769},{"key":"CHORUS","start":8.719,"lines":[{"start":8.719,"end":10.22,"text":"Korin ti Oludande mi,","marked":"Kọrin ti Olùdáǹdè mi"},{"start":10.67,"end":11.957,"text":"Eje Re l'o fi ra mi","marked":"Ẹ̀jẹ̀ Rẹ l'ó fi rà mí"},{"start":12.407,"end":13.857,"text":"O f'ote re-dariji mi","marked":"Ó f'ọ̀tẹ̀ re-dariji mi"},{"start":14.307,"end":15.875,"text":"O sanwo-mo dom'nira.","marked":"Ó sanwo-mo dọ́m'nira."}],"end":15.875},{"key":"2","start":16.825,"lines":[{"start":16.825,"end":18.151,"text":"Emi o so'tan Iyanu Re,","marked":"Èmi ó sọ'tán Ìyanu Rẹ̀"},{"start":18.601,"end":19.961,"text":"B'o ti gbogun mi to ni","marked":"B'ó ti gbógun mi tó ni"},{"start":20.411,"end":22.359,"text":"Nu 'fe at'anu ailopin","marked":"Nù fẹ́ àt'ànú àìlópin"},{"start":22.809,"end":24.258,"text":"Fi 'dande fun mi lofe.","marked":"Fi dàǹdè fún mi lọ́fẹ́."}],"end":24.258},{"key":"3","start":25.208,"lines":[{"start":25.208,"end":26.704,"text":"Ngo y'Oludande mi owon","marked":"Ngọ́ y'Olùdáǹdè mi ọ̀wọ́n"},{"start":27.154,"end":28.49,"text":"Ngo r'agbara segun Re","marked":"Ngọ́ r'agbára ṣẹ́gun Rẹ"},{"start":28.94,"end":30.714,"text":"B'o ti fun mi ni isegun","marked":"B'ó ti fún mi ní ìṣẹ́gun"},{"start":31.164,"end":32.796,"text":"Lor'ese at'iparun.","marked":"Lọ́r'ẹsẹ̀ àt'ìparun."}],"end":32.796},{"key":"4","start":33.746,"lines":[{"start":33.746,"end":35.373,"text":"Ngo korin t'Oludande mi,","marked":"Ngọ́ kọrin t'Olùdáǹdè mi"},{"start":35.823,"end":37.445,"text":"T'ife at'orun wa Re,","marked":"T'ìfẹ́ àt'ọ̀run wá Rẹ"},{"start":37.895,"end":39.116,"text":"O mu mi la'ku si ye","marked":"Ó mú mi là'kú sì yẹ"},{"start":39.566,"end":41.272,"text":"Lati ba om'Olorun gbe.","marked":"Láti bá ọm'ọlọ́run gbé."}],"end":41.272}]}