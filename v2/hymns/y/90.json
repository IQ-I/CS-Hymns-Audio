{"v":2,"coll":"y","num":90,"id":"hymn_90","title":"AWA dupe, awa t'ope da,","duration":60.914,"voices":{"male":{"file":"y-90-male-v2.m4a","bytes":416060,"sha256":"a0b7604c7a4cf4fd2d49349ac8ce78e65e19abc772dab61affc8da80de1249f7","duration":61.0},"female":{"file":"y-90-female-v2.m4a","bytes":426050,"sha256":"2b6bbd5d7dbadfb26cf6bcce03aa8013a99f4b3350fba5fc827ce0da50a1f7d1","duration":61.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.345,"text":"AWA dupe, awa t'ope da,","marked":"Àwa dúpẹ́, àwa t'ọpẹ́ dá"},{"start":2.795,"end":4.91,"text":"T'o ti pa agbara ina ileru","marked":"T'ó ti pa agbára iná ìléru"},{"start":5.36,"end":7.043,"text":"Egbe:  Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":7.493,"end":9.023,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."}],"end":9.023},{"key":"CHORUS","start":9.973,"lines":[{"start":9.973,"end":11.703,"text":"Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":12.153,"end":13.685,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."}],"end":13.685},{"key":"2","start":14.635,"lines":[{"start":14.635,"end":18.306,"text":"Aje, oso at'alawirin, sonponna,","marked":"Ajé, ọ̀ṣọ́ àt'aláwìrìn, ṣọ́ǹpọ́nná"},{"start":18.756,"end":20.415,"text":"Irun-Mole ti di 'temole.","marked":"Irun-mole ti di tẹ̀mọ́lẹ̀."},{"start":20.865,"end":21.695,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":21.695},{"key":"3","start":22.645,"lines":[{"start":22.645,"end":23.922,"text":"Awa omo egbe Serafu,","marked":"Àwa ọmọ ẹgbẹ́ Séráfù"},{"start":24.372,"end":26.439,"text":"E mura ka si le te esu mole.","marked":"Ẹ múra ká sì lè tẹ èṣù mọ́lẹ̀."},{"start":26.889,"end":27.743,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":27.743},{"key":"4","start":28.693,"lines":[{"start":28.693,"end":30.078,"text":"Enit' o ro p'on ti duro","marked":"Ẹnit ó rò p'ọ́n ti dúró"},{"start":30.528,"end":32.717,"text":"K'o sora ki o ma ba subu lule.","marked":"K'ó ṣọ́ra kí ó má bá ṣubú lulẹ̀."},{"start":33.167,"end":33.974,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":33.974},{"key":"5","start":34.924,"lines":[{"start":34.924,"end":36.59,"text":"Orin Halleluyah l'ao ko","marked":"Orin Hallelúyà l'áò kọ"},{"start":37.04,"end":39.285,"text":"'Gbati gbogbo idanwo ba koja lo.","marked":"gbàtí gbogbo ìdánwò bá kọjá lọ."},{"start":39.735,"end":40.581,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":40.581},{"key":"6","start":41.531,"lines":[{"start":41.531,"end":43.039,"text":"E f'ogo fun Baba wa l'oke","marked":"Ẹ f'ògo fún Baba wa l'òkè"},{"start":43.489,"end":45.288,"text":"Ka si f'ogo f'Omo Re l'orun.","marked":"Ká sì f'ògo f'Ọmọ Rẹ̀ l'ọ̀run."},{"start":45.738,"end":46.591,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":46.591},{"key":"7","start":47.541,"lines":[{"start":47.541,"end":48.991,"text":"K'a f'ogo fun Emi Mimo","marked":"K'á f'ògo fún Ẹ̀mí Mímọ́"},{"start":49.441,"end":51.267,"text":"Metalokan si l'ope ye fun.","marked":"Mẹ́talọ́kan sì l'ọpẹ́ yẹ fún."},{"start":51.717,"end":52.536,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"}],"end":52.536},{"key":"8","start":53.486,"lines":[{"start":53.486,"end":55.149,"text":"Ogo ni fun, Ogo ni fun","marked":"Ògo ni fún, Ògo ni fún"},{"start":55.599,"end":57.064,"text":"Ogo ni f'Oruko Re.","marked":"Ògo ni f'Orúkọ Rẹ."},{"start":57.514,"end":58.333,"text":"Egbe:  Ogo ni fun...","marked":"Ògo ni fún"},{"start":58.783,"end":59.365,"text":"Amin.","marked":"Àmín."}],"end":59.365}]}