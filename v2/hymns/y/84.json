{"v":2,"coll":"y","num":84,"id":"hymn_84","title":"ENYIN Angeli to wa l'orun","duration":99.955,"voices":{"male":{"file":"y-84-male-v2.m4a","bytes":722806,"sha256":"767544c8d3d67a4c251eb008283d1f8b393fe5e3c7c6c84795b13efa20057a0e","duration":100.0},"female":{"file":"y-84-female-v2.m4a","bytes":755698,"sha256":"521ab78f744e12c5ff10d84f6eaf083046cbee912e0826f34502bfbc69fe9659","duration":100.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.769,"text":"ENYIN Angeli to wa l'orun","marked":"Ẹ̀yin Áńgẹ́lì tó wà l'ọ̀run"},{"start":2.219,"end":3.599,"text":"E fi iyin fun Baba,","marked":"Ẹ fi ìyìn fún Baba"},{"start":4.049,"end":5.895,"text":"F'Egbe to da sile laiye","marked":"F'Ègbé tó dá sílẹ̀ láìyẹ"},{"start":6.345,"end":7.466,"text":"Fun igbala emi,","marked":"Fún ìgbàlà èmi"},{"start":7.916,"end":9.288,"text":"O ye ki inu wa ko dun","marked":"Ó yẹ kí inú wa kò dùn"},{"start":9.738,"end":11.307,"text":"Ki awa ki o si ma yo!","marked":"Kí àwa kí ó sì má yọ̀!"},{"start":11.757,"end":13.2,"text":"Fun iranti lku Jesu","marked":"Fún ìrántí lkú Jésù"},{"start":13.65,"end":14.761,"text":"Lori Agbelebu.","marked":"Lórí Àgbélébùú."}],"end":14.761},{"key":"CHORUS","start":15.711,"lines":[{"start":15.711,"end":17.486,"text":"A pa lase I'agbala orun","marked":"A pa láṣẹ l'àgbàlá ọ̀run"},{"start":17.936,"end":19.439,"text":"Pe k'Egbe yi ma bi si","marked":"Pé k'Ègbé yí má bí sí"},{"start":19.889,"end":21.337,"text":"A pa lase I'agbala orun","marked":"A pa láṣẹ l'àgbàlá ọ̀run"},{"start":21.787,"end":23.448,"text":"Pe O si ma re si;","marked":"Pé Ó sì má rẹ̀ sí"},{"start":23.898,"end":25.358,"text":"Titi gbogbo ifoju okan","marked":"Títí gbogbo ìfọ́jú ọkàn"},{"start":25.808,"end":27.017,"text":"Yio fi tan laiye","marked":"Yóò fi tàn láìyẹ"},{"start":27.467,"end":28.679,"text":"T'iku Jesu Oluwa wa,","marked":"T'ikú Jésù Olúwa wà"},{"start":29.129,"end":30.42,"text":"Ko ni je asan mo.","marked":"Kò ní jẹ́ asán mọ́."}],"end":30.42},{"key":"2","start":31.37,"lines":[{"start":31.37,"end":33.134,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":33.584,"end":34.978,"text":"E fi iyin fun Baba","marked":"Ẹ fi ìyìn fún Baba"},{"start":35.428,"end":36.814,"text":"Ti o da Egbe yi sile,","marked":"Tí ó dá Ẹgbẹ́ yí sílẹ̀"},{"start":37.264,"end":38.536,"text":"Pe k'a le ri igbala,","marked":"Pé k'á lè rí ìgbàlà"},{"start":38.986,"end":40.905,"text":"“Torina, e je k'a mura","marked":"Torina, ẹ jẹ́ k'á múra"},{"start":41.355,"end":42.609,"text":"Lati sare ije yi,","marked":"Láti sáré ìje yí"},{"start":43.059,"end":44.645,"text":"Bi a ba foriti d'opin","marked":"Bí a bá forítì d'òpin"},{"start":45.095,"end":46.486,"text":"Iye y'o je ti wa.","marked":"Iye y'ó jẹ́ ti wá."},{"start":46.936,"end":47.788,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"}],"end":47.788},{"key":"3","start":48.738,"lines":[{"start":48.738,"end":50.766,"text":"Gbogbo ise wa ti a nse,","marked":"Gbogbo iṣẹ́ wa tí a ńṣe"},{"start":51.216,"end":52.442,"text":"Gbogbo iwa ti a nhu,","marked":"Gbogbo ìwà tí a ńhù"},{"start":52.892,"end":54.613,"text":"Gbogbo oro wa ti a nso,","marked":"Gbogbo ọ̀rọ̀ wa tí a ńṣọ́"},{"start":55.063,"end":56.153,"text":"E je k'a ma sora;","marked":"Ẹ jẹ́ k'á má ṣọ́ra"},{"start":56.603,"end":57.843,"text":"Nitori Oluwa yio mu,","marked":"Nítorí Olúwa yóò mú"},{"start":58.293,"end":59.535,"text":"Gbogbo 'se wa si 'dajo","marked":"Gbogbo ṣe wá sí dájọ́"},{"start":59.985,"end":61.377,"text":"Ati gbogbo ohun 'koko","marked":"Àti gbogbo ohun kọ́kọ́"},{"start":61.827,"end":62.996,"text":"Ire tabi ibi.","marked":"Ìre tàbí ibi."},{"start":63.446,"end":64.297,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"}],"end":64.297},{"key":"4","start":65.247,"lines":[{"start":65.247,"end":66.484,"text":"Awa ni imole aiye","marked":"Àwa ní ìmọ́lẹ̀ ayé"},{"start":66.934,"end":68.381,"text":"Lati le okunkun lo,","marked":"Láti lé òkùnkùn lọ"},{"start":68.831,"end":70.033,"text":"Ilu ta te sori oke","marked":"Ìlú ta tẹ́ sórí òkè"},{"start":70.483,"end":71.801,"text":"A ko le fara sin;","marked":"A kò lè fara sin"},{"start":72.251,"end":73.824,"text":"Awa si ni iyo aiye","marked":"Àwa sì ní iyọ̀ ayé"},{"start":74.274,"end":75.449,"text":"Ti a o mu aiye dun","marked":"Tí a ó mú ayé dùn"},{"start":75.899,"end":77.37,"text":"Sugbon b'iyo ba di obu,","marked":"Ṣùgbọ́n b'iyọ̀ bá di obú"},{"start":77.82,"end":78.87,"text":"Bawo ni yio se dun?","marked":"Báwo ni yóò ṣe dùn?"},{"start":79.32,"end":80.101,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"}],"end":80.101},{"key":"5","start":81.051,"lines":[{"start":81.051,"end":82.413,"text":"Ope lo ye Olugbala,","marked":"Ọpẹ́ ló yẹ Olùgbàlà"},{"start":82.863,"end":84.239,"text":"Fun ife to ni si wa,","marked":"Fún ìfẹ́ tó ní sí wa"},{"start":84.689,"end":86.055,"text":"Ti o pe wa si Egbe yi,","marked":"Tí ó pè wá sí Ègbé yí"},{"start":86.505,"end":87.555,"text":"Oko 'gbala 'kehin","marked":"Oko gbàlà kẹhìn"},{"start":88.005,"end":89.827,"text":"Ogo, ola at'agbara","marked":"Ògo, ọlá àt'agbára"},{"start":90.277,"end":91.593,"text":"Ola nla at'ipa","marked":"Ọlá ńlá àt'ipá"},{"start":92.043,"end":94.169,"text":"Ni fun Baba, Omo, Emi","marked":"Ní fún Baba, Ọmọ, Èmi"},{"start":94.619,"end":96.087,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":96.537,"end":97.355,"text":"Egbe:  A pa lase...","marked":"A pa láṣẹ"},{"start":97.805,"end":98.406,"text":"Amin.","marked":"Àmín."}],"end":98.406}]}