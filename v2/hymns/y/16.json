{"v":2,"coll":"y","num":16,"id":"hymn_16","title":"OLUWA, ojo t'o fun wa pin","duration":47.747,"voices":{"male":{"file":"y-16-male-v2.m4a","bytes":339568,"sha256":"29c132da13079977d79a43d46e07a275cd9bdd1c52019d267f55377470e71bd7","duration":47.8},"female":{"file":"y-16-female-v2.m4a","bytes":351618,"sha256":"c41c22a031e0f5a32d9a0ebcd57a23d2cd82211999a2ff5f023676d16085bbdc","duration":47.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.914,"text":"OLUWA, ojo t'o fun wa pin","marked":"Olúwa, ọjọ́ t'ó fún wa pín"},{"start":2.364,"end":3.742,"text":"Okunkun si de l'ase Re,","marked":"Òkùnkùn sì dé l'àṣẹ Rẹ̀"},{"start":4.192,"end":5.85,"text":"'Wo l'a korin owuro wa si,","marked":"wò l'á kọrin òwúrọ̀ wá sí"},{"start":6.3,"end":7.83,"text":"Iyin Re y'o m'ale wa dun.","marked":"Ìyìn Rẹ̀ y'ó m'alẹ̀ wá dùn."}],"end":7.83},{"key":"2","start":8.78,"lines":[{"start":8.78,"end":10.966,"text":"A dupe ti Ijo Re ko nsun,","marked":"A dúpẹ́ tí Ìjọ Rẹ̀ kò ńsùn"},{"start":11.416,"end":13.191,"text":"B'aiye ti nyi lo s'imole","marked":"B'ayé ti nyí lọ s'ìmọ́lẹ̀"},{"start":13.641,"end":15.671,"text":"O si nsona ti gbogbo aiye","marked":"Ó sì ńṣọ́nà ti gbogbo ayé"},{"start":16.121,"end":17.724,"text":"Ko simi tosan-toru.","marked":"Kò ṣimí tosan-toru."}],"end":17.724},{"key":"3","start":18.674,"lines":[{"start":18.674,"end":20.44,"text":"B'ile si ti mo lojujumo","marked":"B'ilẹ̀ sì ti mọ̀ lójújúmọ́"},{"start":20.89,"end":22.521,"text":"Ni orile at'ekusu","marked":"Ní orílẹ̀ àt'èkùṣù"},{"start":22.971,"end":24.307,"text":"Ohun adura ko dake ri,","marked":"Ohun àdúrà kò dákẹ́ rí"},{"start":24.757,"end":26.266,"text":"Be l'orin iyin ko dekun.","marked":"Bẹ́ l'orin ìyìn kò dẹ́kun."}],"end":26.266},{"key":"4","start":27.216,"lines":[{"start":27.216,"end":29.359,"text":"Orun t'o wo fun wa, si ti la","marked":"Ọ̀run t'ó wò fún wa, sì ti là"},{"start":29.809,"end":31.033,"text":"S'awon eda iwo-orun","marked":"S'àwọn ẹ̀dá iwo-orun"},{"start":31.483,"end":32.923,"text":"Nigbakugba li enu si nso","marked":"Nígbàkúgbà lí ẹnu sì ńṣọ́"},{"start":33.373,"end":34.687,"text":"Ise 'yanu Re di mimo.","marked":"Iṣẹ́ yanu Rẹ̀ di mímọ́."}],"end":34.687},{"key":"5","start":35.637,"lines":[{"start":35.637,"end":38.194,"text":"Be, Oluwa, lai n'ijoba Re,","marked":"Bẹ̀, Olúwa, láì n'ìjọba Rẹ̀"},{"start":38.644,"end":40.126,"text":"Ko dabi ijoba aiye","marked":"Kò dàbí ìjọba ayé"},{"start":40.576,"end":43.152,"text":"O duro, o si nse akoso","marked":"Ó dúró, ó sì ńṣe àkóso"},{"start":43.602,"end":45.125,"text":"Tit' eda Re o juba Re.","marked":"Tít ẹ̀dà Rẹ̀ ò júbà Rẹ̀."},{"start":45.575,"end":46.198,"text":"Amin.","marked":"Àmín."}],"end":46.198}]}