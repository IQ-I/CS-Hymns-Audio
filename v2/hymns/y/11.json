{"v":2,"coll":"y","num":11,"id":"hymn_11","title":"K'A to sun, Olugbala wa","duration":51.816,"voices":{"male":{"file":"y-11-male-v2.m4a","bytes":361835,"sha256":"fce7fbd2755abb3681f46e1b51dc96155e9942bd1689825799493304c3216e5d","duration":51.9},"female":{"file":"y-11-female-v2.m4a","bytes":372993,"sha256":"617d5c6736bfbd655f22eefaa140f318209d50bdb1c6f093ceb037c735fbe076","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.474,"text":"K'A to sun, Olugbala wa,","marked":"K'á tó sùn, Olùgbàlà wa"},{"start":2.924,"end":4.56,"text":"Fun wa n'ibukun ale,","marked":"Fún wa n'ìbùkún alẹ́"},{"start":5.01,"end":6.227,"text":"A jewo ese fun O,","marked":"A jẹ́wọ́ ẹ̀ṣẹ̀ fún Ọ"},{"start":6.677,"end":8.014,"text":"Iwo lo le gba wa la.","marked":"Ìwọ ló lè gbà wá là."}],"end":8.014},{"key":"2","start":8.964,"lines":[{"start":8.964,"end":10.56,"text":"B'ile tile ti su dudu","marked":"B'ilẹ̀ tilẹ̀ ti ṣú dúdú"},{"start":11.01,"end":12.484,"text":"Okun ko le se wa mo","marked":"Okùn kò lè ṣe wá mọ́"},{"start":12.934,"end":14.187,"text":"Iwo eniti ki sare,","marked":"Ìwọ ẹnití kí sáré"},{"start":14.637,"end":15.91,"text":"Nso awon enia Re.","marked":"Ǹṣọ́ àwọn ẹnìà Rẹ."}],"end":15.91},{"key":"3","start":16.86,"lines":[{"start":16.86,"end":18.367,"text":"B'iparun tile yi wa ka,","marked":"B'ìparun tilẹ̀ yí wa ká"},{"start":18.817,"end":20.153,"text":"Ti ofa nfo wa koja","marked":"Tí ọfà ńfọ̀ wá kọjá"},{"start":20.603,"end":21.872,"text":"Awon Angeli yi wa ka,","marked":"Àwọn Áńgẹ́lì yí wa ká"},{"start":22.322,"end":23.617,"text":"Awa o wa l'ailewu.","marked":"Àwa ó wà l'áìléwu."}],"end":23.617},{"key":"4","start":24.567,"lines":[{"start":24.567,"end":26.24,"text":"Sugbon b'iku ba ji wa pa,","marked":"Ṣùgbọ́n b'ikú bá jí wa pa"},{"start":26.69,"end":28.034,"text":"Ti busun wa d'iboji","marked":"Ti bùsùn wá d'ibojì"},{"start":28.484,"end":30.081,"text":"Je k' ile mo wa sodo Re,","marked":"Jẹ́ k ilẹ̀ mo wá sọ́dọ̀ Rẹ"},{"start":30.531,"end":32.006,"text":"L' ayo at' alafia.","marked":"L ayọ̀ àt àlàáfíà."}],"end":32.006},{"key":"5","start":32.956,"lines":[{"start":32.956,"end":34.816,"text":"N'irele awa f'ara wa,","marked":"N'ìrẹ̀lẹ̀ àwa f'ara wa"},{"start":35.266,"end":37.277,"text":"Sabe abo Re, Baba","marked":"Sábẹ́ abo Rẹ, Baba"},{"start":37.727,"end":40.141,"text":"Jesu, 'Wo t'osun bi awa","marked":"Jésù, wò t'osùn bí àwa"},{"start":40.591,"end":42.02,"text":"Se orun wa bi Tire.","marked":"Ṣe ọ̀run wà bí Tire."}],"end":42.02},{"key":"6","start":42.97,"lines":[{"start":42.97,"end":44.206,"text":"Emi Mimo rado bo wa,","marked":"Ẹ̀mí Mímọ́ rádọ̀ bọ̀ wá"},{"start":44.656,"end":45.815,"text":"Tan 'mole s'okunkun wa,","marked":"Tan mọ́lẹ̀ s'òkùnkùn wà"},{"start":46.265,"end":47.498,"text":"Tit'awa o fi ri ojo","marked":"Tít'àwa ó fi rí ọjọ́"},{"start":47.948,"end":49.187,"text":"Imole aiyeraiye.","marked":"Ìmọ́lẹ̀ ayérayé."},{"start":49.637,"end":50.267,"text":"Amin.","marked":"Àmín."}],"end":50.267}]}