{"v":2,"coll":"y","num":27,"id":"hymn_27","title":"GBOGBO enyin ar'a niye","duration":81.225,"voices":{"male":{"file":"y-27-male-v2.m4a","bytes":580250,"sha256":"a7ac6a7f8de4f0aede40dea9b2bdc96cc862d42efe9919f7ea26d42d8b5d37f7","duration":81.3},"female":{"file":"y-27-female-v2.m4a","bytes":591396,"sha256":"17f8a5a29081db5301a6e54e41f818befe81de816a974a56bc0ffa925394f150","duration":81.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.11,"text":"GBOGBO enyin ar'a niye","marked":"Gbogbo ẹ̀yin ar'a níye"},{"start":2.56,"end":3.69,"text":"To mb' ojo simi je","marked":"Tó mb ọjọ́ sími jẹ́"},{"start":4.14,"end":5.406,"text":"At' enyin alaigboran","marked":"Àt ẹ̀yin aláìgbọ́ràn"},{"start":5.856,"end":7.014,"text":"Ti mb' ojo simi je,","marked":"Tí mb ọjọ́ sími jẹ́"},{"start":7.464,"end":8.74,"text":"Oluwa ran wa si nyin","marked":"Olúwa rán wa sì yín"},{"start":9.19,"end":10.294,"text":"Gegeb' alore Re,","marked":"Gẹ́gẹ́b alóre Rẹ"},{"start":10.744,"end":12.354,"text":"Lati kede fun araiye","marked":"Láti kéde fún aráìyè"},{"start":12.804,"end":14.089,"text":"P’ Oluwa mbo Kankan.","marked":"P Olúwa mbọ́ Kankan."}],"end":14.089},{"key":"CHORUS","start":15.039,"lines":[{"start":15.039,"end":16.515,"text":"Enyin Egbe kerubu","marked":"Ẹ̀yin Ẹgbẹ́ Kérúbù"},{"start":16.965,"end":18.084,"text":"E mase jafara","marked":"Ẹ máṣe jáfara"},{"start":18.534,"end":19.629,"text":"Enyin Egbe Serafu","marked":"Ẹ̀yin Ẹgbẹ́ Séráfù"},{"start":20.079,"end":21.313,"text":"E d' amure giri","marked":"Ẹ d àmùrè gírí"}],"end":21.313},{"key":"2","start":22.263,"lines":[{"start":22.263,"end":23.569,"text":"Oluwa binu s' aiye","marked":"Olúwa bínú s ayé"},{"start":24.019,"end":25.378,"text":"Eda ko Kiyesi","marked":"Ẹ̀dà kò Kíyèsi"},{"start":25.828,"end":26.868,"text":"Awon to ti ni lowo","marked":"Àwọn tó ti ní lọ́wọ́"},{"start":27.318,"end":28.923,"text":"Nwon deni ti ko ni","marked":"Wọ́n dẹni tí kò ní"},{"start":29.373,"end":30.516,"text":"Ode 'Badan wa kede","marked":"Òde bádán wá kéde"},{"start":30.966,"end":32.003,"text":"Oro t' Angeli so","marked":"Ọ̀rọ̀ t Áńgẹ́lì sọ"},{"start":32.453,"end":34.212,"text":"Sugbon kaka k'a yi pada","marked":"Ṣùgbọ́n kàkà k'á yí padà"},{"start":34.662,"end":35.895,"text":"A nri Sinu ese","marked":"A ńrí Sínú ẹ̀ṣẹ̀"}],"end":35.895},{"key":"3","start":36.845,"lines":[{"start":36.845,"end":37.985,"text":"Keferi e yi pada","marked":"Kèfèrí ẹ yí padà"},{"start":38.435,"end":39.759,"text":"At' enyin Imale","marked":"Àt ẹ̀yin Ìmàlẹ̀"},{"start":40.209,"end":41.432,"text":"At' awon Onigbagbo","marked":"Àt àwọn Onígbàgbọ́"},{"start":41.882,"end":43.078,"text":"T' o jebi oro na,","marked":"T ó jẹ̀bi ọ̀rọ̀ ná"},{"start":43.528,"end":44.96,"text":"E wa ka jo gbadura,","marked":"Ẹ wá ká jọ gbàdúrà"},{"start":45.41,"end":46.7,"text":"K' a be Baba Mimo","marked":"K a bẹ Baba Mímọ́"},{"start":47.15,"end":48.631,"text":"K' a teriba niwaju Re,","marked":"K á tẹríba níwájú Rẹ̀"},{"start":49.081,"end":50.201,"text":"Yio dariji wa","marked":"Yóò dáríjì wá"}],"end":50.201},{"key":"4","start":51.151,"lines":[{"start":51.151,"end":52.538,"text":"Alanu ni Oluwa","marked":"Aláǹu ni Olúwa"},{"start":52.988,"end":54.133,"text":"Eleti gb' aroye","marked":"Elétí gb àròyé"},{"start":54.583,"end":55.875,"text":"Bi a ba yipada si","marked":"Bí a bá yípadà sí"},{"start":56.325,"end":57.763,"text":"y' o yipada si wa,","marked":"y ó yípadà sí wa"},{"start":58.213,"end":59.334,"text":"Ka p' ojo Oluwa mo,","marked":"Ká p ọjọ́ Olúwa mọ́"},{"start":59.784,"end":60.838,"text":"Gege bi ase Re,","marked":"Gẹ́gẹ́ bí àṣẹ Rẹ"},{"start":61.288,"end":63.327,"text":"Y' o si ferese Re l'orun","marked":"Y ó sì fèrèsé Rẹ̀ l'ọ̀run"},{"start":63.777,"end":64.935,"text":"Igba rere yio de","marked":"Ìgbà rere yóò dé"}],"end":64.935},{"key":"5","start":65.885,"lines":[{"start":65.885,"end":67.475,"text":"Nje t’ a ba si pe wa","marked":"Ǹjẹ́ t a bá sì pè wá"},{"start":67.925,"end":69.246,"text":"Lati faiye sile,","marked":"Láti fàìyè sílẹ̀"},{"start":69.696,"end":71.021,"text":"T' a rekoja odo na,","marked":"T a rékọjá odò ná"},{"start":71.471,"end":72.604,"text":"Odo tutu iku","marked":"Odò tútù ikú"},{"start":73.054,"end":74.283,"text":"Olorun Eleda wa","marked":"Ọlọ́run Ẹlẹ́dàá wa"},{"start":74.733,"end":76.014,"text":"Ma je k' oju ti wa","marked":"Má jẹ́ k ojú ti wá"},{"start":76.464,"end":77.79,"text":"Mu wa d' prun Alafia","marked":"Mú wa d prun Àlàáfíà"},{"start":78.24,"end":79.676,"text":"K'a ba O gbe titi.","marked":"K'á bá Ọ gbé títí."}],"end":79.676}]}