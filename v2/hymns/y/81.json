{"v":2,"coll":"y","num":81,"id":"hymn_81","title":"E YO nin'Oluwa, e yo","duration":59.039,"voices":{"male":{"file":"y-81-male-v2.m4a","bytes":416209,"sha256":"a584b0fecbd188c0180659a4902e87969bd1b3f5fac3fab1544b34fca36cced4","duration":59.1},"female":{"file":"y-81-female-v2.m4a","bytes":433359,"sha256":"326ab7997680048925fc4bf5c6f8e1033d050bb82870099fe8eefb0f0c160dd6","duration":59.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.106,"text":"E YO nin'Oluwa, e yo","marked":"Ẹ Yọ̀ nín'olúwa, ẹ yọ̀"},{"start":2.556,"end":3.758,"text":"enyin olokan diduro","marked":"ẹ̀yin ọlọ́kàn dídúró"},{"start":4.208,"end":6.296,"text":"At'enyin t'ase l'ayanfe","marked":"Àt'ẹnyin t'àṣẹ l'àyànfẹ́"},{"start":6.746,"end":8.455,"text":"Mu 'banuje kuro l'okan nyin.","marked":"Mú banújẹ́ kúrò l'ọkàn yín."}],"end":8.455},{"key":"CHORUS","start":9.405,"lines":[{"start":9.405,"end":12.029,"text":"E yo, e yo, e yo nin' Oluwa,","marked":"Ẹ yọ̀, ẹ yọ̀, ẹ yọ̀ nín Olúwa"},{"start":12.479,"end":13.032,"text":"e yo. 2ce","marked":"ẹ yọ̀."}],"end":13.032},{"key":"2","start":13.982,"lines":[{"start":13.982,"end":15.48,"text":"E yo n'tori On l'Oluwa,","marked":"Ẹ yọ̀ n'torí Ọn l'Olúwa"},{"start":15.93,"end":17.713,"text":"L' aiye ati l'orun pelu","marked":"L ayé àti l'ọ̀run pẹ̀lú"},{"start":18.163,"end":19.682,"text":"O njoba nipa ase Re,","marked":"Ó ǹjọba nípa àṣẹ Rẹ̀"},{"start":20.132,"end":21.593,"text":"O l'agbara lati gbala.","marked":"Ó l'agbára láti gbàlà."},{"start":22.043,"end":23.597,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yọ̀, ẹ yọ̀"}],"end":23.597},{"key":"3","start":24.547,"lines":[{"start":24.547,"end":26.044,"text":"Nigbati ogun ba gbona","marked":"Nígbàtí ogun bá gbóná"},{"start":26.494,"end":27.87,"text":"T'ota ba fere segun nyin","marked":"T'ọ̀tá bá fèrè ṣẹ́gun yín"},{"start":28.32,"end":30.235,"text":"Ogun Jesu ti a ko ri,","marked":"Ogun Jésù tí a kò rí"},{"start":30.685,"end":32.246,"text":"Po ju gbogbo otan nyin lo.","marked":"Pọ̀ ju gbogbo ọ̀tán yín lọ."},{"start":32.696,"end":34.355,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yọ̀, ẹ yọ̀"}],"end":34.355},{"key":"4","start":35.305,"lines":[{"start":35.305,"end":36.888,"text":"B'osan d'orun mo nyin loju,","marked":"B'ọ̀sán d'ọ̀run mo yín lójú"},{"start":37.338,"end":38.81,"text":"T'okunkun re nderu ba nyin","marked":"T'òkùnkùn rẹ̀ ńdẹ́rù bá yín"},{"start":39.26,"end":40.936,"text":"E ma je k'okan nyin baje","marked":"Ẹ má jẹ́ k'ọkàn yín bàjẹ́"},{"start":41.386,"end":43.202,"text":"Gbekele tit' ewu yio tan.","marked":"Gbẹ́kẹ̀lé tít ewu yóò tán."},{"start":43.652,"end":45.418,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yọ̀, ẹ yọ̀"}],"end":45.418},{"key":"5","start":46.368,"lines":[{"start":46.368,"end":48.043,"text":"E yo nin'Oluwa, e yo","marked":"Ẹ yọ̀ nín'olúwa, ẹ yọ̀"},{"start":48.493,"end":50.0,"text":"E f'orin didun yin logo","marked":"Ẹ f'orin dídùn yín lógo"},{"start":50.45,"end":52.512,"text":"Fi duru, fere, at'ohun","marked":"Fi dùrù, fèrè, àt'ohun"},{"start":52.962,"end":54.48,"text":"Korin Halleluyah kikan.","marked":"Kọrin Hallelúyà kíkan."},{"start":54.93,"end":56.389,"text":"Egbe:  E yo, e yo...","marked":"Ẹ yọ̀, ẹ yọ̀"},{"start":56.839,"end":57.49,"text":"Amin.","marked":"Àmín."}],"end":57.49}]}