{"v":2,"coll":"y","num":106,"id":"hymn_106","title":"YIN Oluwa, enyin mimo","duration":43.551,"voices":{"male":{"file":"y-106-male-v2.m4a","bytes":301253,"sha256":"42c0e82c12256e9662fe6b1eb96c1b5946078aebda45639a0b43bb3267541fec","duration":43.6},"female":{"file":"y-106-female-v2.m4a","bytes":309749,"sha256":"25d4008ed63f4179381c4993fb2b6d702be755dfaf3aa5bc85d580c01f6c308c","duration":43.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.79,"text":"YIN Oluwa, enyin mimo","marked":"Yín Olúwa, ẹ̀yin mímọ́"},{"start":2.24,"end":3.667,"text":"Awa ti je ni 'gbese to?","marked":"Àwa ti jẹ́ ní gbèsè tó?"},{"start":4.117,"end":5.424,"text":"Je k'a mu gbogbo ini wa","marked":"Jẹ́ k'á mú gbogbo ìní wá"},{"start":5.874,"end":6.89,"text":"Wa pelu ayo.","marked":"Wá pẹ̀lú ayọ̀."}],"end":6.89},{"key":"2","start":7.84,"lines":[{"start":7.84,"end":9.407,"text":"Jesus l'Oko t'o dara ju","marked":"Jésù l'Oko t'ó dára jù"},{"start":9.857,"end":11.525,"text":"O nfun wa l'okun l'oju 'ja","marked":"Ó ńfún wa l'òkun l'ojú jà"},{"start":11.975,"end":13.303,"text":"lbi kan ko le de ba wa","marked":"lbí kan kò lè dé bá wa"},{"start":13.753,"end":14.962,"text":"'Gbat' a gbekele.","marked":"gbàt a gbẹ́kẹ̀lé."}],"end":14.962},{"key":"3","start":15.912,"lines":[{"start":15.912,"end":17.829,"text":"Gbekele yin le, eyin mimo","marked":"Gbẹ́kẹ̀lé yín lé, ẹ̀yin mímọ́"},{"start":18.279,"end":19.543,"text":"Olododo l'Olorun wa","marked":"Olódodo l'Ọlọ́run wa"},{"start":19.993,"end":22.545,"text":"Ko s'ohun to le, ya awon","marked":"Kò s'ohun tó le, ya àwọn"},{"start":22.995,"end":24.261,"text":"T'O fe l'odo Re.","marked":"T'ó fẹ́ l'ọ̀dọ̀ Rẹ."}],"end":24.261},{"key":"4","start":25.211,"lines":[{"start":25.211,"end":26.577,"text":"F'ore ofe Re pa wa mo","marked":"F'oore ọ̀fẹ́ Rẹ pa wá mọ́"},{"start":27.027,"end":28.471,"text":"K'a le tubo faramo O","marked":"K'á lè túbọ̀ faramọ́ Ọ"},{"start":28.921,"end":30.495,"text":"Titi ao fi de 'nu ogo","marked":"Títí àó fi dé nù ògo"},{"start":30.945,"end":32.155,"text":"At' ayo l'orun.","marked":"Àt ayọ̀ l'ọ̀run."}],"end":32.155},{"key":"5","start":33.105,"lines":[{"start":33.105,"end":34.571,"text":"'Gbana l' ao de ibi mimo","marked":"gbáná l àó dé ibi mímọ́"},{"start":35.021,"end":36.835,"text":"'Gbana l'a o si di mimo","marked":"gbàná l'a ó sì di mímọ́"},{"start":37.285,"end":39.104,"text":"Ayo nla ti a ko so","marked":"Ayọ̀ ńlá tí a kò sọ"},{"start":39.554,"end":40.922,"text":"Ni y'o je ti wa.","marked":"Ní y'ó jẹ́ ti wá."},{"start":41.372,"end":42.002,"text":"Amin.","marked":"Àmín."}],"end":42.002}]}