{"v":2,"coll":"y","num":42,"id":"hymn_42","title":"IWO t'o nmu okan mole","duration":53.491,"voices":{"male":{"file":"y-42-male-v2.m4a","bytes":380778,"sha256":"a5e0d3548f4446b15614729bf5edb02f8d6b75231be0688cc508e46681445efd","duration":53.5},"female":{"file":"y-42-female-v2.m4a","bytes":392591,"sha256":"68d8fdf871ea39de00c668b5cc9d897f09488c3d0d4c53654d9dd306a5d03bbd","duration":53.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.692,"text":"IWO t'o nmu okan mole","marked":"Ìwọ t'ó ńmú ọkàn mọ́lẹ̀"},{"start":2.142,"end":3.52,"text":"Nipa 'mole atorunwa","marked":"Nípa mọ́lẹ̀ àtọ̀runwá"},{"start":3.97,"end":5.175,"text":"T'o si nse iri ibukun","marked":"T'ó sì ńṣe ìrì ìbùkún"},{"start":5.625,"end":7.2,"text":"Sor'awon ti nsaferi Re.","marked":"Sọ́r'àwọn ti ńṣàfẹ́rí Rẹ."}],"end":7.2},{"key":"2","start":8.15,"lines":[{"start":8.15,"end":9.508,"text":"Jo masai fi ibukun Re,","marked":"Jọ maṣai fi ìbùkún Rẹ̀"},{"start":9.958,"end":11.623,"text":"Fun oluko at'akeko","marked":"Fún olùkọ́ àt'akẹ́kọ́"},{"start":12.073,"end":13.372,"text":"Ki ljo Re le je mimo","marked":"Kí ljọ Rẹ lè jẹ́ mímọ́"},{"start":13.822,"end":15.115,"text":"K'atupa re ma jo gere.","marked":"K'àtùpá rẹ̀ má jọ gẹ́rẹ́."}],"end":15.115},{"key":"3","start":16.065,"lines":[{"start":16.065,"end":17.47,"text":"F'okan mimo fun oluko,","marked":"F'ọkàn mímọ́ fún olùkọ́"},{"start":17.92,"end":20.149,"text":"Igbagbo, 'reti, at'ife","marked":"Ìgbàgbọ́, retí, àt'ìfẹ́"},{"start":20.599,"end":22.165,"text":"Ki nwon j'enit' lwo ti ko","marked":"Kí wọ́n j'ẹnit lwò tí kò"},{"start":22.615,"end":24.115,"text":"Ki nwon le j'oluko rere.","marked":"Kí wọ́n lè j'olùkọ́ rere."}],"end":24.115},{"key":"4","start":25.065,"lines":[{"start":25.065,"end":26.541,"text":"F'eti igboran f'akeko","marked":"F'etí ìgbọ́ràn f'akẹ́kọ́"},{"start":26.991,"end":28.5,"text":"Okan 'rele at'aitetan","marked":"Ọkàn rẹlẹ̀ àt'àìtẹ̀tàn"},{"start":28.95,"end":31.045,"text":"Talaka to kun f'ebun yi,","marked":"Tálákà tó kún f'ẹ̀bùn yí"},{"start":31.495,"end":33.005,"text":"San ju oba aiye yi lo.","marked":"Sàn ju ọba ayé yí lọ."}],"end":33.005},{"key":"5","start":33.955,"lines":[{"start":33.955,"end":36.017,"text":"Buk'oluso: buk'agutan,","marked":"Bùk'olùṣọ́: bùk'àgùtàn"},{"start":36.467,"end":37.876,"text":"Ki nwon j'okan labe 'so Re,","marked":"Kí wọ́n j'ọkàn lábẹ́ sọ Rẹ"},{"start":38.326,"end":39.716,"text":"Ki nwon ma f'okan kan sona,","marked":"Kí wọ́n má f'ọkàn kan ṣọ́nà"},{"start":40.166,"end":41.699,"text":"Tit' aiye osi yi y'o pin.","marked":"Tít ayé òsì yí y'ó pín."}],"end":41.699},{"key":"6","start":42.649,"lines":[{"start":42.649,"end":44.495,"text":"Baba, b'awa ba n'ore Re,","marked":"Baba, b'àwa bá n'ọrẹ Rẹ"},{"start":44.945,"end":46.83,"text":"Laiye yi l'a ti l'ogo","marked":"Láìyẹ́ yí l'a ti l'ògo"},{"start":47.28,"end":48.713,"text":"K'a to koja s'oke orun","marked":"K'á tó kọjá s'ókè ọ̀run"},{"start":49.163,"end":50.885,"text":"L'ao mo ohun ti aiku je.","marked":"L'áò mọ ohun tí àìkú jẹ́."},{"start":51.335,"end":51.942,"text":"Amin.","marked":"Àmín."}],"end":51.942}]}