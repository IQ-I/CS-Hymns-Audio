{"v":2,"coll":"y","num":31,"id":"hymn_31","title":"Bi mo ti yo lati gb'oro","duration":49.066,"voices":{"male":{"file":"y-31-male-v2.m4a","bytes":340877,"sha256":"55d86e800a1ea07d82261d90e80f121c690d470f57153f9e812996a29a460dea","duration":49.1},"female":{"file":"y-31-female-v2.m4a","bytes":354806,"sha256":"90098712beada9dc238d61ff4d4f646c55b4a9aa2aad818f75cfe8645b4461b4","duration":49.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.935,"text":"Bi mo ti yo lati gb'oro","marked":"Bí mo ti yọ̀ láti gb'ọ̀rọ̀"},{"start":2.385,"end":3.325,"text":"Lenu awon ore,","marked":"Lẹ́nu àwọn ọ̀rẹ́"},{"start":3.775,"end":5.633,"text":"Pe, 'Ni Sion ni k'a pe si","marked":"Pé, ní Sion ni k'á pè sí"},{"start":6.083,"end":7.335,"text":"K'a p'ojo mimo mo.","marked":"K'á p'ọjọ́ mímọ́ mọ́."}],"end":7.335},{"key":"2","start":8.285,"lines":[{"start":8.285,"end":9.683,"text":"Mo f'onata at'ekun re","marked":"Mo f'ọ̀nàtà àt'ẹkùn rẹ̀"},{"start":10.133,"end":11.381,"text":"Ile t'a se loso","marked":"Ilẹ̀ t'á ṣe lọ́ṣọ́"},{"start":11.831,"end":13.259,"text":"lle t'a ko fun Olorun","marked":"llè t'a kọ́ fún Ọlọ́run"},{"start":13.709,"end":14.915,"text":"Lati fi anu han.","marked":"Láti fi àánú hàn."}],"end":14.915},{"key":"3","start":15.865,"lines":[{"start":15.865,"end":17.696,"text":"S'agala ile ayo na","marked":"S'àgàlà ilé ayọ̀ ná"},{"start":18.146,"end":19.321,"text":"Leya mimo si lo","marked":"Lẹ́yà mímọ́ sì lọ"},{"start":19.771,"end":21.6,"text":"Omo Dafidi wa lor'ite","marked":"Ọmọ Dafidi wà lór'ìtẹ́"},{"start":22.05,"end":23.346,"text":"O nda ejo nibe.","marked":"Ó ńda ẹjọ́ níbẹ̀."}],"end":23.346},{"key":"4","start":24.296,"lines":[{"start":24.296,"end":25.726,"text":"O gbo iyin at'igbe wa;","marked":"Ó gbọ́ ìyìn àt'ìgbẹ́ wa"},{"start":26.176,"end":27.125,"text":"Bi ohun eru re,","marked":"Bí ohun ẹ̀rù rẹ"},{"start":27.575,"end":29.111,"text":"Ti nya elese sib'egbe","marked":"Ti ńyá ẹlẹ́ṣẹ̀ síb'ẹgbẹ́"},{"start":29.561,"end":30.748,"text":"A nyo ni 'wariri.","marked":"A ǹyọ ni wárìrì."}],"end":30.748},{"key":"5","start":31.698,"lines":[{"start":31.698,"end":33.282,"text":"K' ibukun pelu ibe na,","marked":"K ìbùkún pẹ̀lú ibẹ̀ ná"},{"start":33.732,"end":35.045,"text":"Ayo nigbakugba","marked":"Ayọ̀ nígbàkúgbà"},{"start":35.495,"end":37.26,"text":"K'a fi ore ati ore","marked":"K'á fi ọrẹ àti ọrẹ"},{"start":37.71,"end":38.919,"text":"F'awon ti nsin nibe.","marked":"F'àwọn tí ńṣìn níbẹ̀."}],"end":38.919},{"key":"6","start":39.869,"lines":[{"start":39.869,"end":41.312,"text":"Okan mi bebe fun Sion","marked":"Ọkàn mi bẹ̀bẹ̀ fún Sion"},{"start":41.762,"end":42.826,"text":"Nigbati emi wa;","marked":"Nígbàtí èmi wà"},{"start":43.276,"end":44.85,"text":"Nibe n'ibatan at'ore","marked":"Níbẹ̀ n'ìbátan àt'ọrẹ"},{"start":45.3,"end":46.422,"text":"At'olugbala wa.","marked":"Àt'olùgbàlà wa."},{"start":46.872,"end":47.517,"text":"Amin.","marked":"Àmín."}],"end":47.517}]}