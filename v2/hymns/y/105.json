{"v":2,"coll":"y","num":105,"id":"hymn_105","title":"EJE ka f'inu didun","duration":40.885,"voices":{"male":{"file":"y-105-male-v2.m4a","bytes":279022,"sha256":"cc9f229c404cbbf0a14b4caf1eef7c75e3c9e3b8ba07481c3ef6601a2b199972","duration":40.9},"female":{"file":"y-105-female-v2.m4a","bytes":285188,"sha256":"5a60191ef6375ea04215a91b0860c70521994fa9338447e16bcad480a971f0b7","duration":40.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.584,"text":"EJE ka f'inu didun","marked":"Ẹ̀jẹ̀ ká f'inú dídùn"},{"start":2.034,"end":3.303,"text":"Yin Oluwa Olore,","marked":"Yín Olúwa Ọlọ́rẹ"},{"start":3.753,"end":5.25,"text":"Anu Re o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":5.7,"end":6.965,"text":"L'ododo dajudaju.","marked":"L'òdodo dájúdájú."}],"end":6.965},{"key":"2","start":7.915,"lines":[{"start":7.915,"end":9.907,"text":"On, nipa agbara Re","marked":"Ọ̀n, nípa agbára Rẹ"},{"start":10.357,"end":11.931,"text":"F'imole s'aiye titun","marked":"F'ìmọ́lẹ̀ s'ayé titun"},{"start":12.381,"end":13.948,"text":"Anu Re o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":14.398,"end":15.65,"text":"L'ododo dajudaju.","marked":"L'òdodo dájúdájú."}],"end":15.65},{"key":"3","start":16.6,"lines":[{"start":16.6,"end":17.944,"text":"O mbo awon alaini","marked":"Ó mbọ̀ àwọn aláìní"},{"start":18.394,"end":19.672,"text":"Ati gbogbo alaye","marked":"Àti gbogbo àlàyé"},{"start":20.122,"end":21.621,"text":"Anu Re o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":22.071,"end":23.356,"text":"L'ododo dajudaju.","marked":"L'òdodo dájúdájú."}],"end":23.356},{"key":"4","start":24.306,"lines":[{"start":24.306,"end":25.613,"text":"O mbukun ayanfe Re,","marked":"Ó mbùkún àyànfẹ́ Rẹ̀"},{"start":26.063,"end":27.346,"text":"Li aginji aiye yi","marked":"Lí aginjì ayé yí"},{"start":27.796,"end":29.223,"text":"Anu Re o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":29.673,"end":30.827,"text":"L'ododo dajudaju.","marked":"L'òdodo dájúdájú."}],"end":30.827},{"key":"5","start":31.777,"lines":[{"start":31.777,"end":32.99,"text":"E je ka f'inu didun","marked":"Ẹ jẹ́ ká f'inú dídùn"},{"start":33.44,"end":34.505,"text":"Yin Oluwa Olore;","marked":"Yín Olúwa Ọlọ́rẹ"},{"start":34.955,"end":36.626,"text":"Anu Re o wa titi,","marked":"Àánú Rẹ̀ ó wà títí"},{"start":37.076,"end":38.348,"text":"L'ododo dajudaju.","marked":"L'òdodo dájúdájú."},{"start":38.798,"end":39.336,"text":"Amin.","marked":"Àmín."}],"end":39.336}]}