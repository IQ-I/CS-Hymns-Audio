{"v":2,"coll":"y","num":35,"id":"hymn_35","title":"OLUWA ojo isimi","duration":38.543,"voices":{"male":{"file":"y-35-male-v2.m4a","bytes":274321,"sha256":"9572b4142e6348eb8f356bc3d489a4566d18540c4fe14c03d38a37d62950a98b","duration":38.6},"female":{"file":"y-35-female-v2.m4a","bytes":284826,"sha256":"1633d817dcb82317c944afe6c77c45ea6506936e4389155e4eaade460c7f9a44","duration":38.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.647,"text":"OLUWA ojo isimi,","marked":"Olúwa ọjọ́ ìṣímí"},{"start":2.097,"end":3.983,"text":"Gbo tiwa, pelu wa loni","marked":"Gbọ́ tiwa, pẹ̀lú wa lónì"},{"start":4.433,"end":5.85,"text":"Awa pade fun adura","marked":"Àwa pàdé fún àdúrà"},{"start":6.3,"end":7.955,"text":"A fe gb'oro T'o fi fun wa.","marked":"A fẹ́ gb'ọ̀rọ̀ T'ó fi fún wa."}],"end":7.955},{"key":"2","start":8.905,"lines":[{"start":8.905,"end":10.465,"text":"Isimi t'aiye yi rorun","marked":"Ìṣímí t'ayé yí rọrùn"},{"start":10.915,"end":12.49,"text":"Sugbon isimi t'orun dun","marked":"Ṣùgbọ́n ìṣímí t'ọ̀run dùn"},{"start":12.94,"end":14.407,"text":"Lala okan wa fe 'jo na","marked":"Lálà ọkàn wa fẹ́ jọ ná"},{"start":14.857,"end":16.483,"text":"T'a o simi lailese da.","marked":"T'á ò ṣimí láìlẹ́sẹ̀ dá."}],"end":16.483},{"key":"3","start":17.433,"lines":[{"start":17.433,"end":19.419,"text":"Ko s'ija, ko si 'dagiri","marked":"Kò s'ìjà, kò sì dàgìrì"},{"start":19.869,"end":21.828,"text":"Ko s'aniyan bi t'aiye yi","marked":"Kò s'àníyàn bí t'ayé yí"},{"start":22.278,"end":24.132,"text":"T'y'o dapo mo ikorin wa,","marked":"T'y'ó dàpọ̀ mọ́ ìkọrin wa"},{"start":24.582,"end":26.106,"text":"T'o nt'ete aiku jade wa.","marked":"T'ó ńt'ètè àìkú jáde wá."}],"end":26.106},{"key":"4","start":27.056,"lines":[{"start":27.056,"end":29.151,"text":"Bebe, ojo t'a ti nreti","marked":"Bẹ̀bẹ̀, ọjọ́ t'á ti ńretí"},{"start":29.601,"end":30.974,"text":"Afemoju re l'a fe ri","marked":"Àfẹ̀mọ́jú rẹ̀ l'a fẹ́ rí"},{"start":31.424,"end":32.991,"text":"A fe yo Iona ise yi,","marked":"A fẹ́ yọ lọ́nà iṣẹ́ yí"},{"start":33.441,"end":35.934,"text":"K'a sun n'iku, k'a ji l'ayo.","marked":"K'á sun n'ikú, k'á jí l'ayọ̀."},{"start":36.384,"end":36.994,"text":"Amin.","marked":"Àmín."}],"end":36.994}]}