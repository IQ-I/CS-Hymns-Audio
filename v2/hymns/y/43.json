{"v":2,"coll":"y","num":43,"id":"hymn_43","title":"GBOGBO'ogun orun nro keke","duration":50.326,"voices":{"male":{"file":"y-43-male-v2.m4a","bytes":361430,"sha256":"30fb078ad2beac9d5f6baa11685cd52d1153d9a606e020172a2ec6a8001ef0ec","duration":50.4},"female":{"file":"y-43-female-v2.m4a","bytes":381575,"sha256":"ff62a70b54a07d6dee71f47c07634ff89756e3acc4e51f1a9c9b0ffb3a4cd023","duration":50.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.973,"text":"GBOGBO'ogun orun nro keke","marked":"Gbogbo'ogun ọ̀run ńrọ kẹ̀kẹ́"},{"start":2.423,"end":3.738,"text":"Angeli mu harpu won","marked":"Áńgẹ́lì mú harpu wọn"},{"start":4.188,"end":5.552,"text":"Awon mimo nt'ohun won se","marked":"Àwọn mímọ́ ńt'ohun wọn ṣe"},{"start":6.002,"end":7.731,"text":"Lati josin t'o l'ogo","marked":"Láti jọ́sìn t'ó l'ògo"},{"start":8.181,"end":9.489,"text":"Ojo 'simi t'OIorun de","marked":"Ọjọ́ ṣimí t'Ọlọ́run dé"},{"start":9.939,"end":11.413,"text":"Ojo t'o l'ogo julo","marked":"Ọjọ́ t'ó l'ògo jùlọ"},{"start":11.863,"end":13.157,"text":"Orun kun fun iho ayo","marked":"Ọ̀run kún fún ihò ayọ̀"},{"start":13.607,"end":15.36,"text":"A! b'isin won ti dun to.","marked":"A! b'ìsìn wọn ti dùn tó."}],"end":15.36},{"key":"2","start":16.31,"lines":[{"start":16.31,"end":17.92,"text":"Jek'a pelu awon t'orun","marked":"Jẹ́k'á pẹ̀lú àwọn t'ọ̀run"},{"start":18.37,"end":19.364,"text":"Yin Olorun Oba wa","marked":"Yín Ọlọ́run Ọba wa"},{"start":19.814,"end":21.249,"text":"Jek'a pa 'le okan wa mo","marked":"Jẹ́k'á pa lé ọkàn wa mọ́"},{"start":21.699,"end":23.171,"text":"K'a f'ohun mimo korin","marked":"K'á f'ohun mímọ́ kọrin"},{"start":23.621,"end":25.143,"text":"Apere ni ti wa le je","marked":"Apẹ̀rẹ̀ ní ti wá lè jẹ́"},{"start":25.593,"end":27.182,"text":"T'isimi ti won loke","marked":"T'ìṣímí tí wọ́n lókè"},{"start":27.632,"end":28.863,"text":"Titi ao fi ri Oluwa","marked":"Títí àó fi rí Olúwa"},{"start":29.313,"end":30.674,"text":"Ti a nsin l'ojukoju.","marked":"Tí a ńsìn l'ojúkojú."}],"end":30.674},{"key":"3","start":31.624,"lines":[{"start":31.624,"end":34.035,"text":"K'o to d'igba na, e jeki","marked":"K'ó tó d'ìgbà ná, ẹ jẹ̀kí"},{"start":34.485,"end":35.921,"text":"A ma sin l'ojo keje","marked":"A má sìn l'ọjọ́ keje"},{"start":36.371,"end":38.41,"text":"K'a f'aniyan wa s'apakan","marked":"K'á f'àníyàn wá s'àpákàn"},{"start":38.86,"end":40.233,"text":"K'a pe sinu ile Re","marked":"K'á pẹ́ sínú ilé Rẹ"},{"start":40.683,"end":42.112,"text":"O ti pase k'a ma se be","marked":"Ó ti pàṣẹ k'á má ṣe bẹ̀"},{"start":42.562,"end":43.926,"text":"Y'o bukun ipejo wa","marked":"Y'ó bùkún ìpéjọ wa"},{"start":44.376,"end":45.883,"text":"E jek'a sin li aisaare","marked":"Ẹ jẹ́k'á sin lí àìṣàárẹ̀"},{"start":46.333,"end":47.626,"text":"Ere re y'o je ti wa.","marked":"Èrè rẹ̀ y'ó jẹ́ ti wá."},{"start":48.076,"end":48.777,"text":"Amin.","marked":"Àmín."}],"end":48.777}]}