{"v":2,"coll":"y","num":49,"id":"hymn_49","title":"OLUGBALA gbohun mi","duration":55.616,"voices":{"male":{"file":"y-49-male-v2.m4a","bytes":380825,"sha256":"f1cf95a955a9ce4acbbb98005b2710f005ac1e3ee94aecf28e5380e0eee6f03d","duration":55.7},"female":{"file":"y-49-female-v2.m4a","bytes":390287,"sha256":"3740ae4a6d0ff5b66e11e60a7ade178767abc8a5d44630e648ee28e36aa104df","duration":55.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.433,"text":"OLUGBALA gbohun mi,","marked":"Olùgbàlà gbóhùn mi"},{"start":1.883,"end":3.225,"text":"Gbohun mi, gbohun mi,","marked":"Gbóhùn mi, gbóhùn mi"},{"start":3.675,"end":4.893,"text":"Mo wa sodo Re gba mi","marked":"Mo wá sọ́dọ̀ Rẹ gbà mí"},{"start":5.343,"end":6.472,"text":"Nibi agbelebu,","marked":"Níbi àgbélébùú"},{"start":6.922,"end":8.63,"text":"Emi se, sugbon O ku","marked":"Èmi ṣe, ṣùgbọ́n Ó kú"},{"start":9.08,"end":10.441,"text":"lwo ku, lwo ku,","marked":"lwó kú, lwó kú"},{"start":10.891,"end":12.047,"text":"Fi anu Re pa mi mo,","marked":"Fi àánú Rẹ pa mí mọ́"},{"start":12.497,"end":13.699,"text":"Nibi agbelebu.","marked":"Níbi àgbélébùú."}],"end":13.699},{"key":"CHORUS","start":14.649,"lines":[{"start":14.649,"end":15.784,"text":"Oluwa jo gba mi","marked":"Olúwa jọ gbà mí"},{"start":16.234,"end":17.544,"text":"Nk'y'o bi O ninu mo!","marked":"Ǹk'y'ó bí Ọ nínú mọ́!"},{"start":17.994,"end":19.159,"text":"Alabukun gba mi","marked":"Alábùkún gbà mí"},{"start":19.609,"end":20.759,"text":"Nibi Agbelebu.","marked":"Níbi Àgbélébùú."}],"end":20.759},{"key":"2","start":21.709,"lines":[{"start":21.709,"end":23.088,"text":"Tori ki n' ma ba segbe","marked":"Torí kí n má bá ṣègbé"},{"start":23.538,"end":25.656,"text":"Ngo bebe! ngo bebe!","marked":"Ngọ́ bẹ̀bẹ̀! ngọ́ bẹ̀bẹ̀!"},{"start":26.106,"end":27.14,"text":"iwo li ona iye","marked":"ìwọ lí ọ̀nà ìyè"},{"start":27.59,"end":28.813,"text":"Nibi agbelebu","marked":"Níbi àgbélébùú"},{"start":29.263,"end":30.524,"text":"Ore-Ofe Re t'a gba","marked":"Oore-ọ̀fẹ́ Rẹ t'á gbà"},{"start":30.974,"end":32.549,"text":"Lofe ni! Lofe ni!","marked":"Lọ́fẹ́ ni! Lọ́fẹ́ ni!"},{"start":32.999,"end":34.268,"text":"F'oju anu Re wo mi,","marked":"F'ojú àánú Rẹ̀ wò mí"},{"start":34.718,"end":35.895,"text":"Nibi agbelebu.","marked":"Níbi àgbélébùú."},{"start":36.345,"end":37.432,"text":"Egbe: Oluwa jo gba mi...","marked":"Olúwa jọ gbà mí"}],"end":37.432},{"key":"3","start":38.382,"lines":[{"start":38.382,"end":39.642,"text":"F'eje mimo re we mi","marked":"F'ẹ̀jẹ̀ mímọ́ rẹ̀ wé mi"},{"start":40.092,"end":42.271,"text":"Fi we mi,! Fi we me!","marked":"Fi wẹ̀ mi,! Fi wẹ̀ me!"},{"start":42.721,"end":43.863,"text":"Ri mi sinu ibu Re,","marked":"Rí mi sínú ibú Rẹ"},{"start":44.313,"end":45.531,"text":"Nibi agbelebu,","marked":"Níbi àgbélébùú"},{"start":45.981,"end":47.241,"text":"Gbagbo l'o le fun wa ni,","marked":"Gbàgbọ́ l'ó lè fún wa ni"},{"start":47.691,"end":49.37,"text":"'Dariji !, Dariji !","marked":"dáríjì !, Dáríjì !"},{"start":49.82,"end":51.452,"text":"Mo fi f'igbagbo ro mo O.","marked":"Mo fi f'ìgbàgbọ́ rò mọ́ Ọ."},{"start":51.902,"end":52.991,"text":"Egbe: Oluwa jo gba mi...","marked":"Olúwa jọ gbà mí"},{"start":53.441,"end":54.067,"text":"Amin.","marked":"Àmín."}],"end":54.067}]}