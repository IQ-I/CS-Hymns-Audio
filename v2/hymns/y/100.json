{"v":2,"coll":"y","num":100,"id":"hymn_100","title":"EMI Baba Alaye","duration":53.753,"voices":{"male":{"file":"y-100-male-v2.m4a","bytes":372059,"sha256":"5229cf79f88f07340cdcca46c59de50a0c4c172746d738bf1fa43807bac184b6","duration":53.8},"female":{"file":"y-100-female-v2.m4a","bytes":387397,"sha256":"3a1c43e45a5b31cbd56d37adc32edd796405bcdd094973e83a0a450271951ee7","duration":53.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.514,"text":"EMI Baba Alaye","marked":"Ẹ̀mí Baba Àlàyé"},{"start":1.964,"end":3.06,"text":"Sokale pelu","marked":"Sọ̀kalẹ̀ pẹ̀lú"},{"start":3.51,"end":4.99,"text":"Agbara Pentikosti","marked":"Agbára Pentikosti"},{"start":5.44,"end":6.446,"text":"So okan wa ji","marked":"Sọ ọkàn wa jí"},{"start":6.896,"end":8.038,"text":"Ki O si mu gbona","marked":"Kí Ó sì mú gbóná"},{"start":8.488,"end":9.652,"text":"B'ina orun nla","marked":"B'iná ọ̀run ńlá"},{"start":10.102,"end":11.169,"text":"Pelu 'tunu nla","marked":"Pẹ̀lú tùnú ńlá"},{"start":11.619,"end":12.434,"text":"Tan 'mole re.","marked":"Tàn mọ́lẹ̀ rẹ."}],"end":12.434},{"key":"2","start":13.384,"lines":[{"start":13.384,"end":14.839,"text":"Aye ati emi wa","marked":"Ayé àti èmi wà"},{"start":15.289,"end":16.391,"text":"Gba, fi se Tire","marked":"Gbà, fi ṣe Tìrẹ"},{"start":16.841,"end":18.128,"text":"Ninu isin wa fun O","marked":"Nínú ìsìn wa fún Ọ"},{"start":18.578,"end":19.475,"text":"Ka ni 'ranwo Re","marked":"Ká ní rànwọ́ Rẹ"},{"start":19.925,"end":21.252,"text":"Lati j'olotito","marked":"Láti j'olótítọ́"},{"start":21.702,"end":22.714,"text":"K'ebun at'orun","marked":"K'ẹ̀bùn àt'ọ̀run"},{"start":23.164,"end":24.348,"text":"Ti Pentikosti","marked":"Ti Pentikosti"},{"start":24.798,"end":25.926,"text":"Ba s'ori wa.","marked":"Bá s'orí wa."}],"end":25.926},{"key":"3","start":26.876,"lines":[{"start":26.876,"end":28.185,"text":"Fi eje 'yebiye Re","marked":"Fi ẹ̀jẹ̀ yẹbíye Rẹ"},{"start":28.635,"end":29.55,"text":"T'oke Kalfari","marked":"T'òkè Kalfárì"},{"start":30.0,"end":31.427,"text":"We okan ese wa nu","marked":"Wẹ ọkàn ẹ̀ṣẹ̀ wa nù"},{"start":31.877,"end":32.879,"text":"Si ra wa pada","marked":"Sì rà wá padà"},{"start":33.329,"end":34.628,"text":"Fi 'fe kun aya wa","marked":"Fi fẹ́ kún aya wa"},{"start":35.078,"end":36.013,"text":"Ka rin 'na oto","marked":"Ká rìn ná ọ̀tọ̀"},{"start":36.463,"end":37.397,"text":"lfe Re lao se","marked":"lfẹ́ Rẹ̀ láò ṣe"},{"start":37.847,"end":38.852,"text":"Bi ti orun.","marked":"Bí ti ọ̀run."}],"end":38.852},{"key":"4","start":39.802,"lines":[{"start":39.802,"end":41.464,"text":"Baba, Omo on Emi","marked":"Baba, Ọmọ ọn Ẹ̀mí"},{"start":41.914,"end":42.917,"text":"Metalokan lae","marked":"Mẹ́talọ́kan láé"},{"start":43.367,"end":45.16,"text":"lyin, Ogo, agbara","marked":"lyìn, Ògo, agbára"},{"start":45.61,"end":46.732,"text":"Je Tire nikan","marked":"Jẹ́ Tire nìkan"},{"start":47.182,"end":48.211,"text":"Ewa Re l'aye yi","marked":"Ẹwà Rẹ l'ayé yí"},{"start":48.661,"end":49.746,"text":"Yo je ayo wa","marked":"Yó jẹ́ ayọ̀ wa"},{"start":50.196,"end":51.031,"text":"Pelu idupe","marked":"Pẹ̀lú ìdúpẹ́"},{"start":51.481,"end":52.204,"text":"Aleluya!","marked":"Alelúyà!"}],"end":52.204}]}