{"v":2,"coll":"y","num":51,"id":"hymn_51","title":"Jesu nfe gba elese","duration":42.096,"voices":{"male":{"file":"y-51-male-v2.m4a","bytes":289527,"sha256":"b6cdfc1d9112de4c85e39f2f2c2c17e6161f976a92c519bbd35ea1c2cfdefea7","duration":42.1},"female":{"file":"y-51-female-v2.m4a","bytes":305607,"sha256":"045f1bbc74dedb32226a9f184d893caba208489bcf7c2973e0bc4ee584ec9b28","duration":42.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.78,"text":"Jesu nfe gba elese","marked":"Jésù ńfẹ́ gba ẹlẹ́ṣẹ̀"},{"start":2.23,"end":3.567,"text":"Kede re fun gbogbo eda,","marked":"Kéde rẹ fún gbogbo ẹ̀dá"},{"start":4.017,"end":5.708,"text":"T'o yapa ona run le,","marked":"T'ó yapa ọ̀nà run le"},{"start":6.158,"end":7.625,"text":"At' awon ti njafara.","marked":"Àt àwọn ti ǹjáfara."}],"end":7.625},{"key":"CHORUS","start":8.575,"lines":[{"start":8.575,"end":10.439,"text":"Ko o Iorin ko si tun ko","marked":"Kọ́ ọ lọ́rin kò sì tún kọ́"},{"start":10.889,"end":12.44,"text":"Kristi ngba gbogbo elese","marked":"Kristi ńgba gbogbo ẹlẹ́ṣẹ̀"},{"start":12.89,"end":14.259,"text":"Je ki 'hin na daju pe","marked":"Jẹ́ kí hín ná dájú pé"},{"start":14.709,"end":16.288,"text":"Kristi ngba gbogbo elese.","marked":"Kristi ńgba gbogbo ẹlẹ́ṣẹ̀."}],"end":16.288},{"key":"2","start":17.238,"lines":[{"start":17.238,"end":18.658,"text":"Wa y'o o fun o ni 'simi","marked":"Wá y'ọ̀ ọ́ fún ọ ní ṣímí"},{"start":19.108,"end":20.786,"text":"Gba A gbo, oro re ni:","marked":"Gbà A gbọ́, ọ̀rọ̀ rẹ̀ ni"},{"start":21.236,"end":22.654,"text":"Y'o gb'elese to buru","marked":"Y'ó gb'ẹlẹ́ṣẹ̀ tó burú"},{"start":23.104,"end":24.905,"text":"Krisiti ngba gbogbo elese.","marked":"Krisiti ńgba gbogbo ẹlẹ́ṣẹ̀."}],"end":24.905},{"key":"3","start":25.855,"lines":[{"start":25.855,"end":27.272,"text":"Okan mi ko lebi mo,","marked":"Ọkàn mi kò lẹ́bi mọ́"},{"start":27.722,"end":29.196,"text":"Mo mo niwaju ofin,","marked":"Mo mọ̀ níwájú òfin"},{"start":29.646,"end":30.684,"text":"Enit'o we mi mo","marked":"Ẹnit'ó wẹ̀ mi mọ́"},{"start":31.134,"end":32.56,"text":"Ti san gbogbo gbese mi.","marked":"Ti san gbogbo gbèsè mi."}],"end":32.56},{"key":"4","start":33.51,"lines":[{"start":33.51,"end":35.033,"text":"Kristi ngba gbogbo'elese","marked":"Kristi ńgba gbogbo'ẹlẹ́ṣẹ̀"},{"start":35.483,"end":36.913,"text":"An' emi to d'ese ju,","marked":"Àn èmi tó d'ẹ̀ṣẹ̀ jù"},{"start":37.363,"end":38.685,"text":"T'a we mo patapata","marked":"T'á wẹ̀ mọ́ pátápátá"},{"start":39.135,"end":40.546,"text":"Y'o ba wo 'joba orun.","marked":"Y'ó bá wọ jọba ọ̀run."}],"end":40.546}]}