{"v":2,"coll":"y","num":26,"id":"hymn_26","title":"GBOGBO ara aiye","duration":60.956,"voices":{"male":{"file":"y-26-male-v2.m4a","bytes":418979,"sha256":"c94ebdb895b9e60faa3e996c49625a775b16d89f723624c7c3f4d15827fbabe5","duration":61.0},"female":{"file":"y-26-female-v2.m4a","bytes":434778,"sha256":"122c109b9d33f8cd1d79a81540086b6548589095c264b62a7f9db0cfbac058d4","duration":61.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.286,"text":"GBOGBO ara aiye","marked":"Gbogbo ara ayé"},{"start":1.736,"end":2.79,"text":"T'o wa ninu ese","marked":"T'ó wà nínú ẹ̀ṣẹ̀"},{"start":3.24,"end":4.295,"text":"T'o nb ojo 'simi je","marked":"T'ó ńb ọjọ́ ṣímí jẹ́"},{"start":4.745,"end":5.933,"text":"Oluwa nke si yin.","marked":"Olúwa ńké sí yín."}],"end":5.933},{"key":"CHORUS","start":6.883,"lines":[{"start":6.883,"end":8.93,"text":"Egbe Kerubu, Serafu","marked":"Ẹgbẹ́ Kérúbù, Séráfù"},{"start":9.38,"end":10.915,"text":"So faraiye p'Oluwa mbo. (2ce)","marked":"Sọ faraiyé p'Olúwa mbọ̀."}],"end":10.915},{"key":"2","start":11.865,"lines":[{"start":11.865,"end":12.977,"text":"E damure giri,","marked":"Ẹ dàmúrè gírí"},{"start":13.427,"end":15.191,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":15.641,"end":17.01,"text":"E funpe na kikan","marked":"Ẹ fúnpẹ́ ná kíkan"},{"start":17.46,"end":18.742,"text":"Nipa t'ojo 'simi","marked":"Nípa t'ọjọ́ ṣímí"},{"start":19.192,"end":21.29,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":21.29},{"key":"3","start":22.24,"lines":[{"start":22.24,"end":23.283,"text":"Enyin Onigbagbo","marked":"Ẹ̀yin Onígbàgbọ́"},{"start":23.733,"end":24.764,"text":"L'awon Imale nwo","marked":"L'àwọn Ìmàlẹ̀ ńwọ̀"},{"start":25.214,"end":26.26,"text":"At'awon Keferi","marked":"Àt'àwọn Kèfèrí"},{"start":26.71,"end":28.062,"text":"Nipa t'ojo 'simi.","marked":"Nípa t'ọjọ́ ṣímí."},{"start":28.512,"end":30.594,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":30.594},{"key":"4","start":31.544,"lines":[{"start":31.544,"end":32.662,"text":"E mura Iati ba","marked":"Ẹ múra láti bá"},{"start":33.112,"end":34.086,"text":"Oluwa yin laja","marked":"Olúwa yín làjà"},{"start":34.536,"end":35.676,"text":"Mase f'aye sile","marked":"Máṣe f'ayé sílẹ̀"},{"start":36.126,"end":37.46,"text":"F'esu lati mi yin.","marked":"F'eṣú láti mì yín."},{"start":37.91,"end":39.903,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":39.903},{"key":"5","start":40.853,"lines":[{"start":40.853,"end":41.768,"text":"Toro ida Emi,","marked":"Tọrọ idà Èmi"},{"start":42.218,"end":43.348,"text":"Lowo Olorun re,","marked":"Lọ́wọ́ Ọlọ́run rẹ"},{"start":43.798,"end":44.717,"text":"Pelu bata irin","marked":"Pẹ̀lú bàtà irin"},{"start":45.167,"end":46.525,"text":"Lati t'esu mole.","marked":"Láti t'èṣù mọ́lẹ̀."},{"start":46.975,"end":49.017,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"}],"end":49.017},{"key":"6","start":49.967,"lines":[{"start":49.967,"end":51.105,"text":"Oluwa fun wa se,","marked":"Olúwa fún wa ṣe"},{"start":51.555,"end":52.762,"text":"K'a p'ojo mimo mo","marked":"K'á p'ọjọ́ mímọ́ mọ́"},{"start":53.212,"end":54.231,"text":"Ka le ri igbala","marked":"Ká lè rí ìgbàlà"},{"start":54.681,"end":55.975,"text":"Nikehin ojo wa.","marked":"Níkẹ̀hìn ọjọ́ wa."},{"start":56.425,"end":58.372,"text":"Egbe:  Egbe Kerubu, Serafu...","marked":"Ẹgbẹ́ Kérúbù, Séráfù"},{"start":58.822,"end":59.407,"text":"Amin.","marked":"Àmín."}],"end":59.407}]}