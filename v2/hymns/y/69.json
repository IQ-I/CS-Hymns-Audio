{"v":2,"coll":"y","num":69,"id":"hymn_69","title":"RAPADA lowo 'ku on ese","duration":44.167,"voices":{"male":{"file":"y-69-male-v2.m4a","bytes":313764,"sha256":"dfa3c46190a06431050f359a1a5d66b878646a5c108c7ddf22f420eee274ff94","duration":44.2},"female":{"file":"y-69-female-v2.m4a","bytes":324727,"sha256":"314daeb67f097cebdc74845f62ffd1eb8f41f5618e62f273b1ccec6d235beea2","duration":44.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.626,"text":"RAPADA lowo 'ku on ese","marked":"Ràpadà lọ́wọ́ kú ọn ẹsẹ̀"},{"start":2.076,"end":3.513,"text":"lrapada n'ile l'ode","marked":"lrápadà n'ilẹ̀ l'òde"},{"start":3.963,"end":5.588,"text":"'Mole titun wo lo to yi!","marked":"mọ́lẹ̀ títún wo lọ tó yí!"},{"start":6.038,"end":7.83,"text":"Ogo wo Io tan s'okan wa.","marked":"Ògo wo ló tán s'ọkàn wa."}],"end":7.83},{"key":"CHORUS","start":8.78,"lines":[{"start":8.78,"end":11.247,"text":"lrapada! I'orin mi yio je","marked":"lrápadà! l'orin mi yóò jẹ́"},{"start":11.697,"end":13.534,"text":"Titi aiye ainipekurn","marked":"Títí ayé àìnípẹ̀kurn"},{"start":13.984,"end":15.552,"text":"Je k'eni 'rapada k'o ko","marked":"Jẹ́ k'ẹni ràpadà k'ó kọ"},{"start":16.002,"end":17.502,"text":"Orin iyin si Kristi Oba.","marked":"Orin ìyìn sí Kristi Ọba."}],"end":17.502},{"key":"2","start":18.452,"lines":[{"start":18.452,"end":19.955,"text":"Ogo f'eni t'ao le mo'fe Re","marked":"Ògo f'ẹni t'áò lè mọ̀'fẹ́ Rẹ"},{"start":20.405,"end":21.723,"text":"To tan'mole s'ona enia,","marked":"Tó tàn'mọ́lẹ̀ s'ọ̀nà ènìà"},{"start":22.173,"end":23.608,"text":"B'itansan 'Rawo titun nyo","marked":"B'ìtànṣán rawọ titun nyọ̀"},{"start":24.058,"end":25.403,"text":"A gbe rin titun rapada,","marked":"A gbé rìn títún ràpadà"}],"end":25.403},{"key":"3","start":26.353,"lines":[{"start":26.353,"end":27.85,"text":"Bi 'gbi okun ti nru soke","marked":"Bí gbi òkun ti ńru sókè"},{"start":28.3,"end":30.12,"text":"Beni gb'orin ayo yio dun","marked":"Bẹ́ni gb'orin ayọ̀ yóò dùn"},{"start":30.57,"end":31.894,"text":"lfe Jesu jijin b'okun","marked":"lfẹ́ Jésù jíjìn b'okùn"},{"start":32.344,"end":34.038,"text":"Yio k'eni 'rapada wa le.","marked":"Yóò k'ẹni ràpadà wá lé."}],"end":34.038},{"key":"4","start":34.988,"lines":[{"start":34.988,"end":36.655,"text":"lrapada! gbogbo eda,","marked":"lrápadà! gbogbo ẹ̀dá"},{"start":37.105,"end":38.73,"text":"Yo f'ayo m'ore f'Oba wa","marked":"Yọ f'ayọ̀ m'ọ́rẹ́ f'Ọba wa"},{"start":39.18,"end":40.751,"text":"lrapada! gbogbo aiye","marked":"lràpadà! gbogbo ayé"},{"start":41.201,"end":42.618,"text":"Yo d'ohun po korin iyin Re","marked":"Yọ d'ohun pọ̀ kọrin ìyìn Rẹ"}],"end":42.618}]}