{"v":2,"coll":"y","num":66,"id":"hymn_66","title":"IGBALA ni, igbala ni","duration":50.297,"voices":{"male":{"file":"y-66-male-v2.m4a","bytes":346573,"sha256":"533c133681c1f6ccaa4545f54feac0422138318d255c0a46df3ae5213b925bc1","duration":50.3},"female":{"file":"y-66-female-v2.m4a","bytes":355474,"sha256":"a9c73f2c403e08959412076151c84ed8f0668da29daa1cd15e2336fdc59f92a9","duration":50.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.007,"text":"IGBALA ni, igbala ni","marked":"Ìgbàlà ni, ìgbàlà ni"},{"start":2.457,"end":3.45,"text":"Awa elese nfe","marked":"Àwa ẹlẹ́ṣẹ̀ ńfẹ́"},{"start":3.9,"end":5.193,"text":"Nitori ninu buburu","marked":"Nítorí nínú búburú"},{"start":5.643,"end":7.075,"text":"T'a se l'awa nsegbe.","marked":"T'á ṣe l'àwa ńṣègbé."}],"end":7.075},{"key":"2","start":8.025,"lines":[{"start":8.025,"end":9.665,"text":"lse owo wa ti a nse","marked":"lṣe ọwọ́ wa tí a ńṣe"},{"start":10.115,"end":11.157,"text":"O nwi nigbagbogbo","marked":"Ó ńwí nígbàgbogbo"},{"start":11.607,"end":13.421,"text":"Pe, igbala ko si nibe","marked":"Pé, ìgbàlà kò sí níbẹ̀"},{"start":13.871,"end":15.757,"text":"Ise ko le gba ni.","marked":"Iṣẹ́ kò lè gbà ni."}],"end":15.757},{"key":"3","start":16.707,"lines":[{"start":16.707,"end":18.672,"text":"Awa nsebo, awa nrubo","marked":"Àwa ńṣebọ, àwa ńrúbọ"},{"start":19.122,"end":20.794,"text":"A nkorin, a si njo","marked":"A ńkọrin, a sì ńjọ"},{"start":21.244,"end":22.905,"text":"Sugbon a ko ri igbala","marked":"Ṣùgbọ́n a kò rí ìgbàlà"},{"start":23.355,"end":24.48,"text":"Ninu gbogbo wonyi.","marked":"Nínú gbogbo wọ̀nyí."}],"end":24.48},{"key":"4","start":25.43,"lines":[{"start":25.43,"end":26.698,"text":"Nibo ni igbala gbe wa?","marked":"Níbo ni ìgbàlà gbé wà?"},{"start":27.148,"end":28.569,"text":"Fi han ni, fi han ni","marked":"Fi hàn ni, fi hàn ni"},{"start":29.019,"end":31.408,"text":"B'o wa loke, bi isale","marked":"B'ó wà lókè, bí ìsàlẹ̀"},{"start":31.858,"end":33.365,"text":"B'o ba mo, wi fun wa.","marked":"B'ó bá mọ́, wí fún wa."}],"end":33.365},{"key":"5","start":34.315,"lines":[{"start":34.315,"end":35.77,"text":"Jesu ni se Olugbala","marked":"Jésù ni ṣe Olùgbàlà"},{"start":36.22,"end":37.287,"text":"Jesu I'Oluwa wa;","marked":"Jésù l'Olúwa wa"},{"start":37.737,"end":39.028,"text":"lgbala wa li owo Re","marked":"lgbàlà wà lí ọwọ́ Rẹ̀"},{"start":39.478,"end":40.59,"text":"Fun awa elese.","marked":"Fún àwa ẹlẹ́ṣẹ̀."}],"end":40.59},{"key":"6","start":41.54,"lines":[{"start":41.54,"end":43.724,"text":"Wa nisisyi, wa loro","marked":"Wá níṣìṣyí, wá lọ́rọ̀"},{"start":44.174,"end":45.078,"text":"lfe wa ninu Re,","marked":"lfẹ́ wà nínú Rẹ̀"},{"start":45.528,"end":46.976,"text":"Enyin ti o buru l' O npe","marked":"Ẹ̀yin tí ó burú l Ó ńpè"},{"start":47.426,"end":48.748,"text":"E wa gba igbala.","marked":"Ẹ wá gba ìgbàlà."}],"end":48.748}]}