{"v":2,"coll":"y","num":37,"id":"hymn_37","title":"OJO mefa t'ise koja","duration":45.311,"voices":{"male":{"file":"y-37-male-v2.m4a","bytes":318667,"sha256":"4156751a2e61e45c442e0215a146a9d02863b9b1ec456fca3152b8aeecd0d75e","duration":45.4},"female":{"file":"y-37-female-v2.m4a","bytes":325336,"sha256":"0bd76e0692908eddd81295a9f70ccc408835d39a6b1af59f06fdc3b0a4c9344e","duration":45.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.186,"text":"OJO mefa t'ise koja","marked":"Ọjọ́ mẹ́fà t'iṣẹ́ kọjá"},{"start":2.636,"end":3.871,"text":"Okan t'isimi si bere","marked":"Ọkàn t'ìṣímí sì bẹ̀rẹ̀"},{"start":4.321,"end":5.96,"text":"Wa, okan mi si 'simi re,","marked":"Wá, ọkàn mi sì ṣímí rẹ̀"},{"start":6.41,"end":8.164,"text":"Y'o s'ojo t'Olorun busi.","marked":"Y'ó s'ọjọ́ t'Ọlọ́run bùṣì."}],"end":8.164},{"key":"2","start":9.114,"lines":[{"start":9.114,"end":10.588,"text":"Ki 'ronu at'ope wa nde,","marked":"Kí ronú àt'ọpẹ́ wa ńdẹ"},{"start":11.038,"end":12.455,"text":"Bi ebo turari s'orun","marked":"Bí ẹbọ tùràrí s'ọ̀run"},{"start":12.905,"end":14.559,"text":"K'o le fa inu didun wa;","marked":"K'ó lè fa inú dídùn wá"},{"start":15.009,"end":16.291,"text":"T'o je t'enit' O mo nikan.","marked":"T'ó jẹ́ t'ẹnit Ó mọ nìkan."}],"end":16.291},{"key":"3","start":17.241,"lines":[{"start":17.241,"end":18.64,"text":"lbale aiya orun yi,","marked":"lbalẹ̀ àìyá ọ̀run yí"},{"start":19.09,"end":20.511,"text":"L'eri isimi t'o l'ogo","marked":"L'ẹ̀rí ìṣímí t'ó l'ògo"},{"start":20.961,"end":22.066,"text":"T'o wa fun enia mimo","marked":"T'ó wà fún ẹnìà mímọ́"},{"start":22.516,"end":24.034,"text":"Opin aniyan at'aisan.","marked":"Òpin àníyàn àt'àìsàn."}],"end":24.034},{"key":"4","start":24.984,"lines":[{"start":24.984,"end":27.149,"text":"Olorun, a yo si 'se Re,","marked":"Ọlọ́run, a yó sì ṣe Rẹ̀"},{"start":27.599,"end":29.16,"text":"L'oniruru t'ogbon t'otun","marked":"L'onírúrú t'ọgbọ́n t'ọ̀tún"},{"start":29.61,"end":31.325,"text":"A fi 'yin ro anu t'o lo","marked":"A fi yín ro àánú t'ó lọ"},{"start":31.775,"end":33.337,"text":"A ni 'reti s'eyi ti mbo.","marked":"A ní retí s'èyí ti mbọ̀."}],"end":33.337},{"key":"5","start":34.287,"lines":[{"start":34.287,"end":36.064,"text":"F'oni sisin mimo jale","marked":"F'òní ṣísìn mímọ́ jalè"},{"start":36.514,"end":38.206,"text":"K'o si se inu didun si;","marked":"K'ó sì ṣe inú dídùn sí"},{"start":38.656,"end":40.779,"text":"B'o ti dun lati l'ojo yi,","marked":"B'ó ti dùn láti l'ọjọ́ yí"},{"start":41.229,"end":42.742,"text":"Nireti okan ailopin?","marked":"Nírètí ọkàn àìlópin?"},{"start":43.192,"end":43.762,"text":"Amin.","marked":"Àmín."}],"end":43.762}]}