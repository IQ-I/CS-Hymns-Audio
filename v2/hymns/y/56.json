{"v":2,"coll":"y","num":56,"id":"hymn_56","title":"KRIST' Jesu l'agbara","duration":77.666,"voices":{"male":{"file":"y-56-male-v2.m4a","bytes":557170,"sha256":"f695c8754b33db14c8d425887dace15be4c1779f99b2e1c8478baaea24140233","duration":77.7},"female":{"file":"y-56-female-v2.m4a","bytes":578240,"sha256":"301a16fde9fe6a0aae8530f612ad1025256248841e6e340955b81e4477242a24","duration":77.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.829,"text":"KRIST' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":2.279,"end":3.465,"text":"Agbara 'dariji","marked":"Agbára dáríjì"},{"start":3.915,"end":5.811,"text":"Agbara ti n so ni d'aaye","marked":"Agbára tí ń sọ ní d'ààyè"},{"start":6.261,"end":7.271,"text":"T'o f'iye f'elese","marked":"T'ó f'ìyẹ́ f'ẹlẹ́ṣẹ̀"},{"start":7.721,"end":9.199,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":9.649,"end":10.78,"text":"Rohin re n'bi gbogbo!","marked":"Ròhìn rẹ̀ n'bí gbogbo!"},{"start":11.23,"end":12.613,"text":"Gbe okan ebi re to O wa","marked":"Gbé ọkàn ẹ̀bi rẹ̀ tọ̀ Ọ́ wà"},{"start":13.063,"end":14.592,"text":"Yoo f'oor'ofe gba O.","marked":"Yóò f'oor'ọ̀fẹ́ gbà Ọ́."}],"end":14.592},{"key":"CHORUS","start":15.542,"lines":[{"start":15.542,"end":16.911,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":17.361,"end":18.515,"text":"Agbura Olorun","marked":"Àgbúra Ọlọ́run"},{"start":18.965,"end":20.461,"text":"Krist' Jesu I'agbara","marked":"Krist Jésù l'agbára"},{"start":20.911,"end":22.059,"text":"Mo jo w'okan mi fun Un","marked":"Mo jọ w'ọkàn mi fún Un"},{"start":22.509,"end":23.873,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":24.323,"end":25.801,"text":"Ngo gbekele E titi","marked":"Ngo gbẹ́kẹ̀lé Ẹ títí"},{"start":26.251,"end":27.658,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":28.108,"end":29.928,"text":"Mo ju ba, wole fun Un.","marked":"Mo jù bá, wọlé fún Un."}],"end":29.928},{"key":"2","start":30.878,"lines":[{"start":30.878,"end":32.251,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":32.701,"end":34.121,"text":"Lati so ni d'otun","marked":"Láti sọ ní d'ọ̀tún"},{"start":34.571,"end":36.185,"text":"Lati w'ese kuro l'okan","marked":"Láti w'ẹsẹ̀ kúrò l'ọkàn"},{"start":36.635,"end":38.048,"text":"Lati so di pipe","marked":"Láti sọ di pípé"},{"start":38.498,"end":39.95,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":40.4,"end":41.86,"text":"Lati pamo d'opin","marked":"Láti pamọ́ d'òpin"},{"start":42.31,"end":43.959,"text":"Ko s'eni't'o le ja awon","marked":"Kò s'ẹni't'ó lè já àwọn"},{"start":44.409,"end":45.54,"text":"Agutan low Re.","marked":"Àgùtàn lọ́w Rẹ."}],"end":45.54},{"key":"3","start":46.49,"lines":[{"start":46.49,"end":47.888,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":48.338,"end":49.587,"text":"Lati tu ni ninu","marked":"Láti tù ni nínú"},{"start":50.037,"end":51.485,"text":"Agbara lati ru gbogbo","marked":"Agbára láti rú gbogbo"},{"start":51.935,"end":52.923,"text":"Aniyan okan re","marked":"Àníyàn ọkàn rẹ"},{"start":53.373,"end":54.864,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":55.314,"end":56.798,"text":"Lati n'o' omije nu","marked":"Láti n'ọ́ omijé nù"},{"start":57.248,"end":58.984,"text":"Saa f'igboya ro m'Oluwa","marked":"Ṣáà f'ìgboyà rọ̀ m'Olúwa"},{"start":59.434,"end":61.186,"text":"Gboran, si gbekele E.","marked":"Gbọ́ràn, sì gbẹ́kẹ̀lé E."}],"end":61.186},{"key":"4","start":62.136,"lines":[{"start":62.136,"end":63.511,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":63.961,"end":65.072,"text":"'Gbara lati parun","marked":"gbára láti parun"},{"start":65.522,"end":67.633,"text":"Lati bori ota t'o n fe","marked":"Láti borí ọ̀tá t'ó ń fẹ́"},{"start":68.083,"end":69.163,"text":"Gb'ogun ti okan re","marked":"Gb'ogun ti ọkàn rẹ"},{"start":69.613,"end":70.938,"text":"Krist' Jesu l'agbara","marked":"Krist Jésù l'agbára"},{"start":71.388,"end":72.412,"text":"Lor'akete iku","marked":"Lọ́r'àkéte ikú"},{"start":72.862,"end":74.402,"text":"Lati f'okan re ni 'segun","marked":"Láti f'ọkàn rẹ̀ ní ṣẹ́gun"},{"start":74.852,"end":76.117,"text":"Lati ji o dide","marked":"Láti jí ó dìde"}],"end":76.117}]}