{"v":2,"coll":"y","num":33,"id":"hymn_33","title":"OLUS'AGUTAN eni re","duration":25.155,"voices":{"male":{"file":"y-33-male-v2.m4a","bytes":167933,"sha256":"e2ade7985c34c3c5167b99c7b9493d9cffab3959e793a5f151f26a1a3b2ef447","duration":25.2},"female":{"file":"y-33-female-v2.m4a","bytes":176780,"sha256":"cf58dac4ada9e9e446eefeff1595825adfc1cfbe297465cbc96614ad50345bd8","duration":25.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.475,"text":"OLUS'AGUTAN eni re","marked":"Olùṣ'àgùtàn ẹni rẹ̀"},{"start":1.925,"end":3.112,"text":"Fi oju Re han wa,","marked":"Fi ojú Rẹ hàn wá"},{"start":3.562,"end":4.889,"text":"Wo fun wa n'ile adura","marked":"Wo fún wa n'ilẹ̀ àdúrà"},{"start":5.339,"end":6.718,"text":"M'okan wa gbadura.","marked":"M'ọkàn wa gbàdúrà."}],"end":6.718},{"key":"2","start":7.668,"lines":[{"start":7.668,"end":9.328,"text":"K'ife ati alafia","marked":"K'ìfẹ́ àti àlàáfíà"},{"start":9.778,"end":11.351,"text":"K'o ma gbe ile yi!","marked":"K'ó má gbé ilẹ̀ yí!"},{"start":11.801,"end":13.162,"text":"F'irora f'okan iponju","marked":"F'írora f'ọkàn ìpọ́njú"},{"start":13.612,"end":15.12,"text":"M'okan ailera le.","marked":"M'ọkàn àìlera le."}],"end":15.12},{"key":"3","start":16.07,"lines":[{"start":16.07,"end":17.417,"text":"K'a fi 'gbagbo gbo oro Re,","marked":"K'á fi gbàgbọ́ gbọ́ ọ̀rọ̀ Rẹ"},{"start":17.867,"end":19.162,"text":"K'a fi 'gbagbo bebe","marked":"K'á fi gbàgbọ́ bẹ̀bẹ̀"},{"start":19.612,"end":20.699,"text":"Ati niwaju Oluwa,","marked":"Àti níwájú Olúwa"},{"start":21.149,"end":22.543,"text":"K'a se aroye wa.","marked":"K'á ṣe àròyé wa."},{"start":22.993,"end":23.605,"text":"Amin.","marked":"Àmín."}],"end":23.605}]}