{"v":2,"coll":"y","num":110,"id":"hymn_110","title":"GBOGB'omo Egbe Serafu","duration":51.381,"voices":{"male":{"file":"y-110-male-v2.m4a","bytes":355999,"sha256":"6f7d64104c40424da55d7738fa7b7c20b08f314041aab10e9a719b1fde983cdc","duration":51.4},"female":{"file":"y-110-female-v2.m4a","bytes":374020,"sha256":"3f7e099c7d47dcf5281bb7069af7df3ce1f9b41390619702a91b1136edcfcb3f","duration":51.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.89,"text":"GBOGB'omo Egbe Serafu","marked":"Gbogb'ọmọ Ẹgbẹ́ Séráfù"},{"start":2.34,"end":3.671,"text":"Ati Kerubu l'aiye","marked":"Àti Kérúbù l'ayé"},{"start":4.121,"end":5.947,"text":"K'e da 'lu ati 'jo nyin po","marked":"K'é dá lù àti jọ yín pọ̀"},{"start":6.397,"end":7.718,"text":"K'e si yin Oba-Ogo.","marked":"K'é sì yin Oba-ogo."},{"start":8.168,"end":9.78,"text":"Egbe:  Yin Oluwa, yin l'egbegbe","marked":"Yín Olúwa, yín l'ẹgbẹgbẹ́"},{"start":10.23,"end":11.421,"text":"Yin Oluwa lokokan","marked":"Yín Olúwa lọ́kọ̀kan"},{"start":11.871,"end":12.915,"text":"Oba mimo l'Olorun","marked":"Ọba mímọ́ l'Ọlọ́run"},{"start":13.365,"end":14.705,"text":"Yin Oluwa 'wo okan mi.","marked":"Yín Olúwa wo ọkàn mi."}],"end":14.705},{"key":"2","start":15.655,"lines":[{"start":15.655,"end":17.364,"text":"Larin wahala ati 'ja","marked":"Lárin wàhálà àti jà"},{"start":17.814,"end":19.179,"text":"Larin idekun esu","marked":"Lárin ìdẹ̀kùn èṣù"},{"start":19.629,"end":21.155,"text":"Larin isimu at'egan","marked":"Lárin ìṣímú àt'ẹ̀gàn"},{"start":21.605,"end":23.108,"text":"Ni Serafu ny'Oluwa.","marked":"Ní Séráfù ny'olúwa."},{"start":23.558,"end":24.547,"text":"Egbe:  Yin Oluwa, yin...","marked":"Yín Olúwa, yín"}],"end":24.547},{"key":"3","start":25.497,"lines":[{"start":25.497,"end":26.674,"text":"Obangiji Oba mimo","marked":"Ọbangíjì Ọba mímọ́"},{"start":27.124,"end":28.807,"text":"Ni 'yin at'ope ye fun","marked":"Ní yín àt'ọpẹ́ yẹ fún"},{"start":29.257,"end":30.89,"text":"K'a mu keta gbogbo kuro","marked":"K'á mú kẹta gbogbo kúrò"},{"start":31.34,"end":32.787,"text":"K'a le gb' ade irawo.","marked":"K'á lè gb adé ìràwọ̀."},{"start":33.237,"end":34.218,"text":"Egbe:  Yin Oluwa, yin...","marked":"Yín Olúwa, yín"}],"end":34.218},{"key":"4","start":35.168,"lines":[{"start":35.168,"end":36.719,"text":"Baba Ogo dariji wa,","marked":"Baba Ògo dáríjì wá"},{"start":37.169,"end":38.251,"text":"Omo Mimo da wa si,","marked":"Ọmọ Mímọ́ dá wa sí"},{"start":38.701,"end":39.791,"text":"Emi Mimo radobo wa,","marked":"Ẹ̀mí Mímọ́ rádọ́bọ wá"},{"start":40.241,"end":41.815,"text":"K'a si jogun 'te ogo.","marked":"K'á sì jogún tẹ́ ògo."},{"start":42.265,"end":43.911,"text":"Egbe:  Yin Oluwa, yin l'egbegbe","marked":"Yín Olúwa, yín l'ẹgbẹgbẹ́"},{"start":44.361,"end":45.536,"text":"Yin Oluwa lokokan","marked":"Yín Olúwa lọ́kọ̀kan"},{"start":45.986,"end":47.018,"text":"Oba mimo l'Olorun","marked":"Ọba mímọ́ l'Ọlọ́run"},{"start":47.468,"end":48.723,"text":"Yin Oluwa 'wo okan mi.","marked":"Yín Olúwa wo ọkàn mi."},{"start":49.173,"end":49.831,"text":"Amin.","marked":"Àmín."}],"end":49.831}]}