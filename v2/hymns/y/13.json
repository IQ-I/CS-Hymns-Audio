{"v":2,"coll":"y","num":13,"id":"hymn_13","title":"A GBOJU soke si O","duration":26.416,"voices":{"male":{"file":"y-13-male-v2.m4a","bytes":181388,"sha256":"f391f13fbdb0ff9a4c3651bf8f33526fed0a8b4c5d709cea3a5764caeb7eebed","duration":26.5},"female":{"file":"y-13-female-v2.m4a","bytes":186016,"sha256":"33a85fec8cc610cdcdad4f0ee13d83729a7307da275a7c10c9dfc84994a363ed","duration":26.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.544,"text":"A GBOJU soke si O,","marked":"A Gbójú sókè sí Ọ"},{"start":1.994,"end":3.388,"text":"At'owo ati okan,","marked":"Àt'ọwọ́ àti ọkàn"},{"start":3.838,"end":5.034,"text":"Tewo gba adura wa,","marked":"Tẹ́wọ́ gba àdúrà wa"},{"start":5.484,"end":6.996,"text":"B'o tile se ailera.","marked":"B'ó tilẹ̀ ṣe àìlera."}],"end":6.996},{"key":"2","start":7.946,"lines":[{"start":7.946,"end":9.158,"text":"Oluwa, je k'a mo O","marked":"Olúwa, jẹ́ k'á mọ̀ Ọ"},{"start":9.608,"end":10.738,"text":"Je k'a mo oruko Re;","marked":"Jẹ́ k'á mọ orúkọ Rẹ"},{"start":11.188,"end":12.588,"text":"Je k'awa se ife Re,","marked":"Jẹ́ k'àwa ṣe ìfẹ́ Rẹ"},{"start":13.038,"end":14.449,"text":"Bi nwon ti nse Ii orun.","marked":"Bí wọ́n ti ńṣe Ìí ọ̀run."}],"end":14.449},{"key":"3","start":15.399,"lines":[{"start":15.399,"end":16.794,"text":"Nigbati a sun l'oru","marked":"Nígbàtí a sùn l'òru"},{"start":17.244,"end":19.366,"text":"So wa, k'O duro ti wa","marked":"Sọ wá, k'Ó dúró ti wá"},{"start":19.816,"end":20.909,"text":"Nigbati ile si mo","marked":"Nígbàtí ilẹ̀ sì mọ́"},{"start":21.359,"end":23.869,"text":"K'a ji, k'a fi iyin fun O.","marked":"K'á jí, k'á fi ìyìn fún Ọ."},{"start":24.319,"end":24.866,"text":"Amin.","marked":"Àmín."}],"end":24.866}]}