{"v":2,"coll":"y","num":87,"id":"hymn_87","title":"OPE lo ye f'Olugbala","duration":77.023,"voices":{"male":{"file":"y-87-male-v2.m4a","bytes":531683,"sha256":"2d753a8a58b2b881c63a4beb1a468f0f995d41d4b24e8372970f1283e331736a","duration":77.1},"female":{"file":"y-87-female-v2.m4a","bytes":551249,"sha256":"a3b994667455c5c6d4ca7f0088fa569f3669ef88a25989b4da31d9c3e46ed8ac","duration":77.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.8,"text":"OPE lo ye f'Olugbala","marked":"Ọpẹ́ ló yẹ f'Olùgbàlà"},{"start":2.25,"end":3.404,"text":"Iyin fun Metalokan","marked":"Ìyìn fún Mẹ́talọ́kan"},{"start":3.854,"end":5.267,"text":"T'O da wa si d'ojo oni,","marked":"T'ó dá wa sì d'ọjọ́ òní"},{"start":5.717,"end":7.175,"text":"A f'ogo f'oruko Re.","marked":"A f'ògo f'orúkọ Rẹ̀."}],"end":7.175},{"key":"CHORUS","start":8.125,"lines":[{"start":8.125,"end":10.415,"text":"Korin Ogo, Alleluya,","marked":"Kọrin Ògo, Allelúyà"},{"start":10.865,"end":12.162,"text":"Orin ogo lao ko","marked":"Orin ògo láó kọ"},{"start":12.612,"end":14.965,"text":"Korin Ogo, Alleluyah,","marked":"Kọrin Ògo, Alleluyah"},{"start":15.415,"end":16.852,"text":"Ko Hosannah s'Oba wa.","marked":"Kò Hosannah s'Ọba wa."}],"end":16.852},{"key":"2","start":17.802,"lines":[{"start":17.802,"end":19.646,"text":"Metalokan Oba Ogo","marked":"Mẹ́talọ́kan Ọba Ògo"},{"start":20.096,"end":21.442,"text":"Baba fun wa l'agbara","marked":"Baba fún wa l'agbára"},{"start":21.892,"end":23.484,"text":"F'awon asaju n'isegun","marked":"F'àwọn aṣájú n'ìṣègùn"},{"start":23.934,"end":25.518,"text":"Fun won l'ogbon at'oye","marked":"Fún wọn l'ọgbọ́n àt'òye"},{"start":25.968,"end":26.906,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":26.906},{"key":"3","start":27.856,"lines":[{"start":27.856,"end":29.222,"text":"Obangiji Oba Ogo,","marked":"Ọbangijì Ọba Ògo"},{"start":29.672,"end":30.917,"text":"Ranti Egbe Aladura,","marked":"Rántí Ẹgbẹ́ Aládúrà"},{"start":31.367,"end":32.982,"text":"Fun won l'agbara at'ife","marked":"Fún wọn l'agbára àt'ìfẹ́"},{"start":33.432,"end":34.926,"text":"Ko won l'adura t'orun.","marked":"Kò wọn l'àdúrà t'ọ̀run."},{"start":35.376,"end":36.382,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":36.382},{"key":"4","start":37.332,"lines":[{"start":37.332,"end":38.939,"text":"Jehovah-Nissi Oba wa,","marked":"Jehovah-nissi Ọba wa"},{"start":39.389,"end":40.594,"text":"Sanu f'Egbe Serafu;","marked":"Sanu f'Ẹgbẹ́ Séráfù"},{"start":41.044,"end":42.717,"text":"F'isegun f'Egbe Kerubu","marked":"F'ìṣègùn f'Ẹgbẹ́ Kérúbù"},{"start":43.167,"end":44.596,"text":"Se wa gege bi t'orun.","marked":"Ṣe wà gẹ́gẹ́ bí t'ọ̀run."},{"start":45.046,"end":46.019,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":46.019},{"key":"5","start":46.969,"lines":[{"start":46.969,"end":48.458,"text":"Awon ti ko ri 'se yio ri,","marked":"Àwọn tí kò rí ṣe yóò rí"},{"start":48.908,"end":50.173,"text":"Agan a f'owo s'osun","marked":"Àgàn a f'ọwọ́ s'oṣùn"},{"start":50.623,"end":51.891,"text":"Olomo ko ni padanu,","marked":"Ọlọ́mọ kò ní pàdánù"},{"start":52.341,"end":53.955,"text":"Alaisan yio dide.","marked":"Aláìsàn yóò dìde."},{"start":54.405,"end":55.332,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":55.332},{"key":"6","start":56.282,"lines":[{"start":56.282,"end":57.686,"text":"Gbo tiwa Baba wa orun","marked":"Gbọ́ tiwa Baba wa ọ̀run"},{"start":58.136,"end":59.302,"text":"Ranti Egbe idale,","marked":"Rántí Ẹgbẹ́ ìdálẹ̀"},{"start":59.752,"end":61.359,"text":"Fun won l'agbara at'ipa","marked":"Fún wọn l'agbára àt'ipá"},{"start":61.809,"end":63.029,"text":"Fun gbogbo wa n'isegun","marked":"Fún gbogbo wa n'ìṣègùn"},{"start":63.479,"end":64.359,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"}],"end":64.359},{"key":"7","start":65.309,"lines":[{"start":65.309,"end":66.729,"text":"Jehovah Shammah Oba wa,","marked":"Jehovah Ṣhammah Ọba wa"},{"start":67.179,"end":68.792,"text":"Gbat' o ba d'ojo ikehin","marked":"Gbàt ò bá d'ọjọ́ ìkẹhìn"},{"start":69.242,"end":71.044,"text":"Mu wa d'agbala itura,","marked":"Mú wa d'àgbàlá ìtura"},{"start":71.494,"end":73.047,"text":"JAH mu wa de 'te Ogo.","marked":"Jah mú wa dé tẹ́ Ògo."},{"start":73.497,"end":74.369,"text":"Egbe:  Korin Ogo...","marked":"Kọrin Ògo"},{"start":74.819,"end":75.474,"text":"Amin.","marked":"Àmín."}],"end":75.474}]}