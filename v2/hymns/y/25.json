{"v":2,"coll":"y","num":25,"id":"hymn_25","title":"OLUWA awa de","duration":77.071,"voices":{"male":{"file":"y-25-male-v2.m4a","bytes":537104,"sha256":"f5fcff80629ab79a1c799dc928984f9ea85ae7d92187370e60af7404911f360e","duration":77.1},"female":{"file":"y-25-female-v2.m4a","bytes":556816,"sha256":"f060f3b965189778f90dcf5d5d00b90cde6bfcb9d13cb3b21215648261c6ab25","duration":77.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.255,"text":"OLUWA awa de,","marked":"Olúwa àwa dé"},{"start":1.705,"end":3.127,"text":"Lati yin O logo","marked":"Láti yìn Ọ́ lógo"},{"start":3.577,"end":5.676,"text":"Fun ayo nla t'a nyo loni","marked":"Fún ayọ̀ ńlá t'a ńyọ̀ lónì"},{"start":6.126,"end":7.216,"text":"Larin Egbe Seraf","marked":"Lárin Ẹgbẹ́ Seraf"}],"end":7.216},{"key":"CHORUS","start":8.166,"lines":[{"start":8.166,"end":9.786,"text":"Olugbala, a de","marked":"Olùgbàlà, a dé"},{"start":10.236,"end":11.329,"text":"Lati f'iyin fun O","marked":"Láti f'ìyìn fún Ọ"},{"start":11.779,"end":13.325,"text":"Ogo, Iyin, f'Oruko Re","marked":"Ògo, Ìyìn, f'Orúkọ Rẹ"},{"start":13.775,"end":14.788,"text":"Alagbara julo","marked":"Alágbára jùlọ"}],"end":14.788},{"key":"2","start":15.738,"lines":[{"start":15.738,"end":17.564,"text":"Kerubu, Serafu","marked":"Kérúbù, Séráfù"},{"start":18.014,"end":19.276,"text":"Eyin ni'yo aye","marked":"Ẹ̀yin ní'yọ ayé"},{"start":19.726,"end":20.91,"text":"llu ta te sori oke","marked":"llu ta tẹ̀ sórí òkè"},{"start":21.36,"end":22.627,"text":"A ko le farasin","marked":"A kò lè farasin"},{"start":23.077,"end":24.788,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":24.788},{"key":"3","start":25.738,"lines":[{"start":25.738,"end":28.036,"text":"Kabiyesi! Oba,","marked":"Kábíyèsí! Ọba"},{"start":28.486,"end":29.844,"text":"Ogo f'Oruko Re!","marked":"Ògo f'Orúkọ Rẹ!"},{"start":30.294,"end":31.619,"text":"Fun iyanu Re larin wa,","marked":"Fún ìyanu Rẹ̀ lárin wa"},{"start":32.069,"end":33.46,"text":"Eyi t'a ko gbo ri","marked":"Èyí t'a kò gbọ́ rí"},{"start":33.91,"end":35.551,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":35.551},{"key":"4","start":36.501,"lines":[{"start":36.501,"end":37.611,"text":"Orin Halleluyah!","marked":"Orin Hallelúyà!"},{"start":38.061,"end":39.248,"text":"L'awa yio ma ko","marked":"L'àwa yóò má kọ"},{"start":39.698,"end":41.424,"text":"Awa y'o f'iye fo b'idi","marked":"Àwa y'ó f'ìyẹ́ fọ́ b'ìdí"},{"start":41.874,"end":43.105,"text":"Lehin irin ajo wa.","marked":"Lẹ́hìn irin àjọ wà."},{"start":43.555,"end":45.398,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":45.398},{"key":"5","start":46.348,"lines":[{"start":46.348,"end":47.603,"text":"Aiye sun m'Olorun","marked":"Ayé sùn m'Ọlọ́run"},{"start":48.053,"end":49.214,"text":"Akoko sunmo le:","marked":"Àkókò súnmọ́ lé"},{"start":49.664,"end":50.953,"text":"Ilekun anu fere ti,","marked":"Ìlẹ̀kùn àánú fèrè tí"},{"start":51.403,"end":52.566,"text":"E wa wo oko na.","marked":"Ẹ wá wọ oko ná."},{"start":53.016,"end":54.685,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":54.685},{"key":"6","start":55.635,"lines":[{"start":55.635,"end":57.025,"text":"Jesu, Olori wa,","marked":"Jésù, Olórí wa"},{"start":57.475,"end":58.627,"text":"A gb'oju wa si O,","marked":"A gb'ojú wá sí Ọ"},{"start":59.077,"end":60.992,"text":"'Wo l'ao ma yin titi aiye,","marked":"wò l'áò má yín títí ayé"},{"start":61.442,"end":62.991,"text":"Aiye ainipekun","marked":"Ayé àìnípẹ̀kun"},{"start":63.441,"end":65.088,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"}],"end":65.088},{"key":"7","start":66.038,"lines":[{"start":66.038,"end":67.133,"text":"A f'ogo fun Baba","marked":"A f'ògo fún Baba"},{"start":67.583,"end":68.716,"text":"A f'ogo f'Omo Re","marked":"A f'ògo f'Ọmọ Rẹ"},{"start":69.166,"end":70.408,"text":"Ogo ni fun Emi Mimo","marked":"Ògo ni fún Ẹ̀mí Mímọ́"},{"start":70.858,"end":72.282,"text":"Metalokan Iailai.","marked":"Mẹ́talọ́kan láéláé."},{"start":72.732,"end":74.449,"text":"Egbe:  Olugbala, a de...","marked":"Olùgbàlà, a dé"},{"start":74.899,"end":75.522,"text":"Amin.","marked":"Àmín."}],"end":75.522}]}