{"v":2,"coll":"y","num":50,"id":"hymn_50","title":"BABA Oludariji, Dariji","duration":45.886,"voices":{"male":{"file":"y-50-male-v2.m4a","bytes":326059,"sha256":"4565a95ba35f3d29c72bfd90c683df62fa443f6ad967fb88058c285b2f4afb2b","duration":45.9},"female":{"file":"y-50-female-v2.m4a","bytes":341037,"sha256":"a4ce245046fb4b8a07709ef1a653bf2e1bb4cb266dd08521be107f5ccfd7f448","duration":45.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.594,"text":"BABA Oludariji, Dariji","marked":"Baba Olùdáríjì, Dáríjì"},{"start":3.044,"end":5.111,"text":"Gbogbo awa omo Re, Dariji,","marked":"Gbogbo àwa ọmọ Rẹ, Dáríjì"},{"start":5.561,"end":6.717,"text":"Awa Egbe Serafu,","marked":"Àwa Ẹgbẹ́ Séráfù"},{"start":7.167,"end":8.397,"text":"Ati Egbe Kerubu","marked":"Àti Ẹgbẹ́ Kérúbù"},{"start":8.847,"end":11.1,"text":"Ati npafo ninu ese, Dariji.","marked":"Àti ńpafọ̀ nínú ẹ̀ṣẹ̀, Dáríjì."}],"end":11.1},{"key":"2","start":12.05,"lines":[{"start":12.05,"end":13.874,"text":"JESU OLUGBALA WA Dariji","marked":"Jésù Olùgbàlà Wa Dáríjì"},{"start":14.324,"end":15.746,"text":"OLURADAPA Eda Dariji,","marked":"Olùràdàpà Ẹ̀dá Dáríjì"},{"start":16.196,"end":17.482,"text":"Wo to mbebe f'ota Re","marked":"Wò tó mbẹ̀bẹ̀ f'ọ̀tá Rẹ"},{"start":17.932,"end":19.117,"text":"L'origi Agbelebu","marked":"L'orígi Àgbélébùú"},{"start":19.567,"end":21.29,"text":"Wipe fiji won BABA Dariji.","marked":"Wípé fíjì wọn Baba Dáríjì."}],"end":21.29},{"key":"3","start":22.24,"lines":[{"start":22.24,"end":23.886,"text":"EMI OLUTUNU wa, Daniji","marked":"Èmi Olùtùnú wa, Daniji"},{"start":24.336,"end":26.707,"text":"Gbogbo ebi ese wa, Dariji","marked":"Gbogbo ẹ̀bi ẹ̀ṣẹ̀ wa, Dáríjì"},{"start":27.157,"end":28.408,"text":"Gba wa lojo idamu","marked":"Gbà wá lọ́jọ́ ìdàmú"},{"start":28.858,"end":29.962,"text":"Se Oluranlowo wa,","marked":"Ṣe Olùrànlọ́wọ́ wa"},{"start":30.412,"end":32.275,"text":"Mase jeki a bohun Dariji.","marked":"Mase jẹ́kí a bọ́hùn Dáríjì."}],"end":32.275},{"key":"4","start":33.225,"lines":[{"start":33.225,"end":35.058,"text":"METALOKAN jowo wa Dariji","marked":"Mẹ́talọ́kan jọ̀wọ́ wa Dáríjì"},{"start":35.508,"end":37.453,"text":"Omode ati Agba Dariji,","marked":"Ọmọdé àti Àgbà Dáríjì"},{"start":37.903,"end":39.188,"text":"JAH JEHOVAH RAMMAH","marked":"Jah Jehovah Rammah"},{"start":39.638,"end":41.026,"text":"'Wo l'Oba Oniyonu,","marked":"wò l'Ọba Oníyọnu"},{"start":41.476,"end":43.226,"text":"Dariji 'se owo Re Dariji.","marked":"Dáríjì ṣe ọwọ́ Rẹ̀ Dáríjì."},{"start":43.676,"end":44.337,"text":"Amin.","marked":"Àmín."}],"end":44.337}]}