{"v":2,"coll":"y","num":47,"id":"hymn_47","title":"ELESE kan mbe to nf'anu","duration":66.386,"voices":{"male":{"file":"y-47-male-v2.m4a","bytes":475446,"sha256":"40edbfa74acb7a3211553ad5891db82c1e46ab4065a3bee763e4b4c02f706482","duration":66.4},"female":{"file":"y-47-female-v2.m4a","bytes":494405,"sha256":"be549a3c83dd0a9946fbc2cab6bc8cffd7347c6a07b4cd39d9cd588dff34c30a","duration":66.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.836,"text":"ELESE kan mbe to nf'anu,","marked":"Ẹlẹ́ṣẹ̀ kan mbẹ́ tó ńf'ànù"},{"start":2.286,"end":3.299,"text":"Ati 'dariji loni,","marked":"Àti dáríjì lónì"},{"start":3.749,"end":5.898,"text":"Fi ayo gba ihin t'a mu wa","marked":"Fi ayọ̀ gba ìhín t'á mú wá"},{"start":6.348,"end":7.727,"text":"Jesu nkoja lo nihin;","marked":"Jésù ńkọjá lọ níhìn"},{"start":8.177,"end":9.664,"text":"Mbo wa pin 'fe ati anu","marked":"Mbo wá pín fẹ́ àti àánú"},{"start":10.114,"end":11.266,"text":"'Dariji on alafia","marked":"dáríjì ọn àlàáfíà"},{"start":11.716,"end":13.249,"text":"Mbo wa yo l'okan elese","marked":"Mbo wá yọ̀ l'ọkàn ẹlẹ́ṣẹ̀"},{"start":13.699,"end":15.262,"text":"Irora ati osi.","marked":"Ìrora àti òṣì."}],"end":15.262},{"key":"CHORUS","start":16.212,"lines":[{"start":16.212,"end":17.65,"text":"Jesu nkoja lo nihin,","marked":"Jésù ńkọjá lọ níhìn"},{"start":18.1,"end":18.955,"text":"Loni...loni","marked":"Lónì lónì"},{"start":19.405,"end":21.057,"text":"Gbagbo gbat'o wa nitosi","marked":"Gbàgbọ́ gbàt'ọ́ wà nítòsí"},{"start":21.507,"end":23.115,"text":"S'okan re paya lati gba.","marked":"S'ọkàn rẹ̀ payá láti gbà."},{"start":23.565,"end":25.009,"text":"'Tori Jesu nkoja nihin","marked":"torí Jésù ńkọjá níhìn"},{"start":25.459,"end":26.709,"text":"O nkoja nihin Ioni.","marked":"Ó ńkọjá níhìn lónì."}],"end":26.709},{"key":"2","start":27.659,"lines":[{"start":27.659,"end":29.444,"text":"Arakunrin, Jesu nduro","marked":"Arákùnrin, Jésù ńdúró"},{"start":29.894,"end":31.436,"text":"Lati dariji l'ofe","marked":"Láti dáríjì l'ọ̀fẹ́"},{"start":31.886,"end":33.513,"text":"Ese t'o ko gba nisisiyi","marked":"Ẹ̀ṣẹ̀ t'ó kò gbà níṣísíyì"},{"start":33.963,"end":35.386,"text":"Gbekele or'ofe Re","marked":"Gbẹ́kẹ̀lé ọr'ọ̀fẹ́ Rẹ"},{"start":35.836,"end":37.384,"text":"Anu ati 'fe Re sowon,","marked":"Àánú àti fẹ́ Rẹ̀ ṣọ̀wọ́n"},{"start":37.834,"end":38.918,"text":"Ko jina si o loni","marked":"Kò jìnà sí ọ lónì"},{"start":39.368,"end":41.128,"text":"A! silekun okan Re fun","marked":"A! ṣílẹ̀kùn ọkàn Rẹ̀ fún"},{"start":41.578,"end":43.179,"text":"B'O ti sunmo tosi re.","marked":"B'ó ti súnmọ́ tòsí rẹ̀."},{"start":43.629,"end":45.062,"text":"Egbe: Jesu nkoja lo nihin...","marked":"Jésù ńkọjá lọ níhìn"}],"end":45.062},{"key":"3","start":46.012,"lines":[{"start":46.012,"end":48.212,"text":"A! o mbo lati bukun o,","marked":"A! ó mbọ̀ láti bùkún ọ"},{"start":48.662,"end":50.23,"text":"Gbo, fi irele teriba","marked":"Gbọ́, fi ìrẹ̀lẹ̀ tẹríba"},{"start":50.68,"end":52.217,"text":"Mbo wa ra o ninu ese","marked":"Mbo wá rà ọ́ nínú ẹ̀ṣẹ̀"},{"start":52.667,"end":54.492,"text":"O setan lati gba o,","marked":"Ó ṣetán láti gbà ọ́"},{"start":54.942,"end":56.321,"text":"lwo ha je ko 'gbala yi","marked":"lwo ha jẹ́ kó gbàlà yí"},{"start":56.771,"end":58.1,"text":"Ti Jesu nfi ro o,","marked":"Tí Jésù ńfi rò ó"},{"start":58.55,"end":59.966,"text":"A! silekun okan re fun,","marked":"A! ṣílẹ̀kùn ọkàn rẹ̀ fún"},{"start":60.416,"end":61.903,"text":"B'O ti nsunmo 'tosi re.","marked":"B'ó ti ńsúnmọ́ tòsí rẹ̀."},{"start":62.353,"end":63.787,"text":"Egbe: Jesu nkoja lo nihin...","marked":"Jésù ńkọjá lọ níhìn"},{"start":64.237,"end":64.837,"text":"Amin.","marked":"Àmín."}],"end":64.837}]}