{"v":2,"coll":"y","num":9,"id":"hymn_9","title":"L'OJU ale, 'gbat' orun wo","duration":63.867,"voices":{"male":{"file":"y-9-male-v2.m4a","bytes":448172,"sha256":"d21225d87000ca05ab1f7efaec8639dd999eb373cd698bb5c0fe1d22eedc1e4c","duration":63.9},"female":{"file":"y-9-female-v2.m4a","bytes":462636,"sha256":"358045cadb6ecc6505ced2bad7d6b108bc4782a48b3a3caf4e7e0d8c9ca2562b","duration":63.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.267,"text":"L'OJU ale, 'gbat' orun wo,","marked":"L'ojú alẹ́, gbàt ọ̀run wò"},{"start":2.717,"end":4.105,"text":"Nwon gbe abirun w'odo Re;","marked":"Wọ́n gbé abirùn w'odò Rẹ̀"},{"start":4.555,"end":6.185,"text":"Oniruru ni aisan won,","marked":"Onírúrú ni àìsàn wọn"},{"start":6.635,"end":8.252,"text":"Sugbon nwon f'ayo lo le won.","marked":"Ṣùgbọ́n wọ́n f'ayọ̀ lọ lé wọn."}],"end":8.252},{"key":"2","start":9.202,"lines":[{"start":9.202,"end":11.182,"text":"Jesu a de loj' ale yi,","marked":"Jésù a dé lọ́j alẹ́ yí"},{"start":11.632,"end":13.707,"text":"A sunmo O t'awa t'arun wa,","marked":"A súnmọ́ Ó t'àwa t'àrùn wá"},{"start":14.157,"end":15.956,"text":"Bi a ko tile le ri O,","marked":"Bí a kò tilẹ̀ lè rí Ọ"},{"start":16.406,"end":18.092,"text":"Sugbon a mo p'O sunmo wa","marked":"Ṣùgbọ́n a mọ̀ p'Ọ́ súnmọ́ wa"}],"end":18.092},{"key":"3","start":19.042,"lines":[{"start":19.042,"end":20.846,"text":"Olugbala, wo osi wa,","marked":"Olùgbàlà, wo òsì wa"},{"start":21.296,"end":23.207,"text":"Omi ko san, 'mi banuje","marked":"Omi kò sàn, mi banújẹ́"},{"start":23.657,"end":25.308,"text":"Omi ko ni ife si O,","marked":"Omi kò ní ìfẹ́ sí Ọ"},{"start":25.758,"end":27.137,"text":"Ife elomi si tutu.","marked":"Ìfẹ́ ẹlòmí sì tútù."}],"end":27.137},{"key":"4","start":28.087,"lines":[{"start":28.087,"end":29.868,"text":"Omi mo pe asan l'aiye","marked":"Omi mọ̀ pé asán l'ayé"},{"start":30.318,"end":31.873,"text":"Beni nwon ko f'aiye sile","marked":"Bẹ́ni wọ́n kò f'ayé sílẹ̀"},{"start":32.323,"end":33.944,"text":"Omi l'ore ti ko se 're","marked":"Omi l'ọ̀rẹ́ tí kò ṣe rẹ̀"},{"start":34.394,"end":36.02,"text":"Beni nwon ko fi O s'ore.","marked":"Bẹ́ni wọ́n kò fi Ó s'ọrẹ."}],"end":36.02},{"key":"5","start":36.97,"lines":[{"start":36.97,"end":38.518,"text":"Ko s'okan ninu wa t'o pe","marked":"Kò s'ọkàn nínú wa t'ó pé"},{"start":38.968,"end":40.376,"text":"Gbogbpo wa si ni elese","marked":"Gbogbpo wa sì ni ẹlẹ́ṣẹ̀"},{"start":40.826,"end":42.262,"text":"Awon t'o si nsin O toto","marked":"Àwọn t'ó sì ńsìn Ọ́ tòtọ́"},{"start":42.712,"end":44.19,"text":"Mo ara won ni alaipe.","marked":"Mọ ara wọn ní aláìpẹ́."}],"end":44.19},{"key":"6","start":45.14,"lines":[{"start":45.14,"end":46.656,"text":"Sugbon Jesu Olugbala","marked":"Ṣùgbọ́n Jésù Olùgbàlà"},{"start":47.106,"end":48.509,"text":"Eni bi awa ni Iwo se","marked":"Ẹni bí àwa ni Ìwọ ṣe"},{"start":48.959,"end":51.044,"text":"'Wo ti ri danwo bi awa","marked":"wo ti rí dánwò bí àwa"},{"start":51.494,"end":53.146,"text":"'Wo si ti mo ailera wa.","marked":"wo sì ti mọ àìlera wa."}],"end":53.146},{"key":"7","start":54.096,"lines":[{"start":54.096,"end":55.43,"text":"Agbar'owo Re wa sibe","marked":"Agbár'ọwọ́ Rẹ̀ wá síbẹ̀"},{"start":55.88,"end":57.044,"text":"Ore Re si ni Agbara,","marked":"Ọrẹ Rẹ̀ sì ní Agbára"},{"start":57.494,"end":58.938,"text":"Gbo adura ale wa yi,","marked":"Gbọ́ àdúrà alẹ́ wa yí"},{"start":59.388,"end":61.208,"text":"Ni anu, wo gbogbo wa san.","marked":"Ní àánú, wo gbogbo wa sàn."},{"start":61.658,"end":62.318,"text":"Amin.","marked":"Àmín."}],"end":62.318}]}