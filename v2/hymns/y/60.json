{"v":2,"coll":"y","num":60,"id":"hymn_60","title":"AWA Egbe Kerubu","duration":58.577,"voices":{"male":{"file":"y-60-male-v2.m4a","bytes":394504,"sha256":"6dc5622ef4534f2109c25edba94df5aa8d38535e276950a6e9a22e856b83ac0b","duration":58.6},"female":{"file":"y-60-female-v2.m4a","bytes":407424,"sha256":"244d913efa088b78bede17eac030a1ed9f3f654bd61c88455bea2f6d7f55076d","duration":58.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.611,"text":"AWA Egbe Kerubu","marked":"Àwa Ẹgbẹ́ Kérúbù"},{"start":2.061,"end":3.485,"text":"Ati Serafu laiye","marked":"Àti Séráfù láìyẹ̀"},{"start":3.935,"end":5.186,"text":"Awa mbebe fun 'ranwo","marked":"Àwa mbẹ̀bẹ̀ fún rànwọ́"},{"start":5.636,"end":6.942,"text":"Agbara Emi Mimo.","marked":"Agbára Ẹ̀mí Mímọ́."}],"end":6.942},{"key":"CHORUS","start":7.892,"lines":[{"start":7.892,"end":9.357,"text":"A! Baba sanu fun wa","marked":"A! Baba ṣanú fún wa"},{"start":9.807,"end":11.31,"text":"ko dari ese ji wa.","marked":"kò dárí ẹ̀ṣẹ̀ jì wá."}],"end":11.31},{"key":"2","start":12.26,"lines":[{"start":12.26,"end":13.479,"text":"Ki fitila Re ma ku","marked":"Kí fìtílà Rẹ má kú"},{"start":13.929,"end":15.336,"text":"Ninu Eghe Serafu","marked":"Nínú Ẹ̀ghẹ́ Séráfù"},{"start":15.786,"end":17.277,"text":"Ki gbogbo isesi wa","marked":"Kí gbogbo ìṣesí wa"},{"start":17.727,"end":19.112,"text":"Fi wa han bi Omo Re.","marked":"Fi wá hàn bí Ọmọ Rẹ."}],"end":19.112},{"key":"3","start":20.062,"lines":[{"start":20.062,"end":21.498,"text":"Mase ta wa nu kuro","marked":"Máṣe ta wá nù kúrò"},{"start":21.948,"end":22.948,"text":"Iwo olugbala wa","marked":"Ìwọ Olùgbàlà wa"},{"start":23.398,"end":24.788,"text":"K'awa ma ba sako Io,","marked":"K'àwa má bá ṣáko lọ"},{"start":25.238,"end":26.585,"text":"Mu wa rIn ona tire.","marked":"Mú wa rln ọ̀nà tirẹ̀."}],"end":26.585},{"key":"4","start":27.535,"lines":[{"start":27.535,"end":28.935,"text":"Jehovah Jire Baba,","marked":"Jehovah Jire Baba"},{"start":29.385,"end":30.544,"text":"Pese f'awon alaini","marked":"Pèsè f'àwọn aláìní"},{"start":30.994,"end":32.475,"text":"At'awon ti ko ri se","marked":"Àt'àwọn tí kò rí ṣe"},{"start":32.925,"end":34.339,"text":"Masai ranti won loni.","marked":"Masai rántí wọn lónì."}],"end":34.339},{"key":"5","start":35.289,"lines":[{"start":35.289,"end":36.637,"text":"Ese wa ti papo ju,","marked":"Ẹ̀ṣẹ̀ wa ti papọ̀ jù"},{"start":37.087,"end":38.616,"text":"Bi yanrin eti okun","marked":"Bí yanrìn etí òkun"},{"start":39.066,"end":40.271,"text":"Awa nfe 'mularada","marked":"Àwa ńfẹ́ múláradá"},{"start":40.721,"end":41.802,"text":"lwenumo ese wa.","marked":"lwẹ́numọ́ ẹ̀ṣẹ̀ wa."}],"end":41.802},{"key":"6","start":42.752,"lines":[{"start":42.752,"end":44.148,"text":"Jehovah Emmanueli,","marked":"Jehovah Emmanueli"},{"start":44.598,"end":45.689,"text":"Iwo ni ireti wa,","marked":"Ìwọ ni ìrètí wa"},{"start":46.139,"end":47.54,"text":"Mase je koju ti wa","marked":"Mase jẹ́ kojú ti wá"},{"start":47.99,"end":49.335,"text":"L'ojo nla 'dajo.","marked":"L'ọjọ́ ńlá dájọ́."}],"end":49.335},{"key":"7","start":50.285,"lines":[{"start":50.285,"end":51.304,"text":"Odagutan Olorun","marked":"Ọ̀dágùtàn Ọlọ́run"},{"start":51.754,"end":53.197,"text":"Baba at'Emi Mimo","marked":"Baba àt'ẹ̀mí Mímọ́"},{"start":53.647,"end":55.029,"text":"We ma mo patapata,","marked":"Wẹ má mọ́ pátápátá"},{"start":55.479,"end":57.028,"text":"Ko to kuro laiye yi.","marked":"Kò tó kúrò láìyẹ̀ yí."}],"end":57.028}]}