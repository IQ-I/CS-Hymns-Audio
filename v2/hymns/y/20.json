{"v":2,"coll":"y","num":20,"id":"hymn_20","title":"OSE, Ose rere","duration":61.586,"voices":{"male":{"file":"y-20-male-v2.m4a","bytes":432432,"sha256":"ffca786b0de0c7b1c06608f79eadd78d3d4ef8f34bcee8bbe3637de5fd581d39","duration":61.6},"female":{"file":"y-20-female-v2.m4a","bytes":450104,"sha256":"290e2dfbf0ef6148186eabee63f267571724ca5614a2e41afe2bc744c255f5a1","duration":61.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.262,"text":"OSE, Ose rere, Iwo ojo simi;","marked":"Ọ̀sẹ̀, Ọ̀sẹ̀ rere, Ìwọ ọjọ́ sími"},{"start":3.712,"end":5.257,"text":"O ye k'a fi ojo kan,","marked":"Ó yẹ k'á fi ọjọ́ kan"},{"start":5.707,"end":6.726,"text":"Fun Olorun rere,","marked":"Fún Ọlọ́run rere"},{"start":7.176,"end":8.493,"text":"B'ojo mi ba m'ekun wa,","marked":"B'ọjọ́ mi bá m'ẹkún wá"},{"start":8.943,"end":9.993,"text":"Iwo n'oju wa nu;","marked":"Ìwọ n'ojú wa nù"},{"start":10.443,"end":11.663,"text":"Iwo ti s'ojo ayo,","marked":"Ìwọ ti s'ọjọ́ ayọ̀"},{"start":12.113,"end":13.292,"text":"Emi fe dide re.","marked":"Èmi fẹ́ dìde rẹ̀."}],"end":13.292},{"key":"2","start":14.242,"lines":[{"start":14.242,"end":16.914,"text":"Ose, Ose, rere","marked":"Ọ̀sẹ̀, Ọ̀sẹ̀, rere"},{"start":17.364,"end":18.44,"text":"A ki o sise loni","marked":"A kí ó ṣiṣẹ́ lónì"},{"start":18.89,"end":20.299,"text":"A o f'ise wa gbogbo","marked":"A ó f'iṣẹ́ wa gbogbo"},{"start":20.749,"end":21.848,"text":"Fun aisimi ola,","marked":"Fún àìṣímí ọlá"},{"start":22.298,"end":23.558,"text":"Didan l'oju re ma dan","marked":"Dídán l'ojú rẹ̀ má dán"},{"start":24.008,"end":25.087,"text":"'Wo arewa ojo","marked":"wo arẹwà ọjọ́"},{"start":25.537,"end":26.842,"text":"Ojo mi nso ti lala,","marked":"Ọjọ́ mi ńṣọ́ ti lálà"},{"start":27.292,"end":28.681,"text":"Iwo nso ti 'simi.","marked":"Ìwọ ńṣọ́ ti ṣímí."}],"end":28.681},{"key":"3","start":29.631,"lines":[{"start":29.631,"end":31.85,"text":"Ose. Ose, rere","marked":"Ọ̀sẹ̀. Ọ̀sẹ̀, rere"},{"start":32.3,"end":33.572,"text":"Ago tile nwipe","marked":"Àgọ́ tilẹ̀ ńwípé"},{"start":34.022,"end":35.429,"text":"F'Eleda re l'ojo kan,","marked":"F'Ẹlẹ́dàá rẹ l'ọjọ́ kan"},{"start":35.879,"end":37.184,"text":"T'O fun wa n'Ijo mefa","marked":"T'ó fún wa n'Ìjọ mẹ́fà"},{"start":37.634,"end":38.767,"text":"A o fi 'se wa sile","marked":"A ó fi ṣe wá sílẹ̀"},{"start":39.217,"end":40.5,"text":"Lati lo sin nibe","marked":"Láti lọ sìn níbẹ̀"},{"start":40.95,"end":42.413,"text":"Awa ati ore we,","marked":"Àwa àti ọrẹ wẹ"},{"start":42.863,"end":44.143,"text":"Ao lo sile adua.","marked":"Àó lọ sílẹ̀ àdúà."}],"end":44.143},{"key":"4","start":45.093,"lines":[{"start":45.093,"end":47.514,"text":"Ose, Ose, rere","marked":"Ọ̀sẹ̀, Ọ̀sẹ̀, rere"},{"start":47.964,"end":49.36,"text":"Wakati re wu mi,","marked":"Wákàtí rẹ̀ wù mí"},{"start":49.81,"end":50.919,"text":"Ojo orun ni 'wo se","marked":"Ọjọ́ ọ̀run ni wo ṣe"},{"start":51.369,"end":52.27,"text":"'Wo apere orun","marked":"wo apẹ̀rẹ̀ ọ̀run"},{"start":52.72,"end":53.89,"text":"Oluwa, je ki njogun","marked":"Olúwa, jẹ́ kí ńjogún"},{"start":54.34,"end":55.409,"text":"'Simi lehin iku","marked":"ṣimi lẹ́hìn ikú"},{"start":55.859,"end":57.42,"text":"Ki nle ma sin O titi,","marked":"Kí ńlè má sin Ọ́ títí"},{"start":57.87,"end":58.925,"text":"Pelu enia Re.","marked":"Pẹ̀lú ẹnìà Rẹ."},{"start":59.375,"end":60.037,"text":"Amin.","marked":"Àmín."}],"end":60.037}]}