{"v":2,"coll":"y","num":36,"id":"hymn_36","title":"NlGBAWO Olugbala mi","duration":33.872,"voices":{"male":{"file":"y-36-male-v2.m4a","bytes":233972,"sha256":"c2a24d1cb9764ab617b0c5f1d1246b8659798b41387bd6c0dc5783054f53330f","duration":33.9},"female":{"file":"y-36-female-v2.m4a","bytes":237732,"sha256":"47f875c6b87c1a27922eeef7f5c5d90f8576b13dad2bdb541dfc2f988053fd70","duration":33.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.491,"text":"NlGBAWO Olugbala mi,","marked":"Ǹlgbáwọ́ Olùgbàlà mi"},{"start":1.941,"end":3.063,"text":"L'emi o ri O je?","marked":"L'èmi ó rí Ọ jẹ?"},{"start":3.513,"end":4.849,"text":"N'isimi t'o ni ibukun,","marked":"N'ìṣímí t'ó ní ìbùkún"},{"start":5.299,"end":6.772,"text":"Laisi 'boju larin.","marked":"Láìsí bojú lárin."}],"end":6.772},{"key":"2","start":7.722,"lines":[{"start":7.722,"end":8.961,"text":"Ran mi lowo n'irinkiri","marked":"Ràn mí lọ́wọ́ n'ìrìnkiri"},{"start":9.411,"end":10.843,"text":"L'aiye aniyan yi;","marked":"L'ayé àníyàn yí"},{"start":11.293,"end":13.113,"text":"Se mi ki nfi 'fe gbadura,","marked":"Ṣé mi kí ńfi fẹ́ gbàdúrà"},{"start":13.563,"end":14.937,"text":"Si gha adura mi.","marked":"Sì gha àdúrà mi."}],"end":14.937},{"key":"3","start":15.887,"lines":[{"start":15.887,"end":17.987,"text":"Da mi si, Baba, da mi si","marked":"Dá mi sí, Baba, dá mi sí"},{"start":18.437,"end":19.657,"text":"Mo f'ara mi fun O","marked":"Mo f'ara mi fún Ọ"},{"start":20.107,"end":21.478,"text":"Gba ohun gbogbo ti mo ni,","marked":"Gba ohun gbogbo tí mo ní"},{"start":21.928,"end":23.204,"text":"Si f'ara Re fun mi.","marked":"Sì f'ara Rẹ fún mi."}],"end":23.204},{"key":"4","start":24.154,"lines":[{"start":24.154,"end":25.954,"text":"Emi re, Baba, fifun mi,","marked":"Èmi rẹ, Baba, fífún mi"},{"start":26.404,"end":27.719,"text":"K'o le ma pelu mi,","marked":"K'ó lè má pẹ̀lú mi"},{"start":28.169,"end":29.461,"text":"K'o se imole ese mi,","marked":"K'ó ṣe ìmọ́lẹ̀ ẹ̀ṣẹ̀ mi"},{"start":29.911,"end":31.278,"text":"S'isimi ailopin.","marked":"S'ìṣímí àìlópin."},{"start":31.728,"end":32.322,"text":"Amin.","marked":"Àmín."}],"end":32.322}]}