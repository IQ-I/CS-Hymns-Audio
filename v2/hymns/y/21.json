{"v":2,"coll":"y","num":21,"id":"hymn_21","title":"OJO isimi at'ayo","duration":74.815,"voices":{"male":{"file":"y-21-male-v2.m4a","bytes":532124,"sha256":"07a6cba6418b54a9405ca246d4cc925f74d57c73260bf3c7d88434b980562b51","duration":74.9},"female":{"file":"y-21-female-v2.m4a","bytes":552478,"sha256":"da907082d40b9ae1adcd4cbbff99a6762cd23c11cae11e2144e312941ef53b0a","duration":74.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.934,"text":"OJO isimi at'ayo","marked":"Ọjọ́ ìṣimi àt'ayọ̀"},{"start":2.384,"end":3.592,"text":"Ojo inu didun;","marked":"Ọjọ́ inú dídùn"},{"start":4.042,"end":5.157,"text":"Ogun fun ibanuje","marked":"Ogun fún ìbànújẹ́"},{"start":5.607,"end":6.873,"text":"Ojo dida julo","marked":"Ọjọ́ dídá jùlọ"},{"start":7.323,"end":8.359,"text":"Ti awon eni giga","marked":"Ti àwọn ẹni gíga"},{"start":8.809,"end":9.845,"text":"Niwaju ite Re","marked":"Níwájú ìtẹ́ Rẹ"},{"start":10.295,"end":11.587,"text":"Nko mimo, mimo, mimo","marked":"Ǹkọ́ mímọ́, mímọ́, mímọ́"},{"start":12.037,"end":13.493,"text":"S'eni Metalokan.","marked":"S'ẹni Mẹ́talọ́kan."}],"end":13.493},{"key":"2","start":14.443,"lines":[{"start":14.443,"end":15.787,"text":"L'ojo yi ni 'mole la,","marked":"L'ọjọ́ yí ni mọ́lẹ̀ là"},{"start":16.237,"end":17.26,"text":"Nigba dida aiye","marked":"Nígbà dídá ayé"},{"start":17.71,"end":18.871,"text":"Ati fun igbala wa","marked":"Àti fún ìgbàlà wa"},{"start":19.321,"end":20.643,"text":"Kristi jinde loni,","marked":"Kristi jíǹde lónì"},{"start":21.093,"end":22.23,"text":"L'ojo oni l'Oluwa","marked":"L'ọjọ́ òní l'Olúwa"},{"start":22.68,"end":23.67,"text":"Ran Emi torun wa;","marked":"Rán Ẹ̀mí tọ́run wá"},{"start":24.12,"end":25.2,"text":"Ojo ologo julo","marked":"Ọjọ́ ológo jùlọ"},{"start":25.65,"end":26.926,"text":"T'o ni mole pipe.","marked":"T'ó ní mọ́lẹ̀ pípẹ́."}],"end":26.926},{"key":"3","start":27.876,"lines":[{"start":27.876,"end":29.243,"text":"Orisun 'tura ni O,","marked":"Orísun tura ni Ọ"},{"start":29.693,"end":30.945,"text":"L'aiye aginju yi,","marked":"L'ayé aginjù yí"},{"start":31.395,"end":33.238,"text":"L'ori Re, bi ni Pisga","marked":"L'orí Rẹ, bí ni Piṣga"},{"start":33.688,"end":34.899,"text":"L'a nwo 'le ileri","marked":"L'á ńwọ̀ lé ìlérí"},{"start":35.349,"end":36.624,"text":"Ojo ironu didun","marked":"Ọjọ́ ìrònú dídùn"},{"start":37.074,"end":38.065,"text":"Ojo ife mimo","marked":"Ọjọ́ ìfẹ́ mímọ́"},{"start":38.515,"end":40.813,"text":"Ojo ajinde, lati","marked":"Ọjọ́ àjíǹde, láti"},{"start":41.263,"end":42.636,"text":"Aiye si nkan orun.","marked":"Ayé sí nǹkan ọ̀run."}],"end":42.636},{"key":"4","start":43.586,"lines":[{"start":43.586,"end":45.106,"text":"L'oni s'ilu t'are mu,","marked":"L'óní s'ìlú t'àrẹ mú"},{"start":45.556,"end":46.794,"text":"Ni manna t'orun bo,","marked":"Ní manna t'ọ̀run bọ̀"},{"start":47.244,"end":48.632,"text":"Si ipejopo mimo","marked":"Sí ìpéjọpọ̀ mímọ́"},{"start":49.082,"end":50.218,"text":"N'ipe fadaka ndun,","marked":"N'ìpè fàdákà ńdùn"},{"start":50.668,"end":51.831,"text":"Nibiti ihin-rere,","marked":"Níbiti ihin-rere"},{"start":52.281,"end":53.621,"text":"Ntan imole mimo","marked":"Ǹtàn ìmọ́lẹ̀ mímọ́"},{"start":54.071,"end":55.379,"text":"Omi iye nsan jeje","marked":"Omi ìyè ńṣàn jẹ́jẹ́"},{"start":55.829,"end":57.035,"text":"Ti ntu okan lara.","marked":"Ti ńtu ọkàn lára."}],"end":57.035},{"key":"5","start":57.985,"lines":[{"start":57.985,"end":59.539,"text":"K'a r'ore‐ofe titun","marked":"K'á r'oore-ọ̀fẹ́ titun"},{"start":59.989,"end":61.117,"text":"L'ojo 'simi wa yi","marked":"L'ọjọ́ ṣímí wa yí"},{"start":61.567,"end":63.166,"text":"Ka si de simi t'o ku","marked":"Ká sì dé sími t'ó kú"},{"start":63.616,"end":64.929,"text":"F'awon alabukun","marked":"F'àwọn alábùkún"},{"start":65.379,"end":66.964,"text":"Nibe ka gbohun soke","marked":"Níbẹ̀ ká gbóhùn sókè"},{"start":67.414,"end":68.686,"text":"Si Baba at'Omo","marked":"Sí Baba àt'ọmọ"},{"start":69.136,"end":70.429,"text":"Ati si Emi Mimo","marked":"Àti sí Ẹ̀mí Mímọ́"},{"start":70.879,"end":72.208,"text":"N'iyin Metalokan.","marked":"N'ìyìn Mẹ́talọ́kan."},{"start":72.658,"end":73.266,"text":"Amin.","marked":"Àmín."}],"end":73.266}]}