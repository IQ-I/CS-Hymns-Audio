{"v":2,"coll":"y","num":80,"id":"hymn_80","title":"OLUWA, emi sa ti gbohun Re,","duration":51.886,"voices":{"male":{"file":"y-80-male-v2.m4a","bytes":362231,"sha256":"737e1dc59a924d3d2df1958243a3490d4e33b8727546a5ee108ee97f9b84e1ad","duration":51.9},"female":{"file":"y-80-female-v2.m4a","bytes":381491,"sha256":"78bf99ca4dd5f1220c89ad65e674e170abaa0728a3f06d3c566d79d308558898","duration":51.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.346,"text":"OLUWA, emi sa ti gbohun Re,","marked":"Olúwa, èmi sá ti gbóhùn Rẹ̀"},{"start":2.796,"end":4.056,"text":"O nso ife Re si mi,","marked":"Ó ńṣọ́ ìfẹ́ Rẹ̀ sí mi"},{"start":4.506,"end":6.222,"text":"Sugbon mo fe nde l'apa igbagbo,","marked":"Ṣùgbọ́n mo fẹ́ ńdé l'apá ìgbàgbọ́"},{"start":6.672,"end":8.137,"text":"Ki nle tubo sunmo O.","marked":"Kí ńlè túbọ̀ súnmọ́ Ọ."}],"end":8.137},{"key":"CHORUS","start":9.087,"lines":[{"start":9.087,"end":11.053,"text":"Fa mi mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra Olúwa"},{"start":11.503,"end":13.345,"text":"Sib'agbelebu t'Oku,","marked":"Síb'àgbélébù t'Òkú"},{"start":13.795,"end":16.869,"text":"Fa mi mora, mora, mora Oluwa","marked":"Fà mí mọ́ra, mọ́ra, mọ́ra Olúwa"},{"start":17.319,"end":18.961,"text":"Sib' eje Re t'o n'iye.","marked":"Síb ẹ̀jẹ̀ Rẹ̀ t'ó n'ìyẹ́."}],"end":18.961},{"key":"2","start":19.911,"lines":[{"start":19.911,"end":21.792,"text":"Ya mi si mimo fun ise Tire,","marked":"Yà mí sí mímọ́ fún iṣẹ́ Tire"},{"start":22.242,"end":23.413,"text":"Nipa Ore-Ofe Re,","marked":"Nípa Oore-ọ̀fẹ́ Rẹ"},{"start":23.863,"end":25.656,"text":"Je ki nfi okan igbagbo w'oke","marked":"Jẹ́ kí ńfi ọkàn ìgbàgbọ́ w'òkè"},{"start":26.106,"end":27.357,"text":"K'ife mi te si Tire.","marked":"K'ìfẹ́ mi tẹ́ sí Tire."},{"start":27.807,"end":28.653,"text":"Egbe:  Fa mi mora...","marked":"Fà mí mọ́ra"}],"end":28.653},{"key":"3","start":29.603,"lines":[{"start":29.603,"end":31.771,"text":"A! ayo mimo ti wakati kan,","marked":"A! ayọ̀ mímọ́ ti wákàtí kan"},{"start":32.221,"end":33.475,"text":"Ti mo lo nib'ite Re","marked":"Tí mo lọ níb'ìtẹ́ Rẹ"},{"start":33.925,"end":35.706,"text":"'Gba mo gbadura si O, Olorun","marked":"gbà mo gbàdúrà sí Ọ, Ọlọ́run"},{"start":36.156,"end":37.505,"text":"Ti a soro bi ore.","marked":"Tí a sọ̀rọ̀ bí ọ̀rẹ́."},{"start":37.955,"end":38.718,"text":"Egbe:  Fa mi mora...","marked":"Fà mí mọ́ra"}],"end":38.718},{"key":"4","start":39.668,"lines":[{"start":39.668,"end":41.742,"text":"Ijinle ife mbe ti nko le mo","marked":"Ìjìnlẹ̀ ìfẹ́ mbẹ́ tí ńkò lè mọ́"},{"start":42.192,"end":43.654,"text":"Titi ngo fi koja odo!","marked":"Títí ńgò fi kọjá odò!"},{"start":44.104,"end":45.99,"text":"Ayo giga ti emi ko le so,","marked":"Ayọ̀ gíga tí èmi kò lè sọ"},{"start":46.44,"end":47.897,"text":"Titi ngo fi de 'simi.","marked":"Títí ńgò fi dé ṣímí."},{"start":48.347,"end":49.183,"text":"Egbe:  Fa mi mora...","marked":"Fà mí mọ́ra"},{"start":49.633,"end":50.337,"text":"Amin.","marked":"Àmín."}],"end":50.337}]}