{"v":2,"coll":"y","num":1,"id":"hymn_1","title":"Ji, okan mi, ba orun ji","duration":34.73,"voices":{"male":{"file":"y-1-male-v2.m4a","bytes":240519,"sha256":"1d67242c972de2bad9d7d88071a6ecca47250f4fbf2b3ed43c063f8a1d28fe65","duration":34.8},"female":{"file":"y-1-female-v2.m4a","bytes":248879,"sha256":"619db33b975fa3a081cf8bacaa309f75468432afe79742bf2b144d45e5d9cc3c","duration":34.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.429,"text":"Ji, okan mi, ba orun ji","marked":"Jí, ọkàn mi, bá ọ̀run jí"},{"start":2.879,"end":4.198,"text":"Mura si ise ojo re;","marked":"Múra sí iṣẹ́ ọjọ́ rẹ"},{"start":4.648,"end":6.817,"text":"Mase ilora, ji kutu,","marked":"Máṣe ìlora, jí kùtù"},{"start":7.267,"end":8.717,"text":"K'o san gbese ebo oro.","marked":"K'ó san gbèsè ẹbọ ọ̀rọ̀."}],"end":8.717},{"key":"2","start":9.667,"lines":[{"start":9.667,"end":11.381,"text":"Ro gbogbo ojo t'o fi sofo","marked":"Rọ gbogbo ọjọ́ t'ó fi ṣọ̀fọ̀"},{"start":11.831,"end":13.026,"text":"Bere si rere 'se loni,","marked":"Bẹ̀rẹ̀ sí rere ṣe lónì"},{"start":13.476,"end":15.216,"text":"Kiyes' irin re laiye yi;","marked":"Kíyès irin rẹ̀ láìyẹ́ yí"},{"start":15.666,"end":17.45,"text":"K'o si mura d'ojo nla ni.","marked":"K'ó sì múra d'ọjọ́ ńlá ni."}],"end":17.45},{"key":"3","start":18.4,"lines":[{"start":18.4,"end":19.546,"text":"Gba ninu imole orun","marked":"Gbà nínú ìmọ́lẹ̀ ọ̀run"},{"start":19.996,"end":21.496,"text":"Si tan 'mole na f'elomi","marked":"Sì tan mọ́lẹ̀ ná f'ẹlòmí"},{"start":21.946,"end":23.048,"text":"Jeki ogo Olorun re,","marked":"Jẹ́kí ògo Ọlọ́run rẹ"},{"start":23.498,"end":24.904,"text":"Han n'nu wa ati ise re.","marked":"Hàn n'nù wá àti iṣẹ́ rẹ̀."}],"end":24.904},{"key":"4","start":25.854,"lines":[{"start":25.854,"end":27.334,"text":"Ji, gbon'ra nu ' wo okan mi","marked":"Jí, gbọ́n'ra nù ' wọ ọkàn mi"},{"start":27.784,"end":29.413,"text":"Yan ipo re larin Angel","marked":"Yan ipò rẹ̀ lárin Angẹl"},{"start":29.863,"end":31.177,"text":"Awon ti nwon nkorin iyin","marked":"Àwọn tí wọ́n ńkọrin ìyìn"},{"start":31.627,"end":33.181,"text":"Ni gbogbo oru s'Oba wa.","marked":"Ní gbogbo òru s'Ọba wa."}],"end":33.181}]}