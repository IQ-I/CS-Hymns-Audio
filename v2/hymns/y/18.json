{"v":2,"coll":"y","num":18,"id":"hymn_18","title":"IWO imole okan mi","duration":50.911,"voices":{"male":{"file":"y-18-male-v2.m4a","bytes":348787,"sha256":"8da6f8f6ceb1c35a3013bfe03a2d31680704fe8a94e234938aa8cd40970bbd22","duration":51.0},"female":{"file":"y-18-female-v2.m4a","bytes":366167,"sha256":"bea6d126aa1afe2062e74bd6ff92666ab69e78190d5c438efc7dd2e96fc42651","duration":51.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.715,"text":"IWO imole okan mi,","marked":"Ìwọ ìmọ́lẹ̀ ọkàn mi"},{"start":2.165,"end":3.938,"text":"Li odo Re oru ko si","marked":"Lí ọ̀dọ̀ Rẹ òru kò sí"},{"start":4.388,"end":5.788,"text":"Ki kuku aiye ma bo o,","marked":"Kí kúkú ayé má bò ó"},{"start":6.238,"end":7.588,"text":"Kuro I'oju iranse Re.","marked":"Kúrò l'ojú ìránṣẹ́ Rẹ."}],"end":7.588},{"key":"2","start":8.538,"lines":[{"start":8.538,"end":10.003,"text":"Nigba t'orun ale didun","marked":"Nígbà t'ọ̀run alẹ́ dídùn"},{"start":10.453,"end":11.968,"text":"Ba npa ipenpeju mi de","marked":"Bá ńpa ìpéǹpéjú mi dé"},{"start":12.418,"end":13.762,"text":"K'ero mi je lati simi","marked":"K'èrò mi jẹ́ láti ṣímí"},{"start":14.212,"end":15.702,"text":"Lai l'aiya Olugbala mi.","marked":"Láì l'àìyá Olùgbàlà mi."}],"end":15.702},{"key":"3","start":16.652,"lines":[{"start":16.652,"end":17.894,"text":"Ba mi gbe l'oro tit'ale","marked":"Bá mi gbé l'ọ̀rọ̀ tít'àlè"},{"start":18.344,"end":19.931,"text":"Laisi Re emi ko le wa,","marked":"Láìsí Rẹ èmi kò lè wá"},{"start":20.381,"end":21.955,"text":"Ba mi gbe gbat'ile ba nsu","marked":"Bá mi gbé gbàt'ilẹ̀ bá ńṣù"},{"start":22.405,"end":24.45,"text":"Laisi Re, emi ko le ku","marked":"Láìsí Rẹ, èmi kò lè kú"}],"end":24.45},{"key":"4","start":25.4,"lines":[{"start":25.4,"end":26.824,"text":"Bi otosi omo Re kan,","marked":"Bí òtòṣì ọmọ Rẹ̀ kan"},{"start":27.274,"end":28.572,"text":"Ba tapa s'oro Re loni","marked":"Bá tàpá s'ọ̀rọ̀ Rẹ lónì"},{"start":29.022,"end":30.696,"text":"Oluwa, sise oro Re","marked":"Olúwa, ṣiṣẹ́ ọ̀rọ̀ Rẹ"},{"start":31.146,"end":32.777,"text":"Ma jek'o sun ninu ese","marked":"Má jẹ́k'ó sùn nínú ẹ̀ṣẹ̀"}],"end":32.777},{"key":"5","start":33.727,"lines":[{"start":33.727,"end":34.869,"text":"Bukun fun awon alaisan","marked":"Bùkún fún àwọn aláìsàn"},{"start":35.319,"end":36.531,"text":"Pese fun awon talaka","marked":"Pèsè fún àwọn tálákà"},{"start":36.981,"end":38.301,"text":"K'orun alawe l'ale yi","marked":"K'ọ̀run aláwẹ́ l'alẹ́ yí"},{"start":38.751,"end":40.315,"text":"Dabi orun omo titun.","marked":"Dàbí ọ̀run ọmọ titun."}],"end":40.315},{"key":"6","start":41.265,"lines":[{"start":41.265,"end":42.739,"text":"Sure fun wa nighat' aji,","marked":"Súre fún wa níghàt ajì"},{"start":43.189,"end":44.808,"text":"K'a to m'ohun aiye yi se,","marked":"K'á tó m'ohun ayé yí ṣe"},{"start":45.258,"end":46.489,"text":"Titi awa o de bite","marked":"Títí àwa ó dé bìtẹ̀"},{"start":46.939,"end":48.349,"text":"T'a o si de ijoba Re.","marked":"T'a ó sì dé ìjọba Rẹ̀."},{"start":48.799,"end":49.361,"text":"Amin.","marked":"Àmín."}],"end":49.361}]}