{"v":2,"coll":"y","num":7,"id":"hymn_7","title":"JESU, Orun ododo","duration":55.728,"voices":{"male":{"file":"y-7-male-v2.m4a","bytes":386812,"sha256":"d578b9f85e0d7db5fd00724aec436f5b3a639aa596c64fed5db79825d15b2d59","duration":55.8},"female":{"file":"y-7-female-v2.m4a","bytes":396385,"sha256":"2dc5c76d5894e01c891207429d611ca38538994ced698e19a82844d04d8faf84","duration":55.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.878,"text":"JESU, Orun ododo,","marked":"Jésù, Ọ̀run òdodo"},{"start":2.328,"end":3.528,"text":"Iwo Imole ife","marked":"Ìwọ Ìmọ́lẹ̀ ìfẹ́"},{"start":3.978,"end":5.121,"text":"Gbat' imole owuro","marked":"Gbàt ìmọ́lẹ̀ òwúrọ̀"},{"start":5.571,"end":6.765,"text":"Ba nt'ila orun tan wa,","marked":"Bá ńt'ìlà ọ̀run tàn wá"},{"start":7.215,"end":8.232,"text":"Tanmole ododo Re","marked":"Tànmọ́lẹ̀ òdodo Rẹ"},{"start":8.682,"end":9.592,"text":"Yi wa ka.","marked":"Yí wa ká."}],"end":9.592},{"key":"2","start":10.542,"lines":[{"start":10.542,"end":11.768,"text":"Gege bi in ti nse,","marked":"Gẹ́gẹ́ bí in ti ńṣe"},{"start":12.218,"end":13.362,"text":"Son eweko gbogbo,","marked":"Sọn ewéko gbogbo"},{"start":13.812,"end":14.832,"text":"K'Emi ore'ofe Re","marked":"K'Ẹ̀mí ọrẹ'ọ̀fẹ́ Rẹ"},{"start":15.282,"end":16.527,"text":"So okan wa 'di otun;","marked":"Sọ ọkàn wa di ọ̀tún"},{"start":16.977,"end":18.065,"text":"Ro ojo ibuknn Re","marked":"Rọ ọjọ́ ìbùknn Rẹ"},{"start":18.515,"end":19.234,"text":"Sori wa.","marked":"Sórí wa."}],"end":19.234},{"key":"3","start":20.184,"lines":[{"start":20.184,"end":21.506,"text":"B'imole orun ti nran","marked":"B'ìmọ́lẹ̀ ọ̀run ti ńran"},{"start":21.956,"end":23.481,"text":"K'imole ife Tire,","marked":"K'ìmọ́lẹ̀ ìfẹ́ Tire"},{"start":23.931,"end":25.637,"text":"Si ma ghona l'okan wa,","marked":"Sì má ghóná l'ọkàn wa"},{"start":26.087,"end":27.495,"text":"K'o si mu wa l'ara ya,","marked":"K'ó sì mú wa l'ára ya"},{"start":27.945,"end":29.377,"text":"K'a le ma fayo sin O,","marked":"K'á lè má fàyọ sìn Ọ"},{"start":29.827,"end":30.741,"text":"L'aiye wa.","marked":"L'ayé wà."}],"end":30.741},{"key":"4","start":31.691,"lines":[{"start":31.691,"end":33.391,"text":"Amona, lreti wa,","marked":"Amọ̀nà, lretí wa"},{"start":33.841,"end":35.156,"text":"Ma fi wa sile tili,","marked":"Má fi wá sílẹ̀ tìlì"},{"start":35.606,"end":36.863,"text":"Fi wa sabe iso Re,","marked":"Fi wá sábẹ́ ìṣọ́ Rẹ"},{"start":37.313,"end":38.86,"text":"Titi opin emi wa,","marked":"Títí òpin èmi wà"},{"start":39.31,"end":40.803,"text":"Sin wa la ajo wa ja","marked":"Sin wá la àjọ wa jà"},{"start":41.253,"end":42.09,"text":"S'ile wa.","marked":"S'ilẹ̀ wà."}],"end":42.09},{"key":"5","start":43.04,"lines":[{"start":43.04,"end":44.676,"text":"Pa wa mo n'nu ife Re,","marked":"Pa wá mọ́ n'nú ìfẹ́ Rẹ"},{"start":45.126,"end":46.37,"text":"Lojo aiye wa gbogbo,","marked":"Lọ́jọ́ ayé wá gbogbo"},{"start":46.82,"end":48.168,"text":"Si mu wa bori iku,","marked":"Sì mú wa borí ikú"},{"start":48.618,"end":49.863,"text":"Mu wa de'le ayo na,","marked":"Mú wa dé'lé ayọ̀ ná"},{"start":50.313,"end":51.551,"text":"K'a le b'awon mimo","marked":"K'á lè b'àwọn mímọ́"},{"start":52.001,"end":53.097,"text":"gba isin mi.","marked":"gba ìsìn mi."},{"start":53.547,"end":54.179,"text":"Amin.","marked":"Àmín."}],"end":54.179}]}