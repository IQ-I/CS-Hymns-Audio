{"v":2,"coll":"y","num":4,"id":"hymn_4","title":"WA s'odo mi, Oluwa mi","duration":44.52,"voices":{"male":{"file":"y-4-male-v2.m4a","bytes":316126,"sha256":"10d6dd00e576802f01e69e3005735682db464e0efea3d820b631f076333d2190","duration":44.6},"female":{"file":"y-4-female-v2.m4a","bytes":324029,"sha256":"4579d7addea2adc42f5eb2a758aa5f6fb5930775a04d86e571a22ea17287e0d2","duration":44.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.022,"text":"WA s'odo mi, Oluwa mi","marked":"Wá s'ọ́dọ̀ mi, Olúwa mi"},{"start":2.472,"end":3.601,"text":"Ni kutukutu owuro","marked":"Ní kùtùkùtù òwúrọ̀"},{"start":4.051,"end":5.433,"text":"Mu k'ero rere so jade,","marked":"Mú k'èrò rere sọ jáde"},{"start":5.883,"end":7.461,"text":"Lat' inu mi soke orun.","marked":"Lát inú mi sókè ọ̀run."}],"end":7.461},{"key":"2","start":8.411,"lines":[{"start":8.411,"end":10.096,"text":"Wa soda mi, Oluwa mi,","marked":"Wá sọ́dà mi, Olúwa mi"},{"start":10.546,"end":12.25,"text":"Ni wakati osan gangan;","marked":"Ní wákàtí ọ̀sán gangan"},{"start":12.7,"end":13.886,"text":"Ki 'yonu ma ba se mi mo,","marked":"Kí yọnu má bá ṣe mí mọ́"},{"start":14.336,"end":15.693,"text":"Nwon a si s'osan mi d'oru.","marked":"Wọ́n a sì s'ọ̀sán mi d'òru."}],"end":15.693},{"key":"3","start":16.643,"lines":[{"start":16.643,"end":18.546,"text":"Wa sodo mi, Oluwa mi,","marked":"Wá sọ́dọ̀ mi, Olúwa mi"},{"start":18.996,"end":20.325,"text":"Nigbati ale ba nle lo,","marked":"Nígbàtí alẹ́ bá ńlè lọ"},{"start":20.775,"end":22.178,"text":"Bi okan mi ba nsako lo,","marked":"Bí ọkàn mi bá ńṣáko lọ"},{"start":22.628,"end":24.281,"text":"Mu pada, f'oju 're wo mi.","marked":"Mú padà, f'ojú rẹ̀ wò mí."}],"end":24.281},{"key":"4","start":25.231,"lines":[{"start":25.231,"end":26.927,"text":"Wa sodo mi, Oluwa mi,","marked":"Wá sọ́dọ̀ mi, Olúwa mi"},{"start":27.377,"end":29.065,"text":"Li oru, nigbati orun","marked":"Lí òru, nígbàtí ọ̀run"},{"start":29.515,"end":31.687,"text":"Ko woju mi; je k'okan mi","marked":"Kò wojú mi; jẹ́ k'ọkàn mi"},{"start":32.137,"end":33.642,"text":"Ri simi je li aiya Re.","marked":"Rí ṣímí jẹ́ lí àìyá Rẹ."}],"end":33.642},{"key":"5","start":34.592,"lines":[{"start":34.592,"end":36.245,"text":"Wa sodo mi, Oluwa mi,","marked":"Wá sọ́dọ̀ mi, Olúwa mi"},{"start":36.695,"end":38.109,"text":"Ni gbogbo ojo aiye mi,","marked":"Ní gbogbo ọjọ́ ayé mi"},{"start":38.559,"end":40.016,"text":"Nigbati emi mi ba pin,","marked":"Nígbàtí ẹ̀mí mi bá pín"},{"start":40.466,"end":41.973,"text":"Ki nle n'ibugbe lodo Re.","marked":"Kí ńlè n'ibùgbé lọ́dọ̀ Rẹ."},{"start":42.423,"end":42.971,"text":"Amin.","marked":"Àmín."}],"end":42.971}]}