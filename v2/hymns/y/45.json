{"v":2,"coll":"y","num":45,"id":"hymn_45","title":"MO ntoro nkan lodo Kristi","duration":52.546,"voices":{"male":{"file":"y-45-male-v2.m4a","bytes":371666,"sha256":"54662ed60bd0b8aa6b4dcf94b7dc06fec41aaadf46b89519cf01a135ce4c2a15","duration":52.6},"female":{"file":"y-45-female-v2.m4a","bytes":382930,"sha256":"cab718dc646c9db21739c569ffffd867f659efe91d40f0dd4aed650e52fd77e5","duration":52.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.086,"text":"MO ntoro nkan lodo Kristi,","marked":"Mo ńtọrọ nǹkan lọ́dọ̀ Kristi"},{"start":2.536,"end":3.852,"text":"'Tori ere po lona mi,","marked":"torí ère pọ̀ lọ́nà mi"},{"start":4.302,"end":5.874,"text":"Yala pe lomi tab'ina","marked":"Yálà pé lómi tàb'iná"},{"start":6.324,"end":8.022,"text":"Sa we mi mo, sa we mi mo.","marked":"Sá wẹ̀ mí mọ́, sá wẹ̀ mí mọ́."}],"end":8.022},{"key":"CHORUS","start":8.972,"lines":[{"start":8.972,"end":11.552,"text":"Jo, we mi mo-t'ara t'okan","marked":"Jọ, wẹ̀ mi mo-t'ara t'ọkàn"},{"start":12.002,"end":13.804,"text":"Ngo ko ina - bo ba gba be","marked":"Ngọ́ kó iná bó bá gbà bẹ"},{"start":14.254,"end":15.927,"text":"Ona-kona Io dun mo mi,","marked":"Ona-kona ló dùn mọ́ mi"},{"start":16.377,"end":18.226,"text":"K 'ese sa ku 'nu okan mi.","marked":"K ẹ̀ṣẹ̀ sá kú nù ọkàn mi."}],"end":18.226},{"key":"2","start":19.176,"lines":[{"start":19.176,"end":20.648,"text":"B'o ba f'iran didan han mi","marked":"B'ó bá f'ìran dídán hàn mí"},{"start":21.098,"end":22.813,"text":"Ngo dupe inu mi yio dun","marked":"Ngọ́ dúpẹ́ inú mi yóò dùn"},{"start":23.263,"end":24.84,"text":"Sugbon okan t'o mo gara","marked":"Ṣùgbọ́n ọkàn t'ó mọ́ gara"},{"start":25.29,"end":27.105,"text":"Ni mo fe ju, ni mo fe ju.","marked":"Ni mo fẹ́ ju, ni mo fẹ́ ju."},{"start":27.555,"end":28.614,"text":"Egbe: Jo, we mi mo...","marked":"Jọ, wẹ̀ mi mọ́"}],"end":28.614},{"key":"3","start":29.564,"lines":[{"start":29.564,"end":30.94,"text":"Nigbati okan mi ba mo,","marked":"Nígbàtí ọkàn mi bá mọ́"},{"start":31.39,"end":33.257,"text":"Iran didan yio han si mi,","marked":"Ìran dídán yóò hàn sí mi"},{"start":33.707,"end":35.029,"text":"Nitori okukun su bo","marked":"Nítorí òkùkùn ṣú bọ̀"},{"start":35.479,"end":37.371,"text":"Iran orun, Iran orun.","marked":"Ìran ọ̀run, Ìran ọ̀run."},{"start":37.821,"end":38.826,"text":"Egbe: Jo, we mi mo...","marked":"Jọ, wẹ̀ mi mọ́"}],"end":38.826},{"key":"4","start":39.776,"lines":[{"start":39.776,"end":41.61,"text":"Mo ndu ki nsa f'ona ese","marked":"Mo ńdú kí ńṣá f'ọ̀nà ẹ̀ṣẹ̀"},{"start":42.06,"end":43.353,"text":"Ki nsi yago f'ero ese","marked":"Kí ńsì yàgò f'èrò ẹ̀ṣẹ̀"},{"start":43.803,"end":45.49,"text":"B'ijakadi mi ti to yi,","marked":"B'ìjàkadì mi ti tó yí"},{"start":45.94,"end":48.43,"text":"Sibe nko mo, sibe nko mo.","marked":"Síbẹ̀ ńkò mọ́, síbẹ̀ ńkò mọ́."},{"start":48.88,"end":49.975,"text":"Egbe: Jo, we mi mo...","marked":"Jọ, wẹ̀ mi mọ́"},{"start":50.425,"end":50.997,"text":"Amin.","marked":"Àmín."}],"end":50.997}]}