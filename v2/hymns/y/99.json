{"v":2,"coll":"y","num":99,"id":"hymn_99","title":"ENYlN Egbe Serafu,","duration":97.208,"voices":{"male":{"file":"y-99-male-v2.m4a","bytes":659160,"sha256":"869dafd2bc1425c86fe8ac09d54e63af86804cd4834bfc93fdb0846a57055ab7","duration":97.3},"female":{"file":"y-99-female-v2.m4a","bytes":695980,"sha256":"a61ed6c5cdad7593d250a9da5aed2ed008d3bf307dd1394da9fc70bc6befcaef","duration":97.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.531,"text":"ENYlN Egbe Serafu,","marked":"Ẹnyln Ẹgbẹ́ Séráfù"},{"start":1.981,"end":3.271,"text":"Ati Egbe Kerubu","marked":"Àti Ẹgbẹ́ Kérúbù"},{"start":3.721,"end":5.191,"text":"E fi ope fun Olorun,","marked":"Ẹ fi ọpẹ́ fún Ọlọ́run"},{"start":5.641,"end":7.117,"text":"T'o d'emi wa si d'oni.","marked":"T'ó d'èmi wá sì d'òní."}],"end":7.117},{"key":"CHORUS","start":8.067,"lines":[{"start":8.067,"end":9.326,"text":"Emi ko Ie sai sope","marked":"Èmi kò lè ṣàì ṣọpẹ́"},{"start":9.776,"end":10.938,"text":"Ore t'Olorun se fun mi,","marked":"Ọrẹ t'Ọlọ́run ṣe fún mi"},{"start":11.388,"end":13.077,"text":"Emi ko Ie sai sope.","marked":"Èmi kò lè ṣàì ṣọpẹ́."}],"end":13.077},{"key":"2","start":14.027,"lines":[{"start":14.027,"end":15.432,"text":"Loto l'esu gbogun","marked":"Lọ́tọ̀ l'eṣú gbógun"},{"start":15.882,"end":17.201,"text":"Sugbon ko le segun","marked":"Ṣùgbọ́n kò lè ṣẹ́gun"},{"start":17.651,"end":18.848,"text":"Lagbara Metalokan wa,","marked":"Lágbára Mẹ́talọ́kan wa"},{"start":19.298,"end":20.539,"text":"Awa yio bori re.","marked":"Àwa yóò borí rẹ̀."}],"end":20.539},{"key":"3","start":21.489,"lines":[{"start":21.489,"end":22.737,"text":"Elomiran ti ku,","marked":"Ẹlòmíràn ti kú"},{"start":23.187,"end":24.01,"text":"Elomiran w'ewon","marked":"Ẹlòmíràn w'ẹ̀wọ̀n"},{"start":24.46,"end":25.729,"text":"Elomiran nrin ni ile","marked":"Ẹlòmíràn ńrìn ní ilẹ̀"},{"start":26.179,"end":27.546,"text":"Ti moto ti te pa.","marked":"Ti mọ̀tọ̀ ti tẹ́ pa."}],"end":27.546},{"key":"4","start":28.496,"lines":[{"start":28.496,"end":29.839,"text":"Ope ni f'Olorun,","marked":"Ọpẹ́ ni f'Ọlọ́run"},{"start":30.289,"end":31.684,"text":"F'anu Re l'Ori wa,","marked":"F'àánú Rẹ l'Orí wa"},{"start":32.134,"end":34.488,"text":"O gbo tire, O gbo temi,","marked":"Ó gbọ́ tirẹ̀, Ó gbọ́ tèmi"},{"start":34.938,"end":36.175,"text":"Ogo ni f'Olorun.","marked":"Ògo ni f'Ọlọ́run."}],"end":36.175},{"key":"5","start":37.125,"lines":[{"start":37.125,"end":37.978,"text":"Olorun alanu,","marked":"Ọlọ́run alánù"},{"start":38.428,"end":39.641,"text":"Siju anu wo wa,","marked":"Síjú àánú wò wá"},{"start":40.091,"end":41.434,"text":"Jowo pese fun aini wa,","marked":"Jọ̀wọ́ pèsè fún àìní wa"},{"start":41.884,"end":43.165,"text":"K'ile r'oju fun wa.","marked":"K'ilẹ̀ r'ojú fún wa."}],"end":43.165},{"key":"6","start":44.115,"lines":[{"start":44.115,"end":45.315,"text":"F'ilera f'alaisan","marked":"F'ìlera f'aláìsàn"},{"start":45.765,"end":46.887,"text":"Jesu Olugbala","marked":"Jésù Olùgbàlà"},{"start":47.337,"end":48.424,"text":"Jeki awon alaisan,","marked":"Jẹ́kí àwọn aláìsàn"},{"start":48.874,"end":50.22,"text":"Ri 'wosan lodo Re.","marked":"Rí wòsàn lọ́dọ̀ Rẹ."}],"end":50.22},{"key":"7","start":51.17,"lines":[{"start":51.17,"end":52.166,"text":"Mu ile ri re ese","marked":"Mú ilé rí rẹ ẹ̀ṣẹ̀"},{"start":52.616,"end":54.194,"text":"Jehovah Tabbikubb,","marked":"Jehovah Tabbikubb"},{"start":54.644,"end":55.876,"text":"K'awon afoju le riran","marked":"K'àwọn afọ́jú lè ríran"},{"start":56.326,"end":57.783,"text":"K'alailera k'o san.","marked":"K'aláìlera k'ó sàn."}],"end":57.783},{"key":"8","start":58.733,"lines":[{"start":58.733,"end":60.071,"text":"Opo ti sako lo","marked":"Ọ̀pọ̀ ti ṣáko lọ"},{"start":60.521,"end":61.591,"text":"Nwon ko si mona mo","marked":"Wọ́n kò sì mọ̀nà mọ́"},{"start":62.041,"end":63.549,"text":"Elomiran j'asiwaju","marked":"Ẹlòmíràn j'aṣíwájú"},{"start":63.999,"end":65.51,"text":"Sugbon o fa s'ehin.","marked":"Ṣùgbọ́n ó fa s'ẹ́hìn."}],"end":65.51},{"key":"9","start":66.46,"lines":[{"start":66.46,"end":68.023,"text":"Jehovah-Jire wa,","marked":"Jehovah-jire wà"},{"start":68.473,"end":69.741,"text":"Pese fun aini wa,","marked":"Pèsè fún àìní wa"},{"start":70.191,"end":71.389,"text":"Pese omo f'awon agan","marked":"Pèsè ọmọ f'àwọn àgàn"},{"start":71.839,"end":73.319,"text":"Jek' a ri 'bukun gba.","marked":"Jẹ́k a rí bùkún gbà."}],"end":73.319},{"key":"10","start":74.269,"lines":[{"start":74.269,"end":75.074,"text":"Olorun alanu","marked":"Ọlọ́run alánù"},{"start":75.524,"end":76.762,"text":"Dariji eda Re;","marked":"Dáríjì ẹ̀dà Rẹ"},{"start":77.212,"end":78.882,"text":"Mase f'ese bi araiye","marked":"Maṣe f'ẹsẹ̀ bí aráìyè"},{"start":79.332,"end":80.62,"text":"Jeki ojo k'o ro.","marked":"Jẹ́kí ọjọ́ k'ó rọ."}],"end":80.62},{"key":"11","start":81.57,"lines":[{"start":81.57,"end":82.717,"text":"F'ibukun Re f'Oba","marked":"F'ìbùkún Rẹ f'Ọba"},{"start":83.167,"end":84.27,"text":"At'awon Igbimo","marked":"Àt'àwọn Ìgbìmọ̀"},{"start":84.72,"end":86.08,"text":"F'alafia fun ilu wa","marked":"F'àlàáfíà fún ìlú wa"},{"start":86.53,"end":88.077,"text":"K'a ma rogun adaja.","marked":"K'á má rọ̀gún adájà."}],"end":88.077},{"key":"12","start":89.027,"lines":[{"start":89.027,"end":90.275,"text":"E f'ogo fun Baba","marked":"Ẹ f'ògo fún Baba"},{"start":90.725,"end":91.975,"text":"E f'Ogo fun Omo","marked":"Ẹ f'Ògo fún Ọmọ"},{"start":92.425,"end":93.852,"text":"E f'ogo fun Emi Mimo","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́"},{"start":94.302,"end":95.659,"text":"Metalokan lailai.","marked":"Mẹ́talọ́kan láéláé."}],"end":95.659}]}