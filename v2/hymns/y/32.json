{"v":2,"coll":"y","num":32,"id":"hymn_32","title":"EYI I'ojo t'Oluwa da","duration":42.243,"voices":{"male":{"file":"y-32-male-v2.m4a","bytes":289830,"sha256":"6da1f82f7a28d29a784641c3482ee5bc86f6c3c5e877f8ff49cba8e54113f0bf","duration":42.3},"female":{"file":"y-32-female-v2.m4a","bytes":299010,"sha256":"07462a5cecc05204706838758bac383245e95bae3ed3eb98b3ded27eb22fbc6f","duration":42.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.651,"text":"EYI I'ojo t'Oluwa da,","marked":"Èyí l'ọjọ́ t'Olúwa dá"},{"start":2.101,"end":3.277,"text":"O pe 'gba na ntire","marked":"Ó pé gba na ńtirẹ̀"},{"start":3.727,"end":6.083,"text":"K'orun k'o yo, k'aiye ko yo","marked":"K'ọ̀run k'ò yọ, k'ayé kò yọ"},{"start":6.533,"end":7.778,"text":"K'iyin yi 'te na ka.","marked":"K'ìyìn yí tẹ́ ná ká."}],"end":7.778},{"key":"2","start":8.728,"lines":[{"start":8.728,"end":10.926,"text":"Loni, o jinde 'nu oku","marked":"Lónì, ó jíǹde nù òkú"},{"start":11.376,"end":12.726,"text":"ljoba Satan tu","marked":"ljọba Satan tú"},{"start":13.176,"end":14.541,"text":"'Won mimo tan 'segun Re ka,","marked":"wọn mímọ́ tan ṣẹ́gun Rẹ̀ ká"},{"start":14.991,"end":16.074,"text":"Nwon nsoro 'yanu Re.","marked":"Wọ́n ńsọ̀rọ̀ yanu Rẹ̀."}],"end":16.074},{"key":"3","start":17.024,"lines":[{"start":17.024,"end":18.913,"text":"Hosanna si Oba t'a yan","marked":"Hosanna sí Ọba t'á yàn"},{"start":19.363,"end":20.755,"text":"S'Omo Mimo Dafidi","marked":"S'Ọmọ Mímọ́ Dafidi"},{"start":21.205,"end":22.633,"text":"Oluwa, jo sokale wa,","marked":"Olúwa, jọ sọ̀kalẹ̀ wá"},{"start":23.083,"end":24.379,"text":"T' lwo t'igbala Re.","marked":"T lwò t'ìgbàlà Rẹ."}],"end":24.379},{"key":"4","start":25.329,"lines":[{"start":25.329,"end":26.866,"text":"Abukun l'Oluwa t'o wa","marked":"Àbùkún l'Olúwa t'ó wà"},{"start":27.316,"end":28.481,"text":"N'ise ore-ofe","marked":"N'iṣẹ́ oore-ọ̀fẹ́"},{"start":28.931,"end":30.293,"text":"T'o wa l'Oruko Baba Re,","marked":"T'ó wà l'Orúkọ Baba Rẹ"},{"start":30.743,"end":31.995,"text":"Lati gba 'ran wa la.","marked":"Láti gba rán wa là."}],"end":31.995},{"key":"5","start":32.945,"lines":[{"start":32.945,"end":34.148,"text":"Hosanna li ohun goro,","marked":"Hosanna lí ohun gọ̀rọ̀"},{"start":34.598,"end":35.84,"text":"L'orin ljo t'aiye","marked":"L'orin ljó t'ayé"},{"start":36.29,"end":37.661,"text":"Orin t'oke orun lohun","marked":"Orin t'òkè ọ̀run lóhùn"},{"start":38.111,"end":39.597,"text":"Yio dun ju be lo.","marked":"Yóò dùn ju bẹ lọ."},{"start":40.047,"end":40.694,"text":"Amin.","marked":"Àmín."}],"end":40.694}]}