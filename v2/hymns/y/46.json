{"v":2,"coll":"y","num":46,"id":"hymn_46","title":"GB'ADURA wa, Oba aiye","duration":48.024,"voices":{"male":{"file":"y-46-male-v2.m4a","bytes":339579,"sha256":"ecd64bdf11714ab0c7e9f63e1ec9764a8044ed51e703c7c7deb4eaf0a0e33f59","duration":48.1},"female":{"file":"y-46-female-v2.m4a","bytes":355580,"sha256":"08485c37984106b04384c8326105551d09c8d6cd0cada9a4489b0698823f29fa","duration":48.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.37,"text":"GB'ADURA wa, Oba aiye,","marked":"Gb'àdúrà wa, Ọba ayé"},{"start":2.82,"end":3.795,"text":"'Gbat'a wole fun O","marked":"gbàt'á wọlé fún Ọ"},{"start":4.245,"end":5.48,"text":"Gbogbo wa nkigbe n'irele","marked":"Gbogbo wa ńkígbe n'ìrẹ̀lẹ̀"},{"start":5.93,"end":7.02,"text":"A mbebe fun anu","marked":"A mbẹ̀bẹ̀ fún àánú"},{"start":7.47,"end":9.568,"text":"T'iwa l'ebi, tire l'anu","marked":"T'ìwà l'ẹ̀bi, tirẹ̀ l'àánú"},{"start":10.018,"end":11.157,"text":"Mase le wa pada,","marked":"Máṣe lè wá padà"},{"start":11.607,"end":13.082,"text":"Sugbon gbo 'gbe wa n'ite Re,","marked":"Ṣùgbọ́n gbọ́ gbé wà n'ìtẹ́ Rẹ"},{"start":13.532,"end":15.075,"text":"Ran adura wa Iowa.","marked":"Rán àdúrà wa lọ́wa."}],"end":15.075},{"key":"2","start":16.025,"lines":[{"start":16.025,"end":17.672,"text":"Ese awon baba wa po","marked":"Ẹsẹ̀ àwọn Baba wa pọ̀"},{"start":18.122,"end":19.185,"text":"Tiwa ko si kere,","marked":"Tiwa kò sì kéré"},{"start":19.635,"end":20.976,"text":"Sugbon lati irandiran","marked":"Ṣùgbọ́n láti ìrandíran"},{"start":21.426,"end":22.578,"text":"Lo ti f'ore Re han","marked":"Ló ti f'ọrẹ Rẹ̀ hàn"},{"start":23.028,"end":24.807,"text":"Nigba ewu, b'omi jija","marked":"Nígbà ewu, b'omi jíjà"},{"start":25.257,"end":26.505,"text":"Yi ilu wa yi ka","marked":"Yí ìlú wa yí ká"},{"start":26.955,"end":28.798,"text":"lwo la nwo ta si nkepe","marked":"lwó la ńwọ ta sì ńképe"},{"start":29.248,"end":30.439,"text":"K'a ma r'iranwo Re.","marked":"K'á má r'ìrànwọ́ Rẹ."}],"end":30.439},{"key":"3","start":31.389,"lines":[{"start":31.389,"end":32.894,"text":"L'ohun kan gbogbo wa wole","marked":"L'ohun kan gbogbo wa wọlé"},{"start":33.344,"end":34.348,"text":"L'abe iyonu Re,","marked":"L'abẹ́ ìyọnu Rẹ"},{"start":34.798,"end":36.646,"text":"Gbogbo wa njewo ese wa,","marked":"Gbogbo wa ǹjẹ́wọ́ ẹ̀ṣẹ̀ wa"},{"start":37.096,"end":38.319,"text":"A ngbawe fun 'Ie wa","marked":"A ńgbàwẹ̀ fún lè wà"},{"start":38.769,"end":40.339,"text":"F'oju anu wo aini wa,","marked":"F'ojú àánú wo àìní wa"},{"start":40.789,"end":41.842,"text":"Bi a ti nkepe O!","marked":"Bí a ti ńkẹpẹ Ọ!"},{"start":42.292,"end":43.604,"text":"Ma fi 'dajo Re ba wa wi,","marked":"Má fi dájọ́ Rẹ bá wa wí"},{"start":44.054,"end":45.344,"text":"Da wa si lanu Re.","marked":"Dá wa sì lanu Rẹ."},{"start":45.794,"end":46.474,"text":"Amin.","marked":"Àmín."}],"end":46.474}]}