{"v":2,"coll":"y","num":102,"id":"hymn_102","title":"E YO loni pe l'ohun kan","duration":52.906,"voices":{"male":{"file":"y-102-male-v2.m4a","bytes":377475,"sha256":"489532db010efba89d048d2a1ff5beee6d7fc1c05d887c196f86c2cb68159e1b","duration":53.0},"female":{"file":"y-102-female-v2.m4a","bytes":392284,"sha256":"9eb2b42d80f8bde0284ac9735c82fa96700d0cd79d6ead21bf7df05603f0afa7","duration":53.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.126,"text":"E YO loni pe l'ohun kan","marked":"Ẹ Yọ̀ lónì pé l'ohun kan"},{"start":2.576,"end":3.915,"text":"E korin igbega soke","marked":"Ẹ kọrin ìgbéga sókè"},{"start":4.365,"end":6.105,"text":"E yo, eyin Oluwa wa","marked":"Ẹ yọ̀, ẹ̀yin Olúwa wa"},{"start":6.555,"end":7.804,"text":"T'apa Re mu igbala wa","marked":"T'apá Rẹ mú ìgbàlà wá"},{"start":8.254,"end":9.477,"text":"Ise Ife npokiki","marked":"Iṣẹ́ Ìfẹ́ ńpòkìkí"},{"start":9.927,"end":11.273,"text":"Titobi oruko Re","marked":"Títóbi orúkọ Rẹ"},{"start":11.723,"end":12.818,"text":"Olorun kan laelae","marked":"Ọlọ́run kan láéláé"},{"start":13.268,"end":14.312,"text":"To ti f'anu Re han","marked":"Tó ti f'àánú Rẹ̀ hàn"},{"start":14.762,"end":16.051,"text":"K'eniyan mimo Re juba Re.","marked":"K'ènìyàn mímọ́ Rẹ júbà Rẹ."}],"end":16.051},{"key":"2","start":17.001,"lines":[{"start":17.001,"end":19.431,"text":"Gba banuje de, a kepe","marked":"Gba banújẹ́ dé, a képe"},{"start":19.881,"end":21.432,"text":"O si gbo gbogbo 'aroye wa","marked":"Ó sì gbọ́ gbogbo àròyé wa"},{"start":21.882,"end":23.414,"text":"Gbekele boti wu kori","marked":"Gbẹ́kẹ̀lé bọtí wù kórí"},{"start":23.864,"end":25.381,"text":"Agbeniro ni ife Re","marked":"Agbẹniro ni ìfẹ́ Rẹ"},{"start":25.831,"end":26.862,"text":"Orin iyin 'segun","marked":"Orin ìyìn ṣẹ́gun"},{"start":27.312,"end":28.641,"text":"Lokan wa y'o ko si","marked":"Lọ́kàn wa y'ó kò sí"},{"start":29.091,"end":30.396,"text":"Gbogb'ohun y'o ko pe","marked":"Gbogb'ohun y'ó kò pé"},{"start":30.846,"end":31.865,"text":"'E yin Olorun wa","marked":"ẹ yin Ọlọ́run wa"},{"start":32.315,"end":33.604,"text":"K'eniyan mimo re juba Re.","marked":"K'ènìyàn mímọ́ rẹ̀ júbà Rẹ̀."}],"end":33.604},{"key":"3","start":34.554,"lines":[{"start":34.554,"end":36.59,"text":"E yo, loni pe l'ohun kan","marked":"Ẹ yọ̀, lónì pé l'ohun kan"},{"start":37.04,"end":38.338,"text":"E korin igbega soke","marked":"Ẹ kọrin ìgbéga sókè"},{"start":38.788,"end":40.489,"text":"E yo, eyin Oluwa wa","marked":"Ẹ yọ̀, ẹ̀yin Olúwa wa"},{"start":40.939,"end":42.276,"text":"T'apa Re mu igbala wa","marked":"T'apá Rẹ mú ìgbàlà wá"},{"start":42.726,"end":43.967,"text":"Ise Ife npokiki","marked":"Iṣẹ́ Ìfẹ́ ńpòkìkí"},{"start":44.417,"end":45.451,"text":"Totibi oruko Re","marked":"Tótíbí orúkọ Rẹ"},{"start":45.901,"end":47.059,"text":"Olorun kan laelae","marked":"Ọlọ́run kan láéláé"},{"start":47.509,"end":48.616,"text":"To ti f'anu Re han","marked":"Tó ti f'àánú Rẹ̀ hàn"},{"start":49.066,"end":50.286,"text":"K'eniyan mimo Re juba re.","marked":"K'ènìyàn mímọ́ Rẹ júbà rẹ."},{"start":50.736,"end":51.356,"text":"Amin.","marked":"Àmín."}],"end":51.356}]}