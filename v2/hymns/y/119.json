{"v":2,"coll":"y","num":119,"id":"hymn_119","title":"GBOGBO aiye, gbe Jesu ga","duration":49.212,"voices":{"male":{"file":"y-119-male-v2.m4a","bytes":339225,"sha256":"81b90924c7f7cdc10dcc8d2edff05a56547708bcf6514ab9f78e9bbabd67a107","duration":49.3},"female":{"file":"y-119-female-v2.m4a","bytes":355806,"sha256":"61764e7a6e289f7c7eb60f0a7fbe9fbedf2a78528afddacde355b3483621b1de","duration":49.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.343,"text":"GBOGBO aiye, gbe Jesu ga,","marked":"Gbogbo ayé, gbé Jésù ga"},{"start":2.793,"end":4.512,"text":"Angeli, e wole fun","marked":"Áńgẹ́lì, ẹ wọlé fún"},{"start":4.962,"end":6.184,"text":"E mu ade Oba Re wa,","marked":"Ẹ mú adé Ọba Rẹ̀ wá"},{"start":6.634,"end":8.097,"text":"Se l'Oba awon Oba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":8.097},{"key":"2","start":9.047,"lines":[{"start":9.047,"end":10.737,"text":"E se l'Oba enyin Martyr","marked":"Ẹ ṣe l'Ọba ẹ̀yin Martyr"},{"start":11.187,"end":12.342,"text":"Ti npe ni pepe Re","marked":"Ti ńpè ní pẹpẹ Rẹ"},{"start":12.792,"end":14.357,"text":"Gbe gbongbon-igi Jesse ga","marked":"Gbé gbongbon-igi Jesse ga"},{"start":14.807,"end":16.322,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."}],"end":16.322},{"key":"3","start":17.272,"lines":[{"start":17.272,"end":18.519,"text":"Enyin iru-omo Israel","marked":"Ẹ̀yin iru-omo Israẹl"},{"start":18.969,"end":19.986,"text":"Ti a ti rapada","marked":"Tí a ti ràpadà"},{"start":20.436,"end":21.893,"text":"E ki enit'o gba nyin la,","marked":"Ẹ kí ẹnit'ó gba yín là"},{"start":22.343,"end":23.796,"text":"Se l'Oba awon Oba.","marked":"Ṣe l'Ọba àwọn Ọba."}],"end":23.796},{"key":"4","start":24.746,"lines":[{"start":24.746,"end":25.908,"text":"Gbogbo enia elese","marked":"Gbogbo ènìà ẹlẹ́ṣẹ̀"},{"start":26.358,"end":27.389,"text":"Ranti 'banuje nyin","marked":"Rántí banújẹ́ yín"},{"start":27.839,"end":29.297,"text":"E te 'kogun nyin s'ese Re","marked":"Ẹ tẹ́ kógun yín s'ẹ̀ṣẹ̀ Rẹ̀"},{"start":29.747,"end":31.145,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."}],"end":31.145},{"key":"5","start":32.095,"lines":[{"start":32.095,"end":33.292,"text":"Ki gbogbo orile-ede","marked":"Kí gbogbo orile-ede"},{"start":33.742,"end":34.802,"text":"Ni gbogbo agbaiye","marked":"Ní gbogbo àgbàìyè"},{"start":35.252,"end":37.042,"text":"Ki nwon ki, “Kabiyesile”","marked":"Kí wọ́n kí, Kábíyèsílẹ̀"},{"start":37.492,"end":38.831,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."}],"end":38.831},{"key":"6","start":39.781,"lines":[{"start":39.781,"end":41.191,"text":"A ba le pel'awon t'orun","marked":"A bá lè pẹ̀l'àwọn t'ọ̀run"},{"start":41.641,"end":42.725,"text":"Lati ma juba Re","marked":"Láti má júbà Rẹ"},{"start":43.175,"end":44.801,"text":"K'a ba le jo jumo Korin","marked":"K'á bá lè jọ jùmọ̀ Kọrin"},{"start":45.251,"end":46.614,"text":"Se l'Oba awon oba.","marked":"Ṣe l'Ọba àwọn ọba."},{"start":47.064,"end":47.662,"text":"Amin.","marked":"Àmín."}],"end":47.662}]}