{"v":2,"coll":"y","num":92,"id":"hymn_92","title":"OKAN mi yin Oba orun","duration":67.941,"voices":{"male":{"file":"y-92-male-v2.m4a","bytes":471602,"sha256":"cd0322d95491b685bfa408484f49cedb9be765cc0c59f7e382ba5320fa4b7e3c","duration":68.0},"female":{"file":"y-92-female-v2.m4a","bytes":486166,"sha256":"5e240663988ff9be0ad8420120b3eb703334e048f8fc1202252d85f155e09a00","duration":68.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.483,"text":"OKAN mi yin Oba orun","marked":"Ọkàn mi yin Ọba ọ̀run"},{"start":1.933,"end":3.214,"text":"Mu ore wa sodo Re,","marked":"Mú ọrẹ wá sọ́dọ̀ Rẹ"},{"start":3.664,"end":6.001,"text":"'Wo ta wosan, ta dariji","marked":"wò ta wòsàn, ta dáríjì"},{"start":6.451,"end":7.541,"text":"Tal'a ba ha yin bi Re?","marked":"Tál'á bá ha yín bí Rẹ̀?"}],"end":7.541},{"key":"CHORUS","start":8.491,"lines":[{"start":8.491,"end":9.723,"text":"Yin Oluwa, Yin Oluwa","marked":"Yín Olúwa, Yin Olúwa"},{"start":10.173,"end":11.576,"text":"Yin Oba Ainipekun","marked":"Yín Ọba Àìnípẹ̀kun"},{"start":12.026,"end":13.156,"text":"Yin Oluwa, Yin Oluwa","marked":"Yín Olúwa, Yin Olúwa"},{"start":13.606,"end":15.08,"text":"Yin Oba Ainipekun","marked":"Yín Ọba Àìnípẹ̀kun"}],"end":15.08},{"key":"2","start":16.03,"lines":[{"start":16.03,"end":17.621,"text":"Yin fun Oko 'gbala kehin","marked":"Yín fún Oko gbàlà kẹ́hìn"},{"start":18.071,"end":19.551,"text":"To sokale f'araiye","marked":"Tó sọ̀kalẹ̀ f'aráìyè"},{"start":20.001,"end":21.388,"text":"O si yan Bab'Aladura","marked":"Ó sì yan Bab'aládúrà"},{"start":21.838,"end":23.356,"text":"Lati je Alakoso.","marked":"Láti jẹ́ Alákòso."}],"end":23.356},{"key":"3","start":24.306,"lines":[{"start":24.306,"end":26.289,"text":"Yin fun anu to ti fihan","marked":"Yín fún àánú tó ti fihàn"},{"start":26.739,"end":28.141,"text":"Lori Egbe Serafu;","marked":"Lórí Ẹgbẹ́ Séráfù"},{"start":28.591,"end":30.229,"text":"To pa wa mo titi d'oni","marked":"Tó pa wá mọ́ títí d'oni"},{"start":30.679,"end":32.356,"text":"To si fun wa n'isegun.","marked":"Tó sì fún wa n'ìṣẹ́gun."}],"end":32.356},{"key":"4","start":33.306,"lines":[{"start":33.306,"end":34.941,"text":"Yin fun abo ti o daju","marked":"Yín fún abo tí ó dájú"},{"start":35.391,"end":36.842,"text":"To nfun wa lojurere,","marked":"Tó ńfún wa lójúrere"},{"start":37.292,"end":38.63,"text":"Ninu wahala on 'danwo","marked":"Nínú wàhálà ọn dánwò"},{"start":39.08,"end":40.335,"text":"Anu Re wa bakanna.","marked":"Àánú Rẹ̀ wá bákanná."}],"end":40.335},{"key":"5","start":41.285,"lines":[{"start":41.285,"end":42.804,"text":"Yin fun abo ti o daju","marked":"Yín fún abo tí ó dájú"},{"start":43.254,"end":44.483,"text":"Ta nri l'Egbe Serafu","marked":"Ta ńrí l'Ẹgbẹ́ Séráfù"},{"start":44.933,"end":46.893,"text":"Aje, Oso, on Sonponnna","marked":"Ajé, Ọ̀ṣọ́, òn Ṣọ̀ǹpọ́nnná"},{"start":47.343,"end":48.625,"text":"Won ko ri wa gbese mo.","marked":"Wọn kò rí wa gbèsè mọ́."}],"end":48.625},{"key":"6","start":49.575,"lines":[{"start":49.575,"end":50.989,"text":"Bi baba ni o ntoju wa","marked":"Bí Baba ni ó ńtọ́jú wa"},{"start":51.439,"end":53.017,"text":"O si mo ailera wa,","marked":"Ó sì mọ àìlera wa"},{"start":53.467,"end":54.876,"text":"Jeje lo ngbe wa I'apa Re,","marked":"Jẹ́jẹ́ ló ńgbé wà l'apá Rẹ̀"},{"start":55.326,"end":56.897,"text":"O nf' onje iye bo wa.","marked":"Ó ńf oǹjẹ ìyè bọ̀ wá."}],"end":56.897},{"key":"7","start":57.847,"lines":[{"start":57.847,"end":59.919,"text":"Ogun orun, e ba wa yin","marked":"Ogún ọ̀run, ẹ bá wá yín"},{"start":60.369,"end":62.642,"text":"Baba, Omo, on Emi","marked":"Baba, Ọmọ, ọn Ẹ̀mí"},{"start":63.092,"end":64.579,"text":"Orun, Osupa, e wole","marked":"Ọ̀run, Òṣùpá, ẹ wọlé"},{"start":65.029,"end":66.392,"text":"Ati gbogbo agbaiye.","marked":"Àti gbogbo àgbàìyè."}],"end":66.392}]}