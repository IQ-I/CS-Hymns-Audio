{"v":2,"coll":"y","num":103,"id":"hymn_103","title":"OLUWA l'Olus'agutan mi","duration":62.835,"voices":{"male":{"file":"y-103-male-v2.m4a","bytes":438536,"sha256":"f955980775279ab65e20aecb63558e38a7efcd073feb1009ccf25226b201feee","duration":62.9},"female":{"file":"y-103-female-v2.m4a","bytes":454730,"sha256":"77d881cfd42113d005e323ad9c022f38fa9cb645c52c05112e8bd6b4c8aac663","duration":62.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.667,"text":"OLUWA l'Olus'agutan mi,","marked":"Olúwa l'Olùṣ'àgùtàn mi"},{"start":2.117,"end":3.286,"text":"Emi k'o salani","marked":"Èmi k'ó ṣàlàní"},{"start":3.736,"end":5.411,"text":"O mu mi dubule 'nu papa oko,","marked":"Ó mú mi dùbúlẹ̀ nù pápá oko"},{"start":5.861,"end":7.018,"text":"Tutu minimini.","marked":"Tútù mínimíni."},{"start":7.468,"end":9.547,"text":"Egbe:  Awa dupe, at'ope da,","marked":"Àwa dúpẹ́, àt'ọpẹ́ dá"},{"start":9.997,"end":11.253,"text":"Fun idasi Re fun wa","marked":"Fún ìdásí Rẹ fún wa"},{"start":11.703,"end":13.035,"text":"Larin Egbe Serafu.","marked":"Lárin Ẹgbẹ́ Séráfù."}],"end":13.035},{"key":"2","start":13.985,"lines":[{"start":13.985,"end":15.456,"text":"O mu mi lo si iha omi,","marked":"Ó mú mi lọ sí ìhà omi"},{"start":15.906,"end":17.109,"text":"Idake roro si de,","marked":"Ìdákẹ́ rọ́rọ́ sì dé"},{"start":17.559,"end":18.792,"text":"O si tu okan mi lara,","marked":"Ó sì tú ọkàn mi lára"},{"start":19.242,"end":20.515,"text":"Ni ipa oruko Re.","marked":"Ní ipa orúkọ Rẹ."},{"start":20.965,"end":21.907,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":21.907},{"key":"3","start":22.857,"lines":[{"start":22.857,"end":24.551,"text":"Nitoto bi mo tile nrin","marked":"Nítòtọ́ bí mo tilẹ̀ ńrìn"},{"start":25.001,"end":26.256,"text":"Larin afonifoji","marked":"Lárin àfonífojì"},{"start":26.706,"end":28.186,"text":"Emi ki yio beru ibi kan","marked":"Èmi kí yóò bẹ̀rù ibi kan"},{"start":28.636,"end":29.977,"text":"Nitori o wa pelu mi.","marked":"Nítorí ó wà pẹ̀lú mi."},{"start":30.427,"end":31.335,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":31.335},{"key":"4","start":32.285,"lines":[{"start":32.285,"end":33.992,"text":"Ogo Re ati opa Re","marked":"Ògo Rẹ àti ọ̀pá Rẹ"},{"start":34.442,"end":35.839,"text":"Nwon si ntu mi ninu","marked":"Wọ́n sì ńtù mí nínú"},{"start":36.289,"end":38.055,"text":"lwo te tabili onje sile","marked":"lwó tẹ́ tábìlì oǹjẹ sílẹ̀"},{"start":38.505,"end":39.641,"text":"Ni iwaju mi.","marked":"Ní iwájú mi."},{"start":40.091,"end":41.099,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":41.099},{"key":"5","start":42.049,"lines":[{"start":42.049,"end":43.68,"text":"Nitoto ire ati anu","marked":"Nítòtọ́ ìre àti àánú"},{"start":44.13,"end":45.261,"text":"Ni yio ma to mi lehin","marked":"Ni yóò má tọ̀ mi lẹ́hìn"},{"start":45.711,"end":46.957,"text":"Emi o gbekele Oluwa","marked":"Èmi ó gbẹ́kẹ̀lé Olúwa"},{"start":47.407,"end":48.767,"text":"Ni gbogbo ojo aiye mi.","marked":"Ní gbogbo ọjọ́ ayé mi."},{"start":49.217,"end":50.146,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"}],"end":50.146},{"key":"6","start":51.096,"lines":[{"start":51.096,"end":52.715,"text":"K'a f'ogo fun Baba wa loke","marked":"K'á f'ògo fún Baba wa lókè"},{"start":53.165,"end":54.592,"text":"K'a f'ogo fun Omo Re","marked":"K'á f'ògo fún Ọmọ Rẹ"},{"start":55.042,"end":56.728,"text":"K'a f'ogo fun O Emi Mimo","marked":"K'á f'ògo fún Ọ Ẹ̀mí Mímọ́"},{"start":57.178,"end":58.789,"text":"Metalokan l'ope ye.","marked":"Mẹ́talọ́kan l'ọ̀pẹ yẹ."},{"start":59.239,"end":60.192,"text":"Egbe:  Awa dupe...","marked":"Àwa dúpẹ́"},{"start":60.642,"end":61.286,"text":"Amin.","marked":"Àmín."}],"end":61.286}]}