{"v":2,"coll":"y","num":8,"id":"hymn_8","title":"ORUN Ododo, jowo la","duration":19.581,"voices":{"male":{"file":"y-8-male-v2.m4a","bytes":134588,"sha256":"1e37d15b312bfa188252917f4df04324417c9014f5895756679e2e23d30469c1","duration":19.6},"female":{"file":"y-8-female-v2.m4a","bytes":137630,"sha256":"53bd188633b4c17e2376e939e4113ccd81c158122c083a97388844d67e1662d4","duration":19.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.889,"text":"ORUN Ododo, jowo la,","marked":"Ọ̀run Òdodo, jọ̀wọ́ là"},{"start":2.339,"end":3.849,"text":"Ma ran jeje lori Sioni","marked":"Má rán jẹ́jẹ́ lórí Síónì"},{"start":4.299,"end":5.516,"text":"Tu okunkun oju wa ka","marked":"Tú òkùnkùn ojú wa ká"},{"start":5.966,"end":7.96,"text":"Je k'okan wa ko ji si ye.","marked":"Jẹ́ k'ọkàn wa kò jí sì yẹ."}],"end":7.96},{"key":"2","start":8.91,"lines":[{"start":8.91,"end":10.552,"text":"Jek'ore ofe ba le wa,","marked":"Jẹ́k'ọrẹ ọ̀fẹ́ bá lè wá"},{"start":11.002,"end":12.964,"text":"B'iri orun, b'opo ojo;","marked":"B'ìrì ọ̀run, b'ọ̀pọ̀ ọjọ́"},{"start":13.414,"end":14.835,"text":"K'a le mo p'On l'Ore wa san,","marked":"K'á lè mọ̀ p'Ọ́n l'Ọ̀rẹ́ wa sàn"},{"start":15.285,"end":17.022,"text":"Ka le pe 'gbala ni tiwa.","marked":"Ká lè pe gbàlà ní tiwa."},{"start":17.472,"end":18.032,"text":"Amin.","marked":"Àmín."}],"end":18.032}]}