{"v":2,"coll":"y","num":97,"id":"hymn_97","title":"OLORUN Eleda t'o d'egbe Seraf,","duration":72.97,"voices":{"male":{"file":"y-97-male-v2.m4a","bytes":528976,"sha256":"5be84c67e5b34cd77829e0d90b57cd82b741a185c402ce9f5033ea362cb25ba0","duration":73.0},"female":{"file":"y-97-female-v2.m4a","bytes":548817,"sha256":"7826e4829085f802632a982105ef7a5b11b42b1a55b477959b1a26747fbc8a7c","duration":73.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.799,"text":"OLORUN Eleda t'o d'egbe Seraf,","marked":"Ọlọ́run Ẹlẹ́dàá t'ó d'ẹgbẹ́ Seraf"},{"start":3.249,"end":5.37,"text":"Ati Kerubu s'orile ede aiye","marked":"Àti Kérúbù s'orílẹ̀ èdè ayé"},{"start":5.82,"end":7.689,"text":"Lat'owo Jesu Olugbala owon","marked":"Lát'ọwọ́ Jésù Olùgbàlà ọ̀wọ́n"},{"start":8.139,"end":9.704,"text":"Awa nyin oruko Re logo.","marked":"Àwa yín orúkọ Rẹ̀ lógo."}],"end":9.704},{"key":"CHORUS","start":10.654,"lines":[{"start":10.654,"end":13.158,"text":"A! e ku ayo, eku ayo","marked":"A! ẹ kú ayọ̀, eku ayọ̀"},{"start":13.608,"end":14.589,"text":"egbe Serafu","marked":"ẹgbẹ́ Séráfù"},{"start":15.039,"end":17.64,"text":"A! e ku ayo, e ku ayo","marked":"A! ẹ kú ayọ̀, ẹ kú ayọ̀"},{"start":18.09,"end":19.085,"text":"egbe Kerubu.","marked":"ẹgbẹ́ Kérúbù."}],"end":19.085},{"key":"2","start":20.035,"lines":[{"start":20.035,"end":21.557,"text":"Nibo l'awon ayanfe Olorun wa?","marked":"Níbo l'àwọn àyànfẹ́ Ọlọ́run wa?"},{"start":22.007,"end":24.003,"text":"E wa gbo ohun Oluso-agutan yi","marked":"Ẹ wá gbọ́ ohùn Oluso-agutan yí"},{"start":24.453,"end":26.723,"text":"E ronu piwada, e wa w'oko na;","marked":"Ẹ ronú píwàdà, ẹ wá w'oko ná"},{"start":27.173,"end":28.932,"text":"Igbala na ku si atel'owo.","marked":"Ìgbàlà ná kú sí àtẹ́l'ọwọ́."}],"end":28.932},{"key":"3","start":29.882,"lines":[{"start":29.882,"end":32.607,"text":"Egbe Kerubu, dupe lowo Olorun","marked":"Ẹgbẹ́ Kérúbù, dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":33.057,"end":35.202,"text":"Tesiwaju ninu ogun emi jija","marked":"Tẹ̀síwájú nínú ogun èmi jíjà"},{"start":35.652,"end":37.595,"text":"E fere gbo 'hun Oluwa wa Jesu,","marked":"Ẹ fẹ́rẹ̀ gbọ́ hun Olúwa wá Jésù"},{"start":38.045,"end":39.922,"text":"Wipe, o seun, omo rere.","marked":"Wípé, ó ṣeun, ọmọ rere."}],"end":39.922},{"key":"4","start":40.872,"lines":[{"start":40.872,"end":43.498,"text":"Enyin ti nkoja lo ya sodo Jesu","marked":"Ẹ̀yin tí ńkọjá lọ yà sọ́dọ̀ Jésù"},{"start":43.948,"end":46.025,"text":"Lati gb'ore-ofe n'nu egbe yi,","marked":"Láti gb'ore-ofe n'nú ẹgbẹ́ yí"},{"start":46.475,"end":48.729,"text":"Mase kegan oko igbala 'kehin","marked":"Máṣe kẹ́gàn oko ìgbàlà kẹ́hìn"},{"start":49.179,"end":50.561,"text":"T'Olorun Metalokan fun wa.","marked":"T'Ọlọ́run Mẹ́talọ́kan fún wa."}],"end":50.561},{"key":"5","start":51.511,"lines":[{"start":51.511,"end":53.608,"text":"Jesu Oluwa mbowa joba laiye","marked":"Jésù Olúwa mbọwà jọba láìyẹ"},{"start":54.058,"end":56.545,"text":"Larin Egbe Kerubu ati Serafu","marked":"Lárin Ẹgbẹ́ Kérúbù àti Séráfù"},{"start":56.995,"end":58.793,"text":"Egberun Odun ni 'joba re ninu","marked":"Ẹgbẹ̀rún Ọdún ni jọba rẹ̀ nínú"},{"start":59.243,"end":61.037,"text":"Egbe Mimo at'oke wa yi.","marked":"Ẹgbẹ́ Mímọ́ àt'òkè wá yí."}],"end":61.037},{"key":"6","start":61.987,"lines":[{"start":61.987,"end":64.288,"text":"Jesu Kristi Oluwa Oba Ogo","marked":"Jésù Kristi Olúwa Ọba Ògo"},{"start":64.738,"end":66.437,"text":"L'opa iye ainipekun wa lowo re","marked":"L'ọ̀pá ìyè àìnípẹ̀kun wà lọ́wọ́ rẹ̀"},{"start":66.887,"end":68.966,"text":"Yio ko gbogbo awon t'o gbagbo Io,","marked":"Yóò kó gbogbo àwọn t'ó gbàgbọ́ lọ"},{"start":69.416,"end":71.421,"text":"Siwaju ite baba l'oke.","marked":"Síwájú ìtẹ́ Baba l'òkè."}],"end":71.421}]}