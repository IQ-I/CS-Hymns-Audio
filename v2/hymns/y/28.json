{"v":2,"coll":"y","num":28,"id":"hymn_28","title":"OLORUN ojo 'simi","duration":47.081,"voices":{"male":{"file":"y-28-male-v2.m4a","bytes":319573,"sha256":"a7be0e27a15b1930deafca9a618ed3219c24baa14017b5617589918f5f6a36b2","duration":47.1},"female":{"file":"y-28-female-v2.m4a","bytes":334213,"sha256":"2d751bc7e7c0144ac0bcc6fb83810fe077acaa1eb3211f519f67fc4361aaeb59","duration":47.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.346,"text":"OLORUN ojo 'simi","marked":"Ọlọ́run ọjọ́ ṣímí"},{"start":1.796,"end":3.138,"text":"Sokale l'agbara Re","marked":"Sọ̀kalẹ̀ l'agbára Rẹ̀"},{"start":3.588,"end":5.051,"text":"Pase 'bukun t'oke wa","marked":"Pàṣẹ bùkún t'òkè wá"},{"start":5.501,"end":6.946,"text":"Je ka ri O larin wa.","marked":"Jẹ́ ká rí Ó lárin wa."}],"end":6.946},{"key":"2","start":7.896,"lines":[{"start":7.896,"end":9.303,"text":"Je ka O ka ri O","marked":"Jẹ́ ká O ká rí Ọ"},{"start":9.753,"end":10.874,"text":"Ni Olorun Kerubu","marked":"Ní Ọlọ́run Kérúbù"},{"start":11.324,"end":12.566,"text":"Ko ran ife rere Re","marked":"Kò rán ìfẹ́ rere Rẹ̀"},{"start":13.016,"end":14.352,"text":"Sarin Egbe Serafu.","marked":"Sarin Ẹgbẹ́ Séráfù."}],"end":14.352},{"key":"3","start":15.302,"lines":[{"start":15.302,"end":16.546,"text":"Mu ki gbogbo agbaiye","marked":"Mú kí gbogbo àgbàìyè"},{"start":16.996,"end":18.07,"text":"Teti soro mimo Re,","marked":"Tẹ́tí sọ̀rọ̀ mímọ́ Rẹ"},{"start":18.52,"end":19.615,"text":"M'alagidi teriba","marked":"M'alágídí tẹríba"},{"start":20.065,"end":21.869,"text":"S'okan t'o ku d'alaye.","marked":"S'ọkàn t'ó kù d'àlàyé."}],"end":21.869},{"key":"4","start":22.819,"lines":[{"start":22.819,"end":23.916,"text":"Eni nwa O ko ri O,","marked":"Ẹni ńwá Ọ kò rí Ọ"},{"start":24.366,"end":25.654,"text":"Eni nsubu gbe dide;","marked":"Ẹni ńṣubú gbé dìde"},{"start":26.104,"end":28.198,"text":"W'alaisan, at'afoju,","marked":"W'aláìsàn, àt'afọ́jú"},{"start":28.648,"end":30.009,"text":"Ki gbogbo wa jo yin O.","marked":"Kí gbogbo wa jọ yín Ọ."}],"end":30.009},{"key":"5","start":30.959,"lines":[{"start":30.959,"end":32.009,"text":"Bukun oro mimo Re,","marked":"Bùkún ọ̀rọ̀ mímọ́ Rẹ"},{"start":32.459,"end":33.877,"text":"To ran wa lakoko yi,","marked":"Tó ràn wá lákokò yí"},{"start":34.327,"end":35.719,"text":"Je k'aiye fi se 'wa hu","marked":"Jẹ́ k'ayé fi ṣe wá hù"},{"start":36.169,"end":37.45,"text":"L'agbara Metalokan.","marked":"L'agbára Mẹ́talọ́kan."}],"end":37.45},{"key":"6","start":38.4,"lines":[{"start":38.4,"end":39.552,"text":"Ogo ni fun Baba wa,","marked":"Ògo ni fún Baba wa"},{"start":40.002,"end":41.157,"text":"Ogo ni fun Omo Re,","marked":"Ògo ni fún Ọmọ Rẹ"},{"start":41.607,"end":42.841,"text":"Ogo ni f'Emi Mimo","marked":"Ògo ni f'Ẹ̀mí Mímọ́"},{"start":43.291,"end":44.45,"text":"Ogo fun Metalokan.","marked":"Ògo fún Mẹ́talọ́kan."},{"start":44.9,"end":45.532,"text":"Amin.","marked":"Àmín."}],"end":45.532}]}