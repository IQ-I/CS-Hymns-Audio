{"v":2,"coll":"y","num":3,"id":"hymn_3","title":"Ninu gbogbo ewu oru","duration":33.692,"voices":{"male":{"file":"y-3-male-v2.m4a","bytes":229307,"sha256":"a6fc88b2027196cc170c82ed36c2ea68a3448bdd3d2fb6c92b08d83b6a9dd16d","duration":33.7},"female":{"file":"y-3-female-v2.m4a","bytes":232470,"sha256":"a399e2c7929c1438133ea4aed13a52348098707b7c05abfa5979d869ea85031f","duration":33.7}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.602,"text":"Ninu gbogbo ewu oru,","marked":"Nínú gbogbo ẹ̀wù òru"},{"start":2.052,"end":3.213,"text":"Oluwa l'o so mi","marked":"Olúwa l'ó sọ mí"},{"start":3.663,"end":5.183,"text":"Awa si tun ri' mole yi","marked":"Àwa sì tún rí mọ́lẹ̀ yí"},{"start":5.633,"end":6.888,"text":"A tun te ekun ba.","marked":"A tún tẹ ẹkún bá."}],"end":6.888},{"key":"2","start":7.838,"lines":[{"start":7.838,"end":9.739,"text":"Oluwa, pa wa mo l'oni,","marked":"Olúwa, pa wá mọ́ l'óní"},{"start":10.189,"end":11.377,"text":"Fi apa Re so wa;","marked":"Fi apá Rẹ sọ wá"},{"start":11.827,"end":13.046,"text":"Kiki awon ti 'Wo pamo","marked":"Kìkì àwọn tí wò pamọ́"},{"start":13.496,"end":14.779,"text":"L'o nyo ninu ewu.","marked":"L'ó ńyọ̀ nínú ewu."}],"end":14.779},{"key":"3","start":15.729,"lines":[{"start":15.729,"end":17.721,"text":"K'oro wa, ati iwa wa","marked":"K'ọ̀rọ̀ wa, àti ìwà wa"},{"start":18.171,"end":19.645,"text":"Wipe, Tire l'awa,","marked":"Wípé, Tire l'àwa"},{"start":20.095,"end":21.557,"text":"Tobe t'imole otito","marked":"Tobẹ t'ìmọ́lẹ̀ òtítọ́"},{"start":22.007,"end":23.413,"text":"Le tan l'oju aiye.","marked":"Lè tán l'ojú ayé."}],"end":23.413},{"key":"4","start":24.363,"lines":[{"start":24.363,"end":26.188,"text":"Ma je k'a pada lodo Re,","marked":"Má jẹ́ k'á padà lọ́dọ̀ Rẹ"},{"start":26.638,"end":27.479,"text":"Olugbala owon","marked":"Olùgbàlà ọ̀wọ́n"},{"start":27.929,"end":29.456,"text":"Titi a o f'oju wa ri,","marked":"Títí a ó f'ojú wa rí"},{"start":29.906,"end":31.176,"text":"Oju Re li opin.","marked":"Ojú Rẹ li òpin."},{"start":31.626,"end":32.142,"text":"Amin.","marked":"Àmín."}],"end":32.142}]}