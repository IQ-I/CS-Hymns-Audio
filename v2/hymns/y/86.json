{"v":2,"coll":"y","num":86,"id":"hymn_86","title":"OLUWA orun on aiye","duration":71.374,"voices":{"male":{"file":"y-86-male-v2.m4a","bytes":487280,"sha256":"bd2b7b2f23f68f0efa31b82964ca5c0e28ec354dfbf6751f879c273885b379b3","duration":71.4},"female":{"file":"y-86-female-v2.m4a","bytes":499384,"sha256":"09b86112c411156e336d71a7f00c82a0a4de32da819e4c17e4991741a7d3d9c5","duration":71.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.362,"text":"OLUWA orun on aiye","marked":"Olúwa ọ̀run ọn ayé"},{"start":1.812,"end":3.457,"text":"Wo n'iyin at'ope ye fun","marked":"Wò n'ìyìn àt'ọpẹ́ yẹ fún"},{"start":3.907,"end":5.704,"text":"Bawo l'a ba ti fe O to?","marked":"Báwo l'a bá ti fẹ́ Ó tó?"},{"start":6.154,"end":7.071,"text":"Onibu‐Ore.","marked":"Onibu-ore."}],"end":7.071},{"key":"2","start":8.021,"lines":[{"start":8.021,"end":9.719,"text":"Orun ti nran at'afefe","marked":"Ọ̀run tí ńran àt'afẹ́fẹ́"},{"start":10.169,"end":11.758,"text":"Gbogbo eweko nso 'fe Re;","marked":"Gbogbo ewéko ńṣọ́ fẹ́ Rẹ"},{"start":12.208,"end":13.51,"text":"'Wo l'O nmu irugbin dara,","marked":"wò l'Ó ńmú irúgbìn dára"},{"start":13.96,"end":14.884,"text":"Onibu-Ore.","marked":"Onibu-ore."}],"end":14.884},{"key":"3","start":15.834,"lines":[{"start":15.834,"end":17.182,"text":"Fun ara lile wa gbogbo","marked":"Fún ara líle wa gbogbo"},{"start":17.632,"end":19.096,"text":"Fun gbogbo ibukun aiye,","marked":"Fún gbogbo ìbùkún ayé"},{"start":19.546,"end":21.735,"text":"Awa yin O, a si dupe,","marked":"Àwa yìn Ọ́, a sì dúpẹ́"},{"start":22.185,"end":23.094,"text":"Onibu-Ore.","marked":"Onibu-ore."}],"end":23.094},{"key":"4","start":24.044,"lines":[{"start":24.044,"end":25.342,"text":"O ko du wa li Omo Re,","marked":"O kò dù wá lí Ọmọ Rẹ̀"},{"start":25.792,"end":27.232,"text":"O fi fun aiye ese wa,","marked":"Ó fi fún ayé ẹ̀ṣẹ̀ wa"},{"start":27.682,"end":29.127,"text":"O si f'ebun gbogbo pelu;","marked":"Ó sì f'ẹ̀bùn gbogbo pẹ̀lú"},{"start":29.577,"end":30.409,"text":"Onibu‐Ore.","marked":"Onibu-ore."}],"end":30.409},{"key":"5","start":31.359,"lines":[{"start":31.359,"end":32.628,"text":"O fun wa l'Emi Mimo Re,","marked":"Ó fún wa l'Ẹ̀mí Mímọ́ Rẹ̀"},{"start":33.078,"end":34.759,"text":"Emi iye at'agbara","marked":"Ẹ̀mí ìyè àt'agbára"},{"start":35.209,"end":36.458,"text":"O rojo ekun 'bukun Re,","marked":"Ó rọ̀jò ẹkún bùkún Rẹ̀"},{"start":36.908,"end":37.879,"text":"Le wa lori.","marked":"Lè wà lórí."}],"end":37.879},{"key":"6","start":38.829,"lines":[{"start":38.829,"end":40.288,"text":"Fun idariji ese wa,","marked":"Fún ìdáríjì ẹ̀ṣẹ̀ wa"},{"start":40.738,"end":42.052,"text":"Ati fun ireti orun,","marked":"Àti fún ìrètí ọ̀run"},{"start":42.502,"end":43.879,"text":"Kil'ohun t'a ba fi fun O?","marked":"Kíl'ohun t'a bá fi fún Ọ?"},{"start":44.329,"end":45.245,"text":"Onibu-Ore.","marked":"Onibu-ore."}],"end":45.245},{"key":"7","start":46.195,"lines":[{"start":46.195,"end":47.929,"text":"Owo, ti a nna, ofo ni,","marked":"Ọwọ́, tí a ńnà, ọ̀fọ̀ ni"},{"start":48.379,"end":49.829,"text":"Sugbon eyit'a fi fun O,","marked":"Ṣùgbọ́n èyít'á fi fún Ọ"},{"start":50.279,"end":51.612,"text":"O je isura tit' aiye","marked":"Ó jẹ́ ìṣúra tít ayé"},{"start":52.062,"end":52.949,"text":"Onibu-Ore.","marked":"Onibu-ore."}],"end":52.949},{"key":"8","start":53.899,"lines":[{"start":53.899,"end":55.485,"text":"Ohun t'a bun O, Oluwa,","marked":"Ohun t'a bùn Ọ, Olúwa"},{"start":55.935,"end":57.421,"text":"'Wo o san le a pade fun wa","marked":"wò ó sàn lé a pàdé fún wa"},{"start":57.871,"end":59.654,"text":"Layo l'a o ta O lore","marked":"Láyọ̀ l'a ò ta Ọ́ lọ́rẹ̀"},{"start":60.104,"end":61.07,"text":"Onibu-Ore.","marked":"Onibu-ore."}],"end":61.07},{"key":"9","start":62.02,"lines":[{"start":62.02,"end":63.721,"text":"Ni odo Re l'a ti san wa,","marked":"Ní ọ̀dọ̀ Rẹ l'á ti sàn wá"},{"start":64.171,"end":65.244,"text":"Olorun Olodumare;","marked":"Ọlọ́run Olódùmarè"},{"start":65.694,"end":67.399,"text":"Jek' a le ba O gbe titi","marked":"Jẹ́k a lè bá Ọ gbé títí"},{"start":67.849,"end":68.789,"text":"Onibu-Ore.","marked":"Onibu-ore."},{"start":69.239,"end":69.826,"text":"Amin.","marked":"Àmín."}],"end":69.826}]}