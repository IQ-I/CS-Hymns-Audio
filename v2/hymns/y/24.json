{"v":2,"coll":"y","num":24,"id":"hymn_24","title":"OLUS' AGUTAN mi","duration":36.225,"voices":{"male":{"file":"y-24-male-v2.m4a","bytes":242453,"sha256":"ec34d534a2956903daa2b1f89cc3f94b5a71484b6506eaeafaead50d1c88b3f2","duration":36.3},"female":{"file":"y-24-female-v2.m4a","bytes":251642,"sha256":"5d4cdf67bd1742653b44746bbb3aa23aa7cc9f92a5bed4c31a7935ad35e65f6a","duration":36.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.377,"text":"OLUS' AGUTAN mi,","marked":"Olùṣ Àgùtàn mi"},{"start":1.827,"end":2.843,"text":"Ma bo mi titi,","marked":"Má bọ̀ mí títí"},{"start":3.293,"end":4.261,"text":"Olus'agutan mi,","marked":"Olùṣ'àgùtàn mi"},{"start":4.711,"end":5.918,"text":"Ma to ese mi.","marked":"Má tọ ẹsẹ̀ mi."}],"end":5.918},{"key":"2","start":6.868,"lines":[{"start":6.868,"end":8.349,"text":"Di mi mu, si to mi,","marked":"Dì mí mú, sì tọ̀ mi"},{"start":8.799,"end":9.802,"text":"Ni ona hiha","marked":"Ní ọ̀nà híhá"},{"start":10.252,"end":11.367,"text":"B'O ba wa lodo mi,","marked":"B'ó bá wà lọ́dọ̀ mi"},{"start":11.817,"end":12.887,"text":"Emi ko sina.","marked":"Èmi kò ṣìnà."}],"end":12.887},{"key":"3","start":13.837,"lines":[{"start":13.837,"end":14.855,"text":"Sin mi s'ona orun","marked":"Sìn mí s'ọ̀nà ọ̀run"},{"start":15.305,"end":16.165,"text":"Ni ojojumo","marked":"Ní ojojúmọ́"},{"start":16.615,"end":17.92,"text":"Ma busi 'gbagbo mi","marked":"Má bùsi gbàgbọ́ mi"},{"start":18.37,"end":19.696,"text":"Si mu mi fe O.","marked":"Sì mú mi fẹ́ Ọ."}],"end":19.696},{"key":"4","start":20.646,"lines":[{"start":20.646,"end":22.226,"text":"K'ayo at'alafia","marked":"K'ayọ̀ àt'àlàfíà"},{"start":22.676,"end":23.667,"text":"Ti odo Re wa","marked":"Ti ọ̀dọ̀ Rẹ wá"},{"start":24.117,"end":25.133,"text":"K'iye ainipekun","marked":"K'íyè àìnípẹ̀kun"},{"start":25.583,"end":27.026,"text":"Le je ayo mi.","marked":"Lè jẹ́ ayọ̀ mi."}],"end":27.026},{"key":"5","start":27.976,"lines":[{"start":27.976,"end":29.133,"text":"Ma pese okan mi,","marked":"Má pèsè ọkàn mi"},{"start":29.583,"end":30.376,"text":"Ni ojojumo","marked":"Ní ojojúmọ́"},{"start":30.826,"end":32.054,"text":"Si je k'Angeli Re,","marked":"Sì jẹ́ k'Áńgẹ́lì Rẹ"},{"start":32.504,"end":33.597,"text":"Sin mi lo ile.","marked":"Sìn mí lọ ilẹ̀."},{"start":34.047,"end":34.676,"text":"Amin.","marked":"Àmín."}],"end":34.676}]}