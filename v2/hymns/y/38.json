{"v":2,"coll":"y","num":38,"id":"hymn_38","title":"DlDUN n'ise na, Oba mi","duration":44.17,"voices":{"male":{"file":"y-38-male-v2.m4a","bytes":310368,"sha256":"d605dc2fa9505659d963dd5b3986eec4b5fd2defd28da3a2e50ca27fccf155ad","duration":44.2},"female":{"file":"y-38-female-v2.m4a","bytes":317609,"sha256":"ae297bc921a4d332de52e7e4fe09526701160d4eb4c6c674688f81574addc87c","duration":44.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.067,"text":"DlDUN n'ise na, Oba mi","marked":"Dldun n'iṣẹ́ ná, Ọba mi"},{"start":2.517,"end":3.773,"text":"Lati ma yin Oruko Re;","marked":"Láti má yin Orúkọ Rẹ"},{"start":4.223,"end":5.869,"text":"Lati se 'fe Re l'owuro","marked":"Láti ṣe fẹ́ Rẹ l'òwúrọ̀"},{"start":6.319,"end":7.969,"text":"Lati so oro Re l'ale.","marked":"Láti sọ ọ̀rọ̀ Rẹ̀ l'alẹ́."}],"end":7.969},{"key":"2","start":8.919,"lines":[{"start":8.919,"end":10.407,"text":"Didun l'ojo 'simi mimo","marked":"Dídùn l'ọjọ́ ṣímí mímọ́"},{"start":10.857,"end":12.18,"text":"Lala ko so fun mi loni","marked":"Lálà kò sọ fún mi lónì"},{"start":12.63,"end":13.741,"text":"Okan mi ma korin iyin","marked":"Ọkàn mi má kọrin ìyìn"},{"start":14.191,"end":15.592,"text":"Bi harpu Dafidi didun.","marked":"Bí harpu Dafidi dídùn."}],"end":15.592},{"key":"3","start":16.542,"lines":[{"start":16.542,"end":17.961,"text":"Okan mi o yo n'Oluwa","marked":"Ọkàn mi ò yọ n'Olúwa"},{"start":18.411,"end":20.187,"text":"Y'o yin ise at'oro Re,","marked":"Y'ó yin iṣẹ́ àt'ọ̀rọ̀ Rẹ̀"},{"start":20.637,"end":22.156,"text":"lse ore Re ti po to!","marked":"lṣe ọ̀rẹ́ Rẹ ti pọ̀ tó!"},{"start":22.606,"end":24.141,"text":"ljinle si ni imo Re.","marked":"ljinlẹ̀ sì ni ìmọ̀ Rẹ̀."}],"end":24.141},{"key":"4","start":25.091,"lines":[{"start":25.091,"end":26.305,"text":"Emi o yan ipo ola","marked":"Èmi ó yan ipò ọlá"},{"start":26.755,"end":28.288,"text":"Gb'ore-ofe ba we mi nu","marked":"Gb'ore-ofe bá wẹ̀ mi nù"},{"start":28.738,"end":30.285,"text":"Ti ayo pupo si ba mi,","marked":"Tí ayọ̀ púpọ̀ sì bá mi"},{"start":30.735,"end":32.058,"text":"Ayo mimo lat' oke wa.","marked":"Ayọ̀ mímọ́ lát òkè wá."}],"end":32.058},{"key":"5","start":33.008,"lines":[{"start":33.008,"end":35.565,"text":"Ghana, ngo ri, ngo gbo ngo mo,","marked":"Ghana, ngó rí, ngó gbọ́ ngó mọ́"},{"start":36.015,"end":37.737,"text":"Ohun gbogbo ti mo ti nfe","marked":"Ohun gbogbo tí mo ti ńfẹ́"},{"start":38.187,"end":39.638,"text":"Gbogbo ipa mi y'o dalu","marked":"Gbogbo ipá mi y'ó dàlú"},{"start":40.088,"end":41.585,"text":"Lati se 'fe Re titi lai.","marked":"Láti ṣe fẹ́ Rẹ títí láì."},{"start":42.035,"end":42.621,"text":"Amin.","marked":"Àmín."}],"end":42.621}]}