{"v":2,"coll":"y","num":61,"id":"hymn_61","title":"BABA WA ti mbe l'orun","duration":101.201,"voices":{"male":{"file":"y-61-male-v2.m4a","bytes":711994,"sha256":"c00c5c9319bd966d57d0786d0ca38b1ac0b3b0170d42a8600b07f9d2ad437340","duration":101.3},"female":{"file":"y-61-female-v2.m4a","bytes":746906,"sha256":"18b590ef1faceef70f29cea24cba7eda5a9037f796b8777d183fd5c4b49afb0b","duration":101.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.729,"text":"BABA WA ti mbe l'orun","marked":"Baba Wa ti mbẹ̀ l'ọ̀run"},{"start":2.179,"end":3.276,"text":"Owo loruko Re,","marked":"Ọwọ́ lórúkọ Rẹ"},{"start":3.726,"end":5.256,"text":"Ife tire ni ka se","marked":"Ìfẹ́ tirẹ̀ ni ká ṣe"},{"start":5.706,"end":6.855,"text":"Bi nwon ti nse lorun","marked":"Bí wọ́n ti ńṣe lọ́rùn"},{"start":7.305,"end":8.807,"text":"Fun wa l'onje ojo wa","marked":"Fún wa l'oǹjẹ ọjọ́ wa"},{"start":9.257,"end":10.453,"text":"'Dari ese ji wa,","marked":"dárí ẹ̀ṣẹ̀ jì wá"},{"start":10.903,"end":12.101,"text":"Gba wa lowo idanwo","marked":"Gbà wá lọ́wọ́ ìdánwò"},{"start":12.551,"end":13.582,"text":"Gba wa lowo ewu.","marked":"Gbà wá lọ́wọ́ ewu."}],"end":13.582},{"key":"2","start":14.532,"lines":[{"start":14.532,"end":15.817,"text":"Iwo to gbo t'Elija","marked":"Ìwọ tó gbọ́ t'Elija"},{"start":16.267,"end":17.591,"text":"Leba odo Kedron","marked":"Lẹ́bà ọ̀dọ̀ Kedron"},{"start":18.041,"end":19.653,"text":"lwo to gbo ti Daniel","marked":"lwo tó gbọ́ ti Daniẹl"},{"start":20.103,"end":21.175,"text":"Ko gbo ti wa loni,","marked":"Kò gbọ́ ti wá lónì"},{"start":21.625,"end":22.835,"text":"Fun wa niru agbara","marked":"Fún wa nírú agbára"},{"start":23.285,"end":24.749,"text":"To fi f'awon Apostle","marked":"Tó fi f'àwọn Apostle"},{"start":25.199,"end":26.412,"text":"K'awa le wulo fun O","marked":"K'àwa lè wúlò fún Ọ"},{"start":26.862,"end":27.98,"text":"Ka jere bi ti won.","marked":"Ká jèrè bí ti wọ́n."}],"end":27.98},{"key":"3","start":28.93,"lines":[{"start":28.93,"end":30.16,"text":"Fun wa lokan igbagbo","marked":"Fún wa lọ́kàn ìgbàgbọ́"},{"start":30.61,"end":31.991,"text":"Ti ki y'o ye lailai","marked":"Tí kì y'ó yẹ láéláé"},{"start":32.441,"end":33.793,"text":"Ka gbekele O titi,","marked":"Ká gbẹ́kẹ̀lé Ọ títí"},{"start":34.243,"end":35.226,"text":"Ao fi r' oju Re,","marked":"Àó fi r ojú Rẹ"},{"start":35.676,"end":36.97,"text":"Je ka le ni ireti","marked":"Jẹ́ ká lè ní ìrètí"},{"start":37.42,"end":38.484,"text":"Ninu Iwo nikan","marked":"Nínú Ìwọ nìkan"},{"start":38.934,"end":40.325,"text":"Ka nife s'enikeji,","marked":"Ká nífẹ́ s'ẹnìkejì"},{"start":40.775,"end":42.057,"text":"Ka si n'iwa pele.","marked":"Ká sì n'ìwà pẹ̀lẹ́."}],"end":42.057},{"key":"4","start":43.007,"lines":[{"start":43.007,"end":44.309,"text":"Baba a si tun mbe O,","marked":"Baba a sì tún mbẹ́ Ọ"},{"start":44.759,"end":45.729,"text":"Ani fun OIon' wa,","marked":"Àní fún Ọlọ́n wa"},{"start":46.179,"end":47.593,"text":"Ko fi Emi meje Re","marked":"Kò fi Ẹ̀mí méje Rẹ̀"},{"start":48.043,"end":49.228,"text":"Se 'tura f 'okan re,","marked":"Ṣe tura f ọkàn rẹ"},{"start":49.678,"end":50.889,"text":"Je ki awa le ma rin","marked":"Jẹ́ kí àwa lè má rìn"},{"start":51.339,"end":52.801,"text":"Lona to nto wa si","marked":"Lọ́nà tó ńtọ̀ wá sí"},{"start":53.251,"end":54.73,"text":"Ko le ko wa de Canaan","marked":"Kò lè kọ́ wa dé Canaan"},{"start":55.18,"end":56.484,"text":"Niwaju Ite re.","marked":"Níwájú Ìtẹ́ rẹ."}],"end":56.484},{"key":"5","start":57.434,"lines":[{"start":57.434,"end":58.748,"text":"Iwo to gbo ti Sedrak,","marked":"Ìwọ tó gbọ́ ti Sedrak"},{"start":59.198,"end":61.549,"text":"Mesak, Abednego","marked":"Meṣak, Abednego"},{"start":61.999,"end":63.513,"text":"Gbo t'awa Egbe Serafi,","marked":"Gbọ́ t'àwa Ẹgbẹ́ Serafi"},{"start":63.963,"end":65.151,"text":"Gbat'a ba nkepe O","marked":"Gbàt'á bá ńkẹpẹ Ọ"},{"start":65.601,"end":66.825,"text":"Fi agbara Re wo wa","marked":"Fi agbára Rẹ̀ wò wá"},{"start":67.275,"end":68.774,"text":"Bi ti woli isaju","marked":"Bí ti wòlí ìṣájú"},{"start":69.224,"end":70.677,"text":"Ka ni 'gboya bi ti won","marked":"Ká ni gboyà bí tí wọ́n"},{"start":71.127,"end":72.421,"text":"Ka segun aiye yi.","marked":"Ká ṣẹ́gun ayé yí."}],"end":72.421},{"key":"6","start":73.371,"lines":[{"start":73.371,"end":74.415,"text":"Awon Omo Isreal,","marked":"Àwọn Ọmọ Isreal"},{"start":74.865,"end":75.793,"text":"Ninu rin ajo won,","marked":"Nínú rìn àjọ wọn"},{"start":76.243,"end":77.529,"text":"Iwo lo ns'amona won,","marked":"Ìwọ ló ńṣ'amọ̀nà wọn"},{"start":77.979,"end":79.019,"text":"Ati abo fun won,","marked":"Àti abo fún wọn"},{"start":79.469,"end":80.717,"text":"Bi nwon ti ndese si O,","marked":"Bí wọ́n ti ńdẹ́ṣẹ̀ sí Ọ"},{"start":81.167,"end":82.34,"text":"Be lo ndariji won,","marked":"Bẹ́ lọ ńdáríjì wọn"},{"start":82.79,"end":84.216,"text":"Jowo ko dariji wa,","marked":"Jọ̀wọ́ kò dáríjì wá"},{"start":84.666,"end":85.949,"text":"Awa Egbe Serafu.","marked":"Àwa Ẹgbẹ́ Séráfù."}],"end":85.949},{"key":"7","start":86.899,"lines":[{"start":86.899,"end":88.041,"text":"Olorun Abrahamu,","marked":"Ọlọ́run Abrahamu"},{"start":88.491,"end":89.607,"text":"Olorun Isaaki","marked":"Ọlọ́run Isaaki"},{"start":90.057,"end":91.242,"text":"Ati Olorun Jakobu","marked":"Àti Ọlọ́run Jakọbu"},{"start":91.692,"end":92.753,"text":"Awa f'ope fun O","marked":"Àwa f'ọpẹ́ fún Ọ"},{"start":93.203,"end":94.634,"text":"Ogo, iyin, olanla","marked":"Ògo, ìyìn, ọláńlá"},{"start":95.084,"end":96.185,"text":"S'Eni Metalokan","marked":"S'Ẹni Mẹ́talọ́kan"},{"start":96.635,"end":97.945,"text":"Halleluyah's Olorun","marked":"Halleluyah's Ọlọ́run"},{"start":98.395,"end":99.653,"text":"Aiye ainipekun.","marked":"Ayé àìnípẹ̀kun."}],"end":99.653}]}