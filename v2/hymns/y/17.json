{"v":2,"coll":"y","num":17,"id":"hymn_17","title":"ERO di dun kan nso","duration":48.563,"voices":{"male":{"file":"y-17-male-v2.m4a","bytes":340795,"sha256":"cb08b595a2d62e2eaa01c0c1d9e6f661eee914bb7fc6b91461733c712a5269aa","duration":48.6},"female":{"file":"y-17-female-v2.m4a","bytes":350129,"sha256":"ef4e13a8ed82474bdb9d82f51df96e4ef2e87e4db2f424bc8c8fd65da9778bbe","duration":48.6}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.798,"text":"ERO di dun kan nso","marked":"Èrò di dùn kan ńṣọ́"},{"start":2.248,"end":3.628,"text":"S'okan mi fi ri fi ri,","marked":"S'ọkàn mi fi rí fi rí"},{"start":4.078,"end":5.589,"text":"Mo sunmo 'le mi lo ni","marked":"Mo súnmọ́ lé mi lọ ni"},{"start":6.039,"end":7.45,"text":"Ju bi mo ti sunmo ri.","marked":"Ju bí mo ti súnmọ́ rí."}],"end":7.45},{"key":"2","start":8.4,"lines":[{"start":8.4,"end":9.733,"text":"Mo sunmo 'te nla ni,","marked":"Mo súnmọ́ tẹ́ ńlá ni"},{"start":10.183,"end":11.675,"text":"Mo sunm'okan Kristi","marked":"Mo súnm'ọkàn Kristi"},{"start":12.125,"end":13.293,"text":"Mo sumo 'le Baba","marked":"Mo súmọ́ lé Baba"},{"start":13.743,"end":15.12,"text":"Nibiti 'bugbe pupo wa.","marked":"Níbití bùgbé púpọ̀ wà."}],"end":15.12},{"key":"3","start":16.07,"lines":[{"start":16.07,"end":17.406,"text":"Mo sunmo 'te nla ni,","marked":"Mo súnmọ́ tẹ́ ńlá ni"},{"start":17.856,"end":18.916,"text":"T'a so e ru kale","marked":"T'á sọ ẹ́ ru kalẹ̀"},{"start":19.366,"end":20.792,"text":"T'a gb'agbele bu si le","marked":"T'á gb'àgbélé bú sì le"},{"start":21.242,"end":22.561,"text":"T'a si be re gb'ade.","marked":"T'á sì bẹ rẹ̀ gb'adé."}],"end":22.561},{"key":"4","start":23.511,"lines":[{"start":23.511,"end":24.81,"text":"Lagbedemeji eyi,","marked":"Lagbedeméjì èyí"},{"start":25.26,"end":26.234,"text":"Ni 'san‐omi dudu","marked":"Ní san-omi dúdú"},{"start":26.684,"end":28.161,"text":"Ti a o la koja dandan","marked":"Tí a ó là kọjá dandan"},{"start":28.611,"end":30.034,"text":"K'a to de 'mole na.","marked":"K'á tó dé mọ́lẹ̀ ná."}],"end":30.034},{"key":"5","start":30.984,"lines":[{"start":30.984,"end":32.484,"text":"Jesu, jo se mi pe","marked":"Jésù, jọ ṣe mí pé"},{"start":32.934,"end":34.175,"text":"So 'gba gbo mi di lile","marked":"Sọ gbà gbọ́ mi di líle"},{"start":34.625,"end":36.044,"text":"Je ki n mo p'O sunmo mi","marked":"Jẹ́ kí n mo p'Ó súnmọ́ mi"},{"start":36.494,"end":37.89,"text":"Leti bebe iku.","marked":"Létí bẹ̀bẹ̀ ikú."}],"end":37.89},{"key":"6","start":38.84,"lines":[{"start":38.84,"end":39.966,"text":"Ki nmo p'O sunmo mi","marked":"Kí nmọ̀ p'Ó súnmọ́ mi"},{"start":40.416,"end":42.005,"text":"Gba mba njin si koto;","marked":"Gba mba ǹjìn sí kòtò"},{"start":42.455,"end":44.002,"text":"O le je pe mo nsumole,","marked":"Ó lè jẹ́ pé mo ńṣùmọ́lẹ̀"},{"start":44.452,"end":45.964,"text":"Sunmo ju bi mo ti ro.","marked":"Súnmọ́ ju bí mo ti rò."},{"start":46.414,"end":47.014,"text":"Amin.","marked":"Àmín."}],"end":47.014}]}