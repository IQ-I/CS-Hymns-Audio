{"v":2,"coll":"y","num":58,"id":"hymn_58","title":"OBA TI ki ye Majemu","duration":53.764,"voices":{"male":{"file":"y-58-male-v2.m4a","bytes":372023,"sha256":"5a32070ae223c902b59f8f0821c87a91929902c6e29c98429dcf9425ed4e3642","duration":53.8},"female":{"file":"y-58-female-v2.m4a","bytes":385739,"sha256":"c6e6a38eabd11a0b0dea6250b3efb47c9f2ed39a11ddc398279fa765e357a1f3","duration":53.8}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.834,"text":"OBA TI ki ye Majemu","marked":"Ọba Tí kì yẹ Májẹ̀mú"},{"start":2.284,"end":3.524,"text":"F'ore ofe Re fun wa,","marked":"F'oore ọ̀fẹ́ Rẹ fún wa"},{"start":3.974,"end":5.83,"text":"Majemu ti a ba O da,","marked":"Májẹ̀mú tí a bá Ó dá"},{"start":6.28,"end":7.724,"text":"Ki awa ko le mu se.","marked":"Kí àwa kò lè mú ṣe."}],"end":7.724},{"key":"CHORUS","start":8.674,"lines":[{"start":8.674,"end":10.056,"text":"Nitori iku Messaiah","marked":"Nítorí ikú Messaiah"},{"start":10.506,"end":11.978,"text":"Jowo ko sanu fun wa. 2ce","marked":"Jọ̀wọ́ kò ṣanú fún wa."}],"end":11.978},{"key":"2","start":12.928,"lines":[{"start":12.928,"end":14.27,"text":"Oba Mimo Oba Ogo,","marked":"Ọba Mímọ́ Ọba Ògo"},{"start":14.72,"end":15.957,"text":"Wo l'awa nfi iyin fun","marked":"Wò l'àwa ńfi ìyìn fún"},{"start":16.407,"end":18.015,"text":"Kerubu ati Serafu","marked":"Kérúbù àti Séráfù"},{"start":18.465,"end":19.999,"text":"S'ope odun titun yi.","marked":"S'ọpẹ́ ọdún titun yí."}],"end":19.999},{"key":"3","start":20.949,"lines":[{"start":20.949,"end":22.387,"text":"Alaileso jek'o s'eso","marked":"Aláìléso jẹ́k'ó s'èṣọ́"},{"start":22.837,"end":24.285,"text":"Ninu odun t'awa yi","marked":"Nínú ọdún t'àwa yí"},{"start":24.735,"end":26.157,"text":"Alaigbagbo je ko gbagbo","marked":"Aláìgbàgbọ́ jẹ́ kó gbàgbọ́"},{"start":26.607,"end":27.908,"text":"Ki gbogbo wa di yiye.","marked":"Kí gbogbo wa di yíyẹ."}],"end":27.908},{"key":"4","start":28.858,"lines":[{"start":28.858,"end":30.201,"text":"Oba Mimo Jehofa NLA","marked":"Ọba Mímọ́ Jèhófà Ńlá"},{"start":30.651,"end":32.118,"text":"Gb'ope Ajodun wa yi,","marked":"Gb'ọpẹ́ Àjọ̀dún wa yí"},{"start":32.568,"end":34.254,"text":"Seri Ibukun Re sori","marked":"Ṣèrì Ìbùkún Rẹ sórí"},{"start":34.704,"end":36.236,"text":"Omode at'agba wa.","marked":"Ọmọdé àt'àgbà wá."}],"end":36.236},{"key":"5","start":37.186,"lines":[{"start":37.186,"end":38.48,"text":"Pese f'awon alairise,","marked":"Pèsè f'àwọn aláìríṣẹ́"},{"start":38.93,"end":40.062,"text":"Pese omo fun agan","marked":"Pèsè ọmọ fún àgàn"},{"start":40.512,"end":41.96,"text":"Fi ilera fun alaisan","marked":"Fi ìlera fún aláìsàn"},{"start":42.41,"end":43.649,"text":"K'omo Re mase rahun.","marked":"K'ọmọ Rẹ̀ máṣe ráhùn."}],"end":43.649},{"key":"6","start":44.599,"lines":[{"start":44.599,"end":46.288,"text":"F'agbara Re f 'Egbe Serafu,","marked":"F'agbára Rẹ̀ f ẹgbẹ́ Séráfù"},{"start":46.738,"end":48.245,"text":"Lati sin O de opin","marked":"Láti sin Ó dé òpin"},{"start":48.695,"end":50.413,"text":"Mase je k'ise wa laiye","marked":"Maṣe jẹ́ k'iṣẹ́ wa láìyẹ"},{"start":50.863,"end":52.215,"text":"Ja s'asan niwaju Re.","marked":"Já s'ásán níwájú Rẹ."}],"end":52.215}]}