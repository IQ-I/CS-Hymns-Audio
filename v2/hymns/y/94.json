{"v":2,"coll":"y","num":94,"id":"hymn_94","title":"JESU mo wa sodo Re,","duration":85.452,"voices":{"male":{"file":"y-94-male-v2.m4a","bytes":601553,"sha256":"8798ffd56cbcafb9149eabfb72c76d8c5e59309595c8889e694572ce3eab059d","duration":85.5},"female":{"file":"y-94-female-v2.m4a","bytes":629264,"sha256":"5cf5c1168d8d91b32fa10b2c3f4472054b5dfeb485140f4b0ce8b3f7c73ea20a","duration":85.5}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.448,"text":"JESU mo wa sodo Re,","marked":"Jésù mọ̀ wá sọ́dọ̀ Rẹ̀"},{"start":1.898,"end":3.345,"text":"Je ki nle ma to O lehin","marked":"Jẹ́ kí ńlè má tọ̀ Ọ́ lẹ́hìn"},{"start":3.795,"end":5.024,"text":"Bi 'ni mi gbogbo po si","marked":"Bí ní mi gbogbo pọ̀ sí"},{"start":5.474,"end":6.883,"text":"Ti ero mi gbogbo soji.","marked":"Ti èrò mi gbogbo sójì."}],"end":6.883},{"key":"CHORUS","start":7.833,"lines":[{"start":7.833,"end":9.531,"text":"E yin logo, enyin Mimo","marked":"Ẹ yin lógo, ẹ̀yin Mímọ́"},{"start":9.981,"end":11.424,"text":"E f'ope fun Baba loke","marked":"Ẹ f'ọpẹ́ fún Baba lókè"},{"start":11.874,"end":13.209,"text":"Da wa si I'egbe Serafu,","marked":"Dá wa sí l'ẹgbẹ́ Séráfù"},{"start":13.659,"end":15.064,"text":"Ni kehin gba okan wa la.","marked":"Ní kẹ́hìn gba ọkàn wa là."}],"end":15.064},{"key":"2","start":16.014,"lines":[{"start":16.014,"end":18.04,"text":"Keferi, lmale, e wa","marked":"Kèfèrí, lmálẹ̀, ẹ wà"},{"start":18.49,"end":20.165,"text":"Onigbagbo, ma kalo","marked":"Onígbàgbọ́, má kálọ"},{"start":20.615,"end":21.808,"text":"K'a jo yin Olorun wa,","marked":"K'á jọ yin Ọlọ́run wa"},{"start":22.258,"end":23.675,"text":"K'a le d'ade ni 'kehin.","marked":"K'á lè d'áde ní kẹ́hìn."}],"end":23.675},{"key":"3","start":24.625,"lines":[{"start":24.625,"end":25.722,"text":"A dupe lowo Olorun","marked":"A dúpẹ́ lọ́wọ́ Ọlọ́run"},{"start":26.172,"end":27.902,"text":"T'o fi Jesu Kristi fun wa","marked":"T'ó fi Jésù Kristi fún wa"},{"start":28.352,"end":30.035,"text":"Lati ra araiye pada,","marked":"Láti ra aráìyè padà"},{"start":30.485,"end":32.161,"text":"Lowo ese at'Esu.","marked":"Lọ́wọ́ ẹ̀ṣẹ̀ àt'èṣù."}],"end":32.161},{"key":"4","start":33.111,"lines":[{"start":33.111,"end":34.418,"text":"Egbe Serafu damure","marked":"Ẹgbẹ́ Séráfù dàmúrè"},{"start":34.868,"end":36.536,"text":"Egbe Kerubu kun f 'adura","marked":"Ẹgbẹ́ Kérúbù kún f àdúrà"},{"start":36.986,"end":38.372,"text":"Olugbala yio gba wa la","marked":"Olùgbàlà yóò gbà wá là"},{"start":38.822,"end":40.379,"text":"Oluwosan yio wo wa san.","marked":"Olùwòsàn yóò wò wá sàn."}],"end":40.379},{"key":"5","start":41.329,"lines":[{"start":41.329,"end":43.09,"text":"Ojo mbo t'aiye yio pin","marked":"Ọjọ́ mbọ́ t'ayé yóò pín"},{"start":43.54,"end":44.841,"text":"E sora enyin Mimo","marked":"Ẹ ṣọ́ra ẹ̀yin Mímọ́"},{"start":45.291,"end":46.694,"text":"K'eni waju te siwaju","marked":"K'ẹ́ni wájú tẹ̀ síwájú"},{"start":47.144,"end":48.596,"text":"K'eni ehin ma jafara.","marked":"K'ẹni ẹ̀hìn má jáfara."}],"end":48.596},{"key":"6","start":49.546,"lines":[{"start":49.546,"end":50.9,"text":"Awon to segun saju","marked":"Àwọn tó ṣẹ́gun sájú"},{"start":51.35,"end":53.053,"text":"Nwon nwo wa b'a ti nyo loni,","marked":"Wọ́n ńwọ wá b'á ti nyọ́ lónì"},{"start":53.503,"end":55.265,"text":"Nwon nkan sara si wa wipe","marked":"Wọ́n nǹkan sára sì wá wípé"},{"start":55.715,"end":58.152,"text":"Te siwaju, ma fa s'ehin.","marked":"Tẹ̀ síwájú, má fa s'ẹ̀hìn."}],"end":58.152},{"key":"7","start":59.102,"lines":[{"start":59.102,"end":60.578,"text":"Ma siyemeji lona yi,","marked":"Má ṣiyèméjì lọ́nà yí"},{"start":61.028,"end":62.756,"text":"B'o ti wu k'o le fun o to;","marked":"B'ó ti wù k'ó lè fún ọ tó"},{"start":63.206,"end":64.698,"text":"Serafu mase foiya","marked":"Séráfù máṣe fòìyà"},{"start":65.148,"end":66.602,"text":"Adun y'o kehin aiye re.","marked":"Adùn y'ó kẹhìn ayé rẹ̀."}],"end":66.602},{"key":"8","start":67.552,"lines":[{"start":67.552,"end":69.134,"text":"Nigbati 'pe kehin ba dun","marked":"Nígbàtí pé kẹ́hìn bá dùn"},{"start":69.584,"end":71.584,"text":"Jesu y'o ko wa de Kenaani,","marked":"Jésù y'ó kọ́ wá dé Kenaani"},{"start":72.034,"end":73.368,"text":"Je ka l'ayo lodo Re","marked":"Jẹ́ ká l'ayọ̀ lọ́dọ̀ Rẹ"},{"start":73.818,"end":75.331,"text":"Fi wa s'agbala itura.","marked":"Fi wá s'àgbàlá ìtura."}],"end":75.331},{"key":"9","start":76.281,"lines":[{"start":76.281,"end":77.883,"text":"E f'ogo fun Baba Ioke","marked":"Ẹ f'ògo fún Baba lókè"},{"start":78.333,"end":79.855,"text":"E f'ogo fun Omo pelu","marked":"Ẹ f'ògo fún Ọmọ pẹ̀lú"},{"start":80.305,"end":81.759,"text":"E f'ogo fun Emi Mimo","marked":"Ẹ f'ògo fún Ẹ̀mí Mímọ́"},{"start":82.209,"end":83.903,"text":"Metalokan lope ye fun.","marked":"Mẹ́talọ́kan lòpẹ́ yẹ fún."}],"end":83.903}]}