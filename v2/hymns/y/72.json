{"v":2,"coll":"y","num":72,"id":"hymn_72","title":"OBA awon eni Mimo","duration":72.985,"voices":{"male":{"file":"y-72-male-v2.m4a","bytes":507111,"sha256":"0df771e26d031047d404c6aaf1f24fd05662046b920bd744ef986f5662d4e1ac","duration":73.0},"female":{"file":"y-72-female-v2.m4a","bytes":514382,"sha256":"a7c38174160897e4c10047d03bc0e93339c18b39c50a9f226d7429c0c8ddba82","duration":73.0}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.321,"text":"OBA awon eni Mimo","marked":"Ọba àwọn ẹni Mímọ́"},{"start":1.771,"end":3.183,"text":"T'o mo ye awon 'rawo","marked":"T'ó mo yẹ àwọn ràwọ̀"},{"start":3.633,"end":5.081,"text":"Opo enit' Eda gbagbe","marked":"Ọ̀pọ̀ ẹnit Ẹ̀dá gbàgbé"},{"start":5.531,"end":7.003,"text":"Wa yika ite Re lati.","marked":"Wá yíká ìtẹ́ Rẹ láti."}],"end":7.003},{"key":"CHORUS","start":7.953,"lines":[{"start":7.953,"end":10.848,"text":"Mimo Mimo, Mimo Mimo, Mimo Mimo","marked":"Mímọ́ Mímọ́, Mímọ́ Mímọ́, Mímọ́ Mímọ́"},{"start":11.298,"end":12.112,"text":"Lo ye O.","marked":"Ló yẹ Ọ."},{"start":12.562,"end":13.882,"text":"Iwo I'a ba ma f' iyin fun","marked":"Ìwọ l'á bá má f ìyìn fún"},{"start":14.332,"end":15.647,"text":"Olorun, Edumare.","marked":"Ọlọ́run, Èdùmàrè."}],"end":15.647},{"key":"2","start":16.597,"lines":[{"start":16.597,"end":17.994,"text":"Enit' o wa ninu 'mole","marked":"Ẹnit ó wà nínú mọ́lẹ̀"},{"start":18.444,"end":19.611,"text":"T oju enikan ko ri","marked":"T ojú ẹnìkan kò rí"},{"start":20.061,"end":21.316,"text":"Mose ri akehinsi Re","marked":"Mósè rí akéhinsi Rẹ̀"},{"start":21.766,"end":23.202,"text":"Oju Mose ran b'orun.","marked":"Ojú Mósè ràn b'ọ̀run."}],"end":23.202},{"key":"3","start":24.152,"lines":[{"start":24.152,"end":25.642,"text":"Mole ti 'kuku aiye bo","marked":"Mọ́lẹ̀ tí kúkú ayé bọ̀"},{"start":26.092,"end":27.859,"text":"Ntan mole roro loke","marked":"Ǹtàn mọ́lẹ̀ rorò lókè"},{"start":28.309,"end":29.692,"text":"Nwon je omo alade l'orun","marked":"Wọ́n jẹ́ ọmọ aládé l'ọ̀run"},{"start":30.142,"end":31.68,"text":"Eda gbagbe won t'aiye.","marked":"Ẹ̀dà gbàgbé wọn t'ayé."}],"end":31.68},{"key":"4","start":32.63,"lines":[{"start":32.63,"end":34.132,"text":"Lala at'iya won fun O,","marked":"Lálà àt'ìyá wọn fún Ọ"},{"start":34.582,"end":36.109,"text":"Eda ko rohin re mo","marked":"Ẹ̀dá kò ròhìn rẹ̀ mọ́"},{"start":36.559,"end":37.916,"text":"Iwa rere won farasin","marked":"Ìwà rere wọn farasin"},{"start":38.366,"end":39.57,"text":"Oluwa nikan lo mo.","marked":"Olúwa nìkan ló mọ̀."}],"end":39.57},{"key":"5","start":40.52,"lines":[{"start":40.52,"end":42.072,"text":"Nwon farasin fun wa sugbon","marked":"Wọ́n farasin fún wa ṣùgbọ́n"},{"start":42.522,"end":43.726,"text":"A ko-won s'iwe iye","marked":"A ko-won s'ìwé ìyè"},{"start":44.176,"end":46.266,"text":"lgbagbo, adura, suru","marked":"lgbàgbọ́, àdúrà, sùrù"},{"start":46.716,"end":47.813,"text":"Lala on'jakadi won","marked":"Lálà ọn'jákadì wọn"}],"end":47.813},{"key":"6","start":48.763,"lines":[{"start":48.763,"end":50.181,"text":"Nwon mo isura Re lohun","marked":"Wọ́n mọ ìṣúra Rẹ lóhùn"},{"start":50.631,"end":51.797,"text":"Ka wa mo won Oluwa","marked":"Ká wá mọ̀ wọn Olúwa"},{"start":52.247,"end":53.537,"text":"Nigba'O ba nsiro oso","marked":"Nígbà'ó bá ńṣirò ọ̀ṣọ́"},{"start":53.987,"end":55.699,"text":"Ti mbe lara ade Re.","marked":"Ti mbẹ̀ lára adé Rẹ."}],"end":55.699},{"key":"7","start":56.649,"lines":[{"start":56.649,"end":58.079,"text":"E wole f'Oba Ologo","marked":"Ẹ wọlé f'Ọba Ológo"},{"start":58.529,"end":60.102,"text":"Serafu e wole fun","marked":"Séráfù ẹ wọlé fún"},{"start":60.552,"end":62.043,"text":"Niwaju ite Jehovah","marked":"Níwájú ìtẹ́ Jehovah"},{"start":62.493,"end":63.575,"text":"Olorun Metalokan.","marked":"Ọlọ́run Mẹ́talọ́kan."}],"end":63.575},{"key":"8","start":64.525,"lines":[{"start":64.525,"end":65.966,"text":"E wole f'Oba Ologo","marked":"Ẹ wọlé f'Ọba Ológo"},{"start":66.416,"end":67.704,"text":"Kerubu e wole fun","marked":"Kérúbù ẹ wọlé fún"},{"start":68.154,"end":69.875,"text":"Niwaju ite Jehovah","marked":"Níwájú ìtẹ́ Jehovah"},{"start":70.325,"end":71.436,"text":"Olorun Metalokan.","marked":"Ọlọ́run Mẹ́talọ́kan."}],"end":71.436}]}