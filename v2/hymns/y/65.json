{"v":2,"coll":"y","num":65,"id":"hymn_65","title":"ELESE wa s'orisun na","duration":41.357,"voices":{"male":{"file":"y-65-male-v2.m4a","bytes":281400,"sha256":"015db913686e8e7f5bfbb549ae255d90e92984f0f66aa673d560d92a21e194e5","duration":41.4},"female":{"file":"y-65-female-v2.m4a","bytes":295702,"sha256":"27b419d828bb79b9a32e93afdbba7a8dbadae2b9391a4d3ac2f755408fb888d2","duration":41.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.738,"text":"ELESE wa s'orisun na,","marked":"Ẹlẹ́ṣẹ̀ wa s'orísun ná"},{"start":2.188,"end":3.37,"text":"Wa pelu 'banuje re,","marked":"Wá pẹ̀lú banújẹ́ rẹ"},{"start":3.82,"end":5.089,"text":"Ri won sinu omi jijin","marked":"Rí wọn sínú omi jíjìn"},{"start":5.539,"end":6.856,"text":"'Wo y'o r'irorun nibe.","marked":"wò y'ó r'ìrọrùn níbẹ̀."}],"end":6.856},{"key":"CHORUS","start":7.806,"lines":[{"start":7.806,"end":9.822,"text":"Yara kalo, mase duro","marked":"Yára kálọ, máṣe dúró"},{"start":10.272,"end":12.193,"text":"lseju kan le so emi re nu","marked":"lṣẹ́jú kan lè sọ ẹ̀mí rẹ̀ nù"},{"start":12.643,"end":14.327,"text":"Jesu nduro Iati gba o,","marked":"Jésù ńdúró láti gbà ọ́"},{"start":14.777,"end":15.919,"text":"Anu mbe fun o loni.","marked":"Àánú mbẹ́ fún ọ lónì."}],"end":15.919},{"key":"2","start":16.869,"lines":[{"start":16.869,"end":18.292,"text":"Wa t'iwo t'eru ese re","marked":"Wá t'ìwọ t'ẹrú ẹ̀ṣẹ̀ rẹ"},{"start":18.742,"end":20.218,"text":"Jesu ti nduro de o,","marked":"Jésù ti ńdúró dè ọ́"},{"start":20.668,"end":22.474,"text":"B'ese re pon bi alari,","marked":"B'ẹ̀ṣẹ̀ rẹ̀ pọ́n bí alárí"},{"start":22.924,"end":24.148,"text":"Nwon yio funfun bi sno.","marked":"Wọ́n yóò funfun bí sno."}],"end":24.148},{"key":"3","start":25.098,"lines":[{"start":25.098,"end":26.531,"text":"Jesu olugbala wipe,","marked":"Jésù Olùgbàlà wípé"},{"start":26.981,"end":28.176,"text":"Awon ti o ba gbagbo","marked":"Àwọn tí ó bá gbàgbọ́"},{"start":28.626,"end":29.888,"text":"Ti nwon si ronupiwada","marked":"Tí wọ́n sì ronúpìwàdà"},{"start":30.338,"end":31.678,"text":"Y'o r'iye gba lodo re.","marked":"Y'ó r'iye gbà lọ́dọ̀ rẹ̀."}],"end":31.678},{"key":"4","start":32.628,"lines":[{"start":32.628,"end":34.117,"text":"Wa we ninu orisun na,","marked":"Wá wẹ̀ nínú orísun ná"},{"start":34.567,"end":35.905,"text":"F'eti si ohun ife","marked":"F'etí sí ohun ìfẹ́"},{"start":36.355,"end":37.661,"text":"Jeki awon Angeli yio","marked":"Jẹ́kí àwọn Áńgẹ́lì yóò"},{"start":38.111,"end":39.808,"text":"F'elese to yi pada.","marked":"F'ẹlẹ́ṣẹ̀ tó yí padà."}],"end":39.808}]}