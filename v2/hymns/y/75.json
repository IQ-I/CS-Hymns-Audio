{"v":2,"coll":"y","num":75,"id":"hymn_75","title":"EMI Orun gb'adura wa","duration":47.116,"voices":{"male":{"file":"y-75-male-v2.m4a","bytes":324809,"sha256":"fd2521e41176e36319f0b4054afd6fc41d8700d033182fb74c35b29bb5e8d8fd","duration":47.2},"female":{"file":"y-75-female-v2.m4a","bytes":338480,"sha256":"356f20cece255dcb3d37eccaa0374620f458074c2f6c5303c0e7d7f0a6fba417","duration":47.2}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.73,"text":"EMI Orun gb'adura wa,","marked":"Ẹ̀mí Ọ̀run gb'àdúrà wa"},{"start":2.18,"end":3.459,"text":"Wa gbe 'nu ile yi,","marked":"Wá gbé nu ilẹ̀ yí"},{"start":3.909,"end":5.718,"text":"Sokale pel'agbara Re,","marked":"Sọ̀kalẹ̀ pẹ̀l'agbára Rẹ"},{"start":6.168,"end":7.239,"text":"Wa Emi Mimo wa.","marked":"Wá Ẹ̀mí Mímọ́ wa."}],"end":7.239},{"key":"2","start":8.189,"lines":[{"start":8.189,"end":9.676,"text":"Wa bi 'imole si fi han wa,","marked":"Wá bí ìmọ́lẹ̀ sì fi hàn wá"},{"start":10.126,"end":11.343,"text":"B'aini wa ti po to,","marked":"B'àìní wa ti pọ̀ tó"},{"start":11.793,"end":13.239,"text":"Wa to wa si ona lye,","marked":"Wá tó wá sí ọ̀nà lyè"},{"start":13.689,"end":14.792,"text":"Ti Olododo nrin.","marked":"Ti Olódodo ńrìn."}],"end":14.792},{"key":"3","start":15.742,"lines":[{"start":15.742,"end":16.874,"text":"Wa bi ina ebo Mimo","marked":"Wá bí iná ẹbọ Mímọ́"},{"start":17.324,"end":18.485,"text":"S'okan wa di mimo,","marked":"S'ọkàn wa di mímọ́"},{"start":18.935,"end":20.317,"text":"Je ki okan wa je ore","marked":"Jẹ́ kí ọkàn wa jẹ́ ọrẹ"},{"start":20.767,"end":21.868,"text":"F'oruko Oluwa.","marked":"F'orúkọ Olúwa."}],"end":21.868},{"key":"4","start":22.818,"lines":[{"start":22.818,"end":24.229,"text":"Wa bi iri si wa bukun","marked":"Wá bí ìrì sí wa bùkún"},{"start":24.679,"end":25.755,"text":"Akoko mimo yi,","marked":"Àkókò mímọ́ yí"},{"start":26.205,"end":27.501,"text":"Ki okan alaileso wa,","marked":"Kí ọkàn aláìléso wà"},{"start":27.951,"end":29.181,"text":"Le yo l'agbara Re.","marked":"Lè yọ l'agbára Rẹ."}],"end":29.181},{"key":"5","start":30.131,"lines":[{"start":30.131,"end":31.641,"text":"Wa bi adaba n'apa Re,","marked":"Wá bí àdàbà n'apá Rẹ"},{"start":32.091,"end":33.1,"text":"Apa ife Mimo,","marked":"Apá ìfẹ́ Mímọ́"},{"start":33.55,"end":35.119,"text":"Wa je ki Egbe yi l'aiye,","marked":"Wá jẹ́ kí Ègbé yí l'ayé"},{"start":35.569,"end":36.972,"text":"Dabi Egbe t'orun.","marked":"Dàbí Ẹgbẹ́ t'ọ̀run."}],"end":36.972},{"key":"6","start":37.922,"lines":[{"start":37.922,"end":39.397,"text":"Emi orun gb'adura wa,","marked":"Ẹ̀mí ọ̀run gb'àdúrà wa"},{"start":39.847,"end":41.052,"text":"S'aiye yi d'ile Re,","marked":"S'ayé yí d'ilé Rẹ̀"},{"start":41.502,"end":43.368,"text":"Sokale pel'agbara e,","marked":"Sọ̀kalẹ̀ pẹ̀l'agbára ẹ̀"},{"start":43.818,"end":45.567,"text":"Wa, Emi Mimo wa.","marked":"Wá, Ẹ̀mí Mímọ́ wà."}],"end":45.567}]}