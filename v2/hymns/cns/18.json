{"v":2,"coll":"cns","num":18,"id":"hymn_18","title":"Jesu wa sarin wa","duration":21.359,"voices":{"male":{"file":"cns-18-male-v2.m4a","bytes":138647,"sha256":"774100fb9ff224579a7438f9f53f4904a9605034c739288da542433cd779901d","duration":21.4},"female":{"file":"cns-18-female-v2.m4a","bytes":144453,"sha256":"ba33d3673270fcdcc6740167b2a4e33903ba15163d6ce8cda969c9678328634c","duration":21.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.645,"text":"Jesu wa sarin wa,","marked":"Jésù wá sárín wa"},{"start":2.095,"end":3.418,"text":"L'agbar'Ajinde;","marked":"L'agbár'àjíǹde"},{"start":3.868,"end":5.036,"text":"Je k'isin wa nihin","marked":"Jẹ́ k'ìsìn wà níhìn"},{"start":5.486,"end":6.52,"text":"Je isin owo.","marked":"Jẹ́ ìsìn ọwọ́."}],"end":6.52},{"key":"2","start":7.47,"lines":[{"start":7.47,"end":8.489,"text":"Mi emi Mimo Re,","marked":"Mi Ẹ̀mí Mímọ́ Rẹ"},{"start":8.939,"end":9.825,"text":"Sinu okan wa;","marked":"Sínú ọkàn wa"},{"start":10.275,"end":11.385,"text":"Mu 'foya at'aro,","marked":"Mú fòyà àt'arọ"},{"start":11.835,"end":12.856,"text":"Kuro l'okan wa.","marked":"Kúrò l'ọkàn wa."}],"end":12.856},{"key":"3","start":13.806,"lines":[{"start":13.806,"end":15.123,"text":"Bi a ti n yara lo,","marked":"Bí a ti ń yára lọ"},{"start":15.573,"end":16.565,"text":"Lona ajo wa;","marked":"Lọ́nà àjọ wà"},{"start":17.015,"end":18.326,"text":"K'a ma sona f'oro,","marked":"K'á má ṣọ́nà f'ọ̀rọ̀"},{"start":18.776,"end":19.809,"text":"T'o j'ayeraye.","marked":"T'ó j'ayérayé."}],"end":19.809}]}