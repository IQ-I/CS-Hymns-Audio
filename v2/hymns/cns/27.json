{"v":2,"coll":"cns","num":27,"id":"hymn_27","title":"Ni kutukutua de o –a de o","duration":57.32,"voices":{"male":{"file":"cns-27-male-v2.m4a","bytes":432038,"sha256":"d53fe408bfb3a0a992856a63e861246a9982d791645ed3a027c65a17c3d87ad3","duration":57.4},"female":{"file":"cns-27-female-v2.m4a","bytes":441339,"sha256":"20a4992b589f58ee8b4fba89cf5034fed80d71173399faf5d9fae66ca6dd32b9","duration":57.4}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":2.365,"text":"Ni kutukutua de o -a de o,","marked":"Ní kùtùkùtùà dè ọ́ a dé ọ́"},{"start":2.815,"end":4.59,"text":"Aji pon omi kutukutu owuro,","marked":"Ají pọn omi kùtùkùtù òwúrọ̀"},{"start":5.04,"end":6.035,"text":"Ki pon omi riru,","marked":"Kí pọ́n omi rírú"},{"start":6.485,"end":9.143,"text":"A wa kanlekun -a tewo adura,","marked":"A wá kanlẹ́kun a tẹ́wọ́ àdúrà"},{"start":9.593,"end":10.956,"text":"Baba je ko ye wa.","marked":"Baba jẹ́ kó yẹ wá."}],"end":10.956},{"key":"2","start":11.906,"lines":[{"start":11.906,"end":13.712,"text":"Ire olokun niba olokun","marked":"Ìrè olókùn níba olókùn"},{"start":14.162,"end":15.794,"text":"Ire olosa niba olosa (2ce)","marked":"Ìrè ọlọ́ṣà níba ọlọ́ṣà"},{"start":16.244,"end":18.04,"text":"Edumare Baba -Wa sure fun wa.","marked":"Èdùmàrè Baba Wa súre fún wa."}],"end":18.04},{"key":"3","start":18.99,"lines":[{"start":18.99,"end":21.083,"text":"SOLO: Ibukun owo la n toro,","marked":"Sọlọ: Ìbùkún ọwọ́ là ń tọrọ"},{"start":21.533,"end":23.435,"text":"Eledumare wa fifun wa,","marked":"Elédùmarè wá fífún wa"},{"start":23.885,"end":26.899,"text":"FULL: Awa kanlekun a tewo adura,","marked":"Full: Àwa kanlẹ̀kùn á tẹ́wọ́ àdúrà"},{"start":27.349,"end":28.716,"text":"Baba je ko ye wa.","marked":"Baba jẹ́ kó yẹ wá."},{"start":29.166,"end":32.025,"text":"SOLO: Ibukun Ola la n toro _Eledumare","marked":"Sọlọ: Ìbùkún Ọlá là ń tọrọ Elédùmarè"},{"start":32.475,"end":34.382,"text":"Ibukun Ola la n toro _Eledumare","marked":"Ìbùkún Ọlá là ń tọrọ Elédùmarè"},{"start":34.832,"end":36.58,"text":"Alafia la n toro _Eledumare","marked":"Àlàáfíà là ń tọrọ Elédùmarè"},{"start":37.03,"end":39.148,"text":"Abara emi la n toro _Eledumare","marked":"Àbàrà èmi là ń tọrọ Elédùmarè"},{"start":39.598,"end":42.841,"text":"FULL: A wa kanlekun -a tewo adura,","marked":"Full: A wá kànlẹ́kun a tẹ́wọ́ àdúrà"},{"start":43.291,"end":44.618,"text":"Baba je ko ye wa,","marked":"Baba jẹ́ kó yẹ wá"},{"start":45.068,"end":47.309,"text":"Ni kutukutu a de o -a de o,","marked":"Ní kùtùkùtù a dé ọ a dé ọ"},{"start":47.759,"end":49.52,"text":"Aji pon omi kutukutu owuro,","marked":"Ají pọn omi kùtùkùtù òwúrọ̀"},{"start":49.97,"end":51.0,"text":"Kii pon omi riru,","marked":"Kìí pọ́n omi rírú"},{"start":51.45,"end":54.054,"text":"A wa kanlekun -a tewo adura,","marked":"A wá kanlẹ́kun a tẹ́wọ́ àdúrà"},{"start":54.504,"end":55.771,"text":"Baba je ko ye wa.","marked":"Baba jẹ́ kó yẹ wá."}],"end":55.771}]}