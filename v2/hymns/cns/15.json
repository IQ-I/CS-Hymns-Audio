{"v":2,"coll":"cns","num":15,"id":"hymn_15","title":"Jah L'oke a de o, a tun de","duration":26.83,"voices":{"male":{"file":"cns-15-male-v2.m4a","bytes":194686,"sha256":"0f61a4d4a291ae903e1d2af9eeb252483816513c21e393838fa6b202d309654f","duration":26.9},"female":{"file":"cns-15-female-v2.m4a","bytes":205407,"sha256":"c54a1e65df7fec473b45912af0740cc1233262123820435aa35fb6645ba51eb4","duration":26.9}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":3.1,"text":"Jah L'oke a de o, a tun de","marked":"Jah L'òkè a dé ọ, a tún dé"},{"start":3.55,"end":5.643,"text":"O, a tun de t'aroye wa","marked":"O, a tún dé t'àròyé wa"},{"start":6.093,"end":7.686,"text":"A de o t'owo t'owo (2ce)","marked":"A dé ọ t'ọwọ́ t'ọwọ́"},{"start":8.136,"end":9.529,"text":"Messiah ye wa gbo","marked":"Messiah yẹ wá gbọ́"},{"start":9.979,"end":11.907,"text":"Wa ba w ape ninu wakati","marked":"Wá bá w àpè nínú wákàtí"},{"start":12.357,"end":13.559,"text":"Yi o Oba OLola","marked":"Yí ọ Ọba Ọlọ́lá"},{"start":14.009,"end":15.834,"text":"Olu pese Oba Pataki jowo ye","marked":"Olú pèsè Ọba Pàtàkì jọ̀wọ́ yẹ"},{"start":16.284,"end":17.266,"text":"Awa mbe O o.","marked":"Àwa mbẹ́ Ọ ọ́."},{"start":17.716,"end":20.312,"text":"Jah l'oke a de o, a tun de","marked":"Jah l'òkè a dé ọ, a tún dé"},{"start":20.762,"end":21.725,"text":"T'aroye wa,","marked":"T'àròyé wa"},{"start":22.175,"end":23.364,"text":"Ade o teruteru,","marked":"Adé ò tẹrùtẹrù"},{"start":23.814,"end":25.28,"text":"Oyigiyigi ye wa gbo.","marked":"Oyigiyigi yẹ wá gbọ́."}],"end":25.28}]}