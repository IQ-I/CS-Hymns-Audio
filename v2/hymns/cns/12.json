{"v":2,"coll":"cns","num":12,"id":"hymn_12","title":"Olugbala gbadura wa","duration":15.045,"voices":{"male":{"file":"cns-12-male-v2.m4a","bytes":104959,"sha256":"47cb1d9c94b5e8baaca6d26d160f2ee275612ac7e61ed49d4b5e1ce440745ffd","duration":15.1},"female":{"file":"cns-12-female-v2.m4a","bytes":107743,"sha256":"35b4218aee168932d748ab0ebb36e1bab3fa72a2db41f682c26ee34d9423abb2","duration":15.1}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.546,"text":"Olugbala gbadura wa,","marked":"Olùgbàlà gbàdúrà wa"},{"start":1.996,"end":3.579,"text":"B'a ti fi 'gbagbo kunle","marked":"B'á ti fi gbàgbọ́ kúnlẹ̀"},{"start":4.029,"end":5.498,"text":"Jo si ferese anu Re","marked":"Jọ sì fèrèsé àánú Rẹ̀"},{"start":5.948,"end":7.183,"text":"Ko de Oluwa a mbe O,","marked":"Kò dé Olúwa a mbẹ́ Ọ"},{"start":7.633,"end":9.073,"text":"Je k'ojo ibukun de o","marked":"Jẹ́ k'ọjọ́ ìbùkún dé ọ́"},{"start":9.523,"end":11.45,"text":"Awa n duro, awa n duro,","marked":"Àwa ń dúró, àwa ń dúró"},{"start":11.9,"end":13.495,"text":"M'okan gbogbo wa soji.","marked":"M'ọkàn gbogbo wá sọjí."}],"end":13.495}]}