{"v":2,"coll":"cns","num":34,"id":"hymn_34","title":"Baba dariji wa o","duration":32.228,"voices":{"male":{"file":"cns-34-male-v2.m4a","bytes":230314,"sha256":"932ecb87225398e562891fd5158280692c54e2d4565782ed78ee69bb21632441","duration":32.3},"female":{"file":"cns-34-female-v2.m4a","bytes":233564,"sha256":"3d8d9c531bf67d6331f76d868af26726700ceed3d4d7754fc04bf18fe27d1709","duration":32.3}},"segments":[{"key":"1","start":0.3,"lines":[{"start":0.3,"end":1.66,"text":"Baba dariji wa o, (2ce)","marked":"Baba dáríjì wá ọ"},{"start":2.11,"end":3.717,"text":"Awa elese abara m'ore je,","marked":"Àwa ẹlẹ́ṣẹ̀ àbàrà m'ọ́rẹ́ jẹ́"},{"start":4.167,"end":5.468,"text":"Baba dariji wa o,","marked":"Baba dáríjì wá ọ"},{"start":5.918,"end":7.448,"text":"Ni ti mimo a ko mo,","marked":"Ní ti mímọ́ a kò mọ̀"},{"start":7.898,"end":9.76,"text":"Ni ti yiyege a ko ye'ge (2ce)","marked":"Ní ti yíyegé a kò yé'gé"},{"start":10.21,"end":11.847,"text":"Bi a ba ni ka s'ami ese,","marked":"Bí a bá ní ká s'àmì ẹ̀ṣẹ̀"},{"start":12.297,"end":14.106,"text":"Ko s'eni to le duro ninu wa -","marked":"Kò s'ẹni tó lè dúró nínú wa"},{"start":14.556,"end":16.367,"text":"Baba Orun -Jowo dariji wa o.","marked":"Baba Ọ̀run Jọ̀wọ́ dáríjì wá ọ."}],"end":16.367},{"key":"2","start":17.317,"lines":[{"start":17.317,"end":18.29,"text":"Ya wa si mimo (2ce)","marked":"Yà wá sí mímọ́"},{"start":18.74,"end":20.193,"text":"Je ka le wulo fun ise Re,","marked":"Jẹ́ ká lè wúlò fún iṣẹ́ Rẹ"},{"start":20.643,"end":21.572,"text":"Ya wa si mimo,","marked":"Yà wá sí mímọ́"},{"start":22.022,"end":23.45,"text":"Ogun aye -Ogun Esu, (2ce)","marked":"Ogun ayé Ogun Èṣù"},{"start":23.9,"end":25.147,"text":"Ma je ko de wa lona,","marked":"Má jẹ́ kó dé wá lọ́nà"},{"start":25.597,"end":26.998,"text":"Ninu ara -Ninu emi,","marked":"Nínú ara Nínú èmi"},{"start":27.448,"end":29.154,"text":"Ma je k'adura wa ni 'de na,","marked":"Má jẹ́ k'àdúrà wa ní dé ná"},{"start":29.604,"end":30.679,"text":"Ya wa si mimo.","marked":"Yà wá sí mímọ́."}],"end":30.679}]}