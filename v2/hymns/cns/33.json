":31.309,"end":32.539,"text":"K'aboyun bi were","marked":"K'aboyún bí wèrè"},{"start":32.989,"end":34.482,"text":"K'aboyun T'owo bosun","marked":"K'aboyún T'owó bọ̀sùn"},{"start":34.932,"end":39.493,"text":"FULL: Ni kutukutu a be O o -Eleru niyin,","marked":"Full: Ní kùtùkùtù a bẹ̀ Ọ́ ọ Ẹlẹ́rù nìyìn"},{"start":39.943,"end":42.065,"text":"Loni o awa wole -saanu fun wa.","marked":"Lóní o àwa wọlé ṣàánú fún wa."}],"end":42.065}]}